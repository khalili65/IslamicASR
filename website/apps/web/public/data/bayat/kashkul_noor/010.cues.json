 },
 "chapters": [
  {
   "index": 0,
   "title": "## روایتِ امیر دربارهٔ حمدِ پیامبر در محشر",
   "start": 13.82,
   "end": 79.4
  },
  {
   "index": 1,
   "title": "## الحمد لله؛ بالاترین ستایش",
   "start": 79.4,
   "end": 118.58
  },
  {
   "index": 2,
   "title": "## فیضِ منبسط؛ صادرِ اول و نفسِ رحمان",
   "start": 118.58,
   "end": 225.78
  },
  {
   "index": 3,
   "title": "## اختصاص به پیامبر؛ تبعیّتِ اهل‌بیت",
   "start": 225.78,
   "end": 275.7
  },
  {
   "index": 4,
   "title": "## سرایتِ حمد به اهلِ محشر",
   "start": 275.7,
   "end": 413.82
  },
  {
   "index": 5,
   "title": "امیرالمؤمنین در انتهای عبارت چنان می‌فرماید که در قرآن آمده:",
   "start": 413.82,
   "end": 446.02
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 1.66,
   "end": 4.7,
   "text": "بسم الله الرحمن الرحیم و به او نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 4.7,
   "end": 8.74,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 8.74,
   "end": 13.82,
   "text": "آیاته. سلام علیکم و رحمه الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 13.82,
   "end": 17.32,
   "text": "در خصوص مقام محمود که بحث می‌کردیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 17.32,
   "end": 20.74,
   "text": "یه روایت خیلی جالبی از امیرالمؤمنین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 20.74,
   "end": 27.4,
   "text": "حضرت ولی علی علیه الصلاة والسلام هست در تفسیر موضوعی قرآن جلد پنج.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 27.4,
   "end": 31.18,
   "text": "مولا می‌فرماید که در مورد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 31.18,
   "end": 35.34,
   "text": "اهل محشر وقتی مردم اونجا جمع میشن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 35.34,
   "end": 41.6,
   "text": "روز حشر در موطنی که در آنجا مقام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 41.6,
   "end": 46.02,
   "text": "پیغمبر خاتم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 46.02,
   "end": 50.24,
   "text": "اونجا آشکار میشه. یعنی مقامیه که خاص پیغمبره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 50.24,
   "end": 52.38,
   "text": "اهدی نمی‌تونه تو اون مقام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 52.38,
   "end": 58.04,
   "text": "قرار بگیره. فقط پیغمبر عزیز عالم اونجا قرار می‌گیرن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 58.04,
   "end": 62.26,
   "text": "بعد پیغمبر به گونه‌ای خدا رو ستایش می‌کنه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 62.26,
   "end": 66.48,
   "text": "حمد. حمد خدا رو به گونه‌ای انجام میده که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 66.48,
   "end": 72.28,
   "text": "اهدی قبل از اون چنین ستایشی خدا رو نکرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 72.28,
   "end": 78.16,
   "text": "پیداست که خود موضوع حمد خیلی موضوع مهمیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 78.16,
   "end": 82.0,
   "text": "اینکه از امام باقر یا از امام صادق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 82.0,
   "end": 85.18,
   "text": "از هر دو بزرگوار داریم که حضرت فرمودن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 85.18,
   "end": 89.16,
   "text": "مثلا اگر فلان حاجت تموم بگیرم حمد خوبی انجام میدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 89.16,
   "end": 93.7,
   "text": "بعد حضرت وقتی حاجت روا شد همه دیدن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 93.7,
   "end": 97.44,
   "text": "سر به سجده نبرد و فقط گفت الحمد لله رب العالمین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 97.44,
   "end": 100.72,
   "text": "گفت آقا شما فرمودید که حمد خیلی خوبی تموم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 100.72,
   "end": 102.94,
   "text": "بالاتر از این ما نداریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 102.94,
   "end": 108.46,
   "text": "حالا ما به همین راحتی می‌گذرونیم الحمد لله رب العالمین ولی بالاتر از این واقعا نداریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 108.46,
   "end": 110.98,
   "text": "اون حمد، الحمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 110.98,
   "end": 116.68,
   "text": "که مقام همه ستایش‌هاست و همه ستایش‌ها به او برمی‌گرده اصلاً مقام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 116.68,
   "end": 120.46,
   "text": "فیض منبسطه. اصطلاحاً حالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 120.46,
   "end": 124.92,
   "text": "غریبه به چهل اسمش رو ملا صدرا میاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 124.92,
   "end": 128.1,
   "text": "صد تا اسم براش عرفا، حکما اینا دادن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 128.1,
   "end": 133.56,
   "text": "همون صادر اول و وجود منبسط،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 133.56,
   "end": 137.68,
   "text": "فیض منبسط، نور اول،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 137.68,
   "end": 140.6,
   "text": "رقق منشور، عرض کنم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 140.6,
   "end": 146.86,
   "text": "نور مرشوش که مقامی‌ست که در غوص صعود پیغمبر عزیز عالم در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 146.86,
   "end": 149.88,
   "text": "نشئه طبیعی رفت و به اون مقام رسید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 149.88,
   "end": 152.3,
   "text": "اون برزخ بین حق و خلقه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 152.3,
   "end": 155.88,
   "text": "اون خلق نیست. توجه کردید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 155.88,
   "end": 160.84,
   "text": "واسطه‌ی فیضه. هر فیضی از خدا بخواد به خلق برسه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 160.84,
   "end": 164.46,
   "text": "از طریق اون می‌رسه. بهش میگن نفس الرحمن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 164.46,
   "end": 168.34,
   "text": "حد نداره. مقید به غیر اطلاقه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 168.34,
   "end": 171.34,
   "text": "مطلقه. که خدا حالا اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 171.34,
   "end": 174.04,
   "text": "خدا هم مطلقه، خب؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 174.04,
   "end": 177.48,
   "text": "بی‌انتهاست. اما دیگه این قید رو نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 177.48,
   "end": 181.66,
   "text": "قید به مق-- یعنی مقید به غیر اطلاق رو دیگه نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 181.66,
   "end": 183.96,
   "text": "به هر حال وجود عجیبیه خیلی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 183.96,
   "end": 186.12,
   "text": "درباره‌ش برید بررسی کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 186.12,
   "end": 188.96,
   "text": "بهش میگن مقام حمد. چرا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 188.96,
   "end": 191.74,
   "text": "چون که هر فیضی به هر خیری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 191.74,
   "end": 193.78,
   "text": "به هر کی می‌رسه از اون می‌رسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 193.78,
   "end": 198.16,
   "text": "واسطه‌ی خیره. فیض بین خدا و خلقشه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 198.16,
   "end": 200.82,
   "text": "پس همه‌ی حمدها به اون برمی‌گرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 200.82,
   "end": 204.88,
   "text": "چه کار خوبی خدایا عجب فعل قشنگی انجام دادی، چه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 204.88,
   "end": 209.74,
   "text": "پیغمبر خوبی فرستادی، چه ارسال رسل و انزال كتب جالبی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 209.74,
   "end": 212.88,
   "text": "اینا رو کی به واسطه‌ی کی انجام شده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 212.88,
   "end": 216.6,
   "text": "فیض منبسط. باید هر حمدی بکنی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 216.6,
   "end": 221.26,
   "text": "هر خیری شما ازش تعریف کنی به اون برمی‌گرده چون واسطه‌ی فیضه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 221.26,
   "end": 225.62,
   "text": "تعریف کردم که بدونید درون مایه این روایت مولا یعنی چی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 225.62,
   "end": 229.66,
   "text": "این مقامی که پیغمبر درش قرار می‌گیره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 229.66,
   "end": 233.62,
   "text": "مقام حمده، ستایشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 233.62,
   "end": 240.38,
   "text": "و چون پیغمبر عزیز عالم در این نشئ رفت به اون مقام رسید، اون مقام اختصاص به ایشون داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 240.38,
   "end": 244.64,
   "text": "اهدی تو اون جایگاه حتی امیرالمؤمنین هم نمی‌تونه اونجا بایسته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 244.64,
   "end": 250.28,
   "text": "چون مولامون علی و همه اهل بیت علیهم الصلاة والسلام هم بالعصاله نرفتن که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 250.28,
   "end": 253.62,
   "text": "به تبع پیغمبر به اون مقام رسیدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 253.62,
   "end": 259.16,
   "text": "تازه حرف هست که آیا همشون به مقام صادر اول رسیدن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 259.16,
   "end": 263.92,
   "text": "عارف عربی میگه فقط امیرالمؤمنین قابل توجه اونایی که میگه عارف عربی سنی بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 263.92,
   "end": 269.64,
   "text": "میگه فقط وصی بلا فصل پیغمبر به اون مقام رسیده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 269.64,
   "end": 274.94,
   "text": "صادر اول. عجیبه این معارف رو آدم بررسی می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 274.94,
   "end": 278.12,
   "text": "حالا پس چی میشه قصه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 278.12,
   "end": 284.96,
   "text": "اینکه اون مقام فقط پیغمبر در اونجا قرار می‌گیره و حمدی رو انجام میده که اهدی همچین حمدی نکرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 284.96,
   "end": 288.06,
   "text": "انگار که خدا بیشترین چیزی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 288.06,
   "end": 291.36,
   "text": "چی بگیم حالا؟ زشته به خدا بگیم کیف می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 291.36,
   "end": 294.02,
   "text": "دیگه لفظ خاکیه مثل خود ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 294.02,
   "end": 298.64,
   "text": "قید و بند داره. بیشتر اینطوری بگیم راضی میشه انگار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 298.64,
   "end": 302.16,
   "text": "انگار بیشتر از هر چیزی راضی میشه حمده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 302.16,
   "end": 306.54,
   "text": "لئن شکرتّم لأزیدنّ. البته بین حمد و شکر فرقی هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 306.54,
   "end": 310.28,
   "text": "اینو حواسمون جمع باشه که چقدر جایگاه حمد بالاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 310.28,
   "end": 313.52,
   "text": "به هر حال پیغمبر خستتون نکنیم وقتمون هم کمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 313.52,
   "end": 317.22,
   "text": "پیغمبر وقتی این کار رو انجام میده مولامون داره می‌فرمادا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 317.22,
   "end": 320.06,
   "text": "می‌فرمود بعد از حمد پیغمبر،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 320.06,
   "end": 323.26,
   "text": "مؤمنین و مؤمنات شروع می‌کنند به حمد کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 323.26,
   "end": 328.06,
   "text": "اول صدّیقین، شهدا، بعد از اونا صالحین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 328.06,
   "end": 332.16,
   "text": "این کار رو انجام میدن. بعد از اون‌ها همینطور",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 332.16,
   "end": 336.4,
   "text": "تمام اهل محشر شروع می‌کنند حمد کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 336.4,
   "end": 339.36,
   "text": "سرایت می‌کنه به همه. یعنی یاد می‌گیرن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 339.36,
   "end": 343.2,
   "text": "و حمدشون که تموم شد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 343.2,
   "end": 349.54,
   "text": "چکار می‌کنن؟ حمد الهی رو که انجام دادن همه بالاتفاق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 349.54,
   "end": 356.12,
   "text": "ذیل پیغمبر بگیر تا دیگه کوچک‌ترین‌ها، کمترین‌ها، همه و همه ستایش می‌کنند کی رو؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 356.12,
   "end": 363.6,
   "text": "پیغمبر رو. تازه می‌فهمن که عجب هر فیضی به هر کی رسیده از این آقا بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 363.6,
   "end": 367.88,
   "text": "کانال فیض خدا بوده. تازه اینو می‌فهمن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 367.88,
   "end": 373.44,
   "text": "همونجا هم این اتفاق میفته. بهترین کار رو پیغمبر انجام میده به نحوه اتم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 373.44,
   "end": 376.58,
   "text": "سرایت می‌کنه همه یاد می‌گیرن تا اون کمترین‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 376.58,
   "end": 378.82,
   "text": "به صیغه وجودیشون حمد می‌کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 378.82,
   "end": 381.02,
   "text": "بعد از خدا فیض می‌گیرن اون لحظه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 381.02,
   "end": 386.9,
   "text": "همونجا عملاً پیاده میشه که می‌فهمن اِ کانال فیض کی بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 386.9,
   "end": 389.12,
   "text": "به قولی میفتن به دست و پای پیغمبر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 389.12,
   "end": 392.88,
   "text": "تازه می‌فهمن چه خبره. بعد يا حسرتا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 392.88,
   "end": 396.0,
   "text": "ألاما فرطت في جنب الله اونجا شروع میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 396.0,
   "end": 401.62,
   "text": "حسرت می‌خورن اونایی که کوتاهی کردن در خصوص جنب الله که انسان کامله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 401.62,
   "end": 405.64,
   "text": "بعد اینجا رو که امیرالمؤمنین علیه الصلاة والسلام فرمود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 405.64,
   "end": 407.34,
   "text": "اینجا انتهای عبارت جالبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 407.34,
   "end": 413.82,
   "text": "چنانکه مولا می‌فرماید، چنانکه در قرآن آمده عسى أن يبدلك ربك مقاما محمودا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 413.82,
   "end": 418.04,
   "text": "پس پیداست که امیرالمؤمنین مقام محمود رو اینجا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 418.04,
   "end": 422.44,
   "text": "بیان کرده. یعنی مولا نظرش در خصوص مقام محمود چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 422.44,
   "end": 427.08,
   "text": "این مقام حمده. پیغمبر در قیامت به این شکله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 427.08,
   "end": 430.58,
   "text": "پس اگر کسی می‌خواد به اون رتبه‌ی حمدی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 430.58,
   "end": 435.44,
   "text": "برسه، حمد قشنگ و جانانه‌ی قیامت داشته باشه راهش چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 435.44,
   "end": 438.92,
   "text": "ج-- برسه به مقام محمود از طریق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 438.92,
   "end": 442.74,
   "text": "نافله‌ی لیله. والحمد لله رب العالمین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 442.74,
   "end": 446.02,
   "text": "صلوات ختم کنیم. اللهم صل على محمد و آل محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}