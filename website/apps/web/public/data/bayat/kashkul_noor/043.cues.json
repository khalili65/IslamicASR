 "chapters": [
  {
   "index": 0,
   "title": "## روایت چهار رفیق بنی‌اسرائیل در کافی",
   "start": 197.68,
   "end": 230.56
  },
  {
   "index": 1,
   "title": "## صداقت در ادعا و سنگینی اهانت به عزیزان خدا",
   "start": 230.56,
   "end": 534.92
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.14,
   "end": 4.06,
   "text": "اللهم صل علی محمد و آل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 4.06,
   "end": 5.82,
   "text": "محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 5.82,
   "end": 9.2,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 9.2,
   "end": 13.22,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 13.22,
   "end": 19.42,
   "text": "آیات. السلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 19.42,
   "end": 23.42,
   "text": "چنانچه خاطر شریفتون باشه دیروز در خصوص",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 23.42,
   "end": 29.36,
   "text": "اینکه مصیبات همه از ناحیه حضرت حقه در وادی توحید افعالی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 29.36,
   "end": 33.82,
   "text": "داشتیم سخن می‌گفتیم که اینجا دو تا بحث پیش میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 33.82,
   "end": 41.44,
   "text": "یکی در آیه بیست و دو سوره حدیده که دیروز آیه اش رو خوندیم که امام سجاد صلی الله علیه به یزید علیه اللعنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 41.44,
   "end": 47.1,
   "text": "فرمود که این آیه مال ماست که هرچی که مصیبت بر شما میاد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 47.1,
   "end": 49.34,
   "text": "چه در جان هاتون، چه در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 49.34,
   "end": 55.3,
   "text": "خارج از جان هاتون همه از ناحیه حضرت حق تعریف شده در کتاب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 55.3,
   "end": 61.92,
   "text": "ام الکتاب اونجا تبیین شده و در کتاب اعلامیه به ما در شب های قدر و غیره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 61.92,
   "end": 64.82,
   "text": "این واقع شده. این مخصوص ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 64.82,
   "end": 72.42,
   "text": "این ربطی به عمل کرده ما نداره که چون اون ملعون داشت بهش می‌گفت که بستگی به کار خودتون داره این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 72.42,
   "end": 75.14,
   "text": "مشکلات که برای شما ایجاد شده و این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 75.14,
   "end": 77.64,
   "text": "شهادت و اسارت و امثالها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 77.64,
   "end": 85.74,
   "text": "اما آیه بعدی که مورد بحث آیه سی سوره شورا «و ما أصابکم من مصيبة",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 85.74,
   "end": 88.02,
   "text": "فبما كسبت أيديكم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 88.02,
   "end": 96.22,
   "text": "و یعفو عن كثير» داره صراحتا می فرماید که مصیباتی که به شما می‌خوره «بما كسبت أيديكم»",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 96.22,
   "end": 99.48,
   "text": "شما خودتون با دست خودتون این مصیبت‌ها رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 99.48,
   "end": 102.88,
   "text": "ایجاد کردید. این بر می‌گرده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 102.88,
   "end": 105.24,
   "text": "به آدم‌هایی که کامل نیستن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 105.24,
   "end": 108.26,
   "text": "یعنی با عمل کرده خودشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 108.26,
   "end": 111.2,
   "text": "اصطلاحا با گمراهی‌شون،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 111.2,
   "end": 116.06,
   "text": "با فسادشون، با معصیتشون خودشون موجبات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 116.06,
   "end": 119.3,
   "text": "ریزش این مصیبت‌ها رو بر سر خودشون فراهم می‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 119.3,
   "end": 122.94,
   "text": "مثل کسی که سر کار نره بشینه بگه خدایا برسون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 122.94,
   "end": 126.96,
   "text": "خودش با دست خودش موجبات مصیبت فقر رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 126.96,
   "end": 131.1,
   "text": "برای خودش فراهم کرده. کسی که خودش، خودشو بندازه تو چاه خودکشی کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 131.1,
   "end": 134.66,
   "text": "اینا خودش با دست خودشه و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 134.66,
   "end": 139.32,
   "text": "زیاده دیگه. بسیار اینا مصادیقش در زندگی‌های ما هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 139.32,
   "end": 141.92,
   "text": "اینو باید تمیز قائل شد. اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 141.92,
   "end": 149.94,
   "text": "اگرچه باز وارد شدن این مصیبت به حول و قوه الهیه اما به انتخاب خود شخصه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 149.94,
   "end": 153.78,
   "text": "اگر درجات شخص بالا رفت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 153.78,
   "end": 158.32,
   "text": "هرچه کامل‌تر شد اصطلاحا می‌گیم کمل شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 158.32,
   "end": 164.5,
   "text": "مصیباتی که وارد میشه بر او مصیباتی نیست که در پی عمل کرده خودشو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 164.5,
   "end": 167.68,
   "text": "چون عمل زشتی ازش سر نمیزنه، در پی اون نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 167.68,
   "end": 174.0,
   "text": "حوادث روزگاره. از، از قبل تعیین شده، تبیین شده نازل میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 174.0,
   "end": 178.56,
   "text": "اما هرچی انسان ضعیف النفس‌تره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 178.56,
   "end": 180.66,
   "text": "مصیبات به دست خودش رقم می‌خوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 180.66,
   "end": 187.56,
   "text": "اینو باید تمیز قائل بشیم. حالا به عنوان نمونه عرض می‌کنم باز به حول و قوه الهی میاد اما انتخابش با شخصه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 187.56,
   "end": 192.8,
   "text": "قبلاً هم گفتیم پیاده‌سازی همه به دست حقه از قبل هم مشخصه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 192.8,
   "end": 196.8,
   "text": "اما شخصه که انتخاب می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 196.8,
   "end": 199.56,
   "text": "به عنوان نمونه در کتاب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 199.56,
   "end": 204.12,
   "text": "شریف کافی مرحوم کلینی اعلا الله مقامه الشریف جلد دو صفحه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 204.12,
   "end": 208.32,
   "text": "سیصد و شصت و چهار می‌تونید این روایت که عرض می‌کنم رو ببینید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 208.32,
   "end": 211.28,
   "text": "یه روایت عجیبه باید تبیین بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 211.28,
   "end": 214.42,
   "text": "که چهار نفر با هم رفیق بودن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 214.42,
   "end": 216.62,
   "text": "از-- در زمان بنی اسرائیل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 216.62,
   "end": 222.24,
   "text": "الان پیش میاد بعضیمون ادعای رفاقت و صمیمیت و صدیق بودن و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 222.24,
   "end": 225.4,
   "text": "این‌ها می‌کنیم. چاکرم، نوکرم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 225.4,
   "end": 230.56,
   "text": "رفیقم، فدات شم، تف کن شنا کنی و امثال و این‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 230.56,
   "end": 234.76,
   "text": "این تعارفات مرسومی که بین مردم هست و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 234.76,
   "end": 239.1,
   "text": "حالا این شناگری که عرض کردم مال مردم نظام‌آباده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 239.1,
   "end": 243.44,
   "text": "اونجا این مرسومه. شماها شاید تعجب کردید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 243.44,
   "end": 247.28,
   "text": "قربونت برم، دورت بگردم، فدات بشم و امثالهم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 247.28,
   "end": 253.18,
   "text": "ولی واقعاً اینطوریه؟ حالا چهار نفر تو زمان بنی اسرائیل خیلی رفیق بودن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 253.18,
   "end": 257.84,
   "text": "تو روایت میگه اینا خیلی با هم گرم و صمیمی بودن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 257.84,
   "end": 263.2,
   "text": "سه تاشون یه روزی توی خونه‌ی یه بنده خدایی از همین سه نفر جمع شده بودن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 263.2,
   "end": 267.72,
   "text": "نفر چهارم اومد در زد که وارد بشه بر این‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 267.72,
   "end": 271.24,
   "text": "خادم این شخص اومد دم در شناخت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 271.24,
   "end": 274.34,
   "text": "بعد برگشت نگاه کرد دید این سه نفر خیلی گرمن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 274.34,
   "end": 277.42,
   "text": "بگو بخند و صفا و اینا گرمن با هم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 277.42,
   "end": 282.92,
   "text": "مثلا این گعده اینا رو خواست به هم نریزه گفت، به دروغ گفت نیستن اینجا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 282.92,
   "end": 285.28,
   "text": "خا-خادم اون خونه بود دیگه گفت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 285.28,
   "end": 293.06,
   "text": "اینجا نیستن. وقتی که اون رفت چهارمیه رفت، وقتی که آمد داخل پرسیدن کی بود؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 293.06,
   "end": 297.48,
   "text": "صاحب البيت گفت کی بود؟ گفت فلانی نفر چهارم شما بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 297.48,
   "end": 301.96,
   "text": "اونا هم هیچ عکس‌العملی نشون ندادن که مثلا تشری بزنن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 301.96,
   "end": 304.54,
   "text": "تذکری بدن. به چه خاطر شما گفتی نیستی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 304.54,
   "end": 308.12,
   "text": "یا پا-- راه بیفتن برن دنبال طرف بر-برگردونن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 308.12,
   "end": 310.64,
   "text": "نکردن این کارو. دوباره به همون ص--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 310.64,
   "end": 314.0,
   "text": "گعده خودشون ادامه دادن و تا فردا شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 314.0,
   "end": 316.54,
   "text": "این جمع متفرق شد و فردا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 316.54,
   "end": 319.2,
   "text": "با همدیگه حرکت کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 319.2,
   "end": 321.58,
   "text": "اتفاقا در بین راه این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 321.58,
   "end": 323.54,
   "text": "نفر چهارم به اینها ملحق شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 323.54,
   "end": 328.38,
   "text": "دوباره صحبت و گرم و صمیمی هم که می‌رفتن یه ابری اومد بالا سر اینا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 328.38,
   "end": 333.36,
   "text": "اینا گمان کردن که این ابر باران‌زائه خدارو شکر کردن که مثلا بارون می‌خواد بیاد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 333.36,
   "end": 336.8,
   "text": "و این ابر هم چونکه اینا می‌رفتن بالا سرشون حرکت می‌کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 336.8,
   "end": 339.76,
   "text": "تا جایی که نفر-- اون نفر چهارم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 339.76,
   "end": 344.3,
   "text": "از اینا جدا شد. تا که فاصله گرفت یه صاعقه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 344.3,
   "end": 346.6,
   "text": "شدیدی از ابر زد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 346.6,
   "end": 350.48,
   "text": "روایت میگه این سه تا در دم جون دادن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 350.48,
   "end": 354.82,
   "text": "افتادن مردن. نفر چهارم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 354.82,
   "end": 364.18,
   "text": "خیلی متعجب شد. سراسیمه خودش رو نس-- رسوند به حضرت یوشع بن نون وصی حضرت موسی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 364.18,
   "end": 369.24,
   "text": "پيغمبر اون زمان بود. وصی حضرت موسی بود، جانشین بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 369.24,
   "end": 372.2,
   "text": "مثل امیرالمؤمنین که وصی پیغمبر بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 372.2,
   "end": 377.76,
   "text": "ماجرا رو گفت. حضرت یوشع بن نون فرمود که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 377.76,
   "end": 380.42,
   "text": "خب این به جهت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 380.42,
   "end": 386.08,
   "text": "عملکرد زشت اون روزشونه و میدونست دیگه نبی خدا بود باخبر بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 386.08,
   "end": 393.82,
   "text": "خب اینا تو هم-- دور هم جمع شده بودن شما اومدی به شما اهانت کردن و اهانت‌شون رو به خدا شما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 393.82,
   "end": 398.58,
   "text": "به شما چون اهانت کردن خدا بر نتافت این اه-اهانت رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 398.58,
   "end": 403.2,
   "text": "خدا این صاعقه رو بلایی قرار داد به جهت اهانتی که به شما شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 403.2,
   "end": 410.08,
   "text": "و اینا فهمیدن. برنگشتن دنبال سر شما بیان یا به اون شخص تذکر بدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 410.08,
   "end": 412.98,
   "text": "حالا این معلومه که شخص آدم سلیم النفسی بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 412.98,
   "end": 415.12,
   "text": "گفت حالا اگه اینه من از خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 415.12,
   "end": 418.02,
   "text": "می‌خوام که ببخشه من از حق خودم گذشتم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 418.02,
   "end": 420.38,
   "text": "حضرت فرمود الان دیگه فایده نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 420.38,
   "end": 426.28,
   "text": "اگر قبل از صاعقه می‌فهمیدی از حقت می‌گذشتی این بلا برداشته می‌شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 426.28,
   "end": 429.4,
   "text": "اما الان فقط می‌تونه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 429.4,
   "end": 432.46,
   "text": "تخفیفی باشه بر بعد از مرگش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 432.46,
   "end": 436.4,
   "text": "الان دیگه اینا صاعقه مرگ این‌ها رو با خودش برد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 436.4,
   "end": 442.34,
   "text": "این نشون میده که خیلی باید آدم حواسش جمع باشه از ادعاهایی که می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 442.34,
   "end": 445.04,
   "text": "سر هر ادعایی آقا اینو بار من",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 445.04,
   "end": 450.46,
   "text": "این همه سالی که از خدا عمر گرفتیم بارها و بارها چه در خصوص خودم و دیگران اینو دیدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 450.46,
   "end": 454.84,
   "text": "هرچی ادعا کنی تو همون امتحان میشی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 454.84,
   "end": 457.14,
   "text": "و اگه صادق نباشی چوب می‌خوری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 457.14,
   "end": 461.1,
   "text": "مصیبت میاد. و اینم خودش توحید افعالیه‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 461.1,
   "end": 464.24,
   "text": "یعنی خدا بلا رو می‌ریزه سرت اگه صادق نباشی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 464.24,
   "end": 468.74,
   "text": "صداقت در رفاقت، صداقت در معاشرت و همه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 468.74,
   "end": 471.74,
   "text": "مخصوصاً کسی که بهش بی‌احترامی میشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 471.74,
   "end": 474.76,
   "text": "هر چقدر درجش بالا باشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 474.76,
   "end": 478.74,
   "text": "بلا سهمگین‌تره. خدای نکرده آدم به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 478.74,
   "end": 482.34,
   "text": "مثلاً پیغمبر خدا، امام معصوم جسارت کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 482.34,
   "end": 484.04,
   "text": "جانشینان امام معصوم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 484.04,
   "end": 487.42,
   "text": "مثلاً کسی به رهبر عزیزمون حضرت امام،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 487.42,
   "end": 490.92,
   "text": "این‌ها. به کسایی که معلومه پیش خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 490.92,
   "end": 497.96,
   "text": "آبرومندن. به علما، عرفا، بزرگان، اهل علم، اهل فضیلت، اهل تقوا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 497.96,
   "end": 503.88,
   "text": "هرچی که طرف پیش خدا عزیزتره جسارت بکنی چوب سنگین‌تری می‌خوری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 503.88,
   "end": 506.56,
   "text": "مخصوصا اینایی که ادعا می‌کنن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 506.56,
   "end": 509.1,
   "text": "ادعا می‌کنن از دینداری و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 509.1,
   "end": 512.36,
   "text": "از شود و این‌ها بعد به یک آدم دیندار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 512.36,
   "end": 514.72,
   "text": "جسارت می‌کنن. اینو حواسمون باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 514.72,
   "end": 518.76,
   "text": "بعد نظام توحید افعالی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 518.76,
   "end": 522.22,
   "text": "جهان هستی به گونه‌ایست که چوبش رو میزنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 522.22,
   "end": 525.58,
   "text": "به این شیوه. خدا دستش در کاره و چوبش رو می‌زنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 525.58,
   "end": 529.22,
   "text": "\"ید الله فوق أيديهم\". والحمد لله رب العالمين.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 529.22,
   "end": 534.92,
   "text": "صلوات خدایا. اللهم صل على محمد وآل محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}