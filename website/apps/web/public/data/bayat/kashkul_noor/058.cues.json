 },
 "chapters": [
  {
   "index": 0,
   "title": "## آیهٔ صد و بیست و سوم سورهٔ هود؛ چند نکتهٔ فشرده",
   "start": 17.62,
   "end": 108.34
  },
  {
   "index": 1,
   "title": "## غیب از نگاه ما، نه از نگاه خدا",
   "start": 108.34,
   "end": 352.6
  },
  {
   "index": 2,
   "title": "## دلیل توکل در آیات طلاق",
   "start": 352.6,
   "end": 507.21
  },
  {
   "index": 3,
   "title": "## وما ربک بغافل؛ شئون ربوبیت",
   "start": 507.21,
   "end": 608.41
  },
  {
   "index": 4,
   "title": "## موسی و کرم؛ مصداق غیب الهی",
   "start": 608.41,
   "end": 718.37
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.28,
   "end": 5.98,
   "text": "الصلاة والسلام على محمد وال محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 5.98,
   "end": 9.5,
   "text": "بسم الله الرحمن الرحيم و به این استعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 9.5,
   "end": 13.46,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 13.46,
   "end": 17.62,
   "text": "آیات. سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 17.62,
   "end": 20.02,
   "text": "آیه صد و بیست و سه سوره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 20.02,
   "end": 24.88,
   "text": "هود. ولله غیب السماوات والأرض.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 24.88,
   "end": 27.76,
   "text": "نهان آسمان‌ها و زمین لله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 27.76,
   "end": 30.18,
   "text": "برای الله. مال خودشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 30.18,
   "end": 32.26,
   "text": "غیب آسمان‌ها و زمین مال خودشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 32.26,
   "end": 38.18,
   "text": "این یه نکته. والیه يرجع الأمر كله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 38.18,
   "end": 44.22,
   "text": "همه امور، همه کارها به سوی او بازگردانده می‌شود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 44.22,
   "end": 47.22,
   "text": "این نکته دوم. و تو--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 47.22,
   "end": 50.4,
   "text": "فاعبده. فاعبده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 50.4,
   "end": 53.08,
   "text": "پس عبادتش را بکن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 53.08,
   "end": 58.3,
   "text": "این نکته بعدی. که شایسته عبادت فقط اوست که همه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 58.3,
   "end": 61.2,
   "text": "امور به او برمی‌گرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 61.2,
   "end": 64.34,
   "text": "وتوکل عليه. به او اعتماد کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 64.34,
   "end": 66.86,
   "text": "البته می‌دونید توکل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 66.86,
   "end": 72.94,
   "text": "مثلاً موضوع توکل وقتی با على میاد معناش یعنی اعتماد کردن به خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 72.94,
   "end": 76.7,
   "text": "با على. مثل اینجا توکل عليه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 76.7,
   "end": 78.96,
   "text": "وقتی با إلا میاد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 78.96,
   "end": 82.12,
   "text": "یعنی واگذار کن. امرت رو به خدا واگذار کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 82.12,
   "end": 85.96,
   "text": "اینا با هم متفاوته. اینجا با عليه اومده یعنی به خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 85.96,
   "end": 89.82,
   "text": "اعتماد کن. وما ربک بغافل عما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 89.82,
   "end": 94.12,
   "text": "تعملون. پروردگارت از آنچه که انجام می‌دهید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 94.12,
   "end": 98.16,
   "text": "بی‌خبر نیست. بغافل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 98.16,
   "end": 100.16,
   "text": "غفلت نداره خدا. حواست باشه ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 100.16,
   "end": 105.24,
   "text": "اینم نکته بعدی. خیلی آیه کوتاهه اما بسیار کثیر الفروعه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 105.24,
   "end": 110.84,
   "text": "چند تا نکته من عرض کنم. یکی اینکه مگر برای حق تعالی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 110.84,
   "end": 114.56,
   "text": "غیبی هست؟ مگر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 114.56,
   "end": 118.74,
   "text": "چیزی از نگاه خدا غیبه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 118.74,
   "end": 123.36,
   "text": "مثلا عالم الغیب والشهاده از اسامی حضرت حقه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 123.36,
   "end": 126.76,
   "text": "نه، منظور اون چیزی‌ست که از نظر ما غیبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 126.76,
   "end": 131.2,
   "text": "یعنی از نگاه ما غیبه، خدا به اون آگاهه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 131.2,
   "end": 135.22,
   "text": "پس ولله غیب السماوات والأرض.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 135.22,
   "end": 140.64,
   "text": "پنهان آسمان‌ها و زمین که از چشم شما پنهانه، نه از خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 140.64,
   "end": 143.82,
   "text": "اون پنهانی‌ها هم برای خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 143.82,
   "end": 148.1,
   "text": "مال خداست. الان شما بگی این ماشین مال منه، این خونه مال منه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 148.1,
   "end": 153.32,
   "text": "اعتبار دنیاست. فردا یکی دیگه میره تو اون خونه می‌شینه، یکی دیگه سوار همون ماشینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 153.32,
   "end": 155.9,
   "text": "درست شد؟ تازه تو همین دنیا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 155.9,
   "end": 159.52,
   "text": "حالا این بحث ملکیش. ملکوت چطور؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 159.52,
   "end": 162.14,
   "text": "ملک که در برابر ملکوت مثل یک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 162.14,
   "end": 165.64,
   "text": "ریگ در یک بیابان لایتناهیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 165.64,
   "end": 169.64,
   "text": "اون همه اموال در ملکوت مال کیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 169.64,
   "end": 172.1,
   "text": "اونم غیبه دیگه. تازه اون ملکوت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 172.1,
   "end": 174.7,
   "text": "بعد همون نسبت رو با جبروت، ملکوت داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 174.7,
   "end": 177.66,
   "text": "همون نسبت رو با لاهوت، جبروت داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 177.66,
   "end": 181.96,
   "text": "همون نسبت رو-- اصلاً قابل قیاس نیست دیگه بخوای با ذات غیبی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 181.96,
   "end": 185.56,
   "text": "چه خبره؟ چه مالن-- یملکی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 185.56,
   "end": 190.74,
   "text": "الله همه الله. ما همه از بی‌خبر از همه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 190.74,
   "end": 195.12,
   "text": "بعد یه ذره پول تو جیبمون، حساب بانکیمون شارژ میشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 195.12,
   "end": 196.88,
   "text": "دیگه خودمونو گم می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 196.88,
   "end": 201.02,
   "text": "همه هست و نیستیم مال خ-- همه چی مال خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 201.02,
   "end": 203.44,
   "text": "اگه واقعاً اینو من الان راحت دارم میگما،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 203.44,
   "end": 206.28,
   "text": "ولی کسی اینو باورش بشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 206.28,
   "end": 210.88,
   "text": "کار تمومه. حالا اون کیه که آگاهه به همه این‌ها؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 210.88,
   "end": 213.68,
   "text": "فرمود الیه يرجع الأمر كله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 213.68,
   "end": 219.36,
   "text": "كله. همه امور به او برگردانده می‌شود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 219.36,
   "end": 223.02,
   "text": "خیلی زیباست این تیکه. اهل بیت اینجا خیلی حرف‌ها زدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 223.02,
   "end": 230.0,
   "text": "در تفسیر اهل بیت جلد شش صفحه هشتصد و هجده اگه ملاحظه کنید، یه روایت خیلی شیرینی هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 230.0,
   "end": 237.92,
   "text": "من خلاصشو بگم که پیامبر عظیم‌الشأن اسلام در خصوص همین که همه امور برمی‌گرده به حضرت حق،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 237.92,
   "end": 240.68,
   "text": "یه مثالی زدن که ما بفهمیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 240.68,
   "end": 243.8,
   "text": "فرمودن که پروردگار سبحان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 243.8,
   "end": 248.96,
   "text": "ابتدا زمین رو که از ده ولأرض، از زیر کعبه گسترش داد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 248.96,
   "end": 253.08,
   "text": "زمین مستولی شد بر آب و حکومت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 253.08,
   "end": 257.22,
   "text": "عرض رو زمین، زمین خشکی دست گرفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 257.22,
   "end": 259.64,
   "text": "بعد به خودش بالید زمین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 259.64,
   "end": 265.72,
   "text": "تو روایت دیدم که وقتی این چیرگی حاصل شد گفت کیه که به من چیره بشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 265.72,
   "end": 270.28,
   "text": "زمین به خودش بالید. اصلاً انگار خصوصیت چیرگی اینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 270.28,
   "end": 273.28,
   "text": "تکبر برداشت حالا خودش رو چجوری شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 273.28,
   "end": 276.22,
   "text": "به خودش بالید بگو کی به من چیره میشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 276.22,
   "end": 282.9,
   "text": "ماهیان-- تو روایت میگه ماهیان سهمگین و بسیار بزرگی که اصلاً نهنگ در برابر اون‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 282.9,
   "end": 286.6,
   "text": "حساب نمیشه. اون موقع‌ها بودن در آب‌های زمین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 286.6,
   "end": 289.8,
   "text": "طوری که اینا تکون می‌خوردن زمین تکون می‌خورده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 289.8,
   "end": 293.38,
   "text": "انقدر این ماهی‌ها عظیم الجثه بودن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 293.38,
   "end": 296.74,
   "text": "بعد این‌ها زمین رو تکون دادن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 296.74,
   "end": 300.08,
   "text": "فرخ فروختن که آره ما زمین با این همه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 300.08,
   "end": 302.26,
   "text": "مثلاً ابهتش رو تکون دادیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 302.26,
   "end": 305.06,
   "text": "کی مثل ماست؟ کی می‌تونه به ما چیره بشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 305.06,
   "end": 308.88,
   "text": "پروردگار سبح-سبحان وتد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 308.88,
   "end": 313.38,
   "text": "جبل-- کوه رو، کوه رو آفرید به عنوان اوتاد که قرآن میگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 313.38,
   "end": 315.62,
   "text": "یعنی وتد جمع وتد، میخ.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 315.62,
   "end": 319.02,
   "text": "به عنوان میخ کوبید زمین دیگه تکون نخوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 319.02,
   "end": 321.58,
   "text": "میخ ب-- وقتی کوبیده شد مثل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 321.58,
   "end": 324.14,
   "text": "حالا ما نگاه می‌کنیم کوهه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 324.14,
   "end": 326.48,
   "text": "ولی آسمانی‌ها اونو میخ می‌بینن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 326.48,
   "end": 328.86,
   "text": "این وقتی کوبیده شد اون به خودش بالید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 328.86,
   "end": 330.96,
   "text": "گفت کیه که به من چیره بشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 330.96,
   "end": 333.44,
   "text": "من تونستم زمین رو از حرکت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 333.44,
   "end": 335.78,
   "text": "باز بذارم. حالا کوه رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 335.78,
   "end": 340.6,
   "text": "کی بادشو خوابوند؟ طبق روایت پروردگار سبحان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 340.6,
   "end": 347.78,
   "text": "آهن رو آفرید. با آهن تونستن بر کوه چیرگی پیدا کنن و کوه رو برش بدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 347.78,
   "end": 351.04,
   "text": "بعد کو-- آهن گفت کیه مثل من؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 351.04,
   "end": 353.68,
   "text": "با تو از خدایی چرا اینطوری--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 353.68,
   "end": 356.64,
   "text": "کیه مثل من؟ کی می‌تونه بر من چیره بشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 356.64,
   "end": 360.68,
   "text": "حالا آهن رو پروردگار سبحان چگونه آبش کرد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 360.68,
   "end": 363.1,
   "text": "با آتش. آتش رو خلق کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 363.1,
   "end": 366.61,
   "text": "آتش به این حالت افتاد، آب رو خلق کرد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 366.61,
   "end": 368.61,
   "text": "آب به این حالت افتاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 368.61,
   "end": 372.19,
   "text": "حالا آب رو به نظر شما چیکار بکنه خدا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 372.19,
   "end": 374.29,
   "text": "باد. باد رو خلق کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 374.29,
   "end": 377.75,
   "text": "باد، آب رو خشک میکنه دیگه. وقتی باد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 377.75,
   "end": 382.23,
   "text": "دیگه هیچکس حریفش نشد چون واقعا تو قدرت دنیا باد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 382.23,
   "end": 383.87,
   "text": "سرآمد همه قدرت‌هاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 383.87,
   "end": 387.21,
   "text": "هیچکس جلودارش نیست. فقط انسان تونست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 387.21,
   "end": 390.03,
   "text": "خدا انسان رو آفرید و بهش یاد داد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 390.03,
   "end": 396.43,
   "text": "حالا بین این خلقت‌ها چند هزار سال، چقدر ما نمی‌دونیم میلیون‌ها سال طول کشیده خلق ما آخ بی خبری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 396.43,
   "end": 399.73,
   "text": "اینم علم الهیه. انسان رو خلق کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 399.73,
   "end": 404.21,
   "text": "ارتفاعاتی ایجاد کرد که جلوی باد رو بگیره، باد رو بشکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 404.21,
   "end": 408.37,
   "text": "بعد انسان گفت حالا کیه که بر من چیره شه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 408.37,
   "end": 411.75,
   "text": "ببین اصلا عجیبه. بابا الله،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 411.75,
   "end": 414.41,
   "text": "لله ملکوت آسمانها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 414.41,
   "end": 417.65,
   "text": "بیدهی ملکوت سما-- ملکوت کل شی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 417.65,
   "end": 419.93,
   "text": "همه چی. تو هم یکی از اشیا هستی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 419.93,
   "end": 423.13,
   "text": "حالا باد آدمو چجوری خوابوند به نظر شما خدا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 423.13,
   "end": 427.01,
   "text": "چاموس .",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 427.01,
   "end": 431.05,
   "text": "با ما آخوندا که باد همه چی رو خوابوند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 431.05,
   "end": 435.25,
   "text": "نه ملک الموت. یعنی ما قابض الارواح هم شدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 435.25,
   "end": 437.09,
   "text": "یا حق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 437.09,
   "end": 441.15,
   "text": "شما کی بودی؟ شیخ عبدالله فیلبوسکویی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 441.15,
   "end": 444.11,
   "text": "ببخشید خواجه عبدالله، خواجه عبدالله فیلبوسکویی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 444.11,
   "end": 447.83,
   "text": "هر کدوم یه اسامی و کنیه ای دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 447.83,
   "end": 450.51,
   "text": "بله انسان رو و ملک الموت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 450.51,
   "end": 455.11,
   "text": "ملک الموت هم باز گفت حالا کیه که بر من بتونه چیره بشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 455.11,
   "end": 457.41,
   "text": "اینجا دیگه کی دست به کار شد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 457.41,
   "end": 459.61,
   "text": "به نظر شما؟ آفرین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 459.61,
   "end": 461.95,
   "text": "مستقیم خود حضرت حق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 461.95,
   "end": 463.81,
   "text": "فرمود این جمله‌ی آخر روایته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 463.81,
   "end": 469.05,
   "text": "خدای عزّ وجلّ فرمود: «من قهّار و غالب و بخشنده ام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 469.05,
   "end": 471.49,
   "text": "هرچی دارید من به شما بخشیدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 471.49,
   "end": 474.69,
   "text": "بر تو و بر هر چیزی چیره گردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 474.69,
   "end": 477.33,
   "text": "غالب و قهقار نهایی منم.»",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 477.33,
   "end": 479.91,
   "text": "اگه کسی نگاهش اینطوری باشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 479.91,
   "end": 484.35,
   "text": "هیچوقت دچار آمال و آرزو و گرفتاری‌ها و این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 484.35,
   "end": 489.05,
   "text": "عرض شود- غرور- غرور و تکبر و خودبرتربینی‌ها نمیشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 489.05,
   "end": 490.89,
   "text": "این نکته‌ی اول. حالا تندتند بگم برم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 490.89,
   "end": 495.83,
   "text": "اونا رو دیگه توضیح نمیدم. خب همچین کسی آیا شایسته عبادت نیست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 495.83,
   "end": 501.07,
   "text": "بعد از اینکه می‌فرماید: «یرجع الأمر كله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 501.07,
   "end": 503.11,
   "text": "الیه، يرجع الأمر كله».",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 503.11,
   "end": 505.81,
   "text": "خب قطعاً تعبد کن. حالا عبادتش بکن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 505.81,
   "end": 508.13,
   "text": "چرا غیر از این عبادت کنی؟ نکته،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 508.13,
   "end": 514.63,
   "text": "نکته‌ی بعدی. خب کسی که همه‌ی امور بهش برمی‌گرده نباید بهش اعتماد کرد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 514.63,
   "end": 517.95,
   "text": "و توکل علیه. مثل اون آیه‌ی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 517.95,
   "end": 521.29,
   "text": "اینا، این زنجیروار حلقه ها خیلی به دردمون می‌خوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 521.29,
   "end": 523.01,
   "text": "چرا من باید به خدا اعتماد کنم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 523.01,
   "end": 531.21,
   "text": "«ومن یتق الله يجعل له مخرجا، ويرزقه من حيث لا يحتسب».",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 531.21,
   "end": 534.77,
   "text": "هرچی رزق داری، چه گمان کنی چه نکنی از اوست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 534.77,
   "end": 538.17,
   "text": "خب اعتماد کن. چرا باز اعتماد کنم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 538.17,
   "end": 543.85,
   "text": "ادامه‌ی آیه. «ومن يت» می‌فرمود: «فهو بحسبه» چون اون برات بسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 543.85,
   "end": 548.85,
   "text": "«إن الله بالغ أمره فجعل الله لكل شيء قدرا».",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 548.85,
   "end": 551.57,
   "text": "همه چی به دست خداست. چرا اعتماد نکنی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 551.57,
   "end": 554.91,
   "text": "اصلا تو متن آیه دلیل توکل به خدا خوابیده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 554.91,
   "end": 557.93,
   "text": "هم تو اون آیه، آیه دو سه سوره طلاق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 557.93,
   "end": 560.21,
   "text": "همین آیه. و نکته‌ی آخر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 560.21,
   "end": 563.71,
   "text": "«وما ربک بغافل عما تعملون».",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 563.71,
   "end": 572.93,
   "text": "اصلا اینکه پروردگار سبحان «وما ربک بغافل» میگه خدای تو از تو غافل نیست و از اون کاری که می‌کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 572.93,
   "end": 576.83,
   "text": "از شعون ربوبیت آگاهیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 576.83,
   "end": 580.43,
   "text": "به اعیان، به کائنات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 580.43,
   "end": 582.63,
   "text": "او رب شده که مدیر باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 582.63,
   "end": 587.19,
   "text": "قبلاً گفتیم معنای مدیریت در رب خوابیده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 587.19,
   "end": 588.99,
   "text": "رزاقیت درش خوابیده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 588.99,
   "end": 592.69,
   "text": "قدرت درش خوابیده. کسی که همه به او برمی‌گرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 592.69,
   "end": 595.05,
   "text": "چه رزق، چه قدرت، چه حیات،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 595.05,
   "end": 597.79,
   "text": "چه اراده. همه و همه به او برمی‌گرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 597.79,
   "end": 600.01,
   "text": "او از تو غافل نیست. از شعون ربوبیت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 600.01,
   "end": 602.81,
   "text": "الحمد لله رب العالمين.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 602.81,
   "end": 605.71,
   "text": "نه از تو، از شی-- از سر سوزنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 605.71,
   "end": 608.41,
   "text": "در کائنات غافل نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 608.41,
   "end": 614.13,
   "text": "ختم کلام اینکه مصداقش وقتی حضرت موسی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 614.13,
   "end": 619.99,
   "text": "، می‌دونید که حضرت موسی ، یه سؤال عجیب از خدا کرد یه روز.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 619.99,
   "end": 623.19,
   "text": "گفت خدایا این کرم رو برای چی آفریدی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 623.19,
   "end": 627.91,
   "text": "کرم رو. خب می‌دونید که وقتی دریا شکافته شد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 627.91,
   "end": 631.45,
   "text": "زیر دریا با عصای موسی هم که همراهش بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 631.45,
   "end": 635.05,
   "text": "بعضیا میگن وقتی عبور می‌کرد به سنگ زیر دریا، زیر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 635.05,
   "end": 638.15,
   "text": "اون رود نیل زد. سنگ شکافته شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 638.15,
   "end": 640.53,
   "text": "یه کرمی برگ تو دهنش بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 640.53,
   "end": 646.07,
   "text": "برگ درخت زیر دریا تو دهان یک کرم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 646.07,
   "end": 648.79,
   "text": "بعد خدا گفت آخه این کرم رو برای چی تو آفریدی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 648.79,
   "end": 650.43,
   "text": "اینجا خوده براش سؤال شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 650.43,
   "end": 652.13,
   "text": "حالا زبان حالش شاید بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 652.13,
   "end": 655.05,
   "text": "چون حالا به زبان شاید نیومده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 655.05,
   "end": 663.29,
   "text": "خدا فرمود موسی از وقتی که این کرم رو آفریدم، روزی هفتاد بار میگه موسی رو چرا آفریدی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 663.29,
   "end": 665.15,
   "text": "نمی‌دونه. کسی از کسی خبر نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 665.15,
   "end": 668.27,
   "text": "فقط خداست که لله غیب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 668.27,
   "end": 670.85,
   "text": "یعنی بیدهی ملکوت کل شی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 670.85,
   "end": 674.51,
   "text": "همه چی غیب و عیان، همه چی و همه چی با اوست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 674.51,
   "end": 676.25,
   "text": "خب چرا به او توکل نکنی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 676.25,
   "end": 678.57,
   "text": "خودت رو بسپر به او ببین زندگیت چی میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 678.57,
   "end": 683.57,
   "text": "به این میگن توحید افعالی. یکی از دوستان به ما گفته که ما دیگه داریم بالا میایم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 683.57,
   "end": 685.57,
   "text": "انقدر میگی توحید، توحید افعالی رفتم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 685.57,
   "end": 689.81,
   "text": "حالا با این وجه، اِمم، مطلب رو، حالا موضوع رو عوض کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 689.81,
   "end": 691.95,
   "text": "پیشنهاد بدید ما حرفی نداریم. رو بخون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 691.95,
   "end": 695.01,
   "text": "انقدر، انقدر موضوعات هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 695.01,
   "end": 702.95,
   "text": "اما انقدر آیات متعدد هنوز پیرامون توحید هست، من دوست داشتم سلسله آیات رو بریم تا آخر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 702.95,
   "end": 706.77,
   "text": "حالا ما در خدمت شما هستیم. واللهم بارک لمولانا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 706.77,
   "end": 710.07,
   "text": "صاحب الزمان. والحمد لله رب العالمين.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 710.07,
   "end": 714.87,
   "text": "صلوات بفرستید. اللهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 714.87,
   "end": 718.37,
   "text": "صل علی محمد و آل محمد و عجل فرجهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}