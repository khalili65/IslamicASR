 },
 "chapters": [
  {
   "index": 0,
   "title": "## توحید افعالی؛ و ما تشاءون إلا أن یشاء الله",
   "start": 21.44,
   "end": 290.72
  },
  {
   "index": 1,
   "title": "## توحید افعالی؛ تا خدا نخواهد نمی‌خواهی",
   "start": 290.72,
   "end": 648.85
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.26,
   "end": 3.5,
   "text": "اللهم صل علی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 3.5,
   "end": 8.14,
   "text": "محمد و آل محمد و عجل فرجهم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 8.14,
   "end": 12.62,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 12.62,
   "end": 16.6,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 16.6,
   "end": 21.44,
   "text": "آیاته. سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 21.44,
   "end": 23.38,
   "text": "یکی دیگه از آیاتی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 23.38,
   "end": 29.72,
   "text": "پیرامون توحید افعالی خیلی زیبا سخن گفته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 29.72,
   "end": 31.78,
   "text": "که حضرت استاد هم در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 31.78,
   "end": 37.42,
   "text": "نکته هفتصد و پنجاه و شش هزار و یک نکته‌شون اشاره به همین آیه دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 37.42,
   "end": 42.44,
   "text": "آیه سی سوره انسانه که من خود نکته رو براتون می‌خونم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 42.44,
   "end": 45.12,
   "text": "حضرت علامه نکته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 45.12,
   "end": 48.58,
   "text": "هفتصد و پنجاه و شش رو این چنین بیان می‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 48.58,
   "end": 54.8,
   "text": "به مقتضای «و ما تشاءون إلا أن یشاء الله»",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 54.8,
   "end": 63.32,
   "text": "این عبارت قرآنیه. یعنی این‌ها هیچی نمی‌خوان مگر اینکه خدا می‌خواد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 63.32,
   "end": 65.74,
   "text": "هرچی می‌خوان خدا می‌خواد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 65.74,
   "end": 67.68,
   "text": "در خصوص کیه؟ بهشتی‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 67.68,
   "end": 72.6,
   "text": "ظاهراً در خصوص اون‌هایی که در بهشت هستن یا اهل ایمان هستن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 72.6,
   "end": 79.28,
   "text": "اما خب اون مصداق اتمش یا تأویل اصلیش خود اهل بیت‌ن که حالا روایتش رو تقدیم می‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 79.28,
   "end": 85.14,
   "text": "خود نکته رو فعلاً بخونیم. به مقتضای «و ما تشاءون إلا أن یشاء الله»",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 85.14,
   "end": 89.16,
   "text": "طالب، ببخشید طلب هر طالب،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 89.16,
   "end": 93.68,
   "text": "طلب هر طالب مثلاً شما طالب بر وزن فاعل دیگه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 93.68,
   "end": 97.44,
   "text": "شما طلب‌کننده‌ای. یه طلبی داری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 97.44,
   "end": 100.4,
   "text": "می‌فرماید طلب هر طالب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 100.4,
   "end": 104.82,
   "text": "مشابه نیل مطلوب است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 104.82,
   "end": 107.66,
   "text": "یعنی اون مطلوب،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 107.66,
   "end": 110.78,
   "text": "اون معشوق، اون محبوب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 110.78,
   "end": 113.86,
   "text": "شما عاشق، او محش-- معشوق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 113.86,
   "end": 120.12,
   "text": "خب؟ شما کسی هستی که خدا شده محبوب شما،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 120.12,
   "end": 123.74,
   "text": "مطلوب شما. اینکه می‌فرماید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 123.74,
   "end": 126.36,
   "text": "مشابه نیل مطلوب است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 126.36,
   "end": 129.98,
   "text": "یعنی یه وجه، یه شبهی داره به اون، یه وجه شبهی به اون داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 129.98,
   "end": 133.42,
   "text": "یعنی او خواسته که تو خواستی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 133.42,
   "end": 136.56,
   "text": "بعد باز به همین وزان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 136.56,
   "end": 139.72,
   "text": "به یه آیه دیگه هم اشارت، اشاره می‌کنه تو همین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 139.72,
   "end": 141.76,
   "text": "نکته و به حکم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 141.76,
   "end": 145.94,
   "text": "«یحبهم و یحبونه» این آیه پنجاه و چهار مائده‌ی بخشی‌ش هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 145.94,
   "end": 148.84,
   "text": "«یحبهم و یحبونه»",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 148.84,
   "end": 153.12,
   "text": "عشق هر محب نتیجه عشق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 153.12,
   "end": 156.72,
   "text": "محبوب است. چقدر زیبا می‌فرماید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 156.72,
   "end": 160.38,
   "text": "این «یحبهم و یحبونه»",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 160.38,
   "end": 162.72,
   "text": "معنیش یعنی چی؟ یعنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 162.72,
   "end": 167.62,
   "text": "خدا این‌ها رو دوست داشت و «یحبونه»",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 167.62,
   "end": 170.64,
   "text": "حالا این‌هام دوست دارن. به این شکله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 170.64,
   "end": 172.4,
   "text": "یعنی اول هندسه‌ش به این شکله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 172.4,
   "end": 177.42,
   "text": "اول خدا عاشق شده که الان شما عاشق شدی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 177.42,
   "end": 180.34,
   "text": "ببین اول می‌زنه به خدا. یه بار تو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 180.34,
   "end": 185.32,
   "text": "نمي‌دونم کدوم یکی از این رادیوها، رادیوهای کذایی داشتیم صحبت می‌کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 185.32,
   "end": 187.88,
   "text": "در همین آیه رو من",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 187.88,
   "end": 191.04,
   "text": "اشاره قرار دادم بر همین حرفی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 191.04,
   "end": 193.9,
   "text": "حرف دلی که بعضا مدعا می‌گن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 193.9,
   "end": 198.08,
   "text": "امام حسین اول به تو سلام داده تو داری جواب سلامش رو میدی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 198.08,
   "end": 201.96,
   "text": "این حرف دلیه، درسته اما منبع قرآنی داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 201.96,
   "end": 204.5,
   "text": "سرچشمه‌ش قرآنه. اینو گفتم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 204.5,
   "end": 210.26,
   "text": "بعد چقدر پیامک داده بودن که این حرفو ما همش می‌شنیدیم باور نمی‌کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 210.26,
   "end": 213.12,
   "text": "این ریشه قرآنی‌شه. واقعاً اینطوریه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 213.12,
   "end": 216.06,
   "text": "اون‌ها به ما سلام می‌دن ما جواب سلام می‌دیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 216.06,
   "end": 220.66,
   "text": "به وزان همین آیه. او می‌خواد که ما بخوایم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 220.66,
   "end": 223.14,
   "text": "او عاشق می‌شه که ما عاشق می‌شیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 223.14,
   "end": 226.0,
   "text": "اگه اینطوری نگاه کنی آدم دیوانه می‌شه‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 226.0,
   "end": 228.74,
   "text": "یه ذره به این درست فکر کنه و با--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 228.74,
   "end": 236.36,
   "text": "دل بسپره به این حرف جایگاه خودشو پیدا کنه که یعنی واقعاً این چنینه که اول امام عصر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 236.36,
   "end": 238.48,
   "text": "یاد من می‌کنه که من یادش می‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 238.48,
   "end": 241.78,
   "text": "بله اصلاً روانشناس‌های امروزم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 241.78,
   "end": 243.52,
   "text": "همین رو برداشتن بال و پرش دادن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 243.52,
   "end": 247.74,
   "text": "می‌گن آقا تو به هرچی فکر کنی به هر کسی فکر کنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 247.74,
   "end": 251.2,
   "text": "همون لحظه اون شخص به تو فکر می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 251.2,
   "end": 256.04,
   "text": "این ریشه قرآنی داره. حالا یا او ابتدا کرده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 256.04,
   "end": 261.32,
   "text": "که تو داری یادش می‌کنی یا شما ابتدا کردی که او داره یاد می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 261.32,
   "end": 265.78,
   "text": "اما در خصوص آل الله و خدا که قطعاً اول اونا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 265.78,
   "end": 268.86,
   "text": "در بقیه موارد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 268.86,
   "end": 271.7,
   "text": "ما نمی‌تونیم تشخیص بدیم من اول یاد کردم یا اون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 271.7,
   "end": 275.52,
   "text": "این اصل قطعیه. شما هر کسی رو یاد کنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 275.52,
   "end": 279.46,
   "text": "اگر شما ابتدا کرده باشی اونم یادت می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 279.46,
   "end": 284.78,
   "text": "دلش یاد شما می‌کنه. و لو تو قوه خیالش یک آن شما میای میری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 284.78,
   "end": 290.72,
   "text": "و بالعکس. حالا بحث روانشناسیشو الان نمی‌خوایم روانشناختیشو بگیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 290.72,
   "end": 294.8,
   "text": "پس این توحید افعالیه که تا خدا نخواد تو نمی‌خوای.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 294.8,
   "end": 299.32,
   "text": "تا خدا یادت نکنه تو نمی‌تونی یادش کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 299.32,
   "end": 302.1,
   "text": "اصلاً برگی از درخت نمیفته مگر به اذن الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 302.1,
   "end": 308.2,
   "text": "«ولا رطب ولا یابس إلا في كتاب مبین».",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 308.2,
   "end": 310.58,
   "text": "این یک اصل قطعیه. حالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 310.58,
   "end": 313.28,
   "text": "در طول اراده الرب،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 313.28,
   "end": 315.62,
   "text": "در طول اراده خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 315.62,
   "end": 318.98,
   "text": "سلسله مراتب هرچی انسان پاک‌تر باشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 318.98,
   "end": 325.22,
   "text": "در این سلسله مراتب رتبه‌ش میره بالاتر تا جایی که می‌شه مصداق اصلی و اتم این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 325.22,
   "end": 328.06,
   "text": "خواستن بشه خود حضرت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 328.06,
   "end": 337.3,
   "text": "بشه اهل بیت عصمت و طهارت و حضرت عجل صالح المهدی که دیگه تنها امامی‌ست که الان با بدن عنصری در بین ما هستن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 337.3,
   "end": 339.54,
   "text": "بقیه دیگه بدن عنصری اینجا ندارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 339.54,
   "end": 346.36,
   "text": "فارغ شدن از اینجا. مثلا در «تأویل الآيات الظاهرة في فضائل العترة الطاهرة»",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 346.36,
   "end": 353.84,
   "text": "همین امروز صبح می‌خوندم ذیل همین «یحبهم و یحبونه» میاره که «ذكر أبو علی--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 353.84,
   "end": 356.92,
   "text": "أبو علی الطبرسی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 356.92,
   "end": 360.88,
   "text": "فی تفسیره» می‌گه مرحوم طبرسی تو تفسیرش میاره که چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 360.88,
   "end": 364.16,
   "text": "«قال إن المعنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 364.16,
   "end": 367.59,
   "text": "به» معنی این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 367.59,
   "end": 369.79,
   "text": "\"یحبهم و يحبونه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 369.79,
   "end": 374.55,
   "text": "هو امیر المؤمنین علیه السلام و أصحابه\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 374.55,
   "end": 378.87,
   "text": "این معنیش امیرالمؤمنین و اصحابشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 378.87,
   "end": 382.23,
   "text": "کیا-- کی-- کدوم؟ کدوم قسمتش؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 382.23,
   "end": 385.95,
   "text": "اینکه خدا این‌ها رو دوست داره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 385.95,
   "end": 388.01,
   "text": "که اون‌ها هم خدا رو دوست دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 388.01,
   "end": 390.43,
   "text": "میگه امیرالمؤمنین و اصحابش‌م.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 390.43,
   "end": 395.17,
   "text": "خدا عاشق ایناست که این‌ها هم عاشق شدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 395.17,
   "end": 399.63,
   "text": "سلام علیکم احمد. در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 399.63,
   "end": 407.27,
   "text": "ت- تفسیر اهل بیت جلد هفده، صفحه دویست و هفتاد و دو از امام هادی علیه الصلاة والسلام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 407.27,
   "end": 410.15,
   "text": "روایت میاره ذیل اون آیه سی انسان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 410.15,
   "end": 419.61,
   "text": "همون \"و ما تشاؤون إلا أن یشاء الله إن الله جعل قلوب الأئمة موردًا لإرادته فإذا شاء الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 419.61,
   "end": 427.95,
   "text": "شيئا شاءوه\". فرمود که خدای منّان دل‌های ائمه رو محل اراده خودش قرار داده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 427.95,
   "end": 432.87,
   "text": "بچه بودیم به ما می‌گفتن این‌ها حجت خداند، مظهر خداند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 432.87,
   "end": 436.23,
   "text": "بعد اومدیم بالاتر گفتن اینا اراده الرب‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 436.23,
   "end": 437.81,
   "text": "خیلی حرف عمیق‌تریه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 437.81,
   "end": 441.57,
   "text": "یعنی چه اراده الرب‌اند؟ یعنی خدا اراده کنه اینا اراده کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 441.57,
   "end": 444.47,
   "text": "آناً. اصلاً اراده اینا اراده خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 444.47,
   "end": 449.11,
   "text": "در طول اراده خداست. یعنی مظهر توحید افعالی می‌شن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 449.11,
   "end": 454.09,
   "text": "انسان هم می‌تونه به اونجا، ماها می‌تونیم به اونجاها برسیم که در طول اون اراده البته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 454.09,
   "end": 458.11,
   "text": "\"و ما تشاؤون إلا أن یشاء الله\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 458.11,
   "end": 460.37,
   "text": "بعد اشاره به همین آیه می‌کنه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 460.37,
   "end": 467.79,
   "text": "پس \"إن الله جعل قلوب الأئمه موردًا لإرادته فإذا شاء شيئا شاءوه وهو قوله الله\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 467.79,
   "end": 470.87,
   "text": "اشاره به همین آیه می‌کنه. که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 470.87,
   "end": 473.67,
   "text": "این دیگه اوج توحید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 473.67,
   "end": 479.03,
   "text": "افعالیه. در تفسیر اهل بیت، جلد هفده دو مرتبه، صفحه دویست و هفتاد و چهار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 479.03,
   "end": 482.27,
   "text": "یه روایت هم از امام رضا بخونم خیلی شیرین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 482.27,
   "end": 484.99,
   "text": "ذیل همین آیه. به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 484.99,
   "end": 489.99,
   "text": "شخصی به نام یونس، امام رعوف فرمودن که \"قال الله يا ابن آدم\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 489.99,
   "end": 492.79,
   "text": "داره به من و شما میگه. خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 492.79,
   "end": 494.83,
   "text": "امام رضا داره میگه خدا فرمود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 494.83,
   "end": 503.31,
   "text": "تو قرآن نیست این فرمایش. اما حضرت که می‌فرماید \"بمشيئتی كنت أنت الذي تشاء\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 503.31,
   "end": 509.53,
   "text": "ای فرزند آدم به خواست منه که تو چیزی رو می‌خوای.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 509.53,
   "end": 514.15,
   "text": "این مستقیم دیگه زده تو خال همون مطلبی که ما داریم میگیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 514.15,
   "end": 517.97,
   "text": "هرچی تو می‌خوای خواست منه که تو می‌خوای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 517.97,
   "end": 521.03,
   "text": "\"وبقوتي أديت إلي",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 521.03,
   "end": 524.13,
   "text": "فرائضی\". به قوت منه که تو داری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 524.13,
   "end": 526.83,
   "text": "واجباتتو، فرائضتو انجام میدی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 526.83,
   "end": 531.13,
   "text": "\"وبنعمتی قويت على معصيتي\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 531.13,
   "end": 537.83,
   "text": "این به سبب نعمتیه که من به تو دادم تو اصلاً قوت گرفتی بتونی گناه کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 537.83,
   "end": 543.95,
   "text": "یعنی پس ببین همون که گفتم گناهکار هم باز به قوه الهی داره گناه می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 543.95,
   "end": 548.23,
   "text": "خدا اگر نمی‌خواست ما بتونیم گناه کنیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 548.23,
   "end": 550.61,
   "text": "ما نمی‌تونستیم گناه کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 550.61,
   "end": 553.99,
   "text": "خواسته که بتونیم اما اراده نکرده که ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 553.99,
   "end": 557.95,
   "text": "گناه کنیم. خواسته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 557.95,
   "end": 560.17,
   "text": "خب خیلی عالیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 560.17,
   "end": 564.87,
   "text": "\"وجعلتک سميعًا بصيرا قويًا\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 564.87,
   "end": 566.63,
   "text": "خدا می‌فرماید ای بنده من!",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 566.63,
   "end": 571.51,
   "text": "من تورو سميع و بصیر و قوي آفریدم و قرار دادم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 571.51,
   "end": 575.89,
   "text": "همش از منه. چشمتو از منه، گوشتو از منه، قوتت از من.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 575.89,
   "end": 578.33,
   "text": "\"فما أصابك من حسنة فمني\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 578.33,
   "end": 580.55,
   "text": "هرچی حسنه بهت میاد از منه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 580.55,
   "end": 584.11,
   "text": "\"وما أصابك من سيئة فمن نفسك\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 584.11,
   "end": 587.55,
   "text": "اما هرچی بدی میاد حواست باشه که از خودته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 587.55,
   "end": 590.51,
   "text": "دیگه خودت گردن خدا ننداز بدی‌ها رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 590.51,
   "end": 593.23,
   "text": "به حول و قوه الهی داری انجام میدیا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 593.23,
   "end": 596.19,
   "text": "اما خودت خواستی، خواستش با توئه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 596.19,
   "end": 598.31,
   "text": "حالا اون سؤال رو چکار کنیم بالاخره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 598.31,
   "end": 604.61,
   "text": "جمله آخر. که بالاخره مثلاً آقای قاضی سقف داشت می‌ریخت فرار نکرد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 604.61,
   "end": 608.07,
   "text": "این کار غیر عقلیه ظاهراً.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 608.07,
   "end": 612.01,
   "text": "جوابش تو همین آیه است. خدا نخواست که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 612.01,
   "end": 619.95,
   "text": "ایشون فرار کنه. خدا-- ببین انقدر انسان بزرگ می‌شه که در طول اراده، اراده خدا حرکت می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 619.95,
   "end": 623.27,
   "text": "شما هم هر وقت شده آقای قاضی فرار نمی‌کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 623.27,
   "end": 626.55,
   "text": "یعنی اگر خدا خواسته باشه که فرار نکنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 626.55,
   "end": 629.45,
   "text": "توجه کردید چی شد؟ اراده خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 629.45,
   "end": 633.75,
   "text": "خدا می‌خواد که آقای قاضی بلند نشه فرار کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 633.75,
   "end": 635.85,
   "text": "چون به اون مرحله رسیده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 635.85,
   "end": 639.15,
   "text": "به اون کمال و به اون شدت عقل رسیده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 639.15,
   "end": 642.17,
   "text": "من و شما هم اگه برسیم اینطوری می‌شیم آقا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 642.17,
   "end": 643.97,
   "text": "والحمد لله رب العالمين.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 643.97,
   "end": 648.85,
   "text": "صلوات ختم کنیم. اللهم صل على محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}