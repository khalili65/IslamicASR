 "chapters": [
  {
   "index": 0,
   "title": "## پایان جلسات توحید افعالی؛ انتقال به مسجد بلال",
   "start": 13.02,
   "end": 163.08
  },
  {
   "index": 1,
   "title": "## قرآن‌سوزی؛ آزاد شدن شیاطین و مژدهٔ ظهور",
   "start": 163.08,
   "end": 194.5
  },
  {
   "index": 2,
   "title": "## جنگ دوازده‌روزه؛ حماسه و آرزوی نبرد زمینی",
   "start": 194.5,
   "end": 663.59
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.9,
   "end": 4.82,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 4.82,
   "end": 7.82,
   "text": "السلام علیک یا داعی الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 7.82,
   "end": 11.02,
   "text": "و ربانی آياته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 11.02,
   "end": 13.02,
   "text": "السلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 13.02,
   "end": 18.66,
   "text": "این آخرین جلسه‌ای است که بنده امروز در خدمت شما هستم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 18.66,
   "end": 24.34,
   "text": "و چون از شنبه دیگه نماز هم مسجد بلال هستم نمی‌تونم اینجا بحث‌های",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 24.34,
   "end": 29.2,
   "text": "توحید افعالی رو داشته باشیم تا انشاالله به امید خدا بعد از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 29.2,
   "end": 33.0,
   "text": "ماه مبارک رمضان و سال جدید تا ببینیم خدا چی می‌خواد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 33.0,
   "end": 36.42,
   "text": "اصلاً توفیقش باشه یا نه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 36.42,
   "end": 40.72,
   "text": "به صورت کلی نکته‌ای رو امروز عرض کنم پیرامون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 40.72,
   "end": 46.1,
   "text": "بحث توحید افعالی. ببینید بر اساس آیه الله ولی الذین آمنوا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 46.1,
   "end": 48.62,
   "text": "یخرجهم من الظلمات الی النور",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 48.62,
   "end": 51.2,
   "text": "چون دلالت بر استمرار داره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 51.2,
   "end": 53.82,
   "text": "فعل مضارعه یخرجهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 53.82,
   "end": 58.22,
   "text": "این آن فع آن مفسرین فرمودند که پروردگار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 58.22,
   "end": 64.5,
   "text": "منّان اخراج می‌کنه اهل ایمان رو از ظلمت‌ها به نور.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 64.5,
   "end": 71.48,
   "text": "همینطور در مقابلش هم که همیشه تقابل حق و باطل و خیر و شر وجود داشته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 71.48,
   "end": 80.28,
   "text": "همچنین هم اولیاء طاغوت که والذین کفروا أولياؤهم الطاغوت یخرجونهم من النور الی الظلمات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 80.28,
   "end": 84.7,
   "text": "این هم باز آن فع آن در حال اخراج از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 84.7,
   "end": 92.94,
   "text": "نور به سمت ظلمت‌ها هستند و مصادقش هم که تا دلتون بخواد الان در زمان خودمون داریم می‌بینیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 92.94,
   "end": 99.46,
   "text": "یعنی همینطور که توحید داره شدت می‌گیره از اون طرف ظلمت و کفر هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 99.46,
   "end": 102.58,
   "text": "شدت می‌گیره. همینطور که ما به سمت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 102.58,
   "end": 105.92,
   "text": "شدت نور در حرکتیم تا انشاالله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 105.92,
   "end": 112.34,
   "text": "اون وجه اتم حضرت حق و نور الله تشریف بیارن که امام عصر هستند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 112.34,
   "end": 118.2,
   "text": "همینطور عرض شود خدمتتون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 118.2,
   "end": 123.28,
   "text": "ظلمت هم شدت می‌گیره و یاران خودش رو پیدا می‌کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 123.28,
   "end": 128.0,
   "text": "و در سرتاسر دنیا به یک معنا میشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 128.0,
   "end": 134.16,
   "text": "یارگیری اتفاق داره می‌افته هم ظلمت به ظلمت هم نور به نور.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 134.16,
   "end": 143.8,
   "text": "و هر چقدر هم که ما به ظهور امام عصر صلوات الله عليه نزدیک می‌شیم چون حکومت حقه حضرت و دو کر-- دولت کریمه آقا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 143.8,
   "end": 150.62,
   "text": "دولت توحید است و توحید ناب است، این اخراج‌ها بیشتر میشه از هر دو حیث.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 150.62,
   "end": 154.58,
   "text": "و من حالا که این بحث رو عرض کردم حالا نمیخواستم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 154.58,
   "end": 158.0,
   "text": "این رو بگم اما الان به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 158.0,
   "end": 161.66,
   "text": "ذهنم متبادر شد و به من منتقل شد اینکه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 161.66,
   "end": 168.46,
   "text": "اتفاقاً با توجه به متاسفانه بحث‌های هجده و نود و هدی و اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 168.46,
   "end": 173.96,
   "text": "قرآن سوزی‌ها و مسجد سوزی‌ها و حسینیه سوزی‌ها مخصوصاً قرآن سوزی‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 173.96,
   "end": 177.4,
   "text": "اینو یک بار دیگه هم حالا یادم نیست در کجا مسجد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 177.4,
   "end": 181.42,
   "text": "بلال بود یا آیت الله ضیائ، حالا در خاطرم نیست کجا عرض کردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 181.42,
   "end": 185.58,
   "text": "باز هم خدمت شما سروران عزیرم عرض می‌کنم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 185.58,
   "end": 189.5,
   "text": "که خدمت شما عرض می‌کنم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 189.5,
   "end": 193.12,
   "text": "از مخصوصاً قرآن سوزی، قرآن سوزی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 193.12,
   "end": 197.56,
   "text": "خیلی زیاد در قران-- در ایران رخ داد و بی‌سابقه بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 197.56,
   "end": 201.84,
   "text": "این منجر به آزاد شدن شیاطین شد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 201.84,
   "end": 207.34,
   "text": "و این آزاد شدن شیاطین یعنی اخراج",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 207.34,
   "end": 211.68,
   "text": "از سمت نور به سمت-- به ظلمت‌ها خیلی شدت گرفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 211.68,
   "end": 214.86,
   "text": "البته از اون طرف، از اون طرف هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 214.86,
   "end": 219.16,
   "text": "لاجرم اخراج از ظلمت‌ها به سمت نور شدت می‌گیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 219.16,
   "end": 223.38,
   "text": "این خودش یک مژده‌ست برای قریب‌الوقوع بودن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 223.38,
   "end": 228.12,
   "text": "ظهور و همچنین زمینه‌سازی ظهور.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 228.12,
   "end": 232.58,
   "text": "اتفاقاً عزیزانی هم که پیرامون جنگ هی سؤال می‌کنند و این‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 232.58,
   "end": 236.8,
   "text": "حالا من قبلاً عرض کرده بودم که امسال مطلقاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 236.8,
   "end": 241.44,
   "text": "جنگ نیست بر اساس حالا بر اساس اون محاسبات نجومی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 241.44,
   "end": 245.1,
   "text": "و البته علوم غریبه و چه و این‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 245.1,
   "end": 249.66,
   "text": "که ما ضمیمه‌اش کردیم. اما با توجه به قرآن سوزی‌ها این رو من",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 249.66,
   "end": 255.4,
   "text": "جای دیگه‌ای عرض نکردم امروز به شما عرض می‌کنم با توجه به اون قرآن سوزی‌ها و اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 255.4,
   "end": 259.82,
   "text": "جنایت‌هایی که در قران-- در ایران متاسفانه صورت گرفت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 259.82,
   "end": 266.46,
   "text": "مطمئن باشید که چون شیاطین مخصوصاً ابالسه دست بالاشون باز شده و میشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 266.46,
   "end": 270.14,
   "text": "مطمئن باشید که این خودش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 270.14,
   "end": 276.22,
   "text": "باعث میشه که اون جنگی که ما گفتیم اوایل سال بعد قراره اتفاق بیفته زودتر رخ بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 276.22,
   "end": 278.56,
   "text": "این رو هم عرض کنم خدمتتون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 278.56,
   "end": 288.76,
   "text": "یعنی یقیناً این جنگ جلو می‌افته به جهت اینکه جنگ ما، جنگ بعدی، جنگ همه ایمان با همه کفره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 288.76,
   "end": 291.62,
   "text": "و این رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 291.62,
   "end": 294.08,
   "text": "هم بدونید که یهود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 294.08,
   "end": 296.8,
   "text": "خیلی در ریخته شدن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 296.8,
   "end": 301.88,
   "text": "خون بچه‌های نابالغ حریصه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 301.88,
   "end": 304.36,
   "text": "به جهت اینکه ریخته شدن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 304.36,
   "end": 308.98,
   "text": "خون بچه‌ای که نابالغه مخصوصاً دختر بچه‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 308.98,
   "end": 313.74,
   "text": "که اینا پاک و معصومن در غزه ببینید چه کر-چه کردن اینا همه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 313.74,
   "end": 316.34,
   "text": "هدفمند انجام شده و میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 316.34,
   "end": 320.28,
   "text": "این‌ها هم به شدت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 320.28,
   "end": 323.44,
   "text": "دست و بال شیاطین رو باز می‌کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 323.44,
   "end": 328.96,
   "text": "و به یک معنا میشه گفت اخراج از ظلمت‌ها به نور صورت می‌گیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 328.96,
   "end": 334.24,
   "text": "به همین خاطر اصلاً شدت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 334.24,
   "end": 342.6,
   "text": "اخراج‌ها با توجه به زمینه‌ی خودش که اگر، اگر بخواهیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 342.6,
   "end": 346.58,
   "text": "اخراج از سمت نور به ظلمت بگیریم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 346.58,
   "end": 350.68,
   "text": "زمینه‌ش میشه قرآن سوزی، میشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 350.68,
   "end": 357.74,
   "text": "خون بچه‌ها مخصوصاً دختر بچه‌های پاک و معصوم نابالغ رو ریختن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 357.74,
   "end": 362.47,
   "text": "باعث می‌کنه که بتونن فجایع خودشون رو پیاده کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 362.47,
   "end": 367.07,
   "text": "و الان همین کار داره صورت می‌گیره و در جنگ بعدی هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 367.07,
   "end": 370.33,
   "text": "حالا نگار نکنید که این پس فطرت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 370.33,
   "end": 372.65,
   "text": "این سگ زرد آمریکایی هی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 372.65,
   "end": 377.03,
   "text": "اعلام می‌کنه که ما شما مردم ایران رو کمک می‌کنیم، با شما کاری نداریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 377.03,
   "end": 380.51,
   "text": "ما با دولتون و نمی‌دونم نیروهای نظامی اینا کار داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 380.51,
   "end": 383.01,
   "text": "اینا همش حرافی‌هاییه که می‌کنن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 383.01,
   "end": 387.39,
   "text": "و الا مطمئن باشید اون‌ها به شدت حریص‌اند از ریختن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 387.39,
   "end": 390.19,
   "text": "خون‌های بچه‌های",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 390.19,
   "end": 394.53,
   "text": "پاک و معصوم و نابالغ ایرانی، مخصوصا دختر بچه‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 394.53,
   "end": 398.27,
   "text": "و مطمئن باشید در جنگی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 398.27,
   "end": 402.97,
   "text": "رخ میده در پیش روی ما و دیگه خیلی هم نزدیک شدیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 402.97,
   "end": 406.55,
   "text": "این اتفاق ناگوار رخ داد-- خواهد داد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 406.55,
   "end": 413.25,
   "text": "البته از حیث اخراج از ظلمت‌ها به نور چون ولی ما حضرت حق است و الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 413.25,
   "end": 418.53,
   "text": "اون هم شدت می‌گیره و خودش منجر به نزدیک شدن ظهور حضرت ح--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 418.53,
   "end": 424.47,
   "text": "حضرت حق در قالب قیام امام عصر صلوات الله عليه می‌شه که حق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 424.47,
   "end": 430.73,
   "text": "و الله می‌خواد ظهور کنه که من رآنی فقد رأى الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 430.73,
   "end": 437.97,
   "text": "و البته من خیلی تو جنگ دوازده روزه دیدم این غصه رو شما هم خوردید بعضیاتون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 437.97,
   "end": 440.93,
   "text": "که خیلی ناراحت بودیم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 440.93,
   "end": 443.83,
   "text": "خب دا-- همه جنگ شده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 443.83,
   "end": 445.87,
   "text": "موشک پرانی خب اونم خیلی قشنگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 445.87,
   "end": 452.43,
   "text": "یک واقعاً حماسه عجیبی‌ست که دنیا به حیرت افتاد از عظمت و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 452.43,
   "end": 457.31,
   "text": "اون قدرت تخریب و سرعت و همه چی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 457.31,
   "end": 464.01,
   "text": "فناوری جدیدی که بعضی از این موشک‌ها رو فقط هم ایران داره، هیچ کشور دیگه‌ای نداره که باید دست و بازوی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 464.01,
   "end": 468.97,
   "text": "نیروهای مسلح و مخصوصا هوا فضا رو بوسید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 468.97,
   "end": 472.21,
   "text": "روح امثال سردار حاجی زاده‌ها شاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 472.21,
   "end": 479.43,
   "text": "اما این آه همیشه به دل ما بود که چرا جنگ زمینی نباشد و که ما بریم مثل زمان جنگ خودمون بریم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 479.43,
   "end": 481.89,
   "text": "اصلاً اسرائیل رو تصرف کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 481.89,
   "end": 488.71,
   "text": "بریم به سمت پایگاه‌های آمریکایی تو منطقه و اون‌ها رو تصرف کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 488.71,
   "end": 491.35,
   "text": "بریم اینا، این‌ها از آرزوهای ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 491.35,
   "end": 495.79,
   "text": "حالا به نظر بنده می‌رسه که این نظر بنده هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 495.79,
   "end": 500.13,
   "text": "توش بحث‌های سیاسی هست، یعنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 500.13,
   "end": 503.81,
   "text": "بحث‌های جامعه شناختی و شناسی هست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 503.81,
   "end": 508.59,
   "text": "هم بحث‌های جنگ مدرن و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 508.59,
   "end": 514.05,
   "text": "هم بحث‌های محاسبات نجومی و هم علوم غریبه و هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 514.05,
   "end": 518.13,
   "text": "عرض شود خدمت دوستان که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 518.13,
   "end": 522.61,
   "text": "نویدهایی که مژده‌هایی که مشایخ و اساتیدمون به ما دادن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 522.61,
   "end": 530.37,
   "text": "به شما عرض می‌کنیم که به نظرم می‌رسه که تو جنگ بعدی قطعاً جنگ زمینی هم خواهیم داشت و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 530.37,
   "end": 534.79,
   "text": "باید خودمون رو برای اون هم آماده کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 534.79,
   "end": 537.27,
   "text": "اگر نکته آخر اینکه ببخشید وقتم گذشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 537.27,
   "end": 540.83,
   "text": "ما ظهرها خیلی دوست نداریم که طول بکشه صحبتمون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 540.83,
   "end": 545.43,
   "text": "اگر دوست داریم که انشاالله جنگ بعدی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 545.43,
   "end": 552.59,
   "text": "منجر بشه به-- یعنی متصل بشه به ظهور امام عصر صلوات الله عليه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 552.59,
   "end": 555.85,
   "text": "خودمون رو باید آماده کنیم برای یک جنگ طولانی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 555.85,
   "end": 558.93,
   "text": "حالا هی دیگه زمان نپرسید دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 558.93,
   "end": 561.15,
   "text": "بله زمان نپرسید بله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 561.15,
   "end": 566.11,
   "text": "بله، بله؟ بله زمان خواهشا هی ن--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 566.11,
   "end": 568.19,
   "text": "بعضیا می‌پرسن ما که دیگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 568.19,
   "end": 571.21,
   "text": "وحی وصل به کر نیستیم که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 571.21,
   "end": 574.01,
   "text": "وحی که به ما نمیشه که. حالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 574.01,
   "end": 577.05,
   "text": "ما یه عرض شود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 577.05,
   "end": 583.43,
   "text": "تا حدود سه ماه رو عرض کرده بودیم اما تاب آوری مردم اگر واقعاً دنبال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 583.43,
   "end": 588.65,
   "text": "ظهور امام عصر باشن چه بسا بیشتر بشه، بشه شش ماه چه می‌دونیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 588.65,
   "end": 594.71,
   "text": "ولی جنگ طولانی مدتی رو داریم و اون انشاالله امید-- هرچی ما تاب آوریمون بیشتر بشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 594.71,
   "end": 597.63,
   "text": "ما نزدیک‌تر می‌شیم به ظهور امام عصر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 597.63,
   "end": 603.37,
   "text": "و انشاالله اون توحید افعالی، صفاتی و ذاتی رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 603.37,
   "end": 608.67,
   "text": "پیاده شده در حکومت حق امام عصر هممون خواهیم دید و چشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 608.67,
   "end": 610.97,
   "text": "این بحث کلی بود که پایان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 610.97,
   "end": 614.29,
   "text": "نامه بحث دیباچه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 614.29,
   "end": 617.93,
   "text": "کشکول نور و توحید افعالی در سال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 617.93,
   "end": 621.33,
   "text": "1404 بود که دیگه انشاالله میریم به سمت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 621.33,
   "end": 625.65,
   "text": "بحث‌های معرفت نفسیه هر روز مسجد بلالمون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 625.65,
   "end": 629.59,
   "text": "ممنونم از شما که بنده رو امثال اینجا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 629.59,
   "end": 634.19,
   "text": "تحمل کردید. به خدای بزرگ و منّان همتون رو می‌سپارم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 634.19,
   "end": 636.49,
   "text": "به امید دیدار. والحمد لله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 636.49,
   "end": 642.73,
   "text": "اللهم باریک لمولانا صاحب الزمان والحمد لله رب العالمين.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 642.73,
   "end": 645.35,
   "text": "برای سلامتی امام عصر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 645.35,
   "end": 649.53,
   "text": "و رهبر عزیزمون و همه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 649.53,
   "end": 651.63,
   "text": "زحمتکشان وادی نور.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 651.63,
   "end": 654.77,
   "text": "و انشاالله خ-- به زنده باشیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 654.77,
   "end": 658.13,
   "text": "نابودی اسرائیل و فرو پاشی دولت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 658.13,
   "end": 660.79,
   "text": "ظالم و جائر آمریکا رو ببینیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 660.79,
   "end": 663.59,
   "text": "از نای وجودتون بر محمد و آلش صلو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}