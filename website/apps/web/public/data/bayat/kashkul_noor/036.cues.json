  {
   "index": 7,
   "title": "## برج‌های مشیده بی‌پناه",
   "start": 567.98,
   "end": 673.26
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 1.44,
   "end": 4.94,
   "text": "بسم الله الرحمن الرحیم و به این استعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 4.94,
   "end": 8.88,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 8.88,
   "end": 13.42,
   "text": "آیات. سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 13.42,
   "end": 16.58,
   "text": "تبریک عرض می‌کنم ماه ربیع رو،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 16.58,
   "end": 19.38,
   "text": "ماهی که سرتاسر نور است و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 19.38,
   "end": 22.86,
   "text": "به قول رهبر عزیزمون فداش بشیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 22.86,
   "end": 28.06,
   "text": "بهار زندگیه. این ماه بهار زندگیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 28.06,
   "end": 31.28,
   "text": "متأسفانه عده‌ای آدم‌های",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 31.28,
   "end": 34.2,
   "text": "چه عرض کنیم زبان نفع",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 34.2,
   "end": 37.42,
   "text": "همین‌طور شروع این ماه رو هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 37.42,
   "end": 40.24,
   "text": "حالت عزاداری رو ادامه میدن تا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 40.24,
   "end": 46.94,
   "text": "شهادت امام عسکری به بهانه‌های عجیب و غریبی که نه تاریخ اسلام تأیید می‌کنه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 46.94,
   "end": 50.04,
   "text": "نه عرف اجتماع و این‌ها که حالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 50.04,
   "end": 55.24,
   "text": "متأسفانه قصه کوچه بنی هاشم رو میارن تو همین چند روز در حالی که اصلاً همچین چیزی نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 55.24,
   "end": 57.98,
   "text": "ما یه تحقیقی هم کردیم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 57.98,
   "end": 61.88,
   "text": "حدود چهل روز بعد از شهادت پیغمبر اون اتفاق می‌افته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 61.88,
   "end": 66.26,
   "text": "حالا می‌تونید رجوع کنید تو کانال مرام هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 66.26,
   "end": 69.78,
   "text": "بحث ما در خصوص توحید افعالی بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 69.78,
   "end": 73.38,
   "text": "چنانچه خاطر شریفتون باشه از آرامش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 73.38,
   "end": 77.1,
   "text": "که در قلب اتفاق می‌افته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 77.1,
   "end": 80.48,
   "text": "و قلب هم با ذکر به آرامش می‌رسه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 80.48,
   "end": 85.48,
   "text": "رسیدیم به تجلیات الهیه و گفتیم که تجلیات الهیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 85.48,
   "end": 88.66,
   "text": "اگه کسی بخواد بهش برسه باید بره سراغ توحید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 88.66,
   "end": 92.0,
   "text": "توحید سه رتبه داشت؛ افعالی و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 92.0,
   "end": 96.68,
   "text": "صفاتی و ذاتی. ما الان در توحید افعالی هستیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 96.68,
   "end": 102.52,
   "text": "و چنانچه خاطر شریفتون باشه آیاتی که پیرامون توحید افعالی بود رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 102.52,
   "end": 105.92,
   "text": "داشتیم مرور می‌کردیم. یکی از آیاتی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 105.92,
   "end": 108.44,
   "text": "برید انشاالله مرور کنید، نگاه کنید،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 108.44,
   "end": 116.38,
   "text": "خلوتتون بخونید در خصوص توحید افعالی خیلی زیبا سخن گفته آیه هفتاد و هشت سوره نساءه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 116.38,
   "end": 120.64,
   "text": "ابتدا آیه اینجوری شروع می‌شه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 120.64,
   "end": 125.92,
   "text": "ینما تكونوا یدرککم الموت ولو کنتم فی بروج",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 125.92,
   "end": 129.98,
   "text": "فرمود که ااا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 129.98,
   "end": 133.5,
   "text": "در هر کجایی که باشید ولو در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 133.5,
   "end": 139.58,
   "text": "برج‌های آنچنانی که بپا کردید باشید یدرککم الموت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 139.58,
   "end": 144.04,
   "text": "موت شما را درک می‌کنه. شما نمی‌تونید از موت فرار کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 144.04,
   "end": 147.98,
   "text": "این یکی از آیات محکم الهیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 147.98,
   "end": 151.32,
   "text": "البته خود موت یک شیئه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 151.32,
   "end": 153.34,
   "text": "یک چیزیه که بر ما وارد می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 153.34,
   "end": 161.28,
   "text": "ما قراره بچشیمش. کل نفس ذائقة الموت مثل شربتیه که باید بخوریمش، باید بچشیمش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 161.28,
   "end": 165.08,
   "text": "خوش به حال کسی که این شربت رو قبلاً چشیده باشه کو--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 165.08,
   "end": 170.72,
   "text": "که بشه موت قبل ان تموتو که اون موقع این شربت براش تکراری باشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 170.72,
   "end": 175.68,
   "text": "لذت‌بخش باشه. به یک باره بخواد به این شربت رو بخوره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 175.68,
   "end": 178.9,
   "text": "چون چشیدنیه دیگه و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 178.9,
   "end": 181.78,
   "text": "خلق الموت والحیاة",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 181.78,
   "end": 185.42,
   "text": "هر دو چه حیات چه موت خلق الهین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 185.42,
   "end": 187.58,
   "text": "یک شیء‌اند. جزو اشیاء‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 187.58,
   "end": 196.74,
   "text": "جزو خلائق‌اند. البته لیبلوکم ایکم احسن عملا برای این خلق شدن که خدا ببینه شما کدومتون بهترین اعمال رو دارید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 196.74,
   "end": 199.98,
   "text": "که حالا قبلاً هم گفتیم این احسن اعمال چه عملیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 199.98,
   "end": 202.96,
   "text": "خصوصیتش چیه؟ قبلاً صحبت کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 202.96,
   "end": 211.9,
   "text": "پس این که موت هر کجا باشی ما رو در می‌آورد خودش نگاه به این قصه توحید افعالی رو تقویت می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 211.9,
   "end": 215.3,
   "text": "اولین اتفاقی که توی، توی این موضوع می‌افته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 215.3,
   "end": 218.0,
   "text": "ترس از انسان برداشته می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 218.0,
   "end": 220.06,
   "text": "برعکس‌ها یعنی شما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 220.06,
   "end": 222.08,
   "text": "معمولاً از موت می‌ترسیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 222.08,
   "end": 225.18,
   "text": "هممون. غالباً این شک-- مگر اینکه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 225.18,
   "end": 230.28,
   "text": "س-- جزو ان کن-- فتمی نول موت ان کنتم صادقین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 230.28,
   "end": 233.24,
   "text": "مگر اینکه جز صادقین باشیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 233.24,
   "end": 236.18,
   "text": "که اون‌هایین که ولایت کلیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 236.18,
   "end": 241.12,
   "text": "امیرالمؤمنین رو التزام عملیه دارن بله اونا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 241.12,
   "end": 245.1,
   "text": "عاشق موتن که بهش می‌گن مرحله شهود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 245.1,
   "end": 251.04,
   "text": "انسان رو می‌کشونه تا مرحله عنداللهی که مقام حضرت صدوق شهیده است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 251.04,
   "end": 256.24,
   "text": "عند، عند ربهم یرزقون مقام عنداللهی‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 256.24,
   "end": 258.6,
   "text": "مگر اونا بقیه همه غالباً می‌ترسیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 258.6,
   "end": 264.4,
   "text": "توحید افعالی اولین اثرش برداشتن ترسه، ایجاد شجاعته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 264.4,
   "end": 269.78,
   "text": "چرا؟ چون این اصلاً اتفاق نمی‌افته مگر به حول و قوه الهی دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 269.78,
   "end": 273.56,
   "text": "مخصوصاً موت دست من و شما نیست که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 273.56,
   "end": 276.92,
   "text": "چه بسیار آدم‌هایی که خواستن حتی خودکشی کنن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 276.92,
   "end": 279.34,
   "text": "خودشون رو خواستن بکشن حتی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 279.34,
   "end": 282.54,
   "text": "به ظاهر کشتن اما زنده موندن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 282.54,
   "end": 287.48,
   "text": "موت دست خداست. در یک روایت شریفی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 287.48,
   "end": 291.68,
   "text": "دیدم که امیرالمؤمنین علیه الصلاة والسلام حرکت می‌کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 291.68,
   "end": 295.56,
   "text": "در خلوت دید صدایی پشت سرش میاد برگشت دید قنبره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 295.56,
   "end": 297.68,
   "text": "قنبر غلام مولا بود دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 297.68,
   "end": 302.74,
   "text": "اواخر عمر مثل یه سایه همش دنبال آقا بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 302.74,
   "end": 306.34,
   "text": "و اون لحظه‌ای هم که آقا رو زدن قنبر نبود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 306.34,
   "end": 309.46,
   "text": "خیلی شجاع بود همیشه شمشیرش کشیده بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 309.46,
   "end": 314.14,
   "text": "خلاصه حضرت چون داشت می‌رفت به خلوتگاهش برای مناجات یا هرچی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 314.14,
   "end": 317.38,
   "text": "به قنبر گفت چیه دنبال سر من راه افتادی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 317.38,
   "end": 321.0,
   "text": "عرض کرد که آقا می‌خوام مراقب شما باشم، ملازم شما باشم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 321.0,
   "end": 322.7,
   "text": "خطری شما رو تهدید نکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 322.7,
   "end": 326.98,
   "text": "حضرت فرمود ببینید مقدرات، حکم، قضای الهی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 326.98,
   "end": 331.14,
   "text": "در آسمان اتفاق می‌افته و مشخص می‌شه، محکم می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 331.14,
   "end": 334.4,
   "text": "ان من شيء ان الله عندنا خزائنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 334.4,
   "end": 339.98,
   "text": "خزائن هر چیزیه به حق خصوصاً حکم الهی در آسمانه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 339.98,
   "end": 343.66,
   "text": "وقتی این بخواد پیاده بشه مقدر می‌شه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 343.66,
   "end": 346.8,
   "text": "و ما ننزله الا بقدر معلوم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 346.8,
   "end": 349.02,
   "text": "نازل شدن این حکم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 349.02,
   "end": 351.4,
   "text": "میاد به آسمان پایین میاد به دنیا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 351.4,
   "end": 355.26,
   "text": "اما اون قضای کلی و حکم الهی کجا تنظیم می‌شه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 355.26,
   "end": 364.22,
   "text": "بالا. یعنی تا-- این فرمایش مولاست تا آسمون مقدر نکنه هیچ اتفاقی رو زمین نمی‌افته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 364.22,
   "end": 367.9,
   "text": "پس تا خدا نخواد هیچکس نمی‌تونه به علی آسیب برسونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 367.9,
   "end": 371.78,
   "text": "برو و قمر رفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 371.78,
   "end": 380.72,
   "text": "نگاه رو ببینید. این نگاه اگر از مولا به ما برسه چقدر آرامش ایجاد میکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 380.72,
   "end": 386.54,
   "text": "یه روایتی هم ذیل همین آیه که الان عرض کردم مثلا حالا تا همین جا شما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 386.54,
   "end": 393.6,
   "text": "مقدمه رفتیم به جهت محکم کاری بحث، آیه رو براتون ذیلش یه روایت تقدیم کنم و برای امروز بسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 393.6,
   "end": 397.28,
   "text": "که ذیل این آیات رو-- آیه‌ای که عرض کردیم روایات زیادی هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 397.28,
   "end": 404.24,
   "text": "یکیش رو من از تفسیر اهل بیت علیهم الصلاة والسلام جلد سه، صفحه سیصد و دوازده براتون نوشتم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 404.24,
   "end": 406.42,
   "text": "البته بحار جلد چهل و چهار،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 406.42,
   "end": 412.38,
   "text": "صفحه سیصد و سی هم داره. امام حسین صلوات الله علیه این روایت رو امام صادق فرمودن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 412.38,
   "end": 419.6,
   "text": "متن روایتو براتون ترجمه‌شو می‌خونم، کیف کنید، بخوریدش، نوش جونتون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 419.6,
   "end": 425.78,
   "text": "فرمودن که امام صادق فرمودن هنگامی که امام حسین جد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 425.78,
   "end": 431.08,
   "text": "ما از مدینه حرکت نمود، همون اول یعنی از مدینه به محض اینکه حرکت کرد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 431.08,
   "end": 436.86,
   "text": "گروه‌هایی از جن که مسلمان بودند به حضور امام حسین مشرف شدند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 436.86,
   "end": 439.06,
   "text": "نه فقط تو گودی قتلگاه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 439.06,
   "end": 445.0,
   "text": "که اون زعفر جنی اومد که بعد خدا رحمت کنه یه سری اینا رو خرافه می‌دونستن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 445.0,
   "end": 448.72,
   "text": "روح آقای بروجردی بزرگ شاد، حضرت آقای بروجردی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 448.72,
   "end": 452.12,
   "text": "وقتی زعفر جنی از دیار میاد رفت براش مجلس ختم گرفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 452.12,
   "end": 456.16,
   "text": "یعنی هزار و چند سال، هزار و چند صد سال زنده مونده بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 456.16,
   "end": 458.72,
   "text": "چون اونا می‌دونید اجنه عمرشون هزار ساله است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 458.72,
   "end": 460.92,
   "text": "قدرتشون به مراتب از انسان بیشتره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 460.92,
   "end": 464.42,
   "text": "البته عقلشون کوچولوتره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 464.42,
   "end": 468.34,
   "text": "حالا نه، از مدینه اینا هم ملحق شدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 468.34,
   "end": 472.14,
   "text": "اینو امام صادق صلوات الله علیه ذیل این آیه داره می‌فرمادا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 472.14,
   "end": 474.56,
   "text": "مشرف شدند محضر سید الشهدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 474.56,
   "end": 479.96,
   "text": "و گفتند ای سید ما، این ف-- این صحبتش اجنه با امام حسینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 479.96,
   "end": 483.66,
   "text": "ای سید ما، ما شیعه و انصار تو هستیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 483.66,
   "end": 487.24,
   "text": "هر امری که داری و هرچه می‌خواهی بفرما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 487.24,
   "end": 490.08,
   "text": "به به. اگر تو ما را به قتل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 490.08,
   "end": 497.42,
   "text": "کلیه‌ی دشمنان معرو-مأمور فرمایی و در همین مکان باشی، شما مثلا اینجا بمونی هیچ جا دیگه نری،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 497.42,
   "end": 500.02,
   "text": "ما برای تو کافی می‌خوایم- هستیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 500.02,
   "end": 503.66,
   "text": "یعنی ما برای رسیدن به این مقصود بسیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 503.66,
   "end": 509.78,
   "text": "حالا شما ببینید از سی هزار نفر حداقل تا یک میلیون و هشتصد هزار نفر گفتن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 509.78,
   "end": 514.46,
   "text": "که البته شهید مطهری اینو رد می‌کنه اما بنده میگم نه درست بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 514.46,
   "end": 522.18,
   "text": "به تحقیق میگم. اینطور نیست که هرچی شهید مطهری گفته باشه بگیم ول-ولا بعد هرچی که ایشون گفت ولا غیر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 522.18,
   "end": 526.78,
   "text": "همش درسته و پس دیگه راه اجتهاد و تحقیقو ببندیم دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 526.78,
   "end": 531.46,
   "text": "بله اردوگاه‌هایی که از کربلا برو تا اون سه راهی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 531.46,
   "end": 537.8,
   "text": "کوفه و بصره و کربلا و چه می‌دونم تا خود کوفه اردوگاه‌هایی که رضل الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 537.8,
   "end": 541.06,
   "text": "برای قربت الی الله زده بودند تا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 541.06,
   "end": 544.62,
   "text": "مثلا تو این جهاد سهیم باشن بری بشمری بله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 544.62,
   "end": 547.54,
   "text": "این احتمال وجود داره تا یک میلیون و هشتصد هزار نفر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 547.54,
   "end": 553.62,
   "text": "این اجنه چند تا بودند و چه قدرتی داشتن که گفتن، گفتن همه‌ی اینا رو ما یه تنه حریفیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 553.62,
   "end": 555.98,
   "text": "حالا فرمایش امام حسین رو بخونم و بسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 555.98,
   "end": 558.92,
   "text": "ببینید چقدر عالی آقا جواب داده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 558.92,
   "end": 563.52,
   "text": "فرمودن آیا قرآنی که خدا بر جدم نازل کرده قرائت نکرده‌اید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 563.52,
   "end": 565.68,
   "text": "که می‌فرماید همین آیه را قرائت کردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 565.68,
   "end": 570.16,
   "text": "\"أینما تكونوا يدرککم الموت ولو کنتم في بروج\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 570.16,
   "end": 576.16,
   "text": "اگر هر کجا که باشید حتی تو برج‌ها وقتی موت بیاد شما رو در می‌آورد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 576.16,
   "end": 582.46,
   "text": "کسانی که کشته شدند بر آنها مقرر شده است از خانه و قتلگاهشان بیرون می‌رفتند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 582.46,
   "end": 586.04,
   "text": "اینم یه آیه دیگه‌ست. آیه صد و پنجاه و چهار آل عمران.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 586.04,
   "end": 590.66,
   "text": "بعد حضرت ادامه میدن اگر من در مکان خودم پح-",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 590.66,
   "end": 593.2,
   "text": "همین جا بمانم پس این مردم...",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 593.2,
   "end": 596.8,
   "text": "الله اکبر. خیلی حدیث پرمایه است، خیلی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 596.8,
   "end": 599.0,
   "text": "خودش یه چند تا منبر می‌طلبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 599.0,
   "end": 607.88,
   "text": "نه میگم رد میشم. فرمودن اگر من در مکان خود بمانم پس این مردم چگونه آزمایش خواهند شد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 607.88,
   "end": 610.78,
   "text": "اصلا امتحان بوده این حرکت سید الشهدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 610.78,
   "end": 614.54,
   "text": "و چه کسی در بقعه من که در کربلا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 614.54,
   "end": 617.76,
   "text": "ساکن خواهد شد؟ ببینید توحید افعالی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 617.76,
   "end": 622.04,
   "text": "خدا خواست این اتفاق بیفته. \"إن الله شاء أن يراك قتيلا\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 622.04,
   "end": 624.28,
   "text": "خدا خواست تو رو کشته ببینه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 624.28,
   "end": 627.52,
   "text": "و در صورتی که امام حسین می‌فرماید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 627.52,
   "end": 633.38,
   "text": "در صورتی که خدا در موقع گسترش زمین یعنی که ده ول ارض،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 633.38,
   "end": 641.78,
   "text": "آن بقعه را یعنی کربلا را برای من انتخاب نموده و آن را پناهگاهی، اینایی که اربعین رفتن چرا رفتید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 641.78,
   "end": 650.18,
   "text": "حضرت داره سرشو میگه. آن را یعنی کربلا را پناهگاهی برای شیعیان ما قرار داده و در دنیا و آخرت برای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 650.18,
   "end": 652.18,
   "text": "ایشان محل امن و امان خواهد شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 652.18,
   "end": 658.44,
   "text": "یعنی هرکی پناه ببره به کربلا نه فقط تو دنیا بلکه در آخرت هم امان او خواهد بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 658.44,
   "end": 660.02,
   "text": "هنوز اتفاقی نیفتاده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 660.02,
   "end": 662.04,
   "text": "هنوز نه کربلایی به پا شده نه هیچی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 662.04,
   "end": 664.48,
   "text": "نگاهو ببینید این بهش میگن چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 664.48,
   "end": 671.32,
   "text": "توحید افعالی. لا حول ولا قوه الا بالله العلی العظیم والحمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 671.32,
   "end": 673.26,
   "text": "لله رب العالمين. صلوات ختم کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}