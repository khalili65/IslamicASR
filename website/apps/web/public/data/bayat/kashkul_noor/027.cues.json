 ],
 "cues": [
  {
   "i": 0,
   "start": 0.42,
   "end": 4.3,
   "text": "صلی الله محمد و آل محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 4.3,
   "end": 7.92,
   "text": "و ادع... اللهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 7.92,
   "end": 10.26,
   "text": "صل علی محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 10.26,
   "end": 13.98,
   "text": "و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 13.98,
   "end": 17.44,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 17.44,
   "end": 21.36,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 21.36,
   "end": 26.34,
   "text": "آیات. سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 26.34,
   "end": 28.76,
   "text": "تسلیت عرض می‌کنم به نوبه خودم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 28.76,
   "end": 34.86,
   "text": "روز شهادت امام زین العابدین سید الساجدین سلام الله عليه رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 34.86,
   "end": 39.9,
   "text": "هرچی بگیم زبانمون کوتاهه چه عرض کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 39.9,
   "end": 42.34,
   "text": "واقعا امام سجاد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 42.34,
   "end": 46.6,
   "text": "اگر نبود قصه کربلا به ما نمی‌رسید و اگر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 46.6,
   "end": 52.8,
   "text": "کربلا می‌مرد دیگه شیعه‌ای وجود نداشت، اصلا دینی وجود نداشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 52.8,
   "end": 59.76,
   "text": "یه بخشی رو انتخاب کردم از ص-صحیفه زمردین در سخنان سید الساجدین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 59.76,
   "end": 65.34,
   "text": "می‌دونید که علامه حسن‌زاده یه رس-- حضرت علامه حسن‌زاده علیه رحمة یه رساله دارن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 65.34,
   "end": 68.82,
   "text": "بعضاً در خصوص صحیفه سجادیه و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 68.82,
   "end": 72.96,
   "text": "دعاهای اون سخ-صحت‌های خیلی عالی کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 72.96,
   "end": 75.0,
   "text": "همین امروز جالبه که داشتم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 75.0,
   "end": 79.42,
   "text": "شرح اسفار مل-- حضرت علامه حسن‌زاده رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 79.42,
   "end": 83.0,
   "text": "در جلسه هشتاد و دو گوش می‌دادم صبح،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 83.0,
   "end": 87.5,
   "text": "دیدم ایشون برای چندمین بار فرمودن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 87.5,
   "end": 93.12,
   "text": "این ادعیه مقامات انشایی و مقامات علمی اهل بیته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 93.12,
   "end": 102.0,
   "text": "و فرمودن به این جهت که اهل بیت وقتی صحبت می‌کردن کل الناس بقدر عقولهم به قدر عقل مردم حرف می‌زدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 102.0,
   "end": 105.72,
   "text": "روایات احادیث. اما ادعیه این‌چنینی نبود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 105.72,
   "end": 111.0,
   "text": "در نهان‌خانه غیبشون آنچه که بود در پیشگاه حضرت حق رو می‌کردند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 111.0,
   "end": 118.5,
   "text": "لذا بسیاری از معارف عمیق بلند و دست نیافتنی حتی برای ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 118.5,
   "end": 122.56,
   "text": "در این ادعیه جمع شده. این فرمایش علامه است یه بخشیشو براتون می‌خونم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 122.56,
   "end": 128.18,
   "text": "می‌فرماید بدان که این صحیفه شریف پرتویی از نور مشکات رسالت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 128.18,
   "end": 131.52,
   "text": "و بویی از شمیم باغ امامت است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 131.52,
   "end": 136.9,
   "text": "و سلف صالح از دانشمندان والا و پیشینیان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 136.9,
   "end": 142.56,
   "text": "دیروز آن را به زبور آل محمد صلی الله علیه و آله و سلم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 142.56,
   "end": 146.14,
   "text": "و انجیل اهل بیت علیهم السلام نامیدند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 146.14,
   "end": 152.0,
   "text": "ساهران سخن در بلاغت بیان صحیفه سجادیه به سجده افتادند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 152.0,
   "end": 158.64,
   "text": "و مماشات دانشمندان برجسته گواه بر ناتوانی آنها در پیشگاه آن است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 158.64,
   "end": 164.38,
   "text": "هرکس با ظلمت فکر در پیرامون آسمان صحیفه گردش کند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 164.38,
   "end": 169.0,
   "text": "به شهاب ثاقب از تیرهای خزلان مبتلا شود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 169.0,
   "end": 171.38,
   "text": "بعد دلیل میاره از ابن شهرآشوب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 171.38,
   "end": 173.74,
   "text": "یه روایت خیلی جالبی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 173.74,
   "end": 179.46,
   "text": "می‌فرماید ابن شهرشا-- شهرآشوب حکایت کرد به نزد برخی از بلغای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 179.46,
   "end": 185.14,
   "text": "بصره صحیفه کامله سجادیه نام برده شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 185.14,
   "end": 188.5,
   "text": "از اون طرف بلیغ بود،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 188.5,
   "end": 192.5,
   "text": "فصیح بود. گفتن یه همچین کتابی هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 192.5,
   "end": 198.46,
   "text": "وی گفت آماده شوید تا بر شما همانند صفی-- صحیفه را املا کنم، املا کنم یعنی بنویسم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 198.46,
   "end": 205.06,
   "text": "منم بلدم. آنگاه قلم برداشت و سرش رو پایین انداخت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 205.06,
   "end": 209.2,
   "text": "سر را بالا نیاورد تا جان به جان آفرین تسلیم کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 209.2,
   "end": 211.72,
   "text": "این روایتو ابن شهرآشوب میاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 211.72,
   "end": 218.62,
   "text": "علامه می‌فرماید قسم به جان خودم اندیشه‌ای نادرست بود و به غضب الهی دچار شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 218.62,
   "end": 221.08,
   "text": "مگه کسی می‌تونه صحیفه بنویسه که؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 221.08,
   "end": 226.2,
   "text": "اینا مقامات علمی‌اند. البته اینو بگم که هرچی که در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 226.2,
   "end": 229.42,
   "text": "ادعیه اومده برگرفته از قرآنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 229.42,
   "end": 233.78,
   "text": "همین در باب توحید افعالی که داشتیم صحبت می‌کردیم گفتیم یکی از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 233.78,
   "end": 236.16,
   "text": "نشانه‌هاش در قرآن همون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 236.16,
   "end": 238.54,
   "text": "ذکر شریف قرآنیه ماشاءالله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 238.54,
   "end": 244.58,
   "text": "حالا بعضیا دیدم بعد اشتباه داشتن می‌گفتن یا نوشته بودن ماشاءالله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 244.58,
   "end": 246.34,
   "text": "لا قوه الا بالله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 246.34,
   "end": 249.28,
   "text": "تمام. ذکرش اینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 249.28,
   "end": 251.78,
   "text": "اون لا حولا نداره. العلی العظیم نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 251.78,
   "end": 254.14,
   "text": "اونا تو ادعیه اومده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 254.14,
   "end": 258.9,
   "text": "تو قرآن اینه. اتفاقا روایتش هم که بعضیا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 258.9,
   "end": 262.7,
   "text": "اومدن پرسیدن دیروز گفتم براتون میارم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 262.7,
   "end": 266.66,
   "text": "روایتش اینه. حالا اصلاً چی شد که ما به اینجا رسیدیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 266.66,
   "end": 271.02,
   "text": "بحث توحید افعالی بود که هرچی خدا بخواد همون میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 271.02,
   "end": 273.78,
   "text": "هرچی. واقعا هرچی خدا بخواد بله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 273.78,
   "end": 277.16,
   "text": "یه فرمایش دارن امیرالمؤمنین خیلی عجیبه این فرمایش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 277.16,
   "end": 281.6,
   "text": "عرفت الله قابل توجه کسایی که می‌خوان خدا رو بشناسن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 281.6,
   "end": 286.16,
   "text": "از کجا بشناسن؟ عرفت الله مولامون علی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 286.16,
   "end": 289.96,
   "text": "داره می‌فرماید که عرفت الله من خدا را شناختم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 289.96,
   "end": 293.2,
   "text": "به چی شناختی ای مولا؟ به فسخ العظائم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 293.2,
   "end": 295.38,
   "text": "به فسخ کردن اراده‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 295.38,
   "end": 297.92,
   "text": "هرچی خدا بخواد همون میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 297.92,
   "end": 305.28,
   "text": "یه فرمایش از امام صادق صلوات الله علیه هست خیلی جالبه که می‌فرماید هرچی برای مؤمن پیش بیاد خیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 305.28,
   "end": 310.32,
   "text": "اگر بدنش رو با قیچی قیچی همینطوری ریز ریز کنن براش خیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 310.32,
   "end": 315.24,
   "text": "اگر مالک شرق و غرب عالم هم بشه براش خیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 315.24,
   "end": 320.24,
   "text": "بعد امام صادق ابتدای این روایت می‌فرماید من در شگفتم، در تعجبم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 320.24,
   "end": 327.0,
   "text": "خدا با مؤمن چگونه رفتار می‌کنه که هرچه براش پیش میاره خیر قرار می‌ده در دنیا و آخرت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 327.0,
   "end": 333.6,
   "text": "ما چون خیرش رو نمی‌دونیم اصطلاحا حکیم نیستیم، حکمت نداریم، باطنش رو نمی‌دونیم نق می‌زنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 333.6,
   "end": 336.7,
   "text": "ای بابا خدا فقط ما رو گیر آوردی و فلان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 336.7,
   "end": 339.16,
   "text": "طفلی خدا، خدای مظلوم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 339.16,
   "end": 343.5,
   "text": "خدای غریب. به زبان خودمون میگیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 343.5,
   "end": 345.54,
   "text": "حالا فرمایش حضرت اینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 345.54,
   "end": 349.72,
   "text": "حالا قطعاً دیدید تو مفاتیح هم شیخ عباس اشاره داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 349.72,
   "end": 355.14,
   "text": "امام صادق صلوات الله علیه فرمود در شگفتم برای کسی که از چهار چیز بیم داره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 355.14,
   "end": 357.3,
   "text": "و به چهار کلمه پناه نمی‌بره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 357.3,
   "end": 360.86,
   "text": "ما هممون از این چهار چیز بیم داریم آقا تعارف نداریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 360.86,
   "end": 363.04,
   "text": "من اول بگم این چهار چیز چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 363.04,
   "end": 365.82,
   "text": "یکیش فرمود بیم از دنیا داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 365.82,
   "end": 371.78,
   "text": "میخواد دنیاشو بسازه و دوست-- طالب دنیاست و زیبایی‌های دنیا رو دوست داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 371.78,
   "end": 375.84,
   "text": "همه ما دوست داریم. چاخان نگیم هممون می‌خوایم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 375.84,
   "end": 381.5,
   "text": "دومیش پس فرمود که اندوهگین باشه، غم‌زده باشه، غم و اندوه گرفته‌تش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 381.5,
   "end": 387.0,
   "text": "دل ما هممون غمگینه. سومیش ترسه که همه داریم، خائفیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 387.0,
   "end": 392.86,
   "text": "چهارمیش هم مکر و حیله‌ست. به شدت از طرف دشمنان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 392.86,
   "end": 397.04,
   "text": "دنیا، اسلام بگیرید تا ریز به-- در نتیجه بیاین تا پایین،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 397.04,
   "end": 400.68,
   "text": "تو همین اداره خودمونم ما دشمن داریم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 400.68,
   "end": 403.2,
   "text": "و می‌ترسیم که مکر و حیله کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 403.2,
   "end": 406.9,
   "text": "حالا حضرت فرمود از اون کسی که دو-- طالب دنیاست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 406.9,
   "end": 410.92,
   "text": "میگه در تعجبم که پناه چرا نمی‌بره به این ذکر شریفه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 410.92,
   "end": 413.78,
   "text": "ماشاالله لا قوه الا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 413.78,
   "end": 418.78,
   "text": "بالله. تمام. بعد اشاره می‌کنه حضرت می‌فرماید علتش هم تو خود قرآنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 418.78,
   "end": 421.38,
   "text": "اینه که دارم میگم همه ادعیه برگرفته از قرآنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 421.38,
   "end": 424.88,
   "text": "می‌فرماید علتش هم-- علت فرمایش بنده اینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 424.88,
   "end": 429.16,
   "text": "حضرت می‌فرماید که بعدش تو اینو کی بیان می‌کنه قرآن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 429.16,
   "end": 432.48,
   "text": "اون مؤمنه با اون شخصی که دارا بود باغ داشت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 432.48,
   "end": 434.88,
   "text": "مال داشت، فرزند داشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 434.88,
   "end": 438.3,
   "text": "مؤمنه نداشت. نه مال داشت، نه فرزند داشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 438.3,
   "end": 443.14,
   "text": "بحثشون شد. بعد شب تا صبح باغه سوخت و همه از بین رفت دارایی‌ش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 443.14,
   "end": 447.02,
   "text": "بعد این مؤمنه بهش گفت چرا نگفتی ماشاالله؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 447.02,
   "end": 451.0,
   "text": "که اگه گفته بودی ماشاالله لا قوه الا بالله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 451.0,
   "end": 457.92,
   "text": "یعنی در حقیقت مضمونش اینه اتفاق نمی‌افتاد و امید هست که حضرت اشاره می‌کنه به اینجا می‌فرمود اون شخص--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 457.92,
   "end": 460.38,
   "text": "گفت این مؤمنه، گفت امید هست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 460.38,
   "end": 464.32,
   "text": "که خدا به من مال و فرزند بده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 464.32,
   "end": 466.5,
   "text": "که از تو گرفت و به من میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 466.5,
   "end": 469.26,
   "text": "چرا؟ چون من دارم میگم ماشاالله لا قوه الا بالله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 469.26,
   "end": 472.14,
   "text": "این اشاره حضرت به قرآنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 472.14,
   "end": 475.22,
   "text": "بعد فرمود اون کسی که از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 475.22,
   "end": 482.8,
   "text": "غم و غصه می‌ترسه چرا پناه نمی‌بره به ذکر شریف لا اله الا انت سبحانک انی کنت من الظالمین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 482.8,
   "end": 487.1,
   "text": "ذکر یونسیه. بعد حضرت فرمود نمی‌بینید بعدش چی فرموده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 487.1,
   "end": 491.86,
   "text": "فاستجبنا له ونجیناه من الغم وكذلك ننجي المؤمنین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 491.86,
   "end": 495.18,
   "text": "اصلاً علتش اینه. فرمود ترس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 495.18,
   "end": 503.56,
   "text": "تعجبم، در شگفتم کسی که می‌ترسه، ترس وجودشو گرفته پناه نمی‌بره به ذکر شریف حسبنا الله ونعم الوکیل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 503.56,
   "end": 506.48,
   "text": "نه، نه نعم المولى نه. قرآنیش اینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 506.48,
   "end": 508.5,
   "text": "حسبنا الله ونعم الوکیل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 508.5,
   "end": 511.38,
   "text": "تمام. بعد حضرت می‌فرماید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 511.38,
   "end": 514.48,
   "text": "چرا آخ-- دقت نمی‌کنی بعدش تو قرآن چی می‌فرماید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 514.48,
   "end": 519.26,
   "text": "فانقلبوا بنعمة من الله وفضل لم يمسسهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 519.26,
   "end": 522.7,
   "text": "سوء. یه نعمتی خدا بهش میده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 522.7,
   "end": 525.82,
   "text": "از فضلش که اصلاً هیچ بدی دیگه بهش نمی‌رسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 525.82,
   "end": 531.32,
   "text": "خدا بسشه. و اون کسی که می‌ترسه از مکر و حیله دشمن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 531.32,
   "end": 533.5,
   "text": "چرا پناه نمی‌بره به این ذکر؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 533.5,
   "end": 537.76,
   "text": "ففوض امری الى الله ان الله بصير بالعباد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 537.76,
   "end": 542.3,
   "text": "چرا که بعدش می‌فرماید فوقاه الله سيئات ما مكروا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 542.3,
   "end": 547.14,
   "text": "خدا حفظش کرد از بدی اونایی که می‌خوان مکر کنن در حقش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 547.14,
   "end": 549.28,
   "text": "ببین همش هم ریشه‌ش قرآنیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 549.28,
   "end": 551.76,
   "text": "حالا بحث ما اون توحید افعالی بود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 551.76,
   "end": 555.46,
   "text": "که تو ماشاالله تبور پیدا کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 555.46,
   "end": 560.86,
   "text": "چون فرصت گذشته من چند تا روایت خیلی عالی پیرامون عظمت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 560.86,
   "end": 562.82,
   "text": "همین ذکر ماشاالله آورده بودم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 562.82,
   "end": 569.7,
   "text": "یکیشو تقدیم می‌کنم. هرکی دوست داشت ساعت سه عصر اون دو سه تای دیگه هم تقدیم می‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 569.7,
   "end": 573.58,
   "text": "اونم اینه که علامه سنزاده خودش تأکید می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 573.58,
   "end": 576.1,
   "text": "می‌دونید بنده حقیر عادتم اینه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 576.1,
   "end": 581.06,
   "text": "ه-هر چقدرم تو کتاب بزرگان عدت الداعی فلاح السائل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 581.06,
   "end": 584.26,
   "text": "نمی‌دونم، اِ--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 584.26,
   "end": 588.0,
   "text": "اقبال یا قو-- قوت القلوب،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 588.0,
   "end": 595.44,
   "text": "مفتاح الفلاح اینا هر کدوم از اینا هم حتی روایتی در این ادعیه اومده باشه تا یکی از اساتید بزرگان اینو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 595.44,
   "end": 597.88,
   "text": "تأکید و توصیه نکرده باشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 597.88,
   "end": 602.5,
   "text": "بنده نمیگم. به پشتوانه اون‌ها میگم من کیم که بگم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 602.5,
   "end": 605.94,
   "text": "حضرات علامه تأکید دارن بر اینکه دارم میگم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 605.94,
   "end": 612.54,
   "text": "که روایت هم هست البته. فرمودن که امام صادق صلوات الله علیه فرمود اگر کسی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 612.54,
   "end": 619.4,
   "text": "احساس می‌کنه نفسش جسارت می‌کنم خبیث شده، آلوده شده، پلید شده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 619.4,
   "end": 623.06,
   "text": "نمی‌تونه پرواز کنه. حالا این توضیحاتی که من دارم میگم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 623.06,
   "end": 626.18,
   "text": "مضمونشو دارم می‌شکافم یعنی چی نفس خبیث شده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 626.18,
   "end": 628.2,
   "text": "نمی‌تونه پرواز کنه. گیر کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 628.2,
   "end": 631.28,
   "text": "دست و پاش بسته است. سحر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 631.28,
   "end": 635.14,
   "text": "دو رکعت نماز بخونه، بعد دو رکعت نماز شبتم می‌تونی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 635.14,
   "end": 641.12,
   "text": "دو رکعت نماز بخونه و در سجده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 641.12,
   "end": 643.88,
   "text": "همین ذکر شریف ماشاالله رو،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 643.88,
   "end": 646.58,
   "text": "دیگه لا قوه الا بالله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 646.58,
   "end": 649.68,
   "text": "نداره. فقط ذکر شریف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 649.68,
   "end": 652.44,
   "text": "ماشاالله رو چند بار بگه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 652.44,
   "end": 655.3,
   "text": "هفت مرتبه. هفت مرتبe.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 655.3,
   "end": 658.7,
   "text": "نه، اون هزار و چهل و شش اصلاً دستور العملش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 658.7,
   "end": 663.54,
   "text": "بر بر اون برای دنیا و کسی که دنبال می‌خواد دنیاش رونق پیدا کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 663.54,
   "end": 667.76,
   "text": "هزار و چهل و شش مرتبه ماشاالله لا قوه الا بالله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 667.76,
   "end": 674.94,
   "text": "این دستور العمل فقط ماشاالله داره هفت بار در سجده بعد از دو رکعت نماز در سحر چه می‌کنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 674.94,
   "end": 677.28,
   "text": "اِز-- اجازه بدید خود عبارت علامه رو بخونم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 677.28,
   "end": 680.1,
   "text": "می‌فرماید هنوز بلند نشده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 680.1,
   "end": 684.02,
   "text": "تمام اخلاق خبیث شما فرو می‌ریزد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 684.02,
   "end": 687.22,
   "text": "الله اکبر! ببین چه خبره تو این ذکر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 687.22,
   "end": 689.1,
   "text": "ها؟ مگه میشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 689.1,
   "end": 690.76,
   "text": "انجام بده تا ببینی میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 690.76,
   "end": 694.22,
   "text": "بعد از نماز بله دو رکعت نماز در سحر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 694.22,
   "end": 696.06,
   "text": "حالا هر نمازی، مطلقاً دو رکعت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 696.06,
   "end": 699.08,
   "text": "نماز تموم شد بعد سجده بله نماز تموم شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 699.08,
   "end": 701.22,
   "text": "بله نماز تموم شد. سلام دادید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 701.22,
   "end": 704.36,
   "text": "در سجده هفت بار ماشاالله، ماشاالله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 704.36,
   "end": 707.94,
   "text": "یعنی هرچی خدا بخواد. همه چی دست خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 707.94,
   "end": 714.36,
   "text": "البته با توجه البته تو روایت تأکید امام صادق توجه کنه به اینکه چی داره میگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 714.36,
   "end": 716.1,
   "text": "والحمد لله رب العالمين.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 716.1,
   "end": 720.64,
   "text": "صلوات بفرستید. الله الله صلي على محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}