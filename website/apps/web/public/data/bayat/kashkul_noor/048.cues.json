 },
 "chapters": [
  {
   "index": 0,
   "title": "## توحید افعالی در آیهٔ یونس؛ شمس و قمر",
   "start": 16.08,
   "end": 210.16
  },
  {
   "index": 1,
   "title": "## تأویل روایی؛ شمس پیامبر و قمر علی",
   "start": 210.16,
   "end": 322.42
  },
  {
   "index": 2,
   "title": "## فاصلهٔ نجومی و اعتبار زمان",
   "start": 322.42,
   "end": 542.82
  },
  {
   "index": 3,
   "title": "## توحید افعالی؛ همه جعل از خداست",
   "start": 542.82,
   "end": 589.72
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 3.62,
   "end": 7.1,
   "text": "بسم الله الرحمن الرحیم و به این استعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 7.1,
   "end": 12.56,
   "text": "السلام علیک ای داعی الله و ربانی ایاته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 12.56,
   "end": 16.08,
   "text": "سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 16.08,
   "end": 19.08,
   "text": "در آیه پنج سوره حضرت یونس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 19.08,
   "end": 23.18,
   "text": "علی النبي و آله و عليه الصلاة والسلام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 23.18,
   "end": 27.7,
   "text": "باز اشاره خیلی زیبا و قشنگ به توحید افعالی داره که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 27.7,
   "end": 30.92,
   "text": "هو الذي جعل الشمس ضياء.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 30.92,
   "end": 34.02,
   "text": "او کسی‌ست که خدا خودش رو داره اینطوری معرفی می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 34.02,
   "end": 38.22,
   "text": "کسیه که خورشید رو به شدت نورانیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 38.22,
   "end": 42.88,
   "text": "قرار داده، جعل کرده. جعل الشمس ضياء.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 42.88,
   "end": 45.3,
   "text": "و ق-والقمر نورا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 45.3,
   "end": 48.48,
   "text": "خیلی جالبه. نور رو زده به قمر،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 48.48,
   "end": 51.34,
   "text": "ضياء رو زده به شمس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 51.34,
   "end": 53.62,
   "text": "در قرآن از شمس یا به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 53.62,
   "end": 56.5,
   "text": "ضياء یا بهش سراج یاد شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 56.5,
   "end": 59.06,
   "text": "یعنی شدت نور، منبع نور.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 59.06,
   "end": 62.26,
   "text": "که ذاتاً نور داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 62.26,
   "end": 63.9,
   "text": "از جایی نور رو نمی‌گیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 63.9,
   "end": 68.12,
   "text": "عین، عین ذاتشه به یک معنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 68.12,
   "end": 71.08,
   "text": "اما نور رو یا منیر رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 71.08,
   "end": 73.18,
   "text": "زده به چی؟ به قمر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 73.18,
   "end": 76.3,
   "text": "چرا؟ چون قمر نورش از خودش نیست که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 76.3,
   "end": 78.38,
   "text": "این ضعف نوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 78.38,
   "end": 80.9,
   "text": "البته نسبت به اون شدت نور،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 80.9,
   "end": 85.28,
   "text": "ضعفا. و الا خودش خیلی نور داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 85.28,
   "end": 87.06,
   "text": "که پس نور رو زده به قمر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 87.06,
   "end": 89.42,
   "text": "اینم یکی از معجزات قرآنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 89.42,
   "end": 92.42,
   "text": "که نور از خود قمر نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 92.42,
   "end": 95.24,
   "text": "هرچه هست از خورشیده. قمر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 95.24,
   "end": 98.12,
   "text": "از او می‌گیره. خب این تا اینجا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 98.12,
   "end": 102.98,
   "text": "و قدره منازل لتعلموا عدد السنين والحساب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 102.98,
   "end": 106.42,
   "text": "اصلاً این رو برای این خدا مقدر کرده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 106.42,
   "end": 110.0,
   "text": "این قرارداد رو، این اعتبار رو جعل کرده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 110.0,
   "end": 117.18,
   "text": "برای اینکه شما تو حساب کتابتون، معیشتتون، شبانه روز کردنتون، نظم در زندگیتون، حساب و اینا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 117.18,
   "end": 119.26,
   "text": "بتونید درست عمل کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 119.26,
   "end": 121.9,
   "text": "از یه جا شروع کنید به یه جا ختم کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 121.9,
   "end": 125.88,
   "text": "اینو از مقدرات حضرت حق برمی‌شماره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 125.88,
   "end": 128.44,
   "text": "ما خلق الله ذلک الا بالحق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 128.44,
   "end": 131.34,
   "text": "میگه اینچی که خدا می‌بینید خلق کرده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 131.34,
   "end": 133.64,
   "text": "خلق نکرده مگر به حق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 133.64,
   "end": 138.98,
   "text": "حالا این جالب، جالب توجه برای اون‌هاییه که معتقدند روز قیامت خورشید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 138.98,
   "end": 140.74,
   "text": "اذا الشمس کوبرت رو می‌گیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 140.74,
   "end": 144.28,
   "text": "یعنی نابودی خورشید. یا زمین می‌پاچه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 144.28,
   "end": 146.24,
   "text": "خدا انگار یه بمب هسته‌ای میزنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 146.24,
   "end": 148.94,
   "text": "این حرفا چیه؟ بالحق. این حق है.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 148.94,
   "end": 152.36,
   "text": "یعنی چی نابود می‌شه؟ اون باید تأویلش رو پیدا کرد که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 152.36,
   "end": 155.54,
   "text": "خدمت دوستان بعدازظهر یه روز عرض کردیم یعنی چی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 155.54,
   "end": 160.14,
   "text": "این‌ها هست تا خدا هست دار هستی هم برقراره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 160.14,
   "end": 166.72,
   "text": "و ظاهر اسم حضرت حقه و این عالم داره ظهور میده اسماء الهی و هست تا هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 166.72,
   "end": 171.42,
   "text": "همینطور آدم پشت آدم، دوره پشت دوره، کره پشت کره میان و میرن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 171.42,
   "end": 174.86,
   "text": "ما هم یک دوره هستیم. بعد می‌فرماید که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 174.86,
   "end": 177.74,
   "text": "یفصل الآیات. این تفصیل خیلیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 177.74,
   "end": 182.28,
   "text": "بعضی وقت‌ها آدم ابهام میگه، ابهام‌گویی می‌کنه، اجمال‌گویی می‌کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 182.28,
   "end": 186.98,
   "text": "یا کلی میگه میره یه چیزی رو وارد به جزئیات نمی‌شه، طرف متوجه نمی‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 186.98,
   "end": 189.8,
   "text": "خب چیکار کنم حالا؟ آقا آدم خوبی باش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 189.8,
   "end": 192.64,
   "text": "خب چه جوری، چه گونه من خوب باشم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 192.64,
   "end": 195.4,
   "text": "چه کنم که خوب باشم؟ تفصیل بگو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 195.4,
   "end": 197.26,
   "text": "آ-- جزئی‌سازی کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 197.26,
   "end": 200.22,
   "text": "می‌فرماید یفصل الآیات لقوم يعلمون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 200.22,
   "end": 203.8,
   "text": "برای اونایی که اهل البته علمن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 203.8,
   "end": 206.12,
   "text": "يعلمون. آگاهن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 206.12,
   "end": 209.74,
   "text": "برای اون‌ها ما تفصیل‌گویی هم داریم، بله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 209.74,
   "end": 213.3,
   "text": "حالا در تفسیر اهل بیت جلد شش،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 213.3,
   "end": 215.76,
   "text": "صفحه چهارصد و بیست و چهار،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 215.76,
   "end": 220.28,
   "text": "در معانی الاخبار هم صفحه صد و پونزده این روایت رو می‌تونید ببینید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 220.28,
   "end": 223.16,
   "text": "خیلی شیرینه. من این روایت رو تقدیم می‌کنم بعد اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 223.16,
   "end": 224.82,
   "text": "منظور اصلیم رو بیان می‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 224.82,
   "end": 227.88,
   "text": "اینو به جهت این میگم زاهقتون شیرین بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 227.88,
   "end": 233.56,
   "text": "که جابر بن عبدالله از پیغمبر عزیز عالم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 233.56,
   "end": 238.68,
   "text": "ذیل این آیه فرمودند که پیغمبر فرمود: ابتدوا بالشمس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 238.68,
   "end": 243.42,
   "text": "ابتدا کنید به شمس. فإذا غابت الشمس فاقتدوا بالقمر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 243.42,
   "end": 247.96,
   "text": "وقتی شمس غائب شد به ماه ابتدا کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 247.96,
   "end": 251.16,
   "text": "فإذا غابت القمر فاقتدوا بالزهرة.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 251.16,
   "end": 257.5,
   "text": "وقتی ماه غائب شد به زهرة یا به اون زهره، ستاره زهره، سیاره زهره ابتدا کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 257.5,
   "end": 261.6,
   "text": "فإذا غابت الزهرة فاقتدوا بالفرقدین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 261.6,
   "end": 264.46,
   "text": "وقتی اونم غائب شد ابتدا کنید به فرقدین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 264.46,
   "end": 267.94,
   "text": "اشاره به دو تا ستاره قطبی है.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 267.94,
   "end": 270.46,
   "text": "فقالوا یا رسول الله فما الشمس؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 270.46,
   "end": 273.16,
   "text": "وما القمر؟ وما الزهرة؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 273.16,
   "end": 274.84,
   "text": "وما الفرقدان؟ اینا چی‌ان؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 274.84,
   "end": 277.12,
   "text": "اینا کی‌ان که شما فرمودید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 277.12,
   "end": 279.72,
   "text": "فقال أنا الشمس. به به، به.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 279.72,
   "end": 281.52,
   "text": "پیغمبر فرمود خورشید منم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 281.52,
   "end": 284.3,
   "text": "یعنی همه نور پیش منه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 284.3,
   "end": 288.06,
   "text": "وعلی یوم القمر. ماه امیرالمؤمنینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 288.06,
   "end": 290.1,
   "text": "که نورشو از پیغمبر گرفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 290.1,
   "end": 293.14,
   "text": "معلام هرچی داره از پیغمبره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 293.14,
   "end": 297.02,
   "text": "والزهرة فاطمة. سلام الله علیها حضرت زهرا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 297.02,
   "end": 300.7,
   "text": "زهره‌ست. والفرقدان الحسن والحسن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 300.7,
   "end": 304.84,
   "text": "به به. اون دو تا ستاره‌ای که تشبیه شده بهش،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 304.84,
   "end": 307.56,
   "text": "صورت قطبی. اون امام حسن، امام-- می‌فرماید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 307.56,
   "end": 310.7,
   "text": "هر کدوم از اینا رو دیدی بهشون ابتدا کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 310.7,
   "end": 314.48,
   "text": "توجه کردین؟ این خواستم خدمتتون عرض کنم که یه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 314.48,
   "end": 316.66,
   "text": "ورق زده باشیم باطن آیه رو دیده باشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 316.66,
   "end": 319.88,
   "text": "حالا چه ربطی به توفی-توحید افعالی داره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 319.88,
   "end": 322.18,
   "text": "می‌فرماید که آقا ببینید من یه مثالی بزنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 322.18,
   "end": 325.26,
   "text": "الان فاصله زمین تا آسمون چقدره، تا خورشید چقدره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 325.26,
   "end": 328.04,
   "text": "زمین تا خورشید. صد و پنجاه میلیون کیلومتر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 328.04,
   "end": 330.38,
   "text": "چقدر طول می‌کشه با سرعت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 330.38,
   "end": 334.64,
   "text": "سیصد هزار کیلومتر در ثانیه نور از خورشید به زمین برسه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 334.64,
   "end": 336.98,
   "text": "هشت دقیقه. درسته؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 336.98,
   "end": 341.16,
   "text": "حالا حساب کنید ما ستاره‌هایی داریم مثل پروکسیما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 341.16,
   "end": 344.66,
   "text": "یا آلفا. اینا فاصله‌شون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 344.66,
   "end": 347.58,
   "text": "دقیقشو بخواید از زمین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 347.58,
   "end": 353.22,
   "text": "سه میلیارد و پونصد و هفتاد و چهار کیلومتر فاصله‌شونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 353.22,
   "end": 357.64,
   "text": "که اگر زمانی که بخواد اون س-نور با اون سرعتش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 357.64,
   "end": 364.58,
   "text": "بخواد از اون، از اون ستاره بیاد برسه به زمین گفتن چهار سال و شش ماه طول می‌کشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 364.58,
   "end": 366.72,
   "text": "حالا شما ف-- حساب کنید یه اعتباره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 366.72,
   "end": 371.62,
   "text": "ما اومدیم گفتیم سالمون رو بر اساس گردش زمین دور خورشید تعیین میکنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 371.62,
   "end": 376.32,
   "text": "شده این ساعت و ماه و هفته و ماه و سالی که داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 376.32,
   "end": 380.04,
   "text": "درسته؟ حالا شما بیا بگه اگر بگیم آقا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 380.04,
   "end": 385.08,
   "text": "زمان برای ما اینطوری مقدر بشه، تعیین بشه، اعتبار بشه، جعل بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 385.08,
   "end": 390.2,
   "text": "اونجا فرمود تو آیه چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 390.2,
   "end": 394.08,
   "text": "این زمان رو اینطوری برامون تبیین کنیم که وقتی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 394.08,
   "end": 399.32,
   "text": "زمین ما بگرده دور اون سیاره آلفا یا پروکسیما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 399.32,
   "end": 401.44,
   "text": "چقدر طول میکشه به نظر شما؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 401.44,
   "end": 403.6,
   "text": "خیلی. یعنی من که بشه چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 403.6,
   "end": 408.14,
   "text": "یه سال ما. حالا شما میگی آقا از جهت شبانه روز که فرق نمیکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 408.14,
   "end": 417.1,
   "text": "چه هشت دقیقه، چه چهار سال و نیم وقتی خورشید نورش رسید به زمین دیگه پرتو تابش پشت سرش داره میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 417.1,
   "end": 420.56,
   "text": "باز به گردش زمین وضعی دور خودش بستگی داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 420.56,
   "end": 423.06,
   "text": "باز شبانه روز همون بیست و چهار ساعت ما میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 423.06,
   "end": 426.72,
   "text": "میگیم اگر زمین وسعتش بیشتر از این بود چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 426.72,
   "end": 429.71,
   "text": "جعل زمین هم توسط حضرت حق شده دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 429.71,
   "end": 435.54,
   "text": "در هر حال این ز-این زمان رو شما بگیرید اگر چه زمین وسعت پیدا میکرد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 435.54,
   "end": 441.16,
   "text": "چه خورشید اعتباری ما میشد ستاره آلفا یا پروکسیما و امثاله،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 441.16,
   "end": 443.6,
   "text": "چه زمانی میخواست به خودش اختصاص بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 443.6,
   "end": 446.26,
   "text": "حالا ف-- ستاره‌هایی هستند که اصلا دیده نمیشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 446.26,
   "end": 451.34,
   "text": "ما یک بیلیون ستاره داریم که با تلسکوپ قوی دیده شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 451.34,
   "end": 453.78,
   "text": "با چشم غیر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 453.78,
   "end": 461.68,
   "text": "حالا بگیم مسلح گفتن که چهار هزار ستاره رو شما نگاه کنی بتونی بشمری میتونی بشمری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 461.68,
   "end": 469.2,
   "text": "این ستاره‌ها تازه در آسمان یا فلک هشتم‌اند که معروفه به ستارگان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 469.2,
   "end": 473.88,
   "text": "ثوابت. تو ثابت میبینی اما به شدت در حرکتند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 473.88,
   "end": 476.8,
   "text": "موافق اون فلک نهمه که اطلس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 476.8,
   "end": 479.78,
   "text": "الف تا لام سین نقطه نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 479.78,
   "end": 483.26,
   "text": "اصلا هیچی دیده نمیشه. هیچی انتهاش دیده نمیشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 483.26,
   "end": 491.58,
   "text": "این تازه نشئه طبیعته. شما بگیرید اگر اون ستاره‌ای که ما فرض کردیم خورشید انقدر فاصله داره، اینطوری تصور کنید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 491.58,
   "end": 494.08,
   "text": "که زمان برای ما بشه اول،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 494.08,
   "end": 498.42,
   "text": "اول شروع دوره ما بشه اول ز-- روز ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 498.42,
   "end": 503.76,
   "text": "آخرش بشه آخری که وقتی زمین داره میچرخه دور اون سیاره، اون انتها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 503.76,
   "end": 505.94,
   "text": "داره میچرخه بشه آخر دوره ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 505.94,
   "end": 508.14,
   "text": "نمیشه؟ این امکان وجود داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 508.14,
   "end": 511.22,
   "text": "پس اصلا زمان برداشته میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 511.22,
   "end": 513.26,
   "text": "اصلا زمان دیگه معنا نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 513.26,
   "end": 516.4,
   "text": "اونایی که میگن چگونه است که در عالم برزخ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 516.4,
   "end": 519.18,
   "text": "یا در نشئه پس از مرگ زمان برداشته میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 519.18,
   "end": 521.18,
   "text": "الان یه مثال کوچولو زدیم متوجه شدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 521.18,
   "end": 524.36,
   "text": "پس شدنیه، میشه. این زبان اعتبار ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 524.36,
   "end": 527.9,
   "text": "این زمانی که ما داریم میگیم اعتبار ماست به واسطه خورشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 527.9,
   "end": 530.52,
   "text": "این زمان دهر میشه؟ بله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 530.52,
   "end": 532.18,
   "text": "زمان دهر میشه؟ احسن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 532.18,
   "end": 535.78,
   "text": "بله دهریه که موافقش میشه سرمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 535.78,
   "end": 541.28,
   "text": "موافق اون دیگه میشه سرمد که دیگه اصلا کسی ازش خبر نداره جز پیغمبر و اولو الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 541.28,
   "end": 545.76,
   "text": "حالا شما اینو الان توجه داشتید توحید افعالی، افعالی اینجا چه حرفی میزنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 545.76,
   "end": 548.4,
   "text": "میگه آقا همه چی رو من دارم وضع میکنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 548.4,
   "end": 552.04,
   "text": "تو چیکاره‌ای این وسط؟ اونقدری برای من حرف میزنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 552.04,
   "end": 554.0,
   "text": "خدا میتونه اینو به بنده اش بگه یا نه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 554.0,
   "end": 556.6,
   "text": "تو چیکاره‌ای؟ همه چی دست منه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 556.6,
   "end": 560.42,
   "text": "زمان هم من برات تب-تبیین کردم، جعل کردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 560.42,
   "end": 562.62,
   "text": "میتونستم یه زمان دیگه‌ای قرار بدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 562.62,
   "end": 565.4,
   "text": "حالا تو دعوا داری با من که رفتی تو برزخ یعنی چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 565.4,
   "end": 571.86,
   "text": "زمان نیست. الان خیلی راحت با یه مقداری با هم کار کردیم تو ستاره‌شناسی متوجه شدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 571.86,
   "end": 576.2,
   "text": "لا حول و لا قوه الا بالله العلی العظیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 576.2,
   "end": 579.96,
   "text": "به واقع اینه. ما باید خیلی رو توحید افعالی‌مون کار کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
