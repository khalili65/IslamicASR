 "chapters": [
  {
   "index": 0,
   "title": "## لا حول ولا قوة إلا بالله؛ رتبهٔ توحید افعالی",
   "start": 19.14,
   "end": 104.46
  },
  {
   "index": 1,
   "title": "## ادامهٔ آیهٔ هفتاد و هشت نساء",
   "start": 104.46,
   "end": 200.08
  },
  {
   "index": 2,
   "title": "## کل من عند الله؛ انتخاب نفس و حول الهی",
   "start": 200.08,
   "end": 322.32
  },
  {
   "index": 3,
   "title": "## شیطان مجری اسم مذل؛ عزرائیل مجری توفّی",
   "start": 322.32,
   "end": 451.43
  },
  {
   "index": 4,
   "title": "## دارا شدن نه دانا شدن؛ امام خمینی",
   "start": 451.43,
   "end": 560.33
  },
  {
   "index": 5,
   "title": "## جهاد تبیین در معارف نه فقط سیاست",
   "start": 560.33,
   "end": 580.49
  },
  {
   "index": 6,
   "title": "## خلاصه؛ حکمت پیش از موعظه و جدل",
   "start": 580.49,
   "end": 816.03
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 6.64,
   "end": 11.14,
   "text": "بسم الله الرحمن الرحیم و بهین استعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 11.14,
   "end": 15.22,
   "text": "السلام علیک ای داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 15.22,
   "end": 19.14,
   "text": "آیات. سلامٌ علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 19.14,
   "end": 24.62,
   "text": "در توضیحات پیرامون توحید افعالی بودیم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 24.62,
   "end": 27.94,
   "text": "ذکر شریفش چی بود؟ لا حول ولا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 27.94,
   "end": 30.46,
   "text": "قوة الا بالله العلی العظیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 30.46,
   "end": 33.26,
   "text": "که آثار و برکات عجیبی داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 33.26,
   "end": 38.02,
   "text": "اگر کسی توفیقات تقویت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 38.02,
   "end": 41.48,
   "text": "توحید رو در وجودش داشته باشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 41.48,
   "end": 43.22,
   "text": "به تجلیات الهیه می‌رسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 43.22,
   "end": 50.84,
   "text": "اصلاً بحث ما از قلب مطمئن شروع شد و آرامش کجاست و اومد تا اینکه امام حسین در کربلا برای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 50.84,
   "end": 52.72,
   "text": "شهدای کربلا تجلی کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 52.72,
   "end": 55.0,
   "text": "گفتیم اصلاً تجلی چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 55.0,
   "end": 58.06,
   "text": "توضیح دادیم ظهور حقه در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 58.06,
   "end": 63.46,
   "text": "دو وجه و دو حیثیت که بعد اومدیم سمت توحید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 63.46,
   "end": 71.7,
   "text": "که توحید افعالی و صفاتی و ذاتی الان تو رتبه‌ی اول توحید افعالی هستیم که لا حول ولا قوة الا بالله العلی العظیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 71.7,
   "end": 77.16,
   "text": "از مهمات آقا. یعنی اگر کسی به این رتبه‌ی توحید نرسه می‌لنگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 77.16,
   "end": 82.84,
   "text": "توحیدش کامل نیست و اونقدر برزخش مشکل می‌شه عزیزان دلم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 82.84,
   "end": 87.52,
   "text": "برزخش طولانی می‌شه، اذیت می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 87.52,
   "end": 93.04,
   "text": "و این اذیت می‌بینی هفت-- می‌بینی هفت هزار سال طول کشید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 93.04,
   "end": 101.72,
   "text": "برزخش‌ها. لذا ما داریم یه مقدار بیشتر پافشاری می‌کنیم تو بحث توحید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 101.72,
   "end": 104.46,
   "text": "در آیه هفتاد و هشت سوره‌ی نساء بودیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 104.46,
   "end": 108.14,
   "text": "ابتدای آیه رو گفتیم که پیرامون موت بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 108.14,
   "end": 113.28,
   "text": "منتها ادامه‌ی آیه رو براتون می‌خونم ببینید که اصلاً چقدر زیبا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 113.28,
   "end": 115.3,
   "text": "عجیب آقا بوی توحید افعالی می‌ده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 115.3,
   "end": 117.94,
   "text": "یکی از آیات عجیب قرآن است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 117.94,
   "end": 120.32,
   "text": "یعنی من براتون، براتون می‌خونم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 120.32,
   "end": 125.54,
   "text": "متوجه-- مخصوصاً اونایی که سیر بحث رو دنبال کردن بیشتر متعجب می‌شن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 125.54,
   "end": 127.66,
   "text": "حالا خدمتتون عرض می‌کنم چطور.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 127.66,
   "end": 131.0,
   "text": "ادامه‌ی آیه می‌فرماید «وإن تصبهم حسنة»",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 131.0,
   "end": 136.86,
   "text": "وقتی به این‌ها حسنه‌ای می‌رسه «يقولوا هذه من عند الله» این از سمت خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 136.86,
   "end": 140.98,
   "text": "جالبه. یعنی پیداست که یه بویی از توحید بردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 140.98,
   "end": 145.98,
   "text": "چرا؟ «ما أصابك من حسنة فمن الله» دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 145.98,
   "end": 151.96,
   "text": "صریح آیه‌ی قرآن تو سیر بحث عرض کردم این بود که هرچی حسنه به ما می‌رسه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 151.96,
   "end": 155.36,
   "text": "نیست مگر از الله. اینجا اینو اقرار می‌کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 155.36,
   "end": 159.28,
   "text": "وقتی حسنه میاد «هذه من عند الله» درست شد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 159.28,
   "end": 163.5,
   "text": "اشکال کار به کجاست؟ «وإن تصبهم سيئة»",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 163.5,
   "end": 166.32,
   "text": "وقتی سیئه به این‌ها می‌رسه باید چی بگن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 166.32,
   "end": 172.84,
   "text": "بر اساس قرآن بگن چی؟ «ما أصابك من» آفرین «سيئة فمن نفسك»",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 172.84,
   "end": 175.54,
   "text": "از خودته، بدی از خودته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 175.54,
   "end": 178.94,
   "text": "اما این‌ها می‌گن چی؟ «يقولوا هذه من عندك»",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 178.94,
   "end": 181.34,
   "text": "خطاب به کی؟ به پیغمبر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 181.34,
   "end": 187.4,
   "text": "منافقین اینطوری بودن. وقتی سیئه‌ای حتی ورشکستگی مالی، هر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 187.4,
   "end": 189.6,
   "text": "اتفاق ناگواری ظاهراً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 189.6,
   "end": 192.32,
   "text": "رخ می‌داد این‌ها نسبتش می‌دادن پیغمبر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 192.32,
   "end": 194.92,
   "text": "در صورتی هرچی خیر، خوبی از خداست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 194.92,
   "end": 202.0,
   "text": "بدی‌ها از توئه. حالا خدا غیرت نشون-- عجب غیر-- اینی که می‌گم عجیبه، یک غیرتی خدا اینجا به خرج داده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 202.0,
   "end": 206.32,
   "text": "که اجازه بدید من بیشتر از این بازش نکنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 206.32,
   "end": 208.74,
   "text": "یه ذره باید خصوصی‌تر با هم صحبت کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 208.74,
   "end": 211.66,
   "text": "در گوشیه حرفی اینجا. حالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 211.66,
   "end": 214.76,
   "text": "شاید عصری گفتیم. «قل» بگو بهشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 214.76,
   "end": 218.88,
   "text": "«كل من عند الله» این همه حرف در گوشیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 218.88,
   "end": 223.36,
   "text": "همش از خداست. یعنی چی همش از خداست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 223.36,
   "end": 226.94,
   "text": "یعنی «ما أصابك من سيئة»",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 226.94,
   "end": 229.18,
   "text": "مگر قرآن نمیگه «فمن نفسك»",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 229.18,
   "end": 234.8,
   "text": "از جان خودته. «كل من عند الله» یعنی اون هم از خدا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 234.8,
   "end": 237.32,
   "text": "یعنی خدا حرفش منسوخ شد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 237.32,
   "end": 240.8,
   "text": "حرفش برداشته شد؟ نه، سلسله مراتب رو باید دقت کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 240.8,
   "end": 243.34,
   "text": "حالا عرض می‌کنم خدمتتون. «فما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 243.34,
   "end": 247.56,
   "text": "لهاؤلاء القوم» تشر خدا رو ببین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 247.56,
   "end": 251.1,
   "text": "«لا يكادون يفقهون حديثا» چرا یه سری نمی‌خوان بفهمن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 251.1,
   "end": 257.1,
   "text": "«لا يكادون يفقهون» از فهم میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 257.1,
   "end": 259.26,
   "text": "«حديثا». چرا اینا نمی‌خوان؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 259.26,
   "end": 261.64,
   "text": "چرا حرف گوشا نیستن؟ چرا حرف--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 261.64,
   "end": 265.44,
   "text": "نمی‌فهمن چرا اینا؟ چرا انقدر جسارتاً نفهم‌ن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 265.44,
   "end": 270.2,
   "text": "غیرت خدا رو می‌بینی جوشیده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 270.2,
   "end": 272.12,
   "text": "همش «كل من عند الله».",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 272.12,
   "end": 276.96,
   "text": "این حرفا چیه؟ ما گفتیم از نفس توئه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 276.96,
   "end": 280.1,
   "text": "اما نفس تو فقط انتخاب می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 280.1,
   "end": 285.24,
   "text": "به حول و قوه منه. انتخاب با توئه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 285.24,
   "end": 291.06,
   "text": "مثل اینکه دزد، بارها گفتیم دزد میره دزدی به حول و قوه الهی میره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 291.06,
   "end": 293.76,
   "text": "یا به حول و قوه خودش میره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 293.76,
   "end": 296.58,
   "text": "به حول و قوه الهی میره دزدی می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 296.58,
   "end": 299.56,
   "text": "اونم «كل من عند الله» آقا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 299.56,
   "end": 304.1,
   "text": "نگاه کن قصه رو درست. ولی انتخاب با خودشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 304.1,
   "end": 310.22,
   "text": "نسبت به اینکه چه اسمی داره پیاده می‌شه تعریف می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 310.22,
   "end": 312.44,
   "text": "حیثیت از اینجا تعریف می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 312.44,
   "end": 315.0,
   "text": "چه حیثیه؟ خیره یا شره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 315.0,
   "end": 321.7,
   "text": "انتخاب با توئه. چه اسمی از خدا-- والا کلاً اسماء الهی داره پیاده، پیاده می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 321.7,
   "end": 323.32,
   "text": "اصلاً شما خود شما کی هستی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 323.32,
   "end": 325.66,
   "text": "اصلاً شیطان آقا بالاتر از دیگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 325.66,
   "end": 328.64,
   "text": "از حیث شر دیگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 328.64,
   "end": 331.0,
   "text": "شروره دیگه. بلکه شریره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 331.0,
   "end": 334.64,
   "text": "بدتر از شرور. بدتر از شریره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 334.64,
   "end": 337.92,
   "text": "شریره. خب؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 337.92,
   "end": 342.6,
   "text": "این ملعون خبیث الی الابد البته بهتره بگیم لعنت الله عليه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 342.6,
   "end": 347.2,
   "text": "چون ما، ما بهتره لعن نکنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 347.2,
   "end": 349.98,
   "text": "آیا اون هم کلمة الله نیست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 349.98,
   "end": 353.2,
   "text": "آیا اون هم مجری اسم مذل حضرت حق نیست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 353.2,
   "end": 356.1,
   "text": "«إن الله يهدي من يشاء ويضل»",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 356.1,
   "end": 360.58,
   "text": "هیچ اسمی از اسامی حضرت حق پیاده نمی‌شه مگر اینکه مجری داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 360.58,
   "end": 363.52,
   "text": "مجری اسم. آیا خدا مذل هست یا نه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 363.52,
   "end": 366.43,
   "text": "یکی از اسامی خداست دیگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 366.43,
   "end": 368.85,
   "text": "حالا ما احتراماً میگیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 368.85,
   "end": 372.55,
   "text": "رها کننده. خدا رها میکنه طرف رو با",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 372.55,
   "end": 378.61,
   "text": "احتراماً میگیم و الا درست تو راه گمراه میکنه آقا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 378.61,
   "end": 380.43,
   "text": "خب از چه طریقی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 380.43,
   "end": 384.09,
   "text": "از طریق مجرا. مجرا شیطان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 384.09,
   "end": 386.91,
   "text": "ولی کی گمراه کرد؟ خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 386.91,
   "end": 389.57,
   "text": "از چه طریقی؟ شیطان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 389.57,
   "end": 391.59,
   "text": "کی گمراه کرد؟ خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 391.59,
   "end": 395.37,
   "text": "از چه طریقی؟ نفس حضرت عالی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 395.37,
   "end": 400.39,
   "text": "ببینید برای اینکه بهتر متوجه بشیم، یه جا هست قرآن فرمود الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 400.39,
   "end": 403.47,
   "text": "يتوفى الأنفس حين موتها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 403.47,
   "end": 406.57,
   "text": "والتي لم تمت في منامها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 406.57,
   "end": 410.57,
   "text": "چه اون کسی که خوابیده، چه کسی که میمیره رو يتوفى الأنفس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 410.57,
   "end": 412.99,
   "text": "کی؟ الله. درسته؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 412.99,
   "end": 416.57,
   "text": "اینو همه می-- قبول داریم دیگه. خداست که میکشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 416.57,
   "end": 421.81,
   "text": "خداست که میخوابونه. اینطوری میفهمیم از آیه دیگه خودمونیش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 421.81,
   "end": 424.87,
   "text": "پس چطور یه جا دیگه میفرماید و يتوفهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 424.87,
   "end": 429.73,
   "text": "الملائكة. اون وفات،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 429.73,
   "end": 431.95,
   "text": "اون کسی که وفات رو به این‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 431.95,
   "end": 435.49,
   "text": "میاره ملائکه اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 435.49,
   "end": 438.77,
   "text": "مگه عزرائیل اینجا چیکار هست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 438.77,
   "end": 442.43,
   "text": "دقت کردید چی شد؟ مجری عزرائیله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 442.43,
   "end": 445.03,
   "text": "در سلسله طولیه‌",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 445.03,
   "end": 448.57,
   "text": "همه چی به اذن الله. کل من عند الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 448.57,
   "end": 450.61,
   "text": "این نگاه توحید افعالیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 450.61,
   "end": 457.07,
   "text": "به نظر شما اگر کسی به این برسه واقعاً نه مثل من علم فکریش باشه و از رو کاغذ برای شما بخونه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 457.07,
   "end": 460.67,
   "text": "و اینا نه، واقعاً برسه دارا بشه نه دانا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 460.67,
   "end": 463.83,
   "text": "بچشه این رو چه بلایی سرش میاد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 463.83,
   "end": 466.35,
   "text": "چه بلای عشقی سرش میاد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 466.35,
   "end": 471.53,
   "text": "میشه امام خمینی. میگه همه عالم جلوی من وایسن من یه تنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 471.53,
   "end": 474.61,
   "text": "حرف حق رو میزنم و راه حق رو میرم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 474.61,
   "end": 478.75,
   "text": "سر سوزنی‌ام نه می‌ترسم، نه ترسیدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 478.75,
   "end": 483.13,
   "text": "که حضرت آیت الله آقای شهید اشرافی اصفهانی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 483.13,
   "end": 484.99,
   "text": "شهید مهرا بارها عرض کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 484.99,
   "end": 487.31,
   "text": "ایشون فرمودن این اصلاً معجزه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 487.31,
   "end": 492.15,
   "text": "این معجزه است که یه شخصی پیدا شه قسم به لفظ جلاله اونم توی اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 492.15,
   "end": 495.91,
   "text": "جایگاه قسمت. طاهیتل و معصومن دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 495.91,
   "end": 500.45,
   "text": "کسی سر سوزنی از این‌ها گناه و معصیت بلکه کراهت ندید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 500.45,
   "end": 504.01,
   "text": "خدا رحمت کنه حضرت الله آقای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 504.01,
   "end": 507.05,
   "text": "علامه حسن زاده علیه رحمة الله الرضوان رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 507.05,
   "end": 510.59,
   "text": "که در خصوص رهبر عزیز فرمودن وقتی افتادم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 510.59,
   "end": 515.25,
   "text": "پای رهبر رو ببوسن، دست رهبر رو ببوسن آقا فرمودن نکنین این کار رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 515.25,
   "end": 521.63,
   "text": "فرمودن اگر من یک کراهت از شما تو مدت عمرتون میدیدم این کار رو نمیکردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 521.63,
   "end": 526.23,
   "text": "اینا جلوی هر کسی خم نمیشن که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 526.23,
   "end": 530.63,
   "text": "مبایع مش فضل الله محضرشون بوده گفت پاشید برید بابا پاشید وقت ما رو نگیرید برید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 530.63,
   "end": 533.97,
   "text": "تعارف با کسی ندارن. عمرشون ارزشمنده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 533.97,
   "end": 536.87,
   "text": "طوری نیست که گرده بگیرن حالا بشینید گپ بزنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 536.87,
   "end": 540.43,
   "text": "این حرفا چیه؟ با خدا دارن معامله میکنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 540.43,
   "end": 542.41,
   "text": "آقای اشرافی اصفهانی میگن معجزه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 542.41,
   "end": 550.99,
   "text": "یکی تو اون تراز برده ب-برگرده لفظ جلاله الله استفاده کنه که والله قسم من تو کل عمرم نترسیدم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 550.99,
   "end": 555.07,
   "text": "از هیچی. یه سوتیوز بغل ما می--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 555.07,
   "end": 558.41,
   "text": "رد میشه شیش متر میپریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 558.41,
   "end": 560.33,
   "text": "این اون امام خمینی میسازه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 560.33,
   "end": 563.45,
   "text": "کیا ادعا میکنن ما بسیجی امام-- اولیش خود من.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 563.45,
   "end": 567.03,
   "text": "بسیجی ایم آقا. ما رهرو راه ولایتیم بفرمایید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 567.03,
   "end": 569.93,
   "text": "چرا تو توحید افعالی رهرو نیستیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 569.93,
   "end": 572.69,
   "text": "چرا تو توحید صفاتی رهرو نیستیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 572.69,
   "end": 575.99,
   "text": "چرا تو توحید ذاتی نیستیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 575.99,
   "end": 580.49,
   "text": "چرا تو این چیزا نیستیم؟ فقط تو تحلیل سیاسی و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 580.49,
   "end": 585.19,
   "text": "نمی‌دونم این زد و بندهای سیاسی و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 585.19,
   "end": 587.21,
   "text": "جریانات اجتماعی و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 587.21,
   "end": 590.07,
   "text": "جریان شناسی اجتماعی رو چپ و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 590.07,
   "end": 594.03,
   "text": "جلوی راست قرار بدی، راست و جلوی اون سنتی و نمی‌دونم چی و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 594.03,
   "end": 600.31,
   "text": "از این مزخرفات و وقت بیهو-- خودت رو بگیری بیهوده عمرت رو به بطالت بدی بره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 600.31,
   "end": 602.09,
   "text": "تو این چیزا ولایی هستیم ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 602.09,
   "end": 605.03,
   "text": "جهاد تبیین فقط تو بحث‌های سیاسیه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 605.03,
   "end": 607.49,
   "text": "فلانی خیانت کرد، فلانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 607.49,
   "end": 615.43,
   "text": "نمی‌دونم چیکار کرد، این اون به اون جسارت کرد، این بحث‌های مزخرف بیخوده که هیچ سودی هم به حال ما نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 615.43,
   "end": 619.53,
   "text": "به من چه که فلانی چی گفت و چیکار کرد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 619.53,
   "end": 623.51,
   "text": "جهاد تبیین آیا در حوزه معارف نیست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 623.51,
   "end": 628.55,
   "text": "آیا بعد از چهل و شش سال گذشته از انقلاب نباید یه تحولی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 628.55,
   "end": 631.65,
   "text": "اساسی در حوزه معارف رخ بده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 631.65,
   "end": 635.97,
   "text": "نباید؟ آیا امام شرق و غرب عالم رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 635.97,
   "end": 640.15,
   "text": "به، بله به صحیفه و قرآن دعوت کرد اما قبلش به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 640.15,
   "end": 647.25,
   "text": "شیخ الرئیس و آثارش، به ملا صدرا و آثارش، به محی الدین عربی و آثارش دعوت کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 647.25,
   "end": 650.61,
   "text": "کدوم یکی از ما یه کتاب از اینا خوندیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 650.61,
   "end": 654.03,
   "text": "آیا حوزه تبیین در حوزه معارف نیست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 654.03,
   "end": 664.91,
   "text": "خود حضرت آقا اخیراً نفرمودن در حوزه معارف بسیار حرف‌ها گ-- داریم نگفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 664.91,
   "end": 668.13,
   "text": "حالا خسته میشید بین دو نماز هم هست وقت ما هم گذشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 668.13,
   "end": 671.39,
   "text": "خلاصه‌ش چی شد؟ لا حول و لا قوه الا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 671.39,
   "end": 673.65,
   "text": "بریم یه ذره فکر کنیم رو این آیه что عرض کردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 673.65,
   "end": 678.33,
   "text": "هفتاد و شش سوره نساء. کل من عند الله آقا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 678.33,
   "end": 681.61,
   "text": "شوخی نیست. اصلاً دیگه اینجا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 681.61,
   "end": 683.35,
   "text": "خیر و شر معنا پیدا نمیکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 683.35,
   "end": 686.15,
   "text": "هرچی پیش آید خوش آید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 686.15,
   "end": 688.11,
   "text": "اصلاً نگاه رو عوض میکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 688.11,
   "end": 689.79,
   "text": "سبک زندگی رو تغییر میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 689.79,
   "end": 693.07,
   "text": "به خدا قسم کسی بیفته تو وادی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 693.07,
   "end": 695.23,
   "text": "توحید افعالی تازه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 695.23,
   "end": 696.81,
   "text": "صفاتی و ذاتی پیشکش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 696.81,
   "end": 699.77,
   "text": "بیفته تو همین رتبه اول توحید،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 699.77,
   "end": 704.25,
   "text": "چنان مستحکم میشه، حکیم میشه، محکم میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 704.25,
   "end": 706.35,
   "text": "حکومت رو باید سپرد به اینا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 706.35,
   "end": 709.35,
   "text": "و لا يمكن الفرار من حکومتی که از حکمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 709.35,
   "end": 711.89,
   "text": "یسین و قرآن الحکیم از حکمه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 711.89,
   "end": 715.03,
   "text": "از حکمته. عبور از ظاهر به باطنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 715.03,
   "end": 717.69,
   "text": "یه حکیم میتونه تعبیر خواب کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 717.69,
   "end": 721.07,
   "text": "از ظاهر صور و اشکالی که در خواب دیدی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 721.07,
   "end": 724.19,
   "text": "عبور کنه به حقیقت و باطن اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 724.19,
   "end": 727.29,
   "text": "خواب برسه. یه حکیم میتونه که بتونه عبور کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 727.29,
   "end": 730.67,
   "text": "کدوم یکی از ما از ظاهر به باطن عبور کردیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 730.67,
   "end": 734.75,
   "text": "کدوم یکیمون حکیم شدیم؟ کدوم یکیمون؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 734.75,
   "end": 741.21,
   "text": "ختمه که الان یه جمله بگم شاید اذیتتون کنه این جمله اما چه کنم قرآنیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 741.21,
   "end": 746.53,
   "text": "اونجایی که خدای منان به پیغمبرش فرمود این‌ها رو دعوت کن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 746.53,
   "end": 751.47,
   "text": "اول چیزی که خدا اولین-- خب میخوام دعوت کنم همه رو به سمت خود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 751.47,
   "end": 755.45,
   "text": "شما ای خدا چگونه دعوت کنم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 755.45,
   "end": 758.47,
   "text": "ما سریع میریم سراغ اول از همه جدل،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 758.47,
   "end": 760.65,
   "text": "بحث، جدل، دعوا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 760.65,
   "end": 762.23,
   "text": "غلط کردی که قبول نمیکنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 762.23,
   "end": 765.61,
   "text": "به پسرمون، به دخترمون، به جوون دانشجو، به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 765.61,
   "end": 768.55,
   "text": "مرد، به این جوون‌های بیرون. بیخود کردی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 768.55,
   "end": 770.93,
   "text": "با باتوم تو سرش. مثل اوایل ما،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 770.93,
   "end": 773.53,
   "text": "اوایل انقلاب چیکار می‌کردیم با جوون‌ها؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 773.53,
   "end": 776.87,
   "text": "در صورتی که اون تازه میگه و موعظه--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 776.87,
   "end": 779.89,
   "text": "ببخشید و جادلهم بالتی هی احسن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 779.89,
   "end": 783.29,
   "text": "جدل احسن اون آخرین رتبه مرحله‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 783.29,
   "end": 787.39,
   "text": "قبلش چیه؟ خیلی ما هنر کنیم بریم سراغ موعظه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 787.39,
   "end": 790.97,
   "text": "و الموعظة الحسنة وسطه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 790.97,
   "end": 794.77,
   "text": "اول چی رو میفرمود؟ حکمت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 794.77,
   "end": 799.15,
   "text": "می‌فرمود با حکمت اینا رو دعوت کنید با حکمت، به حکمت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 799.15,
   "end": 805.17,
   "text": "حکمت این جنس حرف‌هاییه که ما داریم می‌زنیم که هیچ کدومش مال ما نیست، مال بزرگانه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 214,
   "start": 805.17,
   "end": 807.21,
   "text": "عبور کنیم از ظاهر به باطن یه ذره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 215,
   "start": 807.21,
   "end": 810.09,
   "text": "این بحث رو انشاالله ادامه میدیم یه ذره پخته‌تر بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 216,
   "start": 810.09,
   "end": 812.97,
   "text": "والحمد لله رب العالمين صلوات بفرستید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 217,
   "start": 812.97,
   "end": 816.03,
   "text": "اللهم صل علی محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}