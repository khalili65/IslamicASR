 },
 "chapters": [
  {
   "index": 0,
   "title": "بسم الله الرحمن الرحیم و به نستعین. درود بر داعیِ خدا و ربّانیِ آیاتش.",
   "start": 18.72,
   "end": 60.12
  },
  {
   "index": 1,
   "title": "## توحیدِ صمدی و خطایِ تصوّرِ بیرونی",
   "start": 60.12,
   "end": 292.96
  },
  {
   "index": 2,
   "title": "## ابصار؛ دیدنِ خود در آینهٔ وجود",
   "start": 292.96,
   "end": 447.53
  },
  {
   "index": 3,
   "title": "## اظهارِ ما فی الباطن",
   "start": 447.53,
   "end": 545.21
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 5.24,
   "end": 10.08,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 10.08,
   "end": 14.14,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 14.14,
   "end": 18.72,
   "text": "آیه. سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 18.72,
   "end": 21.12,
   "text": "بارها عرض کردیم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 21.12,
   "end": 25.68,
   "text": "عمده یعنی مهم‌ترین علتی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 25.68,
   "end": 31.0,
   "text": "وجود داره و بزرگان فرمودن در خصوص",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 31.0,
   "end": 37.28,
   "text": "فرقی که بین شهدای کربلا و دیگران هست، دیگر شهدا هست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 37.28,
   "end": 40.86,
   "text": "که اون‌ها سخت‌ترین سختی‌ها رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 40.86,
   "end": 44.42,
   "text": "متحمل شدن به جان خریدن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 44.42,
   "end": 54.76,
   "text": "در حالی که یقین به شهادت داشتن نه فقط بحث شهادت بلکه تمام دارایی‌شون، داشته‌هاشون همه قرار بود غصب بشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 54.76,
   "end": 56.92,
   "text": "غارت بشه. زن و بچه‌شون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 56.92,
   "end": 60.12,
   "text": "یا کشته شن یا به اسارت برن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 60.12,
   "end": 66.36,
   "text": "چون امام سجاد صلی الله علیه که ایام شهادتشون هم هست فرمود سه کار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 66.36,
   "end": 69.36,
   "text": "می‌خواستن با ما بکنن که خدا نگذاشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 69.36,
   "end": 76.34,
   "text": "یکیش این بود که حتی زن و بچه‌های ما رو هم می‌خواستن سر ببرن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 76.34,
   "end": 79.66,
   "text": "این صریح فرمایش امام سجاد صلی الله علیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 79.66,
   "end": 83.44,
   "text": "خدا نگذاشت. توجه کردید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 83.44,
   "end": 85.6,
   "text": "این‌ها این رو می‌دونستن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 85.6,
   "end": 90.52,
   "text": "با علم به این سبقت در شهادت گرفتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 90.52,
   "end": 101.2,
   "text": "علتش چیه؟ علتشو همه بزرگان همیشه هم عرض کردیم اینکه گفتن امام حسین صلی الله علیه برای این‌ها تجلی کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 101.2,
   "end": 104.82,
   "text": "تجلی کرد. ما آخرین صحبتی که در خصوص",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 104.82,
   "end": 110.1,
   "text": "آرامش و ربطش با باطن و قلب و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 110.1,
   "end": 113.24,
   "text": "موضوع ذکر که ارتباطش با",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 113.24,
   "end": 118.86,
   "text": "قلب چگونه است داشتیم صحبت می‌کردیم رسیدیم به بحث تجلی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 118.86,
   "end": 123.9,
   "text": "که گفتیم اصلاً عالم تجلی حضرت حق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 123.9,
   "end": 127.76,
   "text": "که حضرت حق در انسان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 127.76,
   "end": 131.06,
   "text": "یا اصلاً حتی بگیم در انسان هم غلطه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 131.06,
   "end": 134.12,
   "text": "اصلاً تجلی اعظم حق شد انسان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 134.12,
   "end": 136.12,
   "text": "اصلاً بودن انسان،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 136.12,
   "end": 140.36,
   "text": "وجود انسان، موجودیتش،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 140.36,
   "end": 142.54,
   "text": "موجود شدنش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 142.54,
   "end": 145.86,
   "text": "به تجلی اعظم حق بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 145.86,
   "end": 147.78,
   "text": "ما دست کم نباید خودمون رو بگیریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 147.78,
   "end": 151.62,
   "text": "هرچی که بیرون از ماست در ما هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 151.62,
   "end": 155.22,
   "text": "ما وقتی که در نماز می‌ایستیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 155.22,
   "end": 160.22,
   "text": "این استنباط غلط ابتدایی هم از بچگانه بودن ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 160.22,
   "end": 163.14,
   "text": "به نظر من از شما عذرخواهی می‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 163.14,
   "end": 172.52,
   "text": "من نمازم ابتداییه بچگانه است که اینطوری فرض می‌کنم که وقتی می‌ایستم خدا رو روبروی خودم بیرون خارج از خودم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 172.52,
   "end": 177.34,
   "text": "تصور می‌کنم که حالا می‌خوام در برابر او خم و راست بشم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 177.34,
   "end": 181.78,
   "text": "واقعاً توحید صمدی قرآنی که علامه حسن زاده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 181.78,
   "end": 186.82,
   "text": "این همه سرش پافشاری داشت اینه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 186.82,
   "end": 191.74,
   "text": "مگر حدیث نداریم پیغمبر عزیز عالم نفرمود که خدای منان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 191.74,
   "end": 195.76,
   "text": "عالم رو به صورت آدم خلق کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 195.76,
   "end": 201.74,
   "text": "یعنی این عالم که خارج از ماست، بیرون از ماست، عکس ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 201.74,
   "end": 204.82,
   "text": "تو جلو آینه وایمیسی عینیّت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 204.82,
   "end": 207.94,
   "text": "خودت رو در آینه می‌بینی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 207.94,
   "end": 211.74,
   "text": "اون چیزی که در آینه می‌بینی عینا خودتی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 211.74,
   "end": 216.46,
   "text": "یک عکسه. هرچه هست در خود ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 216.46,
   "end": 219.66,
   "text": "اون عکست رو هم که تو آینه داری می‌بینی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 219.66,
   "end": 229.32,
   "text": "تو خودت می‌بینی. اون عکس تو آینه میشه معلوم بالعرض، معلوم به ذات اون چیزی که تو خودت معلوم شده برای تو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 229.32,
   "end": 231.54,
   "text": "و همیشه هم همراه توئه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 231.54,
   "end": 237.16,
   "text": "تو خودته در خودت در قوه خیالت اون صورت و شکل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 237.16,
   "end": 240.4,
   "text": "دیده میشه و شکل می‌گیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 240.4,
   "end": 243.16,
   "text": "توجه کردید؟ اصلاً ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 243.16,
   "end": 247.3,
   "text": "وقتی اینطوری نگاه کنیم همه عالم برای ما دگرگون میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 247.3,
   "end": 249.64,
   "text": "خودمون هم برای خودمون دگرگون میشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 249.64,
   "end": 252.68,
   "text": "بحث تجلی بحث بسیار مهم و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 252.68,
   "end": 255.32,
   "text": "حساس و البته خطیریه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 255.32,
   "end": 262.02,
   "text": "گردنه داره توش. یعنی باید انسان این کتل‌ها رو به قول علامه طی کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 262.02,
   "end": 265.6,
   "text": "هرچی که بیرون هست، این همه صحرا، کوه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 265.6,
   "end": 268.5,
   "text": "آسمان‌ها، نه فلک،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 268.5,
   "end": 276.42,
   "text": "کهکشان‌ها، بهشت و جهنم حتی که ظاهراً بیرون از ما هستن، این‌ها همه در درون مان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 276.42,
   "end": 278.92,
   "text": "ما عکسشون رو داریم بیرون می‌بینیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 278.92,
   "end": 283.82,
   "text": "همه این‌ها در درون ماست. خدای منان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 283.82,
   "end": 290.18,
   "text": "به ذاتش، صفاتش و افعالش در انسان تجلی کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 290.18,
   "end": 292.96,
   "text": "هرچه هست در درون ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 292.96,
   "end": 298.68,
   "text": "بارها عرض کردیم در بحث ابصار ملا صدرا در ابس- ابصار چی فرمودن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 298.68,
   "end": 302.08,
   "text": "اگه شما بیرون از خودت الان شما دارید منو می‌بینید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 302.08,
   "end": 306.42,
   "text": "من رو اینجا که نشستم دارید عینا منو می‌بینید،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 306.42,
   "end": 310.42,
   "text": "یا نه من رو در درون خودتون دارید می‌بینید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 310.42,
   "end": 312.5,
   "text": "من رو در درون خودتون می‌بینید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 312.5,
   "end": 316.88,
   "text": "لذا برداشت‌ها از دیدن من متفاوته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 316.88,
   "end": 320.38,
   "text": "حضرت قابض الارواح یک وجود واحده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 320.38,
   "end": 323.42,
   "text": "یک وجوده. چند تا که نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 323.42,
   "end": 329.58,
   "text": "درسته؟ اما چرا بعضیا می‌بیننش بدشون میاد لحظه موت می‌ترسن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 329.58,
   "end": 333.06,
   "text": "چهره وحشتناکه. برای اونا وحشتناکه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 333.06,
   "end": 337.52,
   "text": "بعضی‌ هم می‌بینن از گل نازک‌تره، براشون خوشبوتره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 337.52,
   "end": 340.74,
   "text": "چرا؟ مگر اون یک وجود واحد نیست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 340.74,
   "end": 344.82,
   "text": "چرا ابصار فرق کرده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 344.82,
   "end": 351.14,
   "text": "که انّ خودت رو در آینه وجودی عزرائیل می‌بینی، خودت رو می‌بینی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 351.14,
   "end": 355.44,
   "text": "باز در حقیقت عزرائیل رو اینطوری می‌تونیم بگیم یه معنای دیگه‌ش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 355.44,
   "end": 358.48,
   "text": "عزرائیل رو در، در خودت می‌بینی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 358.48,
   "end": 361.06,
   "text": "اگر خودت جهنمی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 361.06,
   "end": 367.43,
   "text": "او رو جهنم می‌بینی. اگر خودت بهشتی، او رو بهشت می‌بینی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 367.43,
   "end": 369.65,
   "text": "اگه چه این عینک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 369.65,
   "end": 374.13,
   "text": "دودی زدی به چشمت عالم رو کبود می‌بینی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 374.13,
   "end": 376.57,
   "text": "سرخ زدی سرخ می‌بینی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 376.57,
   "end": 380.53,
   "text": "هر طور نگاه بکنی، هر-- خودت هرچه هستی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 380.53,
   "end": 383.45,
   "text": "اصلاً هرچه هست در درون ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 383.45,
   "end": 385.47,
   "text": "خدای منّان تنها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 385.47,
   "end": 396.45,
   "text": "موجودی که از حیث ذات و صفات و افعال در او تجلی کرده خدا-- انسانه، انسان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 396.45,
   "end": 399.35,
   "text": "انسان موجود عجیبیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 399.35,
   "end": 405.93,
   "text": "لذا اصلاً نمیشه انسان خودش رو بسازه الا با معرفت خود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 405.93,
   "end": 408.67,
   "text": "لذا اس-استاد بارها فرمودن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 408.67,
   "end": 411.35,
   "text": "مهم‌ترین کاری که ما داریم خودسازیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 411.35,
   "end": 413.29,
   "text": "ما مهم‌تر از خودسازی نداریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 413.29,
   "end": 416.79,
   "text": "حتی این اداره‌ای که میایم اینجا الان داریم کار می‌کنیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 416.79,
   "end": 422.09,
   "text": "اگر این منجر به خودسازی ما شد کار ما درسته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 422.09,
   "end": 426.75,
   "text": "کار ما عبادته. همین جاها، همین جا اگر خودسازی بود توش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 426.75,
   "end": 432.95,
   "text": "این عبادته. اما اگر نبود وقت تلف کنیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 432.95,
   "end": 436.15,
   "text": "تلف وقته، عمره و ازش ما-- از ما حساب کتاب می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 436.15,
   "end": 439.95,
   "text": "حالا خودسازی علامه فرمود مبتنی بر چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 439.95,
   "end": 445.45,
   "text": "معرفت نفس، شناخت نفس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 445.45,
   "end": 449.71,
   "text": "حالا در خصوص تجلی اجازه بدید چون و-- فرصت گذشت و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 449.71,
   "end": 452.71,
   "text": "رفت انشاالله جلسات بعد، هفته بعد صحبت می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 452.71,
   "end": 456.59,
   "text": "اما خلاصه اینکه بدونیم اظهار،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 456.59,
   "end": 460.65,
   "text": "ما این فرمایش بسیاری از بزرگانه، عینا این جمله رو دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 460.65,
   "end": 464.15,
   "text": "اظهار ما فی الباطن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 464.15,
   "end": 467.93,
   "text": "اونچه که در باطنه وقتی ظهور می‌کنه به این میگن تجلی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 467.93,
   "end": 472.69,
   "text": "حضرت حق ذات غیبی بود ظهور کرد شد این عوالم هستی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 472.69,
   "end": 475.89,
   "text": "اما تجلی اعظمش شده انسان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 475.89,
   "end": 477.69,
   "text": "ببین ما کی هستیم، چی هستیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 477.69,
   "end": 480.71,
   "text": "بعد خودمون رو راحت فروختیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 480.71,
   "end": 483.77,
   "text": "به شهوت و غضب و قدرت و ثروت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 483.77,
   "end": 489.67,
   "text": "به این چهار تا چیز. اگر ارتباط ظاهر با باطن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 489.67,
   "end": 493.77,
   "text": "قطع شد، دیگه به این نمیگن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 493.77,
   "end": 496.39,
   "text": "ذکر. به این نمیگن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 496.39,
   "end": 505.81,
   "text": "حضور قلب. لذا نمازی که ظاهرش با باطنش ارتباطش قطع، قطع شده، این ذکر نیست، این نماز نیست، این معراج نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 505.81,
   "end": 508.41,
   "text": "لذا آرامش هم درش نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 508.41,
   "end": 513.05,
   "text": "اگر ما آرامش نداریم چون ظاهرمون با باطنمون ارتق-- ارتباطش قطع شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 513.05,
   "end": 516.81,
   "text": "البته از جهت فلسفی غلطه بگیم قطع شده‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 516.81,
   "end": 520.89,
   "text": "قطع شدنی نیست. اصلاً نمیشه چون این ظهور اون باطنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 520.89,
   "end": 523.05,
   "text": "به انزل مراتب رسیده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 523.05,
   "end": 525.13,
   "text": "یعنی یه سوسویی داره می‌زنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 525.13,
   "end": 527.69,
   "text": "حالا انشاالله بیشتر درباره‌ش صحبت می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 527.69,
   "end": 529.85,
   "text": "انشاالله که عاقبتمون ختم به خیر بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 529.85,
   "end": 535.83,
   "text": "اون جمله رو یادتون باشه. امام حسین در کربلا برای شهدای کربلا تجلی کرد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 535.83,
   "end": 541.05,
   "text": "که اون‌طور شدن. این تجلی رو ما داریم درباره‌ش صح-- صحبت می‌کنیم یعنی چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 541.05,
   "end": 545.21,
   "text": "والحمد لله رب العالمين صلوات. سلام بر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}