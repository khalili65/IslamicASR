   "start": 19.56,
   "end": 195.44
  },
  {
   "index": 1,
   "title": "## الله ینجیکم منها و من کل کرب",
   "start": 195.44,
   "end": 321.0
  },
  {
   "index": 2,
   "title": "## حکمت بلا؛ از پیام کوچک تا شوک",
   "start": 321.0,
   "end": 361.51
  },
  {
   "index": 3,
   "title": "## یوسف و توکیل غیر خدا",
   "start": 361.51,
   "end": 381.77
  },
  {
   "index": 4,
   "title": "## نردبان بلا تا موت",
   "start": 381.77,
   "end": 544.09
  },
  {
   "index": 5,
   "title": "## کشف هفت‌لایه و مورچه",
   "start": 544.09,
   "end": 671.33
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 6.74,
   "end": 10.5,
   "text": "بسم الله الرحمن الرحیم و به این استعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 10.5,
   "end": 14.54,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 14.54,
   "end": 19.56,
   "text": "آیات. سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 19.56,
   "end": 21.94,
   "text": "در بحث توحید افعالی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 21.94,
   "end": 23.52,
   "text": "دو تا آیه دیگه تقدیم کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 23.52,
   "end": 28.4,
   "text": "آیه شصت و سه و شصت و چهار سوره انعام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 28.4,
   "end": 34.1,
   "text": "قل من ینجیکم من ظلمات البر والبحر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 34.1,
   "end": 38.42,
   "text": "بگو چه کسیه که شما را از تاریکی‌های",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 38.42,
   "end": 42.86,
   "text": "خشکی و دریا نجات می‌دهد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 42.86,
   "end": 46.54,
   "text": "حالا وقتی که شما دچار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 46.54,
   "end": 50.96,
   "text": "تاریکی‌های دریا، حالا اهم از بلاهای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 50.96,
   "end": 53.06,
   "text": "میشه گفت خشکی و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 53.06,
   "end": 56.14,
   "text": "دریایی، بری و بحری شدید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 56.14,
   "end": 60.36,
   "text": "تدعونه تضرعاً وخفیة.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 60.36,
   "end": 64.04,
   "text": "تو اون حالت شما برای نجات خودتون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 64.04,
   "end": 67.96,
   "text": "هم زاری درونی دارید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 67.96,
   "end": 74.08,
   "text": "هم بیرونی؛ یعنی تضرع می‌کنید، فریاد می‌زنید، التماس می‌کنید، داد می‌زنید،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 74.08,
   "end": 77.38,
   "text": "بلند خدا رو می‌خونید، این تضرع.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 77.38,
   "end": 83.18,
   "text": "خفیة یعنی در درون خودتون انکسار ایجاد میشه، در درون خدا رو می‌خونید،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 83.18,
   "end": 88.6,
   "text": "از خدا مدد می‌خواید. لئن أنجیناه من هذه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 88.6,
   "end": 91.08,
   "text": "تو اون حالت می‌گید که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 91.08,
   "end": 94.4,
   "text": "اگر تو این من هذه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 94.4,
   "end": 101.86,
   "text": "وقتی خدا رو به طلب-- به کمک می‌طلبید می‌گید اگر ما رو از این تنگنا، از این گرفتاری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 101.86,
   "end": 106.48,
   "text": "نجات بده لنكونن من الشاكرین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 106.48,
   "end": 109.34,
   "text": "قطعاً ما از شکرگزاران خواهیم بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 109.34,
   "end": 113.34,
   "text": "حالا این لئن أنجیناه من هذه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 113.34,
   "end": 117.46,
   "text": "نشون میده که هر کسی مشکل خودشو خیلی بزرگ می‌بینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 117.46,
   "end": 121.9,
   "text": "أنج-- أنجیناه من هذه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 121.9,
   "end": 128.04,
   "text": "اصلاً روانشناسان یه اصلی دارن بارها عرض کردیم میگن اگه همه برن مشکلاتشون رو سر یه چهارراهی بذارن بیان اول",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 128.04,
   "end": 130.24,
   "text": "بعد بگن آقا هرکی بره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 130.24,
   "end": 133.34,
   "text": "نسبت به صعë وجودیش نمی‌دونه، نمیشه، بدون مشکل نمیشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 133.34,
   "end": 135.48,
   "text": "بره یه مشکلی رو انتخاب کنه برداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 135.48,
   "end": 141.32,
   "text": "می‌بینن وقتی مشکلات همه رو می‌بینن مشکل خودشون رو انتخاب می‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 141.32,
   "end": 145.02,
   "text": "به جهت اینکه اطلاع و آگاهی ندارن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 145.02,
   "end": 148.08,
   "text": "فکر می‌کنن خدا فقط اینو گیر آورده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 148.08,
   "end": 150.6,
   "text": "بعضیا هم تو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 150.6,
   "end": 153.52,
   "text": "حالا محاوره ای و لاتی و اینا به خدا میگن خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 153.52,
   "end": 159.86,
   "text": "فقط ما رو گیر آوردی، آقا این شکلی میگن بی‌اطلاع‌اند، نمی‌دونن اصلاً کسی بی‌مشکل نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 159.86,
   "end": 162.94,
   "text": "حالا اینجا می‌فرماید که اینا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 162.94,
   "end": 166.62,
   "text": "چه به صورت ظاهری، چه باطنی خدا رو می‌خونن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 166.62,
   "end": 173.78,
   "text": "در-- قول هم میدن. خدایا لئن أنجیناه من هذه اگه ما رو از این مشکل نجات بدی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 173.78,
   "end": 178.32,
   "text": "لا قطعاً نكونن من الشاكرین ما شکرگزار می‌شیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 178.32,
   "end": 185.38,
   "text": "حالا آیه بعد می‌فرماید که به اینا بگو اصلاً بهشون بگو الله ینجیکم منها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 185.38,
   "end": 191.54,
   "text": "و من کل كرب. اصلاً اون الله که شما رو نجات میده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 191.54,
   "end": 194.18,
   "text": "از چه این مشکل،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 194.18,
   "end": 199.5,
   "text": "چه کل كرب. كرب اندوه سنگینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 199.5,
   "end": 203.04,
   "text": "اندوهیه که انسان رو به خودش می‌پیچونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 203.04,
   "end": 205.66,
   "text": "از كرب الارض گرفته شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 205.66,
   "end": 209.22,
   "text": "كرب الارض یعنی زیر و رو شدن زمین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 209.22,
   "end": 212.56,
   "text": "مثل زلزله‌ی بم اتفاقی که افتاد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 212.56,
   "end": 216.72,
   "text": "اصلاً بعضی از روستاها به کل ناپدید شدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 216.72,
   "end": 219.42,
   "text": "یعنی زمین برگشت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 219.42,
   "end": 225.0,
   "text": "اونا رو بلعید. به یک هم چسë هیچی ازشون باقی نمونده بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 225.0,
   "end": 226.84,
   "text": "به این میگن كرب الارض.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 226.84,
   "end": 230.38,
   "text": "بعضی از مشکلات این کارو با آدم می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 230.38,
   "end": 233.8,
   "text": "آدمو زیر و رو می‌کنه، تشویش خاطر میاره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 233.8,
   "end": 236.0,
   "text": "اندوهش چنان سنگینه آدم...",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 236.0,
   "end": 243.52,
   "text": "می‌فرماید که حالا چه منها چه اون غمی که شما فکر می‌کنی سنگینه و گرفتارش شدی منها،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 243.52,
   "end": 247.3,
   "text": "چه نه کرب عظیم. اونم کل كرب، کل كرب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 247.3,
   "end": 250.54,
   "text": "همه رو الله ینجیکم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 250.54,
   "end": 254.74,
   "text": "همه رو خدا شما رو-- الله که شما رو نجات میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 254.74,
   "end": 258.22,
   "text": "با اینکه اینو می‌دونید ثم أنتم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 258.22,
   "end": 262.4,
   "text": "تشركون وقتی که این اتفاق افتاد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 262.4,
   "end": 268.06,
   "text": "شما از تک تک این گرفتاری‌ها نجات پیدا می‌کنید بازم می‌رید سراغ همون کارهای خودتون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 268.06,
   "end": 271.08,
   "text": "ثم أنتم تشركون باز مشرک می‌شید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 271.08,
   "end": 275.68,
   "text": "باز خدا رو فراموش می‌کنید. این تشر خداست ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 275.68,
   "end": 282.46,
   "text": "به قول آقای قراختی در تفسیر نورش می‌فرماید خدا از بی‌وفایی تو قرآن خیلی ناله زده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 282.46,
   "end": 284.06,
   "text": "خیلی ناله‌های عجیب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 284.06,
   "end": 287.36,
   "text": "یکی اونجاست که می‌فرماید فلما كشفنا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 287.36,
   "end": 291.78,
   "text": "عنه ذره. وقتی ما ازشون این ذر، این پریشونی رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 291.78,
   "end": 294.5,
   "text": "فکشفنا ما برطرف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 294.5,
   "end": 299.62,
   "text": "کردیم مر. مر یعنی سرشو انداخت پایین رفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 299.62,
   "end": 302.94,
   "text": "مر کان لم یعدنا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 302.94,
   "end": 306.12,
   "text": "اصلاً انگار که دعا نکرده در درگاه ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 306.12,
   "end": 309.58,
   "text": "إلا ضر مسه. به خاطر اون گرفتاری که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 309.58,
   "end": 311.54,
   "text": "مسش کرده. این شکلیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 311.54,
   "end": 313.24,
   "text": "آدم معمولاً اینجوریه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 313.24,
   "end": 315.58,
   "text": "ناسپاسه متأسفانه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 315.58,
   "end": 321.0,
   "text": "حالا این مشکلات میاد، خدا لطف کنه تو بحث کتابموت بیشتر توضیح میدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 321.0,
   "end": 323.16,
   "text": "مشکلات برای چی اصلاً میاد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 323.16,
   "end": 325.34,
   "text": "همین صریح این آیه داره می‌فرمود دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 325.34,
   "end": 328.64,
   "text": "مشکلات میاد که تضرع وخفیة.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 328.64,
   "end": 332.84,
   "text": "برای اینکه چه در درونتون، چه بیرون بیفتید به خواندن خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 332.84,
   "end": 339.54,
   "text": "حالا اگر مشکل کوچیک، ابتدا هم خدا نسبت به صعë وجودی اشخاص مشکلات کوچیک میاره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 339.54,
   "end": 343.58,
   "text": "مسائل و موانع ایجاد می‌کنه تا طرف به خودش بیاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 343.58,
   "end": 347.0,
   "text": "اگر پیام این مشکل کوچیک رو گرفت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 347.0,
   "end": 351.36,
   "text": "این مصیبت کوچیک رو که هنوز كرب نشده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 351.36,
   "end": 355.56,
   "text": "اندوه زیر و رو کننده نشده، یه پیامی همه این‌ها دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 355.56,
   "end": 360.97,
   "text": "اگه پیام رو گرفت و به سمت حضرت حق حرکت کرد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 360.97,
   "end": 364.63,
   "text": "مثل حضرت یوسف. خدا هم تخفیف میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 364.63,
   "end": 370.75,
   "text": "البته به اونایی که خیلی خدا اینا رو دوست داره و خیلی قبولشون داره خیلی سخت هم می‌گیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 370.75,
   "end": 373.81,
   "text": "اما اگر این پیام رو نگرفت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 373.81,
   "end": 376.35,
   "text": "مشکل بیشتر میشه، سنگین‌تر میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 376.35,
   "end": 379.11,
   "text": "مثل کسی که با یه صدا زدن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 379.11,
   "end": 381.77,
   "text": "صداش کنی سریع می‌پره دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 381.77,
   "end": 383.99,
   "text": "اما اگر خوابش عمیق بود چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 383.99,
   "end": 388.37,
   "text": "گاهی باید آب بپاشی روش. اگر رفته باشه تو کما چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 388.37,
   "end": 392.81,
   "text": "اصن می‌تونی کاریش بکنی؟ اگه یه دفعه سکته کرده باشه اصن قلب از کار افتاده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 392.81,
   "end": 396.39,
   "text": "دیگه باید شوک بهش بزنن تا بیدارش کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 396.39,
   "end": 402.67,
   "text": "گاهی مشکلات اینطوریه. هرچی خدا می‌ریزه این پیام‌ها رو دریافت نمی‌کنه، نمی‌فهمه باید چکار کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 402.67,
   "end": 406.29,
   "text": "برای همین آخر سر یه شوک جانانه خدا بهش وارد می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 406.29,
   "end": 411.67,
   "text": "خدا نکنه آدم به اونجا-- حالا اون شوک جانانه که اجباریه برای همه هست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 411.67,
   "end": 415.27,
   "text": "که تو کتاب الموت ان‌شاءالله عصرها بحثشو داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 415.27,
   "end": 420.13,
   "text": "اون موته. موت اجباریه. خب چرا قشنگ انسان به موت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 420.13,
   "end": 427.31,
   "text": "اختیاری پیش از اون این پیام‌ها رو بگیره و از همین جا از کثرت دل بکنه بره به سمت وحدت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 427.31,
   "end": 434.21,
   "text": "از همین مشکلات میاد که نگاه ما رو، توجه ما رو، علقه و تعلق خاطر ما رو از کثرات،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 434.21,
   "end": 437.75,
   "text": "از پیرامون، از خارج از خودمون بکنه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 437.75,
   "end": 439.45,
   "text": "ما رو متوجه وحدت کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 439.45,
   "end": 442.07,
   "text": "به توحید برسونه. به توحید افعالی برسونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 442.07,
   "end": 444.35,
   "text": "به توحید صفاتی و ذاتی برسونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 444.35,
   "end": 448.35,
   "text": "متأسفانه ما اینطوریم. این توجه رو نمی‌کنیم این پیام‌ها رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 448.35,
   "end": 452.79,
   "text": "در-- دیگه ما بالاتر از انبیا، اونم انبیا سلفی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 452.79,
   "end": 458.67,
   "text": "پیغمبر در حقیقت در قرآن اسامیشون به عظمت یاد شده نداریم که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 458.67,
   "end": 463.29,
   "text": "مثلا حضرت یوسف چه کرد خدا باهاش؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 463.29,
   "end": 467.27,
   "text": "اونجا چرا مثلا حضرت یوسف خیلی تو زندان موند؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 467.27,
   "end": 469.85,
   "text": "بعضیا گفتن سی و چند سال تا سی و--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 469.85,
   "end": 472.59,
   "text": "تا نزدیک چهل سال تو زندان بوده ایشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 472.59,
   "end": 475.19,
   "text": "اختلاف روایات هست تا سی و شش سال، چهل سال.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 475.19,
   "end": 477.35,
   "text": "حالا چرا انقدر زیاد موند؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 477.35,
   "end": 480.21,
   "text": "به خاطر یک حرف ایشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 480.21,
   "end": 483.33,
   "text": "من روایتشو دیدم خدمت شما تقدیم می‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 483.33,
   "end": 488.27,
   "text": "حضرت عیسی-- حضرت یوسف علی‌نبی‌آنه آله و علیه الصلاة والسلام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 488.27,
   "end": 491.89,
   "text": "وقتی اون زندانیه داشت آزاد میشد بهش گفت رفتی پیش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 491.89,
   "end": 493.71,
   "text": "پادشاه منو یاد کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 493.71,
   "end": 496.25,
   "text": "بگو که یوسف بی‌گناه بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 496.25,
   "end": 501.59,
   "text": "خدا سریع بهش تشر زد. فرمود کس دیگه رو وکیل گرفتی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 501.59,
   "end": 507.13,
   "text": "بعد میگه مگه من خدا وکیل تو نیستم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 507.13,
   "end": 509.89,
   "text": "چرا کس دیگری رو وکیل گرفتی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 509.89,
   "end": 511.97,
   "text": "تشرش زد. بعد باهاش صحبت کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 511.97,
   "end": 520.29,
   "text": "فر تو روایت شریف مبسوط فرمود مگه من نبودم که محبتتو به دل بابات انداختم که انقدر پیغمبر من عاشق تو بشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 520.29,
   "end": 526.75,
   "text": "مگر من نبودم که تو رو از تو چاه که افتادی عریان انداختنت من پوشوندمت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 526.75,
   "end": 528.49,
   "text": "اصن انداختن به قصد کشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 528.49,
   "end": 530.95,
   "text": "من یه کاروانی رو مامور کردم تو رو بیرون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 530.95,
   "end": 534.63,
   "text": "ببرن، بخرنت، عاشقت بشن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 534.63,
   "end": 538.65,
   "text": "تا جایی بردمت بالا که انقدر بین مردم اهل کرامت بشی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 538.65,
   "end": 540.19,
   "text": "همه این کارا رو من کردم برات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 540.19,
   "end": 544.09,
   "text": "حالا به دیگری میگی برو منو یاد کن نزد پادشاه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 544.09,
   "end": 547.57,
   "text": "پس بمون تو زندان تا بمونی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 547.57,
   "end": 551.57,
   "text": "اینطوریه. خدا یکی رو خیلی دوست داره بدجوری هم گوششو می‌پوشونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 551.57,
   "end": 559.15,
   "text": "ببین گرفتن گوش الهی، گوش وقتی بخواد کشیده بشه از طرف خدا نسبت به سهو وجودی اشخاصه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 559.15,
   "end": 560.71,
   "text": "نگو خدا فقط ما رو گیر آورده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 560.71,
   "end": 567.11,
   "text": "ببین چقدر دوستت داره. بعد حالا اونجا عذر-- عذرخواهی کرد حضرت یوسف.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 567.11,
   "end": 570.07,
   "text": "خدا وقتی حضرت یوسف عذرخواهی کرد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 570.07,
   "end": 572.83,
   "text": "خدا یه چشمه‌ای هم البته بهش نشون داد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 572.83,
   "end": 576.75,
   "text": "هم تخفیف بهش داد تازه چهل سال موند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 576.75,
   "end": 580.93,
   "text": "و الا قرار بود شاید تو کلاً تو زندان بپوسه ایشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 580.93,
   "end": 584.65,
   "text": "همین که فرمود نگاه کن یه کشف عجیبی برای ایشون اتفاق افتاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 584.65,
   "end": 595.65,
   "text": "اینم بگم و برای امروز بسه. فرمود نگاه کن به عنایت الهی پرده‌ها رفت کنار تا هفت لایه زیر زمین رو ایشون دید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 595.65,
   "end": 598.53,
   "text": "هفت لایه کشف کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 598.53,
   "end": 602.43,
   "text": "حالا زمین‌شناسا باید پیش حضرت یوسف لون بذارن دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 602.43,
   "end": 605.83,
   "text": "کشف هشت-- هفت لایه‌ای زمین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 605.83,
   "end": 608.83,
   "text": "چهادید یه نمونه‌شو به ما گفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 608.83,
   "end": 612.97,
   "text": "ایشون به ما گفته بقیه‌شو با خودشون بردن یا حالا به اصحاب خاصشون گفتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 612.97,
   "end": 619.53,
   "text": "در هر حال به ما نفرمودن. مثل حضرت لقمان حکیم که یک کشف در یک کشف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 619.53,
   "end": 624.33,
   "text": "چهار هزار خاصیت از خواص گیاهان طبیعی رو از خدا گرفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 624.33,
   "end": 627.03,
   "text": "این قدرت در انسان هست. ما بی‌خیالشم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 627.03,
   "end": 629.19,
   "text": "چسبیدیم به دنیا. نگاه کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 629.19,
   "end": 632.43,
   "text": "بعد دید توی هفت لایه هفتم یه مورچه‌ایه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 632.43,
   "end": 635.19,
   "text": "هفت لایه طبقه زیرین زمین،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 635.19,
   "end": 637.89,
   "text": "یه مورچه‌ایه، یه چیزی تو دهنشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 637.89,
   "end": 640.63,
   "text": "خدا فرمود می‌بینی یوسف؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 640.63,
   "end": 642.83,
   "text": "من هفت لایه زیر تو رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 642.83,
   "end": 645.63,
   "text": "از یک مورچه ناچیز غافل نیستم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 645.63,
   "end": 648.45,
   "text": "روزیش رو دارم. روزیش رو بهش میدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 648.45,
   "end": 650.63,
   "text": "بعد تو از کس دیگه کمک خواستی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 650.63,
   "end": 655.15,
   "text": "به این نگاه، به این نگاه که ما داریم تمرین می‌کنیم ظهرها اینجا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 655.15,
   "end": 658.61,
   "text": "که این نگاهمون واقعاً این شکلی بشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 658.61,
   "end": 662.17,
   "text": "یه انقلابی در نگاهمون ایجاد بشه، بهش میگن توحید افعالی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 662.17,
   "end": 666.19,
   "text": "این تازه مرتبه اولشه. ان‌شاءالله خدا توحید ما رو متعالی کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 666.19,
   "end": 668.07,
   "text": "والحمد لله رب العالمين.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 668.07,
   "end": 671.33,
   "text": "صلوات خدایی. اللهم صل علی محمد و آل محمد و عجل فرجهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}