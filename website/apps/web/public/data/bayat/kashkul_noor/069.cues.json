 },
 "chapters": [
  {
   "index": 0,
   "title": "## جبران اعتکاف؛ ایام البیض و نماز جعفر طیار",
   "start": 20.5,
   "end": 360.06
  },
  {
   "index": 1,
   "title": "آیهٔ شصت‌وسه نیز به یکی از آیات الهی اشاره می‌کند:",
   "start": 360.06,
   "end": 791.33
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.06,
   "end": 4.44,
   "text": "اللهم صل علی محمد و آل محمد و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 4.44,
   "end": 11.4,
   "text": "عجل فرجهم. بسم الله الرحمن الرحیم و به این استعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 11.4,
   "end": 15.22,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 15.22,
   "end": 20.5,
   "text": "آیات. سلامٌ علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 20.5,
   "end": 24.28,
   "text": "رهبر عزیزمون فرمودن اون‌هایی که اعتکاف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 24.28,
   "end": 28.2,
   "text": "شامل حالشون نمی‌شه به هر دلیلی نمی‌تونن برن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 28.2,
   "end": 31.5,
   "text": "اینطور نباشه که بگیم خب دیگه ما نرفتیم دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 31.5,
   "end": 34.4,
   "text": "کلا بی‌توجه باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 34.4,
   "end": 36.14,
   "text": "فرمودن که جبران کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 36.14,
   "end": 39.58,
   "text": "جبران این سه شب و سه روز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 39.58,
   "end": 43.24,
   "text": "ایام البیض که می‌دونید در امم پیشین نبود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 43.24,
   "end": 47.26,
   "text": "ایام البیض در امم پیشین نبود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 47.26,
   "end": 49.84,
   "text": "سه ماه رجب،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 49.84,
   "end": 55.92,
   "text": "شعبان و رمضان بود. اما ایام البیض مخصوص این امت شد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 55.92,
   "end": 60.5,
   "text": "به عشق پیغمبر. یعنی به شدت ساعات و آنات رو-- نورانی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 60.5,
   "end": 64.44,
   "text": "بیض، پر از نوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 64.44,
   "end": 67.9,
   "text": "مثل اینکه قرآن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 67.9,
   "end": 72.26,
   "text": "بخشیش البته بر انبیا نازل شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 72.26,
   "end": 76.86,
   "text": "دو مرتبه از اون که نازل شد بخشیش رو اجازه پیدا کردن به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 76.86,
   "end": 80.06,
   "text": "امت‌شون بدن. اما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 80.06,
   "end": 84.66,
   "text": "سه تا سوره بود که بر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 84.66,
   "end": 87.54,
   "text": "امم پیشین نازل نشد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 87.54,
   "end": 91.5,
   "text": "فقط بر ما نازل شد. سوره یاسین،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 91.5,
   "end": 95.9,
   "text": "سوره قل هو الله احد و سوره ملک.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 95.9,
   "end": 98.74,
   "text": "این سه تا مخصوص شماست. لذا اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 98.74,
   "end": 102.48,
   "text": "نمازی که این سه شب داره، اگر کسی این سه شب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 102.48,
   "end": 106.1,
   "text": "اون نماز مخصوص تو مفاتیح هست بخونه که امشب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 106.1,
   "end": 111.82,
   "text": "می‌شه شب سومش، این از برکت هر سه ماه بهره‌مند می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 111.82,
   "end": 115.14,
   "text": "خیلی عجیبه که این سه تا سوره توشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 115.14,
   "end": 119.36,
   "text": "حالا رهبر عزیزمون فرمودن بی‌توجه نباشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 119.36,
   "end": 126.82,
   "text": "چه کنیم؟ فرمودن نماز جعفر طیار رو تو این سه روز بخونید ثواب اعتکاف رو بهتون میدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 126.82,
   "end": 129.32,
   "text": "اینو رهبر عزیزمون فرمودن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 129.32,
   "end": 132.28,
   "text": "حالا کسی الان روز دومه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 132.28,
   "end": 135.16,
   "text": "نمی‌دونسته، اشکال نداره. امروز بخونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 135.16,
   "end": 137.4,
   "text": "می‌تونید دو بار امروز بخونید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 137.4,
   "end": 141.0,
   "text": "نمی‌تونید همون یه بار رو بخون. اصلاً یه بار بخون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 141.0,
   "end": 145.78,
   "text": "نمکش رو بچش. قطعاً البته شما از من جلوتری جسارت می‌کنم اینطوری حرف می‌زنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 145.78,
   "end": 150.14,
   "text": "از برکات انشاالله این ایام بهره‌مند باشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 150.14,
   "end": 156.42,
   "text": "من می‌دونم بین شما عزیزانی هستند که گفت‌وگو کردیم متوجه شدم که هر شب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 156.42,
   "end": 160.52,
   "text": "به سبک امام رضا نماز شب می‌خونن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 160.52,
   "end": 166.06,
   "text": "امام رضا چگونه می‌خونه؟ چهار رکعت اول نماز شبش نماز جعفر طیاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 166.06,
   "end": 172.82,
   "text": "هستند تو این جمع کسانی که نماز جعفر طیار رو هر شب چهار رکعت اول نماز شبشونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 172.82,
   "end": 175.28,
   "text": "جا نمونیم خلاصه. دارن مسابق--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 175.28,
   "end": 179.42,
   "text": "مسابقه‌ای که از سابقون، از سابقون دارن جلو می‌زنن از ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 179.42,
   "end": 182.02,
   "text": "ما حرفشو می‌زنیم به قول الان شهرانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 182.02,
   "end": 185.42,
   "text": "حرف زدنش از ما عمل کردنش از مردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 185.42,
   "end": 190.3,
   "text": "بحث توحید افعالی رو هم رها نکنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 190.3,
   "end": 193.22,
   "text": "این نماز شب، نماز جعفر طیار- بله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 193.22,
   "end": 195.66,
   "text": "نماز شب تخفیف‌شدش هم هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 195.66,
   "end": 197.7,
   "text": "بله هست. بله هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 197.7,
   "end": 202.88,
   "text": "می‌تونید نماز رو دو رکعت نماز رو بخونید دو تا دو رکعتی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 202.88,
   "end": 207.14,
   "text": "چون چهار رکعته دیگه. دو تا دو رکعتی که می‌خونید تموم شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 207.14,
   "end": 211.06,
   "text": "بعد از که چهار رکعت تموم شد می‌شینید اون سبحان الله و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 211.06,
   "end": 216.92,
   "text": "الحمد لله ولا اله الا الله الله اکبر رو تسبیح دستتون می‌شه سیصد بار می‌گید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 216.92,
   "end": 223.66,
   "text": "دیگه اون بعضی کسایی که بالاخره کمردرد دارن، پا درد دارن یا تو، تو سجده زیاد می‌مونن اذیت می‌شن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 223.66,
   "end": 226.98,
   "text": "ولی اونا خیلی خوبه. اینم یه روشیه برای اهل-- بفرمایید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 226.98,
   "end": 228.88,
   "text": "تسبیحات اربعه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 228.88,
   "end": 231.38,
   "text": "تسبیحات اربعه رو سیصد بار می‌گید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 231.38,
   "end": 235.14,
   "text": "همون ثواب رو می‌برید. این که شب بخواد بخونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 235.14,
   "end": 238.6,
   "text": "اون که خونده که. بله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 238.6,
   "end": 242.46,
   "text": "توحید افعالی رو هم تقدیم کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 242.46,
   "end": 248.2,
   "text": "در آیه، آیه شصت و یک، شصت و دو و شصت و سه سوره حشر خیلی شیرین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 248.2,
   "end": 251.24,
   "text": "همشون تقریباً یه گفتمان دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 251.24,
   "end": 255.86,
   "text": "آیه شصت و یک می‌فرماید: «و لک بأن الله يولج الليل في النهار»",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 255.86,
   "end": 259.36,
   "text": "می‌خواد قدرت نمایی خدا رو می‌خواد-- خدا این چنین قدرت نمایی کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 259.36,
   "end": 263.36,
   "text": "چگونه؟ يولج از، از ولوج میاد، از دخول.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 263.36,
   "end": 266.44,
   "text": "خدا داخل می‌کنه. لیل في نهار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 266.44,
   "end": 270.56,
   "text": "شب رو در روز و يولج النهار في الليل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 270.56,
   "end": 272.36,
   "text": "روز رو میاره داخل می‌کنه در شب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 272.36,
   "end": 276.28,
   "text": "این کار خداست. کار امر طبیعی نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 276.28,
   "end": 278.64,
   "text": "و ان الله سميع بصير.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 278.64,
   "end": 282.28,
   "text": "این یه آیه که داره قدرت خدا رو بیان می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 282.28,
   "end": 285.58,
   "text": "آیه بعد می‌فرماید: «ذلك» این که ما گفتیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 285.58,
   "end": 288.06,
   "text": "اون. حالا میگه «ذلك» اسم اشاره به دو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 288.06,
   "end": 290.14,
   "text": "یعنی فکر نکنید چیز کمیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 290.14,
   "end": 292.54,
   "text": "این یک از آیات محکم و بزرگ ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 292.54,
   "end": 296.86,
   "text": "لذا شاید به این دلیل نمیگه هاذا می‌فرماید «ذلك» اون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 296.86,
   "end": 299.62,
   "text": "اون آیه‌ای که برای شما نقل کردیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 299.62,
   "end": 303.78,
   "text": "و ان الله هو الحق. به خاطر اینه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 303.78,
   "end": 309.9,
   "text": "خدا حقه، به حقه. چون حقه، چون حضرت حق حقه، چون الله حقه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 309.9,
   "end": 312.78,
   "text": "فقط هم اون می‌تونه جابجا کنه شب و روز رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 312.78,
   "end": 315.76,
   "text": "تو دل هم بیاره ببره. احدی نمی‌تونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 315.76,
   "end": 318.96,
   "text": "و ان ما يدعون من دونه هو الباطل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 318.96,
   "end": 323.3,
   "text": "اون کسی که شما به جز این الله می‌خونیدش هرکی باشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 323.3,
   "end": 328.62,
   "text": "اون باطله. چرا؟ یه نفرو پیدا کنید به جای خدا بتونه شب و روزو جابجا کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 328.62,
   "end": 332.26,
   "text": "پیدا کنید ها. احدی نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 332.26,
   "end": 336.1,
   "text": "بعد اینجا چقدر زیبا از اسماء جلال خودش استفاده می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 336.1,
   "end": 340.04,
   "text": "از جلال و جبروت که الان داره قدرت نمایی می‌کنه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 340.04,
   "end": 341.74,
   "text": "دیگه کم و mehr نداره واقعاً.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 341.74,
   "end": 344.96,
   "text": "لذا اسماء جمال نمیاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 344.96,
   "end": 348.22,
   "text": "و ان الله هو العلی الکبیر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 348.22,
   "end": 352.0,
   "text": "به به! قدرت خدا نمایان می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 352.0,
   "end": 355.5,
   "text": "البته اگه کسی ببینه. آیه شصت و سه هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 355.5,
   "end": 358.88,
   "text": "باز به یکی از آیات الهی اشاره می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 358.88,
   "end": 361.82,
   "text": "الم تر؟ آیا نگاه نکردی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 361.82,
   "end": 365.48,
   "text": "ندیدی؟ ان، ان الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 365.48,
   "end": 368.15,
   "text": "انزل من السماء ماء",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 368.15,
   "end": 371.05,
   "text": "الله خداست که از آسمون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 371.05,
   "end": 372.69,
   "text": "نازل میکنه بارون رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 372.69,
   "end": 377.41,
   "text": "[سخنگوی 1] فَتُصْبِحُواْ الأَرْضَ مُصْفَرَّةً [سخنگوی 2] إِنَّ اللَّهَ حالا بحث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 377.41,
   "end": 381.29,
   "text": "بارون که میشه لطیفانه اسماء جمال رو خدا میاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 381.29,
   "end": 385.17,
   "text": "إِنَّ اللَّهَ لَطِيفٌ خَبِيرٌ نسبت به موضوع‌های",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 385.17,
   "end": 391.65,
   "text": "اسماء رو میارن. بعد وقتی صبح میکنی بر سر اون باران میبینی همه جا سرسبز شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 391.65,
   "end": 395.63,
   "text": "البته تفاسیر انفسی خیلی شیرین و عالی و زیبایی داره این آیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 395.63,
   "end": 400.27,
   "text": "فعلاً کاری به اون نداریم. ما در بحث تفسیر افقی دارم الان حرف میزنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 400.27,
   "end": 401.89,
   "text": "قدرت نمایی حضرت حقه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 401.89,
   "end": 408.65,
   "text": "حالا میشه که از بارو-از آسمون چیزی بیاد اما بارون نباشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 408.65,
   "end": 412.61,
   "text": "میتونه خدا؟ مثلاً ابابیل چیکار کردن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 412.61,
   "end": 418.29,
   "text": "سنگ‌هایی که ریختن. یا تو بعضی از اقوام که خدا عذابشون کرد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 418.29,
   "end": 425.29,
   "text": "این‌ها رو با جونورهای عجیب و غریب از آسمون، از آسمون جانورانی ریخت سر این‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 425.29,
   "end": 429.37,
   "text": "که هیچ شباهتی به جانوران موجود در رو زمین نداشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 429.37,
   "end": 433.53,
   "text": "اینا از کجا اومدن؟ مگه تو آسمونا کسی جونور کشف کرده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 433.53,
   "end": 439.23,
   "text": "با قدرت خداست. اصلاً میشه خود ق-- باران که لطافت داره بیاد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 439.23,
   "end": 441.63,
   "text": "اما بزنه همه چیو تخریب کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 441.63,
   "end": 446.33,
   "text": "مثل زمان حضرت نوح دیگه. چه سیلی راه انداخت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 446.33,
   "end": 450.35,
   "text": "اصلاً خدا نمی‌تونست مثل نابودان آب و باران رو نازل کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 450.35,
   "end": 455.71,
   "text": "حتماً باید قطره، قطره، قطره جدای از هم لط-- با لطافت بیاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 455.71,
   "end": 458.05,
   "text": "یا نسیم، باد چقدر خوبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 458.05,
   "end": 461.51,
   "text": "قدرتمندترین از قدرتمندترین موجوداته دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 461.51,
   "end": 464.99,
   "text": "دفعه پیش گفتیم که چی تونست جلوی باد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 464.99,
   "end": 466.73,
   "text": "علم بشه از آیات الهی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 466.73,
   "end": 470.63,
   "text": "هیچکس نمی‌تونست. حالا اگه باد نباشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 470.63,
   "end": 473.65,
   "text": "این ریح اگر نباشه همه چی نابود میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 473.65,
   "end": 476.67,
   "text": "باده که زندگی رو در جریان قرار میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 476.67,
   "end": 479.21,
   "text": "حالا این باد خنک، این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 479.21,
   "end": 482.97,
   "text": "نسیم خوش نفس این یه دفعه تبدیل بشه به توفان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 482.97,
   "end": 488.61,
   "text": "نمیشه؟ این همه جا رو زده تخریب کرده به قران کوه از جا کنده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 488.61,
   "end": 491.23,
   "text": "و کاری نداره برای خدای که. حالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 491.23,
   "end": 496.31,
   "text": "میشه آبه. آقا میگه آب خودش به تنهایی خود آب رفع عطش میکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 496.31,
   "end": 502.07,
   "text": "خنک، گواره. خب چطور بعضیا هرچی میخورن باز تشنه تر میشن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 502.07,
   "end": 504.29,
   "text": "بعضیا معتقدن یزید علیه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 504.29,
   "end": 509.31,
   "text": "علیه اللعنه و العذاب الالم انقدر آب خورد ترکید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 509.31,
   "end": 512.37,
   "text": "معدش اصلاً ترکید. یعنی دیگه اصلاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 512.37,
   "end": 515.37,
   "text": "هرچی می خورد تشنه‌تر میشد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 515.37,
   "end": 520.33,
   "text": "این رو بعضیا معتقدن. حالا چند جور بر مرگ این ملعون بعضیا میگن انقدر خورد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 520.33,
   "end": 524.17,
   "text": "حالا به هر تقدیر. میشه هرچی بخوری گشنه‌تر بشی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 524.17,
   "end": 526.67,
   "text": "هرچی بخوری تشنه‌تر بشی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 526.67,
   "end": 528.99,
   "text": "عصا کارش چیه؟ عصا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 528.99,
   "end": 532.45,
   "text": "خب باهاش بزنی برگ درخت بندازی و چوپونی کنی و.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 532.45,
   "end": 535.33,
   "text": "عصا چیه؟ تیکه چوب چگونه میشه مار؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 535.33,
   "end": 537.49,
   "text": "اگه خدا بخواد عصا، چوب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 537.49,
   "end": 540.27,
   "text": "میشه مار. خدا بخواد بزنه به دریا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 540.27,
   "end": 545.25,
   "text": "رود نیل شکافته میشه. پس همه چی به یاد قدرت حضرت حقه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 545.25,
   "end": 548.55,
   "text": "حالا یادم افتاد که حالا نمیدونم قوم عاد بود، ثمود بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 548.55,
   "end": 551.47,
   "text": "الان که قورباغه وزغ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 551.47,
   "end": 553.19,
   "text": "از زیر زمین میریخت بیرون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 553.19,
   "end": 555.75,
   "text": "از کجا؟ زیر زمین مگه وزغ و قورباغه داره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 555.75,
   "end": 558.71,
   "text": "اون وقت وزغ و قورباغه‌هایی نه الان مثل الان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 558.71,
   "end": 564.09,
   "text": "میگن انقدر اینا بزرگ و وحشتناک بودن که کسی میدید فرار میکرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 564.09,
   "end": 566.91,
   "text": "اینا آخه تو تاریخ قصص انبیا اومده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 566.91,
   "end": 572.11,
   "text": "همه جا رو پر کرد. یا مثلاً ملخ، ملخ میزد همه جا رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 572.11,
   "end": 580.27,
   "text": "کاری نداره برای خدا که. ولی یه، یه ولی خدا میخواد که قدرت تصرف در ماده کائنات داشته باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 580.27,
   "end": 583.31,
   "text": "بتونه این بلا رو برداره. خدا هم به برکت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 583.31,
   "end": 585.79,
   "text": "نفس پاک اون این بلاها رو برداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 585.79,
   "end": 589.75,
   "text": "قبول کنیم بسیاری از این بلاهایی که از ما داره رفع میشه به جهت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 589.75,
   "end": 594.03,
   "text": "هم نفسیمون با اولیاء خداست که متأسفانه اکثرشون رفتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 594.03,
   "end": 596.13,
   "text": "اینا حرز بودن خودشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 596.13,
   "end": 598.89,
   "text": "سالار آقا حسنزاده اینا خودش حرز بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 598.89,
   "end": 601.05,
   "text": "رفتن. چرا هی بلا داره بیشتر میشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 601.05,
   "end": 602.71,
   "text": "خدا بقیه‌شون رو از ما نگیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 602.71,
   "end": 605.29,
   "text": "رهبر عزیزمون رو از ما نگیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 605.29,
   "end": 606.99,
   "text": "و الا بلا پشت بلا میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 606.99,
   "end": 611.37,
   "text": "چرا نیاد؟ بلاهایی که ما تا حالا ندیدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 611.37,
   "end": 615.51,
   "text": "حالا تا الانم آخرالزمانه پشت سر هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 615.51,
   "end": 617.05,
   "text": "بلاهایی میاد. حدیث هم داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 617.05,
   "end": 624.55,
   "text": "هرچی گناها جدیدتر میشه، یه گناه‌هایی داره رخ میده که قبلنا اصلاً رو کره زمین سابقش نبوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 624.55,
   "end": 629.67,
   "text": "به همون نسبت بلاها جدید میشه و هیچ دارویی هم نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 629.67,
   "end": 634.17,
   "text": "هیچ دارویی نداره این گناهها، این بلاهایی که بر اثر این گناهان میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 634.17,
   "end": 638.39,
   "text": "بعد اولیاء خدا، خدا رحمت کنه شیخ حسن لری نخودکی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 638.39,
   "end": 642.37,
   "text": "توی نمیدونم نشان از بینشانه‌ها رو خوندید حتماً بگیرید کتاب بخونید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 642.37,
   "end": 645.95,
   "text": "خیلی عجیب آدم رو از این رو به اون میکنه واقعاً.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 645.95,
   "end": 649.39,
   "text": "که ایشون میان بهش میگن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 649.39,
   "end": 651.09,
   "text": "قدرت تصرف در کائنات داشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 651.09,
   "end": 653.61,
   "text": "میان میگن آقا مزرعه ما رو ملخ برداشته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 653.61,
   "end": 657.57,
   "text": "بیچاره شدیم. اهل امام بود طرف.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 657.57,
   "end": 663.63,
   "text": "بهش گفت برو رو به روی م-مزرعت وایسا بگو شیخ حسن میگه ملخ‌ها برید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 663.63,
   "end": 666.17,
   "text": "اینم میشناخت دیگه شیخ حسن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 666.17,
   "end": 669.29,
   "text": "الکی حرف نمیزنه که. همونه که کیمیا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 669.29,
   "end": 671.19,
   "text": "رو به حضرت امام تو اون ذکر شریف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 671.19,
   "end": 677.03,
   "text": "یاد داد و حضرت امام فرمود من هرچی عزت خدا بهم داده از این ذکر کیمیاییه که شیخ حسن بهم داد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 677.03,
   "end": 679.47,
   "text": "رفت رو به رو مزرعه‌ش وایستاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 679.47,
   "end": 681.37,
   "text": "ملخ‌ها شیخ حسن علی میگه برید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 681.37,
   "end": 689.49,
   "text": "دید همه رفتن. یا اون آژانه بود که میزد اون زمان میزدن عمامه از سر آخوندها برمی‌داشتن زمان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 689.49,
   "end": 691.77,
   "text": "شاه ملعون. بعد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 691.77,
   "end": 695.25,
   "text": "اومد بزنه تو سر آشیخ حسن علی نخودکی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 695.25,
   "end": 699.93,
   "text": "گفت تکون نخور. شیخ حسن علی تو زندگی نامه‌ش نوشتم به این آژانه، به این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 699.93,
   "end": 702.17,
   "text": "پلیس زمان شاه گفت تکون نخور.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 702.17,
   "end": 703.85,
   "text": "میخ کوب همینجوری رو زمین وایساد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 703.85,
   "end": 705.87,
   "text": "نه-- تکون نتونست دیگه بخوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 705.87,
   "end": 708.39,
   "text": "این قدرت کنه. این قدرت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 708.39,
   "end": 711.29,
   "text": "مقام کنه. تصرف در ماده کائنات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 711.29,
   "end": 716.63,
   "text": "و اولیاء خدا بر اثر کثرت عبادتشون و عبودیتشون، نه عبادت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 716.63,
   "end": 719.63,
   "text": "عبودیتشون، بندگی‌شون به اون میرسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 719.63,
   "end": 721.59,
   "text": "این پلیس هم چه خشکش زدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 721.59,
   "end": 723.67,
   "text": "مردم می‌اومدن رد میشدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 723.67,
   "end": 729.51,
   "text": "تو تاریخ نوشتن. میزدن یه پلیسی خشکش زده تکون نمیخوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 729.51,
   "end": 732.41,
   "text": "گفتن این هرکی هست این کار شیخ حسن علیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 732.41,
   "end": 734.33,
   "text": "هیچکس نمیتونه این کارو بکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 734.33,
   "end": 736.51,
   "text": "فقطم به دستمون گره باز میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 736.51,
   "end": 740.87,
   "text": "رفتم بهش گفتم بابا این بیچاره بیست و چهار ساعته خشکش زده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 740.87,
   "end": 744.81,
   "text": "بره بره خیابون همینطوری وایساده پلک نمیزنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 744.81,
   "end": 749.33,
   "text": "این میمیره. گفت برید بهش بگید شیخ حسن علی گفت برو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 749.33,
   "end": 752.31,
   "text": "اومدم بهش، به آژانه گفتم شیخ حسن علی گفت برو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 752.31,
   "end": 756.07,
   "text": "این یه دفعه راه افتاد. اینا رو شوخی نگیرید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 756.07,
   "end": 762.75,
   "text": "اینا وجود داره. دوست داشتید یه وقتی حالا ایناشو ضبط میشه میره تو کانال نمیشه یه سری چیزا رو گفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 762.75,
   "end": 767.77,
   "text": "کرامات که بنده از بعضی از اولیاء خدا، از آقای بهجت، از آقا مرتضی تهرانی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 767.77,
   "end": 770.63,
   "text": "از آقای حق شناس، از خود علامه حسن زاده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 770.63,
   "end": 773.37,
   "text": "دیدم و برای شما بگم محیر العقوله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 773.37,
   "end": 778.71,
   "text": "یعنی اصلاً باور نمیکنید شماها چه برسه اونایی که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 778.71,
   "end": 782.29,
   "text": "اللهم باریک لمولانا صاحب الزمان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 782.29,
   "end": 784.33,
   "text": "والحمد لله رب العالمين.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 784.33,
   "end": 787.85,
   "text": "صلوات الله. ما شا الله علی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 787.85,
   "end": 791.33,
   "text": "محمد و آل محمد و اللعنه علی أعدائهم أجمعین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}