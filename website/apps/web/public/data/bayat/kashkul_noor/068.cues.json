 "chapters": [
  {
   "index": 0,
   "title": "## گوسالهٔ سامری؛ ناتوانی از پاسخ و نفع و ضرر",
   "start": 6.4,
   "end": 103.18
  },
  {
   "index": 1,
   "title": "## تذکر هارون؛ تبعیت از جانشین پیامبر",
   "start": 103.18,
   "end": 123.66
  },
  {
   "index": 2,
   "title": "## سابقهٔ سامری؛ دفاع موسی از مظلوم",
   "start": 123.66,
   "end": 211.86
  },
  {
   "index": 3,
   "title": "## خاک مرکب جبرئیل؛ زرنگی منافق",
   "start": 211.86,
   "end": 328.24
  },
  {
   "index": 4,
   "title": "## وعدهٔ سی‌شبه و فتنهٔ ده روز اضافه",
   "start": 328.24,
   "end": 552.64
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 6.4,
   "end": 10.3,
   "text": "بسم الله الرحمن الرحیم و به این استعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 10.3,
   "end": 15.94,
   "text": "السلام علیک یا داعی الله و ربانی ایات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 15.94,
   "end": 18.86,
   "text": "سلامٌ علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 18.86,
   "end": 27.74,
   "text": "در آیه پنجاه و شش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 27.74,
   "end": 32.84,
   "text": "ببخشید آیه هشتاد و نه و نود سوره طه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 32.84,
   "end": 36.12,
   "text": "اگر دقت بفرمایید موضوع",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 36.12,
   "end": 38.7,
   "text": "سامری رو البته اسمش چی بود؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 38.7,
   "end": 41.82,
   "text": "اسم اصلیش موسi بن ظفر بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 41.82,
   "end": 45.0,
   "text": "معروف به سامری. بیان کرده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 45.0,
   "end": 48.06,
   "text": "در آیه هشتاد و نه می‌فرماید: \"أَفَلَا يَرَونَ أَنَّهُ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 48.06,
   "end": 53.48,
   "text": "لَا يَرْجِعُ إِلَيْهِمْ قَوْلًا وَلَا يَمْلِكُ لَهُمْ ضَرًّا وَلَا نَفْعًا\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 53.48,
   "end": 57.14,
   "text": "فرمود پس آیا درک نمی‌کنند که این گوساله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 57.14,
   "end": 62.36,
   "text": "پاسخی بهشون نمیده. \"أَنَّهُ لَا يَرْجِعُ إِلَيْهِمْ قَوْلًا\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 62.36,
   "end": 66.22,
   "text": "هیچ سخنی نمیگه. گوساله پاسخی به شما نمیده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 66.22,
   "end": 69.42,
   "text": "پاسخی به نیازهایتون نمیده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 69.42,
   "end": 74.14,
   "text": "و تازه \"وَلَا يَمْلِكُ لَهُمْ ضَرًّا وَلَا نَفْعًا\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 74.14,
   "end": 78.74,
   "text": "مالک و صاحب اختیار هیچ سود و زیانی هم برای اون‌ها نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 78.74,
   "end": 85.7,
   "text": "آیا توجه به این نمی‌کنند؟ آیه بعد که آیه نوده می‌فرماید: \"وَلَقَدْ قَالَ لَهُمْ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 85.7,
   "end": 89.04,
   "text": "هَارُونُ مِنْ قَبْلُ\". قبل از این هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 89.04,
   "end": 92.66,
   "text": "حضرت هارون این گوشزد رو به اینا کرده بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 92.66,
   "end": 97.82,
   "text": "بهشون گفته بود. یعنی نشون میده که انحرافشون عامدانه بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 97.82,
   "end": 99.96,
   "text": "از جهل و بی‌خردی نبود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 99.96,
   "end": 107.82,
   "text": "می‌دونستن چون \"وَلَقَدْ قَالَ لَهُمْ هَارُونُ مِنْ قَبْلُ\" قبل از این هم حضرت هارون که جانشین حضرت موسی بود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 107.82,
   "end": 110.84,
   "text": "در خصوص این انحراف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 110.84,
   "end": 115.22,
   "text": "بهشون تذکر داده بود که می‌دونید بزرگترین خطری که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 115.22,
   "end": 120.82,
   "text": "انقلاب‌ها رو، این‌ها رو تهدید می‌کنه ارتجاعه، ارتداده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 120.82,
   "end": 126.0,
   "text": "انحراف فرهنگیه که متأسفانه در انقلاب خودمون هم خیلی رخ داد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 126.0,
   "end": 128.18,
   "text": "حالا انقلاب حضرت موسی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 128.18,
   "end": 132.68,
   "text": "علی نبی یعنی علیه السلام پیروز شده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 132.68,
   "end": 139.3,
   "text": "و یه آدم منافقی که البته اول عرض می‌کنم خدمتتون جزو داردسته حضرت موسی بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 139.3,
   "end": 147.16,
   "text": "منافق از آب دراومد و این بساط رو به جایی کشید که هفتاد هزار، توی روایات میگه هفتاد هزار نفر کم نیست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 147.16,
   "end": 151.78,
   "text": "از قوم موسی که البته اکثریت قوم بنی اسرائیل رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 151.78,
   "end": 155.86,
   "text": "به خودش اختصاص میده، همه منحرف شدن، بت‌پرست شدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 155.86,
   "end": 160.8,
   "text": "پس \"وَلَقَدْ قَالَ لَهُمْ هَارُونُ مِنْ قَبْلُ\" قبل از این حضرت هارون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 160.8,
   "end": 165.14,
   "text": "غسیه حضرت موسی تذکر داده بهش- بهشون، بهشون گفته بود که \"يَا قَوْمِ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 165.14,
   "end": 168.48,
   "text": "إِنَّمَا فُتِنتُمْ بِهِ\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 168.48,
   "end": 172.32,
   "text": "شما دچار یه فتنه و آزمایشی می‌شید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 172.32,
   "end": 176.74,
   "text": "توسط همین سامری \"وَإِنَّ رَبَّكُمُ الرَّحْمَٰنُ\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 176.74,
   "end": 182.38,
   "text": "البته حواستون جمع باشه که پروردگار سم-- شما الرحمنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 182.38,
   "end": 185.04,
   "text": "شما باید دامن الله یا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 185.04,
   "end": 188.42,
   "text": "الرحمن رو بگیرید، نه اینکه بت‌ها رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 188.42,
   "end": 192.16,
   "text": "\"فَاتَّبِعُونِي\" و اینجا این کانال فیضه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 192.16,
   "end": 195.12,
   "text": "منو-- تبعیت منو بکنید چون من",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 195.12,
   "end": 198.58,
   "text": "جانشین پیغمبرم. من هم نبی حساب میشم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 198.58,
   "end": 203.82,
   "text": "\"وَأَطِيعُوا أَمْرِي\" اطاعت امر منو بکنین اگر می‌خواید که چی باشید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 203.82,
   "end": 208.86,
   "text": "موحد باشید. اگر می‌خواید راهتون به سمت حضرت حق باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 208.86,
   "end": 211.86,
   "text": "حالا این چی اتفاقش کجا رقم می‌خوره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 211.86,
   "end": 215.6,
   "text": "در کتاب تفسیر اهل بیت علیهم الصلاة و السلام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 215.6,
   "end": 217.76,
   "text": "جلد نه صفحه دویست و شیا--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 217.76,
   "end": 220.02,
   "text": "شصت و شش یه روایتی دیدم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 220.02,
   "end": 222.84,
   "text": "که این سامری جزو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 222.84,
   "end": 225.92,
   "text": "اولا اقوام حضرت موسی بود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 225.92,
   "end": 229.62,
   "text": "و البته اون موقع",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 229.62,
   "end": 233.82,
   "text": "ظاهراً دیندار بود و همراه حضرت بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 233.82,
   "end": 241.36,
   "text": "اتفاقاً اون یه روای-- آیه‌ای داریم که حضرت موسی با مشت می‌زنه به اون مصری و اونو می‌کشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 241.36,
   "end": 243.36,
   "text": "این دو تا با هم درگیر بودن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 243.36,
   "end": 245.66,
   "text": "اون مصری یا کافره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 245.66,
   "end": 249.12,
   "text": "با همین موسi بن ظفر درگیر شده بودن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 249.12,
   "end": 252.94,
   "text": "چون یار حضرت موسی بود، اون موقع مؤمن بود حضرت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 252.94,
   "end": 256.68,
   "text": "موسی رفت در دفاع از مظلوم با مشت زد اونو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 256.68,
   "end": 260.52,
   "text": "ناباوریه مشت انداختش دیگه بچه نظام آباد بودن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 260.52,
   "end": 263.9,
   "text": "انداخت طرفو. خلاصه حساب کار دستتون باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 263.9,
   "end": 266.2,
   "text": "یاخوندتونم بچه نظام آبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 266.2,
   "end": 269.4,
   "text": "با یه مشت انداختش. کارو تموم کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 269.4,
   "end": 272.58,
   "text": "حالا ایشون تو این روایت می‌فرماد که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 272.58,
   "end": 274.98,
   "text": "دیگه بعداً معروف شد به سامری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 274.98,
   "end": 279.64,
   "text": "وقتی که از دریا رد می‌شدن همراه حضرت موسی جلو حرکت می‌کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 279.64,
   "end": 281.88,
   "text": "از جلو می‌دید ماجراها رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 281.88,
   "end": 284.62,
   "text": "تو این روایت که سندش رو عرض کردم خدمتتون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 284.62,
   "end": 289.58,
   "text": "نگاه می‌کرد. حالا خیلی عجیبه که چشمش هم باز بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 289.58,
   "end": 294.32,
   "text": "یعنی حضرت جبرائیل رو متمثل شده می‌دیده ایشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 294.32,
   "end": 299.96,
   "text": "روایت داره میگه من نمیگم. که سوار یک مرکبی شبیه به اسب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 299.96,
   "end": 307.34,
   "text": "که هر کجا این سامری میگه هر کجا می‌دیدم که این اسبه که حضرت جبرائیل بر اون مرکب سواره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 307.34,
   "end": 310.7,
   "text": "پاشو می‌کوبه، اون زمین حرکت می‌کنه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 310.7,
   "end": 313.9,
   "text": "اون خاک به تحرک می‌افته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 313.9,
   "end": 319.1,
   "text": "این زرنگی می‌کنه. یه مشت از اون خاک رو برمی‌داره که پای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 319.1,
   "end": 321.24,
   "text": "مرکب حضرت جبرائیل بهش خورده بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 321.24,
   "end": 325.1,
   "text": "می‌دیده این خاک حرکت داره، زنده است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 325.1,
   "end": 328.24,
   "text": "اینو برمی‌داره تو توبرش می‌ریزه. به هیچکس هم نمیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 328.24,
   "end": 329.84,
   "text": "پس خلاصه زرنگی می‌کنه و میره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 329.84,
   "end": 333.58,
   "text": "بعد از این، بعد از اینکه حالا این انقلاب پیروز می‌شه و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 333.58,
   "end": 336.1,
   "text": "حضرت موسی موفق می‌شه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 336.1,
   "end": 340.92,
   "text": "و بعد وعده از خدا می‌گیره که برای دیدار حضرت حق چرا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 340.92,
   "end": 346.96,
   "text": "بره اون الواح رو، الواح رو به منزله قوانین حضرت حق بگیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 346.96,
   "end": 349.5,
   "text": "بیاره به عنوان قانون اساسی انقلاب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 349.5,
   "end": 352.56,
   "text": "مثل ما که انقلاب کردیم قانون اساسی می‌خواستیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 352.56,
   "end": 354.94,
   "text": "کی این قانون اساسی رو وضع کرد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 354.94,
   "end": 358.62,
   "text": "روحش شاد شهید بهشتی. اون موقع هم حضرت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 358.62,
   "end": 361.54,
   "text": "موسی رفت کوه طور سی شب به همه هم گفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 361.54,
   "end": 364.18,
   "text": "گفت من از خدا سی شب وعده گرفتم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 364.18,
   "end": 366.06,
   "text": "برم قانون اساسی رو بگیرم بیام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 366.06,
   "end": 371.46,
   "text": "اون آیات لازم رو برای زندگی، خوشبختی، سعادت دنیا و آخرت شما بگیرم بیام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 371.46,
   "end": 375.28,
   "text": "رفت این سی شب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 375.28,
   "end": 379.12,
   "text": "شد چهل شب. اون چ-- دقیقا این فتنه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 379.12,
   "end": 381.96,
   "text": "این امتحان الهی. دقیقا اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 381.96,
   "end": 385.82,
   "text": "ده روزی که اضافه شد اینا افتادن به جون هم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 385.82,
   "end": 389.0,
   "text": "العیاذ بالله این اگه پیغمبر بود چرا دروغ گفت به ما؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 389.0,
   "end": 393.74,
   "text": "چرا گفت سی روز این-- آدم درکش و شعورش نرسه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 393.74,
   "end": 398.18,
   "text": "اینجوری میشه. افتادن به جون هم. تو همون ده روز هر اتفاقی می‌خواد بیفته افتاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 398.18,
   "end": 401.04,
   "text": "سامری هم قبل از این شروع کرد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 401.04,
   "end": 403.78,
   "text": "مردم رو تهیج کرد، ترغیب کرد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 403.78,
   "end": 405.36,
   "text": "و طلاهاشون رو خواست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 405.36,
   "end": 408.8,
   "text": "گفت من می‌خوام به شما یه چشمه‌ای نشون بدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 408.8,
   "end": 411.96,
   "text": "اینا طلا می‌خوام. طلاهاشون رو همه آوردن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 411.96,
   "end": 414.7,
   "text": "و اینا رو آب کرد. حالا و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 414.7,
   "end": 420.96,
   "text": "اصلا در تفسیر نور آقای قلوچی میگه نذاشت اونا ببینن مراحل ساخت این گوساله رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 420.96,
   "end": 423.2,
   "text": "که متوجه بشن چیکار می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 423.2,
   "end": 431.5,
   "text": "گوساله رو ساخت وقتی که تموم شد با اون طلاها که البته این مظهر دنیاست دیگه طلا نماد دنیاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 431.5,
   "end": 435.2,
   "text": "زر و زیوره که الان همه رو بیچاره کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 435.2,
   "end": 442.42,
   "text": "اینو وقتی ساخت دست برد تو اون توپش که پنهان کرده بود به کسی نشون نداده بود و خاک رو ریخت تو دهان این گوساله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 442.42,
   "end": 448.6,
   "text": "وقتی باد می‌وزید اولا وقتی این خاک رو ریخت به برکت اون خاک که حرکت داشت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 448.6,
   "end": 451.94,
   "text": "این گاوه تکون می‌خورد، حرکت می‌کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 451.94,
   "end": 455.08,
   "text": "بعضیا گفتن حتی دست و پاش حرکت می‌کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 455.08,
   "end": 458.24,
   "text": "بعد حتی یه روایت دیدم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 458.24,
   "end": 461.42,
   "text": "مو و پشم روی این گوساله رشد کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 461.42,
   "end": 464.12,
   "text": "پوست و مو و پشم به برکت اون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 464.12,
   "end": 467.36,
   "text": "حالا خداست دیگه. خداست و خدا این کارو می‌خواد امتحان کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 467.36,
   "end": 469.44,
   "text": "شبیه گوساله شد واقعا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 469.44,
   "end": 474.32,
   "text": "باد که می‌زد از منف-- از منفذهایی که این گوساله داشت با اون خاکی که در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 474.32,
   "end": 477.9,
   "text": "حلقش ریخته بود صدای گوساله ازش بلند می‌شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 477.9,
   "end": 480.12,
   "text": "دیگه همه گفتن دیگه این معجزه است دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 480.12,
   "end": 482.6,
   "text": "یه گوساله از طلا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 482.6,
   "end": 487.7,
   "text": "خلاصه افتادن العیاذ بالله به سجده و فلان اینا همه منحرف شدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 487.7,
   "end": 491.62,
   "text": "این نشون میده که یه نفر آدمی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 491.62,
   "end": 496.84,
   "text": "م-منافق میشه اگر بصیرت نباشه می‌تونه یه ملت رو به انحراف بکشونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 496.84,
   "end": 499.48,
   "text": "تمام زحمات پیغمبر رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 499.48,
   "end": 505.28,
   "text": "به باد هوا بده. تو کش-- توی کشور خودمون متاسفانه تو انقلاب خود ما هم داشتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 505.28,
   "end": 508.56,
   "text": "حالا نمی‌خوایم اسم ببریم. بعضیاشون به درک وصل شدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 508.56,
   "end": 512.48,
   "text": "بعضیاشون هنوزم که هنوزه عمر نوح دارن انگار نمیرن به درک نمیرن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 512.48,
   "end": 515.04,
   "text": "انشاالله زودتر برن. که چه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 515.04,
   "end": 518.7,
   "text": "کارهایی کردن برای اینکه این انقلاب از مسیر خودش خارج بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 518.7,
   "end": 522.08,
   "text": "خدا سایه رهبر عزیزمون رو از سر ما حفظ کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 522.08,
   "end": 525.12,
   "text": "که اگر خدای نکرده زمانم را",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 525.12,
   "end": 527.66,
   "text": "سایه ایشون از سر ما کوتاه بشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 527.66,
   "end": 530.76,
   "text": "خیلی فتنه، فتنه بسیار سنگینی خواهد بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 530.76,
   "end": 535.02,
   "text": "خیلی. برای همین تا می‌تونیم قربونی کنیم صدقه بدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 535.02,
   "end": 538.88,
   "text": "خدا ایشون رو برای ما حفظ کنه تا انشاالله ظهور حضرت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 538.88,
   "end": 541.42,
   "text": "غفور السرور حضرت رو درک کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 541.42,
   "end": 545.42,
   "text": "والحمد لله. اللهم بارک لمولانا صاحب الزمان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 545.42,
   "end": 547.28,
   "text": "والحمد لله رب العالمين.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 547.28,
   "end": 552.64,
   "text": "صلوات الله- على محمد و آل محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}