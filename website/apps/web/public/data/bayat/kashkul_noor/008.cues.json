 "chapters": [
  {
   "index": 0,
   "title": "## مقام محمود و سعهٔ وجودی در نافلهٔ شب",
   "start": 15.02,
   "end": 116.72
  },
  {
   "index": 1,
   "title": "## تفاضلِ رسل؛ میزانِ ولایت",
   "start": 116.72,
   "end": 165.98
  },
  {
   "index": 2,
   "title": "## شهادت؛ شهود و درک از نماز",
   "start": 165.98,
   "end": 212.22
  },
  {
   "index": 3,
   "title": "## سخنِ آیت‌الله بهجت؛ مراقبهٔ روز و حضورِ نماز",
   "start": 212.22,
   "end": 232.42
  },
  {
   "index": 4,
   "title": "## کامل الزیارات؛ ابن‌قولویه و برکتِ یادِ حسین",
   "start": 232.42,
   "end": 420.42
  },
  {
   "index": 5,
   "title": "## مکاشفهٔ حضرت سکینه",
   "start": 420.42,
   "end": 462.8
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 1.86,
   "end": 7.1,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 7.1,
   "end": 10.98,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 10.98,
   "end": 15.02,
   "text": "آیاته سلام علیکم و رحمه الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 15.02,
   "end": 18.74,
   "text": "در بحث مقام محمود بودیم و چند تا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 18.74,
   "end": 23.36,
   "text": "نشونه و نمونه آوردیم از اینکه مقام محمود رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 23.36,
   "end": 29.56,
   "text": "بسیاری از علمای امامیه و مفسرین و این‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 29.56,
   "end": 32.12,
   "text": "همون مقام شفاعت می‌دونن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 32.12,
   "end": 36.82,
   "text": "و عرض کردیم که هر کسی نسبت به سعه وجودیش با خوندن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 36.82,
   "end": 40.44,
   "text": "و اقامه نماز شب می‌تونه به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 40.44,
   "end": 42.88,
   "text": "بخشی از مقام محمود برسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 42.88,
   "end": 49.58,
   "text": "یه علت دیگه‌ای که ما آنقدر به زرعه قاطعین رو می‌گیم همون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 49.58,
   "end": 51.88,
   "text": "فراز زیارت شریف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 51.88,
   "end": 61.96,
   "text": "عاشورا است. اونجایی که عرض می‌کنیم \"و اسأله أن يبلغ المقام المحمود لكم عند الله\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 61.96,
   "end": 65.7,
   "text": "یعنی ما داریم درخواست می‌کنیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 65.7,
   "end": 70.0,
   "text": "اون مقام محمودی رو که اون‌ها نزد خدا دارن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 70.0,
   "end": 73.76,
   "text": "البته که اون مقام رو به ما نمیدن که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 73.76,
   "end": 79.56,
   "text": "به میزان سعه وجودیمون، به اندازه ظرف وجودیمون، هر مقدار که از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 79.56,
   "end": 83.3,
   "text": "حقیقت نافله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 83.3,
   "end": 86.84,
   "text": "شب بهره‌مند هستیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 86.84,
   "end": 90.68,
   "text": "همون مقدار به ما میدن. داریم مثلا هر--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 90.68,
   "end": 93.86,
   "text": "شهید از هفتاد نفر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 93.86,
   "end": 99.32,
   "text": "تا هفتصد هزار نفر رو می‌تونه شفاعت کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 99.32,
   "end": 102.68,
   "text": "خب چرا این اختلاف درجه برای چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 102.68,
   "end": 105.52,
   "text": "به جهت مقامشونه دیگه، رتبه‌شونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 105.52,
   "end": 109.26,
   "text": "وقتی انبیا رتبه‌شون با هم متعد--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 109.26,
   "end": 116.72,
   "text": "مختلفه که \"تِلْكَ الرُّسُلْ فَضَّلْنَا بَعْضَهُمْ عَلَى بَعْضٍ\" فضیلت دارن، برتری دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 116.72,
   "end": 119.18,
   "text": "فضیلت و برتری اون‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 119.18,
   "end": 123.94,
   "text": "به چه چیزیه؟ به میزانی که ولایت رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 123.94,
   "end": 131.06,
   "text": "اخذ کردن. چقدر به ولایت کلیه الهیه که همش رو امیرالمؤمنین حضرت وصی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 131.06,
   "end": 134.32,
   "text": "علی علیه الصلاة والسلام برداشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 134.32,
   "end": 136.84,
   "text": "الله اکبر. همش رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 136.84,
   "end": 143.42,
   "text": "هیچ کدوم از انبیا نتونستن همه ولایت کلیه رو بردارن جز مقام ختمی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 143.42,
   "end": 149.24,
   "text": "ولی مولا برداشت. این چهارده نور پاک برداشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 149.24,
   "end": 154.54,
   "text": "خب اون هر مقدار که به ولایت رسیدن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 154.54,
   "end": 157.92,
   "text": "رتبه‌شون همونه. انبیا اینچنین‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 157.92,
   "end": 161.5,
   "text": "خب اشخاص و افراد هم به جز انبیا اینچنین‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 161.5,
   "end": 165.06,
   "text": "شهدا اینچنین‌اند نسبت به ز-- سعه وجودیشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 165.06,
   "end": 170.36,
   "text": "چه مقدار اصلاً شهید کسیه که شهود پیدا می‌کنه، شاهد میشه بر عالم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 170.36,
   "end": 176.78,
   "text": "اشهد که ما می‌گیم ما متاسفانه لقلقه زبونمون شده اما باید به مقام شهود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 176.78,
   "end": 180.9,
   "text": "یعنی اون شهادتی که آخر ما می‌گیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 180.9,
   "end": 183.88,
   "text": "در داریم سلام میدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 183.88,
   "end": 189.34,
   "text": "اون تشهدی که می‌گیم اشهد الله این مقام شهادته، شهوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 189.34,
   "end": 192.96,
   "text": "یعنی درک از نماز. یه بلایی باید سر ما آورده باشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 192.96,
   "end": 195.52,
   "text": "به قول مولا علی علیه الصلاة والسلام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 195.52,
   "end": 198.48,
   "text": "مقام زیارت خداست دیگه نماز.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 198.48,
   "end": 201.62,
   "text": "زیارت خداست یعنی بارگاهه، حرمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 201.62,
   "end": 203.76,
   "text": "عجب! نماز حرمه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 203.76,
   "end": 210.4,
   "text": "بله. اگه یه وقتی توفیق بده خدا ما در خصوص نماز یه ذره به حرف بیفتیم با هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 210.4,
   "end": 216.5,
   "text": "متوجه می‌شیم که چه حرم با عظمت و بی‌نظیریه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 216.5,
   "end": 221.42,
   "text": "و هر کسی به قول آقای بهجت فرمودن نماز نخون حال کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 221.42,
   "end": 223.4,
   "text": "نه چقدر قشنگ. خیلی همه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 223.4,
   "end": 227.1,
   "text": "همه فهم‌ند. فرمودن نماز نخون که حال کنی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 227.1,
   "end": 231.24,
   "text": "کیف کنی. نماز بخون که حالت رو بسنجی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 231.24,
   "end": 237.8,
   "text": "عجب! یعنی نماز بخون که تو حالت چ-- بفهمی حالت چگونه هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 237.8,
   "end": 240.02,
   "text": "محضر حضرت عمه توکل بودیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 240.02,
   "end": 242.5,
   "text": "اون موقعی که قم درس می‌خوندیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 242.5,
   "end": 245.68,
   "text": "یه روز ازشون یکی از دوستان ما سؤال کرد که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 245.68,
   "end": 251.16,
   "text": "چه کنیم در نماز صیمه بهمون وصل شه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 251.16,
   "end": 254.16,
   "text": "یعنی حالت حضور قلب داشته باشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 254.16,
   "end": 258.06,
   "text": "ایشون یه تبسم تلخی کردن فرمودن که آقا کسی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 258.06,
   "end": 262.22,
   "text": "بیرون از نماز همش در غفلته چگونه می‌خواد با یه الله اکبر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 262.22,
   "end": 264.7,
   "text": "تو درک از نماز وصل بشه؟ که نمیشه آقا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 264.7,
   "end": 267.36,
   "text": "باید کل روز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 267.36,
   "end": 271.22,
   "text": "وصل باشی، مراقبه کنی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 271.22,
   "end": 273.92,
   "text": "خودت رو در حضور حضرت حق جل جلاله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 273.92,
   "end": 278.9,
   "text": "بدونی تا اون موقع نماز خودش رو نشون بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 278.9,
   "end": 280.86,
   "text": "نماز دیگه زیارتگاهه، زی--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 280.86,
   "end": 286.6,
   "text": "بارگاهه. حالا همه هم یه جوری منو نگاه می‌کنن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 286.6,
   "end": 290.04,
   "text": "انگار که حرفای عجیب و غریب داریم می‌زنیم ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 290.04,
   "end": 297.24,
   "text": "فحش داریم میدیم. نه شوهرم بهت میگه آخه تو به قیافت نمیخوره این حرفا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 297.24,
   "end": 300.34,
   "text": "شاید اینو-- اگه اینه درست میگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 300.34,
   "end": 304.4,
   "text": "چی بگیم؟ خدا می‌دونه من همینطور که دارم میگم خدا می‌دونه تو وجود نفس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 304.4,
   "end": 306.54,
   "text": "خودم اینطوری میگم آخه تو رو چه به این حرفا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 306.54,
   "end": 309.86,
   "text": "خودم به خودم میگم. اما چه کنم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 309.86,
   "end": 313.44,
   "text": "این چهره نورانی شما و آقا سعید عزیز اینو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 313.44,
   "end": 315.72,
   "text": "آدم نگاه می‌کنه دوست داره هی حرف بزنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 315.72,
   "end": 322.86,
   "text": "محمودیه به قول علامه شهرانی حرف زدن از ما، عمل کردن از شما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 322.86,
   "end": 325.12,
   "text": "پس عزیزانی دلم خسته تون نکنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 325.12,
   "end": 332.28,
   "text": "وقتمون هم گذشت. این \"و اسأله أن يبلغ المقام المحمود لكم عند الله\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 332.28,
   "end": 335.9,
   "text": "اون مقام محمودی که برای شماست نزد خدا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 335.9,
   "end": 338.0,
   "text": "اِممم من دارم چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 338.0,
   "end": 340.46,
   "text": "\"و اسأله\" درخواست می‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 340.46,
   "end": 343.1,
   "text": "اینم که حدیث چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 343.1,
   "end": 345.52,
   "text": "حدیث قدسیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 345.52,
   "end": 350.94,
   "text": "اولین منبعی که زیارت عاشورا رو مطرح کرده حدود هزار سال پیش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 350.94,
   "end": 353.54,
   "text": "کدوم کتابه؟ کامل الزيارات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 353.54,
   "end": 356.28,
   "text": "مرحوم ابن قولویه قمی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 356.28,
   "end": 358.68,
   "text": "بغل شیخ مفید تو کاظمین دفنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 358.68,
   "end": 361.66,
   "text": "بارها امام عصر رو دیدن که خم شد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 361.66,
   "end": 364.2,
   "text": "ضریح قبر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 364.2,
   "end": 368.9,
   "text": "شیخ مفید و ابن قولویه رو بوسید گریه کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 368.9,
   "end": 373.34,
   "text": "کم شخصیتی نیست. اون کامل الزياراتش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 373.34,
   "end": 375.58,
   "text": "بخونید ببینید چه خبره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 375.58,
   "end": 382.32,
   "text": "که آدم با یه لیوان آب، یه جرعه آبی که بخوره، یه هورت آب بخوره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 382.32,
   "end": 387.58,
   "text": "بگه صلي الله عليك يا أبا عبد الله لعن الله قاتليك",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 387.58,
   "end": 391.34,
   "text": "بهشتی میشه. یعنی اگر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 391.34,
   "end": 398.68,
   "text": "واقعاً این رو درست انجام بده با خلوص و خرابش نکنه همین با یه همین یه عمل بهشتی میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 398.68,
   "end": 401.64,
   "text": "انقدر بهشتی شدن آسونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 401.64,
   "end": 405.32,
   "text": "توجه کردید؟ البته اینو عرض کنم این از ما نیستا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 405.32,
   "end": 409.24,
   "text": "پررو نشم من. مقام سید الشهداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 409.24,
   "end": 412.62,
   "text": "ببین آقا چه مقامی داره که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 412.62,
   "end": 419.12,
   "text": "با یه آب خوردن و یادش کردن \"شیعتی مهما شربت ماءً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 419.12,
   "end": 423.12,
   "text": "اذکرنی\". حضرت سکینه تو مکاشفه‌ش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 423.12,
   "end": 427.4,
   "text": "تا قیام قیامت حالا ببخشید من حالا دارم دگرگون میشم ادامه ندم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 427.4,
   "end": 433.22,
   "text": "تا قیام قیامت هر کسی که آب می‌خوره سلام میده به ابا عبدالله،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 433.22,
   "end": 434.94,
   "text": "اجرش مال حضرت سکینه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 434.94,
   "end": 440.26,
   "text": "کنار گودی مکاشفه کرد، شهو-- به مقام کشف و شهود رسید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 440.26,
   "end": 444.98,
   "text": "آقا بهش گفت سکینه جان سلام منو تا قیام قیامت به محبینم برسون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 444.98,
   "end": 448.76,
   "text": "بگو هر وقت که آب گوارا نوشیدید یاد من باشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 448.76,
   "end": 455.32,
   "text": "لب، لب تشنه من باشید. حالا عزیز دلم صلي الله عليك يا مظلوم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 455.32,
   "end": 459.38,
   "text": "يا أبا عبد الله. این سال حضرت حسین ان شا الله به زودی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 459.38,
   "end": 462.8,
   "text": "کربلا رو با معرفت زیارت کنیم. صلوات ختم کنیم. الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}