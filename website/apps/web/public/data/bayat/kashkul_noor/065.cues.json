   "start": 19.98,
   "end": 92.02
  },
  {
   "index": 1,
   "title": "## حرز خانوادگی شبانه و اذکار حیّ و قیوم",
   "start": 92.02,
   "end": 226.92
  },
  {
   "index": 2,
   "title": "## برداشت غلط از صدقه؛ تحویل بلا",
   "start": 226.92,
   "end": 304.56
  },
  {
   "index": 3,
   "title": "## شأن نزول اول؛ هفت سال قحطی قریش",
   "start": 304.56,
   "end": 360.06
  },
  {
   "index": 4,
   "title": "## شأن نزول دوم؛ پرستش اجنه",
   "start": 360.06,
   "end": 380.06
  },
  {
   "index": 5,
   "title": "## ابالسه علیه سالکان توحید و سخن رهبری",
   "start": 380.06,
   "end": 401.22
  },
  {
   "index": 6,
   "title": "## گارد با احراز؛ حرز امام رضا و حرز کبیر جواد",
   "start": 401.22,
   "end": 717.26
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.1,
   "end": 9.92,
   "text": "بسم الله الرحمن الرحیم و به این استعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 9.92,
   "end": 12.74,
   "text": "السلام علیک یا داعی الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 12.74,
   "end": 15.18,
   "text": "و ربانی آیات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 15.18,
   "end": 19.98,
   "text": "سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 19.98,
   "end": 26.08,
   "text": "در بحث توحید افعالی آیه پنجاه و شش سوره اسرا، اسرا رو دقت بفرمایید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 26.08,
   "end": 30.36,
   "text": "ماه، ماه توحیده. ماه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 30.36,
   "end": 34.46,
   "text": "اگرچه به یک معنای ماه ولایت هم هست اما ولایت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 34.46,
   "end": 43.24,
   "text": "روح توحیده. یکی از خطبی که پیغمبر داره ماه رجب رو شهر الله معرفی کرده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 43.24,
   "end": 46.82,
   "text": "و فرموده این ماه، ماه خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 46.82,
   "end": 51.44,
   "text": "خب چی بهتر از اینکه در این ماه توحید انسان کامل بشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 51.44,
   "end": 57.86,
   "text": "اگر دقت بفرمایید از مهم‌ترین دستورات بزرگان که دیروز هم عرض کردیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 57.86,
   "end": 63.42,
   "text": "همان ده هزار مرتبه سوره قل هوالله خوندن در طی این ماه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 63.42,
   "end": 65.4,
   "text": "سوره قل هوالله به چه جهته؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 65.4,
   "end": 69.5,
   "text": "شناسنامه خداست دیگه. توحید رو کامل می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 69.5,
   "end": 76.38,
   "text": "سوره ان انزلنا انسان رو با کثرات محشور می‌کنه، با وسایل فیض الهی محشور می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 76.38,
   "end": 80.3,
   "text": "تنزل الملائکه. میای به قوس نزولی، میای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 80.3,
   "end": 83.64,
   "text": "سمت کثرات. اما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 83.64,
   "end": 85.84,
   "text": "سوره قل هوالله به عکسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 85.84,
   "end": 90.74,
   "text": "صعودیه قوسش. بچه رو می‌بره به سمت وحدت محض.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 90.74,
   "end": 92.88,
   "text": "حالا اون حرز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 92.88,
   "end": 96.8,
   "text": "خانوادگی یا حرز شخصی که عرض کردم خدمتتون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 96.8,
   "end": 100.84,
   "text": "دستورش رو در مسعود بلال که هر شب نه فقط ماه رجب،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 100.84,
   "end": 103.34,
   "text": "هر شب صد تا قل هوالله و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 103.34,
   "end": 110.34,
   "text": "سه تا ناس و سه تا فلق بخونی بدمی در اهل منزل، بچه‌ها مخصوصا مصون میشن از تصرفات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 110.34,
   "end": 113.2,
   "text": "شیاطین و مریضی‌های پی در پی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 113.2,
   "end": 117.84,
   "text": "اینو هم تو ماه شما حداقل اینو انجام بدید خودش میشه سه هزار تا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 117.84,
   "end": 123.38,
   "text": "کل ماه رجب. بقیه‌ش هم دیگه وقتی پیدا کنید تا ده هزار تا برسونیدش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 123.38,
   "end": 128.92,
   "text": "یعنی فرمایش آقای قاضیه. کسی که سالک ال الله این کارو می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 128.92,
   "end": 131.64,
   "text": "یه عرض کردیم تثبیت می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 131.64,
   "end": 134.34,
   "text": "مهر می‌زنه، تثبیت می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 134.34,
   "end": 138.54,
   "text": "تثبت وجودی میده بهتون در وادی توحید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 138.54,
   "end": 141.44,
   "text": "خدا رحمت کنه عزادار آقای کشمیری رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 141.44,
   "end": 146.84,
   "text": "ایشون خیلی توصیه داشتن در این ماه به اسمایی از خدای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 146.84,
   "end": 152.18,
   "text": "منان استفاده کنی که درش اسم الحي و القیوم اومده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 152.18,
   "end": 154.58,
   "text": "مثل خود یا حي یا قيوم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 154.58,
   "end": 160.32,
   "text": "یا اون ذکر شریف که از تا استاد برای تنویر قلب و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 160.32,
   "end": 163.38,
   "text": "قوت عقل بیان فرمودن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 163.38,
   "end": 167.96,
   "text": "یادتونه؟ یا حي یا قيوم يا من لا اله الا انت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 167.96,
   "end": 170.78,
   "text": "خیلی ذکر شریفیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 170.78,
   "end": 174.06,
   "text": "خب این یکی از بهترین ذکرهاست تو این ایام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 174.06,
   "end": 177.34,
   "text": "اصلا ماه، ماهی‌ست که باید توحید ما کامل بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 177.34,
   "end": 183.94,
   "text": "این ماه ما رو به درستی تحویل ماه بعدی بده که بریم تو بغل پیغمبر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 183.94,
   "end": 190.18,
   "text": "لذا هر ذکری و هر surه ای که بیشتر بوی و رایحه توحید میده، هر عملی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 190.18,
   "end": 192.72,
   "text": "که ما رو به سمت توحید سوق میده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 192.72,
   "end": 203.06,
   "text": "اون هرجاست اینو بدونید. در آیه پنجاه و شش سوره اسرا می‌فرماید قل قل الذين زعمتم من دونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 203.06,
   "end": 210.66,
   "text": "پیغمبر به اینا بگو اون کسانی رو که به جای خدا پنداشتید و عبادتشون رو می‌کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 210.66,
   "end": 213.26,
   "text": "فلا یملکون كشف بر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 213.26,
   "end": 215.02,
   "text": "عنكم ولا تحويلا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 215.02,
   "end": 221.2,
   "text": "اونا نه می‌تونن آسیب و گزندی رو از شما دفع کنن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 221.2,
   "end": 226.92,
   "text": "ولا تحويلا یعنی نه می‌تونن انتقالش بدن به دیگری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 226.92,
   "end": 231.58,
   "text": "قدیما یه برداشت غلطی از صدقه بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 231.58,
   "end": 233.14,
   "text": "نمی‌دونم کی برخورد کرده بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 233.14,
   "end": 236.34,
   "text": "ما تو فامیل‌های نزدیک ما یه روزی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 236.34,
   "end": 239.56,
   "text": "صدقه پ- می‌داد. یه خدا رحمتش کنه از دنیا رفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 239.56,
   "end": 241.84,
   "text": "از نزدیکان ما بود. صدقه می‌داد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 241.84,
   "end": 243.54,
   "text": "بعد گفت بیا، بیا سر اینور.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 243.54,
   "end": 245.82,
   "text": "صدقه رو که می‌داد به من گفت علی سریع بیا بریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 245.82,
   "end": 250.1,
   "text": "گفتم چیش؟ گفت الان اون بلایی که می‌خواست بیاد سر ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 250.1,
   "end": 252.54,
   "text": "با این صدقه می‌ریزه سر اون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 252.54,
   "end": 254.16,
   "text": "بیا ما بریم. یه همچین برداشتی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 254.16,
   "end": 255.72,
   "text": "گفتم کی این حرفا رو زده به تو؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 255.72,
   "end": 258.64,
   "text": "گفت از قدیم شنیدیم. برداشت‌ها رو ببین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 258.64,
   "end": 261.38,
   "text": "یعنی فکر می‌کردن صدقه که میدن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 261.38,
   "end": 264.7,
   "text": "بلا از سر خودشون برداشته میشه می‌ریزه سر اون ب-",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 264.7,
   "end": 267.24,
   "text": "بیچاره‌ای که داره صدقه رو بهش میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 267.24,
   "end": 274.36,
   "text": "این میشه تحویل. اینجا صریح آیه قرآن می‌فرماید که هیچکس ولا تحويلا هیچکس نمی‌تونه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 274.36,
   "end": 277.32,
   "text": "بلا رو از تو برداره به کس دیگه بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 277.32,
   "end": 283.1,
   "text": "پس همچینی ما نداریم. اینکه می‌فرماید زعمتم، زعمتم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 283.1,
   "end": 288.38,
   "text": "حالا در اقرب المواقع دیدم که از عادت عرب بوده که یه کسی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 288.38,
   "end": 291.96,
   "text": "دروغ زیاد می‌گفته یا سخن باطل و دروغ می‌گفته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 291.96,
   "end": 294.64,
   "text": "بهش می‌گفتن فلانی زعم کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 294.64,
   "end": 298.22,
   "text": "که میگه زعمتم. یعنی به دروغ میگن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 298.22,
   "end": 300.14,
   "text": "چون هیچ کاری از اینا بر نمیاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 300.14,
   "end": 304.4,
   "text": "از این چیزا از اون کسایی که سمتشون میرید و اینا رو بت خودشون بردارید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 304.4,
   "end": 307.78,
   "text": "حالا دو تا شرح نزول هم عرض می‌کنم خدمتتون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 307.78,
   "end": 311.78,
   "text": "از اون مهماتشون. که اصلا این آیه چرا نازل شد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 311.78,
   "end": 317.74,
   "text": "یه شرح نزولش که می‌فرماید هفت سال قریش به شدت دچار قحطی شدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 317.74,
   "end": 321.18,
   "text": "الان یه مدتی بارون نیوماد چقدر ما اذیت شدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 321.18,
   "end": 323.0,
   "text": "فکر کنین هفت سال شوخی نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 323.0,
   "end": 325.76,
   "text": "قحطی، بیچارگی، فلاکت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 325.76,
   "end": 328.28,
   "text": "پیری همه رو گرفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 328.28,
   "end": 331.58,
   "text": "بعد اینا هی دست به دامن بت‌هاشون شدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 331.58,
   "end": 334.18,
   "text": "هی توسل به بت‌هاشون میدن و هی بدتر شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 334.18,
   "end": 337.06,
   "text": "اصلا دیگه هیچ خبری نمیشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 337.06,
   "end": 341.64,
   "text": "بعد از که هفت سال تموم شده دیگه به بیچارگی و فلاکت افتادن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 341.64,
   "end": 345.66,
   "text": "اومدن دامن پیغمبر رو گرفتن گفتن حالا شما دعا کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 345.66,
   "end": 350.0,
   "text": "اونجا که شد این آیه نازل شد که آها دیدید با اون بت‌هایی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 350.0,
   "end": 355.18,
   "text": "بهشون دست دراز می‌کردید هیچ کاری برای شما نتونستن بکنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 355.18,
   "end": 360.06,
   "text": "یعنی خدا یه تشر مشتی بهشون زد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 360.06,
   "end": 364.94,
   "text": "روایت دوم که در شرح نزولش هست ابن مسعود میگه که میگه عده‌ای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 364.94,
   "end": 367.22,
   "text": "اونجا افتاده بودن به پرستش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 367.22,
   "end": 371.74,
   "text": "اجنه جن‌ها رو می‌دیدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 371.74,
   "end": 375.04,
   "text": "حالا یه بعضیا معتقدن که از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 375.04,
   "end": 377.14,
   "text": "پیغمبر ما به این ور",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 377.14,
   "end": 379.6,
   "text": "جن‌ها دیگه دیده نشدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 379.6,
   "end": 385.54,
   "text": "قبلش رو می‌دیدن. بعضیا میگن نه، در زمان سلیمان فقط دیده شدن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 385.54,
   "end": 391.06,
   "text": "در بقیه انبیا دیده نشدن. رددال چیزی که بنده تحقیق کردم بیشتر این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 391.06,
   "end": 395.1,
   "text": "قوتش بیشتره که از پیغمبر ما دیده نشدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 395.1,
   "end": 401.22,
   "text": "اینم دلالت یا دلایلی داره که باید به وقتش صحبت کنیم چرا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 401.22,
   "end": 404.4,
   "text": "اینا افتادن به پرستش اجنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 404.4,
   "end": 411.1,
   "text": "الان هم بسیاری از دشمنان ما کارهاشون رو با همین اجنه از جنس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 411.1,
   "end": 415.28,
   "text": "جن که شیاطین هستن، شیاطین جنی و انسی البته،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 415.28,
   "end": 417.66,
   "text": "دارن پیش می‌برن و من این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 417.66,
   "end": 421.58,
   "text": "هشدار رو میدم به خودم و شما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 421.58,
   "end": 424.96,
   "text": "این هشدار رو جدی میدم هر کی دوست داشت بیاد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 424.96,
   "end": 429.16,
   "text": "محاجه می‌کنم باهاش. مناظره دو طرفه با هم می‌کنیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 429.16,
   "end": 431.92,
   "text": "که هر کس در مسیر توحید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 431.92,
   "end": 434.56,
   "text": "گامش رو محکم‌تر برداره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 434.56,
   "end": 438.04,
   "text": "اون ابالسه ای که بهش حمله می‌کنند،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 438.04,
   "end": 440.76,
   "text": "قدرت بیشتری داره. از فراعنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 440.76,
   "end": 443.04,
   "text": "ابالسه از و شیاطینن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 443.04,
   "end": 444.78,
   "text": "از اون افریتاشونن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 444.78,
   "end": 446.54,
   "text": "اون بزرگان گنده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 446.54,
   "end": 449.74,
   "text": "الان که دیگه همشون اومدن وسط.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 449.74,
   "end": 458.52,
   "text": "یعنی انقدر، انقدر روزی نیست به بنده بگذره و عزیزی از اون کسایی که پرچم‌دارن، جلودارن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 458.52,
   "end": 461.32,
   "text": "یا تریبون به دستن یا مجموعه دارن یا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 461.32,
   "end": 470.28,
   "text": "هدایتگرن به بنده یا پیام یا زنگ یا رجوع نکنه و درد و دل نکنه از گرفتاری‌هایی که براش داره پیش میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 470.28,
   "end": 473.68,
   "text": "مخصوصا برای همسرش و فرزندانش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 473.68,
   "end": 476.04,
   "text": "یه فرمایشی رهبر عزیزمون یه شب داشتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 476.04,
   "end": 480.72,
   "text": "اونم که گوش دادن دو سه سال پیش رمز عجیبی تو صحبت روشون بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 480.72,
   "end": 486.98,
   "text": "فرمودن شما، خدا شما رو می‌خواد عقاب کنه بلا رو می‌ریزه سر همسرت و فرزندانت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 486.98,
   "end": 490.88,
   "text": "چه سنته. برای اون‌ها درجه میشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 490.88,
   "end": 495.72,
   "text": "ولی برای برای شما چی؟ یه امتحان سنگینی، یه فتنه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 495.72,
   "end": 500.56,
   "text": "خب این به توسط چی؟ بالاخره فعل الهی یه مجری می‌خواد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 500.56,
   "end": 505.84,
   "text": "توسط شیاطین. اسم خدا مذل هست یا نه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 505.84,
   "end": 508.84,
   "text": "ان الله يهدي من يشاء ويضل من يشاء.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 508.84,
   "end": 511.84,
   "text": "اسم خدا مذله. اسم خدا نمی‌تونه معطل بمونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 511.84,
   "end": 514.44,
   "text": "مجری می‌خواد. مجری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 514.44,
   "end": 516.78,
   "text": "اسم مذل حضرت حق شیاطینن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 516.78,
   "end": 521.38,
   "text": "مخصوصا اون ابلیس ملعون لعنت الله علیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 521.38,
   "end": 526.1,
   "text": "این‌ها دست به کار میشن. می‌ریزن سر ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 526.1,
   "end": 529.44,
   "text": "به حق این ساعت عزیز قسم می‌خورم اگر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 529.44,
   "end": 533.42,
   "text": "خیلی خودمونی بگم گاردمون بسته نباشه بیچاره‌مون می‌کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 533.42,
   "end": 536.24,
   "text": "چون ما ذو النفوس ضعیفه هستیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 536.24,
   "end": 539.44,
   "text": "گاردمون با چی بسته میشه؟ با احراز، با عوضات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 539.44,
   "end": 541.6,
   "text": "این همه بزرگان دستور دادن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 541.6,
   "end": 543.96,
   "text": "بهش-- میگه آقا کی گفته اینا خرافاته؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 543.96,
   "end": 546.28,
   "text": "امام رضا حرز داشته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 546.28,
   "end": 550.2,
   "text": "او که انسان کامله. بهش میگن کون جامع.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 550.2,
   "end": 552.7,
   "text": "اصلاً خودش حرزه. حرز جامع.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 552.7,
   "end": 555.32,
   "text": "باز حرز می‌بسته به باز مبارک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 555.32,
   "end": 559.9,
   "text": "یا تو یقه مبارکه. چطور او داشت ما نداشته باشیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 559.9,
   "end": 564.08,
   "text": "حالا من یه دستورالعمل خیلی ساده خدمتتون عرض می‌کنم که از بلاها فلان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 564.08,
   "end": 567.4,
   "text": "تا حرز پیدا کنید مخصوصا حرز شخصی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 567.4,
   "end": 571.66,
   "text": "که حرز کبیر امام جواد بارها من توصیه کردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 571.66,
   "end": 574.12,
   "text": "دیروز عزیزمونا شاهد بودند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 574.12,
   "end": 577.1,
   "text": "برادر عزیزمون آقای مستند شهوت–",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 577.1,
   "end": 579.8,
   "text": "شنود هست، مستند شنود خیلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 579.8,
   "end": 583.86,
   "text": "طرح شد همه جا. برادرش پیش ما بود اینجا دفتر ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 583.86,
   "end": 588.26,
   "text": "چه حرف‌هایی از بلاهایی که بندگان خدا اینا کشیده بودن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 588.26,
   "end": 589.9,
   "text": "از نوادگان شیخ صدوق‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 589.9,
   "end": 593.4,
   "text": "می‌دونید که. چرا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 593.4,
   "end": 595.3,
   "text": "حرز کبیر امام جواد نداشتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 595.3,
   "end": 601.88,
   "text": "بهشون گفتم. همه حرزها رو داشته باش اما تا اینو نداشته باشی بلاها پشت بلا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 601.88,
   "end": 606.2,
   "text": "شما نمی‌دونید بارها از زمان خانم دکتر قلی‌زاده از دوستانی که می‌شناسم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 606.2,
   "end": 611.9,
   "text": "نزدیک‌تری با هم یه مقدار. بارها گفتم شما نمی‌دونید با یک جلسه‌ای که بنده میرم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 611.9,
   "end": 618.96,
   "text": "یه ایه یازرا، یه لوح سینه مسجد بلال حتی ظهرهای اینجا چه بلاها می‌کشن اونوقت می‌آیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 618.96,
   "end": 623.02,
   "text": "چه مشکلاتی ایجاد می‌کنند جلوی پای ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 623.02,
   "end": 627.84,
   "text": "یه روز با تمام قوا جلوشون وایسادیم که بتونیم مسجد بلال رو انجام بدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 627.84,
   "end": 631.76,
   "text": "برمی‌گشتم از پشت سر من وایساده-- دیگه از وایسادم تو ترافان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 631.76,
   "end": 633.92,
   "text": "از پشت سر پنج تا ماشین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 633.92,
   "end": 637.8,
   "text": "محکم کوبیدن به ما. پنج تا ضربه محکم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 637.8,
   "end": 644.62,
   "text": "وقتی اومدم پایین خط به ماشین من نریخته بود ولی ماشین من همه جلو بندیا ریخته بود پایین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 644.62,
   "end": 649.36,
   "text": "چرا؟ اگر تو حرز داشته باشی حالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 649.36,
   "end": 652.26,
   "text": "اطاله سخن نکنم. بحثمون هم خیلی طول--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 652.26,
   "end": 657.28,
   "text": "می‌خواستم نظرات حضرت امام رو پیرامون این آیه بیان کنم بهمان روزهای بعد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 657.28,
   "end": 661.58,
   "text": "اون چیزی که می‌خواستم تقدیم کنم اگر تا حرز انشاالله تهیه کنید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 661.58,
   "end": 664.1,
   "text": "اینو داشته باشید از بلاها محفوظ بمونید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 664.1,
   "end": 668.72,
   "text": "هر وقت تو هر جمعی، جلسه‌ای، با فامیلی، خونواده‌ای جایی رفتی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 668.72,
   "end": 673.94,
   "text": "احساس کردی تو چشمید، در معرض دید قرار گرفتید، سریع دستتونو بیارید جلو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 673.94,
   "end": 679.4,
   "text": "وقتی می‌خواید پاشید برید، دستتونو بیارید دو تا دست رو جلو صورت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 679.4,
   "end": 685.04,
   "text": "سوره ناس و فلق و ایه‌الکرسی رو بخونید، بدمید به دستاتون بکشید به صورتتون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 685.04,
   "end": 691.4,
   "text": "اینو به خونواده‌تون هم یاد بدید تا انشاالله اون حرز رو تهیه کنید موقتاً انشاالله این دفع بلا می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 691.4,
   "end": 694.76,
   "text": "آقا من خیلی جدی دارم میگم برید اون بیست و یک جلسه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 694.76,
   "end": 701.08,
   "text": "احراز و عوضاتی که ما صحبت کردیم، یادگاران بزرگان رو تقدیم کردیم بخونید یه مقدار جدی بگیرید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 701.08,
   "end": 704.7,
   "text": "اللهم باریک لمولانا صاحب الزمان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 704.7,
   "end": 706.74,
   "text": "والحمد لله رب العالمين.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 706.74,
   "end": 709.74,
   "text": "صلوات الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 709.74,
   "end": 717.26,
   "text": "على محمد و آل محمد و عجل .",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}