 "chapters": [
  {
   "index": 0,
   "title": "## دستور توحیدیِ «ان‌شاءالله» در آیات کهف",
   "start": 13.14,
   "end": 33.24
  },
  {
   "index": 1,
   "title": "## شأن نزول؛ قطع وحی تا چهل روز",
   "start": 33.24,
   "end": 227.56
  },
  {
   "index": 2,
   "title": "## آدم و درخت؛ ترک ان‌شاءالله",
   "start": 227.56,
   "end": 288.04
  },
  {
   "index": 3,
   "title": "## نمونه‌های ان‌شاءالله در کلام انبیا",
   "start": 288.04,
   "end": 331.6
  },
  {
   "index": 4,
   "title": "آیۀ شصت‌ونه سورۀ کهف؛ حضرت خضر به موسی فرمود:",
   "start": 331.6,
   "end": 444.24
  },
  {
   "index": 5,
   "title": "## ان‌شاءالله در نوشته؛ روایت امام صادق",
   "start": 444.24,
   "end": 583.86
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 4.32,
   "end": 8.62,
   "text": "بسم الله الرحمن الرحيم و به این استعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 8.62,
   "end": 13.14,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 13.14,
   "end": 17.38,
   "text": "آیات. سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 17.38,
   "end": 23.5,
   "text": "در آیه بیست و سه و بیست و چهار سوره کهف ببینید چقدر زیبا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 23.5,
   "end": 29.98,
   "text": "به ما یه دستور خیلی عالی رو میده که حواسمون رو جمع کنیم در مسیر توحید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 29.98,
   "end": 32.74,
   "text": "آیه بیست و سه می‌فرماید: «ولا تقولن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 32.74,
   "end": 34.98,
   "text": "لشيء إني فاعل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 34.98,
   "end": 39.22,
   "text": "ذلک غدا». و هرگز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 39.22,
   "end": 42.26,
   "text": "«لا تقولن لشيء»",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 42.26,
   "end": 45.5,
   "text": "چیزی مگو که چی؟ «إني فاعل».",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 45.5,
   "end": 48.66,
   "text": "من کننده این کارم «ذلک غدا» فردا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 48.66,
   "end": 51.9,
   "text": "مثلا من فردا می‌خوام این کار رو انجام بدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 51.9,
   "end": 57.6,
   "text": "مسلبا این حرفو نزن که من می‌خوام این کار رو انجام بدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 57.6,
   "end": 62.52,
   "text": "آیه بعدش می‌فرماید: «إلا إن يشاء الله».",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 62.52,
   "end": 65.44,
   "text": "مگر اینکه بگی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 65.44,
   "end": 71.68,
   "text": "اگه خدا بخواد. «واذکر ربک إذا نسيت».",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 71.68,
   "end": 74.32,
   "text": "و اگر فراموش کردی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 74.32,
   "end": 78.46,
   "text": "یعنی مثلا ان شاء الله رو یادت رفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 78.46,
   "end": 81.58,
   "text": "«وقل عسى أن يهدني",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 81.58,
   "end": 86.6,
   "text": "ربي». بگو که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 86.6,
   "end": 88.8,
   "text": "پروردگارتو یاد کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 88.8,
   "end": 92.14,
   "text": "«عسى أن يهدني ربي",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 92.14,
   "end": 95.54,
   "text": "لأقرب من هذا رشدا».",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 95.54,
   "end": 100.28,
   "text": "امید است که پروردگارم مرا به راهی که نزدیک‌تره راهنمایی کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 100.28,
   "end": 104.08,
   "text": "اولا شأن نزول این آیه رو عرض کنم خدمتتون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 104.08,
   "end": 107.6,
   "text": "که شیخ طوسی علیه الرحمه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 107.6,
   "end": 110.08,
   "text": "خیلی عجیبه شأن نزول.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 110.08,
   "end": 116.98,
   "text": "دقت بفرمایید. می‌فرماید که از این جهت این آیه نازل شد که گروهی از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 116.98,
   "end": 121.4,
   "text": "یهودی‌ها و قریش اومدن پیش پیغمبر عزیز عالم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 121.4,
   "end": 125.78,
   "text": "قربونش بریم و در خصوص ذوالقرنین و اصحاب کهف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 125.78,
   "end": 129.02,
   "text": "سؤالای پیچیده و سنگینی کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 129.02,
   "end": 133.06,
   "text": "پیغمبر عزیز عالم خب معمولا منتظر وحی می‌شد دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 133.06,
   "end": 137.78,
   "text": "فرمودن برید فردا صبح بیاید جوابتون رو بگیرید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 137.78,
   "end": 140.66,
   "text": "این‌ها رفتن فردا که هیچی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 140.66,
   "end": 144.44,
   "text": "هر بار اومدن پیغمبر دو مرتبه فرمود هنوز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 144.44,
   "end": 147.68,
   "text": "وحی نیومده. بنده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 147.68,
   "end": 153.4,
   "text": "خیلی برام انقدر که عجیب بود گشتم، گشتم تو کتاب‌هایی که دم دستمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 153.4,
   "end": 162.68,
   "text": "ذیل این آیه در مستدرک الوسائل جلد شونزده صفحه شصت و یک از مولامون علی علیه الصلاة والسلام یه روایت پیدا کردم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 162.68,
   "end": 164.98,
   "text": "ذیل این آیه. که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 164.98,
   "end": 169.26,
   "text": "مولا فرمودن که وقتی به خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 169.26,
   "end": 171.64,
   "text": "فرمودن که وقتی به خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 171.64,
   "end": 176.14,
   "text": "سوگند بخورد تا چهل روز می‌تواند ان شاء الله بگوید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 176.14,
   "end": 178.1,
   "text": "کسی به خدا سوگند می‌خوره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 178.1,
   "end": 184.1,
   "text": "قسم به خدا می‌خوره تا چهل روز خدا بهش مهلت میده که ان شاء الله رو بگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 184.1,
   "end": 187.84,
   "text": "همین نگе مثلا به خدا قسم من این کارو می‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 187.84,
   "end": 191.04,
   "text": "خدا بهش چهل، چهل روز. چرا چهل روز؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 191.04,
   "end": 195.96,
   "text": "امیرالمؤمنین علیه الصلاة والسلام فرمودن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 195.96,
   "end": 203.64,
   "text": "فردا صبح که پیغمبر عزیز عالم وقتی اومدن ازشون سؤال کنن فرمود فردا صبح بیاید بهتون جواب بدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 203.64,
   "end": 207.12,
   "text": "به خاطر اینکه پیغمبر اینو مولا علی فرمودن سندش هم گفتم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 207.12,
   "end": 215.12,
   "text": "چون پیغمبر ان شاء الله نگفت تا چهل روز وحی قطع شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 215.12,
   "end": 219.32,
   "text": "دیگه شما-- میگه تو خود بخوان حدیث مفصل از این موضوع.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 219.32,
   "end": 223.2,
   "text": "وقتی پیغمبر نگه این اتفاق بیفته من و شما که دیگه سهله،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 223.2,
   "end": 232.24,
   "text": "جسارتا. در یه روایت خیلی شیرین دیگه‌ای در تفسیر اهل بیت اینجا دارم کتابش خواستید بیاید ببینید خیلی شیرین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 232.24,
   "end": 235.7,
   "text": "جلد هشت صفحه چهارصد و پنجاه و چهار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 235.7,
   "end": 238.28,
   "text": "امام باقر صلوات الله علیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 238.28,
   "end": 242.32,
   "text": "فرمودن که وقتی حضرت آدم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 242.32,
   "end": 250.9,
   "text": "وارد بهشت شد، پروردگار سبحان به حضرت آدم دستور داد که «ولا تقربا هذه الشجرة» نزدیک این درخت نشو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 250.9,
   "end": 252.58,
   "text": "حضرت آدم چی فرمود؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 252.58,
   "end": 257.08,
   "text": "چی عرض کرد به خدا؟ عرض کرد پروردگارا نزدیک نمی‌شم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 257.08,
   "end": 261.82,
   "text": "ان شاء الله نگفت. همون بلا سرش اومد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 261.82,
   "end": 264.52,
   "text": "یعنی خدا ولش کرد. بلا سر ما اومد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 264.52,
   "end": 270.98,
   "text": "نه همین که شما الان الحمدالله پشت سر آخوندی بلا سرتون نیومده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 270.98,
   "end": 276.64,
   "text": "حضرت آدم از بهشت بیرونتون کرد که بیاید ابتدا با آخوندها کنید دوباره برگردید بهشت ذات خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 276.64,
   "end": 281.68,
   "text": "و الا بهشت سیب و گلابی بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 281.68,
   "end": 286.4,
   "text": "حالا چند تا مورد من براتون بگم خیلی عالیه از قرآن درآورده‌ام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 286.4,
   "end": 289.46,
   "text": "ببینید چه کسانی، چه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 289.46,
   "end": 293.22,
   "text": "انسان‌های با عظمتی ان شاء الله گفتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 293.22,
   "end": 297.18,
   "text": "در سوره یوسف آیه نود و نه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 297.18,
   "end": 301.6,
   "text": "حضرت یعقوب به فرزندانش وقتی می‌خواد راهیشون کنه برن مصر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 301.6,
   "end": 306.46,
   "text": "می‌فرماید: «ادخلوا مصر إن شاء الله آمنین».",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 306.46,
   "end": 309.72,
   "text": "پیغمبر خلاص فقط میگه برید وارد بشید ان شاء الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 309.72,
   "end": 313.02,
   "text": "ان شاء الله با امان، با ایمنی و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 313.02,
   "end": 316.06,
   "text": "آرامش وارد شین. آیه شصت و نه سوره کهف.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 316.06,
   "end": 318.2,
   "text": "حضرت خضر به حضرت موسی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 318.2,
   "end": 321.18,
   "text": "می‌فرماید: «ستجدني إن شاء الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 321.18,
   "end": 327.78,
   "text": "صابرا». ان شاء الله حضرت موسی و حضرت خضر میگه ان شا الله منو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 327.78,
   "end": 331.1,
   "text": "صبر کننده صابر می‌یابی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 331.1,
   "end": 336.08,
   "text": "چون حضرت خضر سختگیر بود، حکمت می‌دونست، باطن اشیا رو می‌خوند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 336.08,
   "end": 338.18,
   "text": "می‌خواست به حضرت موسی حکمت یاد بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 338.18,
   "end": 340.98,
   "text": "حضرت موسی تو سه مرحله بیشتر طاقت نیاورد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 340.98,
   "end": 343.64,
   "text": "انقدر حکمت سنگینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 343.64,
   "end": 345.58,
   "text": "در آیه بیست و هفت قصه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 345.58,
   "end": 348.64,
   "text": "حضرت شعيب به حضرت موسی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 348.64,
   "end": 351.44,
   "text": "فرمود: «ستجدني",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 351.44,
   "end": 354.46,
   "text": "إن شاء الله من الصالحين»",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 354.46,
   "end": 356.34,
   "text": "منو از صالحا خواهی یافت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 356.34,
   "end": 360.8,
   "text": "ان شاء الله. در آیه صد و دو صافات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 360.8,
   "end": 362.96,
   "text": "حضرت اسماعیل به پدرش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 362.96,
   "end": 366.24,
   "text": "وقتی می‌خواست قربونیش کنه باباش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 366.24,
   "end": 368.9,
   "text": "شوخی نیستا. می‌خواد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 368.9,
   "end": 372.94,
   "text": "قربونیش کنه. می‌خواد سرشو ببره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 372.94,
   "end": 378.74,
   "text": "توجه کردی؟ سر شما رو تا حالا خواستن ببرن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 378.74,
   "end": 384.1,
   "text": "چی فرمود؟ عرض کرد ستجدنی ان شاء الله من الصابرین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 384.1,
   "end": 386.36,
   "text": "انشاالله، ان شاء الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 386.36,
   "end": 389.04,
   "text": "من الصابرین خواهید یافت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 389.04,
   "end": 391.54,
   "text": "و حالا نمونه‌های دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 391.54,
   "end": 393.68,
   "text": "یا مثلاً پیغمبر عزیز عالم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 393.68,
   "end": 397.66,
   "text": "اینا من که توجه می‌کردم هی یادم اومد که جالبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 397.66,
   "end": 399.46,
   "text": "چون خودم این دعا رو می‌خوندم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 399.46,
   "end": 403.88,
   "text": "وارد قبرستان که هر وقت می‌شدن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 403.88,
   "end": 406.9,
   "text": "پیغمبر وارد قبرس- قبرستان که می‌شدن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 406.9,
   "end": 408.82,
   "text": "این دعا رو حالا دعاش طولانیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 408.82,
   "end": 415.56,
   "text": "یه تیکه‌اش می‌فرماید انا ان شاء الله بکم لاحقون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 415.56,
   "end": 418.96,
   "text": "مگه مرگ قطعی نیست رفقا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 418.96,
   "end": 422.6,
   "text": "مگه صد درصدی نیست؟ حتمیه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 422.6,
   "end": 425.4,
   "text": "اما باز پیغمبر می‌فرماید ان شاء الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 425.4,
   "end": 429.8,
   "text": "بکم لاحقون. اگه خدا بخواد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 429.8,
   "end": 432.28,
   "text": "ما هم به شما ملحق می‌شیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 432.28,
   "end": 435.44,
   "text": "ببینید چه سری درشه. چه خبره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 435.44,
   "end": 440.04,
   "text": "بعد ما راحت قول میدیم، حرف می‌زنیم، قرار می‌ذاریم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 440.04,
   "end": 443.54,
   "text": "تصمیم می‌گیریم بدون توجه به حضرت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 443.54,
   "end": 448.34,
   "text": "و از اون عجیب‌تر اینکه در تفسیر نور خود آقای قراعی می‌دیدم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 448.34,
   "end": 454.72,
   "text": "امام صادق صلوات الله علیه فرمودن در نوشته‌های خود نیز ان شاء الله را فراموش نکنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 454.72,
   "end": 458.32,
   "text": "تو نوشتنتون. آقای این مدیر،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 458.32,
   "end": 462.7,
   "text": "ابلاغ می‌کنی این کار حتما انجام بشود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 462.7,
   "end": 466.02,
   "text": "خب یه ان شاء الله بیار. بعد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 466.02,
   "end": 471.7,
   "text": "روزی یه نامه‌ای رو خود حضرت امام صادق دستور میده یه نامه‌ای رو بنویسن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 471.7,
   "end": 474.2,
   "text": "وقتی نامه رو میارن خدمت حضرت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 474.2,
   "end": 477.94,
   "text": "حضرت نگاه می‌کنه می‌بینه ان شاء الله ننوشتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 477.94,
   "end": 486.24,
   "text": "می‌فرماید چگونه امید دارید که این کار به سر و سامان برسه و تموم شه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 486.24,
   "end": 488.6,
   "text": "در حالی که حت- تو نوشتن‌ها،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 488.6,
   "end": 491.7,
   "text": "تو نوشتن حتی ان شاء الله نگذاشتید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 491.7,
   "end": 498.82,
   "text": "خود آقای قراعی نقل می‌کردن که سوار هواپیما شده بودن بعد اون مهماندار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 498.82,
   "end": 503.78,
   "text": "داشت می‌گفتش که لحظاتی بعد نمی‌دونم در فرودگاه فلان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 503.78,
   "end": 507.6,
   "text": "می‌خوایم به زمین بنشینیم و کمربندهاتون رو محکم ببندین و فلان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 507.6,
   "end": 511.52,
   "text": "من براش هم گفتم که بگید ان شاء الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 511.52,
   "end": 514.36,
   "text": "به اون مهمانداره گفتم بگید ان شاء الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 514.36,
   "end": 516.28,
   "text": "به من گفتش که ان شاء الله نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 516.28,
   "end": 523.82,
   "text": "ما سپردیم به کامپیوتر هواپیما و خودش هم هر وقت بخواد می‌شینه و اصلاً دستور دادیم و ان شاء الله نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 523.82,
   "end": 529.96,
   "text": "می‌شینه دیگه. بهش گفتم که این همه هواپیماهایی که سقوط می‌کنن اون‌ها کامپیوتر نداشتن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 529.96,
   "end": 533.26,
   "text": "سیستم خودکار اتوماتیک نداشتن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 533.26,
   "end": 539.88,
   "text": "چگونه شد که سقوط کردن؟ یه ذره تو خودش رفت و فکر کرد راست میگه حرف، حرف حق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 539.88,
   "end": 544.12,
   "text": "رفت دو مرتبه بلندگو رو گرفت گفت ان شاء الله لحظاتی بعد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 544.12,
   "end": 546.3,
   "text": "در فرودگاه می‌شینیم. بعد برای من",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 546.3,
   "end": 550.22,
   "text": "آقای قرائتی میگن بهش یه هدیه دادن بخاطر این کارش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 550.22,
   "end": 555.14,
   "text": "از همین رو عادت کنیم. عادت کنیم ان شاء الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 555.14,
   "end": 560.18,
   "text": "پشت سر علما حرکت کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 560.18,
   "end": 565.72,
   "text": "علما، نه ما. ان شاء الله پشت سر آخوندها حالا ما شدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 565.72,
   "end": 567.92,
   "text": "پشت سر آخوندها. مدیرها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 567.92,
   "end": 572.72,
   "text": "نه مدیرها نه. ان شاء الله پشت سر اونا نباشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 572.72,
   "end": 576.58,
   "text": "اللهم بارک لمولانا صاحب الزمان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 576.58,
   "end": 578.68,
   "text": "والحمد لله رب العالمين.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 578.68,
   "end": 582.24,
   "text": "صلوات الله علیه. اللهم صل علی محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 582.24,
   "end": 583.86,
   "text": "و آل محمد و عجل فرجهم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}