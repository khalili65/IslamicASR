 "chapters": [
  {
   "index": 0,
   "title": "## شب نیمهٔ شعبان؛ شبی بی‌نظیر",
   "start": 19.26,
   "end": 39.28
  },
  {
   "index": 1,
   "title": "## فرق اجمال و تفصیل در نزول فیض",
   "start": 39.28,
   "end": 237.36
  },
  {
   "index": 2,
   "title": "## دعای شب؛ تعرض و قصد و أمل",
   "start": 237.36,
   "end": 324.44
  },
  {
   "index": 3,
   "title": "## لک فی هذا اللیل؛ چهار عطا و شرط منع",
   "start": 324.44,
   "end": 482.71
  },
  {
   "index": 4,
   "title": "## جوایز و عطايا",
   "start": 482.71,
   "end": 542.33
  },
  {
   "index": 5,
   "title": "## مواهب؛ هبهٔ برگشت‌ناپذیر",
   "start": 542.33,
   "end": 748.72
  },
  {
   "index": 6,
   "title": "## متن دعا؛ طاعون و وبا و اختلاف نسخ",
   "start": 748.72,
   "end": 858.18
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 6.4,
   "end": 10.42,
   "text": "بسم الله الرحمن الرحیم و به این استعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 10.42,
   "end": 18.12,
   "text": "والسلام علیک یا داعی الله و ربانیة آياته السلام عليكم ورحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 18.12,
   "end": 20.52,
   "text": "تبریک عرض می‌کنم شب بسیار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 20.52,
   "end": 25.78,
   "text": "پرخنده و نورانی و به یک معنا بی‌نظیریه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 25.78,
   "end": 29.82,
   "text": "خدا رحمت کنه حضرت علامه حسن زاده علیه رحمة الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 29.82,
   "end": 35.42,
   "text": "را که در کتاب شریف هزار و یک نکته‌شون چند تا نکته رو اختصاص دادن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 35.42,
   "end": 41.58,
   "text": "به لیلة القدر. در یکی از اون نکات می‌فرمایند که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 41.58,
   "end": 44.34,
   "text": "امشب یعنی شب نیمه شعبان،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 44.34,
   "end": 47.7,
   "text": "لیلة القدر تفصیلیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 47.7,
   "end": 54.2,
   "text": "اینطور نیست که حالا چون بعضیا میگن چون یک شب قدر مثلا اون هم در ماه مبارک رمضانه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 54.2,
   "end": 59.76,
   "text": "اینجا دیگه شک کردن به اینکه امشب شب قدره یا نه موضوعیت نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 59.76,
   "end": 62.78,
   "text": "یا میگن اگر ثابت بشه که مثلا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 62.78,
   "end": 68.4,
   "text": "شب بیست و سوم یا یکی از اون سه شب در ماه مبارک رمضان شب قدره، دیگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 68.4,
   "end": 70.78,
   "text": "امشب قطعا شب قدر نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 70.78,
   "end": 74.4,
   "text": "این، این نگاه غلطه. از نظر علامه اشتباه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 74.4,
   "end": 78.06,
   "text": "حضرت استاد نظرشون این بود که امشب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 78.06,
   "end": 83.02,
   "text": "صد درصد لیلة القدره اما لیلة القدر تفصیلیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 83.02,
   "end": 87.36,
   "text": "یا به یک معنا لیلة القدر فرقانیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 87.36,
   "end": 95.5,
   "text": "و اون شب قدری که در ماه مبارک رمضان هست لیلة القدر اجمالیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 95.5,
   "end": 98.86,
   "text": "یا لیلة القدر قرآنیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 98.86,
   "end": 101.44,
   "text": "حالا فرقشون در چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 101.44,
   "end": 104.26,
   "text": "اینه که ایشون معتقدن امشب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 104.26,
   "end": 107.68,
   "text": "که شب نیمه شعبان هست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 107.68,
   "end": 110.28,
   "text": "تمام اونچه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 110.28,
   "end": 113.84,
   "text": "مشیت حضرت حق، اراده حضرت حق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 113.84,
   "end": 121.56,
   "text": "در خصوص کلمات وجودی نظام هستی نه فقط انسان‌ها البته بالاخص انسان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 121.56,
   "end": 124.78,
   "text": "محقق می‌شه. اون اراده‌ای که خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 124.78,
   "end": 127.84,
   "text": "می‌خواد متحقq کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 127.84,
   "end": 132.34,
   "text": "بر نزول فیضش انواع و اقسام فیض‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 132.34,
   "end": 134.0,
   "text": "به صورت کلی می‌گیم فیض.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 134.0,
   "end": 137.26,
   "text": "حالا بگیم اقسام رزق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 137.26,
   "end": 141.62,
   "text": "رزق مادی، معنوی، جسمی، روحی، دنیوی، اخروی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 141.62,
   "end": 144.26,
   "text": "علمی، مالی، مادی همه جوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 144.26,
   "end": 151.5,
   "text": "همه، همه این‌ها رزق‌اند. همه این‌ها رو امشب به صورت تفصیلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 151.5,
   "end": 158.48,
   "text": "یا فرقانی جدا، جدا، جدا، جدا تک، تک امشب مشخص می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 158.48,
   "end": 164.58,
   "text": "اونم به واسطه انسان کامل که تنها عزیزیست که با بدن انسی در این نظام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 164.58,
   "end": 166.92,
   "text": "هستن و انسان کامل است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 166.92,
   "end": 170.0,
   "text": "حجت على الاطلاق حضرت حق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 170.0,
   "end": 176.26,
   "text": "پس حواسمون جمع باشه. اونی که در ماه رمضان اتفاق می‌افته حالا هر شبش که باشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 176.26,
   "end": 182.46,
   "text": "اون به صورت کلیه. کلیش اونجا امضا می‌شه و تایید می‌شه و تمام می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 182.46,
   "end": 184.7,
   "text": "ولّا جزئیش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 184.7,
   "end": 192.78,
   "text": "چون اینجا میگیم ا-- اینجا میگیم تفصیل، اونجا میگیم اجمال، اینجا میگیم فرقان، اونجا میگیم قرآن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 192.78,
   "end": 195.6,
   "text": "قرآن انا انزلناه في ليلة القدر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 195.6,
   "end": 200.22,
   "text": "در اون شب اجمالا و دفعةً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 200.22,
   "end": 205.44,
   "text": "به صورت یک حقیقت نوری کلی بر قلب پیامبر نازل شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 205.44,
   "end": 210.52,
   "text": "تفصیلش امشبه. یعنی جز، جز-",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 210.52,
   "end": 212.14,
   "text": "فضیلتش رو قبول دارم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 212.14,
   "end": 214.32,
   "text": "میگن همون فضیلت شب قدر رو داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 214.32,
   "end": 216.66,
   "text": "احسنت. فرمودیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 216.66,
   "end": 218.64,
   "text": "بله. ولی ایشون می‌فرمایند که اصلا شب قدر نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 218.64,
   "end": 221.52,
   "text": "بله این عرض کردم نظر حضرت علامه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 221.52,
   "end": 227.18,
   "text": "اما در هر حال اگر هم ما که، ما که کاره‌ای نیستیم که بخواهیم این نظر رو رد کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 227.18,
   "end": 232.16,
   "text": "اگر بخواهیم مثلا بگیم نه نظر علامه نباشه، کلا امشب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 232.16,
   "end": 235.36,
   "text": "فرمودند که شب بسیار با عظمت و پرفضیلتیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 235.36,
   "end": 239.62,
   "text": "اعمال زیادی رو برای امشب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 239.62,
   "end": 242.66,
   "text": "دستور دادند. در کتاب‌های مختلف می‌تونین رجوع کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 242.66,
   "end": 249.86,
   "text": "مخصوصا مفاتیح که روحش شالای به اجد خیلی تاکید دارن-- تاکید می‌کردن بر دعایه داخل مفاتیح.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 249.86,
   "end": 253.72,
   "text": "برای اینکه عظمت امشب رو متوجه بشیم من",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 253.72,
   "end": 258.5,
   "text": "توجه شما رو جلب می‌کنم به یه فرازی از دعایی که در امشب وارد شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 258.5,
   "end": 261.54,
   "text": "یکی از اعمال امشب این دعاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 261.54,
   "end": 266.24,
   "text": "که هم شیخ طوسی این دعا رو روایت کرده هم مرحوم کفامی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 266.24,
   "end": 269.84,
   "text": "که البته شیخ عباس هم در مفاتیح آورده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 269.84,
   "end": 272.46,
   "text": "در این دعا که البته دعای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 272.46,
   "end": 279.06,
   "text": "معروف به نماز بعد از نماز شب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 279.06,
   "end": 283.44,
   "text": "هم هست، منتها فضیلت اصلیش مال امشبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 283.44,
   "end": 291.26,
   "text": "عرض می‌کنیم به خدا که الهی تعرض لك في هذا الليل المتعرضون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 291.26,
   "end": 293.68,
   "text": "و قصد القاصدون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 293.68,
   "end": 299.14,
   "text": "و امل فضلک و معروفک الطالبون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 299.14,
   "end": 302.4,
   "text": "حالا من این‌ها رو فعلا رد می‌شم ازش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 302.4,
   "end": 305.24,
   "text": "می‌خوام یه نکته رو با هم توجه کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 305.24,
   "end": 307.94,
   "text": "و لك از اینجا به بعد رو توجه کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 307.94,
   "end": 312.24,
   "text": "و لك برای تو هست في هذا الليل در امشب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 312.24,
   "end": 316.58,
   "text": "یعنی قطعا صد درصد امشب این فضیلت رو داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 316.58,
   "end": 318.72,
   "text": "اگر هم نپذیریم شب قدر باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 318.72,
   "end": 322.82,
   "text": "اما این فضیلت رو ببینید تو متن دعاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 322.82,
   "end": 324.44,
   "text": "چه اتفاقی امشب می‌افته؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 324.44,
   "end": 328.94,
   "text": "و لك في هذا الليل یعنی دست-- تو دست به کاری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 328.94,
   "end": 331.62,
   "text": "حضرت حق. چه می‌کنی در این شب؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 331.62,
   "end": 335.04,
   "text": "نفحات و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 335.04,
   "end": 338.7,
   "text": "جوايزن. ببینید و لك",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 338.7,
   "end": 340.78,
   "text": "في هذا الليلة",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 340.78,
   "end": 344.42,
   "text": "نفحات و جوايزن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 344.42,
   "end": 349.26,
   "text": "و عطايا و محا-- مواهب الهی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 349.26,
   "end": 353.72,
   "text": "مواهبن. که حالا این‌ها رو به کی میدی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 353.72,
   "end": 357.62,
   "text": "حالا قبل از اینکه جز این چهار تا قسمت رو بگیم چی هستن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 357.62,
   "end": 360.2,
   "text": "این‌ها رو به کی میدی خدا امشب؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 360.2,
   "end": 362.34,
   "text": "تمن به ala",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 362.34,
   "end": 364.16,
   "text": "من تشاء من عبادک.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 364.16,
   "end": 368.65,
   "text": "هر کدوم از بندگان که دوست داشته باشی به اون میدی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 368.65,
   "end": 372.51,
   "text": "خب حالا به کی نمیدی؟ خیلی نکته عجیبیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 372.51,
   "end": 375.43,
   "text": "معمولا توجه به این قسمتش نمیشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 375.43,
   "end": 377.73,
   "text": "به کی نمیدی خیلی به نظرم مهمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 377.73,
   "end": 380.89,
   "text": "\"و تمنعها\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 380.89,
   "end": 385.35,
   "text": "این فیض چهارگانه خودت رو منعش می‌کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 385.35,
   "end": 390.49,
   "text": "از کیا؟ \"من لن تسبق له العناية منك\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 390.49,
   "end": 395.91,
   "text": "بر اون کسی که سابقه عنایت تو شامل حالش نشده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 395.91,
   "end": 400.19,
   "text": "یعنی قبل از امشب مورد عنایت تو واقع نشده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 400.19,
   "end": 402.09,
   "text": "اونا نه. اوناها رو منع.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 402.09,
   "end": 404.01,
   "text": "اونا میرن کنار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 404.01,
   "end": 406.77,
   "text": "خیلی عجیبه. یعنی کسی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 406.77,
   "end": 412.17,
   "text": "انقدر امشب عظمت داره که الان باید سابقه دار باشی تا امشب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 412.17,
   "end": 417.83,
   "text": "یعنی صدات در خونه حضرت حق آشنا باشه، ملائکه تو رو بشناسن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 417.83,
   "end": 424.99,
   "text": "تو رو دیده باشن در درگاه الهی که مورد توجه و عنایت حضرت حق قرار گرفتی که امشب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 424.99,
   "end": 428.91,
   "text": "این لطف چهارگانه حضرت حق شامل حال تو بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 428.91,
   "end": 432.75,
   "text": "حالا این الطاف چیان؟ می‌فرماید نفحات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 432.75,
   "end": 435.69,
   "text": "یه فرمایش پیغمبر عزّ عالم داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 435.69,
   "end": 440.95,
   "text": "یادتونه دیگه. \"إن في أيام دهركم نفحات\" یه بار دیگه همین جا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 440.95,
   "end": 445.57,
   "text": "عرض کردیم. \"ألا فتعرّوا لها\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 445.57,
   "end": 447.97,
   "text": "در عمر شما یک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 447.97,
   "end": 453.51,
   "text": "نفحه‌هاییست، یک نسیم‌های رحمتی می‌وزه البته از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 453.51,
   "end": 459.19,
   "text": "روح زمان که دهره و عرض کرده اونم روحش سرمده از عالم بالا نازل میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 459.19,
   "end": 461.91,
   "text": "خودتونو در معرض اون نسیم قرار بدید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 461.91,
   "end": 463.87,
   "text": "اینجا هم جمعش بسته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 463.87,
   "end": 465.81,
   "text": "\"ولک في هذه الليلة\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 465.81,
   "end": 467.99,
   "text": "نفحه نه، نفحات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 467.99,
   "end": 471.75,
   "text": "یعنی امشب صد درصد اون شبیه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 471.75,
   "end": 476.95,
   "text": "نسیم‌های رحمت خدا وزیدن می‌گیره اما برای اون سابقه دارا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 476.95,
   "end": 482.47,
   "text": "سابقه های قدایی سا- عبادت در درگاه خدا اجزا عنابه و لابه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 482.47,
   "end": 487.01,
   "text": "دیگه و جوايز اون. امشب شبیه که خدا جایزه میده به بنده هاش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 487.01,
   "end": 490.05,
   "text": "یعنی کسی اگه جایزه می‌خواد از خدا بسم الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 490.05,
   "end": 492.83,
   "text": "شبشه. و عطايا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 492.83,
   "end": 495.93,
   "text": "خدا عطا می‌کنه. بعدش می‌فرماید و مواهب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 495.93,
   "end": 499.71,
   "text": "این دو تا چه فرقی با هم داره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 499.71,
   "end": 503.79,
   "text": "عطايا عطای الهیه ولی تو باید براش زحمت بکشی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 503.79,
   "end": 508.13,
   "text": "اعطا می‌کنه اما تو باید قابلیتشو داشته باشی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 508.13,
   "end": 511.31,
   "text": "و احتمال داره که از تو بگیرش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 511.31,
   "end": 515.71,
   "text": "اینو حواسمون جمع باشه. جایزه رو خدا نمی‌گیره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 515.71,
   "end": 520.47,
   "text": "و تو یه زحمتی می‌کشی که دیگری نکشیده، این جایزه مال شما میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 520.47,
   "end": 523.05,
   "text": "اعطا مال خاص شما نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 523.05,
   "end": 526.49,
   "text": "فرقش باز با جایزه اینه. اعطا مال همه هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 526.49,
   "end": 530.31,
   "text": "یعنی به همه می‌تونه بده. جایزه نیست فقط به یه نفر و دو نفر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 530.31,
   "end": 535.41,
   "text": "به بعضیا بده. به همه می‌تونه بده اما باید یه زحمتی کشیده باشه طرف.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 535.41,
   "end": 540.37,
   "text": "یه پیش زمینه‌ای داشته باشه و اگرم داد این احتمال وجود داره که بگیرش،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 540.37,
   "end": 544.27,
   "text": "این عطاشو. حالا اینا تو مواهب فرقش در چی میشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 544.27,
   "end": 548.71,
   "text": "هبه الهی. در بحث، بحث اسماء الحسنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 548.71,
   "end": 550.81,
   "text": "داریم که هبه الهی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 550.81,
   "end": 553.97,
   "text": "یکی از اسامی خدا البخاوه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 553.97,
   "end": 557.13,
   "text": "به شدت بخشنده. چه بخشندگی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 557.13,
   "end": 561.79,
   "text": "چه هبه‌ای؟ هبه اولا به غیر استحقاقه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 561.79,
   "end": 563.59,
   "text": "یعنی فضل الهیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 563.59,
   "end": 566.25,
   "text": "خدا چون الفاضله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 566.25,
   "end": 571.49,
   "text": "تفضل می‌کنه، تو استحقاق نداری از کرمش می‌بخشه، یک.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 571.49,
   "end": 575.31,
   "text": "دو: این بخشش دیگه برگشتنی نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 575.31,
   "end": 578.77,
   "text": "یعنی داد که دیگه داده. مثل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 578.77,
   "end": 582.39,
   "text": "اعطا نیست. عطا رو بر-- پس می‌گیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 582.39,
   "end": 586.35,
   "text": "جایزه رو هم پس نمی‌گیره. عطا رو ولی پس می‌گیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 586.35,
   "end": 591.65,
   "text": "هبه رو پس نمی‌گیره. یعنی به قدری امشب ظرفیت داره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 591.65,
   "end": 593.27,
   "text": "خدا می‌تونه امشب یعنی تو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 593.27,
   "end": 598.27,
   "text": "می‌تونی خودت رو در معرض این نفحه‌های الهی به گونه‌ای قرار بدی که یه هبه‌ای به تو ببخشه که تا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 598.27,
   "end": 603.89,
   "text": "آخر عمرت بلکه همه نسلت ازش برخ-برخوردار باشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 603.89,
   "end": 607.65,
   "text": "ببین الان هبه‌ای که به حضرت زهرا شده به عنوان خیر کثیر،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 607.65,
   "end": 609.87,
   "text": "تمام پرچم داران",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 609.87,
   "end": 613.05,
   "text": "انقلاب‌های عالی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 613.05,
   "end": 618.07,
   "text": "در سطح د-- از زمان خود حضرت صدوق شهید بگی تا الان همه بچه سید بودن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 618.07,
   "end": 620.57,
   "text": "نگاه کنین شما همین الان ببین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 620.57,
   "end": 624.71,
   "text": "تو این کوران وحشتناک دنیا، این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 624.71,
   "end": 627.55,
   "text": "طوفان‌های حوادث آنچنانی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 627.55,
   "end": 631.85,
   "text": "پرچم عزت و عظمت و آرامش و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 631.85,
   "end": 635.69,
   "text": "سکون دست کیه؟ دست بچه‌های حضرت زهراست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 635.69,
   "end": 638.39,
   "text": "چه برکتی! بعدم همشو کشتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 638.39,
   "end": 641.69,
   "text": "هی هرچی که گیر میاوردن هی بچه حضرت زهراست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 641.69,
   "end": 644.03,
   "text": "می‌کشتن. این برکت رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 644.03,
   "end": 647.21,
   "text": "این هبه‌ست. این دیگه پس گرفتنی نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 647.21,
   "end": 650.75,
   "text": "یه چیزی امشب از خدا بگیریم ان شا الله بهش قرض الحجه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 650.75,
   "end": 653.81,
   "text": "که تا نسل در نسل‌مون ازش بهره‌برداری کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 653.81,
   "end": 657.43,
   "text": "نکته آخرم که عرض می‌کنم، یه دعایی هست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 657.43,
   "end": 663.77,
   "text": "که این دعا رو مرحوم آیت الله فشارکی در کتاب عنوان الكلامش آورده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 663.77,
   "end": 666.87,
   "text": "می‌تونید اونجا رجوع کنید. صفحه دویست و پنجاه و چهار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 666.87,
   "end": 669.05,
   "text": "حالا من نگاه کردم یه بخشیشو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 669.05,
   "end": 672.05,
   "text": "توی بعضی از سایت‌ها دیدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 672.05,
   "end": 676.69,
   "text": "یه ج-- قسمتشو بعضی جاها آوردن بعضی جاها نوردن، علتشو عرض می‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 676.69,
   "end": 679.87,
   "text": "این دعا رو خدا رحمت کنه آقا مجتهد теهرانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 679.87,
   "end": 682.29,
   "text": "فرمودن که اگر کسی امشب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 682.29,
   "end": 685.77,
   "text": "بین نماز مغرب و عشا بخونه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 685.77,
   "end": 688.79,
   "text": "به فرمایش امام حسن چه اتفاقی می‌افته؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 688.79,
   "end": 691.69,
   "text": "فرمودن قبل از اینکه سخن بگه، نماز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 691.69,
   "end": 697.37,
   "text": "مغربش تموم شد مثلا تسبیحات خانومه گفته قبل از اینکه سخن بگه یا رو تا از قبله برگردونی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 697.37,
   "end": 701.53,
   "text": "امشب این دعا رو بخون. بعد حالا چه فضیلتی داره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 701.53,
   "end": 705.55,
   "text": "فرمودن که هیچ مکروهی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 705.55,
   "end": 709.23,
   "text": "تا س-- شب نیمه شعبان سال بعد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 709.23,
   "end": 712.45,
   "text": "هیچ مکروهی به او نرسد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 712.45,
   "end": 716.23,
   "text": "و اگر عمر او تمام شده باشد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 716.23,
   "end": 719.61,
   "text": "خداوند عمر دوباره به او کرامت فرماید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 719.61,
   "end": 726.13,
   "text": "انقدر که این دعا پر-پر فضیلته بیست و یک بار این دعا باید خونده بشه بعد از نماز مغرب و عشا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 726.13,
   "end": 728.63,
   "text": "بنده حقیر استنباطم اینه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 728.63,
   "end": 731.4,
   "text": "شاید شما نپذیرید که با توجه به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 731.4,
   "end": 737.92,
   "text": "روایات مشابه اگر کسی وقت نکرد بین مغرب و عشا اینو بخونه رجاءً نه به قصد ورود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 737.92,
   "end": 742.4,
   "text": "رجاءً بعد از نماز عشا حالا تا صبح بخونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 742.4,
   "end": 744.42,
   "text": "من دعاش کوتاهه طولانی هم نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 744.42,
   "end": 748.72,
   "text": "می‌خونم براتون اون قسمتش که بعضی جاها نداره رو بگم علتش چیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 748.72,
   "end": 752.52,
   "text": "بسم الله الرحمن الرحیم. اللهم إنک علیم حلیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 752.52,
   "end": 755.9,
   "text": "ذو أنات و لا طاقة لنا بحکمک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 755.9,
   "end": 761.06,
   "text": "یا الله یا الله یا الله الأمان الأمان الأمان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 761.06,
   "end": 764.58,
   "text": "من الطاعون والوبا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 764.58,
   "end": 767.9,
   "text": "این طاعون و وبا به زعم بنده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 767.9,
   "end": 772.06,
   "text": "صرفا اون طاعون و وبای اونی نیست که قدیما بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 772.06,
   "end": 777.92,
   "text": "می‌تونه هر نوع مریضی صعب العلاج و جدیدی باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 777.92,
   "end": 781.68,
   "text": "من اینو دیدم نظر یکی از بزرگان بود که طاعون و وبا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 781.68,
   "end": 785.9,
   "text": "مخصوصا وبا مطلقاً مریضی‌های صعب العلاج رو می‌گفتن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 785.9,
   "end": 788.42,
   "text": "نه یه مریضی خاص رو فقط.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 788.42,
   "end": 791.18,
   "text": "پس می‌تونه این مریضی‌های عجیب و غریب امروزی هم باشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 791.18,
   "end": 793.44,
   "text": "و موت فجأة",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 793.44,
   "end": 798.68,
   "text": "یعنی مرگ ناگهانی. تو امان می‌گیری امشب از خدا از مرگ ناگهانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 798.68,
   "end": 803.26,
   "text": "و سوء القوی و شماتت الأعداء",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 803.26,
   "end": 805.8,
   "text": "ربنا اكشف عنا العذاب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 805.8,
   "end": 808.16,
   "text": "خدایا از ما عذاب رو دفع کن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 808.16,
   "end": 811.4,
   "text": "إنا مؤمنون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 811.4,
   "end": 816.64,
   "text": "این تو این متن که حالا من عکسشو دادم بچه ها گذاشتن تو کانال این دعا رو حفظ کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 816.64,
   "end": 818.94,
   "text": "اینجا بعضی از نسخه‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 818.94,
   "end": 822.66,
   "text": "به جای إنا مؤمنون آورده إنا موقنون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 822.66,
   "end": 825.96,
   "text": "خب؟ بعضی از نسخه‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 825.96,
   "end": 830.96,
   "text": "إنا مؤمنون تو پرانتز آورده إنا موقنون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 830.96,
   "end": 834.8,
   "text": "خب یعنی هم این احتمال هست که دو تاش باشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 834.8,
   "end": 838.06,
   "text": "هم این احتمال هست که شما هر کدومو بگی درسته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 214,
   "start": 838.06,
   "end": 841.66,
   "text": "پس اگر شما جایی دیدید که اختلافی وجود داره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 215,
   "start": 841.66,
   "end": 843.94,
   "text": "نگران اون اختلاف نباشید علتش این بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 216,
   "start": 843.94,
   "end": 846.68,
   "text": "برحمتک یا ارحم الراحمین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 217,
   "start": 846.68,
   "end": 850.08,
   "text": "اللهم بارک لمولانا صاحب الزمان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 218,
   "start": 850.08,
   "end": 852.06,
   "text": "والحمد لله رب العالمين.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 219,
   "start": 852.06,
   "end": 858.18,
   "text": "صلوات اللهم صل على محمد و آل محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}