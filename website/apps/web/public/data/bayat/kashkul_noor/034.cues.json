 },
 "chapters": [
  {
   "index": 0,
   "title": "آیه‌ای دیگر در خصوص ارزش توحید افعالی و کلاً موضوع توحید، آیهٔ هفتاد و نهم سورهٔ آل عمران است:",
   "start": 34.58,
   "end": 90.9
  },
  {
   "index": 1,
   "title": "## روایت امام باقر؛ شیعه مخاطب آیه",
   "start": 90.9,
   "end": 225.36
  },
  {
   "index": 2,
   "title": "## سنگینی تکلیف مدیران در کرامت نفس",
   "start": 225.36,
   "end": 271.74
  },
  {
   "index": 3,
   "title": "## شأن نزول اول و دوم؛ غیرت توحیدی پیامبر",
   "start": 271.74,
   "end": 425.8
  },
  {
   "index": 4,
   "title": "## بما کنتم تعلمون و تدرسون؛ خط توحیدی تربیت",
   "start": 425.8,
   "end": 502.78
  },
  {
   "index": 5,
   "title": "## آیت‌الکرسی قلهٔ قرآن؛ توحید و دفع شیاطین",
   "start": 502.78,
   "end": 711.1
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.16,
   "end": 7.34,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 7.34,
   "end": 12.78,
   "text": "السلام علیک یا داعی الله و ربانی آیات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 12.78,
   "end": 17.22,
   "text": "سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 17.22,
   "end": 21.9,
   "text": "آیه دیگری که در خصوص ارزش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 21.9,
   "end": 28.5,
   "text": "توحید افعالی و کلاً موضوع توحید هست آیه هفتادو نُه سوره آل عمران.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 28.5,
   "end": 30.84,
   "text": "ما کان لبشر ان يؤتیه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 30.84,
   "end": 34.58,
   "text": "ان يؤتیه الله الكتاب والحکم والنبوة.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 34.58,
   "end": 41.06,
   "text": "سه تا مو-- سه تا فاکتور رو اینجا مشخص می‌کنه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 41.06,
   "end": 44.58,
   "text": "کتاب، حکم، همون حکمت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 44.58,
   "end": 55.32,
   "text": "نبوت. ثم يقول للناس كونوا عبادا لي من دون الله ولكن كونوا ربانيین بما كنتم تعلمون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 55.32,
   "end": 58.06,
   "text": "می‌فرماید هیچ انسانی رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 58.06,
   "end": 63.14,
   "text": "سزاوار نیست که خدا این سه چیزو بهش بده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 63.14,
   "end": 67.26,
   "text": "کتاب، حکمت و نبوت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 67.26,
   "end": 73.28,
   "text": "بعد به مردم بگه در پس این سه، این سه اعطاء الهی به مردم بگه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 73.28,
   "end": 75.12,
   "text": "حالا بیا چکار کنید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 75.12,
   "end": 79.6,
   "text": "من دون الله، عبادا لي من دون الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 79.6,
   "end": 83.1,
   "text": "شما بشید بندگان ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 83.1,
   "end": 86.08,
   "text": "یعنی جای توحید رو عوض کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 86.08,
   "end": 88.48,
   "text": "اصلاً میگه سزاوار نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 88.48,
   "end": 90.9,
   "text": "اصلاً اینا با هم همجور در نمیان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 90.9,
   "end": 96.38,
   "text": "البته یه روایت داره که خیلی کیف کردم خود من در تفسیر اهل بیت اون رو تقدیم کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 96.38,
   "end": 100.42,
   "text": "خیلی شیرینه روایت. جلد دو، صفحه ششصد و چهل و شش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 100.42,
   "end": 103.76,
   "text": "خواستم آخر سر بگم اولش بگم کامتون شیرین شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 103.76,
   "end": 107.64,
   "text": "یه ذره خودتونو بهتر بشناسید، ارزش خودتون رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 107.64,
   "end": 110.66,
   "text": "دریابید. امام باقر سلام الله علیه فرمود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 110.66,
   "end": 114.6,
   "text": "این سه تایی که اینجا فرمود کتاب و حکم و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 114.6,
   "end": 117.3,
   "text": "نبوت رو، اینا رو به کی دادن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 117.3,
   "end": 121.08,
   "text": "اصلاً منظور نظر در، تو این آیه کیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 121.08,
   "end": 127.84,
   "text": "می‌فرماید الشیعة وهم اهل الكتاب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 127.84,
   "end": 130.3,
   "text": "وهم الذين أوتوا الكتاب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 130.3,
   "end": 133.26,
   "text": "والحکم والنبوة.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 133.26,
   "end": 136.2,
   "text": "شیعه ماست که این سه تا بهش داده شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 136.2,
   "end": 140.7,
   "text": "کتاب بهش داده شده، حکم یا حکمت داده شده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 140.7,
   "end": 145.1,
   "text": "نبوت داده شده. بله البته این نبوت از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 145.1,
   "end": 149.26,
   "text": "نوع نبوت تشریعی نیست دیگه اون خاتم تموم شد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 149.26,
   "end": 152.92,
   "text": "ختم پیدا کرد. این نبوت انباییه یا تعریفیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 152.92,
   "end": 155.24,
   "text": "یا عامه یعنی انبا--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 155.24,
   "end": 157.34,
   "text": "خ-- باخبر شدن از عالم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 157.34,
   "end": 159.7,
   "text": "از حقایق عالم هستی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 159.7,
   "end": 162.74,
   "text": "این درش که بسته نیست به روی ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 162.74,
   "end": 168.3,
   "text": "نبع یعنی خبر. شما نابع باشی به شدت میشه نبی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 168.3,
   "end": 170.54,
   "text": "شدیداً باخبر بشی از حقایق عالم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 170.54,
   "end": 173.26,
   "text": "این به شیعه داده شده. درست شد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 173.26,
   "end": 179.04,
   "text": "حالا میگه انقدر خدا اینطوری خودمونی بگیم انقدر خدا به شما حال داده، انقدر تحویلتون گرفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 179.04,
   "end": 182.24,
   "text": "آقای شیعه‌ها مبادا، مبادا خودپرست بشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 182.24,
   "end": 184.16,
   "text": "مبادا دعوت به خود داشته باشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 184.16,
   "end": 189.22,
   "text": "البته دلش میاد بیرون. انقدر که توحید مهمه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 189.22,
   "end": 192.92,
   "text": "میگه حواستون باشه صرفاً داعی الی الله باشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 192.92,
   "end": 196.44,
   "text": "پیغمبرش هم که اومده السلام علیک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 196.44,
   "end": 199.82,
   "text": "یا داعی الله و ربانی آیات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 199.82,
   "end": 203.16,
   "text": "امام عصر هم با اون عظمتش داعی الی الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 203.16,
   "end": 206.2,
   "text": "خدا نکنه کسی دعوت به سمت خودش کنه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 206.2,
   "end": 208.8,
   "text": "دعوت به نفس کنه، دعوت به خود کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 208.8,
   "end": 212.72,
   "text": "اینا بیچاره‌اند. بیچاره‌ترین آدما این‌هان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 212.72,
   "end": 217.64,
   "text": "مشخص هم هست آدم متکبر میشه، مغرور میشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 217.64,
   "end": 220.48,
   "text": "و ارزش و اهمیت برای دیگران قائل نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 220.48,
   "end": 225.36,
   "text": "کرامت نفس برای مردم قائل نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 225.36,
   "end": 228.1,
   "text": "و اینجا البته و یعنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 228.1,
   "end": 235.4,
   "text": "هر کسی که رتبه‌ش تو اجتماع بیشتره و بیشتر سر و کار با مردم داره وظیفه‌ش هم سنگین‌تر میشه کرامت نفسانی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 235.4,
   "end": 241.78,
   "text": "مدیران محترم چه عزیزانی که حضور دارن، چه کسایی که نیستن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 241.78,
   "end": 244.4,
   "text": "خیلی یعنی چوب سنگینی داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 244.4,
   "end": 247.34,
   "text": "کسی بی‌جهت کسی رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 247.34,
   "end": 251.44,
   "text": "راه نده تو دفترش. مدیران عزیز.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 251.44,
   "end": 253.12,
   "text": "اینا باید خیلی بهش توجه بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 253.12,
   "end": 259.4,
   "text": "یعنی اینا ریزه کاریای... یه بحثی کاش میشد یه وقتی مدیرها باشن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 259.4,
   "end": 263.66,
   "text": "ما آیاتی از قرآن که پیرامون مدیریته درباره‌ش حرف بزنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 263.66,
   "end": 268.04,
   "text": "انقدر آیات داریم توش ریزه کاریای مدیریت هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 268.04,
   "end": 271.22,
   "text": "بماند بحث ما توحید بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 271.22,
   "end": 277.54,
   "text": "اینجا اگر دقت بفرمایید توی این آیه شریفه حالا مثل شأن نزولش هم خدمتتون عرض کنم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 277.54,
   "end": 282.08,
   "text": "که چرا اصلاً این آیه نازل شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 282.08,
   "end": 286.42,
   "text": "یه شخصی اومد پیش پیغمبر دو تا شأن نزول براش بیان کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 286.42,
   "end": 291.32,
   "text": "گفت آقا ما هم که به شما سلام میدیم شما پیغمبر خدایی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 291.32,
   "end": 295.88,
   "text": "کمه سلام به شما. میشه اجازه بدین ما به شما سجده کنیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 295.88,
   "end": 301.82,
   "text": "مثل اینا که میرن رو میز مدیرشون سجده می‌کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 301.82,
   "end": 307.38,
   "text": "جان؟ هیچکس. حقتو خوردی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 307.38,
   "end": 311.74,
   "text": "شأن نزول دومش رو فرمودن که،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 311.74,
   "end": 313.82,
   "text": "چی فرمودن؟ فرمودن که ابو- بود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 313.82,
   "end": 318.84,
   "text": "but اشتباه گرفتیم. نه هنوزم هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 318.84,
   "end": 323.96,
   "text": "حالا مدیرایی که سرش می‌زنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 323.96,
   "end": 328.94,
   "text": "بله شخصی به نام ابو رافع.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 328.94,
   "end": 332.0,
   "text": "ابو رافع یه-- خودش یهودی بوده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 332.0,
   "end": 336.48,
   "text": "به همراه سرپرست گروه اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 336.48,
   "end": 341.22,
   "text": "نجران مسیحیا بودن با اون‌ها تو مدینه اومدن پیش پیغمبر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 341.22,
   "end": 344.74,
   "text": "ببین کشف فهمی تا کجا بوده که این‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 344.74,
   "end": 348.1,
   "text": "گفتن که خب حالا تو خیالشون اینطوری بود که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 348.1,
   "end": 352.88,
   "text": "شما چون الوهیت رو در خصوص حضرت عیسی قبول نمی‌کنی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 352.88,
   "end": 355.58,
   "text": "پیش خودشون می‌گفتن خب حتما چون برای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 355.58,
   "end": 362.16,
   "text": "شما قائل نیستیم العیاذ بالله، استغفرالله چون به خود شما الوهیت نمیدیم حضرت مسیح رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 362.16,
   "end": 368.68,
   "text": "قبول نمی‌کنی الوهیت. اومدن که اجازه بدید ما اعلام کنیم در خصوص شما حکم الوهیت بدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 368.68,
   "end": 375.24,
   "text": "یعنی شما العیاذ بالله الله یعنی توحید رو منحرف کنیم، منصرف کنیم به سمت شما معطوف کنیم به سمت شما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 375.24,
   "end": 379.66,
   "text": "پیغمبر به قدری عصبانی شد و ناراحت شد این آیه نازل شد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 379.66,
   "end": 383.6,
   "text": "یعنی تشفی خاطر خود پیغمبر هم به، به نحوی بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 383.6,
   "end": 390.78,
   "text": "این نشون میده که چقدر اصلاً غیرت انبیا میجوشه وقتی توحید بخواد منحرف بشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 390.78,
   "end": 395.66,
   "text": "از مسیر خودش. و چقدر خدا روی این قصه حساسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 395.66,
   "end": 399.22,
   "text": "یعنی رگ گردن اولیاش رو میزنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 399.22,
   "end": 403.7,
   "text": "اگر بخوان خدایی نکرده سر سوزنی از اون مسیر منحرف بشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 403.7,
   "end": 407.84,
   "text": "نگاه نکنیم خدا گناهان ما رو میبخشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 407.84,
   "end": 413.42,
   "text": "گناهان ما رو میبخشه به جهت اینکه الحمد لله تو توحید استوارین شما تو مسیرتون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 413.42,
   "end": 418.58,
   "text": "شیعه اینه دیگه. شیعه یه خصوصیتی داره که بهش این‌ها داده شده، عطا شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 418.58,
   "end": 421.26,
   "text": "یعنی توحیدش الحمد لله خالصه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 421.26,
   "end": 425.8,
   "text": "باید سعی کنیم تو عمل قوی‌ش کنیم، قوت بهش ببخشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 425.8,
   "end": 429.36,
   "text": "البته دو تا نکته هم اینجا هست نمیدونم توجه کردید یا نه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 429.36,
   "end": 435.58,
   "text": "انتهای آیه یه جا میفرماید «و ما کنتم تعلمون» اهمیت تعلیمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 435.58,
   "end": 438.76,
   "text": "یه جا میفرماید و «و ما کنتم تدرسون»",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 438.76,
   "end": 441.82,
   "text": "این که درس گرفتید. میگه شم-- این خیلی مهمه ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 441.82,
   "end": 447.86,
   "text": "میگه همین که شما اهل تعلیم دادن حقایق به دیگرانید،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 447.86,
   "end": 449.9,
   "text": "یعنی عالم هستید، بعد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 449.9,
   "end": 458.66,
   "text": "نسبت به اینکه میفرماید «و لکن کنوا ربانیین» از شما توقع میره که عالم ربانی باشید، مربی ربانی باشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 458.66,
   "end": 465.3,
   "text": "یکی اینکه دارید تعلیم علوم الهی رو میدید، یکی هم اینکه درس دارید میگیرید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 465.3,
   "end": 468.54,
   "text": "یعنی هر دو جهتشو داره میده تعلیم و تربیت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 468.54,
   "end": 474.04,
   "text": "انقدر این دو عظمت دارن که میفرماید که مبادا شما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 474.04,
   "end": 477.4,
   "text": "این جایگاه بزرگ خودتون رو از دست بدید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 477.4,
   "end": 481.82,
   "text": "تو تعلیم و تربیت یه وقت منحرف بشید به سمت چیزای دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 481.82,
   "end": 485.18,
   "text": "این خودش یه جایگاه توحیدیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 485.18,
   "end": 489.84,
   "text": "توجه کردید؟ داره خط دهی میکنه به معلّما، به مربی‌ها و مرباها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 489.84,
   "end": 492.12,
   "text": "کسایی که تحت تربیت هستن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 492.12,
   "end": 495.86,
   "text": "مربی و مرباش. این دو تا ن--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 495.86,
   "end": 502.78,
   "text": "بعد از اون طرف هم داره میفرماید که حواسمون باشه که رنگ و بوی تعلیم و تربیت باید بوی توحید بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 502.78,
   "end": 505.9,
   "text": "اصلاً شما دقت کنید اون بحث دیروز که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 505.9,
   "end": 509.14,
   "text": "نیمه کاره هم موند در خصوص آیت‌الکرسی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 509.14,
   "end": 511.12,
   "text": "درون مایه آیت‌الکرسی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 511.12,
   "end": 515.5,
   "text": "چیه که انقدر عظمت پیدا کرده و شده قله قرآن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 515.5,
   "end": 517.92,
   "text": "قله قرآن. این رو هم بگم رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 517.92,
   "end": 523.84,
   "text": "و دیگه بسه. اینا رو توجه کنید ما بدون منظور همینطوری نمیگیم اینا رو، منظور داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 523.84,
   "end": 527.68,
   "text": "اینکه نمیخوایم وقت شما رو، خودمونو بگیریم که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 527.68,
   "end": 537.0,
   "text": "اصلاً تمام این قصه‌ها، حکایات، قرآنی که احسن القصص گفته، اینا همه باید ما رو برسونه نهایتاً به موضوع توحید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 537.0,
   "end": 543.42,
   "text": "آیت‌الکرسی سرتاسر نظر علامه طباطبایی رو دیروز عرض کردیم، سرتاسر مراتب توحیده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 543.42,
   "end": 545.38,
   "text": "از توحید در الوهیتش،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 545.38,
   "end": 550.0,
   "text": "قیومیتش، مالکیتش، توحید در شفاعتش و غیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 550.0,
   "end": 554.2,
   "text": "چرا وقتی اون شخص اومد پیش امام صادق صلوات الله عليه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 554.2,
   "end": 557.86,
   "text": "گفت آقا جون اتفاقات عجیب و غریبی تو خونه‌م میفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 557.86,
   "end": 560.42,
   "text": "همه مردم به من و خونواده‌م بدبینن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 560.42,
   "end": 563.02,
   "text": "قابل توجه اونه که این مشکلات رو دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 563.02,
   "end": 565.46,
   "text": "همه از من، از خونواده‌م بدشون میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 565.46,
   "end": 568.04,
   "text": "دعوا میشه، بحث میشه، تو خونه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 568.04,
   "end": 569.88,
   "text": "سر و صداهای عجیب و غریب. اینا هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 569.88,
   "end": 574.94,
   "text": "قرن-- الانم که اجنه به شدت فعالن به قول رهبر عزیزمون و بزرگان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 574.94,
   "end": 580.7,
   "text": "حضرت میدونید چی فرمودن؟ فرمودن که این ارتفاع منزلت چقدره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 580.7,
   "end": 585.18,
   "text": "خیلی-- اصلاً این، این روایت، یه روایت استخون داره برای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 585.18,
   "end": 592.08,
   "text": "زدن تو دهن اون مهندسینی که فرهنگ غرب رو آوردن تو معماری اسلامی ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 592.08,
   "end": 595.12,
   "text": "ارتفاع خونه‌ت چقدره؟ گفت هشت ذرا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 595.12,
   "end": 597.24,
   "text": "ببخشید ده ذرا، ده ذرا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 597.24,
   "end": 600.52,
   "text": "حالا ذرا رو میگن از نوک انگشت بگیر تا آرنج.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 600.52,
   "end": 602.88,
   "text": "این حدودا یه آدم معمولی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 602.88,
   "end": 610.0,
   "text": "کمتر از مثلاً یک متر، حدوداً شصت متر، شصت سانت، هفتاد سانت این حدودا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 610.0,
   "end": 614.48,
   "text": "حضرت فرمود که تا هشت ذراش رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 614.48,
   "end": 616.22,
   "text": "توجه داشته باش تا کجا میشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 616.22,
   "end": 621.12,
   "text": "بین هشت ذرا و ده ذرا یعنی اون دو تا ذرا آخر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 621.12,
   "end": 624.74,
   "text": "به صورت دایره‌ای. دایره‌ای نه یعنی این شکلی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 624.74,
   "end": 630.68,
   "text": "دَوِرانی یعنی دور تا دور اون خونه‌ت رو بردار آیت‌الکرسی رو بنویس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 630.68,
   "end": 634.24,
   "text": "و این کارو کرد همه مشکلاتش برطرف شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 634.24,
   "end": 636.88,
   "text": "چرا؟ تو آیت‌الکرسی چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 636.88,
   "end": 641.7,
   "text": "درون مایه ش چیه که همه شیاطین رو دفع میکنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 641.7,
   "end": 645.98,
   "text": "و اصلاً صرف اینکه اون بالا بحثای علمی داره چرا اون بالا باید بنویسه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 645.98,
   "end": 649.24,
   "text": "بین هشت ذرا و ده ذ-ده ذرا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 649.24,
   "end": 652.66,
   "text": "مثل اون حکایت دیگه شبیه این هست که حضرت فرمود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 652.66,
   "end": 656.8,
   "text": "حالا نمیتونی چیزی بنویسی اونجا پنجره بزن و پنجره رو باز بذار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 656.8,
   "end": 660.54,
   "text": "هوا تردد کرد، هوای داغ و گرم رفت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 660.54,
   "end": 667.32,
   "text": "اجنه هم فرار کردن. جان جمع جنه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 667.32,
   "end": 670.62,
   "text": "نطفه‌شون از آتشه. از جاهای گرم خوششون میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 670.62,
   "end": 673.42,
   "text": "چرا می‌گفتن قدیمیا تو حموم عاد جن میاد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 673.42,
   "end": 675.92,
   "text": "اینو راسته حقیقت داره. خب؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 675.92,
   "end": 680.58,
   "text": "جایی که داغه-- دیدی وقتی عصبانی میشی داغ می‌کنی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 680.58,
   "end": 684.82,
   "text": "بارون رو دارم. شیاطین و اجنه افتادن به جانت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 684.82,
   "end": 689.18,
   "text": "میگه این پنجره رو باز بذار هوای گرم رفت اجنه هم شرشونو کم کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 689.18,
   "end": 692.92,
   "text": "اینا همه درسه، اینا بحثه باید روش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 692.92,
   "end": 697.74,
   "text": "واقعاً کلنجار بریم یه مقدار چکش کاری کنیم بفهمیم چه خبره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 697.74,
   "end": 702.38,
   "text": "چه خبره تو دین ما. وقتتون امروز یه ذره بیشتر از روزای دیگه گرفتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 702.38,
   "end": 704.06,
   "text": "حضورتون رو مختل شمردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 704.06,
   "end": 705.9,
   "text": "والحمد لله رب العالمين.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 705.9,
   "end": 709.56,
   "text": "صلوات بفرستیم. اللهم صل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 709.56,
   "end": 711.1,
   "text": "على محمد و آل محمد و عجل فرجهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}