 "chapters": [
  {
   "index": 0,
   "title": "## آیهٔ نور و زیتِ بی‌نیاز از آتش",
   "start": 27.22,
   "end": 225.96
  },
  {
   "index": 1,
   "title": "## مانع‌های راه و خطای طلب آتش بیرونی",
   "start": 225.96,
   "end": 291.0
  },
  {
   "index": 2,
   "title": "## فطرت‌الله و درجات نزول قرآن",
   "start": 291.0,
   "end": 461.55
  },
  {
   "index": 3,
   "title": "## موتوا قبل أن تموتوا؛ سفر از ظاهر به باطن خود",
   "start": 461.55,
   "end": 483.33
  },
  {
   "index": 4,
   "title": "## خودسازی مبتنی بر معرفت نفس",
   "start": 483.33,
   "end": 503.45
  },
  {
   "index": 5,
   "title": "## اندیت و شهادت",
   "start": 503.45,
   "end": 736.55
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 7.44,
   "end": 11.5,
   "text": "بسم الله الرحمن الرحیم و به این استعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 11.5,
   "end": 15.32,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 15.32,
   "end": 20.62,
   "text": "آیه. سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 20.62,
   "end": 23.7,
   "text": "یکادو زیتها یضیء",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 23.7,
   "end": 27.04,
   "text": "ولولم تمسسها نار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 27.04,
   "end": 33.16,
   "text": "یک بخشی از آیه سی و پنج سوره نور که معروف است به آیه نور.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 33.16,
   "end": 39.8,
   "text": "خدا رحمت کنه شیخ الرئیس رو که در کتاب اشارات و تنبیهاتش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 39.8,
   "end": 42.0,
   "text": "فکر می‌کنم در نقت ششم باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 42.0,
   "end": 44.52,
   "text": "اینجا اشاره به این آیه می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 44.52,
   "end": 47.06,
   "text": "نکته بسیار عالی رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 47.06,
   "end": 49.24,
   "text": "مطرح می‌کند در سیر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 49.24,
   "end": 54.76,
   "text": "معرفت نفس. می‌فرماید البته می‌دونید این آیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 54.76,
   "end": 60.54,
   "text": "از همون اولش که الله نور السماوات والارض مثل نوره کمشکات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 60.54,
   "end": 63.04,
   "text": "شروع می‌کنه. مثل،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 63.04,
   "end": 67.18,
   "text": "مثل نور و مشکات و مصباح و المصباح رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 67.18,
   "end": 71.28,
   "text": "یه مصباح نکره میاره، یه المصباح معرفه میاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 71.28,
   "end": 73.94,
   "text": "همینطوری یک یک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 73.94,
   "end": 79.08,
   "text": "در تأویل این آیه همه چهارده معصوم رو بیان می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 79.08,
   "end": 82.62,
   "text": "در یک روایتی هست ملاصدرا هم روحش شاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 82.62,
   "end": 87.02,
   "text": "در تفسیر سوره نورش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 87.02,
   "end": 90.34,
   "text": "خیلی زیبا این اختصاص",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 90.34,
   "end": 93.32,
   "text": "این آیه رو به چهارده معصوم بیان می‌کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 93.32,
   "end": 96.48,
   "text": "که اون مثل نور پیغمبره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 96.48,
   "end": 99.2,
   "text": "مشکات حضرت زهراست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 99.2,
   "end": 105.4,
   "text": "مصباح امام حسنه که نکره اومده، المصباح",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 105.4,
   "end": 109.32,
   "text": "امام حسینه که معرفه اومده و حرف‌های عالی رو پیاده می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 109.32,
   "end": 114.26,
   "text": "رجوع کنید به کتاب تفسیر سوره نور",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 114.26,
   "end": 117.02,
   "text": "ملاصدرا بسیار عالی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 117.02,
   "end": 122.28,
   "text": "حالا این بخشش که ولولم تس-تمسسها نار می‌فرماید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 122.28,
   "end": 124.56,
   "text": "یکادو زیتها یضیء.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 124.56,
   "end": 128.76,
   "text": "زیت اون روغن. می‌فرماید که کأن این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 128.76,
   "end": 132.3,
   "text": "روغنش یضیء",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 132.3,
   "end": 135.8,
   "text": "ازش نور همینطوری می‌پاشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 135.8,
   "end": 139.8,
   "text": "انتشار نور داره، انتشار نور داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 139.8,
   "end": 142.1,
   "text": "ولولم تمسسها نار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 142.1,
   "end": 147.72,
   "text": "در حالی که اصلاً هیچ آتشی رو مس نکرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 147.72,
   "end": 151.26,
   "text": "بعد این رو شیخ الرئیس میاره می‌زنه به نفس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 151.26,
   "end": 157.56,
   "text": "خیلی زیبا. می‌فرماید یکی از و-وجوه تعل-تأویل این آیه همین nefse.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 157.56,
   "end": 161.3,
   "text": "و چه نکات عالی. تو کتاب‌ها داره خاک می‌خوره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 161.3,
   "end": 166.2,
   "text": "و ما بی‌خبر. می‌فرماید که در درون ما چون بحث ما توحید بود دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 166.2,
   "end": 169.9,
   "text": "توحید ازلی بود. در درون ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 169.9,
   "end": 172.34,
   "text": "یک روغنی هست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 172.34,
   "end": 177.84,
   "text": "در درون وجود ما. چدی-چگونه‌ست که این چراغدان‌های قدیمی روغنی داشت که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 177.84,
   "end": 181.38,
   "text": "اون سوخت در حقیقت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 181.38,
   "end": 185.08,
   "text": "آتش فیضله این چراغ رو به عهده داشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 185.08,
   "end": 188.12,
   "text": "این روغنی که در درون ماست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 188.12,
   "end": 191.56,
   "text": "چنان می‌جوشه و چنان یضیء و چنان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 191.56,
   "end": 194.12,
   "text": "پرحرارت و پرنوره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 194.12,
   "end": 197.38,
   "text": "انتشار نورش چنان شدت داره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 197.38,
   "end": 201.5,
   "text": "که اصلاً نیازی نیست از بیرون آتش او رو مس کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 201.5,
   "end": 205.48,
   "text": "بعد متأسفانه ما همش از بیرون دنبال چیزی هستیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 205.48,
   "end": 209.02,
   "text": "که سالها دل طلب جام جمع از ما می‌کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 209.02,
   "end": 213.08,
   "text": "آنکه خود داشت ز بیگانگان تمنا می‌کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 213.08,
   "end": 215.88,
   "text": "هرچه هست در درون ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 215.88,
   "end": 219.4,
   "text": "این توحید، این روغن توحید،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 219.4,
   "end": 223.44,
   "text": "این جوشش توحید در درون ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 223.44,
   "end": 225.84,
   "text": "ما بیرون دنبالش می‌گردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 225.84,
   "end": 229.14,
   "text": "ما باید موانع رو البته کنار بزنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 229.14,
   "end": 234.64,
   "text": "أعم از موانع بیرونی و مبا-موانع",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 234.64,
   "end": 237.12,
   "text": "نفسی یا داخلی که در خودمون است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 237.12,
   "end": 241.08,
   "text": "چه در خارج، چه در داخل. این موانع رو کنار بزنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 241.08,
   "end": 244.34,
   "text": "دیگه موانع ما شاء شیطان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 244.34,
   "end": 251.52,
   "text": "انقدر زیاده که در کلاس اخلاق باید انسان شرکت کنه یا کتاب اخلاقی بخونه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 251.52,
   "end": 255.3,
   "text": "متوجه بشه که چه موانعی هست بر سر مسیر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 255.3,
   "end": 258.34,
   "text": "شناخت ما به خودمون. معرفت نفس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 258.34,
   "end": 261.92,
   "text": "یا در مسیر سیر و سلوک پا-- گام برداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 261.92,
   "end": 263.94,
   "text": "کتاب‌هایی مثل سیر و سلوک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 263.94,
   "end": 270.38,
   "text": "سید بحر العلوم رو یا جام صحبای علامه طباطبایی رو زانو بزنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 270.38,
   "end": 274.22,
   "text": "و استاد ببینه. ببینه چه خبره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 274.22,
   "end": 278.04,
   "text": "و چه موانعی بر سر راه ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 278.04,
   "end": 284.0,
   "text": "وجود داره که این ولولم تمسسها نار رو م-- نه ما نمی‌فهمیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 284.0,
   "end": 288.44,
   "text": "هی دنبال این هستیم که یه چیزی از بیرون ما رو آتیش بزنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 288.44,
   "end": 292.68,
   "text": "مثلاً می‌ریم سراغ قرآن که ما رو آتیش بزنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 292.68,
   "end": 296.38,
   "text": "کار درستی هم هست‌ها. اشتباه نشه‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 296.38,
   "end": 302.58,
   "text": "ولی این ابتدای راهه. می‌ریم سراغ اهل بیت که ما رو آتیش بزنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 302.58,
   "end": 305.26,
   "text": "می‌ریم سراغ خلوت که آتیش بگیریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 305.26,
   "end": 309.52,
   "text": "اون آتیشه در درونمون از بیرون بیاد داخل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 309.52,
   "end": 314.66,
   "text": "می‌ریم حرم که شعله‌ور بشه از داخل شعله‌ور بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 314.66,
   "end": 316.94,
   "text": "می‌ریم با اهل ایمان می‌شینیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 316.94,
   "end": 321.16,
   "text": "با اولیاء خدا مجالست و مصاحبت می‌کنیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 321.16,
   "end": 324.62,
   "text": "و مؤانست می‌کنیم که این شعله رو از بیرون بگیریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 324.62,
   "end": 331.16,
   "text": "در صورتی که این طرز تفکر کاملاً غلطه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 331.16,
   "end": 333.62,
   "text": "ما اصلاً می‌ریم حرم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 333.62,
   "end": 342.88,
   "text": "خودمون رو زیارت کنیم. ما قرآن می‌خونیم که قرآن وجود خودمون رو یادو-یاد کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 342.88,
   "end": 347.48,
   "text": "وذكر فان الذکرى تنفع المؤمنین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 347.48,
   "end": 350.28,
   "text": "این یا-- یکی از اسامی قرآن ذکره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 350.28,
   "end": 353.98,
   "text": "حلم مدکر. کسی نیست یادآوری کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 353.98,
   "end": 358.58,
   "text": "این قرآنی که بیرون رو سرت می‌گیری علامه سنزده علیه الرحمه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 358.58,
   "end": 361.16,
   "text": "می‌فرماید این قرآن تو دلته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 361.16,
   "end": 364.69,
   "text": "اصلاً قرآن تویی. تو قرآنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 364.69,
   "end": 367.45,
   "text": "هیچ کس قرآن نیست جز انسان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 367.45,
   "end": 370.23,
   "text": "انسان قرآنه، بقیه قرآن نیستن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 370.23,
   "end": 372.69,
   "text": "چرا قرآن برای حیوان نازل نشده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 372.69,
   "end": 374.49,
   "text": "چرا برای نبات نازل نشده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 374.49,
   "end": 376.25,
   "text": "چرا برای جماد نازل نشده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 376.25,
   "end": 379.41,
   "text": "حتی قرآن برای ملک نازل نشده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 379.41,
   "end": 383.55,
   "text": "چرا؟ ملک یک پارچه نوره که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 383.55,
   "end": 386.47,
   "text": "عقل محض. اما برای اون هم نازل نشده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 386.47,
   "end": 391.23,
   "text": "برای انسان نازل شده. چون یک نسخه از اون قرآن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 391.23,
   "end": 393.47,
   "text": "در وجود ما هست. فطرت الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 393.47,
   "end": 397.17,
   "text": "فطرت الله. قرآن از کجا اومده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 397.17,
   "end": 400.85,
   "text": "انا انزلناه في ليلة القدر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 400.85,
   "end": 402.55,
   "text": "این قرآن هم نازل شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 402.55,
   "end": 406.55,
   "text": "از کجا؟ از مرتبه الوهیت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 406.55,
   "end": 408.73,
   "text": "از مرتبه اله عالم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 408.73,
   "end": 411.87,
   "text": "الوهیت، ربوبیت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 411.87,
   "end": 415.05,
   "text": "از اون رتبه عالیه و اعلیی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 415.05,
   "end": 419.07,
   "text": "نازل شده اومده. این قرآن از اونجا اومده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 419.07,
   "end": 423.39,
   "text": "حالا ما متأسفانه مأنوس شدیم با همین سیاه قلم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 423.39,
   "end": 427.35,
   "text": "کتاب قرآن کتب شده انزل مراتب قرآن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 427.35,
   "end": 430.97,
   "text": "این، این مرتبه. با قرآن مثالی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 430.97,
   "end": 435.41,
   "text": "نمی‌دونم ارتباط داریم یا نداریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 435.41,
   "end": 440.57,
   "text": "آیا ما با مثال وجود خودمون ارتباط داریم که با قرآن مثالی ارتباط بگیریم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 440.57,
   "end": 443.69,
   "text": "رتبه مثال ما کجاست؟ برزخ وجودی ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 443.69,
   "end": 447.43,
   "text": "بهش میگن مثال متصل یا مقید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 447.43,
   "end": 453.77,
   "text": "از اون طریق مرحوم الهی طه طهائی برادر حضرت علامه طه طهائی ارتباط می‌گرفت با مثال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 453.77,
   "end": 455.47,
   "text": "مطلق یا منفصل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 455.47,
   "end": 459.87,
   "text": "بیرون از ما که برزخ خارجه که ارواح ما اونجان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 459.87,
   "end": 462.67,
   "text": "راه و رسم داره. هر چیزی دو تا، چهار تا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 462.67,
   "end": 466.73,
   "text": "یه فرمولی داره. همه اینا رو بزرگان سنگ حوادث خوردن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 466.73,
   "end": 470.53,
   "text": "سنگ جسارت خوردن. امثال ملاصدرا و شیخ رئیس‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 470.53,
   "end": 472.47,
   "text": "در کتاب‌هاشون پیاده کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 472.47,
   "end": 475.57,
   "text": "هیچ وقت فراموشمون نمیشه که استاد-- حضرت استاد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 475.57,
   "end": 477.55,
   "text": "فنس کشیده بودن تو قم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 477.55,
   "end": 482.79,
   "text": "پایگاه علم دور شیشه های خونه‌شون که طلبه‌ها سنگ می‌زدن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 482.79,
   "end": 485.85,
   "text": "به منزل علامه. نمی‌فهمیدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 485.85,
   "end": 489.01,
   "text": "زبان نفهم بودن که علامه چی داره میگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 489.01,
   "end": 494.37,
   "text": "این سنگ‌ها رو خوردن. حقایق رو در کتاب‌هاشون پیاده کردن و گفتن شماها سنگ زدین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 494.37,
   "end": 497.51,
   "text": "ما گفتیم و رفتیم. دیگه خودتون می‌دونین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 497.51,
   "end": 500.87,
   "text": "کدوم یکی از ما پیاده کردیم این مسائل رو در خودمون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 500.87,
   "end": 504.65,
   "text": "حالا تا بره قرآن عقلی، قرآن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 504.65,
   "end": 507.13,
   "text": "عرض شود قلبی، قرآن روحی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 507.13,
   "end": 510.91,
   "text": "همینجوری برو تا عالی‌ترین مراتب که ان من شه نلدی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 510.91,
   "end": 513.93,
   "text": "انا خزائن هو مرتبه اندیت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 513.93,
   "end": 516.03,
   "text": "که شهدا به اون مقام رسیدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 516.03,
   "end": 519.11,
   "text": "به قول بارها عرض کردیم به قول مرحوم حضرت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 519.11,
   "end": 524.51,
   "text": "آیت الله وحید در کتاب شریف حلقه وصل رسالت و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 524.51,
   "end": 528.95,
   "text": "امامت‌شون می‌فرمود اون مقام اندیت مقام فاطمه زهراست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 528.95,
   "end": 532.17,
   "text": "عجب! یعنی شهید میره تا اونجا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 532.17,
   "end": 534.87,
   "text": "بله. خطشو امام رئوف دادن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 534.87,
   "end": 537.97,
   "text": "فرمودن معنا فی درجاتنا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 537.97,
   "end": 540.37,
   "text": "معنا فی درجاتنا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 540.37,
   "end": 543.59,
   "text": "بله. بله. چون اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 543.59,
   "end": 546.39,
   "text": "انسان کامله. یعنی چی انسان کامل؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 546.39,
   "end": 550.11,
   "text": "اگر انسان کامل کتاب بشه میشه قرآن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 550.11,
   "end": 556.25,
   "text": "یعنی در حقیقت قرآن شرح کتبی انسان کامله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 556.25,
   "end": 561.53,
   "text": "اگر انسان کامل باز بشه عینیت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 561.53,
   "end": 564.43,
   "text": "آفاقی پیدا کنه میشه نظام آفاقی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 564.43,
   "end": 567.15,
   "text": "پس نظام آفاقی عوالم هستی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 567.15,
   "end": 572.03,
   "text": "میشه شرح عینی انسان کامل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 572.03,
   "end": 576.07,
   "text": "انسان کامل چیه؟ حقیقت قرآنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 576.07,
   "end": 580.47,
   "text": "خب آیا ما در خودمون حقیقت قرآن رو داریم یا نداریم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 580.47,
   "end": 583.57,
   "text": "داریم. ازش بی‌خبریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 583.57,
   "end": 587.93,
   "text": "ما ازش بی‌خبریم. تک تک آیه‌های قرآن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 587.93,
   "end": 590.41,
   "text": "سوره‌های قرآن، کل قرآن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 590.41,
   "end": 593.69,
   "text": "وقتی می‌خونی برات یادآوریه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 593.69,
   "end": 595.69,
   "text": "این حقایق در ما پیاده شده است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 595.69,
   "end": 598.15,
   "text": "چرا نمی‌فهمن؟ چرا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 598.15,
   "end": 600.67,
   "text": "متوجه نمیشن؟ حجاب آقا حجاب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 600.67,
   "end": 603.95,
   "text": "خودم برای خودم حجاب شدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 603.95,
   "end": 607.99,
   "text": "تا دیر نشده، تا سرمون به سنگ لحد نخورده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 607.99,
   "end": 613.01,
   "text": "و فکشفنا انک فتاک فبصرک الیوم حدید نشده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 613.01,
   "end": 615.65,
   "text": "موتو قبلاً تموتو. همینجا بمیریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 615.65,
   "end": 617.99,
   "text": "یعنی سفر کنیم از ظاهر به باطن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 617.99,
   "end": 623.41,
   "text": "از ظاهر به باطنت چی؟ بیرون از خودم نه خیر، از ظاهر خودت به باطن خودت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 623.41,
   "end": 626.97,
   "text": "سفر کن. چگونه است که هر شب خدا داره سفرت میده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 626.97,
   "end": 632.45,
   "text": "سیرت میده تو عالم برزخ وجودی یا قوه خیالت یا مثال متصلت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 632.45,
   "end": 636.45,
   "text": "هر شب کجا میری می‌خوابی؟ میری تو رتبه مثالی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 636.45,
   "end": 641.65,
   "text": "خدا داره سیرت میده. خب زحمت بکش از رتبه مثالی برو به رتبه عقلیت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 641.65,
   "end": 645.41,
   "text": "یعنی با ملائکه هم‌نشین شو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 645.41,
   "end": 649.31,
   "text": "از رتبه عقلیت برو به قلبی‌ت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 649.31,
   "end": 651.85,
   "text": "با پیغمبر هم‌نشین شو. از رتبه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 651.85,
   "end": 653.83,
   "text": "قلبی‌ت برو به مرتبه روحی‌ت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 653.83,
   "end": 656.03,
   "text": "اصلاً ارتباط با روحمون ما داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 656.03,
   "end": 657.95,
   "text": "چرا انقدر ما ضعیف اراده‌ایم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 657.95,
   "end": 660.89,
   "text": "چون ارتباطمون با روحمون به حداقل رسیده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 660.89,
   "end": 663.83,
   "text": "اراده جاش تو روح انسانه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 663.83,
   "end": 667.43,
   "text": "روح ارتباطش با بدن به حداقل ممکن می‌رسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 667.43,
   "end": 672.23,
   "text": "اراده ضعیف میشه. عزیزان ما هیچ چاره‌ای-- جمله آخرم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 672.23,
   "end": 675.73,
   "text": "ببخشید وقتتون رو گرفتم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 675.73,
   "end": 680.95,
   "text": "رو این جمله بریم کار کنیم. بارها عرض کردیم حضرت استاد فرمودن علامه حسن زاده له الرحمة.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 680.95,
   "end": 683.45,
   "text": "انشاالله استاد اشراقی همه‌مونن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 683.45,
   "end": 686.71,
   "text": "فرمودن که ما کاری مهم‌تر از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 686.71,
   "end": 689.71,
   "text": "چی نداریم؟ خانم دکتر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 689.71,
   "end": 692.17,
   "text": "معرفت نفس. نه، نه، نه. اون بعداً.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 692.17,
   "end": 695.05,
   "text": "اون راهشه. ما کاری--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 695.05,
   "end": 697.35,
   "text": "آقا حسین. جز؟ آفرین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 697.35,
   "end": 701.87,
   "text": "خودسازی. ما کاری مهم‌تر از خودسازی نداریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 701.87,
   "end": 706.61,
   "text": "حالا خانم دکتر فرمودند و خودسازی مبتنی است بر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 706.61,
   "end": 710.73,
   "text": "معرفت نفس. علم عملی در جامعه، علم عملی در- بله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 710.73,
   "end": 712.89,
   "text": "پس ما هیچ چاره‌ای نداریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 712.89,
   "end": 716.29,
   "text": "اگر کسی دنبال معرفت نفس و شناخت خودش نیست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 716.29,
   "end": 720.01,
   "text": "به توحید، راه توحید رو به روی خودش سد کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 720.01,
   "end": 721.59,
   "text": "از درون باید بجوشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 721.59,
   "end": 724.59,
   "text": "قربونت برم. بیرون خبری نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 724.59,
   "end": 728.37,
   "text": "الله مبارک لمولانا صاحب الزمان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 728.37,
   "end": 730.55,
   "text": "والحمد لله رب العالمين.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 730.55,
   "end": 732.67,
   "text": "صلوات بفرستید. اللهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 732.67,
   "end": 736.55,
   "text": "صل على محمد و آل محمد عاجلا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}