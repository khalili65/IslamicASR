 },
 "chapters": [
  {
   "index": 0,
   "title": "## تسلیت و سایهٔ کاذب نه جنگ نه صلح",
   "start": 0.08,
   "end": 43.42
  },
  {
   "index": 1,
   "title": "## دو هدف پازل هراس",
   "start": 43.42,
   "end": 151.0
  },
  {
   "index": 2,
   "title": "## پازل ارزی و تعرفه",
   "start": 151.0,
   "end": 171.38
  },
  {
   "index": 3,
   "title": "## ترور و نرخ تخریب؛ کشته‌سازی",
   "start": 171.38,
   "end": 192.56
  },
  {
   "index": 4,
   "title": "## ناآرامی‌ها و غربال آخرالزمان",
   "start": 192.56,
   "end": 556.69
  },
  {
   "index": 5,
   "title": "## دعا در شب آشوب؛ دعای سرّ امیرالمؤمنین",
   "start": 556.69,
   "end": 668.97
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.08,
   "end": 5.44,
   "text": "الله اکبر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 5.44,
   "end": 10.06,
   "text": "الله اکبر. بسم الله الرحمن الرحیم و به این استعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 10.06,
   "end": 14.06,
   "text": "السلام علیک یا دعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 14.06,
   "end": 17.1,
   "text": "آیاته. سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 17.1,
   "end": 20.94,
   "text": "سلام علیکم. تسلیت عرض می‌کنیم هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 20.94,
   "end": 24.84,
   "text": "شهادت جمعیت هموطنان عزیزمون رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 24.84,
   "end": 33.36,
   "text": "و هم شهادت حضرت موسی بن جعفر علیهم الصلاة والسلام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 33.36,
   "end": 37.38,
   "text": "خیلی ماه‌های گذشته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 37.38,
   "end": 40.38,
   "text": "یه سایه سنگینی رو سر مردم بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 40.38,
   "end": 42.94,
   "text": "ما هر جا رفتیم گفتیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 42.94,
   "end": 47.12,
   "text": "که آقا این سایه، سایه کاذبی هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 47.12,
   "end": 49.0,
   "text": "اینو درش دارین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 49.0,
   "end": 51.92,
   "text": "سایه نه جنگ نه صلح.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 51.92,
   "end": 56.84,
   "text": "همه جا پر شده بود. تو فامیل‌های خود ما هی به هر کی می‌رسیدی حاج قراره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 56.84,
   "end": 59.9,
   "text": "کی حمله کنن؟ بعد از جنگ دوازده روزه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 59.9,
   "end": 62.94,
   "text": "دوباره میخوان حمله کنن. کی میخوان حمله کنن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 62.94,
   "end": 67.48,
   "text": "فاطمیه میخوان حمله-- فاطمیه اول قراره حمله کنن، فاطمیه دوم هم--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 67.48,
   "end": 69.34,
   "text": "تولد حضرت زهرا دیگه قطعیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 69.34,
   "end": 71.28,
   "text": "همین جوری هی تاریخ میدادن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 71.28,
   "end": 75.46,
   "text": "اینا از کجا بود؟ از خارج از کشور.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 75.46,
   "end": 79.4,
   "text": "هی القا می‌شد تو پیام‌رسان‌های",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 79.4,
   "end": 83.2,
   "text": "خارجی و داخلی هم که بهش دامن می‌زدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 83.2,
   "end": 85.18,
   "text": "ما همون موقع حالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 85.18,
   "end": 90.34,
   "text": "بعضی از دوستان که تو جلسات معرفت نفس مسجد بلال حاضر بودن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 90.34,
   "end": 93.0,
   "text": "شاهدن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 93.0,
   "end": 96.88,
   "text": "بعد از جنگ دوازده روزه ما یه بررسی کردیم، همونجا اعلام کردیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 96.88,
   "end": 102.9,
   "text": "از نظر علم نجوم ما هرچی بررسی می‌کنیم، علم نجوم حال نمیگیم صد درصد قطعیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 102.9,
   "end": 108.62,
   "text": "اما اونچه که ما می‌بینیم از طریق علم نجوم، امسال جنگی دیگه نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 108.62,
   "end": 111.98,
   "text": "جنگ، جنگ شناختیه. اون موقع هم هی گفتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 111.98,
   "end": 115.62,
   "text": "گفتیم که آقا این جنگه، امسال جنگ شناختیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 115.62,
   "end": 120.4,
   "text": "هر جا هم رفتیم، هیئت خودمون، هر جا تریبونی دستمون بود اینو گفتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 120.4,
   "end": 124.82,
   "text": "متاسفانه هی انقدر این رو ادامه دادن تا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 124.82,
   "end": 130.62,
   "text": "پادزهرش رو خدا حفظ کنه رهبر عزیزمون و سایه‌ش همیشه سر ما باشه، ایشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 130.62,
   "end": 134.18,
   "text": "زدن پادر-- که اونجایی که توی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 134.18,
   "end": 138.44,
   "text": "دیدارشون با هیئت دولت بود فکر می‌کنم گفتن که آقا این س--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 138.44,
   "end": 141.4,
   "text": "نه جنگ نه صلح و اینو از بین ببریدش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 141.4,
   "end": 145.66,
   "text": "بیفتید به کار و تلاش. چرخه اقتصادی رو به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 145.66,
   "end": 148.74,
   "text": "کار بندازید، به جریان بندازید این‌ها...",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 148.74,
   "end": 154.14,
   "text": "این یکی از قسمت‌های پازل دشمن بود که چی بشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 154.14,
   "end": 157.16,
   "text": "که مردم رو جا-- بندازه تو هراس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 157.16,
   "end": 161.5,
   "text": "به دو دلیل: یک، تاب آوری مردم کم بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 161.5,
   "end": 168.52,
   "text": "هی هول و هراس جنگ که میاد تو ذهن مردم اصن تابشون میاد پایین، طاقتشون میاد پایین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 168.52,
   "end": 174.6,
   "text": "از جهت روانی بچه‌ها آسیب می‌بینن، خانم‌ها آسیب می‌بینن، آقایون آسیب می‌بینن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 174.6,
   "end": 181.76,
   "text": "بیشتر از همه بچه‌ها. من دیگه شاید هر روز برای بچه‌های خودم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 181.76,
   "end": 188.02,
   "text": "دلیل و مدرک می‌آوردم که اگه باباتونو قبول دارید خیالتون راحت جنگی نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 188.02,
   "end": 192.56,
   "text": "اینا بچه‌های خودمن چه برسه کسای دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 192.56,
   "end": 196.98,
   "text": "نکته دومش این بود که فلج کنن چرخه اقتصادی رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 196.98,
   "end": 199.56,
   "text": "چرا؟ خودتون می‌دونید دیگه الان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 199.56,
   "end": 202.72,
   "text": "واقعاً کسایی که تو کار اقتصادی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 202.72,
   "end": 208.36,
   "text": "چه اونایی که وارد می‌کردن، چه اونایی که صادر می‌کردن، چه اونایی که نه صرفاً در حد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 208.36,
   "end": 212.88,
   "text": "یه بازارچه ای مثلا تولیداتی چیزی داشتن همه فلج بودن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 212.88,
   "end": 218.96,
   "text": "بازاریامون گفتن ما به چه امیدی مثلا چرخه اقتصادی‌مون رو دوباره فعال کنیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 218.96,
   "end": 221.98,
   "text": "اگه قرار باشه دوباره جنگ بشه چی میشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 221.98,
   "end": 225.7,
   "text": "اونایی که پول داشتن مونده بودن پولشونو کجا سرمایه‌گذاری کنن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 225.7,
   "end": 228.52,
   "text": "همش از ترس جنگ، جنگ، جنگ.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 228.52,
   "end": 232.18,
   "text": "دیدید که خبری هم نشد. این یه پازل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 232.18,
   "end": 235.28,
   "text": "پازل بعدیشون این بود که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 235.28,
   "end": 238.16,
   "text": "بیان و این کارا رو هم کردن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 238.16,
   "end": 241.44,
   "text": "مقابله کنن از ورود ارز به ایران",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 241.44,
   "end": 245.36,
   "text": "و اون کسایی که به هر دلیلی و به هر نحوی با ایران",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 245.36,
   "end": 249.08,
   "text": "وارد معادلات تجاری میشن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 249.08,
   "end": 252.98,
   "text": "و با ایران حالا چه از حیث واردات، چه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 252.98,
   "end": 256.4,
   "text": "صادرات معامله می‌کنن با ایران،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 256.4,
   "end": 258.5,
   "text": "همه‌شون رو بترسونن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 258.5,
   "end": 261.46,
   "text": "حالا یا تهدید کنن یا تطمیع.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 261.46,
   "end": 264.84,
   "text": "حتی این اواخر که دیگه این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 264.84,
   "end": 268.54,
   "text": "قمارباز معلوم دیگه تعرفه بیست و پنج درصدی هم داد دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 268.54,
   "end": 270.88,
   "text": "گفت اونایی که با ایران بخوان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 270.88,
   "end": 274.72,
   "text": "معامله اقتصادی داشته باشن تعرفه بیست و پنج درصدی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 274.72,
   "end": 278.4,
   "text": "گذاشتن و تهدید کرد، چه کرد، چه کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 278.4,
   "end": 282.0,
   "text": "اینم یه پازل بعدیشون بود که چی بشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 282.0,
   "end": 285.92,
   "text": "که فلج کنن از جهت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 285.92,
   "end": 290.64,
   "text": "اه معادلات بین‌المللی اقتصاد ایران رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 290.64,
   "end": 292.84,
   "text": "همه این‌ها برای چی بود؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 292.84,
   "end": 295.16,
   "text": "همه این‌ها برای این بود که این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 295.16,
   "end": 298.98,
   "text": "آخرین پازلشون، این شکل بگیره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 298.98,
   "end": 304.5,
   "text": "که چی بشه؟ مردم از جهت اقتصادی به شدت به هم بریزن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 304.5,
   "end": 308.66,
   "text": "عیادی خارجیشون، عیادی داخلیشون دست به دست هم بدن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 308.66,
   "end": 315.58,
   "text": "اقتصاد ایران به نحوی فلج بشه که مردم دیگه طاقت نیارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 315.58,
   "end": 323.16,
   "text": "همین چیزی که دیدیم دیگه. متاسفانه بعضی تصمیمات غلط داخلی‌ها و دولت مردان ما هم تشدیدش کرد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 323.16,
   "end": 327.2,
   "text": "و از ناب داخلی‌شون و نفوذی‌هاشون هم که به یک طرف،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 327.2,
   "end": 331.4,
   "text": "فشار رو انقدر سنگین کردن که دیگه اعتراض شروع شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 331.4,
   "end": 334.08,
   "text": "اعتراض که شروع شد اونا از قبل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 334.08,
   "end": 338.42,
   "text": "همونطور که رهبر عزیزمون هم فرمودن و دیگران هم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 338.42,
   "end": 343.68,
   "text": "خبر داشتن گفتن، از قبل برنامه ریزی شده بود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 343.68,
   "end": 352.2,
   "text": "خارج از کشور تروریست‌ها آماده شده بودن، بعد رفته رفته تو این چند ماه خورد خورد وارد کرده بودن که کسی متوجه نشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 352.2,
   "end": 357.28,
   "text": "وارد ایران شده بودن، بعد تطمیع شده بودن از ده میلیون، بیست میلیون،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 357.28,
   "end": 361.24,
   "text": "سی میلیون همین جوری تا هشتاد میلیون نسبت به اینکه چیکار کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 361.24,
   "end": 364.49,
   "text": "مثلا سطل آشغال آتیش بزنن ده میلیون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 364.49,
   "end": 367.77,
   "text": "یه ماشین مردم رو آتیش بزنن بیست میلیون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 367.77,
   "end": 371.15,
   "text": "ماشین‌های امدادی آتیش بزنن چهل میلیون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 371.15,
   "end": 374.19,
   "text": "مساجد آتیش بزنن پنجاه میلیون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 374.19,
   "end": 376.91,
   "text": "مراکز امنیتی رو داغون کنن و آ--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 376.91,
   "end": 379.67,
   "text": "آتیش بزنن هشتاد میلیون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 379.67,
   "end": 383.33,
   "text": "این همه هزینه برای چی بشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 383.33,
   "end": 392.37,
   "text": "که یه کاری بکنن این کشته‌سازی حداکثری بشه، این رعب و وحشت همه جا رو بگیره، م-مردم رو در برابر نظام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 392.37,
   "end": 398.49,
   "text": "قرار بدن و این اغتشاش‌ها، آشوب‌ها به جایی بکشه که دیگه اونا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 398.49,
   "end": 403.81,
   "text": "ببینن یعنی محیط رو آماده ببینن برای دخالت نظامی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 403.81,
   "end": 408.45,
   "text": "ولی مشت محکم رو مردم دیروز الحمدالله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 408.45,
   "end": 413.65,
   "text": "خدا انشاالله این مردم رو حفظ کنه برکتشون رو بیشتر کنه، مضاعف کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 413.65,
   "end": 418.69,
   "text": "که دلگرمی نه فقط رهبر، دلگرمی امام عصر هم به خدا قسم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 418.69,
   "end": 421.13,
   "text": "ما باید قدر مردم خوبمون رو بدونیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 421.13,
   "end": 423.47,
   "text": "زدن به پوزه‌ی دشمن و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 423.47,
   "end": 425.69,
   "text": "این حالت یعنی این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 425.69,
   "end": 428.87,
   "text": "چیزی که اون‌ها فکر می‌کردن، پازلی که چیده بودن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 428.87,
   "end": 435.43,
   "text": "همه چی رو دست به دست هم بدن موقعیت آماده بشه برای دخالت نظامی از قبل هم حرفش رو زده بودن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 435.43,
   "end": 437.81,
   "text": "یه دفعه دقیقاً برعکس شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 437.81,
   "end": 443.45,
   "text": "اصلاً فکرش رو نمی‌کردن. این تشکری که رهبر عزیزمون کردن فرمودن کار بزرگی کردید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 443.45,
   "end": 446.05,
   "text": "کسی که این هندسه رو خوب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 446.05,
   "end": 450.27,
   "text": "ترسیم کرده باشه و دیده باشه متوجه این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 450.27,
   "end": 454.45,
   "text": "تشکر رهبر عزیز میشه که چرا این چنین تشکر کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 454.45,
   "end": 461.57,
   "text": "فرمود برید با اون عیادی خودتون و ازنای خودتون بگید که مردم ایران رو نشناختید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 461.57,
   "end": 466.57,
   "text": "واقعاً البته یه عزیزی می‌پرسید که این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 466.57,
   "end": 471.13,
   "text": "ناآرامی‌ها تا کی هست؟ یه زمانی ده سال، ده سال بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 471.13,
   "end": 475.83,
   "text": "مثلا هفتاد و هشت، بعد هشتاد و هشت، بعد نود و هشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 475.83,
   "end": 479.79,
   "text": "الان دیگه هر دو سه سال یه بار شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 479.79,
   "end": 483.23,
   "text": "اتفاقاً هرچی جلوتر بریم بیشتر هم میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 483.23,
   "end": 487.53,
   "text": "این‌ها همش دنباله‌ی یک چیزی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 487.53,
   "end": 493.23,
   "text": "یعنی دن-- انگار که زمان داره، خود زمان داره دنبال یه چیزی می‌گرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 493.23,
   "end": 497.03,
   "text": "اون هم چیزی نیست قطعاً جز ظهور حضرت ولی عصر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 497.03,
   "end": 504.31,
   "text": "اینو مطمئن باشیم و باید این اتفاقات هی شدیدتر هم بشه، بشه، بشه که لتقر--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 504.31,
   "end": 507.11,
   "text": "چی؟ امام صادق و امیرالمؤمنین فرمودند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 507.11,
   "end": 510.71,
   "text": "جان؟ لتقر قرای اینقدر- احسن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 510.71,
   "end": 518.73,
   "text": "سه بار تاکید کردن که سه بار فرمودند قطعاً، قطعاً، قطعاً غربال میشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 518.73,
   "end": 521.65,
   "text": "الان ببینید چقدر آدم‌ها جاشون عوض شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 521.65,
   "end": 526.25,
   "text": "خیلی‌ها که سینه چاک انقلاب بودن داریم می‌بینیم رفتن اونور",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 526.25,
   "end": 528.73,
   "text": "و از اون طرف چقدر اومدن این طرف.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 528.73,
   "end": 530.53,
   "text": "اینا غربال‌های آخر الزمانه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 530.53,
   "end": 533.49,
   "text": "خودمون رو مراقب باشیم. خودمون یه وقت اینجا ن–",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 533.49,
   "end": 537.75,
   "text": "نبازیم. خودمون یه وقت خدایی نکرده چه می‌دونیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 537.75,
   "end": 540.11,
   "text": "ایمان‌ها رو این دعای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 540.11,
   "end": 547.73,
   "text": "یا الله، یا رحمان، یا رحیم، یا مقلب القلوب ثبت قلبی على دینک.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 547.73,
   "end": 550.03,
   "text": "خیلی این دعای مهمیه الان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 550.03,
   "end": 554.65,
   "text": "برای اص-- این تثبت وجودی پیدا کنیم در مسیر توحید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 554.65,
   "end": 557.45,
   "text": "و دعا، دعا حتماً، حتماً، حتماً دعا کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 557.45,
   "end": 560.39,
   "text": "ما شب اول که به هم ریخت حوزه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 560.39,
   "end": 564.25,
   "text": "حسینیه ما چون پشت سر ما رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 564.25,
   "end": 570.37,
   "text": "حوزه بسیج رو آتیش زدن و حالا الحمدالله اسلحه‌ها دسترسی پیدا نکردند اما خب بسیجی‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 570.37,
   "end": 574.67,
   "text": "جاشون رو از دست دادن آمدن تو حسینیه ما شد مقر دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 574.67,
   "end": 577.85,
   "text": "بچه‌ها می‌رفتن، می‌اومدن. بعد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 577.85,
   "end": 583.89,
   "text": "یه حُصنی که پیدا کرد نمی‌دونم عزیزان اینجا کسی بود اون شب یا نه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 583.89,
   "end": 589.59,
   "text": "ولی تا سحر ما یه ذره صحبت کردیم و بعدم اون دعای مخصوص",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 589.59,
   "end": 592.99,
   "text": "سر امیرالمؤمنین رو برای دفع",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 592.99,
   "end": 597.03,
   "text": "شر اشوار و برگشتن به خودشون خوندیم تا سحر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 597.03,
   "end": 601.59,
   "text": "یه دعای خاصی حالا به وقتش خدمتتون عرض می‌کنیم از اسرار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 601.59,
   "end": 605.07,
   "text": "امیرالمؤمنینه که حضرت علامه یاد دادن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 605.07,
   "end": 609.53,
   "text": "و به وقتش باید خونده باشه برای مسائل بسیار مهم و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 609.53,
   "end": 612.95,
   "text": "خیلی میشه گفت عظیم حرف‌ها، چیزها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 612.95,
   "end": 616.39,
   "text": "حتی بعضیا با این دعا به طی الارض افتادن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 616.39,
   "end": 618.21,
   "text": "یعنی انقدر این دعا مهمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 618.21,
   "end": 621.47,
   "text": "اون شب انجام دادیم تقریباً یک ساعتم طول کشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 621.47,
   "end": 624.71,
   "text": "غظه از ازهرام خوندیم. اینا با برکتی میشه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 624.71,
   "end": 629.47,
   "text": "بعد به اینا گفتیم اگه اینا نمی ریختن بیرون ما هرگز امشب دور هم جمع می‌شدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 629.47,
   "end": 634.55,
   "text": "انقدر صفا کنیم این دعای سر رو بخونیم و اینا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 634.55,
   "end": 639.63,
   "text": "انشاالله که خدای متعال شر اشوار رو،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 639.63,
   "end": 648.17,
   "text": "ازنابشون رو، همین عصاء به خودشون برگردونه و ما زنده باشیم و فرو پاشی دولت آمریکا رو یک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 648.17,
   "end": 653.17,
