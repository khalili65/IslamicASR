   "title": "## من زار زائرنا؛ زیارت زائر",
   "start": 0.14,
   "end": 47.76
  },
  {
   "index": 1,
   "title": "## قرب نافله و قرب فریضه",
   "start": 47.76,
   "end": 211.98
  },
  {
   "index": 2,
   "title": "## حرکت به سمت زائر کربلا",
   "start": 211.98,
   "end": 309.08
  },
  {
   "index": 3,
   "title": "## تجلی در توحید افعالی",
   "start": 309.08,
   "end": 472.65
  },
  {
   "index": 4,
   "title": "## شراب اولیاء و هیئت",
   "start": 472.65,
   "end": 561.29
  },
  {
   "index": 5,
   "title": "## سخن امام و قید حفظ نور",
   "start": 561.29,
   "end": 676.65
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.14,
   "end": 3.16,
   "text": "اللهم صل على محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 3.16,
   "end": 6.48,
   "text": "و آل محمد و عجل فرج.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 6.48,
   "end": 11.14,
   "text": "بسم الله الرحمن الرحیم و بهین استعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 11.14,
   "end": 15.24,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 15.24,
   "end": 18.6,
   "text": "آیاته. سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 18.6,
   "end": 24.38,
   "text": "سلام علیکم و رحمة الله. انشاالله که زیارت همه قبول باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 24.38,
   "end": 27.74,
   "text": "الحمد لله غالبا ظاهر بودید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 27.74,
   "end": 32.84,
   "text": "اون عزیزانی که حالا چه رفتن چه نرفتن مثل ما جا موندن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 32.84,
   "end": 36.94,
   "text": "حتما توجه داشته باشن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 36.94,
   "end": 40.56,
   "text": "من زار زائرنا کمن زارنا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 40.56,
   "end": 43.34,
   "text": "اگر کسی زیارت کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 43.34,
   "end": 46.96,
   "text": "زائر ما رو کأنّ ما رو زیارت کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 46.96,
   "end": 50.5,
   "text": "خیلی درس در این روایت شریف هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 50.5,
   "end": 53.16,
   "text": "اولاً بره به زیارت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 53.16,
   "end": 58.24,
   "text": "یعنی اگر کسی که از زیارت برگشته،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 58.24,
   "end": 62.08,
   "text": "شما میخوای به فیض این روایت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 62.08,
   "end": 66.04,
   "text": "برسی، یه قدم هم شده به سمتش برو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 66.04,
   "end": 71.32,
   "text": "یعنی ولو تو اتاقت نشستی یه زائر کربلا اومد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 71.32,
   "end": 76.18,
   "text": "تو یه قدم به سمت اون به این نیت برو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 76.18,
   "end": 80.16,
   "text": "که بوی قرب فریضه بده نه قرب نافله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 80.16,
   "end": 84.32,
   "text": "مثلا اتفاقی که توی این ایام میفته،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 84.32,
   "end": 88.1,
   "text": "عزیزانی که مسجد بلال تشریف داشتن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 88.1,
   "end": 94.48,
   "text": "جلسه‌ی آخر سیر معرفت نفس این رو توضیح دادیم که دیگه ما یه قرب نافله داریم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 94.48,
   "end": 98.64,
   "text": "که حق نزول می‌کنه، تنزل پیدا می‌کنه که دست تو رو بگیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 98.64,
   "end": 102.7,
   "text": "بشه دست تو، گوش تو، چشمت و زبانت و لسانت و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 102.7,
   "end": 105.2,
   "text": "با لسانت و با دیگران صحبت کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 105.2,
   "end": 108.8,
   "text": "خیلی فضیلت بالاییه. اما بالاتر از این چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 108.8,
   "end": 111.54,
   "text": "که تو اجازه ندی حق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 111.54,
   "end": 115.64,
   "text": "نزول کنه، تنزل کنه بیاد که تنزل الملائکه والروح.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 115.64,
   "end": 120.96,
   "text": "نه. تو حرکت کنی به معراج بری، الصلاة معراج المؤمن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 120.96,
   "end": 129.62,
   "text": "تو بری بالا و تو بشی گوش حق، تو بشی دست حق، تو بشی چشم حق، تو بشی یدالله به این شکل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 129.62,
   "end": 135.04,
   "text": "این بوی این قرب فریضه عرض کردیم توی اربعین دیگه خیلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 135.04,
   "end": 137.94,
   "text": "بلنده، به مشام میرسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 137.94,
   "end": 143.2,
   "text": "که تو حرکت می‌کنی اگر شب قدر تنزل الملائکه والروح",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 143.2,
   "end": 146.94,
   "text": "حضرت صدیقه طاهره تشریف میارن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 146.94,
   "end": 156.06,
   "text": "به عالم مادون برای اینکه دست دیگران رو بگیرن به روز رسانی صورت بگیره ارواح برگردن به اصلشون و به مادر هستی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 156.06,
   "end": 158.14,
   "text": "در اربعین بالعکسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 158.14,
   "end": 160.56,
   "text": "شما حرکت کردید رفتید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 160.56,
   "end": 163.6,
   "text": "به سمت حضرت صدیقه شهیده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 163.6,
   "end": 166.12,
   "text": "شما بودید که حرکت کرد-- این می‌شه چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 166.12,
   "end": 168.78,
   "text": "قرب فریضه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 168.78,
   "end": 171.68,
   "text": "این مقامش خیلی بالاتره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 171.68,
   "end": 175.14,
   "text": "لذا ثواب عجیب بر، عجیبی هم براش مترتب هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 175.14,
   "end": 177.4,
   "text": "اصلاً زیارت فلسفه‌ش اینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 177.4,
   "end": 180.08,
   "text": "مخصوصا اربعین که دیگه این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 180.08,
   "end": 182.58,
   "text": "فیض عظیم و این جمعیت میلیونی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 182.58,
   "end": 188.98,
   "text": "حالا اینکه سر اینکه چرا اربعین، چرا بقیه ائمه ندارن این آقا فقط داره تو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 188.98,
   "end": 191.78,
   "text": "مسجد بلال عزیزانی که بودن عرض کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 191.78,
   "end": 194.6,
   "text": "البته حواستون باشه که فردا و پس فردا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 194.6,
   "end": 202.64,
   "text": "اگر یه وقت دوستانی هستن که میخوان شرکت کنن فردا و پس فردا مسجد بلال هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 202.64,
   "end": 210.62,
   "text": "یعنی به جهت جبران هفته پیش که تعطیل شد فردا هم استثنا مسجد بلال هست بحثمون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 210.62,
   "end": 217.88,
   "text": "حالا بحث اینه که شما وقتی زائر کربلا دیدید ولو شده یه قدم به سمتش حرکت کن که شما بری به سمت زیارت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 217.88,
   "end": 221.02,
   "text": "چون زیارت این اتفاق درش میفته دیگه شما حرکت کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 221.02,
   "end": 224.46,
   "text": "چرا میگه حداقلش بری پشت بام؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 224.46,
   "end": 227.56,
   "text": "یعنی حرکت کن. برو بالا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 227.56,
   "end": 229.48,
   "text": "قرب ف-- بوی قرب چی میده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 229.48,
   "end": 231.82,
   "text": "فریضه میده. تو برو بالا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 231.82,
   "end": 234.24,
   "text": "اینا خودش نکاتی درشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 234.24,
   "end": 238.92,
   "text": "تو حرکت کن، تو برو به سمت حضرت حق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 238.92,
   "end": 242.02,
   "text": "اون روایت که در کامل الزيارات هست همه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 242.02,
   "end": 245.46,
   "text": "میدونید ملاحظه کردید قطعا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 245.46,
   "end": 248.88,
   "text": "در خصوص زائر کربلا هم این-- یه وجهش اینه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 248.88,
   "end": 251.66,
   "text": "که بدونیم آدابی داره. یه وجهش اینه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 251.66,
   "end": 256.22,
   "text": "عجیب چه تجلی در زائر ارباب رخ میده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 256.22,
   "end": 263.98,
   "text": "که تو او رو به قصد زیارت او رو داری ظاهراً زیارت می‌کنی اما کأنّ زائر، زائر امام حسین میشی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 263.98,
   "end": 265.8,
   "text": "اصلاً به این توجه کردید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 265.8,
   "end": 269.22,
   "text": "آخه چیه؟ توی این آقا چه اتفاقی افتاده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 269.22,
   "end": 271.94,
   "text": "که من زائر امام حسین میشم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 271.94,
   "end": 275.74,
   "text": "من اگر مثلا یه سنگ و چوب رو مثلا یه سنگی رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 275.74,
   "end": 280.68,
   "text": "بیارن به من بدن از که چهل سال روی ضریح سید الشهدای-- مثلا رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 280.68,
   "end": 283.76,
   "text": "سنگ قبر سید الشهدا بوده الانم اتفاق میفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 283.76,
   "end": 292.12,
   "text": "سنگ قبرا، سنگ قبرای مثلا اهل بیت رو که بخوان تعویذ کنن اونو تبدیل می‌کنند به سدخه، انگشتر مثلا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 292.12,
   "end": 294.7,
   "text": "دیدید حتما شاید شما هم دارید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 294.7,
   "end": 299.16,
   "text": "یا مثلا یه قطعه از کاشی حرم رو من الان خونه خودمون دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 299.16,
   "end": 303.18,
   "text": "از کاشی مثلا چند صد سال کاشی حرم بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 303.18,
   "end": 306.46,
   "text": "خب اینو الان شما اینو ببینی زائر میشی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 306.46,
   "end": 313.58,
   "text": "کسی همچین حرفی نزده. اما این آقایی که الان رفته زیارت برگشته چه اتفاقی افتاده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 313.58,
   "end": 319.3,
   "text": "اینو بهش فکر کنی یه ذره که من زار زائرنا، اولاً زائر ما باشه‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 319.3,
   "end": 321.76,
   "text": "نرفته باشه سنگ و چوب ببینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 321.76,
   "end": 325.04,
   "text": "زائرنا. زائر ما باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 325.04,
   "end": 329.32,
   "text": "بعد تو هم به قصد زیارت او رو ببینی یعنی به سمتش حرکت کنی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 329.32,
   "end": 332.1,
   "text": "کمن زارنا. ما رو زیارت کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 332.1,
   "end": 334.32,
   "text": "این برمی‌گرده تو همون سیر توحیدی‌مون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 334.32,
   "end": 339.58,
   "text": "بحث ما تو یعنی ظهرها تو اصطلاح کشکول نور چی بود؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 339.58,
   "end": 342.28,
   "text": "توحید بود. رسیده بودیم به توحید افعالی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 342.28,
   "end": 344.88,
   "text": "تو اونجا جوابش هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 344.88,
   "end": 346.98,
   "text": "یعنی ببینید چه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 346.98,
   "end": 350.88,
   "text": "گفتیم که سیر-- مثلا چرا ما رسیدیم به توحید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 350.88,
   "end": 353.5,
   "text": "افعالی و کلاً سه مرحله از توحید بحث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 353.5,
   "end": 359.72,
   "text": "تجلیات الهیه بود که گفتیم که امام حسین در کربلا به شاهد، برای شهدا کربلا تجلی کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 359.72,
   "end": 363.52,
   "text": "اینو حواسمون باشه مخصوصا زائرها اینو توجه داشته باشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 363.52,
   "end": 370.39,
   "text": "امام حسین چنان تجلی در زائر خودش می‌کنه، تجلی یعنی خودنمایی یعنی ظهور",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 370.39,
   "end": 372.93,
   "text": "یعنی خودش رو نمایان میکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 372.93,
   "end": 375.05,
   "text": "ولو شما الان بدنت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 375.05,
   "end": 377.79,
   "text": "گرمه الان متوجه نیستی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 377.79,
   "end": 381.89,
   "text": "وقتی بدنت سرد شد اون موقع متوجه میشی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 381.89,
   "end": 386.37,
   "text": "متأسفانه. چنان ظهوری میکنه در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 386.37,
   "end": 390.85,
   "text": "این شخص که تو اون رو میبینی که انّه‌ا رو زیارت کردی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 390.85,
   "end": 393.57,
   "text": "این چیزی جز تجلی سید الشهدا نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 393.57,
   "end": 397.71,
   "text": "اینو باید قدر بدونیم. اینو باید ارزش براش قائل بشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 397.71,
   "end": 400.51,
   "text": "کجا تعریف میشه این در توحید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 400.51,
   "end": 405.03,
   "text": "وقتی شما نگاه میکنی به عالم، همه‌ی عالم رو ظهور",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 405.03,
   "end": 408.81,
   "text": "حق میبینی. عالم میشه اطوار وجودی حق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 408.81,
   "end": 413.95,
   "text": "کلمات وجودی نظام هستی بدون استثناء میشن اطوار وجودی حق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 413.95,
   "end": 415.75,
   "text": "میشن ظهور اسماء الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 415.75,
   "end": 421.35,
   "text": "وهرت الموجودات. الموجودات همه و همه بدون استثناء",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 421.35,
   "end": 425.23,
   "text": "ان بسم الله الرحمن الرحیم همه میشن بسم الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 425.23,
   "end": 428.45,
   "text": "حالا یه اسم اعظم داریم بین این اسماء،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 428.45,
   "end": 432.31,
   "text": "اون انسان کامله. شما که ظاهر شدی رفتی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 432.31,
   "end": 438.15,
   "text": "زیارت انسان کامل و اون انسان کامل به میزان ظرفیت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 438.15,
   "end": 443.37,
   "text": "و اندازه و قدر و قیمت شما در شما خودش رو نشون داده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 443.37,
   "end": 447.97,
   "text": "اگر بتونی اون رو حفظش کنی هر کس شما رو ببینه ظاهر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 447.97,
   "end": 452.77,
   "text": "ارباب میشه. حالا ببین اگر خودت خودت رو ببینی چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 452.77,
   "end": 456.37,
   "text": "اگر خودت خودت رو زیارت کنی چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 456.37,
   "end": 464.07,
   "text": "حواست هست چی عرض میکنم؟ شما که اگر دیگری بیاد به سمت شما ظاهر امام حسین میشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 464.07,
   "end": 467.35,
   "text": "خودت در خودت چه خبره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 467.35,
   "end": 469.65,
   "text": "خودت چگونه خودت رو زیارت میکنی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 469.65,
   "end": 472.65,
   "text": "به به، به به.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 472.65,
   "end": 475.03,
   "text": "لا فرق بینهم و بین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 475.03,
   "end": 478.77,
   "text": "حبیبهم. انّ لله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 478.77,
   "end": 481.93,
   "text": "شراب اولیائه بود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 481.93,
   "end": 487.71,
   "text": "که یه شرابی داره تو بحث قلب مؤمن عرض کردیم خدا مخصوص اولیایشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 487.71,
   "end": 490.33,
   "text": "که وقتی اینا میخورن، میخورن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 490.33,
   "end": 492.49,
   "text": "اذا شربوا سکروا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 492.49,
   "end": 496.63,
   "text": "مست میشن. که رفتیم تا اونجا که آخرش شد چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 496.63,
   "end": 499.29,
   "text": "لا فرق بینهم و بین حبیبهم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 499.29,
   "end": 504.33,
   "text": "این شراب رو می، مینوشونه یعنی واقعاً نوشیده ظاهر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 504.33,
   "end": 507.91,
   "text": "که دیگه دقت کنید چی رو داریم عرض می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 507.91,
   "end": 512.77,
   "text": "قطعاً این ظاهر به قدر صیغه وجودی خودش از این شراب نوشیده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 512.77,
   "end": 516.75,
   "text": "و مست شده. غرق شده در محیط ولایت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 516.75,
   "end": 519.87,
   "text": "کسی او رو ببینه به قصد زیارت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 519.87,
   "end": 527.17,
   "text": "میشه ظاهر ارباب. به دوستان من همیشه گفتم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 527.17,
   "end": 530.65,
   "text": "اوج عشق و حالمون،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 530.65,
   "end": 535.23,
   "text": "خودمونی بگم بغل ضریح امام حسین آیا چیزی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 535.23,
   "end": 539.51,
   "text": "جز اوج عشق و حالمون تو هیئت‌های امام حسینه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 539.51,
   "end": 546.73,
   "text": "چیز اضافه نمیشه. یعنی همون امام حسین که اونجاست تو هیئت هم تجلی کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 546.73,
   "end": 553.41,
   "text": "همون امام حسین که اونجاست تو ظاهرش تجلی میکنه و تو میتونی او رو ببینی که انّه‌ا آقا رو دیدی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 553.41,
   "end": 558.11,
   "text": "این‌ها رو دست کم نگیریما. همه‌ی عالم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 558.11,
   "end": 562.03,
   "text": "ظهور الله‌اند. لذا به اینجا که میرسیم ختم کلام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 562.03,
   "end": 564.37,
   "text": "خیلی دوست داشتم بیشتر صحبت کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 564.37,
   "end": 567.51,
   "text": "چون بهتر از هر روزی دارید گوش میدید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 567.51,
   "end": 572.65,
   "text": "جانتون رو میخونم. اثر زیارته دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 572.65,
   "end": 575.53,
   "text": "ما جانونdam داریم از شما بهره میبریم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 575.53,
   "end": 583.17,
   "text": "رزق میخوریم. خلاصشو اینطوری بگیم که امام رحمت الله علیه یه جمله داره خیلی عالیه این جمله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 583.17,
   "end": 593.53,
   "text": "یعنی چهل سال باید آدم جون بکنه جان به لبش برسه تا این جام سخن امام رو بتونه بچشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 593.53,
   "end": 597.33,
   "text": "که فرمود ما همه هیچی‌م.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 597.33,
   "end": 601.15,
   "text": "هرچه هست تویی. الله اکبر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 601.15,
   "end": 611.47,
   "text": "کسی اینطوری نگاه کنه ظاهر امام حسین رو به نیت خود امام حسین میبوسه و زیارت میکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 611.47,
   "end": 616.61,
   "text": "یعنی خدا شاهده من تنم به لرزه افتاده از این حرفا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 616.61,
   "end": 624.41,
   "text": "حرفا، حرفای کمی نیست. اثر زیارت شما باعث میشه ما اوج بگیریم، حرفای ما میاد بر آتشی بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 624.41,
   "end": 626.19,
   "text": "قدر خودتون رو بدونید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 626.19,
   "end": 628.27,
   "text": "البته، البته، البته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 628.27,
   "end": 630.21,
   "text": "یه بزرگی یه قیدی زد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 630.21,
   "end": 632.33,
   "text": "جسارت می‌کنم ببخشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 632.33,
   "end": 636.07,
   "text": "خیلی عذرخواهی می‌کنم در حد و اندازه من نیست این حرفا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 636.07,
   "end": 642.95,
   "text": "هدیه بدیم به شما. گفتن تا وقتی این اتفاق رخ میده که تو بری زیارت کنی ظاهر رو،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 642.95,
   "end": 646.17,
   "text": "کمن ظاهر، ظاهراً.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 646.17,
   "end": 650.65,
   "text": "که اون ظاهر به گناه نیفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 650.65,
   "end": 653.07,
   "text": "به محض اینکه به گناه افتاد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 653.07,
   "end": 657.79,
   "text": "اولین گناهی که ازش-- خطا نه ها خطا که خطاییه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 657.79,
   "end": 660.71,
   "text": "خطا کرده، سه-- حواسش نبوده، سهو کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 660.71,
   "end": 664.09,
   "text": "نه گناهی هم میدونه این گناهه و انجام میده تمام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 664.09,
   "end": 670.17,
   "text": "سقوط کرد. لذا حواسمون باشه این نور زیارت رو حفظ کنیم انشاالله تا قیام قیامت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 670.17,
   "end": 672.83,
   "text": "والحمد لله رب العالمين صلوات ختم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 672.83,
   "end": 676.65,
   "text": "اللهم صل على محمد و آل محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}