 "chapters": [
  {
   "index": 0,
   "title": "## میلادِ کریم اهل‌بیت و پیوند با مقام محمود",
   "start": 0.8,
   "end": 69.32
  },
  {
   "index": 1,
   "title": "## مقام محمود از نافلهٔ شب",
   "start": 69.32,
   "end": 166.62
  },
  {
   "index": 2,
   "title": "## اهلیّتِ ظهورِ امام حق",
   "start": 166.62,
   "end": 186.64
  },
  {
   "index": 3,
   "title": "## روایتِ امام مجتبی در احتجاج",
   "start": 186.64,
   "end": 326.38
  },
  {
   "index": 4,
   "title": "## علوّ دین، قمعِ کافرین و درون‌مایهٔ تهجّد",
   "start": 326.38,
   "end": 392.62
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.8,
   "end": 4.78,
   "text": "بسم الله الرحمن الرحیم و بهی نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 4.78,
   "end": 8.66,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 8.66,
   "end": 12.0,
   "text": "آیات. سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 12.0,
   "end": 17.4,
   "text": "تبریک عرض می‌کنم میلاد بسیار با عظمت و بی‌نظیر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 17.4,
   "end": 20.5,
   "text": "کریم اهل بیت امام حسن مجتبی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 20.5,
   "end": 25.06,
   "text": "سلام الله علیه. چنانچه تونستید یه سر زیارت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 25.06,
   "end": 29.7,
   "text": "نوه ایشون حضرت سید الکریم در تهران برید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 29.7,
   "end": 35.64,
   "text": "که آقای بهجت فرمودن اگر کسی هفته بهش بگذره و ایشونو زیارت نکنه از تهرانی‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 35.64,
   "end": 44.48,
   "text": "جفا کرده. به همین مناسبت یه فرمایشی از ایشون رو طولانیه البته در خصوص",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 44.48,
   "end": 49.26,
   "text": "ظهور امام عصر، امام حسن در خصوص ظهور امام زمان ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 49.26,
   "end": 52.36,
   "text": "سخن گفته. یه جمله‌شو من فقط",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 52.36,
   "end": 57.04,
   "text": "مورد اشاره قرار بدم قبل از اون چون بحث ما پیرامون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 57.04,
   "end": 59.48,
   "text": "مقام محمود بود،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 59.48,
   "end": 63.8,
   "text": "آیه «ومن الليل فتحجّب به نافلة الليل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 63.8,
   "end": 69.08,
   "text": "عسى أن يبعثک ربک مقاماً محموداً» رو داشتیم مورد بررسی قرار می‌دادیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 69.08,
   "end": 72.96,
   "text": "که این مقام محمود از تهجد میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 72.96,
   "end": 80.36,
   "text": "خب فرمایش مرحوم مجلسی رو در بحار جلد صد و یک صفحه سیصد و دو دیدم خیلی جالب بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 80.36,
   "end": 83.28,
   "text": "خب ایشون جامع یعنی یه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 83.28,
   "end": 86.32,
   "text": "مجمعی رو از همه روایات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 86.32,
   "end": 88.42,
   "text": "جمع‌آوری کردن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 88.42,
   "end": 91.7,
   "text": "میشه گفت ذخیره جهان اسلام شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 91.7,
   "end": 95.28,
   "text": "نظر ایشون خیلی مهمه بر اساس روایت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 95.28,
   "end": 102.5,
   "text": "نظر دادن ایشون مرحوم مجلسی میگه برداشت من از مقام محمود بر اساس روایات اینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 102.5,
   "end": 105.22,
   "text": "چند تا برداشت کرده ایشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 105.22,
   "end": 107.14,
   "text": "که اینا رو من بخوام خیلی شیرینن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 107.14,
   "end": 109.76,
   "text": "فرمودن که المقام محمود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 109.76,
   "end": 111.44,
   "text": "أي مقام الشفاعه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 111.44,
   "end": 115.64,
   "text": "اینم که توضیح دادیم یعنی مقام شفاعت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 115.64,
   "end": 119.14,
   "text": "أي يؤهلني از اهلیت میاد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 119.14,
   "end": 124.02,
   "text": "لشفاعتکم. اون مقام شفاعت میخوره به صاحب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 124.02,
   "end": 127.1,
   "text": "مقام شفاعت یعنی به شافع ما، شفیع ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 127.1,
   "end": 130.0,
   "text": "این میخوره به ما. اهلیت شفاعت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 130.0,
   "end": 132.44,
   "text": "میگه اینم مقام محموده. یعنی چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 132.44,
   "end": 138.08,
   "text": "یعنی کسی میتونه اهلیت شفاعت پیدا کنه که به مقام محمود برسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 138.08,
   "end": 140.16,
   "text": "مقام محمود از کجا می آمد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 140.16,
   "end": 144.52,
   "text": "از تهجد. پس تهجده که ما رو به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 144.52,
   "end": 148.38,
   "text": "سنخیت و مسانخت با امام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 148.38,
   "end": 153.9,
   "text": "میرسونه که در نتیجه شفاعت حاصل بشه که اصلاً شفع گفتیم جفت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 153.9,
   "end": 157.2,
   "text": "یعنی هم سنخه با امام. حالا هر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 157.2,
   "end": 162.84,
   "text": "کدومش از این عبارت‌ها میشه کلی درباره‌ش صحبت کرد ما تبرکاً رد میشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 162.84,
   "end": 165.4,
   "text": "اوش-- أو ظهور الإمام الحق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 165.4,
   "end": 170.14,
   "text": "به به. یه معنای دیگه‌ای که از روایات ایشون استیضاح کرده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 170.14,
   "end": 176.02,
   "text": "در خصوص مقام محمود می‌فرماید ظهور امام حقه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 176.02,
   "end": 180.38,
   "text": "البته چون قبلش فرموده أي يؤهلني این به اون هم میخوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 180.38,
   "end": 183.98,
   "text": "یعنی اهلیته برای ظهور امام حق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 183.98,
   "end": 186.64,
   "text": "یعنی کسی که اهلیت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 186.64,
   "end": 190.28,
   "text": "درک ظهور امام عصر رو پیدا کرده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 190.28,
   "end": 193.66,
   "text": "کسی نیست مگر اینکه به مقام محمود رسیده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 193.66,
   "end": 197.3,
   "text": "دید دیروز عرض کردیم دیگه «واسأله أي",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 197.3,
   "end": 201.1,
   "text": "مقام المقام المحمود لکم عند الله» نشون میده که پس ما می‌تونیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 201.1,
   "end": 203.34,
   "text": "نسبت به صاع وجودیمون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 203.34,
   "end": 208.84,
   "text": "به بخشی از این مقام دسترسی پیدا کنیم که این اهلیت ظهور آقاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 208.84,
   "end": 217.4,
   "text": "پس اگر کسی دنبال اینه که امام عصرش صلوات الله علیه زودتر تشریف بیارن و ایشون در رکاب او باشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 217.4,
   "end": 227.16,
   "text": "که «فاخرجنی من قبری معتذراً کفنی شاهراً سيفی مجرداً غناط ملبیاً دعوة الداعی الحاضر والباد» و به همین صورت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 227.16,
   "end": 229.8,
   "text": "این باید چیکار کنه؟ باید اهل نماز شب باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 229.8,
   "end": 235.46,
   "text": "باید به مقام محمود نسبت به صاع وجودی خودش رسیده باشه که به اهلیت ظهور آقا برسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 235.46,
   "end": 238.02,
   "text": "بیخود هی سینه نزنه آقا بیا، آقا بیا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 238.02,
   "end": 242.38,
   "text": "عمل کن. خودت رو باید آماده کنی برای اهلیت ظهور حضرت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 242.38,
   "end": 246.2,
   "text": "حالا اینجا امام مجتبی قربونش بریم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 246.2,
   "end": 251.36,
   "text": "همین روایت که عرض کردم یه جمله‌شو براتون بخونم در همین خصوص فرمودن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 251.36,
   "end": 254.08,
   "text": "سندشم احتجاج مرحوم طبرسیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 254.08,
   "end": 257.46,
   "text": "اصلش از الاحتجاج علی اهل اللجاج",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 257.46,
   "end": 259.3,
   "text": "جلد دو صفحه دویست و نود و یک.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 259.3,
   "end": 264.14,
   "text": "امام مجتبی صلوات الله علیه فرمایش مبسوطی دارن پیرامون امام عصر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 264.14,
   "end": 267.98,
   "text": "یک قسمتش می فرماید یملك ما بین الخافقین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 267.98,
   "end": 274.64,
   "text": "اربعین عاماً. چهل سال ایشون حکومت می‌کنه بر شرق و غرب عالم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 274.64,
   "end": 280.12,
   "text": "چهل سال هم می‌تونه منظور عدد کثرت باشه یعنی بسیار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 280.12,
   "end": 284.52,
   "text": "بعد فرمودن فتوا به به امام حسن صاحب امروز.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 284.52,
   "end": 287.7,
   "text": "فتوا لمن ادراک ایامه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 287.7,
   "end": 290.68,
   "text": "خوش به حال کسی که درک کنه ایام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 290.68,
   "end": 295.7,
   "text": "ظهور او رو. اینجاش خیلی شیرینه و سمع كلامه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 295.7,
   "end": 298.02,
   "text": "بشنوه صدای مهدی فاطمه رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 298.02,
   "end": 301.32,
   "text": "به به. چه خوش است صوت قرآن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 301.32,
   "end": 303.44,
   "text": "ذ تو دل رو با شنیدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 303.44,
   "end": 307.9,
   "text": "خب بعد چه-- این کسی اهلیت پیدا می‌کنه که ظهور آقا رو درک کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 307.9,
   "end": 311.44,
   "text": "و اصلاً غیبت و غیبت و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 311.44,
   "end": 314.3,
   "text": "ظهور براش یکی میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 314.3,
   "end": 317.94,
   "text": "اصلاً طبق روایت طوری میشه که انگار الان آقا هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 317.94,
   "end": 320.52,
   "text": "اصلاً غیبت از او برداشته میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 320.52,
   "end": 322.96,
   "text": "و البته فرمایش دیگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 322.96,
   "end": 326.14,
   "text": "مرحوم مجلسی هست که رد میشیم فقط عنوانشو میخونم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 326.14,
   "end": 328.16,
   "text": "باز معنای چی؟ مقام محمود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 328.16,
   "end": 330.12,
   "text": "و أعلا الدين.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 330.12,
   "end": 334.78,
   "text": "اون علوّ دین. «ای نماحی معالم الدین و اهل» تو مدحه می‌خونیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 334.78,
   "end": 337.6,
   "text": "اون علوّ دین هم باز به دست حضرته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 337.6,
   "end": 339.84,
   "text": "این هم مقام محمود می‌طلبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 339.84,
   "end": 343.68,
   "text": "یعنی کسانی می‌تونن علوّ به دین بدن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 343.68,
   "end": 350.58,
   "text": "و در اعلی مرتبه ظهور بدن به دین خدا که اهل مقام محمودن و قمع الکافرین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 350.58,
   "end": 356.64,
   "text": "به به به. انشاالله زنده باشیم هممون ببینیم اون روزها که کافرین همه قلع و قمع میشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 356.64,
   "end": 361.28,
   "text": "خب این هم-- چه کس، چه کسی می‌تونه قلع و قمع کنه کافرین رو؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 361.28,
   "end": 364.36,
   "text": "به کمک امام عصرش. کسی که به اهلیت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 364.36,
   "end": 367.1,
   "text": "به چی رس-رسیده؟ به مقام محمود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 367.1,
   "end": 372.58,
   "text": "از چه طریقی؟ تهجد از وجود یعنی بیداری بعد از خواب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 372.58,
   "end": 375.92,
   "text": "چقدر درون مایه داره. بیداری بعد از خواب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 375.92,
   "end": 380.88,
   "text": "انشاالله خدا هممون رو موفق کنه به همین حقیقت به برکت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 380.88,
   "end": 384.74,
   "text": "میلاد با سعادت امام حسن مجتبی کریم اهل بیت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 384.74,
   "end": 392.62,
   "text": "دست و بال همتون رو انشاالله دنیا و آخرت پر کنه حضرت به کرمش صلوات هدیه کنید. اللهم صل علی محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}