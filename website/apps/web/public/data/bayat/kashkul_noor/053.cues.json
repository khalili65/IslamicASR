   "start": 560.08,
   "end": 698.58
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.06,
   "end": 2.8,
   "text": "اللهم صل على",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 2.8,
   "end": 5.82,
   "text": "محمد و آل محمد و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 5.82,
   "end": 10.74,
   "text": "عجل فرجه. بسم الله الرحمن الرحیم و بهیم استعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 10.74,
   "end": 14.82,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 14.82,
   "end": 19.14,
   "text": "آیات. سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 19.14,
   "end": 26.4,
   "text": "در آیه صد و چهار سوره حضرت یونس علیه النبي و آله و عليه الصلاة و السلام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 26.4,
   "end": 28.5,
   "text": "باز به زیبایی تمام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 28.5,
   "end": 31.96,
   "text": "موضوع توحید افعالی به این شکل اومده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 31.96,
   "end": 36.5,
   "text": "قل يا ايها الناس پیغمبر بگو: «ای مردم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 36.5,
   "end": 43.58,
   "text": "إن كنتم في شك من ديني اگر شما در دین من شک دارید، یعنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 43.58,
   "end": 50.2,
   "text": "تردید دارید که این حقه این دین به حقه إن الدين عند الله الإسلام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 50.2,
   "end": 54.36,
   "text": "این اسلام، این دینی که موجب سعادت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 54.36,
   "end": 58.18,
   "text": "دنیا و آخرت شماست، هر دو سرای شما رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 58.18,
   "end": 60.5,
   "text": "در نظر گرفته حقه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 60.5,
   "end": 63.62,
   "text": "اگر به این شک دارید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 63.62,
   "end": 70.44,
   "text": "فلا أعبد الذين تعبدون من دون الله سیاق آیه طوریه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 70.44,
   "end": 73.34,
   "text": "یه دفعه میره حرف اصلی رو بیان میکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 73.34,
   "end": 78.3,
   "text": "میگه اگه شما شک دارید من اون چیزی که شما به جز خدا می پرستید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 78.3,
   "end": 85.44,
   "text": "نمی‌پرستم. یعنی من منظور اینه من سر سوزنی شک ندارم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 85.44,
   "end": 89.82,
   "text": "من کاری به شما ندارم. لکم دینکم ولي دین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 89.82,
   "end": 91.92,
   "text": "من یقین کامل دارم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 91.92,
   "end": 93.66,
   "text": "و کارهای خودم رو می‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 93.66,
   "end": 97.52,
   "text": "بعد تصریح می‌کنه و لکن أعبد الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 97.52,
   "end": 102.84,
   "text": "و لکن من خدایی رو می‌پرستم الذي",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 102.84,
   "end": 105.76,
   "text": "از اینجا دیگه اشاره صریح به توحید افعالیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 105.76,
   "end": 108.04,
   "text": "منتها موضوع، یه موضوعیه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 108.04,
   "end": 110.4,
   "text": "همه پذیرفتن هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 110.4,
   "end": 113.56,
   "text": "اما اینکه کی انسان رو می‌میرانه اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 113.56,
   "end": 120.0,
   "text": "روش حرفه. و لکن أعبد الله الذي يتوفى.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 120.0,
   "end": 124.04,
   "text": "من بنده کسی هستم، کسی رو می‌پرستم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 124.04,
   "end": 129.18,
   "text": "که يتوفىکم شما رو می‌میرانه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 129.18,
   "end": 132.24,
   "text": "و أمرت أن أكون من المؤمنین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 132.24,
   "end": 141.4,
   "text": "من به من امر شده. من امر دارم از طرف حضرت حق که جزو اهل ایمان باشم، از مؤمنین باشم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 141.4,
   "end": 145.96,
   "text": "یعنی باز بدونید که من ایمان کامل به اونچه که میگم دارم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 145.96,
   "end": 152.82,
   "text": "خیلی جالبه که اشاره پیغمبر برای نهادینه کردن موضوع تح-توحید افعالی به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 152.82,
   "end": 158.36,
   "text": "توفی جانهاست توسط حضرت حق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 158.36,
   "end": 163.78,
   "text": "بارها عرض کردیم در یکی از موضوعات بسیار مهمی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 163.78,
   "end": 169.2,
   "text": "واقعا همه می‌تونن یقین کنن که دست خدا در کار هست همینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 169.2,
   "end": 175.66,
   "text": "ببینید قدیما توفی یا حالا اسمش رو بذاریم موت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 175.66,
   "end": 177.78,
   "text": "بیشتر برای پیرمردها بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 177.78,
   "end": 183.86,
   "text": "قدیم‌ها کمتر پیش اومد، پیش میومد که کسی زیر سن صد سال بمیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 183.86,
   "end": 187.74,
   "text": "عمرها هزار ساله بوده. تو امم پیشین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 187.74,
   "end": 191.98,
   "text": "انبیاء پیشین چرا عمرشون هزار ساله بوده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 191.98,
   "end": 199.14,
   "text": "وقتی قرآن می‌فرماید حضرت نوح علیه النبي و آله و عليه الصلاة و السلام نهصد و پنجاه سال فقط نبوت کرده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 199.14,
   "end": 201.34,
   "text": "یه مقدار بعضیا نمی‌پذیرن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 201.34,
   "end": 209.62,
   "text": "میگن آخه چه حرفیه؟ اگر برن بررسی کنن تاریخ رو می‌بینن که قبل از پیغمبر عزیز ما عمرها هزار ساله بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 209.62,
   "end": 213.48,
   "text": "بارها در بارش صحبت کردیم و مصادیق آوردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 213.48,
   "end": 217.84,
   "text": "الان برعکسه. الان واقعا دور از جون همه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 217.84,
   "end": 225.46,
   "text": "فرزندان شما و خود شما خدا طول عمر و برکت به شما اهل ایمان به فرزندان و متعلقین‌تون بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 225.46,
   "end": 229.16,
   "text": "ع-عمرها که اومده زیر صد سال هیچی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 229.16,
   "end": 232.1,
   "text": "جوون مرگی هم خیلی شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 232.1,
   "end": 234.74,
   "text": "یعنی کسی باورش نمیشه جوونی از دنیا بره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 234.74,
   "end": 237.6,
   "text": "میگن باید پیر بشه در صورتی که اینجوری نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 237.6,
   "end": 239.5,
   "text": "الان که به شدت زیاد شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 239.5,
   "end": 243.76,
   "text": "خیلی بیشتر از قبل. حالا کاری به دلایلش نداریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 243.76,
   "end": 245.9,
   "text": "اما طرف می‌بینی که به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 245.9,
   "end": 250.42,
   "text": "کهولت سن داره هر نفسش داره می‌میره اما زنده است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 250.42,
   "end": 255.78,
   "text": "و یه جوون سر و مو رو به قول قدیمیا گنده خیلی سرحال، قرا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 255.78,
   "end": 257.92,
   "text": "خوب یه دفعه سکته می‌کنه می‌میره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 257.92,
   "end": 261.28,
   "text": "بدون هیچ پیشینه مریضی آنچنانی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 261.28,
   "end": 266.12,
   "text": "میگن جوان ناکام. آیا نباید یقین کرد که مرگ دست خداست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 266.12,
   "end": 268.4,
   "text": "همین اخیرا کسی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 268.4,
   "end": 274.54,
   "text": "قبل از این واقعه دیروز دردناک امامزاده یحیی که گردن این امام،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 274.54,
   "end": 276.64,
   "text": "حالا امام جماعت بیچاره رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 276.64,
   "end": 280.28,
   "text": "برید، اون ملعون قبلش یه اسراي عقل دیگه‌ش رو بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 280.28,
   "end": 286.56,
   "text": "طرفو که گرفتن گفت من صد تا قرص خورده بودم که خودکشی کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 286.56,
   "end": 288.54,
   "text": "اصلا تو حالت عادی نبوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 288.54,
   "end": 291.48,
   "text": "صد تا قرص می‌خوره نمی‌میره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 291.48,
   "end": 295.32,
   "text": "خیلیه صد تا قرص. طرف ده تا دونه می‌خوره می‌میره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 295.32,
   "end": 298.54,
   "text": "صد تا خورده نمرده. تو اعترافات خودش گفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 298.54,
   "end": 303.14,
   "text": "چرا به نظر شما؟ الله يتوفى الأنفس حين موتها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 303.14,
   "end": 306.16,
   "text": "بله. حضرت عزرائیل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 306.16,
   "end": 308.82,
   "text": "سلام الله عليه. ایشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 308.82,
   "end": 311.52,
   "text": "واسطه فیضن. واسطه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 311.52,
   "end": 318.02,
   "text": "اماته ان برای اینکه ما رو از نشئه مادون از رحم طبیعت ببرن به رحم برزخ.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 318.02,
   "end": 320.68,
   "text": "همونطور که ما در رحم مادر بودیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 320.68,
   "end": 322.9,
   "text": "باز حضرت عزرائیل در کار بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 322.9,
   "end": 327.26,
   "text": "اونجا ما رو اماته کرده. حضرت اسرافیل اینجا احیا کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 327.26,
   "end": 331.28,
   "text": "باز اینجا وقتی می‌میریم انتهای دنیا حضرت عزرائیل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 331.28,
   "end": 336.74,
   "text": "اماته می‌کنه که در عالم برزخ حضرت اسرافیل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 336.74,
   "end": 338.58,
   "text": "اه-- اصطلاحا میگیم بدمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 338.58,
   "end": 343.48,
   "text": "در سوره ش یعنی بدمه دم و نفخ تو فیه الروح جان دوباره‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 343.48,
   "end": 346.62,
   "text": "دو مرتبه احیا کنه ما رو در رحم برزخ.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 346.62,
   "end": 350.24,
   "text": "دوباره اونجا آماده بشیم برای زندگی برزخیمون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 350.24,
   "end": 354.66,
   "text": "تا انتهای عالم برزخ که امت مثنتین دو بار می‌میریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 354.66,
   "end": 358.9,
   "text": "اونجا دوباره عزرائیل بیاد اونجا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 358.9,
   "end": 362.18,
   "text": "اماته کنه تا حضرت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 362.18,
   "end": 367.24,
   "text": "جبرائیل البته اگر ما برسیم انشاالله به شهود و شنود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 367.24,
   "end": 370.9,
   "text": "عقلانی بریم به عالم عقول از عالم مثال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 370.9,
   "end": 373.9,
   "text": "خیلی رتبه بالایی می‌خواد. هرکسی نمی‌تونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 373.9,
   "end": 377.0,
   "text": "انشاالله به اصل الحاق و شفاعت عامه بریم اونجا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 377.0,
   "end": 379.72,
   "text": "باز اونجا حضرت اسرافیل در عالم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 379.72,
   "end": 382.3,
   "text": "عقول منتظره تا احیا کنه ما رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 382.3,
   "end": 385.68,
   "text": "دست‌به‌دست میدن از هر درجه مادون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 385.68,
   "end": 390.18,
   "text": "رفتن ما به درجه مافوق، یه اماته می‌خواد، یه احیا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 390.18,
   "end": 394.38,
   "text": "باید اسم این اسم و اسامی حضرت حق،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 394.38,
   "end": 398.82,
   "text": "الحی‌ش و اون اماته حضرت حق اتفاق، اتفاق بیفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 398.82,
   "end": 401.36,
   "text": "یحیی و یمیت و یمیت و یحیی دائماً.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 401.36,
   "end": 407.0,
   "text": "این تجلی حضرت حقه. حالا این کار حضرت عزرائيله، کار حضرت اسرافيله،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 407.0,
   "end": 413.48,
   "text": "چون واسطه‌های فیض‌اند. اما قرآن میگه الله یتوفی الأنفس حين موتها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 413.48,
   "end": 416.0,
   "text": "الله یتوفی الأنفس حين موتها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 416.0,
   "end": 418.14,
   "text": "نه فقط وقت موت‌تون‌ها،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 418.14,
   "end": 420.84,
   "text": "و الذي لم تمت في منامها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 420.84,
   "end": 423.16,
   "text": "حتی کسی هم که می‌خوابه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 423.16,
   "end": 425.8,
   "text": "باز همین الله یتوفی الأنفس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 425.8,
   "end": 429.0,
   "text": "یعنی هر وقت ما می‌خوایم پشت میزتون نشستید،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 429.0,
   "end": 433.08,
   "text": "یکان چشاتون میره رو هم، می‌رید تو عالم رتبه مثال.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 433.08,
   "end": 436.64,
   "text": "الله یتوفی الأنفس. همون لحظه خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 436.64,
   "end": 439.02,
   "text": "نفس شما رو به تمامه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 439.02,
   "end": 443.4,
   "text": "استیفا می‌کنه. الله همون لحظه موت حاصل می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 443.4,
   "end": 450.44,
   "text": "میری به عالم بعدی. منتها باز توجه نفس برمی‌گرده به بدن که دو مرتبه برمی‌گردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 450.44,
   "end": 454.2,
   "text": "یا به عبارتی هنوز توجه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 454.2,
   "end": 462.36,
   "text": "یه چیزکی، یه نگاهی، یه گوشه چشمی از نفس هنوز به این بدن هست که این بدن هنوز برقراره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 462.36,
   "end": 466.62,
   "text": "شما دقت بکنید که همین، همین موضوع توفی رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 466.62,
   "end": 468.78,
   "text": "مرگ و مو-- موت و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 468.78,
   "end": 472.16,
   "text": "حیات رو. مرگ و میر رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 472.16,
   "end": 476.36,
   "text": "از هر حیثش که نگاه می‌کنید دست خدا تو کاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 476.36,
   "end": 480.94,
   "text": "هیچکس نمی‌تونه. بارها آدم‌ها بودن خودکشی کردن زنده موندن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 480.94,
   "end": 486.68,
   "text": "بارها آدم‌ها-- خیلیا آدم همین الان حیات دارن، آرزوی مرگ دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 486.68,
   "end": 488.42,
   "text": "خیلیا لب مرگ‌اند همین الان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 488.42,
   "end": 492.98,
   "text": "همین الان که من و شما، شما اینجا نشستیم در عافیت والحمد لله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 492.98,
   "end": 497.24,
   "text": "اون‌ها همین الان در حال جان کندن و نزع جان‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 497.24,
   "end": 500.42,
   "text": "در احتضارند. این میلیاردها آدما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 500.42,
   "end": 504.02,
   "text": "اونا آرزوی حیات دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 504.02,
   "end": 505.7,
   "text": "خب کی این کار رو داره انجام میده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 505.7,
   "end": 508.82,
   "text": "دست کیه؟ کی می‌تونه دخالت کنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 508.82,
   "end": 513.3,
   "text": "همش دست حضرت حقه. کسی اینو باور کنه الهی زندگی می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 513.3,
   "end": 517.2,
   "text": "خدا رحمت کنه. حضرت آقای،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 517.2,
   "end": 522.22,
   "text": "حضرت استاد علامه حسن زاده علیه الرحمه و الرضوان رو از قبرستون من فیلمشونو دیدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 522.22,
   "end": 524.24,
   "text": "از قبرستون که برمی‌گشتن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 524.24,
   "end": 526.98,
   "text": "همین جوونا، پیرمردا، بچه‌ها،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 526.98,
   "end": 529.0,
   "text": "بچه‌های ده و همه رو جمع کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 529.0,
   "end": 530.74,
   "text": "یه حرف خیلی حکیمانه زد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 530.74,
   "end": 533.94,
   "text": "فرمود گمان کنید شما جای اون بودید الان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 533.94,
   "end": 536.3,
   "text": "از خدا نمی‌خواستید حیات دوباره به شما بده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 536.3,
   "end": 538.8,
   "text": "خب بسم الله دوباره به شما حیات داده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 538.8,
   "end": 543.02,
   "text": "دارید از قبر برمی‌گردید به سمت شهر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 543.02,
   "end": 544.92,
   "text": "گمان کنید حیات دوباره گرفتید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 544.92,
   "end": 547.76,
   "text": "چه می‌کنید؟ خیلی حرف، حرف حکیمانه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 547.76,
   "end": 550.24,
   "text": "همه چی دست خداست. بخت النصر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 550.24,
   "end": 552.44,
   "text": "دانیال رو انداخت تو چاه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 552.44,
   "end": 555.0,
   "text": "که از گرسنگی و تشنگی بمیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 555.0,
   "end": 559.92,
   "text": "اما خدا کسایی رو مأمور کرد بهش آب دادن، غذا دادن، زنده نگهش داشتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 559.92,
   "end": 567.18,
   "text": "یا حجاج بن یوسف علیه اللعنة والعذاب الألیم وقتی سعید ابن جبیر رو خواست از اهل ایمان بود دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 567.18,
   "end": 569.84,
   "text": "از محبین پر و پا قرص امیرالمؤمنین بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 569.84,
   "end": 573.16,
   "text": "وقتی رفتن اینو دست و پا بسته بیارنش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 573.16,
   "end": 575.0,
   "text": "گفت من خودم میام. من از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 575.0,
   "end": 578.44,
   "text": "قضا و قدر خدا نترسم. رها کنید من خودم دنبال سرتون میام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 578.44,
   "end": 580.86,
   "text": "رفت. رسیدن تو راه خسته شدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 580.86,
   "end": 583.86,
   "text": "شب بود. به یه دیر راهب اینا مسیحیا بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 583.86,
   "end": 586.44,
   "text": "هرچی کردن اون وارد نشد. گفت من مسلمونم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 586.44,
   "end": 590.34,
   "text": "اصلاً غیرتم اجازه نمیده وارد در دیر غریبه بشم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 590.34,
   "end": 593.14,
   "text": "اونا رفتن تو از ترس، از ترس حیوانات وحشی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 593.14,
   "end": 599.42,
   "text": "این بیرون موند. همچنین از حیث سرک می‌کشیدن نگهبانا، سربازا که این در نره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 599.42,
   "end": 601.74,
   "text": "اینا نه وایساده و عبادت می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 601.74,
   "end": 604.5,
   "text": "رفتن یه شیری اومد. گفتن تموم شد دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 604.5,
   "end": 607.12,
   "text": "سعید و این شیره می‌خوره و تموم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 607.12,
   "end": 610.38,
   "text": "کارش تموم شد. ما جواب حجاجو چی بدیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 610.38,
   "end": 612.86,
   "text": "چون حجاج می‌خواست غذا بخوره آقای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 612.86,
   "end": 619.5,
   "text": "علم‌دده می‌گفت یکی از محبین امیرالمؤمنین رو بیارید جلوی من سر ببرید دست پا بزنه خونش بپاشه من حال کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 619.5,
   "end": 625.84,
   "text": "قابل توجه مدیرایی که میگن یه شرکتی بیایید جلو ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 625.84,
   "end": 631.22,
   "text": "آخه اینا رو شنیدین که میگین؟ که غذا به ما بچسبه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 631.22,
   "end": 637.9,
   "text": ". اضافه کارشو قطع کنید دست پا بزنه پرپر بزنه ما رسمیا حال کنیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 637.9,
   "end": 640.2,
   "text": ". آره. خلاصه دیدن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 640.2,
   "end": 645.68,
   "text": "شیره نه، اومد پوزشو مالید به پای سعید ابن جبیر و بوسید و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 645.68,
   "end": 648.66,
   "text": "هاج و واج اینا موندن. گفتن این از اولیای خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 648.66,
   "end": 653.28,
   "text": "ریختن به پای سعید. گفت نه، من از اولیای خدا نیستم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 653.28,
   "end": 656.24,
   "text": "ببینید خض-خضوع رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 656.24,
   "end": 658.52,
   "text": "گفت من یکی از نوکرای امیرالمؤمنینم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 658.52,
   "end": 661.5,
   "text": "من اولیا-- من عاصی گناهکارم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 661.5,
   "end": 663.58,
   "text": "همه مسلمون شدن. اونا همه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 663.58,
   "end": 667.64,
   "text": "اونایی که اونجا بودن، دیدن این صحنه همه مسلمون شدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 667.64,
   "end": 672.36,
   "text": "بعد باز خودش گفت شما برید پی کارتون من میرم به سمت قضا و قدر الهی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 672.36,
   "end": 675.1,
   "text": "باز رفت به سمت حجاج. نگاه کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 675.1,
   "end": 679.56,
   "text": "یه کسی که دم از ولایت امیرالمؤمنین می‌زنه چگونه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 679.56,
   "end": 684.54,
   "text": "محکم تو ولایتش وایساده و توحید افعالی چه می‌کنه در وجودش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 684.54,
   "end": 687.72,
   "text": "انشاالله خدای منان اینو در وجود ما پیاده کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 687.72,
   "end": 698.58,
   "text": "اللهم باریک لمولانا صاحب الزمان والحمد لله رب العالمين صلوات الله. على محمد وآله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}