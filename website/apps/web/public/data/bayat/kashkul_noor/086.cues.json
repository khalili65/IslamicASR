 },
 "chapters": [
  {
   "index": 0,
   "title": "آیهٔ بیست‌ودو سورهٔ سبأ توحید افعالی را بسیار زیبا بیان می‌کند:",
   "start": 54.36,
   "end": 76.16
  },
  {
   "index": 1,
   "title": "## داستان قوم سبأ و سدّ میان دو کوه",
   "start": 76.16,
   "end": 245.94
  },
  {
   "index": 2,
   "title": "## سهم سادات و گرهٔ زندگی؛ نمونه‌ای زنده",
   "start": 245.94,
   "end": 406.42
  },
  {
   "index": 3,
   "title": "## قهر خدا از همان دسترنج مدّعا",
   "start": 406.42,
   "end": 511.68
  },
  {
   "index": 4,
   "title": "## مثقال ذرّه؛ عاریه بودن ملک و نفس",
   "start": 511.68,
   "end": 660.66
  },
  {
   "index": 5,
   "title": "## شکر قلبی در بحار؛ تفکر در آلاء",
   "start": 660.66,
   "end": 885.89
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 6.26,
   "end": 9.6,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 9.6,
   "end": 14.54,
   "text": "السلام علیک یا داعی الله و ربانی آیاته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 14.54,
   "end": 18.44,
   "text": "سلام علیکم و رحمه الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 18.44,
   "end": 20.58,
   "text": "آیه بیست و دو سوره سبأ.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 20.58,
   "end": 30.52,
   "text": "\"قل ادعوا الذين زعمتم من دون الله لا يملكون مثقال ذرة في السماوات ولا في الأرض",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 30.52,
   "end": 34.4,
   "text": "وما لهم فيهما من شرک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 34.4,
   "end": 39.8,
   "text": "و ما له منهم من وھیر\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 39.8,
   "end": 42.9,
   "text": "خیلی زیبا موضوع توحید افعالی رو بیان کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 42.9,
   "end": 47.96,
   "text": "فرموده که بگو اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 47.96,
   "end": 51.92,
   "text": "کسانی رو که به جای خدا میپ-می‌پنداشتید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 51.92,
   "end": 55.12,
   "text": "این زعمتم نگاه کردم مرحوم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 55.12,
   "end": 58.64,
   "text": "اصفهانی، راغب اصفهانی در مفرداتش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 58.64,
   "end": 62.8,
   "text": "می‌فرماید که این زعمتم یک قولیه که دروغ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 62.8,
   "end": 69.36,
   "text": "درش هست. یعنی یک حرف خیالیه، وهمیه، حقیقت نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 69.36,
   "end": 72.9,
   "text": "این که خدای منّان به این‌ها میگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 72.9,
   "end": 76.16,
   "text": "اون کسایی که می‌پنداشتید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 76.16,
   "end": 80.74,
   "text": "که به جای خدا می‌تونند برای شما کاری انجام بدن، بسم الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 80.74,
   "end": 83.92,
   "text": "قل ادعوا. بهشون بگو اینا رو بخوانید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 83.92,
   "end": 87.66,
   "text": "اگه راست میگید اینا رو بخوانید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 87.66,
   "end": 90.76,
   "text": "حالا این به کی برمی‌گرده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 90.76,
   "end": 96.92,
   "text": "این خطاب به در حقیقت ماجرای مخصوصاً آیه قبلش، آیه بیست و یک،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 96.92,
   "end": 99.32,
   "text": "این‌ها ماجرای قوم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 99.32,
   "end": 102.6,
   "text": "سبأ در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 102.6,
   "end": 105.82,
   "text": "خود سوره سبأ هم هست دیگه آیه بیست و دو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 105.82,
   "end": 108.88,
   "text": "یه جای دیگه هم البته تو قرآن تو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 108.88,
   "end": 111.92,
   "text": "آیه چهارده به بعد سوره نمل، نمل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 111.92,
   "end": 114.74,
   "text": "اونجا هم ماجرای قوم سبأ اومده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 114.74,
   "end": 116.96,
   "text": "قصه‌ش رو من نقل کنم بعد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 116.96,
   "end": 120.34,
   "text": "یک دو تا نکته از آیه عرض کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 120.34,
   "end": 125.18,
   "text": "که به چه صورت بوده. این‌ها می‌دونید تقریباً جنوب عربستان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 125.18,
   "end": 128.62,
   "text": "پایگاه‌شون بوده، پایتخت‌شون اونجا بوده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 128.62,
   "end": 132.9,
   "text": "که وصل می‌شه به یمن. اونجا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 132.9,
   "end": 134.66,
   "text": "اومده بودن چیکار کرده بودن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 134.66,
   "end": 139.48,
   "text": "دو تا باغ خدای منّان به اینا داده بود سمت چپ و راست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 139.48,
   "end": 143.3,
   "text": "که اومده بودن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 143.3,
   "end": 146.64,
   "text": "بین دو تا کوه خیلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 146.64,
   "end": 152.16,
   "text": "بزرگ، بینش رو با مسافت تقریباً هشتصد متر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 152.16,
   "end": 157.84,
   "text": "با یک دیواره بسیار قطور و شبیه کوه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 157.84,
   "end": 162.86,
   "text": "سدی رو ایجاد کرده بودن که حالا امروزه بهش میگن سد خاکی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 162.86,
   "end": 165.1,
   "text": "سدی رو بین این دو تا کوه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 165.1,
   "end": 172.12,
   "text": "حساب کنید اون موقع با نبود تجهیزات امروزی خیلی سخت بوده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 172.12,
   "end": 176.82,
   "text": "نزدیک به یک کیلومتر سد بزنی بین دو تا کوه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 176.82,
   "end": 178.74,
   "text": "که اونجا رودخونه‌ای رد می‌شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 178.74,
   "end": 183.54,
   "text": "بعدم میگن اون حالت مثلاً ق-قطر همین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 183.54,
   "end": 188.16,
   "text": "سد به قدری زیاد بوده که خودش مثل یه کوه دیده می‌شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 188.16,
   "end": 190.52,
   "text": "حساب کنید چقدر اونجا خاک ریخته شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 190.52,
   "end": 192.96,
   "text": "چه کردن، چه، چه استحکامی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 192.96,
   "end": 195.54,
   "text": "یعنی به خودشون می‌نازیدن دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 195.54,
   "end": 197.84,
   "text": "یعنی می‌گفتن این حاصل دست ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 197.84,
   "end": 202.96,
   "text": "ما یه همچین کاری کردیم. خب این با-- آب جمع شد پشت این سد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 202.96,
   "end": 209.7,
   "text": "به قدری باعث شد که اونجا زراعت‌شون و باغداری‌شون مخصوصاً رونق بگیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 209.7,
   "end": 216.76,
   "text": "دو تا باغ که دیگه میشه گفت ضرب المثل شده بود در بهشت روی زمین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 216.76,
   "end": 220.32,
   "text": "انواع و اقسام میوه‌های آنچنانی و فلان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 220.32,
   "end": 224.2,
   "text": "بعد پیامبران اون زمان خب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 224.2,
   "end": 226.26,
   "text": "اولین بعد از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 226.26,
   "end": 232.74,
   "text": "توحید، اولین حرفی که همیشه داشتن این بود که آقا نعمت‌های خدا رو شاکر باشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 232.74,
   "end": 235.14,
   "text": "این‌ها پس زدن. گفتن این حرفا چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 235.14,
   "end": 237.08,
   "text": "حاصل دسترنج خودمونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 237.08,
   "end": 240.18,
   "text": "خدا اعوذ بالله کیه؟ حرفا چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 240.18,
   "end": 241.78,
   "text": "خودمون داریم زحمتش رو می‌کشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 241.78,
   "end": 245.94,
   "text": "مثل خیلیا که الان اینطوری هستن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 245.94,
   "end": 251.02,
   "text": "واجبات خمسی و واجبات مالیشون رو وقتی می‌خوای بگی آقا بده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 251.02,
   "end": 255.62,
   "text": "در راه خدا بده بره. همین چند روز پیش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 255.62,
   "end": 257.28,
   "text": "ما اصلاً طرف رو نمی‌شناختیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 257.28,
   "end": 264.3,
   "text": "یه بنده خدایی سیصد و خرده‌ای میلیون پول ریخت به حساب بنده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 264.3,
   "end": 266.26,
   "text": "پیامک هم داد که این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 266.26,
   "end": 268.86,
   "text": "پول سهم ساداته از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 268.86,
   "end": 271.74,
   "text": "مرجعم که آقای سیستانی اجازه گرفتن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 271.74,
   "end": 276.52,
   "text": "شما فقط بر سادات. بعد یه بچه سیدی بود که این بنده خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 276.52,
   "end": 283.02,
   "text": "اصلاً دیگه انقدر به مشکل برخورده بودن داشتن-- یعنی ز-نظام زندگیشون داشت می‌پاچید، ورشکست شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 283.02,
   "end": 285.1,
   "text": "حالا این نفر کلاشو برداشته بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 285.1,
   "end": 287.82,
   "text": "دقیقاً همین پول رو نیاز داشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 287.82,
   "end": 289.54,
   "text": "طفلی چند-- بچه‌های هیئت ما بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 289.54,
   "end": 292.2,
   "text": "چند بار اومد پیش من درد و دل کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 292.2,
   "end": 293.82,
   "text": "ترو خدا یه کاری، یه وامی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 293.82,
   "end": 297.76,
   "text": "ما هیچ کاری نتونستیم براش بکنیم چون رقم بالا بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 297.76,
   "end": 300.26,
   "text": "بعد بهش گفتم سیجون برای خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 300.26,
   "end": 303.52,
   "text": "بگو اصلاً هزار میلیارد با یه یک قرونی کاری نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 303.52,
   "end": 307.0,
   "text": "تو توسل کن. یه چند تا راه توسل بهش یاد دادیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 307.0,
   "end": 308.6,
   "text": "جدش هم به امام حسن می‌خورد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 308.6,
   "end": 310.82,
   "text": "من جلوی ضریح سیدالکریم نشسته بودم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 310.82,
   "end": 314.62,
   "text": "گفتم جد ایشونم که من امروز زیارتش رو کردم حضرت امام مجتبی‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 314.62,
   "end": 318.94,
   "text": "تو اجدادت کریم بودند. توسل کن انشاالله گره باز می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 318.94,
   "end": 320.6,
   "text": "دیگه یه چند ماهی گذشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 320.6,
   "end": 322.5,
   "text": "دیگه یعنی زندگیش داشت می‌پاچید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 322.5,
   "end": 325.2,
   "text": "حکم جلبش رو داشتن می‌گرفتن می‌بردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 325.2,
   "end": 326.96,
   "text": "یه دفعه زدم این پول اومد دست ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 326.96,
   "end": 334.86,
   "text": "دادم مخصوص سادات و یه چند تا دور و بری‌های ما بودند گرفتار اما هیچ کدومشون مثل ایشون گرفتار نبود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 334.86,
   "end": 339.04,
   "text": "وقتی براش این پول رو زدم و باهاش ارتباط گرفتم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 339.04,
   "end": 341.96,
   "text": "خودش، خانومش گریه زاری، دست پاش می‌لرزید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 341.96,
   "end": 344.46,
   "text": "گفت حاجی نمی‌دونید با من چیکار کردین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 344.46,
   "end": 347.8,
   "text": "خب این مگه این پولو ما آخوندا می‌خوریم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 347.8,
   "end": 350.4,
   "text": "این برای چیه؟ مثلاً سهم سادات برای چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 350.4,
   "end": 358.28,
   "text": "برای گره گشایی از سادات محترم که حق بزرگی جدشون گردن همه ما داره، حق حیات داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 358.28,
   "end": 360.76,
   "text": "یا اون یکی سهم امام مگه چیکار ما باهاش می‌کنیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 360.76,
   "end": 363.74,
   "text": "در راه علم و در راه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 363.74,
   "end": 372.3,
   "text": "نشر حقایق و ساختن مساجد و حسینیه‌ها که این ملعون‌های خبیث اومدن آتیشش زدن، حوزه‌های علمیه، دانشگاه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 372.3,
   "end": 377.14,
   "text": "تو مسیر هرچی هست برای رشد و تعالی خودمونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 377.14,
   "end": 380.42,
   "text": "بعد طرف می‌بینی حتی نمازشو می‌خونه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 380.42,
   "end": 386.16,
   "text": "واجبات مالیشو نمیده. میگه خودم زحمت-- تو دلش میگه‌ها ولی به زبونش، خودم زحمت کشیدم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 386.16,
   "end": 391.58,
   "text": "ز-دست‌رنج خودمه. متاسفانه این شرک‌ها زیاده، دیده میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 391.58,
   "end": 395.0,
   "text": "خیلی زیاد داریم‌ها، آدم‌هایی که نماز می‌خونن، روزه می‌گیرن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 395.0,
   "end": 396.98,
   "text": "اما واجبات مالیشونو نمیدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 396.98,
   "end": 402.36,
   "text": "میگن این آخوندا می‌کنن تو جیب خودشونو فلان و بیسار و چقدرم جو سازی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 402.36,
   "end": 404.42,
   "text": "خلاصه کاری نداریم. اینا شاکر نشدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 404.42,
   "end": 406.42,
   "text": "شک-شکر الهی رو به جا نیاوردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 406.42,
   "end": 414.64,
   "text": "چه اتفاقی افتاد؟ خدای منان از همون دست‌رنج خودشون که ادعا می‌کردن این سد رو ما ساختیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 414.64,
   "end": 418.5,
   "text": "ببینید چی ساختیم. از همون جا بلا رو سرشون نازل کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 418.5,
   "end": 421.7,
   "text": "یه کاری کرد که این سد انقدر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 421.7,
   "end": 424.0,
   "text": "آب اومد بالا، اومد بالا که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 424.0,
   "end": 428.52,
   "text": "فشار به حدری شد که سد رو به قول امروزه میگن سد شکسته شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 428.52,
   "end": 432.8,
   "text": "دو سوم این سد با آب اومد تو شهر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 432.8,
   "end": 437.02,
   "text": "خود این سد به، به شکل کوه دو سومش با خود آب اومد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 437.02,
   "end": 439.9,
   "text": "انقدر شدت آب زیاد شد، اومد سیل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 439.9,
   "end": 442.98,
   "text": "زد همه باغ و بستان و همشونو که داغون کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 442.98,
   "end": 445.7,
   "text": "هیچی همه اینام به درک وصل شدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 445.7,
   "end": 449.3,
   "text": "بعد جالبه که وقتی هم آب فروکش کرد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 449.3,
   "end": 454.12,
   "text": "روایت داریم که دیگه عجیبه قهر خدای سرزمین رو بگیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 454.12,
   "end": 458.86,
   "text": "دیگه هیچ درخت مثمر ثمری، درخت مثلاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 458.86,
   "end": 461.14,
   "text": "ثمر، ثمره خوبی، میوه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 461.14,
   "end": 463.88,
   "text": "شیرین و خوبی داشته باشه اونجا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 463.88,
   "end": 467.98,
   "text": "نبود. هر درختی هم که بعداً اونجا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 467.98,
   "end": 471.22,
   "text": "رشد می‌کرد، اون درخت‌ها یا گز بودن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 471.22,
   "end": 476.1,
   "text": "یا فوقش حالا حد خیلی کمی درخت سدره مثلاً بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 476.1,
   "end": 480.1,
   "text": "اونم بی بار و بر. قهر خدا بگیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 480.1,
   "end": 485.58,
   "text": "این داستان داره اونو حکایت می‌کنه که آقا شما اینطوری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 485.58,
   "end": 488.68,
   "text": "شرک قائل شدید و شکر الهی رو به جا نیاوردید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 488.68,
   "end": 492.02,
   "text": "خب بفرمایین بخونید. اونهایی که به جز من خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 492.02,
   "end": 495.32,
   "text": "ادعا می‌کردید که شما پشتوانه شماست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 495.32,
   "end": 498.2,
   "text": "صداشون کنید ببینن. بسم الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 498.2,
   "end": 504.16,
   "text": "خیلی از ما اینطوری هستیم. پشتمون به خیلی چیزا به جز العذربلله حضرت حق گرمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 504.16,
   "end": 506.48,
   "text": "به وقتش خدا میگه بخون ببینم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 506.48,
   "end": 509.0,
   "text": "بخون ببینم همونایی که دلت بهشون گرمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 509.0,
   "end": 511.68,
   "text": "ببینم چیکار میخوان براتون بکنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 511.68,
   "end": 520.1,
   "text": "اینجا می‌فرماید که \"قل ادعوا الذین زعمتم من دون الله لا یملکون مثقال ذرة فی السماوات ولا فی الارض\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 520.1,
   "end": 524.2,
   "text": "مثقال یعنی سر سوزنی، مثقال ذره‌ای.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 524.2,
   "end": 527.82,
   "text": "اینایی که شما می‌خونیدشون، دلتون بهشون خوشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 527.82,
   "end": 530.16,
   "text": "نه د-نه از آسمان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 530.16,
   "end": 534.36,
   "text": "مالکن نه از زمین. حتی در زمین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 534.36,
   "end": 538.7,
   "text": "پس این خونه من، این ملک من، این وسیله نقلیه من، این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 538.7,
   "end": 540.38,
   "text": "مال و منال من، اینا چین؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 540.38,
   "end": 542.72,
   "text": "مال تو نیست. اینا عاریه هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 542.72,
   "end": 546.64,
   "text": "خودتم عاریه‌ای. خودتم مال خودت نیستی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 546.64,
   "end": 549.72,
   "text": "کسی که توحید افعالیش قوی میشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 549.72,
   "end": 552.86,
   "text": "حتی افعال-- چرا میگی به حول در نماز؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 552.86,
   "end": 556.2,
   "text": "ذکری که می‌تونی در حال حرکت بگی اینه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 556.2,
   "end": 559.96,
   "text": "بقیه رو باید ثابت بگی. به حول الله و قوته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 559.96,
   "end": 561.98,
   "text": "درسته میگی اقوم و اقعد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 561.98,
   "end": 563.58,
   "text": "من پا میشم، من می‌شینم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 563.58,
   "end": 566.94,
   "text": "اما به حول الله و قوته،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 566.94,
   "end": 570.08,
   "text": "به حول و قوه او پا میشم، می‌شینم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 570.08,
   "end": 574.46,
   "text": "که امثال عارف عربی‌ها بارها عرض کردیم که دیگه عرفای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 574.46,
   "end": 577.12,
   "text": "خیلی بلندی اینجا پیاده می‌کنند که عالم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 577.12,
   "end": 579.24,
   "text": "هرجایی نمی‌تونه نقل کنه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 579.24,
   "end": 584.48,
   "text": "ان الله یصلی. خود خدا، شؤون خدا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 584.48,
   "end": 587.26,
   "text": "ظهور خدا داره اقامه نماز کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 587.26,
   "end": 589.08,
   "text": "تو کی هستی؟ تو چی هستی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 589.08,
   "end": 592.18,
   "text": "اصلاً تو موجودیتی خودت به شخصه نداری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 592.18,
   "end": 594.82,
   "text": "هیچ چیزی وجود استقلالی نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 594.82,
   "end": 598.34,
   "text": "بعد می‌فرماید \"و ما له فیها من شرک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 598.34,
   "end": 600.6,
   "text": "و ما له منهم من وهی\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 600.6,
   "end": 603.66,
   "text": "حواستون هم باشه ها. اینایی که شما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 603.66,
   "end": 610.04,
   "text": "تو خیال خودتون دلتون بهشون گرمه، \"ما له منهم من وهی\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 610.04,
   "end": 611.94,
   "text": "اینا هیچ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 611.94,
   "end": 614.76,
   "text": "پشتیبانی از طرف خدا نمیشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 614.76,
   "end": 620.72,
   "text": "یعنی فکر نکنید بگید که حالا این‌ها رابطه‌ای‌ان حتی بین خدا و شما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 620.72,
   "end": 624.38,
   "text": "اینطوری هم نیست. اصلاً هیچ پشتوانه‌ای خ-اینا پیش خدا ندارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 624.38,
   "end": 631.52,
   "text": "هیچ کاره عالم‌اند. سر سوزنی تملک نه در زمین دارن نه در آسمان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 631.52,
   "end": 635.0,
   "text": "چرا شکرگذار نعمت‌های من نیستید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 635.0,
   "end": 640.32,
   "text": "شمایی که معذرت می‌خوام دماغتونو چند ثانیه بگیرن ول نکنن خفه میشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 640.32,
   "end": 642.66,
   "text": "آخه به چی دلت خوشه آدم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 642.66,
   "end": 645.66,
   "text": "که به-- قدیمام گفتن آه و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 645.66,
   "end": 648.72,
   "text": "دم. آدم مخفف آه و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 648.72,
   "end": 650.96,
   "text": "دمه. یه آه و یه دم آدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 650.96,
   "end": 655.08,
   "text": "یک آن تب کنه بسوزه تمام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 655.08,
   "end": 657.84,
   "text": "چهارچرخش رفت رو هوا. تموم شد کارش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 657.84,
   "end": 663.82,
   "text": "با این همه ادعا و. یه روایتی دیدم خیلی شیرینه اینو بگم یه ذره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 663.82,
   "end": 669.38,
   "text": "در دل آیه استفاده بهره‌برداری اینچنینی هم کرده باشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 669.38,
   "end": 675.54,
   "text": "در بهار جلد هفتاد و پنج صفحه دویست و پنجاه و دو از اهمیت شکر نعمت می‌خوام عرض کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 675.54,
   "end": 680.96,
   "text": "روایت داریم من عم-- انعم الله علیه نعمة.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 680.96,
   "end": 682.68,
   "text": "کسی که خدا نعمتی رو بهش داد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 682.68,
   "end": 686.72,
   "text": "این همه ما خودمون غرق در نعمتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 686.72,
   "end": 689.44,
   "text": "کسی که خدا بهش نعمتی داد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 689.44,
   "end": 691.66,
   "text": "فعرفها بقلبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 691.66,
   "end": 695.4,
   "text": "نکته اینجاست. بقلبش این نعمت رو شناسایی کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 695.4,
   "end": 701.4,
   "text": "شناخت. قلباً شناخت که این نعمت از خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 701.4,
   "end": 707.04,
   "text": "و علم ان المنعم علیه الله و این رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 707.04,
   "end": 713.06,
   "text": "علم پیدا کرد که اون منعم اصلی الله خداست نه دیگری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 713.06,
   "end": 716.4,
   "text": "فقط ادى شکرها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 716.4,
   "end": 722.24,
   "text": "و ان لم یحرك لسانه قطعاً ادای شکر اون نعمت رو کرده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 722.24,
   "end": 728.29,
   "text": "ولو الم یحرك لسانه حتی اگر لسانش تکون نخوره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 728.29,
   "end": 731.03,
   "text": "یعنی حتی به لسان اگر جاری نکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 731.03,
   "end": 735.83,
   "text": "این روایت داره این رو بیان میکنه که شکر اصلی چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 735.83,
   "end": 738.23,
   "text": "اینکه قلباً متوجه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 738.23,
   "end": 740.83,
   "text": "نعمت باشی و بدونی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 740.83,
   "end": 743.49,
   "text": "منعم اون نعمت هم فقط خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 743.49,
   "end": 745.41,
   "text": "این تو وجود انسانه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 745.41,
   "end": 751.17,
   "text": "لغلغه زبان هم میتونه نباشه تو وجود-- یعنی به این اعتقاد رسیدی تو شکری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 751.17,
   "end": 755.23,
   "text": "تو شکر نعمت به جا آوردی. نه اینکه ته دلت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 755.23,
   "end": 760.59,
   "text": "دلت به کس دیگه، به دست کس دیگه، به چیز دیگه ای خوش باشه، نه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 760.59,
   "end": 767.15,
   "text": "در مستدرک هم از امیرالمؤمنین علیه الصلاة والسلام جلد یازده صفحه صد و هشتاد و پنج",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 767.15,
   "end": 770.99,
   "text": "خیلی شیرین فرمودن \"التفکر فی آلاء الله.\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 770.99,
   "end": 773.09,
   "text": "به به، به قربون این آقا برم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 773.09,
   "end": 778.35,
   "text": "امیر بیان. تفکر در نعمت‌های خدا چیه به نظر شما؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 778.35,
   "end": 782.35,
   "text": "چه وجهی از عبادته؟ می فرماید \"نعم العبادة\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 782.35,
   "end": 785.37,
   "text": "چه عبادت خوبیه. نعم العبادة.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 785.37,
   "end": 789.25,
   "text": "بعضیا گفتن همون معنای خیر العباده است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 789.25,
   "end": 793.17,
   "text": "یعنی بهترین از همه عبادت. چه نعمت شیرینیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 793.17,
   "end": 795.73,
   "text": "تفکر کردن در نعمت‌های خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 795.73,
   "end": 799.69,
   "text": "خدا وکیلیش این آخر کلام یه نهیبی به خودم بزنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 799.69,
   "end": 801.39,
   "text": "شده ما خلوت کنیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 801.39,
   "end": 804.17,
   "text": "حالا چکمون که میخواد پاس بشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 804.17,
   "end": 806.75,
   "text": "موجودی نداره. مریضمون شفا بگیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 806.75,
   "end": 808.89,
   "text": "گرفتاری‌های آنچنانی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 214,
   "start": 808.89,
   "end": 810.59,
   "text": "حقوقمون یهو پس و پیش میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 215,
   "start": 810.59,
   "end": 813.93,
   "text": "اینو زانوقم بغل می‌گیریم یک ساعت بریم تو فکر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 216,
   "start": 813.93,
   "end": 817.73,
   "text": "ولی شده خداوکیلی یه گوشه ای زانوقم بغل بگیریم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 217,
   "start": 817.73,
   "end": 822.57,
   "text": "بریم تو فکر نعمت‌های خدا غرق بشیم که خدا چیا به ما داده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 218,
   "start": 822.57,
   "end": 826.23,
   "text": "یه بار بشینیم بنویسیم ببینیم اصلاً ته داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 219,
   "start": 826.23,
   "end": 832.31,
   "text": "اصلاً میشه نوشت همه رو؟ چقدر تو قرآن تاکید-- اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 220,
   "start": 832.31,
   "end": 836.89,
   "text": "سوره الرحمن دیگه. \"فبأي آلاء ربكما تكذبان\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 221,
   "start": 836.89,
   "end": 840.73,
   "text": "کدوم یکی از نعمت‌های خدا تون رو دارید تکذیب می‌کنید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 222,
   "start": 840.73,
   "end": 845.15,
   "text": "خیلی مهمه اینکه انسان قلباً متوجه نعمت الهی باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 223,
   "start": 845.15,
   "end": 847.11,
   "text": "اگر نباشه بلا میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 224,
   "start": 847.11,
   "end": 850.43,
   "text": "بعد میاد گرفتار میشیم ما آخوندا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 225,
   "start": 850.43,
   "end": 853.95,
   "text": "از انواع و اقسام آدمای بلاکشی که بلا زده‌شونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 226,
   "start": 853.95,
   "end": 857.49,
   "text": "حالا میخواد بیاد بگه حاج آقا یه وردی، یه قسمی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 227,
   "start": 857.49,
   "end": 860.89,
   "text": "یه دعایی به ما، یه دستور العملی بده ما نجات پیدا کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 228,
   "start": 860.89,
   "end": 863.87,
   "text": "مرد حسابی اون موقع باید به فکر می‌بودی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 229,
   "start": 863.87,
   "end": 865.97,
   "text": "شکرگذار می‌بودی، نبودی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 230,
   "start": 865.97,
   "end": 870.87,
   "text": "حالا بلا ریخته تو وجود تو، خونواده‌ت میخوای با یه دعا برش داری؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 231,
   "start": 870.87,
   "end": 875.91,
   "text": "اینطوری نیست که. اللهم بارک لمولانا صاحب الزمان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 232,
   "start": 875.91,
   "end": 877.95,
   "text": "والحمد لله رب العالمين.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 233,
   "start": 877.95,
   "end": 881.35,
   "text": "صلوات. اللهم صلي على محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 234,
   "start": 881.35,
   "end": 885.89,
   "text": "و آل محمد و عجل فرجهم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}