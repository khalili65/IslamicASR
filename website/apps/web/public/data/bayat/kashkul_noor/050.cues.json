 },
 "chapters": [
  {
   "index": 0,
   "title": "## توحید افعالی در آیهٔ چهل و نه یونس",
   "start": 19.96,
   "end": 112.78
  },
  {
   "index": 1,
   "title": "## صداقت پیامبر؛ نفی خود در اوج عظمت",
   "start": 112.78,
   "end": 245.66
  },
  {
   "index": 2,
   "title": "## خورشیدگرفتگی هنگام دفن فرزند",
   "start": 245.66,
   "end": 266.06
  },
  {
   "index": 3,
   "title": "ادامهٔ آیه می‌فرماید برای هر امتی اجلی است؛ چون اجل آمد:",
   "start": 266.06,
   "end": 501.56
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.74,
   "end": 4.76,
   "text": "اللهم صل علی محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 4.76,
   "end": 7.48,
   "text": "و آل محمد و عجل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 7.48,
   "end": 12.34,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 12.34,
   "end": 16.9,
   "text": "السلام علیک یا داعی الله و ربانی ایات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 16.9,
   "end": 19.96,
   "text": "سلام علیکم و رحمت الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 19.96,
   "end": 23.2,
   "text": "در آیه چهل و نه سوره یونس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 23.2,
   "end": 27.8,
   "text": "صلوات الله علیه اما توحید افعالی رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 27.8,
   "end": 36.24,
   "text": "مشاهده می‌کنیم. ولا أمل کل نفسی ضرر ولا نفعا الا ما شاء الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 36.24,
   "end": 40.54,
   "text": "پیغمبر بگو که من برای خودم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 40.54,
   "end": 45.56,
   "text": "قدرت دفع زیان و جلب سود ندارم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 45.56,
   "end": 49.06,
   "text": "حتی برای خودم چه برسه به شما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 49.06,
   "end": 51.98,
   "text": "البته الا ما شاء الله چون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 51.98,
   "end": 54.08,
   "text": "در تفسیر مراغی یا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 54.08,
   "end": 59.38,
   "text": "بعضی از وهابیت اشاره به همین آیه کردن و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 59.38,
   "end": 63.06,
   "text": "به برداشت غلطی که از این آیه کردن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 63.06,
   "end": 67.5,
   "text": "گفتن پس توسل به اهل بیت اشکال داره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 67.5,
   "end": 71.5,
   "text": "و هیچ خیری درش نیست. وقتی مثلاً پیغمبر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 71.5,
   "end": 78.14,
   "text": "برای خودش هیچ خیری رو نمی‌تونه بخواد یا سودی یا ضرری رو دفع کنه، بخواد برای ما داشته باشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 78.14,
   "end": 80.64,
   "text": "اشاره می‌کنم بد فهمیشونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 80.64,
   "end": 83.38,
   "text": "اتفاقاً آقای قاضی هم به همین تذکر میدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 83.38,
   "end": 89.08,
   "text": "میگه اون‌ها توجه به این قسمت آیه نکردن که الا ما شاء الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 89.08,
   "end": 91.72,
   "text": "مگر اون بخشی که خدا بخواد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 91.72,
   "end": 97.14,
   "text": "یعنی پس پیغمبر هم می‌تونه خیری رو برسونه یا دفعی رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 97.14,
   "end": 101.36,
   "text": "ضرری رو دفع کنه چه از خودش چه از ماها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 101.36,
   "end": 104.76,
   "text": "لکن در صورتی که خدا بخواد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 104.76,
   "end": 110.58,
   "text": "یعنی در طول الهیت نظام همه تعریف می‌شن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 110.58,
   "end": 115.52,
   "text": "حالا یه فرمایشی هم خدا حفظ کنه آقای قاضی رو در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 115.52,
   "end": 119.32,
   "text": "تفسیر نورشون دارن خیلی برای من جالب بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 119.32,
   "end": 121.54,
   "text": "خب هر کسی به این‌ها دقت نمی‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 121.54,
   "end": 124.46,
   "text": "می‌فرماید همین فرمایش پیغمبر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 124.46,
   "end": 128.9,
   "text": "که لا أمل کل نفسی ضرر ولا نفعا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 128.9,
   "end": 131.76,
   "text": "این نشانه صداقت پیغمبره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 131.76,
   "end": 134.9,
   "text": "اون جایگاهی که پیغمبر داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 134.9,
   "end": 139.36,
   "text": "خدای منان کتابی رو بهش نازل کرده که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 139.36,
   "end": 142.8,
   "text": "اهدی نمی‌تونسته یک آیه مثل اون بیاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 142.8,
   "end": 150.4,
   "text": "شوخی نیست. نشسته بودن بهترین ادبیات عرب رو تو یک غزل پیاده کرده بودن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 150.4,
   "end": 158.6,
   "text": "و اون رو سر در خانه خدا آویزون کرده بودن به عنوان مثلاً دیگه اوج فصاحت و بلاغت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 158.6,
   "end": 163.56,
   "text": "اشعار اون زمان. بلغای اون زمان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 163.56,
   "end": 168.36,
   "text": "به محض اینکه آیات قرآن نازل شد کشیدنش پایین گفتن نه اصلاً این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 168.36,
   "end": 171.42,
   "text": "آبروریزیه ما به اون افتخار کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 171.42,
   "end": 178.72,
   "text": "با اینکه پیغمبر رو قبول نداشتن اما واقعاً اوج فصاحت و بلاغت رو در کلام پیغمبر دیدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 178.72,
   "end": 185.96,
   "text": "این تازه یه وجهشه. در هر حال اون آبرویی که پیغمبر داشت، قبوحتی که داشت، عظمتی که داشت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 185.96,
   "end": 189.28,
   "text": "اینکه در بین همه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 189.28,
   "end": 192.1,
   "text": "به امانت‌داری و راستی و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 192.1,
   "end": 194.72,
   "text": "بزرگ مردی معروف بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 194.72,
   "end": 197.42,
   "text": "اما صداقت پیغمبر ایجاب می‌کنه که چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 197.42,
   "end": 201.3,
   "text": "بگه من هیچ، هیچ، اصلاً هیچ کاره عالمم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 201.3,
   "end": 203.24,
   "text": "الا ما شاء الله. مگر خدا بخواد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 203.24,
   "end": 205.84,
   "text": "کی این کارو می‌کنه خدا وکیلی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 205.84,
   "end": 208.8,
   "text": "ما یه مقدار دور و برمون آدم بگیره، یه مقدار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 208.8,
   "end": 212.62,
   "text": "معروف بشیم، مشهور بشیم، چهار تا آدم مریدمون بشن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 212.62,
   "end": 215.6,
   "text": "یه ذره بلا قربان بگن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 215.6,
   "end": 219.04,
   "text": "کار تمومه. انقدر از خودمون شاید چیزا ببافیم و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 219.04,
   "end": 222.0,
   "text": "به اسم دین به خورد این و اون بدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 222.0,
   "end": 228.06,
   "text": "چی میشه که خیلیا تا وقتی دور و برشون شلوغ نیست آدمای خوبین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 228.06,
   "end": 230.74,
   "text": "یه مقدار که مطرح می‌شن، معروف می‌شن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 230.74,
   "end": 236.14,
   "text": "اکثراً خراب می‌شن. عده قلیلی وقتی معروف و مشهور می‌شن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 236.14,
   "end": 238.56,
   "text": "پاک و صادق می‌مونن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 238.56,
   "end": 243.12,
   "text": "این یکی از چیزها نکاتیه که هرکسی بهش توجه نمی‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 243.12,
   "end": 245.42,
   "text": "چقدر پیغمبر صادق بوده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 245.42,
   "end": 249.02,
   "text": "یا وقتی فرزندش رو دفن می‌کردن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 249.02,
   "end": 252.7,
   "text": "دیگه همه شنیدید خورشید گرفتگی اتفاق افتاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 252.7,
   "end": 258.62,
   "text": "همه گفتن اه آسمان هم خورشید هم در وصفای پسر پیغمبر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 258.62,
   "end": 261.1,
   "text": "عزادار شد، حزدار شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 261.1,
   "end": 263.42,
   "text": "آسمان هم گرفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 263.42,
   "end": 266.06,
   "text": "گرفته شد، محزون شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 266.06,
   "end": 271.32,
   "text": "خب هرکس دیگه بود استفاده از این می‌کرد می‌گفت بله بله ببینید من چه جایگاهی دارم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 271.32,
   "end": 275.32,
   "text": "پسر پیغمبر فوت شد. پیغمبر فرمود نه این یه امر طبیعیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 275.32,
   "end": 282.52,
   "text": "واقعاً خیلی این نکات رو آدم دقت می‌کنی چقدر صداقت، چقدر راستی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 282.52,
   "end": 287.44,
   "text": "ما خیلی بخوایم تو این مسیر حرکت کنیم و صادق باشیم هیچی نمیگیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 287.44,
   "end": 291.96,
   "text": "میگیم ما حس-- به حسن ظن مردم به خودمون احترام می‌ذاریم، هیچی نمیگیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 291.96,
   "end": 295.28,
   "text": "بزار هر طور میخوان برداشت کنن. ولی پیغمبر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 295.28,
   "end": 298.04,
   "text": "نفی می‌کنه. می‌گه نه such چیزی نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 298.04,
   "end": 304.06,
   "text": "خیلی جالبه. بعد حالا بقیه آله که آیه که می‌فرماید کل امه اجل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 304.06,
   "end": 307.96,
   "text": "برای همه امت‌های سرامدی است، یه اجلی است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 307.96,
   "end": 311.44,
   "text": "اذا جاء اجله. حالا کی می‌تونه اینو برداره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 311.44,
   "end": 315.4,
   "text": "وقتی این اجل اومد. ولا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 315.4,
   "end": 319.78,
   "text": "یستأخرون ساعة ولا یستقدمون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 319.78,
   "end": 323.12,
   "text": "اصلاً امکان اینکه حالا این ساعتم اینجا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 323.12,
   "end": 326.46,
   "text": "منظور یک ساعت و شصت دقیقه‌ای نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 326.46,
   "end": 328.72,
   "text": "لحظه است. یک لحظه آن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 328.72,
   "end": 331.6,
   "text": "آنی اینور اونور نمیشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 331.6,
   "end": 338.12,
   "text": "در اتفاقاً بهار جلد شش صفحه صد و چهل و پنج از امام صادق علیه السلام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 338.12,
   "end": 340.4,
   "text": "روایت دیدم خیلی جالب بود که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 340.4,
   "end": 343.16,
   "text": "فرمودن فرشتگان مرگ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 343.16,
   "end": 346.76,
   "text": "اول سال‌ها رو می‌شمارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 346.76,
   "end": 348.76,
   "text": "چون یه روایتی داریم در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 348.76,
   "end": 353.92,
   "text": "تفسیر اهل بیت جلد شش صفحه چهارصد و هشتاد امام صادق علیه السلام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 353.92,
   "end": 359.12,
   "text": "در خصوص این اجل مسمی یا زمان مرگ و اینا فرمودش شب قدر،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 359.12,
   "end": 363.54,
   "text": "شب قدر تعیین میشه به عزرائیل ابلاغ میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 363.54,
   "end": 366.2,
   "text": "شب قدر به حضرت عزرائیل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 366.2,
   "end": 370.76,
   "text": "ابلاغ می‌شه که این اسم‌ها رو امسال باید بری سراغشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 370.76,
   "end": 378.12,
   "text": "کی به نظر شما؟ اون زمانی که میدن کیه به عزرائیل؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 378.12,
   "end": 381.44,
   "text": "توی اون روایت امام صادق تعیین کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 381.44,
   "end": 386.92,
   "text": "اون که تو بهاره. فرمود که اول سال‌ها رو می‌شمرم، ملائکه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 386.92,
   "end": 393.88,
   "text": "بعد ماه وقتی سالش رسید که امسال باید شب قدر به عزرائیل میدن که امسال کار تمومه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 393.88,
   "end": 395.76,
   "text": "بعد ماه‌ها رو می‌شماره دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 395.76,
   "end": 398.56,
   "text": "دیگه ماه رو قبل از سال نمی‌شماره دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 398.56,
   "end": 400.8,
   "text": "سال که تموم شد رسید به سال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 400.8,
   "end": 403.36,
   "text": "مرگ طرف ماه‌هاش رو می‌شماره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 403.36,
   "end": 406.12,
   "text": "بعد هفته‌هاشو می‌شماره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 406.12,
   "end": 409.6,
   "text": "بعد روزهاشو، بعد ساعت‌شو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 409.6,
   "end": 413.88,
   "text": "ساعت مرگش که رسید حضرت عزرائیل چی رو می‌شماره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 413.88,
   "end": 416.38,
   "text": "نفس‌هاشو. آفرین، نفس‌ها رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 416.38,
   "end": 419.8,
   "text": "نفس‌های طرفه. انقدر دقیقه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 419.8,
   "end": 421.9,
   "text": "برای همین آیه می‌فرماید که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 421.9,
   "end": 428.0,
   "text": "اذا جاء اجلهم لا يستأخرون ساعة ولا يستقدمون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 428.0,
   "end": 435.02,
   "text": "آنی این ور اون ور نمی‌شه. آیا این به نظر شما اوج توحید افعالی نیست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 435.02,
   "end": 437.28,
   "text": "اینکه پیغمبر عزیز عالم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 437.28,
   "end": 442.92,
   "text": "شخص اول عالم که واسطه بین حق و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 442.92,
   "end": 446.92,
   "text": "خلقه می‌فرماد که من نه در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 446.92,
   "end": 449.26,
   "text": "جلب نفعی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 449.26,
   "end": 453.88,
   "text": "و نه در دفع ضرری دخیل نیستم حتی برای خودم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 453.88,
   "end": 460.0,
   "text": "الا ماشاءالله. آیا این اوج توحید افعالی نیست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 460.0,
   "end": 462.64,
   "text": "چقدر شیرین تو این آیات اومده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 462.64,
   "end": 465.88,
   "text": "حالا بزرگان ما چگونه‌ست که مثل حضرت امام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 465.88,
   "end": 469.82,
   "text": "یتنه جلوی کفر جهانی وایمیستن به نظر شما؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 469.82,
   "end": 473.82,
   "text": "اینه که سر سفره این آیات می‌شینن، از این آیات تغذیه می‌کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 473.82,
   "end": 475.98,
   "text": "همینطوری نمی‌خونن رد شن برن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 475.98,
   "end": 478.8,
   "text": "توجه می‌کنن و توحیدشونو قوی می‌کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 478.8,
   "end": 484.16,
   "text": "از اهری نمی‌ترسن. دلشون رو یکپارچه می‌سپردن به حضرت حق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 484.16,
   "end": 489.14,
   "text": "انشاالله خدای منان به برکت توحید افعالی قرآنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 489.14,
   "end": 490.92,
   "text": "ما را هم به این حقیقت برسونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 490.92,
   "end": 492.64,
   "text": "والحمد لله رب العالمین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 492.64,
   "end": 495.98,
   "text": "اللهم بارک لمولانا صاحب الزمان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 495.98,
   "end": 498.38,
   "text": "والحمد لله رب العالمین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 498.38,
   "end": 501.56,
   "text": "صلوات ختم کنیم. اللهُمَّ صَلِّ عَلَى حَبِيبِكَ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}