   "start": 1.58,
   "end": 119.32
  },
  {
   "index": 1,
   "title": "## معنای ولایت؛ بی‌فاصله‌گی",
   "start": 119.32,
   "end": 188.08
  },
  {
   "index": 2,
   "title": "## فاطر؛ شکاف فقر و پر کردن به الوهیت",
   "start": 188.08,
   "end": 334.74
  },
  {
   "index": 3,
   "title": "## یطعم و لا یطعم؛ ضیافت مستمر",
   "start": 334.74,
   "end": 466.56
  },
  {
   "index": 4,
   "title": "## نگاه الهی به جزء و کل",
   "start": 466.56,
   "end": 687.36
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 1.58,
   "end": 6.44,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 6.44,
   "end": 10.48,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 10.48,
   "end": 15.18,
   "text": "آیات. سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 15.18,
   "end": 23.36,
   "text": "یکی دیگه از آیاتی که فی rampant توحید افعالی صحبت می‌کنه آیه چهارده سوره انعام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 23.36,
   "end": 27.92,
   "text": "می‌فرماید قل-- این که میگه قل بگو پیغمبر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 27.92,
   "end": 31.6,
   "text": "تو بگو بهشون. این نشون میده که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 31.6,
   "end": 35.08,
   "text": "پیغمبر عبد محض حضرت حقه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 35.08,
   "end": 38.3,
   "text": "بهحت عبودیت و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 38.3,
   "end": 44.02,
   "text": "بندگیه. قل غير الله اتخذ وлия.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 44.02,
   "end": 46.9,
   "text": "بهشون بگو که آیا غیر از خ--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 46.9,
   "end": 49.42,
   "text": "الله من",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 49.42,
   "end": 51.4,
   "text": "ولایتی رو بپذیرم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 51.4,
   "end": 54.98,
   "text": "کسی رو ولی خودم قرار بدم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 54.98,
   "end": 58.94,
   "text": "این آیه البته شأن نزولش رو می‌دونید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 58.94,
   "end": 61.58,
   "text": "مفسرین فرمودن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 61.58,
   "end": 64.7,
   "text": "این بود که وقتی پیغمبر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 64.7,
   "end": 71.62,
   "text": "اه ادعا-- بعثت، بعثت مبعوث شد و به بعثت رسید و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 71.62,
   "end": 75.26,
   "text": "اون مرتبه نبوتش رو اعلام کرد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 75.26,
   "end": 77.3,
   "text": "مشرکین جمع شدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 77.3,
   "end": 80.74,
   "text": "حالا به قولی مرفهین بی‌درد اون زمان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 80.74,
   "end": 83.9,
   "text": "برگشتن گفتن که ما که می‌دونیم تو به خاطر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 83.9,
   "end": 89.92,
   "text": "فقری که گرفتارشی مردم رو دعوت به خدا کردی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 89.92,
   "end": 93.8,
   "text": "به خاطر فقرته. بیا ما هرچی میخوای بهت میدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 93.8,
   "end": 98.26,
   "text": "دست به دست هم بدیم تو رو پولدارترین آدم روز زمین می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 98.26,
   "end": 101.62,
   "text": "همه به هم بهت می‌بخشیم. حالا پیغمبر--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 101.62,
   "end": 108.08,
   "text": "این آیه در شأن نزولی که دارن این رو فرمودن مفسرین که به این خاطر اصلاً نازل شد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 108.08,
   "end": 114.68,
   "text": "که این‌ها اینو گفتن. حالا پیغمبر می‌فرماید که بهشون بگو که غير الله اتخذ وлия.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 114.68,
   "end": 118.7,
   "text": "آیا من به جز الله ولایتی رو بپذیرم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 118.7,
   "end": 122.36,
   "text": "حالا اصلاً ولی می‌دونید چندین معنا داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 122.36,
   "end": 131.0,
   "text": "یکی از معانی مهم ولایت که ما کمتر بهش توجه می‌کنیم اینه که دو چیز انقدر به هم نزدیک بشن و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 131.0,
   "end": 135.9,
   "text": "به هم پیوستگی پیدا کنن که هیچ فاصله‌ای بین اون دو چیز نباشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 135.9,
   "end": 141.28,
   "text": "به این میگن ولی. یعنی هیچ فاصله‌ای نیست از اون دویت به--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 141.28,
   "end": 144.0,
   "text": "میگه لا فرق بینهم و بین حبیبهم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 144.0,
   "end": 146.72,
   "text": "این معنای ولایت میشه. ما وقتی می‌تونیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 146.72,
   "end": 151.12,
   "text": "دم از ولایت الله الله ولی للذین آمنو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 151.12,
   "end": 158.38,
   "text": "ما دم بزنیم یا دم از ولایت امیرالمؤمنین بزنیم که واقعاً هیچ فاصله‌ای بین ما و اون‌ها نباشد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 158.38,
   "end": 163.92,
   "text": "اگر فاصله‌ای هست و اگر ما با گناه و معصیت فاصله ای ایجاد کردیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 163.92,
   "end": 172.26,
   "text": "این ولایت مشکل داره. اون ولایتی درست و درمونه که و ما رو به سر مقصد می‌رسونه که هیچ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 172.26,
   "end": 173.88,
   "text": "خللی وجود نداشته باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 173.88,
   "end": 177.64,
   "text": "این یک نکته. که میگه اون الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 177.64,
   "end": 180.84,
   "text": "هیچ فاصله‌ای بین من و او نیست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 180.84,
   "end": 186.28,
   "text": "بین من و الله. پس چرا من اصلاً برم کس دیگه رو اختیار کنم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 186.28,
   "end": 190.36,
   "text": "بعد نکته دیگه می‌فرماید که فاطر سماوات و الارض.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 190.36,
   "end": 196.68,
   "text": "اون الله که من ولی خودم اختیارش کردم بیام عوضش کنم با کی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 196.68,
   "end": 199.76,
   "text": "خدایی که فاطر سماوات و ارضه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 199.76,
   "end": 203.06,
   "text": "فاطر اصلاً فطر رو می‌دونید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 203.06,
   "end": 208.18,
   "text": "اه به معنای در حقیقت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 208.18,
   "end": 211.3,
   "text": "یک شکاف عمیق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 211.3,
   "end": 216.7,
   "text": "و طولانی رو ایجاد کردن و بعد پر کردنش با چیزیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 216.7,
   "end": 218.88,
   "text": "به این میگن فطر. فاطر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 218.88,
   "end": 222.74,
   "text": "کسیه که در چیزی یعنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 222.74,
   "end": 226.52,
   "text": "اه سهاه اللغه یا مرحوم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 226.52,
   "end": 228.7,
   "text": "اصفهانی در مفرداتش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 228.7,
   "end": 239.1,
   "text": "می‌فرماین که اصلاً چیزی رو فاطر کسیه که چیزی رو می‌شکافه عمیقاً و به صورت طولانی و بعد پرش می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 239.1,
   "end": 246.92,
   "text": "اینجا معنایی که اینجا آوردن فاطر السماوات والأرض یعنی اینکه خدا اون کسی‌ست که آسمان‌ها و زمین رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 246.92,
   "end": 252.3,
   "text": "بلکه آسمان وجود من و زمین وجود من رو شکافته با چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 252.3,
   "end": 256.5,
   "text": "با فقر. اونم به صورت طولانی الی الأبد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 256.5,
   "end": 261.18,
   "text": "یا ایها الناس انتم الفقراء الى الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 261.18,
   "end": 263.4,
   "text": "شما فقیرید. فقیر محضید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 263.4,
   "end": 269.68,
   "text": "ذاتاً فقیرید و اون و ابتغوا اليه الوسيلة عرض کردیم تو بحث لقاء الله که علامه طباطبایی فرمودن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 269.68,
   "end": 272.74,
   "text": "این وسیله‌ای که ما رو به سمت خدا می‌کشونه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 272.74,
   "end": 277.72,
   "text": "فقر ذاتی ماست. اگه کسی بهش توجه کنه و بهش پی ببره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 277.72,
   "end": 281.88,
   "text": "حالا با چی پرش می‌کنه؟ شکاف میشه فقر،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 281.88,
   "end": 286.14,
   "text": "آسمان و زمین وجود ما رو فاطر السماوات والأرض",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 286.14,
   "end": 289.44,
   "text": "شکاف عمیق طولانی به الی الأبد داده با فقر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 289.44,
   "end": 293.68,
   "text": "با چی پرش می‌کنه؟ خودش فرمود دیگه انتم الفقراء الى",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 293.68,
   "end": 296.84,
   "text": "الله. با الوهیتش پر می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 296.84,
   "end": 301.1,
   "text": "یعنی یکپارچه وجود ما بوی الله میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 301.1,
   "end": 304.84,
   "text": "اگه کسی ما رو نگاه کنه با دی-- خودت، خودت رو با دید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 304.84,
   "end": 308.18,
   "text": "حق بین نگاه کنی الله رو می‌بینی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 308.18,
   "end": 312.64,
   "text": "پیغمبر فرمود هرکس منو ببینه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 312.64,
   "end": 315.16,
   "text": "من ارانی فقط رأى الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 315.16,
   "end": 319.62,
   "text": "قطعاً الله رو دیده. یه وجهش همینه که عرض کردم الان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 319.62,
   "end": 324.42,
   "text": "البته یه وجهش هم اینه که تمام اسماء حسنی و صفات اولیا الهی در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 324.42,
   "end": 328.96,
   "text": "پیغمبر به نحوه اتم پیاده شد لذا اون شد مظهر الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 328.96,
   "end": 334.74,
   "text": "اینم یک نکته. و بعد می‌فرماید و هو حالا اون فاطر السماوات والأرض کیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 334.74,
   "end": 337.34,
   "text": "و هو یطعم و لا یطعم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 337.34,
   "end": 343.34,
   "text": "اون کسی‌ست که اطعام می‌کنه و خودش اطعام نمیشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 343.34,
   "end": 347.28,
   "text": "یعنی در حقیقت خدایی که-- پیغمبر چگونه داره معرفی می‌کنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 347.28,
   "end": 349.38,
   "text": "الله اکبر از این معرفی کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 349.38,
   "end": 352.88,
   "text": "ما چگونه خدا رو می‌تونیم معرفی کنیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 352.88,
   "end": 360.3,
   "text": "می‌فرماید خدای من یک سفره خانه‌ای راه انداخته، یک ضیافت خانه‌ای داره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 360.3,
   "end": 363.74,
   "text": "که همه رو اطعام می‌کنه و خودش اطعام نمیشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 363.74,
   "end": 370.86,
   "text": "شما تصور کنید هر کسی در هر سطحی و در هر جزء و کلی در هر جایگاهی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 370.86,
   "end": 374.18,
   "text": "هُوَ، هُوَ او یطعمُ.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 374.18,
   "end": 379.02,
   "text": "فعل مضارعه دلالت بر استمرار داره دائما داره اطعام می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 379.02,
   "end": 382.46,
   "text": "این رو فقط نگیرید صرفاً این نان و آبی که ما می‌خوریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 382.46,
   "end": 388.68,
   "text": "البته از شؤون ولایت چون بلافاصله بعد از ولیا فاتر سماوات و الأرض",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 388.68,
   "end": 397.72,
   "text": "بعد یطعم میاره یعنی اینکه از شؤون ولایت به قول آقای قرائتی در تفسیر نورش از شؤون ولایت اطعام،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 397.72,
   "end": 403.44,
   "text": "ن-- در حقیقت برآورده کردن نیازهای تحت امرشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 403.44,
   "end": 405.46,
   "text": "زیردستشه، از شؤون ولایته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 405.46,
   "end": 407.94,
   "text": "حکومت اسلامی باید نیازهای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 407.94,
   "end": 412.28,
   "text": "مردم رو فراهم کنه. اینم آقا چندین ساله شعار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 412.28,
   "end": 417.2,
   "text": "سال رو مثلا بحث اقتصادی قرار میده، تولید قرار میده و امثالهم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 417.2,
   "end": 421.78,
   "text": "از وظایف حکومته. مثلا طرف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 421.78,
   "end": 423.94,
   "text": "از زمان گدایی می‌کرد، پیرمرد بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 423.94,
   "end": 426.22,
   "text": "مولا فرمود برید ببینید چی میخواد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 426.22,
   "end": 429.26,
   "text": "چرا آخه داره گدایی می‌کنه در حکومت ما؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 429.26,
   "end": 431.74,
   "text": "گفتن آقا این مسیحیه، مسلمون نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 431.74,
   "end": 436.82,
   "text": "فرمود دیگه بدتر. برید سراغش ببینید مشکلش چیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 436.82,
   "end": 439.94,
   "text": "بر ماست که نیازشو فراهم کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 439.94,
   "end": 445.82,
   "text": "حالا در هر حال این که می‌فرمایید یطعم فعل مضارعه در، در چی اطعام می‌کنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 445.82,
   "end": 450.16,
   "text": "نه فقط در آب و نان بلکه تمام وجود ما رو یعنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 450.16,
   "end": 453.04,
   "text": "اطعام عقل ما، روح ما، خیال ما،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 453.04,
   "end": 455.2,
   "text": "جسم ما، روح ما،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 455.2,
   "end": 461.0,
   "text": "سر ما، سرّ سر ما، حقیقت وجودی ما از رقت تا حقیقت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 461.0,
   "end": 466.56,
   "text": "از مادون تا مافوق، از فرد تا اصل همه رو خدا داره اطعام می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 466.56,
   "end": 471.66,
   "text": "اصلاً وجود ما رو داره در خصوص خود اسماء الهی آنف آن تج--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 471.66,
   "end": 475.34,
   "text": "تغذیه میشه آنف آن خدا در ما داره تجلی می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 475.34,
   "end": 479.34,
   "text": "يسأله من فی السماوات والأرض الله اکبر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 479.34,
   "end": 484.76,
   "text": "یه رساله داره مرحوم ابن عربی در این خصوص به نام رساله شعنیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 484.76,
   "end": 486.86,
   "text": "فقط در خصوص همین آیه و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 486.86,
   "end": 492.7,
   "text": "کل یوم هو فی شأن بعد از اینکه قرآن می‌فرماید همه يسأله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 492.7,
   "end": 501.68,
   "text": "دائم من فی السماوات والأرض هرچی در آسمان و زمینه يسأله گدایی می‌کنه، درخواست می‌کنه از خدا چون فقران دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 501.68,
   "end": 506.06,
   "text": "فقر ذاتی‌ان. بعد جوابش چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 506.06,
   "end": 508.9,
   "text": "کل یوم هو فی شأن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 508.9,
   "end": 512.2,
   "text": "در هر ظرف ظهوری که يوم ظرف ظهور بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 512.2,
   "end": 515.82,
   "text": "شما ظرف ظهوری هستی که اسماء الهی رو داری ظاهر می‌کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 515.82,
   "end": 519.36,
   "text": "خدا داره در شما ظهور می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 519.36,
   "end": 523.78,
   "text": "کل یوم هو هُوَ همون هُوَ یطعمُ فی شأن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 523.78,
   "end": 527.14,
   "text": "خدا داره آنف آن در من و شما تجلی می‌کنه که هستیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 527.14,
   "end": 529.6,
   "text": "اینم یه غذائه. غذای وجودی ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 529.6,
   "end": 533.28,
   "text": "غذای عقل ما یه طور، غذای قوه خیال مون یه طور،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 533.28,
   "end": 539.32,
   "text": "غذای وهممون، جسممون، روحمون همه و همه رو دائم داره خدا میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 539.32,
   "end": 541.54,
   "text": "چه خدای دیگه‌ای بهتر از این؟ کجا برم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 541.54,
   "end": 547.96,
   "text": "در خونه کی برم؟ و ادامه میدهد قل انی باز خدا تأکید می‌کنه قل بهشون بگی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 547.96,
   "end": 554.2,
   "text": "انی امرت ان اكون اول من اسلم ولا تكونن من المشرکین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 554.2,
   "end": 557.16,
   "text": "هی فرصت نیست خیلی اینجا حرف داشتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 557.16,
   "end": 561.66,
   "text": "توجه بفرمایید پیغمبر آیا اولین مسلمانه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 561.66,
   "end": 565.52,
   "text": "مگر جدشون حضرت ابراهیم نفرمودن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 565.52,
   "end": 569.52,
   "text": "انی وجهت همون آیه‌ای که قبل از شروع نماز مستحبه بخونیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 569.52,
   "end": 575.22,
   "text": "انی وجهت وجهی للذي فطر السماوات والأرض حنيفا مسلما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 575.22,
   "end": 577.4,
   "text": "و ما انا من المشركين.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 577.4,
   "end": 579.22,
   "text": "پس همشون مسلم بودن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 579.22,
   "end": 583.7,
   "text": "اصلاً عند ان الدين عندالله الاسلام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 583.7,
   "end": 585.64,
   "text": "پیش همه اصلاً دین اسلامه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 585.64,
   "end": 588.38,
   "text": "بخشیشو اونا آوردن کاملشو پیغمبر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 588.38,
   "end": 591.56,
   "text": "چرا اینجا پیغمبر می‌فرماید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 591.56,
   "end": 595.14,
   "text": "بهشون بگو که اول من اسلم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 595.14,
   "end": 596.86,
   "text": "ان اكون اول من اسلم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 596.86,
   "end": 600.38,
   "text": "من امر شدم که اولین مسلمان باشم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 600.38,
   "end": 608.12,
   "text": "اجازه بدید در انتهای بحث که البته خیلی حرف‌هامون باشه ما تبرکا حرف می‌زنیم حاق مطلب رو که نمیشه گفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 608.12,
   "end": 611.48,
   "text": "نظر ابن عربی رو براتون بخونم و شما رو به خدا بسپارم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 611.48,
   "end": 614.94,
   "text": "مرحوم ابن عربی حضرت محی الدین شیخ اکبر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 614.94,
   "end": 617.74,
   "text": "در این خصوص می‌فرماید در عین اینکه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 617.74,
   "end": 622.22,
   "text": "زمان رسالت پیامبر ما از سایر پیامبران متأخر است،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 622.22,
   "end": 624.26,
   "text": "از همشون دیرتره دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 624.26,
   "end": 630.92,
   "text": "خاتم الانبیاست درسته؟ اما خدای سبحان به این پیامبر می‌فرماید اول من اسلم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 630.92,
   "end": 636.82,
   "text": "در واقع رتبه وجودی پیامبر اسلام را در این عالم اعلام می‌کند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 636.82,
   "end": 646.32,
   "text": "قدم وجودی پیامبر ما در عالم معنا یعنی اولین وجودی که خضوع اطعام در مقابل خدای سبحان دارد پیامبر اسلام است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 646.32,
   "end": 651.4,
   "text": "عالم یه همچین پیغمبری رو و یه همچین خدایی رو بفروشه بره سراغ چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 651.4,
   "end": 654.0,
   "text": "وقتی توجه به این آیه می‌کنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 654.0,
   "end": 657.08,
   "text": "سرتاسر نظام هستی رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 657.08,
   "end": 661.06,
   "text": "از جزء و کل، از مادون و مافوق رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 661.06,
   "end": 669.98,
   "text": "یکپارچه فقر الی الله می‌بینی و همه کاره این عالم و نظام هستی رو که به احسن وجه داره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 669.98,
   "end": 673.14,
   "text": "صونش رو تدبیر می‌کنه حضرت حق می‌بینی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 673.14,
   "end": 675.32,
   "text": "یعنی شما دیگه نگاهت میشه الهی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 675.32,
   "end": 677.22,
