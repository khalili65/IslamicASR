   "title": "## میلاد امام سجاد و منبری اهل بهشت",
   "start": 164.34,
   "end": 214.22
  },
  {
   "index": 1,
   "title": "## هندسهٔ توحید؛ بک عرفتک",
   "start": 214.22,
   "end": 481.63
  },
  {
   "index": 2,
   "title": "## دعای عرفه و عبدِ فقرمحض",
   "start": 481.63,
   "end": 740.91
  },
  {
   "index": 3,
   "title": "## خلاصه و شرط همراهی با سیدالشهدا",
   "start": 740.91,
   "end": 941.31
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.06,
   "end": 5.64,
   "text": "[سخنگوی 1] [سخنگوی 2]",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 5.64,
   "end": 9.14,
   "text": "[سخنگوی 1] بسم الله الرحمن الرحیم و به این استعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 9.14,
   "end": 12.98,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 12.98,
   "end": 16.8,
   "text": "آیه. سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 16.8,
   "end": 20.94,
   "text": "تبریک عرض می‌کنم ایام بسیار نورانی و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 20.94,
   "end": 24.16,
   "text": "پرسروری است. انشاالله از فیوضات این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 24.16,
   "end": 26.48,
   "text": "ایام به نفس کینونت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 26.48,
   "end": 30.68,
   "text": "زمان و مکان بهره برده باشیم و بیشتر ببریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 30.68,
   "end": 34.5,
   "text": "ماه رجب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 34.5,
   "end": 38.14,
   "text": "فرمودن که ماه تخلیه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 38.14,
   "end": 42.9,
   "text": "لذا بهترین ذکر در ماه رجب استغفار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 42.9,
   "end": 47.9,
   "text": "ماه شعبان رو فرمودن ماه تخلیه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 47.9,
   "end": 51.26,
   "text": "خله پوشی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 51.26,
   "end": 53.86,
   "text": "بهترین-- لذا بهترین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 53.86,
   "end": 57.1,
   "text": "کار در این ماه ذکر صلوات است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 57.1,
   "end": 62.4,
   "text": "و ماه مبارک رمضان هم که ماه تجلی است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 62.4,
   "end": 64.56,
   "text": "جلا دادن یا تجلی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 64.56,
   "end": 67.82,
   "text": "تجلی حضرت حق در بندگانش که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 67.82,
   "end": 71.38,
   "text": "بهترین کار در ماه مبارک رمضان میشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 71.38,
   "end": 75.72,
   "text": "قرآن خوندن چون تجلی حضرت حق در قرآنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 75.72,
   "end": 78.0,
   "text": "اگر کسی-- چون بحث ما توحید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 78.0,
   "end": 81.76,
   "text": "افعالی بود صرف کلاً مبحث توحید بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 81.76,
   "end": 85.68,
   "text": "توحید رو کسی بخواد خوب پیدا کنه باید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 85.68,
   "end": 89.82,
   "text": "تجلیات حضرت حق رو در قرآن ببینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 89.82,
   "end": 96.02,
   "text": "پیرامون آیاتی که از تجلیات حضرت حق سخن گفته بگردین پیدا کنین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 96.02,
   "end": 98.84,
   "text": "اتفاقاً ما این بحث کشکول نورمون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 98.84,
   "end": 101.78,
   "text": "که ظهرا اینجا با هم داریم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 101.78,
   "end": 107.86,
   "text": "اگر چنانچه خاطر شریفتون باشه از ابتدا با همین بحث تجلیات الهیه شروع شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 107.86,
   "end": 115.74,
   "text": "چند جلسه‌ای پیرامون نوع تجلی حضرت حق و ظهور خدا صحبت کردیم و کشیده شد به مباحث توحیدی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 115.74,
   "end": 119.78,
   "text": "و چه شیرین، چه خوش که ما می‌شنویم از بعضی دوستان که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 119.78,
   "end": 125.32,
   "text": "انقدر توحیدشون این نشان دهنده اینه که نبض توحیدشون خوب می‌زنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 125.32,
   "end": 128.5,
   "text": "انشاالله بهتر بزنه که گفتن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 128.5,
   "end": 130.64,
   "text": "ما تو ساختمان شیشه‌ای بودیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 130.64,
   "end": 134.22,
   "text": "اسفاری که زد مجبور شدیم بیایم اینجا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 134.22,
   "end": 136.56,
   "text": "اینجا که اومدیم جهنم و ضرر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 136.56,
   "end": 138.8,
   "text": "اومدیم تو نماز شما شرکت کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 138.8,
   "end": 141.14,
   "text": "افتادیم تو این مباحث توحیدی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 141.14,
   "end": 143.48,
   "text": "فهمیدیم که اصلاً باید اونجا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 143.48,
   "end": 147.7,
   "text": "داغون میشد که ما بیایم بیوفتیم تو این جلسه‌ی توحیدی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 147.7,
   "end": 151.18,
   "text": "این، این فکر هم خودش فکر توحیدیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 151.18,
   "end": 156.54,
   "text": "شما تشنه باشی به قول حضرت استاد در و دیوار عالم به شما دستور میده، به شما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 156.54,
   "end": 162.18,
   "text": "تعلیم میده، به شما حکمت می‌آموزه، با شما سخن میگه، معلمت میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 162.18,
   "end": 169.16,
   "text": "آره عزیزم. چون روز میلاد آقا زین العابدین صلوات الله علیه هست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 169.16,
   "end": 171.82,
   "text": "یه سنجاک می‌کنیم به این موضوع،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 171.82,
   "end": 174.64,
   "text": "به میلاد حضرت در امروز.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 174.64,
   "end": 176.34,
   "text": "نمی‌دونم خبر دارید یا نه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 176.34,
   "end": 180.4,
   "text": "نظرات بزرگانی مثل عارف عربی و امثالهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 180.4,
   "end": 185.28,
   "text": "این هست که در بهشت منبری اهل بهشت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 185.28,
   "end": 191.54,
   "text": "در اون اعلی مرتبه که اولیا خود-- احس اولیا خود دور هم جمع میشن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 191.54,
   "end": 194.42,
   "text": "بالاخره یکی باید اونجا منبر بره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 194.42,
   "end": 196.86,
   "text": "اونجا هم منبر هست. حدیث منبر رو شنیدید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 196.86,
   "end": 201.58,
   "text": "دیگه منبری هست که در صحنه محشر پیغمبر در صدر قرار می‌گیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 201.58,
   "end": 203.96,
   "text": "امیرالمؤمنین پایین همینطور تا امام عصر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 203.96,
   "end": 207.04,
   "text": "بعد انبیاء خلف، انبیاء",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 207.04,
   "end": 209.86,
   "text": "عظام همچنین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 209.86,
   "end": 214.22,
   "text": "اون منبر در بهشت مستقر میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 214.22,
   "end": 218.46,
   "text": "به نظر شما منبری اهل بهشت کیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 218.46,
   "end": 225.3,
   "text": "صاحب امروزه. منبری اهل بهشت آقا زین العابدینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 225.3,
   "end": 229.24,
   "text": "چه عجیب که بین این همه خطیب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 229.24,
   "end": 232.38,
   "text": "در میان آل الله آقایی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 232.38,
   "end": 236.04,
   "text": "بیشتر کارش رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 236.04,
   "end": 237.6,
   "text": "دعا متمرکز شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 237.6,
   "end": 243.82,
   "text": "وضعیت حضرت به گونه‌ای شد که معارف حقه رو با دعا انتقال داد به شه منبری اونجا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 243.82,
   "end": 246.94,
   "text": "چرا؟ اتفاقاً در این هم رمزی هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 246.94,
   "end": 249.58,
   "text": "خدا رحمت کنه حضرت علامه صاحب-",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 249.58,
   "end": 253.36,
   "text": "علامه حسن زاده علیه رحمة الله گوان رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 253.36,
   "end": 257.26,
   "text": "فرمودن که روایات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 257.26,
   "end": 260.9,
   "text": "کل الناس علی قدر عقوله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 260.9,
   "end": 266.94,
   "text": "اونا دستور داشتن که به ما هم دستور دادن که به قدر عقل مردم سخن بگیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 266.94,
   "end": 270.04,
   "text": "روایات ریخته شده در یک سری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 270.04,
   "end": 271.96,
   "text": "الفاظ خاکی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 271.96,
   "end": 276.74,
   "text": "درسته نورانیت داره و به منزله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 276.74,
   "end": 280.08,
   "text": "میشه گفت بدنه نسبت به روح قرآن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 280.08,
   "end": 283.56,
   "text": "روایات. اما باز الفاظ خاکی‌ان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 283.56,
   "end": 286.22,
   "text": "به نسبت عقل مردمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 286.22,
   "end": 289.32,
   "text": "اما حضرت استاد فرمودن که دعا اینطوری نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 289.32,
   "end": 293.24,
   "text": "مقامات انشایی آل الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 293.24,
   "end": 297.96,
   "text": "بهترین و لطیف‌ترین و ظریف‌ترین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 297.96,
   "end": 300.64,
   "text": "حقایق و معارف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 300.64,
   "end": 304.04,
   "text": "حقه ارشی و فوق ارشی در دعاها ریخته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 304.04,
   "end": 310.16,
   "text": "برید ببینید چه خبره. خب باید هم یعنی چه کسی که صاحب بیشترین دعاهاست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 310.16,
   "end": 312.5,
   "text": "بشه منبری اهل بهشت که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 312.5,
   "end": 315.86,
   "text": "سخن گفته در خلوتخانه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 315.86,
   "end": 321.56,
   "text": "نهان وجود خودش با حضرت حق عالی‌ترین مضامین رو پیاده کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 321.56,
   "end": 324.92,
   "text": "ما غافلیم. در هر موردی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 324.92,
   "end": 328.64,
   "text": "یعنی شما هر حالتی برات پیش بیاد، انسان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 328.64,
   "end": 331.06,
   "text": "همین که قلب داریم، قلب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 331.06,
   "end": 332.88,
   "text": "تقلب داره، منقلبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 332.88,
   "end": 336.52,
   "text": "از حالی به حال دیگه دائماً در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 336.52,
   "end": 340.66,
   "text": "تغییر و تبدله. یا مقلب القلوب والابصار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 340.66,
   "end": 343.66,
   "text": "این قلب چون در حال تقلبه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 343.66,
   "end": 348.74,
   "text": "و حالش عوض میشه هر حالی هر وقتی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 348.74,
   "end": 351.92,
   "text": "حتی در مفاتیح هر ساعتی یه دعا داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 351.92,
   "end": 355.98,
   "text": "حالا ما نمی‌تونیم هر حالتی در روز به ما دست داد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 355.98,
   "end": 358.22,
   "text": "پونزده تا مناجات حضرت داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 358.22,
   "end": 362.3,
   "text": "خدا رحمت کنه انواع شما رو اجدادتون و پدر مادرهاتون رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 362.3,
   "end": 365.09,
   "text": "مادرمون ما رو با این آشنا کرد روحش شاد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 365.09,
   "end": 368.97,
   "text": "بچه بودم. خمسة عشر امام سجاد در مفاتیح هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 368.97,
   "end": 370.75,
   "text": "پونزده تا مناجات کوتاهه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 370.75,
   "end": 373.35,
   "text": "نیم صفحه‌ای، یه صفحه‌ای، نهایت یک صفحه و نیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 373.35,
   "end": 375.47,
   "text": "خیلی شیرین، خیلی عالی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 375.47,
   "end": 380.87,
   "text": "مناجات التائبین، مناجات الخائفین، مناجات الراغبین، مناجات المحبین، منا--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 380.87,
   "end": 384.27,
   "text": "همینطور در هر حالتی یه مناجات داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 384.27,
   "end": 388.39,
   "text": "بعد شما وقتی مناجات رو دقت می‌کنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 388.39,
   "end": 392.51,
   "text": "می‌بینی چه موارد اِ-- عالی رو حضرت پیاده کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 392.51,
   "end": 395.89,
   "text": "شما این‌ها رو رد پاشون رو خیلی‌هاشو تو روایات نمی‌بینی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 395.89,
   "end": 398.75,
   "text": "اگرم باشه ما نمی‌فهمیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 398.75,
   "end": 406.51,
   "text": "به نظر شما برای رسیدن به توحید بحث ما توحید بود و ابتدا به صورت توحید افعالی داریم سخن می‌گیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 406.51,
   "end": 410.99,
   "text": "ما باید از حضرت حق شروع کنیم آثارش رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 410.99,
   "end": 417.47,
   "text": "چون، اه، آثار هر کسی نمودار دارایی اونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 417.47,
   "end": 419.91,
   "text": "آثار حضرت حق میشه آیات الهی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 419.91,
   "end": 422.69,
   "text": "آیه الله یکی شما هستی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 422.69,
   "end": 429.29,
   "text": "آیات الهی \"وفی الأرض آيات للمؤمنین و فی أنفسكم أفلا تبصرون، في خلق السماوات والأرض",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 429.29,
   "end": 432.73,
   "text": "واختلاف الليل والنهار لآيات لأولي الألباب\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 432.73,
   "end": 436.93,
   "text": "لأولي الألباب تا el mashallah همینطور آیات، آیات، آیات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 436.93,
   "end": 444.35,
   "text": "آیات قرآن که پیرامون خود آیه های خداست بررسی کنید چقدر ماشاءالله آیه، آیه، آیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 444.35,
   "end": 449.35,
   "text": "نشانه‌های حضرت حقه. \"أفلا ينظرون إلى الإبل كيف خلقت\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 449.35,
   "end": 456.69,
   "text": "خب آیا بالاخره ما می‌خوایم به توحید برسیم از حضرت حق شروع کنیم بیاییم به آثار؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 456.69,
   "end": 460.65,
   "text": "یا از آثار و آیات و مجالی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 460.65,
   "end": 464.69,
   "text": "و شؤون حضرت حق شروع کنیم به خدا برسیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 464.69,
   "end": 469.77,
   "text": "سیاق ظاهری قرآن داره میگه به آیات نزا-- نگاه کن خدا رو پیدا کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 469.77,
   "end": 473.13,
   "text": "اگه اینه چرا حضرت امام سجاد صلوات الله علیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 473.13,
   "end": 475.47,
   "text": "در دعای ابو حمزه میگه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 475.47,
   "end": 478.03,
   "text": "به حضرت حق عرض می‌کنه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 478.03,
   "end": 481.63,
   "text": "\"بک عرفتک\" من تو رو به خودت شناختم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 481.63,
   "end": 484.41,
   "text": "\"و أنت دللتنی علیک\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 484.41,
   "end": 487.07,
   "text": "تو منو دلالت کردی بر خودت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 487.07,
   "end": 490.13,
   "text": "من ن-- از آیات به تو نرسیدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 490.13,
   "end": 492.71,
   "text": "من به تو رسیدم و از تو به آیات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 492.71,
   "end": 494.99,
   "text": "از پیغمبر عزیز عالم پرسیدم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 494.99,
   "end": 499.05,
   "text": "آقا شما از آیات خدا رو پیدا کردی یا از خدا به آیات رسیدی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 499.05,
   "end": 503.27,
   "text": "فرمود نخیر، من خدا رو دیدم و آیاتش رو شناختم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 503.27,
   "end": 508.07,
   "text": "هندسه اینطوریه. یعنی هندسه اصلی توحید حواسمون باشه ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 508.07,
   "end": 509.83,
   "text": "اینچنینه. اما چه کنیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 509.83,
   "end": 513.15,
   "text": "ما چون نو-نفس ضعیف هستیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 513.15,
   "end": 516.69,
   "text": "نفوس ضعیف که کامل نیست اونا نفس مکتفی‌ان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 516.69,
   "end": 520.07,
   "text": "به کفایت رسیدن و هرچی اراده کنن خدا بهشون میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 520.07,
   "end": 523.45,
   "text": "ما مستکفی هستیم، در حال کفایتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 523.45,
   "end": 525.23,
   "text": "نیاز داریم که چی کار کنیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 525.23,
   "end": 529.95,
   "text": "از آیات برسیم. حالا بهترین آیه‌ای که ما رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 529.95,
   "end": 533.27,
   "text": "دلالت می‌کنه بر توحید به حضرت حق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 533.27,
   "end": 537.15,
   "text": "چه آیه‌ایه؟ قطعاً آیه الله العظمى‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 537.15,
   "end": 542.03,
   "text": "آیه الله العظمى کسی نیست-- حالا ما ت-تشریفاً،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 542.03,
   "end": 545.31,
   "text": "تخصیصاً، چه عرض کنم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 545.31,
   "end": 547.73,
   "text": "به جهت احترام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 547.73,
   "end": 550.99,
   "text": "به مراجع تقلید میگیم آیات عظام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 550.99,
   "end": 554.25,
   "text": "آیه الله العظمى. در صورت که این غلطه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 554.25,
   "end": 559.61,
   "text": "این اشتباه است. آیه الله العظمى روایت داریم امیر المؤمنینن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 559.61,
   "end": 562.21,
   "text": "آیات عظام آل الله‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 562.21,
   "end": 565.77,
   "text": "حالا این اِ-- یه غلط مصطلحه دیگه چه عرض کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 565.77,
   "end": 570.51,
   "text": "ت-احتراماً میگیم. باید از طریق انسان کامل حرکت کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 570.51,
   "end": 575.39,
   "text": "ببینید سید الشهدا تو دعای عرفه، کربلایی‌ها، سینه زن‌ها، هیئتی‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 575.39,
   "end": 577.09,
   "text": "چرا حسین، حسین، حسین میگیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 577.09,
   "end": 579.39,
   "text": "اما دعای عرفه رو توجه نکرد-- نداریم که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 579.39,
   "end": 581.59,
   "text": "ابو عبدالله به خدا عرض می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 581.59,
   "end": 585.71,
   "text": "مگه امام حسین ما نیست؟ بسم الله دنبال سرش راه بیفتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 585.71,
   "end": 589.15,
   "text": "می‌فرماید \"الهی ترددی فی الآثار\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 589.15,
   "end": 595.87,
   "text": "رفت و آمد، تردید. تردید من در آثار یعنی در آیات تو \"یوجب بعد المزار\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 595.87,
   "end": 599.55,
   "text": "باعث می‌شه من از زیارت تو دور بشم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 599.55,
   "end": 605.35,
   "text": "اگه کسی درست راه عرفان و توحید رو، توحید افعالی، صفاتی، ذاتی رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 605.35,
   "end": 607.29,
   "text": "درست پیش بره این درستشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 607.29,
   "end": 610.35,
   "text": "این هندسه درستشه. اما ما چه کنیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 610.35,
   "end": 613.77,
   "text": "چون نفوس ضعیف هستیم باید با امام حرکت کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 613.77,
   "end": 616.23,
   "text": "با امام حرکت کنیم. تو دعاها اینا خوابیده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 616.23,
   "end": 617.79,
   "text": "ببینید من چند تا نمونه‌شو گفتم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 617.79,
   "end": 620.93,
   "text": "از ابو حمزه، از دعای عرفه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 620.93,
   "end": 627.17,
   "text": "وقتی پشت سر اونا حرکت کنیم می‌بینیم که اون‌ها آینه تمام نمای حضرت حقن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 627.17,
   "end": 631.69,
   "text": "چون عبداً، عبید حضرت حقن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 631.69,
   "end": 635.05,
   "text": "بهترین حرفی که درباره‌شون می‌زنیم می‌تونیم بگیم اینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 635.05,
   "end": 639.51,
   "text": "بگیم اون‌ها عباد الرحمنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 639.51,
   "end": 643.13,
   "text": "عبدن و اشهد ان محمدا عبده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 643.13,
   "end": 646.95,
   "text": "و رسوله اللهم صل على محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 646.95,
   "end": 650.01,
   "text": "اصلاً عبد از کجا شناخته می‌شه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 650.01,
   "end": 652.61,
   "text": "من بحثو جمع کنم خسته شدید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 652.61,
   "end": 654.49,
   "text": "عبد از کجا شناخته می‌شه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 654.49,
   "end": 657.63,
   "text": "از اینکه هیچ اختیاری از خودش نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 657.63,
   "end": 660.67,
   "text": "میگه من عبد و عبید فلانی‌ام، غلام فلانی‌ام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 660.67,
   "end": 663.33,
   "text": "هرچی-- شما اسمت چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 663.33,
   "end": 665.09,
   "text": "هرچی شما منو بخونی. چی می‌خوری؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 665.09,
   "end": 666.99,
   "text": "هرچی شما بدی بخورم. چی می‌پوشی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 666.99,
   "end": 669.89,
   "text": "هرچی شما بپوشونی. به این میگن عبد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 669.89,
   "end": 672.11,
   "text": "اصلاً حرفی برای گفتن نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 672.11,
   "end": 675.43,
   "text": "یکپارچه همه وجودش فقر محض الی الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 675.43,
   "end": 677.83,
   "text": "لذا پیغمبر فرمود الفقر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 677.83,
   "end": 682.13,
   "text": "فخری. من فقیرترین آدم‌ها به حضرت حقم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 682.13,
   "end": 683.85,
   "text": "فقر مالی و مادی نه ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 683.85,
   "end": 688.17,
   "text": "کاهنات که می‌داد گنجینه‌های آسمان‌ها و زمین دست او بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 688.17,
   "end": 692.01,
   "text": "نه فقر ذاتی، فقر صفاتی، فقر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 692.01,
   "end": 698.89,
   "text": "افعالی. همه و همه افعالش رو مستغرق و مستهلک و فانی در افعال حضرت حق می‌بینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 698.89,
   "end": 701.01,
   "text": "لا حول و لا قوه الا بالله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 701.01,
   "end": 708.59,
   "text": "توحید افعالی. صفات و اسمايش رو مستغرق و مستهلک و فانی در اسماء و صفات خدا می‌بینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 708.59,
   "end": 715.61,
   "text": "لا اله الا الله. ذات وجود خودشو مستهلک و مستغرق و فانی در ذات الهی می‌بینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 715.61,
   "end": 720.47,
   "text": "لاهو الا هو. یا من لاهو الا هو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 720.47,
   "end": 723.39,
   "text": "توجه کردین؟ هیچی از خودش نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 723.39,
   "end": 728.79,
   "text": "خب با یه همچین انسان جامع الاطراف، تا آینه تمام نمایی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 728.79,
   "end": 732.41,
   "text": "رضا فرمود من رأنی فقد رأى الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 732.41,
   "end": 736.99,
   "text": "هرکی منو ببینه الله رو دیده حرکت کنی تو به توحید می‌رسی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 736.99,
   "end": 740.91,
   "text": "می‌رسوننت یعنی اونا. خب بالاخره چه کنیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 740.91,
   "end": 748.55,
   "text": "خلاصه بحث اینکه ما مجبوریم چون نفوس ضعیفه هستیم برای رسیدن به توحید ابتدا از آیات شروع کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 748.55,
   "end": 753.15,
   "text": "اما حواسمون باشه به اون اوج، به اون معراج، به اون مدارج عالیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 753.15,
   "end": 756.61,
   "text": "که امام حسین که جلو دار ماست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 756.61,
   "end": 761.73,
   "text": "فرمود که الهی ترددی في الآفاق یوجب وعد المزار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 761.73,
   "end": 764.59,
   "text": "پس همراه امام حسین که باشی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 764.59,
   "end": 767.35,
   "text": "تو رو می‌بره تا توحید افعالی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 767.35,
   "end": 770.53,
   "text": "تا اوج توحید صفاتی، تا اوج توحید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 770.53,
   "end": 773.87,
   "text": "ذاتی. اگه کسی همراهش بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 773.87,
   "end": 777.59,
   "text": "من كان با-- می‌خواست حرکت کنه جمله آخرم باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 777.59,
   "end": 783.35,
   "text": "حضرت ابا عبدالله می‌خواست بره قابل توجه سینه زنا، گریه کنا، عاشقا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 783.35,
   "end": 787.31,
   "text": "داشت می‌رفت کیا می‌تونن همراه من باشن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 787.31,
   "end": 788.95,
   "text": "نسخه‌شو پیچیدن همونجا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 788.95,
   "end": 791.77,
   "text": "هرکسی نمی‌تونه با امام حسین همراه بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 791.77,
   "end": 796.47,
   "text": "من فکر می‌کنم معذرت می‌خوام درسته بار عام داره اما هرکسی نمی‌تونه مستقیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 796.47,
   "end": 800.31,
   "text": "مستقم بمونه همراه راه مستقیم حضرت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 800.31,
   "end": 802.41,
   "text": "استقامت داشته باشه. وسط راه می‌برن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 214,
   "start": 802.41,
   "end": 804.91,
   "text": "هزار نفرم مدینه همراه حضرت بودن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 215,
   "start": 804.91,
   "end": 808.11,
   "text": "هفتاد و دو تا موندن. حضرت چی فرمود؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 216,
   "start": 808.11,
   "end": 811.09,
   "text": "داشت می‌رفت خطبه‌ای که خوند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 217,
   "start": 811.09,
   "end": 816.15,
   "text": "فرمود که من کان باذلا فی نا محجته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 218,
   "start": 816.15,
   "end": 821.37,
   "text": "هرکس آماده‌ست محجه اون آخرین قطره خون داخل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 219,
   "start": 821.37,
   "end": 825.71,
   "text": "شش یا قلب گوسفندو میگن که سرشو می‌برن یه قطره خون مونده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 220,
   "start": 825.71,
   "end": 834.33,
   "text": "به اون میگن محجه عرب. میگه اون آخرین قطره خونشو اگر باذلن بخواد بذل کنه فی نا اونم نه فی سبیلنا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 221,
   "start": 834.33,
   "end": 837.69,
   "text": "همه اجابه‌ها برداشته بشه. در راه ما ده شب ماه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 222,
   "start": 837.69,
   "end": 840.49,
   "text": "محرم در خصوص همین یه جمله حرف زدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 223,
   "start": 840.49,
   "end": 843.93,
   "text": "بسیار درون مایه داره. دیگه چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 224,
   "start": 843.93,
   "end": 846.99,
   "text": "و موطن علی نفسه علی لقاء",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 225,
   "start": 846.99,
   "end": 850.17,
   "text": "و موطن نفسه علی لقاء.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 226,
   "start": 850.17,
   "end": 852.25,
   "text": "یا یه جا فرموده لقاء الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 227,
   "start": 852.25,
   "end": 855.87,
   "text": "هر-- اگر قصد توطن کرده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 228,
   "start": 855.87,
   "end": 862.51,
   "text": "برای اینکه ملاقات خدا رو داشته باشه تو راه ما البته تو این عبارتی که گفتم تو چند تا نسخه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 229,
   "start": 862.51,
   "end": 866.97,
   "text": "متغیر اومده. خلاصه‌ش اینه که هرکس می‌خواد بره به ملاقات خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 230,
   "start": 866.97,
   "end": 871.73,
   "text": "و قصد توطن کرده، نیومده مسافر باشه، اومده که همراه ما باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 231,
   "start": 871.73,
   "end": 876.49,
   "text": "فلیرحل معنا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 232,
   "start": 876.49,
   "end": 878.39,
   "text": "فلیسافر معنا نه ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 233,
   "start": 878.39,
   "end": 880.47,
   "text": "مسافر میره که برگرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 234,
   "start": 880.47,
   "end": 883.69,
   "text": "فلیرحل راحل و ان الراحل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 235,
   "start": 883.69,
   "end": 886.51,
   "text": "قریب المسافة. امام سجاد می‌فرما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 236,
   "start": 886.51,
   "end": 893.67,
   "text": "راحل راهش نزدیکه. هرکس می‌خواد با من بیاد و دیگه هم برنگرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 237,
   "start": 893.67,
   "end": 895.99,
   "text": "بسم الله فلیرحل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 238,
   "start": 895.99,
   "end": 899.47,
   "text": "معنا، معنا همراه من و حسین باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 239,
   "start": 899.47,
   "end": 902.15,
   "text": "من اونو به اوج توحید می‌رسونمش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 240,
   "start": 902.15,
   "end": 906.15,
   "text": "لذا گفتیم ماه رمضان میشه تجلی رو-- تجلیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 241,
   "start": 906.15,
   "end": 910.79,
   "text": "حضرت ابا عبدالله لحظه آخر دو انگشت مبارکش رو باز کرد از بین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 242,
   "start": 910.79,
   "end": 917.57,
   "text": "انگشتای مبارک شهدا تجلیات سید الشهدا رو دیدن و اونطوری جان دادن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 243,
   "start": 917.57,
   "end": 920.17,
   "text": "سبقت گرفتن. تجلی، تجلی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 244,
   "start": 920.17,
   "end": 921.79,
   "text": "ماه رمضان باید بهش برسیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 245,
   "start": 921.79,
   "end": 924.11,
   "text": "سرش در یکی از سوره های قرآنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 246,
   "start": 924.11,
   "end": 926.39,
   "text": "انشاالله به وقتش بهتون میگم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 247,
   "start": 926.39,
   "end": 931.81,
   "text": "امروز خیلی حرف زدیم. اللهم بارک لمولانا سافل الزمان.",
   "kind": "speech",
