 },
 "chapters": [
  {
   "index": 0,
   "title": "بسم الله الرحمن الرحیم و به نستعین. درود بر داعیِ خدا و ربّانیِ آیاتش.",
   "start": 1.4,
   "end": 166.76
  },
  {
   "index": 1,
   "title": "## سرِّ وجودِ پیامبر؛ فاطمه",
   "start": 166.76,
   "end": 304.24
  },
  {
   "index": 2,
   "title": "## مادرِ کائنات",
   "start": 304.24,
   "end": 414.31
  },
  {
   "index": 3,
   "title": "## نورِ حسنی در زجاجهٔ فاطمی",
   "start": 414.31,
   "end": 510.69
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 1.4,
   "end": 4.48,
   "text": "بسم الله الرحمن الرحیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 4.48,
   "end": 9.88,
   "text": "و بهین استعین. السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 9.88,
   "end": 14.62,
   "text": "آياته. سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 14.62,
   "end": 18.02,
   "text": "در خصوص مقام محمود سخن می‌گفتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 18.02,
   "end": 21.3,
   "text": "این ور سال دیگه این آخرین جلسه‌مون هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 21.3,
   "end": 24.86,
   "text": "ان شا الله که عاقبتمون به خیر بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 24.86,
   "end": 29.96,
   "text": "خدا رحمت کنه عارف عربی رو معروف به شیخ اکبر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 29.96,
   "end": 33.48,
   "text": "که واقعا اگر معارفی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 33.48,
   "end": 35.54,
   "text": "به عنایت صبوحی حضرت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 35.54,
   "end": 39.06,
   "text": "حق به قلب پاک ایشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 39.06,
   "end": 44.24,
   "text": "ریخته شد، اگر این اتفاق نمی‌افتاد و به دست ما نمی‌رسید،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 44.24,
   "end": 46.52,
   "text": "چقدر ما از باطن قرآن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 46.52,
   "end": 48.7,
   "text": "که خطاب محمدی‌ست دور بودیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 48.7,
   "end": 56.56,
   "text": "خود پی-- علامه رحمة الله عليه و رضوان فرمودند که به جانم سوگند اگر کسی این کتاب‌ها رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 56.56,
   "end": 60.72,
   "text": "نخونه به باطن قرآن پی نبرده و نمی‌بره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 60.72,
   "end": 63.06,
   "text": "یکیش کتاب‌های",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 63.06,
   "end": 65.44,
   "text": "خصوص و فتوحات ابن عربی بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 65.44,
   "end": 68.12,
   "text": "روحشون شاد. عارف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 68.12,
   "end": 74.04,
   "text": "قرن هفتم بودند. ایشون یه جمله‌ای دارن در خصوص مقام محمود که البته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 74.04,
   "end": 79.46,
   "text": "مثل اون روایت که از مولامون دیروز عرض کردیم برگرفته از فرمایشات آل الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 79.46,
   "end": 90.2,
   "text": "از خودشون که نمیگن. ایشون می‌فرمایند در روز قیامت تمام خصلت‌های پسندیده از آن پیامبر است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 90.2,
   "end": 93.92,
   "text": "و این همان مقام محمود است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 93.92,
   "end": 98.96,
   "text": "در واقع محمود رو گرفته از اینکه تمام خصلت‌ها جمع در وجود ایشون،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 98.96,
   "end": 101.54,
   "text": "همه‌ی خصلت‌های پسندیده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 101.54,
   "end": 106.06,
   "text": "که در قرآن وعده‌اش به پیامبر داده شده است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 106.06,
   "end": 109.54,
   "text": "این مقام محمود است و این مقام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 109.54,
   "end": 112.48,
   "text": "مورد تحسین همگان است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 112.48,
   "end": 115.46,
   "text": "و بازگشت تمام ثناها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 115.46,
   "end": 119.22,
   "text": "و ستایش‌ها به آن است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 119.22,
   "end": 122.7,
   "text": "همون که دیروز عرض کردیم مولا هم همین رو فرمود دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 122.7,
   "end": 127.1,
   "text": "مقام حمد. بازگشت همه‌ی حمدها به--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 127.1,
   "end": 131.92,
   "text": "رسول خدا یک حمدی انجام میده و جایگاه حمد مشخص میشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 131.92,
   "end": 135.38,
   "text": "و همه در پی‌ش بعد تازه می‌فهمن فیض از کجا رسیده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 135.38,
   "end": 140.5,
   "text": "پس اون میشه محل همه ثناها و حمدها،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 140.5,
   "end": 143.28,
   "text": "ستایش‌ها همه به پیغمبر برمی‌گرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 143.28,
   "end": 146.2,
   "text": "چون اونو ورداری برزخ جامع رو ورداشتی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 146.2,
   "end": 149.36,
   "text": "رابطه حق با خلق قطع میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 149.36,
   "end": 156.68,
   "text": "اصلاً دیگه امکانی نیست. لذا فرمود لولاك لما خلقت الأفلاك.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 156.68,
   "end": 158.98,
   "text": "حالا اون سری که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 158.98,
   "end": 163.9,
   "text": "در وجود پیغمبر عزیز عالمه که خیلی به درد شب قدرتون می‌خوره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 163.9,
   "end": 166.76,
   "text": "و اگه این مقام محمود رو داره و اینجا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 166.76,
   "end": 174.04,
   "text": "شیخ اکبر می‌فرمود مقام محمود مقامی‌ست که تمام مقامات به آن باز می‌گردد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 174.04,
   "end": 177.32,
   "text": "این انتهای جمله شیخ اکبر بود الان عرض کردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 177.32,
   "end": 181.96,
   "text": "تمام مقامات به او باز می‌گردد یعنی مقام کل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 181.96,
   "end": 187.62,
   "text": "حتی امیرالمؤمنین علیه‌الصلاة والسلام هم خودش رو چی خطاب کرد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 187.62,
   "end": 193.3,
   "text": "أنا عبد من عبید محمد صلی الله عليه وآله وسلم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 193.3,
   "end": 199.34,
   "text": "خیلی عجیبه. ما پیغمبر رو نشناختیم و نخواهیم شناخت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 199.34,
   "end": 206.72,
   "text": "لذا حالا اون سری که در وجود ایشونه و ما رو به پیغمبر نزدیک می‌کنه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 206.72,
   "end": 212.32,
   "text": "به این مقام نزدیک می‌کنه و شب‌های قدر ما رو آسون می‌کنه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 212.32,
   "end": 214.58,
   "text": "اون کیه؟ همون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 214.58,
   "end": 221.04,
   "text": "ودیعتی‌ست که امانت الهی به پیغمبر بود و پیغمبر اون امانت رو به امیرالمؤمنین بخشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 221.04,
   "end": 226.2,
   "text": "حضرت صدیقه شهیده صلوات الله علیها که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 226.2,
   "end": 231.9,
   "text": "ما وقتی می‌بینیم روایات رو می‌بینیم عزیزتر از ایشون پیش پیغمبر نبود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 231.9,
   "end": 236.0,
   "text": "و اصلاً عزیزتر از ایشون پیش خدا هم نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 236.0,
   "end": 239.7,
   "text": "حضرت زهرا سرّ سرّ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 239.7,
   "end": 248.36,
   "text": "عالمه و وجود ایشون درکش، درک حقیقت وجودی ایشون میشه درک ليلة القدر دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 248.36,
   "end": 253.16,
   "text": "هر مقدار درک من و شما به خانم نزدیک‌تر بشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 253.16,
   "end": 258.58,
   "text": "که از همین حس شروع میشه، حس کردن مقام مادری که دیگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 258.58,
   "end": 262.58,
   "text": "خاک‌ترین لفظی که به ذهن ما خطور می‌کنه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 262.58,
   "end": 267.92,
   "text": "شیواترین، شیرین‌ترین، دلنشین‌ترین، همه فهم‌ترین، دست- در دسترس‌ترین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 267.92,
   "end": 271.92,
   "text": "چی بگیم؟ لفظ مادر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 271.92,
   "end": 274.48,
   "text": "همه می‌چشنش. اصلا تو میگی مادر کیف می‌کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 274.48,
   "end": 277.08,
   "text": "مثل عسل به کامشون میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 277.08,
   "end": 279.72,
   "text": "خب از همین جا شروع میشه درک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 279.72,
   "end": 282.76,
   "text": "حضرت صدیقه طاهره. یعنی از این غافل نباشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 282.76,
   "end": 285.86,
   "text": "شب قدر ایشونو مادر صدا کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 285.86,
   "end": 289.02,
   "text": "بله یا مولاتی مولاتی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 289.02,
   "end": 290.8,
   "text": "فاطمة عقیقینی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 290.8,
   "end": 294.14,
   "text": "اون ذکر پونصد و ده باره تو سجده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 294.14,
   "end": 297.04,
   "text": "به اون تفصیلی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 297.04,
   "end": 303.04,
   "text": "آشیخ عباس در مفاتیح آورده بعد از نماز استغاثه با خانم گفته میشه خیلی خوبه شب قدر بتونیم بخونیم اون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 303.04,
   "end": 306.2,
   "text": "بله جایگاه عظمت و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 306.2,
   "end": 310.32,
   "text": "رفعت مقام خانم اقتضا می‌کنه اما از همین جا شروع بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 310.32,
   "end": 312.72,
   "text": "مادر با زبان حال،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 312.72,
   "end": 316.02,
   "text": "با زبان حالمون، با",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 316.02,
   "end": 318.94,
   "text": "مادر کائنات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 318.94,
   "end": 324.34,
   "text": "نه مادر سادات. درسته مادر سادات اما کامل نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 324.34,
   "end": 326.6,
   "text": "مادر کائنات کامله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 326.6,
   "end": 330.88,
   "text": "صحبت کنیم. همون که بارها عرض کردیم شهید نصرالله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 330.88,
   "end": 334.34,
   "text": "رمزی که از رهبر اخذ کرد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 334.34,
   "end": 339.9,
   "text": "و در جنگ لبنان کمکشون کرد و فرمود سری بود، رمزی بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 339.9,
   "end": 341.52,
   "text": "ما اومدیم از ایشون کمک بخواهیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 341.52,
   "end": 347.34,
   "text": "فرمود با خدا صحبت کنید. با زبان حالتون با خدا حرف بزنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 347.34,
   "end": 351.78,
   "text": "امتحان کنید با خدا حرف بزنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 351.78,
   "end": 355.36,
   "text": "که عزیزمون آقای وحدتی هم دیروز تو جلسه اینو فرمودن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 355.36,
   "end": 358.24,
   "text": "خیلی امتحان کنید ببینید چه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 358.24,
   "end": 360.52,
   "text": "س-چه سری درشه. اصلاً چیکار می‌کنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 360.52,
   "end": 365.97,
   "text": "چه بلایی سر آدم میاره جزئی‌ترین چیزاتون رو به زبون بیارید بخدا به زبان حال.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 365.97,
   "end": 368.05,
   "text": "فیلم بازی نکنید صحبت کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 368.05,
   "end": 370.37,
   "text": "شب قدر هم به همین وضع.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 370.37,
   "end": 372.61,
   "text": "به همین سیر بحثمون چی بود؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 372.61,
   "end": 376.21,
   "text": "از سر و سر عالم از سر حضرت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 376.21,
   "end": 379.71,
   "text": "پیغمبر عزیز عالم که حضرت زهراست بهره بگیریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 379.71,
   "end": 381.61,
   "text": "شب قدر ایشون رو مادر صدا کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 381.61,
   "end": 387.11,
   "text": "هر طور می‌تونیم به حضرت صدیقه شهیده انشاالله از فردا شب، شب قدر اوله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 387.11,
   "end": 391.19,
   "text": "نزدیک بشیم روضه‌شو بخونیم، توسل کنیم، نمازشو بخونیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 391.19,
   "end": 395.21,
   "text": "با ایشون گفت‌وگو کنیم بار ما رو برمی‌داره ایشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 395.21,
   "end": 398.71,
   "text": "بار عالم رو برداشته، بار ولایت برداشته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 398.71,
   "end": 403.31,
   "text": "شوخی نیست. بار امیرالمؤمنین رو برداشته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 403.31,
   "end": 407.39,
   "text": "یک‌تنه سپاه یعنی لشکر امیرالمؤمنین بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 407.39,
   "end": 412.49,
   "text": "اینا حرفای احساسی و عاطفی نیست که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 412.49,
   "end": 417.05,
   "text": "خلاصه اینکه از حضرت زهرا صلوات الله علیها غافل نباشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 417.05,
   "end": 423.81,
   "text": "عزیزانی که دیروز توی افطار دیشب بودند ما تقریبا بیست دقیقه در خصوص ربط حضرت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 423.81,
   "end": 426.77,
   "text": "امام مجتبی با حضرت زهرا صحبت کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 426.77,
   "end": 429.63,
   "text": "یه بیست دقیقه. اونم مد نظرتون باشه ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 429.63,
   "end": 433.89,
   "text": "حالا از طریق حضرت زهرا به پیغمبر، پیغمبر به خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 433.89,
   "end": 437.13,
   "text": "حالا از چه طریقی به حضرت زهرا امام حسن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 437.13,
   "end": 439.83,
   "text": "تمام اهل بیت از نور امام حسن‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 439.83,
   "end": 443.19,
   "text": "حتی امام عصر. همه حسنی‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 443.19,
   "end": 447.53,
   "text": "چون اون زج-- اون زجاجه یعنی اون شیشه‌ی روی اون چراغ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 447.53,
   "end": 449.79,
   "text": "امام حسینه. اون چراغ،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 449.79,
   "end": 452.89,
   "text": "المصباح و نلمصباح.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 452.89,
   "end": 455.43,
   "text": "اون چراغ امام حسنه طبق روایات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 455.43,
   "end": 457.59,
   "text": "اصلاً اون نور امام حسنه. در کجاست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 457.59,
   "end": 460.21,
   "text": "در ظرف نوریه حضرت زهراست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 460.21,
   "end": 462.57,
   "text": "اصلاً حضرت زهرا چی رو جلوه داده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 462.57,
   "end": 464.85,
   "text": "رفقا توی یه جمله بگم تمومش کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 464.85,
   "end": 468.29,
   "text": "حضرت زهرا صلوات الله علیها چی رو جلوه داده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 468.29,
   "end": 471.39,
   "text": "اون نور رو. چون ظرف چراغ اونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 471.39,
   "end": 475.07,
   "text": "اون نور کیه؟ امام حسن. کی تلألأ بهش داده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 475.07,
   "end": 477.45,
   "text": "یعنی کی باعث شده که اون نور بهتر دیده بشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 477.45,
   "end": 480.15,
   "text": "امام حسین. همینطور تا امام عصر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 480.15,
   "end": 482.69,
   "text": "همه حسنی‌اند. اصلاً نور حضرت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 482.69,
   "end": 485.19,
   "text": "صدیقه شهیده امام مجتبی‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 485.19,
   "end": 489.95,
   "text": "از طریق امام مجتبی می‌تونید به سر و سر عالم دسترسی پیدا کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 489.95,
   "end": 491.49,
   "text": "خیلی حرف زدم امروزا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 491.49,
   "end": 493.55,
   "text": "خیلی چیزای مهم و نابی گفتم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 493.55,
   "end": 495.93,
   "text": "قدر این حرفا رو بدونید مال من نبوده، نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 495.93,
   "end": 501.77,
   "text": "مال نفس، رزق نفس شما بوده از بزرگان ما واسطه بودیم به شما رسید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 501.77,
   "end": 504.19,
   "text": "دادمان باشید ما رو انشاالله فردا شب دعا کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 504.19,
   "end": 505.91,
   "text": "والحمد لله رب العالمين.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 505.91,
   "end": 510.69,
   "text": "صلوات خوانی. اللهُم صَلِّ عَلَى مُحَمَّدٍ وَآلِ مُحَمَّد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}