 },
 "chapters": [
  {
   "index": 0,
   "title": "## تجلی اباعبدالله و توقع تجلی امام عصر",
   "start": 21.38,
   "end": 73.4
  },
  {
   "index": 1,
   "title": "## جامعهٔ کبیره؛ بکم فتح الله و بکم یختم",
   "start": 73.4,
   "end": 147.54
  },
  {
   "index": 2,
   "title": "## کامل الزیارات؛ شب جمعه تا زیارت خدا در عرش",
   "start": 147.54,
   "end": 214.22
  },
  {
   "index": 3,
   "title": "## آب حیات ولایت؛ متنجس نه نجس‌العین",
   "start": 214.22,
   "end": 402.34
  },
  {
   "index": 4,
   "title": "## دیدن خدا در چهرهٔ ولی",
   "start": 402.34,
   "end": 487.02
  },
  {
   "index": 5,
   "title": "## علامه طباطبایی؛ مراقبه و چشمۀ واحد کثرات",
   "start": 487.02,
   "end": 614.78
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 1.12,
   "end": 5.1,
   "text": "و آله محمد و عجل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 5.1,
   "end": 9.82,
   "text": "بسم الله الرحمن الرحیم و به این استعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 9.82,
   "end": 13.98,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 13.98,
   "end": 19.52,
   "text": "آیه. سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 19.52,
   "end": 27.74,
   "text": "عرض کردیم که حضرت ابا عبدالله صلوات الله عليه در کربلا تجلی کردند برای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 27.74,
   "end": 34.56,
   "text": "شهدای کربلا. ما می‌تونیم این توقع رو از امام عصر عزیزمون داشته باشیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 34.56,
   "end": 37.5,
   "text": "که برای ما ت-تجلی کنه حضرت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 37.5,
   "end": 44.66,
   "text": "برای عده‌ای می‌کنه و کرده و در حال تجلی هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 44.66,
   "end": 46.98,
   "text": "و متأسفانه ما غافلیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 46.98,
   "end": 51.24,
   "text": "ما دستمون کوتاهه. و الا حضرت برای تشنه گانش تجلی کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 51.24,
   "end": 54.62,
   "text": "تجلی هم یعنی ظهور، یعنی خودش رو نشون داد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 54.62,
   "end": 61.66,
   "text": "ما عرض کردیم خب این که امام حسین صلوات الله عليه خودش رو نشون داد یعنی چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 61.66,
   "end": 65.36,
   "text": "این که ظهور کرد برای اون‌ها یعنی چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 65.36,
   "end": 71.62,
   "text": "برای اینکه تو ریل بحث بیفتیم خوب اینو متوجه بشیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 71.62,
   "end": 76.58,
   "text": "اشاره می‌کنیم به اون فرمایش امام هادی صلوات الله عليه در جامعه کبیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 76.58,
   "end": 81.6,
   "text": "بکن فتح الله و بکن یختم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 81.6,
   "end": 84.92,
   "text": "اصلاً خدا با شما آغاز می‌کنه و خاتمه میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 84.92,
   "end": 88.46,
   "text": "با کی؟ با خاندان عصمت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 88.46,
   "end": 91.46,
   "text": "یعنی اونا مجرای فیض‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 91.46,
   "end": 96.98,
   "text": "یعنی هر خیری بخواد به کسی برسه از هر حیثش،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 96.98,
   "end": 102.44,
   "text": "هر رزقی حتی فیض وجود بخواد به کسی برسه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 102.44,
   "end": 105.92,
   "text": "از این خانواده می‌رسه. از کانال اون‌ها می‌رسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 105.92,
   "end": 110.08,
   "text": "خدا به هرکی هرچی می‌خواد برسونه از طریق اون‌ها می‌رسونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 110.08,
   "end": 112.06,
   "text": "حالا خدا می‌خواد تجلی کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 112.06,
   "end": 115.54,
   "text": "خدا می‌خواد خودش رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 115.54,
   "end": 118.78,
   "text": "نشون بده، ظهور کنه از طریق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 118.78,
   "end": 120.48,
   "text": "چه کسی؟ کانال فیض.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 120.48,
   "end": 123.32,
   "text": "کانال فیض کیه؟ انسان کامل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 123.32,
   "end": 128.26,
   "text": "یعنی باز سید الشهدا تجلی کرد برای شهدا یعنی چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 128.26,
   "end": 130.08,
   "text": "یعنی خدا خودنمایی کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 130.08,
   "end": 135.32,
   "text": "اما از طریق امام حسین. یعنی کار این تو-- به اینجا می‌رسه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 135.32,
   "end": 142.1,
   "text": "که اصلاً این که میگه از-- جز با امام حسین نمیشه چون خدا از اون طریق فیضش رو می‌رسونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 142.1,
   "end": 146.16,
   "text": "خدا از اون طریق به تو توجه می‌کنه، به تو رو می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 146.16,
   "end": 153.12,
   "text": "شما اصلاً نمی‌تونی جز در محیط ولایت، جز در بارگاه سید الشهدا خدا رو ببینی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 153.12,
   "end": 158.26,
   "text": "نمیشه. حالا امام حسین بین اون چهارده تا معصوم علیهم الصلاة والسلام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 158.26,
   "end": 160.8,
   "text": "دیگه یه کاری کرده کارستون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 160.8,
   "end": 164.28,
   "text": "یه کاری کرده که اهدی مثل اون ظاهر نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 164.28,
   "end": 167.96,
   "text": "یعنی شب جمعه دیگه وقتی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 167.96,
   "end": 172.12,
   "text": "اه کتاب شریف کامل الزياراته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 172.12,
   "end": 175.64,
   "text": "که وقتی حضرت سؤال کرد از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 175.64,
   "end": 179.32,
   "text": "رفیقش امام صادق که آیا دوست داری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 179.32,
   "end": 182.86,
   "text": "همه انبیا و ملائکه رو باهاشون مصاف-- مصافحه کنی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 182.86,
   "end": 186.84,
   "text": "مصافحه یعنی دست بدی. خیلیه با همه انبیا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 186.84,
   "end": 191.82,
   "text": "عرض کرد بله. فرمود شب جمعه برو زیارت جد ما امام حسین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 191.82,
   "end": 194.68,
   "text": "بعد گفت می‌خوای با همه اوصیا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 194.68,
   "end": 198.42,
   "text": "یعنی انبیا رو بذار به کنار، اوصیاشون هم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 198.42,
   "end": 200.46,
   "text": "خیلی میشه. گفت بله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 200.46,
   "end": 202.42,
   "text": "فرمود شب جمعه برو زیارت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 202.42,
   "end": 204.66,
   "text": "همینطوری بردش تا جایی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 204.66,
   "end": 207.42,
   "text": "بعد حضرت یه نفس عمیقی چاق کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 207.42,
   "end": 210.72,
   "text": "سکوت کردن و حرف مهمی می‌خواد بزنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 210.72,
   "end": 212.78,
   "text": "بعد یه نگاه به طرف کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 212.78,
   "end": 218.48,
   "text": "بعد حضرت فرمود می‌خوای خدا رو زیارت کنی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 218.48,
   "end": 220.86,
   "text": "خیلی حرفه‌ها. یعنی این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 220.86,
   "end": 223.32,
   "text": "الان میشه تو بحث تجلی میشه اینو گفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 223.32,
   "end": 226.4,
   "text": "در غیر این صورت طرف کفر می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 226.4,
   "end": 230.06,
   "text": "گفت بله. حضرت فرمود شب جمعه برو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 230.06,
   "end": 232.5,
   "text": "بعد فرمود چ-چرا حالا شب جمعه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 232.5,
   "end": 239.82,
   "text": "فرمود شب جمعه همه انبیا، اولیا، شهدا، اوصیا یعنی جانشینان انبیا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 239.82,
   "end": 244.3,
   "text": "همه و همه و خدا ظاهر حسین ابن علی میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 244.3,
   "end": 246.86,
   "text": "الله اکبر. خدا هم ظاهر میشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 246.86,
   "end": 253.38,
   "text": "بله. حالا درکش یه مقدار مشکله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 253.38,
   "end": 255.14,
   "text": "اما بله خدا هم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 255.14,
   "end": 261.46,
   "text": "و فرمود اگر کسی شب جمعه زیارت حسین ابن علی کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 261.46,
   "end": 266.08,
   "text": "زارالله فی عرشه، خدا رو زیارت کرده در عرشش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 266.08,
   "end": 267.74,
   "text": "حالا عرش خدا چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 267.74,
   "end": 270.62,
   "text": "عرش جایگاه قدرت الهیه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 270.62,
   "end": 275.28,
   "text": "به یک معنا علم الهیه، سلطنت الهیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 275.28,
   "end": 282.58,
   "text": "حالا اینجا خیلی حرفا بزرگان پیاده کردن ما کاری فعلاً با اون بخش نداریم تو بحث تجلی‌ایم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 282.58,
   "end": 285.72,
   "text": "یعنی یه کاری کرده امام حسین که دیگه خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 285.72,
   "end": 287.36,
   "text": "سنگ تموم براش گذاشته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 287.36,
   "end": 291.32,
   "text": "خداست و خدایی می‌کنه. کی می‌تونه جلوشو بگیره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 291.32,
   "end": 297.7,
   "text": "او رو آب حیات قرار داده به گونه‌ای که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 297.7,
   "end": 300.78,
   "text": "هر ن-- نجس العين نه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 300.78,
   "end": 304.28,
   "text": "متنجس. یه وقت نجس العين",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 304.28,
   "end": 307.14,
   "text": "یعنی عین نجاست اونکه برطرف نمیشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 307.14,
   "end": 313.32,
   "text": "مگه اینکه کلاً مثل سگ بیفته تو نمکزار کلاً تبدیل بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 313.32,
   "end": 317.64,
   "text": "ولی غیر از اون شما چیزی متنجس شد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 317.64,
   "end": 322.04,
   "text": "پاکه، ذاتاً پاکه اما نجس شده، برخورد کرده با نجاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 322.04,
   "end": 329.72,
   "text": "این به محض دقت کنید به محض اینکه به آب رسید پاکه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 329.72,
   "end": 332.12,
   "text": "من ناپاک شدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 332.12,
   "end": 335.16,
   "text": "ذات ما که ناپاک نیست که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 335.16,
   "end": 341.2,
   "text": "ذات ما ناپاک نیست. کل مولود یولد على الفطره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 341.2,
   "end": 345.2,
   "text": "فطرت چیه؟ فطرت الله التي فطر الناس عليها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 345.2,
   "end": 348.48,
   "text": "فطرت الهیه. همه مفتورند به فطرت و همه پاک.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 348.48,
   "end": 353.68,
   "text": "ذات همه پاک. وقتی گناه می‌کنیم متنجس میشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 353.68,
   "end": 356.8,
   "text": "یعنی برخورد به نجاست می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 356.8,
   "end": 359.34,
   "text": "به محض برخورد با آب پاک باید بشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 359.34,
   "end": 364.9,
   "text": "اون آب چیه؟ محیط ولایت اهل بیت، مخصوصاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 364.9,
   "end": 368.72,
   "text": "محیط زیارت امام حسین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 368.72,
   "end": 373.46,
   "text": "مج-- هر چیزی که منتسب به حضرته، مجلسش، روزه‌ش، ذکرش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 373.46,
   "end": 376.3,
   "text": "الان من به جای آقا میگم اینجا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 376.3,
   "end": 380.1,
   "text": "همین بارگاه سید الشهدا میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 380.1,
   "end": 383.26,
   "text": "و این به محض برخورد انسان پاک میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 383.26,
   "end": 390.64,
   "text": "این معامله‌ایه که خدا در خصوص این خاندان خاصه امام حسین داره انجام میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 390.64,
   "end": 396.06,
   "text": "به من و شما چه که بخوایم شک کنیم و بگیم مگه میشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 396.06,
   "end": 398.84,
   "text": "شک نداره خداست. همه چی دست خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 398.84,
   "end": 404.58,
   "text": "خداست و خدایی می‌کنه. حالا اون تجلی اعظم در سید الشهداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 404.58,
   "end": 410.3,
   "text": "این تجلی یعنی چی؟ یعنی خدا از طریق امام حسین خودش رو نشون میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 410.3,
   "end": 418.94,
   "text": "یعنی کسی تو چهره امام حسین نگاه کرد، امام حسین براش تجلی کرد، خدا رو تو چهره امام حسین می‌بینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 418.94,
   "end": 421.14,
   "text": "اینطوریه. داریم نزدیک میشیم به قصه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 421.14,
   "end": 424.74,
   "text": "یعنی چی؟ شده شما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 424.74,
   "end": 428.8,
   "text": "خدا رو تو چهره کسی ببینی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 428.8,
   "end": 432.42,
   "text": "علی بن ابی طالب. حضرت؟ جعفر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 432.42,
   "end": 436.26,
   "text": "قال اصول منو درآوردی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 436.26,
   "end": 439.9,
   "text": "حضرت-- از حضرت عیسی سؤال کردن ما با کی بنشینیم، با کی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 439.9,
   "end": 442.14,
   "text": "صحبت کنیم، با کی مصاحبت کنیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 442.14,
   "end": 446.32,
   "text": "فرمودن با کسی که می‌بینیش شما رو یاد خدا بندازه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 446.32,
   "end": 450.54,
   "text": "یاد خدا و این هه خب مراتب داره، مراتب محفوظ.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 450.54,
   "end": 453.86,
   "text": "من نمیدونم رهبر عزیز رو کی از نزدیک دیده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 453.86,
   "end": 457.78,
   "text": "من از نزدیک ایشون رو زیارت کردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 457.78,
   "end": 460.9,
   "text": "اصلاً قطعاً اینطوری همه‌تون اتفاق افتاده براتون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 460.9,
   "end": 465.28,
   "text": "یه ولوله عجیبی ناخودآگاه تو درونت ایجاد میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 465.28,
   "end": 468.26,
   "text": "چرا؟ محل ظهور",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 468.26,
   "end": 473.84,
   "text": "ب-به قدر، به اندازه خودش به صیغه وجودی خودش محل ظهور خداشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 473.84,
   "end": 477.7,
   "text": "خدا رو می‌بینی. باز به ما هم بستگی داره‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 477.7,
   "end": 481.06,
   "text": "امکان داره یه کسی بغل پیغمبر هم بشینه نبینه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 481.06,
   "end": 483.38,
   "text": "کور باشه. حالا این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 483.38,
   "end": 487.02,
   "text": "فرصت رفته این خط رو گوش بدید از حضرت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 487.02,
   "end": 492.1,
   "text": "علامه طباطبایی بخونم. توضیحش انشاالله فردا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 492.1,
   "end": 496.14,
   "text": "حضرت علامه طباطبایی علیه الرحمة والرضوان در کتاب شریف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 496.14,
   "end": 498.7,
   "text": "سیر و سلوکش پیرامون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 498.7,
   "end": 507.4,
   "text": "تجلیات حضرت حق این چنین می‌فرماید که البته قبلش دو تا توصیه می‌کنه که می‌فرماید تو بهترین جاهایی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 507.4,
   "end": 511.16,
   "text": "شما تجلیات خدا رو می‌بینید، یکی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 511.16,
   "end": 513.26,
   "text": "زیارت امام حسینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 513.26,
   "end": 520.76,
   "text": "چه از دور، چه از نزدیک. یکی هم قرائت قرآن به یک سبک خاصیه که حالا بعداً توضیح میدیم به چه سبکی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 520.76,
   "end": 527.38,
   "text": "بعد ایشون می‌فرماید که به طور اجمال کیفیت آن یعنی ظهور تجلیات الهیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 527.38,
   "end": 531.24,
   "text": "این است که سالک در اثر مراقبه کم‌کم، در اثر چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 531.24,
   "end": 535.12,
   "text": "مراقبه، مراقبه خودشه، پلیس خودشه، حواسش به خودش هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 535.12,
   "end": 544.36,
   "text": "کیشی که نفس میده. کم‌کم متوجه می‌شود که کثرات جهان این همه خلقت، این همه کثرت، این همه خلائق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 544.36,
   "end": 547.06,
   "text": "از یک چشم سیاب می‌شود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 547.06,
   "end": 550.16,
   "text": "یعنی منبعشون یکیه، یک جاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 550.16,
   "end": 557.56,
   "text": "توحید. و هرچه در او واقع می‌گردد از یک مصدر صادر می‌گردد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 557.56,
   "end": 564.98,
   "text": "و هر موجودی هر بها و نور و کمالی که دارد از آن مبدا گرفته است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 564.98,
   "end": 567.12,
   "text": "تعجب نکنین تجلی یعنی چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 567.12,
   "end": 571.54,
   "text": "یعنی این. کسی به اینجا رسید که منبع رو یکی دید، یه چیز دید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 571.54,
   "end": 574.78,
   "text": "توحید صمدی قرآنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 574.78,
   "end": 586.36,
   "text": "از حیث افعالیش لا حول و لا قوة الا بالله، از حیث صفاتی و اسماییش لا اله الا الله، از حیث ذاتیش لا هو الا هو،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 586.36,
   "end": 589.34,
   "text": "یا ما الله الا هو. کسی این‌ها رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 589.34,
   "end": 592.14,
   "text": "رسید، درک کرد، چشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 592.14,
   "end": 594.7,
   "text": "یعنی خدا تجلیات خدا رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 594.7,
   "end": 597.68,
   "text": "دیده و در او ظهور کرده خدای ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 597.68,
   "end": 601.32,
   "text": "ممنون میشم. حالا این رو شما وصلش کن به امام حسین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 601.32,
   "end": 603.36,
   "text": "کسی این رو در امام حسین دید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 603.36,
   "end": 606.82,
   "text": "این یعنی امام حسین خودشو بهش نشون داده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 606.82,
   "end": 609.68,
   "text": "والحمد لله رب العالمين صلوات بفرستین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 609.68,
   "end": 614.78,
   "text": "اللهم صل على محمد و آل محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}