 },
 "chapters": [
  {
   "index": 0,
   "title": "## اجبار یا اذن؛ آیات نودونه و صد یونس",
   "start": 17.32,
   "end": 37.54
  },
  {
   "index": 1,
   "title": "## آثار عقل در زندگی و معاشرت",
   "start": 37.54,
   "end": 547.19
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.14,
   "end": 5.58,
   "text": "اللهم صل علی محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 5.58,
   "end": 9.06,
   "text": "بسم الله الرحمن الرحیم و به این استعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 9.06,
   "end": 13.82,
   "text": "السلام علیک یا داعی الله و ربانی آیات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 13.82,
   "end": 17.32,
   "text": "سلام علیکم و رحمت الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 17.32,
   "end": 23.26,
   "text": "یکی دیگه از آیاتی که توحید افعالی رو به خوبی بیان می‌کنه آیه صد سوره یونس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 23.26,
   "end": 25.48,
   "text": "قبل از اینکه خوب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 25.48,
   "end": 29.76,
   "text": "این آیه رو ما تحت توجه قرار بدیم لازمه یه دونه آیه قبلش رو هم بخونیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 29.76,
   "end": 34.28,
   "text": "در آیه نود و نه سوره یونس می‌فرماید ولوشأ ربک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 34.28,
   "end": 37.54,
   "text": "لآمن من فی الأرض کلهم جميعا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 37.54,
   "end": 43.0,
   "text": "اگه خدا می‌خواست هر کسی که رو زمینه جمعاً همه رو اهل ایمان می‌کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 43.0,
   "end": 45.8,
   "text": "یعنی بالاجبار، اختیار نمی‌داد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 45.8,
   "end": 49.22,
   "text": "همه رو اجباراً مؤمن می‌کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 49.22,
   "end": 53.82,
   "text": "أفأنت تكره الناس حتى يكونوا مؤمنین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 53.82,
   "end": 58.46,
   "text": "آیا تو مردم رو می‌خوای مجبور کنی که مؤمن بشن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 58.46,
   "end": 62.62,
   "text": "بعد از این آیه میاد تو آیه صد می‌فرماید و كان--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 62.62,
   "end": 64.66,
   "text": "وما كان لنفس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 64.66,
   "end": 67.58,
   "text": "أن تؤمن إلا بإذن الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 67.58,
   "end": 70.34,
   "text": "الله اکبر از این فرمایش حضرت حق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 70.34,
   "end": 74.52,
   "text": "می‌فرماید هیچ کسی قدرت اینو نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 74.52,
   "end": 77.7,
   "text": "هیچ کسی رو نسزد که ایمان بیاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 77.7,
   "end": 82.84,
   "text": "إلا بإذن الله. یعنی ایمان آوردن هر کسی هم به اذن خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 82.84,
   "end": 86.36,
   "text": "اگرچه اجبار نیست اما اذن الهیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 86.36,
   "end": 88.28,
   "text": "إن الله يهدي من يشاء.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 88.28,
   "end": 90.68,
   "text": "خدا قلب من و شما رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 90.68,
   "end": 92.82,
   "text": "کشونده الان در درگاه خودش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 92.82,
   "end": 95.98,
   "text": "الان میلیاردها آدم رو این زمین دارن زندگی می‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 95.98,
   "end": 100.32,
   "text": "کدومشون قلبشون متوجه حضرت حقه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 100.32,
   "end": 103.02,
   "text": "اختیارا یا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 103.02,
   "end": 105.7,
   "text": "به سمت حضرت حقه یا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 105.7,
   "end": 109.26,
   "text": "به سمت شیطانه. جز این دو حالت نیست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 109.26,
   "end": 113.46,
   "text": "اما اختیارا. اینجا می‌فرماید حالا شمایی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 113.46,
   "end": 117.94,
   "text": "اومدید ایمان آوردید حواستون جمع باشه کار این به اذن الله بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 117.94,
   "end": 120.44,
   "text": "اگه خدا نمی‌خواست شما نمی‌تونستی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 120.44,
   "end": 123.74,
   "text": "الان ذکری که شما تسبیح خانم رو دارید میدید همش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 123.74,
   "end": 126.14,
   "text": "تک تک این تسبیحاتو میگید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 126.14,
   "end": 133.7,
   "text": "همش به اذن الله. حالا کی اجبار اتفاق میفته که همه باید ایمان بیارن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 133.7,
   "end": 138.28,
   "text": "اون پس از مرگه. توی روایتی در تفسیر اهل بیت جلد شش،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 138.28,
   "end": 142.76,
   "text": "صفحه پونصد و هفتاد و چهار ملاحظه بفرمایید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 142.76,
   "end": 149.92,
   "text": "روایت شیرینی‌ست که مأمون از امام رئوف سؤال کرد در خصوص همین آیه صد سوره یونس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 149.92,
   "end": 152.66,
   "text": "و حضرت این‌چنين جواب دادن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 152.66,
   "end": 155.34,
   "text": "اینکه اینجا خدا فرموده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 155.34,
   "end": 157.78,
   "text": "ما كان لنفس أن تؤمن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 157.78,
   "end": 161.98,
   "text": "إلا بإذن الله هیچ نفسی نیست، هیچ کسی نیست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 161.98,
   "end": 165.86,
   "text": "که ایمان به خدا بیاره مگر به اذن الهیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 165.86,
   "end": 172.32,
   "text": "امام رئوف فرمودن که این به معنای این نیست که کسی از ایمان آوردن محروم می‌شه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 172.32,
   "end": 176.6,
   "text": "بلکه به این معناست که کسی بدون اذن خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 176.6,
   "end": 184.1,
   "text": "نمی‌تواند ایمان بیاورد و اذن خدا عبارت است از فرمان او به ایمان آوردن شخص.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 184.1,
   "end": 187.22,
   "text": "یعنی خدا فرمان به قلب شما داده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 187.22,
   "end": 192.14,
   "text": "ایمان آوردید. اگه خدا این امر رو نمی‌کرد، این فرمان رو نمی‌داد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 192.14,
   "end": 197.24,
   "text": "قلب من و شما ادبار داشت. بعد حضرت ادامه میدن و مجبور به ایمان نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 197.24,
   "end": 199.34,
   "text": "البته اینم حواستون باشه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 199.34,
   "end": 202.06,
   "text": "اجباری در کار نیست. دعوت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 202.06,
   "end": 207.32,
   "text": "شما لبیک گفتید. اما اگر خدا دعوت نمی‌کرد شما به چی لبیک می‌گفتید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 207.32,
   "end": 209.5,
   "text": "لذا سجده داره، شکر داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 209.5,
   "end": 217.0,
   "text": "میگه بعد از هر نمازت حداقل سه بار در سجده بگو شکرا لله شکی یا حمد لله حمد لله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 217.0,
   "end": 221.74,
   "text": "بعد این نکته آخرش حضرت می‌فرماید که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 221.74,
   "end": 225.32,
   "text": "و مجبور به ایمان نیست مگر پس از مرگ.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 225.32,
   "end": 228.78,
   "text": "این نشون میده که پس از مرگ وقتی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 228.78,
   "end": 235.74,
   "text": "نفس ناطقه انسان اعلام انصراف از بدن داد و منصرف شد و رفت به اون عالم، اونجا دیگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 235.74,
   "end": 238.88,
   "text": "چون فکشفنا عنک غطاءک،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 238.88,
   "end": 243.5,
   "text": "این پرده میفته همه و همه حداقلش به علم یقین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 243.5,
   "end": 248.66,
   "text": "حالا اون عین یقین و حق الیقین به مراتب ایمان بستگی داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 248.66,
   "end": 254.5,
   "text": "حتی کفار و مشرک منافقین هم اونها هم به علم یقین حقیقت رو در میارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 254.5,
   "end": 257.02,
   "text": "لذا اونجا بالاجبار همه اهل ایمان می‌شن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 257.02,
   "end": 261.16,
   "text": "یعنی همه قبول می‌کنند حضرت حق رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 261.16,
   "end": 263.92,
   "text": "اونجا دیگه اجبار اونجاست. الب--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 263.92,
   "end": 268.1,
   "text": "ببینید یکی از چیزایی که برای همه جعل شده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 268.1,
   "end": 273.0,
   "text": "حضرت حق اجباراً برای همه جعل کرده مرگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 273.0,
   "end": 278.04,
   "text": "اینه که دیگه همه قبول داریم کل نفس واقعة الموت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 278.04,
   "end": 280.1,
   "text": "خب نمی‌شد بشه کل نفس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 280.1,
   "end": 283.96,
   "text": "واقعة الإيمان. پس خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 283.96,
   "end": 286.22,
   "text": "هدایت می‌کنه منتها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 286.22,
   "end": 288.98,
   "text": "در این نشر طبیعت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 288.98,
   "end": 293.66,
   "text": "اختیار داده. مثل اینکه در قرآن می‌فرماید انا هدینا السبیل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 293.66,
   "end": 296.14,
   "text": "اما شاكرا و اما كفورا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 296.14,
   "end": 298.16,
   "text": "ما راهو نشون میدیم، هدایت می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 298.16,
   "end": 301.28,
   "text": "حالا تو می‌خوای شاکر باشی، می‌خوای کافر باشی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 301.28,
   "end": 303.74,
   "text": "یا وهديناهم النجدین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 303.74,
   "end": 307.1,
   "text": "دو راه خیر و شر رو بهشون نشون دادیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 307.1,
   "end": 310.12,
   "text": "باز می‌فرماید فألهمه فجوره و تقواه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 310.12,
   "end": 313.06,
   "text": "فجور و تقوی الهام شده به نفس انسان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 313.06,
   "end": 318.64,
   "text": "مثلاً ذاتا یه دزد میره دزدی کنه می‌بینی دست پاش می‌لرزه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 318.64,
   "end": 322.72,
   "text": "یا جاهای دیگه می‌فرماید لا اكراه في الدين قد تبين الرشد من الغي.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 322.72,
   "end": 326.74,
   "text": "راه رشد و غی، راه خیر و شر کاملاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 326.74,
   "end": 331.3,
   "text": "آشکار و مشخصه. دیگه تو می‌تونی اختیارا این‌ها رو برداری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 331.3,
   "end": 333.62,
   "text": "می‌تونی پس بزنی. هر کاری دوست داشتی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 333.62,
   "end": 336.86,
   "text": "اینجا این شکلیه. خب؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 336.86,
   "end": 339.56,
   "text": "می‌خوایم عرض کنیم که در موضوع",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 339.56,
   "end": 342.86,
   "text": "از نظر خدمتتون ایمان آوردن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 342.86,
   "end": 347.86,
   "text": "خدا اجبار نکرده، دعوت کرده، هدایت کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 347.86,
   "end": 351.98,
   "text": "اما هرچی که هست همین هدایت حضرت حق هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 351.98,
   "end": 355.78,
   "text": "به اذن الله. آیه رو دقت کنید ادامه داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 355.78,
   "end": 360.66,
   "text": "من نصفشو خوندم. بسیار تو بحث‌ها ما از این آیه استفاده کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 360.66,
   "end": 369.61,
   "text": "گفتیم حواسمون جمع باشه. یه جایی هست که خدا صراحتا فرموده اگر اینطوری نباشی اهل رجس و ناپاکی میشی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 369.61,
   "end": 370.09,
   "text": "اونجا که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 370.09,
   "end": 378.29,
   "text": "توی قرآن می‌فرماید [سخنگوی 1: إنما یرید الله لیذھب عنکم الرجس أهل البتی ویطهرکم تطهيرا] این رجس یعنی آلودگی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 378.29,
   "end": 381.49,
   "text": "توی یک روایت دیگه حضرت فرمودن یعنی شک.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 381.49,
   "end": 383.45,
   "text": "شک به خدا. اونم آلودگیه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 383.45,
   "end": 386.01,
   "text": "کلاً مطلقاً آلودگی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 386.01,
   "end": 389.97,
   "text": "این آیه صراحتاً داره می‌فرماد [سخنگوی 1: ویجعل الرجس] این یجعل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 389.97,
   "end": 392.75,
   "text": "به کی می‌خوره؟ به الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 392.75,
   "end": 398.49,
   "text": "خدا قرار میده [سخنگوی 1: ویجعل الرجس] خدا آلودگی رو کجا قرار میده به نظر شما؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 398.49,
   "end": 409.41,
   "text": "[سخنگوی 1: ویجعل الرجس على الذین لا- لا- خانم دکتر بلند بگین. درس. نه، نه. [سخنگوی 1: يعقلون] [سخنگوی 1: يعقلون]",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 409.41,
   "end": 413.37,
   "text": "درس و بحثامون زیاد بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 413.37,
   "end": 414.89,
   "text": "[سخنگوی 1: لا يعقلون] عقل. عقل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 414.89,
   "end": 418.71,
   "text": "احسنت. جایی کسی عقلش رو تعطیل کنه آلوده میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 418.71,
   "end": 423.57,
   "text": "مثلا وجه تمایز ما با حیوانات جسارت می‌کنم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 423.57,
   "end": 428.71,
   "text": "اینه که عقل داریم دیگه. حالا کسی عاقلانه نگاه نکنه، عاقلانه گوش نده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 428.71,
   "end": 432.49,
   "text": "عاقلانه زندگی-- سبک زندگیش عاقلانه نباشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 432.49,
   "end": 436.21,
   "text": "حسش براساس عقلش نباشه، گفتارش براساس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 436.21,
   "end": 438.85,
   "text": "عقلش نباشه، حتی سکوتش،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 438.85,
   "end": 442.01,
   "text": "حتی غضبش، خنده‌ش، گریه‌ش،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 442.01,
   "end": 446.03,
   "text": "مدیریتش تحت مدیریت قرار گرفتنش،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 446.03,
   "end": 450.23,
   "text": "اداره‌ی یه اداره. همه‌ی این‌ها باید عاقلانه باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 450.23,
   "end": 454.41,
   "text": "اگر وهم بیاد رهزنی کنه و دعوات نفس بیاد وسط،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 454.41,
   "end": 458.43,
   "text": "شیطنت‌ها شروع میشه. می‌بینی همکارا میفتن به جون هم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 458.43,
   "end": 462.17,
   "text": "از هم راضی نیستن. هیچ وقت از هم خوششون نمیاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 462.17,
   "end": 464.67,
   "text": "یکی از الحمدالله خدا رو شکر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 464.67,
   "end": 469.15,
   "text": "شاکریم. اینم شکر داره. یکی از خوبی‌ها و محسنات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 469.15,
   "end": 472.27,
   "text": "بازرسی اینه که به واقع",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 472.27,
   "end": 474.73,
   "text": "این حالا از مدتی که ما اومدیم اینطوری بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 474.73,
   "end": 477.15,
   "text": "نمی‌دونیم پا قدمی ما آخوندا بوده یا نه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 477.15,
   "end": 481.95,
   "text": "کلاً اینطوریه عزیزان. همه با هم خوبن، خوشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 481.95,
   "end": 486.79,
   "text": "ما ندیدیم تو این اداره الحمدالله خیلی به ندرت اونم سریع رفع شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 486.79,
   "end": 488.97,
   "text": "یه وقت کسی با دیگری بجنگه، دعوایی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 488.97,
   "end": 490.53,
   "text": "همه مثل یه برادرن با هم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 490.53,
   "end": 495.43,
   "text": "الحمدالله. این آثار چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 495.43,
   "end": 497.91,
   "text": "اگه گفتید الان سیر بحث رو به کجا رسید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 497.91,
   "end": 501.83,
   "text": "آثار- [سخنگوی 3] .",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 501.83,
   "end": 504.21,
   "text": "آثار عقل، عقل، عقل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 504.21,
   "end": 507.41,
   "text": "وقتی عقل بیاد حکومت کنه عزیزان،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 507.41,
   "end": 510.91,
   "text": "یه جا عاقلانه رفتار بشه، همه‌چی درست میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 510.91,
   "end": 516.13,
   "text": "هر کجا که مداوات نفس و وهم و رهزنی نفس بیاد، همه چی خراب میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 516.13,
   "end": 520.23,
   "text": "تو زندگی شخصی و عرض شود تربیت و فرزند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 520.23,
   "end": 522.79,
   "text": "و مدارای با دیگران و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 522.79,
   "end": 527.29,
   "text": "حتی زناشویی‌مون. این چیزا اگر عقل اومد همه چی خوش و خرمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 527.29,
   "end": 530.83,
   "text": "حتی در ندارایی هم می‌بینی آدم خوشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 530.83,
   "end": 536.85,
   "text": "اما اگر عقل بره کنار، آدم اوج دارایی‌ش هم باشه ناخوشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 536.85,
   "end": 540.03,
   "text": "اللهم بارک لمولانا صاحب الزمان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 540.03,
   "end": 541.93,
   "text": "والحمد لله رب العالمين.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 541.93,
   "end": 543.97,
   "text": "صلوات ختم. اللهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 543.97,
   "end": 547.19,
   "text": "صل علی محمد و آل محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}