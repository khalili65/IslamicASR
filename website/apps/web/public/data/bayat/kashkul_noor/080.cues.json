 "chapters": [
  {
   "index": 0,
   "title": "## شباهت به پیامبر؛ سخن آیت‌الله بهجت",
   "start": 78.02,
   "end": 134.2
  },
  {
   "index": 1,
   "title": "## استرجاع در راه کربلا و نوم عرفانی",
   "start": 134.2,
   "end": 245.9
  },
  {
   "index": 2,
   "title": "## جملهٔ طلایی علی‌اکبر؛ فرهنگ توحیدی و بی‌باکی از مرگ",
   "start": 245.9,
   "end": 339.34
  },
  {
   "index": 3,
   "title": "## آیهٔ اضطرار؛ مصادیق اباعبدالله و امام عصر",
   "start": 339.34,
   "end": 468.9
  },
  {
   "index": 4,
   "title": "## امام؛ پدر مهربان و برادر شفیق",
   "start": 468.9,
   "end": 616.38
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.06,
   "end": 2.9,
   "text": "لا مدلا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 2.9,
   "end": 7.08,
   "text": "مد آله الطاهر و جبرائیل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 7.08,
   "end": 11.46,
   "text": "بسم الله الرحمن الرحیم و به این استعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 11.46,
   "end": 16.46,
   "text": "السلام علیک یا داعی الله و ربانیة آیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 16.46,
   "end": 19.12,
   "text": "سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 19.12,
   "end": 22.12,
   "text": "تبریک عرض می‌کنم میلاد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 22.12,
   "end": 26.2,
   "text": "با عظمت آقا حضرت علی اکبر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 26.2,
   "end": 30.94,
   "text": "که اون السلام علی الحسین در زیارت عاشورا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 30.94,
   "end": 35.8,
   "text": "از امام صادق در کامل الزيارات ابن قولویه روایت داریم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 35.8,
   "end": 38.06,
   "text": "مربوط به حضرت علی اکبره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 38.06,
   "end": 41.02,
   "text": "علی ابن الحسین عاشورا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 41.02,
   "end": 44.62,
   "text": "شخصیت بسیار برجسته و عجیبی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 44.62,
   "end": 47.22,
   "text": "تبریک عرض می‌کنم مخصوصاً خدمت جوون‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 47.22,
   "end": 51.96,
   "text": "چه جوون‌های قدیم، چه جوون‌های جدید مثل خود من",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 51.96,
   "end": 55.34,
   "text": "و مخصوصاً اون‌هایی که اسمشون مثل من علی اکبره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 55.34,
   "end": 60.78,
   "text": "قدیما بزرگ قوم به اون‌هایی که اسمشون علی اکبر بود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 60.78,
   "end": 64.92,
   "text": "هدیه میدادن. حالا آقای لواسانی داره فرار می‌کنه میره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 64.92,
   "end": 71.56,
   "text": "اما هدیه میدادن به اونایی که اسمشون- اونایی که اسمشون علی اکبر نیست نمی‌تونن بیان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 71.56,
   "end": 76.36,
   "text": "جلو. نهه. زمونه برعکس شده داداش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 76.36,
   "end": 79.42,
   "text": "بله. خدا رحمت کنه آقای بهجت رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 79.42,
   "end": 82.26,
   "text": "که ، ایشون یه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 82.26,
   "end": 83.92,
   "text": "فرمایشی دارن خیلی عجیب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 83.92,
   "end": 90.12,
   "text": "می‌فرمودن که بنا به فرمایش خود ابا عبدالله در کربلا که همه شنیدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 90.12,
   "end": 94.9,
   "text": "اشبه الناس خلقاً و خلقاً و منطقاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 94.9,
   "end": 98.96,
   "text": "برسول الله. یعنی حضرت علی اکبر از حیث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 98.96,
   "end": 104.26,
   "text": "خلقت، خلق و منطق یعنی بینش و عقل،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 104.26,
   "end": 107.06,
   "text": "شبیه‌ترین مردم به پیغمبر بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 107.06,
   "end": 110.22,
   "text": "آقای بهجت به استناد همین فرمایش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 110.22,
   "end": 115.78,
   "text": "می‌فرمودن اگر ایشون شهید نمی‌شدن و می‌موندن امام می‌شدن؛",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 115.78,
   "end": 118.36,
   "text": "چون شبیه‌ترین مردم‌اند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 118.36,
   "end": 120.8,
   "text": "به فرمایش خود ابا عبدالله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 120.8,
   "end": 122.68,
   "text": "یعنی امام بعد از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 122.68,
   "end": 129.32,
   "text": "ابا عبدالله می‌شدن. ولی قضاای الهی بر این تعلق گرفت که ایشون تشریف ببرن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 129.32,
   "end": 132.54,
   "text": "این خودش نشان عظمت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 132.54,
   "end": 134.2,
   "text": "جایگاه و شخصیت ایشونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 134.2,
   "end": 136.9,
   "text": "چون بحث ما توحید افعالی است،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 136.9,
   "end": 139.62,
   "text": "اتفاقاً در یه فرمایشی ایشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 139.62,
   "end": 142.86,
   "text": "همه موضوع توحید رو به نحو عالی بیان می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 142.86,
   "end": 144.94,
   "text": "شنیدید قطعاً در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 144.94,
   "end": 147.68,
   "text": "مخصوصاً تو محرم‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 147.68,
   "end": 153.6,
   "text": "که سیّد ابن طاووس در لهوفش نقل می‌کنه که وقتی ابی عبدالله می‌رفتند به سمت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 153.6,
   "end": 156.42,
   "text": "کربلا، سه مرتبه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 156.42,
   "end": 160.96,
   "text": "حضرت علی اکبر شنیدن که ابا عبدالله سه مرتبه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 160.96,
   "end": 164.24,
   "text": "عرض می‌کنند انا لله و انا الیه راجعون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 164.24,
   "end": 166.72,
   "text": "سه بار. حضرت علی اکبر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 166.72,
   "end": 172.38,
   "text": "عرض کردن که بابا چرا شما آیه استرجاع به لب جاری کردین؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 172.38,
   "end": 174.44,
   "text": "فرمودن پسرم میوه دلم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 174.44,
   "end": 179.14,
   "text": "من الان خوابی بر من عارض شد رو مرکب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 179.14,
   "end": 181.56,
   "text": "حالا می‌دونید اینم نوم عرفانیه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 181.56,
   "end": 184.4,
   "text": "نوم عرفانی وجود رو باطل نمی‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 184.4,
   "end": 188.04,
   "text": "یک نحو از ارتباط با ملکوته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 188.04,
   "end": 190.24,
   "text": "که چشم بازه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 190.24,
   "end": 194.32,
   "text": "گوش هم می‌شنوه. یک نحو ارتباط با ملکوته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 194.32,
   "end": 198.96,
   "text": "یه مقدار انسان ارتفاع وجودی پیدا کنه و مراقبت کنه می‌رسه به اونجا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 198.96,
   "end": 207.42,
   "text": "چیز عجیبی نیست. البته که اون نوم عرفانی امام سطحش به مراتب نسبت به مراتب وجودی خود ایشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 207.42,
   "end": 210.72,
   "text": "از همه بالاتره. ارتباط مستقیم با غیبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 210.72,
   "end": 217.28,
   "text": "فیض علی الاطلاقه. فرمودن که پسرم خاطفی رو دیدم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 217.28,
   "end": 221.02,
   "text": "بر-- سوار مرکب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 221.02,
   "end": 226.9,
   "text": "، صدا می‌زدن که این کاروانی که داره میره مرگ به دنبالشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 226.9,
   "end": 231.2,
   "text": "پس پیداست که ما داریم میریم به سمت قتلگاهمون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 231.2,
   "end": 234.38,
   "text": "حضرت علی اکبر علیه الصلاة والسلام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 234.38,
   "end": 237.84,
   "text": "عرض کردن که بابا آیا ما به حق هستیم یا نه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 237.84,
   "end": 239.86,
   "text": "این به حق هستیم یا نه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 239.86,
   "end": 243.06,
   "text": "یعنی ما در مسیر توحید هستیم یا نه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 243.06,
   "end": 245.9,
   "text": "یعنی توحید ما درسته یا نه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 245.9,
   "end": 248.6,
   "text": "چون حق یعنی همون توحید دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 248.6,
   "end": 251.24,
   "text": "توحید چیزی جز حق نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 251.24,
   "end": 255.06,
   "text": "به قول ابن ترکه در تمهید القواعدش می‌فرماید:",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 255.06,
   "end": 260.8,
   "text": "حق مساوقه با وجوده، وجود هم مساوقه با حق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 260.8,
   "end": 265.54,
   "text": "و یک وجود صمدی قرآنی داریم که همه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 265.54,
   "end": 269.64,
   "text": "اتوار وجودیشون شؤون عالم شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 269.64,
   "end": 272.32,
   "text": "به هر حال وقتی این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 272.32,
   "end": 276.4,
   "text": "سؤال قشنگ رو علی اکبر از امام حسین پرسید که آیا ما به حقیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 276.4,
   "end": 280.3,
   "text": "یعنی آیا توحید ما ناب، درسته یا نه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 280.3,
   "end": 285.26,
   "text": "ابا عبدالله فرمودن آری پسرم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 285.26,
   "end": 290.8,
   "text": "، ما به حق هستیم. بعد در این موقع بود که حضرت علی اکبر این جمله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 290.8,
   "end": 294.46,
   "text": "کلیدی بلکه طلایی رو بر لسان جاری کردن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 294.46,
   "end": 299.22,
   "text": "و در این صورت از کشته شدن در راه حق چه باکی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 299.22,
   "end": 303.5,
   "text": "ببینید وقتی کسی فرهنگش فرهنگ توحیدی می‌شه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 303.5,
   "end": 305.54,
   "text": "اصلاً براش فرقی نمی‌کنه که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 305.54,
   "end": 307.94,
   "text": "حیات و مماتش یکی می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 307.94,
   "end": 312.04,
   "text": "اصلاً ترس و رعبی به دلش وارد نمی‌شه که بخواد دشمن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 312.04,
   "end": 314.42,
   "text": "مثلاً ترعیب کنه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 314.42,
   "end": 316.98,
   "text": "رعب به دل‌ها وارد کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 316.98,
   "end": 321.7,
   "text": "که آره مثلاً من می‌خوام امروز فر-- حمله کنم، فردا حمله کنم، حمله کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 321.7,
   "end": 324.2,
   "text": "مثلاً هر وقت عشقت کشید حمله کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 324.2,
   "end": 327.58,
   "text": "اولاً تو دهنی حسابی رو از ما بخور",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 327.58,
   "end": 329.76,
   "text": "تا بشینی سر جات مثل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 329.76,
   "end": 331.98,
   "text": "همیشه تاریخ انقلاب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 331.98,
   "end": 334.78,
   "text": "پس ما هیچ اصلاً نگرانی‌ای نداریم، ترس نداریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 334.78,
   "end": 338.02,
   "text": "اگر کسی واقعاً در مسیر توحیدی باشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 338.02,
   "end": 342.36,
   "text": "ترس نداره. می‌دونید یکی از مصادیق اصلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 342.36,
   "end": 346.9,
   "text": "مضطر انسانی که مضطر شده که أم يجيب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 346.9,
   "end": 350.94,
   "text": "یکی از اون آیاتی که اصلاً بحث توحید رو خیلی زیبا بیان کرده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 350.94,
   "end": 353.22,
   "text": "همین آیه شصت و دو سوره نمل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 353.22,
   "end": 355.7,
   "text": "أم يجيب المضطر إذا دعاه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 355.7,
   "end": 361.52,
   "text": "ويكشف سؤه ويجعلكم خلفاء الأرض",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 361.52,
   "end": 364.26,
   "text": "أإله مع الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 364.26,
   "end": 370.02,
   "text": "سؤال أإله مع الله آیا به اتفاق خدا الهه دیگه‌ای اصلاً هست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 370.02,
   "end": 372.82,
   "text": "مع الله اصلاً شما الهه‌ای رو می‌تونید پیدا کنید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 372.82,
   "end": 375.28,
   "text": "چون همه عالم دست الله هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 375.28,
   "end": 377.7,
   "text": "همه چی منتشر شده از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 377.7,
   "end": 383.56,
   "text": "الله هست. شما چه اللهی رو، چه الهی رو میخواید کنار، کنار الله قرار بدید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 383.56,
   "end": 386.4,
   "text": "خیلی زیبا آیه پیرامون اصلاً توحیده دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 386.4,
   "end": 390.2,
   "text": "قلیل متذکرون اگرچه عده قلیلی هستند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 390.2,
   "end": 396.46,
   "text": "که این رو متذکر بشن. اما ما می‌گیم در قرآن آیه شصت و دو سوره نمل اینو می‌گیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 396.46,
   "end": 402.96,
   "text": "حالا این أم يجيب المضطر إذا دعاه وأكشف السوء دو تا مصداق عتم براش بیان کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 402.96,
   "end": 407.66,
   "text": "یکی ابا عبدالله که به هر طرف رفت راه رو به روش بستن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 407.66,
   "end": 411.46,
   "text": "و مضطرش کردن و مجبورش کردن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 411.46,
   "end": 414.44,
   "text": "بجنگه و اون هم با زن و بچه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 414.44,
   "end": 417.32,
   "text": "اه یکی هم آقامون امام عصره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 417.32,
   "end": 420.76,
   "text": "امام عصر هم الان مضطره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 420.76,
   "end": 426.22,
   "text": "مضطر بی‌آونگرده. الطرید الشرید الفرید الوحید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 426.22,
   "end": 431.14,
   "text": "آقا امیرالمؤمنین این‌ suchی معرفی کردن دیگه آقا امام عصر رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 431.14,
   "end": 435.9,
   "text": "طرد شده‌ی آواره‌ی تنها مونده غریب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 435.9,
   "end": 440.2,
   "text": "این یعنی اضطرار. یک عمر منتظره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 440.2,
   "end": 443.78,
   "text": "هیچ کدومشون هم مثل امام عصر سختی نکشیدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 443.78,
   "end": 447.62,
   "text": "یه چند سالی دیدن و زجر کشیدن و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 447.62,
   "end": 450.98,
   "text": "حوادث و ظلم‌ها رو دیدند و از دنیا رفتند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 450.98,
   "end": 453.52,
   "text": "اما این آقا هزار و چندی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 453.52,
   "end": 458.14,
   "text": "این همه ظلم‌ها و ستم‌ها و خونریزی‌ها و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 458.14,
   "end": 464.42,
   "text": "دروغ قساوت قلب‌خوار و این‌ها رو داره از حجاج‌ها بگیر بیا تا داعش و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 464.42,
   "end": 468.28,
   "text": "الان این فرعون زمان ترامپ ملعون رو داره می‌بینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 468.28,
   "end": 471.12,
   "text": "این ما شاید جسارت می‌کنم ببخشید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 471.12,
   "end": 474.7,
   "text": "من شاید اینو به بی رگی گرفتنم خیلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 474.7,
   "end": 477.7,
   "text": "حواسم پرت و اصلاً توجه به این چیزا ندارم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 477.7,
   "end": 480.7,
   "text": "اما ما امام عصر که اینجوری نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 480.7,
   "end": 484.38,
   "text": "پدره. الامام والد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 484.38,
   "end": 489.12,
   "text": "الوالد الشفیق العنیس الرفيق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 489.12,
   "end": 494.58,
   "text": "الأخ الشقيق الأم البره بالولد الصغير.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 494.58,
   "end": 498.6,
   "text": "این فرمایشات امام رضا علیه السلام در خصوص امامه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 498.6,
   "end": 502.26,
   "text": "رفیقه، عنیسه، پدر به شدت مهربانه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 502.26,
   "end": 508.72,
   "text": "مادر رسیدگی کننده و نیکوکار، نیکوکار به بچه کوچیکشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 508.72,
   "end": 512.44,
   "text": "بالولد الصغير. مثل برادر دوقلو شما می‌مونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 512.44,
   "end": 515.24,
   "text": "غمی به شما وارد شه او غم زده میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 515.24,
   "end": 517.06,
   "text": "تب کنید او تب میکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 517.06,
   "end": 519.38,
   "text": "اون نگه-- اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 519.38,
   "end": 522.4,
   "text": "در حقیقت به شدت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 522.4,
   "end": 527.12,
   "text": "مضطره احوالات دوستان و شیعیانشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 527.12,
   "end": 528.96,
   "text": "ما شاید خیلی توجه نداشته باشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 528.96,
   "end": 532.8,
   "text": "اگر مصیبتی به خودم وارد بشه میریزم و مضطرب میشم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 532.8,
   "end": 536.5,
   "text": "اما آقا اینطوری نیست که. اون میگه اصلاً برام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 536.5,
   "end": 539.0,
   "text": "چه امروز چه فردا هر وقت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 539.0,
   "end": 541.56,
   "text": "بالاخره سینه ام رو باز کنم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 541.56,
   "end": 546.3,
   "text": "مرگ رو در آغوش میکشم. به قول جدش امیرالمؤمنین علیه الصلاة والسلام فرمود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 546.3,
   "end": 551.14,
   "text": "شوق من به موت از شوق بچه به سینه مادرش بیشتره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 551.14,
   "end": 556.3,
   "text": "شوخی نیست این حرف. همه اضطرار حضرت به ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 556.3,
   "end": 558.74,
   "text": "ما مضطرب به امام عصریم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 558.74,
   "end": 560.88,
   "text": "که میلاد حضرت هم نزدیکه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 560.88,
   "end": 565.5,
   "text": "قریب‌الوقوع چند روز بعد انشاالله عیدی‌های بزرگ بگیریم من جمله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 565.5,
   "end": 570.02,
   "text": "برگشتن شر استکبار خصوصاً آمریکا به خودش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 570.02,
   "end": 572.6,
   "text": "و اسرائیل به خودش و از ما بش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 572.6,
   "end": 576.26,
   "text": "این باشه انشاالله عیدی ما. سلامتی رهبرمون باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 576.26,
   "end": 580.64,
   "text": "در هر حال این خلاصه مطلب رو جمع‌بندی کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 580.64,
   "end": 583.08,
   "text": "این باز هم ضمن تبریک به تک تک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 583.08,
   "end": 589.08,
   "text": "شما روز جوان هم هست حتما برای فرزندان جوانمون اگر در منزل دارین یه عیدی تهیه کنید بهش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 589.08,
   "end": 593.48,
   "text": "علی اکبر امام حسین صلوات الله علیه و برای جوان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 593.48,
   "end": 595.8,
   "text": "بازرسی که اسمش علی اکبره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 595.8,
   "end": 598.02,
   "text": "حتما یه فکری بکنید همینطوری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 598.02,
   "end": 602.34,
   "text": "با کمال میل. آره. انشاالله که امام عصر عیدی‌های خوب به هممون بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 602.34,
   "end": 606.3,
   "text": "اللهم بارک لمولانا صاحب الزمان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 606.3,
   "end": 608.44,
   "text": "والحمد لله رب العالمين.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 608.44,
   "end": 616.38,
   "text": "صلوات الله علیه و آ Last.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}