   "title": "## احسن کل شیء خلقه؛ توحید افعالی",
   "start": 17.54,
   "end": 295.52
  },
  {
   "index": 1,
   "title": "## تدبر در صورت انسان و قیاس با نبات و حیوان",
   "start": 295.52,
   "end": 318.78
  },
  {
   "index": 2,
   "title": "## حیوانات و عنکبوت؛ بیست جلد و هنوز ناتمام",
   "start": 318.78,
   "end": 345.06
  },
  {
   "index": 3,
   "title": "## جمادات و مدارها؛ یک میکرون اعوجاج",
   "start": 345.06,
   "end": 646.65
  },
  {
   "index": 4,
   "title": "## ذکر جامع؛ هدیهٔ توحیدی",
   "start": 646.65,
   "end": 672.15
  },
  {
   "index": 5,
   "title": "## ذکر جامع؛ توحید در هر حال",
   "start": 672.15,
   "end": 770.25
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.14,
   "end": 9.66,
   "text": "[سخنگوی 1] [سخنگوی 2] بسم الله الرحمن الرحیم و به این استعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 9.66,
   "end": 13.64,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 13.64,
   "end": 17.54,
   "text": "آیاته. السلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 17.54,
   "end": 21.72,
   "text": "در آیه هفت سوره سجده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 21.72,
   "end": 25.02,
   "text": "اشاره می‌کنه به یکی از زیباترین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 25.02,
   "end": 26.94,
   "text": "مباحث توحید افعالی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 26.94,
   "end": 31.0,
   "text": "الذي احسن کل شیء خلقه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 31.0,
   "end": 35.34,
   "text": "وبدأ خلق الانسان من طین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 35.34,
   "end": 40.68,
   "text": "ببینید پروردگار سبحان در افعالش دو تا کار به صورت کلی انجام میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 40.68,
   "end": 45.38,
   "text": "یکی افعالی‌ست که مربوط به خلقتشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 45.38,
   "end": 49.94,
   "text": "مربوط به آفرینشه، انشاشه، ایجادشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 49.94,
   "end": 52.28,
   "text": "مثل خلقت خود ما انسان‌ها،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 52.28,
   "end": 55.16,
   "text": "خلقت جمادات، نباتات، حیوان‌ها،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 55.16,
   "end": 60.38,
   "text": "آسمان، زمین، حور، قصر، بهشت، انهار، اشجار،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 60.38,
   "end": 62.96,
   "text": "جهنم، دنیا، آخرت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 62.96,
   "end": 66.18,
   "text": "اینا همه آفرینش حضرت حقه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 66.18,
   "end": 69.82,
   "text": "اهدی دخالتی در این آفرینش نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 69.82,
   "end": 74.24,
   "text": "و اگر کسی در دنیا خلقی می‌کنه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 74.24,
   "end": 79.98,
   "text": "ابدایی می‌کنه، در طول اون عقلی‌ست که خدای منان بهش داده، یک.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 79.98,
   "end": 84.9,
   "text": "دو، معمولا یه-- معمولا نه، قطعاً و صد درصد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 84.9,
   "end": 88.4,
   "text": "یه مدتی بگذره این انشاش، این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 88.4,
   "end": 92.16,
   "text": "به قول معروف حالا خلق دست خودش این قدیمی می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 92.16,
   "end": 95.5,
   "text": "مدل جدید میاد رو دست اون می‌زنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 95.5,
   "end": 98.14,
   "text": "هیچکس نتونسته چیزی رو خلق کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 98.14,
   "end": 99.86,
   "text": "که بگه این دیگه مدل آخره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 99.86,
   "end": 102.28,
   "text": "دیگه رو-- رو دست این نمیاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 102.28,
   "end": 106.14,
   "text": "تنها کسی که این کارو کرده در خلقت حضرت حقه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 106.14,
   "end": 108.42,
   "text": "به بهترین وجه ممکن. بهترین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 108.42,
   "end": 111.34,
   "text": "ببینید به آفرین نیست‌ها،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 111.34,
   "end": 115.9,
   "text": "بهتر آفرینه. کار حسن نمی‌کنه‌ها،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 115.9,
   "end": 120.06,
   "text": "احسن می‌کنه. اینو دقت داشته باشید در بحث خلقتش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 120.06,
   "end": 124.18,
   "text": "لذا اینجا می‌فرماید الذي احسن کل شیء خلقه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 124.18,
   "end": 129.98,
   "text": "احسن. یعنی به بهترین وجه ممکن خلق کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 129.98,
   "end": 132.22,
   "text": "و جالبه بعدش می‌فرماید وبدأ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 132.22,
   "end": 135.16,
   "text": "خلق الانسان من طین. در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 135.16,
   "end": 140.42,
   "text": "رابطه با در طول این احسن خلقش اشاره می‌کنه به خلقت انسان از خاک.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 140.42,
   "end": 143.68,
   "text": "کی می‌تونه از خاک انسان بیافرینه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 143.68,
   "end": 146.06,
   "text": "انسان می‌آفرینه، انسان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 146.06,
   "end": 150.04,
   "text": "نه از جنس خود خاک. خاکو برداره کوزش کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 150.04,
   "end": 153.12,
   "text": "خاکو برداره آجرش کنه، ساختمونش کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 153.12,
   "end": 155.32,
   "text": "نه. انسانه با روحش کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 155.32,
   "end": 157.4,
   "text": "بفرمایید نفخت فیه من روحه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 157.4,
   "end": 159.74,
   "text": "من روحی روح درش بدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 159.74,
   "end": 163.24,
   "text": "کی می‌تونه؟ کی تونسته اصلاً؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 163.24,
   "end": 166.44,
   "text": "می‌دونستید که دانشمندا گفتن اگر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 166.44,
   "end": 170.7,
   "text": "کسی بخواد، اگر بشه، اگر بشه همچین کاری کرد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 170.7,
   "end": 175.86,
   "text": "مغزی رو خلق کرد که بتونه کارکرد مغز انسان رو داشته باشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 175.86,
   "end": 179.56,
   "text": "یک برابر و نیم وسعت کره زمین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 179.56,
   "end": 183.88,
   "text": "اندازه‌ش می‌شه. حالا اینو خدا تو جمجه ما تو انقدر جا قرار داده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 183.88,
   "end": 188.2,
   "text": "تازه اون گفتن اگر بشه که نشدنیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 188.2,
   "end": 192.42,
   "text": "این احسن نیست؟ حالا یه کاری هم خدا داره با",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 192.42,
   "end": 194.88,
   "text": "در خصوص افعال حضرت حق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 194.88,
   "end": 197.18,
   "text": "در خصوص بندگانشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 197.18,
   "end": 199.52,
   "text": "به هر حال و بعد از انشا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 199.52,
   "end": 204.14,
   "text": "میره سراغ اون‌ها. مثل ثواب دادن به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 204.14,
   "end": 207.48,
   "text": "اهل ایمان. به بهترین وجه ممکن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 207.48,
   "end": 211.16,
   "text": "الان به ما بگن که آقا اگر یکی بیاد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 211.16,
   "end": 214.48,
   "text": "مثلاً یه بار تو رو صدا کنه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 214.48,
   "end": 218.3,
   "text": "یه بار تو رو صدا بزنه، حاضری چی بهش بدی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 218.3,
   "end": 221.06,
   "text": "یهو صدا زده میگم بله چی میگی شما؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 221.06,
   "end": 224.7,
   "text": "ولی خدا میگه کسی بیاد یک بار منو دل شب صدا کنه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 224.7,
   "end": 227.66,
   "text": "انقدر بهش جزا میدم. این همه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 227.66,
   "end": 231.48,
   "text": "قصر و اشجار و انهار و بهشت و چی و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 231.48,
   "end": 233.6,
   "text": "بعد من یادش می‌کنم، من بدادش می‌رسم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 233.6,
   "end": 239.38,
   "text": "انقدر خدا می‌بخشه، می‌بخشه، می‌بخشه طرف میگه بابا بسه دیگه چه خبره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 239.38,
   "end": 243.42,
   "text": "در مؤاخذه کردن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 243.42,
   "end": 249.02,
   "text": "متأسفانه کفار و مشرکین و منافقین که نفهمیدن چه باید بکنند،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 249.02,
   "end": 253.12,
   "text": "از اون نفهمی‌شون یا خدایی نکرده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 253.12,
   "end": 257.96,
   "text": "مخالفت‌شون با حضرت حق در-- هر طری مخالفت کردن به احسن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 257.96,
   "end": 261.98,
   "text": "وجه دین خدا که به بهترین وجه ممکن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 261.98,
   "end": 264.9,
   "text": "بسته‌ای برای سعادت دنیا و آخرتشون نازل شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 264.9,
   "end": 267.66,
   "text": "اون‌ها مخالفت کردن به هر دلیلی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 267.66,
   "end": 271.28,
   "text": "خدا بدترین نوع عذاب رو داره نه عذاب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 271.28,
   "end": 274.26,
   "text": "أشد المؤاخذه. شوخی نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 274.26,
   "end": 279.44,
   "text": "یعنی از هر حیث رو دست خدا نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 279.44,
   "end": 283.4,
   "text": "یا از حیث مثلاً لطفش به انسان،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 283.4,
   "end": 286.26,
   "text": "لطفی که به انسان داره از حیث دستگیریش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 286.26,
   "end": 290.38,
   "text": "البته شما هر حالا اون فعلاً تو اون بحث کاری نداریم ارتباطش با بندگان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 290.38,
   "end": 293.9,
   "text": "بریم سراغ همون وجه احسن خلقتش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 293.9,
   "end": 301.1,
   "text": "بشینید یه دقیقه فکر کنید ببینید اگر همین چهره صورت ظاهری که ما داریم اگر تغییر می‌کرد چگونه می‌شد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 301.1,
   "end": 304.18,
   "text": "یا بشینید رو کاغذ بنویسید. من این کارو کردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 304.18,
   "end": 307.7,
   "text": "مثلاً هر کاری می‌کنی احسن وجهش همینه که هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 307.7,
   "end": 310.32,
   "text": "اگر قرار بود مثلاً گوش‌های ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 310.32,
   "end": 312.58,
   "text": "جاش با چشممون عوض می‌شد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 312.58,
   "end": 315.54,
   "text": "یا دهانمون مثلاً جاش می‌رفت رو پیشونی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 315.54,
   "end": 320.14,
   "text": "شما اینا رو فکر کنید یا موها به جای اینکه رو سر در بیاد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 320.14,
   "end": 322.72,
   "text": "مثلاً می‌اومد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 322.72,
   "end": 326.76,
   "text": "چه می‌دونم زیر فک یا رو گردن در می‌اومد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 326.76,
   "end": 330.24,
   "text": "یا اصلاً آدم مو در نمی‌آورد کلاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 330.24,
   "end": 333.84,
   "text": "مثلاً طاس و کچل بود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 333.84,
   "end": 336.62,
   "text": "یا سه چشم بود یا تک چشم بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 336.62,
   "end": 339.88,
   "text": "یا شما فکر کنید الان ما برعکس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 339.88,
   "end": 342.7,
   "text": "بهترش اینه که بگیم درخت برعکس ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 342.7,
   "end": 346.84,
   "text": "نباتات برعکس ماست. دهانشون در زمینه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 346.84,
   "end": 349.56,
   "text": "پاشون به سمت آسمونه. درسته؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 349.56,
   "end": 351.98,
   "text": "اینو حضرت استاد اشاره می‌کنن. بعد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 351.98,
   "end": 354.74,
   "text": "بین ما و اون‌ها حیوانه که افقیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 354.74,
   "end": 358.74,
   "text": "اون به صورت افقیه یعنی عمودی نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 358.74,
   "end": 361.83,
   "text": "مثل چهارپا هم راه می‌ره. انسان اینطوری نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 361.83,
   "end": 365.05,
   "text": "حیوان اون شکلیه، چهارپایه، افقیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 365.05,
   "end": 368.75,
   "text": "انسان عمودیه. دهانش به سمت آسمانه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 368.75,
   "end": 372.67,
   "text": "درخت دهانش به سمت زمینه، تو زمینه، از زمین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 372.67,
   "end": 375.23,
   "text": "ارتزاق می‌کنه. حالا اگر قرار بود ما،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 375.23,
   "end": 378.27,
   "text": "ما هم برعکس باشیم. چی می‌شد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 378.27,
   "end": 383.17,
   "text": "یا از پایین تغذیه کنیم. معذرت می‌خوام از بالا دف کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 383.17,
   "end": 389.13,
   "text": "شما هرچی فکر می‌کنی می‌بینی به بهترین وجه ممکن پروردگار سبحان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 389.13,
   "end": 392.09,
   "text": "ما را ایجاد کرده. کتاب‌ها نوشتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 392.09,
   "end": 395.13,
   "text": "حالا این در خصوص خود انسانه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 395.13,
   "end": 399.17,
   "text": "برید در خصوص حیوانات بررسی کنید ببینید چه خبره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 399.17,
   "end": 402.33,
   "text": "اصلا تهش پیدا نشده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 402.33,
   "end": 404.99,
   "text": "دریا چه موجوداتی داره هنوز،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 404.99,
   "end": 409.23,
   "text": "هنوز که هنوزه در حال پیدا کردن موجودات جدیدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 409.23,
   "end": 414.15,
   "text": "موجوداتی هستن که از طریق پوستشون تغذیه می‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 414.15,
   "end": 415.75,
   "text": "یعنی دهانشون پوستشونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 415.75,
   "end": 423.07,
   "text": "پوست-- شما فکر کن اگر ما این شکلی بودیم یعنی تغذیه‌مون، خورد و خوراکمون از طریق پوست باید اتفاق میفتاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 423.07,
   "end": 428.23,
   "text": "چی می‌شد؟ اصلا خنده داره، کاریکاتوریه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 428.23,
   "end": 431.75,
   "text": "و اون‌ها این شکلی‌اند. یه دانشمندی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 431.75,
   "end": 434.89,
   "text": "من این کتاب رو ندیدم از حضرت استاد شنیدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 434.89,
   "end": 437.65,
   "text": "دانشمند فرانسویه خیلی سال‌های پیش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 437.65,
   "end": 441.65,
   "text": "یه کتابی می‌نویسه در خصوص عنکبوت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 441.65,
   "end": 446.29,
   "text": "بیست جلد کتاب در رابطه با یک عنکبوت می‌نویسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 446.29,
   "end": 449.03,
   "text": "اسرار خلقت عنکبوت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 449.03,
   "end": 455.97,
   "text": "بیست جلد کتاب. بعد مقدمه کتاب می‌نویسه این جانور خدا شصت سال عمر منو گرفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 455.97,
   "end": 460.95,
   "text": "شصت سال عمرشو میذاره، بیست جلد کتاب در خصوص عنکبوت می‌نویسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 460.95,
   "end": 464.53,
   "text": "حضرت استاد می‌فرمودن آخر کتابم می‌نویسه من چیزی نفهمیدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 464.53,
   "end": 467.71,
   "text": "یعنی هنوز چیزهایی در خصوص این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 467.71,
   "end": 470.95,
   "text": "جانور هست. حالا قرآن در خصوص خود عنکبوت چی می‌فرماید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 470.95,
   "end": 473.91,
   "text": "ان ای اوهن البیوت لک تو انکبوت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 473.91,
   "end": 476.23,
   "text": "تازه این جانور خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 476.23,
   "end": 478.99,
   "text": "خانه‌ش از همه ضعیف‌تره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 478.99,
   "end": 483.79,
   "text": "ضعیف‌ترین خانه‌ها رو داره. ناز یک عنکبوت حضرت حق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 483.79,
   "end": 487.25,
   "text": "شصت سال عمر یه دانشمند رو گرفته بازم تموم نشده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 487.25,
   "end": 490.53,
   "text": "الله اکبر. این احسن وجه نیست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 490.53,
   "end": 494.11,
   "text": "این حیوانات. حالا برو تو جمادات ببین خلقت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 494.11,
   "end": 499.01,
   "text": "آ-آسمانها و زمین به چه شکله که اگر یک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 499.01,
   "end": 501.43,
   "text": "میکرون کوچک‌ترین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 501.43,
   "end": 506.15,
   "text": "اندازه ممکن در مدار کل فی فлке یسبحون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 506.15,
   "end": 508.77,
   "text": "در مدار این کهکشان‌ها،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 508.77,
   "end": 512.01,
   "text": "این کرات، سیارات اینا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 512.01,
   "end": 515.57,
   "text": "یک ا-میکرون اعوجاج",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 515.57,
   "end": 517.97,
   "text": "صورت بگیره، می‌پاچه عالم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 517.97,
   "end": 520.03,
   "text": "همه چی به هم برخورد می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 520.03,
   "end": 524.17,
   "text": "اصلا منفجر می‌شه. زندگی اصلا از بین میره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 524.17,
   "end": 527.33,
   "text": "چه تدبیری پشت این خلقته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 527.33,
   "end": 529.83,
   "text": "چه خلقی کرده خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 529.83,
   "end": 533.67,
   "text": "بعد حالا ببینید وقتی میرید سراغ جمادات، بعد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 533.67,
   "end": 536.29,
   "text": "حیوانات، این‌ها رو بررسی می‌کنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 536.29,
   "end": 539.11,
   "text": "یا ملائکه، خلقت اجنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 539.11,
   "end": 542.75,
   "text": "اینا همش حرفه دیگه. عوالم هستی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 542.75,
   "end": 545.41,
   "text": "مراتب هستی. الله اکبر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 545.41,
   "end": 549.67,
   "text": "نحوه منتشر شدن اسماء الهی از ذات لایوی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 549.67,
   "end": 551.27,
   "text": "عالم اله و اسماء.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 551.27,
   "end": 555.29,
   "text": "بعد میاد می‌شه عالم عقول. انقدر ملائکه داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 555.29,
   "end": 557.35,
   "text": "کثرت مخلوقات به ملائکه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 557.35,
   "end": 561.25,
   "text": "یعنی بیشترین خلقت خدا ملائکه‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 561.25,
   "end": 564.53,
   "text": "همه جا حاضرند، همه جا حاضرند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 564.53,
   "end": 567.99,
   "text": "هر فیضی به هر چیزی می‌رسه از طریق ملائکه می‌رسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 567.99,
   "end": 574.17,
   "text": "غوغاس آقا. یه قطره بارون تا از اون بالا بیاد برسه به برخورد کنه به زمین،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 574.17,
   "end": 576.55,
   "text": "یه ملک محافظشه، همراهش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 576.55,
   "end": 582.59,
   "text": "شوخیه مگه؟ همه چی رو نظم دقیق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 582.59,
   "end": 586.05,
   "text": "حالا وقت هم-- این همه خلقت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 586.05,
   "end": 591.51,
   "text": "این همه خلائق وقتی به انسان می‌رسه میگه احسن الخالقین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 591.51,
   "end": 594.49,
   "text": "فتبارک الله احسن الخالقین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 594.49,
   "end": 598.85,
   "text": "بعد حالا این احسن الخالقین انسان رو از چی ایجاد کرد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 598.85,
   "end": 601.49,
   "text": "از چی خلق کرد؟ تو آیه برگردیم به آیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 601.49,
   "end": 605.51,
   "text": "وبدأ خلق الانسان من طین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 605.51,
   "end": 609.87,
   "text": "از این گل، از این خاک که ظاهرا پست‌ترین چیزه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 609.87,
   "end": 611.91,
   "text": "رو پا-- روش پا می‌کوبی و میری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 611.91,
   "end": 616.11,
   "text": "اصلا توجهی بهش نداری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 616.11,
   "end": 619.09,
   "text": "الله اکبر از این خلقت. یعنی شما نگاه کنید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 619.09,
   "end": 621.69,
   "text": "هرچه در خودت سیر انفسی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 621.69,
   "end": 624.51,
   "text": "پیرامون و خارج از خودت، سیر آفاقی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 624.51,
   "end": 627.37,
   "text": "هرچی دقت می‌کنی و نگاه می‌کنی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 627.37,
   "end": 630.93,
   "text": "حیرت اندر حیرت، حیرت اندر حیرت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 630.93,
   "end": 634.85,
   "text": "حیرت اندر حیرت. همش میگی الله، الله، الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 634.85,
   "end": 636.95,
   "text": "گناه می‌کنی میگی استغفرالله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 636.95,
   "end": 639.15,
   "text": "نعمت میگی الحمدلله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 639.15,
   "end": 642.71,
   "text": "می‌ترسی میگی از جد ما شاء الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 642.71,
   "end": 645.37,
   "text": "مصیبت بهت وارد می‌شه انا لله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 645.37,
   "end": 647.67,
   "text": "هرچی می‌شه. اتفاقا یه ذکری هست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 647.67,
   "end": 651.51,
   "text": "حالا که به اینجا رسید این ذکر رو هدیه کنم به شما اگه دوست داشتید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 651.51,
   "end": 656.43,
   "text": "قطعا دیدید. این ذکر معروفه به ذکر جامع.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 656.43,
   "end": 660.57,
   "text": "یه دقیقه به من وقت بدید براتون این ذکر رو تقدیم کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 660.57,
   "end": 663.09,
   "text": "کفامی از رسول خدا فرمودن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 663.09,
   "end": 667.11,
   "text": "روایت کردن که هر که این دعا رو روزی ده بار بخونه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 667.11,
   "end": 670.71,
   "text": "همون احسن پاداش هم اینجا داره، داره دیده می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 670.71,
   "end": 673.95,
   "text": "خداوند متعال با ده بار در روز خوندن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 673.95,
   "end": 676.33,
   "text": "چهار هزار گناهش رو می‌بخشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 676.33,
   "end": 679.15,
   "text": "فشار قبر رو از او مرتفع می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 679.15,
   "end": 682.75,
   "text": "قرضش رو ادا می‌کنه. غم اون رو زایل می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 682.75,
   "end": 684.73,
   "text": "از شر شیطان حفظش می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 684.73,
   "end": 688.13,
   "text": "اوه اوه چه خبره. دوباره روایت دیگه داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 688.13,
   "end": 696.03,
   "text": "تاکید علامه طباطبایی، علامه مجلسی، علامه حسن زاده به عنوان ذکر جامع بسیار، حالا فرصت نیست من رد می‌شم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 696.03,
   "end": 698.35,
   "text": "ببینید شما متن ذکر رو هم می‌خونم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 698.35,
   "end": 700.93,
   "text": "یازده بند کوتاهه، طولانی نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 700.93,
   "end": 704.25,
   "text": "ببینید چقدر همش الله، الله، الله، الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 704.25,
   "end": 706.73,
   "text": "یکپارچه توحیده. او",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 706.73,
   "end": 709.99,
   "text": "میگه اعدت من آماده کردم، مهیا کردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 709.99,
   "end": 713.09,
   "text": "لكل حول برای حل حولی چی رو؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 713.09,
   "end": 716.57,
   "text": "لا اله الا الله و لكل هم وغم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 716.57,
   "end": 719.07,
   "text": "ما شاء الله و لكل نعمة",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 719.07,
   "end": 722.11,
   "text": "الحمدلله و لكل رخاء",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 722.11,
   "end": 727.09,
   "text": "الشکر لله و لكل اعجوبة هر چیز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 727.09,
   "end": 732.35,
   "text": "تعجب آوری سبحان الله و لكل غم استغفرالله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 732.35,
   "end": 740.85,
   "text": "الله، الله، الله. و لكل مصيبة انا لله و انا الیه راجعون و لكل میغ حسبي الله و لكل قضاء",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 740.85,
   "end": 742.81,
   "text": "و قدر توکلت على الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 742.81,
   "end": 745.01,
   "text": "به به. و لكل عدو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 745.01,
   "end": 749.15,
   "text": "اعتصمت بالله و لكل طاعة و معصية",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 749.15,
   "end": 752.41,
   "text": "لا حول ولا قوة الا بالله العلي العظيم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 752.41,
   "end": 755.21,
   "text": "چقدر زیباست. یکپارچه توحیده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 755.21,
   "end": 759.17,
   "text": "آدم با این قبیل دعاها خو کنه، صفا کنه، نفس بکشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 759.17,
   "end": 762.65,
   "text": "اللهم بارک لمولانا صاحب الزمان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 762.65,
   "end": 764.57,
   "text": "والحمد لله رب العالمين.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 764.57,
   "end": 770.25,
   "text": "صلوات بفرستید. اللهم صل علی محمد و آل محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}