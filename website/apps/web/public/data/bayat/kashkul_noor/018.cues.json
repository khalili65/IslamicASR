 "chapters": [
  {
   "index": 0,
   "title": "## آرامش در ذکر قلبی؛ ظاهر و باطن",
   "start": 17.22,
   "end": 43.06
  },
  {
   "index": 1,
   "title": "### دعای نور؛ فرق معرفت و علم",
   "start": 43.06,
   "end": 63.28
  },
  {
   "index": 2,
   "title": "## آرامش با باطن‌بینی",
   "start": 63.28,
   "end": 368.57
  },
  {
   "index": 3,
   "title": "## اسماء و اشیاء؛ تجلی سلوکی و ماورائی",
   "start": 368.57,
   "end": 548.81
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 2.66,
   "end": 6.44,
   "text": "بسم الله الرحمن الرحیم و به این استعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 6.44,
   "end": 12.16,
   "text": "السلام علیک یا داعی الله و ربانی یا ایاته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 12.16,
   "end": 17.22,
   "text": "سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 17.22,
   "end": 20.68,
   "text": "بحث ما پیرامون آرامش بود و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 20.68,
   "end": 22.8,
   "text": "ربط اون با حوزه قلب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 22.8,
   "end": 26.72,
   "text": "گفتیم که آرامش در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 26.72,
   "end": 30.0,
   "text": "ذکر است، ذکر هم مرتبه قلبیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 30.0,
   "end": 33.08,
   "text": "قلب هم اون رتبه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 33.08,
   "end": 36.36,
   "text": "باطنی انسانه، نه ظاهری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 36.36,
   "end": 39.32,
   "text": "الان زبان من داره صحبت می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 39.32,
   "end": 47.06,
   "text": "درسته اونچه که میگه قطعاً یه چیزکی درش هست، در خودش هست که داره اینو بیرون می‌ریزه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 47.06,
   "end": 51.84,
   "text": "اما اینطور نیستش که بگی این کل مرتبه باطنشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 51.84,
   "end": 62.04,
   "text": "باطن رو خدا میدونه. الان کسی ظاهر منو ببینه میگه به به چه ظاهر مقدسی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 62.04,
   "end": 64.78,
   "text": "اما باطن رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 64.78,
   "end": 67.64,
   "text": "شما میدونی آقای ندهه؟ می‌خندی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 67.64,
   "end": 72.62,
   "text": "به هر حال شد. بله. اصلاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 72.62,
   "end": 77.94,
   "text": "مرتبه باطن قبلاً عرض کردیم خدمتتون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 77.94,
   "end": 81.84,
   "text": "تو اون دعاهایی که حضرت استاد خیلی سفارش داشتن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 81.84,
   "end": 85.32,
   "text": "که و قلبی، یادتونه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 85.32,
   "end": 88.5,
   "text": "اولش نور بود. اللهم نور",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 88.5,
   "end": 92.96,
   "text": "ظاهری به عبادتک و باطنی به محبتک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 92.96,
   "end": 96.98,
   "text": "و قلبی به معرفتک.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 96.98,
   "end": 99.24,
   "text": "فرق بین معرفت و علم هم گفتیم دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 99.24,
   "end": 102.46,
   "text": "خلاصه‌ش این بود که اصلاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 102.46,
   "end": 107.0,
   "text": "معرفت یعنی اگر چیزی دیدنیه ببینیش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 107.0,
   "end": 112.48,
   "text": "اگر چیزی شنیدنیه بشنویش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 112.48,
   "end": 120.42,
   "text": "مثلاً امام صادق صلوات الله علیه نماز که می‌خوند بعضاً حالت فغوشی علیه می‌فرمایید حالت غش بهشون دست می‌داد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 120.42,
   "end": 130.16,
   "text": "سؤال می‌شد چرا آقا؟ می‌فرمود که انقدر تکرار کردم ایاک نعبد و ایاک نستعین گفتم، گفتم تا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 130.16,
   "end": 136.74,
   "text": "یا اون بخش مالك یوم الدین اینو انقدر گفتم تا مشافهتاً عین عبارته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 136.74,
   "end": 143.22,
   "text": "از همون کسی که نازل کرده شنیدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 143.22,
   "end": 147.72,
   "text": "دقت کردی؟ لذا اون حالات بهش دست میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 147.72,
   "end": 153.58,
   "text": "وقتی که چیزی چشیدنیه انسان بچشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 153.58,
   "end": 156.42,
   "text": "چیزی دیدنیه ببینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 156.42,
   "end": 160.22,
   "text": "خدا رو میشه دید یا نمیشه دید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 160.22,
   "end": 166.68,
   "text": "همه میگیم نمیشه دید. در صورتی که مولامون حضرت ولیع امیرالمؤمنین علی علیه الصلاة والسلام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 166.68,
   "end": 171.88,
   "text": "فرمودند که لم اعبد رباً لم أره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 171.88,
   "end": 174.9,
   "text": "من اصلاً ابداً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 174.9,
   "end": 178.24,
   "text": "عبادت پروردگاری رو نمی‌کنم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 178.24,
   "end": 188.4,
   "text": "ندیده باشم. همه ما میگیم دیدنی نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 188.4,
   "end": 192.94,
   "text": "یعنی چی؟ این رؤیت باطنیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 192.94,
   "end": 197.14,
   "text": "اینکه داریم میگیم فرق معرفت با علم اینطوریه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 197.14,
   "end": 200.86,
   "text": "یعنی اگر از دم از حق میزنی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 200.86,
   "end": 203.9,
   "text": "آقایی که لباس پیغمبر تنته،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 203.9,
   "end": 215.7,
   "text": "میکروفن دستته، کلی آدم سنگتو به سینه میزنن، این چیزی که به لسانت جاری میشه در درون خودت ظهور کرده یا نه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 215.7,
   "end": 217.68,
   "text": "البته آثارش مشخص میشه‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 217.68,
   "end": 221.94,
   "text": "کسی که واقعاً خودش عمل میکنه به دل هم مینشینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 221.94,
   "end": 225.64,
   "text": "نه اینکه هم وقتی شروع می‌کنه صحبت همه میرن تو چرت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 225.64,
   "end": 229.66,
   "text": "این مشخصه که درونش چه خبره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 229.66,
   "end": 234.46,
   "text": "در هر حال هرچی که هست عزیزان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 234.46,
   "end": 242.9,
   "text": "در باطنه. آرامش در دست پیدا کردن ما یا دستیابی ما به باطن خودمون و عالمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 242.9,
   "end": 252.06,
   "text": "ما چون ظاهر بینیم، ظاهر نگریم، ظاهر دانیم فقط از ظاهرها، ظواهر می-می‌دانیم، می‌بینیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 252.06,
   "end": 256.18,
   "text": "می‌شنویم. نچشیدیم باطن رو آرامش هم نداریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 256.18,
   "end": 259.08,
   "text": "آرامش مال ذکره. ذکر مال مرتبه قلبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 259.08,
   "end": 263.8,
   "text": "قلب باطنه. معرفت هم اونجا میشینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 263.8,
   "end": 266.7,
   "text": "به یک معنا اینطوری خلاصه‌ش کنم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 266.7,
   "end": 271.68,
   "text": "باید حضرت حق تجلی کنه برای ما به طور خاص",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 271.68,
   "end": 275.64,
   "text": "تا ما با آرامش برسیم. یعنی ما ظاهر رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 275.64,
   "end": 279.38,
   "text": "صرفاً می‌بینیم در صورتی که باید باطن رو ببینیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 279.38,
   "end": 281.9,
   "text": "کدوممون باطن نگریم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 281.9,
   "end": 284.62,
   "text": "مگر خدا باطن عالم نیست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 284.62,
   "end": 288.28,
   "text": "مگر حضرت حق ذات غیبی باطن عالم نیست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 288.28,
   "end": 291.78,
   "text": "غیب مطلقه نیست؟ چطور مولا می‌بینه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 291.78,
   "end": 294.94,
   "text": "با چشم بصر که دیدنی نیست که خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 294.94,
   "end": 299.6,
   "text": "با چشم باطنش می‌بینه واقعاً.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 299.6,
   "end": 302.86,
   "text": "این نماز وقتی ما رو آتش میزنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 302.86,
   "end": 307.1,
   "text": "که ببینیم اون عبارتش خیلی مثل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 307.1,
   "end": 311.62,
   "text": "بمب هسته‌ای ریخت منو به هم تو دعای عرفه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 311.62,
   "end": 315.98,
   "text": "که ابا عبدالله-- اصلاً توجه نکردم این همه سال.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 315.98,
   "end": 317.52,
   "text": "همون جا میخکوب موندم دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 317.52,
   "end": 319.16,
   "text": "اصلاً تا آخر عرفه نرفتم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 319.16,
   "end": 322.58,
   "text": "باورتون شاید نشه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 322.58,
   "end": 326.18,
   "text": "ابا عبدالله به خدا عرض می‌کنه که خدایا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 326.18,
   "end": 331.14,
   "text": "من از تو می‌ترسم که انّە تو رو می‌بینم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 331.14,
   "end": 337.08,
   "text": "من از تو می‌ترسم که انّە تو را می‌بینم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 337.08,
   "end": 341.24,
   "text": "واقعاً این دیدن از چه نوع دیدنیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 341.24,
   "end": 344.8,
   "text": "اگر ما از علم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 344.8,
   "end": 353.18,
   "text": "عبور کنیم بریم به نور معرفت که البته وقتی معرفت شد میشه نوری که علم همراهی خودش داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 353.18,
   "end": 357.34,
   "text": "میشه علم اخص، علم خاص، دیگه عام نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 357.34,
   "end": 360.0,
   "text": "قطعاً می‌بینیم. اون موقع است که خدا تجلی کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 360.0,
   "end": 365.27,
   "text": "حالا بحث تجلیات اجازه بدید فردا بگیم الان فرصت رفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 365.27,
   "end": 372.07,
   "text": "در خصوص تجلی یه نکته عرض کنم که ببینید عالم اصلاً کائنات یکیش هم ما هستیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 372.07,
   "end": 375.39,
   "text": "تمام کلمات وجودی نظام هستی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 375.39,
   "end": 378.35,
   "text": "یکیش ما هستیم. اینا اسماء الهی‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 378.35,
   "end": 380.09,
   "text": "به قولی اشیاء‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 380.09,
   "end": 385.63,
   "text": "اشیاء موجود‌اند. موجودیت دارن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 385.63,
   "end": 387.51,
   "text": "وجود دارن، عدم که نیستن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 387.51,
   "end": 392.27,
   "text": "یکیشم ما هستیم. و علم آدم الاسماء كلها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 392.27,
   "end": 395.09,
   "text": "حضرت استاد فرمودن که می‌تونید بذارید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 395.09,
   "end": 398.23,
   "text": "به جای الاسماء بذارید الاشیاء.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 398.23,
   "end": 402.25,
   "text": "همه‌ی این اشیاء ظهور اسم الله‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 402.25,
   "end": 405.57,
   "text": "خب؟ حالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 405.57,
   "end": 410.75,
   "text": "دقت بفرمایید همه‌ی این کلمات وجودی نظام هستی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 410.75,
   "end": 414.21,
   "text": "ظهور باطن حق‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 414.21,
   "end": 417.29,
   "text": "خدا ظهور کرده شده این عالم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 417.29,
   "end": 421.15,
   "text": "اصلاً این عالم ظهور حقه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 421.15,
   "end": 426.09,
   "text": "تا اینجاش که می‌فهمی یعنی چی. مثل اینکه شما یه مرحله‌ای داری به نام بدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 426.09,
   "end": 430.03,
   "text": "رتبه‌ی انزل مراتب رتبه‌ی وجودی خودته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 430.03,
   "end": 431.97,
   "text": "ظهور کرده شده بدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 431.97,
   "end": 436.45,
   "text": "باطنتو من نمی‌بینم این ظاهرتو می‌بینم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 436.45,
   "end": 442.15,
   "text": "درست شد؟ اگر چشم باطن‌بین پیدا کنم فقط این با-بدنتو نمی‌بینم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 442.15,
   "end": 445.91,
   "text": "سررت رو هم می‌بینم، می‌فهمم تو به درد رفاقت می‌خوری یا نه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 445.91,
   "end": 451.13,
   "text": "حالا حضرت حق ظهور کرده شده عالم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 451.13,
   "end": 456.45,
   "text": "این به دو شکله. یک شکلش بهش میگن شکل سلوکی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 456.45,
   "end": 460.45,
   "text": "خلاصشو به شما بگم ترجمه‌ش ان‌شاءالله روزای بعد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 460.45,
   "end": 462.49,
   "text": "که بهش میگن اصطلاحاً سلوکی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 462.49,
   "end": 469.25,
   "text": "یعنی خدا ذاتش، صفاتش و افعالش در ضمیر سالک ظهور می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 469.25,
   "end": 474.33,
   "text": "یعنی تو رشحه ای از ذات الهی رو تو خودت می‌بینی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 474.33,
   "end": 478.35,
   "text": "رشحه ای از صفات الهی رو در خودت می‌بینی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 478.35,
   "end": 484.81,
   "text": "رشحه ای از افعال الهی رو در خودت می‌بینی که میگی لا حول ولا قوه الا بالله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 484.81,
   "end": 489.65,
   "text": "صفات الهی رو در خودت می‌بینی که میگی لا اله الا الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 489.65,
   "end": 495.33,
   "text": "ذات الهی رو در خودت می‌بینی که میگی یا ملاهو الا هو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 495.33,
   "end": 498.81,
   "text": "این بحث داره. یه، یه وجهش هم میگن ز--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 498.81,
   "end": 502.83,
   "text": "بهش میگن اصطلاحاً میگن متافیزیکی یا ماورائی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 502.83,
   "end": 508.63,
   "text": "توضیحاتش انشاالله بعدها که یعنی حضرت حق برای خودش تجلی کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 508.63,
   "end": 510.87,
   "text": "خودش برای خودش ظهور کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 510.87,
   "end": 514.61,
   "text": "خودش رو دید. یه مقدار الان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 514.61,
   "end": 518.97,
   "text": "کلمه کلمه قامضیه جمله ولی بازش کنیم چقدر شیرین می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 518.97,
   "end": 522.03,
   "text": "مثل اینکه خود شما خودت رو برای خودت آشکار کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 522.03,
   "end": 524.09,
   "text": "بری جلو آینه خودت رو ببینی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 524.09,
   "end": 529.11,
   "text": "به این شکل. خلاصه اینکه آرامش در چیه عزیزان دلم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 529.11,
   "end": 534.15,
   "text": "در اینه که ما چشممون به باطن باز بشه و اون هم کار خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 534.15,
   "end": 537.55,
   "text": "ما فقط یه کار باید بکنیم که خدا این کارو برا ما انجام بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 537.55,
   "end": 539.23,
   "text": "یعنی خدا برا ما ظهور کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 539.23,
   "end": 541.39,
   "text": "اونم باشه طلبتون برای روزهای بعد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 541.39,
   "end": 544.61,
   "text": "والحمد لله رب العالمين صلوات ختم کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 544.61,
   "end": 547.15,
   "text": "اللهم صل علی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 547.15,
   "end": 548.81,
   "text": "محمد و آل محمد و عجل فرجهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}