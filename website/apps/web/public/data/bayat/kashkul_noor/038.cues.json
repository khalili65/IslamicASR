 "chapters": [
  {
   "index": 0,
   "title": "## نخ تسبیح معارف: توحید",
   "start": 0.18,
   "end": 211.74
  },
  {
   "index": 1,
   "title": "## انشای نفس در قوهٔ خیال",
   "start": 211.74,
   "end": 232.54
  },
  {
   "index": 2,
   "title": "## خواب و بدن مثالی",
   "start": 232.54,
   "end": 252.84
  },
  {
   "index": 3,
   "title": "## اطوار وجودی حق و كل من عند الله",
   "start": 252.84,
   "end": 637.06
  },
  {
   "index": 4,
   "title": "## ما رأيت إلا جميلا",
   "start": 637.06,
   "end": 689.84
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.18,
   "end": 2.2,
   "text": "صلّ الله محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 2.2,
   "end": 5.78,
   "text": "و آل محمد و عجل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 5.78,
   "end": 9.82,
   "text": "بسم الله الرحمن الرحیم و به این استعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 9.82,
   "end": 13.96,
   "text": "والسلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 13.96,
   "end": 18.44,
   "text": "آیات سلامٌ علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 18.44,
   "end": 21.26,
   "text": "امروز گم شده‌ی ما رفقا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 21.26,
   "end": 26.38,
   "text": "معرفت توحیدیه. بزرگترین مشکلی که ماها داریم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 26.38,
   "end": 29.06,
   "text": "ضعف در وادی توحیده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 29.06,
   "end": 35.58,
   "text": "متأسفانه جلسات و درس و بحث‌ها و منبرهای توحیدی خیلی کم شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 35.58,
   "end": 42.16,
   "text": "در حالی که اصلاً اون شیرازه، اون نخ اسکنداس توحیده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 42.16,
   "end": 46.68,
   "text": "شما توحیدو بردارید دیگه چی باقی می‌مونه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 46.68,
   "end": 49.66,
   "text": "شما کل صحف نوریه و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 49.66,
   "end": 53.76,
   "text": "حکمیه بزرگان اهل معرفت رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 53.76,
   "end": 58.04,
   "text": "ورق بزنید همش بوی توحید میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 58.04,
   "end": 62.56,
   "text": "البته مسیر رسیدن به اون رو در معرفت نفس بیان کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 62.56,
   "end": 66.0,
   "text": "اون معجزه قولیه مولامون علی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 66.0,
   "end": 70.54,
   "text": "حضرت وصی علیه الصلاة والسلام که حدیث من عرف،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 70.54,
   "end": 74.9,
   "text": "من عرف نفسه فقط عرف ربه روش خیلی باید کار بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 74.9,
   "end": 78.36,
   "text": "شاهراه رسیدن به توحید ناب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 78.36,
   "end": 84.56,
   "text": "معرفت نفسه. این رو به صورت مقدمه عرض کردم که بحث توحیدی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 84.56,
   "end": 89.8,
   "text": "ما هر روز فعلاً ورود کردیم به فضل الهی در توحید افعالی رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 89.8,
   "end": 92.76,
   "text": "بهتر متوجه بشیم چرا من قریش کاف‌شاری داریم؛",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 92.76,
   "end": 99.8,
   "text": "داریم آیاتشو بحث می‌کنیم، بررسی می‌کنیم و به زودی ازش و راحت ازش گذر نمی‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 99.8,
   "end": 106.78,
   "text": "در آیه‌ هفت و هشت سوره نسا چنانچه خاطر شریفتون باشه انتهای آیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 106.78,
   "end": 111.9,
   "text": "که و ان تصبهم حسنه يقولوا هذه من عند الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 111.9,
   "end": 116.76,
   "text": "این‌ها منافقین می‌گفتن وقتی یه حسنه ای میاد این از الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 116.76,
   "end": 120.5,
   "text": "و ان تصبهم سيئة يقولوا هذه من عندك.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 120.5,
   "end": 123.5,
   "text": "وقتی که سیئه ای میاد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 123.5,
   "end": 130.18,
   "text": "به هر دلیلی حتی ورشکستگی مالی برای خودشون پیش میومد اینو نسبت میدادن به پیغمبر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 130.18,
   "end": 133.58,
   "text": "هذه من عندك گفتن از توئه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 133.58,
   "end": 136.24,
   "text": "عرض کردیم اینجا غیرت خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 136.24,
   "end": 138.86,
   "text": "خروش می‌گیره و می‌جوشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 138.86,
   "end": 141.86,
   "text": "می‌فرماید قل بهشون بگو محکم قل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 141.86,
   "end": 147.66,
   "text": "کل من عند الله همش از خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 147.66,
   "end": 154.08,
   "text": "فمال هؤلاء القول لا يكادون يفقهون حديثا چرا اینا نمی‌خوان بفهمن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 154.08,
   "end": 159.66,
   "text": "خیلی حد-- این آیه سیاقش عجیبه، خیلی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 159.66,
   "end": 162.3,
   "text": "که بعد دیروز ما عرض کردیم خب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 162.3,
   "end": 165.14,
   "text": "پس اون آیه‌ی ما أصابك من",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 165.14,
   "end": 167.58,
   "text": "سيئة فمن نفسك اینجا چی میشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 167.58,
   "end": 171.06,
   "text": "اگر هرچی بدیه از نفس توئه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 171.06,
   "end": 173.2,
   "text": "اینجا خدا میگه همچی از خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 173.2,
   "end": 176.52,
   "text": "کل من عندالله. اینو چجوری جمعش کنیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 176.52,
   "end": 180.12,
   "text": "تو اینجا بودیم داشتیم بحث می‌کردیم، فرصت گذشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 180.12,
   "end": 183.96,
   "text": "اجازه بدید برای اینکه اینو ما خوب متوجه بشیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 183.96,
   "end": 189.78,
   "text": "یه نکته‌ای رو پیرامون معرفت نفس با هم گفت و گو کنیم کوتاه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 189.78,
   "end": 192.82,
   "text": "بعد از این استفاده کنیم برای اون معرفت توحیدی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 192.82,
   "end": 195.54,
   "text": "خوب اینو گوش بدید اگر خواستید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 195.54,
   "end": 199.88,
   "text": "با دقت بیشتر مفصل‌ترشو بدونید در شرح اسفار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 199.88,
   "end": 205.82,
   "text": "ملاصدرا حضرت علامه حسن زاده علیه الرحمة والرضوان در جلسه هفتاد و شش،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 205.82,
   "end": 209.94,
   "text": "جلسه هفتاد و هشت قشنگ اینو توضیح دادم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 209.94,
   "end": 213.44,
   "text": "خلاصه‌ش اینه ببینید آنچه که ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 213.44,
   "end": 218.56,
   "text": "در نفسمون در قوه خیالمون صورت و شکل انشا میشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 218.56,
   "end": 221.04,
   "text": "نفسمون انشا می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 221.04,
   "end": 227.1,
   "text": "یعنی قوه خیال که قوه خیالی که ما داریم و در اون صورت و شکل انشا میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 227.1,
   "end": 229.62,
   "text": "چه در تمثلات بیداریمون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 229.62,
   "end": 238.1,
   "text": "تمثلاتی رخ میده. این که میگیم تمثل چون رتبه خیال رتبه مثالیه دیگه مافوق رتبه طبیعته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 238.1,
   "end": 243.88,
   "text": "برزخ وجودی ماست، ملکوت وجودی ماست که بالاتر از اون میشه عقل که رتبه جبروته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 243.88,
   "end": 247.7,
   "text": "بیرون از ما همینطوره. ما رتبه مثال،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 247.7,
   "end": 250.58,
   "text": "عالم مثال رو داریم که الان ارواح",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 250.58,
   "end": 254.78,
   "text": "اموات ما اونجان. عالم عقول هم داریم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 254.78,
   "end": 258.42,
   "text": "عالم جبروته و عالم ملائکه و این‌هاست و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 258.42,
   "end": 263.68,
   "text": "سلطنت امیرالمؤمنین و بعد میشه عالم اله و اسما و اینا که قبلاً بحثشو داشتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 263.68,
   "end": 267.16,
   "text": "در خود ما این شکلی بود دیگه. میگیم تمثل از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 267.16,
   "end": 268.8,
   "text": "رتبه مثالیه بحث اینجاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 268.8,
   "end": 272.9,
   "text": "قوه خیال همون برزخ وجودی‌مون یا رتبه مثالی‌مونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 272.9,
   "end": 276.94,
   "text": "این تمثلات چه در بیداری باشه چه در خواب باشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 276.94,
   "end": 280.56,
   "text": "همش و همش فعل نفسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 280.56,
   "end": 283.38,
   "text": "نفس این‌ها، این‌ها رو انشا می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 283.38,
   "end": 286.62,
   "text": "حالا نفس مرده‌ست یا زنده‌ست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 286.62,
   "end": 289.24,
   "text": "نفس حیه دیگه، زنده‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 289.24,
   "end": 296.12,
   "text": "درسته؟ مظهری‌ست از اسم الحی حضرت حق که شما الان حضرت عالی زنده هستید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 296.12,
   "end": 300.02,
   "text": "خب اگر نفس زنده‌ست فعلش هم زنده است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 300.02,
   "end": 302.5,
   "text": "یعنی فعل نفس هم حیات داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 302.5,
   "end": 306.7,
   "text": "یعنی اون تمثلات که شما تو قوه خیالت داری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 306.7,
   "end": 310.92,
   "text": "اونا حقیقت داره، اونا واقعی‌ت داره، اونا حیات داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 310.92,
   "end": 315.28,
   "text": "برای همین میگه امیرالمؤمنین می‌فرمود مراقب فکرت باش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 315.28,
   "end": 318.54,
   "text": "هر فکری رو نکن. این افکار حالا اون فکر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 318.54,
   "end": 327.26,
   "text": "منطقی رو ما، ما داریم میگیم‌ و اینا هم خیلی باید مراقبت کرد که انسان هر صورت و شکلی تو قوه خیالش متمثل نشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 327.26,
   "end": 331.36,
   "text": "هر خوابی رو نبینه. چرا میگه تسبیح حضرت زهرا قبل خواب بخون؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 331.36,
   "end": 335.82,
   "text": "برای اینکه جلوگیری می‌کنه از تمثلات بیخود اضافه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 335.82,
   "end": 340.96,
   "text": "قوه خیالو چرا میگه؟ دیروز که عزیزانی که ساعت سه بودند در بحث قلب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 340.96,
   "end": 348.48,
   "text": "مؤمن گفتیم حضرت علامه طباطبایی در کتاب سیر و سلوکش نفی خواطر رو میاره کنار فکر و ذکر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 348.48,
   "end": 351.86,
   "text": "اصلاً نمیشه بدون نفی خواطر رفت سمت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 351.86,
   "end": 355.92,
   "text": "تفکر که حرکت نفس است از معلومات به مجهولات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 355.92,
   "end": 362.48,
   "text": "و ذکر. اصلاً نمیشه. خاطری که آشوبه درش، خاطری که پر از متخیلات فاسده‌ست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 362.48,
   "end": 366.38,
   "text": "هرچی هم خلوت بکنه بازم همهمه تو وجودشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 366.38,
   "end": 368.88,
   "text": "پس میگه اول نفخ خواطر کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 368.88,
   "end": 370.48,
   "text": "خاطراتتو پاک‌سازی کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 370.48,
   "end": 374.12,
   "text": "تعلقاتتو بکن. حالا بحث چیز دیگه‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 374.12,
   "end": 377.18,
   "text": "بحث اینه که چون نفس زنده‌ست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 377.18,
   "end": 381.12,
   "text": "فعلش هم نفس زنده است و ما اون رو انتساب میدیم به نفس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 381.12,
   "end": 385.04,
   "text": "شما نفس رو ورداری چه فعلی، چه خوابی، چه تمثلی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 385.04,
   "end": 391.84,
   "text": "اصلاً امکانش نیست. شما وقتی می‌خوابی اون همه صور و اشکالی که در خواب می‌بینی اینا از کجاست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 391.84,
   "end": 394.76,
   "text": "مطلقاً انشائات نفس ناطقه خودته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 394.76,
   "end": 397.84,
   "text": "از بیرون نیومده که. شما خواب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 397.84,
   "end": 400.3,
   "text": "اینجا بدنت افتاده داری خواب می‌بینی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 400.3,
   "end": 404.3,
   "text": "هر جا هستی و هر کاری داری می‌کنی همه میگن آقا بدن شما اینجا بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 404.3,
   "end": 407.76,
   "text": "چرا علدی-- الکی ادعا می‌کنی که من حرم سید و شهدا بودم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 407.76,
   "end": 410.8,
   "text": "دروغ نگو. میگه آقا شما نمی‌فهمید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 410.8,
   "end": 413.8,
   "text": "من اینجا بودم اما در رتبه مثالی‌م سیر می‌کردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 413.8,
   "end": 417.9,
   "text": "با بدن مثالی‌م رفته بودم به حرم سید و شهدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 417.9,
   "end": 419.9,
   "text": "بله به واقع هم رفته بودی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 419.9,
   "end": 423.22,
   "text": "فعل نفسه و چون نفست حیات داره اونم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 423.22,
   "end": 428.2,
   "text": "ان دار الآخرة لهی الحيوان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 428.2,
   "end": 430.68,
   "text": "حالا برگرد به دار آخرت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 430.68,
   "end": 433.54,
   "text": "میگه اونجا هم یکپارچه حیاته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 433.54,
   "end": 438.14,
   "text": "چرا حیاته؟ مگر دار آخرت، مگر عالم برزخ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 438.14,
   "end": 441.64,
   "text": "رتبه مثالی آدم-- عالم نیست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 441.64,
   "end": 443.54,
   "text": "برش گردون به همین معرفت نفس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 443.54,
   "end": 448.08,
   "text": "همینطور که رتبه مثالی شما حیات داره، فعل نفسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 448.08,
   "end": 451.4,
   "text": "چون نفس حیات داره فعلش هم حیات داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 451.4,
   "end": 455.2,
   "text": "اون ور هم چون این‌ها شعون حضرت حق‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 455.2,
   "end": 456.92,
   "text": "اطوار وجودی حق‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 456.92,
   "end": 459.12,
   "text": "ظهور و بروز اسماء الهی هستند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 459.12,
   "end": 462.52,
   "text": "همه یکپارچه حق‌اند. همه یکپارچه حیات‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 462.52,
   "end": 468.36,
   "text": "حیات دارن. اصلاً شما یک شی، یک موجود از موجودات، از وجودات رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 468.36,
   "end": 470.68,
   "text": "پیدا نمی‌کنید که پرتو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 470.68,
   "end": 475.1,
   "text": "نور حضرت حق، وجود کلی صمدی قرآنی درش نباشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 475.1,
   "end": 476.84,
   "text": "یعنی اسماء الهی درش نباشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 476.84,
   "end": 479.04,
   "text": "اسم الحی خدا درش پیاده نشده باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 479.04,
   "end": 481.22,
   "text": "اصلاً پیدا نمی‌کنی. اگر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 481.22,
   "end": 483.3,
   "text": "نباشه که معدومه، موجود نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 483.3,
   "end": 485.7,
   "text": "درسته؟ حالا شما برگرد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 485.7,
   "end": 489.36,
   "text": "از، از مسیر سیر معرفت نفس رسم جلو که اینو بفهمین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 489.36,
   "end": 498.36,
   "text": "یه ذات غیبی داریم. همه‌ی اطوار وجودی ایشون، حضرت حق، ظهور و بروز اسماء و ملکات و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 498.36,
   "end": 501.32,
   "text": "کمالات وجودی حضرت حق‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 501.32,
   "end": 504.24,
   "text": "در-- یعنی تمام آسمان و زمین و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 504.24,
   "end": 507.08,
   "text": "ملک و ملکوت و همه ظهور",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 507.08,
   "end": 509.5,
   "text": "کمالات حضرت حق‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 509.5,
   "end": 511.82,
   "text": "در حقیقت خ--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 511.82,
   "end": 514.12,
   "text": "میشه اینطوری گفت عالم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 514.12,
   "end": 516.16,
   "text": "اطوار وجودی حقه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 516.16,
   "end": 519.2,
   "text": "طورهای مختلف حقه که ظهور کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 519.2,
   "end": 521.64,
   "text": "اسماء حق‌اند که ظهور کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 521.64,
   "end": 525.06,
   "text": "میگه که رتبه مثالی عالم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 525.06,
   "end": 529.56,
   "text": "شما-- خدا نفس داره یا نه؟ داره خدا نفس؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 529.56,
   "end": 532.0,
   "text": "بله. ما که داریم. خدا هم داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 532.0,
   "end": 534.86,
   "text": "شما درس دیروز بودی که حاضر جوابی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 534.86,
   "end": 537.82,
   "text": "اللهم عرفنی نفسک.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 537.82,
   "end": 540.76,
   "text": "یا تو قرآن می‌فرماید که یحضرکم الله نفسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 540.76,
   "end": 546.46,
   "text": "پس خدا نفس داره. اگر خدا نفس داره نفس الهی تمثلات داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 546.46,
   "end": 550.3,
   "text": "لذا گفتن به منزله، این منزله رو توجه کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 550.3,
   "end": 552.68,
   "text": "عالم به منزله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 552.68,
   "end": 556.3,
   "text": "بدن است برای نفس حضرت حق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 556.3,
   "end": 563.56,
   "text": "پس هرچه در عالم، چه در رتبه مثال، چه در رتبه‌ی عقل، چه در رتبه‌ی اله و اسماء الهی هست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 563.56,
   "end": 567.86,
   "text": "همش میشه چی؟ پرتویی از نور",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 567.86,
   "end": 570.4,
   "text": "لمعات جمال و جلال الهی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 570.4,
   "end": 572.52,
   "text": "اون ذات غیبی همه میشن ظهور.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 572.52,
   "end": 577.14,
   "text": "پس اینا همه زنده‌ن. حالا همه‌ی اینا پیاده شده از ذات غیبی‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 577.14,
   "end": 579.12,
   "text": "همه‌شون متصله به حضرت حق‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 579.12,
   "end": 584.48,
   "text": "از خدا جدا نیستند. هو معکم أينما كنتم هر کجا باشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 584.48,
   "end": 587.48,
   "text": "پس نتیجه، یه جمله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 587.48,
   "end": 590.86,
   "text": "پس کل من عند الله یعنی چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 590.86,
   "end": 594.28,
   "text": "یعنی همه‌ی اینا فعل حق‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 594.28,
   "end": 599.5,
   "text": "هر اتفاقی در عالم می‌افته، من و شما ظاهراً تلخ و شیرین می‌بینیمش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 599.5,
   "end": 602.5,
   "text": "من و شما ظاهراً شر و خیر می‌بینیمش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 602.5,
   "end": 604.9,
   "text": "مطلقاً خیر محضه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 604.9,
   "end": 608.8,
   "text": "حیات تفوره. من و شما نمی‌تونیم تحلیل نداریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 608.8,
   "end": 611.28,
   "text": "ضعیفیم. میگیم این شره، این بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 611.28,
   "end": 614.16,
   "text": "درصورتی که حتی خود شیطان هم شر نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 614.16,
   "end": 617.16,
   "text": "ذاتاً شر نیست. اگه شیطان نبود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 617.16,
   "end": 620.84,
   "text": "چه بهشتی؟ سگ پاسبان خداست که ما رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 620.84,
   "end": 623.56,
   "text": "پارس کنه ما رو بفرسته بهشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 623.56,
   "end": 625.48,
   "text": "اگه شب نبود روز چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 625.48,
   "end": 628.82,
   "text": "اگه ظلمت نبود نور چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 628.82,
   "end": 631.92,
   "text": "اگه شر نبود حسین رو چگونه ما بفهمیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 631.92,
   "end": 634.68,
   "text": "توجه کردی چی شد؟ خلاصه‌ش اینه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 634.68,
   "end": 638.26,
   "text": "همه چی فعل حقه. می‌رسیم به جمله حضرت زینب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 638.26,
   "end": 640.82,
   "text": "سلام ما رأيت إلا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 640.82,
   "end": 644.88,
   "text": "جمیلا. الان تازه می‌فهمیم بحث، بحث توحیدیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 644.88,
   "end": 651.32,
   "text": "احساسی و عاطفی نیست. حضرت زینب همه چی رو زیبا دید چون فعل حق می‌بینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 651.32,
   "end": 653.96,
   "text": "اما خب بستگی داره که از چه مجرایی پیاده بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 653.96,
   "end": 658.28,
   "text": "این اسماء جلال از سمت و ناحیه دشمن پیاده میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 658.28,
   "end": 661.7,
   "text": "اسماء جمال از سمت و ناحیه اهل ایمان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 661.7,
   "end": 664.18,
   "text": "انشاالله این بحث رو باز ادامه میدیم یه مقدار پخته‌تر بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 664.18,
   "end": 669.16,
   "text": "نترسید از این اصطلاحات. وازش می‌کنیم، صحبت می‌کنیم، یه مقدار گفت‌وگو می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 669.16,
   "end": 671.4,
   "text": "حرفای جدید اگر می‌شنوین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 671.4,
   "end": 673.94,
   "text": "این‌ها در حوزه ت--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 673.94,
   "end": 676.84,
   "text": "در حقیقت فرمایش رهبریه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 676.84,
   "end": 679.12,
   "text": "تبیین جهاده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 679.12,
   "end": 680.98,
   "text": "تبیین در حوزه معارفه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 680.98,
   "end": 683.04,
   "text": "دل بدید. خسته نشیم از این حرفا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 683.04,
   "end": 686.78,
   "text": "تا کی داستان و قصه بگیم؟ والحمد لله رب العالمين.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 686.78,
   "end": 689.84,
   "text": "صلوات بفرستین. الله. اللهُم صَلّ عَلَى",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}