 },
 "chapters": [
  {
   "index": 0,
   "title": "## قلهٔ بحث توحید افعالی؛ آیة‌الکرسی",
   "start": 13.94,
   "end": 43.5
  },
  {
   "index": 1,
   "title": "## روایت امام صادق؛ بخٍ بخٍ و برائت از آتش",
   "start": 43.5,
   "end": 160.06
  },
  {
   "index": 2,
   "title": "## چهار دسته آیات آویخته به عرش",
   "start": 160.06,
   "end": 255.6
  },
  {
   "index": 3,
   "title": "## صد بار آیة‌الکرسی؛ چون عبادت عمر",
   "start": 255.6,
   "end": 297.3
  },
  {
   "index": 4,
   "title": "## کافی؛ چهار آیهٔ اول و سه آیهٔ آخر بقره با آیة‌الکرسی",
   "start": 297.3,
   "end": 401.58
  },
  {
   "index": 5,
   "title": "## المیزان؛ سلسله توحید الوهی و قیومی و مالکی و شفاعتی",
   "start": 401.58,
   "end": 535.26
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 1.28,
   "end": 4.76,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 4.76,
   "end": 10.44,
   "text": "السلام علیک یا داعی الله و ربانی آیاته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 10.44,
   "end": 13.94,
   "text": "سلام علیکم و رحمه الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 13.94,
   "end": 19.36,
   "text": "در بحث توحید افعالی شاید امروز قله‌ی بحثمون باشه به جهت آیه‌ای که بهش می‌رسیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 19.36,
   "end": 26.58,
   "text": "یکی دیگه از- سلام علیکم. آیاتی که توحید افعالی رو به خوبی بیان می‌کنه آیه الکرسیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 26.58,
   "end": 29.92,
   "text": "آیه دویست و پنجاه و پنج سوره بقره‌ست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 29.92,
   "end": 34.54,
   "text": "که تسریش داده دو آیه بعدش رو هم بخونیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 34.54,
   "end": 38.94,
   "text": "اول از عظمت این آیه الکرسی چند تا روایت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 38.94,
   "end": 41.34,
   "text": "با سند تقدیم کنم بعد نکته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 41.34,
   "end": 45.2,
   "text": "توحید افعالی‌ش رو عرض کنم. در تفسیر اهل بیت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 45.2,
   "end": 51.52,
   "text": "جلد دو، صفحه دویست و نود از امام صادق صلی الله علیه روایته که سمع بعض آبایی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 51.52,
   "end": 55.36,
   "text": "شنیدم از بعض از پدرانم که رجلا یقرأ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 55.36,
   "end": 58.44,
   "text": "ام القرآن فقال شکر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 58.44,
   "end": 61.18,
   "text": "و اجر. شنید که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 61.18,
   "end": 65.18,
   "text": "یه شخصی سوره حمد رو خوند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 65.18,
   "end": 68.8,
   "text": "ام القرآن یعنی سوره حمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 68.8,
   "end": 72.06,
   "text": "فقال پدرم یعنی امام معصوم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 72.06,
   "end": 75.18,
   "text": "که امام صادق اینجا مشخص نکردن کدوم از پدرانشونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 75.18,
   "end": 77.38,
   "text": "بالاخره امام معصوم بودن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 77.38,
   "end": 81.3,
   "text": "گفتن اون سوره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 81.3,
   "end": 83.28,
   "text": "شکر رو خوند و اجر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 83.28,
   "end": 86.92,
   "text": "یعنی سوره حمد، سوره شکر و اجر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 86.92,
   "end": 89.3,
   "text": "ثم سمعه یقرأ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 89.3,
   "end": 94.48,
   "text": "قل هو الله احد. بعد شنید که یه کسی قل هو الله می‌خونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 94.48,
   "end": 98.5,
   "text": "فقال آمن و امن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 98.5,
   "end": 102.52,
   "text": "فرمود که امن است و امان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 102.52,
   "end": 105.44,
   "text": "هر کس این سوره رو می‌خونه این امن است و امان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 105.44,
   "end": 111.06,
   "text": "من سمعه. بعد فرمود سمعه یقرأ ان انزلنا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 111.06,
   "end": 115.62,
   "text": "شنید که کسی ان انزلنا می‌خونه فقال صدق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 115.62,
   "end": 118.22,
   "text": "و غفر له. یعنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 118.22,
   "end": 120.82,
   "text": "فرمود که راست گفت و آمرزیده شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 120.82,
   "end": 126.74,
   "text": "اینا آثارشا، یعنی داره میگه این آ-- این سوره رو بخونی چه آثاری داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 126.74,
   "end": 130.2,
   "text": "ثم سمعه یقرأ آیه الکرسی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 130.2,
   "end": 132.24,
   "text": "بعد شنید که یه کسی آیه الکرسی رو خوند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 132.24,
   "end": 137.1,
   "text": "فقال بخ بخ. یعنی به به، به قول ما فارسی‌ها به به.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 137.1,
   "end": 141.44,
   "text": "این نشون میده که چه عظمتی داره این آیه الکرسی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 141.44,
   "end": 145.46,
   "text": "نزلت براعه هذا من النار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 145.46,
   "end": 150.42,
   "text": "یعنی که این بیزاری از دوزخه براش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 150.42,
   "end": 153.44,
   "text": "براش نازل شد. نزلت براعه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 153.44,
   "end": 158.32,
   "text": "نازل شد براش انگار که برگه برات دوری از آتش جهنم بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 158.32,
   "end": 163.9,
   "text": "اینقدر- روایت دیگه المستدرک الوسائل، جلد پنج، صفحه پ--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 163.9,
   "end": 170.72,
   "text": "شصت و هفته. در نور الثقله، تفسیر برهان، تفاسیر روایی عموما اینجا هست این روایت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 170.72,
   "end": 176.46,
   "text": "که پیغمبر عزیز عالم، من خودم مدتی انجام دادم خیلی عجیب ثمرات داشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 176.46,
   "end": 179.76,
   "text": "خلاصه‌ش اینه که فرمودن وقتی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 179.76,
   "end": 184.7,
   "text": "چهار دسته آیات، یکی سوره حمد، یکی آیه الکرسی، یکی آیه شهد الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 184.7,
   "end": 186.54,
   "text": "شهد الله انه لا اله الا هو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 186.54,
   "end": 189.06,
   "text": "آیه عجیبیه. و آیه ملک.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 189.06,
   "end": 190.96,
   "text": "قل اللهم مالک الملك",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 190.96,
   "end": 195.28,
   "text": "توتی الملك من تشاء تنزع الملك ممن تشاء.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 195.28,
   "end": 201.8,
   "text": "این آیه. اینا به عرش آویخته موندن در حالی که هیچ حجابی بین اون‌ها و خدا نبود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 201.8,
   "end": 205.76,
   "text": "خدا دستور نزول و هبوطشونو داد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 205.76,
   "end": 209.66,
   "text": "اینا به خدا شکایت کردن که خدایا داریم ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 209.66,
   "end": 212.1,
   "text": "عصمت محضیم. ما پاک پاکیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 212.1,
   "end": 215.06,
   "text": "ما رو میخوای بفرستی بین مش گناهکار و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 215.06,
   "end": 219.88,
   "text": "آدم‌های آلوده و عاصی. خداوند متعال این چنین فرمود:",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 219.88,
   "end": 223.52,
   "text": "به عزت و جلالم سوگند هر بنده‌ای که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 223.52,
   "end": 226.7,
   "text": "پس از پایان تمام نمازها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 226.7,
   "end": 231.34,
   "text": "شما آیات را بخواند، یعنی شما چهار دسته رو که یکش آیه الکرسی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 231.34,
   "end": 233.94,
   "text": "در بهشت ساکن می‌کنم و با چشمان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 233.94,
   "end": 240.54,
   "text": "پنهانم روزی هفت بار به او نظر می‌کنم و در هر روز هفتاد حاجت او را برآورده می‌نمایم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 240.54,
   "end": 246.0,
   "text": "که مغفرت و بخشش کمترین آن است و او را از شر همه دشمنان پناه می‌دهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 246.0,
   "end": 251.72,
   "text": "و در مقابل دشمنانش او را یاری می‌کنم و فقط مرگ مانع ورود او به بهشت می‌شود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 251.72,
   "end": 254.04,
   "text": "یعنی به محض اینکه بمیره میره بهشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 254.04,
   "end": 258.62,
   "text": "اینم یه روایت. باز از تفسیر اهل بیت، جلد دو، صفحه بیست و--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 258.62,
   "end": 263.5,
   "text": "دویست و نود. بهار، جلد هشتاد و نه، صفحه دویست و شصت و سه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 263.5,
   "end": 266.22,
   "text": "پیغمبر عزیز عالم فرمودند من قرأ،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 266.22,
   "end": 269.0,
   "text": "من قرأ آیه الکرسی مع تمر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 269.0,
   "end": 272.04,
   "text": "هر که صد بار آیه الکرسی رو بخونه کان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 272.04,
   "end": 275.46,
   "text": "خیلی عجیبه، خیلی. به نظرتون اجرش چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 275.46,
   "end": 280.7,
   "text": "یعنی تأثیری که از نظر فلسفی، تأثیری که در نفس میذاره مثل چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 280.7,
   "end": 284.66,
   "text": "کان کمن عبد الله طول حیاتی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 284.66,
   "end": 288.44,
   "text": "مثل اینکه کل عمرش رو عبادت کرده خدا رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 288.44,
   "end": 292.24,
   "text": "الله اکبر. چه خبره تو این آیه الکرسی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 292.24,
   "end": 294.94,
   "text": "کافی- جان؟ دویست تا باید بخونه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 294.94,
   "end": 297.3,
   "text": "اگر کسی صد بار بخونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 297.3,
   "end": 300.62,
   "text": "کافی، جلد دو، صفحه دویست-- صفحه ششصد و بیست و یک.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 300.62,
   "end": 308.16,
   "text": "پیغمبر عزیز مشهد اسلام فرمودند من قرأ اربع آیات من اول البقره و آیه الکرسی و آیه این بعدها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 308.16,
   "end": 310.64,
   "text": "و ثلاث آیات من آخره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 310.64,
   "end": 314.18,
   "text": "لم یرفی نفسه و ماله شیئاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 314.18,
   "end": 319.1,
   "text": "تکرهه ولا يقربه شیطان و لا ینسي القرآن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 319.1,
   "end": 326.22,
   "text": "عجب خواصی داره. اگر کسی این دسته آیات رو بخونه و الان میگم چیه که یکیش آیه الکرسیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 326.22,
   "end": 328.86,
   "text": "پیغمبر عزیز عالم فرمودند که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 328.86,
   "end": 333.22,
   "text": "شیطان، شیطان نمی‌تونه نزدیکش بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 333.22,
   "end": 336.42,
   "text": "یک. بعد فرمود که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 336.42,
   "end": 340.46,
   "text": "لم یرفی نفسه و ماله شیئاً تکرهه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 340.46,
   "end": 347.34,
   "text": "هیچ چیزی به ما-- هیچ کراهتی بدی، زشتی، چیزی به خ-- نفس و جانش و مالش نمی‌خوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 347.34,
   "end": 350.9,
   "text": "و لا ینسي القرآن. قرآن هم فراموش نمی‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 350.9,
   "end": 354.14,
   "text": "حالا اونا چین؟ چهار آله-- آیه اول سوره بقره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 354.14,
   "end": 358.54,
   "text": "اینا رو باید با هم خوندن. چهار آیه اول سوره بقره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 358.54,
   "end": 364.22,
   "text": "سه آیه آخر سوره بقره، وسطش آیه الکرسی با دو آیه بعدش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 364.22,
   "end": 369.24,
   "text": "اینم قابل توجه اونایی که میگن آیه الکرسی همون تک آیه است دو آیه بعدشو نباید خوند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 369.24,
   "end": 373.68,
   "text": "نه، اینجا پیغمبر تسری می‌کنه با دو آیه بعد آیه الکرسی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 373.68,
   "end": 377.82,
   "text": "اینا رو با هم بخون و آثارش. بازم بگم دو سه تا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 377.82,
   "end": 379.48,
   "text": "حال دارید؟ وقت کمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 379.48,
   "end": 384.38,
   "text": "امام صادق وقت کمه. امام صادق صلی الله علیه فرمودن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 384.38,
   "end": 389.26,
   "text": "هر چیزی قله‌ای داره. قله قرآن آیه الکرسی‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 389.26,
   "end": 394.44,
   "text": "قله قرآن. حالا چیزای دیگه هم روایتای دیگه هم هست شما آثار میگن وقت کمه ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 394.44,
   "end": 401.26,
   "text": "میگیم چشم. روایتای دیگه هم آماده کردم در عظمت آیه الکرسی طرفه نظر می‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 401.26,
   "end": 404.02,
   "text": "خب این بخشی از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 404.02,
   "end": 409.96,
   "text": "فرمایش علامه طباطبایی هم بگم چون بحث ما توحید افعالی بود دیگه خوانش روایات نبود که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 409.96,
   "end": 413.82,
   "text": "علامه طباطبایی می‌فرماید تو آیه الکرسی سلسله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 413.82,
   "end": 417.64,
   "text": "مراتب صفات الهی و توحید رعایت شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 417.64,
   "end": 419.7,
   "text": "اول وحدانیت در الوهیته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 419.7,
   "end": 422.08,
   "text": "لا اله الا الله هو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 422.08,
   "end": 424.66,
   "text": "وحدانیت در چی؟ الوهیت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 424.66,
   "end": 427.92,
   "text": "لا اله الا هو لا اله الا هو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 427.92,
   "end": 430.52,
   "text": "بعد قیومیت که بدون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 430.52,
   "end": 432.86,
   "text": "قیومیت توحید تموم نمی‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 432.86,
   "end": 435.22,
   "text": "الحی القيوم. عجب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 435.22,
   "end": 438.22,
   "text": "از-- علامه فرمودن که بعید نیست اسم اعظم باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 438.22,
   "end": 445.6,
   "text": "الحی القيوم. برای تنویر قلوب، نورانی شدن قلوب، صفای باطن فرمودن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 445.6,
   "end": 447.86,
   "text": "یا حی یا قیوم یا ملا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 447.86,
   "end": 449.52,
   "text": "اله الا انت رو بخونید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 449.52,
   "end": 452.16,
   "text": "علامه فرمودن البته روایت امام صادق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 452.16,
   "end": 458.46,
   "text": "بعد میره سراغ مالکیت که اصلا قیومیت با مالکیت تموم می‌شه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 458.46,
   "end": 460.5,
   "text": "له ما في السماوات وما في الأرض.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 460.5,
   "end": 465.88,
   "text": "این مالکیت حقیقیه. اعتباری نیست که امروز این خونه مال منه فردا مال کسی دیگه است، نه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 465.88,
   "end": 469.54,
   "text": "همه چی کلا مالکیت مطلقه با خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 469.54,
   "end": 471.3,
   "text": "بعد توحید در شفاعته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 471.3,
   "end": 474.14,
   "text": "من ذا الذي يشفع عنده الا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 474.14,
   "end": 477.92,
   "text": "باذنه. حالا این جمله از علامه طباطبایی و السلام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 477.92,
   "end": 482.54,
   "text": "ذیل اینجا ذیل همین آیه من ذا الذي يشفع این هیچ کس نمی‌تونه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 482.54,
   "end": 485.04,
   "text": "شفاعت کنه الا باذنه مگر به اذن خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 485.04,
   "end": 492.62,
   "text": "این توحید افعالیه. علامه می‌فرماید علل و اسباب در مورد مسببات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 492.62,
   "end": 497.02,
   "text": "شفا دهندگانی هستند که به اذن خدا شفاعت می‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 497.02,
   "end": 500.98,
   "text": "این شفاعت هم می‌تواند تکوینی باشد هم تشریعی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 500.98,
   "end": 505.86,
   "text": "یعنی همه چی علل و اسباب اینا همه مسبب الاسباب خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 505.86,
   "end": 510.68,
   "text": "همه چی دست خداست. خدا بخواد تو شفا می‌گیری نخواد نمی‌گیری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 510.68,
   "end": 517.08,
   "text": "همه چی دست خداست. یعنی سرتاسر آیه الکرسی رو نگاه می‌کنی همش یه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 517.08,
   "end": 519.42,
   "text": "توحید الوهی، توحید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 519.42,
   "end": 524.74,
   "text": "در قیومیت، مالکیت، در شفاعت، یکپارچه توحید افعالیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 524.74,
   "end": 526.44,
   "text": "بخونید و لذتشو ببرید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 526.44,
   "end": 529.02,
   "text": "ما هم دعا کنید. الحمد لله رب العالمین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 529.02,
   "end": 531.58,
   "text": "صلوات ختم کنید. اللهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 531.58,
   "end": 535.26,
   "text": "صل علی محمد و آل محمد و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}