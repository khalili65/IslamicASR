   "start": 18.38,
   "end": 70.64
  },
  {
   "index": 1,
   "title": "## لکنا هو الله ربی؛ سه اسم شریف",
   "start": 70.64,
   "end": 164.68
  },
  {
   "index": 2,
   "title": "## آیهٔ آخر کهف؛ عمل صالح و نفی شرک",
   "start": 164.68,
   "end": 205.14
  },
  {
   "index": 3,
   "title": "## ما شاء الله لا قوة إلا بالله",
   "start": 205.14,
   "end": 335.54
  },
  {
   "index": 4,
   "title": "## سفارش امام صادق؛ هزار و چهل‌وشش",
   "start": 335.54,
   "end": 381.32
  },
  {
   "index": 5,
   "title": "## آب فرو رفته در زمین",
   "start": 381.32,
   "end": 538.42
  },
  {
   "index": 6,
   "title": "## دو روایت؛ تفکیک دو ذکر",
   "start": 538.42,
   "end": 558.6
  },
  {
   "index": 7,
   "title": "## ادب و تخلق",
   "start": 558.6,
   "end": 660.6
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.54,
   "end": 8.88,
   "text": "بسم الله الرحمن الرحیم و به این استعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 8.88,
   "end": 14.3,
   "text": "السلام علیک یا داعی الله و ربانی آیات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 14.3,
   "end": 18.38,
   "text": "سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 18.38,
   "end": 21.56,
   "text": "در سلسله آیات سی و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 21.56,
   "end": 24.2,
   "text": "هفت سوره کهف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 24.2,
   "end": 36.7,
   "text": "برو تا چهل و پنج تقریبا این چند تا آیه رو بر-بررسی کنید ببینید چقدر قشنگ موضوع توحید افعالی بیان شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 36.7,
   "end": 40.64,
   "text": "در آیه سی و هفت می فرماید: قال له صاحبه وهو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 40.64,
   "end": 44.1,
   "text": "يحاوره أكفرت بالذي خلقك",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 44.1,
   "end": 46.98,
   "text": "من ترابٍ ثم من نطفةٍ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 46.98,
   "end": 50.04,
   "text": "ثم سواك رجلا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 50.04,
   "end": 54.34,
   "text": "این دو تا با هم حالا اون صاحبه و منظور رفیقه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 54.34,
   "end": 57.8,
   "text": "این دو تا رفیق با هم بودند که حالا رفاقت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 57.8,
   "end": 59.78,
   "text": "مذهبی با هم نداشتند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 59.78,
   "end": 64.66,
   "text": "ظاهراً همسایه بودند. یکیشون فقیر مؤمن بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 64.66,
   "end": 67.98,
   "text": "یکیشون غنی کافر بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 67.98,
   "end": 70.02,
   "text": "حالا یه آشنایی ای بین این‌ها بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 70.02,
   "end": 73.74,
   "text": "از سیاق آیه این چنین برمی‌آد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 73.74,
   "end": 75.86,
   "text": "اینا با هم گفت‌وگو می‌کردند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 75.86,
   "end": 78.36,
   "text": "يحاوره يعني گفت‌وگو می‌کردند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 78.36,
   "end": 82.02,
   "text": "اون رفیق مؤمن به اون یکی گفت که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 82.02,
   "end": 84.7,
   "text": "آیا آنکه تو را از خاک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 84.7,
   "end": 87.32,
   "text": "سپس از نطفه آفرید،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 87.32,
   "end": 91.78,
   "text": "آنگاه تو را به صورت مردی درست و نیکو درآورد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 91.78,
   "end": 94.78,
   "text": "ثم سواك رجلا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 94.78,
   "end": 98.34,
   "text": "أكفرت آیا کافر شدی به همچین کسی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 98.34,
   "end": 100.82,
   "text": "که اصلاً خالق توئه این مراحل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 100.82,
   "end": 108.26,
   "text": "خلقت رو از اون آب و ناری که پدر مادر خوردند و جمادی بود آورده تو رو به این عظمت آفریده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 108.26,
   "end": 111.44,
   "text": "که وصل به ملکوت عالم شدی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 111.44,
   "end": 113.36,
   "text": "این گفت‌وگو بینشون صورت می‌گیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 113.36,
   "end": 116.36,
   "text": "بعد آیه بعد آیه سی و هشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 116.36,
   "end": 121.26,
   "text": "لکنا اون لکنا مخفف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 121.26,
   "end": 124.64,
   "text": "لکن أنا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 124.64,
   "end": 127.9,
   "text": "لکنا هو الله ربی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 127.9,
   "end": 131.76,
   "text": "ولا أشرک بربی أحدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 131.76,
   "end": 134.8,
   "text": "ولی من به شخص اقرار دارم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 134.8,
   "end": 137.34,
   "text": "که هو الله ربی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 137.34,
   "end": 140.86,
   "text": "اون الله پروردگار منه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 140.86,
   "end": 144.18,
   "text": "پیداست که این مؤمن خیلی هم حالیش بوده اتفاقاً.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 144.18,
   "end": 147.8,
   "text": "از سه تا اسم بسیار شریف و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 147.8,
   "end": 149.48,
   "text": "عزیز خدا استفاده کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 149.48,
   "end": 151.6,
   "text": "هو که اشاره به ذات داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 151.6,
   "end": 154.42,
   "text": "چون قبل از الله اومده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 154.42,
   "end": 158.52,
   "text": "الله و رب. پیداست مؤمن، مؤمن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 158.52,
   "end": 162.82,
   "text": "کمی نبوده. توانمند بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 162.82,
   "end": 167.74,
   "text": "می-می‌فرمود که در حالی که من قبول دارم اون پروردگار منه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 167.74,
   "end": 169.96,
   "text": "ولا أشرک بربی أحدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 169.96,
   "end": 175.18,
   "text": "این نشون میده شما دقت کنید آیات قرآن رو اصلاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 175.18,
   "end": 178.94,
   "text": "توحید و باور ربوبیت حق تعالی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 178.94,
   "end": 182.72,
   "text": "هیچ جا نیست مگر در کران- کنار نفی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 182.72,
   "end": 186.66,
   "text": "شرک. ببینید هو الله ربی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 186.66,
   "end": 189.48,
   "text": "می‌تونست تا همین جا بگه تمومش کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 189.48,
   "end": 191.74,
   "text": "الله پروردگار منه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 191.74,
   "end": 194.52,
   "text": "اما ولا أشرک بربی أحدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 194.52,
   "end": 199.68,
   "text": "مطلقا من اه-احدا و ابدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 199.68,
   "end": 204.66,
   "text": "شرک به خدا قائل نیستم. دویت رو اصلا باور ندارم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 204.66,
   "end": 209.2,
   "text": "مثل اون آیه ساعت کوکی اهل ایمان هست که هر وقت بخوای ملائکه بیدار می‌شن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 209.2,
   "end": 212.18,
   "text": "آیه آخر سوره همین سوره کهف آیه آخرش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 212.18,
   "end": 216.86,
   "text": "قل إنما أنا بشر مثلكم يوحى إلي أنما آلهتكم إلا الله واحد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 216.86,
   "end": 219.1,
   "text": "فمن كان يرجو لقاء ربه فليعمل عملا صالحا ولا يشرك بعبادة ربه أحدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 219.1,
   "end": 221.52,
   "text": "اگر کسی دوست داره که بره به پر--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 221.52,
   "end": 226.16,
   "text": "لیاقت پیدا کنه ملاقات کنه پروردگارشو دو تا کار باید انجام بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 226.16,
   "end": 231.96,
   "text": "فليعمل عملا صالحا که قبلاً عرض کردیم در تفاسیر این عمل صالح رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 231.96,
   "end": 235.88,
   "text": "معرفت الامام یا معیت با امام شمردند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 235.88,
   "end": 239.3,
   "text": "ولا يشرک بعبادة ربه أحدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 239.3,
   "end": 242.04,
   "text": "ببینید باز شرک رو نفی می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 242.04,
   "end": 246.66,
   "text": "نمیشه اصلاً محاله کسی بوی شرک بده وجودش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 246.66,
   "end": 250.06,
   "text": "بعد بخواد به خدا قرب پیدا کنه یا توحیدش ناب باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 250.06,
   "end": 253.98,
   "text": "اصلاً امکانش نیست. و نکته دیگه اینکه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 253.98,
   "end": 257.46,
   "text": "حالا آیه بعدم بخونیم. آیه سی و نه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 257.46,
   "end": 260.08,
   "text": "سی و هفت و هشت رو خوندیم حالا سی و نه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 260.08,
   "end": 269.06,
   "text": "ولولا إذ دخلت جنتك قلت ما شاء الله لا قو- لا قوة إلا بالله إن ترني أنا أقل منك مالا و ولدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 269.06,
   "end": 272.52,
   "text": "این رفیق مؤمن به اون یکی گفته که چرا وقتی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 272.52,
   "end": 275.04,
   "text": "رفتی وارد باغ خودت شدی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 275.04,
   "end": 279.12,
   "text": "نگفتی ما شاء الله لا قوة إلا بالله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 279.12,
   "end": 282.16,
   "text": "عجب ش- ذکر شریفی هم هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 282.16,
   "end": 287.02,
   "text": "که اگر این چنین می‌گفتی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 287.02,
   "end": 290.6,
   "text": "که الان می‌خواد بگه که این چنین می‌گفتی این بلا سرت نمی‌اومد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 290.6,
   "end": 294.62,
   "text": "حالا عرض می‌کنم چه بلایی هست. بعد می‌فرمود که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 294.62,
   "end": 298.66,
   "text": "إن ترني. اگر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 298.66,
   "end": 303.9,
   "text": "إن ترني اگر تو ببینی أنا أقل منك مالا و ولدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 303.9,
   "end": 308.56,
   "text": "حالا که تو منو ظاهراً از حیث مال و فرزند کمتر از خودت می‌بینی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 308.56,
   "end": 312.46,
   "text": "أقل منك. این خودش یه نکته‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 312.46,
   "end": 315.84,
   "text": "میگه إن ترني. اگر تو می‌بینی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 315.84,
   "end": 321.6,
   "text": "من خودم اینطوری نیستما. به جهت اینکه مالم کمه فرزندم کمه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 321.6,
   "end": 323.22,
   "text": "احساس حوارت ندارما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 323.22,
   "end": 326.24,
   "text": "إن ترني تو اینطوری می‌بینی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 326.24,
   "end": 328.86,
   "text": "من پشتم گرمه به چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 328.86,
   "end": 335.54,
   "text": "الله که هو ربي. این ذکر اتفاقاً همون ذکر شریفیست که چند بار سفارش کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 335.54,
   "end": 341.2,
   "text": "امام صادق صلوات الله علیه فرمود: تعجبم از کسانی که دنبال رونق دنیاشونن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 341.2,
   "end": 343.54,
   "text": "در حالی که از این ذکر قرآنی غافلن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 343.54,
   "end": 347.64,
   "text": "و اشاره به همین آیه کردن. ما شاء الله لا قوة",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 347.64,
   "end": 350.42,
   "text": "إلا بالله. عددش هم چقدر بود یادتونه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 350.42,
   "end": 353.7,
   "text": "هزار و چهل و شش. احسن. هزار و چهل و شش بار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 353.7,
   "end": 356.52,
   "text": "بزرگان فرمودن کسی هر روز بگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 356.52,
   "end": 361.8,
   "text": "امورات دنیوی‌ش خدا کفایت می‌کنه و انشاالله رونق می‌گیره دنیوی‌ش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 361.8,
   "end": 366.24,
   "text": "این فرمایش امام صادره. تو مفاتیح هم شیخ عباس آورده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 366.24,
   "end": 369.48,
   "text": "بعد میگه اینو نگفتی، اینو نگفتی باغت سوخت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 369.48,
   "end": 371.84,
   "text": "چون میدونید باغش می‌سوزه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 371.84,
   "end": 378.78,
   "text": "صبح پا میشه می‌بینه که کلاً دار و درخت از بین رفته، میوه‌ها از بین رفته، این داربست‌ها همه ریخته،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 378.78,
   "end": 381.32,
   "text": "آتیش گرفته، هیچ اثری نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 381.32,
   "end": 383.02,
   "text": "آیه چهل هم دقت کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 383.02,
   "end": 388.7,
   "text": "\"فعسی ربی أن يؤتی خيرا من جنتك ويرسل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 388.7,
   "end": 392.86,
   "text": "عليها حسبانا من السماء فتصبح",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 392.86,
   "end": 401.2,
   "text": "صعيدا زلقا\" میگه که امیدوارم که- امید دارم که پروردگارم یه باغ بهتر از تو به من عطا کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 401.2,
   "end": 406.24,
   "text": "و از آسمان آسیب دقیق و حساب شده‌ای به باغت بفرسته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 406.24,
   "end": 409.44,
   "text": "تا مثل یه زمین صاف و بی گیاه بشه، تبدیل بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 409.44,
   "end": 415.76,
   "text": "این پیداست که مهاجعه این دو تا به هم به جای باریک می‌کشه که اینطوری نفرین می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 415.76,
   "end": 420.66,
   "text": "قشنگ مشخصه از باطن آیه که گفت این گفت و گو که اون نمی‌پذیره، زیر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 420.66,
   "end": 424.12,
   "text": "بار نمیره و اینو مسخره می‌کنه و برو بابا جمع کن کاسه و کوزه‌ت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 424.12,
   "end": 427.92,
   "text": "مثل الان که اهل ایمان رو چقدر تحقیر می‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 427.92,
   "end": 433.06,
   "text": "نکته دیگه اینکه چقدر خوبه که حتی آدم اگر از جهت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 433.06,
   "end": 435.96,
   "text": "شئونات اجتماعی دون پایه است،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 435.96,
   "end": 441.18,
   "text": "به قول مدیران امروز میان به رعیت یه جور دیگه‌ای نگاه می‌کنند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 441.18,
   "end": 446.32,
   "text": "اما مطلقا و ابدا احساس حقارت نکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 446.32,
   "end": 450.8,
   "text": "حتی با قدرتمندان و ثروتمندان هم وقتی مواجه میشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 450.8,
   "end": 453.76,
   "text": "ارشادش رو انجام بده، محکم حرفش رو بزنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 453.76,
   "end": 456.12,
   "text": "از اهدی نترسه. این نکاتیه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 456.12,
   "end": 461.32,
   "text": "در آیه هست. خیلی زیبا. یه روایت، دو تا روایت هم تقدیم کنم برای امروز بسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 461.32,
   "end": 467.92,
   "text": "البته آیه چهل و یک هم که می‌فرمود: \"أو يصبح ماؤها غورا\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 467.92,
   "end": 470.84,
   "text": "یا اینکه آبش \"يصبح",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 470.84,
   "end": 477.44,
   "text": "ماؤها غورا\". غور یعنی آب، آب زمین تو نه همه کلاً آب اون ق-قنات‌ها و رودها نه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 477.44,
   "end": 479.84,
   "text": "آبی که تو زمین توئه بره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 479.84,
   "end": 482.96,
   "text": "بره وارد زمین بشه ته تموم بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 482.96,
   "end": 486.12,
   "text": "\"فلن تستطيع له طلبا\" هرچی بخواید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 486.12,
   "end": 488.82,
   "text": "زور بزنین آب رو استخراج کنین، نتونین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 488.82,
   "end": 490.9,
   "text": "چه نفرینی کرده به همین هم نمی‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 490.9,
   "end": 493.98,
   "text": "نفرینه اصلاً درست بوده از طرف یعقوب علیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 493.98,
   "end": 496.4,
   "text": "السلام؟ حالا اون درخت موجود زنده بوده بالاخره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 496.4,
   "end": 502.92,
   "text": "چرا نفرین کرد به اون موجود زنده که- سعادوت، سعادت اون درخت همینه که از دست یه کافر نجات پیدا کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 502.92,
   "end": 507.42,
   "text": "اصلاً بسوزه از بین بره. بله یعنی کمال اون درخت اصلاً در همینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 507.42,
   "end": 510.2,
   "text": "مثل گوسفند می‌کشنش می‌خورنش دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 510.2,
   "end": 515.18,
   "text": "بدتر از این. حالا ظاهراً اون نفس نباتیه درد نمی‌کشه ظاهراً.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 515.18,
   "end": 518.2,
   "text": "گوسفند که درد می‌کشه اما کمالش در اینه که بخوریش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 518.2,
   "end": 521.22,
   "text": "اونم مؤمن بخورش، نه کافر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 521.22,
   "end": 523.28,
   "text": "حالا اینجا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 523.28,
   "end": 531.26,
   "text": "تو تشریف بیارید بعد از کلاس دم در خدمتون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 531.26,
   "end": 534.88,
   "text": "عملاً. بله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 534.88,
   "end": 538.42,
   "text": "خدا به شما سلامت بده. دو تا روایت هم تقدیم کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 538.42,
   "end": 545.72,
   "text": "در تفسیر در المنصور دیدم پیغمبر اعزی الله علیه وسلم فرمود: هر nemati که خدا از مال و فرزند،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 545.72,
   "end": 549.28,
   "text": "از مال و فرزندان به کسی می‌بخشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 549.28,
   "end": 551.68,
   "text": "اگه بهش بگه با اون نعمت‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 551.68,
   "end": 553.68,
   "text": "بگه ماشاءالله لا قوة",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 553.68,
   "end": 558.04,
   "text": "إلا بالله دقت بفرمایید که اون لا حول ولا قوة إلا بالله تو دعاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 558.04,
   "end": 561.9,
   "text": "اینجا این ذکر قرآنی لا حول نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 561.9,
   "end": 567.38,
   "text": "پیغمبر فرمود اگر به نعمت‌هاش بگه ماشاءالله لا قوة إلا بالله خداوند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 567.38,
   "end": 571.72,
   "text": "آفات و ناراحتی‌ها را از او دفع می‌کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 571.72,
   "end": 576.96,
   "text": "تا به آرزوش برسه. بعد اشاره به همین آیه کردن پیغمبر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 576.96,
   "end": 579.34,
   "text": "ذیل این آیه این رو فرمودن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 579.34,
   "end": 581.94,
   "text": "پس اگه کسی می‌خواد از آفات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 581.94,
   "end": 586.02,
   "text": "دنیا، مال، فرزند اینا در امان بشه چه اشکالی داره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 586.02,
   "end": 590.3,
   "text": "هر روز تو خونه، تو محل کسبت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 590.3,
   "end": 593.02,
   "text": "این آیه رو بخون یا به بچه‌هات بخون بدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 593.02,
   "end": 595.96,
   "text": "همه دفع-- آفات دفع میشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 595.96,
   "end": 599.88,
   "text": "و انشاالله به آرزوهات می‌رسی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 599.88,
   "end": 604.86,
   "text": "و روایت دوم از تفسیر کنز الدقایق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 604.86,
   "end": 608.26,
   "text": "باز پیغمبر اعزی الله علیه وسلم فرمودند که اگه می‌خوای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 608.26,
   "end": 612.42,
   "text": "دفع بلا و دوام نعمت داشته باشی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 612.42,
   "end": 616.48,
   "text": "و به گنجی از گنج‌های بهشت دسترسی پیدا کنی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 616.48,
   "end": 621.94,
   "text": "غافل نباش از این ذکر. اینجا با این نیت‌ها این ذکره دیگه دعاییه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 621.94,
   "end": 625.16,
   "text": "میشه لا حول ولا قوة إلا بالله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 625.16,
   "end": 628.74,
   "text": "این ذکری که پیغمبر فرمود. اون ماشاءالله لا قوة",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 628.74,
   "end": 632.34,
   "text": "إلا بالله. این لا حول ولا قوة إلا بالله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 632.34,
   "end": 635.98,
   "text": "اینا یه وقت اشتباه نشه. این دومیش کار می‌کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 635.98,
   "end": 640.1,
   "text": "این سبب دفع بلا، دوام نعمت و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 640.1,
   "end": 642.86,
   "text": "گنجی از گنج‌های بهشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 642.86,
   "end": 648.22,
   "text": "انشاالله هممون مؤدب به آداب الهی باشیم، متخلق به اخلاق الهی باشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 648.22,
   "end": 651.78,
   "text": "اللهم بارک لمولانا صاحب الزمان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 651.78,
   "end": 653.92,
   "text": "والحمد لله رب العالمين.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 653.92,
   "end": 659.7,
   "text": "صلوات الله علیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 659.7,
   "end": 660.6,
   "text": "اللهم صل على محمد وآل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}