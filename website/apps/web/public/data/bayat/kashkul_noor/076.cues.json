   "title": "## آستانهٔ شعبان و صلوات",
   "start": 15.46,
   "end": 36.02
  },
  {
   "index": 1,
   "title": "## دستور صلوات نخودکی از سوم تا نیمه",
   "start": 36.02,
   "end": 236.52
  },
  {
   "index": 2,
   "title": "## توحید افعالی؛ حجر ۶۶",
   "start": 236.52,
   "end": 378.71
  },
  {
   "index": 3,
   "title": "## محیی و ممیت آن‌به‌آن",
   "start": 378.71,
   "end": 445.63
  },
  {
   "index": 4,
   "title": "## سجدتین نماز؛ نقشهٔ احیا و اماته",
   "start": 445.63,
   "end": 711.29
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 2.3,
   "end": 7.18,
   "text": "بسم الله الرحمن الرحیم و به این استعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 7.18,
   "end": 10.98,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 10.98,
   "end": 15.46,
   "text": "آیات. سلامٌ علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 15.46,
   "end": 20.38,
   "text": "در آستانه ماه شریف شعبان هستیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 20.38,
   "end": 24.1,
   "text": "پیشاپیش تبریک میگیم. ماهی است که یک شهادت هم درش نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 24.1,
   "end": 28.2,
   "text": "همه سراسر نور و سرور و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 28.2,
   "end": 31.92,
   "text": "بهجت و میلاده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 31.92,
   "end": 39.36,
   "text": "یکی از بهترین کارها بلکه میشه گفت بهترین دستوراتی که دادن در خصوص ماه شعبان صلواته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 39.36,
   "end": 48.3,
   "text": "تا میتونه انسان خدا رحمت کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 48.3,
   "end": 50.54,
   "text": "یه هدیه هم می‌خوایم خدمت شما تقدیم کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 50.54,
   "end": 55.22,
   "text": "خواستیم فردا به خدمت عزیزان مسجد بلال در کلاس معرفت نفس بگیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 55.22,
   "end": 57.2,
   "text": "حالا به دلمون افتاد به شما هم تقدیم کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 57.2,
   "end": 59.5,
   "text": "دوست داشتید انجام بدید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 59.5,
   "end": 63.6,
   "text": "ما که انجام دادیم برکت خاصی دیدیم ازش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 63.6,
   "end": 68.18,
   "text": "محضر حضرت آیت الله آشیخ عبد القاسم شوشتری که رسیدیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 68.18,
   "end": 72.0,
   "text": "اصفهان ما میرفتیم محضرشون درس می‌گرفتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 72.0,
   "end": 75.48,
   "text": "ایشون شاگرد بلا فصل مرحوم آقای حافظیان بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 75.48,
   "end": 78.4,
   "text": "می‌دونید مرحوم آقای حافظیان هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 78.4,
   "end": 82.0,
   "text": "شاگرد بلا فصل مرحوم آقای نخودکی اصفهانی بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 82.0,
   "end": 86.14,
   "text": "مرحوم آ-آقای نخودکی هرچی که داشت بخشید به آقای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 86.14,
   "end": 89.56,
   "text": "حافظیان. ایشون هم بخشید به آقای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 89.56,
   "end": 92.34,
   "text": "شوشتری. اینو گفتم که بدونید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 92.34,
   "end": 95.74,
   "text": "از چه کسی دارم نقل قول می‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 95.74,
   "end": 100.26,
   "text": "ایشون فرمودن که از روز سوم شعبان شروع کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 100.26,
   "end": 102.2,
   "text": "یک دستور العملی هست که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 102.2,
   "end": 105.66,
   "text": "خدای نخودکی این دستور رو به شاگرداشون،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 105.66,
   "end": 108.1,
   "text": "خواص شاگرداشون می‌دادن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 108.1,
   "end": 111.84,
   "text": "از روز سوم شعبان تا نیمه شعبان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 111.84,
   "end": 114.04,
   "text": "شروع کنید روز اول هزار صلوات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 114.04,
   "end": 119.34,
   "text": "البته تسبیحی رو بردارید که این تسبیح تا حالا باهاش ذکر نگفته باشه کسی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 119.34,
   "end": 122.54,
   "text": "یعنی نو باشه. خرید تازه بخرید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 122.54,
   "end": 125.32,
   "text": "روز سوم شعبان، ترجیحاً س--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 125.32,
   "end": 128.94,
   "text": "مکان و زمان ثابت باشه اثرش بیشتره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 128.94,
   "end": 132.04,
   "text": "روز اول هزار تا صلوات هدیه می‌کنید به پیغمبر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 132.04,
   "end": 136.02,
   "text": "روز دوم که میشه چهارم شعبان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 136.02,
   "end": 138.36,
   "text": "هزار صلوات هدیه می‌کنید به امیرالمؤمنین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 138.36,
   "end": 142.04,
   "text": "همینطوری نیمه شعبان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 142.04,
   "end": 145.88,
   "text": "می‌رسه به امام عسکری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 145.88,
   "end": 148.9,
   "text": "امام عسکری هزار صلوات هدیه می‌کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 148.9,
   "end": 152.5,
   "text": "دیگه به امام عصر رو گرو نگه می‌دارید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 152.5,
   "end": 156.6,
   "text": "تسبیح رو جایی که رو به قبله باشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 156.6,
   "end": 161.56,
   "text": "یعنی الان میشه اینجا، اینجا رو به قبله می‌خوایم بگیم مثلا اینجا میشه رو به قبله،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 161.56,
   "end": 164.88,
   "text": "رو به قبله به میخی جایی آویزون می‌کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 164.88,
   "end": 168.82,
   "text": "دست بهش نمی‌زنید تا انشاالله حاجتتونو بگیرید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 168.82,
   "end": 173.24,
   "text": "هر وقت که حاجتتونو گرفتید تسبیح رو از اونجا برمی‌دارید و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 173.24,
   "end": 177.36,
   "text": "هزار تا صلوات هدیه به امام عصر می‌کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 177.36,
   "end": 180.24,
   "text": "خیلی دستور شیرین و قشنگیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 180.24,
   "end": 182.64,
   "text": "اگر یه وقت کسی این کارو کرد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 182.64,
   "end": 188.32,
   "text": "سوم شعبان سال بعد رسید هنوز حاجت نگرفته، تسبیح رو برداره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 188.32,
   "end": 191.6,
   "text": "و هزار تا صلواتش رو سال حضرت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 191.6,
   "end": 194.34,
   "text": "صاحب الامر انجام بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 194.34,
   "end": 197.5,
   "text": "به یک، به چه دلیلی؟ به دلیل اینکه یا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 197.5,
   "end": 200.9,
   "text": "صلاحش نبوده این رو بهش بدن یا وقتش نرسیده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 200.9,
   "end": 205.7,
   "text": "بنده خودم یه بار انجام دادم دو سال بعد حاجتمو گرفتم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 205.7,
   "end": 210.06,
   "text": "یعنی نشون داد که زمانش باید برسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 210.06,
   "end": 213.26,
   "text": "اما در توحید افعالی هم نکته‌ای رو عرض کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 213.26,
   "end": 220.74,
   "text": "بی‌بهره نباشیم. آیه شصت و شش سوره حجر می‌فرماید و هو الذي احیاکم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 220.74,
   "end": 224.62,
   "text": "ثم یمیتکم ثم یحییکم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 224.62,
   "end": 228.0,
   "text": "پروردگار سبحان خودش رو در این آیه اینچنین معرفی کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 228.0,
   "end": 232.14,
   "text": "او کسیست که به شما حیات بخشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 232.14,
   "end": 236.52,
   "text": "احیاکم. مثلا حیات شما به دست اوست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 236.52,
   "end": 239.12,
   "text": "هو الذي احیاکم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 239.12,
   "end": 241.62,
   "text": "خب این حیات تا کیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 241.62,
   "end": 244.64,
   "text": "ثم یمیتکم. بعد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 244.64,
   "end": 249.86,
   "text": "شما رو می‌میرانه. به حقیقت موت شما رو می‌رسونه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 249.86,
   "end": 251.86,
   "text": "که ب-برید به نشئه بعدی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 251.86,
   "end": 255.74,
   "text": "برید به مرحله یا رتبه بعدی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 255.74,
   "end": 257.52,
   "text": "که قیامتتون آغاز بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 257.52,
   "end": 260.6,
   "text": "اون قوس نزول که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 260.6,
   "end": 266.1,
   "text": "ان الله اومد که ملا صدرا از اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 266.1,
   "end": 273.36,
   "text": "در رساله مبدأ و معادش از اون به لیلة القدر یاد می‌کنه، از اومدنتون به این دنیا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 273.36,
   "end": 276.38,
   "text": "و شروع قوس صعود رو می‌گیره قیامت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 276.38,
   "end": 278.44,
   "text": "قیامت صغری رو. الان ما درشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 278.44,
   "end": 282.38,
   "text": "قیامت کبرا هم که وقت موت حاصل میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 282.38,
   "end": 284.74,
   "text": "ثم ی-یمیتکم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 284.74,
   "end": 288.44,
   "text": "پس ما می‌میریم. قطعاً می‌میریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 288.44,
   "end": 291.06,
   "text": "حال اینکه تمام اولیا و انبیا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 291.06,
   "end": 293.28,
   "text": "مردن، رفتن و موت رو چشیدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 293.28,
   "end": 296.48,
   "text": "کل نفس ذائقة الموت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 296.48,
   "end": 299.1,
   "text": "کی این موت رو در ما پیاده می‌کنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 299.1,
   "end": 301.82,
   "text": "هو الذي. این توحید افعالیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 301.82,
   "end": 303.62,
   "text": "یعنی خداست که می‌میرانه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 303.62,
   "end": 308.0,
   "text": "بله. الله يتوفى الأنفاس حين موتها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 308.0,
   "end": 310.16,
   "text": "الله. حضرت عزرائیل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 310.16,
   "end": 312.3,
   "text": "خادمه. جزو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 312.3,
   "end": 316.1,
   "text": "خدمه و صدنه حضرت حقه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 316.1,
   "end": 321.26,
   "text": "الله می‌میرانه. بعد دو مرتبه ثم یحییکم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 321.26,
   "end": 325.54,
   "text": "باز هم شما رو احیا می‌کنه، حیات می‌بخشه، زنده‌تون می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 325.54,
   "end": 328.18,
   "text": "عزیزان بعد از این دنبال آیه شایسته هم باشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 328.18,
   "end": 331.64,
   "text": "شصت و شش سوره حجر. ان الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 331.64,
   "end": 334.96,
   "text": "حالا با-- اینجا خدای من ان الانسان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 334.96,
   "end": 337.76,
   "text": "خدای من اینجا یه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 337.76,
   "end": 341.64,
   "text": "آهی که ان از دل خدا بلند میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 341.64,
   "end": 349.0,
   "text": "با اینکه شما می‌بینید خداست که به دنیا میاره، خداست که می‌میرانه و دو مرتبه خداست که شما رو زنده می‌کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 349.0,
   "end": 351.4,
   "text": "باز چی؟ ان الانسان لکفور.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 351.4,
   "end": 353.1,
   "text": "اون لامش که تأکیده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 353.1,
   "end": 356.2,
   "text": "لکفور حتما اینطوریه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 356.2,
   "end": 362.74,
   "text": "کفور هم که نمی‌فرماید کافر نه کفور یعنی به شدت ناسپاس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 362.74,
   "end": 366.73,
   "text": "آدم باید سر به بیابون بگذاره از این آه خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 366.73,
   "end": 372.73,
   "text": "حالا دارید می‌بینید اینو که با چشم خودتون دارید می‌بینید که همه کارهای عالم خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 372.73,
   "end": 376.29,
   "text": "همه چی به- م-موت و حیات دست اونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 376.29,
   "end": 378.71,
   "text": "و البته این موت و حیات همیشه هست دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 378.71,
   "end": 382.77,
   "text": "کل یوم نحن نشفیش هم قبلاً گفتیم اسم محی و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 382.77,
   "end": 387.33,
   "text": "اسم ممیت آنفآن در ما داره پیاده میشه که قبلاً بحثش رو کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 387.33,
   "end": 391.61,
   "text": "که آنفآن پروردگار سبحان داره تجلی می‌کنه که ما هستیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 391.61,
   "end": 394.39,
   "text": "حالا تجلیاتش متفاوت میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 394.39,
   "end": 402.33,
   "text": "الان در نشئه طبیعت یه طور تجلی می‌کنه، وقت موت ما هم خدا تجلی می‌کنه که ما می‌میریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 402.33,
   "end": 405.89,
   "text": "طورمون عوض میشه. انما تنتقلون من دار الی دار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 405.89,
   "end": 410.29,
   "text": "میریم به یه دار دیگه‌ای. باز خدا داره اونجا به گونه‌ی دیگه‌ای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 410.29,
   "end": 413.79,
   "text": "تجلی می‌کنه. همه عالم اطوار وجودی حقه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 413.79,
   "end": 416.49,
   "text": "باز هم موت البته داریم ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 416.49,
   "end": 419.45,
   "text": "و امت مثلتاً اینکه تو قرآن میگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 419.45,
   "end": 422.33,
   "text": "اونا قیامت میگن ما دو بار مردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 422.33,
   "end": 425.73,
   "text": "پیداست که انتهای عالم برزخ هم موتی هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 425.73,
   "end": 428.23,
   "text": "اونجا هم دوباره پوست اندازی می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 428.23,
   "end": 430.59,
   "text": "انتهای عالم برزخ می‌میریم، میریم برای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 430.59,
   "end": 434.01,
   "text": "قیامت. قیامت کبرا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 434.01,
   "end": 442.31,
   "text": "از جهت فلسفی که آنفآن وقتی اسم م-ممت در ما بعد از محی ممیت پیاده میشه پس ما آنفآن داریم می‌میریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 442.31,
   "end": 444.93,
   "text": "از طوری به طور دیگه‌ای حرکت می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 444.93,
   "end": 449.25,
   "text": "چه‌شیرین که در نماز هم که همه حقایق درش جمعه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 449.25,
   "end": 453.11,
   "text": "نماز. همه چی درش هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 453.11,
   "end": 456.39,
   "text": "دو تا سجده، این فلسفه سجدتین،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 456.39,
   "end": 460.75,
   "text": "یکی از معارفی که بزرگان پیاده کردن همین هستن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 460.75,
   "end": 464.43,
   "text": "سجده اول سرتون که به خاک می‌گذارید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 464.43,
   "end": 466.27,
   "text": "لحظه‌ایست که شما عدمید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 466.27,
   "end": 470.87,
   "text": "از خاک می‌خوایم تازه از کتم عدم یا از خاک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 470.87,
   "end": 473.67,
   "text": "طورمون عوض بشه بیاییم به این دنیا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 473.67,
   "end": 476.25,
   "text": "سرمون به سجده‌ست، به خاکه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 476.25,
   "end": 479.95,
   "text": "اون لحظه‌ایست که پروردگار سبحان می‌خواد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 479.95,
   "end": 482.15,
   "text": "اراده خلقت کنه و ما رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 482.15,
   "end": 486.31,
   "text": "بیاره به این دنیا. الان هنوز به دنیا وارد نشدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 486.31,
   "end": 489.99,
   "text": "در گل خلقتیم. سرتون که به سجده اوله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 489.99,
   "end": 492.75,
   "text": "وقتی بلند شدید وارد دنیا می‌شید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 492.75,
   "end": 495.39,
   "text": "ذکر بین دو سجده چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 495.39,
   "end": 497.89,
   "text": "استغفرالله. استغفرالله والتوبت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 497.89,
   "end": 503.21,
   "text": "الیه. چرا؟ چون اومدی به نشئه غفلت، ظلمت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 503.21,
   "end": 507.31,
   "text": "ش- خیر و شر، حق و باطل با هم مشوب شدن، قاطی شدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 507.31,
   "end": 510.15,
   "text": "استغفار اونجا باید انجام بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 510.15,
   "end": 512.27,
   "text": "م-مرحله دنیاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 512.27,
   "end": 514.91,
   "text": "اون لحظه وقتی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 514.91,
   "end": 517.57,
   "text": "سر از سجده بلند کردی میشه چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 517.57,
   "end": 520.47,
   "text": "احیاکم. شما رو احیا کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 520.47,
   "end": 524.95,
   "text": "تو این آیه داره می‌فرماید دیگه. هو الذي احیاکم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 524.95,
   "end": 527.25,
   "text": "بعد دو مرتبه سر به سجده می‌گذاری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 527.25,
   "end": 531.73,
   "text": "اون موت انتهای این دنیاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 531.73,
   "end": 534.73,
   "text": "ثم یمیتکم. تو این آیه داره میگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 534.73,
   "end": 536.81,
   "text": "سرت رو دو مرتبه بر می‌گردی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 536.81,
   "end": 540.81,
   "text": "می‌گذاری رو خاک میشه در حقیقت موت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 540.81,
   "end": 544.57,
   "text": "اول. یعنی میری به نشئه برزخ.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 544.57,
   "end": 548.13,
   "text": "که میشه سجده دوم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 548.13,
   "end": 551.55,
   "text": "در-- میگه سجده دوم را طولانی‌تر کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 551.55,
   "end": 554.39,
   "text": "چرا؟ یه وجهش البته اینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 554.39,
   "end": 557.05,
   "text": "وجوه متعدد داره به وقتش باید بیان کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 557.05,
   "end": 559.97,
   "text": "الان حوصله شما نمی‌کشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 559.97,
   "end": 564.81,
   "text": "یه وجهش اینه که عالم برزخ به مراتب بسیار طولانی‌تر از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 564.81,
   "end": 571.23,
   "text": "نشئه طبیعته. و از اونجا که برگشتی میشه ثم یحییکم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 571.23,
   "end": 574.01,
   "text": "دو مرتبه احیا میشی به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 574.01,
   "end": 576.75,
   "text": "در حقیقت نشئه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 576.75,
   "end": 580.37,
   "text": "قیامت. ثم یحییکم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 580.37,
   "end": 584.27,
   "text": "این حالا بعد شما اونجا تو قیامت چی به دردت می‌خوره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 584.27,
   "end": 588.99,
   "text": "بهترین چیزی که در قیامت به درد من و شما می‌خوره اونجا چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 588.99,
   "end": 594.79,
   "text": "وقتی شما از سجده دوم بلند شدی قیامتت به پا شد، چی به لسانت باید جاری بشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 594.79,
   "end": 600.41,
   "text": "شهادتین دیگه. مستحبه که البته الله اکبر و الحمدلله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 600.41,
   "end": 603.35,
   "text": "بگی. ولی شهادتین اصلشه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 603.35,
   "end": 609.89,
   "text": "اشهد ان لا اله الا الله وحده لا شريك له واشهد ان محمدا عبده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 609.89,
   "end": 613.43,
   "text": "ورسوله. الصلاة محمد و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 613.43,
   "end": 615.37,
   "text": "آله. دو مرتبه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 615.37,
   "end": 622.21,
   "text": "به کثرت قیامتی بر می‌گردی و شروع می‌کنی پیغمبر رو می‌بینی همه کارهای عالمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 622.21,
   "end": 625.17,
   "text": "السلام علیک ای النبی ورحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 625.17,
   "end": 628.05,
   "text": "همه کار، اول پیغمبر رو می‌بینی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 628.05,
   "end": 630.59,
   "text": "در قیامت. می‌بینی اصلاً قیامت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 630.59,
   "end": 635.97,
   "text": "کهاتن. فرمود ان اول قیام این دو تا انگشت مبارک رو به هم چسبوند فرمود کهاتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 635.97,
   "end": 638.47,
   "text": "مثل این. اصلاً من خود ان القيامه هستم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 638.47,
   "end": 645.81,
   "text": "بهترش یعنی حرف عمیق‌ترش اینه که امیرالمؤمنین فرمودن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 645.81,
   "end": 647.75,
   "text": "بعد اونجا سلام به پیغمبر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 647.75,
   "end": 650.17,
   "text": "بعد می‌بینی بعد پیغمبر شؤون داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 650.17,
   "end": 653.53,
   "text": "شؤونش ا همه اولیا و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 653.53,
   "end": 657.37,
   "text": "اهل ایمانن. لذا خودت رو هم جزو اون شؤون می‌بینی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 657.37,
   "end": 661.19,
   "text": "السلام علینا و علی عباد الله الصالحین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 661.19,
   "end": 665.27,
   "text": "سفره گسترده میشه. یعنی همه سر سفره پیغمبرن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 665.27,
   "end": 674.33,
   "text": "بعد دیگه همه از آدم تا خاتم رو همه رو می‌بینی به یک باره السلام علیکم ورحمة الله وبركاته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 674.33,
   "end": 677.85,
   "text": "از خدا می‌خوای به همه این‌ها برکاتش رو برسونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 677.85,
   "end": 680.93,
   "text": "برکتش رو به همه تسلیم کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 680.93,
   "end": 684.35,
   "text": "حرف اینجا البته زیاد داشتیم، چیزای دیگه می‌خواستیم بگیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 684.35,
   "end": 687.77,
   "text": "فرصت دیگه نیست. اسم الحي رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 687.77,
   "end": 692.57,
   "text": "غافل نباشیم. اسم الحي بسیار اسم شریفیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 692.57,
   "end": 694.29,
   "text": "حالا عدد داره، عددش چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 694.29,
   "end": 697.07,
   "text": "بعد از هر نماز کسی بگه چه اتفاقاتی می‌افته؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 697.07,
   "end": 699.41,
   "text": "می‌خواستیم تعقیّم کنیم فرصت رفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 699.41,
   "end": 702.97,
   "text": "اللهم باریک لمولانا صاحب الزمان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 702.97,
   "end": 705.09,
   "text": "والحمد لله رب العالمين.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 705.09,
   "end": 711.29,
   "text": "صلوات. اللهم صل علی محمد و آل محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}