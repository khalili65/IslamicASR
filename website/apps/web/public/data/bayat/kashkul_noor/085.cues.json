 "chapters": [
  {
   "index": 0,
   "title": "## میلاد حضرت رقیه و ولایت‌مداری کودک سه‌ساله",
   "start": 20.08,
   "end": 202.0
  },
  {
   "index": 1,
   "title": "## اگر انقلاب نمی‌شد",
   "start": 202.0,
   "end": 278.72
  },
  {
   "index": 2,
   "title": "## جاهلیت اولی و جاهلیت اخری",
   "start": 278.72,
   "end": 327.28
  },
  {
   "index": 3,
   "title": "## وجوه جاهلیت مدرن",
   "start": 327.28,
   "end": 706.65
  },
  {
   "index": 4,
   "title": "## فضای مجازی؛ امپراتوری دروغ",
   "start": 706.65,
   "end": 996.24
  },
  {
   "index": 5,
   "title": "## راهپیمایی بیست‌ودو بهمن و خلوص",
   "start": 996.24,
   "end": 1039.3
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.64,
   "end": 4.1,
   "text": "اللهم صل على محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 4.1,
   "end": 10.78,
   "text": "و آله. بسم الله الرحمن الرحیم و به این استعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 10.78,
   "end": 14.68,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 14.68,
   "end": 18.7,
   "text": "آیاته. سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 18.7,
   "end": 21.02,
   "text": "تبریک عرض می‌کنم هم میلاد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 21.02,
   "end": 24.94,
   "text": "حضرت رقیه سلام الله علیها رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 24.94,
   "end": 34.24,
   "text": "و هم سالروز پیروزی انقلاب عزیز و شکوهمندمون رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 34.24,
   "end": 38.22,
   "text": "نکته‌ای رو پیرامون حضرت رقیه سلام الله علیها تبرکاً عرض کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 38.22,
   "end": 44.68,
   "text": "خیلی شیرینه وقتی شما روایات رو می‌بینید که این بچه با اینکه سه سالش بوده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 44.68,
   "end": 48.06,
   "text": "اینکه در اشعار میگن سه سالش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 48.06,
   "end": 51.62,
   "text": "برکت عمر نوح رو داشت به واقع میگن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 51.62,
   "end": 56.0,
   "text": "که کاخ ستم رو چگونه ویران کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 56.0,
   "end": 62.22,
   "text": "انقدر این دختر سه ساله زهرای سه ساله کربلا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 62.22,
   "end": 66.42,
   "text": "ولایت مدار بود که همه رو از توحید داشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 66.42,
   "end": 72.02,
   "text": "یعنی تو سه سال باباش چگونه ایشون رو عجین با توحید کرده بود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 72.02,
   "end": 75.72,
   "text": "که امامش رو خوب می‌شناخت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 75.72,
   "end": 79.68,
   "text": "بحث فقط بحث عاطفی و پدر بودن نبود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 79.68,
   "end": 83.4,
   "text": "یه نکته فقط عرض کنم وقتی که ابا عبدالله وداع کرد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 83.4,
   "end": 87.3,
   "text": "با همه وداع کرد از همه خداحافظی کرد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 87.3,
   "end": 92.92,
   "text": "الا این دختر. و وقتی از خیمه می‌رفت آقا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 92.92,
   "end": 97.0,
   "text": "به دخترش حضرت رقیه تو روایات هست در مقاتل که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 97.0,
   "end": 100.38,
   "text": "فرمود دخترم میرم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 100.38,
   "end": 108.48,
   "text": "گفت کجا میری بابا؟ فرمود میرم امید دارم که آب بیارم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 108.48,
   "end": 111.18,
   "text": "امید دارم که آب برات بیارم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 111.18,
   "end": 115.04,
   "text": "تا وقتی من برنگشتم از خیمه خارج نشو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 115.04,
   "end": 121.22,
   "text": "حضرت رقیه چنان ولایت مدار بود این کار رو انجام داد با اینکه غوغا و اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 121.22,
   "end": 125.5,
   "text": "سر و صدا و هلهله‌ها اینا همه جا پیچیده بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 125.5,
   "end": 127.9,
   "text": "جیغ و فریاد و آتش و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 127.9,
   "end": 130.9,
   "text": "این‌ها اما از خیمه خارج نشد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 130.9,
   "end": 139.06,
   "text": "از خیمه خارج نشد تا اون نانجیب وارد خیمه شد و دیگه بیشتر از این ادامه ندم بحث روضه‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 139.06,
   "end": 144.0,
   "text": "خیلی عجیبه که وارد شد دم غروب بود دیگه وقتی وارد خیمه شد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 144.0,
   "end": 147.58,
   "text": "که حالا چه کرد بماند. دید یه دخترکی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 147.58,
   "end": 151.98,
   "text": "سجاده پهن کرده و مهر و تسبیح رو داره میذاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 151.98,
   "end": 155.64,
   "text": "چی-- چه می‌کنی؟ گفت من منتظر پدرمم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 155.64,
   "end": 158.48,
   "text": "برگرده نماز مغرب و عشاشو بخونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 158.48,
   "end": 164.24,
   "text": "این بچه ببینید چگونه در دامن توحید یه دختر بچه سه ساله چه می‌دانه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 164.24,
   "end": 168.26,
   "text": "چگونه در دامن توحید بزرگ شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 168.26,
   "end": 170.92,
   "text": "نفس سید الشهدا چه می‌کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 170.92,
   "end": 174.3,
   "text": "که هنوز هم گره گشایی می‌کنه و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 174.3,
   "end": 179.32,
   "text": "یه مدتی هم می‌گفتن نه ایشون دختر امام حسین نبوده و such این‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 179.32,
   "end": 182.64,
   "text": "خدا حفظ کنه بعضی از اولیای خدا جمله جالبی گفتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 182.64,
   "end": 190.38,
   "text": "گفتن قربون امام حسین بریم که دختر نداشتش گره‌های کور باز می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 190.38,
   "end": 194.0,
   "text": "انشاالله که به زودی یه روز شاهد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 194.0,
   "end": 202.0,
   "text": "ریشه‌کنی تکفیری‌ها و این‌ها باشیم در سوریه که بتونیم باز هم به زیارت این بی بی دو عالم بریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 202.0,
   "end": 206.7,
   "text": "در خصوص انقلاب هم یه چند تا نکته عرض کنم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 206.7,
   "end": 210.76,
   "text": "که اگر نگم خیانت کردم به خون شهدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 210.76,
   "end": 215.48,
   "text": "ببینید عزیزان شما تصور کنید اصلاً انقلاب نمی‌شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 215.48,
   "end": 221.4,
   "text": "چه اتفاقی می‌افتاد اگر این انقلاب شکوهمند رخ نمی‌داد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 221.4,
   "end": 228.2,
   "text": "آیا به نظر شما اگر این ان-انقلاب رخ نمی‌داد، این انفجار نور صورت نمی‌گرفت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 228.2,
   "end": 234.94,
   "text": "آیا امیدی برای زمینه‌سازی ظهور امام عصر اصلاً بود؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 234.94,
   "end": 241.4,
   "text": "چه انقلابی، چه جمعیتی، چه حرکتی، چه نهضتی، چی می‌خواست آماده‌سازی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 241.4,
   "end": 244.4,
   "text": "جهان رو برای ظهور امام عصر داشته باشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 244.4,
   "end": 246.28,
   "text": "کی؟ کی اصلاً؟ کی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 246.28,
   "end": 249.56,
   "text": "میگه کی؟ کی می‌خواست این اتفاق بیفته؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 249.56,
   "end": 253.3,
   "text": "و چگونه؟ یه ذره به این‌ها فکر کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 253.3,
   "end": 261.48,
   "text": "اون فرمایش قرآن که و ان الارض یرضها عبادی الصالحون قطعاً زمین قراره که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 261.48,
   "end": 264.1,
   "text": "به ارث برسه به بندگان صالح خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 264.1,
   "end": 266.28,
   "text": "این صالح‌سازی رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 266.28,
   "end": 269.52,
   "text": "کدوم حکومت ما-- باید متکفل می‌شد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 269.52,
   "end": 274.12,
   "text": "تا آماده کنه جهان رو برای ظهور منجی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 274.12,
   "end": 276.46,
   "text": "کی؟ کی؟ چگونه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 276.46,
   "end": 281.4,
   "text": "این‌ها همه سؤال‌های جدیه. در حالی که شما وقتی دقت می‌کنید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 281.4,
   "end": 287.86,
   "text": "در چه آیات قرآن، چه فرمایشات پیغمبر عزیز عالم و اهل بیت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 287.86,
   "end": 294.68,
   "text": "متوجه می‌شیم که ما یک جاهلیت اولا داریم، یک جاهلیت اخرا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 294.68,
   "end": 297.36,
   "text": "یه فرمایشی از پیغمبر براتون بخونم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 297.36,
   "end": 299.62,
   "text": "خیلی عالی. می‌فرماید که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 299.62,
   "end": 302.62,
   "text": "در تفسیر اهل بیت انی بعثت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 302.62,
   "end": 305.4,
   "text": "بین جاهلیتین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 305.4,
   "end": 309.56,
   "text": "من مبعوث شدم بین دو تا جاهلیت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 309.56,
   "end": 314.42,
   "text": "معمولاً و غالباً همه توجه به اون جاهلیت اولا دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 314.42,
   "end": 318.56,
   "text": "به جاهلیت مدرن امروز توجه نمی‌کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 318.56,
   "end": 322.0,
   "text": "بعد فرمود لااخراهما شر من اولاهما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 322.0,
   "end": 324.94,
   "text": "اتفاقاً می‌فرماید اون دومیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 324.94,
   "end": 328.26,
   "text": "شرش به مراتب بیشتر از اون اولی‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 328.26,
   "end": 330.66,
   "text": "یعنی این جاهلیت مدرنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 330.66,
   "end": 335.5,
   "text": "حالا علتش هم عرض می‌کنم یه چند تاشو البته خیلی وجوه دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 335.5,
   "end": 339.78,
   "text": "اصلاً کل جاهلیت رو شما ببینید مثلاً در سوره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 339.78,
   "end": 342.52,
   "text": "احزاب آیه سی‌وسه دو سه تا آیه تبرکاً بخونیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 342.52,
   "end": 349.18,
   "text": "ولا تبرجن تبرج الجاهلیت الجاهلیت الاولى.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 349.18,
   "end": 351.7,
   "text": "مثل جاهلیت نخستین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 351.7,
   "end": 353.72,
   "text": "در میان مردم ظاهر نشوید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 353.72,
   "end": 358.0,
   "text": "جاهلیت اولا رو داره میگه. آیه صد و پنجاه و چهار آل عمران.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 358.0,
   "end": 362.64,
   "text": "یظنون بالله غير الحق وان الجاهلية.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 362.64,
   "end": 365.66,
   "text": "یه ظن باطلی بردن به خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 365.66,
   "end": 368.67,
   "text": "چه ظنی؟ ظن جاهلیت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 368.67,
   "end": 374.33,
   "text": "آیه پنجاه مائده. \"أَفَحُكْمَ الْجَاهِلِيَّةِ يَبْغُونَ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 374.33,
   "end": 378.25,
   "text": "وَمَنْ أَحْسَنُ مِنَ اللَّهِ حُكْمًا لِّقَوْمٍ يُوقِنُونَ\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 378.25,
   "end": 383.05,
   "text": "آیا اونان که حکم جاهلیت رو می‌طلبیدند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 383.05,
   "end": 386.79,
   "text": "آیا اونا به حق‌اند یا اصلا کیه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 386.79,
   "end": 389.67,
   "text": "مثل خدا بتونه حکم کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 389.67,
   "end": 394.43,
   "text": "برای اهل یقین؟ باز بحث جاهلیت رو اینجا داره مطرح می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 394.43,
   "end": 400.75,
   "text": "یا همین سوره فتح که اینجا یک روزهای شنبه می‌خونید آیه بیست و شش فتح \"فِي قُلُوبِهِمُ الْحَمِيَّةُ\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 400.75,
   "end": 404.37,
   "text": "چه حمیت؟ حمیت الجاهلیت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 404.37,
   "end": 408.15,
   "text": "یه بحث جدیه. این وجود داشته و الان هم هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 408.15,
   "end": 411.15,
   "text": "اتفاقا از امام باقر سلام الله علیه روایت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 411.15,
   "end": 415.23,
   "text": "جالبی دیدم از تفسیر نور-- ثقلین خواستید رجوع کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 415.23,
   "end": 418.21,
   "text": "جلد چهار صفحه دویست و شصت و نه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 418.21,
   "end": 420.93,
   "text": "می‌فرماید امام باقر سلام الله علیه \"أَي",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 420.93,
   "end": 424.39,
   "text": "سَتَكُونُ جَاهِلِيَّةٌ أُخْرَى\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 424.39,
   "end": 429.31,
   "text": "یعنی اینکه جاهلیت بعدی خواهد آمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 429.31,
   "end": 432.77,
   "text": "در آخرالزمان. پس نشون میده که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 432.77,
   "end": 439.27,
   "text": "جاهلیت تموم نشد. اتفاقا مدرنیته‌ش الان تو اوجشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 439.27,
   "end": 444.45,
   "text": "دلایلی هم براش داریم. مثلا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 444.45,
   "end": 446.83,
   "text": "انحراف در مبانی فکری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 446.83,
   "end": 451.35,
   "text": "همین امانیسم، انسان محوری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 451.35,
   "end": 455.53,
   "text": "قدیما اصلا حرفی از انسان محوری نبود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 455.53,
   "end": 458.41,
   "text": "اگرم می‌گفتن که مثلا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 458.41,
   "end": 463.37,
   "text": "Butی چیزی داشتن بر اساس اون آموزه‌های قبلی که داشتیم آیاتی رو برای شما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 463.37,
   "end": 466.39,
   "text": "عرض کردیم و این‌ها یا اون حیاکل،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 466.39,
   "end": 471.27,
   "text": "حیاکل اگر یادتون باشه براتون گفتیم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 471.27,
   "end": 477.75,
   "text": "در اون حیاکل، هیکل‌هایی که از بت‌هاشون داشتن می‌تراشیدن می‌گفتن این‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 477.75,
   "end": 480.53,
   "text": "ما رو به سمت الله رهنمون می‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 480.53,
   "end": 484.65,
   "text": "اینا نشانه‌هایین برای اینکه ما رو به خدا رهنمون کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 484.65,
   "end": 487.43,
   "text": "یعنی قائل به ربوبیت عالم بودند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 487.43,
   "end": 491.21,
   "text": "این، اینم اتفاقا صریح فرمایش حضرت علامه حسن زاده است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 491.21,
   "end": 495.13,
   "text": "اما الان میگن انسان محوری نه خدا محوری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 495.13,
   "end": 498.61,
   "text": "همه کارهای عالم انسانه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 498.61,
   "end": 502.19,
   "text": "خدا رحمت کنه شهید یعقوبیان رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 502.19,
   "end": 507.53,
   "text": "تا قم با هم یه سفری می‌رفتیم تا اونجا برای ما خاطرات کشورهای مختلف--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 507.53,
   "end": 513.29,
   "text": "خیلی کشورها رفته بود. وراثت، وراثت فرودگاه بود، کشورهای مختلفی رفته بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 513.29,
   "end": 516.57,
   "text": "این اصل لینگامیسم در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 516.57,
   "end": 520.41,
   "text": "هندوستان رو اون روز خیلی شاید مثلا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 520.41,
   "end": 522.59,
   "text": "سی سال پیش برای بنده گفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 522.59,
   "end": 525.23,
   "text": "من باورم نمی‌شد. بعد الان داریم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 525.23,
   "end": 528.31,
   "text": "خبرهاش رو می‌بینیم. هیگو رفته بود خیلی مفصله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 528.31,
   "end": 531.93,
   "text": "دوست داشتید الان نمیشه تو این فرصت نمی‌گنجد و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 531.93,
   "end": 534.23,
   "text": "صلاحم نمی‌دونم تو این محیط متحر بگم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 534.23,
   "end": 540.07,
   "text": "خلاصه‌ش اینه که اون‌ها قائل‌اند به عبودیت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 540.07,
   "end": 542.61,
   "text": "آلت مرد. خیلی عذرخواهی می‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 542.61,
   "end": 544.85,
   "text": "یعنی می‌پرستند. ایشون رفته بود دیده بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 544.85,
   "end": 547.63,
   "text": "اصلا معبدشون رو دیده بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 547.63,
   "end": 550.97,
   "text": "که چگونه اون‌ها قائل‌اند به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 550.97,
   "end": 553.03,
   "text": "اینکه باید عبادت کنن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 553.03,
   "end": 558.07,
   "text": "و معتقدند که همه کارهای عالم اینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 558.07,
   "end": 559.91,
   "text": "محل خلقت اینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 559.91,
   "end": 561.87,
   "text": "یعنی الانو این به این میگن چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 561.87,
   "end": 565.43,
   "text": "جاهلیت مدرن. جاهلیت امروز.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 565.43,
   "end": 571.19,
   "text": "یا عرض شود نژادپرستی که الان دیگه به اوج خودش رسیده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 571.19,
   "end": 574.39,
   "text": "تو آمریکا ببینید چه خبره. تو کشورهایی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 574.39,
   "end": 578.01,
   "text": "که مهاجر نشستند ببینید چه، چه جوری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 578.01,
   "end": 584.95,
   "text": "کو-- بکش بکش هست و این‌ها رو برده خودشون می‌دونن، برده جنسی، برده و کلفت زندگیشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 584.95,
   "end": 588.49,
   "text": "و اصلا به هیچ حق و حقوقی برای اینا قائل نیستند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 588.49,
   "end": 593.93,
   "text": "زمان پیغمبر هم بود اما زمان قبل از پیغمبر اما نه به این شدت و حدت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 593.93,
   "end": 596.37,
   "text": "یا مثلا فساد اخلاقی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 596.37,
   "end": 601.45,
   "text": "قرآن می‌فرماید \"وَهَرَ الْفَسَادَ فِي الْبَرِّ وَالْبَحْرِ بِمَا كَسَبَتْ أَيْدِي النَّاسِ\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 601.45,
   "end": 604.55,
   "text": "این ظهور می‌کنه. انقدر شدت می‌گیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 604.55,
   "end": 606.93,
   "text": "جالبه فساد هم در خشکی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 606.93,
   "end": 609.81,
   "text": "هم در آب. آب که ماهین که بیچاره‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 609.81,
   "end": 613.13,
   "text": "تو ماهی-- آبزیان چه فسادی هست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 613.13,
   "end": 620.07,
   "text": "پیداست این کشتی‌ها، این ناوها، اینایی که رو آب حرکت می‌کنند اینا فساد برانگیزند دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 620.07,
   "end": 624.43,
   "text": "اینهان که دارن فساد می‌کنند و الا تو آب چه فسادی هست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 624.43,
   "end": 630.49,
   "text": "و اون موقع فساد اگر بود به عنوان یک جرم شناخته می‌شد فساد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 630.49,
   "end": 633.45,
   "text": "یعنی می‌رفتن یه گوشه‌ای خطا می‌کردن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 633.45,
   "end": 636.63,
   "text": "حرام مرتکب می‌شدن. الان که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 636.63,
   "end": 640.05,
   "text": "اصلا قانونمند شده یعنی قانونیش کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 640.05,
   "end": 644.07,
   "text": "خیلی عذرخواهی می‌کنم. نمی‌دونم ارتباطات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 644.07,
   "end": 647.97,
   "text": "عرض شود همجنس گرایی و چه می‌دونم چه و اینا که اصلا قانونیش کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 647.97,
   "end": 651.43,
   "text": "یعنی کسی که اگر اینا رو قبول نداشته باشه این‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 651.43,
   "end": 656.03,
   "text": "ام ال می‌دوننش. اصلا یه آدم بی‌سواد و بی‌فرهنگ می‌دوننش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 656.03,
   "end": 659.23,
   "text": "آیا این جاهلیت مدرن نیست به نظر شما؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 659.23,
   "end": 663.15,
   "text": "جاهلیت امروزه ببینید تا کجاها پیش رفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 663.15,
   "end": 665.15,
   "text": "یا استبداد و ستم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 665.15,
   "end": 668.85,
   "text": "کاری که با مردم غزه و فلسطین کردن و دارن می‌کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 668.85,
   "end": 672.39,
   "text": "رهبر عزیزمون چندین بار فرمودن ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 672.39,
   "end": 676.35,
   "text": "هرچی تاریخ رو مرور کردیم و سابقه داریم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 676.35,
   "end": 679.13,
   "text": "س-- نده، ندیدیم. همچین چیزی ندیدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 679.13,
   "end": 682.25,
   "text": "اتفاقی که در غزه داره رخ میده و رخ داد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 682.25,
   "end": 684.91,
   "text": "ما نداشتیم. نداشتیم تو سابقه جنگ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 684.91,
   "end": 692.39,
   "text": "این همه چرا حجاج نامی اومد اون همه کشت و کشتار کرد اما نه به این شکل، نه به این طرز فجیع.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 692.39,
   "end": 694.99,
   "text": "بعد مدال بهش بدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 694.99,
   "end": 699.69,
   "text": "دنبال صلح، مدال صلح نوبل و چه می‌دونم چه و اینها هم بره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 699.69,
   "end": 702.63,
   "text": "به خاطر این کشت و کشتارها واقعا عجیب غریبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 702.63,
   "end": 706.45,
   "text": "یعنی اتفاقاتی که داره در صحنه جهانی می‌افته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 706.45,
   "end": 710.45,
   "text": "یا فضای مجازی. رهبرمون فرمودن قتلگاه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 710.45,
   "end": 714.97,
   "text": "واقعا قتلگاهه. کی انقدر فساد در دسترس بوده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 714.97,
   "end": 719.29,
   "text": "کی انقدر امپراتوری دروغ حاکم بوده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 719.29,
   "end": 722.83,
   "text": "من به شما این نهیب رو و به خودم و هممون بزنم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 722.83,
   "end": 726.43,
   "text": "که الان پیاده نظام اسرائیل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 726.43,
   "end": 732.26,
   "text": "به صورت خاموش هم شاید بگیم حتی غلطه، اتفاقا روشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 732.26,
   "end": 735.08,
   "text": "در منازل تک تک ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 735.08,
   "end": 738.82,
   "text": "مشغول به جنگ، جنگ نرم با فضای مجازی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 738.82,
   "end": 744.46,
   "text": "انقدر این اغتشاش‌گران رو که وقتی گرفته بودن خیلیاشون سنشون زیر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 744.46,
   "end": 747.92,
   "text": "سن هفده هجده سال بود. بسیارشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 747.92,
   "end": 752.42,
   "text": "گفتن خودشون اقرار کردن که ما تحت تاثیر فضای مجازی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 752.42,
   "end": 756.36,
   "text": "همین اینستاگرام و واتساپ و تلگرام و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 756.36,
   "end": 760.04,
   "text": "اینا حکم رانان اینا کیان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 760.04,
   "end": 764.24,
   "text": "این فسادی که داره تو این‌ها از حیث ستم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 764.24,
   "end": 767.16,
   "text": "به دیگران مخصوصاً دروغ.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 767.16,
   "end": 773.46,
   "text": "اهل بیت فرمودن تمام فسادها رو جمع کن توی اتاق همه رو، همه فساد‌ها رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 773.46,
   "end": 777.58,
   "text": "کلید اون اتاقی که همه فسادها توشه دروغه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 777.58,
   "end": 781.76,
   "text": "این فضای مجازی به واقع امپراتوری دروغه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 781.76,
   "end": 785.18,
   "text": "کی انقدر دروغ بوده که بعد مردم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 785.18,
   "end": 790.38,
   "text": "جاهل ما، ما زنده باشیم و اینطور بر علیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 790.38,
   "end": 795.74,
   "text": "پاک‌ترین، اندیشمندترین، عالم‌ترین، فرهیخته‌ترین،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 795.74,
   "end": 798.82,
   "text": "شجاع‌ترین، هوشمندترین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 798.82,
   "end": 803.1,
   "text": "عالم ربانی دوران، مرجع تقلید، جانشین امام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 803.1,
   "end": 806.6,
   "text": "عصر اونطوری سمپاشی کنن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 806.6,
   "end": 808.82,
   "text": "از رو جهل و نادونیشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 808.82,
   "end": 814.16,
   "text": "اساءه ادب به ایشون بکنن و ما زنده باشیم و بدترین داب برای بنده همین بود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 814.16,
   "end": 820.96,
   "text": "که دوست داشتم می‌مردم و این فریادهای جاهلانه رو نمی‌شنیدم هیچوقت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 820.96,
   "end": 824.8,
   "text": "واقعاً آدم هرچی نگاه می‌کنه حالا زیاده بخواهیم بشماریم اینطوری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 824.8,
   "end": 830.02,
   "text": "شما یه مقایسه‌ای کنید این، این جاهلیت الان سنگین‌تره یا اون؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 830.02,
   "end": 836.38,
   "text": "حالا به نظر شما برای اینکه یه عزیزی که الطرید الفرید الوحید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 836.38,
   "end": 839.7,
   "text": "الشرید کسی که طرد شده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 839.7,
   "end": 845.12,
   "text": "آواره‌ست. الطرید الشرید الفرید الوحید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 845.12,
   "end": 849.12,
   "text": "تنها مونده، غریب مونده هزار و چند صد سال.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 849.12,
   "end": 854.04,
   "text": "آیا یه حکومت شیعی تنها حکومتی که بعد از اهل بیت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 854.04,
   "end": 859.22,
   "text": "والی شیعه باشه، عالم ربانی در رأسش باشه تشکیل میشد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 859.22,
   "end": 862.25,
   "text": "آیا بجز این میشد جلوی این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 862.25,
   "end": 864.7,
   "text": "جاهلیت مدرنیست‌ها؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 864.7,
   "end": 866.84,
   "text": "میشد؟ اصلاً امکانش بود؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 866.84,
   "end": 869.16,
   "text": "اصلاً برای چی امام عصر بیاد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 869.16,
   "end": 871.42,
   "text": "اگر جاه-- اصلاً چرا رفت که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 871.42,
   "end": 877.34,
   "text": "دوباره بیاد؟ رفت برای اینکه مثل اجدادش اون بلاها رو سرش نیارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 214,
   "start": 877.34,
   "end": 882.94,
   "text": "مثل حضرت موسی خائف، خائف ایشون دیگه که از القاب امام عصر خائفه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 215,
   "start": 882.94,
   "end": 886.7,
   "text": "ترسان از چیه؟ از اینکه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 216,
   "start": 886.7,
   "end": 888.96,
   "text": "بله ایها المعذب الخائف.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 217,
   "start": 888.96,
   "end": 891.2,
   "text": "برای اینکه مثل اجدادش نکشنش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 218,
   "start": 891.2,
   "end": 894.62,
   "text": "یعنی زمین از حجت خدا خالی نشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 219,
   "start": 894.62,
   "end": 896.54,
   "text": "خب باید یه سری می‌اومدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 220,
   "start": 896.54,
   "end": 898.94,
   "text": "باید یه انقلابی رخ می‌داد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 221,
   "start": 898.94,
   "end": 901.12,
   "text": "جانفشانی‌هایی صورت می‌گرفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 222,
   "start": 901.12,
   "end": 903.3,
   "text": "یه انقلابی به قول امام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 223,
   "start": 903.3,
   "end": 907.74,
   "text": "انفجار نور صورت می‌گرفت که اون نور اصلی بتونه ظهور کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 224,
   "start": 907.74,
   "end": 911.66,
   "text": "همینطوری که نمیشه که. و الا برای چی بیاد آقا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 225,
   "start": 911.66,
   "end": 914.88,
   "text": "رفت برای چی بیاد وقتی که دوباره مثل همون موقع است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 226,
   "start": 914.88,
   "end": 916.96,
   "text": "پس باید انقلابی صورت می‌گرفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 227,
   "start": 916.96,
   "end": 919.76,
   "text": "باید زمینه‌سازی صورت می‌گرفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 228,
   "start": 919.76,
   "end": 923.48,
   "text": "و البته که یقیناً جمله آخرم وقتتون رو زیاد گرفتم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 229,
   "start": 923.48,
   "end": 927.7,
   "text": "ببخشید. قطعاً به قول فرمایش خود حضرت آقا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 230,
   "start": 927.7,
   "end": 930.74,
   "text": "اون هزینه‌ای که توی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 231,
   "start": 930.74,
   "end": 934.94,
   "text": "جنگ و مبارزه و جهاد هست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 232,
   "start": 934.94,
   "end": 937.2,
   "text": "اونقدری نیست که در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 233,
   "start": 937.2,
   "end": 940.06,
   "text": "تسلیم هست، در صلح هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 234,
   "start": 940.06,
   "end": 942.14,
   "text": "اون هزینه‌ش به مراتب بیشتره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 235,
   "start": 942.14,
   "end": 946.46,
   "text": "اون خاریه، اون خراب کردن پل پشت سره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 236,
   "start": 946.46,
   "end": 949.94,
   "text": "اون دور انداختن ظهور امام عصره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 237,
   "start": 949.94,
   "end": 953.66,
   "text": "آقای بهائ‌الدینی من از شاگردانشون شنیدم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 238,
   "start": 953.66,
   "end": 958.12,
   "text": "که فرموده بودند که ظهور چیز، انقلاب امام،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 239,
   "start": 958.12,
   "end": 961.22,
   "text": "انقلاب اسلامی حداقل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 240,
   "start": 961.22,
   "end": 966.32,
   "text": "فرموده بودند حداقل دویست سال ظهور آقا رو جلو انداخت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 241,
   "start": 966.32,
   "end": 971.84,
   "text": "کمه دویست سال؟ خیلیه دویست سال.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 242,
   "start": 971.84,
   "end": 974.38,
   "text": "دویست سال ظهور آقا جلو بیفته چیز کمیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 243,
   "start": 974.38,
   "end": 980.84,
   "text": "یعنی دویست زال-- دویست سال ظلم و ستم و فساد و تباهی و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 244,
   "start": 980.84,
   "end": 984.08,
   "text": "عرض شود گمراهی و اینا همه برداشته بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 245,
   "start": 984.08,
   "end": 987.9,
   "text": "چیز کمی نیست. هممون مدیون خون شهدا هستیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 246,
   "start": 987.9,
   "end": 995.3,
   "text": "لذا انشاالله فردا ترغیب کنیم، تشویق کنیم خودمون و دوستانمون و خونواده‌مون رو که در راهپیمایی شرکت کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 247,
   "start": 995.3,
   "end": 998.36,
   "text": "یه جمله هم از سید هاشم حیدری بگم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 248,
   "start": 998.36,
   "end": 999.96,
   "text": "خیلی جمله جالبی فرمودن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 249,
   "start": 999.96,
   "end": 1002.38,
   "text": "راهپیمایی بیست و بهمن شما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 250,
   "start": 1002.38,
   "end": 1007.76,
   "text": "از پیاده روی اربعین با همه عظمتش مهم‌تر است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 251,
   "start": 1007.76,
   "end": 1015.76,
   "text": "علتی که ایشون میاره چیه؟ می‌فرماید چون تو اربعین همه میان از شیعه انگلیسی تا انجمن حجرتیه گرفته تا دیگران.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 252,
   "start": 1015.76,
   "end": 1019.88,
   "text": "ولی تو بیست و دو بهمن فقط خالص‌ها می‌آیند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 253,
   "start": 1019.88,
   "end": 1023.9,
   "text": "خیلی مهمه به قول حظ-حضرت آقا یه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 254,
   "start": 1023.9,
   "end": 1025.94,
   "text": "تو دهنی محکمی باشه بر دشمن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 255,
   "start": 1025.94,
   "end": 1030.92,
   "text": "اونم تو این برهه. اللهم باریک لمولانا صاحب الزمان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 256,
   "start": 1030.92,
   "end": 1032.94,
   "text": "والحمد لله رب العالمین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 257,
   "start": 1032.94,
   "end": 1039.3,
   "text": "صلوات الله. اللهم صل على محمد و آل محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}