 },
 "chapters": [
  {
   "index": 0,
   "title": "## توحید و مزاحمتِ شیطان؛ راه مخلصین",
   "start": 19.08,
   "end": 75.16
  },
  {
   "index": 1,
   "title": "## روایتِ امالی؛ چهار عمل برای دوریِ شیطان",
   "start": 75.16,
   "end": 207.62
  },
  {
   "index": 2,
   "title": "## ماهِ رجب؛ میدانِ همان چهار عمل",
   "start": 207.62,
   "end": 412.58
  },
  {
   "index": 3,
   "title": "## ندایِ داعی در آسمانِ هفتم",
   "start": 412.58,
   "end": 673.68
  },
  {
   "index": 4,
   "title": "## دستورهای سلوکیِ رجب",
   "start": 673.68,
   "end": 830.74
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.26,
   "end": 7.6,
   "text": "[سخنگوی 1] [سخنگوی 1] .",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 7.6,
   "end": 11.2,
   "text": "بسم الله الرحمن الرحیم و به این استعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 11.2,
   "end": 15.24,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 15.24,
   "end": 19.08,
   "text": "آیات. السلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 19.08,
   "end": 21.94,
   "text": "بحث ما پیرامون توحید بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 21.94,
   "end": 27.9,
   "text": "مزاحم‌ترین چیزی که در مسیر توحید وجود داره شیطان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 27.9,
   "end": 31.92,
   "text": "و هیچ کدوم از ما ازش خلاص نمی‌شیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 31.92,
   "end": 36.84,
   "text": "مگر اینکه برسیم به مقام مخلصین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 36.84,
   "end": 42.88,
   "text": "که در شرح رساله سید بحر العلوم اونجا ما توضیحش رو دادیم یعنی چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 42.88,
   "end": 45.74,
   "text": "که فبعزتك",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 45.74,
   "end": 47.86,
   "text": "لا اغویانهم اجمعين",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 47.86,
   "end": 51.36,
   "text": "الا عبادک منهم المخلصین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 51.36,
   "end": 54.28,
   "text": "هیچ راهی جز اخلاص نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 54.28,
   "end": 57.0,
   "text": "یه روایتی تقدیم می‌کنم برای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 57.0,
   "end": 60.78,
   "text": "نجات از شیطان. این روایت خیلی عالیه، شیرینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 60.78,
   "end": 64.58,
   "text": "با توجه به این زمینه‌ای که چیدم نشون میده که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 64.58,
   "end": 67.86,
   "text": "اگر کسی به مضمون این روایت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 67.86,
   "end": 71.98,
   "text": "عمل کنه خدا می‌برش به مقام مخلصین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 71.98,
   "end": 74.78,
   "text": "چرا؟ دقت بفرمایید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 74.78,
   "end": 78.9,
   "text": "روایت در امالی شیخ صدوقه، صفحه صد و هفده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 78.9,
   "end": 82.08,
   "text": "کسی دوست داشت تشریف بیاره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 82.08,
   "end": 85.36,
   "text": "کتابش اینجا پیش ما هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 85.36,
   "end": 90.08,
   "text": "پیامبر عظیم الشأن اسلام فرمودند الا اخبرکم بشیء ان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 90.08,
   "end": 93.62,
   "text": "الا انتم فعلتموه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 93.62,
   "end": 97.06,
   "text": "آیا نمی‌خواید به شما یه خبری رو بدم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 97.06,
   "end": 99.7,
   "text": "یه چیزی رو به شما آموزش بدم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 99.7,
   "end": 103.3,
   "text": "که اگر اون رو انجام بدید چه اتفاقی بیفته؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 103.3,
   "end": 106.32,
   "text": "تباعد الشيطان منکم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 106.32,
   "end": 108.22,
   "text": "شیطان از شما دور بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 108.22,
   "end": 111.48,
   "text": "چه دور شدنی؟ عجب!",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 111.48,
   "end": 113.4,
   "text": "كما تباعدش--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 113.4,
   "end": 116.32,
   "text": "تباعد المشرق من المغرب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 116.32,
   "end": 120.84,
   "text": "الله اکبر. مشرق و مغرب چقدر از هم دورن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 120.84,
   "end": 125.34,
   "text": "یه همچین دوری اتفاق میفته بین شما و شیطان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 125.34,
   "end": 128.46,
   "text": "اصلاً مشرق و مغرب هیچ‌وقت به هم می‌رسن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 128.46,
   "end": 131.36,
   "text": "هیچ‌وقت نمی‌رسه. خودش یه وجهیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 131.36,
   "end": 134.78,
   "text": "حالا دوریش به یه طرف، این که اصلاً به هم نمی‌رسن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 134.78,
   "end": 138.44,
   "text": "کلاً دو تا جدای از همه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 138.44,
   "end": 144.78,
   "text": "این نشون میده که این چند تا عملی که پیغمبر عزیز عالم سفارش کردن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 144.78,
   "end": 148.58,
   "text": "انقدر ارزشش پیش خدا بالاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 148.58,
   "end": 151.92,
   "text": "خیلی شیرین، خیلی قشنگ پیغمبر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 151.92,
   "end": 153.94,
   "text": "فرمایش کردن. قالوا بلى.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 153.94,
   "end": 157.26,
   "text": "خیلی شايق شدن. بله آقا بفرمایید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 157.26,
   "end": 163.18,
   "text": "حضرت فرمودند که قال الصوم یسود وجهه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 163.18,
   "end": 167.82,
   "text": "صورت شیطان رو روزه داری سیاه می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 167.82,
   "end": 170.18,
   "text": "یعنی خب شما هیچ‌وقت حاضری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 170.18,
   "end": 174.06,
   "text": "مقابل یه آدم چ-- که چهره‌ش سیاهه وایسی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 174.06,
   "end": 179.46,
   "text": "سیاهه به اون معنای ظلمانیش عرض می‌کنیم ها، نه پوست ظاهری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 179.46,
   "end": 181.66,
   "text": "یه آدم کريه المنظر، خبيث.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 181.66,
   "end": 184.86,
   "text": "بدت میاد تنفر پیدا می‌کنی فرار می‌کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 184.86,
   "end": 188.9,
   "text": "پس کسی که چهره‌ش سیاه باشه تو دیگه گولش رو نمی‌خوری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 188.9,
   "end": 192.6,
   "text": "چون شیطان هم می‌دونید می‌تونه به اشکال مختلف در بیاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 192.6,
   "end": 195.32,
   "text": "در قوه مثال ما به خودش رو نشون بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 195.32,
   "end": 199.8,
   "text": "این اولیش. و صدقة تكسر ظهره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 199.8,
   "end": 202.3,
   "text": "به به. صدقه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 202.3,
   "end": 207.62,
   "text": "ظهرش رو، پشت شیطان، کمر شیطان رو می‌شکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 207.62,
   "end": 210.0,
   "text": "امروز هم که روز اول ماهه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 210.0,
   "end": 212.84,
   "text": "صدقه وارده. هر چقدر می‌تونیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 212.84,
   "end": 216.08,
   "text": "سریع نیت کنیم انجام بدیم. پشت شیطان رو می‌شکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 216.08,
   "end": 220.18,
   "text": "عجیبه. و الحب في الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 220.18,
   "end": 224.9,
   "text": "و المباذرة علی العمل الصالح.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 224.9,
   "end": 227.82,
   "text": "یکی حب در راه خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 227.82,
   "end": 232.98,
   "text": "یعنی تو حب و بغضت در مسیر الوهیت باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 232.98,
   "end": 236.72,
   "text": "الله. الله رو چنان ببینی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 236.72,
   "end": 239.96,
   "text": "که هرکی با الله تو همراهش باشی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 239.96,
   "end": 242.06,
   "text": "یعنی سلما لمن سالمکم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 242.06,
   "end": 245.68,
   "text": "هرکی علیهشه تو هم علیهش باشی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 245.68,
   "end": 250.82,
   "text": "و حرب لمن حارب. و البته در کنارش و المزا--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 250.82,
   "end": 254.34,
   "text": "مباذرة علی العمل الصالح.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 254.34,
   "end": 257.78,
   "text": "عمل صالحی که بر مبنای حب الله باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 257.78,
   "end": 259.94,
   "text": "به عشق خدا انجام بدی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 259.94,
   "end": 262.54,
   "text": "فقط به عشق خدا. چرا اومدی این-- چرا اومدی اینجا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 262.54,
   "end": 264.74,
   "text": "چرا میری حرم؟ چرا ذکر میگی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 264.74,
   "end": 267.68,
   "text": "چرا این کارو می‌کنی؟ چرا؟ دلم می‌خواد، عاشقیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 267.68,
   "end": 270.46,
   "text": "خدا رو دوست دارم. یعنی به عشق خدا باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 270.46,
   "end": 272.74,
   "text": "این چیکار می‌کنه به نظرتون؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 272.74,
   "end": 276.64,
   "text": "خیلی عالیه. يقطعان دابره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 276.64,
   "end": 282.72,
   "text": "ریشه‌شو می‌چینه. ریشه‌کن می‌کنه شیطان رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 282.72,
   "end": 286.92,
   "text": "خیلی عجیب. و آخریش که خیلی جالب‌تر از همه‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 286.92,
   "end": 291.34,
   "text": "والاستغفار يقطع وطينه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 291.34,
   "end": 297.04,
   "text": "وطين این رگ، شاه رگ گردن رو میگن وطين.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 297.04,
   "end": 301.14,
   "text": "استغفار شاه رگ شیطان و می‌زنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 301.14,
   "end": 306.26,
   "text": "به همین راحتی. پس پیداست که اگر کسی این چهار تا عمل اصلی رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 306.26,
   "end": 310.34,
   "text": "انجام بده میره به مقام مخلصین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 310.34,
   "end": 312.44,
   "text": "حالا اگر-- چرا من این رو عرض کردم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 312.44,
   "end": 317.46,
   "text": "تبریک هم عرض می‌کنم امروز رو به جهت این که هم روز اول ماه رجب،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 317.46,
   "end": 324.12,
   "text": "هم میلاد با برکت شکافنده علوم اولین و آخرین حضرت امام با-- صلوة الله علیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 324.12,
   "end": 327.0,
   "text": "اگر دقت بفرمایید در دستورات ماه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 327.0,
   "end": 330.0,
   "text": "رجب بین این چهار تا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 330.0,
   "end": 335.32,
   "text": "فرمایش پیغمبر تو این ماه وارد شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 335.32,
   "end": 337.82,
   "text": "روزه، صدقه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 337.82,
   "end": 340.84,
   "text": "عملی که بر اساس حب خدا باشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 340.84,
   "end": 343.0,
   "text": "و استغفار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 343.0,
   "end": 347.34,
   "text": "هر چهارتاش تو این ماه وارد شده و اصلاً ماهی ما نداریم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 347.34,
   "end": 350.58,
   "text": "که مثل این ماه عمل کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 350.58,
   "end": 352.38,
   "text": "صحبت‌های آقا مجتبی یادش بخیر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 352.38,
   "end": 356.54,
   "text": "نمی‌دونم کیا شنیدید. ایشون شب اول ماه رجب که میشد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 356.54,
   "end": 359.12,
   "text": "معمولاً بالا منبر گریه‌ش می‌گرفت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 359.12,
   "end": 365.68,
   "text": "و اون روایت شریف پیغمبر رو حالا نمی‌دونم حالشو داشته باشید، فرصت داشته باشید براتون بخونم بخوابه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 365.68,
   "end": 370.16,
   "text": "شب‌های ماه رجب. ایشون تاکید داشتن که-- ایشون فرمودن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 370.16,
   "end": 374.42,
   "text": "تاکید داشتن که من تحقیق کردم متوجه شدم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 374.42,
   "end": 376.86,
   "text": "ماه رجب فقط مربوط به اسلام نبوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 376.86,
   "end": 381.24,
   "text": "در زمان جاهلیت که پیغمبری هم نبوده، اسلامی هم نبوده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 381.24,
   "end": 387.32,
   "text": "مردم جاهل اون زمان صبر می‌کردن ماه رجب برسه تا حاجتشون رو از خدا بگیرن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 387.32,
   "end": 391.64,
   "text": "می‌گفتن تو این ماه خدا دست رد به اهدی نمی‌زنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 391.64,
   "end": 396.96,
   "text": "و آقا مجتبی فرمودن که بهترین ماه برای خواستن از خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 396.96,
   "end": 402.84,
   "text": "ماه برای گدایی کردن و مسألت از حضرت حق بهتر از این ماه نداریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 402.84,
   "end": 407.22,
   "text": "این سفارش آقا مجتبی بود. بعد اشاره می‌ک-- روحشون شاد باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 407.22,
   "end": 410.06,
   "text": "اشاره می‌کردم به این فرمایش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 410.06,
   "end": 415.86,
   "text": "پیغمبر عزیز عالم. خواستید ببینید بحار جلد نود و پنج صفحه سیصد و هفتاد و هفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 415.86,
   "end": 417.64,
   "text": "سریع بخونم فرصت داره می‌گذره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 417.64,
   "end": 419.98,
   "text": "إن الله تعالی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 419.98,
   "end": 424.04,
   "text": "نصب في السماء السابعة توجه کنید به کلمات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 424.04,
   "end": 426.42,
   "text": "آسمان هفتم. سابعة.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 426.42,
   "end": 428.56,
   "text": "یعنی اون منتهی الی خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 428.56,
   "end": 432.94,
   "text": "اونجا یک منصبی داده به یک ملکی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 432.94,
   "end": 435.38,
   "text": "که اون ملکیه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 435.38,
   "end": 437.74,
   "text": "چ-چ-- اسمش چیه؟ چی می‌خوننش؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 437.74,
   "end": 440.7,
   "text": "يقال له الداعي. اسمش هست داعی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 440.7,
   "end": 449.0,
   "text": "دعوت کننده‌ست. و إذا دخل شهر رجب ينادي ذلك الملك كل ليلة منه إلى الصباح",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 449.0,
   "end": 451.42,
   "text": "کسی گله نکنه چرا دیشب اینو نشنیدیم ما؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 451.42,
   "end": 454.08,
   "text": "چرا دیشب نگفتید؟ چرا دیروز نگفتید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 454.08,
   "end": 457.76,
   "text": "هر شب از ماه رجب تا صبح این ملک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 457.76,
   "end": 460.96,
   "text": "شروع می‌کنه ندا زدن. وقتی ماه رجب شروع می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 460.96,
   "end": 463.5,
   "text": "از شب اول تا آخر هر شب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 463.5,
   "end": 466.72,
   "text": "تا صبح نداش اینه: تو بالذاکرین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 466.72,
   "end": 469.6,
   "text": "خوش به حال اونایی که مشغول ذکر خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 469.6,
   "end": 474.34,
   "text": "تو بالالطائعین. اونهایی که مشغول اطاعت حضرت حق‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 474.34,
   "end": 476.56,
   "text": "يقول الله تعالی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 476.56,
   "end": 480.28,
   "text": "بعد پروردگار-- اون داره میگه، اون ملک از سمت حضرت حق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 480.28,
   "end": 483.84,
   "text": "می‌فرماید که خدا می‌فرماید: أنا جليس من جالسني.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 483.84,
   "end": 487.78,
   "text": "الله اکبر. أنا جليس من جالسني.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 487.78,
   "end": 490.68,
   "text": "من می‌شینم با هر کسی که با من بشینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 490.68,
   "end": 492.34,
   "text": "ومطيع من أطاعني.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 492.34,
   "end": 495.46,
   "text": "هرکس که اطاعت منو بکنه الله اکبر،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 495.46,
   "end": 498.48,
   "text": "حضرت حق بگه من بر اطاعتشم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 498.48,
   "end": 500.98,
   "text": "الله اکبر. شما سیاق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 500.98,
   "end": 503.32,
   "text": "فرمایش رو ببینید. چی داره میگه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 503.32,
   "end": 506.46,
   "text": "خدا بگه من مطیعشم. الله اکبر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 506.46,
   "end": 513.6,
   "text": "واقعا الله اکبر. وغافر من استغفر-من استغفرني.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 513.6,
   "end": 515.64,
   "text": "هرکسی که تو این ماه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 515.64,
   "end": 518.2,
   "text": "استغفار کنه من می‌بخشمش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 518.2,
   "end": 521.12,
   "text": "من شهر şehري. به به!",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 521.12,
   "end": 524.38,
   "text": "انتساب به خودش داده. یادتونه در اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 524.38,
   "end": 527.52,
   "text": "و ادخلی عبادی و ادخلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 527.52,
   "end": 532.44,
   "text": "فی عبادی و ادخلی جنتي حضرت امام فرمودن اون یا، یا ذاتیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 532.44,
   "end": 537.88,
   "text": "یعنی بندگانی که انتساب به ذات من دارن و بهشت ذات من.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 537.88,
   "end": 540.6,
   "text": "نه اون بهشت حور و سیب و گلابی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 540.6,
   "end": 542.7,
   "text": "اون نه. اینم همینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 542.7,
   "end": 547.04,
   "text": "من شهر şehري. این شهر منه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 547.04,
   "end": 550.88,
   "text": "یعنی کسی می‌خواد بره تو آغوش خدا، بسم الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 550.88,
   "end": 554.44,
   "text": "آغوش باز کرده حضرت حق. میگه به چه لسانی بگه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 554.44,
   "end": 558.62,
   "text": "ولعبد عبدي. کسی که تو این ماه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 558.62,
   "end": 562.18,
   "text": "عبودیت منو بکنه، اون بنده منه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 562.18,
   "end": 565.36,
   "text": "یعنی کأنّ اینطوریه، برداشت بنده اینطوریه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 565.36,
   "end": 567.78,
   "text": "شما اگر اشکالی دارید بفرمایید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 567.78,
   "end": 570.48,
   "text": "کأنّ هیچ حجابی نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 570.48,
   "end": 576.64,
   "text": "هرکس تو این، توی این ماه خدا رو بخونه و عبودیت خدا رو داشته باشه هیچ حجابی نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 576.64,
   "end": 579.2,
   "text": "می‌شه عبدی، بنده من.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 579.2,
   "end": 582.42,
   "text": "همه حجاب‌ها میره کنار. الله اکبر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 582.42,
   "end": 586.66,
   "text": "ورحمت رحمتی. این رحمت که تو این ماهه خاصه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 586.66,
   "end": 589.6,
   "text": "رحمت منه، رحمتی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 589.6,
   "end": 592.06,
   "text": "کأنّ واسطه ها هم برداشته می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 592.06,
   "end": 596.2,
   "text": "هیچ واسطه‌ای دیگه نیست. مستقیم خودمو بنده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 596.2,
   "end": 601.18,
   "text": "الله اکبر. فمن دعاني في هذا الشهر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 601.18,
   "end": 608.46,
   "text": "أجبته. پس هرکسی که در این ماه منو بخونه جوابشو میدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 608.46,
   "end": 611.06,
   "text": "و من سألني أعطيته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 611.06,
   "end": 615.54,
   "text": "هرکسی که گداي من باشه سؤال کنه عطا می‌کنم بهش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 615.54,
   "end": 617.58,
   "text": "و من استهداني",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 617.58,
   "end": 620.86,
   "text": "هديته. هرکسی که هدایت بخواد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 620.86,
   "end": 622.79,
   "text": "منم که هدایتش می‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 622.79,
   "end": 626.06,
   "text": "واگذارش به کس دیگه نمی‌کنم، خودم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 626.06,
   "end": 630.42,
   "text": "وجعلت هذا الشهر حبلاً بيني و بين عبادي.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 630.42,
   "end": 634.4,
   "text": "هیچ‌وقت یادم نمیره آقا مجتبی چقدر تاکید رو این جمله داشتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 634.4,
   "end": 638.36,
   "text": "می‌فرمود ببینید خدا فرموده این ماه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 638.36,
   "end": 642.7,
   "text": "اون هبل، اون ریسمان بین من و بندمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 642.7,
   "end": 647.46,
   "text": "این ماه. یعنی کسی این ماه رو از دست بده دیگه ریسمان رو از دست داده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 647.46,
   "end": 652.12,
   "text": "وجعلت هذا الشهر حبلاً بيني و بين عبادي.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 652.12,
   "end": 655.28,
   "text": "فمن اتسم به وصل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 655.28,
   "end": 658.38,
   "text": "إلي. الله اکبر، الله اکبر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 658.38,
   "end": 663.5,
   "text": "هرکس که این ریسمان رو بگیره وصل إلي، به من وصل شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 663.5,
   "end": 666.0,
   "text": "این ریسمان چیه؟ ماه رجب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 666.0,
   "end": 670.74,
   "text": "الله اکبر از این ماه. چه خبره تو درونای این ماه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 670.74,
   "end": 676.28,
   "text": "چه کرده؟ خدا چی رو آماده کرده برای ما؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 676.28,
   "end": 680.96,
   "text": "بعد متاسفانه همه خیلی از کنارش راحت رد می‌شن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 680.96,
   "end": 684.04,
   "text": "می‌گیم حالا ماه شعبان هم هست، حالا ر-رمضان هم هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 684.04,
   "end": 686.52,
   "text": "این آمادگی میاره برای اون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 686.52,
   "end": 689.04,
   "text": "یکی دو تا دستور هم تقدیم می‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 689.04,
   "end": 692.64,
   "text": "ببخشید یه ذره امروز طول کشید، مناسبت خاصه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 692.64,
   "end": 696.2,
   "text": "اونایی که تو سیر و سلوکن، عزیزانی که یکشنبه‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 696.2,
   "end": 700.0,
   "text": "چهره‌هایی که بعضیا می‌بینم میان لواسان، رساله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 700.0,
   "end": 704.16,
   "text": "س-- علامه طباطبایی رو اونجا داریم کار می‌کنیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 704.16,
   "end": 710.72,
   "text": "به درد اونا می‌خوره. آقای قاضی و بسیاری از بزرگان فرمودن برای سالک الی الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 710.72,
   "end": 714.96,
   "text": "خیلی مهمه که در کل این ماه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 714.96,
   "end": 719.64,
   "text": "ده هزار بار سوره توحید بخونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 719.64,
   "end": 721.96,
   "text": "شروع کنید تو کل ماه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 721.96,
   "end": 727.92,
   "text": "انجام بدید. هر چند تا می‌تونید تو هر روز تا ماه تموم شد ده هزار تا باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 727.92,
   "end": 732.12,
   "text": "کس-- این کأنَّ مُهر می‌زنه به سالک الی الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 732.12,
   "end": 735.82,
   "text": "یعنی میخ کوبت می‌کنه تو مسیر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 735.82,
   "end": 737.58,
   "text": "سلوک. این یک نکته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 737.58,
   "end": 744.4,
   "text": "اونایی هم که گیر و گروه‌های مالی بالاخره دارن و حتی رزق‌های معنوی می‌خوان، رزق‌های مالی، معنوی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 744.4,
   "end": 749.34,
   "text": "از هر نوعش. دیدم بعضی از بزرگان مخصوصا آقا نجفی اصفهانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 749.34,
   "end": 752.86,
   "text": "رضوان الله اصفهانی فرمودن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 752.86,
   "end": 755.58,
   "text": "در کل این ماه روزی دوازده بار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 755.58,
   "end": 759.38,
   "text": "آیه نوزده سوره شعراء رو اگر کسی بخونه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 759.38,
   "end": 761.64,
   "text": "رزقشو خدا زیاد می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 761.64,
   "end": 765.56,
   "text": "اعم از مالی، معنوی، علمی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 765.56,
   "end": 768.5,
   "text": "آبرویی، هرچی. رزق دیگه، مطلق رزق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 768.5,
   "end": 771.64,
   "text": "حتی عمر ما هم رزق ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 771.64,
   "end": 775.86,
   "text": "نسل ما هم رزق ماست. برکت وجود ما رزق ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 775.86,
   "end": 777.74,
   "text": "این آیه رو می‌خونم، کوتاهه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 777.74,
   "end": 780.7,
   "text": "الله لطيف بعباده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 780.7,
   "end": 783.26,
   "text": "يرزق من يشاء",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 783.26,
   "end": 785.68,
   "text": "وهو القوي العزيز.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 214,
   "start": 785.68,
   "end": 788.0,
   "text": "آیه نوزده سوره شعراء.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 215,
   "start": 788.0,
   "end": 793.36,
   "text": "اون دستور العملیم که پارسال خدمت دوستان تو مسجد بلال گفتم شروع",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 216,
   "start": 793.36,
   "end": 796.12,
   "text": "درس و بحثامون چهارشنبه‌ها،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 217,
   "start": 796.12,
   "end": 798.88,
   "text": "در کوزه آب ندیده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 218,
   "start": 798.88,
   "end": 801.36,
   "text": "که سی تا قدر بهش بخونی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 219,
   "start": 801.36,
   "end": 804.1,
   "text": "کل سال از اون آب برای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 220,
   "start": 804.1,
   "end": 806.5,
   "text": "خوردن تو خونه استفاده کنی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 221,
   "start": 806.5,
   "end": 810.74,
   "text": "برای وضو نه، خوردن استفاده کنی برکت میاد تو زندگیتون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 222,
   "start": 810.74,
   "end": 813.5,
   "text": "بهترین وقتش دیشب و امروزه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 223,
   "start": 813.5,
   "end": 818.74,
   "text": "این هم یادتون باشه. اللهم بارک لمولانا صاحب الزمان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 224,
   "start": 818.74,
   "end": 823.1,
   "text": "والحمد لله رب العالمين لصار امام باقر صلوات الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 225,
   "start": 823.1,
   "end": 827.34,
   "text": "اللهم صل على محمد و آل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 226,
   "start": 827.34,
   "end": 830.74,
   "text": "محمد و عجل فرجهم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}