 "chapters": [
  {
   "index": 0,
   "title": "## هود/۳۳؛ آوردن عذاب فقط به مشیت خدا",
   "start": 19.28,
   "end": 119.02
  },
  {
   "index": 1,
   "title": "## زجر نوح؛ پنجاه سال دعوت و ساخت کشتی",
   "start": 119.02,
   "end": 312.22
  },
  {
   "index": 2,
   "title": "## المیزان؛ توحید افعالی و نفی استقلال پیامبر",
   "start": 312.22,
   "end": 414.74
  },
  {
   "index": 3,
   "title": "## صدرالمتألهین و علامه حسن‌زاده؛ فنای فعلی",
   "start": 414.74,
   "end": 576.16
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 6.96,
   "end": 10.7,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 10.7,
   "end": 16.06,
   "text": "السلام علیک ای داعی الله و ربانی ای آیه سه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 16.06,
   "end": 19.28,
   "text": "سلام علیکم و رحمت الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 19.28,
   "end": 22.2,
   "text": "در آیه سی و سه سوره هود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 22.2,
   "end": 25.82,
   "text": "می‌خوانیم که . حضرت نوح علی نبی نبو ع و علیه صلوة السلام فرمودند که جز این نیست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 25.82,
   "end": 28.84,
   "text": "که اگر خدا بخواهد اون رو برای شما میاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 28.84,
   "end": 47.92,
   "text": "شما هم عاجز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 47.92,
   "end": 52.04,
   "text": "کننده نیستید. نمی‌تونید جلو آوردن اون رو بگیرید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 52.04,
   "end": 60.42,
   "text": "اون چیه؟ که یعنی ان شاء الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 60.42,
   "end": 63.16,
   "text": "اگر خدا بخواهد او می‌آید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 63.16,
   "end": 71.22,
   "text": "عذابه. سراغ داری قومی رو که از پیغمبرش درخواست عذاب کرده باشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 71.22,
   "end": 73.6,
   "text": "یه شخص ملعون خبیثی بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 73.6,
   "end": 79.18,
   "text": "این در سأل سائل بعذاب واقع هست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 79.18,
   "end": 82.86,
   "text": "از سوره معارج. اونجا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 82.86,
   "end": 87.06,
   "text": "وقتی که جانشینی امیرالمؤمنین معرفی شد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 87.06,
   "end": 91.24,
   "text": "اون ملعون خبیث به پیغمبر گفت اگه قراره ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 91.24,
   "end": 97.88,
   "text": "اماممون، پیشوامون، زعیممون از این به بعد این ایشون باشه، جسارت هم کرد ملعون،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 97.88,
   "end": 104.72,
   "text": "همین الان سنگ، سنگ عذابی از آسمون بیاد به سر من کوبیده بشه و منو به درک برسونه و همون اتفاق افتاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 104.72,
   "end": 107.3,
   "text": "سأل سائل بعذاب واقع.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 107.3,
   "end": 109.52,
   "text": "عذابی که واقعیت پیدا کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 109.52,
   "end": 115.0,
   "text": "واقع شد. چقدر آدم باید پست باشه که از خدا تقاضای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 115.0,
   "end": 117.0,
   "text": "عذاب کنه برای یک حقیقت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 117.0,
   "end": 121.36,
   "text": "اینا اینطوری بودن. روایت داریم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 121.36,
   "end": 129.94,
   "text": "بعد از حالا نبی اکرم اسلام که از همه پیامبرها بیشتر از همه انبیا زجر کشید، سختی کشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 129.94,
   "end": 133.64,
   "text": "یکی از انبیا که بیش از همه سختی کشید حضرت نوح",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 133.64,
   "end": 136.64,
   "text": "بود. نهصد و پنجاه سال نبوّت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 136.64,
   "end": 140.08,
   "text": "قریب به دو هزار سال عمر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 140.08,
   "end": 145.24,
   "text": "انقدر اذیتش کردن، کتک می‌زدن، پیغمبر خدا رو می‌زدن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 145.24,
   "end": 146.94,
   "text": "و بهش می‌گفتن این دیوانه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 146.94,
   "end": 151.94,
   "text": "این العوذ بالله مجنون. وقتی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 151.94,
   "end": 156.94,
   "text": "اومدن بهش گفتن که از خدا بخواه دیگه عذاب رو بیاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 156.94,
   "end": 158.62,
   "text": "مگه تو نمیگی که ای پیغمبر؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 158.62,
   "end": 163.0,
   "text": "مگه نمیگید اگر دعوت منو لبیک نگید عذاب میاد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 163.0,
   "end": 166.22,
   "text": "خب بسم الله بگید عذاب بیاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 166.22,
   "end": 170.58,
   "text": "وقتی این چنین گفت تفاسیر روایی میگن که اینا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 170.58,
   "end": 175.78,
   "text": "این روایت، این آیه رو به زبان جاری کرد که قال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 175.78,
   "end": 178.06,
   "text": "حضرت نوح فرمود سوره، سوره هوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 178.06,
   "end": 182.86,
   "text": "اما فرمایش حضرت نوحه. فرمود که انما، انما هم که حصر دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 182.86,
   "end": 192.8,
   "text": "فقط و فقط فقط و فقط خداست که می‌تونه عذاب رو بیاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 192.8,
   "end": 196.12,
   "text": "خیلی جالبه پیغمبر با اون عظمت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 196.12,
   "end": 202.36,
   "text": "از خودش خلع ید می‌کنه. میگه آوردن عذاب هم دست خداست، دست من نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 202.36,
   "end": 206.28,
   "text": "بعد اونا خندیدن، تمسخر کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 206.28,
   "end": 215.16,
   "text": "وقتی که خندیدن و تمسخر کردن به پیغمبر همونجا حکم نازل شد بر حضرت نوح که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 215.16,
   "end": 219.12,
   "text": "دست به کار شو برای کشتی که دیگه مشیت خدا برای عذاب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 219.12,
   "end": 227.18,
   "text": "تحقق پیدا کرده. که حالا کمترین روایتی که من دیدم هست چهار ساله که مشغول ساختن کشتی بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 227.18,
   "end": 229.48,
   "text": "چهار سال. شوخی نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 229.48,
   "end": 231.8,
   "text": "بعد هر روز می‌رفت چی شد عذاب؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 231.8,
   "end": 234.58,
   "text": "تمسخر می‌کردن. می‌خندیدن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 234.58,
   "end": 238.96,
   "text": "تا اینکه یه روز دیگه انقدر تمسخر رو به اوج رسوندن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 238.96,
   "end": 242.44,
   "text": "بارانی از آسمان چکید به دست حضرت نوح.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 242.44,
   "end": 246.08,
   "text": "یه قطره بارون افتاد به دست حضرت نوح.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 246.08,
   "end": 251.42,
   "text": "حضرت یقین حاصل کرد که عذاب می‌خواد بیاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 251.42,
   "end": 256.98,
   "text": "حالا این، از امام صادق صلوة الله علیه روایت داریم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 256.98,
   "end": 264.16,
   "text": "نوح مابین دعوت و مأموریت به ساختن کشتی پنجاه سال فاصله داشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 264.16,
   "end": 267.36,
   "text": "یعنی از وقتی که دعوت کرد تا وقتی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 267.36,
   "end": 272.42,
   "text": "اجابت نکردند و دستور ساختن کشتی اومد پنجاه سال.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 272.42,
   "end": 279.24,
   "text": "شوخی نیست. کسی که از طرف خدا اومده پنجاه سال مردم رو دعوت کنه همش تمسخر بشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 279.24,
   "end": 289.42,
   "text": "و کتک و آزار. من از اساتیدمون شنیدم که بعد از پیغمبر ما هیچکس اندازه حضرت نوح زجر نکشیده، کتک نخورده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 289.42,
   "end": 293.62,
   "text": "یعنی می‌رفت بالای کوه مردم رو دعوت می‌کرد می‌ریختن ایل و طواید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 293.62,
   "end": 296.92,
   "text": "خود همین ایل و طواید همه با هم با قوم و خویششون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 296.92,
   "end": 301.34,
   "text": "نه یکی دو نفر. می‌ریختن انقدر حضرت رو می‌زدن بیهوش میشد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 301.34,
   "end": 306.12,
   "text": "ما چند تامون در راه خدا یه چک خوردیم تا حالا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 306.12,
   "end": 310.28,
   "text": "حالا یکی دو تا نظر سه تا اجازه بدید براتون تند تند بخونم اینو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 310.28,
   "end": 312.22,
   "text": "ما که حرفی برای گفتن نداریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 312.22,
   "end": 315.1,
   "text": "بزرگان اهل معرفت باید حرف بزنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 315.1,
   "end": 317.58,
   "text": "اول از علامه طباطبایی علیه رحمة",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 317.58,
   "end": 320.62,
   "text": "از المیزان نکته‌ای رو اینجا یادداشت کردم براتون بخونم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 320.62,
   "end": 323.66,
   "text": "ذیل همین آیه می‌فرماید نوح علیه السلام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 323.66,
   "end": 329.4,
   "text": "در این پاسخ حقیقت توحید در افعال را به قومش تعلیم کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 329.4,
   "end": 334.54,
   "text": "آنان اراده خدا را با اختیار پیامبر خلط کرده بودند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 334.54,
   "end": 338.5,
   "text": "نوح بیان کرد که وسائط مأمورند، نه مستقل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 338.5,
   "end": 343.34,
   "text": "درسته من پیغمبر خدا هستم اما در آوردن عذاب الهی هم مستقل نیستم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 343.34,
   "end": 347.6,
   "text": "خدا باید بخواد. پس انما دلالت بر حصر دارد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 347.6,
   "end": 352.54,
   "text": "و مراد نفی استقلال پیامبر در تحقق فعل الهی است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 352.54,
   "end": 357.28,
   "text": "این آیه تأکید بر قانون کلی ربوبی است که هیچ چیزی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 357.28,
   "end": 359.62,
   "text": "به جز به مشیت واقع نمی‌شود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 359.62,
   "end": 367.0,
   "text": "در مقام فعل خداوند محیط است و همه اسباب در طول مشیت اویند، نه در عرض آن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 367.0,
   "end": 370.12,
   "text": "حتی پیغمبر خیلی حرف‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 370.12,
   "end": 374.56,
   "text": "یعنی در توحید افعالی می‌بینید به جایی می‌رسه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 374.56,
   "end": 378.76,
   "text": "باید بگه خب من الان از خدا تقاضا می‌کنم و عذاب بیاد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 378.76,
   "end": 384.12,
   "text": "شاخ و شونه بکشه بگه بله عذاب می‌خواید همین الان چنان معذبتون بکنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 384.12,
   "end": 386.58,
   "text": "اصلاً حرفی از خودش نمی‌زنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 386.58,
   "end": 389.02,
   "text": "میگه فقط دست خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 389.02,
   "end": 392.64,
   "text": "برعکس ما. خدا نکنه یه مقدار قدرت پیدا کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 392.64,
   "end": 394.78,
   "text": "پشت میز بشینیم. قلمی دستمون بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 394.78,
   "end": 397.02,
   "text": "بیچارت می‌کنم. پدرتو درمیارم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 397.02,
   "end": 401.06,
   "text": "یذره از حقوقتو به چیز کنم، کم کنم، فلانت کنم، بسارت کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 401.06,
   "end": 406.92,
   "text": "من، من، من. امان از این میم آخرش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 406.92,
   "end": 410.58,
   "text": "این میم و نون آخرش. من، من، من، من.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 410.58,
   "end": 414.74,
   "text": "انبیا نداشتن. حتی در عذاب الهی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 414.74,
   "end": 417.68,
   "text": "نظر صدر المتألهین هم بخونم خیلی زیباست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 417.68,
   "end": 419.9,
   "text": "نوح در مقام فنای فعلی بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 419.9,
   "end": 423.02,
   "text": "همون چی بود؟ توحید افعالی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 423.02,
   "end": 427.2,
   "text": "از خود نفی قدرت کرد و فعل را برای حق اثبات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 427.2,
   "end": 430.26,
   "text": "إنما يأتیکم به الله إن شاء",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 430.26,
   "end": 435.1,
   "text": "اشاره است به فنای فاعل در فاعل حقیقی در این مقام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 435.1,
   "end": 440.22,
   "text": "عبد تنها مجرای اراده تکوینی الهی‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 440.22,
   "end": 445.06,
   "text": "فقط مجراست. عبد فقط مجراست، کاناله، وسیله‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 445.06,
   "end": 447.3,
   "text": "همه‌چی دست خداست. و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 447.3,
   "end": 456.5,
   "text": "ادامه میده که نوح از آنجا که مظهر اسم المنتقم و در عین حال غل اسم الرحمن بود با گفتن این جمله وجه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 456.5,
   "end": 459.14,
   "text": "ملکی و ملکوتی را جمع کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 459.14,
   "end": 464.94,
   "text": "عذاب از حق است نه از من، ولی من مظهر آنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 464.94,
   "end": 468.58,
   "text": "نظر علامه حسن زاده رم دوست دارید بشنوید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 468.58,
   "end": 471.14,
   "text": "سه خطه. اگه حالشو دارید صلوات بفرستید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 471.14,
   "end": 473.7,
   "text": "اللهم صل علی محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 473.7,
   "end": 478.54,
   "text": "و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 478.54,
   "end": 482.24,
   "text": "دیگه ما بعد از نماز صحبت کردیم که اگه کسی کاری داره بره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 482.24,
   "end": 489.82,
   "text": "هی این پا اون پا نشه. علامه می‌فرماید چون نوح گفت إنما يأتیکم به الله إن شاء مقام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 489.82,
   "end": 492.94,
   "text": "تفویض را تمام کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 492.94,
   "end": 496.92,
   "text": "عبدی که بداند فعل از او نیست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 496.92,
   "end": 501.92,
   "text": "بلکه از اوست که حق ظاهر می‌شود،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 501.92,
   "end": 505.76,
   "text": "به ساحت فنای فعلی رسیده است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 505.76,
   "end": 508.58,
   "text": "کسی که بدونه لا حول و لا قوه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 508.58,
   "end": 511.02,
   "text": "الا بالله العلی العظیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 511.02,
   "end": 514.06,
   "text": "این رسیده به ساحت فنای فعلی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 514.06,
   "end": 518.62,
   "text": "یعنی فعل خودش رو فانی در فعل حضرت حق می‌بینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 518.62,
   "end": 523.74,
   "text": "اصلاً از خودش حرفی نداره، اراده‌ای نداره مگر به اراده الهی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 523.74,
   "end": 530.14,
   "text": "شما تو نماز که پا میشی میگی به حول الله و درسته أقوم و أقعد من پا میشم من می‌شینم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 530.14,
   "end": 533.9,
   "text": "اون سیئه است چون من میشه أقوم و أقعد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 533.9,
   "end": 538.04,
   "text": "من خرابش می‌کنم. اما به حول الله و قوته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 538.04,
   "end": 545.36,
   "text": "همه‌چی به حول و قوه اوست. و تا این رفقا درست نشه عبودیت ما رنگ و بوی توحیدی نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 545.36,
   "end": 551.44,
   "text": "رک بگم. ما مخصوصاً داریم-- یعنی من خودمم به یکباره افتادم تو این وادی‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 551.44,
   "end": 555.4,
   "text": "ما بحثمون قلب مطمئن بود اگه یادتون باشه چند ماه پیش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 555.4,
   "end": 557.96,
   "text": "کشیده شد به بحث توحید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 557.96,
   "end": 563.04,
   "text": "شاید اونا خواستن. حوصله کنید ببینید چه بلایی سرمون میاد آخر بحث.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 563.04,
   "end": 566.98,
   "text": "والحمدالله مبارک لمولانا صاحب الزمان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 566.98,
   "end": 569.04,
   "text": "والحمد لله رب العالمين.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 569.04,
   "end": 576.16,
   "text": "صلوات بفرستید. اللهم صل علی محمد و آل محمد و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}