 },
 "chapters": [
  {
   "index": 0,
   "title": "## یتلو علیهم آیاته؛ تلاوت و شیرینی حق",
   "start": 194.0,
   "end": 214.36
  },
  {
   "index": 1,
   "title": "## صد و بیست و چهار هزار؛ رمز کثرت",
   "start": 214.36,
   "end": 646.72
  },
  {
   "index": 2,
   "title": "## صادر اول و مقام عَما",
   "start": 646.72,
   "end": 973.04
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.34,
   "end": 3.08,
   "text": "اللهم صل علی محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 3.08,
   "end": 6.78,
   "text": "و آل محمد و عجل فرج.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 6.78,
   "end": 10.48,
   "text": "بسم الله الرحمن الرحيم و به این استعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 10.48,
   "end": 16.46,
   "text": "السلام علیک یا داعی الله و ربانی آیات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 16.46,
   "end": 18.68,
   "text": "سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 18.68,
   "end": 22.96,
   "text": "تبریک عرض می‌کنم ایام رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 22.96,
   "end": 26.42,
   "text": "روز مبعث پیغمبر عزیز عالم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 26.42,
   "end": 30.72,
   "text": "به‌قدری تلألؤ نوری داره که اطراف خودش رو هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 30.72,
   "end": 36.32,
   "text": "پر از نور می‌کنه. فقط همون روزی-- سه دلیلی که عرفا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 36.32,
   "end": 41.76,
   "text": "قبل و بعد هر مناسبت خاصی رو هم تعظیم می‌کردن تلألؤ نورمونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 41.76,
   "end": 46.26,
   "text": "مثل اینکه شما خورشید رو ببینی یک جا، چقدر فاصله داره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 46.26,
   "end": 50.14,
   "text": "اما تمام اطرافش رو روشن کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 50.14,
   "end": 52.58,
   "text": "فقط این نیست که همون روز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 52.58,
   "end": 55.22,
   "text": "شدت نور داشته باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 55.22,
   "end": 59.78,
   "text": "اینم خودش یک نکته‌ایه. البته حضرت امام روحشون شاد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 59.78,
   "end": 63.04,
   "text": "می‌فرمودن که ما بالاتر از این عید نداریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 63.04,
   "end": 68.16,
   "text": "علتشم می‌فرمیدند. ما مبعث رو بهترین و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 68.16,
   "end": 70.68,
   "text": "با عظمت‌ترین اعیاد باید بدونیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 70.68,
   "end": 76.12,
   "text": "علتش هم اینه که اگر مبعث رو شما برداری،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 76.12,
   "end": 80.68,
   "text": "اصلا ملک و ملکوت ارتباطشون قطع میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 80.68,
   "end": 84.04,
   "text": "اگر ملک و ملکوت ارتباطش قطع بشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 84.04,
   "end": 88.22,
   "text": "چه اتفاقی می‌افته؟ هیچ خبری از نور و نورانیت و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 88.22,
   "end": 95.46,
   "text": "عالم قدس نیست. یعنی زندگی‌ها همه خاکی و مادی و حیوانی و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 95.46,
   "end": 98.84,
   "text": "بلهم ازل. اینچنین میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 98.84,
   "end": 101.1,
   "text": "ما هرچی داریم از کجاست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 101.1,
   "end": 104.18,
   "text": "هرچی داریم إنا أنزلناه في",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 104.18,
   "end": 106.8,
   "text": "ليلة القدر. همش از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 106.8,
   "end": 111.46,
   "text": "شب قدره. خب چی؟ أنزلناه چی نازل شد در شب قدر؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 111.46,
   "end": 115.52,
   "text": "قرآن. شما حالا پی-- بعثت پیغمبر رو بردار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 115.52,
   "end": 121.78,
   "text": "دیگه قرآنی وجود نداره. هو الذي بعث في الأميين رسولا منهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 121.78,
   "end": 125.42,
   "text": "يتلو عليهم آياته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 125.42,
   "end": 129.3,
   "text": "اول می‌فرمود او خدا خودش رو اینچنین معرفی می‌کنه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 129.3,
   "end": 133.22,
   "text": "او کسی‌ست که مبعوث کرد پیغمبری رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 133.22,
   "end": 135.58,
   "text": "خیلی جالبه می‌فرمود منهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 135.58,
   "end": 139.66,
   "text": "از خودشون. این خیلی نکته‌ست توش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 139.66,
   "end": 142.22,
   "text": "پیغمبر از خودشونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 142.22,
   "end": 146.48,
   "text": "یعنی چیز جدایی از ما نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 146.48,
   "end": 151.02,
   "text": "جنس پیغمبر به گونه‌ایه که ما هم جنس اون هستیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 151.02,
   "end": 154.44,
   "text": "یعنی اگر حواسمون نباشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 154.44,
   "end": 161.36,
   "text": "اگر همین جوری که هستیم باشیم به قول بزرگان فرمودن استعدادمون رو مضمحل نکنیم، این مقام شفاعته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 161.36,
   "end": 165.62,
   "text": "چون جنس ما از هم جنس پیغمبره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 165.62,
   "end": 169.12,
   "text": "رسولم منهم. این یه نکته‌شه البته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 169.12,
   "end": 171.98,
   "text": "اما اگر رها کنیم خودمون رو،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 171.98,
   "end": 176.72,
   "text": "یله بار بیاییم، بی‌هیچ قید و بندی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 176.72,
   "end": 178.34,
   "text": "اصطلاحا میگن لاغبالی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 178.34,
   "end": 180.32,
   "text": "این چنین جسارتا بار بیاییم چرا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 180.32,
   "end": 183.04,
   "text": "ما دیگه از مقام شفاعت فاصله می‌گیریم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 183.04,
   "end": 186.6,
   "text": "و استعدادمون مضمحل میشه و شفاعتی هم در کار نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 186.6,
   "end": 189.98,
   "text": "رضا فرمودن شفاعت رو از همین جا باید با خودت ببری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 189.98,
   "end": 192.5,
   "text": "خب حالا اگر این بعثت نبود،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 192.5,
   "end": 199.76,
   "text": "چه اتفاقی می‌افتاد؟ بلافاصله بعد از بعثت پیغمبر می‌فرماید يتلو عليهم آياته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 199.76,
   "end": 204.54,
   "text": "اصلا پیغمبر مبعوث شد برای اینکه بیاد آیات الهی رو تلاوت کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 204.54,
   "end": 206.58,
   "text": "تلاوت هم قبلا عرض کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 206.58,
   "end": 212.26,
   "text": "تلاوت خوردن یه چیزیه به همراه چیزی که شیرینش می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 212.26,
   "end": 215.46,
   "text": "به این میگن تلاوت. حتی اگر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 215.46,
   "end": 222.72,
   "text": "تو به هر دلیلی به آیه‌ای از آیات الهی می‌رسیدی که نمی‌رسیدی، اگر هم می‌رسیدی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 222.72,
   "end": 225.72,
   "text": "اگر بعثت پیغمبر نبود،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 225.72,
   "end": 229.58,
   "text": "اون برای تو تلخ بود. چون يتلو عليهم آياته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 229.58,
   "end": 234.44,
   "text": "شما چایی رو می‌خوری، قبلا هم عرض کردیم تلذ،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 234.44,
   "end": 237.32,
   "text": "تلذ یعنی بغل، کنار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 237.32,
   "end": 239.94,
   "text": "تلذ یعنی کنار. این که میگه تلاوت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 239.94,
   "end": 242.96,
   "text": "یعنی کنار، کنار قرآن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 242.96,
   "end": 246.94,
   "text": "می‌خوای قرآن رو تلاوت کنی کنارش یه چیزی باید باشه تا شیرین باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 246.94,
   "end": 249.94,
   "text": "چون الحق مر. حق تلخه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 249.94,
   "end": 254.46,
   "text": "باید شیرینش کنی. مثل اینکه چایی رو می‌خوری چرا با قند می‌خوری؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 254.46,
   "end": 259.84,
   "text": "که شیرین بشه. چایی رو با قند و شکر که می‌خوری یعنی تلاوتش کردی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 259.84,
   "end": 267.34,
   "text": "قرآن رو بدون پیغمبر، اصلا هر آیه‌ای از آیات الهی رو تو می‌تونی ادعا کنی منم آیت الله‌ام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 267.34,
   "end": 272.74,
   "text": "بله. و في الأرض آيات للموقنين و في أنفسكم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 272.74,
   "end": 279.02,
   "text": "آیات الهی در این زمین هست و در جان‌های شما هم هست و خود شما هم آیت اللهی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 279.02,
   "end": 282.26,
   "text": "این قبول. اما اولا اینو از کجا فهمیدی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 282.26,
   "end": 285.52,
   "text": "این آیه‌ای که الان من خوندم کجاست منبعش؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 285.52,
   "end": 288.36,
   "text": "قرآنه. در سوره ذاریاته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 288.36,
   "end": 292.74,
   "text": "اگر قرآن نبود نازل نمی‌شد چه می‌فهمیدی که تو آیت اللهی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 292.74,
   "end": 297.76,
   "text": "بر فرض هم که خودت رو مسح می‌کردی که باز لا يمسه إلا المتحرون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 297.76,
   "end": 299.72,
   "text": "اون طهارت رو کی به تو آموخت؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 299.72,
   "end": 304.2,
   "text": "آموزش داد؟ بر فرض هم بگیم آقا من طهارت داشتم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 304.2,
   "end": 307.4,
   "text": "خودمم آیت الله بودم و مسح کردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 307.4,
   "end": 310.4,
   "text": "تا تلاوت نباشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 310.4,
   "end": 315.82,
   "text": "این شیرین نیست. یعنی تو خودت شیرینی خودتو و شیرینی آیات الهی رو،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 315.82,
   "end": 318.66,
   "text": "این نظام هستی رو نمی‌چشیدی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 318.66,
   "end": 326.1,
   "text": "یعنی چی؟ باید پیغمبری بیاد آیه رو کنار پیغمبر بچشی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 326.1,
   "end": 330.02,
   "text": "باید اینکه امام صادق ازش پرسیدن آقا چرا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 330.02,
   "end": 332.98,
   "text": "قرآن محکم و متشابه داره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 332.98,
   "end": 336.46,
   "text": "فرمودن به جهت اینکه بیاید به ما رجوع کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 336.46,
   "end": 345.58,
   "text": "اگر شما به انسان کامل، به امام معصوم، به پیغمبر عزیز عالم که امیرالمؤمنین هم شاگرد او بوده رجوع نکنید،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 345.58,
   "end": 349.22,
   "text": "شیرینی‌ای در کار نیست. همه‌چی تلخه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 349.22,
   "end": 352.12,
   "text": "حتی خدا هم در کام شما تلخ میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 352.12,
   "end": 355.12,
   "text": "الحق مر. فرمایش مولاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 355.12,
   "end": 358.06,
   "text": "حق تلخه. کی شیرین میشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 358.06,
   "end": 361.06,
   "text": "وقتی تلاوتش کنی. کی تلاوت می‌کنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 361.06,
   "end": 363.4,
   "text": "يتلو عليهم آياته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 363.4,
   "end": 365.62,
   "text": "پيغمبر تلاوت می‌کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 365.62,
   "end": 368.82,
   "text": "و در پس تلاوت پیغمبره که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 368.82,
   "end": 375.86,
   "text": "و یزکیه و یع- و يعلمهم الكتاب و الحكمة تا من و شما یاد بگیریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 375.86,
   "end": 381.58,
   "text": "در پس تلاوت یاد بگیریم تزکیه رو، تزکیه نفس رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 381.58,
   "end": 383.86,
   "text": "یاد بگیریم تعلیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 383.86,
   "end": 388.54,
   "text": "کتاب و حکمت رو. که اگر این تلاوت رو شما بردارید چی میمونه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 388.54,
   "end": 391.62,
   "text": "نه تزکیه‌ای هست، نه تعلیمی هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 391.62,
   "end": 396.58,
   "text": "شما تزکیه و تعلیم رو بگیر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 396.58,
   "end": 399.78,
   "text": "اولئک كالأنعام بل هم أضل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 399.78,
   "end": 403.66,
   "text": "همه حیوانی زندگی می‌کردن. کما اینکه زندگی می‌کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 403.66,
   "end": 407.42,
   "text": "پیغمبر عزیز عالم اومد همه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 407.42,
   "end": 410.14,
   "text": "آدم‌ها رو نجات داد با اینکه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 410.14,
   "end": 412.7,
   "text": "صد و بیست و چهار هزار پیغمبر بودن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 412.7,
   "end": 415.78,
   "text": "حالا شما برنگردید بگید آقا یه دونه کم کن ازش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 415.78,
   "end": 419.74,
   "text": "این عدد رمزیه. صد، صد و بیست و چهار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 419.74,
   "end": 422.8,
   "text": "یک رو دو برابر کن، دو. دو رو دو برابر کن، چهار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 422.8,
   "end": 425.76,
   "text": "همینطور بزنش به عدد کثرت که هزاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 425.76,
   "end": 430.44,
   "text": "یعنی هرچی دلت بخواد ما نبی فرستادیم، پیغمبر فرستادیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 430.44,
   "end": 435.3,
   "text": "از هر قومی هم منهم از خودشون فرستادیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 435.3,
   "end": 441.68,
   "text": "این نه یعنی که صد و بیست و چهار هزار پیغمبر رو منهای یک کن قبل از پیغمبر این تعداد اومده بودن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 441.68,
   "end": 446.64,
   "text": "نه، اینطوری اشتباه نکن. این عدد خودش- همه چی حروف مقطعه‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 446.64,
   "end": 448.94,
   "text": "به قول حضرت استاد خود شما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 448.94,
   "end": 451.72,
   "text": "تمام قرآن، تمام سوره‌ها،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 451.72,
   "end": 456.5,
   "text": "نه فقط اون خام میم مثلا مقطعه باشه، تمام سوره‌های قرآن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 456.5,
   "end": 461.72,
   "text": "تمام کلمات وجودی و نظامی حروف- نظام هستی حروف مقطعه‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 461.72,
   "end": 466.6,
   "text": "رمزه. به قول حضرت استاد علامه حسن زاده علیه الرحمة والرضوان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 466.6,
   "end": 471.2,
   "text": "تمام کلمات وجودی نظام هستی رمزی هستند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 471.2,
   "end": 477.72,
   "text": "رمز و کنزند. تا کی باشه این رمز رو فاش کنه و به این گنج پی ببره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 477.72,
   "end": 479.44,
   "text": "حالا شما پیغمبر رو وردار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 479.44,
   "end": 481.72,
   "text": "امروز بعثت رو بردار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 481.72,
   "end": 485.22,
   "text": "یعنی آیه‌ای بر کسی نازل نشه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 485.22,
   "end": 487.74,
   "text": "یتلو عليهم آياته رو بردار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 487.74,
   "end": 493.34,
   "text": "چه شیرینی، چه لذتی، چه آرامشی، چه علا به ذکر الله تطمئن القلوب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 493.34,
   "end": 499.9,
   "text": "چی میمونه؟ این حالا یه ذره من فراموش از tema رو براتون یه کمی جسارتا باز کردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 499.9,
   "end": 503.38,
   "text": "یه مقدار درون مایه یه جمله این عارف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 503.38,
   "end": 507.86,
   "text": "و این حکیم و متأله رو بدونید چرا می‌فرماید مبعث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 507.86,
   "end": 511.26,
   "text": "بزرگترین عید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 511.26,
   "end": 516.08,
   "text": "جهان اسلامه. چرا واقعا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 516.08,
   "end": 519.88,
   "text": "حتی اهل بیت دیگه هم بیومنه اومدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 519.88,
   "end": 522.04,
   "text": "این بیومنه روز غدیر اول",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 522.04,
   "end": 527.38,
   "text": "به پیغمبر می‌خوره. اگر شما بگی آقا نفر اول، اول عالم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 527.38,
   "end": 530.1,
   "text": "امیرالمؤمنین علی علیه الصلاة والسلام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 530.1,
   "end": 532.98,
   "text": "ایشونه. کما اینکه بعضیا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 532.98,
   "end": 539.8,
   "text": "متأسفانه نفهمیدن امیرالمؤمنین رو مقامشو بردن بالاتر از پیغمبر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 539.8,
   "end": 542.88,
   "text": "اگر اینطوری بگی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 542.88,
   "end": 546.68,
   "text": "خود امیرالمؤمنین علیه الصلاة والسلام فرمود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 546.68,
   "end": 549.62,
   "text": "چون وقتی به پیغمبر گفت: «یا رسول الله!",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 549.62,
   "end": 552.96,
   "text": "منو دعا کن» دیگه شنیدید حدیث شریف رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 552.96,
   "end": 555.02,
   "text": "پیغمبر سجده کردن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 555.02,
   "end": 562.22,
   "text": "و عرضه کردن در محضر حضرت حق که اللهم اغفر لعلی بحق علی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 562.22,
   "end": 564.32,
   "text": "امیرالمؤمنین تعجب کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 564.32,
   "end": 567.08,
   "text": "اغفر لعلی بحق علی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 567.08,
   "end": 571.06,
   "text": "پیغمبر فرمود: «نگاه کردم در کائنات،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 571.06,
   "end": 576.24,
   "text": "در پایین و بالا، مادون و مافوق، در تمام عوالم هستی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 576.24,
   "end": 583.76,
   "text": "چشم انداختم. دیدم اهدی، اهدی محبوب‌تر از تو پیش خدای منان نیست.»",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 583.76,
   "end": 587.1,
   "text": "اون چون جان پیغمبر بود شد محبوب‌ترین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 587.1,
   "end": 592.1,
   "text": "حواسمون باشه. اون أنفسنا و أنفسکم تو قرآن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 592.1,
   "end": 595.56,
   "text": "چون شد جان پیغمبر محبوب‌ترین بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 595.56,
   "end": 598.46,
   "text": "و الا خود امیرالمؤمنین ادعاش چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 598.46,
   "end": 601.92,
   "text": "می‌فرماید أنا عبد من عبید محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 601.92,
   "end": 603.88,
   "text": "صلی الله عليه و آله و سلم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 603.88,
   "end": 606.28,
   "text": "صلی الله علی محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 606.28,
   "end": 608.9,
   "text": "و آله... عبید هم عبد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 608.9,
   "end": 611.08,
   "text": "من عبید. اصلاً بری این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 611.08,
   "end": 614.88,
   "text": "بشکافی این جملات مولا رو متوجه میشی جایگاه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 614.88,
   "end": 617.32,
   "text": "شوخی نکرده امیرالمؤمنین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 617.32,
   "end": 620.0,
   "text": "شکست نفسی نکرده عزیز دلم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 620.0,
   "end": 627.62,
   "text": "جایگاه پیغمبر عزیز عالم را اگر کسی متوجه بشه می‌فهمه که به حق فرموده امیرالمؤمنین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 627.62,
   "end": 630.28,
   "text": "من عبدیم از،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 630.28,
   "end": 633.54,
   "text": "اونم از. یعنی عبد زیاد داره این آقا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 633.54,
   "end": 637.06,
   "text": "یکیش منم. اونم عبید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 637.06,
   "end": 639.2,
   "text": "حالا من یکی از اونهاهام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 639.2,
   "end": 641.32,
   "text": "می‌خوای بدونی من کیم؟ عبیدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 641.32,
   "end": 644.86,
   "text": "یعنی به شدت بنده او هستم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 644.86,
   "end": 652.34,
   "text": "الله اکبر. یعنی به فرمایش حضرت استاد تمام اولیاء خدا حتی امیرالمؤمنین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 652.34,
   "end": 658.66,
   "text": "رفت به اون مقامات. اگر بگیریم عارف عربی درست گفته در فصوصش و در فتوحاتش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 658.66,
   "end": 662.8,
   "text": "که دو نفر به مقام صادر اول رسیدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 662.8,
   "end": 666.56,
   "text": "صادر نخستین. نفس الرحمن که ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 666.56,
   "end": 670.3,
   "text": "یعنی در حقیقت برزخ بین حق و خلقه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 670.3,
   "end": 673.4,
   "text": "هر فیضی به خلائق می‌رسه از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 673.4,
   "end": 679.56,
   "text": "صادر اول می‌رسه. بهش میگن وجود منبسط یا فیض منبسط.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 679.56,
   "end": 682.38,
   "text": "الذ الممدود. ألم تر إلى",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 682.38,
   "end": 686.96,
   "text": "ربك كيف مد الظل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 686.96,
   "end": 689.1,
   "text": "آیا ندیدی پروردگارت این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 689.1,
   "end": 690.74,
   "text": "سایه رو چگونه می‌کشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 690.74,
   "end": 696.66,
   "text": "مد الظل. این الذ الممدود سایه کشیده شده چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 696.66,
   "end": 699.72,
   "text": "همون برزخ بین حق و خلقه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 699.72,
   "end": 701.86,
   "text": "واسطه فیض حق و خلقه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 701.86,
   "end": 705.6,
   "text": "هرچی به خلائق رسیده از حق رسیده دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 705.6,
   "end": 708.98,
   "text": "خب کی واسطه بوده؟ صادر اول.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 708.98,
   "end": 717.72,
   "text": "درسته؟ عارف عربی فرمود دو کس رسیدن به اون مقام که اسمش یکی دیگه از اسمای دیگش بوده، صد تا اسم داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 717.72,
   "end": 720.48,
   "text": "یکی دیگه از اسماش هست أما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 720.48,
   "end": 728.82,
   "text": "با عین. از پیغمبر عزیز عالم پرسیدن خداوند متعال قبل از خلقت کجا بود؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 728.82,
   "end": 735.08,
   "text": "فرمود در عما بود. عما در عربی ابرهای متراکم و در هم فشرده رو میگن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 735.08,
   "end": 737.66,
   "text": "همون مقام نفس الرحمن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 737.66,
   "end": 740.1,
   "text": "یعنی هنوز خلق نیست. خب عماس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 740.1,
   "end": 744.46,
   "text": "عما واسطه بین حق حضرت حق و خلقه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 744.46,
   "end": 747.14,
   "text": "پیغمبر به اون مقام رفته رسیده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 747.14,
   "end": 749.8,
   "text": "بله. دیگه کی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 749.8,
   "end": 752.92,
   "text": "به قول عارف عربی امیرالمؤمنین هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 752.92,
   "end": 755.6,
   "text": "رسیده به اون مقام که واسطه فیض بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 755.6,
   "end": 758.86,
   "text": "اما خود امیرالمؤمنین می‌فرماد من",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 758.86,
   "end": 763.82,
   "text": "بنده‌ای هستم از اون بندگان به شدت بنده پیغمبر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 763.82,
   "end": 767.38,
   "text": "اینجاست که حضرت استاد زبان پاکش رو باز می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 767.38,
   "end": 772.08,
   "text": "دهان علوی بلکه علوی‌ش رو باز می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 772.08,
   "end": 776.76,
   "text": "می‌فرماد که امیرالمؤمنین هم به تبع پیغمبر به اون مقام رسیده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 776.76,
   "end": 779.8,
   "text": "تنها یک نفر در عالم وجود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 779.8,
   "end": 782.54,
   "text": "بلا صله این تمام این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 782.54,
   "end": 787.72,
   "text": "قوس صعود رو رفته به عالی‌ترین مراتب که مقام عماس رسیده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 787.72,
   "end": 789.98,
   "text": "اون هم پیغمبر عزیز عالمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 789.98,
   "end": 798.74,
   "text": "یعنی بی‌هیچ واسطه‌ای. بقیه حتی امیرالمؤمنین بله، حتی حضرت فاطمه زهرا بله،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 798.74,
   "end": 801.32,
   "text": "همه حتی امام عصر ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 801.32,
   "end": 803.84,
   "text": "بله، تمام انبیا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 803.84,
   "end": 810.14,
   "text": "و اولیا و ائمه همه به تبع پیغمبر رفتن رسیدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 810.14,
   "end": 815.74,
   "text": "نه الان در تمام ادوار یعنی دوره‌های پیش از ما و دوره‌های بعد از ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 815.74,
   "end": 817.76,
   "text": "ما الان در دو-- کدوم دوره هستیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 817.76,
   "end": 820.9,
   "text": "عددشو کی می‌تونه بگه؟ چه می‌دونیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 820.9,
   "end": 827.08,
   "text": "امام صادق صلوات الله علیه فرمود: \"الف الف آدم بوده و خواهد آمد.\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 827.08,
   "end": 829.1,
   "text": "یعنی دوره‌های پشت سر هم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 829.1,
   "end": 838.08,
   "text": "دوره‌های کره‌هایی. کتاب رسخ و فتق حضرت استاد رو بخونید حیرت‌زده می‌شید، حیران می‌شید واقعاً.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 838.08,
   "end": 839.66,
   "text": "محیر العقول کتاب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 839.66,
   "end": 842.98,
   "text": "دانشمندای شرق و غرب عالم رو ریخته به هم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 842.98,
   "end": 846.02,
   "text": "با یک آیه قرآن این رساله رو نوشتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 214,
   "start": 846.02,
   "end": 848.92,
   "text": "آیه رسخ و فتق. خیلی حرف زدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 215,
   "start": 848.92,
   "end": 854.64,
   "text": "ببخشید. خواستم فقط همین یه فرمایش حضرت امام رو عرض کنم که چه خبره تو مبعث.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 216,
   "start": 854.64,
   "end": 856.78,
   "text": "حالا ما در مبعث چه کردیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 217,
   "start": 856.78,
   "end": 859.0,
   "text": "در هیئتمون، در اداره مون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 218,
   "start": 859.0,
   "end": 862.16,
   "text": "که نمی‌دونم کلاً که تعطیل بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 219,
   "start": 862.16,
   "end": 864.34,
   "text": "همین طوری‌ش تعطیله چه برسه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 220,
   "start": 864.34,
   "end": 866.56,
   "text": "روز تعطیلی رسمی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 221,
   "start": 866.56,
   "end": 869.88,
   "text": "در منزلمون با اهل بیتمون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 222,
   "start": 869.88,
   "end": 874.08,
   "text": "چه کردیم؟ بالاترین کار در مبعث چی بود اصلاً؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 223,
   "start": 874.08,
   "end": 876.94,
   "text": "اون کار رو انجام دادیم یا ندادیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 224,
   "start": 876.94,
   "end": 879.58,
   "text": "دو تا کار بالاترین کار بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 225,
   "start": 879.58,
   "end": 881.92,
   "text": "یکی زیارت امیرالمؤمنین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 226,
   "start": 881.92,
   "end": 885.56,
   "text": "ولو از راه دور، یکی زیارت امام رئوف.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 227,
   "start": 885.56,
   "end": 890.06,
   "text": "یعنی آدم دست و پا باید بشکنه و لو از راه دور و لو از راه دور.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 228,
   "start": 890.06,
   "end": 896.56,
   "text": "چه کردیم؟ این سؤال رو از خودمون-- وایستید نکته آخرم برمی‌گردم سنجاقش کنم به همون نکته اول.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 229,
   "start": 896.56,
   "end": 900.82,
   "text": "اون تلألؤ نوری، اون خورشید نور",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 230,
   "start": 900.82,
   "end": 905.38,
   "text": "پراکنده می‌شه انوارش، پرتوهاش همه جا رو می‌گیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 231,
   "start": 905.38,
   "end": 910.62,
   "text": "یعنی فقط روز قبل و رو-- عین روز مبعث و یه روز بعدش نه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 232,
   "start": 910.62,
   "end": 914.9,
   "text": "همه ع-عقیده بنده رو اگر بخواید بشنوید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 233,
   "start": 914.9,
   "end": 917.38,
   "text": "به عقیده بنده تمام،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 234,
   "start": 917.38,
   "end": 921.42,
   "text": "تمام نه سال ما، تمام ادوار ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 235,
   "start": 921.42,
   "end": 924.46,
   "text": "اینطوری بگیم با فر-- صحبت‌هایی که عرض کردیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 236,
   "start": 924.46,
   "end": 927.96,
   "text": "تمام دوره‌ها به نور مبعث روشنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 237,
   "start": 927.96,
   "end": 930.82,
   "text": "نه فقط دوره ما. حالا شما می‌خوای بگی اِ یه روز؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 238,
   "start": 930.82,
   "end": 933.22,
   "text": "می‌خوای بگی یک سال؟ می‌خوای بگی کل عمر من؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 239,
   "start": 933.22,
   "end": 936.52,
   "text": "تمام دوره‌ها. حالا با این،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 240,
   "start": 936.52,
   "end": 940.06,
   "text": "با این معرفتی که الان به ما حاصل شد، رزق ما،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 241,
   "start": 940.06,
   "end": 946.32,
   "text": "ما شد که وفسما رزقکم و ما تو از، از آسمان نازل شد بر ملکوت وجود شما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 242,
   "start": 946.32,
   "end": 952.92,
   "text": "حالا با این معرفت چه شیرین انسان خدمت پیغمبر عزیز عالم و آلش صلوات بفرسته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 243,
   "start": 952.92,
   "end": 957.02,
   "text": "اللهم صل على محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 244,
   "start": 957.02,
   "end": 960.14,
   "text": "و آل محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 245,
   "start": 960.14,
   "end": 964.54,
   "text": "و عجل فرجهم. اللهم بارک لمولانا صاحب الزمان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 246,
   "start": 964.54,
   "end": 966.7,
   "text": "والحمد لله رب العالمين.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
