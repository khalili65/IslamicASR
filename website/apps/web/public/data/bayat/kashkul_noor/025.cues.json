 },
 "chapters": [
  {
   "index": 0,
   "title": "## پیشنهاد جمع‌خوانی سورهٔ فتح برای نصر",
   "start": 0.2,
   "end": 20.6
  },
  {
   "index": 1,
   "title": "## سورهٔ واقعه و توحید افعالی",
   "start": 20.6,
   "end": 160.72
  },
  {
   "index": 2,
   "title": "## اشاره‌ای به فصوص ابن‌عربی",
   "start": 160.72,
   "end": 274.2
  },
  {
   "index": 3,
   "title": "## أفرأیتم ما تمنون؛ خلق نطفه",
   "start": 274.2,
   "end": 440.83
  },
  {
   "index": 4,
   "title": "## قدرنا بینکم الموت؛ نشئهٔ دیگر",
   "start": 440.83,
   "end": 550.53
  },
  {
   "index": 5,
   "title": "## کشت و زرع؛ آب و آتش",
   "start": 550.53,
   "end": 743.65
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.2,
   "end": 3.88,
   "text": "اللهم صل علی محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 3.88,
   "end": 5.7,
   "text": "و آل محمد و عجل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 5.7,
   "end": 11.38,
   "text": "فرجهم. بسم الله الرحمن الرحيم و به نستعين.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 11.38,
   "end": 15.24,
   "text": "السلام علیک يا داعي الله و رباني",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 15.24,
   "end": 20.6,
   "text": "آياته. السلام عليكم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 20.6,
   "end": 25.12,
   "text": "قبل از این که بحث هر روزمون رو ادامه بدیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 25.12,
   "end": 27.0,
   "text": "یه نظرخواهی دوستان داشتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 27.0,
   "end": 32.02,
   "text": "خیلی نظر به جا و خوبی هم بود در خصوص Surه فتح.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 32.02,
   "end": 38.38,
   "text": "با توجه به فرمایش رهبر عزیزمون که الحمد لله خیلی‌هم لبیک گفتن و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 38.38,
   "end": 41.86,
   "text": "تاثیراتش هم دیدیم در خصوص",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 41.86,
   "end": 45.78,
   "text": "دفع بلای مواجهه با دشمن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 45.78,
   "end": 51.9,
   "text": "Surه فتح و دعای توسل بود و دعای چهاردهم صحیفه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 51.9,
   "end": 60.68,
   "text": "خب نمی‌دونم بعضیا دیگه باید به قول دوستان چه اتفاقاتی بیفته تا شاخکشون تیز بشه که گوش بدن اینجور حرف‌ها رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 60.68,
   "end": 66.28,
   "text": "و بعضیا هم خودشون رو توی جایگاه خاصی می‌بینن چاه این اتفاق میفته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 66.28,
   "end": 70.06,
   "text": "خودشون دست به قلم و دست به کار میشن و توصیه می‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 70.06,
   "end": 75.78,
   "text": "بذار این مسائل بسیار کلان رو بزرگان ما دستورالعمل بدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 75.78,
   "end": 81.52,
   "text": "ما کی هستیم که آقا به ما میگن آقا چه ذکری چه فلان، میگیم آقا دیگه رهبر فرمودن دیگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 81.52,
   "end": 86.78,
   "text": "بقیه گوش بدن دیگه. حتی به نظرم هیئت‌هام،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 86.78,
   "end": 93.18,
   "text": "عزیزان اینجا همه هیئتی‌ان، یه شب هیئتمون رو مثلا اختصاص بدیم به حوزه نصر،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 93.18,
   "end": 97.0,
   "text": "به موضوع نصر. همون سه تا فرمایش رهبر رو انجام بدیم؛",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 97.0,
   "end": 101.6,
   "text": "Surه فتح بخونیم، دعای توسل بخونیم و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 101.6,
   "end": 103.44,
   "text": "دعای چهاردهم صحیفه رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 103.44,
   "end": 107.58,
   "text": "بعد حالا بخواید روضه بخونید، سینه زنی کنید، هر کاری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 107.58,
   "end": 112.22,
   "text": "پس انشاالله به همین جهت ما بچه‌ها رو نیت کردن که به امید خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 112.22,
   "end": 116.04,
   "text": "از امروز به بعد حالا روزش رو دیگه ببینیم چهارده روز بخونیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 116.04,
   "end": 122.2,
   "text": "یا چقدر بشه. بعد از نماز عصر به جای روزی یه صفحه Surه فتحو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 122.2,
   "end": 124.52,
   "text": "جمع خوانی کنیم تندتند دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 124.52,
   "end": 133.06,
   "text": "یه صلوات بفرمایید. اللهم صل علی محمد و آل محمد و عجل فرجهم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 133.06,
   "end": 136.4,
   "text": "Sur واقع رو که خب به هر حال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 136.4,
   "end": 142.52,
   "text": "اه سرود شامگاهی ماست دیگه قبل از خواب همه اهل ایمان توصیه شده بخونن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 142.52,
   "end": 144.88,
   "text": "اگر دقت کرده باشید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 144.88,
   "end": 148.2,
   "text": "توی این Surه مملو از همون توحید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 148.2,
   "end": 150.24,
   "text": "افعالی که داشتیم می‌گفتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 150.24,
   "end": 154.08,
   "text": "عرض کردیم از تجلیات حضرت حق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 154.08,
   "end": 157.02,
   "text": "بر اساس رساله سیر و سلوک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 157.02,
   "end": 159.68,
   "text": "علامه طباطبایی علیه الرحمه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 159.68,
   "end": 163.5,
   "text": "و اهمیتش که هیچ چاره‌ای جز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 163.5,
   "end": 166.56,
   "text": "این نیست. گفتیم که باید بریم به سمت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 166.56,
   "end": 170.24,
   "text": "اون توحید سلف که سه دسته توحید،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 170.24,
   "end": 173.6,
   "text": "توحید افعالی، صفاتی و ذاتی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 173.6,
   "end": 178.26,
   "text": "تو اف-- اولین رتبه توحید بودیم افعالی که گفتیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 178.26,
   "end": 183.3,
   "text": "سالک یا به عبارتی بنده خوب خدا به جایی می‌رسه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 183.3,
   "end": 186.86,
   "text": "این لا حول و لا قوه الا بالله رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 186.86,
   "end": 191.78,
   "text": "به عینه می‌بینه. یعنی اصلاً دست خدا رو می‌بینه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 191.78,
   "end": 197.24,
   "text": "همه جا می‌بینه تا جایی که به جایی می‌رسه اصلاً دیگه خودش رو هم برمی‌داره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 197.24,
   "end": 201.1,
   "text": "افعال خودش رو هم منتسب می‌کنه به خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 201.1,
   "end": 203.72,
   "text": "میگه من نکردم، خدا کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 203.72,
   "end": 207.56,
   "text": "حالا این رو بریم جلو. الان یه مقدار زوده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 207.56,
   "end": 209.6,
   "text": "ولی یه مقدار انشاالله برامون جا بیفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 209.6,
   "end": 213.0,
   "text": "بعداً عبارت‌هایی رو از ابن عربی براتون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 213.0,
   "end": 216.08,
   "text": "می‌خونم. میارم از رو از فتـو از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 216.08,
   "end": 219.36,
   "text": "فصوص ایشون. فصوص الحکم که بیست و هفت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 219.36,
   "end": 228.26,
   "text": "مقام از مقامات انسان رو توش بیان می‌کنه و ما باید به اون سمت‌ها بریم و هر کدومش رو می‌زنه به یک پیغمبر عزیز.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 228.26,
   "end": 232.94,
   "text": "اونجا اصلاً فتـو-- اه ابن عربی که خیلی با جسارت تمام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 232.94,
   "end": 237.02,
   "text": "همه افعال رو نسبت میده به خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 237.02,
   "end": 240.56,
   "text": "و در حقیقت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 240.56,
   "end": 245.72,
   "text": "وقتی که شما نماز می‌خونی میگه خدا داره نماز می‌خونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 245.72,
   "end": 253.3,
   "text": "وقتی که شروع می‌کنی گفت و گوی با خدا، شما داری دعا می‌کنی از خدا چیزی می‌خوای، خدا خ-- از خودش داره چیزی می‌خواد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 253.3,
   "end": 256.56,
   "text": "و حالا الان زوده این‌ها رو یه مقدار بشنویم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 256.56,
   "end": 258.4,
   "text": "بعضیامون برامون شاید سنگین باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 258.4,
   "end": 261.24,
   "text": "به هرحال یه چند تا نمونه من براتون بخونم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 261.24,
   "end": 266.86,
   "text": "ببینید ما هر شب به دستور اهل بیت داریم توحید افعالی رو مرور می‌کنیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 266.86,
   "end": 270.74,
   "text": "توجه بهش نداریم. ببینید از همین آیه من شروع کنم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 270.74,
   "end": 274.2,
   "text": "که می‌فرماید \"أفرأیتم ما تمنون\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 274.2,
   "end": 277.7,
   "text": "آیا نمی‌بینید که این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 277.7,
   "end": 281.04,
   "text": "نطفه‌ای که بارگذاری می‌شه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 281.04,
   "end": 285.48,
   "text": "این رو که شما دارید می‌بینید، خودتون دارید می‌بینید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 285.48,
   "end": 287.84,
   "text": "و در حقیقت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 287.84,
   "end": 292.74,
   "text": "این موهبت الهی، غریزه شهوت که به قول استاد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 292.74,
   "end": 295.46,
   "text": "علامه عسگرزاده علیه الرحمه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 295.46,
   "end": 298.9,
   "text": "این به جهت ایجاد صورت انسانیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 298.9,
   "end": 302.32,
   "text": "خیلی ارزشمنده ایجاد صورت انسانی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 302.32,
   "end": 305.62,
   "text": "نه اطفاء شهوت حیوانی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 305.62,
   "end": 309.6,
   "text": "اصلاً کسی به همین نیت این کار رو بکنه عین عبادته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 309.6,
   "end": 314.3,
   "text": "و چه حرف‌ها بزرگان از حیث روانشناسی اینجا پیاده کردن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 314.3,
   "end": 318.8,
   "text": "که چقدر انسان معتدل می‌شه، بدنش معتدل می‌شه اون لحظه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 318.8,
   "end": 325.78,
   "text": "و حتی عبادت بعد از اون حتی خواب بعد از اون چقدر ثمرات داره و چقدر انسان رو به خدا نزدیک می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 325.78,
   "end": 331.34,
   "text": "خیلی اینجا حرف‌ها هست. باید البته شنونده هم ظرفیتش رو داشته باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 331.34,
   "end": 333.7,
   "text": "به وقتش انشاالله اینا بیان بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 333.7,
   "end": 336.94,
   "text": "میگه این رو که می‌بینید \"أأنتم تخلقونه\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 336.94,
   "end": 342.12,
   "text": "آیا این نطفه‌ای که در رحم پرورش پیدا می‌کنه و بال و پر می‌گیره و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 342.12,
   "end": 346.84,
   "text": "شبیه ابتدا شبیه کرمه اصلاً رغبت نمی‌کنی ببینیش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 346.84,
   "end": 349.38,
   "text": "بعد به این زیبایی می‌شه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 349.38,
   "end": 352.74,
   "text": "که یکی دست به زلف افشونت می‌بره میگی دستتو ببر اونور.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 352.74,
   "end": 356.06,
   "text": "اذیت می‌شی. دوست نداری حتی موهات به هم بریزه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 356.06,
   "end": 358.76,
   "text": "این زیبایی از، از کجا اومد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 358.76,
   "end": 363.92,
   "text": "یه جا در قرآن میگه \"هو الذي یصورکم في الأرحام كيف یشاء\" اوست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 363.92,
   "end": 366.58,
   "text": "هو. کدوم هو؟ قل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 366.58,
   "end": 368.9,
   "text": "اولین چیزی که به ما گفتن بگو چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 368.9,
   "end": 373.03,
   "text": "قل هو. بعد الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 373.03,
   "end": 376.05,
   "text": "البته سرتاسر قرآن توحید الوهیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 376.05,
   "end": 379.15,
   "text": "چون سطح متوسط مردم رو می‌بینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 379.15,
   "end": 381.89,
   "text": "اما شما بری اونو بررسی کنی می‌بینی نه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 381.89,
   "end": 384.83,
   "text": "اصلش توحید هویه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 384.83,
   "end": 388.63,
   "text": "توحید، توحید در حقیقت وجودیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 388.63,
   "end": 391.09,
   "text": "هو الله احد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 391.09,
   "end": 395.41,
   "text": "حالا همون هو، هو اللذی یصورکم فی الارحام کیف یشاء.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 395.41,
   "end": 399.75,
   "text": "تو فکر می‌کنی مادر بچه‌ای که در رحمته تو داری پرورشش میدی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 399.75,
   "end": 401.33,
   "text": "چرا شما نمی‌تونی تشخیص بدی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 401.33,
   "end": 404.19,
   "text": "اصلاً نمی‌تونی دخالت کنی که این دختر باشه یا پسر؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 404.19,
   "end": 409.31,
   "text": "چه شکلی بشه؟ چشماش زاه بشه، سیاه بشه، سفید بشه، چی بشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 409.31,
   "end": 412.03,
   "text": "دست شماست مگه؟ قدش چقدر بشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 412.03,
   "end": 415.45,
   "text": "وزنش چی بشه؟ پوستش چه رنگی بشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 415.45,
   "end": 417.95,
   "text": "اینجا می‌فرماید که أأنتم تخلقونه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 417.95,
   "end": 422.39,
   "text": "أم نحن الخالقون. شما اینو خلق می‌کنید یا ماییم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 422.39,
   "end": 425.53,
   "text": "خلق می‌کنیم این‌ها رو، اون بچه در رحم رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 425.53,
   "end": 428.93,
   "text": "این توحید افعالیه دیگه. میگه دست خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 428.93,
   "end": 436.49,
   "text": "ببینید اینجا داره به ما این تعلیم رو میده که حواستون به-- ما رو هل میده به سمت تجلیات الهیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 436.49,
   "end": 440.83,
   "text": "بریم جلوتر. نحن قدرنا بینکم الموت وما نحن بمسبوقین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 440.83,
   "end": 445.33,
   "text": "ما هستیم که موت رو بین شما قرار دادیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 445.33,
   "end": 448.81,
   "text": "و ما هیچکس نمی‌تونه بر ما سبقت بگیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 448.81,
   "end": 452.33,
   "text": "ألا أنا بدل أمثالكم وننشئكم فیما لا تعلمون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 452.33,
   "end": 455.49,
   "text": "شما رو می‌خوایم ببریم تو یه جای دیگه تو عالم مثال،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 455.49,
   "end": 459.17,
   "text": "در واقع عالم برزخ و بعد از اونجا عالم عقول و ارواح",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 459.17,
   "end": 461.89,
   "text": "و اله و این‌ها. که چی بشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 461.89,
   "end": 465.63,
   "text": "اونجا ننشئکم شما، ایجاد جدیدی می‌کنیم از شما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 465.63,
   "end": 469.91,
   "text": "یعنی یه آدم جدیدی از شما اونجا می‌سازیم که خودتون باورتون نمیشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 469.91,
   "end": 473.15,
   "text": "مثل اینکه الان شما باورت میشه نطفه بودی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 473.15,
   "end": 478.35,
   "text": "خداوکیلی باورت میشه همین حضرت عالی با این هیئت و کثفت اون بودی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 478.35,
   "end": 484.05,
   "text": "بعد اونجا ببین قراره با ما چه کنن که اینجا رو ببینی باورت نمیشه شما این بودی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 484.05,
   "end": 487.23,
   "text": "اینا تو بطن آیات ننشئکم فیما لا تعلمون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 487.23,
   "end": 490.79,
   "text": "اصلاً خبر ندارید ما قراره با شما چه کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 490.79,
   "end": 492.95,
   "text": "بعد انسان آقا بشه، بزرگ بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 492.95,
   "end": 495.93,
   "text": "به یه نطفه بگن تو بدت میاد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 495.93,
   "end": 498.25,
   "text": "مثلاً الان، الان کثفتت چگونه است؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 498.25,
   "end": 502.87,
   "text": "چقدر خودت از خودت خوشت میاد و حب ذات داری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 502.87,
   "end": 508.07,
   "text": "اگر اون موقع، اون لحظه که ما نطفه بودیم می‌گفتن که الانتو نشون میدادن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 508.07,
   "end": 512.27,
   "text": "می‌گفتن می‌خوایم این رو ب-- شما رو اینطوری قرار بدیم، بدت میومد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 512.27,
   "end": 518.15,
   "text": "یا استقبال می‌کردی؟ این معنای شیرینی موت و انتقال از این عالم به عالم بعدی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 518.15,
   "end": 521.93,
   "text": "ولقد علمتم النشأة الأولى فلولا تذكرون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 521.93,
   "end": 525.51,
   "text": "اونایی که میگن آقا نشئه چیه؟ هی میگی نشئه طبیعت، نشئه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 525.51,
   "end": 527.77,
   "text": "مثال، نشئه-- نه ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 527.77,
   "end": 530.61,
   "text": "ما به تحقیق آگاه، آگاه کردیم شما رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 530.61,
   "end": 532.75,
   "text": "علمتم النشأة الأولى.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 532.75,
   "end": 536.17,
   "text": "اون مرحله رتبه اول خلقتتون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 536.17,
   "end": 538.73,
   "text": "فَلَوْلَا تَذَكَّرُونَ. نمی‌خواید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 538.73,
   "end": 541.23,
   "text": "یادآور بشید دو مرتبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 541.23,
   "end": 543.07,
   "text": "أفرأيتما تحرثان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 543.07,
   "end": 547.35,
   "text": "آیا نگاه نمی‌کنید این چیزی که شما دارید می‌کارید و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 547.35,
   "end": 550.53,
   "text": "این زمینی که کشزارتون و این‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 550.53,
   "end": 555.85,
   "text": "أأنتم تزرعونه. اینا رو شما رشد به این گیاه‌ها میدید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 555.85,
   "end": 559.29,
   "text": "أم نحن الزارعون. یا ما هستیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 559.29,
   "end": 562.03,
   "text": "ماییم که داریم اصلاً زارع ماییم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 562.03,
   "end": 565.93,
   "text": "ما داریم این گندم و برنج و این‌ها رو همه رو پرورش میدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 565.93,
   "end": 570.15,
   "text": "کسی تا حالا اینطوری فکر می‌کرده؟ خدا داره اینا رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 570.15,
   "end": 572.47,
   "text": "بارور می‌کنه. همه فکر می‌کنیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 572.47,
   "end": 575.05,
   "text": "کشاورز داره می‌کنه. صریح آیه قرآن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 575.05,
   "end": 580.29,
   "text": "اصلاً تفسیرم نمی‌خواد. لو نشاء لجعلناه حطاماً فللتمتفکرن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 580.29,
   "end": 583.27,
   "text": "اگه ما بخوایم همه رو نیست و نابود می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 583.27,
   "end": 587.05,
   "text": "انا لمغرمون. بعد طوری که شما می‌گید آخ، آخ چه بیچاره شدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 587.05,
   "end": 588.91,
   "text": "بل نحن محرومون. محروم شدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 588.91,
   "end": 592.31,
   "text": "یعنی یک آن می‌تونیم به خاک سیاه بنشونمتون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 592.31,
   "end": 594.85,
   "text": "هرچی که دارید دیگه نداشته باشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 594.85,
   "end": 598.07,
   "text": "همه چی دست ماست. باز ولمون نمی‌کنه خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 598.07,
   "end": 601.81,
   "text": "فرمود أفرأيتما الماء الذي تشربون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 601.81,
   "end": 604.35,
   "text": "آیا نگاه نمی‌کنید آبی که داری می‌خوری؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 604.35,
   "end": 607.97,
   "text": "تشربون ما. آبی که داری می‌خوری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 607.97,
   "end": 610.97,
   "text": "أأنتم أنزلتموه من الموز.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 610.97,
   "end": 613.89,
   "text": "شمایید که از ابر نازلش می‌کنید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 613.89,
   "end": 617.55,
   "text": "أم نحن المنزلون. یا ما نازلش می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 617.55,
   "end": 620.57,
   "text": "اینایی که متاسفانه چشمشون به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 620.57,
   "end": 624.35,
   "text": "قلم دعوات و خودکار مدیرشونه جرات نمی‌کنن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 624.35,
   "end": 629.95,
   "text": "لام تا کام حرفی بزنن. مدیرشون خطا هم می‌کنه جرات نمی‌کنن تذکر به مدیر بدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 629.95,
   "end": 632.15,
   "text": "میگن نه بیچاره‌مون می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 632.15,
   "end": 634.71,
   "text": "نمیدونم حقوقمون کم میشه، رزقمون فلان میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 634.71,
   "end": 637.29,
   "text": "بیچاره. این که شرکه که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 637.29,
   "end": 639.39,
   "text": "مگه روزی تو زیر دست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 639.39,
   "end": 642.59,
   "text": "مدیره؟ اونم یه واسطه‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 642.59,
   "end": 644.49,
   "text": "اون هیچ کاره‌ست اصلاً در این عالم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 644.49,
   "end": 646.17,
   "text": "همه کاره عالم خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 646.17,
   "end": 650.65,
   "text": "اینا همه وسایطن. میگه که آقا این بارون که داره میاد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 650.65,
   "end": 653.57,
   "text": "ما از ابر نازلش می‌کنیم، نه شما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 653.57,
   "end": 657.55,
   "text": "بازم ولمون نمی‌کنه خدا. میگه من باید آچارکشی‌تون کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 657.55,
   "end": 659.45,
   "text": "قشنگ جا بیفته براتون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 659.45,
   "end": 663.37,
   "text": "انقدر که این مهمه. یکی دو تا آیه دیگه بخونیم بسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 663.37,
   "end": 667.17,
   "text": "لو نشاء جعلناه أجاجا فلا تشکرون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 667.17,
   "end": 671.81,
   "text": "چرا تو-- چرا شکر نمیگید؟ اگه ما می‌خواستیم این آبو اصلاً شورش می‌کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 671.81,
   "end": 675.39,
   "text": "بخورید کور شدید. می‌تونست یا نمی‌تونست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 675.39,
   "end": 680.81,
   "text": "خداست دیگه. همه کاره عالم. أفرأيتما النار التي تورون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 680.81,
   "end": 682.99,
   "text": "تا جالبه که متضاد دم میاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 682.99,
   "end": 688.03,
   "text": "آب و آتش. حالا میگه آتشی که برمیف-برمی‌افروزید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 688.03,
   "end": 692.97,
   "text": "این رو، این آتش رو أأنتم أنشأتم شجرةها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 692.97,
   "end": 697.95,
   "text": "شما ایجاد کردید، به وجود آوردید اون درختان رو که این چنین آتش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 697.95,
   "end": 700.97,
   "text": "ازشون بلند میشه. أم نحن المنشئون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 700.97,
   "end": 702.89,
   "text": "ماییم که این درخت رو بارور کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 702.89,
   "end": 705.77,
   "text": "اصلاً اون آتشم از ماست و اصلاً ماییم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 705.77,
   "end": 709.55,
   "text": "ماییم که داریم برافروخته میشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 709.55,
   "end": 712.39,
   "text": "اسم الله که ظهور کرده تک تک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 712.39,
   "end": 716.25,
   "text": "این کلمات وجودی نظام هستی از خود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 716.25,
   "end": 720.99,
   "text": "زمین و آسمون، فرش و عرش همه و همه کلمات وجودی مان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 720.99,
   "end": 725.45,
   "text": "که ظهور کردن. ما ذات غیبی هستیم، بقیه همه ظهور ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 725.45,
   "end": 727.67,
   "text": "ببینید این میشه توحید افعالی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 727.67,
   "end": 732.05,
   "text": "این پله اوله. انشاالله با همین آیات که هر شب داریم می‌خونیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 732.05,
   "end": 734.17,
   "text": "فکر می‌کنم دیگه برامون جا افتاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 734.17,
   "end": 736.41,
   "text": "یعنی حسابی خدا ما رو چکش کاری کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 736.41,
   "end": 738.09,
   "text": "والحمد لله رب العالمين.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 738.09,
   "end": 743.65,
   "text": "صلوات بفرستید. اللهم صل على محمد وآل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}