 "chapters": [
  {
   "index": 0,
   "title": "## سالروز شهادت سید حسن نصرالله؛ نماد مقاومت",
   "start": 12.58,
   "end": 112.36
  },
  {
   "index": 1,
   "title": "## توحید افعالی؛ زبان حال پدران و مادران",
   "start": 112.36,
   "end": 223.92
  },
  {
   "index": 2,
   "title": "## دستورالعمل‌های بهجت و حقیقت زیارت رضا",
   "start": 223.92,
   "end": 265.68
  },
  {
   "index": 3,
   "title": "## شبههٔ شرک آدم و حوا و پاسخ امام رضا",
   "start": 265.68,
   "end": 509.21
  },
  {
   "index": 4,
   "title": "## مثلث تربیت",
   "start": 509.21,
   "end": 574.27
  },
  {
   "index": 5,
   "title": "روزی در هیئتی مادری بود و چند فرزندش؛ همه اهل تسنن بودند. نه بحثی شد و نه جدلی؛ یک جمله گفته شد:",
   "start": 574.27,
   "end": 612.37
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.04,
   "end": 4.58,
   "text": "بسم الله الرحمن الرحیم و به این استعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 4.58,
   "end": 8.5,
   "text": "السلام علیک ای داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 8.5,
   "end": 12.58,
   "text": "آیه. سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 12.58,
   "end": 16.04,
   "text": "امروز سالروز شهادت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 16.04,
   "end": 22.04,
   "text": "سید مقاومته. سید حسن نصرالله روحش شاد باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 22.04,
   "end": 24.88,
   "text": "از طرف ما خدا روحش رو شاد کنه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 24.88,
   "end": 27.32,
   "text": "نماد مقاومت بود به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 27.32,
   "end": 31.94,
   "text": "واقع. یعنی واقعاً از هر آدمی بپرسی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 31.94,
   "end": 37.16,
   "text": "چه مخالف چه موافق، یه جمله در ارتباط با ایشون بگو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 37.16,
   "end": 41.18,
   "text": "میگه ایشون نماد مقاومت بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 41.18,
   "end": 48.5,
   "text": "دلگرمی انقلاب ما و رهبر ما و جبهه انقلاب و جبهه مقاومت بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 48.5,
   "end": 55.64,
   "text": "روحش شاد. من خودم به شخصه نمی‌دونستم وقتی از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 55.64,
   "end": 60.62,
   "text": "بچه های مقاومت شنیدم خیلی تعجب کردم که این نیروی عظیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 60.62,
   "end": 63.96,
   "text": "مقاومت که بر علیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 63.96,
   "end": 68.16,
   "text": "اسرائیل و استکبار بسیج شدن رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 68.16,
   "end": 73.38,
   "text": "خوبه شما هم بدونید با حدودا بیست نفر ایشون آغاز می‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 73.38,
   "end": 79.2,
   "text": "سید حسن با بیست نفر آقا شروع می‌کنند کارش رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 79.2,
   "end": 83.06,
   "text": "خیلی حرفه‌ها. در لبنان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 83.06,
   "end": 85.22,
   "text": "یعنی ابتدا ساكن با بیست نفر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 85.22,
   "end": 86.78,
   "text": "الان چند نفر اینجا هستید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 86.78,
   "end": 91.22,
   "text": "ماشاالله. اگه واقعاً همه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 91.22,
   "end": 94.32,
   "text": "به یک کلمه واحده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 94.32,
   "end": 98.22,
   "text": "یعنی به توحید، به وحدت همه و همه متفق،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 98.22,
   "end": 103.54,
   "text": "متفق القول و دل بشن کار تمومه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 103.54,
   "end": 107.96,
   "text": "ماشاالله این سازمان این همه عده و عُده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 107.96,
   "end": 110.44,
   "text": "چرا کارش درست پیش نمیره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 110.44,
   "end": 113.92,
   "text": "خدا به فریاد برسه. بحث ما روحش شاد باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 113.92,
   "end": 119.12,
   "text": "ما یه نکته‌ای رو عرض می‌کنیم ثوابش رو به روح اون بزرگوار تقدیم می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 119.12,
   "end": 121.74,
   "text": "بحث ما در توحید افعالی بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 121.74,
   "end": 125.54,
   "text": "یکی دیگه از آیاتی که توحید افعالی رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 125.54,
   "end": 132.58,
   "text": "بیان می‌کنه و به یک معنا زبان حال خیلی از پدر و مادران امروزه متأسفانه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 132.58,
   "end": 137.42,
   "text": "آیه صد و نود سوره اعرافه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 137.42,
   "end": 141.24,
   "text": "آیه قبلش می‌فرماید که پدر و مادر از خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 141.24,
   "end": 146.16,
   "text": "فرزند طلب می‌کنند. می‌گن خدایا به ما فرزند سالم و صالح و این‌ها بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 146.16,
   "end": 154.76,
   "text": "ما شکرگزارت هستیم. فلما آتاهما صالحا وقتی یه فرزند صالح خدا بهشون داد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 154.76,
   "end": 157.02,
   "text": "چه اتفاقی می‌افته؟ جعل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 157.02,
   "end": 158.82,
   "text": "اینجا مثنی آمده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 158.82,
   "end": 161.1,
   "text": "یعنی اون دو تا یعنی پدر و مادر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 161.1,
   "end": 164.26,
   "text": "جعل له شركاء",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 164.26,
   "end": 168.18,
   "text": "فيها آتاهما. تو اون چیزی که بهشون عطا کردی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 168.18,
   "end": 171.22,
   "text": "به جای اینکه شکر خدا رو به جا بیارن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 171.22,
   "end": 173.68,
   "text": "این‌ها چیکار می‌کنند؟ برای خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 173.68,
   "end": 177.02,
   "text": "شریک قائل می‌شن. یعنی چی اینجا شریک قائل می‌شن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 177.02,
   "end": 181.84,
   "text": "مفسرین مثلاً میگن که آها اون طبیبه، اون دکتره، اون آمپوله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 181.84,
   "end": 187.18,
   "text": "به قول آقای قرائتی، اون تزریقه، اون دارویی که خوردن باعث شد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 187.18,
   "end": 191.78,
   "text": "بچه دار بشن. اصلاً حواسش پرت می‌شه از اینکه اصلاً بچه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 191.78,
   "end": 195.08,
   "text": "تا خدا نخواهد چگونه بچه دار می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 195.08,
   "end": 198.76,
   "text": "هو الذي هرچه هست اوست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 198.76,
   "end": 203.56,
   "text": "انشأکم من الارض شما را انشا می‌کنه از همین زمینی که روش داری قدم می‌زنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 203.56,
   "end": 206.22,
   "text": "از پست‌ترین چیزی که پا روش می‌کوبی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 206.22,
   "end": 207.94,
   "text": "از همین تو رو انشا کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 207.94,
   "end": 209.86,
   "text": "شوخی نیست. این قدرت خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 209.86,
   "end": 212.52,
   "text": "قدرت احدی نیست. حالا چه کنیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 212.52,
   "end": 215.8,
   "text": "دست به دارو، درمان و این‌ها ببریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 215.8,
   "end": 218.16,
   "text": "این کسایی که مثلاً بچه دار نمی‌شن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 218.16,
   "end": 223.38,
   "text": "ببریم. ولی هرچه هست دست حضرت حق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 223.38,
   "end": 226.74,
   "text": "اتفاقاً خدا رحمت کنه آقای بهجت رو روحش شاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 226.74,
   "end": 230.66,
   "text": "ایشون چند تا دستور العمل داره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 230.66,
   "end": 235.2,
   "text": "برای بچه دار شدن. می‌تونید مراجعه کنید در کتاب بهجت و دعا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 235.2,
   "end": 239.36,
   "text": "هرکس از من سؤال می‌کنه این سه چهار تا دستور ایشون رو براش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 239.36,
   "end": 242.74,
   "text": "می‌فرستم. معمولاً هم دیدم جواب گرفتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 242.74,
   "end": 245.44,
   "text": "یکی از اون دستورات زیارت امام رضاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 245.44,
   "end": 250.3,
   "text": "به همین راحتی. البته فقط به قصد زیارت برید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 250.3,
   "end": 252.62,
   "text": "خدا رحمت کنه آقای مجتهدی رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 252.62,
   "end": 256.2,
   "text": "می‌فرمودن زیارت امام رضا اینه که تو سوار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 256.2,
   "end": 260.56,
   "text": "وسیله بشی. یه غذای مختصری هم با خودت برداری بری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 260.56,
   "end": 263.44,
   "text": "رسیدی مشهد بری حرم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 263.44,
   "end": 269.58,
   "text": "تجدید وضوئی و حرم و یه ساعت، دو ساعت، چهار ساعت هر چقدر ظرفیت داری زیارتتو بکنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 269.58,
   "end": 272.46,
   "text": "اون غذای مختصر هم بخوری،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 272.46,
   "end": 275.02,
   "text": "برگردی سوار وسیله بیای شهرت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 275.02,
   "end": 278.64,
   "text": "این اصل زیارته. نه توش سیاحته، نه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 278.64,
   "end": 282.62,
   "text": "تجارته، نه نمی‌دونم گشت و گذار و این چیزا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 282.62,
   "end": 286.76,
   "text": "نه، نه. اون اصل زیارت مونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 286.76,
   "end": 290.52,
   "text": "کسی این کار رو انجام بده به عشق اینکه بچه دار باشه خدا انشاالله بهش میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 290.52,
   "end": 293.04,
   "text": "حالا اینجا دو تا نکته هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 293.04,
   "end": 297.94,
   "text": "اولاً اینجا تفاسیر میگن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 297.94,
   "end": 301.82,
   "text": "این فلما آتاهما چون روایت داریم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 301.82,
   "end": 307.8,
   "text": "پدر و مادر اولی که از حضرت حق فرزند سالم خواستن و صالح",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 307.8,
   "end": 310.58,
   "text": "حضرت آدم و حوا اجداد ما بودند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 310.58,
   "end": 314.9,
   "text": "روحشون شاد. خب اینجا چگونه است که میگه جعل له",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 314.9,
   "end": 317.04,
   "text": "این جعل باز می‌گرده-- بر می‌گرده به اون دو تا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 317.04,
   "end": 321.12,
   "text": "این‌ها شریک قائل شدند برای خدا که فتعالی الله عما یشرکون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 321.12,
   "end": 325.76,
   "text": "خدا خیلی تعالی است از این چیزی که این‌ها شرک ورزیدند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 325.76,
   "end": 327.8,
   "text": "بریه از این‌ها، شرک این‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 327.8,
   "end": 332.52,
   "text": "مگر آدم و حوا، مگر پیغمبر مشرک می‌شد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 332.52,
   "end": 334.72,
   "text": "ببینید ظاهر سیاق آیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 334.72,
   "end": 336.48,
   "text": "داره میگه آدم مشرک شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 336.48,
   "end": 342.58,
   "text": "حوا مشرک شد. اینه که عالم باید به کارشناس دین رجوع کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 342.58,
   "end": 346.42,
   "text": "همین روایت رو در تفسیر اهل بیت می‌تونید ببینید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 346.42,
   "end": 349.84,
   "text": "همین آیه رو ذیلش روایتی هست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 349.84,
   "end": 354.14,
   "text": "که شخصی میگه که من در مجلس مأمون نشسته بودم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 354.14,
   "end": 357.36,
   "text": "امام رضا قربونش بریم اونجا حاضر بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 357.36,
   "end": 360.16,
   "text": "مأمون همین سؤال رو از امام رضا کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 360.16,
   "end": 364.2,
   "text": "گفت آقا مگه شما معتقد نیستید که انبیا معصومن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 364.2,
   "end": 366.37,
   "text": "حضرت فرمود بله معتقدیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 366.37,
   "end": 369.77,
   "text": "اشاره کرد به همین آیه. مأمون خیلی زیرک بوده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 369.77,
   "end": 372.75,
   "text": "و بعضیا هم میگن حافظ قرآن هم بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 372.75,
   "end": 377.65,
   "text": "لعنت الله عليه. این آیه را قرائت کرد گفت این چی میگه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 377.65,
   "end": 382.47,
   "text": "میگه که حضرت آدم و حوا مگر روایت ندارین این آیه در شأن آدم و حواست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 382.47,
   "end": 386.37,
   "text": "حضرت فرمود بله. پس چگونه است که اینجا میگه ش-مشرك",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 386.37,
   "end": 389.01,
   "text": "شدند؟ شریک قائل شدند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 389.01,
   "end": 390.63,
   "text": "امام رضا چه قشنگ جواب دادند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 390.63,
   "end": 393.81,
   "text": "فرمودند که روایت رو عرض کردم سندشو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 393.81,
   "end": 396.79,
   "text": "محکم. فرمودند که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 396.79,
   "end": 403.97,
   "text": "حضرت آدم و حوا از خدا طلب کردند خدایا ما فرزند سالم و صالح بده شکرگذار تو هستیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 403.97,
   "end": 406.07,
   "text": "حضرت حوا خب اون موقع فرق میکرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 406.07,
   "end": 407.91,
   "text": "میدونم الان من بگم تعجب میکنین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 407.91,
   "end": 415.03,
   "text": "اون موقع آدما هم جثه‌شون بزرگتر بود، هم قدرت‌شون بیشتر بود، هم عمرشون هزار ساله بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 415.03,
   "end": 420.29,
   "text": "هی به ضعف رفتند به-- یعنی ضعف مفرد پیدا کرد نسل بشری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 420.29,
   "end": 431.43,
   "text": "علتشو هم قبلاً عرض کردم. حضرت رضا فرمودند که پانصد بار حضرت حوا باردار شد و بچه‌دار شد هر بار جفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 431.43,
   "end": 435.39,
   "text": "یه پسر، یه دختر. همه هم سالم و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 435.39,
   "end": 439.59,
   "text": "صحیح الخلقه و همه هم صالح.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 439.59,
   "end": 443.45,
   "text": "ابتدا به ساکن همه خوب، همه سر حال، صالح.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 443.45,
   "end": 446.05,
   "text": "بعد حالا مأمون داره دقت میکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 446.05,
   "end": 449.15,
   "text": "پس این بالاخره شک به کی میخوره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 449.15,
   "end": 451.53,
   "text": "حضرت فرمودند اینها شدند دو گروه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 451.53,
   "end": 454.67,
   "text": "دو گروه دختر و پسر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 454.67,
   "end": 457.59,
   "text": "پونصد تا بچه حساب کنید دو گروه میشن دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 457.59,
   "end": 460.03,
   "text": "گروه دخترا، گروه پسرا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 460.03,
   "end": 464.07,
   "text": "حضرت فرمود هر بار بارداری جفت میشدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 464.07,
   "end": 467.27,
   "text": "الان برعکس شده. اصلاً دوقلو خیلی کمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 467.27,
   "end": 471.37,
   "text": "اون موقع اینطوری نبود. اکثراً دوقلو میشدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 471.37,
   "end": 475.47,
   "text": "جمعیت که هم بالاخره باید زاد و ولد زیاد شد که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 475.47,
   "end": 484.43,
   "text": ". این جعل رو فرمولش اینه امام رض-- امام رضا فرمودند این جعل له این جعلای مثنا میخوره به اون دو گروه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 484.43,
   "end": 489.47,
   "text": "یعنی فرزندان حضرت آدم و حوا مشرک شدند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 489.47,
   "end": 493.83,
   "text": "مثل پدر مادرشون که شاکر بودند، اینا شاکر نشدند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 493.83,
   "end": 497.95,
   "text": "اینا مشرک شدند. الان نگاه میکنی پدر خوب، مادر خوب،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 497.95,
   "end": 501.91,
   "text": "مادر شاداری، دختر رها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 501.91,
   "end": 505.71,
   "text": "پدر مسجدی، هیئتی، بچه‌اش رها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 505.71,
   "end": 508.59,
   "text": "الان داریم اینا رو میبینیم. این اتفاق میفته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 508.59,
   "end": 512.59,
   "text": "که البته مثلث تربیت درش موثره دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 512.59,
   "end": 517.83,
   "text": "یک، صلب و رحم یعنی پدر و مادر نقش اساسی دارند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 517.83,
   "end": 520.25,
   "text": "اولین جایی که در قوس نزول ان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 520.25,
   "end": 527.03,
   "text": "لله ما میایم در صلب پدر بعد رحم مادر رنگ میگیریم یا صعه یا ذیق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 527.03,
   "end": 529.49,
   "text": "دومیش محیطه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 529.49,
   "end": 531.97,
   "text": "محیطی که درش قرار میگیریم کجاست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 531.97,
   "end": 538.65,
   "text": "ابا عبدالله در دعای عرفه از خدا تشکر میکنه که من رو در زمانی پیاده کردی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 538.65,
   "end": 540.41,
   "text": "پیغمبر عزیز عالم است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 540.41,
   "end": 545.15,
   "text": "شوخی نیست. ما باید شاکر باشیم در زمان انقلاب پیاده شدیم در این عالم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 545.15,
   "end": 547.53,
   "text": "و الا معلوم بود ما چی میشدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 547.53,
   "end": 550.37,
   "text": "واقعاً. من یه جمله ای روز--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 550.37,
   "end": 554.05,
   "text": "اینو هم عرض کنم و السلام. اون سومیش هم مربی دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 554.05,
   "end": 559.53,
   "text": "مثلث تربیت. یه روزی توی یه هیئتی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 559.53,
   "end": 567.13,
   "text": "عرض کردم که یه مادری بود و دو سه-- چند تا پ-بچه هاش بودند همه اهل تسنن بودند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 567.13,
   "end": 570.21,
   "text": "یه جمله گفتم. اصلاً نه بحث کردیم نه هیچی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 570.21,
   "end": 574.27,
   "text": "گفتم يوم ندعوا کل اناس با امام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 574.27,
   "end": 576.89,
   "text": "هر کسی با امامش محشور میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 576.89,
   "end": 579.97,
   "text": "امام ما آقامون امیر المؤمنین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 579.97,
   "end": 582.47,
   "text": "افتخار ما اینه که اصلاً دعوا با کسی نداریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 582.47,
   "end": 584.87,
   "text": "ما با امیر المؤمنین محشور میشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 584.87,
   "end": 587.61,
   "text": "امام شما، خلیفه شما،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 587.61,
   "end": 589.57,
   "text": "ما با همونا محشور میشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 589.57,
   "end": 593.35,
   "text": "تمام شد. اینو ما گفتیم همین یه جمله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 593.35,
   "end": 599.47,
   "text": "الحمد لله اونا شیعه شدند، اثنی عشری شدند، برگشتن خودشون، بچه هاشون با همین یه جمله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 599.47,
   "end": 601.43,
   "text": "تربیت خیلی مهمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 601.43,
   "end": 605.69,
   "text": "حرف اول رو میزنه. ان شا الله عاقبت همگی مون ختم به خیر بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 605.69,
   "end": 608.97,
   "text": "اللهم بارک لمولانا صاحب الزمان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 608.97,
   "end": 612.37,
   "text": "والحمد لله رب العالمين. صلوات الله-",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}