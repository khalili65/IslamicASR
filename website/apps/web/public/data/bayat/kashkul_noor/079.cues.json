 "chapters": [
  {
   "index": 0,
   "title": "توحید افعالی در آیهٔ شصت سورهٔ نمل:",
   "start": 27.5,
   "end": 145.96
  },
  {
   "index": 1,
   "title": "## تفکر در آسمان و زمین؛ خوابیدن بر زمین",
   "start": 145.96,
   "end": 226.94
  },
  {
   "index": 2,
   "title": "## فأنبتنا؛ خط بطلان بر منِ مدعی باغبان",
   "start": 226.94,
   "end": 439.5
  },
  {
   "index": 3,
   "title": "## اسباب را برنمی‌دارد؛ باران و سنت الهی",
   "start": 439.5,
   "end": 527.1
  },
  {
   "index": 4,
   "title": "نکتهٔ بعد اینکه در سوره — فکر می‌کنم واقعه باشد —",
   "start": 527.1,
   "end": 607.08
  },
  {
   "index": 5,
   "title": "آیهٔ نود و نه انعام:",
   "start": 607.08,
   "end": 673.5
  },
  {
   "index": 6,
   "title": "## لأولی النهی؛ عقل نهی‌کننده",
   "start": 673.5,
   "end": 760.5
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.14,
   "end": 8.98,
   "text": "بسم الله الرحمن الرحیم و به این استعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 8.98,
   "end": 13.02,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 13.02,
   "end": 19.58,
   "text": "آیات. سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 19.58,
   "end": 23.18,
   "text": "توحید افعالی در آیه شصت سوره نمل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 23.18,
   "end": 27.5,
   "text": "أَمَّنْ خَلَقَ السَّمَاوَاتِ وَالْأَرْضَ.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 27.5,
   "end": 29.66,
   "text": "پیداست که قبلش داره از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 29.66,
   "end": 34.9,
   "text": "مشرکین سخن میگه و اون انتخابی که اون‌ها کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 34.9,
   "end": 38.8,
   "text": "چون اینجا می‌فرماید که آیا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 38.8,
   "end": 43.06,
   "text": "آن که خلق کرد آسمان‌ها و زمین رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 43.06,
   "end": 51.38,
   "text": "دیگه چه کار کرد؟ وَأَنزَلَ لَكُم مِّنَ السَّمَاءِ مَاءً.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 51.38,
   "end": 56.94,
   "text": "از آسمان لکم برای شما باران بارید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 56.94,
   "end": 59.96,
   "text": "فَأَنبَتْنَا بِهِ حَدَائِقَ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 59.96,
   "end": 63.12,
   "text": "ذَاتَ بَهْجَةٍ. به به!",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 63.12,
   "end": 68.72,
   "text": "پس به وسیله اون آب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 68.72,
   "end": 73.66,
   "text": "فَأَنبَتْنَا بِهِ به وسیله اون باران باغ‌های",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 73.66,
   "end": 77.28,
   "text": "خرم و با طراوت، با بهجت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 77.28,
   "end": 82.94,
   "text": "ذَاتَ بَهْجَةٍ. مَا كَانَ لَكُمْ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 82.94,
   "end": 87.44,
   "text": "أَن تُنْبِتُوا شَجَرَهَا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 87.44,
   "end": 91.14,
   "text": "که برای شما این باغ‌ها رو رویاند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 91.14,
   "end": 95.74,
   "text": "و البته رویاندن درختانش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 95.74,
   "end": 99.62,
   "text": "در قدرت شما نیست. مَا كَانَ لَكُمْ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 99.62,
   "end": 102.12,
   "text": "یعنی دست شما نیست، با شماها نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 102.12,
   "end": 105.36,
   "text": "چی؟ أَن تُنْبِتُوا شَجَرَهَا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 105.36,
   "end": 108.52,
   "text": "که بخواهید این درخت‌ها رو بار بیارید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 108.52,
   "end": 112.6,
   "text": "اصلاً یک کشاورز سراغ دارید که اینطوری فکر کنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 112.6,
   "end": 116.22,
   "text": "همه سا-- اینو نتیجه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 116.22,
   "end": 119.6,
   "text": "دست و پنجه و زحمت خودشون میدونن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 119.6,
   "end": 123.76,
   "text": "یه گل می‌کارن. حالا در خلقت آسمان و زمین مدعی خیلی نداریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 123.76,
   "end": 127.5,
   "text": "کی تا حالا جرات کرده، ادعا کرده که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 127.5,
   "end": 132.22,
   "text": "مثلاً گفته که آسمان رو من خلق کردم، زمین رو من خلق کردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 132.22,
   "end": 136.3,
   "text": "درسته؟ آیه چند؟ آیه شصت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 136.3,
   "end": 140.0,
   "text": "البته آیه شصت و دو هم باز هست در توحید افعالی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 140.0,
   "end": 143.64,
   "text": "دیگه امروز وقت نشد. ما انشاالله هفته بعد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 143.64,
   "end": 147.04,
   "text": "أَمَّنْ خَلَقَ بله. این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 147.04,
   "end": 149.9,
   "text": "اولاً تو أَمَّنْ خَلَقَ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 149.9,
   "end": 156.16,
   "text": "می‌فرماید که داره قشنگ یاد میده که تفکر کردن در خلائق رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 156.16,
   "end": 158.96,
   "text": "خَلَقَ. خلق السماوات والارض.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 158.96,
   "end": 162.82,
   "text": "دقت کردید اصلاً با آسمان‌ها و زمین ما همیشه زمین رو نگاه می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 162.82,
   "end": 165.34,
   "text": "تازه به خود زمین هم توجه نداریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 165.34,
   "end": 167.76,
   "text": "که فِي الْأَرْضِ آيَاتٌ لِلْمُوقِنِينَ.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 167.76,
   "end": 170.42,
   "text": "تو همین زمینی که روش داری راه میری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 170.42,
   "end": 173.26,
   "text": "و چقدرم وقتی روش دراز میکشی آرامش داری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 173.26,
   "end": 178.64,
   "text": "امتحان کن یه بار که خسته‌ای یه بار رو تخت بخوابی، یه بار نه رو زمین، خود زمین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 178.64,
   "end": 182.9,
   "text": "کاملاً با هم فرق می‌کنه. امام علی می‌فرمود بالا نخوابید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 182.9,
   "end": 185.32,
   "text": "یه جوری بخوابید رو زمین باشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 185.32,
   "end": 190.68,
   "text": "حالا الان تخت فروش‌ها صدای منو بشنون ما رو تخته می‌کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 190.68,
   "end": 195.26,
   "text": "رو تخت ممنوع شده. اصلاً رو در-- بالا خوابیدن ممنوع شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 195.26,
   "end": 199.2,
   "text": "رو زمین. جان؟ [سخنگوی 1] .",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 199.2,
   "end": 202.24,
   "text": "دیگه اینا معماری غلطه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 202.24,
   "end": 205.82,
   "text": "معماری غلطه. اصلاً رو خود زمین امتحان کنید بخوابید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 205.82,
   "end": 207.94,
   "text": "چرا روستایی‌ها حالشون از ما بهتره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 207.94,
   "end": 213.64,
   "text": "دهاتی‌ها. اما شهری‌ها مخصوصاً بالانشین‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 213.64,
   "end": 216.78,
   "text": "چرا؟ اینا اصول-- یعنی در معماریشون این است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 216.78,
   "end": 219.0,
   "text": "حالا ما کار به معماریش فعلاً نداریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 219.0,
   "end": 222.3,
   "text": "داره توجه میده ما رو به توجه به چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 222.3,
   "end": 224.5,
   "text": "نگاه کردن به آفرینش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 224.5,
   "end": 226.94,
   "text": "آسمان‌ها و زمین و مطلقاً.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 226.94,
   "end": 230.62,
   "text": "حالا در خصوص آسمان و زمین و اینا عرض کردیم که ادعا خیلی نداریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 230.62,
   "end": 233.46,
   "text": "نداریم اصلاً. اما در خصوص درخت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 233.46,
   "end": 236.44,
   "text": "و گل و گیاه و این‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 236.44,
   "end": 240.3,
   "text": "اد-- مدعی داریم. میگه دست‌پرورده خودم بوده این همه زمان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 240.3,
   "end": 245.2,
   "text": "ببین چه کردم. ببین چه-- مثلاً شهرداری میگه این چند هزار هکتار رو من",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 245.2,
   "end": 249.68,
   "text": "نمی‌دونم چیکار کردم سرسبز کردم تو کل ک-کشور اینو من، من.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 249.68,
   "end": 253.16,
   "text": "قرآن صراحتاً داره خط بطلان می‌کشه رو این من، من گفتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 253.16,
   "end": 256.3,
   "text": "میگه فَأَنبَتْنَا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 256.3,
   "end": 261.16,
   "text": "ما هستیم که این درخت‌ها رو بارور می‌کنیم و رشد بهش میدیم و می‌رویونیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 261.16,
   "end": 264.4,
   "text": "ما کان لکم. دیگه از شما- بله احسنت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 264.4,
   "end": 266.46,
   "text": "ب-- بعدش دیگه بله الان می‌رسیم دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 266.46,
   "end": 271.16,
   "text": "مَا كَانَ لَكُمْ که اصلاً دیگه نفی می‌کنه اصلاً توانایی‌های ما رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 271.16,
   "end": 277.52,
   "text": "چند تامون تا حالا درخت داشتیم خشک شده یا درختو با چیز و گوشه و گوشه‌ای خریدیم چقدرم بهش رسیدیم کو--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 277.52,
   "end": 279.56,
   "text": "خیلی به من میگن چون من",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 279.56,
   "end": 281.58,
   "text": "گیاه بازی و درخت بازی زیاد کردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 281.58,
   "end": 284.16,
   "text": "تو حیاط خونه‌مون صد تا گلدون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 284.16,
   "end": 287.2,
   "text": "اینو قشنگ قلمه بزن، پیوند بزن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 287.2,
   "end": 289.38,
   "text": "اینقدر دوست داشتم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 289.38,
   "end": 292.0,
   "text": "جاهای سبز و سرسبز و.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 292.0,
   "end": 295.42,
   "text": "خیلی تجربم تو این زمینه کم نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 295.42,
   "end": 300.06,
   "text": "خیلی می‌رسی ناز یه درخت و یه گیاه رو می‌خری به بهترین وجه ممکن سم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 300.06,
   "end": 304.56,
   "text": "سم می‌زنی، کود و این داستان‌ها می‌زنی، خاکش رو عوض می‌کنی، به موقع بهش آب میدی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 304.56,
   "end": 309.24,
   "text": "تموم. خشک شد. بارها من به این قضیه برخوردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 309.24,
   "end": 312.06,
   "text": "خشک شد. کی خشکش کرد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 312.06,
   "end": 314.0,
   "text": "تو که همه اش بهش رسیدی حساب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 314.0,
   "end": 316.62,
   "text": "چه سری بود که اون خشک شد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 316.62,
   "end": 319.72,
   "text": "یه گیاه دیگه رشد می‌کنه خیلی هم خوب میره بالا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 319.72,
   "end": 322.54,
   "text": "یه گیاهی تو خونه ما بود. خود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 322.54,
   "end": 326.06,
   "text": "گیاه فروشه وقتی دید مات و مبهوت گفت این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 326.06,
   "end": 327.72,
   "text": "حالا اسمش الان یادم نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 327.72,
   "end": 329.9,
   "text": "اسم خارجیه. اسم خاصی داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 329.9,
   "end": 334.4,
   "text": "زبان مادر شوهر نبود؟ نه یه ذره اینطوری پیچیده تو هم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 334.4,
   "end": 336.38,
   "text": "یه حالت خاصی داره. الانم زیاد شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 336.38,
   "end": 338.16,
   "text": "گرونم هست. زبان مادر زن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 338.16,
   "end": 341.58,
   "text": "تقریباً سه متر ارتفاع گرفته بود این گلدون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 341.58,
   "end": 343.98,
   "text": "گلدون هم از اندازه کف دست بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 343.98,
   "end": 347.46,
   "text": "به ما یکی هدیه داد. سه متر بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 347.46,
   "end": 351.64,
   "text": "می‌گفت من اصلاً ندیدم هیچ کجایی این انقدر رشد کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 351.64,
   "end": 354.0,
   "text": "گفتم من تسبیح خانم یا یا مع--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 354.0,
   "end": 359.88,
   "text": "یا از ش-- یا کاشف الكرب عن وجه حسین می‌خونم، آب میدم، برکت گرفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 359.88,
   "end": 364.06,
   "text": "حالا اینو کی می‌فهمه؟ تا کسی خودش تجربه نکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 364.06,
   "end": 369.42,
   "text": "اینا رو ما از حل خودمون می‌دونیم. اما فَأَنبَتْنَا قرآن میگه ما هستیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 369.42,
   "end": 372.64,
   "text": "اصلاً کی می‌تونه جای این گیاه‌ها رو، میوه‌هاش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 372.64,
   "end": 377.9,
   "text": "رو یه نفر رو پیدا کنید بگه آقا من یه کاری می‌کنم از درخت انار، انگور بیاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 377.9,
   "end": 380.22,
   "text": "از درخت انگور، انار بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 380.22,
   "end": 383.24,
   "text": "اصلاً قیافش عوض شه، رنگش عوض شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 383.24,
   "end": 386.82,
   "text": "حالا شاید بتونن یه کارهایی تو ژنتیکش بکنن اما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 386.82,
   "end": 389.54,
   "text": "کی تا حالا دیده درخت سیب، پرتقال بده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 389.54,
   "end": 392.58,
   "text": "بله بدون دخالت انسان. غصه نزنه-",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 392.58,
   "end": 396.1,
   "text": "نزنه. پیوند نزنه. پیوند هم بزنن اون نمیشه که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 396.1,
   "end": 398.04,
   "text": "یه چیز دیگه‌ای میشه. یه چیز بهتر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 398.04,
   "end": 400.82,
   "text": "یه چیز دیگه‌ای در میاد. بازم اون کار خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 400.82,
   "end": 404.18,
   "text": "اون پیوندی هم که می‌زنن، اونم کار خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 404.18,
   "end": 408.42,
   "text": "هزار تا، من خودم صد تا پیوند زدم آقای بهشتی صد تا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 408.42,
   "end": 412.94,
   "text": "آقا- از یک- چیزی نیومد. از بنجامین،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 412.94,
   "end": 415.64,
   "text": "از بنجامین صد تا پیوند زدم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 415.64,
   "end": 419.08,
   "text": "دو تاش گرفت. نود و هشت تاش سوخت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 419.08,
   "end": 421.22,
   "text": "این داره خدا داره آلارم میده دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 421.22,
   "end": 424.02,
   "text": "میگه کار من نیست. تعلیم دادن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 424.02,
   "end": 426.24,
   "text": "کشاورزی هم امیرالمؤمنین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 426.24,
   "end": 433.3,
   "text": "بله. لقمان حکیم در یک تمثلش چهار هزار خاصیت گیاه‌های دارویی رو از خدا اخذ کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 433.3,
   "end": 435.58,
   "text": "چهار هزار در یک تمثل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 435.58,
   "end": 439.3,
   "text": "همه اینا به قول عزیز آقای بهشتی دستورات اون‌هاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 439.3,
   "end": 442.72,
   "text": "ف بعد نکته بعد میگه فأنبتنا به.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 442.72,
   "end": 445.1,
   "text": "به چی؟ به چی فأنبتنا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 445.1,
   "end": 448.7,
   "text": "اینجا بازم خدا با معرفته اسباب رو برنمی‌داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 448.7,
   "end": 450.28,
   "text": "میگه من می‌رویونم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 450.28,
   "end": 452.8,
   "text": "اینا رو همه رو من رشد بهشون میدم. اما به، به چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 452.8,
   "end": 455.74,
   "text": "به باران. یعنی باران هم باز از منه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 455.74,
   "end": 457.62,
   "text": "أنزل من السماء. من",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 457.62,
   "end": 459.74,
   "text": "بارون رو نازل می‌کنم. خب؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 459.74,
   "end": 465.2,
   "text": "ولی همین درختم که می‌رویه با وسیله باران.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 465.2,
   "end": 468.72,
   "text": "خیلی جاها خدا أنزلنا میگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 468.72,
   "end": 471.96,
   "text": "ما نازل کردیم. یعنی اسباب رو هم میاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 471.96,
   "end": 475.5,
   "text": "هم معرفت به خرج میده. بالاخره اونا هم دارن زحمت می‌کشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 475.5,
   "end": 478.0,
   "text": "هم اصلاً سنت الهی اینه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 478.0,
   "end": 480.94,
   "text": "که از طریق اسباب کاراشو بکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 480.94,
   "end": 483.2,
   "text": "جا آقای بهشتی. همه رو رعایت می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 483.2,
   "end": 486.16,
   "text": "بلند بگید. میگم حق و حقوق همه رو رعایت می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 486.16,
   "end": 487.78,
   "text": "آفرین. نميگه من این کارو کردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 487.78,
   "end": 490.22,
   "text": "احسن. من مدیر کل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 490.22,
   "end": 491.96,
   "text": "هستم. احسن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 491.96,
   "end": 494.78,
   "text": "من امام جماعتم. احسن. نه دیگه امام جماعت رو قاطی نکن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 494.78,
   "end": 501.62,
   "text": "مدیر کل رو خوب اومدی. ذات بحجه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 501.62,
   "end": 505.98,
   "text": "خب خیلی شیرین داره اشاره می‌کنه به اینکه اصلاً یک امر عقلیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 505.98,
   "end": 509.8,
   "text": "زیبایی رو همه دوست دارن. کیه که بگه من بدم میاد از زیبایی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 509.8,
   "end": 511.62,
   "text": "کلیات رو عقل می‌سنجه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 511.62,
   "end": 513.74,
   "text": "جزئیات رو وهم. کلیات رو عقل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 513.74,
   "end": 516.14,
   "text": "آقا زیبایی خوبه یا بد؟ میگه خیلی خوبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 516.14,
   "end": 519.14,
   "text": "اینجا داره تایید می‌کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 519.14,
   "end": 522.38,
   "text": "کسی که عقل گراست و عاقلانه زندگی می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 522.38,
   "end": 525.0,
   "text": "ذات بحجه. ببین چه بحجتی داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 525.0,
   "end": 529.7,
   "text": "این ارزش زیبایی رو می‌رسونه که حالا بعضیا خونشون ریخته، پاش به--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 529.7,
   "end": 533.34,
   "text": "اصن میری تو اتاقش، اصن ریخت و قیافه و لباسش و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 533.34,
   "end": 537.0,
   "text": "ریش و لباس، موهاش و چیز اینا حالت بد میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 537.0,
   "end": 540.9,
   "text": "یکش میگه من شرک گرفته اصلاً بعد اسم ازالله هم خودش گذاشته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 540.9,
   "end": 544.42,
   "text": "نه اینا مطابق با طبع نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 544.42,
   "end": 548.28,
   "text": "نکته بعد اینکه در سوره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 548.28,
   "end": 551.34,
   "text": "چیز میخوایم بخونیم. در سوره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 551.34,
   "end": 555.84,
   "text": "فکر می‌کنم واقعه باشه. أأنتم تزرعونه أم نحن الزارعون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 555.84,
   "end": 557.84,
   "text": "حالا میگه شما فکر می‌کنید که شمایید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 557.84,
   "end": 562.6,
   "text": "أأنتم تزرعونه شما دارید زراعت می‌کنید أم نحن الزارعون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 562.6,
   "end": 565.0,
   "text": "زارع ما ایم. خیلی جالبه‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 565.0,
   "end": 567.84,
   "text": "این کشاورز اصلی حضرت حقه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 567.84,
   "end": 572.2,
   "text": "دیگه اوج عرض شود عرفانه دیگه عرفان اولییه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 572.2,
   "end": 575.72,
   "text": "اوج توحید افعالیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 575.72,
   "end": 578.84,
   "text": "یه توجه به این ذرائفی که در قرآن هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 578.84,
   "end": 581.92,
   "text": "زیاد هم هست. دو سه تا آیه براتون سریع بخونم و بسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 581.92,
   "end": 584.08,
   "text": "مثلاً آیه بیست و هفت فاطر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 584.08,
   "end": 593.2,
   "text": "ببینید ألم تر آیا نگاه نکردی أن الله أنزل من السماء ماءً فأخرجنا به ثمرات مختلفاً ألوانا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 593.2,
   "end": 597.32,
   "text": "خداست که اون بارون رو نازل می‌کنه از آسمون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 597.32,
   "end": 604.66,
   "text": "بعد اینطوری مختلفاً ألوانا درخت‌هایی، ثمرات و درخت‌ها و گیاههایی با رنگ‌های متفاوت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 604.66,
   "end": 609.82,
   "text": "آیه نود و نه انعام و هو الذي، هو الذي هم قل هو الله أحد ها،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 609.82,
   "end": 615.28,
   "text": "همون هو الذي أنزل من السماء ماءً فأخرجنا به نبات كل شيء.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 615.28,
   "end": 617.18,
   "text": "به به. دوباره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 617.18,
   "end": 620.28,
   "text": "حالا اینا رو وقتی میاره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 620.28,
   "end": 623.64,
   "text": "یه جا دیگه عجیبه، خیلی عجیب خدا حرف زده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 623.64,
   "end": 628.34,
   "text": "آیه پنجاه و پنج طه. منها وقتی بحث خلقت آدم رو میاره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 628.34,
   "end": 630.42,
   "text": "برید این آیه رو نگاه کنید روش فکر کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 630.42,
   "end": 632.54,
   "text": "من خیلی فکر کردم، خیلی برام عجیب بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 632.54,
   "end": 636.7,
   "text": "عجایبی ازش استخراج کردم. منها از اون ارز.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 636.7,
   "end": 639.34,
   "text": "این ها ضمیرها میخوره به ارز.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 639.34,
   "end": 641.4,
   "text": "منها خلقناکم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 641.4,
   "end": 645.84,
   "text": "ما شما رو از همین زمینی که روش نشستید خلق کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 645.84,
   "end": 649.76,
   "text": "و فيها و درش نعیدکم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 649.76,
   "end": 652.64,
   "text": "در همین خاک، در همین زمین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 652.64,
   "end": 654.64,
   "text": "نعیدکم. عود می‌کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 654.64,
   "end": 656.88,
   "text": "دوباره بر می‌گردید، بر می‌گردید به این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 656.88,
   "end": 659.98,
   "text": "خاک. واقعاً ما بر می‌گردیم به خاک؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 659.98,
   "end": 663.12,
   "text": "بله. دوباره ما بر می‌گردیم به خاک.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 663.12,
   "end": 665.56,
   "text": "و منها عجیب‌تر از اون اینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 665.56,
   "end": 669.42,
   "text": "دوباره و منها. ببینید منها خلقناکم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 669.42,
   "end": 673.5,
   "text": "و فيها نعیدکم و منها نخرجکم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 673.5,
   "end": 677.32,
   "text": "حالا دوباره از همین خاک شما رو بیرون می‌کشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 677.32,
   "end": 680.86,
   "text": "چه قدرتی! که انگار توی این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 680.86,
   "end": 685.86,
   "text": "زمین یک دوره کامل هدایت بشر صورت گرفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 685.86,
   "end": 689.1,
   "text": "تکامل بشر، بشر صورت گرفته و خواهد گرفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 689.1,
   "end": 692.24,
   "text": "ما هم کارمون تموم میشه میریم. قیامت هم قیام می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 692.24,
   "end": 694.08,
   "text": "دوره‌های بعدی، کره‌های بعدی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 694.08,
   "end": 697.56,
   "text": "همینطور آدم پشت آدم، الف الف آدم خواهد آمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 697.56,
   "end": 700.26,
   "text": "حالا اینا برای چیه؟ ختم کلام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 700.26,
   "end": 703.86,
   "text": "تو آیه قرآن می‌فرماید إن في ذلك لآيات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 703.86,
   "end": 709.2,
   "text": "اینی که ما داریم به شما میگیم اینا آیه‌هایمان، نشانه‌هایمان برای چیه به نظر شما؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 709.2,
   "end": 713.28,
   "text": "لأولي النهى. نهى اینجا معنیش چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 713.28,
   "end": 716.88,
   "text": "جمعش میشه نهیه. نهیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 716.88,
   "end": 718.92,
   "text": "یا نهى یعنی عقل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 718.92,
   "end": 721.12,
   "text": "یک مع-- یک اسم دیگه عقله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 721.12,
   "end": 727.94,
   "text": "چرا بهش میگن نهى؟ چون با عقل میشه تشخیص داد این هوای نفسه ترکش کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 727.94,
   "end": 730.06,
   "text": "عقل نداشته باشی نمی‌تونی تشخیص بدی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 730.06,
   "end": 733.58,
   "text": "لذا بهش میگن نهى. إن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 733.58,
   "end": 736.56,
   "text": "في ذلك لآيات لأولي النهى.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 736.56,
   "end": 742.7,
   "text": "کسی این آیات رو می‌بینه و می‌فهمه و می‌چشه و درک می‌کنه حرفای من خدا رو می‌گیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 742.7,
   "end": 744.68,
   "text": "که چی؟ دارای عقله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 744.68,
   "end": 748.1,
   "text": "عقلشو تعطیل نکرده و الا خنده‌ش می‌گیرم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 748.1,
   "end": 751.38,
   "text": "اللهم بارک لمولانا صاحب الزمان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 751.38,
   "end": 753.48,
   "text": "والحمد لله رب العالمين.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 753.48,
   "end": 760.5,
   "text": "صلوات. اللهم صل على محمد و آل محمد و عجل فرجهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}