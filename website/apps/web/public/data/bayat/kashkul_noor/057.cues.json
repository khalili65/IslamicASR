 },
 "chapters": [
  {
   "index": 0,
   "title": "## قوس نزول و صعود در ذیل آیه",
   "start": 0.48,
   "end": 293.82
  },
  {
   "index": 1,
   "title": "## اغوا نزد علامه؛ برداشتن توفیق",
   "start": 293.82,
   "end": 578.2
  },
  {
   "index": 2,
   "title": "## ابوذر و گرگ؛ هدایت تکوینی",
   "start": 578.2,
   "end": 649.68
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.48,
   "end": 3.72,
   "text": "بسم الله الرحمن الرحیم و به این استعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 3.72,
   "end": 7.62,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 7.62,
   "end": 11.88,
   "text": "آیات. سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 11.88,
   "end": 15.0,
   "text": "در آیه سی و چهار سوره هود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 15.0,
   "end": 28.4,
   "text": "می‌خوانیم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 28.4,
   "end": 29.22,
   "text": "خیلی آیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 29.22,
   "end": 32.84,
   "text": "شریفه. خیلی زیباست. خیلی عالی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 32.84,
   "end": 35.56,
   "text": "می‌فرماید اگه خدا بخواد شما رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 35.56,
   "end": 46.82,
   "text": "گمراه بسازه ،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 46.82,
   "end": 49.2,
   "text": "اگه خدا بخواد شما رو اغوا کنه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 49.2,
   "end": 52.26,
   "text": "خدا بخواد شما رو گمراه کنه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 52.26,
   "end": 55.08,
   "text": "نصیحت من اگرچه من پیغمبرم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 55.08,
   "end": 57.42,
   "text": "من نوح نبی اللهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 57.42,
   "end": 60.66,
   "text": "اما هیچ سودی به حال شما نخواهد داشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 60.66,
   "end": 64.56,
   "text": "اگر خدا بخواد شما رو گمراه کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 64.56,
   "end": 68.42,
   "text": "و هرچند که بخواهم برای شما خیرخواهی کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 68.42,
   "end": 70.98,
   "text": "نصح یعنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 70.98,
   "end": 78.0,
   "text": "خیرخواهی. یعنی طرف حتی گاهی اوقات پدر رو می‌بینید تو گوش بچه‌ش می‌زنه اما این خودش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 78.0,
   "end": 80.24,
   "text": "یک نوع نصح عملیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 80.24,
   "end": 84.34,
   "text": "خیرخواه بچه‌شه که گوشش رو می‌پیچونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 84.34,
   "end": 87.08,
   "text": "نصیحت گونه‌های مختلفی داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 87.08,
   "end": 90.04,
   "text": "مطلقا میشه خیرخواهی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 90.04,
   "end": 92.68,
   "text": "حالا چرا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 92.68,
   "end": 95.12,
   "text": "من هیچ کاره‌ی عالمم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 95.12,
   "end": 97.36,
   "text": "خیلی شیرینه. اصلا من کیف کردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 97.36,
   "end": 99.48,
   "text": "این دقت کردم به این leh",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 99.48,
   "end": 104.26,
   "text": "به این دقیقه و این لطیفه این آیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 104.26,
   "end": 112.88,
   "text": "چون ، اگه دقت کنید تو این قسمت انتهای آیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 112.88,
   "end": 118.92,
   "text": "قوس نزول و صعود رو با هم جمع کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 118.92,
   "end": 122.18,
   "text": "ناظر به قوس نزوله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 122.18,
   "end": 126.18,
   "text": "یعنی اوست که شما رو پیاده کرده در این عالم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 126.18,
   "end": 130.56,
   "text": "ان الله. رب هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 130.56,
   "end": 134.72,
   "text": "به فرمایش حضرت علامه حسن زاده علیه الرحمة والرضوان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 134.72,
   "end": 139.06,
   "text": "فرمودن تدبیر کننده روزی بخشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 139.06,
   "end": 145.38,
   "text": "هم قوتتو میده هم قوتتو میده هم حیاتت، حیات بهت می‌بخشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 145.38,
   "end": 149.8,
   "text": "هم ظاهر و باطنت رو مدیریت می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 149.8,
   "end": 152.42,
   "text": "دنیا و آخرت رو مدیریت می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 152.42,
   "end": 156.42,
   "text": "مدبره. مدیره. روزی دهنده است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 156.42,
   "end": 158.48,
   "text": "قوت دهنده است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 158.48,
   "end": 163.18,
   "text": "همه این‌ها دست ربه. چون تو رو پیاده کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 163.18,
   "end": 166.42,
   "text": "چون تو جزئی او کل از حیث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 166.42,
   "end": 171.92,
   "text": "به قول فرمایش ابن عربی در فصوص در فصل آخر بیست و هفتمین فصلش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 171.92,
   "end": 176.02,
   "text": "از حیث عشق کل به جزء عاشق بندشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 176.02,
   "end": 181.64,
   "text": "او کل ما جزء. از حیث عشقش این سیر حبّی که تو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 181.64,
   "end": 185.58,
   "text": "نازل شدی از ذات حضرت حق عاشقته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 185.58,
   "end": 188.2,
   "text": "و تو رو روزی میده. تدبیر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 188.2,
   "end": 191.32,
   "text": "امور تو رو دست می‌گیره. این از حیث چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 191.32,
   "end": 194.72,
   "text": "قوس نزولش. قوس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 194.72,
   "end": 198.4,
   "text": "صعودش کدوم میشه؟ .",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 198.4,
   "end": 205.0,
   "text": "و دیگه. این قوس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 205.0,
   "end": 206.84,
   "text": "نزوله. تدبیر می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 206.84,
   "end": 210.16,
   "text": "اصلا رب شماست که شما رو تدبیر می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 210.16,
   "end": 214.62,
   "text": "قوسش چگونه است؟ از آسمون به زمین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 214.62,
   "end": 219.86,
   "text": "قوس نزولی است که همه چی رو پیاده کرده برای تو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 219.86,
   "end": 226.38,
   "text": "در قرآن می‌فرماید و الارض هم داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 226.38,
   "end": 230.18,
   "text": "آنچه که در آسمان و زمینه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 230.18,
   "end": 232.36,
   "text": "اصلا برای شما آفریده شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 232.36,
   "end": 234.52,
   "text": "حالا شما برای کی آفریده شدید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 234.52,
   "end": 237.1,
   "text": "فرمود تو رو برای خودم آفریدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 237.1,
   "end": 239.7,
   "text": "و متأسفانه ما الهی زندگی نمی‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 239.7,
   "end": 243.76,
   "text": "اصلا توجه به این قصه نداریم که ما برای خدا خلق شدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 243.76,
   "end": 245.94,
   "text": "حالا ما رو پیاده کرده. کجا میریم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 245.94,
   "end": 250.78,
   "text": "قراره به کجا بریم؟ فرمود انتهای آیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 250.78,
   "end": 254.42,
   "text": "به سمت او در حرکتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 254.42,
   "end": 258.26,
   "text": "امر رو تدبیر می‌کنه. رب شماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 258.26,
   "end": 266.66,
   "text": "قوس نزول. دو مرتبه برمی‌گردید به سوی او.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 266.66,
   "end": 272.06,
   "text": "این میشه همون قوس صعود که الان ما در-در وادی قوس صعودیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 272.06,
   "end": 276.5,
   "text": "این نماز شما باید به ما به همه ما الان این نماز باید صعود می‌داد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 276.5,
   "end": 279.02,
   "text": "باید عروج میداد. الان ما در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 279.02,
   "end": 281.26,
   "text": "وادی قوس صعود هستیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 281.26,
   "end": 285.78,
   "text": "حالا این از انتهای آیه که خیلی به نظرم خیلی شیرین اومد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 285.78,
   "end": 291.22,
   "text": "اول گفتم. حالا چند تا فرمایش از بزرگان براتون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 291.22,
   "end": 292.94,
   "text": "تقدیم کنم که خیلی عالیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 292.94,
   "end": 296.84,
   "text": "اول از حضرت علامه طباطبایی علیه الرحمة والرضوان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 296.84,
   "end": 303.92,
   "text": "ایشون رو نه به معنای ظلم می‌گیره بلکه به معنای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 303.92,
   "end": 307.1,
   "text": "گرفتن توفیق از بنده می‌گیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 307.1,
   "end": 312.16,
   "text": "اغوا رو. اینجا چون می‌فرماید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 312.16,
   "end": 315.2,
   "text": "اگر خدا اراده کرده باشه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 315.2,
   "end": 319.16,
   "text": "شما رو اغوا کنه. مگه خدا اغوا می‌کنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 319.16,
   "end": 322.64,
   "text": "تو قرآن ربه شیطان به خدا گفت چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 322.64,
   "end": 328.24,
   "text": "ربه چون تو منو گمراه کردی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 328.24,
   "end": 336.28,
   "text": "ببینید از ریشه غوا. به عزت خدا قسم خورده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 336.28,
   "end": 338.86,
   "text": "خب یعنی خدا العیاذ بالله کار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 338.86,
   "end": 341.46,
   "text": "شیطانی می‌کنه؟ نه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 341.46,
   "end": 345.6,
   "text": "این‌ها ظاهرا با یک لفظ اومدن اما معناش متفاوته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 345.6,
   "end": 351.58,
   "text": "علامه طباطبایی می‌فرماید اغوا در مواردی‌ست که خداوند توفیق را برمی‌دارد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 351.58,
   "end": 354.52,
   "text": "و نفس را به خودش وا می‌گذارد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 354.52,
   "end": 358.3,
   "text": "پس ضلال از خودشان است، نه از خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 358.3,
   "end": 360.82,
   "text": "چون این خواسته که گمراه بشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 360.82,
   "end": 365.22,
   "text": "به سمت آلودگی بره، حرف حق پیغمبر رو نپذیره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 365.22,
   "end": 371.2,
   "text": "افتاد تو وادی ضلال و اغواگری حضرت حق یعنی رهاش می‌کنه خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 371.2,
   "end": 374.9,
   "text": "این معناش فرق می‌کنه با اون اغوای شیطان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 374.9,
   "end": 376.7,
   "text": "اون دعوت به گمراهی می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 376.7,
   "end": 379.38,
   "text": "اینجا خدا که دعوت به گمراهی نمی‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 379.38,
   "end": 382.9,
   "text": "خدا اینجا چه می‌کنه؟ توفیق رو ازش می‌گیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 382.9,
   "end": 388.86,
   "text": "اون توفیقات که با هندسه توفیق چگونه بود قبلاً عرض کردیم بالا به پایین هست، حوزه‌ش نزولیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 388.86,
   "end": 391.24,
   "text": "هندسه اخلاص پایین به بالاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 391.24,
   "end": 395.74,
   "text": "شما مخلص میشی. از بالا به پایین توفیقات ناظر میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 395.74,
   "end": 397.92,
   "text": "علامه طباطبایی فرمود این اتفاق می‌افته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 397.92,
   "end": 401.38,
   "text": "این توفیق برداشته میشه. ملاصدرا نظرش چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 401.38,
   "end": 404.0,
   "text": "همون ادبارم میشه؟ بله دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 404.0,
   "end": 406.7,
   "text": "وقتی توفیق برداشته شد نتیجه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 406.7,
   "end": 411.16,
   "text": "برداشته شدن توفیق یا اغوای الهی میشه ادبار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 411.16,
   "end": 413.7,
   "text": "یعنی شما اصلاً حال عبادت نداری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 413.7,
   "end": 415.3,
   "text": "نه سحر پا میشی نه مغرب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 415.3,
   "end": 418.76,
   "text": "بخواه اصلاً حوصله نداری. این میشه ادبار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 418.76,
   "end": 421.02,
   "text": "چرا؟ چون توفیق برداشته شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 421.02,
   "end": 428.02,
   "text": "ملاصدرا می‌فرماید: \"الصادقون من الأنبياء إذا تجلى لهم اسم المريد فنوحهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 428.02,
   "end": 432.32,
   "text": "ودعوتهم في ظل إرادته لا في وجه--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 432.32,
   "end": 434.76,
   "text": "في جه، جهت أنفسهم.\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 434.76,
   "end": 440.4,
   "text": "اینم خیلی عالیه. می‌فرماید نوح توی این آیه از مقام فعلی خود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 440.4,
   "end": 444.9,
   "text": "به مقام فناء في الفعل الهی رسیده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 444.9,
   "end": 450.8,
   "text": "نصیحت او دیگر منسوب به نفس نیست بلکه ظل اراده الهی‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 450.8,
   "end": 454.34,
   "text": "میگه من نصیحتمو می‌کنم. اما من خودم م--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 454.34,
   "end": 456.82,
   "text": "کانال مشیت الهی‌ام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 456.82,
   "end": 461.64,
   "text": "نصیحت من می‌تونه اتفاقاً در تو برعکس اثر کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 461.64,
   "end": 464.52,
   "text": "و تو رو بدتر از خدا دور کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 464.52,
   "end": 467.2,
   "text": "من می‌سپارم به خدا. من حرفمو می‌زنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 467.2,
   "end": 470.02,
   "text": "اراده، اراده خداست. خیلی فرمایش، فرمایش عالیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 470.02,
   "end": 472.08,
   "text": "اصلاً نگاه، نگاه توحیدیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 472.08,
   "end": 474.08,
   "text": "فرمایش علامه حسن زاده رو هم گوش بدید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 474.08,
   "end": 480.24,
   "text": "عالیه. نوح علیه السلام در گفتار خویش اظهار فنا در اراده کرده است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 480.24,
   "end": 482.54,
   "text": "اینا در، در اراده خدا فانی‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 482.54,
   "end": 486.84,
   "text": "من از خودم اراده‌ای ندارم. حقیقت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 486.84,
   "end": 489.92,
   "text": "کلامش این است که نصیحت من",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 489.92,
   "end": 493.16,
   "text": "ظل مشیت او، سایه خواست خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 493.16,
   "end": 498.68,
   "text": "هرچی خدا بخواد. و اگر آن مشیت در وجه اضلال یعنی گمراهی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 498.68,
   "end": 502.96,
   "text": "تجلی کند، نصیحت من نیز در همان وجه حرکت می‌کند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 502.96,
   "end": 505.52,
   "text": "باز علامه حسن زاده اینجا غوغا می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 505.52,
   "end": 509.6,
   "text": "یعنی به نظرم قشنگ‌ترین نظر رو حضرت استاد اینجا دادن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 509.6,
   "end": 511.88,
   "text": "فرمودن نصح و اغوا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 511.88,
   "end": 514.92,
   "text": "خیلی عالیه. دقت کنید این جمله آخر من.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 514.92,
   "end": 517.28,
   "text": "نصح و اغوا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 517.28,
   "end": 520.46,
   "text": "ظاهراً دو چیز متفاوت‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 520.46,
   "end": 525.84,
   "text": "خیرخواهی و اغواگری. هر دو از یک ربند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 525.84,
   "end": 529.06,
   "text": "الله اکبر. هر دو از همون رب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 529.06,
   "end": 533.3,
   "text": "مدیر مدبر روزی‌دهنده قدرت‌بخش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 533.3,
   "end": 537.4,
   "text": "هر دو از یک ربند. مرید حقیقی اوست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 537.4,
   "end": 539.58,
   "text": "یعنی اراده، اراده از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 539.58,
   "end": 542.38,
   "text": "المرید از اسامی حضرت حق دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 542.38,
   "end": 545.64,
   "text": "مرید حقیقی اوست و هدایت و اضلال هر دو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 545.64,
   "end": 547.92,
   "text": "هم هدایت هم اضلال.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 547.92,
   "end": 549.88,
   "text": "وجهین اراده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 549.88,
   "end": 553.54,
   "text": "واحده‌اند. الله اکبر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 553.54,
   "end": 559.28,
   "text": "یعنی همون حضرت حق، همون رب کن، کوه رب کن که الیه ترجعون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 559.28,
   "end": 561.7,
   "text": "همون نگاه می‌کنه به بنده‌ش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 561.7,
   "end": 565.12,
   "text": "اگر بنده خواست هدایت می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 565.12,
   "end": 568.42,
   "text": "اگر بنده نخواست اضلال می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 568.42,
   "end": 571.1,
   "text": "پس حول و قوه با خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 571.1,
   "end": 574.76,
   "text": "پیاده‌سازی، انجام، فعل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 574.76,
   "end": 576.88,
   "text": "با خداست. فناء فعلی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 576.88,
   "end": 579.04,
   "text": "توحید افعالی. خواست با کیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 579.04,
   "end": 581.7,
   "text": "بفرمایید. بنده. تموم شد و رفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 581.7,
   "end": 587.68,
   "text": "با بنده‌ست. تو اگر خواستی هدایتو تمام اسباب الهی هدایت تو رو می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 587.68,
   "end": 592.6,
   "text": "حتی زمین، زمان، در و دیوار تو رو هدایت می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 592.6,
   "end": 598.22,
   "text": "اما اگر نه، نخواستی پیغمبرش هم نمی‌تونه برای تو کاری بکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 598.22,
   "end": 601.0,
   "text": "میشه مثل حضرت ابذر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 601.0,
   "end": 602.86,
   "text": "که داشت گوسفندچرونی می‌کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 602.86,
   "end": 606.14,
   "text": "می‌دونید دیگه. گوسفندچرانی می‌کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 606.14,
   "end": 608.8,
   "text": "یه گرگ اومد هی عصا پرت کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 608.8,
   "end": 610.44,
   "text": "هی گرگه رفت برگشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 610.44,
   "end": 614.24,
   "text": "هی عصا، یه چوب دیگه، یه سنگ هی پرت کرد دید نه میره میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 614.24,
   "end": 617.02,
   "text": "گفت عجب گرگ بی‌حیاییه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 617.02,
   "end": 621.88,
   "text": "گرگه به لسان واضح عربی با ابوذر صحبت کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 621.88,
   "end": 624.24,
   "text": "آقا گرگه حیوان درنده‌ست این میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 624.24,
   "end": 626.5,
   "text": "در و دیوار می‌ Ine هدایتگر می‌شن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 626.5,
   "end": 629.2,
   "text": "چی گفت؟ گفت بی‌حیا من نیستم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 629.2,
   "end": 633.08,
   "text": "بی‌حیا اونان که در مکه پیغمبر ظهور کرده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 633.08,
   "end": 637.88,
   "text": "سنگش می‌زنن. تازه فهمید چه خبره راه افتاد رفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 637.88,
   "end": 640.86,
   "text": "به این معنی در حیوان هدایتگر می‌شن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
