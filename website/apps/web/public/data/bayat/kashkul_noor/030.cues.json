 "chapters": [
  {
   "index": 0,
   "title": "## توحید افعالی؛ نخستین رتبهٔ توحید",
   "start": 21.92,
   "end": 42.08
  },
  {
   "index": 1,
   "title": "## دشواری درک توحید افعالی",
   "start": 42.08,
   "end": 62.28
  },
  {
   "index": 2,
   "title": "## روایت شیخ انصاری؛ امید به غیر خدا",
   "start": 62.28,
   "end": 287.9
  },
  {
   "index": 3,
   "title": "## سختی مسیر؛ سکرات و هم‌نشینی با اهل توحید",
   "start": 287.9,
   "end": 378.61
  },
  {
   "index": 4,
   "title": "## آقای بروجردی و توحید افعالی در عمل",
   "start": 378.61,
   "end": 543.25
  },
  {
   "index": 5,
   "title": "## چشم به خدا نه به دست دیگران",
   "start": 543.25,
   "end": 606.47
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.28,
   "end": 4.02,
   "text": "اللهم صل علی محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 4.02,
   "end": 7.6,
   "text": "و آل محمد و عجل فرجهم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 7.6,
   "end": 12.52,
   "text": "بسم الله الرحمن الرحیم و بهین استعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 12.52,
   "end": 16.68,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 16.68,
   "end": 21.92,
   "text": "آیاته. السلام علیکم و رحمه الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 21.92,
   "end": 25.06,
   "text": "در ادامه بحث توحید افعالی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 25.06,
   "end": 27.66,
   "text": "که اولین رتبه از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 27.66,
   "end": 33.58,
   "text": "سه رتبه‌ی توحیده و هیچ چاره‌ای برای درک تجلیات الهی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 33.58,
   "end": 37.42,
   "text": "نیست مگر ورود به این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 37.42,
   "end": 41.32,
   "text": "سه دسته و این سه رتبه‌ی توحید،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 41.32,
   "end": 45.98,
   "text": "یه فرمایشی رو از استاد عزیزمون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 45.98,
   "end": 48.72,
   "text": "حضرت آقای مظاهری می‌خونم یادش بخیر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 48.72,
   "end": 51.84,
   "text": "ما اصفهان که درس می‌خوندیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 51.84,
   "end": 57.48,
   "text": "خیلی از حضور نورانی ایشون بهره می‌بردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 57.48,
   "end": 62.28,
   "text": "در صبح‌ها مسجد امیرالمؤمنین مجیای اصفهان هم حالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 62.28,
   "end": 68.02,
   "text": "که مستحضر باشین اونجا ایشون درس تفسیر داشتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 68.02,
   "end": 71.34,
   "text": "ایشون می‌فرمایند که اگر خداوند را به عنوان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 71.34,
   "end": 75.7,
   "text": "مسبب الاسباب درک کنیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 75.7,
   "end": 78.6,
   "text": "توحید افعالی را فهمیدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 78.6,
   "end": 83.32,
   "text": "جواب سؤال اونایی که میگن چجوری میشه بفهمیم واقعاً؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 83.32,
   "end": 87.08,
   "text": "کسی که خدا رو مسبب الاسباب بشناسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 87.08,
   "end": 89.38,
   "text": "لا مؤثر فی الوجود الا الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 89.38,
   "end": 93.2,
   "text": "لا مسبب فی الوجود الا الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 93.2,
   "end": 96.96,
   "text": "مسبب الاسباب. هر سببی رو او",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 96.96,
   "end": 100.34,
   "text": "مسببه، او ایجاد می‌کنه، او جورش می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 100.34,
   "end": 104.04,
   "text": "یعنی همه چی به دست اوست. واقعاً اگر ید الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 104.04,
   "end": 107.28,
   "text": "رو فوق ایدیهم ببینیم همین آیه قرآن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 107.28,
   "end": 109.98,
   "text": "همین رو بدونیم کار تمومه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 109.98,
   "end": 114.76,
   "text": "واقعاً بدونیم ها. در زندگی روزمره‌مون این مشخص میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 114.76,
   "end": 121.06,
   "text": "بعد ادامه میدن که درک توحید افعالی بسیار سخت و مشکل است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 121.06,
   "end": 125.8,
   "text": "یعنی این‌طور نیست که شما فکر کنید به سهل الوصوله و خیلی راحت میشه بهش رسید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 125.8,
   "end": 139.8,
   "text": "نه، خیلی سخته. این توحید یعنی انسان وجود خداوند را مسبب الاسباب بداند، درک کند که تنها مؤثر در عالم است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 139.8,
   "end": 142.82,
   "text": "فقط خدا رو مؤثر بدونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 142.82,
   "end": 149.24,
   "text": "باز ادامه میدن که به دست آوردن توحید افعالی بسیار مشکل است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 149.24,
   "end": 154.46,
   "text": "افرادی که به مراتب، حالا اینجاشو دقت کنید، نه عالیه‌ش بلکه به مراتب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 154.46,
   "end": 159.1,
   "text": "پایین این توحید، تازه این رتبه‌ی اوله توحیده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 159.1,
   "end": 163.22,
   "text": "حالا اونایی که توی این رتبه‌ی اول به مراتب پایینش تازه برسن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 163.22,
   "end": 168.3,
   "text": "می‌فرماید بسیار کم و انگشت‌شمار هستند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 168.3,
   "end": 175.86,
   "text": "خیلی باید ریاضت کشید، خیلی باید با خداوند مرتبط بود تا مراتب پایین این توحید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 175.86,
   "end": 184.28,
   "text": "به انسان داده شود. بعد اون روایتی رو که شیخ انصاری علیه الرحمه آورده رو بیان می‌کنه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 184.28,
   "end": 188.12,
   "text": "در زمان امام صادق صلوات الله علیه یه نفر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 188.12,
   "end": 190.9,
   "text": "داشته ورشکست می‌شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 190.9,
   "end": 195.38,
   "text": "بعد میره دنبال یه نفر که ازش پول قرض بگیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 195.38,
   "end": 201.54,
   "text": "تو راه بر می‌خوره به یکی از شاگردان امام صادق صلوات الله علیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 201.54,
   "end": 205.44,
   "text": "چقدر مهمه انسان استادش کی باشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 205.44,
   "end": 208.54,
   "text": "استادش امام زمانشه، شوخی نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 208.54,
   "end": 214.22,
   "text": "بله هر حرفی رو هر کسی هم نمی‌تونه بزنه و تأثیر کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 214.22,
   "end": 218.34,
   "text": "طرف میگه حاجی این ذکرو گفتی ما انجام دادیم هیچ تأثیری نکرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 218.34,
   "end": 221.02,
   "text": "خب ببین از نفس کی اینو گرفتی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 221.02,
   "end": 225.82,
   "text": "اون کسی که داره بهت القا می‌کنه این ذکر رو خیلی مهمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 225.82,
   "end": 233.0,
   "text": "از هرکی نگیر. درس عبرتت باشه دیگه از ما دستورالعمل نگیر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 233.0,
   "end": 239.12,
   "text": "گفت کجا میری؟ گفت دارم میرم از کسی پول قرض بگیرم به این شکل و اینا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 239.12,
   "end": 243.46,
   "text": "این شخص گفت من از امام صادق صلوات الله علیه شنیدم، این فرمایش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 243.46,
   "end": 248.3,
   "text": "حضرته. حالا داره به این رفیقش میگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 248.3,
   "end": 256.56,
   "text": "شنیدم که فرمود خداوند در مورد کسی که به غیر او مراجعه کند فرموده است که به عزت و جلالم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 256.56,
   "end": 262.64,
   "text": "چه غیرتی از خدا می‌جوشه که به عزت و جلالش سوگند می‌خورد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 262.64,
   "end": 269.84,
   "text": "مثلاً شما بچه‌ت بره در حالی که شما داری، فکر کنید همه چی داری بعد بچه‌ت بره به یک گدا رو بزنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 269.84,
   "end": 277.34,
   "text": "چقدر غیرتت می‌جوشد؟ به عزت و جلالم سوگند که امید او را ناامید خواهم کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 277.34,
   "end": 283.2,
   "text": "اینو خدا فرموده. شیخ انصاری علیه الرحمه تو کتابش میاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 283.2,
   "end": 287.9,
   "text": "اینم آقای مظاهری اشاره کرده تو فرمایشاتش و ایشون فرمودن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 287.9,
   "end": 292.0,
   "text": "در هر حال خیلی سخته، خیلی باید انسان تلاش کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 292.0,
   "end": 297.02,
   "text": "و این تازه پایین‌ترین مراتب رتبه‌ی اول رو میگه انگشت‌شمار می‌رسن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 297.02,
   "end": 300.38,
   "text": "چرا اکثراً خیلی سخته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 300.38,
   "end": 303.38,
   "text": "برزخشون؟ خیلی طولانیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 303.38,
   "end": 308.34,
   "text": "بیچاره میشن آقا. یه وقت می‌بینی هفتصد سال طول می‌کشه فقط بمیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 308.34,
   "end": 310.54,
   "text": "از نظر من و شما یک آنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 310.54,
   "end": 312.22,
   "text": "عه تموم شد چشماشو بست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 312.22,
   "end": 315.1,
   "text": "اما هفتصد سال جون کندنش طول کشیده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 315.1,
   "end": 317.92,
   "text": "این تازه بین دنیا و برزخشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 317.92,
   "end": 322.06,
   "text": "س-- حالت سکراته. بیهوشی هنگام مرگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 322.06,
   "end": 326.04,
   "text": "از نظر ما بیهوشیه ولی اونجا هوش و حواسش پریده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 326.04,
   "end": 328.62,
   "text": "تازه فهمیده چه خبره. سرش به سنگ خورده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 328.62,
   "end": 330.86,
   "text": "سنگ لحدم اونه، نه این لحد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 330.86,
   "end": 333.12,
   "text": "سنگ تو خاک فقهی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 333.12,
   "end": 338.2,
   "text": "قبر فقهی. امان از اون لحظات خدا شاهده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 338.2,
   "end": 340.92,
   "text": "خدا زودتر انسان رو بیدار کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 340.92,
   "end": 346.96,
   "text": "خیلی سخته. بعد ما توقع داریم با اونا هم‌نشین بشیم، با اهل بیت علیهم السلام که دیگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 346.96,
   "end": 351.8,
   "text": "همه توحیدن، همه توحیدن، روح توحیدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 351.8,
   "end": 356.02,
   "text": "بعد ما می‌خوایم با اون‌ها هم‌نشین بشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 356.02,
   "end": 358.96,
   "text": "چقدر من پرروام معذرت می‌خوام از شما استاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 358.96,
   "end": 363.37,
   "text": "چقدر من بی‌حیام. خیلی بی‌حیایی می‌خواد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 363.37,
   "end": 365.33,
   "text": "اونایی که خدای توحیدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 365.33,
   "end": 370.99,
   "text": "تو که تا تق به توق می‌خوره سریع به اه، اه کس و ناکس رو می‌زنی و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 370.99,
   "end": 373.55,
   "text": "به همه رو می‌زنی جز خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 373.55,
   "end": 378.61,
   "text": "یه بار سحر پا شن بگن یا أكرم الأكرمین أكرمنا کرم کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 378.61,
   "end": 383.99,
   "text": "خدا رحمت کنه آقای فاطمی نیا می‌فرمودن اگه نماز شب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 383.99,
   "end": 387.21,
   "text": "وقت نداشتی یا حال نداشتی هرچی بود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 387.21,
   "end": 389.45,
   "text": "اون سه رکعتو بخون، شب و وتر رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 389.45,
   "end": 391.53,
   "text": "نداشتی اونم نداشتی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 391.53,
   "end": 394.71,
   "text": "وتر رو تنها بخون. اونم نداشتی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 394.71,
   "end": 398.23,
   "text": "فقط دستو بلند کن بگو یا أكرم الأكرمین أكرمنا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 398.23,
   "end": 402.23,
   "text": "خدا جبران می‌کنه برات نماز شب نخوندنتو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 402.23,
   "end": 406.41,
   "text": "توجه کردید آدم به خدا رو کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 406.41,
   "end": 408.47,
   "text": "آثار و برکاتشو ببینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 408.47,
   "end": 415.95,
   "text": "خدا رحمت کنه آقای بروجردی رو اینو مرحوم آقای فلسفی نقل می‌کردن که آقای بروجردی وقتی اومده بود ایران",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 415.95,
   "end": 419.31,
   "text": "توی شهریه طلبه‌ها به مشکل برخورده بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 419.31,
   "end": 421.45,
   "text": "خب طلبه کارش درس خوندنه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 421.45,
   "end": 426.71,
   "text": "کار می‌کنه اما باید درس بخونه تا به اج-- استخوان‌بندی علمیش قوی شه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 426.71,
   "end": 430.43,
   "text": "توقع داریم یه کاسب شیش دانگه حواسش به کسب و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 430.43,
   "end": 436.65,
   "text": "نوسان بورس و دلار و سکه و ارز و چی و این کوفت زهر مارا باشه تا کاسب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 436.65,
   "end": 440.27,
   "text": "دو استابی بشه، تا یه تاجر و بیزینس خوبی باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 440.27,
   "end": 442.35,
   "text": "اما یه بچه طلبه تو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 442.35,
   "end": 444.65,
   "text": "کار نداری فقط داری درس می‌خونی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 444.65,
   "end": 447.75,
   "text": "خب می‌خواد ملا بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 447.75,
   "end": 451.81,
   "text": "کارش اونه. چاره‌ای جز این نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 451.81,
   "end": 454.55,
   "text": "شهریه طلبه‌ها رو نداشت بده آقای بروجردی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 454.55,
   "end": 460.39,
   "text": "آقای فلسفی محضر ایشون رو درک کرده بود آه دل ایشون رو بالاخره در دلش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 460.39,
   "end": 465.83,
   "text": "راه افتاده بود از طرف خودش رفته بود پیش علمای تهران گفته بود که آقای بروجردی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 465.83,
   "end": 470.85,
   "text": "مثلا نداره شهریه طلبه‌ها رو می‌خواد بده، بیایید کمکشون کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 470.85,
   "end": 476.31,
   "text": "رفته بود بعد پیش حضرت امام. حضرت امام تا شنیده بود حالا اون علمای دیگه ظاهرا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 476.31,
   "end": 481.37,
   "text": "کاری نکرده بودند. امام تا شنیده بود فرموده بود از طرف من به بازاری‌ها بگید که سهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 481.37,
   "end": 484.71,
   "text": "امامشونو بدن به آقای بروجردی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 484.71,
   "end": 489.05,
   "text": "حالا چقدر حرف اینجا هست که امام این کارو می‌کنه ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 489.05,
   "end": 491.51,
   "text": "ما از یک قرون دوزارمون نمی‌گذریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 491.51,
   "end": 494.73,
   "text": "امام می‌تونه تصرف کنه تو این پول.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 494.73,
   "end": 499.17,
   "text": "خلاصه اینو که میگه آقای بر-- فلسفی میره پیش خود آقای بروجردی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 499.17,
   "end": 506.29,
   "text": "میگه اصل-- آستاد روح‌الله هم چیزی گفته شما اجازه میدید من برم بگم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 506.29,
   "end": 508.17,
   "text": "ایشون می‌فرماد که کی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 508.17,
   "end": 512.27,
   "text": "آقای بروجردی. این جمله رو میگم خیلی جالبه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 512.27,
   "end": 516.13,
   "text": "می‌فرمایند که نه اگرچه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 516.13,
   "end": 519.81,
   "text": "هرچند از جهت شرعی اشکالی نداره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 519.81,
   "end": 521.95,
   "text": "ولی نه نیازی نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 521.95,
   "end": 528.31,
   "text": "این جمله رو دارم میگم آقای بروجردی میگه این به توحید افعالی ضرر می‌زنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 528.31,
   "end": 531.27,
   "text": "الله اکبر. به چه چیزهایی فکر می‌کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 531.27,
   "end": 534.11,
   "text": "بعد حالا بعداً البته آقای فلسفی رو می‌بینه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 534.11,
   "end": 538.67,
   "text": "آقای بروجردی میگه تا به محض اینکه شما رفتی یه شخصی اومد سه ماه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 538.67,
   "end": 543.25,
   "text": "شهریه همه طلبه‌ها رو تضمین کرد تا سه ماه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 543.25,
   "end": 546.65,
   "text": "خدا منتظر می‌بینه إنک ربک للبعث یرصد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 546.65,
   "end": 549.71,
   "text": "منتظر می‌شینه ببینه تو چه می‌کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 549.71,
   "end": 554.27,
   "text": "اگر چشمت به دست دیگران باشه هر آینه ناامیدت می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 554.27,
   "end": 559.09,
   "text": "اما نه اگر فقط بگی ماشاءالله لا قوة إلا بالله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 559.09,
   "end": 563.35,
   "text": "همه چی از خودسه. باید ببینیم خدا چه می‌کنه برای تو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 563.35,
   "end": 566.47,
   "text": "بارها هم برای هممون تو زندگی پیش اومده‌ها این چیزا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 566.47,
   "end": 570.33,
   "text": "داریم لمسش می‌کنیم. اما متاسفانه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 570.33,
   "end": 574.89,
   "text": "غفلت نمی‌دونم چیه؟ تسویف، سوف سوف حالا از فردا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 574.89,
   "end": 576.63,
   "text": "وادی توحید رو رها کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 576.63,
   "end": 579.07,
   "text": "حالا اینجا خیلی حرفا داریم به درد بخور هم هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 579.07,
   "end": 581.89,
   "text": "اونا اصلاً گم شده‌های ما ایناست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 581.89,
   "end": 584.89,
   "text": "این چیزا گم شده‌های ماست. نه اون ذکر و ورد و--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 584.89,
   "end": 586.69,
   "text": "اونم باید باشه. اما اصل اینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 586.69,
   "end": 590.53,
   "text": "این استخوان‌بندی اگه درست بود، چارچوب اگه درست بود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 590.53,
   "end": 596.35,
   "text": "ذکرتم اثر داره، خلوت سحرتم اثر داره، اخلاقیات سیر و سلوکتم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 596.35,
   "end": 599.75,
   "text": "تاثیر داره. ولی این درست نشه فایده نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 599.75,
   "end": 602.99,
   "text": "والحمد لله رب العالمين صلوات ختم کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 602.99,
   "end": 606.47,
   "text": "اللهم صل علی محمد و آل محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}