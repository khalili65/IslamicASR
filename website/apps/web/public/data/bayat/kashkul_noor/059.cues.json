 },
 "chapters": [
  {
   "index": 0,
   "title": "## رب آسمان‌ها و زمین؛ از رب تا الله",
   "start": 15.16,
   "end": 154.82
  },
  {
   "index": 1,
   "title": "## نور علی نور؛ کلمات وجودی و بحر ملکوت",
   "start": 154.82,
   "end": 297.7
  },
  {
   "index": 2,
   "title": "## نور ما از نور رب؛ اتصال روح مؤمن به روح الله",
   "start": 297.7,
   "end": 386.14
  },
  {
   "index": 3,
   "title": "## قل الله خالق کل شیء؛ واحد قهار",
   "start": 386.14,
   "end": 626.74
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 7.26,
   "end": 11.1,
   "text": "بسم الله الرحمن الرحیم و به این استعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 11.1,
   "end": 16.96,
   "text": "السلام علیک یا داعی الله و ربانی یا آیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 16.96,
   "end": 20.44,
   "text": "سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 20.44,
   "end": 23.58,
   "text": "آیه شونزده سوره رعد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 23.58,
   "end": 26.76,
   "text": "قل، پیغمبر بگو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 26.76,
   "end": 31.26,
   "text": "به مشرکین بگو. من رب السماوات والأرض.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 31.26,
   "end": 36.22,
   "text": "پروردگار آسمان و زمین کیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 36.22,
   "end": 39.84,
   "text": "انقدر که مشرکین متعصب بودن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 39.84,
   "end": 43.38,
   "text": "حتی بدیهی‌ترین سؤالات رو هم حاضر نبودن پاسخ بدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 43.38,
   "end": 46.2,
   "text": "لذا می‌فرماید خودت جوابشونو بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 46.2,
   "end": 48.78,
   "text": "قل الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 48.78,
   "end": 51.32,
   "text": "قل الله. بگو الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 51.32,
   "end": 56.48,
   "text": "پروردگار آسمان‌ها و زمینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 56.48,
   "end": 61.82,
   "text": "حالا اینجا بحث پیش میاد که اینجا چرا ابتدا از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 61.82,
   "end": 66.7,
   "text": "رب استفاده کرده، اسم رب استفاده کرده بعد الله رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 66.7,
   "end": 70.34,
   "text": "آورده. چه فرقی بین رب و الله هست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 70.34,
   "end": 74.06,
   "text": "اولاً الله که می‌دونید اسم جامع",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 74.06,
   "end": 77.36,
   "text": "رب پیغمبره، رب انسان کامله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 77.36,
   "end": 82.46,
   "text": "چون تمام اسماء در انسان کامل پیاده شده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 82.46,
   "end": 86.22,
   "text": "پس پروردگار اون میشه الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 86.22,
   "end": 91.0,
   "text": "رب هم-همه موجودات دیگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 91.0,
   "end": 100.78,
   "text": "اون جدولی از کانال وجودیشونه که مرتبط میشن به بحر وجود، به الله، به الوهیت نظام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 100.78,
   "end": 105.46,
   "text": "اون اسمی از اسامی حضرت حقی که در هر کسی پیاده شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 105.46,
   "end": 108.48,
   "text": "حالا شدت پیاده سازیشم باز متفاوته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 108.48,
   "end": 111.06,
   "text": "صعه وجودی هر کسی بستگی داره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 111.06,
   "end": 117.24,
   "text": "به میزان و شدت نوری پیاده شدن هر اسمی در هر کسی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 117.24,
   "end": 120.46,
   "text": "در طول هم‌ن، اسماء عین ذاتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 120.46,
   "end": 124.2,
   "text": "اسمی که در من پیاده شده اسم اعظم وجودی منه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 124.2,
   "end": 129.18,
   "text": "یا حصه وجودی منه یا سر منه، کانال ارتباطی من با",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 129.18,
   "end": 132.9,
   "text": "اللهه، اونم اسم الله دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 132.9,
   "end": 136.12,
   "text": "صدنه و خدمه الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 136.12,
   "end": 138.94,
   "text": "درست شد؟ الله اسم جامع.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 138.94,
   "end": 142.18,
   "text": "در طول اونه، در عرض هم که نیستن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 142.18,
   "end": 145.62,
   "text": "اما رب من اونه، اون اسمه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 145.62,
   "end": 150.24,
   "text": "که شأنی از شؤون الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 150.24,
   "end": 151.82,
   "text": "اینو گفتم که فرقشو بدونید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 151.82,
   "end": 154.82,
   "text": "اتفاقاً این کتابی هم که الان دست منه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 154.82,
   "end": 161.08,
   "text": "کتاب شریف نور على نور در ذکر ذاکر مذکور حضرت علامه حسن زاده علیه الرحمة والرضوان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 161.08,
   "end": 162.84,
   "text": "توصیه می‌کنم این کتابو بخونید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 162.84,
   "end": 170.08,
   "text": "خیلی کتاب عالی‌ایه. اصلاً به درد بخوره برای هممون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 170.08,
   "end": 172.64,
   "text": "ایشون توی بخشی از کتاب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 172.64,
   "end": 176.36,
   "text": "اگر خواستید رجوع کنید صفحه صد و دوازده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 176.36,
   "end": 182.98,
   "text": "می‌فرماید آنچه عادت می‌شود و القادا-- القا-القاءات هرچی که به تو القا میشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 182.98,
   "end": 186.64,
   "text": "و تمثلات که به تو روی می‌آورد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 186.64,
   "end": 189.98,
   "text": "همه درونی‌اند نه بیرونی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 189.98,
   "end": 196.26,
   "text": "و به عبارت روشن‌تر همونطور که در فصل پنجم گفته‌ایم هر یک از کلمات وجودی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 196.26,
   "end": 199.12,
   "text": "جدولی از بحر وجود است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 199.12,
   "end": 204.72,
   "text": "شما یک کلمه وجودی هستی از بین بی‌نهایت کلمات وجودی نظام هستی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 204.72,
   "end": 207.84,
   "text": "که در تکلم الهی خلق شدی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 207.84,
   "end": 209.9,
   "text": "میگه هر کدوم از شما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 209.9,
   "end": 214.62,
   "text": "جدولی‌s هستید که وصلید به دریای لایتناهی وجود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 214.62,
   "end": 217.38,
   "text": "که آن بحر ملکوت اوست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 217.38,
   "end": 221.08,
   "text": "اون بحر، اون دریای لایتناهی ملکوت هر کدوم از ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 221.08,
   "end": 225.62,
   "text": "بیدیهی ملکوت کل شیء و الیه ترجعون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 225.62,
   "end": 228.72,
   "text": "ما میریم به سمت ملکوت و الیه ترجعون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 228.72,
   "end": 232.12,
   "text": "به سمت اون کسی که بیدیهی ملکوته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 232.12,
   "end": 236.52,
   "text": "ملکوت کل شی. ملکوت ما دست اونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 236.52,
   "end": 239.54,
   "text": "ما میریم به سمت اون. از چه طریقی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 239.54,
   "end": 241.34,
   "text": "از طریق رب وجودی‌م.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 241.34,
   "end": 244.14,
   "text": "اسم اعظمی که در ما پیاده شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 244.14,
   "end": 246.62,
   "text": "بقیه فرمایش حضرت استاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 246.62,
   "end": 251.68,
   "text": "این انتصاب کلمان-کلمات نوری موجودات به وجود حقیقی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 251.68,
   "end": 256.04,
   "text": "که حق سبحانه اوست همان است که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 256.04,
   "end": 258.28,
   "text": "کمال اهل توحید فرمودند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 258.28,
   "end": 263.46,
   "text": "فرمایش ابن فناری رو از مصباح العنس اینجا میاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 263.46,
   "end": 267.28,
   "text": "خواستید رجوع کنید به کتابش صفحه سیصد و چهل و هشت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 267.28,
   "end": 269.28,
   "text": "درش آوردم من اونجاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 269.28,
   "end": 273.6,
   "text": "مصباح العنس مرحوم ابن فناری که سنگین‌ترین کتاب در افاضه نظریه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 273.6,
   "end": 278.32,
   "text": "می‌فرماید هویت هو کل شی فی الحقیقه شعاع هویته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 278.32,
   "end": 283.42,
   "text": "هویت هر کسی-- می‌خوای بدونی هویت شما چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 283.42,
   "end": 286.26,
   "text": "اصلاً شما چی هستی؟ می‌فرماید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 286.26,
   "end": 289.82,
   "text": "شعاع هویت حقی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 289.82,
   "end": 294.3,
   "text": "پرتویی از نور، نور وجودی حقی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 294.3,
   "end": 299.72,
   "text": "بعد یه حدیث رو میاره. خیلی حدیث-- دو تا روایت میاره خیلی عالی، عالی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 299.72,
   "end": 301.82,
   "text": "یعنی آدم می‌خواد پرواز کنه وقتی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 301.82,
   "end": 304.96,
   "text": "متوجه میشه که درون مایه ما چگونه است،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 304.96,
   "end": 309.46,
   "text": "هویت ما چیه، چنان عزت نفسی پیدا می‌کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 309.46,
   "end": 315.94,
   "text": "اون موقع سرتو می‌ندازی رو خاک در برابر رب مطلق نظام هستی که چه کرده با تو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 315.94,
   "end": 319.6,
   "text": "يفصل نورنا من نور ربنا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 319.6,
   "end": 323.42,
   "text": "جدا شده نور ما از نور پروردگار ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 323.42,
   "end": 326.1,
   "text": "کشعاع الشمس من الشمس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 326.1,
   "end": 328.74,
   "text": "و ایذاً الله اکبر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 328.74,
   "end": 331.78,
   "text": "و ایذاً این روایت، این روایت که دیگه غوغا کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 331.78,
   "end": 333.98,
   "text": "ان روح المؤمنه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 333.98,
   "end": 336.92,
   "text": "روح مؤمن. شما مؤمن هستی دیگه انشاالله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 336.92,
   "end": 341.3,
   "text": "مؤمن یعنی کسی که ولایت امیر المؤمنین رو پذیرفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 341.3,
   "end": 346.74,
   "text": "روحت چه-چگونه است؟ ان روح المؤمنه لا، لامش هم تأکیده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 346.74,
   "end": 349.54,
   "text": "قطعاً اشد اتصالا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 349.54,
   "end": 353.68,
   "text": "شدیدترین وجه ممکن رو در نظر بگیرید از حیث اتصال،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 353.68,
   "end": 356.28,
   "text": "به چی؟ بروح الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 356.28,
   "end": 359.82,
   "text": "من اتصال شعاع الشمس بها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 359.82,
   "end": 364.76,
   "text": "شعاع الشمس، پرتو نور خورشید چه اتصالی داره به خود خورشید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 364.76,
   "end": 367.1,
   "text": "میگه روح شما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 367.1,
   "end": 369.96,
   "text": "شدت اتصالش به روح الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 369.96,
   "end": 374.9,
   "text": "بیش از اون شدته. یعنی تو چیز جدایی از حضرات حق نیستی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 374.9,
   "end": 377.92,
   "text": "حالا از چه طریقی؟ این پرتو رو در نظر بگیرید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 377.92,
   "end": 383.76,
   "text": "این پرتو نوری که در وجود شمامون عکس شده از چه کانالی منعکس شده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 383.76,
   "end": 389.14,
   "text": "اون ربط به من و شماست. حالا در ابتدای آیه این همه حرف زدیم که اینو بگیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 389.14,
   "end": 398.28,
   "text": "در ابتدای آیه فرمود: «قل» بگو «من رب السماوات والأرض» پروردگار این آسمان‌ها و زمین کیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 398.28,
   "end": 401.6,
   "text": "هر کدوم اونا هم اسمی دارن. یعنی آسمان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 401.6,
   "end": 405.36,
   "text": "عبد رفیعه. عبد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 405.36,
   "end": 410.52,
   "text": "اسم رفیعه. یعنی رب آسمان میشه اسم الرفیع.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 410.52,
   "end": 413.36,
   "text": "هر کدوم از، از اشیا یه ربی دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 413.36,
   "end": 415.88,
   "text": "حالا کلن یه دفعه همه رو جمع می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 415.88,
   "end": 418.02,
   "text": "پیغمبر خسته نکن خودتو اینا رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 418.02,
   "end": 420.02,
   "text": "«قل الله» بگو الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 420.02,
   "end": 424.26,
   "text": "حالا الله رب توئه. چون همه اسماء در تو پیاده شده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 424.26,
   "end": 425.86,
   "text": "اما همه الیه توجمع.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 425.86,
   "end": 427.94,
   "text": "همه به سمت اون در حرکتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 427.94,
   "end": 432.0,
   "text": "ببین چه خبره تو این آیه. حالا ما به طمع ثواب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 432.0,
   "end": 433.98,
   "text": "آقا آیه بخونیم، ثواب ببریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 433.98,
   "end": 435.84,
   "text": "این آیه رو از اول شروع می‌کنیم خوندن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 435.84,
   "end": 439.22,
   "text": "سوره واقع می‌خونیم. می‌خوایم فقیر نشیم هر شب بخونیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 439.22,
   "end": 442.9,
   "text": "بفرمایید. خب در اون آیه‌ش چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 442.9,
   "end": 447.14,
   "text": "این چی بود؟ چگونه می‌خواد نردبان بشه برای صعود ما به سمت حضرات حق؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 447.14,
   "end": 450.7,
   "text": "همین فقط به طمع ثواب که با یه گناه هم بپره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 450.7,
   "end": 453.3,
   "text": "ادامه آیه هم بخونم. «قل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 453.3,
   "end": 458.88,
   "text": "أف اتخذتم أف اتخذتم من دونه أولياء»",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 458.88,
   "end": 462.04,
   "text": "بهشون بگو اگر شما به جز خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 462.04,
   "end": 467.64,
   "text": "ولی‌ای برای خودتون اتخاذ کردید «لا یملك أولئك لأنفسهم نفعا ولا ضرا»",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 467.64,
   "end": 471.9,
   "text": "اینا در هیچ نفع و ضرری هیچ تملکی ندارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 471.9,
   "end": 479.7,
   "text": "بیچاره این‌هایی که شما سر تعظیم در برابرشون فرود میارید که الان برای ما خیلیا مصادیق شده دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 479.7,
   "end": 483.86,
   "text": "میگه اول خدا، دوم فلان دکتر یا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 483.86,
   "end": 486.7,
   "text": "خدا. آقای مدیر اگه شما نبودید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 486.7,
   "end": 489.7,
   "text": "اینا همش شرکه. اینا همش همینا، همینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 489.7,
   "end": 491.88,
   "text": "همین «من دون الله أولياء»",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 491.88,
   "end": 494.69,
   "text": "ولی گرفته کسی رو به جز خدا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 494.69,
   "end": 497.16,
   "text": "خدا و خدا و خدا. تمام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 497.16,
   "end": 500.74,
   "text": "اینام شعون حقن. «قل» باز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 500.74,
   "end": 506.24,
   "text": "تصریح می‌کنه. بهشون بگو «هل يستوي الأعمى والبصير» آیا کور با بینا یکی‌ان؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 506.24,
   "end": 508.58,
   "text": "«أم هل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 508.58,
   "end": 510.72,
   "text": "تستوي الظلمات والنور»",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 510.72,
   "end": 512.38,
   "text": "آیا ظلمت و نور یکی‌ان؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 512.38,
   "end": 515.22,
   "text": "آقای قرائتی در تفسیر نورش می‌فرماید:",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 515.22,
   "end": 518.5,
   "text": "دیگه کار رو به جایی می‌رسونه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 518.5,
   "end": 522.66,
   "text": "که می‌فرماید کسی که چشمش رو به روی حق بسته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 522.66,
   "end": 526.26,
   "text": "مثل کوره. مثل کسیه که تو ظلمت قرار گرفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 526.26,
   "end": 529.74,
   "text": "میگه آقا چشمتو باز کن ببین آیا نور و ظلمت یکیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 529.74,
   "end": 532.38,
   "text": "آیا کور و بینا یکی‌ان؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 532.38,
   "end": 534.3,
   "text": "آخه با چه زبانی خدا به تو بفهمونه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 534.3,
   "end": 541.12,
   "text": "«أم جعلوا لله شركاء خلقوا كخلقه فتشابه الخلق عليهم»",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 541.12,
   "end": 545.88,
   "text": "آیا فکر کردید که اینها خلق می‌تونن بش- مش- مشابه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 545.88,
   "end": 548.96,
   "text": "شبیه به حضرات حق دست به خلقت بگیرن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 548.96,
   "end": 551.88,
   "text": "دست به خلقت بزنن؟ چیزی رو ایجاد کنن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 551.88,
   "end": 554.64,
   "text": "مگه تو خودت انشای حق نیستی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 554.64,
   "end": 556.84,
   "text": "بعد بحثو جمع می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 556.84,
   "end": 558.74,
   "text": "دیگه کار رو تمام می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 558.74,
   "end": 561.3,
   "text": "چقدر عالی. اصلاً سیاق آیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 561.3,
   "end": 563.68,
   "text": "تن آدم رو می‌لرزونه خدا شاهده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 563.68,
   "end": 566.42,
   "text": "توحید افعالی می‌باره از کلمه کلمه آیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 566.42,
   "end": 571.86,
   "text": "«قل الله» بازم بهشون بگو الله «خالق كل شيء»",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 571.86,
   "end": 575.52,
   "text": "خالق هر چیزی‌ایست. از تو بگیر تا یک مورچه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 575.52,
   "end": 579.48,
   "text": "«وهو الواحد القهار»",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 579.48,
   "end": 583.3,
   "text": "انقدر خدا اینجا، این تعبیر بنده‌ست‌ها ببخشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 583.3,
   "end": 587.12,
   "text": "انقدر خدا که از نه غیرت ربوبیتش می‌جوشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 587.12,
   "end": 590.78,
   "text": "با دو اسم واحد و قهار جمع می‌کنه بحث رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 590.78,
   "end": 596.62,
   "text": "علامه حسن زاده روحش شاد فرمودن اگر اسم الواحد با القهار با هم جمع شه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 596.62,
   "end": 599.12,
   "text": "واحدیت کفرات، کثرت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 599.12,
   "end": 603.44,
   "text": "واحدیت با القهار جمع شه بوی احدیت می‌ده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 603.44,
   "end": 606.16,
   "text": "یعنی که ام ne خدا میگه من، منم و لا غیر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 606.16,
   "end": 608.7,
   "text": "والسلام. خیلی هر حرف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 608.7,
   "end": 611.7,
   "text": "سنگینه. خیلی آیه، آیه عجیبیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 611.7,
   "end": 614.14,
   "text": "من خدا شاهده مو به تنم سیخ شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 614.14,
   "end": 618.92,
   "text": "خیلی آیه عجیبیه. اللهم بارک لمولانا صاحب الزمان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 618.92,
   "end": 620.84,
   "text": "والحمد لله رب العالمين.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 620.84,
   "end": 626.74,
   "text": "صلوات ختم. الله- اللهم صل على محمد و آل محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}