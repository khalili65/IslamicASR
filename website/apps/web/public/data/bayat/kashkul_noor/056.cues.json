 "chapters": [
  {
   "index": 0,
   "title": "## میلاد زینب و روایت واحد و اثنان",
   "start": 17.6,
   "end": 113.34
  },
  {
   "index": 1,
   "title": "## غلام دون البلوغ و معیار دوستی",
   "start": 113.34,
   "end": 195.74
  },
  {
   "index": 2,
   "title": "## ما رأیت إلا جمیلا",
   "start": 195.74,
   "end": 399.12
  },
  {
   "index": 3,
   "title": "## زینت بابا و زینت بلا",
   "start": 399.12,
   "end": 724.5
  },
  {
   "index": 4,
   "title": "## زینت در خانه و میدان",
   "start": 724.5,
   "end": 796.4
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 1.18,
   "end": 6.28,
   "text": "صلوات على محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 6.28,
   "end": 9.38,
   "text": "بسم الله الرحمن الرحیم و به این استعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 9.38,
   "end": 13.5,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 13.5,
   "end": 17.6,
   "text": "آیاته. سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 17.6,
   "end": 22.08,
   "text": "روز میلاد با عظمت حضرت زینب سلام الله علیها است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 22.08,
   "end": 28.42,
   "text": "تبریک عرض می‌کنم محضر امام عصر عزیزمون و همه شما محبین حضرت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 28.42,
   "end": 33.36,
   "text": "چون بحث ما پیرامون توحید افعالی بود هر روز،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 33.36,
   "end": 37.36,
   "text": "یه روایتی رو تقدیم می‌کنم ببینید نگاه، سلام علیکم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 37.36,
   "end": 46.3,
   "text": "نگاه بی بی عالم حضرت زینب سلام الله علیها در وادی توحید چگونه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 46.3,
   "end": 52.32,
   "text": "در مستدرک الوسائل، جلد پونزده، صفحه دویست و پانزده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 52.32,
   "end": 55.5,
   "text": "قیل یعنی گفته شده که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 55.5,
   "end": 59.6,
   "text": "لما کان العباس و زینب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 59.6,
   "end": 64.68,
   "text": "ولدی علی علیه السلام صغیرین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 64.68,
   "end": 71.32,
   "text": "حضرت ابالفضل و حضرت زینب که فرزندان امیرالمؤمنین بودند، کوچولو بودند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 71.32,
   "end": 74.54,
   "text": "خب حالا اینجا بعد سؤال پیش میاد که پس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 74.54,
   "end": 80.08,
   "text": "حضرت ام البنین کی حضرت امیرالمؤمنین باهاش ازدواج کرده بوده که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 80.08,
   "end": 82.86,
   "text": "اینها هر دو کوچک بودند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 82.86,
   "end": 90.7,
   "text": "منظور از این صغیرین نه اینکه خیلی بچه بودند چون بالاخره فاصله سنی حضرت زینب با حضرت ابالفضل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 90.7,
   "end": 96.64,
   "text": "تا حدودی طوری بوده که یعنی حضرت ابالفضل بچه باشه حضرت زینب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 96.64,
   "end": 99.12,
   "text": "نوجوان باشه، به این شکل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 99.12,
   "end": 106.1,
   "text": "منظور اینه که هنوز به اون شکل رشد آنچنانی نرسیده بودند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 106.1,
   "end": 110.64,
   "text": "یا به عبارتی میشه گفت ازدواج نکرده بودند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 110.64,
   "end": 113.34,
   "text": "البته این روایتی که الان من می‌خونم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 113.34,
   "end": 120.2,
   "text": "در خصوص حضرت زینب سلام الله علیها هم فقط حضرت زینب به جز حضرت عباس هم وارد شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 120.2,
   "end": 122.88,
   "text": "می‌تونه اون روایت درست باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 122.88,
   "end": 125.38,
   "text": "حالا مضمون روایت برای ما مهمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 125.38,
   "end": 129.88,
   "text": "قال علی للعباس به فرزندش ابالفضل،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 129.88,
   "end": 132.4,
   "text": "امیرالمؤمنین فرمود قل واحد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 132.4,
   "end": 134.94,
   "text": "بگو واحد. بگو یک.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 134.94,
   "end": 139.24,
   "text": "تمرین می‌خوان یاد بدن اعداد رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 139.24,
   "end": 144.22,
   "text": "فقال واحد. ابالفضل بلادرنگ فرمودند که عرض کردند واحد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 144.22,
   "end": 148.08,
   "text": "فقال قل اثنان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 148.08,
   "end": 151.0,
   "text": "امیرالمؤمنین حالا می‌خواد دو رو یاد بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 151.0,
   "end": 154.52,
   "text": "گفت عباس جان بگو دو. قال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 154.52,
   "end": 160.98,
   "text": "استحي ان اقول باللسان الذي قلت واحد اثنان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 160.98,
   "end": 167.6,
   "text": "الله اکبر. حضرت ابالفضل عرض کرد بابا من حیا می‌کنم با لسانی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 167.6,
   "end": 170.96,
   "text": "گفتم واحد بگم اثنان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 170.96,
   "end": 175.8,
   "text": "بحث توحیده. لسانی که میگه یک دیگه دو نمیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 175.8,
   "end": 180.0,
   "text": "ببینید حتی آموزش اعدادشون هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 180.0,
   "end": 184.16,
   "text": "عجین با مبحث توحیده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 184.16,
   "end": 194.4,
   "text": "اینقدر امیرالمؤمنین تحت تاثیر قرار گرفت که فقبل علیه السلام عینيه وسط دو تا چشم ابالفضل رو بوسید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 194.4,
   "end": 196.42,
   "text": "ثم التفت الى زينب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 196.42,
   "end": 199.4,
   "text": "بعد رو کرد به حضرت زینب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 199.4,
   "end": 202.9,
   "text": "و كانت على يساره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 202.9,
   "end": 205.12,
   "text": "و العباس عن يمینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 205.12,
   "end": 210.78,
   "text": "یعنی حضرت ابالفضل سمت راست آقا بود، حضرت زینب سمت چپشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 210.78,
   "end": 215.52,
   "text": "فقالت يا أبت أتحبنا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 215.52,
   "end": 217.5,
   "text": "حالا فقالت يا أبت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 217.5,
   "end": 219.38,
   "text": "أتحبنا کی داره میگه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 219.38,
   "end": 225.54,
   "text": "حضرت زینب. به باباش میگه بابا أتحبنا آیا ما رو دوست داری؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 225.54,
   "end": 229.72,
   "text": "قال نعم يا بنية أولادنا أكبادنا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 229.72,
   "end": 231.84,
   "text": "بله دخترم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 231.84,
   "end": 237.22,
   "text": "فرزندم. فرزندان ما جگرگوشه‌های ما هستند، جگر ما هستند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 237.22,
   "end": 240.22,
   "text": "أولادنا أكبادنا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 240.22,
   "end": 242.54,
   "text": "فقالت يا أبت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 242.54,
   "end": 245.9,
   "text": "الله اکبر. این فرمایشو ببینید چقدر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 245.9,
   "end": 252.58,
   "text": "بوی توحید می‌ده. حضرت زینب سلام الله علیها به باباش امیرالمؤمنین داره می‌فرماید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 252.58,
   "end": 258.18,
   "text": "يا أبت حبان لا يجتمعان في قلب المؤمن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 258.18,
   "end": 266.98,
   "text": "بابا دو تا حب، دو تا دوستی و دو تا عشق با هم جمع نمی‌شه تو یه دل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 266.98,
   "end": 269.82,
   "text": "حب الله و حب الأولاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 269.82,
   "end": 273.78,
   "text": "نمی‌شه این دو تا با هم توی دل جمع شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 273.78,
   "end": 278.36,
   "text": "تجزیه حضرت زینب رو تو وادی توحید ببینید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 278.36,
   "end": 281.54,
   "text": "و إن كان لا بد لنا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 281.54,
   "end": 284.68,
   "text": "قطعاً این شکلیه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 284.68,
   "end": 286.98,
   "text": "لا بد لنا فشفق،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 286.98,
   "end": 289.82,
   "text": "فشفقت لنا. اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 289.82,
   "end": 292.12,
   "text": "قسمتی که از دل شما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 292.12,
   "end": 297.42,
   "text": "به ما اختصاص پیدا کرده دلسوزیه و شفقت لنا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 297.42,
   "end": 301.36,
   "text": "این دلسوزی عاطفه شما نسبت به ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 301.36,
   "end": 304.98,
   "text": "و الحب لله خالصاً.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 304.98,
   "end": 308.58,
   "text": "اون حب، اون شدت حب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 308.58,
   "end": 311.94,
   "text": "لله خالصاً قطعاً فقط مال خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 311.94,
   "end": 314.64,
   "text": "خالصاً. خالصاً مخلصاً لله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 314.64,
   "end": 323.4,
   "text": "مال خداست. حالا اونچه که به ما اولاد شما که میگی ما رو دوست داری تعلق می‌گیره، شفقت شماست، دلسوزی شماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 323.4,
   "end": 326.94,
   "text": "الله اکبر که فزاد علیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 326.94,
   "end": 334.78,
   "text": "السلام بهما حباً. میگن از حالت امیرالمؤمنین متوجه شدن که شدت محبت پیدا کرد به این دو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 334.78,
   "end": 337.7,
   "text": "و از این رفتارشون از حضرت ابالفضل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 337.7,
   "end": 339.76,
   "text": "و حضرت زینب سلام الله علیها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 339.76,
   "end": 342.92,
   "text": "نگاه توحیدی رو ببین. کدوم بچه میاد آخه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 342.92,
   "end": 346.84,
   "text": "با باباش یه همچین تجزیه تحلیلی بکنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 346.84,
   "end": 352.0,
   "text": "الله اکبر. اینها پرورش یافته دستگاه نبوت‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 352.0,
   "end": 355.54,
   "text": "السلام علیک یا اهل بیت نبوة دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 355.54,
   "end": 358.28,
   "text": "اهل بیت نبوت‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 358.28,
   "end": 361.96,
   "text": "شوخی نیست، اهل بیت رسالت‌اند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 361.96,
   "end": 366.4,
   "text": "پرورش یافته‌ی توحیدن، دامان توحیدن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 366.4,
   "end": 369.16,
   "text": "و الا اصلا محاله یه بچه یا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 369.16,
   "end": 376.34,
   "text": "حتی بگو جوان اصلا این چنین حرف زدن ازش مگر در روادید تربیت توحیدی میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 376.34,
   "end": 379.4,
   "text": "و الا یه جوان، یه نوجوان چه میفهمه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 379.4,
   "end": 382.74,
   "text": "این حرفا چه حالیش؟ میره دنبال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 382.74,
   "end": 386.12,
   "text": "چیپس و پفکش. میره دنبال دلبستگی‌های دنیایش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 386.12,
   "end": 391.02,
   "text": "محال جذباتش. حتی من روایاتی می‌دیدم بررسی می‌کردم خیلی برام شیرین بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 391.02,
   "end": 393.46,
   "text": "بچه‌هایی که زمان پیغمبر،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 393.46,
   "end": 395.74,
   "text": "پیغمبر رو درک کرده بودند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 395.74,
   "end": 400.72,
   "text": "اصلا نفسشون تو زمان پیغمبر و مأنوس با پیغمبر بوده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 400.72,
   "end": 403.62,
   "text": "چگونه نگاه‌های توحیدی پیدا می‌کردند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 403.62,
   "end": 408.18,
   "text": "من یه نمونه‌شو در بحث لقاء الله از یا زهراي شرق گفته بودم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 408.18,
   "end": 410.54,
   "text": "الان براتون بگویم بخوانم خودتون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 410.54,
   "end": 412.6,
   "text": "قضاوت کنید. ببینید یه بچه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 412.6,
   "end": 420.18,
   "text": "زیر سن بلوغ چون تو روایت تأ-تأکید می‌کنه زیر سن بلوغ با پیغمبر چگونه صحبت می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 420.18,
   "end": 423.52,
   "text": "این یعنی رایحه و این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 423.52,
   "end": 432.1,
   "text": "شم ولایت و توحید از ناحیه نبوت بهش اصابت کرده و الا محال همچین نگاهی پیدا کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 432.1,
   "end": 434.96,
   "text": "ارشاد القلوب، صفحه صد و شصت و سه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 434.96,
   "end": 437.34,
   "text": "کامتون شیرین بشه با این روایت و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 437.34,
   "end": 439.84,
   "text": "هدیه ما امروز به شما این دو روایت باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 439.84,
   "end": 445.18,
   "text": "روی انه صلی الله علیه و آله و سلم غلام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 445.18,
   "end": 448.92,
   "text": "دون البلوغ. می‌فرماید که روایت شده که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 448.92,
   "end": 451.8,
   "text": "یه غلام دون البلوغ یعنی چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 451.8,
   "end": 457.04,
   "text": "یعنی زیر سن بلوغ. یه بچه زیر سن بلوغ برخورد کرد به پیغمبر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 457.04,
   "end": 462.32,
   "text": "و بشره. خیلی خوشحال شد تا پیغمبر رو دید بشره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 462.32,
   "end": 465.98,
   "text": "الان مثلا بچه‌های ما یه آخوند می‌بینن چجوری میشن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 465.98,
   "end": 470.48,
   "text": "حالشون چجوری میشه؟ دگرگون میشن، می‌ترسن، خوشحال میشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 470.48,
   "end": 476.48,
   "text": "حالا خیلی جالبه من بعضی موقع‌ها تو خیابون میرم این بچه‌ها یهو چادر مادرشونو میگن مامان، مامان، مامان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 476.48,
   "end": 478.1,
   "text": "منو دارن نگاه می‌کنن با یه تعجب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 478.1,
   "end": 479.98,
   "text": "من گوش میدم ببینم چی میخواد بگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 479.98,
   "end": 482.74,
   "text": "میگه امام خمینی، امام خمینی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 482.74,
   "end": 484.62,
   "text": "ما رو نشون میدن میگن امام خمینی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 484.62,
   "end": 488.54,
   "text": "بعد خیلی براشون جالبه مثلا ما رو می‌بینن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 488.54,
   "end": 492.8,
   "text": "و بشره و تبسم فرحا بالنبی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 492.8,
   "end": 497.92,
   "text": "و خیلی متبسم شد و خوشحال شد از دیدن پیغمبر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 497.92,
   "end": 503.38,
   "text": "فقال له اتحبنی یا فتی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 503.38,
   "end": 506.72,
   "text": "پیغمبر به اون بچه گفتش که ای جوان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 506.72,
   "end": 508.48,
   "text": "آیا دوست داری منو؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 508.48,
   "end": 512.52,
   "text": "اتحبنی یا فتی. ای جوان منو دوست داری؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 512.52,
   "end": 515.7,
   "text": "فقال ای والله یا رسول الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 515.7,
   "end": 519.54,
   "text": "انگار که بگه آره به خدا، به خدا قسم شما رو دوست دارم یا رسول الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 519.54,
   "end": 523.3,
   "text": "فقال له مثل عينک.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 523.3,
   "end": 526.6,
   "text": "مثل دو تا چشات منو دوست داری؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 526.6,
   "end": 530.56,
   "text": "فقال اکثر. اون بچه گفت نه بیشتر، بیشتر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 530.56,
   "end": 533.82,
   "text": "فقال مثل ابیک. مثل بابات منو دوست داری؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 533.82,
   "end": 537.4,
   "text": "فقال اکثر. باز پیغمبر گفت مثل بابات؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 537.4,
   "end": 540.56,
   "text": "نه بیشتر. فقال مثل امک.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 540.56,
   "end": 543.12,
   "text": "مثل مادرت؟ گفت فقال اکثر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 543.12,
   "end": 546.08,
   "text": "نه بیشتر. یا رسول الله بیشتر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 546.08,
   "end": 551.96,
   "text": "فقال مثل نفسك. آیا منو مثل نفس، مثل جان خودت دوست داری؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 551.96,
   "end": 554.36,
   "text": "فقال اکثر والله یا رسول الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 554.36,
   "end": 558.06,
   "text": "باز قسم لفظ جلالی الله خورد که نه بیشتر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 558.06,
   "end": 560.38,
   "text": "از خودمم شما رو بیشتر دوست دارم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 560.38,
   "end": 563.18,
   "text": "حالا اینجا زده تو خال دیگه. سؤال رو ببینید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 563.18,
   "end": 565.18,
   "text": "خیلی پیغمبر زیرک بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 565.18,
   "end": 570.38,
   "text": "فقال می‌خواد عیار توحید این بچه رو بسنجه یا به دیگران",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 570.38,
   "end": 572.86,
   "text": "به چشم دیگران بکشونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 572.86,
   "end": 577.28,
   "text": "فقال مثل ربک.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 577.28,
   "end": 581.76,
   "text": "اونجا مثل، مثل، اینجا مثل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 581.76,
   "end": 587.24,
   "text": "سؤال آورد. آیا مثل پروردگارت؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 587.24,
   "end": 591.82,
   "text": "لحن عوض شده اصلاً. اونجا مثل بابات، مثل مادرت، مثل خودت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 591.82,
   "end": 595.2,
   "text": "اینجا مثل، آیا مثل پروردگارت؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 595.2,
   "end": 599.52,
   "text": "سؤال هشداریه. پرورد-- بعد بچه گفت فقال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 599.52,
   "end": 602.4,
   "text": "الله الله الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 602.4,
   "end": 605.6,
   "text": "سه بار لفظ جلالی الله به کار برد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 605.6,
   "end": 610.66,
   "text": "یا رسول الله ليس هذا لك ولا لأحد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 610.66,
   "end": 614.72,
   "text": "این نه برای شماست، نه برای احدی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 614.72,
   "end": 617.46,
   "text": "اینکه کسی رو با رب یکی بدونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 617.46,
   "end": 620.66,
   "text": "الله اکبر. فإنما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 620.66,
   "end": 623.58,
   "text": "أحببتك لحب الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 623.58,
   "end": 626.86,
   "text": "فإنما هم که حشر این بچه چقدر حالیش بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 626.86,
   "end": 629.22,
   "text": "منحصراً فقط و فقط",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 629.22,
   "end": 634.12,
   "text": "شما رو به خاطر خ-حب خدا دوست دارم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 634.12,
   "end": 636.26,
   "text": "یه بچه زیر سن بلوغ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 636.26,
   "end": 638.32,
   "text": "تو کوچه داره رفت و آمد می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 638.32,
   "end": 641.4,
   "text": "تو محیط نبوت پیغمبر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 641.4,
   "end": 645.7,
   "text": "و ولایت اهل بیت چگونه پرورش پیدا می‌کنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 645.7,
   "end": 648.64,
   "text": "التفت- التفت النبي.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 648.64,
   "end": 652.24,
   "text": "بعد رو کرد به اون کسایی که همراهش بودند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 652.24,
   "end": 655.8,
   "text": "صلی الله علیه و سلم. إلى من كان معه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 655.8,
   "end": 658.68,
   "text": "رو کرد پیغمبر به اونایی که همراهش بودند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 658.68,
   "end": 661.46,
   "text": "وقال حالا میخواد به رخ اونا بکشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 661.46,
   "end": 667.72,
   "text": "هكذا كونوا أحبوا الله لإحسانه إليكم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 667.72,
   "end": 670.64,
   "text": "مثل این باشید، مثل این بچه باشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 670.64,
   "end": 674.46,
   "text": "میشه تا حالا شده کسی بیاد به ما بگه مثل این بچه باش؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 674.46,
   "end": 678.82,
   "text": "مثلا امام عصر ما رو ببینه بگه مثل این بچه باش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 678.82,
   "end": 681.78,
   "text": "به خدا تربیت توحیدی این کارو می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 681.78,
   "end": 686.56,
   "text": "که آقا دوست داره ماها گردن کلفتای معذرت میخوام ریش سفید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 686.56,
   "end": 690.34,
   "text": "مثل یه بچه باشیم. خصلت توحیدیه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 690.34,
   "end": 694.16,
   "text": "هكذا كونوا أحبوا الله لإحسانه إليكم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 694.16,
   "end": 696.82,
   "text": "خدا رو دوست داشته باشید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 696.82,
   "end": 706.02,
   "text": "به خاطر اون احسانی که به شما می‌کنه و نعمه علیكم اون نعمت‌هایی که به شما بخشیده و أحبوني منم دوست داشته باشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 706.02,
   "end": 712.16,
   "text": "اما لحب الله به عشق خدا به خاطر خدا منو دوست داشته باشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 712.16,
   "end": 714.34,
   "text": "اینها رو ببینید. این بچه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 714.34,
   "end": 722.5,
   "text": "حالا این بچه که تو خیابونه، تو محیط ولایت نفس پیغمبر بهش خورده و حالا رفته مسجدی مثلاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 722.5,
   "end": 725.68,
   "text": "خب منبر پیغمبر شاید. ولی حضرت زینب چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 725.68,
   "end": 730.12,
   "text": "که بشه زینت باباش امیرالمؤمنین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 730.12,
   "end": 734.52,
   "text": "یه کسی به جایگاهی برسه که بشه زینت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 734.52,
   "end": 737.12,
   "text": "ولایت کلیه این عالم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 737.12,
   "end": 739.88,
   "text": "شوخی نیست. در همه جهات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 739.88,
   "end": 743.84,
   "text": "نه فقط شجاعتش. در باب توحید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 743.84,
   "end": 750.22,
   "text": "به جایی برسه که اون سیاق عجیبش ترک کربلا که همه می‌دونیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 750.22,
   "end": 755.2,
   "text": "ما رأيت این ما-- اگر می‌فرمود رأيت جميلا من زیبا دیدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 755.2,
   "end": 759.66,
   "text": "خب میشد بگیم خب مثلاً یه بخشو زیبا دید، یه بخشو زیبا ندید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 759.66,
   "end": 762.88,
   "text": "باید سؤال کرد. بیبی جان کجا رو زیبا دیدی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 762.88,
   "end": 765.92,
   "text": "اما ما رأيت إلا جميلا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 765.92,
   "end": 770.24,
   "text": "نفی و اثبات می‌کنه. یعنی هرچی دیدم زیبا دیدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 770.24,
   "end": 773.66,
   "text": "الله اکبر. همه رو جلوی حضرت حق دیده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 773.66,
   "end": 777.06,
   "text": "این شوخی نیست. اینا باید تعلیم داده شه به بچه‌هامون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 777.06,
   "end": 781.04,
   "text": "ان‌شاءالله که هدیه‌های خوب از بیبی جان و از زینب امروز بگیریم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 781.04,
   "end": 785.3,
   "text": "و در رأسش گهکشایی از امر فرج حضرت حجت باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 785.3,
   "end": 788.4,
   "text": "اللهم بارک لمولانا صاحب الزمان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 788.4,
   "end": 790.36,
   "text": "والحمد لله رب العالمين.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 790.36,
   "end": 794.82,
   "text": "صلوات الله. الله محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 794.82,
   "end": 796.4,
   "text": "الله محمد آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}