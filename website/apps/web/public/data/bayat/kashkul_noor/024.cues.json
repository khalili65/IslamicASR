 },
 "chapters": [
  {
   "index": 0,
   "title": "## توحید افعالی در رسالهٔ الولایه",
   "start": 19.74,
   "end": 42.54
  },
  {
   "index": 1,
   "title": "## کمال الانسان؛ فنا به سه قسم",
   "start": 42.54,
   "end": 223.34
  },
  {
   "index": 2,
   "title": "## التوحید الفعلی والاسمی والذاتی؛ لابد ان یعبر",
   "start": 223.34,
   "end": 243.64
  },
  {
   "index": 3,
   "title": "## نخستین در؛ مثال پرده",
   "start": 243.64,
   "end": 498.66
  },
  {
   "index": 4,
   "title": "قرآن همان توحید افعالی را می‌گوید:",
   "start": 498.66,
   "end": 544.04
  },
  {
   "index": 5,
   "title": "## نمونه‌های رهبری؛ ان الله معنا",
   "start": 544.04,
   "end": 611.58
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.14,
   "end": 4.46,
   "text": "و آل محمد اجله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 4.46,
   "end": 9.38,
   "text": "بسم الله الرحمن الرحیم و به این استعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 9.38,
   "end": 13.58,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 13.58,
   "end": 19.74,
   "text": "آیات. سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 19.74,
   "end": 24.84,
   "text": "ادامه بحث تجلیات الهیه رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 24.84,
   "end": 28.02,
   "text": "در بطن و در دل موضوع توحید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 28.02,
   "end": 33.58,
   "text": "عرض می‌کردیم. که رسیدیم به مرحله‌ی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 33.58,
   "end": 36.44,
   "text": "توحید افعالی که اولین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 36.44,
   "end": 41.24,
   "text": "مرتبه از سه رتبه‌ی توحیده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 41.24,
   "end": 46.32,
   "text": "داشتیم فرمایش علامه طباطبایی علیه الرحمة و الرضوان رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 46.32,
   "end": 51.04,
   "text": "بررسی می‌کردیم. امروز هم اجازه بدید که از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 51.04,
   "end": 55.78,
   "text": "رسالت الولایه صفحه دویست و نود و چهار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 55.78,
   "end": 59.22,
   "text": "از ایشون موضوعی رو انتخاب کردم بخونیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 59.22,
   "end": 65.28,
   "text": "قد عرفت فرمود به تحقیق فهمیدی، دانستی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 65.28,
   "end": 67.74,
   "text": "متوجه شدی که ان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 67.74,
   "end": 74.28,
   "text": "کمال الانسان همه ما به دنبال کمال باید بریم دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 74.28,
   "end": 81.58,
   "text": "یعنی اگر کسی به دنبال کمال نره خودش رو ضایع کرده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 81.58,
   "end": 89.26,
   "text": "و توچا-دچار عجب و تکبر و خودشیفتگی و این‌ها شاید شده گمان کرده که ناقص نیست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 89.26,
   "end": 93.14,
   "text": "کامله که به سمت کمال نمیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 93.14,
   "end": 99.48,
   "text": "همه ما اگر عقل درست، حسابی و سلیمی داشته باشیم باید بریم به سمت کمال.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 99.48,
   "end": 103.52,
   "text": "حالا اینجا حضرت علامه می‌فرماید که تو اینو فهمیدی که،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 103.52,
   "end": 107.82,
   "text": "یعنی من برای تو به گونه‌ای سخن گفتم که اینو متوجه شدی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 107.82,
   "end": 109.66,
   "text": "ان کمال الانسان چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 109.66,
   "end": 113.6,
   "text": "حالا کمال انسان چیه که تو باید به سمتش بری؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 113.6,
   "end": 117.6,
   "text": "فناه به اقسام ثلاثة.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 117.6,
   "end": 121.54,
   "text": "کمال انسان فنای اوست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 121.54,
   "end": 126.52,
   "text": "به سه قسم. یعنی ما باید بریم، هیچ چاره‌ای نداریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 126.52,
   "end": 132.02,
   "text": "اگر می‌خوایم به سمت کمال بریم باید به سمت این سه نوع فنا حرکت کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 132.02,
   "end": 138.3,
   "text": "یعنی اگر نماز شب بخونیم، نماز بخونیم، قرآن بخونیم، عبادت کنیم، جهاد کنیم، صدقه بدیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 138.3,
   "end": 141.02,
   "text": "زیارت بریم، بکشیم خودمون رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 141.02,
   "end": 145.1,
   "text": "تو این وادی اما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 145.1,
   "end": 150.02,
   "text": "ما به این سه تا فنا نرسیم این کمال نبوده برای ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 150.02,
   "end": 154.06,
   "text": "باید این‌ها ما رو به این کمال، سه تا کمال برسونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 154.06,
   "end": 156.6,
   "text": "و الا همون‌ها دلیل بر نقص ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 156.6,
   "end": 163.84,
   "text": "کسی که نماز می‌خونه معجب می‌شه، گمان می‌کنه خبری و کاری انجام داده و چیزی شده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 163.84,
   "end": 169.0,
   "text": "این اصلاً اتصال به الهیت نظام نداشته نمازش و خودش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 169.0,
   "end": 173.66,
   "text": "اصلاً تعطیله. برای همین اصلاً اسلام در ظاهر نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 173.66,
   "end": 175.9,
   "text": "این ظاهر البته باید حفظ بشه و باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 175.9,
   "end": 178.3,
   "text": "پوسته دین، شریعت دین باید باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 178.3,
   "end": 182.92,
   "text": "اما به قول شهید مطهری اسلام در اندیشه‌ها خوابیده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 182.92,
   "end": 184.58,
   "text": "تو به چه نیتی نماز خوندی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 184.58,
   "end": 188.46,
   "text": "اصلاً چرا نماز خوندی؟ دنبال چی هستی که نماز خوندی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 188.46,
   "end": 192.36,
   "text": "اصلاً این نمازی که خوندی رو از خودت می‌دونی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 192.36,
   "end": 194.64,
   "text": "یا توفیق من الله،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 194.64,
   "end": 200.08,
   "text": "توفیقش از حضرت حقه به حول و قوه الهیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 200.08,
   "end": 205.46,
   "text": "پس هیچ چاره‌ای نیست. تا اینجا اینو متوجه می‌شیم که عزیزان دلم این حرفا رو شوخی نگیریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 205.46,
   "end": 208.28,
   "text": "اصلاً چاره‌ای نیست، گریزی ازش نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 208.28,
   "end": 211.46,
   "text": "الا ولابد ما باید بریم به این سمت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 211.46,
   "end": 215.3,
   "text": "یعنی نماز ما باید بوی فنا بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 215.3,
   "end": 217.48,
   "text": "عبادات ما باید بوی فنا بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 217.48,
   "end": 223.18,
   "text": "اگه نمیده یه گیری هست، یه اشکالی به قضیه وارده باید اون برطرف شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 223.18,
   "end": 231.26,
   "text": "و به عبارت اخری یعنی به عبارت دیگری التوحید حالا اون سه گانه توحید یا فنا رو داره حضرت علامه توضیح میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 231.26,
   "end": 234.24,
   "text": "التوحید الفعلي توحید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 234.24,
   "end": 238.24,
   "text": "افعالی که عرض کردیم. والاسمی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 238.24,
   "end": 241.28,
   "text": "والذاتی. فالانسان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 241.28,
   "end": 245.52,
   "text": "فی سیره الی الحق سبحانه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 245.52,
   "end": 248.52,
   "text": "باز تاکید می‌کنم حواست باشه‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 248.52,
   "end": 256.08,
   "text": "که انسان در سیرش به سمت حضرت حق که و انا الیه راجعون قراره ما رجعت کنیم بریم به سمت حضرت حق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 256.08,
   "end": 260.1,
   "text": "این سیر رو می‌فرماید لابد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 260.1,
   "end": 262.06,
   "text": "بد یعنی لازم. چاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 262.06,
   "end": 268.84,
   "text": "چاره‌ی لازم. اونجایی که خدای منان به حضرت موسی علی نبينا و آله و علیه الصلاة والسلام فرمود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 268.84,
   "end": 272.24,
   "text": "انا بدک اللازم یا موسی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 272.24,
   "end": 277.62,
   "text": "بدک. یعنی من اصلاً چاره‌ی لازم توام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 277.62,
   "end": 280.26,
   "text": "من-- اصلاً نمی‌تونی منو برداری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 280.26,
   "end": 285.42,
   "text": "چاره‌ی لازم تو منم. اصلاً منو برداری خودت برداشته شدی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 285.42,
   "end": 289.9,
   "text": "اینجا می‌فرماید لابد. بد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 289.9,
   "end": 292.26,
   "text": "چاره. لابد یعنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 292.26,
   "end": 295.16,
   "text": "ناچاریم. اصلاً از این گریزی ازش نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 295.16,
   "end": 300.16,
   "text": "هیچ چاره‌ی دیگه‌ای نیست. در سیر به سمت حضرت حق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 300.16,
   "end": 304.54,
   "text": "لابد علامه می‌فرماید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 304.54,
   "end": 307.3,
   "text": "لابد ای عبر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 307.3,
   "end": 310.76,
   "text": "یا بله ای عبر بله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 310.76,
   "end": 316.7,
   "text": "ای عبر من جميع مراتب الافعال والاسما والذوات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 316.7,
   "end": 320.92,
   "text": "حتی ینال توحیدات الثلاثه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 320.92,
   "end": 324.08,
   "text": "فرمود هیچ چاره‌ای نیست که عبور کنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 324.08,
   "end": 329.58,
   "text": "از جميع مراتب کمال یا از جميع مراتب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 329.58,
   "end": 333.36,
   "text": "توحید که توحید افعالی بود و اسمایی و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 333.36,
   "end": 335.58,
   "text": "ذاتی. اصلاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 335.58,
   "end": 342.04,
   "text": "علامه طباطبایی، استاد علامه حسن زاده علیهم الرحمة داره تاکید می‌کنه هیچ چاره‌ای نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 342.04,
   "end": 346.6,
   "text": "دنبال چیز دیگه‌ای نرو. اگه کسی اینا رو تعطیل کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 346.6,
   "end": 348.18,
   "text": "بگه آقا این حرفا چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 348.18,
   "end": 352.28,
   "text": "نمازمونو بخونیم بریم. این حرف‌ها آدمو دیوونه می‌کنه، خول می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 352.28,
   "end": 357.28,
   "text": "خیلیا این حرفا می‌زنن. ول کن بابا این حرفا چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 357.28,
   "end": 359.04,
   "text": "خولی میری سراغ این چیزا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 359.04,
   "end": 361.9,
   "text": "فکرت رو درگیر می‌کنی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 361.9,
   "end": 365.34,
   "text": "این اصلاً از کمال بهره‌ای نبرده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 365.34,
   "end": 369.7,
   "text": "این اصلاً وارد محیط تو-- و وادی توحید نشده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 369.7,
   "end": 372.44,
   "text": "حتی در آن ابتداییات‌ش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 372.44,
   "end": 377.86,
   "text": "که اینو دارم تأکید می‌کنم که بزرگانی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 377.86,
   "end": 381.56,
   "text": "حقایق رو چشیدن و بهش رسیدن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 381.56,
   "end": 385.12,
   "text": "زبان حالشون برای امثال ما چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 385.12,
   "end": 389.46,
   "text": "چرا ما در جا بزنیم تو این مسیر؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 389.46,
   "end": 393.92,
   "text": "حالا بعد این از این قسمت که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 393.92,
   "end": 398.1,
   "text": "حضرت اعلا می‌فرمایند. یه جای دیگه هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 398.1,
   "end": 400.7,
   "text": "هستش که اولین دری که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 400.7,
   "end": 405.02,
   "text": "از عوالم توحیدی، حالا می‌خوای به سمت توحید حرکت کنی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 405.02,
   "end": 411.02,
   "text": "اولین وادی‌ای که وارد می‌شی، اولین دری که به روت گشوده می‌شه چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 411.02,
   "end": 416.08,
   "text": "اولین دری که از عوالم توحیدی به روی سالک باز می‌شود توحید افعالی است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 416.08,
   "end": 422.36,
   "text": "یعنی می‌بیند که افعالی، این داره توضیح میده که حالا این توحید افعالی یعنی چی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 422.36,
   "end": 429.12,
   "text": "می‌بیند افعالی که در عالم به مخلوق نسبت می‌داده به حق سبحانه و انتساب داشته است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 429.12,
   "end": 432.2,
   "text": "اینو می‌بینه، نه علم فکری‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 432.2,
   "end": 435.12,
   "text": "می‌بینه که هر فعلی رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 435.12,
   "end": 438.94,
   "text": "سر می‌زنه در این عالم انتسابش به حضرته حقه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 438.94,
   "end": 447.1,
   "text": "اینو می‌بینه، می‌چشش. مانند این که کسی در پشت پرده‌ای قرار گرفته، مثال رو ببین چقدر زیباست، چقدر واضح.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 447.1,
   "end": 454.9,
   "text": "مثال رو دقت کنید. مانند کسی که در پشت پرده‌ای قرار گرفته باشد و پرده را تکان دهد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 454.9,
   "end": 458.64,
   "text": "که صورتاً حرکت به پرده استناد داده می‌شود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 458.64,
   "end": 464.6,
   "text": "ولی واقعاً حرکت دهنده کسی‌ست که در پشت پرار-- پرده قرار گرفته است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 464.6,
   "end": 468.4,
   "text": "و آن را تکان می‌دهد. سالک به جایی می‌رسد که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 468.4,
   "end": 471.14,
   "text": "پرده‌دار را می‌بیند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 471.14,
   "end": 474.6,
   "text": "توجه کردی؟ نه پرده رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 474.6,
   "end": 477.82,
   "text": "کسی که داره پشت پرده، پرده رو تکون میده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 477.82,
   "end": 483.28,
   "text": "اون داره تکون میده دیگه. تو فکر می‌کنی پرده داره خودش به خودی خود تکون می‌خوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 483.28,
   "end": 485.86,
   "text": "در صورتی که کسی دیگه اون پشته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 485.86,
   "end": 489.76,
   "text": "لا حول و لا قوه الا بالله العلی العظیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 489.76,
   "end": 495.16,
   "text": "هیچ حول و قوه‌ای نیست. حالا ما اصابک من حسنه فمن الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 495.16,
   "end": 497.9,
   "text": "قرآن این همون توحید افعالیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 497.9,
   "end": 501.46,
   "text": "قرآن می‌فرماید مطلقاً هر حسنه ای به تو می‌رسه از خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 501.46,
   "end": 505.66,
   "text": "تمام شد. دیگه چه عجبی، چه خودشیفتگی‌ای.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 505.66,
   "end": 508.8,
   "text": "از اون طرف میگه هر-- ما اصابک من",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 508.8,
   "end": 510.6,
   "text": "حس-- سیئه فمن نفسک.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 510.6,
   "end": 513.12,
   "text": "هرچی بدیه از نفس خودته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 513.12,
   "end": 518.48,
   "text": "البته دزد هم میره دزدی می‌کنه به حول و قوه الهی میره دزدی می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 518.48,
   "end": 522.58,
   "text": "اما انتخاب با اوست. ما فقط حق انتخاب داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 522.58,
   "end": 525.52,
   "text": "عبادت کنیم، ثواب انجام بدیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 525.52,
   "end": 528.34,
   "text": "یا گناه والعیاذ بالله معصیت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 528.34,
   "end": 531.76,
   "text": "انتخاب از ماست. حول و قوه از حضرته حقه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 531.76,
   "end": 535.66,
   "text": "یعنی حتی گناه هم به حول و قوه الهیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 535.66,
   "end": 538.9,
   "text": "این اگر به اوج برسه می‌شه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 538.9,
   "end": 541.76,
   "text": "این اگر کسی این رو چشید می‌شه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 541.76,
   "end": 544.04,
   "text": "توحید افعالی. برای مثال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 544.04,
   "end": 548.88,
   "text": "دو تا نمونه من نوشتم همین امروز برای اینکه اشتباه هم عرض نکنم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 548.88,
   "end": 553.62,
   "text": "صحبت رهبر عزیزمون رو دوباره گوش دادم، نوشتم عین صحبت ایشون رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 553.62,
   "end": 558.4,
   "text": "ببینید چقدر قشنگ بوی توحید افعالی میده و برای امروز بسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 558.4,
   "end": 562.44,
   "text": "رهبر عزیزمون تو یه فرمایشی فرمودن بنده می‌دانم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 562.44,
   "end": 566.5,
   "text": "که خدای متعال اراده فرموده است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 566.5,
   "end": 570.12,
   "text": "که این ملت را",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 570.12,
   "end": 573.84,
   "text": "به متعالی‌ترین درجات برساند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 573.84,
   "end": 577.16,
   "text": "خدا می‌خواد برسونه. این یعنی توحید افعالی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 577.16,
   "end": 579.98,
   "text": "نگاه رو ببینید. ید الله فوق ایدیهم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 579.98,
   "end": 587.06,
   "text": "یه جای دیگه فرمودن آیا دست خدا را به وضوح نمی‌شود دید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 587.06,
   "end": 593.2,
   "text": "ملت ایران نمی‌تواند احساس کند که ان الله معنا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 593.2,
   "end": 597.3,
   "text": "نمی‌شه احساس کرد؟ ان الله معنا هم توحید افعالیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 597.3,
   "end": 598.88,
   "text": "یعنی همه چی به دست خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 598.88,
   "end": 603.7,
   "text": "دیگه آدم از چی می‌ترسه؟ ان‌شاءالله این بحث رو ادامه میدیم پخته‌تر بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 603.7,
   "end": 605.5,
   "text": "والحمد لله رب العالمين.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 605.5,
   "end": 607.64,
   "text": "صلوات ختم کنیم. اللهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 607.64,
   "end": 611.58,
   "text": "صل علی محمد و آل محمد و عجل فرجهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}