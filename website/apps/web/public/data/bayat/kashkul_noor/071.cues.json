   "start": 731.78,
   "end": 976.5
  },
  {
   "index": 6,
   "title": "## نیت بزرگ و وسعت بی‌انتهای سفره",
   "start": 976.5,
   "end": 1147.18
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.64,
   "end": 4.28,
   "text": "بسم الله الرحمن الرحیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 4.28,
   "end": 7.5,
   "text": "تبریک عرض می‌کنم ان‌شاءالله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 7.5,
   "end": 10.5,
   "text": "شب اول ماه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 10.5,
   "end": 16.62,
   "text": "مبارک رجب رو. ماهی که پر است از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 16.62,
   "end": 20.18,
   "text": "برکت و رحمت و مغفرت و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 20.18,
   "end": 23.7,
   "text": "عصب دیگه. ریزش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 23.7,
   "end": 32.88,
   "text": "شدید رحمت حضرت حق از امشب آغاز می‌شه و چه زیبا که تقارنش با شب یلدا اونو زیباتر کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 32.88,
   "end": 38.82,
   "text": "بعضیا میان شب یلدا رو هی می‌خوان اسلامیزه کنن، هی می‌خوان یه طوری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 38.82,
   "end": 42.52,
   "text": "یه توجیحاتی بیارن که آره مثلاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 42.52,
   "end": 48.32,
   "text": "در تأیید شب یلدا یه رده پای ازش تو اسلام پیدا کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 48.32,
   "end": 53.08,
   "text": "بد هم نیست اما باید توجه داشت که اساساً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 53.08,
   "end": 55.24,
   "text": "این رسم‌های دیرینه‌ی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 55.24,
   "end": 61.34,
   "text": "ایرانی خیلی جالبه که اصلاً نیازی به توجیه ندارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 61.34,
   "end": 67.22,
   "text": "همه‌شون، همه‌شون برخاسته از اون عرق دینی و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 67.22,
   "end": 74.14,
   "text": "مذهبی ماست. هرچی نگاه می‌کنی می‌بینی که سرتاسر رسم‌های ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 74.14,
   "end": 76.48,
   "text": "عجین شده با معارف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 76.48,
   "end": 79.72,
   "text": "و مبانی دینی ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 79.72,
   "end": 87.88,
   "text": "کدوم آیین انقدر تأکید داره به همدلی، همراهی، هم-همراه هم بودن، کنار هم نشستن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 87.88,
   "end": 92.86,
   "text": "تا جایی که در رساله حقوق امام سجاد صلوات الله علیه می‌فرمود که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 92.86,
   "end": 99.16,
   "text": "اون کسی که کنار دستش می‌شینی ولو لحظاتی گردنت حق میاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 99.16,
   "end": 102.98,
   "text": "کدوم دین و آیین و مذهب یه همچین توصیه‌ای داره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 102.98,
   "end": 107.76,
   "text": "اصلاً ایران، ایران اسلامیه، ایرانی اسلامیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 107.76,
   "end": 111.1,
   "text": "این‌ها از هم انفکاک‌پذیر نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 111.1,
   "end": 115.16,
   "text": "توجه داشته باشیم. این یه نکته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 115.16,
   "end": 118.94,
   "text": "خب صغات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 118.94,
   "end": 123.04,
   "text": "نماز عصر ما امروز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 123.04,
   "end": 127.22,
   "text": "اهh لطفی بود که به شما به عنوان اغر راه تقدیم می‌کنیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 127.22,
   "end": 131.56,
   "text": "برای شب یلداتون شاید به دردتون بخوره عزیزانی که این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 131.56,
   "end": 136.42,
   "text": "صوت رو می‌شنون. اونا هم اینکه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 136.42,
   "end": 138.92,
   "text": "خب شب یلدا چرا شب یلدا شده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 138.92,
   "end": 143.04,
   "text": "به جهت یک دقیقه طولانی‌تر شدنش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 143.04,
   "end": 146.42,
   "text": "این طولانی تر شدن‌ها همه آیات الهی‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 146.42,
   "end": 153.44,
   "text": "اینکه إن فی خلق السماوات والأرض واختلاف الليل والنهار رفت و آمد شب و روز حتی این‌ها،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 153.44,
   "end": 158.1,
   "text": "این یک دقیقه طولانی‌تر شدن هم می‌شه رفت و آمد شب و روز دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 158.1,
   "end": 161.94,
   "text": "یعنی اینکه رفتن شب یه دقیقه دیرتر می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 161.94,
   "end": 165.0,
   "text": "دیرتر میره. واختلاف الليل والنهار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 165.0,
   "end": 169.0,
   "text": "لا آيات لول الألباب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 169.0,
   "end": 171.26,
   "text": "و برای اونایی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 171.26,
   "end": 176.28,
   "text": "مغزشون رو تعطیل نکردن، این‌ها آیه ها و نشانه‌های الهی‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 176.28,
   "end": 181.38,
   "text": "در هر حال شما دقت می‌کنید که اساساً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 181.38,
   "end": 186.48,
   "text": "خود قیامت هم یا آخرت هم یا سفر به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 186.48,
   "end": 190.48,
   "text": "از شود ملاقات خدا هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 190.48,
   "end": 193.2,
   "text": "لقاء الله هم به جهت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 193.2,
   "end": 199.74,
   "text": "طولانی‌تر بودنش نسبت به مرحله مادون که دنیاست ارزشمند شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 199.74,
   "end": 203.2,
   "text": "اینکه اونجا طولانی‌تره یه وجهش اینه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 203.2,
   "end": 205.44,
   "text": "حالا قداستش به کنار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 205.44,
   "end": 208.5,
   "text": "هرچی اهه قداستش بیشتر، طولانی‌تر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 208.5,
   "end": 212.06,
   "text": "البته این طولانی‌تر رو شما بعد زمانی بهش ندید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 212.06,
   "end": 217.94,
   "text": "از حیث مکانتی و معنوی عرض می‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 217.94,
   "end": 220.84,
   "text": "نه زمانی و مکانی. مکانتش رو عرض می‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 220.84,
   "end": 223.26,
   "text": "احتمال داره که انسان یک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 223.26,
   "end": 225.54,
   "text": "نوم عرفانی بهش دست بده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 225.54,
   "end": 228.18,
   "text": "آنی. از حیث زمانی آنیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 228.18,
   "end": 230.48,
   "text": "یک لحظه‌ست، یک ثانیه‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 230.48,
   "end": 238.78,
   "text": "اما انقدر اغر راه دریافت کنه، صغات بگیره، انقدر حقایق در وجودش بنشینه، انقدر صور و اشکال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 238.78,
   "end": 244.44,
   "text": "نورانی و ملذّه ببینه که انّ یک سال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 244.44,
   "end": 250.74,
   "text": "مشغول بوده. این طولانی‌تر منظورم اینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 250.74,
   "end": 252.54,
   "text": "که البته اینا همه در طول هم‌ند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 252.54,
   "end": 256.98,
   "text": "اینا همه آیات الهی‌اند. نشانه‌های حضرت حق‌اند که دارن بروز می‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 256.98,
   "end": 259.12,
   "text": "شب یلدا هم خودش یک نشانه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 259.12,
   "end": 264.68,
   "text": "نشانه حضرت حقه. و چقدر زیبا سنت‌های دیرینه‌ی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 264.68,
   "end": 266.86,
   "text": "ایرانی میاد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 266.86,
   "end": 269.64,
   "text": "به کمک فهم حقایق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 269.64,
   "end": 276.86,
   "text": "قرآنی. شما در نماز هم دقت کنید پیغمبر عزیز عالم معراج که رفتن، اون سفر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 276.86,
   "end": 282.46,
   "text": "از حیث باطنی طولانی و الا از حیث دنیایی که رفتن و برگشتن هنوز اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 282.46,
   "end": 288.68,
   "text": "ابریق یا پارچ یا هرچی که حالا افتاد آبش داشت می‌رفت هنوز آبش خالی نشده بود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 288.68,
   "end": 291.32,
   "text": "از جهت دنیایی. اما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 291.32,
   "end": 298.82,
   "text": "بعضی دوازده هزار، بعضی چهارده هزار، بعضی تا هجده هزار عالم رو پیغمبر گفتن رفتن تو اون معراج دیدن برگشتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 298.82,
   "end": 302.1,
   "text": "البته صد و بیست معراج رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 302.1,
   "end": 305.86,
   "text": "ایشون داشتنی یه معراجشون بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 305.86,
   "end": 310.46,
   "text": "در این معراج اصلی نماز رو به صغات برگردوندن برای من و شما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 310.46,
   "end": 313.96,
   "text": "ما هم به دست‌بوسی و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 313.96,
   "end": 319.2,
   "text": "در حقیقت تبریک به پیغمبر و تشکر از ایشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 319.2,
   "end": 323.42,
   "text": "در انتهای معراجمون که صلاة هست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 323.42,
   "end": 328.12,
   "text": "هنگامی که نشستیم کار تموم شده، یه رفت و برگشت قوس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 328.12,
   "end": 330.24,
   "text": "صعودی و نزولی داشتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 330.24,
   "end": 338.14,
   "text": "دو مرتبه که برمی‌گردیم به عالم کثرات تشکر می‌کنیم، دست‌بوسی می‌کنیم از پیغمبر عزیز عالم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 338.14,
   "end": 341.94,
   "text": "با اون سلام آخر که السلام سلام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 341.94,
   "end": 346.02,
   "text": "در حقیقت آخر نماز منظورم و الا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 346.02,
   "end": 349.72,
   "text": "از حیث اون سه تا سلام می‌شه سلام اول.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 349.72,
   "end": 355.38,
   "text": "السلام علیک ایها النبي ورحمة الله وبركاته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 355.38,
   "end": 361.02,
   "text": "اینجا تشکر می‌کنیم، دست‌بوسی از پیغمبر می‌کنیم که این صغات رو برای ما آورد که ما هم به سفر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 361.02,
   "end": 366.26,
   "text": "طولانی معراج بریم که هرچی ارتفاع ما در این معراج بیشتر باشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 366.26,
   "end": 373.08,
   "text": "ارتفاع ما از حیث تقرب به حضرت حق و تلبس به اسماء الله بیشتر و عمیق‌تر باشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 373.08,
   "end": 377.12,
   "text": "این ارتفاع عالی‌تره و طول",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 377.12,
   "end": 380.84,
   "text": "اون از حیث معنوی بیشتره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 380.84,
   "end": 383.24,
   "text": "دست‌بوسی می‌کنیم از پیغمبر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 383.24,
   "end": 386.06,
   "text": "و اینجا طول میدیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 386.06,
   "end": 388.46,
   "text": "به قوس نزولمون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 388.46,
   "end": 390.32,
   "text": "طول میدیم، چگونه طول میدیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 390.32,
   "end": 396.04,
   "text": "وسعت این سفره رو به حدی وسیع می‌کنیم به دستور حضرت حق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 396.04,
   "end": 399.16,
   "text": "درسته دو تا سلام اول مستحب‌ن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 399.16,
   "end": 405.44,
   "text": "اما مستحبی‌ان که به قولی هزاران واجب ازش بیرون میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 405.44,
   "end": 412.1,
   "text": "در سلام دوم می‌گین \"السلام علینا وعلى عباد الله الصالحین\" ببینید گستره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 412.1,
   "end": 415.62,
   "text": "سفره سلام رو که این برکته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 415.62,
   "end": 419.98,
   "text": "یعنی برکت میدی تو نمازت رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 419.98,
   "end": 423.26,
   "text": "برکت می‌بخشی. گستره‌ش جهانی می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 423.26,
   "end": 426.26,
   "text": "نه فقط همین جایی که من نشستم و من و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 426.26,
   "end": 429.26,
   "text": "اهل بیتم و یا مسجدم و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 429.26,
   "end": 431.38,
   "text": "دور و بری‌هام و همسایه‌هام، نه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 431.38,
   "end": 433.6,
   "text": "همسایه‌هات گستره‌ش تا کجا میره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 433.6,
   "end": 437.38,
   "text": "طولش رو ببینید چه وسعتی پیدا می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 437.38,
   "end": 441.1,
   "text": "ارتفاعش رو ببینید. سفره چه برکتی می‌گیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 441.1,
   "end": 447.6,
   "text": "بارها عرض کردیم فرق رزق و غیر رزق و برکت در رزق اینه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 447.6,
   "end": 452.12,
   "text": "شما اگر یه نعمتی رو داشته باشی ازش استفاده نکنی؛",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 452.12,
   "end": 458.54,
   "text": "مثلاً یه زمینی، یه باغی، یه وسیله‌ای، یه گوشه افتاده استفاده نمی‌کنی، این رزق تو نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 458.54,
   "end": 461.88,
   "text": "نعمت هست اما رزق تو نبوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 461.88,
   "end": 466.46,
   "text": "اما اگر ازش استفاده کنی فقط خودت استفاده کنی رزقه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 466.46,
   "end": 472.54,
   "text": "اگر استفاده کنی به دیگران هم بدی استفاده کنن این برکتش می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 472.54,
   "end": 479.52,
   "text": "مثل کسی که مثلاً باغ داره یا یه خونه تو مشهد و جاهای زیارتی داره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 479.52,
   "end": 483.04,
   "text": "شیفت‌بندی می‌کنه هی میده دیگران هم میرن استفاده می‌کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 483.04,
   "end": 488.38,
   "text": "کسایی کار خیر می‌کنن. این می‌شه برکتش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 488.38,
   "end": 491.4,
   "text": "یعنی خیلی برکت خیلی مهمه در اسلام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 491.4,
   "end": 494.54,
   "text": "ببینید نماز چه گستره‌ای پیدا می‌کنه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 494.54,
   "end": 499.4,
   "text": "چه برکتی در درونش نهفته است اگر توجه بهش بشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 499.4,
   "end": 503.26,
   "text": "که البته در حیثيت اسرار نماز این‌ها باید بیان بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 503.26,
   "end": 507.66,
   "text": "حالا ما تبرکاً امشب به شما تقدیم کردیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 507.66,
   "end": 514.02,
   "text": "که \"السلام علینا وعلى عباد الله الصالحین\" این طول دادن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 514.02,
   "end": 517.42,
   "text": "طول دادن در قوس نزول به عنوان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 517.42,
   "end": 519.92,
   "text": "یک برکت، دو تشکر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 519.92,
   "end": 524.14,
   "text": "به عنوان دست‌بوسی از پیغمبر که این سوغات رو برای ما آوردن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 524.14,
   "end": 527.48,
   "text": "که بعد ورود به کثرات می‌کنی و \"السلام علیکم\" میگی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 527.48,
   "end": 532.62,
   "text": "دیگه همه رو به همه این برکت نماز به گونه‌ای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 532.62,
   "end": 536.3,
   "text": "این فیض فیضان داره که به تمام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 536.3,
   "end": 540.4,
   "text": "تک تک کلمات وجودی و نظام هستی می‌رسه حتی به پیغمبر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 540.4,
   "end": 543.02,
   "text": "بله، اول کسی که سلام تو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 543.02,
   "end": 549.7,
   "text": "در انتهای نماز مشمولش می‌شه پیغمبر عزیز عالم، امام زمان، همه انبیا هستند،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 549.7,
   "end": 554.6,
   "text": "حقایق همه، همه این نور نماز بهشون می‌رسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 554.6,
   "end": 558.6,
   "text": "ببینید چه خبره. هرچی ارتفاع بیشتر،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 558.6,
   "end": 561.08,
   "text": "هرچی طول بیشتر،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 561.08,
   "end": 567.26,
   "text": "ارزش بیشتر. اینو خواستم بهتون توجه بدم نسبت به امشب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 567.26,
   "end": 571.02,
   "text": "خب حالا ما چه کنیم؟ امشب که هم شب اول ماه رجب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 571.02,
   "end": 575.42,
   "text": "هم شب یلداست. تا می‌تونیم سفره رو گسترده کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 575.42,
   "end": 579.7,
   "text": "تا می‌تونیم همراهی و همدلی داشته باشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 579.7,
   "end": 582.16,
   "text": "مخصوصاً به زبان، به لسان بیاریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 582.16,
   "end": 585.44,
   "text": "این خیلی مهمه. یعنی چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 585.44,
   "end": 591.96,
   "text": "یعنی اینکه وقتی که تو منزلمون قرار گرفتیم اگر می‌تونیم همراه خانواده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 591.96,
   "end": 597.4,
   "text": "همه با هم زبان بگیریم، نمی‌شه خودمون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 597.4,
   "end": 599.42,
   "text": "اسم ببریم یک یک.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 599.42,
   "end": 604.76,
   "text": "چگونه است که تو نماز می‌گیم \"وعلى عباد الله الصالحین\" همه رو در بر می‌گیریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 604.76,
   "end": 607.48,
   "text": "می‌گوییم \"السلام علیکم\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 607.48,
   "end": 614.9,
   "text": "مخاطب به جمعه. امشب سر این سفره همه رو مهمان کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 614.9,
   "end": 620.2,
   "text": "از انبیا، اولیا، شهدا، صالح‌ها،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 620.2,
   "end": 623.32,
   "text": "امام عصر عزیزمون که در صدر همه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 623.32,
   "end": 629.08,
   "text": "مادر کائنات حضرت صدیقه شهیده، پدر کائنات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 629.08,
   "end": 633.16,
   "text": "امیرالمؤمنین علی علیه السلام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 633.16,
   "end": 641.06,
   "text": "از شب اون مقام جمع الجمع که رتبه پیغمبر عزیز عالم و واسطه فیض بین حق و خلق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 641.06,
   "end": 645.6,
   "text": "بگیر بیا تا مادون تا انزل مراتب همه رو،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 645.6,
   "end": 650.2,
   "text": "همه رو مهمان کنید. و حتی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 650.2,
   "end": 653.26,
   "text": "لعن بر قاتلین و دشمنان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 653.26,
   "end": 660.16,
   "text": "آل الله هم به یک معنا اون‌ها رو هم توجه کردی بی‌توجه نکردی اما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 660.16,
   "end": 665.52,
   "text": "با لعن. در هر حال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 665.52,
   "end": 668.86,
   "text": "یاد همه بکنیم. این سفره رو گسترده کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 668.86,
   "end": 671.26,
   "text": "بعد می‌بینید که همه حاضرن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 671.26,
   "end": 674.64,
   "text": "چگونه است که تو نماز انفرادی داری می‌خونی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 674.64,
   "end": 677.26,
   "text": "اما همه حاضرن. محل حضوره دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 677.26,
   "end": 683.24,
   "text": "مقام، مقام حضوره. چنین سفره‌ی یلدایی اونم شب در شب رجب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 683.24,
   "end": 688.28,
   "text": "ریزش شدید رحمت خدا رو از همون ابتدا همراه خودش داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 688.28,
   "end": 694.16,
   "text": "همراه کردن همه سر سفره حتی اسم ببریم از کسایی که گردن ما حق دارن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 694.16,
   "end": 702.6,
   "text": "از اجدادمون تا اونجایی که اسماشونو می‌دونیم نمی‌دونیم بگیم تا حضرت آدم همه اجدادمون و نسل بعدمون حتی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 702.6,
   "end": 707.42,
   "text": "بگیم تا انتهای این دوره خلقت نسل در نسل ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 707.42,
   "end": 709.86,
   "text": "همه رو ما حاضر می‌کنیم به یک سلام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 709.86,
   "end": 715.76,
   "text": "سلام بر همشون. رحمت و فیوضات تو ای خدا بر همشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 715.76,
   "end": 719.34,
   "text": "و لعنت تو بر هر کدومی که مانع",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 719.34,
   "end": 722.4,
   "text": "راه تو و اولیاء تو شدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 722.4,
   "end": 724.96,
   "text": "و این سفره ببینید چقدر گسترده می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 724.96,
   "end": 729.2,
   "text": "بوی یلدایی می‌ده و بوی رجب که شدت ریزش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 729.2,
   "end": 732.38,
   "text": "رحمت حضرت حقه. بنده هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 732.38,
   "end": 735.7,
   "text": "خیلی حتماً و حتماً یاد می‌کنم تا بتونم اونایی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 735.7,
   "end": 742.74,
   "text": "اسم‌هایی که می‌دونم اسم میارم، اونایی که چهره‌هاشون تو ذهنم باشه در خاطرم میارم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 742.74,
   "end": 747.12,
   "text": "و یاد می‌کنم. به همه سلام تقدیم می‌کنم به همه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 747.12,
   "end": 753.34,
   "text": "از پروردگار منّان خواستارم که رحمت واسعه خودش رو بر همه نازل کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 753.34,
   "end": 755.72,
   "text": "اون‌هایی که ما التماس دعا گفتن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 755.72,
   "end": 760.28,
   "text": "حتی سوالی داشتن یا من فرصت نکردم جواب بدم یا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 760.28,
   "end": 762.42,
   "text": "بلد نبودم جواب بدم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 762.42,
   "end": 765.3,
   "text": "یا ناقص جواب دادم یا جواب دادم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 765.3,
   "end": 769.36,
   "text": "در هر حال همه رو، همه سائلین در هر حیثش؛",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 769.36,
   "end": 772.04,
   "text": "مالی، معنوی، علمی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 772.04,
   "end": 780.14,
   "text": "و هر کسی که تعلق خاطری به بنده حقیر داره در-- به این راه ما که خودمون چیزی نیستیم به خاطر انتصاب‌مون به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 780.14,
   "end": 782.1,
   "text": "این راه مقدس آل الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 782.1,
   "end": 784.72,
   "text": "تعلق خاطری به ما داره. همه رو یاد می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 784.72,
   "end": 787.28,
   "text": "سلام محضر همه تقدیم می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 787.28,
   "end": 794.98,
   "text": "مخصوصاً، مخصوصاً، مخصوصاً اون‌هایی که توی این چندین ساله همیشه و همیشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 794.98,
   "end": 796.86,
   "text": "از وجودشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 796.86,
   "end": 802.56,
   "text": "مایه گذاشتن، از آبروشون مایه گذاشتن، از مالشون مایه گذاشتن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 802.56,
   "end": 806.9,
   "text": "از نفسشون و نفسشون مایه گذاشتن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 806.9,
   "end": 810.16,
   "text": "از خانواده‌شون مایه گذاشتن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 810.16,
   "end": 813.56,
   "text": "و در این راه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 813.56,
   "end": 817.64,
   "text": "ولایت کلیه الهیه بنده رو یاری رسوندن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 817.64,
   "end": 822.56,
   "text": "مدد رسوندن. چه اون‌هایی که الان ظاهراً همراه ما هستن یا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 822.56,
   "end": 826.6,
   "text": "اون‌هایی که نیستن و اون‌هایی که بعداً ملحق می‌شن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 826.6,
   "end": 828.94,
   "text": "همه و همه هر کسی که در مسیر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 828.94,
   "end": 834.04,
   "text": "امیرالمؤمنین و حضرت صدیقه شهیده علیهم السلام بنده رو یاری رسوند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 834.04,
   "end": 839.66,
   "text": "هر کسی که در مسیر امام عصر بنده رو کمک کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 839.66,
   "end": 843.78,
   "text": "حتی خیلیا گمنام بنده رو یاری دادن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 843.78,
   "end": 847.54,
   "text": "من متوجه می‌شم حتی تو همین خیریه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 847.54,
   "end": 855.5,
   "text": "خودمون شما شاید در کانال ام نعمene باشید، دیدید بعضی از قبض‌ها که اونجا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 855.5,
   "end": 858.8,
   "text": "ادمین محترم وا-بارگذاری می‌کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 858.8,
   "end": 863.52,
   "text": "هیچ اسمی نخورده یا اصلاً بعضیا قبض هم نفرستادن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 863.52,
   "end": 870.14,
   "text": "متوجه بعضی واریزی‌ها می‌شم که هیچ اطلاعی بعضاً نمیده طرف مثلاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 870.14,
   "end": 876.04,
   "text": "نذر عام می‌کنه در هر شرایطی، در هر وضعی خرج کارهای خیر و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 876.04,
   "end": 878.6,
   "text": "تربیتی و معنوی و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 878.6,
   "end": 887.6,
   "text": "تو این راه هزینه بشه. متوجه می‌شم این‌ها رو که بعضیا با چه خلوصی کمک می‌کنن بدون هیچ گونه چشم‌داشتی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 887.6,
   "end": 894.26,
   "text": "و حتی قبضشون هم. البته من توصیه می‌کنم به جهت اینکه ثبت بشه در خیریه و حرف و حدیثی پیش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 894.26,
   "end": 899.86,
   "text": "نیاد. مثل اخیراً که بنده مجبور شدم چون به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 899.86,
   "end": 901.74,
   "text": "عموم کشیده شد ولو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 901.74,
   "end": 905.78,
   "text": "یک نفر اشکال کرده باشه مجبور شدم توضیحاتی بدم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 905.78,
   "end": 908.56,
   "text": "و خیلی‌ها ناراحت شده بودن از این،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 908.56,
   "end": 915.3,
   "text": "حق هم دارن و بنده رو دلداری داده بودن و از همشون تشکر می‌کنم و دستشون رو می‌بوسم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 915.3,
   "end": 923.42,
   "text": "اما خب اگر قبضی که می‌فرستن مشخص باشه برای چه موضوعی هست حتی نذر عام هم هست بیان کنن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 923.42,
   "end": 926.22,
   "text": "حتی واگذار می‌کنن به صلاحدید بنده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 926.22,
   "end": 933.88,
   "text": "حقیر باز اعلام کنن خیلی خوب ولی در هر حال بعضیا گمنام خدمت می‌کنن، گمنام خیر می‌رسونن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 933.88,
   "end": 938.78,
   "text": "یا اون عزیزی که سی و چند تا نزدیک چهل کتاب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 938.78,
   "end": 940.38,
   "text": "جامع سهوا السیر و سلوک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 214,
   "start": 940.38,
   "end": 942.7,
   "text": "علامه رو هدیه کردن و تأکید کردن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 215,
   "start": 942.7,
   "end": 949.68,
   "text": "اسمشون برده نشه و ما به اون‌هایی که جزوات‌شون کامل بود در امتحانات که گرفتیم چه در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 216,
   "start": 949.68,
   "end": 956.58,
   "text": "عرض شود مسجد بلال ملاحظه کردیم، چه در لواسان اینا رو تقدیم کردیم به کامل‌ترین‌ها، بهترین‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 217,
   "start": 956.58,
   "end": 960.42,
   "text": "البته کم اومد عذرخواهی می‌کنم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 218,
   "start": 960.42,
   "end": 968.32,
   "text": "و هر کسی که با دعای خودش الان سر صف سجاده‌ش نشسته در دل سحر در نماز وترش بنده رو دعا می‌کنه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 219,
   "start": 968.32,
   "end": 971.7,
   "text": "ما رو در این مسیر تقویت می‌کنه، یار--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 220,
   "start": 971.7,
   "end": 975.44,
   "text": "یاری میده. حتی کسایی که در نیتشون ما رو یاری میدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 221,
   "start": 975.44,
   "end": 978.58,
   "text": "خیلی جالبه ببینید وسعت سفره رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 222,
   "start": 978.58,
   "end": 984.04,
   "text": "مثلاً یه عزیزی برای من پیام فرستاده بود دلداری داده بود که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 223,
   "start": 984.04,
   "end": 985.94,
   "text": "شما اذیت شدید بابت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 224,
   "start": 985.94,
   "end": 991.28,
   "text": "این، اِاِاِ انقلتی که پیرامون مسئله خیریه وارد شده و این‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 225,
   "start": 991.28,
   "end": 994.58,
   "text": "ای کاش خدا پروردگار سبحان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 226,
   "start": 994.58,
   "end": 998.88,
   "text": "چقدرم شیرین دعا کرده بود خودتون رو بی‌نیاز کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 227,
   "start": 998.88,
   "end": 1002.2,
   "text": "همونطور که خودتون دعا کردید امیدوارم خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 228,
   "start": 1002.2,
   "end": 1005.7,
   "text": "ما رو از شکاکان بی‌نیاز کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 229,
   "start": 1005.7,
   "end": 1008.32,
   "text": "از یاری شکاکان بی‌نیاز کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 230,
   "start": 1008.32,
   "end": 1010.62,
   "text": "یا اینکه به خود بنده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 231,
   "start": 1010.62,
   "end": 1016.92,
   "text": "این ظرفیتش رو بده و توانش رو بده که گمنام به شما کمک مالی بکنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 232,
   "start": 1016.92,
   "end": 1020.2,
   "text": "این ببینید نیت رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 233,
   "start": 1020.2,
   "end": 1025.58,
   "text": "یعنی بتونم واسطه خیری بشم شما رو از حیث مالی بی‌نیاز کنم در این مسیر،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 234,
   "start": 1025.58,
   "end": 1029.72,
   "text": "در این مسیر پر از خیر و البته پر پیچ و خم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 235,
   "start": 1029.72,
   "end": 1032.26,
   "text": "این خیلیا با نیت‌هاشون ما رو یاری میدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 236,
   "start": 1032.26,
   "end": 1039.6,
   "text": "ببینید چقدر طول و دراز میشه از حیث، از حیث معنوی چقدر وسعت می‌گیره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 237,
   "start": 1039.6,
   "end": 1042.78,
   "text": "این سفره و چه انعکاسی در عالم هستی داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 238,
   "start": 1042.78,
   "end": 1047.84,
   "text": "شما وقتی میگی عالم هستی انتها نداره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 239,
   "start": 1047.84,
   "end": 1052.18,
   "text": "پس نباید هم تعجب کرد که یک نیت خیر انتها نداشته باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 240,
   "start": 1052.18,
   "end": 1058.0,
   "text": "تا کجا بره؟ ما چه می‌دونیم؟ مگه حضرت حق انتها داره که جلوه‌هاش،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 241,
   "start": 1058.0,
   "end": 1063.2,
   "text": "رشحاتش و تجلیاتش، ظهورات و بروزاتش انتها داشته باشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 242,
   "start": 1063.2,
   "end": 1065.88,
   "text": "خودمون رو محروم نکنیم، بزرگ بشیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 243,
   "start": 1065.88,
   "end": 1068.28,
   "text": "و بزرگ بپرورونیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 244,
   "start": 1068.28,
   "end": 1070.22,
   "text": "نیت‌هامون رو بزرگ کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 245,
   "start": 1070.22,
   "end": 1074.9,
   "text": "قلبمون و دلمون رو صاف کنیم و بزرگ کنیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 246,
   "start": 1074.9,
   "end": 1078.76,
   "text": "و وصل بشیم به بزرگان عالم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 247,
   "start": 1078.76,
   "end": 1082.46,
   "text": "سر سفره بزرگان ارتضاغ کنیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 248,
   "start": 1082.46,
   "end": 1085.14,
   "text": "و از آدم‌های کوچیک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 249,
   "start": 1085.14,
   "end": 1092.38,
   "text": "تنگ نظر فاصله بگیریم، دور باشیم از نیت‌های کوچک حتی دور باشیم، بزرگ باشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 250,
   "start": 1092.38,
   "end": 1100.46,
   "text": "خدایا ما رو بزرگ کن. پروردگار سبحان امشب که یک دقیقه طولانی‌تر شده به یک معنا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 251,
   "start": 1100.46,
   "end": 1103.96,
   "text": "شب دیرتر رختش رو وَر می‌بنده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 252,
   "start": 1103.96,
   "end": 1111.42,
   "text": "و بزرگ‌تر شده به یک معنا تو هم ما رو بزرگ‌تر کن، ما رو بزرگ کن خدایا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 253,
   "start": 1111.42,
   "end": 1115.44,
   "text": "به همه باز هم تبریک میگم انشاالله این ورودمون به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 254,
   "start": 1115.44,
   "end": 1117.72,
   "text": "شهر مقدس که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 255,
   "start": 1117.72,
   "end": 1127.04,
   "text": "ماه رجب است، موجب برکت ورود به صحن مقدس که ماه شعبان باشه بشه و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 256,
   "start": 1127.04,
   "end": 1130.7,
   "text": "از اونجا موجب ورودمون به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 257,
   "start": 1130.7,
   "end": 1133.22,
   "text": "حرم مقدس که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 258,
   "start": 1133.22,
   "end": 1136.78,
   "text": "ماه مبارک رمضان باشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 259,
   "start": 1136.78,
   "end": 1144.3,
   "text": "انشاالله اتفاق بیفته و از اونجا هم در شب قدر مزجع شریف و تربت شریف رو زیارت کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 260,
   "start": 1144.3,
   "end": 1147.18,
   "text": "والحمد لله رب العالمین یا زهرا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}