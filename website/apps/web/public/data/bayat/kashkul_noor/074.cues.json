   "title": "## دعای صدیقهٔ شهیده",
   "start": 308.4,
   "end": 526.47
  },
  {
   "index": 3,
   "title": "## عثمان بن مظعون و ثقلت الدنیا فی عینه",
   "start": 526.47,
   "end": 546.79
  },
  {
   "index": 4,
   "title": "## محک نظر امام عصر",
   "start": 546.79,
   "end": 821.41
  },
  {
   "index": 5,
   "title": "## ترس‌ها و بزرگی دنیا در چشم",
   "start": 821.41,
   "end": 980.63
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 1.6,
   "end": 5.1,
   "text": "بسم الله الرحمن الرحیم و به این استعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 5.1,
   "end": 8.86,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 8.86,
   "end": 13.66,
   "text": "آیه. سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 13.66,
   "end": 18.76,
   "text": "خب مدتی بود که در محضر شما نبودیم و بهره نمی‌بردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 18.76,
   "end": 22.36,
   "text": "تو این فرصت کوتاه به ذهنم رسید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 22.36,
   "end": 24.58,
   "text": "چون بحث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 24.58,
   "end": 28.6,
   "text": "کشکول نورمون هم که زهرا پیرامونه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 28.6,
   "end": 32.54,
   "text": "معرفت توحیدی و کلا توحید افعالی و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 32.54,
   "end": 36.4,
   "text": "شروع کردیم تو اون مبحث بودیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 36.4,
   "end": 38.58,
   "text": "مدتی بود تعطیل شده بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 38.58,
   "end": 40.66,
   "text": "یه نکته‌ای رو عرض کنم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 40.66,
   "end": 45.36,
   "text": "نقطه مقابل معرفت توحیدی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 45.36,
   "end": 48.3,
   "text": "چیه؟ یعنی چی باعث می‌شه که انسان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 48.3,
   "end": 51.5,
   "text": "از توحید باز بمونه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 51.5,
   "end": 56.18,
   "text": "غالب انسان‌ها به این توجه نمی‌کنند و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 56.18,
   "end": 60.14,
   "text": "متأسفانه حتی اگر دم از توحید هم بزنن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 60.14,
   "end": 66.22,
   "text": "مسلمون شناسنامه‌ان. یعنی از توحید بهره‌ای نمی‌برن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 66.22,
   "end": 70.32,
   "text": "و برای اون چیزی که خلق شدن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 70.32,
   "end": 76.94,
   "text": "زحمتی نمی‌کشن. برای اتفاقاً چیزی زحمت می‌کشن که براش خلق نشدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 76.94,
   "end": 79.96,
   "text": "خدا رحمت کنه حضرت استاد را همیشه به این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 79.96,
   "end": 84.06,
   "text": "فرمایش شریف تأکید می‌کرد که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 84.06,
   "end": 86.96,
   "text": "اعملوا فکل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 86.96,
   "end": 89.42,
   "text": "ميسر لما خلق له.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 89.42,
   "end": 93.54,
   "text": "خیلی قشنگه روایت. می‌فرمود عمل کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 93.54,
   "end": 98.0,
   "text": "خب به چی عمل کنیم؟ می‌فرمود فکل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 98.0,
   "end": 100.16,
   "text": "ميسر لما خلق له.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 100.16,
   "end": 103.56,
   "text": "کلاً این شکلیه سنت الهی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 103.56,
   "end": 107.44,
   "text": "که برای هر چیزی خلق شدی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 107.44,
   "end": 113.72,
   "text": "ميسر له. شما برای هر چیزی خلق شدید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 113.72,
   "end": 117.94,
   "text": "برای همون هم اعمالتون میسره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 117.94,
   "end": 120.5,
   "text": "یعنی ميسر. يسر یعنی آسونی دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 120.5,
   "end": 127.06,
   "text": "در قرآن داریم ان الله يريد بكم اليسر ولا يريد بكم العسر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 127.06,
   "end": 130.78,
   "text": "اگه آیه رو اشتباه نخونده باشم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 130.78,
   "end": 135.52,
   "text": "که خدا برای شما آسونی رو خواسته، سختی رو نخواسته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 135.52,
   "end": 138.26,
   "text": "اینجا که می‌فرمود ان مع العسر يسرا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 138.26,
   "end": 141.44,
   "text": "يسر آسونیه. عسر سختیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 141.44,
   "end": 144.04,
   "text": "اینجا می‌فرمود اعملوا عمل کنید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 144.04,
   "end": 148.28,
   "text": "فکل ميسر لما خلق له.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 148.28,
   "end": 151.0,
   "text": "برای اون چیزی که براش خلق شدید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 151.0,
   "end": 154.14,
   "text": "برای همون هم شما براتون ميسره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 154.14,
   "end": 160.46,
   "text": "یعنی براتون آسونه. آسونه شما برای اون چیزی که خلق شدید عمل کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 160.46,
   "end": 164.6,
   "text": "ما برای چی خلق شدیم؟ برای دنیا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 164.6,
   "end": 168.64,
   "text": "برای خدمت به دنیا؟ برای خدمت به بدنمون؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 168.64,
   "end": 173.94,
   "text": "مطلقا. یک وسیله‌ست برای رسیدن به اون هدف.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 173.94,
   "end": 176.9,
   "text": "ما خلق شدیم، آیه قرآن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 176.9,
   "end": 179.58,
   "text": "ما خلقت الجن والانس الا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 179.58,
   "end": 185.92,
   "text": "ليعبدون. اصلاً فقط صرفاً برای عبادت خلق شدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 185.92,
   "end": 191.3,
   "text": "عبادت البته تمام مفسرین عرض کردیم فرمودن ای ليعرفون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 191.3,
   "end": 193.88,
   "text": "اون عبادت رو گرفتن عرفان،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 193.88,
   "end": 198.4,
   "text": "گرفتن شناخت. عبادت بدون شناخت هم فایده نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 198.4,
   "end": 206.58,
   "text": "اما در هر حال این داره نشون می‌ده که مسیر توحید چون فطرت الله التي فطر الناس عليها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 206.58,
   "end": 210.56,
   "text": "فطرت ما ذات ما الهیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 210.56,
   "end": 213.04,
   "text": "چون ذات ما الهیه، فطرت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 213.04,
   "end": 217.82,
   "text": "الهیه، فطرت الله التي فطر الناس عليها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 217.82,
   "end": 221.68,
   "text": "فطرت الهیه. کل مولود یولد على فطره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 221.68,
   "end": 224.52,
   "text": "چون فطرت ما الهیه پس میسره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 224.52,
   "end": 230.2,
   "text": "عمل کردن در مسیر الهیت نظام، در مسیر توحید،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 230.2,
   "end": 235.04,
   "text": "عمل کردن برای آخرت باید خیلی آسون باشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 235.04,
   "end": 239.66,
   "text": "و برعکس باید برای دنیا س-- کار کردن سخت باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 239.66,
   "end": 243.12,
   "text": "کسی که به فکر دنیاست همش همش دنیاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 243.12,
   "end": 245.08,
   "text": "خلوت می‌کنه به فکر دنیاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 245.08,
   "end": 247.34,
   "text": "جلوت داره به فکر دنیاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 247.34,
   "end": 251.06,
   "text": "گفت و گوش با دیگران صرفاً پیرامون مسائل دنیاییه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 251.06,
   "end": 254.84,
   "text": "اصلاً دلش تنگ نمی‌شه برای آخرت، برای توحید، برای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 254.84,
   "end": 258.42,
   "text": "معارف دلتنگی نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 258.42,
   "end": 262.02,
   "text": "چنین کسی سخته براش خودش حالیش نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 262.02,
   "end": 267.24,
   "text": "فکر می‌کنه این راه درستی رو، راه صحیح و آسونی رو انتخاب کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 267.24,
   "end": 273.68,
   "text": "اتفاقاً راه سخت رو انتخاب کرده چون ذاتش مغایره با این راه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 273.68,
   "end": 279.38,
   "text": "ذات او اینچنین خلق نشده که در مسافرخونه بخواد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 279.38,
   "end": 283.3,
   "text": "اساس و عرض شود وسایل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 283.3,
   "end": 287.9,
   "text": "abadi تهیه کنه که. مثلا شما فکر کنید هیچ‌وقت شما بخوای بری سفر، یه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 287.9,
   "end": 291.02,
   "text": "اتاقی رو اجاره می‌کنی بری چند روز توش باشی، میری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 291.02,
   "end": 293.3,
   "text": "کلی اساس و تجهیز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 293.3,
   "end": 299.44,
   "text": "اینا بخری بذاری اون تو؟ عقل سالم اقتضا می‌کنه این کار رو؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 299.44,
   "end": 302.9,
   "text": "در حد نیازت که اکتفا کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 302.9,
   "end": 306.74,
   "text": "زندگیتو بگذرونی اون چند روزت به هدف اصلیت برسی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 306.74,
   "end": 311.12,
   "text": "این روایت خیلی زیباست. اتفاقاً یه دعایی هم داریم منسوب به حضرت صدیقه شهیده‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 311.12,
   "end": 314.72,
   "text": "خیلی دعای عالیه که همین رو داره تصویر می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 314.72,
   "end": 317.96,
   "text": "می‌فرمود الهی، خیلی قشنگه دعا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 317.96,
   "end": 324.1,
   "text": "اصلاً غوغا کرده تو یه جمله چه کرده معجزه قولیه حضرت زهرا سلام الله علیها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 324.1,
   "end": 327.12,
   "text": "الهی استعمالنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 327.12,
   "end": 330.72,
   "text": "لما خلقتنی له. به به به به!",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 330.72,
   "end": 334.88,
   "text": "خدای منو مشغول کن به کار بگیر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 334.88,
   "end": 337.08,
   "text": "استعمالنی. منو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 337.08,
   "end": 339.26,
   "text": "مشغول کن و به کار بگیر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 339.26,
   "end": 344.98,
   "text": "لما خلقتنی له. در اون چیزی که براش خلقم کردی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 344.98,
   "end": 350.08,
   "text": "منو تو مسیری قرار بده، تو مسیری راه بنداز، تو مسیری قرار بده و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 350.08,
   "end": 353.36,
   "text": "مشغولم کن که تو منو برای اون خلق کردی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 353.36,
   "end": 356.8,
   "text": "همون فکل ميسر لما خلق له.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 356.8,
   "end": 358.46,
   "text": "چقدر قشنگ حضرت زهرا این دعا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 358.46,
   "end": 365.61,
   "text": "ما کی از این دعاهو بلدی؟ تو قرآن داریم به دست اونا که خاسرن، بیچاره‌ن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 365.61,
   "end": 369.55,
   "text": "همش میگن ربّنا آتنا فی الدنیا حسنة.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 369.55,
   "end": 371.47,
   "text": "فی الدنیا، فی الدنیا، فی الدنیا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 371.47,
   "end": 377.77,
   "text": "همش دنیا، دنیا، دنیا. اصن خودمونو محک بزنیم بالاخره خودمون که بل الإنسان علی نفسه بصیرة.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 377.77,
   "end": 380.27,
   "text": "می‌دونیم چه کاره‌ایم .",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 380.27,
   "end": 383.11,
   "text": "چقدر برای دنیامون داریم دعاهامونو رصد کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 383.11,
   "end": 386.59,
   "text": "یه شبانه روز رصد کنیم از صبح تا شب دعاهامون چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 386.59,
   "end": 390.89,
   "text": "چند تاش بوی دنیا میده، چند تاش بوی آخرت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 390.89,
   "end": 393.99,
   "text": "بدتر از اونه که یه وقت می‌ری رصد می‌کنی می‌بینی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 393.99,
   "end": 398.63,
   "text": "خواسته‌های اخرویتم بوی دنیا میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 398.63,
   "end": 402.51,
   "text": "یعنی به‌خاطر اینکه وضع دنیات خوب بشه نماز شب می‌خونی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 402.51,
   "end": 407.33,
   "text": "به‌خاطر اینکه گره و گره‌های دنیاییت باز بشه میری زیارت می‌کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 407.33,
   "end": 409.93,
   "text": "به‌خاطر اینکه عزیز بشی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 409.93,
   "end": 414.89,
   "text": "گناه نمی‌کنی. به‌خاطر اینکه آبروت نره گناه نمی‌کنی و این اصلاً این همش بوی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 414.89,
   "end": 419.19,
   "text": "دنیا داد که. همش دنیا، دنیا، دنیا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 419.19,
   "end": 421.03,
   "text": "یه روایتی داریم من خیلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 421.03,
   "end": 424.67,
   "text": "این رو شنیدم خیلی غصه خوردم، خیلی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 424.67,
   "end": 428.73,
   "text": "اول برای خودم، دوم برای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 428.73,
   "end": 432.63,
   "text": "این نسل جوونمون، نسل جدیدمون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 432.63,
   "end": 436.55,
   "text": "که چقدر متاسفانه از این معارف به دورن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 436.55,
   "end": 442.85,
   "text": "باز ما بچه که بودیم چهار تا شهید بغل دستمون، بغل گوشمون اینا رو تو گوشمون گفتن و خوندن و.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 442.85,
   "end": 446.45,
   "text": "الان نمی‌دونم کی اصلاً از خود گذشته‌ای هست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 446.45,
   "end": 449.79,
   "text": "با خدا معامله کنه و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 449.79,
   "end": 455.75,
   "text": "و بره زندگیشو وقف این نوجوونا و جوونا و اینها بکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 455.75,
   "end": 457.41,
   "text": "هستن البته اما خیلی کم‌ن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 457.41,
   "end": 461.33,
   "text": "مثل همین شهید حسین .",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 461.33,
   "end": 463.39,
   "text": "فامیلیش چی بود که تو مسجد شهید شد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 463.39,
   "end": 467.05,
   "text": "تیر خورد به پهلوش چند روز پیش تو این اغتشاشات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 467.05,
   "end": 470.95,
   "text": "تو مسجد سیدالشهدای پاکدشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 470.95,
   "end": 475.17,
   "text": "اونجا بود یا کجا بود؟ مَردشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 475.17,
   "end": 479.73,
   "text": "تیر خورد حسین دهقان. تیر خورد به پهلوش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 479.73,
   "end": 483.15,
   "text": "تیر خورد به پهلوش. نانجی--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 483.15,
   "end": 486.97,
   "text": "آره نانجیبا راه رو بسته بودن که نتونن ببرنش بیمارستان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 486.97,
   "end": 488.95,
   "text": "تو مسجد شهید شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 488.95,
   "end": 491.47,
   "text": "کلیپش خ-- خیلی روزم بوده ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 491.47,
   "end": 494.25,
   "text": "از تشنگی و گرسنگی شهید میشه انقدر خون ازش میره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 494.25,
   "end": 499.49,
   "text": "ببینید کلیپش خیلی اشکیه. متنبه کننده‌ست آره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 499.49,
   "end": 505.25,
   "text": "اون مثلا ااا یه چند تا کلیپ ازش من دیدم که معلم بوده، چقدر می‌جوشیده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 505.25,
   "end": 509.45,
   "text": "اصن عمرشو گذاشته بوده برای تربیت توی دهات، توی دهات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 509.45,
   "end": 514.63,
   "text": "عمرشو گذاشته بوده برای تربیت نوجوونا و جوونا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 514.63,
   "end": 517.35,
   "text": "یعنی همش این بوده که جع-- بعدم گفته بوده من",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 517.35,
   "end": 520.57,
   "text": "تا قبل سی سالگی شهید میشم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 520.57,
   "end": 524.57,
   "text": "و همونم شد دیگه. حالا این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 524.57,
   "end": 528.89,
   "text": "روایتی که میگم چون امیرالمؤمنین علیه الصلاة والسلام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 528.89,
   "end": 532.39,
   "text": "از حضرت ام البنین سلام الله علیها چهار تا پسر داشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 532.39,
   "end": 537.03,
   "text": "می‌دونید دیگه. عبدالله و عثمان و جعفر و عباس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 537.03,
   "end": 541.81,
   "text": "علیهم الصلاة والسلام. عبدالله، عثمان، جعفر، عباس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 541.81,
   "end": 545.85,
   "text": "عثمان رو بعضیا میگن فکر می‌کنن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 545.85,
   "end": 552.83,
   "text": "م-- به‌خاطر اون سومی لعنت الله عليه مثلاً مولا گذاشته تحت فشار قرار داشته و از اینجور حرفا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 552.83,
   "end": 554.97,
   "text": "حرفای زشتی می‌زنن بعضیا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 554.97,
   "end": 559.83,
   "text": "این مذهبی‌ها تازه. به هر حال انتسابش میدن به اون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 559.83,
   "end": 566.27,
   "text": "در صورتی که خود امیرالمؤمنین علیه الصلاة والسلام ازش پرسیدن چرا شما اسم فرزندتو گذاشتی عثمان؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 566.27,
   "end": 569.75,
   "text": "ایشون فرمودن من یک برادری داشتم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 569.75,
   "end": 572.51,
   "text": "، خیلی به ایشون علاقه‌مند بودم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 572.51,
   "end": 577.91,
   "text": "به‌خاطر علاقه‌ای که به این برادر دینیم داشتم اسم فرزندم رو گذاشتم عثمان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 577.91,
   "end": 581.67,
   "text": "چقدر شیرین. چقدر جالب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 581.67,
   "end": 587.09,
   "text": "امروز یه حدیثی دیدم که دوای دردها دیدار برادران است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 587.09,
   "end": 592.77,
   "text": "برادران دینیتو یا خواهرها برن به دیدار خواهرای دینیشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 592.77,
   "end": 598.67,
   "text": "دوای دردهاست. ما استفاده می‌کنیم از این دوا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 598.67,
   "end": 603.99,
   "text": "حالا اونجا امیرالمؤمنین یک، یه چند تا صفت رو بر می‌شمره وقتی داره تعریف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 603.99,
   "end": 607.17,
   "text": "عثمان رو می‌کنه. عثمان بن مزعون بوده اسمش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 607.17,
   "end": 610.89,
   "text": "عثمان بن مزعون که شهیدم میشه ایشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 610.89,
   "end": 613.97,
   "text": "توی جنگی شهید میشه. الان خاطرم نیست تو کدوم جنگ.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 613.97,
   "end": 618.81,
   "text": "یکی از جنگ‌ها شهید میشه. امیرالمؤمنین وقتی از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 618.81,
   "end": 627.29,
   "text": "خاطراتش با عثمان بن مزعون میگه که این کی بود و به‌خاطر اون اسم فرزندم رو گذاشتم عثمان،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 627.29,
   "end": 630.81,
   "text": "یکی از خصوصیات عثمان رو اینچنین معرفی می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 630.81,
   "end": 635.41,
   "text": "یکی‌شونم براتون بخونم. می‌فرماید: یعظمنی فی عینی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 635.41,
   "end": 639.49,
   "text": "می‌دونید چرا ایشون تعظیم شده تو چشم من؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 639.49,
   "end": 642.35,
   "text": "یعظمنی فی عینی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 642.35,
   "end": 645.27,
   "text": "می‌دونید چرا انقدر عظیمه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 645.27,
   "end": 647.49,
   "text": "نامش، یادش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 647.49,
   "end": 651.79,
   "text": "تو چشم من؟ یعظمنی فی عینی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 651.79,
   "end": 655.97,
   "text": "عظیم شد و اون رو عظیم می‌شمرم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 655.97,
   "end": 658.61,
   "text": "تو چشم من عظیمه، بزرگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 658.61,
   "end": 661.03,
   "text": "چرا؟ به‌خاطر اینکه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 661.03,
   "end": 664.35,
   "text": "ثقلت الدنيا فی عينه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 664.35,
   "end": 668.97,
   "text": "الله اکبر. چون دنیا تو چشمش کوچیک بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 668.97,
   "end": 670.93,
   "text": "ثقلت الد-- اصن ترجمه نمی‌خواد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 670.93,
   "end": 673.21,
   "text": "اصن از عبارت عربیش مشخصه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 673.21,
   "end": 675.57,
   "text": "ثقلت الدنيا فی عينه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 675.57,
   "end": 677.85,
   "text": "دنیا کوچولو بود تو چشماش،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 677.85,
   "end": 682.31,
   "text": "لذا بزرگ شد تو چشم علی .",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 682.31,
   "end": 686.17,
   "text": "حالا الان ما می‌خوایم ببینیم که مثلاً خیلیا میان می‌پرسن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 686.17,
   "end": 690.13,
   "text": "چجوری بفهمیم که نظر امام عصر درباره‌ی ما چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 690.13,
   "end": 692.27,
   "text": "ما مثلاً جایگاه ما تو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 692.27,
   "end": 694.87,
   "text": "محض، در محضر آقا چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 694.87,
   "end": 697.07,
   "text": "آیا ما تو چشم آقا جا گرفتیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 697.07,
   "end": 699.43,
   "text": "تو دلش جا گرفتیم؟ بفرمایید بسم الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 699.43,
   "end": 706.99,
   "text": "این بهترین محک. هر مقدار دنیا در چشم من و شما کوچیکه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 706.99,
   "end": 711.67,
   "text": "همون مقدار ما تو چشم امام زمانمون بزرگیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 711.67,
   "end": 716.87,
   "text": "اینطوری ببین قضیه رو. این حرف که دارم می‌زنم حرف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 716.87,
   "end": 724.31,
   "text": "بسیار مهمیه و البته می‌دونم در حد و اندازه‌ی بنده نیست این حرفا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 724.31,
   "end": 727.25,
   "text": "حرف زدنش آسونه. آدم بشینه و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 727.25,
   "end": 733.03,
   "text": "بالاخره یه کتابی هم بذاره جلوش و دو تا حدیثو بخونه و دوستان هم حوصله کنن و هی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 733.03,
   "end": 737.59,
   "text": "پلک نزنن و یا به سختی جلو خوابشونو بگیرن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 737.59,
   "end": 742.91,
   "text": "ما نه امروز حالا استثنائا همه بیدارید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 742.91,
   "end": 746.53,
   "text": ". انشاالله بیداری واقعی باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 746.53,
   "end": 749.71,
   "text": "به هر حال حرف زدنش آسونه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 749.71,
   "end": 752.67,
   "text": "اما عمل به این‌ها خیلی سخته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 752.67,
   "end": 754.45,
   "text": "بحث ما چی بود؟ جمع کنیم بحثو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 754.45,
   "end": 758.01,
   "text": "می‌خواستم بیشتر از یه ربع نشه. فکر کنم شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 758.01,
   "end": 759.91,
   "text": "نقطه مقابل توحید. احسن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 759.91,
   "end": 766.67,
   "text": "نقطه مقابل توحید. می‌خواستم قلب مرعوب رو دوباره بریم که تمومش کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 766.67,
   "end": 772.77,
   "text": "دیگه اواخر قلب مرعوبیم. ولی این به ذهنم رسید هدیه به شما شد امروز، رضا شما شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 772.77,
   "end": 777.35,
   "text": "اینکه چی باعث می‌شه ما به توحید نرسیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 777.35,
   "end": 781.33,
   "text": "چی باعث می‌شه ما اصلاً دنبال معرفت توحیدی نریم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 781.33,
   "end": 785.29,
   "text": "که بخواهیم با عبادتمون به یقین برسیم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 785.29,
   "end": 791.77,
   "text": "فرمود فاعبد ربک حتی یأتیک الیقین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 791.77,
   "end": 794.31,
   "text": "وعبد یا واو باید داشته باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 794.31,
   "end": 797.61,
   "text": "وعبد ربک حتی یأتیک الیقین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 797.61,
   "end": 802.31,
   "text": "انقدر پروردگارتو عبادت کن تا یقین برای تو حاصل بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 802.31,
   "end": 807.13,
   "text": "البته بعضی از مفسرین ذیل این یقین گفتن منظور موته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 807.13,
   "end": 811.61,
   "text": "یعنی تا لحظه موت عبادت پروردگارتو بکن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 811.61,
   "end": 815.39,
   "text": "اما چون عبادت معنای معرفت می‌ده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 815.39,
   "end": 817.57,
   "text": "به هر حال این معرفت یقین هم میاره دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 817.57,
   "end": 821.41,
   "text": "هرچی معرفت انسان بیشتر، یقین و باور توحیدی انسان بیشتر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 821.41,
   "end": 823.37,
   "text": "چرا ما از خیلی چیزا می‌ترسیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 823.37,
   "end": 825.73,
   "text": "چرا از دشمن می‌ترسیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 825.73,
   "end": 832.07,
   "text": "گاهیمون از یه سوسک می‌ترسیم، از تاریکی می‌ترسیم، از یه جنازه می‌ترسیم، از یه تهدید می‌ترسیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 832.07,
   "end": 838.31,
   "text": "از قلم مدیرمون یه ذره بد بچرخه می‌ترسیم، دلهره پیدا می‌کنیم، حقوقمون کم بشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 838.31,
   "end": 841.45,
   "text": "اضطراب پیدا می‌کنیم. چرا؟ اینا علتش چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 841.45,
   "end": 844.21,
   "text": "علتش اینه که دنیا تو چشم ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 844.21,
   "end": 850.47,
   "text": "بزرگ شده و ما معرفت توحیدی نداریم و راه سخت رو انتخاب کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 850.47,
   "end": 852.55,
   "text": "راه سخت، راه دنیاست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 214,
   "start": 852.55,
   "end": 857.15,
   "text": "طلب دنیاست. راه آسون و یسر،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 215,
   "start": 857.15,
   "end": 859.79,
   "text": "اون عسر بود. این یسر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 216,
   "start": 859.79,
   "end": 862.17,
   "text": "مطابق با فطرت پیش رفتنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 217,
   "start": 862.17,
   "end": 869.61,
   "text": "یعنی خداجو بودن، خداگو بودن، خدا خو بودن، خدا رو بودن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 218,
   "start": 869.61,
   "end": 874.69,
   "text": "همه شیت بوی خدا رو بده. البته باز دارم تاکید می‌کنم این حرف زدنش آسونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 219,
   "start": 874.69,
   "end": 877.75,
   "text": "البته حرف زدنشم سخته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 220,
   "start": 877.75,
   "end": 881.57,
   "text": "چه برسه به عملش. عملش دیگه باید--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 221,
   "start": 881.57,
   "end": 885.07,
   "text": "میگن کار هر بز نیست خرمن کوفتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 222,
   "start": 885.07,
   "end": 888.51,
   "text": "گوه نرم می‌خواد و- مرد کهن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 223,
   "start": 888.51,
   "end": 891.21,
   "text": "مرد کهن. واقعاً کار هر بز نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 224,
   "start": 891.21,
   "end": 895.15,
   "text": "حرف زدنش آسونه. اگرچه اون هم سخته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 225,
   "start": 895.15,
   "end": 897.45,
   "text": "پس این رو بیایید اصلاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 226,
   "start": 897.45,
   "end": 900.39,
   "text": "بنویسید، شعار روزمون کنیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 227,
   "start": 900.39,
   "end": 902.35,
   "text": "حواسمون بهش باشه چون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 228,
   "start": 902.35,
   "end": 904.65,
   "text": "شیطان اینا رو گم می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 229,
   "start": 904.65,
   "end": 907.81,
   "text": "یعنی از دستمون می‌کشه بیرون، از جلو چشممون می‌بره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 230,
   "start": 907.81,
   "end": 911.89,
   "text": "یه کاری می‌کنه اصلاً فراموش-- غفلت میاد بیچاره‌مون می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 231,
   "start": 911.89,
   "end": 913.99,
   "text": "چی رو؟ این فرمایش مولا رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 232,
   "start": 913.99,
   "end": 917.55,
   "text": "همین یه دونه رو. پیرهن-- اینکه چرا من",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 233,
   "start": 917.55,
   "end": 923.71,
   "text": "عثمان بن مزعون رو دوست داشتم با اینکه اسمش اسم بدترین دشمن مولا بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 234,
   "start": 923.71,
   "end": 925.97,
   "text": "اما اسم بچه‌شو می‌ذاره به اس-- به اون اسم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 235,
   "start": 925.97,
   "end": 928.25,
   "text": "خیلی عجیبه. فکر کنید بهش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 236,
   "start": 928.25,
   "end": 938.05,
   "text": "چرا؟ شاید بشه گفت مهم‌ترین خصوصیتش این بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 237,
   "start": 938.05,
   "end": 942.03,
   "text": "بخاطر اینکه صغرت دنیا فی عینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 238,
   "start": 942.03,
   "end": 945.89,
   "text": "اگر کسی دنیا تو چشمش کوچیک شد یعنی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 239,
   "start": 945.89,
   "end": 948.75,
   "text": "یعنی چی؟ یعنی خدا تو چشمش بزرگ شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 240,
   "start": 948.75,
   "end": 950.77,
   "text": "آخرت تو چشمش بزرگ شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 241,
   "start": 950.77,
   "end": 955.41,
   "text": "توحید براش بلد و برجسته شد، بزرگ شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 242,
   "start": 955.41,
   "end": 960.31,
   "text": "چنین کسی به همون میزان که توحید براش مهم شد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 243,
   "start": 960.31,
   "end": 966.41,
   "text": "زندگی توحیدی شد، سبک زندگیش به همون میزان تو چشم آقاش جا کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 244,
   "start": 966.41,
   "end": 970.39,
   "text": "انشاالله خدا ما رو تو چشم آقامون و تو دل آقامون جا کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 245,
   "start": 970.39,
   "end": 975.71,
   "text": "اللهم باریک لمولانا صاحب الزمان والحمد لله رب العالمين.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 246,
   "start": 975.71,
   "end": 980.63,
   "text": "صلوات. اللهم صل علی محمد و آل محمد",
