 },
 "chapters": [
  {
   "index": 0,
   "title": "توحید افعالی در آیهٔ شصت و سوم سورهٔ نمل:",
   "start": 28.44,
   "end": 48.46
  },
  {
   "index": 1,
   "title": "## روح و ریح در روایات",
   "start": 48.46,
   "end": 140.4
  },
  {
   "index": 2,
   "title": "آیهٔ چهل و سه و چهل و چهار فرقان:",
   "start": 140.4,
   "end": 194.52
  },
  {
   "index": 3,
   "title": "آیهٔ بیست و ششم ص:",
   "start": 194.52,
   "end": 267.88
  },
  {
   "index": 4,
   "title": "## مراتب نفس: روح، قلب، عقل",
   "start": 267.88,
   "end": 907.22
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 6.3,
   "end": 10.86,
   "text": "بسم الله الرحمن الرحیم و به این استعین السلام علیک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 10.86,
   "end": 13.44,
   "text": "یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 13.44,
   "end": 17.48,
   "text": "آیه. سلامٌ علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 17.48,
   "end": 20.18,
   "text": "توحید افعالی در آیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 20.18,
   "end": 23.8,
   "text": "شصت و سه سوره نمل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 23.8,
   "end": 28.44,
   "text": "أما يهديكم في ظلمات البر والبحر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 28.44,
   "end": 34.86,
   "text": "آیا اون کسی که شما رو هدایت می‌کنه در ظلمت‌های",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 34.86,
   "end": 38.86,
   "text": "زمین و دریا، در خشکی و دریا ظلمت‌هایی وجود دارد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 38.86,
   "end": 42.92,
   "text": "شما رو تو اون ظلمت‌ها هدایت می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 42.92,
   "end": 45.1,
   "text": "آیا این به درد بخوره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 45.1,
   "end": 47.38,
   "text": "آیا این خدای خوبیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 47.38,
   "end": 50.48,
   "text": "یا اون شریک‌هایی که شما می‌گیرید،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 50.48,
   "end": 55.7,
   "text": "این نهییه و کسایی که از توحید فاصله گرفتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 55.7,
   "end": 58.78,
   "text": "و من يرسل الرياح",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 58.78,
   "end": 60.7,
   "text": "بشرا بين يدي رحمته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 60.7,
   "end": 64.6,
   "text": "چقدر شیرینه این آیه. و اون خداییه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 64.6,
   "end": 71.44,
   "text": "يرسل. یه جای دیگه تو قرآن می‌فرماید هو الذي يرسل الرياح بشرا بين يدي رحمته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 71.44,
   "end": 77.06,
   "text": "خدا خودشو اینجوری معرفی می‌کنه که اون کسیه که ارسال می‌کنه بادها رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 77.06,
   "end": 80.2,
   "text": "که انَّ بادها رسولان الهی هستن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 80.2,
   "end": 83.84,
   "text": "جالبه. يرسل، يرسل الرياح یعنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 83.84,
   "end": 86.92,
   "text": "ارسال باد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 86.92,
   "end": 91.8,
   "text": "ريح. که این‌ها می‌شن رسول الهی دیگه خدا فرستاده‌شون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 91.8,
   "end": 96.94,
   "text": "اصلاً ما تا حالا در خصوص باد اینطوری فکر کردیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 96.94,
   "end": 101.78,
   "text": "که این رسول خداست. باد فرستاده خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 101.78,
   "end": 104.64,
   "text": "صریح آیه قرآن اینو داره می‌فرماید دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 104.64,
   "end": 108.38,
   "text": "و من يرسل الرياح. کیه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 108.38,
   "end": 111.76,
   "text": "بادها رو ارسال می‌کنه، می‌فرسته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 111.76,
   "end": 115.88,
   "text": "فقط رسولان-- انبیا رسول نیستن که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 115.88,
   "end": 118.68,
   "text": "باد هم فرستاده خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 118.68,
   "end": 121.2,
   "text": "بشرا بين يدي رحمته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 121.2,
   "end": 124.3,
   "text": "این بشارت میده یک رحمتی از سمت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 124.3,
   "end": 127.08,
   "text": "ص-- ناحیه مقدسه حضرت حق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 127.08,
   "end": 130.48,
   "text": "که بشارت آفرینه برای همه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 130.48,
   "end": 134.1,
   "text": "حالا الان عرض می‌کنیم با توجه به بعض از روایات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 134.1,
   "end": 136.74,
   "text": "که چگونه بشارتی درشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 136.74,
   "end": 140.4,
   "text": "بعد اینجا تصریح داره أأله مع الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 140.4,
   "end": 146.94,
   "text": "آیا همراه الله شما الهه دیگر، دیگری رو هم جرات کردی به اختیار کنی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 146.94,
   "end": 150.26,
   "text": "کدوم یکی از این‌ها؟ چه هدایت در ظلمت‌های",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 150.26,
   "end": 155.7,
   "text": "خشکی و دریا، چه ارسال بادها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 155.7,
   "end": 161.04,
   "text": "کیو سراغ دارید که بتونه توانمندی این چنینی داشته باشه و قدرت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 161.04,
   "end": 166.88,
   "text": "چنینی. لذا می‌فرماید تعالى الله اگرچه انگار خدا خودش ناامیده از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 166.88,
   "end": 169.54,
   "text": "ایمان آوردن اینا و توحیدشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 169.54,
   "end": 171.52,
   "text": "تعالى الله أما يشركون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 171.52,
   "end": 173.96,
   "text": "ما گفتیم اما شما باز اون شرکتون رو دارید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 173.96,
   "end": 179.12,
   "text": "تعالى الله أما يشركون. از اون شرکی که شما می‌ورزید تعالى الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 179.12,
   "end": 181.82,
   "text": "خدا بالاتر از این حرف‌هاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 181.82,
   "end": 183.6,
   "text": "اگرچه حرف ما رو شما قبول نمی‌کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 183.6,
   "end": 187.56,
   "text": "خیلی جالب بود که حالا قبلاً در سیره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 187.56,
   "end": 191.46,
   "text": "معرفت نفس مسجد بلال ما در خصوص",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 191.46,
   "end": 195.64,
   "text": "ريح و ربطش با روح و هوا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 195.64,
   "end": 198.48,
   "text": "سخن گفته بودیم. حالا نمی‌دونم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 198.48,
   "end": 201.9,
   "text": "از این دوستانی که اینجا هستن کی اونجا حاضر بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 201.9,
   "end": 206.56,
   "text": "یه چند تا روایت تقدیم کنم کیف کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 206.56,
   "end": 209.36,
   "text": "اولاً امام باقر سلام الله علیه فرمود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 209.36,
   "end": 214.42,
   "text": "إن الروح متحرک كالريح.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 214.42,
   "end": 218.86,
   "text": "روح مثل ريح یعنی مثل باد متحرکه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 218.86,
   "end": 221.58,
   "text": "و انما سمي روحا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 221.58,
   "end": 223.78,
   "text": "لانه اشتق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 223.78,
   "end": 228.14,
   "text": "اسمه من الريح.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 228.14,
   "end": 233.1,
   "text": "روح، روح همین روحی که و نفخت فيه من روحي.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 233.1,
   "end": 237.14,
   "text": "این روح انشقاقش از اسم رِيحه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 237.14,
   "end": 240.24,
   "text": "یعنی گر-- اسمش، کلمه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 240.24,
   "end": 242.88,
   "text": "روح گرفته شده از رِيحه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 242.88,
   "end": 246.22,
   "text": "اگرچه حقیقت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 246.22,
   "end": 248.42,
   "text": "ريح برمی‌گرده به خود روح.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 248.42,
   "end": 252.04,
   "text": "اما کلمه‌ش روح از ريح گرفته شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 252.04,
   "end": 256.82,
   "text": "و انما اخرجه عن لفظ الريح.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 256.82,
   "end": 261.72,
   "text": "از لفظ ريح یعنی باد، روح خارج شده و گرفته شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 261.72,
   "end": 265.94,
   "text": "لأن الأرواح مجانسه للريح.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 265.94,
   "end": 270.08,
   "text": "خیلی جالبه. فرمود که ارواح هم جنس با",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 270.08,
   "end": 275.56,
   "text": "ريحن. یعنی این روحی که در ما دمیده شده هم جنس با بادن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 275.56,
   "end": 279.92,
   "text": "هم جنسه. همین بادی که میاد که رحمت خداست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 279.92,
   "end": 283.92,
   "text": "که انَّ این روحی هم که در ماست رحمت خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 283.92,
   "end": 287.68,
   "text": "از رحمت خدا منتشر شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 287.68,
   "end": 290.78,
   "text": "و انما أضافه إلى نفسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 290.78,
   "end": 294.06,
   "text": "این اضافه شده به نفس، نفس الهی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 294.06,
   "end": 295.78,
   "text": "و نفخت فيه من روحي دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 295.78,
   "end": 297.7,
   "text": "از روح خودم دمیدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 297.7,
   "end": 302.34,
   "text": "یا روح الله میگه. این روح الله اضافه شده به نفس الهی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 302.34,
   "end": 305.96,
   "text": "انقدر که این روح عظيمه خود ريح",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 305.96,
   "end": 308.4,
   "text": "به قدری عظمت داره اضافه شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 308.4,
   "end": 312.4,
   "text": "خیلی. روح ما اضافه شده به نفس الهی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 312.4,
   "end": 320.08,
   "text": "انقدر که با عظمته. یه روایت دیگه از پیغمبر عزیز عالم داریم که لا تسب الريح فإنها من روح الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 320.08,
   "end": 326.22,
   "text": "به باد دشنام ندید. بعضی‌ها میگن اه این باده فلان فلان شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 326.22,
   "end": 331.08,
   "text": "میگه دشنام ندید. چرا؟ فإنها من روح الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 331.08,
   "end": 334.5,
   "text": "باد از روح الهیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 334.5,
   "end": 337.14,
   "text": "چقدر جالب! یعنی جنسش از روحه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 337.14,
   "end": 340.36,
   "text": "همین روحی که در شما، شما دمیده شده‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 340.36,
   "end": 346.78,
   "text": "دیدی باد که وقتی میاد چقدر-- وقتی که باد میاد یه خار و خسا، خسکی از رو زمین بلند می‌کنه، یه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 346.78,
   "end": 349.6,
   "text": "بالاخره گرد و خاکی چیزی درست می‌کنه از خودش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 349.6,
   "end": 355.4,
   "text": "اما بعداً می‌بینی بارش باران بعدش در پی داره و بعد از بارش بارانم که طراوت و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 355.4,
   "end": 358.06,
   "text": "این‌ها. یا باز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 358.06,
   "end": 363.14,
   "text": "داریم که یه روایت دیگه از اهل بیت تقدیم کنم خیلی شیرین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 363.14,
   "end": 367.15,
   "text": "الريح هواء ریح یعنی همین باد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 367.15,
   "end": 371.41,
   "text": "وقتی که حرکت نمی‌کنه اسمش چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 371.41,
   "end": 374.81,
   "text": "هواس. هوا. صریح آیه قرآن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 374.81,
   "end": 377.87,
   "text": "حرکت که نمی‌کنه همون هواست دیگه اسمش هواست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 377.87,
   "end": 382.45,
   "text": "می‌فرماید: \"الريح هواء إذا تحرك سمي ريحا\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 382.45,
   "end": 387.55,
   "text": "این هوا وقتی حرکت کرد اسمش میشه ريح یعنی باد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 387.55,
   "end": 392.15,
   "text": "\"وإذا سکن\" وقتی ساکن شد \"سمي هواء\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 392.15,
   "end": 394.63,
   "text": "ساکن که شد اسمش هست هواء.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 394.63,
   "end": 397.49,
   "text": "\"وبه هي قوام الدنيا\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 397.49,
   "end": 399.73,
   "text": "و قوام دنیا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 399.73,
   "end": 403.01,
   "text": "انسان-- دنیا انگار قیامش به همین باده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 403.01,
   "end": 406.29,
   "text": "اگه نباشه دنیا به هم می‌ریزه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 406.29,
   "end": 409.85,
   "text": "\"ولو کف الريح ثلاثة أيام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 409.85,
   "end": 412.95,
   "text": "لفصد کل شيء على وجه الأرض\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 412.95,
   "end": 416.33,
   "text": "اگر سه روز باد نیاد امام حسن داره می‌فرماد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 416.33,
   "end": 419.81,
   "text": "سه روز باد نیاد هرچی رو زمینه \"لفصد\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 419.81,
   "end": 424.93,
   "text": "قطعا فاسد می‌شه و \"نطع\" یعنی بو می‌گیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 424.93,
   "end": 427.03,
   "text": "\"وذلك\" حالا اینو می‌زنه به چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 427.03,
   "end": 429.17,
   "text": "می‌زنش به روح. خیلی قشنگ.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 429.17,
   "end": 432.97,
   "text": "\"وذلك أن الريح بمنزلة المروحة\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 432.97,
   "end": 435.11,
   "text": "میگه این باد مثل یه پنکه ایه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 435.11,
   "end": 436.73,
   "text": "مروحة به عربی یعنی پنکه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 436.73,
   "end": 443.43,
   "text": "\"تذب وتتفعل فساد عن کل شيء\" از هر چیزی فساد رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 443.43,
   "end": 445.83,
   "text": "مثل پنکه چجوری فساد رو برطرف می‌کنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 445.83,
   "end": 448.77,
   "text": "قدیم‌ها گوشت رو می‌ذاشتن جلو پنکه خراب نشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 448.77,
   "end": 451.33,
   "text": "این همینجوری فساد رو برطرف می‌کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 451.33,
   "end": 455.15,
   "text": "و \"تطيب\" پاکیزه می‌کنه همه چی رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 455.15,
   "end": 459.83,
   "text": "\"فهي بمنزلة الروح\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 459.83,
   "end": 464.17,
   "text": "این باد مثل روحه، همین روحی که در ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 464.17,
   "end": 466.71,
   "text": "\"إذا خرج من البدن نطع البدن\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 466.71,
   "end": 469.03,
   "text": "وقتی که از بدن پار-- خارج می‌شه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 469.03,
   "end": 471.39,
   "text": "بدن بو می‌گیره، فاسد می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 471.39,
   "end": 478.41,
   "text": "این باد هم اگر از دنیا خارج بشه، از کالبد و بدن دنیا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 478.41,
   "end": 482.73,
   "text": "مثل روحی که از بدنت خارج شد، بدن فاسد می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 482.73,
   "end": 487.67,
   "text": "این باد اگر از کالبد و بدن دنیا از طبیعت دنیا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 487.67,
   "end": 490.81,
   "text": "خارج بشه، فساد دنیا رو برمی‌داره و می‌میره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 490.81,
   "end": 500.01,
   "text": "دنیا می‌میره. و جالبه که اونجا هم می‌فرماید: \"اگر باد حرکت نکنه اسمش هست هواء\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 500.01,
   "end": 503.43,
   "text": "حالا روح اگر حرکت نکنه اسمش چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 503.43,
   "end": 505.71,
   "text": "خود روح. جسم. جان؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 505.71,
   "end": 509.75,
   "text": "جسم. نه جسم که داره حرکت می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 509.75,
   "end": 513.59,
   "text": "روح هم اگر حرکت نکنه باز اسمش هست هواء.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 513.59,
   "end": 516.25,
   "text": "اما چه هوایی؟ هوای نفس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 516.25,
   "end": 519.45,
   "text": "آفرین. روح وقتی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 519.45,
   "end": 523.15,
   "text": "فساد بگیرتش، فسیل بشه، یه میشه مثل یه مرده‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 523.15,
   "end": 525.77,
   "text": "هیچ حرکتی براش وارد نشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 525.77,
   "end": 531.69,
   "text": "یعنی اصلا تفکر کردن و در قرآن \"ويتفكرون في خلق السماوات والأرض",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 531.69,
   "end": 538.21,
   "text": "ربنا ما خلقت هذا باطلا سبحانك فقنا عذاب النار\" چقدر در خصوص تفکر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 538.21,
   "end": 541.95,
   "text": "حرف زده قرآن. چون تفکر حرکته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 541.95,
   "end": 544.97,
   "text": "دقت بفرمایین. حرکت نفس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 544.97,
   "end": 548.87,
   "text": "از معلوم به مجهوله. یعنی must-- معلوماتش رو دسته‌بندی می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 548.87,
   "end": 553.81,
   "text": "از این معلومات می‌خواد برسه به مجهولات که مجهولات براش معلوم بشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 553.81,
   "end": 556.59,
   "text": "به این میگن در منطق فکر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 556.59,
   "end": 558.41,
   "text": "سیر فکری به این شکله دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 558.41,
   "end": 564.21,
   "text": "حالا اگر انسان تفکر نداشته باشه، تعقل نداشته باشه، منظرم می‌خوام مثل حیوان زندگی کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 564.21,
   "end": 567.77,
   "text": "چی می‌شه؟ دچار هوای نفس می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 567.77,
   "end": 571.59,
   "text": "یا من چیکار کنم از هوای نفس خلاصی پیدا کنم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 571.59,
   "end": 574.21,
   "text": "حرکت کن. روحت باید حرکت کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 574.21,
   "end": 578.75,
   "text": "اینم آیه اش که نگید. آقا خونده از خودشون از تو آستینشون در میارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 578.75,
   "end": 581.41,
   "text": "آیه چهل و سه و چهل و چهار سوره فروان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 581.41,
   "end": 584.55,
   "text": "\"أَرَأَيْتَ مَنِ اتَّخَذَ إِلَهَهُ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 584.55,
   "end": 587.97,
   "text": "هَوَاهُ\" هواء.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 587.97,
   "end": 592.31,
   "text": "آیا اون کسی که هوای خودش رو اله خودش قرار داده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 592.31,
   "end": 599.83,
   "text": "\"أَفَأَنتَ تَكُونُ عَلَيْهِ وَكِيلًا\" آیا تو می‌تونی ضامنش بشی یا پیغمبر یا رسول الله تو هم نمی‌تونی ضامنش بشی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 599.83,
   "end": 601.55,
   "text": "کسی که هوای نفسش رو اختیار کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 601.55,
   "end": 604.61,
   "text": "\"أَمْ تَحْسَبُ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 604.61,
   "end": 607.63,
   "text": "أَنَّ أَكْثَرَهُمْ يَسْمَعُونَ أَوْ يَعْقِلُونَ\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 607.63,
   "end": 610.09,
   "text": "یا گمان می‌کنی که اینا بسیارشون اهل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 610.09,
   "end": 613.77,
   "text": "اصلا گوش دادن و عرض شود شنیدنن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 613.77,
   "end": 616.43,
   "text": "یا اهل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 616.43,
   "end": 618.57,
   "text": "تع-- \"يَعْقِلُونَ\" اهل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 618.57,
   "end": 621.23,
   "text": "تعقل و تدبر و تفکر و اینا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 621.23,
   "end": 627.99,
   "text": "\"إِنْ هُمْ إِلَّا\" \"إِنْ هُمْ\" اینا نیستن مگر \"كَالْأَنْعَامِ\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 627.99,
   "end": 630.41,
   "text": "جسارتمو ببخشید. قرآن داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 630.41,
   "end": 632.19,
   "text": "قرآن بی‌ادبی نمی‌کنه که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 632.19,
   "end": 636.01,
   "text": "فحش نمیده که. داره پرده‌پرده از یه حقیقتی رو می‌کنه به قول علما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 636.01,
   "end": 638.99,
   "text": "\"إِنْ هُمْ إِلَّا كَالْأَنْعَامِ\" اینا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 638.99,
   "end": 642.49,
   "text": "اینایی که روحشون حرکت نداره داداش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 642.49,
   "end": 645.05,
   "text": "شبیه کی‌ان؟ \"كَالْأَنْعَامِ\" بلکه بدتر از اون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 645.05,
   "end": 648.73,
   "text": "\"بَلْ هُمْ أَوَلُ سَبِيلًا\" اصلا راهشون بدترین راهه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 648.73,
   "end": 652.35,
   "text": "\"أَوَلُ سَبِيلًا\" میگه اصلا بدترین راه رو دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 652.35,
   "end": 655.35,
   "text": "یه آیه بیست و شش سوره ساد رو هم تقدیم کنم و بسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 655.35,
   "end": 658.39,
   "text": "\"وَلَا تَتَّبِعِ الْهَوَى\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 658.39,
   "end": 660.45,
   "text": "هواء رو پی-پیروی نکن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 660.45,
   "end": 662.13,
   "text": "این هواء روحیه که ساكنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 662.13,
   "end": 664.67,
   "text": "\"وَلَا تَتَّبِعِ الْهَوَى",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 664.67,
   "end": 668.79,
   "text": "فَيُضِلَّكَ عَنْ سَبِيلِ اللَّهِ\" باعث می‌شه که تو رو از راه خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 668.79,
   "end": 671.13,
   "text": "دور کنه. \"إِنَّ الَّذِينَ يَضِلُّونَ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 671.13,
   "end": 675.59,
   "text": "عَنْ سَبِيلِ اللَّهِ\" اون کسی که از راه خدا دور شد یعنی روحش رو رها کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 675.59,
   "end": 677.65,
   "text": "روحش فسیل شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 677.65,
   "end": 682.81,
   "text": "روحش حرکت نداشت. \"لَهُمْ عَذَابٌ شَدِيدٌ\" خدا به که عذاب شدید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 682.81,
   "end": 688.49,
   "text": "الله اکبر. \"بِمَا نَسُوا يَوْمَ الْقِيَامَةِ\" چون روز قیامت رو فراموش کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 688.49,
   "end": 694.05,
   "text": "جانم. استاد یه جای میگه نفس همون روح.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 694.05,
   "end": 696.33,
   "text": "روح یک رتبه از نفسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 696.33,
   "end": 699.33,
   "text": "مرحله عالی نفس می‌شه روح.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 699.33,
   "end": 702.17,
   "text": "سؤال قشنگی بود. نفس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 702.17,
   "end": 704.95,
   "text": "یک حقیقتیست که رتبه‌های متعدد داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 704.95,
   "end": 709.11,
   "text": "ذو مراتبه. عالی‌ترین یا اشمخه آقای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 709.11,
   "end": 711.91,
   "text": "عبدالرضا. اشمخ مراتب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 711.91,
   "end": 717.11,
   "text": "نفس می‌شه روح. بعد یه رتبه پایین‌ترش می‌شه قلب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 717.11,
   "end": 718.93,
   "text": "که مقام واحدیته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 718.93,
   "end": 721.25,
   "text": "روح والا‌تر از نفسه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 721.25,
   "end": 724.75,
   "text": "روح رتبه عالی خود نفسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 724.75,
   "end": 728.13,
   "text": "نفس چیه؟ نفس برزخ بین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 728.13,
   "end": 731.08,
   "text": "باطن و ظاهره. ظاهر بدن ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 731.08,
   "end": 733.08,
   "text": "باطن ذات غیبی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 733.08,
   "end": 735.92,
   "text": "نفس با تمام مراتبش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 735.92,
   "end": 738.64,
   "text": "فیض رو از حق می‌گیره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 738.64,
   "end": 741.6,
   "text": "و به خود شما میده نفس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 741.6,
   "end": 745.6,
   "text": "فیض رو از خدا می‌گیره به خود شما میده و لو حتی به بدنت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 745.6,
   "end": 747.5,
   "text": "بدن تحت تصرف نفسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 747.5,
   "end": 751.38,
   "text": "نفس هم در حقیقت بدن رو داره ارتقا میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 751.38,
   "end": 753.32,
   "text": "نفس داره همه کار می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 753.32,
   "end": 758.24,
   "text": "مثلا شما الان داری می‌بینی این چشم داره می‌بینه یا نفس می‌بینه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 758.24,
   "end": 761.16,
   "text": "نفس می‌بینه. چون اگر قرار باشه این چشم ببینه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 761.16,
   "end": 764.18,
   "text": "چرا وقتی خوابیدی چشمت بسته است باز چیزی می‌بینی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 764.18,
   "end": 766.5,
   "text": "تو خواب می‌خوری، راه میری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 766.5,
   "end": 769.94,
   "text": "پس نفسه که می‌خوره، می‌شنوه، حرف می‌زنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 769.94,
   "end": 772.36,
   "text": "همه کارا نفسه. نفس هم خستگی بردار نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 772.36,
   "end": 779.34,
   "text": "حالا رتبه هاش روحه که بیرون از ما در عالم آف-- در نظام آفاقی در اصل تطابق بین انسان و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 779.34,
   "end": 782.56,
   "text": "آدم و عالم، در عالم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 782.56,
   "end": 784.98,
   "text": "مرتبه احدیت که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 214,
   "start": 784.98,
   "end": 788.72,
   "text": "زا-- می‌زننش به ذات غیبی هست روح.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 215,
   "start": 788.72,
   "end": 790.38,
   "text": "روح ما از اون مرتبه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 216,
   "start": 790.38,
   "end": 793.96,
   "text": "یه پله پایین‌تر مرتبه واحدیت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 217,
   "start": 793.96,
   "end": 797.24,
   "text": "که مرتبه میشه فیض مقدس بال--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 218,
   "start": 797.24,
   "end": 799.64,
   "text": "فیض ابدس ببخشید، اونجا میشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 219,
   "start": 799.64,
   "end": 801.54,
   "text": "یا اعیان ثابته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 220,
   "start": 801.54,
   "end": 803.92,
   "text": "میشه قلب. مرتبه قلبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 221,
   "start": 803.92,
   "end": 806.78,
   "text": "یه رتبه پایین‌تر میشه جبروت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 222,
   "start": 806.78,
   "end": 808.74,
   "text": "عقله. یه رتبه پایین‌تر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 223,
   "start": 808.74,
   "end": 812.98,
   "text": "حالا اون جبروت، لاهوت اینا که میگن بیرون از ماست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 224,
   "start": 812.98,
   "end": 814.9,
   "text": "در ما این اسم دومه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 225,
   "start": 814.9,
   "end": 817.4,
   "text": "روح، قلب،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 226,
   "start": 817.4,
   "end": 821.26,
   "text": "عقل. جبروت بیرون، عقل درون ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 227,
   "start": 821.26,
   "end": 825.6,
   "text": "ملکوت بیرون، رتبه مثال یا خیال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 228,
   "start": 825.6,
   "end": 829.12,
   "text": "در درون ما. حالا نشئه طبیعت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 229,
   "start": 829.12,
   "end": 831.88,
   "text": "در نظام آفاقی یعنی خارج از من.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 230,
   "start": 831.88,
   "end": 837.98,
   "text": "در من چی؟ معادل نشئه طبیعت در من میشه چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 231,
   "start": 837.98,
   "end": 841.56,
   "text": "بدنم دیگه. انزل مراتبم که بدنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 232,
   "start": 841.56,
   "end": 845.36,
   "text": "حالا نفس پس میشه برزخ بین ظاهر و باطن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 233,
   "start": 845.36,
   "end": 848.28,
   "text": "پس، پس در نهایت نتیجه می‌گیریم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 234,
   "start": 848.28,
   "end": 852.28,
   "text": "من گروبانگیر نفس هست تا اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 235,
   "start": 852.28,
   "end": 855.16,
   "text": "کل نفس هم در- بله، بله دقیقاً.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 236,
   "start": 855.16,
   "end": 857.22,
   "text": "به اون وجه آزاد کار- احسنت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 237,
   "start": 857.22,
   "end": 859.2,
   "text": "آفرین. نکته‌ی خیلی خوبی بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 238,
   "start": 859.2,
   "end": 861.26,
   "text": "بله، بله خیلی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 239,
   "start": 861.26,
   "end": 863.36,
   "text": "نه-- اصلاً حدیث داریم. حالا فرصت نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 240,
   "start": 863.36,
   "end": 865.72,
   "text": "هم تو همین کتاب تصویب کوثر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 241,
   "start": 865.72,
   "end": 870.5,
   "text": "روایت داریم که روح مثل خورشید و تو شعاع اونی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 242,
   "start": 870.5,
   "end": 873.48,
   "text": "خورشید چگونه از بالا داره می‌تابه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 243,
   "start": 873.48,
   "end": 875.56,
   "text": "یه شعاعی از این به اون-- روح",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 244,
   "start": 875.56,
   "end": 878.94,
   "text": "در عالم بالا است. یعنی اون مرتبش عالیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 245,
   "start": 878.94,
   "end": 882.14,
   "text": "اعلا است. بخشی از ذات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 246,
   "start": 882.14,
   "end": 883.92,
   "text": "احدیت هست. احسن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 247,
   "start": 883.92,
   "end": 888.54,
   "text": "یعنی روح مبدا- بارک الله. اصلاً مشوب به کثرت نیست دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 248,
   "start": 888.54,
   "end": 891.68,
   "text": "روحه. مرتبه احدیت. جمع الجمع.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 249,
   "start": 891.68,
   "end": 894.02,
   "text": "اصلاً مشوب به کثرت نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 250,
   "start": 894.02,
   "end": 898.08,
   "text": "اللهم بارک لمولانا صاحب الزمان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 251,
   "start": 898.08,
   "end": 900.18,
