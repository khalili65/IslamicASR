 "chapters": [
  {
   "index": 0,
   "title": "## هرچه بنگری بوی توحید می‌دهد",
   "start": 0.44,
   "end": 68.84
  },
  {
   "index": 1,
   "title": "## کتاب انفسی؛ انسان کامل",
   "start": 68.84,
   "end": 192.46
  },
  {
   "index": 2,
   "title": "## کتاب آفاقی؛ انسان کبیر",
   "start": 192.46,
   "end": 417.18
  },
  {
   "index": 3,
   "title": "## هفتاد هزار معنا؛ اقرأ وَارْقَ",
   "start": 417.18,
   "end": 640.14
  },
  {
   "index": 4,
   "title": "## نتیجهٔ مقدمه و کاشف الاسرار",
   "start": 640.14,
   "end": 871.56
  },
  {
   "index": 5,
   "title": "## تداعی نام زهرا و حسّ شنوایی میّت",
   "start": 871.56,
   "end": 1022.24
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.44,
   "end": 10.44,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 10.44,
   "end": 15.7,
   "text": "السلام علیک یا داعی الله و ربانی آیات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 15.7,
   "end": 20.68,
   "text": "السلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 20.68,
   "end": 28.94,
   "text": "ما هرچی که پیرامونمون نگاه کنیم اگر با دیده عقلی ببینیم عزیزان همه چی بوی توحید میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 28.94,
   "end": 32.28,
   "text": "هیچ چیزی نیست که بوی توحید رو نده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 32.28,
   "end": 39.24,
   "text": "پیش از این که آیه جدیدمون رو مورد توجه قرار بدیم یه مقدمه ای بچینم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 39.24,
   "end": 43.04,
   "text": "ببینید پروردگار سبحان، ذات غیبی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 43.04,
   "end": 45.96,
   "text": "که ام من شیء ان الله عندنا خزائنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 45.96,
   "end": 49.12,
   "text": "هیچ چیزی نیست مگر اینکه خزائنش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 49.12,
   "end": 52.64,
   "text": "تازه خزینه جمع خزائنش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 52.64,
   "end": 55.42,
   "text": "عندنا، نزد حضرت حق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 55.42,
   "end": 58.6,
   "text": "وقتی او خواست ظهور کنه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 58.6,
   "end": 63.6,
   "text": "کلاً ظهور حق به سه شکل خودش رو نشون داده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 63.6,
   "end": 67.06,
   "text": "به یک معنا میشه گفت سه کتاب جلوه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 67.06,
   "end": 70.66,
   "text": "حضرت حق شده. یکی کتاب انفسیه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 70.66,
   "end": 74.34,
   "text": "جان آدم. آدم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 74.34,
   "end": 78.48,
   "text": "که وجه اتمش از حیث اخذ فیض و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 78.48,
   "end": 82.02,
   "text": "پیاده شدن همه اسماء و صفات به نحو اتم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 82.02,
   "end": 86.68,
   "text": "میشه انسان کامل، میشه امام معصوم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 86.68,
   "end": 89.84,
   "text": "و اصلاً وجود آدم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 89.84,
   "end": 92.44,
   "text": "تجلی اعظم حضرت حقه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 92.44,
   "end": 99.72,
   "text": "ته هم نداره. شما هرچی بخوای بری دنبال حقیقت خودت بگردی که آقا آخر حقیقت من چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 99.72,
   "end": 105.68,
   "text": "پیداش نمی‌کنی. چون اون کسی که شما رو خلق کرده لایتناهیه، انتها نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 105.68,
   "end": 108.76,
   "text": "شما هم به وزان حق خلق شدی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 108.76,
   "end": 113.14,
   "text": "یعنی شما سر تا پا از انزل مراتبت که بدنه ته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 113.14,
   "end": 115.48,
   "text": "همینطوری بگیر برو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 115.48,
   "end": 118.8,
   "text": "تا قوه خیالت که ملکوتته،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 118.8,
   "end": 122.12,
   "text": "عقلت که جبروتته، قلبت که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 122.12,
   "end": 125.22,
   "text": "واحدیت وجودته، روحت که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 125.22,
   "end": 131.7,
   "text": "احدیت وجودته، سرت که کانال ارتباطیت با ذات غیبیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 131.7,
   "end": 134.0,
   "text": "همه و همه بوی حضرت حق رو میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 134.0,
   "end": 137.46,
   "text": "تو پیاده شده عالم علوی هستی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 137.46,
   "end": 140.26,
   "text": "درسته ما توجه‌مون به عالم سفلی افتاده و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 140.26,
   "end": 143.94,
   "text": "صرفاً دنیا و ظلمت سرا و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 143.94,
   "end": 151.52,
   "text": "همه هم و غممون هم افتاده به اینکه به بدنمون برسیم و به این انزل مراتب و به طبیعت و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 151.52,
   "end": 157.36,
   "text": "به ان-- یعنی به اون مرتبه دنی که دنیاست پست فلسفیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 157.36,
   "end": 163.24,
   "text": "اما ما از یعنی بیدهی ملکوت کل شی حقیقت وجودیمون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 163.24,
   "end": 165.46,
   "text": "که هممون هم ازش بی‌خبریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 165.46,
   "end": 170.34,
   "text": "اون حدیث من عرف که اگر کسی خودش رو شناخت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 170.34,
   "end": 172.56,
   "text": "من عرف نفسه فقد عرف ربّه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 172.56,
   "end": 174.62,
   "text": "ما از حقیقت وجودی‌مون نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 174.62,
   "end": 178.76,
   "text": "ما حقیقت وجودی‌مون رو بی‌خبریم و هیچ‌کس نمی‌تونه باخبر بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 178.76,
   "end": 180.84,
   "text": "چون وصل به ذات غیبی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 180.84,
   "end": 185.1,
   "text": "هیچ‌کس نمی‌تونه. ما جز اینو نمی‌تونیم به کل احاطه پیدا کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 185.1,
   "end": 188.26,
   "text": "اوست که به همه احاطه داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 188.26,
   "end": 191.36,
   "text": "او که معو-- معیت قیومیه داره با همه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 191.36,
   "end": 194.7,
   "text": "این از خود ما. این یه کتاب. اصلاً انتها هم نداریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 194.7,
   "end": 198.8,
   "text": "تو چه جوری، چه جوری می‌خوای حقیقت خودت رو تهش رو پیدا کنی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 198.8,
   "end": 203.88,
   "text": "تهش وصل به حقه. همه هم و انا الیه راجعون به سمت او بر می‌گردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 203.88,
   "end": 207.08,
   "text": "یک کتاب دیگه‌ای که در حقیقت شرح",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 207.08,
   "end": 214.62,
   "text": "عینی این کتابه که بر اساس اصل تطابق بین آدم و عالم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 214.62,
   "end": 219.16,
   "text": "هرچی که در ما هست پیاده شده در خارج.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 219.16,
   "end": 223.34,
   "text": "هرچی در آدم هست پیاده شده در عالم خارج.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 223.34,
   "end": 225.36,
   "text": "عالم خارج رو می‌گن نظام افاقی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 225.36,
   "end": 228.26,
   "text": "بهش می‌گن انسان کبیر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 228.26,
   "end": 231.0,
   "text": "ما هستیم عالم صغیر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 231.0,
   "end": 239.22,
   "text": "عالم رو اگر ام پی تریش کنی به یک معنا فشرده سازیش کنی میشه عالم رو فشرده ش-- سازیش کنی میشه آدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 239.22,
   "end": 242.68,
   "text": "حالا آدم رو باز کن عینیّت خارجی بهش ببخش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 242.68,
   "end": 246.56,
   "text": "میشه نظام افاقی. میشه کتاب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 246.56,
   "end": 250.74,
   "text": "عینی. اونم ته نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 250.74,
   "end": 256.54,
   "text": "چرا اون ته نداره؟ اگرچه شرح کتاب وجودی انسانه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 256.54,
   "end": 260.18,
   "text": "هرچی در بیرون هست در ما هم هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 260.18,
   "end": 265.32,
   "text": "بدون استثناء. تمام عوالم هستی، اگر پیغمبر عزیز عالم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 265.32,
   "end": 269.22,
   "text": "در یک معراجش هجده هزار عالم، در یک معراجش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 269.22,
   "end": 275.52,
   "text": "شونزده هزار عالم، در یک معراجش شهید اول میگه دوازده هزار عالم رفته دیده، همه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 275.52,
   "end": 276.88,
   "text": "این‌ها در وجود ما هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 276.88,
   "end": 280.26,
   "text": "پیغمبر در خودش سیر کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 280.26,
   "end": 286.86,
   "text": "ما بی‌خبریم ازش. اون‌ها اومدن که ما رو متوجه این حقایق کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 286.86,
   "end": 288.72,
   "text": "اینا همه بیرون هست در خارج.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 288.72,
   "end": 291.44,
   "text": "اونم تازه عینیّت انسانه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 291.44,
   "end": 294.3,
   "text": "اونم انتها نداره. تهش رو کی دیده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 294.3,
   "end": 297.58,
   "text": "بیدهی ملکوت و کل شی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 297.58,
   "end": 302.3,
   "text": "اون اشیاء بیرونی هم که عینیّت وجودمان، اونم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 302.3,
   "end": 304.5,
   "text": "شیعه دیگه. اونم بیدهی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 304.5,
   "end": 306.16,
   "text": "ملکوتش دست خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 306.16,
   "end": 309.1,
   "text": "هیچ‌کس ازش خبر نداره جز خود حضرت حق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 309.1,
   "end": 313.46,
   "text": "چون وصل میشه به حضرت حق، به ذات غیبی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 313.46,
   "end": 318.94,
   "text": "توجه کردی چه اسماء مستثنی خودش که حتی پیغمبر هم ازش بی‌خبره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 318.94,
   "end": 321.6,
   "text": "مخصوص خودشه. اونم ته نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 321.6,
   "end": 325.76,
   "text": "یعنی شما تک‌تک این کلمات وجودی نظام هستی رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 325.76,
   "end": 328.46,
   "text": "نگاه کنی همشون بوی توحید میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 328.46,
   "end": 331.14,
   "text": "بوی خدای رحمان میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 331.14,
   "end": 339.24,
   "text": "بدون استثناء. الان سگ دست ما جسارتاً نم باشه بزنیم به سگ، دستمون نجس میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 339.24,
   "end": 341.7,
   "text": "درسته؟ مرطوب باشه شرعاً.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 341.7,
   "end": 346.2,
   "text": "حالا همین کلب رو در قرآن می‌تونی بدون وضو مسش کنی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 346.2,
   "end": 353.62,
   "text": "حرامه. حرمت داره. اون حرف، اون حرف کلب، حرفش رو نمی‌تونی بدون وضو مس کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 353.62,
   "end": 359.6,
   "text": "اتفاقاً اون‌هایی که تو سیر و سلوک میوفتن اساتین فهم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 359.6,
   "end": 362.66,
   "text": "اساتین فن، اون استوانه‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 362.66,
   "end": 365.58,
   "text": "اونا میگن که از همین استفاده کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 365.58,
   "end": 368.7,
   "text": "اقرأ ورقب بخوان بالا برو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 368.7,
   "end": 374.84,
   "text": "تو هم وقتی میگی آقا \"لا یمسّه إلا المتهرون\" وقتی نمیشه با دست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 374.84,
   "end": 377.62,
   "text": "ناپاک اون کلمات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 377.62,
   "end": 379.82,
   "text": "کتب شده رو که ظاهره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 379.82,
   "end": 382.64,
   "text": "مس کنی بعد میخوای حقیقت رو بدون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 382.64,
   "end": 385.76,
   "text": "مل-- بدون طهارت مس کنی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 385.76,
   "end": 388.78,
   "text": "حقیقت خودت رو، بیرون از خودت رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 388.78,
   "end": 392.08,
   "text": "همه این کلمات وجودی نظام هستی بوی توحید میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 392.08,
   "end": 395.28,
   "text": "اصلا توحیده. چیزی جز خدا نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 395.28,
   "end": 400.12,
   "text": "بعد چگونه است که تو جرأت می‌کنی بدون وضو نفس بکشی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 400.12,
   "end": 403.08,
   "text": "اینطوری که میشه میگن اصلا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 403.08,
   "end": 406.26,
   "text": "سالک، سالک نیست مگر اینکه دائم الوضو باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 406.26,
   "end": 409.48,
   "text": "لذا علمای تب-- تبریزی وقتی ازش پرسیدن روحش شاد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 409.48,
   "end": 412.0,
   "text": "که آقا شما بدترین وقتت کیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 412.0,
   "end": 413.76,
   "text": "بدترین زمان عمرت کی بوده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 413.76,
   "end": 418.44,
   "text": "می‌فرمود اون لحظه‌ای که حدسی از من",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 418.44,
   "end": 422.16,
   "text": "صادر میشه به هر حال بیت الخلاء چیزی تا بخوام وضو بسازم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 422.16,
   "end": 425.02,
   "text": "اون لحظاتی که وضو ندارم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 425.02,
   "end": 428.24,
   "text": "اون می‌فهمه که در محضر کی قرار گرفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 428.24,
   "end": 431.28,
   "text": "این هم یه کتاب. کتاب عینی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 431.28,
   "end": 433.28,
   "text": "شرح کتاب انسانه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 433.28,
   "end": 437.72,
   "text": "بهش گفتن کتاب آفاق. یک کتابی هم که کتاب کتب شده است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 437.72,
   "end": 442.38,
   "text": "کتاب قرآنه. تک تک کلمات وجودی نظام هستی رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 442.38,
   "end": 448.44,
   "text": "شما بخواید بهش کتب شدشو پیاده کنی میشه قرآن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 448.44,
   "end": 452.66,
   "text": "حالا شما بری تو باطن قرآن می‌رسی به اون کلمات وجودی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 452.66,
   "end": 454.72,
   "text": "بری تو باطن قرآن می‌رسی به خودت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 454.72,
   "end": 461.66,
   "text": "اصلا قرآن تویی. انسان شرح کتبیش میشه قرآن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 461.66,
   "end": 466.88,
   "text": "هر چقدر که این قرآن رو بهش برسی یعنی به باطن خودت برسی عزیز دلم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 466.88,
   "end": 471.28,
   "text": "تو به خدا نزدیک شدی، مقامت، رتبت، درجه‌ت همونه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 471.28,
   "end": 474.0,
   "text": "و تو مقرب الی الله شدی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 474.0,
   "end": 476.86,
   "text": "و تو انسان شدی. \"بما هو بإنسان\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 476.86,
   "end": 478.62,
   "text": "این یه مقدمه‌ای بود کشیدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 478.62,
   "end": 485.0,
   "text": "حالا شما الان شاید متوجه بشین چرا میگه هر حرف از قرآن هفتاد هزار معنا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 485.0,
   "end": 486.96,
   "text": "حضرت استاد در شرح",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 486.96,
   "end": 489.1,
   "text": "سوره قل هو الله شون،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 489.1,
   "end": 491.84,
   "text": "بنده چندین بار ازشون شنیدم از تالار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 491.84,
   "end": 495.22,
   "text": "حسن زاده علیه الرحمة والرضوان فرمودن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 495.22,
   "end": 497.48,
   "text": "این هفتاد هزار عدد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 497.48,
   "end": 500.74,
   "text": "کثرته. نه یعنی هفتاد هزار تمام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 500.74,
   "end": 505.24,
   "text": "یعنی کسی هفتاد هزار معنا از یک حرف قرآن استخراج کرد دیگه تمام بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 505.24,
   "end": 510.34,
   "text": "نه. ولا \"وما يعلم جنود ربک إلا هو\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 510.34,
   "end": 512.94,
   "text": "جز خدا نمی‌دونه جنود خودشو، لشگریان خودش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 512.94,
   "end": 516.48,
   "text": "این اقرأ ورقه امیرالمؤمنین به فرزندش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 516.48,
   "end": 519.56,
   "text": "بخوان و بالا برو. یعنی تا کجا بالا برو؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 519.56,
   "end": 521.28,
   "text": "تا هفتاد حرف؟ نخیر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 521.28,
   "end": 524.16,
   "text": "بی‌نهایت. انتها نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 524.16,
   "end": 526.82,
   "text": "بخوان و بالا برو. چی بخونم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 526.82,
   "end": 531.6,
   "text": "من که میگم مثلا حاء میم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 531.6,
   "end": 533.78,
   "text": "عین سین قاف میشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 533.78,
   "end": 536.28,
   "text": "هفتده. عددش هفتده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 536.28,
   "end": 540.84,
   "text": "خب چی بخونم؟ هفتده رکعت نمازتو از این درآر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 540.84,
   "end": 543.86,
   "text": "حاء میم عین سین قاف. این یه وجهش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 543.86,
   "end": 546.54,
   "text": "آقا بخون، بخون هفتاد هزار معنا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 546.54,
   "end": 549.86,
   "text": "یعنی برو انقدر وجوه متعدد داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 549.86,
   "end": 555.3,
   "text": "شما الان این لفظ رو که بر لسانت جاری می‌کنی در نشئ طبیعت، این یه لفظه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 555.3,
   "end": 557.84,
   "text": "داری، من الان دارم صحبت می‌کنم لفظه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 557.84,
   "end": 560.6,
   "text": "درسته؟ وقتی می‌خوابی چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 560.6,
   "end": 563.42,
   "text": "وقتی می‌خوابی که لبت تکون نمی‌خوره که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 563.42,
   "end": 567.18,
   "text": "تو قرآن حرف، تو خواب، تو مرتبه مثالیه وجودت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 567.18,
   "end": 569.16,
   "text": "اونم یه رتبه از وجود خودته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 569.16,
   "end": 571.02,
   "text": "اونجا حرف می‌زنی چی میگی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 571.02,
   "end": 575.7,
   "text": "با چه زبانی صحبت می‌کنی؟ این زبان بسته است که این دهان، این فم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 575.7,
   "end": 577.9,
   "text": "این دهان مادی بسته است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 577.9,
   "end": 583.38,
   "text": "کسی بغلت باشه بگه من این حرفو زدم، این حرفو زدم میگه وا دروغ نگو جمع کن این حرفا رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 583.38,
   "end": 585.1,
   "text": "لال مونی. افتاده بودی اینجا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 585.1,
   "end": 588.38,
   "text": "میگی به خدا قسم من این حرفا رو زدم، این کتابا رو خوندم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 588.38,
   "end": 591.66,
   "text": "راست هم داری میگی. این نفهمیدی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 591.66,
   "end": 596.64,
   "text": "تو تو خودت سیر کردی در رتبه مثالیت حرف زدی، کتاب خوندی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 596.64,
   "end": 600.3,
   "text": "کلی حرف پیاده کردی، کارها کردی، جاها رفتی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 600.3,
   "end": 603.46,
   "text": "کجا رفتی؟ با چه پایی؟ با چه کلامی حرف زدی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 603.46,
   "end": 606.3,
   "text": "اون رتبه مثالیته. قرآن هم این شکلیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 606.3,
   "end": 611.46,
   "text": "قرآن هم این صورت کتب شدش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 611.46,
   "end": 616.16,
   "text": "جلوه‌ای و وج-وجه مثالی داره، وجه عقلی داره، وجه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 616.16,
   "end": 618.34,
   "text": "قلبی داره، روحی داره، سری داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 618.34,
   "end": 620.74,
   "text": "همینجوری برو تا اصلا انتها نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 620.74,
   "end": 624.42,
   "text": "خودتم این شکلی هستی. من یه مثال زدم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 624.42,
   "end": 630.63,
   "text": "که تو خود ما چه خبره. تک تک حالا بخوام اینجوری حرف بزنم باید تا شب برای شما حرف بزنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 630.63,
   "end": 636.02,
   "text": "انقدر که بزرگان اهل معرفت تو وادی توحید حرف پیاده کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 636.02,
   "end": 638.62,
   "text": "و من میخوام یه آیه رم براتون بخونم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 638.62,
   "end": 642.94,
   "text": "مقدمم زیاد شد. ببخشید. میخواستم از این کتاب کاشف الاسرار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 642.94,
   "end": 646.88,
   "text": "مرحوم ملا نصر تالقانی هم براتون چهار تا نکته بخونم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 646.88,
   "end": 648.52,
   "text": "دیگه فرصت نمیشه یه وقت دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 648.52,
   "end": 656.32,
   "text": "بگیرید بخونید. یه کتاب دو جلدی عالیه در اصول عقاید و جلد دومش هم بسیار در بهشت و جهنم خیلی عالیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 656.32,
   "end": 658.0,
   "text": "من بچه بودم این کتاب رو خوندم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 658.0,
   "end": 662.78,
   "text": "می‌دونی چقدر قدیمیه؟ هنوز ریش تو صورتم در نیومده بود همین کتاب رو خوندم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 662.78,
   "end": 665.5,
   "text": "این که دستمه. خدا رحمت کنه مادرمو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 665.5,
   "end": 668.1,
   "text": "اون موقع به من گفت اینو بخون. کتاب عالی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 668.1,
   "end": 671.94,
   "text": "حالا اون بماند. پس نتیجه مقدمه چی شد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 671.94,
   "end": 676.64,
   "text": "اینکه هرچه ببینی، هرچه بچشی، هرچه بگی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 676.64,
   "end": 681.1,
   "text": "اولا ته نداره، دوما همش یکپارچه توحیده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 681.1,
   "end": 683.5,
   "text": "همش اسماء خداست که ظهور کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 683.5,
   "end": 686.66,
   "text": "جلوه حقه. چیزی جز این نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 686.66,
   "end": 689.44,
   "text": "حتی شیطان هم کلمه وجودی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 689.44,
   "end": 693.88,
   "text": "توحیدیه. حتی کلب، حتی پست‌ترین موجودات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 693.88,
   "end": 696.06,
   "text": "این تا اینجا. بریم سراغ آیه مون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 696.06,
   "end": 697.58,
   "text": "آیه چهل سوره روم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 697.58,
   "end": 700.96,
   "text": "\"الله الذي\" با الله شروع میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 700.96,
   "end": 704.32,
   "text": "من عاشق آیاتی‌ام که با الله یا با ه و شروع میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 704.32,
   "end": 709.68,
   "text": "دلیلی هم دارم براش. \"الله الذي خلقکم\" اون الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 709.68,
   "end": 712.3,
   "text": "کسیه که شما رو خلق کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 712.3,
   "end": 714.62,
   "text": "کی می‌تونست خلق کنه؟ بسم الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 714.62,
   "end": 717.32,
   "text": "کی می‌تونه مثل شما خلق کنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 717.32,
   "end": 721.74,
   "text": "یه بار عرض کردیم که دانشمندا گفتن اگر چ-- اگر بتونن یه حالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 721.74,
   "end": 728.02,
   "text": "فرضه مغزی رو بسازن که کار مغز آدم رو بکنه، یک برابر و نیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 728.02,
   "end": 730.22,
   "text": "کره زمین فقط وسعتش میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 730.22,
   "end": 733.56,
   "text": "خدا، خدا توی انقدر جاش داده تو کله شما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 733.56,
   "end": 738.48,
   "text": "کی می‌تونه؟ الله الذي خلقکم ثم رزقکم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 738.48,
   "end": 742.02,
   "text": "سپس حالا چه ربطی بین خلق و رزق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 742.02,
   "end": 746.7,
   "text": "اینایی که نگران رزقشونن خدا خلق کرده رزقش هم با اوست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 746.7,
   "end": 748.74,
   "text": "نگران چی؟ ثم رزقکم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 748.74,
   "end": 751.68,
   "text": "قطعاً کسی رو خلق کنه خدا رزقش هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 751.68,
   "end": 753.72,
   "text": "تأمین میکنه. ثم یمیتکم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 753.72,
   "end": 760.26,
   "text": "سپس شما رو انما تنتقلون من دار الی دار از این نشئه میبره به یه نشئه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 760.26,
   "end": 762.12,
   "text": "نترس موت انتقاله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 762.12,
   "end": 764.86,
   "text": "انتقال از اینجا به یه جای دیگه. همش هم توحیده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 764.86,
   "end": 768.4,
   "text": "طبقات توحیده. اقرأ ورقق بخوان برو بالا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 768.4,
   "end": 771.32,
   "text": "ثم یحییکم. دوباره احیا میکنه شما رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 771.32,
   "end": 774.54,
   "text": "موت میگه فلانی فوت کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 774.54,
   "end": 777.4,
   "text": "این حرف غلطیه. فوت کرد یعنی نابود شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 777.4,
   "end": 780.08,
   "text": "وفات درسته. یعنی منتقل شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 780.08,
   "end": 781.64,
   "text": "تمام نفس اخذ شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 781.64,
   "end": 785.46,
   "text": "الله يتوفى الأنفس حين موتها و رفت به یک دار دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 785.46,
   "end": 790.42,
   "text": "همه اموات ما الان صحیح و سالم و سر سلامت و زنده و توی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 790.42,
   "end": 793.2,
   "text": "دار دیگه‌ای منتظرن تا ما بهشون ملحق شیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 793.2,
   "end": 796.06,
   "text": "تو دوره ما البته دوره خلقت ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 214,
   "start": 796.06,
   "end": 801.42,
   "text": "بعد اینا رو وقتی می‌فرماید خلقکم رزقکم یمیتکم یحییکم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 215,
   "start": 801.42,
   "end": 803.52,
   "text": "حالا هل من شرکا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 216,
   "start": 803.52,
   "end": 807.86,
   "text": "شرکائکم ما یفعل من ذلک من شیء من شیء.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 217,
   "start": 807.86,
   "end": 811.26,
   "text": "میگه یه چیزی، یه چیزی شما از اینا بیارید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 218,
   "start": 811.26,
   "end": 814.38,
   "text": "از این کس-- از این کسایی که شما فکر میکنید کار خدایی می‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 219,
   "start": 814.38,
   "end": 819.86,
   "text": "این شرکایی که بعد تو ذهنت وسائط فیض رو هم تو شریک بگیری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 220,
   "start": 819.86,
   "end": 822.36,
   "text": "بگی اینا هم یه کاره‌ای ان حتی وسائط فیض.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 221,
   "start": 822.36,
   "end": 825.56,
   "text": "هیچ کاره‌اند آقا. همه کارهای عالم خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 222,
   "start": 825.56,
   "end": 828.66,
   "text": "شما حتی اون مقدمات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 223,
   "start": 828.66,
   "end": 832.28,
   "text": "پیاده‌سازی آفرینش الهی رو هم نمی‌تونی استقلال بهش بدی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 224,
   "start": 832.28,
   "end": 834.68,
   "text": "بیدیه ملکوته کل شیء.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 225,
   "start": 834.68,
   "end": 839.1,
   "text": "میگه یه چیزی بیار من شیء یه چیز کوچولو بردار بیار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 226,
   "start": 839.1,
   "end": 841.82,
   "text": "اینایی که ازشون شریک قائل شدید براشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 227,
   "start": 841.82,
   "end": 844.2,
   "text": "ما یفعل من ذلک من شیء.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 228,
   "start": 844.2,
   "end": 847.98,
   "text": "یه چیزی، یه رزقی به شما داده باشن، یه چیزی رو خلق کرده باشن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 229,
   "start": 847.98,
   "end": 851.36,
   "text": "بتونن شما رو بمیرانند و زنده کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 230,
   "start": 851.36,
   "end": 853.02,
   "text": "بسم الله. دارید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 231,
   "start": 853.02,
   "end": 855.36,
   "text": "سراغ دارید؟ ندارید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 232,
   "start": 855.36,
   "end": 858.1,
   "text": "لالید. لذا می‌فرماید سبحانه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 233,
   "start": 858.1,
   "end": 861.84,
   "text": "پاک و منزه است خدا. وظیفه هر مؤمنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 234,
   "start": 861.84,
   "end": 864.86,
   "text": "اینه که بگه سبحانه وتعالی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 235,
   "start": 864.86,
   "end": 866.82,
   "text": "بی‌حرمتی به خدا نکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 236,
   "start": 866.82,
   "end": 871.56,
   "text": "تعالى عما یشرکون. از اونچه که شریک قائل شدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 237,
   "start": 871.56,
   "end": 874.2,
   "text": "یادم افتاد ختم کلام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 238,
   "start": 874.2,
   "end": 879.5,
   "text": "یادم افتاد در حین بحث که یه روایت خیلی سال‌های پیش دیدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 239,
   "start": 879.5,
   "end": 886.16,
   "text": "یادم نیست الحمدالله چون کتاب‌های معتبر خوندم مطمئنم تو کتاب خوبی خوندمش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 240,
   "start": 886.16,
   "end": 889.96,
   "text": "چون من اولین کتاب‌هایی که تو بچگیم خوندم کتب اربه شیعه بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 241,
   "start": 889.96,
   "end": 893.8,
   "text": "بعد اومدیم سراغ امثال این کتابی که زیر بغلمه و مصباح الشریعه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 242,
   "start": 893.8,
   "end": 898.16,
   "text": "و امثالهم. یه نفر بعد از نمیدونم چند هزار سال تو آتیش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 243,
   "start": 898.16,
   "end": 903.72,
   "text": "تو جهنم یه دفعه بر زبانش اسم حضرت صدیقه شهیده جاری میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 244,
   "start": 903.72,
   "end": 907.14,
   "text": "یه دفعه میگه یا زهرا. خدا میگه اینو بیرونش بکشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 245,
   "start": 907.14,
   "end": 914.06,
   "text": "از آتیش میارنش بیرون. چی شد تو یه دفعه بعد چند هزار سال نام حضرت زهرا ناموس من رو به لسان جاری کردی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 246,
   "start": 914.06,
   "end": 919.26,
   "text": "گفت یهو یادم افتاد تو قوه خیالم یادم افتاد پیغمبر یه دختری داشت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 247,
   "start": 919.26,
   "end": 922.06,
   "text": "به نام زهرا مرضیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 248,
   "start": 922.06,
   "end": 925.84,
   "text": "که می‌فرمود اب--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 249,
   "start": 925.84,
   "end": 931.76,
   "text": "حداقل، حداقل کمترین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 250,
   "start": 931.76,
   "end": 938.08,
   "text": "چیزی که خیری که در دوست داشتن دختر من فاطمه برای شما هست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 251,
   "start": 938.08,
   "end": 943.12,
   "text": "اینه که فرمود وقت موت، وقت موت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 252,
   "start": 943.12,
   "end": 945.68,
   "text": "شما راحت جون میدید. این کمترینشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 253,
   "start": 945.68,
   "end": 949.7,
   "text": "کسی که حضرت زهرا رو دوست داشته. خلاصه گفت‌وگو می‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 254,
   "start": 949.7,
   "end": 957.94,
   "text": "الان این که یادم افتاد سر این توصیه‌های هر روز ما بر توحید، توح-- حالا ما از توحید افعالی شروع کردیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 255,
   "start": 957.94,
   "end": 960.46,
   "text": "تا انشاالله برسیم به صفاتی و ذاتی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 256,
   "start": 960.46,
   "end": 962.68,
   "text": "معلوم نیست عمرمون قطع بده یا نده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 257,
   "start": 962.68,
   "end": 967.18,
   "text": "اینا این تداعی‌ها، اون چطوری یادش افتاد بعد چند هزار سال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 258,
   "start": 967.18,
   "end": 971.18,
   "text": "این تداعی کردن چرا تلقین به میت می‌خونن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 259,
   "start": 971.18,
   "end": 974.6,
   "text": "چرا شونشو تکون میدن؟ چرا میگن بالا سر میت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 260,
   "start": 974.6,
   "end": 978.32,
   "text": "دعای ادعیه عند الموت بخون که این‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 261,
   "start": 978.32,
   "end": 980.68,
   "text": "می‌دونید تنها حسی که بر--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 262,
   "start": 980.68,
   "end": 982.7,
   "text": "با ما هست حس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 263,
   "start": 982.7,
   "end": 985.44,
   "text": "دنیاییه، مادیه. همیشه با ما هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 264,
   "start": 985.44,
   "end": 988.34,
   "text": "حس شنواییه. هیچوقت از بین نمیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 265,
   "start": 988.34,
   "end": 992.77,
   "text": "برای همین برای میت اسمع افهم اول اسمع میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 266,
   "start": 992.77,
   "end": 995.64,
   "text": "بشنو. مرده ولی می‌شنوه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 267,
   "start": 995.64,
   "end": 998.3,
   "text": "نمی‌بینه ولی می‌شنوه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 268,
   "start": 998.3,
   "end": 1005.34,
   "text": "این گفتن‌ها، این گویش‌ها که هر روز بگیم توحید افعالی، توحید افعالی، آیاتشو بخونید کم نگیرید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 269,
   "start": 1005.34,
   "end": 1010.48,
   "text": "یه روزی یه دفعه تو وجودت جلوه می‌کنه و انشاالله دست ما رو می‌گیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 270,
   "start": 1010.48,
   "end": 1013.86,
   "text": "اللهم باریک لمولانا صاحب الزمان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 271,
   "start": 1013.86,
   "end": 1015.92,
   "text": "والحمد لله رب العالمين.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 272,
   "start": 1015.92,
   "end": 1017.96,
   "text": "صلوات. اللهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 273,
   "start": 1017.96,
   "end": 1022.24,
   "text": "صل على محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}