 },
 "chapters": [
  {
   "index": 0,
   "title": "## رازقیت در تعریف رب؛ دو دغدغه",
   "start": 5.68,
   "end": 189.18
  },
  {
   "index": 1,
   "title": "مراد آیهٔ هفتادوسه سورهٔ نحل است.",
   "start": 189.18,
   "end": 273.38
  },
  {
   "index": 2,
   "title": "## ذاریات؛ إن الله هو الرزاق",
   "start": 273.38,
   "end": 506.0
  },
  {
   "index": 3,
   "title": "## حکایت مادر شهید و مشورت پیامبر",
   "start": 506.0,
   "end": 651.96
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 5.68,
   "end": 9.34,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 9.34,
   "end": 13.26,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 13.26,
   "end": 17.72,
   "text": "آیات. السلام علیکم و رحمه الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 17.72,
   "end": 20.94,
   "text": "یکی از موضوعات مهم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 20.94,
   "end": 26.68,
   "text": "از وظایف رب هست، اصلا در رب تعریف میشه رزاقیت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 26.68,
   "end": 31.82,
   "text": "رازقیت، رزقه. دهنده رزق کیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 31.82,
   "end": 34.86,
   "text": "که الان دغدغه مهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 34.86,
   "end": 38.84,
   "text": "انسان‌ها اینه. دغدغه مهمشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 38.84,
   "end": 41.82,
   "text": "غالبا هم رزق مادی رو دغدغه دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 41.82,
   "end": 47.66,
   "text": "رزق معنوی رو کمتر کسی دغدغه داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 47.66,
   "end": 53.1,
   "text": "در سوره نحل، حالا خود سوره نحل همین روایت تقدیم می‌کنم درخواست خود سوره نحل،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 53.1,
   "end": 57.38,
   "text": "نحل تا اون آیه مورد نظرمون رو بررسی کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 57.38,
   "end": 62.46,
   "text": "روایتی دیدم خیلی شیرین بود از ثواب الأعمال صفحه صد و هفت خواستید مراجعه کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 62.46,
   "end": 68.04,
   "text": "امام باقر . امام باقر صلوات الله علیه فرمودند که من قرأ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 68.04,
   "end": 72.0,
   "text": "سوره النحل فی کل شهر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 72.0,
   "end": 76.04,
   "text": "اگر کسی هر ماه یه بار سوره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 76.04,
   "end": 81.06,
   "text": "نحل رو بخونه خدا با او چه میکنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 81.06,
   "end": 85.44,
   "text": "فرمودن کفی المغرم فی الدنيا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 85.44,
   "end": 90.44,
   "text": "یعنی از ضرر و زیان‌های مالی خدا کفایتش میکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 90.44,
   "end": 94.0,
   "text": "ضرر و زیان مالی به این آسیبی نمیزنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 94.0,
   "end": 97.36,
   "text": "یه بار قرض بره گرفتار بشه و اینها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 97.36,
   "end": 100.66,
   "text": "این بغل گوش ماست و ما توجه نداریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 100.66,
   "end": 106.76,
   "text": "دیگه چی؟ و سبعين نوعا من انواع Blaya.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 106.76,
   "end": 112.12,
   "text": "خدا هفتاد نوع از انواع بلاها را ازش دفع می‌کند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 112.12,
   "end": 115.48,
   "text": "اهون هو جان؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 115.48,
   "end": 119.72,
   "text": "میگن یکیش یکیش بلای همکارانه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 119.72,
   "end": 123.52,
   "text": "یکی از مهم‌تر از اون بلای مدیرانه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 123.52,
   "end": 127.42,
   "text": "اهون هو الجنون والجزام والبرص.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 127.42,
   "end": 130.66,
   "text": "تازه میفرماید آسون‌ترینش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 130.66,
   "end": 133.76,
   "text": "از این هفتاد تا آسون‌ترینش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 133.76,
   "end": 137.96,
   "text": "جنون و جزام و برس مدیراست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 137.96,
   "end": 140.74,
   "text": "و کانه مسکن هو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 140.74,
   "end": 148.24,
   "text": "به به، به به. دل مدیرها بسوزه و کانه مسکن هو فی جنت ادم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 148.24,
   "end": 150.78,
   "text": "حالا این جنت ادم کجاست که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 150.78,
   "end": 154.74,
   "text": "چنین کسی رو خدا اونجا اسکان میده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 154.74,
   "end": 157.54,
   "text": "و هیه وسط الجنان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 157.54,
   "end": 160.88,
   "text": "وسط بهشته. بهترین جای بهشته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 160.88,
   "end": 162.82,
   "text": "خدا چه میکنه؟ آخه چه خبره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 162.82,
   "end": 166.04,
   "text": "باید توجه داشت، رفت دقت کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 166.04,
   "end": 169.06,
   "text": "درون مایه این سوره چیه که این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 169.06,
   "end": 172.76,
   "text": "نتیجه‌شه. این در حقیقت آثار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 172.76,
   "end": 176.86,
   "text": "اونم یک بار در ماه انسان این سوره رو بخونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 176.86,
   "end": 179.76,
   "text": "مد نظرم آیه هفتاد و سه سوره نحله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 179.76,
   "end": 186.62,
   "text": "میفرماید و يعبدون من دون الله ما لا يملك لهم رزقا من السماوات والأرض",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 186.62,
   "end": 189.18,
   "text": "شيئا ولا يستطيعون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 189.18,
   "end": 195.74,
   "text": "این بیچاره‌ها به جز خدا کسی رو می‌پرستن چون خدا رو سلطان و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 195.74,
   "end": 198.48,
   "text": "شاه می‌دونستن فرض می‌کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 198.48,
   "end": 201.44,
   "text": "بعد بت‌ها رو وزرای خدا فرض می‌کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 201.44,
   "end": 205.16,
   "text": "اینچنین. نه اینکه الله رو قبول نداشتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 205.16,
   "end": 210.54,
   "text": "الله رو قبول داشتن. می‌گفتن این‌ها این بت‌ها دست ما رو می‌ذاره تو دست خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 210.54,
   "end": 213.34,
   "text": "حضرت حق اینجا هم فرمود که اونا کی‌ان؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 213.34,
   "end": 217.12,
   "text": "ما لا يملك لهم رزقا من السماوات والأرض",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 217.12,
   "end": 220.36,
   "text": "شيئا. شيئا یعنی هیچ چیزی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 220.36,
   "end": 226.86,
   "text": "کوچک‌ترین چیزی. تملکی اصلا برای اون‌ها در خصوص رزق ندارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 226.86,
   "end": 229.54,
   "text": "چه در آسمان‌ها، چه در زمین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 229.54,
   "end": 233.6,
   "text": "یعنی براشون نه از آسمونی می‌تونن رزق بیارن، نه در زمین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 233.6,
   "end": 237.76,
   "text": "به یک معنا نه رزق معنوی می‌تونن برای این‌ها تامین کنن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 237.76,
   "end": 240.74,
   "text": "نه رزق مادی. چرا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 240.74,
   "end": 245.16,
   "text": "چون همش دست خداست. ولا يستطيعون هم که بعدش میاره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 245.16,
   "end": 249.5,
   "text": "این دیگه چون دلالت استمراره دیگه دلالت تدریجی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 249.5,
   "end": 251.82,
   "text": "الی الابد لا يستطيعون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 251.82,
   "end": 253.7,
   "text": "استطاعت اینو ندارن که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 253.7,
   "end": 259.92,
   "text": "اهدی جز خدا. اهدی جز خدا استطاعت اینو نداره که برای کسی رزقی بیاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 259.92,
   "end": 264.42,
   "text": "چه از آسمان، چه در زمین. چه بارش باران، چه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 264.42,
   "end": 266.18,
   "text": "رشد گیاهان و امثالهم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 266.18,
   "end": 269.12,
   "text": "هر ثمرات آسمانی یا زمینی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 269.12,
   "end": 273.38,
   "text": "همش دست خداست. رزق آسمانی‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 273.38,
   "end": 278.76,
   "text": "اتفاقا در آیه پنجاه و هشت سوره ذاریات می‌دیدم خیلی این آیه رو من خیلی دوست دارم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 278.76,
   "end": 281.54,
   "text": "اصلا سوره ذاریات خیلی سوره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 281.54,
   "end": 288.42,
   "text": "روزیه. می‌دونستید که روز رو-- هر روز اگر کسی سوره ذاریات رو بخونه فرمودن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 288.42,
   "end": 293.68,
   "text": "زندگیش رو خدا دست می‌گیره از جهت مالی، دنیوی، اینا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 293.68,
   "end": 296.78,
   "text": "بارش رزق برش، بر سرش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 296.78,
   "end": 299.54,
   "text": "می‌شینه. ان الله آیه پنجاه و هشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 299.54,
   "end": 302.6,
   "text": "ان الله هو الرزاق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 302.6,
   "end": 305.7,
   "text": "خیلی قشنگه. ان الله هو الرزاق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 305.7,
   "end": 309.72,
   "text": "اوست که رزاقه. الله رزاقه، نه کس دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 309.72,
   "end": 313.6,
   "text": "ذو القوة المتین. متین یعنی محکم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 313.6,
   "end": 315.66,
   "text": "او دارای قوه محکم است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 315.66,
   "end": 319.96,
   "text": "با همون قوت محکمش رزقت رو میده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 319.96,
   "end": 323.46,
   "text": "که اهدی هم نمی‌تونه جلوشو بگیره اگه خدا بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 323.46,
   "end": 328.48,
   "text": "اتفاقا باز در همین آیه که از، عزیزان دارم دنبالش می‌گردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 328.48,
   "end": 332.98,
   "text": "شیرینه ما حرف می‌زنیم از آیات، آقای وحدتی اولین کسی که میره سراغش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 332.98,
   "end": 335.88,
   "text": "سوره ذاریات آیه پنجاه و هشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 335.88,
   "end": 341.04,
   "text": "در کتاب العطفه الرضویه فی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 341.04,
   "end": 343.26,
   "text": "مجربات الامامیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 343.26,
   "end": 346.98,
   "text": "مال مرحوم رضویه. اثر سید محمد رضیه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 346.98,
   "end": 350.46,
   "text": "سید محمد رضی رضوی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 350.46,
   "end": 355.56,
   "text": "ایشون یه روایت-- اونجا یک نقلی رو میاره از شیخ محمد رشتی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 355.56,
   "end": 359.86,
   "text": "از علمای و کبار علمای امامیه بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 359.86,
   "end": 363.52,
   "text": "میاره که این آیه رو همین آیه که الان عرض کردیم آقای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 363.52,
   "end": 367.4,
   "text": "وحدتی آوردش. آیه چنده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 367.4,
   "end": 370.18,
   "text": "پنجاه و هشت سوره ذاریات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 370.18,
   "end": 375.46,
   "text": "این آیه رو. ایشون فرمودن اگر کسی یک اربعین،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 375.46,
   "end": 377.98,
   "text": "بحث رزق و روزی رو داریم عرض می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 377.98,
   "end": 383.8,
   "text": "اگر کسی یک اربعین هر روز صبح بعد از نماز صبحش، کوتاه هم هست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 383.8,
   "end": 385.7,
   "text": "بیست و هفت بار این آیه رو بگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 385.7,
   "end": 388.58,
   "text": "إن الله هو الرزاق ذو القوة المتین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 388.58,
   "end": 393.9,
   "text": "چهل روز. فرمودن، ایشون فرمودن که به قدری مجربه هنوز چهل و--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 393.9,
   "end": 397.04,
   "text": "چهل روزش تموم نشده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 397.04,
   "end": 400.98,
   "text": "مال فراوانی از برکت این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 400.98,
   "end": 404.92,
   "text": "آیه‌ای که قرائت می‌کنه، مال فراوانی رو نصیبش می‌کنه خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 404.92,
   "end": 407.3,
   "text": "کی؟ إن الله هو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 407.3,
   "end": 409.74,
   "text": "الرزاق. همون هوی که تو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 409.74,
   "end": 412.74,
   "text": "سوره قل هو الله، قل هو الله احد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 412.74,
   "end": 416.32,
   "text": "همون الله. همین که تو نماز میگی همونم رزقتون میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 416.32,
   "end": 419.14,
   "text": "اگر کسی به این توجه کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 419.14,
   "end": 420.86,
   "text": "دیگه چشم می‌بنده به همه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 420.86,
   "end": 423.14,
   "text": "چشمش بسته میشه به روی همه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 423.14,
   "end": 425.98,
   "text": "فقط چشم می‌اندازه و فـ تو همین آیه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 425.98,
   "end": 430.32,
   "text": "همین سوره بگو و في السماء رزقكم وما توعدون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 430.32,
   "end": 433.46,
   "text": "مطلقاً رزق شما در آسمانه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 433.46,
   "end": 435.84,
   "text": "یه روایت شیرینم تقدیم کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 435.84,
   "end": 439.06,
   "text": "خیلی این روایت پرمعنی‌ست جانم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 439.06,
   "end": 441.24,
   "text": "و هم نبی می‌شد ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 441.24,
   "end": 445.22,
   "text": "یعنی إن الله. إن الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 445.22,
   "end": 447.66,
   "text": "الرزاق. رزاق ذو القوة المتین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 447.66,
   "end": 450.5,
   "text": "بله. مضار-- تحکیم می‌خواد بکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 450.5,
   "end": 454.04,
   "text": "بله؟ حالا این رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 454.04,
   "end": 457.74,
   "text": "الان بخوایم توضیحش بدیم طول می‌کشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 457.74,
   "end": 461.28,
   "text": "ه و حالا شما فرمودید یه نکته‌ای عرض کنم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 461.28,
   "end": 471.52,
   "text": "اون روایتو تقدیم کنم. ه و دوستان توجه داشته باشن ه و هروقت بعد از الله میاد، اون الله، الله صفاتیه، اسماییه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 471.52,
   "end": 474.8,
   "text": "اگر ه و قبل از الله بیاد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 474.8,
   "end": 477.48,
   "text": "اون اللهی که اومده ذاتیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 477.48,
   "end": 481.06,
   "text": "اشاره به ذات داره. مثلاً قل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 481.06,
   "end": 484.0,
   "text": "هو الله احد. اینجا ه و قبل از الله اومده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 484.0,
   "end": 486.9,
   "text": "اون الله چیه؟ الله ذاتیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 486.9,
   "end": 489.22,
   "text": "اشاره به ذات اراده تحققه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 489.22,
   "end": 493.78,
   "text": "یا مثلاً همین جا الان الله قبل از ه و اومده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 493.78,
   "end": 495.92,
   "text": "این میشه صفاتی و اسمایی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 495.92,
   "end": 500.84,
   "text": "یعنی مرتبه واحدیت به پایینه، مرتبه کثرته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 500.84,
   "end": 505.66,
   "text": "اون وحدت محضه نیست که حالا قبلاً تو مراتب هستی دربارش حرف زدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 505.66,
   "end": 509.48,
   "text": "یه مادری که بچه‌ش یتیم شده بود، ظاهراً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 509.48,
   "end": 512.68,
   "text": "اونطور که یادمه خیلی وقت پیش روایت شده دیدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 512.68,
   "end": 514.3,
   "text": "پدرش در جنگ شهید شده بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 514.3,
   "end": 518.14,
   "text": "اومده حضور پیغمبر. یا رسول الله بچه‌م دیگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 518.14,
   "end": 521.6,
   "text": "جوون شده می‌خوام بفرستمش سر یه کاری به نظر شما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 521.6,
   "end": 525.04,
   "text": "چه کاری بفرستمش؟ پیغمبر تأملی کردن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 525.04,
   "end": 528.74,
   "text": "فرمودن بفرستش عطرفروشی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 528.74,
   "end": 532.66,
   "text": "این خانم تشکر کرد رفت با دایی‌های بچه مشورت گرفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 532.66,
   "end": 534.76,
   "text": "اونا گفتن نه بابا عطرفروشی چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 534.76,
   "end": 538.22,
   "text": "این حرفا چیه؟ الان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 538.22,
   "end": 541.58,
   "text": "بورس توی آهنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 541.58,
   "end": 545.88,
   "text": "دلار هر حالا به قول امروزی‌ها پول تو آهنه، سکه تو آهنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 545.88,
   "end": 551.28,
   "text": "بفرستش آهنگری. الان رونق تو آهنگریه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 551.28,
   "end": 555.9,
   "text": "ایشون همین کارو کرد. حرف پیغمبرو گوش نداد، حرف دایی‌هاشو گوش داد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 555.9,
   "end": 561.44,
   "text": "فرستاد بچه رو آهنگری. چند وقتی گذشت وضع بچه خیلی خوب شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 561.44,
   "end": 567.72,
   "text": "به مرتبه این خانم رسید حضور پیغمبر گفت یا رسول الله یادتونه من از شما مشورتی گرفتم ولی عکس عمل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 567.72,
   "end": 569.96,
   "text": "فرمایش شما رو انجام ندادم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 569.96,
   "end": 572.72,
   "text": "فرستادم آهنگری. وضعشم خیلی خوب شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 572.72,
   "end": 576.6,
   "text": "یعنی مثلاً می‌خواد بگه که شما مثل اینکه اشتباهی کردین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 576.6,
   "end": 580.02,
   "text": "پیغمبر به مرتبه قربونش بریم تأمل کردن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 580.02,
   "end": 584.66,
   "text": "فرمودن اون روز من در لوح محفوظ الهی توجه کردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 584.66,
   "end": 587.04,
   "text": "دیدم فرزند شما خوش روزیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 587.04,
   "end": 592.3,
   "text": "خدای منان به جهت پدر شهیدش رزق خوبی رو براش در نظر گرفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 592.3,
   "end": 593.92,
   "text": "مهم نبود چه کاری داشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 593.92,
   "end": 596.34,
   "text": "هر کاری می‌رفت خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 596.34,
   "end": 598.4,
   "text": "تأمین کرده بود رزقش رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 598.4,
   "end": 601.5,
   "text": "تو اومدی فقط کارشو سخت کردی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 601.5,
   "end": 604.32,
   "text": "عطرفروشی راحت‌ترین کار اون موقع بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 604.32,
   "end": 609.04,
   "text": "فرستادیش تو آهنگری و پتک بکوب و بزن بیچاره‌ش کردی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 609.04,
   "end": 611.78,
   "text": "اینه. چقدر خوبه که انسان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 611.78,
   "end": 615.74,
   "text": "پشت سر یک حکیم حرکت کنه و دل بسپره به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 615.74,
   "end": 619.46,
   "text": "حکمت. حکمت که باطن اشیا اونا خبر دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 619.46,
   "end": 624.54,
   "text": "و خب انشاالله ما سر تسلیم فرود بیاریم در برابر حضرات حق که هرچه هست دست اونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 624.54,
   "end": 628.02,
   "text": "إن الله هو الرزاق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 628.02,
   "end": 631.26,
   "text": "چقدر شیرینه. ذو القوة المتین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 631.26,
   "end": 634.16,
   "text": "بیست و هفت بار بعد از نماز صبحتون بگید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 634.16,
   "end": 640.06,
   "text": "چهل روز دیگه هم غر سر مدیر نزنین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 640.06,
   "end": 644.0,
   "text": "بله. اللهم بارک لمولانا صاحب الزمان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 644.0,
   "end": 645.98,
   "text": "والحمد لله رب العالمين.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 645.98,
   "end": 651.96,
   "text": "صلوات الله. اللهم صل على محمد و آل محمد و عجل فرجهم.",
   "kind": "speech",
