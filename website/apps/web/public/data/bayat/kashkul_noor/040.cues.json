 "chapters": [
  {
   "index": 0,
   "title": "## هفتهٔ وحدت و توحید افعالی",
   "start": 20.26,
   "end": 76.48
  },
  {
   "index": 1,
   "title": "## آیهٔ انعام؛ فلا کاشف له إلا هو",
   "start": 76.48,
   "end": 109.1
  },
  {
   "index": 2,
   "title": "## حدیث قدسی امالی؛ کلکم ضال",
   "start": 109.1,
   "end": 401.47
  },
  {
   "index": 3,
   "title": "## سید رضی و دعای عبرات",
   "start": 401.47,
   "end": 479.01
  },
  {
   "index": 4,
   "title": "## دعای عبرات؛ ادب توسل",
   "start": 479.01,
   "end": 652.23
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.12,
   "end": 2.6,
   "text": "اللهم صل علی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 2.6,
   "end": 6.32,
   "text": "محمد و آل محمد و عجل فرج.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 6.32,
   "end": 11.02,
   "text": "بسم الله الرحمن الرحیم و به این استعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 11.02,
   "end": 15.04,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 15.04,
   "end": 19.08,
   "text": "آیات. سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 19.08,
   "end": 21.78,
   "text": "تبریک عرض می‌کنم هفته وحدت رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 21.78,
   "end": 25.96,
   "text": "هفته بسیار پر میمنت و پربرکتی‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 25.96,
   "end": 29.84,
   "text": "انشاالله از برکاتش همه بهره‌مند بشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 29.84,
   "end": 32.48,
   "text": "در توحید افعالی بودیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 32.48,
   "end": 35.6,
   "text": "می‌رسیم به یکی دیگه از آیاتی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 35.6,
   "end": 39.68,
   "text": "سخن گفته در خصوص توحید افعالی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 39.68,
   "end": 44.3,
   "text": "خب پیغمبر عزیز عالم تشریف آوردن به این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 44.3,
   "end": 53.24,
   "text": "نشئه طبیعت. این همه سختی و زجر رو به خودشون خریدن که فرمود هیچ پیغمبری اندازه‌ی من زجر نکشید،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 53.24,
   "end": 56.56,
   "text": "اذیت نشد. به خاطر چی به نظر شما؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 56.56,
   "end": 60.0,
   "text": "به خاطر همین کلمه توحید رو به من و شما برسونه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 60.0,
   "end": 64.0,
   "text": "حقیقتش رو به من و شما بچشونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 64.0,
   "end": 66.76,
   "text": "ما در بحث توحید افعالی بودیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 66.76,
   "end": 69.8,
   "text": "آیه‌ی هفده سوره انعام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 69.8,
   "end": 72.74,
   "text": "به زیبایی داره همین موضوع رو تصریح می‌کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 72.74,
   "end": 76.48,
   "text": "که وای یمسسک الله بضر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 76.48,
   "end": 80.6,
   "text": "اگر از سمت و ناحیه الله به شما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 80.6,
   "end": 82.82,
   "text": "ضری، پریشونی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 82.82,
   "end": 86.52,
   "text": "مشکلی به شما برسه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 86.52,
   "end": 89.1,
   "text": "فلا کاشف له الا هو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 89.1,
   "end": 92.88,
   "text": "هیچ کس نمی‌تونه این مشکل رو برطرف کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 92.88,
   "end": 95.94,
   "text": "مگر خود او. همون کسی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 95.94,
   "end": 98.54,
   "text": "این مانع رو جلوی راه شما گذاشته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 98.54,
   "end": 100.96,
   "text": "و شما رو مبتلا کرده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 100.96,
   "end": 104.42,
   "text": "فقط و فقط او می‌تونه این مشکل شما رو برطرف کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 104.42,
   "end": 106.82,
   "text": "الا هو، انقدر دست و پا نزن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 106.82,
   "end": 111.46,
   "text": "انقدر به این و اون متوسل نشو، انقدر در خونه این و اون نرو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 111.46,
   "end": 118.22,
   "text": "حتی به پیغمبر عزیز عالم که به جهت هدایت اومده و رحمت است بر همه عالمین،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 118.22,
   "end": 121.54,
   "text": "به ایشون هم در قرآن می‌فرمود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 121.54,
   "end": 124.36,
   "text": "انقدر دست و پا نزن، خودتو اذیت نکن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 124.36,
   "end": 126.1,
   "text": "تو هم بخوای من اینا رو نمی‌بخشم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 126.1,
   "end": 129.18,
   "text": "برای اینا استغفار نکن. برای مشرکین استغفار نکن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 129.18,
   "end": 133.02,
   "text": "استغفار توای پیغمبر هم در حق اینا قبول نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 133.02,
   "end": 134.98,
   "text": "تا من نخوام نمی‌تونی هدایت کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 134.98,
   "end": 138.56,
   "text": "هدایت دست منه. تو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 138.56,
   "end": 141.08,
   "text": "ابلاغ کن، بگو برو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 141.08,
   "end": 145.12,
   "text": "هدایت دست منه. توجه دارید چی عرض می‌کنم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 145.12,
   "end": 149.62,
   "text": "همه چی دست خداست. این الا هو رو باید توجه کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 149.62,
   "end": 153.66,
   "text": "فلا کاشف له الا هو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 153.66,
   "end": 160.76,
   "text": "خیلی شیرینه. هو. و ادامه میده آیه که وای یمسسک بخیر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 160.76,
   "end": 164.44,
   "text": "اگر خیری هم به تو اصابت کنه و به تو برسه و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 164.44,
   "end": 168.76,
   "text": "مس کنه شما رو یا شما به خیری برسی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 168.76,
   "end": 170.62,
   "text": "فهو علی کل شیء قدیر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 170.62,
   "end": 175.2,
   "text": "این از قدرت الهیه که بر هر چ-- هر چیزی قائل--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 175.2,
   "end": 179.34,
   "text": "قادره و این از اون قدیر بودن خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 179.34,
   "end": 183.34,
   "text": "یعنی قدر و اندازه‌ی هر کسی رو،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 183.34,
   "end": 186.18,
   "text": "و ما ننزله الا بقدر معلوم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 186.18,
   "end": 192.0,
   "text": "قدر و اندازه‌ی هر کسی رو خدا می‌دونه به سعه‌ی وجودی و ظرفیت وجودی او",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 192.0,
   "end": 199.86,
   "text": "بهش خیر می‌رسونه. دست و پا نزن، خودتو نکش، انقدر این در و اون در نزن، در خونه این و اون نرو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 199.86,
   "end": 203.94,
   "text": "تا خدا نخواد هیچ چیزی به تو نمی‌رسه و هیچی از تو دفع نمی‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 203.94,
   "end": 206.76,
   "text": "ببینید تمام آیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 206.76,
   "end": 209.88,
   "text": "بوی توحید افعالی می‌ده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 209.88,
   "end": 214.0,
   "text": "همین یه دونه آیه اگر تو وجود انسان پیاده بشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 214.0,
   "end": 216.78,
   "text": "چقدر انسان رو مستحکم می‌کنه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 216.78,
   "end": 219.72,
   "text": "چقدر انسان رو آرامش می‌ده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 219.72,
   "end": 224.02,
   "text": "چقدر انسان از دغدغه‌ها، اضطراب، تشویش، استرس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 224.02,
   "end": 227.68,
   "text": "بیرون میاد. ها؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 227.68,
   "end": 231.38,
   "text": "یه روایتی براتون بخونم کیف کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 231.38,
   "end": 233.14,
   "text": "خیلی من خودم کیف کردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 233.14,
   "end": 235.38,
   "text": "انشاالله شما هم لذتش رو می‌برید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 235.38,
   "end": 240.38,
   "text": "در این حدیث قدسیه که پیغمبر عزیز عالم فرمودن تو همین کتابیه که پیشمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 240.38,
   "end": 244.68,
   "text": "این کتاب شریف امالی شیخ صدوقه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 244.68,
   "end": 248.88,
   "text": "صفحه صد و شصت و یک و صد و شصت و دوش می‌تونید این رو ببینید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 248.88,
   "end": 253.76,
   "text": "روایت که پیغمبر فرمود حدیث قدسیه خدا فرموده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 253.76,
   "end": 255.6,
   "text": "بشنوید و تنتون بلرزه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 255.6,
   "end": 260.42,
   "text": "کلکم ضال. همه شما گمراهید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 260.42,
   "end": 264.36,
   "text": "کلکم ضال. همه‌تون گمراهید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 264.36,
   "end": 269.9,
   "text": "الا من هدیته. مگر اون کسی که من هدایتش کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 269.9,
   "end": 272.34,
   "text": "بابا مگه پیغمبر نیومده برای هدایت؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 272.34,
   "end": 275.36,
   "text": "نه، هدایت دست منه. همه کارهای عالم خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 275.36,
   "end": 278.66,
   "text": "خداست و خدایی می‌کنه. اصلاً خود پیغمبر رو کی فرستاده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 278.66,
   "end": 282.78,
   "text": "خدا. همه‌تون گمراهید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 282.78,
   "end": 289.1,
   "text": "انقدر نیفت به پای استادتو، برو دنبال یه عارف و البته پیدا کردن استاد که امر،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 289.1,
   "end": 293.06,
   "text": "امر خودشونه. به قول بزرگوانی همچون آقای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 293.06,
   "end": 300.72,
   "text": "قاضی رحمة الله علیه فرمودن که اگر نصف عمر آدم، مر-مرحوم آقا میرزا جواد آقا ملکی تبریزی هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 300.72,
   "end": 304.24,
   "text": "همین فرمایشو دارن. بسیاری‌شون فرمودن اگر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 304.24,
   "end": 308.6,
   "text": "بعضیاشون دو ثلث، بعضیا فرمودن یک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 308.6,
   "end": 311.16,
   "text": "نیمی از عمرت رو،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 311.16,
   "end": 317.94,
   "text": "نیمی از عمرت رو اگر بذاری فقط بگردی یه استاد کامل پیدا کنی ارزش داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 317.94,
   "end": 321.1,
   "text": "بله ولی اون رو هم خدا تو مسیرت می‌گذاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 321.1,
   "end": 322.96,
   "text": "تو برو در خونه خدا زار بزن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 322.96,
   "end": 326.86,
   "text": "کی نصف شب پاش شدی زار زدی، التماس کردی، خواهش کردی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 326.86,
   "end": 330.54,
   "text": "خدا برات قرار نداد تو مسیر زندگیت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 330.54,
   "end": 332.34,
   "text": "ادامه‌ش و کلکم فقیر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 332.34,
   "end": 336.06,
   "text": "همه‌تون فقیرید. الا من أغنیته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 336.06,
   "end": 340.78,
   "text": "مگر اون کسی که من غنی‌ش کنم، من قنا بهش بدم، من توانگرش کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 340.78,
   "end": 345.34,
   "text": "همه چی دست خداست. و کلکم، این سومیش دیگه خیلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 345.34,
   "end": 347.06,
   "text": "خطرناکه، ترسناکه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 347.06,
   "end": 348.74,
   "text": "و کلکم مظلم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 348.74,
   "end": 351.78,
   "text": "همه‌تون ظالمید. ظالم بنفس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 351.78,
   "end": 355.18,
   "text": "ظلمت نفسی. الا من عصمت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 355.18,
   "end": 357.36,
   "text": "مگر خدا حفظتون کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 357.36,
   "end": 361.04,
   "text": "مگر من دست شما رو بگیرم بهتون عصمت ببخشم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 361.04,
   "end": 362.98,
   "text": "من تلخی گناه رو به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 362.98,
   "end": 370.8,
   "text": "ذائقه‌تون بچشونم بدتون بیاد از گناه و من شیرینی عبادت رو به ذائقه‌تون بچشونم خوشتون بیاد از عبادت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 370.8,
   "end": 378.51,
   "text": "همه چی دست خداست. اگه کسی اینطوری نگاه کنه ببین چقدر نگاهش به عالم عوض می‌شه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 378.51,
   "end": 384.83,
   "text": "متأسفانه ما وقتی یه گرفتاری برامون پیش میاد اون موقع هم معلوم میشه عیار ما چه بونه‌ست‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 384.83,
   "end": 388.31,
   "text": "اول یاد خدا می‌افتیم و اول میریم در خونه خدا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 388.31,
   "end": 391.51,
   "text": "اول برنامه‌ریزی می‌کنیم برای سحرمون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 391.51,
   "end": 394.33,
   "text": "که اجزل التماس‌مون به خدا بیشتر بشه یا نه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 394.33,
   "end": 397.93,
   "text": "این و اون تو ذهنمون میان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 397.93,
   "end": 401.47,
   "text": "اول خدا. خدا رحمت کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 401.47,
   "end": 405.61,
   "text": "سید رضی رو که نهج‌البلاغه رو جمع کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 405.61,
   "end": 410.67,
   "text": "البته نهج‌البلاغه فرمایشات مولا این نیستا فقط‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 410.67,
   "end": 414.25,
   "text": "من به شما عرض کنم به زرص قاطع که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 414.25,
   "end": 419.37,
   "text": "صد برابر این چیزی که تو نهج‌البلاغه هست از امیرالمؤمنین آثار هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 419.37,
   "end": 424.43,
   "text": "چه از حیث خطب، چه نامه‌ها، چه کلمات قصار، چه حکمت‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 424.43,
   "end": 431.69,
   "text": "صد برابرش. اینو حضرت علامه حسن زاده علیه الرحمة والرضوان تو یه جلسه‌ای فرمودن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 431.69,
   "end": 434.23,
   "text": "حالا این که سید رضی این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 434.23,
   "end": 437.89,
   "text": "زحمت رو کشید جمع‌آوری کرد این فرمایشات رو،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 437.89,
   "end": 441.17,
   "text": "ایشون می‌دونید که اه توسط",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 441.17,
   "end": 446.53,
   "text": "یکی از امرای سلا-- اون سلطان وقت خودش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 446.53,
   "end": 450.51,
   "text": "افتاد زندان. اینا به راحتی این راه رو نرفتند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 450.51,
   "end": 459.19,
   "text": "اینو بگم دیگه. متوجه منظور بنده بشید و با یه دعای شیرینی هم آشناتون کنم و برای امروز بسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 459.19,
   "end": 461.33,
   "text": "افتاد زندان و زندانیش طول کشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 461.33,
   "end": 466.53,
   "text": "خیلی طول کشید و اون ملعون خبیث امیری که بالا سرش بود شکنجه می‌داد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 466.53,
   "end": 471.45,
   "text": "نه غذا می‌داد نه آب. ایشون خیلی اذیت شد مدت طولانی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 471.45,
   "end": 473.93,
   "text": "بعد به هر حال یه روزی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 473.93,
   "end": 476.57,
   "text": "توی حالا ما می‌گیم خواب ولی تو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 476.57,
   "end": 479.01,
   "text": "حالا رؤیای صادقه یا کشفی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 479.01,
   "end": 482.29,
   "text": "امام عصر رو زیارت کرد سید رضی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 482.29,
   "end": 487.17,
   "text": "تا امام عصر رو دیدن به محض اینکه سلام محضر آقا دادن به گریه افتادن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 487.17,
   "end": 489.53,
   "text": "از آقا خواهش کردن که آقا این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 489.53,
   "end": 491.79,
   "text": "زور و این پریشانی رو شما از من بردار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 491.79,
   "end": 494.71,
   "text": "منو آزاد کن. من دارم می‌میرم اینجا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 494.71,
   "end": 498.53,
   "text": "بالاخره اینا عشقشون دست به قلم بودن و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 498.53,
   "end": 501.81,
   "text": "به هر حال یه نمونه‌ش جمع‌آوری نهج‌البلاغه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 501.81,
   "end": 504.73,
   "text": "کارهای علمی و معنوی و این‌ها بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 504.73,
   "end": 508.53,
   "text": "دوست داشتن این کارا رو انجام بدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 508.53,
   "end": 513.99,
   "text": "امام عصر فرمودن که دعای عبرات رو بخون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 513.99,
   "end": 515.75,
   "text": "عرض کرد آقا این دعا کجاست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 515.75,
   "end": 517.77,
   "text": "من به گوشم نخورده. فرمود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 517.77,
   "end": 522.03,
   "text": "لای، تو خود کتاب مصباح خودته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 522.03,
   "end": 525.87,
   "text": "فکر کرد گفت من همچین دعایی تو مصباح ندیدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 525.87,
   "end": 529.03,
   "text": "فرمود چرا نگاه کن تو مصباح خودته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 529.03,
   "end": 535.49,
   "text": "از اون حالت که آمد بیرون سریع رفت کتابو برداشت دید یه ورقه‌ای لای کتابه روش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 535.49,
   "end": 538.15,
   "text": "با یه خط خوشی نوشته دعای عبرات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 538.15,
   "end": 542.15,
   "text": "حالا اگه خواستید پیداش کنید ابتداش این شکلیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 542.15,
   "end": 545.39,
   "text": "اللهم إنی أسألک یا راحم العبرات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 545.39,
   "end": 547.11,
   "text": "چقدر شیرینه این دعا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 547.11,
   "end": 550.23,
   "text": "بخونید بخوریدش کیف کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 550.23,
   "end": 554.61,
   "text": "که از تو درخواست می‌کنم ای رحم کننده‌ی بر اشک‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 554.61,
   "end": 557.45,
   "text": "این تیکش خیلی، خیلی من باهاش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 557.45,
   "end": 561.37,
   "text": "صفا کردم. و یا کاشف الزفرات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 561.37,
   "end": 564.39,
   "text": "ای برطرف کننده آه‌های طولانی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 564.39,
   "end": 569.37,
   "text": "به به به! خدا فقط می‌تونه آه‌های طولانی رو برداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 569.37,
   "end": 572.83,
   "text": "خلاصه این رو برداشت چهل بار پشت سر هم خوند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 572.83,
   "end": 575.35,
   "text": "سید رضی و بعد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 575.35,
   "end": 577.47,
   "text": "که چهل بار خوند، اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 577.47,
   "end": 580.23,
   "text": "امیر دو تا زن داشت. یه زنش عاقله بود خوب بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 580.23,
   "end": 583.35,
   "text": "اومد پیشش گفت من خواب یه سید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 583.35,
   "end": 586.75,
   "text": "بزرگواری رو دیدم خیلی نورانی ازش پرسیدم شما کی هستی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 586.75,
   "end": 592.45,
   "text": "گفته من امیرالمؤمنینم. خلاصه طولانیه فرصت رفته من جمعش کنم داستان رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 592.45,
   "end": 598.73,
   "text": "و به من فرمودن که برو به شوهرت بگو یا این بچه منو که زندانی کردی آزاد می‌کنی یا سر خون--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 598.73,
   "end": 600.95,
   "text": "سقف خونه رو رو سرت خراب می‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 600.95,
   "end": 605.51,
   "text": "اینم از ترسش گفت برید ببینید کیه از سادات زندانی شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 605.51,
   "end": 608.81,
   "text": "خلاصه این خبر پیچید تا رسید به سلطان و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 608.81,
   "end": 611.25,
   "text": "سلطان دستور آزادی‌ش رو داد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 611.25,
   "end": 614.89,
   "text": "سید رضی آزاد شد با خوندن این دعا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 614.89,
   "end": 619.99,
   "text": "سید رضی هم که از علمای به نام شیعه است،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 619.99,
   "end": 624.11,
   "text": "درسته به امام عصر توسل کرد اما امام زمان چیکار کرد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 624.11,
   "end": 627.05,
   "text": "بهش گفت برو دعا کن. بهش دعا یاد داد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 627.05,
   "end": 631.11,
   "text": "فرمود برو در خونه خدا. اونا داعیه، داعی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 631.11,
   "end": 635.17,
   "text": "ال-- السلام علیک یا داعی الله دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 635.17,
   "end": 637.53,
   "text": "الله رو دارن به من و شما معرفی می‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 637.53,
   "end": 640.65,
   "text": "انشاالله که این بحث توحید افعالی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 640.65,
   "end": 644.27,
   "text": "مورد نظر امام عصرمون قرار بگیره و از ما قبول کنه حضرت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 644.27,
   "end": 647.21,
   "text": "والحمد لله رب العالمين صلوات بفرستید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 647.21,
   "end": 652.23,
   "text": "اللهم صل على محمد و آل محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}