 },
 "chapters": [
  {
   "index": 0,
   "title": "## توحید افعالی؛ هو الذی بعث فی الأمیین",
   "start": 20.56,
   "end": 174.06
  },
  {
   "index": 1,
   "title": "## اعملوا فکل میسر لما خلق له؛ سختی عبادت از بوی دنیا",
   "start": 174.06,
   "end": 609.85
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 8.36,
   "end": 11.74,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 11.74,
   "end": 14.64,
   "text": "السلام علیک یا داعی الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 14.64,
   "end": 16.96,
   "text": "و ربانی آیات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 16.96,
   "end": 20.3,
   "text": "السلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 20.3,
   "end": 25.16,
   "text": "ما دیروز عرض کردیم حضر عزیران که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 25.16,
   "end": 29.98,
   "text": "اهمیت و جایگاه دعست رو بیان کردیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 29.98,
   "end": 32.64,
   "text": "و فراموش کردیم اصلاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 32.64,
   "end": 34.9,
   "text": "اصل بحث رو مطرح کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 34.9,
   "end": 37.74,
   "text": "اون هم بحث توحید افعالی بود که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 37.74,
   "end": 40.54,
   "text": "حالا این پیغمبر عزیز عالم رو، این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 40.54,
   "end": 43.8,
   "text": "خورشید جهان تاب رو کی فرستاد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 43.8,
   "end": 48.72,
   "text": "کی مبعوث کرد؟ هو الذی بعث في الأميين رسولا منهم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 48.72,
   "end": 51.2,
   "text": "این هو الذی کیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 51.2,
   "end": 54.36,
   "text": "الله. هو الذی. هو الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 54.36,
   "end": 57.34,
   "text": "قل هو الله احد. این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 57.34,
   "end": 59.06,
   "text": "همون بحث توحید افعالیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 59.06,
   "end": 63.38,
   "text": "یعنی بحثای دیروز فراموشمون نشه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 63.38,
   "end": 70.7,
   "text": "آنچه که خیرات از مبدا سر زده که همه، همه چشمه‌های خیرات که در عالم می‌جوشه از اونه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 70.7,
   "end": 74.64,
   "text": "اون هم به توسط حضرت حق انشا شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 74.64,
   "end": 80.76,
   "text": "بعد، بعد از جلسه رفتیم جلسه عصری که با دوستان داشتیم پیرامون بزرگترین مانع",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 80.76,
   "end": 85.32,
   "text": "رسیدن به معرفت توحیدی صحبت کردیم که دنیاست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 85.32,
   "end": 91.74,
   "text": "و محبت دنیا. و اونجا اشاره به این فرمایش امیرالمؤمنین کردیم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 91.74,
   "end": 95.62,
   "text": "چرا از مولا پرسیدن که چرا شما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 95.62,
   "end": 98.46,
   "text": "اسم فرزندتونو گذاشتید عثمان؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 98.46,
   "end": 105.24,
   "text": "چون حضرت چهار تا پسر داشت از حضرت زهرا ملبنی عبدالله، عثمان، جعفر و عباس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 105.24,
   "end": 110.14,
   "text": "چرا عثمان؟ بعد حضرت فرمودن که اشک چشم‌هاشون رو پر کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 110.14,
   "end": 112.6,
   "text": "فرمودن من برادری داشتم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 112.6,
   "end": 115.64,
   "text": "به نام عثمان بن مزعون،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 115.64,
   "end": 119.18,
   "text": "معروف بود به عثمان مزعون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 119.18,
   "end": 124.24,
   "text": "برادری داشتم. بعد خصوصیات این برادر دینی‌شون رو مطرح کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 124.24,
   "end": 130.44,
   "text": "یه دونه از اون خصوصیات این بود که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 130.44,
   "end": 136.14,
   "text": "دوست من، برادر دینی من که اسمش عثمان بود به اون خاطر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 136.14,
   "end": 140.86,
   "text": "به عشق اون اسم پسرمو گذاشتم عثمان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 140.86,
   "end": 144.56,
   "text": "تو چشم من عظیم بود،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 144.56,
   "end": 146.76,
   "text": "بزرگ بود. چرا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 146.76,
   "end": 152.5,
   "text": "به جهت اینکه تو چشمش دنیا کوچیک بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 152.5,
   "end": 159.78,
   "text": "که بعد عرض کردیم اگه کسی بخواد بدونه تو چشم امام عصرش جایگاهش چگونه است؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 159.78,
   "end": 163.2,
   "text": "ببینه دنیا چقدر تو چشمش کوچیکه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 163.2,
   "end": 168.16,
   "text": "این رو به عنوان بزرگترین مانع در مسیر توحید معرفی کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 168.16,
   "end": 173.28,
   "text": "دیروز عصر می‌خوام رشته‌های بحث گم نشه تا امروز تکمیلش کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 173.28,
   "end": 176.34,
   "text": "بحث توح- بحث توحید افعالی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 176.34,
   "end": 182.38,
   "text": "که بعد عرض کردیم که اون، اشاره کردیم به اون روایت شریف پیغمبر عزیز عالم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 182.38,
   "end": 185.2,
   "text": "فرمودن عمل کنید. چون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 185.2,
   "end": 191.8,
   "text": "گاهی اوقات ما می‌خوایم عمل کنیم می-می-- اعمالمون حتی عباداتمون بوی دنیا میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 191.8,
   "end": 197.0,
   "text": "بعد می‌بینید سخته. عباداتمون چون بوی دنیا میده سخت شده برا ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 197.0,
   "end": 200.06,
   "text": "بعد میگیم عبادت سخته، بندگی سخته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 200.06,
   "end": 203.18,
   "text": "در صورتی که در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 203.18,
   "end": 211.86,
   "text": "کتاب شریف خدمتتون عرض شود که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 211.86,
   "end": 215.3,
   "text": "حالا الان یادم نیست تو کدوم کتابه سندش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 215.3,
   "end": 218.8,
   "text": "این فرمایش پیغمبر عزیز عالم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 218.8,
   "end": 223.14,
   "text": "عمل کنید. فعل امر عمل کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 223.14,
   "end": 225.28,
   "text": "آقا سخته. عمل کردن سخته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 225.28,
   "end": 235.04,
   "text": "به راحتی میگیم فعل امر امر کنید عمل کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 235.04,
   "end": 238.16,
   "text": "کلاً شما برای اون هدفی که به خاطر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 238.16,
   "end": 243.32,
   "text": "به خاطرش خلق شدید آسونه کار برای شما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 243.32,
   "end": 249.28,
   "text": "پس در مسیر بندگی، در مسیر عبادت، در مسیر توحید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 249.28,
   "end": 251.16,
   "text": "باید لاجرم چی باشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 251.16,
   "end": 254.88,
   "text": "کار آسون باشه. اگر کار سخت شده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 254.88,
   "end": 257.38,
   "text": "یه گیری تو کاره. یه اِش-- یه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 257.38,
   "end": 261.18,
   "text": "مشکلی وجود داره. پیداست نیت الهی نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 261.18,
   "end": 266.62,
   "text": "و الا اگر کسی نیتش درست باشه در مسیر توحید و عبادت خدا حرکت کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 266.62,
   "end": 269.14,
   "text": "قطعاً و قطعاً کار براش آسون میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 269.14,
   "end": 275.7,
   "text": "این صریح-- حدیث صریح پیغمبر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 275.7,
   "end": 278.38,
   "text": "همون فرمایش حضرت صدیقه شهیده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 278.38,
   "end": 281.32,
   "text": "چقدر عالیه این دعا. دیروز هم خدمت دوستان عرض کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 281.32,
   "end": 285.2,
   "text": "بارها عرض کردیم. اصلاً دعامون کنیم اینو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 285.2,
   "end": 288.9,
   "text": "چقدر حساب شده حضرت زهرا دعا کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 288.9,
   "end": 298.2,
   "text": "فرمود، عرض کرد به خدا منو مشغول بدار به کاری که به خاطر اون خلقم کردی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 298.2,
   "end": 300.16,
   "text": "حالا ما برای چی خلق شدیم اصلاً؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 300.16,
   "end": 301.72,
   "text": "سلام. سلام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 301.72,
   "end": 307.7,
   "text": "اینجا دیگه تتمه بحثه که دیروز باز شد تو مسیر توحید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 307.7,
   "end": 310.78,
   "text": "یه روایت تقریبا حالا چون وقت می‌گذره من دیگه عربیشو نخونم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 310.78,
   "end": 314.7,
   "text": "تو توحید صدوقه، کتابش اینجا هست پیش ما خواستید بگو بریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 314.7,
   "end": 317.52,
   "text": "از موسی بن جعفر علیهم الصلاة والسلام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 317.52,
   "end": 320.3,
   "text": "سؤال کردن در خصوص همین فرمایش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 320.3,
   "end": 326.2,
   "text": "پیغمبر عزیز عالم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 326.2,
   "end": 331.92,
   "text": "یعنی چی؟ حضرت فرمودن که عمل کنید که همه انسان‌ها برای هدفی که آفریده شده‌اند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 331.92,
   "end": 335.22,
   "text": "آمادگی دارند. امام فرمودند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 335.22,
   "end": 338.2,
   "text": "خداوند، خداوند بزرگ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 338.2,
   "end": 342.06,
   "text": "جن و انس را برای این آفرید که او را عبادت کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 342.06,
   "end": 348.2,
   "text": "اشاره به کدوم آیه است؟ ما خلقت الجن والانس الا ليعبدون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 348.2,
   "end": 351.28,
   "text": "اشاره حضرت کی؟ موسی بن جعفر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 351.28,
   "end": 354.18,
   "text": "ذیل اون فر- فرمایش پیغمبر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 354.18,
   "end": 357.34,
   "text": "برای این آفریده شده‌اند که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 357.34,
   "end": 364.1,
   "text": "عبادتش رو بکنن. و برای این آفریده نشدند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 364.1,
   "end": 368.97,
   "text": "که بخوان عصیانش بکنن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 368.97,
   "end": 372.45,
   "text": "و چون آنها را برای اطاعت آفریده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 372.45,
   "end": 378.73,
   "text": "راه را برای رسیدن به این هدف برای آنان آسان و هموار ساخته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 378.73,
   "end": 381.11,
   "text": "پس وای به حال کسانی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 381.11,
   "end": 383.83,
   "text": "حضرت موسی بن جعفر داره میفرماید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 383.83,
   "end": 391.07,
   "text": "وای به حال کسانی که چشم بر هم گذارند و نابینایی را بر هدایت ترجیح دهند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 391.07,
   "end": 396.67,
   "text": "راه کاملا مشخص-- \"قد تبین الرشد من الغی\" تو آیه کرسی میگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 396.67,
   "end": 400.05,
   "text": "آیه دومش. کاملا راه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 400.05,
   "end": 403.45,
   "text": "خیر و شر از هم مشخصند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 403.45,
   "end": 407.71,
   "text": "\"قد تبین الرشد من الغی\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 407.71,
   "end": 410.37,
   "text": "کس-- وای به حال کسی که چشمش رو به این ببنده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 410.37,
   "end": 414.91,
   "text": "یعنی کسی بینا باشه متوجه میشه چه راهی رو باید بره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 414.91,
   "end": 418.91,
   "text": "بعد یه فرمایشم از امام صادق براتون بخونم کیف کنین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 418.91,
   "end": 422.27,
   "text": "در علل و شرایع جلد یک صفحه نه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 422.27,
   "end": 425.99,
   "text": "امام صادق صلی الله علیه از امام حسین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 425.99,
   "end": 430.93,
   "text": "نقل کردند که روز عاشورا در برابر اصحابش که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 430.93,
   "end": 433.33,
   "text": "گفتگو کرد و خطبه خوانی کرد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 433.33,
   "end": 437.07,
   "text": "این جمله بسیار عالی رو سید الشهدا فرمودن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 437.07,
   "end": 438.57,
   "text": "عاشقا امام حسین توجه کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 438.57,
   "end": 443.59,
   "text": "\"ان الله عز وجل\" ما، ما که کربلا نبودیم که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 443.59,
   "end": 448.37,
   "text": "ندای قدسی امام حسین امروز داره به شما میرسه از صحنه کربلا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 448.37,
   "end": 451.95,
   "text": "رزق شماست. اون روز آقا اونجا گفته اما شما باید بشنوید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 451.95,
   "end": 458.61,
   "text": "\"ان الله عز وجل ما خلق العباد الا ليعرفوه\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 458.61,
   "end": 462.69,
   "text": "خدای عز وجل \"ما خلق العباد\" م--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 462.69,
   "end": 467.13,
   "text": "خلق رو خ-خلق نکرد، عبا-- بندگانش رو خلق نکرد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 467.13,
   "end": 468.85,
   "text": "مگر برای اینکه او را بشناسند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 468.85,
   "end": 476.63,
   "text": "\"و اذا عرفوه عبدوه\" پس قطعاً اگر کسی او را بشناسه \"عبدوه\" عبادتش میکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 476.63,
   "end": 480.53,
   "text": "\"فانا عبدوه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 480.53,
   "end": 484.89,
   "text": "استغفروا بعبادته عن عبادت-- عن عباده من",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 484.89,
   "end": 487.33,
   "text": "من سوا من سوا\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 487.33,
   "end": 490.87,
   "text": "\"عن عباده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 490.87,
   "end": 493.77,
   "text": "من سوا\". می فرماید که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 493.77,
   "end": 496.61,
   "text": "هنگامی که بندگی‌شو بکنن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 496.61,
   "end": 500.53,
   "text": "از بندگی غیر او بی‌نیاز میشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 500.53,
   "end": 503.27,
   "text": "کی داره میفرماد؟ امام حسین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 503.27,
   "end": 509.81,
   "text": "میفرماد اگر کسی خدا رو درست شناخت عبادتش میکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 509.81,
   "end": 514.19,
   "text": "پس نشون میده که شناخت، معرفت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 514.19,
   "end": 520.43,
   "text": "منجر به عبادت میشه و چون ما اصلا برای شناخت خلق شدیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 520.43,
   "end": 524.41,
   "text": "حلقه‌های بحث فراموش نشه، قطع نشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 524.41,
   "end": 526.73,
   "text": "یه بار دیگه میگم ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 526.73,
   "end": 530.35,
   "text": "برای چی خلق شدیم؟ عبادت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 530.35,
   "end": 532.19,
   "text": "عبادت اصلش چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 532.19,
   "end": 536.29,
   "text": "معرفت. اگر کسی معرفت داشت میفته به عبادت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 536.29,
   "end": 541.19,
   "text": "درست شد؟ حالا چون برای معرفت خلق شدیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 541.19,
   "end": 543.05,
   "text": "برگردیم به حدیث. \"فکل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 543.05,
   "end": 548.03,
   "text": "ميسر لما خلق\". میسوره براتون معرفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 548.03,
   "end": 551.67,
   "text": "معرفت توحیدی برای شما آسون باید باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 551.67,
   "end": 556.11,
   "text": "و چون آسونه در پسش عبادت هم باید آسون باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 556.11,
   "end": 560.65,
   "text": "اگه کسی کسب معرفت براش سخته،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 560.65,
   "end": 565.43,
   "text": "معرفت توحیدی ثقیل شده براش، یه گیر و گوری تو کارش هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 565.43,
   "end": 568.71,
   "text": "یعنی این نرفته به سمت معرفت توحیدی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 568.71,
   "end": 573.91,
   "text": "اون معرفت یا نیتش ناخالص بوده یا اون معرفت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 573.91,
   "end": 578.61,
   "text": "معرفت توحیدی نیست. یه گرفتاری پیش اومده باید اون برطرف بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 578.61,
   "end": 584.33,
   "text": "خلاصه مطلب این که ما برای معرفت توحیدی خلق شدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 584.33,
   "end": 587.35,
   "text": "اشکال نکنید به من. حاج آقا بسه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 587.35,
   "end": 590.31,
   "text": "دیگه می‌خوایم عق بزنیم انقدر میگیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 590.31,
   "end": 592.81,
   "text": "توحید افعالی، توحید افعالی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 592.81,
   "end": 595.95,
   "text": "چون بعضیا گفتند به ما متأسفانه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 595.95,
   "end": 599.97,
   "text": "اللهم بارک لمولانا صاحب الزمان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 599.97,
   "end": 601.97,
   "text": "والحمد لله رب العالمين.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 601.97,
   "end": 606.87,
   "text": "صلوات الله علی محمد آله طاهر و لعنه على أعدائه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 606.87,
   "end": 609.85,
   "text": "أجمعین. علی ممدی حاجی میگه من کیف می‌کنم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}