 "chapters": [
  {
   "index": 0,
   "title": "## توحید افعالی؛ چکیدهٔ آرا",
   "start": 20.7,
   "end": 59.7
  },
  {
   "index": 1,
   "title": "## ادامهٔ تعریف: هیچ فاعل مستقلی جز او نیست",
   "start": 59.7,
   "end": 240.48
  },
  {
   "index": 2,
   "title": "## سه نظر در اختیار انسان: جبر، تفویض، امر بین الامرین",
   "start": 240.48,
   "end": 523.02
  },
  {
   "index": 3,
   "title": "## خاطرهٔ شهید خیرآبادی و مار",
   "start": 523.02,
   "end": 550.86
  },
  {
   "index": 4,
   "title": "## روایت قیس و افعی در بیابان",
   "start": 550.86,
   "end": 681.08
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.14,
   "end": 3.62,
   "text": "اللهم صل علی محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 3.62,
   "end": 7.42,
   "text": "و آل محمد و عجل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 7.42,
   "end": 9.74,
   "text": "بسم الله الرحمن الرحیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 9.74,
   "end": 14.12,
   "text": "و به این استعین. السلام علیک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 14.12,
   "end": 16.58,
   "text": "یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 16.58,
   "end": 20.7,
   "text": "آیاته. سلام علیکم و رحمه الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 20.7,
   "end": 29.0,
   "text": "در ادامه بحث توحید افعالی اولین رتبه توحید الثلاث، سه گانه توحید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 29.0,
   "end": 31.6,
   "text": "یه بخشی رو خیلی جالب بود برام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 31.6,
   "end": 39.18,
   "text": "می‌دونید که هوش مصنوعی تمام سایت‌هایی که پیرامون این موضوع",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 39.18,
   "end": 42.18,
   "text": "نظر دارند رو در آن واحد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 42.18,
   "end": 45.02,
   "text": "بررسی می‌کنه و یک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 45.02,
   "end": 48.6,
   "text": "جواب در حقیقت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 48.6,
   "end": 50.96,
   "text": "اِمم، مخلص و خلاصه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 50.96,
   "end": 56.14,
   "text": "از همه اون سایت‌ها به شما ارائه میده در اون موضوعی که ازش سؤال می‌کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 56.14,
   "end": 61.18,
   "text": "در رابطه با توحید افعالی من از هوش مصنوعی سؤال کردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 61.18,
   "end": 69.08,
   "text": "ببینید چقدر جالب چکیده تقریباً چکیده نظرات بزرگان رو تو چند جمله گفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 69.08,
   "end": 75.62,
   "text": "گفته توحید افعالی به این معناست که تمام کارهایی که در عالم هستی انجام می‌شود، مطلق کارها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 75.62,
   "end": 81.04,
   "text": "به اذن و اراده خداوند متعال است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 81.04,
   "end": 87.82,
   "text": "همان آیه‌ای که در قرآن «ما شاء الله لا قوة إلا بالله» که امام صادق صلوات الله علیه فرمود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 87.82,
   "end": 91.06,
   "text": "در تعجبم از اونایی که دنبال دنیا هستن و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 91.06,
   "end": 96.42,
   "text": "میخوان وضع مالیشون خوب بشه و این‌ها بعد غافلن از این ذکر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 96.42,
   "end": 100.38,
   "text": "که قبلاً هم عرض کردم خدمتتون عددی که بزرگان گفتند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 100.38,
   "end": 103.3,
   "text": "هزار و چهل و شش هست برای این آیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 103.3,
   "end": 107.0,
   "text": "یعنی کسی هر روز هزار و چهل و شش بار این آیه رو بگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 107.0,
   "end": 108.92,
   "text": "دیگه رتق و فتق امور مالیش می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 108.92,
   "end": 112.76,
   "text": "دیگه نیاز نداره منت مدیرش رو بکشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 112.76,
   "end": 114.38,
   "text": "چی میگه؟ آره. شما؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 114.38,
   "end": 122.8,
   "text": "ما شاء الله لا قوة إلا بالله. پیشانی بسایه به مو-- به میز مدیرش و.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 122.8,
   "end": 132.1,
   "text": "کار مدیر ندارم. نداره. نه. آدم بیکار می‌خواد بشینه هزار و خورده‌ای همینجوری شروع کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 132.1,
   "end": 135.28,
   "text": "نه طول نمی‌کشه. خیلی طول نمی‌کشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 135.28,
   "end": 141.02,
   "text": "تقریباً نه تقریباً چهل دقیقه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 141.02,
   "end": 145.4,
   "text": "هزار و چهل و شش تا. نه ما اتفاقاً مدتیه نگفته بودیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 145.4,
   "end": 148.24,
   "text": "ما اصلاً به همین معروفیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 148.24,
   "end": 149.94,
   "text": "در مورد مدیرها باید بگیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 149.94,
   "end": 153.52,
   "text": "آره هستن الان بلاخره هستن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 153.52,
   "end": 156.42,
   "text": "توحید افعالی به این معنا-- البته اینا مدیرای خوبن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 156.42,
   "end": 158.2,
   "text": "هزار و چند تا بگیم الله و؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 158.2,
   "end": 165.28,
   "text": "هزار و چهل و شش بار. نظر مثلا آقای کشمیری، آقای قاضی اینایی ندادم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 165.28,
   "end": 169.76,
   "text": "پس اینجا می‌فرماید که وهی-- بقیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 169.76,
   "end": 171.42,
   "text": "صحبت هوش مصنوعی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 171.42,
   "end": 175.32,
   "text": "و هیچ فاعل مستقلی غیر از او وجود ندارد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 175.32,
   "end": 180.62,
   "text": "به عبارت دیگر، خداوند خالق و فاعل تمام افعال است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 180.62,
   "end": 186.42,
   "text": "و تمام موجودات دیگر در انجام افعال خود وابسته به او هستند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 186.42,
   "end": 189.34,
   "text": "حالا نظر شهید مطهری رو براتون می‌خونم ببینید چقدر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 189.34,
   "end": 192.68,
   "text": "شبیه‌اند با نظر هوش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 192.68,
   "end": 195.54,
   "text": "شهید مطهری می‌فرماید توحید افعالی به معنای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 195.54,
   "end": 197.96,
   "text": "باور به این مسئله است که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 197.96,
   "end": 200.5,
   "text": "یعنی اگه هرکی الان این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 200.5,
   "end": 205.02,
   "text": "فرمایش شهید مطهری رو باور داره رسیده به توحید افعالی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 205.02,
   "end": 209.94,
   "text": "که همه نظام‌های علی و معلولی موجود در جهان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 209.94,
   "end": 213.32,
   "text": "و هر چیزی که در جهان اتفاق می‌افتد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 213.32,
   "end": 216.88,
   "text": "فعل خداست. همچنین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 216.88,
   "end": 224.28,
   "text": "هیچ موجودی به صورت مستقل نمی‌تواند فعلی انجام دهد و همه موجودات در انجام کارهای خود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 224.28,
   "end": 227.48,
   "text": "به فعل خدا و اراده او وابسته‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 227.48,
   "end": 233.1,
   "text": "بر پایه توحید افعالی همان‌طور که خداوند در ذاتش شریکی ندارد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 233.1,
   "end": 235.26,
   "text": "در فاعلیت هم شریک ندارد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 235.26,
   "end": 240.26,
   "text": "یعنی کارهایی که هر مخلوقی انجام می‌دهد فعل خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 240.26,
   "end": 243.6,
   "text": "حالا اینجا سؤال پیش میاد بالاخره ما اینجا چikاره‌ایم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 243.6,
   "end": 246.8,
   "text": "ما مگر اختیار نداریم؟ اینجا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 246.8,
   "end": 248.5,
   "text": "خب سه تا نظر وجود داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 248.5,
   "end": 252.96,
   "text": "به صورت کلی مسلمونا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 252.96,
   "end": 255.32,
   "text": "سه تا نظر اینجا دارن. اون حالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 255.32,
   "end": 259.7,
   "text": "عبارت‌ها، اون کلیاتش رو من عرض می‌کنم و الا زیادتر از اینا هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 259.7,
   "end": 264.76,
   "text": "اشاعره میگن از اونجا که علتی جز خدا وجود نداره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 264.76,
   "end": 267.58,
   "text": "انسان علت افعال خود نیست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 267.58,
   "end": 270.8,
   "text": "و افعال او در واقع افعال خداوندند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 270.8,
   "end": 273.64,
   "text": "این می‌شه چی؟ جبری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 273.64,
   "end": 275.86,
   "text": "کیا اینطوری بودن؟ یزیدیا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 275.86,
   "end": 281.3,
   "text": "که گفت به حضرت زینب ملعون خبیث رو کرد به حضرت زینب سلام الله علیها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 281.3,
   "end": 283.14,
   "text": "گفت دیدی حسینت رو خدا کشت؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 283.14,
   "end": 285.78,
   "text": "یعنی چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 285.78,
   "end": 288.08,
   "text": "جبری. احسنت. جبری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 288.08,
   "end": 292.3,
   "text": "هیچ اراده‌ای هم-- هم-- هر کاری می‌کنی بکن کار، کار خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 292.3,
   "end": 297.82,
   "text": "معتزل مقابل اینا. میگن خداوند افعال انسان را به خود اونا واگذار کرده بنابراین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 297.82,
   "end": 301.48,
   "text": "افعال اختیاری انسان مخلوق خداوند نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 301.48,
   "end": 304.78,
   "text": "خودت اختیار کردی ربطی به خدا ندارد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 304.78,
   "end": 309.2,
   "text": "این هم که موافق با توحید و خالقیت خدا نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 309.2,
   "end": 311.36,
   "text": "یه چیزی بین این دوست که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 311.36,
   "end": 315.14,
   "text": "امامی یعنی شیعه امامی اثنی عشری معتقد به اینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 315.14,
   "end": 321.48,
   "text": "میگه انسان مختاره و افعال او واقعاً کارهای خودشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 321.48,
   "end": 325.34,
   "text": "اما در انجام دادن اون‌ها می‌خواد اون کارو انجام بده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 325.34,
   "end": 327.88,
   "text": "علت مستقل و تام نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 327.88,
   "end": 330.02,
   "text": "خداوند علت مستقل و تامه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 330.02,
   "end": 332.98,
   "text": "این اراده‌ش در طول اراده خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 332.98,
   "end": 336.62,
   "text": "یعنی اراده خودش می‌کنه اما در طول اراده خدا تو،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 336.62,
   "end": 338.64,
   "text": "اراده می‌کنه. یه چیزی بین اون دو تاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 338.64,
   "end": 342.64,
   "text": "در، در حقیقت بر این مبنا بخواهیم فکر کنیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 342.64,
   "end": 346.44,
   "text": "فعل ما هم فعل خداست، هم فعل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 346.44,
   "end": 352.64,
   "text": "خودمونه. اگر چنانچه خیر باشه صد درصد استناد میدیم به خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 352.64,
   "end": 355.68,
   "text": "«ما أسابک من حسنة فمن الله»",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 355.68,
   "end": 360.34,
   "text": "بارها این آیه رو خوندیم. اگر شر بود احتراماً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 360.34,
   "end": 363.04,
   "text": "یعنی به شأن الهی اینو نسبت به خودمون میدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 363.04,
   "end": 366.56,
   "text": "ما اصابک من ح-- ش-- سیئةٍ آیه قرآنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 366.56,
   "end": 370.0,
   "text": "فمن نفسك از خودته از کس دیگه نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 370.0,
   "end": 371.76,
   "text": "حالا شه-- حالا به چه درد میخوره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 371.76,
   "end": 373.4,
   "text": "این توحید به چه درد میخوره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 373.4,
   "end": 375.74,
   "text": "خدا رحمت کنه آقای مصباح رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 375.74,
   "end": 381.34,
   "text": "ایشون میفرمودن حداقل دو تا خصوصیت داره، دو تا فایده داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 381.34,
   "end": 384.42,
   "text": "همینطوری نگو نزن زیر میز.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 384.42,
   "end": 387.54,
   "text": "خ-- دو تا حداقل دو تا خصوصیت عالی داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 387.54,
   "end": 391.5,
   "text": "یکیش توحید عبادیه، إیاک نعبد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 391.5,
   "end": 398.02,
   "text": "یکیشم توحید توکلی حالا اصطلاحا میگیم توکل، توکل إیاک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 398.02,
   "end": 406.22,
   "text": "نستعین. وقتی تو میفهمیدی-- میفهمی یه رب مطلقی در عالم هست که خالق همه عوالم هستیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 406.22,
   "end": 413.22,
   "text": "و اصلاً او شایستگی عبادت رو داره و لاغیر میگی إیاک فقط تو رو میپرستم إیاک نعبد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 413.22,
   "end": 415.92,
   "text": "و وقتی میفهمی همه قدرت‌ها ید الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 415.92,
   "end": 418.58,
   "text": "فوق أيديهم همه مادون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 418.58,
   "end": 422.16,
   "text": "قدرت او تعریف میشن و در طول او هستن و هرچی اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 422.16,
   "end": 424.6,
   "text": "اراده کنه همونه توکلت زیاد میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 424.6,
   "end": 429.38,
   "text": "اعتماد به خدا انقدر زیاد میشه که از اهدی نمی‌ترسی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 429.38,
   "end": 436.3,
   "text": "این چیز کمیه؟ این دقیقا حالات بزرگانمونه مثل حضرت امام و مثل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 436.3,
   "end": 438.68,
   "text": "رهبر عزیزمونه که چطونه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 438.68,
   "end": 441.94,
   "text": "حکیمه دیگه حکیم از حکم میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 441.94,
   "end": 444.52,
   "text": "استحکام، احکام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 444.52,
   "end": 451.62,
   "text": "يس حکمه، محکمه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 451.62,
   "end": 455.96,
   "text": "حکمته. چون چشمش به باطن عالم باز شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 455.96,
   "end": 457.8,
   "text": "اگه غیر از این باشه متزلزل میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 457.8,
   "end": 459.86,
   "text": "لذا محکمه محکم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 459.86,
   "end": 462.04,
   "text": "بهش میگیم حکیم. چرا میگیم رهبر حکیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 462.04,
   "end": 468.66,
   "text": "انقدر که محکمه. گنده گنده هاش بال و پر ریختن تو همین دوازده روز تعارف نداریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 468.66,
   "end": 473.06,
   "text": "ولی ایشون استحکام ایشون همه رو محکم کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 473.06,
   "end": 478.98,
   "text": "و جذاب محمود کریمی هم آقای کریمی هم رهبر فرمود که یه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 478.98,
   "end": 482.96,
   "text": "اه سرود ایران سرای امید هم به من بدهکاری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 482.96,
   "end": 490.2,
   "text": "یعنی باز تو اوج این وضعیت میگن آقا امیدتون رو از دست ندید و فلان محکم وایساده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 490.2,
   "end": 492.5,
   "text": "صحبت‌هاشون با قوه قضاییه از من گوش دادید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 492.5,
   "end": 495.36,
   "text": "چقدر عالی، چقدر اطمینان به همه ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 495.36,
   "end": 499.3,
   "text": "این یعنی چی به نظر شما توحید افعالی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 499.3,
   "end": 502.3,
   "text": "یه روایت هم تقدیم کنم و برای امروز بسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 502.3,
   "end": 504.0,
   "text": "پس موقعی هم اینجوری هم هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 504.0,
   "end": 511.94,
   "text": "هست ولی نه اینجا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 511.94,
   "end": 515.76,
   "text": "خدا رحمت کنه شهید خیرآبادی حالا-",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 515.76,
   "end": 518.54,
   "text": "صحبت این آقای مدیر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 518.54,
   "end": 522.68,
   "text": "فلان، فلان شده ما رو یاد یه خاطره افتاد بگم بعد روایات‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 522.68,
   "end": 526.2,
   "text": "رفت زمان جنگ بود رفتیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 526.2,
   "end": 529.86,
   "text": "مسجد محلمون مسجد موسی بن جعفر علیهم السلام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 529.86,
   "end": 531.7,
   "text": "خبر آوردن خیرآبادی شهید شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 531.7,
   "end": 533.46,
   "text": "خیلی من دوسش داشتم. روحش شاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 533.46,
   "end": 536.4,
   "text": "مداح بود، ذاکر اهل بیت بود. یکی اومد خاطره گفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 536.4,
   "end": 539.34,
   "text": "گفت من هر غروب جا-- مفصله من خلاصشو بگم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 539.34,
   "end": 541.58,
   "text": "هر غروب میدیدم این غیبش میزنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 541.58,
   "end": 544.12,
   "text": "یه روز رصد کردم مراقبت کردم دنبالش راه افتادم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 544.12,
   "end": 546.58,
   "text": "رفتم دیدم یه گوشه‌ای رفت بغل این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 546.58,
   "end": 548.86,
   "text": "نخلستونا اینا نشست و شروع کرد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 548.86,
   "end": 552.46,
   "text": "صداش زمزمه‌ش میومد. شروع کرد روضه امام حسین خوندن هم که اشک میریخت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 552.46,
   "end": 560.74,
   "text": "فهمیدم کار هر روزشه. دیدم یه ماره خیلی وحشتناک سیاهی اومد از بغل پاش اومد بالا همینطوری اومد بالا سیخ.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 560.74,
   "end": 562.64,
   "text": "من گفتم برم خبرش کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 562.64,
   "end": 566.18,
   "text": "اگه برم خبرش کنم میفهمه من یواشکی اومدم شاکی میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 566.18,
   "end": 569.12,
   "text": "همینطوری که مونده بودم دیدم این اشک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 569.12,
   "end": 572.4,
   "text": "خیرآبادی که داره میریزه این ماره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 572.4,
   "end": 575.82,
   "text": "صورتشو آورد مالید به اشک این شهید خیرآبادی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 575.82,
   "end": 578.18,
   "text": "حالا اون موقع که شهید نشده بود. رفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 578.18,
   "end": 584.66,
   "text": "بعد اومد پایین رفت. گفت اینم همینطوری بعد بهش گفتم و ازم قسم هم داد که من تا زنده ام به کسی نگو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 584.66,
   "end": 587.86,
   "text": "بعد از شهادت شما برامون... این چیه به نظر شما که نمیترسه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 587.86,
   "end": 593.76,
   "text": "توحید افعالی. یا مثلا این روایت که میخواستم تقدیم کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 593.76,
   "end": 596.78,
   "text": "آقا علی ابن موسی الرضا انشاالله به زودی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 596.78,
   "end": 600.1,
   "text": "زیارت و معرفت‌ش به خرج خودشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 600.1,
   "end": 607.72,
   "text": "نصیب هممون بشه. ایشون فرمودن که پدر ما یعنی حضرت موسی بن جعفر علیهم السلام یه رفیقی داشته، دوستی داشته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 607.72,
   "end": 613.3,
   "text": "خوبه آدم رفیقا به ما بدن. ولو مدیر هم باشن اما رفیق باشن، رفیق اینطوری باشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 613.3,
   "end": 618.92,
   "text": "بعد می‌رفت تو بیابون عادتش بود می‌رفت تو بیابون عبادت می‌کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 618.92,
   "end": 620.98,
   "text": "حالا خلاصش کنم میگه که--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 620.98,
   "end": 625.96,
   "text": "کی داره میگه اینو؟ نه امام رضا از قول پدرش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 625.96,
   "end": 628.74,
   "text": "یعنی محکم. میگه یه روز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 628.74,
   "end": 630.98,
   "text": "دیده شد که قی-- اسمشم قیس بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 630.98,
   "end": 632.74,
   "text": "داشت تو بیابون نماز میخوند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 632.74,
   "end": 637.08,
   "text": "یه ماره افعی اومد از بالا درخت افتاد رو گردنش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 637.08,
   "end": 642.26,
   "text": "افتاد رو گردن قیس. حالا عبارت عربی روایت هم من دارم خواستید بیاید بهتون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 642.26,
   "end": 645.5,
   "text": "بدم. افتاد رو گردنش و تکون نخورد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 645.5,
   "end": 649.22,
   "text": "و حضرت موسی بن جعفر میگه این آدم تکون نخورد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 649.22,
   "end": 650.82,
   "text": "این ماره باز ادامه داد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 650.82,
   "end": 656.24,
   "text": "ول نکرد. رفت تو یقه شو، رفت تو پیرهنش و چرخید دور کمرش و از اونور",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 656.24,
   "end": 659.3,
   "text": "حالا از کجا اومد بیرون و رفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 659.3,
   "end": 661.4,
   "text": "این بچه تکون نخورد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 661.4,
   "end": 665.48,
   "text": "موسی بن جعفر میگه انقدر که غرق در خدا و ذکر خدا و اینها بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 665.48,
   "end": 668.52,
   "text": "این توحید افاعالیه. حالا خودمون رو بسنجیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 668.52,
   "end": 671.44,
   "text": "از فردا اینجا یه سوسک تو نمازخونه ول می‌کنم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 671.44,
   "end": 674.0,
   "text": "ببینم که موقع نماز چند مرده حلاجید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 674.0,
   "end": 675.74,
   "text": "والحمد لله رب العالمين.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 675.74,
   "end": 681.08,
   "text": "صلوات بفرستید. الله صلي علي محمد و آله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}