 },
 "chapters": [
  {
   "index": 0,
   "title": "## سه رتبهٔ توحید در رسائل توحیدیۀ علامه",
   "start": 26.38,
   "end": 181.96
  },
  {
   "index": 1,
   "title": "## قائم الاسم؛ صفات و اسماء در وجود انسان",
   "start": 181.96,
   "end": 414.81
  },
  {
   "index": 2,
   "title": "## قائم الفعل؛ لا حول و خرمشهر",
   "start": 414.81,
   "end": 435.39
  },
  {
   "index": 3,
   "title": "## از جبهه تا نماز؛ یک منطق",
   "start": 435.39,
   "end": 626.09
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.16,
   "end": 2.76,
   "text": "[سخنگوی 1] .",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 2.76,
   "end": 7.7,
   "text": "بسم الله الرحمن الرحیم و بهی نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 7.7,
   "end": 11.6,
   "text": "السلام علیک ای داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 11.6,
   "end": 18.7,
   "text": "آیاته. سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 18.7,
   "end": 21.4,
   "text": "اجازه بفرمایید که یه چند تا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 21.4,
   "end": 25.28,
   "text": "فرمایش حضرت علامه طباطبایی علیه الرحمه رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 25.28,
   "end": 29.4,
   "text": "براتون بخونم در سیر همون بحث تجلی و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 29.4,
   "end": 31.06,
   "text": "مراو-- مراتب توحید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 31.06,
   "end": 36.08,
   "text": "اجازه بدید که حداقل اینا به گوش امثال من بخوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 36.08,
   "end": 44.0,
   "text": "یه فکر نکنم که حالا دو تا نمازی خوندیم و یه زیارتی رفتیم و چهار تا ذکری گفتیم دیگه تا آخرشو رفتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 44.0,
   "end": 50.02,
   "text": "تو مهکی هم هست برای اینکه رتبه و مرحله خودمون رو در حیث توحید بدونیم دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 50.02,
   "end": 53.42,
   "text": "کجا قرار گرفتیم؟ کجای کاریم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 53.42,
   "end": 56.7,
   "text": "حضرت علامه علیه الرحمة والرضوان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 56.7,
   "end": 62.54,
   "text": "در کتاب الرسائل التوحیدیه هست این فرمایش، صفحه پونزده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 62.54,
   "end": 65.92,
   "text": "می‌فرمود که فالتوحید ثلاث.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 65.92,
   "end": 68.72,
   "text": "ما سه دسته توحید داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 68.72,
   "end": 73.04,
   "text": "ما معتقدیم و ادعا می‌کنیم که موحدیم دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 73.04,
   "end": 76.82,
   "text": "اولین اصل اعتقادی ماست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 76.82,
   "end": 80.98,
   "text": "توحید. عجب سه مرحله، سه رتبه داره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 80.98,
   "end": 83.52,
   "text": "بله. چی‌ان اینا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 83.52,
   "end": 88.34,
   "text": "فرمودن توحید، توحید ذاتی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 88.34,
   "end": 90.66,
   "text": "و توحید اسمایی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 90.66,
   "end": 93.1,
   "text": "و توحید افعالی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 93.1,
   "end": 94.84,
   "text": "وحده، وحده، وحده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 94.84,
   "end": 100.46,
   "text": "اون تو اون دعایی که دست به دست هم می‌دادیم یادش بخیر زمان جنگ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 100.46,
   "end": 103.42,
   "text": "می‌خوندیم این ا--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 103.42,
   "end": 108.8,
   "text": "این سه تا وحده به اعتبار این سه دسته توحیده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 108.8,
   "end": 112.24,
   "text": "که وحدو-- وحده اول می‌شه توحید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 112.24,
   "end": 116.36,
   "text": "ذاتی، وحده وسط توحید صفاتی یا اسمایی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 116.36,
   "end": 120.08,
   "text": "وحده آخر توحید افعالی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 120.08,
   "end": 123.6,
   "text": "ای حالا داره اِمم این رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 123.6,
   "end": 126.0,
   "text": "معنی می‌کنه، ترجمه‌اش می‌کنه برای ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 126.0,
   "end": 130.4,
   "text": "ان کل شیء قائم الذات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 130.4,
   "end": 136.18,
   "text": "وقائم الاسم وقائم الفعل به سبحانه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 136.18,
   "end": 138.96,
   "text": "یعنی چی؟ حالا ما اینو می‌خوایم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 138.96,
   "end": 143.16,
   "text": "یکی یکی انشاالله روزهای آتی درباره‌شون حرف بزنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 143.16,
   "end": 148.96,
   "text": "که معنیش یعنی اینکه همه چی کلش، هیچ استثنایی وجود نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 148.96,
   "end": 152.16,
   "text": "من و شمام یکی از اشیا ایم دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 152.16,
   "end": 155.6,
   "text": "فرمودن که قائم الذات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 155.6,
   "end": 160.08,
   "text": "وقائم الاسم وقائم الفعل به سبحانه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 160.08,
   "end": 162.78,
   "text": "همه اشیا که یکیش ماییم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 162.78,
   "end": 167.6,
   "text": "قائمین به ذات او. او قیوم ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 167.6,
   "end": 172.96,
   "text": "ما قائمه به او هستیم. یعنی اونو ورداری اصلاً ما نیستیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 172.96,
   "end": 177.36,
   "text": "از حیث ذات ما مستهلک در او هستیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 177.36,
   "end": 181.96,
   "text": "حالا توضیحاتی بعداً می‌گیم. فعلاً سرفصل‌شو بدونیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 181.96,
   "end": 184.76,
   "text": "از حیث صفات و یا اسما چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 184.76,
   "end": 192.0,
   "text": "بعضیا حالا گفتن صفات رو اول آوردن شدت صفات رو بعد زدن به مرحله بعدی اسما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 192.0,
   "end": 195.96,
   "text": "ولی غالباً مثل همین جمله علامه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 195.96,
   "end": 199.52,
   "text": "صفاتی و اسمایی رو تو یه جا مطرح کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 199.52,
   "end": 204.02,
   "text": "اون می‌شه قائم الاسم. یعنی ما اصلاً موجودیتمون این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 204.02,
   "end": 210.44,
   "text": "بالاخره اونچه که از صفات و اسما در ما پیاده هست، همه صفات و اسماء الهیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 210.44,
   "end": 213.56,
   "text": "شما یکی از صفات وجودی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 213.56,
   "end": 216.36,
   "text": "حی هست یا نه؟ الحي فقط خداست؛",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 216.36,
   "end": 219.44,
   "text": "یعنی همه‌ی حیات. اما شما حی هستی یا نه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 219.44,
   "end": 223.52,
   "text": "یعنی زنده هستی یا نه؟ البته این اسمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 223.52,
   "end": 226.78,
   "text": "صفتش می‌شه چی؟ حیات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 226.78,
   "end": 229.94,
   "text": "قدرت صفته. القادر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 229.94,
   "end": 231.88,
   "text": "می‌شه اسمش. که اسم خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 231.88,
   "end": 234.12,
   "text": "الف و لام میاد دیگه فقط خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 234.12,
   "end": 237.54,
   "text": "اما قادر ما هستیم که می‌تونیم به کارایی بکنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 237.54,
   "end": 241.02,
   "text": "ببینید اینا از صفاتیه که در ما-- سمعی هستیم یا نه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 241.02,
   "end": 243.14,
   "text": "بصیر هستیم یا نه؟ مرید هستیم؛",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 243.14,
   "end": 247.16,
   "text": "یعنی اراده داریم یا نه؟ متکلم هستیم یا نه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 247.16,
   "end": 248.98,
   "text": "اینا همه اسماء الهین که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 248.98,
   "end": 251.32,
   "text": "صفات الهین که این‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 251.32,
   "end": 254.8,
   "text": "یعنی اگر صفات الهی رو ورداری اینم نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 254.8,
   "end": 261.36,
   "text": "یا به عبارتی سررشته‌ی اینو بگیری، بیدهی، ملکوت و کل شی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 261.36,
   "end": 266.92,
   "text": "همه چی ملکوتش بیدهی، به دست اوست که ید الله فوق أيديهم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 266.92,
   "end": 269.16,
   "text": "کسی اینطوری نگاه کرد دیگه نمی‌ترسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 269.16,
   "end": 272.5,
   "text": "مثل این عزیزمون که تو خبر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 272.5,
   "end": 274.22,
   "text": "نمی‌دونم دیدید تو برنامه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 274.22,
   "end": 278.08,
   "text": "اسمش چی بود؟ که تا لحظه آخر مونده بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 278.08,
   "end": 281.22,
   "text": "[سخنگوی 1] 。 [سخنگوی 1] نه، نه، اون آقایی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 281.22,
   "end": 283.54,
   "text": "[سخنگوی 2] 。 [سخنگوی 1] هومن خلیلی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 283.54,
   "end": 285.84,
   "text": "آره به خدا اینا نمادهای مقاومتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 285.84,
   "end": 290.66,
   "text": "اینا رو دست کم نگیریم. حالا یکیش مثل خانم امامی دیده می‌شه، بقیه دیده نمی‌شن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 290.66,
   "end": 294.24,
   "text": "واقعاً این‌ها نمادن. [سخنگوی 2] 。",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 294.24,
   "end": 296.74,
   "text": "[سخنگوی 1] احسنت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 296.74,
   "end": 300.16,
   "text": "شهید نیما رجب‌پور. همه رو آره احسنت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 300.16,
   "end": 302.9,
   "text": "بیرون کرده بود بعد خودش بعدشم شهید شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 302.9,
   "end": 307.56,
   "text": "حالا من عکس اون دست خونیش که رو دیوار گذاشته بود رو گرفتم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 307.56,
   "end": 310.22,
   "text": "دوست داشتید-- یا فیلمشو گرفتم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 310.22,
   "end": 313.98,
   "text": "خون شهیده دیگه، متبرکه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 313.98,
   "end": 316.32,
   "text": "حالا بحث چی بود؟ این‌ها نماد مقاومتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 316.32,
   "end": 319.04,
   "text": "بعد صحبت خودش رو نمی‌دونم شنیدید یا نه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 319.04,
   "end": 323.34,
   "text": "ازش سؤال پرسید، جالبه خود خانم امامی گفت‌وگو می‌کردن، به ایشون گفت شما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 323.34,
   "end": 326.12,
   "text": "چجوری آخه اونجا نترسیدی نشستی تا دقیقه نود؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 326.12,
   "end": 328.48,
   "text": "در و دیوار همه چی داره میاد بیرون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 328.48,
   "end": 332.46,
   "text": "ما رفتیم چند روز پیش، دیروز، پریروز بود رفتیم با اتفاق شما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 332.46,
   "end": 335.6,
   "text": "بعضی از عزیزان بازدید همون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 335.6,
   "end": 339.26,
   "text": "ساختمون شیشه‌ای واقعاً مت-- تازه اونجا فهمیدیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 339.26,
   "end": 341.58,
   "text": "واقعاً اینا شجاع بودن. چه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 341.58,
   "end": 344.56,
   "text": "وضعیتی اون تو بود. خب؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 344.56,
   "end": 347.32,
   "text": "ایشون خیلی جمله جالبی فرمودن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 347.32,
   "end": 352.86,
   "text": "شاید ما اینا رو دست کم بگیریم اما اینا‌ها همین رسیدن به همین مراحل توحیدیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 352.86,
   "end": 355.76,
   "text": "یعنی اینطوری داره پی-- تو وجودش پیاده شده که اینطوری شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 355.76,
   "end": 358.82,
   "text": "اینا رو نباید دست کم گرفت. اینا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 358.82,
   "end": 360.72,
   "text": "در حقیقت شاگردان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 360.72,
   "end": 363.94,
   "text": "مکتب انقلابن. امامی‌ان انقلابن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 363.94,
   "end": 367.71,
   "text": "سر این سفره بزرگ شدن یعنی خیلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 367.71,
   "end": 371.43,
   "text": "ارزش و اهمیتشون والا است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 371.43,
   "end": 378.41,
   "text": "فرمود که من اونجا چیزی که برام تدایی شد \"یدالله فوق ایدیهم\" بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 378.41,
   "end": 381.19,
   "text": "خود ایشون گفت. گفتن اون به من آرامش داده بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 381.19,
   "end": 388.05,
   "text": "\"یدالله فوق ایدیهم\". خیلی ه-- این یعنی در عمل اینو یه وقت من مثل من میاد اینجا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 388.05,
   "end": 390.73,
   "text": "زبون درازی میکنه و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 390.73,
   "end": 393.53,
   "text": "به هر حال معرکه گیری میکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 393.53,
   "end": 395.33,
   "text": "نه، اون در عمل پیاده میکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 395.33,
   "end": 401.03,
   "text": "اینا مراحل توحیده. یعنی اسماء رو سر رشته‌ش رو میگیری میرسی، میرسی به اون،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 401.03,
   "end": 403.69,
   "text": "به حضرت حق. حالا انشاالله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 403.69,
   "end": 406.53,
   "text": "در آینده توضیح میدیم. بعد مصادیقی از فرمایشات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 406.53,
   "end": 414.59,
   "text": "حضرت امام رهبری بیان میکنیم ببینیم اینا دارن همین رو بیان میکنن به لسان عامه مردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 414.59,
   "end": 418.05,
   "text": "و قائم الفعل بهی سبحانه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 418.05,
   "end": 420.51,
   "text": "یعنی انسان تو مرحله اول",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 420.51,
   "end": 424.39,
   "text": "توحید، تازه مرحله اول.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 424.39,
   "end": 430.53,
   "text": "اگه کسی به اینجا نرسیده معذرت میخوام دیگه عذرخواهی می‌کنم تعطیله از حیث توحید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 430.53,
   "end": 435.39,
   "text": "یعنی اون موحد واقعی نیست. اصلا به همون مرحله اولش هم نرسیده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 435.39,
   "end": 437.95,
   "text": "قائم به چیه؟ از حیث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 437.95,
   "end": 440.57,
   "text": "فعل به حضرت حق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 440.57,
   "end": 443.07,
   "text": "جل جلاله. یعنی چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 443.07,
   "end": 446.37,
   "text": "یعنی اینکه هر فعلی البته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 446.37,
   "end": 449.39,
   "text": "احترام نگه میداره، حرمت نگه میداره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 449.39,
   "end": 452.55,
   "text": "افعال قبیحش رو به خدا نسبت نمیده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 452.55,
   "end": 455.71,
   "text": "میگه منم که گناه کردم. ما اصابک من",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 455.71,
   "end": 459.15,
   "text": "سیئه قرآن فرمود آنچه که از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 459.15,
   "end": 462.93,
   "text": "سیئه به تو اصابت میکنه فمن نفسك از نفس خودته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 462.93,
   "end": 465.21,
   "text": "به من خطاب، به من نسبت نده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 465.21,
   "end": 468.31,
   "text": "خب؟ اما درستیش چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 468.31,
   "end": 470.61,
   "text": "لا حول ولا قوه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 470.61,
   "end": 472.97,
   "text": "الا بالله العلی العظیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 472.97,
   "end": 475.57,
   "text": "عجب ذکر با عظمتیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 475.57,
   "end": 482.93,
   "text": "این تازه مرحله اوله که هر خیری ازش صادر میشه، هر فعلی ازش صادر میشه میگه خدا انجام داد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 482.93,
   "end": 486.73,
   "text": "حالا الان بفرمایید ببینم اگر کسی واقعاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 486.73,
   "end": 489.13,
   "text": "این، دیگه متاسفانه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 489.13,
   "end": 494.49,
   "text": "فرصتهای بین دو نماز ضیقه اما خیلی پربرکته خوشبختانه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 494.49,
   "end": 498.19,
   "text": "این سؤال منو جواب بدید و امروز بسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 498.19,
   "end": 500.63,
   "text": "که الان ما نماز خوندیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 500.63,
   "end": 504.21,
   "text": "هممون نماز ظهر رو اقامه کردیم ظاهراً.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 504.21,
   "end": 509.99,
   "text": "من و شما نماز ظهر اقامه کردیم یا خدا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 509.99,
   "end": 513.39,
   "text": "به وزان توحید افعالی، افعالی باید چی گفت؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 513.39,
   "end": 517.23,
   "text": "باید خدا، باید گفت خدا اقامه صلاة کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 517.23,
   "end": 521.67,
   "text": "ببینید به همین راحتی. یه جمله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 521.67,
   "end": 526.37,
   "text": "حضرت امام داشتن. کی میتونه بگه که اصلاً اوج",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 526.37,
   "end": 528.67,
   "text": "توحید توحید اف-- آفرین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 528.67,
   "end": 533.39,
   "text": "احسنت، احسنت. خرمشهر را خدا آزاد کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 533.39,
   "end": 537.03,
   "text": "این یعنی توحید افعالی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 537.03,
   "end": 540.79,
   "text": "یه آیه قرآن داریم ما، بچه های تو جبهه زیاد اینو می‌گفتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 540.79,
   "end": 544.67,
   "text": "عزیزانی که اینجا سابقه جبهه و جنگ دارن، آقای وحدتی و دوستان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 544.67,
   "end": 547.05,
   "text": "یادشون هست. آفرین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 547.05,
   "end": 552.35,
   "text": "احسنت. و ما رمیت اذ رمیت و لکن الله رمى.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 552.35,
   "end": 556.15,
   "text": "من نمیزنم تیر رو خداست که پرتاب میکنه، خداست که میزنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 556.15,
   "end": 558.59,
   "text": "این توحید افعالیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 558.59,
   "end": 564.71,
   "text": "حالا واقعاً بریم سراغ ارکان و اجزاء نماز، خدا داره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 564.71,
   "end": 568.81,
   "text": "سجده میکنه و رکوع میکنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 568.81,
   "end": 572.39,
   "text": "یه ذره درکش مشکله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 572.39,
   "end": 576.49,
   "text": "سمع الله ترجمه کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 576.49,
   "end": 579.05,
   "text": "شنید خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 579.05,
   "end": 582.91,
   "text": "لمن حمده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 582.91,
   "end": 586.25,
   "text": "که چه کسی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 586.25,
   "end": 590.27,
   "text": "حمدش کرد برای این، کیه حمدش کرد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 590.27,
   "end": 593.45,
   "text": "خدا شنید که خودش خودش رو حمد کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 593.45,
   "end": 596.89,
   "text": "معنیش اینه. معنی درست توحیدیش اینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 596.89,
   "end": 601.07,
   "text": "خودش خودش رو حمد کرد. خودش خودش رو-- میشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 601.07,
   "end": 603.71,
   "text": "چرا نمیشه؟ کبریا ئیه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 603.71,
   "end": 605.87,
   "text": "جان؟ به حول و قوه‌ش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 605.87,
   "end": 608.03,
   "text": "احسن. بحول الله و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 608.03,
   "end": 610.71,
   "text": "قوته اقوم و اقعد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 610.71,
   "end": 612.31,
   "text": "اقوم و اقعد سیئه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 612.31,
   "end": 615.25,
   "text": "به خودمون نسبت میدیم حول و قوه حضرت حق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 615.25,
   "end": 617.89,
   "text": "این توحید افعالیه. انشاالله بیشتر صحبت میکنیم",
