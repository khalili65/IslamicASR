 },
 "chapters": [
  {
   "index": 0,
   "title": "## مصیبت در زمین و انفس؛ مگر در کتاب",
   "start": 17.76,
   "end": 170.24
  },
  {
   "index": 1,
   "title": "## امام سجاد در مجلس یزید؛ تمایز شأن اهل‌بیت",
   "start": 170.24,
   "end": 225.64
  },
  {
   "index": 2,
   "title": "## نطفه تا چهل روز؛ صورت‌بندی و خواست والدین",
   "start": 225.64,
   "end": 562.6
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.12,
   "end": 5.86,
   "text": "اللهم صل على محمد وآل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 5.86,
   "end": 9.76,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 9.76,
   "end": 13.92,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 13.92,
   "end": 17.76,
   "text": "آیه. سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 17.76,
   "end": 24.24,
   "text": "یکی دیگر از آیاتی که پیرامون توحید افعالیه آیه بیست و دو سوره حدیده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 24.24,
   "end": 28.7,
   "text": "ما أصاب من مصيبة في الأرض.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 28.7,
   "end": 33.9,
   "text": "حالا اینجا بحث زمین را آورده و لا في أنفسكم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 33.9,
   "end": 38.58,
   "text": "هیچ مصیبتی به شما اصابت نمی‌کند در زمین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 38.58,
   "end": 44.72,
   "text": "و نه در جان شما، در أنفسكم یعنی خارج از نفس شما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 44.72,
   "end": 46.8,
   "text": "و در نفس شما هیچ مصیبتی...",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 46.8,
   "end": 50.2,
   "text": "حالا انواع مصیبت دیگه مطلبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 50.2,
   "end": 54.02,
   "text": "إلا في كتاب. حالا این کتاب من قبل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 54.02,
   "end": 57.58,
   "text": "این کتاب چه کتابی اولاً؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 57.58,
   "end": 61.94,
   "text": "در تفسیر اهل بیت علیهم الصلاة والسلام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 61.94,
   "end": 65.76,
   "text": "روایت دیدم از امام صادق صلی الله علیه که این کتاب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 65.76,
   "end": 71.54,
   "text": "خدا در آسمان و در زمینه هر دو رو شامل می‌شه چون کتابن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 71.54,
   "end": 75.44,
   "text": "نکره اومده به صورت مطلق اومده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 75.44,
   "end": 78.8,
   "text": "چه در کتاب آسمانی الهی، چه در کتاب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 78.8,
   "end": 81.62,
   "text": "زمینی. کتاب آسمانی می‌شه چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 81.62,
   "end": 84.6,
   "text": "می‌شه ام الكتاب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 84.6,
   "end": 87.86,
   "text": "أَمَّن شَيْءٍ إِلَّا عِندَنَا خَزَائِنُهُ.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 87.86,
   "end": 91.3,
   "text": "می‌شه اون عالم حکم کلی و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 91.3,
   "end": 95.62,
   "text": "عالم قضا. اونجا اصله اینجا فرعه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 95.62,
   "end": 98.8,
   "text": "اون می‌شه متن، این می‌شه شرحش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 98.8,
   "end": 101.26,
   "text": "در ام الكتاب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 101.26,
   "end": 104.02,
   "text": "اونجا این کتاب آسمانیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 104.02,
   "end": 107.6,
   "text": "کتاب زمینی رو امام صادق صلی الله علیه فرمود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 107.6,
   "end": 111.16,
   "text": "می‌شه اون کتاب اعلام خدا به ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 111.16,
   "end": 114.58,
   "text": "کتابی که خدا به ما اعلام می‌کنه به صورت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 114.58,
   "end": 117.4,
   "text": "وَمَا نُنَزِّلُهُ إِلَّا بِقَدَرٍ مَعْلُومٍ.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 117.4,
   "end": 120.62,
   "text": "می‌شه عالم قدر، قدر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 120.62,
   "end": 123.18,
   "text": "که شب قدر و غیر شب قدر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 123.18,
   "end": 128.26,
   "text": "که احتمالاً اون منظور شب‌های جمعه باشه که حضرت به معراج میرن امام عصر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 128.26,
   "end": 132.32,
   "text": "اینو به ما اعلام می‌کنند. خب این مصیبت می‌فرمود نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 132.32,
   "end": 135.98,
   "text": "مَا أَصَابَ مِن مُّصِيبَةٍ فِى الْأَرْضِ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 135.98,
   "end": 138.98,
   "text": "وَلَا فِى أَنفُسِكُمْ إِلَّا فِى كِتَابٍ.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 138.98,
   "end": 143.6,
   "text": "این مصیبت چه در جانتون، چه در خارجش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 143.6,
   "end": 146.2,
   "text": "از شما که به شما اصابت می‌کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 146.2,
   "end": 149.08,
   "text": "نیست مگر اینکه تو کتاب الهی مشخص شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 149.08,
   "end": 154.68,
   "text": "چه در کتاب در حقیقت قضا، چه در کتاب قدر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 154.68,
   "end": 158.86,
   "text": "حالا مِن قَبْلِ أَن نَبْرَأَهَا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 158.86,
   "end": 163.1,
   "text": "قبل از اینکه تو این دنیا بخواد ایجادش کنیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 163.1,
   "end": 165.28,
   "text": "این مصیبت مشخص شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 165.28,
   "end": 166.84,
   "text": "إِنَّ ذَٰلِكَ عَلَى اللَّهِ يَسِيرٌ.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 166.84,
   "end": 171.42,
   "text": "این بر خدا خیلی آسونه. ذیل این آیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 171.42,
   "end": 177.12,
   "text": "روایتی دیدم در تفسیر اهل بیت جlde پونزده، صفحه پنجاه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 177.12,
   "end": 180.3,
   "text": "و-- پونصد و نود و شش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 180.3,
   "end": 182.06,
   "text": "خب دو تا روایت دیدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 182.06,
   "end": 186.46,
   "text": "اولیش این بود که این آیه رو امام سجاد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 186.46,
   "end": 191.46,
   "text": "در مجلس یزید عليه اللعنة والعذاب الأليم قرائت کردند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 191.46,
   "end": 196.38,
   "text": "چرا؟ یزید عليه اللعنة اونجا سوء استفاده کرد وقتی حضرت رو در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 196.38,
   "end": 203.58,
   "text": "بند دید گفت دیدی ماحصل عمل کرد خودتون شد این مصیبت‌ها و اشاره کرد به آیه سی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 203.58,
   "end": 205.52,
   "text": "سوره شورا. شورا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 205.52,
   "end": 208.24,
   "text": "که وَمَا أَصَابَكَ مِنْ مُصِيبَةٍ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 208.24,
   "end": 210.78,
   "text": "فَبِمَا كَسَبَتْ أَيْدِيكُمْ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 210.78,
   "end": 213.38,
   "text": "هرچی مصیبت به شما می‌رسه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 213.38,
   "end": 216.16,
   "text": "از کار خودتونه، عمل کرد خودتونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 216.16,
   "end": 220.38,
   "text": "فَبِمَا كَسَبَتْ أَيْدِيكُمْ به دست خودتون این مصیبت‌ها سرتون اومده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 220.38,
   "end": 223.52,
   "text": "وَيَعْفُو عَن كَثِيرٍ. بسیاری‌هاشو خدا می‌بخشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 223.52,
   "end": 228.2,
   "text": "حضرت امام سجاد صلی الله علیه تو این روایت هستش که فرمودن ابداً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 228.2,
   "end": 230.88,
   "text": "این آیه در شأن ما نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 230.88,
   "end": 234.72,
   "text": "و اون آیه بیست و دو حدید رو که اول قرائت کردن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 234.72,
   "end": 237.02,
   "text": "اون رو فرمودن در شأن ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 237.02,
   "end": 242.02,
   "text": "که چی؟ این مصیبات توسط خود حضرت حق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 242.02,
   "end": 246.64,
   "text": "انشاء شده در خصوص ما اهل بیت ربطی به ما نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 246.64,
   "end": 248.58,
   "text": "گنهکارا بله به دست خودشونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 248.58,
   "end": 254.58,
   "text": "اما ما نه. این چنین نیست. بعد روایت دیگه‌ای که اینو تکمیل می‌کنه در همون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 254.58,
   "end": 260.22,
   "text": "مجلد و همون صفحه‌ای که عرض کردم، صفحه پونصد و نود و شش می‌تونید در تفسیر اهل بیت ببینید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 260.22,
   "end": 262.92,
   "text": "خیلی عالی. اینو تقدیم می‌کنم و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 262.92,
   "end": 266.32,
   "text": "شیرینیش به کامتون مثل اصلـ-عسل بنشینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 266.32,
   "end": 270.38,
   "text": "امام علی علیه الصلاة والسلام ذیل این آیه، کدوم آیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 270.38,
   "end": 273.86,
   "text": "بیست و دو سوره حدید فرمودن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 273.86,
   "end": 278.48,
   "text": "نطفه تا چهل روز در حال تغییر و تبدله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 278.48,
   "end": 287.08,
   "text": "نطفه انسان. که انّ خدا تا چهل روز مهلت میده به پدر مادر ببینه اینا چی-- زبان حالشون چیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 287.08,
   "end": 289.6,
   "text": "هرکس فرمایش مولا رو من نمیگم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 289.6,
   "end": 295.16,
   "text": "هرکس پسر یا دختر بخواهد در این چهل روز از خدا بخواهد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 295.16,
   "end": 304.38,
   "text": "مهلت داره. و پس از این چهل روز خداوند ملک موکل بر رحم را می‌فرستد برای صورت‌بندی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 304.38,
   "end": 307.18,
   "text": "یعنی اون هُوَ الْخَالِقُ الْبَارِئُ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 307.18,
   "end": 313.34,
   "text": "اتفاق افتاده مونده هُوَ الْخَالِقُ الْبَارِئُ الْمُصَوِّرُ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 313.34,
   "end": 318.32,
   "text": "لَهُ الْأَسْمَاءُ الْحُسْنَى. اون الْمُصَوِّرُ هنوز مونده که صورت‌گری بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 318.32,
   "end": 326.24,
   "text": "یعنی اندازه مشخص شده، برش هم خورده، نقش الگو مشخص شده، برش هم خورده باره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 326.24,
   "end": 327.86,
   "text": "مونده این دوخت و دوز بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 327.86,
   "end": 331.18,
   "text": "یعنی حالا دختر دوخت و دوز بشه یا پسر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 331.18,
   "end": 333.28,
   "text": "همه چی بر اساس حکم الهیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 333.28,
   "end": 335.38,
   "text": "به این موی-ملک موکل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 335.38,
   "end": 337.32,
   "text": "خدا دستور میده برو برای صورت‌بندی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 337.32,
   "end": 339.64,
   "text": "خیلی جالبه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 339.64,
   "end": 341.78,
   "text": "اونجا ملک با خدا حرف می‌زنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 341.78,
   "end": 344.66,
   "text": "می‌گه حالا الان فرصت نیست و وقت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 344.66,
   "end": 348.66,
   "text": "مبسوط یا حالا اگه عصر شد یادم بندازید در خصوص این ملک با هم صحبت کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 348.66,
   "end": 350.96,
   "text": "خیلی شیرینه گفت‌وگوهاش با خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 350.96,
   "end": 353.3,
   "text": "به خدا میگه که خدایا من چه کنم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 353.3,
   "end": 360.74,
   "text": "پسر باشه یا دختر؟ خدای سبحان بهش وحی می‌کنه که آنچنان که بخواهد، یعنی هرچی که خدا بخواهد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 360.74,
   "end": 362.9,
   "text": "حالا این با توجه به ز--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 362.9,
   "end": 367.16,
   "text": "صدر حدیث ذیل اون آیه نشون میده که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 367.16,
   "end": 369.94,
   "text": "خواست خدا اینجا تمایل به چی داره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 369.94,
   "end": 376.54,
   "text": "زوان حال پدر و مادر. یعنی پدر و مادر بیشتر دختر میخوان یا پسر و اصلاً کاری کردن در این زمینه یا نه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 376.54,
   "end": 379.44,
   "text": "یا دستوراتی داریم از اهل بیت که تو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 379.44,
   "end": 384.18,
   "text": "می‌تونی با یک کارهایی دختر داشته باشی یا پسر حتی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 384.18,
   "end": 387.22,
   "text": "شکلش زیبا باشه یا بد شکل باشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 387.22,
   "end": 392.0,
   "text": "حتی حافظ قرآن باشه، دانشمند باشه، ورزشکار باشه و امثالهم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 392.0,
   "end": 396.3,
   "text": "حتی اخلاط أربعة‌ش چه گونه‌ست همه دست خودمونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 396.3,
   "end": 400.88,
   "text": "حالا در بحث سر مکتوم یه چیزایی که ما اونجا گفتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 400.88,
   "end": 405.06,
   "text": "خب وقت گذشت. ببخشید من سریع حدیث رو تموم کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 405.06,
   "end": 407.4,
   "text": "خدا می‌فرمود بهش که حالا پسر باشه یا دختر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 407.4,
   "end": 412.34,
   "text": "سپس گوید خدا یا شقی باشد یا سعادت‌مند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 412.34,
   "end": 415.14,
   "text": "خیلی جالبه. ببینید همش دست خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 415.14,
   "end": 418.16,
   "text": "البته اینجا بر اساس چی تببین می‌شه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 418.16,
   "end": 421.38,
   "text": "اهل بیت فرمودن این س-- سقی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 421.38,
   "end": 424.38,
   "text": "که در بطن مادر مشخص می‌شه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 424.38,
   "end": 428.88,
   "text": "بر اساس چیه؟ بر اساس خواست خود شخص در عالم زرکه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 428.88,
   "end": 432.12,
   "text": "که در مباحث وا اینو توضیح دادیم چندین بار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 432.12,
   "end": 438.18,
   "text": "چگونه است؟ در عالم زر چه اتفاقی می‌افته که طرف خودش می‌پذیره سعید باشه یا شقی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 438.18,
   "end": 440.7,
   "text": "بر اساس همون هم پیاده می‌شه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 440.7,
   "end": 446.5,
   "text": "و خدا بر اساس همون به این ملک دستور میده که این ش-- سقی باشه شقی باشه یا سعید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 446.5,
   "end": 450.68,
   "text": "خدای متعال به هرچ-- هرچی که خودش بخواهد همون رو طبق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 450.68,
   "end": 454.04,
   "text": "خواست بنده پیاده می‌کنه و به اون ملک میگه پیاده‌اش کن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 454.04,
   "end": 456.98,
   "text": "و وحی می‌فرماید و آن ملک می‌نویسد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 456.98,
   "end": 461.6,
   "text": "این می‌نویسد یعنی نوشتن کتب شده دیگه ثبت می‌شه تموم می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 461.6,
   "end": 463.88,
   "text": "و بار دیگر خیلی جالبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 463.88,
   "end": 469.04,
   "text": "آخر سر ملک می‌پرسه خدایا روزی و مدت عمرش چقدر باشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 469.04,
   "end": 474.0,
   "text": "ببین همچی تعیین شده. خب می‌تونه جدا روزی رو بپرسه جدا عمر رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 474.0,
   "end": 476.96,
   "text": "اما چرا با همه؟ اینا توأمانه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 476.96,
   "end": 483.58,
   "text": "یعنی تا آخرین لقمه‌شو نخوره یا به یک معنا آخرین نفسشو-- نفس هم روزیه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 483.58,
   "end": 486.1,
   "text": "آخرین نفسشو نکشه عمرش تموم نمی‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 486.1,
   "end": 488.04,
   "text": "یعنی رزق و عمر با هم توأمانن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 488.04,
   "end": 489.74,
   "text": "هم-- هر دو با هم‌ن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 489.74,
   "end": 493.0,
   "text": "لذا امیرالمؤمنین علیه‌الصّلاة و السّلام توی جماعتی فرمود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 493.0,
   "end": 495.92,
   "text": "به نظر شما واحد شمارش عمر چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 495.92,
   "end": 498.4,
   "text": "هرکی یه چیزی گفت. یکی سال،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 498.4,
   "end": 500.84,
   "text": "ماه، روز، هفته، روز،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 500.84,
   "end": 502.9,
   "text": "ساعت. حضرت هیچکدوم رو قبول نکرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 502.9,
   "end": 505.86,
   "text": "فرمود واحد شمارش عمر نفسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 505.86,
   "end": 508.62,
   "text": "آخرین نفسی که می‌کشی اونم رزقته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 508.62,
   "end": 512.46,
   "text": "تموم می‌شه. اینا همه مشخص شده و معلوم شده‌ست از قبل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 512.46,
   "end": 515.94,
   "text": "پروردگار بر او معلوم فرماید که عمرش و روزیش چقدر باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 515.94,
   "end": 518.9,
   "text": "آن ملک با هرچه که در دنیا به آن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 518.9,
   "end": 523.26,
   "text": "اِاِاِ به آن طفل اصابت می‌کند در پیشانیش بنویسد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 523.26,
   "end": 527.92,
   "text": "اینکه مولا فرمود من پیشانی شما را نگاه کنم اول و آخرتون و می‌بینم اینطوریه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 527.92,
   "end": 531.62,
   "text": "تو پیشانی هرکسی ثبت شده تمام اول و آخرش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 531.62,
   "end": 536.52,
   "text": "و معنی آیه شریفه همین است که فرماید \"ما أصاب من مصيبة في الأرض\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 536.52,
   "end": 538.84,
   "text": "تا انتهای آیه سوره بیست و دو سوره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 538.84,
   "end": 542.34,
   "text": "آیه سوره حدید. این نشون میده که همچی از قبل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 542.34,
   "end": 545.04,
   "text": "ثبت و ضبط شده و مشخص شده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 545.04,
   "end": 551.42,
   "text": "و توحید افعالی باعث می‌شه که انسان آرامش خاطر پیدا کنه که همچی در بیدهی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 551.42,
   "end": 555.14,
   "text": "بیدهی ملکوت کل شی و ید الله فوق أیدیهم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 555.14,
   "end": 558.04,
   "text": "والحمد لله رب العالمين صلوات ختم کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 558.04,
   "end": 560.1,
   "text": "اللهم صل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 560.1,
   "end": 562.6,
   "text": "علی محمد و آل محمد و عجل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}