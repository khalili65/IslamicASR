 "chapters": [
  {
   "index": 0,
   "title": "چند شب موضوعِ درس قلبِ مطمئن و آرامش بود. آرامش بر اساسِ آیهٔ شریفه:",
   "start": 4.64,
   "end": 104.1
  },
  {
   "index": 1,
   "title": "## علمِ فکری و نورِ قلبی",
   "start": 104.1,
   "end": 411.47
  },
  {
   "index": 2,
   "title": "## نتیجه: معرفت آرامش می‌آورد",
   "start": 411.47,
   "end": 525.37
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 4.64,
   "end": 8.4,
   "text": "بسم الله الرحمن الرحیم و بهی نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 8.4,
   "end": 12.46,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 12.46,
   "end": 16.66,
   "text": "آیات. سلامٌ علیکم و رحمت الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 16.66,
   "end": 21.12,
   "text": "چند شب خاطر شریفتون باشه درس ما، بحث ما در خصوص",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 21.12,
   "end": 24.14,
   "text": "قلب مطمئن بود و آرامش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 24.14,
   "end": 31.2,
   "text": "گفتیم آرامش طبق آیه شریف «الا بذكر الله تطمئن القلوب» که سهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 31.2,
   "end": 37.2,
   "text": "انبیا و شیعیان اهل بیت علیهم الصلاة والسلامه روایتشم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 37.2,
   "end": 45.2,
   "text": "از کتاب شریف دلائل و-- دلائل الآيات الظاهرة عرض کردیم خدمتون سهم شیعیان امیرالمؤمنینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 45.2,
   "end": 50.0,
   "text": "که انّ قسطیه که ما از مولامون علی گرفتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 50.0,
   "end": 52.58,
   "text": "قسطیه که اون‌ها، اون‌ها اهل قسطن دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 52.58,
   "end": 55.62,
   "text": "ن-- نحن موازین القسط.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 55.62,
   "end": 58.72,
   "text": "اون‌ها م-- این میزان‌های قسطن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 58.72,
   "end": 61.66,
   "text": "قسط‌مون رو ما از مولا گرفتیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 61.66,
   "end": 65.16,
   "text": "سهم‌مون شده الحمد لله اطمینان قلبی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 65.16,
   "end": 70.86,
   "text": "حالا بر اساس قرآن «الا بذكر الله تطمئن القلوب»",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 70.86,
   "end": 76.56,
   "text": "جایی اطمینان قلبی و آرامش هست که گم شده امروز مردمه که گفتیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 76.56,
   "end": 80.74,
   "text": "ذکر حاصل بشه. چون میگه تطمئن القلوب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 80.74,
   "end": 84.38,
   "text": "اونم به ذکر الله. ذکر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 84.38,
   "end": 87.24,
   "text": "عرض کردیم جایگاهش قلبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 87.24,
   "end": 91.48,
   "text": "مثل ورد نیست ل-- صرفاً لسان کار کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 91.48,
   "end": 94.58,
   "text": "طرف داره با کسی حرف می‌زنه ذکرم میگه همینطوری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 94.58,
   "end": 96.22,
   "text": "اصلاً توجه هم نداره چی میگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 96.22,
   "end": 99.9,
   "text": "اینو ترکش کن آقا. این به بال گردنت می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 99.9,
   "end": 104.1,
   "text": "گمان می‌کنی ذاکری اما نیستی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 104.1,
   "end": 106.34,
   "text": "حتی بسیاری از علومی که ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 106.34,
   "end": 109.14,
   "text": "اخذ می‌کنیم علوم فکریه که چاره‌ای هم ازش نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 109.14,
   "end": 113.66,
   "text": "به قول حضرت استاد ناگزیرین، چاره‌ای ازش نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 113.66,
   "end": 118.52,
   "text": "باید رفت به سمتش ورزش فکری کرد تا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 118.52,
   "end": 126.62,
   "text": "یواش یواش روزنه‌ها، اون روازن باز بشه از سمت نایب حضرت حق نور علم چون العلم نور",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 126.62,
   "end": 129.3,
   "text": "یغرف الله فی قلب من یشاء.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 129.3,
   "end": 131.7,
   "text": "فی قلب من یشاء بیاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 131.7,
   "end": 135.04,
   "text": "وقتی بحث قلبه، علمی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 135.04,
   "end": 137.86,
   "text": "آرامش‌بخش می‌شه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 137.86,
   "end": 140.48,
   "text": "که وارد قلب شده باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 140.48,
   "end": 146.5,
   "text": "علمی که صرفاً علم فکری بمونه و وارد حوزه قلب نشه هم آرامش‌بخش نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 146.5,
   "end": 149.14,
   "text": "یه مشت مفروضات و اصطلاحات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 149.14,
   "end": 152.32,
   "text": "آدم جمع کرده و آخرش هم هیچی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 152.32,
   "end": 155.06,
   "text": "همونم به بال گردنش می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 155.06,
   "end": 159.04,
   "text": "مثل یکی از-- حالا اسم نمی‌برم یکی از علما معروفه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 159.04,
   "end": 161.66,
   "text": "ایشون کتابی دارن در خصوص شیطان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 161.66,
   "end": 167.54,
   "text": "من این کتابو خوندم. کتاب انصافاً خیلی عالیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 167.54,
   "end": 169.8,
   "text": "واقعاً سنگ تموم گذاشته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 169.8,
   "end": 177.52,
   "text": "بعد خودش میگه که خودش دست خودشو به einde خدا رو می‌کنه که و نباید آدم این حرفا رو بزنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 177.52,
   "end": 179.58,
   "text": "من بعضاً تعجب می‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 179.58,
   "end": 183.76,
   "text": "میگه من به خودم بالیدم از نوشتن این کتاب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 183.76,
   "end": 186.52,
   "text": "که کتابی به این استخون‌بندی کسی ننوشته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 186.52,
   "end": 194.48,
   "text": "بعد متمثل شد شیطان برای من گفت من خودم تو رو وسوسه کردم این کتاب رو بنویسی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 194.48,
   "end": 197.7,
   "text": "وقتی میری مراتب عالیه به قدری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 197.7,
   "end": 202.16,
   "text": "خلوص که شدت اخلاصه به قول مرحوم مجلسی در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 202.16,
   "end": 209.22,
   "text": "رساله سیر و سلوکش که من و شما باید به سمت خلوص بریم نه صرفاً اخلاص، شدت اخلاصه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 209.22,
   "end": 213.3,
   "text": "وقتی اونجا میری دیگه کار خیلی دشواره، خیلی سخته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 213.3,
   "end": 216.8,
   "text": "کارو برای خا-- رضای خدا انجام دادی تموم شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 216.8,
   "end": 218.78,
   "text": "واقعاً هم با اخلاص انجام دادی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 218.78,
   "end": 221.9,
   "text": "فقط صرفاً کارت به خاطر خدا بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 221.9,
   "end": 227.06,
   "text": "آقا اما همین که الان میای میگی می‌شه سمعه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 227.06,
   "end": 230.04,
   "text": "سمعه چیه؟ یکی از مراتب ریاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 230.04,
   "end": 232.98,
   "text": "اما وقتش گذشته، الان نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 232.98,
   "end": 236.88,
   "text": "الان انجام بدی دیگری خوشش بیاد می‌شه ریا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 236.88,
   "end": 241.16,
   "text": "به قصد خوش آمدن. اما قبلاً با اخلاص انجام دادی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 241.16,
   "end": 244.2,
   "text": "الان بیای بگی که دیگری خوشش بیاد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 244.2,
   "end": 246.9,
   "text": "می‌شه سمعه. اینم یکی از اشتباهات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 246.9,
   "end": 250.66,
   "text": "سمعه چیه؟ سمعه. که دیگری بشنوه از سمع میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 250.66,
   "end": 256.86,
   "text": "ها. قوه سامعه. اینم یک اشتباه فاحشی که ما البته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 256.86,
   "end": 260.74,
   "text": "اشتباه نشه با فما بنعمة ربک فحدث.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 260.74,
   "end": 265.48,
   "text": "اینکه میگه نعمتی خدا بهت داد حدیث کن به نیت حدیث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 265.48,
   "end": 269.2,
   "text": "نعمت الهی اینجا اشکال نداره اما به این نیت که دیگری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 269.2,
   "end": 271.5,
   "text": "بشنوه به به و چهر چهر خوشش بیاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 271.5,
   "end": 273.96,
   "text": "این نیت‌ها رو حواسمون باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 273.96,
   "end": 278.96,
   "text": "توجه کردی؟ و الا مثلا حضرت استاد تو کتاب عرفان در--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 278.96,
   "end": 286.22,
   "text": "انسان در عرف عرفانش چند تا از تمثلاتش رو، مکاشفاتش رو، حتی شهودش رو گفته؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 286.22,
   "end": 289.02,
   "text": "خب داره میگه دیگه. پس چرا گفته؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 289.02,
   "end": 293.38,
   "text": "ها؟ این می‌خواد به وزانه فما بنعمة ربک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 293.38,
   "end": 296.14,
   "text": "فحدث داره میگه که آقا این راه بازه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 296.14,
   "end": 299.2,
   "text": "طلاب بیان، ط-طالبان بیان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 299.2,
   "end": 302.28,
   "text": "فکر نکنین راه بسته است. در هر حال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 302.28,
   "end": 307.04,
   "text": "به حاشیه نریم. ما وعده داده بودیم که فرق بین علم و معرفت رو به شما بگیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 307.04,
   "end": 310.7,
   "text": "الان خیلی حاشیه رفتیم. اینو من روی جمله‌ای از کتاب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 310.7,
   "end": 313.32,
   "text": "معجم الفروق اللغویه براتون بگم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 313.32,
   "end": 317.24,
   "text": "نظرات متعدد پیرامون فرق بین علم و معرفت هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 317.24,
   "end": 320.72,
   "text": "این یه‌دونه رو فعلاً من تقدیم کنم اگر خدا خواست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 320.72,
   "end": 323.04,
   "text": "جلسات بعد ادامه‌ش میدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 323.04,
   "end": 330.06,
   "text": "که البته وعده تجلی هم داده بودیم که آقا پی-پیرامون تجلی صحبت کن چون تجلیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 330.06,
   "end": 333.26,
   "text": "تجلیات الهی همه در قلب اتفاق می‌افته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 333.26,
   "end": 335.46,
   "text": "قلب. بحث ما قلبه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 335.46,
   "end": 337.94,
   "text": "و ذکر وقتی ذکر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 337.94,
   "end": 342.62,
   "text": "اسم نیست که در قلب جایی بگیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 342.62,
   "end": 344.92,
   "text": "معجم الفروق اللغویه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 344.92,
   "end": 347.98,
   "text": "داره فرق بین علم و معرفت رو میگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 347.98,
   "end": 351.44,
   "text": "الفرق بین العلم والمعرفة",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 351.44,
   "end": 354.82,
   "text": "ان المعرفة اخص من العلم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 354.82,
   "end": 356.74,
   "text": "معرفت اخص از علمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 356.74,
   "end": 360.24,
   "text": "علم عامه، معرفت خاصه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 360.24,
   "end": 363.38,
   "text": "لانها علم بعین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 363.38,
   "end": 367.08,
   "text": "شیء مفصلاً اما سوا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 367.08,
   "end": 370.47,
   "text": "معرفت اون علمیه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 370.47,
   "end": 375.45,
   "text": "باعث بشه شما به عین شی پی ببرید، به باطن شی پی ببرید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 375.45,
   "end": 379.53,
   "text": "طوری که تفکیک قائل بشی بین این و دیگری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 379.53,
   "end": 382.65,
   "text": "یعنی این رو قش-- بریم-- بهش میگن حکمت اصطلاحاً.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 382.65,
   "end": 385.21,
   "text": "یکی از شعبه‌هاش میشه حکمت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 385.21,
   "end": 387.77,
   "text": "به باطن اشیا پی ببرید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 387.77,
   "end": 390.23,
   "text": "یعنی به باطن خودت پی ببری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 390.23,
   "end": 393.45,
   "text": "کی تا حالا به باطن خودش پی برده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 393.45,
   "end": 396.87,
   "text": "واقعاً به کنه و باطن خودش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 396.87,
   "end": 400.41,
   "text": "چشمش افتاده و خودش رو دیده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 400.41,
   "end": 404.15,
   "text": "والعلم يكون مجملا و مفصلا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 404.15,
   "end": 407.95,
   "text": "علم می‌تونه مجمل باشه و مفصل یعنی هر دو تا شامل بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 407.95,
   "end": 411.47,
   "text": "اما معرفت کسی پیدا کرد دیگه اخصه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 411.47,
   "end": 420.17,
   "text": "نتیجه، اگر علم وارد حوزه قلب شد یعنی تبدیل به باور شد، به دنبالش یقین اومد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 420.17,
   "end": 424.57,
   "text": "این از جنس معرفته و این آرامش بخشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 424.57,
   "end": 427.47,
   "text": "توجه کردید؟ اگر صرفاً آدم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 427.47,
   "end": 433.65,
   "text": "سیاح قلم و کتاب و درس و بحث و استاد و بعدم پوزیشین، پوزیشین استاداشو بیاره--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 433.65,
   "end": 437.07,
   "text": "من این استادو درک کردم، اون استاد بدتر از من.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 437.07,
   "end": 440.73,
   "text": "این جز تشویش خاطر و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 440.73,
   "end": 444.19,
   "text": "خیالات موهوم چیزی نمیاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 444.19,
   "end": 446.31,
   "text": "خیال می‌کنه خیلی حالیشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 446.31,
   "end": 452.35,
   "text": "این علم فکریه. ختم کلامی که بنده خودم بارها هم اینو عرض کردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 452.35,
   "end": 457.09,
   "text": "تو رادیو معارف یه روز گوش می‌دادم صدای حضرت امام بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 457.09,
   "end": 462.27,
   "text": "داشت پخش میشد. خود حضرت امام علیه الرحمه داشت می‌گفت رفتیم بالا سر یه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 462.27,
   "end": 465.05,
   "text": "عالمی که به ما درس می‌داد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 465.05,
   "end": 467.55,
   "text": "یعنی از تراز بالاهای حوزه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 467.55,
   "end": 470.77,
   "text": "اسم نبود. به لحظه احتضارش بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 470.77,
   "end": 474.79,
   "text": "رفتیم هرچی بهش تلقین کردیم شهادتین رو دری وری گفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 474.79,
   "end": 476.75,
   "text": "فحش و العیاذ بالله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 476.75,
   "end": 479.45,
   "text": "ناسزا به خدا گفت و جون داد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 479.45,
   "end": 482.83,
   "text": "حضرت امام اینو فرمود. ما از ایشون شنیدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 482.83,
   "end": 485.33,
   "text": "در خصوص فرق بین چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 485.33,
   "end": 493.19,
   "text": "علم و معرفت. میشه انسان مثل من لباس پیغمبر تنش باشه خیلی هم ادعا و پوزیشن علم و کتاب و چی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 493.19,
   "end": 498.75,
   "text": "اما وقت مرگ که باطنش آشکار میشه اون موقع در جا می‌زنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 498.75,
   "end": 502.51,
   "text": "خیلی مهمه این موضوع. اگر معرفت بود،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 502.51,
   "end": 506.19,
   "text": "عزیزان دلم آرامش هست و با آرامش از دنیا میره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 506.19,
   "end": 509.85,
   "text": "من با دلی آرام و مطمئن نقلمت حضرت امام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 509.85,
   "end": 512.73,
   "text": "از این دنیا میرم. این معصل معرفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 512.73,
   "end": 515.77,
   "text": "یعنی باطن علم، نور علم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 515.77,
   "end": 517.77,
   "text": "ان شا الله که عاقبتمون ختم به خیر بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 517.77,
   "end": 519.53,
   "text": "والحمد لله رب العالمين.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 519.53,
   "end": 525.37,
   "text": "صلوات ختم. اللهم صل على محمد وآل محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}