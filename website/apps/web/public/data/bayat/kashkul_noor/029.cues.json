 },
 "chapters": [
  {
   "index": 0,
   "title": "## تسلیت صفر؛ آیۀ برد و سلام",
   "start": 19.38,
   "end": 120.22
  },
  {
   "index": 1,
   "title": "## از قلب مطمئن تا توحید افعالی",
   "start": 120.22,
   "end": 296.56
  },
  {
   "index": 2,
   "title": "## طلب و اراده؛ مخلوقات مظاهر فاعلیت حق",
   "start": 296.56,
   "end": 364.56
  },
  {
   "index": 3,
   "title": "## آقای قاضی و سقف در حال ریزش",
   "start": 364.56,
   "end": 536.53
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.16,
   "end": 2.42,
   "text": "اللهم صل على",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 2.42,
   "end": 6.8,
   "text": "محمد وآل محمد وعجل فرج.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 6.8,
   "end": 10.42,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 10.42,
   "end": 14.58,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 14.58,
   "end": 19.38,
   "text": "آیات. سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 19.38,
   "end": 24.22,
   "text": "تسلیت عرض می‌کنم شروع ماه صفر که سراسر غم و حزن و اندوهه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 24.22,
   "end": 28.56,
   "text": "خصوصاً امروز که اول ماه هست و ورود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 28.56,
   "end": 31.16,
   "text": "اسرای کربلا به شهر شامه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 31.16,
   "end": 35.76,
   "text": "خیلی روز پر مصیبت و غم‌انگیز و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 35.76,
   "end": 40.62,
   "text": "سراسر مصیبته. ان‌شاءالله خدا دل امام عصرمون رو آروم کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 40.62,
   "end": 47.78,
   "text": "توجه کنه به حضرت. صدقه امروز حتماً فراموشتون نشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 47.78,
   "end": 51.36,
   "text": "یه آیه‌ای هست، آیه شصت و نه سوره انبیا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 51.36,
   "end": 54.94,
   "text": "خدا رحمت کنه حضرت آقای بهجت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 54.94,
   "end": 62.2,
   "text": "فرمودن که هر کدوم از آیات قرآن رو مطلقاً به هر نیتی میشه خوند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 62.2,
   "end": 64.78,
   "text": "به این فرمایش آقای بهجت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 64.78,
   "end": 66.66,
   "text": "شما دست و بالتون باز میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 66.66,
   "end": 69.88,
   "text": "به هر نیتی هر آیه‌ای رو می‌تونید بخونید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 69.88,
   "end": 78.08,
   "text": "به ذهنم به خاطر همین فرمایش آقای بهجت رسید که اون آیه‌ای که حضرت ابراهیم رو می‌ندازن تو آتیش، خدا می‌فرماید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 78.08,
   "end": 80.7,
   "text": "س-- برد و سلام شو بر ابراهیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 80.7,
   "end": 84.08,
   "text": "الان که هوا اینقدر داغ شده بیایید به نیت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 84.08,
   "end": 88.3,
   "text": "اینکه ان‌شاءالله برد و سلام بشه بر همه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 88.3,
   "end": 90.44,
   "text": "و ان‌شاءالله بارش رحمت بیاد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 90.44,
   "end": 97.26,
   "text": "یه نسیم خنکی بیاد، این گرما کم بشه مردم اذیت نشن، هرچقدر می‌تونیم بخونیم آیه شصت و نه سوره انبیا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 97.26,
   "end": 101.06,
   "text": "«قلنا یا نار کونی بردا و سلاما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 101.06,
   "end": 107.4,
   "text": "علی ابراهیم» ای آتیش خنک و سالم باش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 107.4,
   "end": 112.38,
   "text": "و شو، بشو. خنک شو سالم شو بر ابراهیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 112.38,
   "end": 114.52,
   "text": "شصت و نه انبیا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 114.52,
   "end": 120.02,
   "text": "این رو ان‌شاءالله تو برنامه‌مون داشته باشیم هرچقدر می‌تونیم در روز.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 120.02,
   "end": 125.44,
   "text": "ما از قلب مطمئن یا آرامش رسیدیم به اینکه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 125.44,
   "end": 127.88,
   "text": "اگر بخواهیم قلبمون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 127.88,
   "end": 132.7,
   "text": "به آرامش برسه، اصلاً به آرامش بخواهیم برسیم باید خدا تجلی کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 132.7,
   "end": 136.22,
   "text": "باید برسیم به اینکه تجلیات الهی رو درک کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 136.22,
   "end": 138.96,
   "text": "تجلیات الهی هم در توحید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 138.96,
   "end": 140.68,
   "text": "عرض کردیم اتفاق میفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 140.68,
   "end": 147.92,
   "text": "توحید هم سه قسمت بود. اولین بخش توحید رو گفتیم ت-توحید افعالیه برامون داریم کار می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 147.92,
   "end": 151.88,
   "text": "یکی از بهترین نظرات رو پیرامون توحید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 151.88,
   "end": 155.76,
   "text": "افعالی حضرت امام علیه الرحمه دادن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 155.76,
   "end": 159.68,
   "text": "یه بخشیش رو من براتون می‌خونم دو خط از،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 159.68,
   "end": 166.12,
   "text": "اِاِاِ اینجا نوشتم براتون از صفحه صد و چهار شرح دعای سحر ایشونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 166.12,
   "end": 169.9,
   "text": "می‌فرماید توحید افعالی یعنی حق تعالی در فعل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 169.9,
   "end": 175.68,
   "text": "واحد است و وجود شریک در فعل او محال است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 175.68,
   "end": 178.18,
   "text": "و همه افعال و مخلوقات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 178.18,
   "end": 187.04,
   "text": "فعل حق تعالی است. همه افعال، هر فعلی از هر خلقی سر می‌زنه فعل خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 187.04,
   "end": 191.16,
   "text": "او در حقیقت در سلسله طولیه‌ میشه چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 191.16,
   "end": 197.38,
   "text": "میشه واسطه. در تغییرات فلسفی که یه زمانی یادش بخیر در بحث سر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 197.38,
   "end": 203.36,
   "text": "مکروم و روح بخاری از این تغییرات فلسفی حضرت امام یادتون باشه زیاد استفاده کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 203.36,
   "end": 208.44,
   "text": "همچنین در آداب الصلاة هم امام اگر خواسته باشید صفحه نود و سه باز این رو دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 208.44,
   "end": 210.68,
   "text": "حق تعالی فاعلی است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 210.68,
   "end": 215.48,
   "text": "که در مبدأ بودن برای همه اشیا مستقل است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 215.48,
   "end": 219.78,
   "text": "و ایجاد و علیتش قائم به ذات است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 219.78,
   "end": 225.56,
   "text": "و هیچ وابستگی به غیر ندارد و مؤثری در عالم جز او نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 225.56,
   "end": 229.26,
   "text": "همون اصل فلسفی که «لا مؤثر في الوجود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 229.26,
   "end": 231.86,
   "text": "إلا الله» قرآنی‌ش میشد چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 231.86,
   "end": 236.74,
   "text": "«ما شاء الله لا قوة إلا بالله» هیچ قوه‌ای نیست مگر از الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 236.74,
   "end": 242.8,
   "text": "فلسفی‌ش میشد اصل فلسفی‌ش «لا مؤثر في الوجود إلا الله» اینجا رو داره می‌فرماید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 242.8,
   "end": 249.64,
   "text": "و از آنجا که استقلال در وجود ملاک و معیار فاعل، فاعل حقیقی و ایجادی است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 249.64,
   "end": 254.28,
   "text": "و وجودی که عین ربط است نمی‌تواند ایجاد کند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 254.28,
   "end": 257.02,
   "text": "یا ایجاد کننده باشد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 257.02,
   "end": 266.32,
   "text": "پس تأثیر و فاعلیت از آن خداوند و منحصر در اوست و دیگر اشیا به منزله واسطه و معدات هستند، نه مؤثر حقیقی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 266.32,
   "end": 269.28,
   "text": "می‌فرماید همه عین ربط به حضرت حق‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 269.28,
   "end": 271.42,
   "text": "یعنی ربط و برداری اصلاً نمیشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 271.42,
   "end": 273.52,
   "text": "برداری که نیستو نابوده طرف،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 273.52,
   "end": 278.54,
   "text": "معدوم میشه. همین که موجوده عین ربط به وجود حقیقی ح--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 278.54,
   "end": 281.74,
   "text": "و صمدی قرآنی حضرت حق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 281.74,
   "end": 286.58,
   "text": "درست شد؟ پس همه میشن در طول اون، همه میشن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 286.58,
   "end": 290.08,
   "text": "رو-- فوقش، فوقش بگیریم میشن وسائط.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 290.08,
   "end": 292.26,
   "text": "یعنی واسطه‌اند. معدات‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 292.26,
   "end": 294.34,
   "text": "علت تامه فقط حضرت حق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 294.34,
   "end": 300.94,
   "text": "این میشه توحید افعالی. یه جمله دیگه‌ای هم از کتاب الطلب و الاراده ایشون بخونیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 300.94,
   "end": 305.06,
   "text": "صفحه شصت و دو خواستید رجوع کنید حضرت امام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 305.06,
   "end": 307.98,
   "text": "فرمودن حق تعالی تمام حقیقت وجود است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 307.98,
   "end": 309.6,
   "text": "خیلی عالیه این چند جمله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 309.6,
   "end": 318.56,
   "text": "عالی، عالی، عالی. حق تعالی تمام حقیقت وجود است و هیچ شیئی از حیطه‌ی وجودی او خارج نیست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 318.56,
   "end": 322.38,
   "text": "و مخلوقات ظل او هستند، یعنی سایه اونن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 322.38,
   "end": 327.34,
   "text": "و هرجا اثری باشد متعلق به خداوند است و ممکنات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 327.34,
   "end": 331.56,
   "text": "جز تعلقات و روابط و ظهورات او نیستند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 331.56,
   "end": 336.14,
   "text": "خود و افعالشان مظاهر فاعلیت حق هستند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 336.14,
   "end": 338.3,
   "text": "همه‌ی مخلوقات،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 338.3,
   "end": 340.84,
   "text": "اینا چی‌اند؟ مظاهر فاعلیت حق‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 340.84,
   "end": 343.28,
   "text": "یعنی خ-- اصلاً فاعل مطلق خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 343.28,
   "end": 345.64,
   "text": "هر کاری رو خدا داره انجام میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 345.64,
   "end": 349.18,
   "text": "پس ما چی‌کاره‌ایم؟ ما در طول اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 349.18,
   "end": 351.74,
   "text": "اراده‌ایم. یعنی اراده ما در طول اون اراده است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 351.74,
   "end": 355.48,
   "text": "به یک معنا میشه گفت ما انتخاب فقط می‌کنیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 355.48,
   "end": 359.76,
   "text": "که کدوم راهو بریم. بعد دیگه کار رو خدا انجام میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 359.76,
   "end": 362.24,
   "text": "اینو من در گوشی به شما بگم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 362.24,
   "end": 364.08,
   "text": "هرکسی هم شاید درکش نکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 364.08,
   "end": 368.99,
   "text": "اِاِاِ حالا کسی که این چنین فکر کنه و این چنین اعتقاد داشته باشه حضرت امام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 368.99,
   "end": 373.49,
   "text": "جملات ایشون بود دیگه. میشه از عهدی بترسه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 373.49,
   "end": 378.95,
   "text": "میشه؟ اینکه مرحوم آیت‌الله اشرافی اصفهانی روحش شاد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 378.95,
   "end": 381.67,
   "text": "شهید اصفهانی می‌فرمودن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 381.67,
   "end": 384.03,
   "text": "این معجزه است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 384.03,
   "end": 386.69,
   "text": "از حضرت امام شنیده بود که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 386.69,
   "end": 390.13,
   "text": "فرموده بودند والله قسم به عمرم یک بار نترسیدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 390.13,
   "end": 392.07,
   "text": "ایشون می‌فرمودن این معجزه است آقا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 392.07,
   "end": 394.17,
   "text": "یه نفری یک بار تو عمرش نترسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 394.17,
   "end": 400.53,
   "text": "این معجزه است. خب بله کسی که به این اعتقادات واقعاً برسه از چی بترسه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 400.53,
   "end": 403.37,
   "text": "خدا رحمت کنه آقای قاضی رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 403.37,
   "end": 405.67,
   "text": "تو نجف جنگ شد، درگیری شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 405.67,
   "end": 411.19,
   "text": "دو تا طایفه به جون هم اندا-- افتادن و جنگ و سخت تو نجف درگیر شدن و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 411.19,
   "end": 414.11,
   "text": "بعد جالبه که یکی از اینا بالا پشت بوم آقای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 414.11,
   "end": 418.67,
   "text": "قاضی مستقر شده بودن و بعد اون‌ها غالب شدن و ریختن تو خونه آقای قاضی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 418.67,
   "end": 423.81,
   "text": "حالا آقای قاضی در-- پا درد شدید داشت تو ایوان دراز کشیده بود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 423.81,
   "end": 425.63,
   "text": "نگاه می‌کرد اینا رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 425.63,
   "end": 433.37,
   "text": "بعد دو تا جنازه افتاد پشت بوم آقای قاضی میگه دیدم از این نا–ناودون همینطوری خون داره می‌ریزه پایین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 433.37,
   "end": 437.43,
   "text": "می‌زدن می‌کشتن. دو تا جنازه دیگه افتاد تو ایوان بغل من.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 437.43,
   "end": 439.63,
   "text": "دو تا دیگه افتاد توی حیاط.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 439.63,
   "end": 442.97,
   "text": "شش تا جنازه تو خونه بود همینطوری نگاه می‌کردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 442.97,
   "end": 444.67,
   "text": "هیچ-- بگه حالا ما بودیم چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 444.67,
   "end": 447.07,
   "text": "این خونو می‌دیدیم دفرار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 447.07,
   "end": 449.73,
   "text": "چرا تکون نمی‌خوره آقای قاضی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 449.73,
   "end": 453.33,
   "text": "یا تو اون درس معروفش داشت اینم بشنویم و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 453.33,
   "end": 460.09,
   "text": "شیرینه برای امروز بسه. همین توحید افعالی رو داشت درس می‌داد آقای قاضی سر کلاس برای طلبه‌ها،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 460.09,
   "end": 462.65,
   "text": "اون حجره‌های قدیمی و اینا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 462.65,
   "end": 467.73,
   "text": "یه دفعه بالا سرش یه سر و صدایی کرد و انگار که می‌خواد مثلاً سقف بریزه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 467.73,
   "end": 472.03,
   "text": "طلبه‌ها الفرار. همه فرار، همه فرار کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 472.03,
   "end": 475.75,
   "text": "زندگی‌نامه ایشون نوشته که آقای قاضی محکم اصلاً تکون نخورد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 475.75,
   "end": 481.87,
   "text": "همینطوری که نشسته بود گفت برگردید من دارم برای شما توحید افعالی درس میدم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 481.87,
   "end": 488.81,
   "text": "برگردید. همه نگاه کردن دیدن اون قسمتی که بالا سر آقای قاضیه داشت می‌ریخت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 488.81,
   "end": 493.25,
   "text": "بعد نگو حالا اون پشتش دارن بنایی می‌کردن از اون پشت ریخته بود و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 493.25,
   "end": 497.87,
   "text": "آقای قاضی فرمود برگردید که من توحید افعالی دارم به شما میدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 497.87,
   "end": 500.03,
   "text": "چی باعث میشه که نترسه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 500.03,
   "end": 502.15,
   "text": "چی واقعاً باعث... توحید افعالی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 502.15,
   "end": 504.59,
   "text": "اینا باید تو زندگی ما موج بزنه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 504.59,
   "end": 507.85,
   "text": "داستان که نیست که. اینا قصه که نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 507.85,
   "end": 511.81,
   "text": "حالا یه جمله‌ای رو من انشاالله توفیق باشه فردا براتون میگم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 511.81,
   "end": 515.57,
   "text": "الان فرصت نیست که بفرمایید ارزش و اهمیت این توحید چیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 515.57,
   "end": 519.41,
   "text": "تا جایی که همنشینی با",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 519.41,
   "end": 523.99,
   "text": "ما با اهل بیت عصمت و طهارت علیهم الصلاة والسلام و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 523.99,
   "end": 527.47,
   "text": "همین توحید سه گانه رقم می‌زنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 527.47,
   "end": 530.55,
   "text": "درباره‌ش حرف می‌زنیم. والحمد لله رب العالمين.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 530.55,
   "end": 536.53,
   "text": "صلوات بفرستید. اللهم صل على محمد وآل محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}