 "chapters": [
  {
   "index": 0,
   "title": "## آیهٔ هفتادویک انعام؛ توحید افعالی",
   "start": 2.68,
   "end": 67.82
  },
  {
   "index": 1,
   "title": "## حیرت پیرو شیطان",
   "start": 67.82,
   "end": 165.06
  },
  {
   "index": 2,
   "title": "## امر به تسلیم رب العالمین",
   "start": 165.06,
   "end": 246.0
  },
  {
   "index": 3,
   "title": "## ادعای توحید افعالی و تازیانهٔ امتحان",
   "start": 246.0,
   "end": 266.0
  },
  {
   "index": 4,
   "title": "## کوفه و مسلم؛ آزمایش ولایت در طول",
   "start": 266.0,
   "end": 303.44
  },
  {
   "index": 5,
   "title": "## قل؛ مرام‌نامه را اظهار کن",
   "start": 303.44,
   "end": 437.33
  },
  {
   "index": 6,
   "title": "## امانت بودن خود و کشف غطاء",
   "start": 437.33,
   "end": 739.49
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 2.68,
   "end": 5.76,
   "text": "بسم الله الرحمن الرحیم و به این استعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 5.76,
   "end": 11.58,
   "text": "السلام علیک یا داعی الله و ربانی ایاته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 11.58,
   "end": 15.46,
   "text": "سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 15.46,
   "end": 20.06,
   "text": "آیه هفتاد و یک سوره انعام هم پیرامون توحید افعالی‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 20.06,
   "end": 27.14,
   "text": "قرائت کنیم. \"قل اندعوا من دون الله ما لا ينفعنا ولا يضرنا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 27.14,
   "end": 32.92,
   "text": "ونرد على أعقابنا بعد إذ هدانا الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 32.92,
   "end": 37.34,
   "text": "كاللذي استهوت الشياطين",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 37.34,
   "end": 43.48,
   "text": "في الأرض حيران له أصحاب يدعونه إلى الهدى اعتنا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 43.48,
   "end": 46.36,
   "text": "قل إن هدى الله هوى الهدى",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 46.36,
   "end": 50.62,
   "text": "وأمرنا لنسلم لرب العالمين\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 50.62,
   "end": 57.38,
   "text": "میفرماید پیغمبر بهشون بگو که آیا به جای خدا معبودی رو بپرستیم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 57.38,
   "end": 60.8,
   "text": "نه سودی به ما میرسونه و نه زیانی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 60.8,
   "end": 65.16,
   "text": "یعنی هیچ، هیچ ازش هیچی صادر نمیشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 65.16,
   "end": 69.82,
   "text": "سنگ و چوب. و پس از آنکه خدا ما را هدایت کرد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 69.82,
   "end": 73.78,
   "text": "به فرهنگ و فضای جاهلیت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 73.78,
   "end": 80.5,
   "text": "بازمان گردانند؟ یعنی وقتی خدا ما را هدایت کرده دوباره ما بریم تحت سیطره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 80.5,
   "end": 82.78,
   "text": "جاهلیت اون‌ها؛",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 82.78,
   "end": 86.58,
   "text": "که الان حالا اگر اون موقع جاهلیت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 86.58,
   "end": 92.12,
   "text": "اون شکلی بود، الان جاهلیت، جاهلیت مدرنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 92.12,
   "end": 95.62,
   "text": "در حالی که برای او یارانی است که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 95.62,
   "end": 99.7,
   "text": "حالا میگه مانند کسی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 99.7,
   "end": 104.62,
   "text": "اگر ما این کارو بکنیم مانند کسی که شیاطین عقلش رو ربودن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 104.62,
   "end": 108.26,
   "text": "و در زمین سرگردان است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 108.26,
   "end": 111.36,
   "text": "حيران له أصحاب يدعونه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 111.36,
   "end": 113.5,
   "text": "سرگردان و حیران است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 113.5,
   "end": 116.2,
   "text": "میگه کسی که به دنبال شیطان میره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 116.2,
   "end": 121.34,
   "text": "هدایت الهی رو ول میکنه، حیرانه، سرگشته‌ست، سرگردانه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 121.34,
   "end": 123.26,
   "text": "نفسش نفس مضطربه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 123.26,
   "end": 126.32,
   "text": "هیچوقت به آرامش نمیرسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 126.32,
   "end": 131.22,
   "text": "و در حالی که برای او یارانی است که وی را به سوی هدایت دعوت می‌کنند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 131.22,
   "end": 137.36,
   "text": "که به جانب ما بیا. بگو یقیناً هدایت خدا همان هدایت است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 137.36,
   "end": 142.0,
   "text": "\"قل إن هدى الله هوى الهدى\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 142.0,
   "end": 144.12,
   "text": "هدایتی، هدایته که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 144.12,
   "end": 145.92,
   "text": "از سمت و ناحیه حضرت حق باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 145.92,
   "end": 149.38,
   "text": "هدایت من درآوردی و دین من درآوردی و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 149.38,
   "end": 154.28,
   "text": "که ما شاء الشيطان الان زیاد شده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 154.28,
   "end": 157.24,
   "text": "تحریف‌ها، تفاسیر به رأی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 157.24,
   "end": 159.54,
   "text": "تا دلت بخواد. اینا رو ول کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 159.54,
   "end": 165.06,
   "text": "ببین خدا چگونه دعوت کرده و ما مأموریم که تسلیم پروردگار جهانیان باشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 165.06,
   "end": 168.48,
   "text": "و أمرنا اصلاً به ما امر شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 168.48,
   "end": 170.24,
   "text": "به ما امر شده که چی بشیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 170.24,
   "end": 175.24,
   "text": "\"لنسلم لرب العالمين\" تسلیم پروردگار عالمین باشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 175.24,
   "end": 178.28,
   "text": "چرا آدم تسلیم کس دیگه‌ای باشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 178.28,
   "end": 181.42,
   "text": "اگر او رب العالمین‌ه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 181.42,
   "end": 186.16,
   "text": "الحمد لله رب العالمين در ذکر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 186.16,
   "end": 192.7,
   "text": "سوره حمد که در قرآن می‌خونیم بعد بسم الله اولین جمله‌ای که ما اظهار می‌کنیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 192.7,
   "end": 198.4,
   "text": "اعلام می‌کنیم به خودمون و به همه‌ی جهان پیرامون میگیم الحمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 198.4,
   "end": 200.38,
   "text": "لله. کدوم الله؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 200.38,
   "end": 208.86,
   "text": "رب العالمين. پروردگاری‌ست که حالا رب، ربی‌ست که تدبیر کننده است، رزق می‌دهد، تدبیر می‌کند،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 208.86,
   "end": 212.32,
   "text": "از بلاهاها و حوادث حفظ می‌کند،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 212.32,
   "end": 217.24,
   "text": "تقدیر میکنه، تدبیر میکنه، اندازه‌گیری میکنه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 217.24,
   "end": 220.98,
   "text": "مدیریت میکنه، عقل رو پیاده میکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 220.98,
   "end": 223.74,
   "text": "به وسیله نفس زندگیت رو دست میگیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 223.74,
   "end": 228.06,
   "text": "بسپر به خدا، ببین خدا چگونه زندگیت رو مدیریت میکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 228.06,
   "end": 232.74,
   "text": "البته نسبت به ادعامون خدا همونطور رفتار میکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 232.74,
   "end": 239.52,
   "text": "شما میخوای مدارج عالیه رو بپیمایی، میخوای درجاتت بره بالا، میخوای آدم عالیی باشی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 239.52,
   "end": 244.52,
   "text": "خب قطعاً امتحاناتتم سنگین‌تره عزیز دلم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 244.52,
   "end": 248.68,
   "text": "شاید شما باورتون نشه از وقتی که ما اینجا توحید افعالی رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 248.68,
   "end": 254.16,
   "text": "سفره‌ش رو پهن کردیم برای خود بنده اتفاقات عجیب و غریب،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 254.16,
   "end": 259.72,
   "text": "بلاهای عجیب و غریب که اصلاً سابقاً نداشته تو زندگیم داره رخ میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 259.72,
   "end": 264.8,
   "text": "فکر میکنید چیه علتش؟ داریم ادعا میکنیم توحید افعالی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 264.8,
   "end": 271.1,
   "text": "\"بيده ملكوت كل شيء يد الله فوق أيديهم لا حول ولا قوة إلا بالله\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 271.1,
   "end": 274.36,
   "text": "خدا میگه اع ادعا کردی توحید افعالی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 274.36,
   "end": 276.46,
   "text": "لا حول ولا قوة إلا بالله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 276.46,
   "end": 279.1,
   "text": "بسم الله. ببینم میتونی طاقت بیاری؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 279.1,
   "end": 284.54,
   "text": "تا کجا مرد شی؟ هر کجا آدم ادعا میکنه سر همونم میخوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 284.54,
   "end": 288.08,
   "text": "آدم یا نباید ادعا کنه یا پاش واسته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 288.08,
   "end": 294.5,
   "text": "مثل خیلیا که صدر اسلام دم از پیغمبر زدند اما پای امیرالمؤمنین که وصی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 294.5,
   "end": 297.44,
   "text": "بلا فصل پیغمبر بود وا نستادند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 297.44,
   "end": 300.44,
   "text": "اولین جایی که البته اولین جا که به صورت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 300.44,
   "end": 307.2,
   "text": "عمومی و رسمی و مکاتبه شد اینها و الا خب قبلش هم خیلی بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 307.2,
   "end": 311.42,
   "text": "امام معصوم ولایت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 311.42,
   "end": 316.82,
   "text": "بی چون و چرای یک غیر معصوم رو ولایت خودش معرفی کرد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 316.82,
   "end": 318.82,
   "text": "در قضیه کوفه بود و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 318.82,
   "end": 321.36,
   "text": "حضرت مسلم بن عقیل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 321.36,
   "end": 323.4,
   "text": "چقدرها تو زرد و ازاب درومدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 323.4,
   "end": 325.58,
   "text": "تقریباً غریبه به اتفاق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 325.58,
   "end": 327.44,
   "text": "دم از ولایت اباعبدالله زدند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 327.44,
   "end": 329.8,
   "text": "هجده هزار نامه نوشتند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 329.8,
   "end": 333.82,
   "text": "حالا بعضیا که میگن هجده هزار بزرگان قبایل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 333.82,
   "end": 337.82,
   "text": "یعنی هر کدومشون عشیره‌ای زیر دستشون بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 337.82,
   "end": 341.66,
   "text": "اینو ضرب کن در چند ببین چه عددی در میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 341.66,
   "end": 345.94,
   "text": "نامه نوشتن خواستن. خب حالا حضرت خودش نیومد نماینده‌ش رو فرستاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 345.94,
   "end": 348.74,
   "text": "این آقا کیه؟ این چیه؟ مثلا کاری به ایشون نداریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 348.74,
   "end": 351.52,
   "text": "ما تو رو خواستیم. تو باید بیای.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 351.52,
   "end": 354.02,
   "text": "اونجا میگه آقا هرچی ایشون گفت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 354.02,
   "end": 356.76,
   "text": "سمعاً و طاعتم باید بپذیرید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 356.76,
   "end": 360.1,
   "text": "دقیقاً امتحانی که ما الان داریم پس میدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 360.1,
   "end": 364.42,
   "text": "اگه تو ولایت رو در طول ولایت کلیه میبینی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 364.42,
   "end": 370.05,
   "text": "باید بگی چشم. مگه میشه امام عصر رها کرده باشه شیعه رو؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 370.05,
   "end": 374.51,
   "text": "اصلاً امکانش هست؟ ولا ننسي لذكركم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 374.51,
   "end": 377.05,
   "text": "اصلاً نمیشه ما شما رو هیچ وقت یادمون نمیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 377.05,
   "end": 381.51,
   "text": "امام عصر فرمودن دیگه. ما همیشه به یاد شما هستیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 381.51,
   "end": 383.75,
   "text": "مگر میشه معطل بمونه دین خدا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 383.75,
   "end": 387.63,
   "text": "این همه خون‌های پاک پای این دین ریخته شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 387.63,
   "end": 391.73,
   "text": "پای هدایت الهی خون‌ها ریخته-- پاک‌ترین خون‌ها ریخته شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 391.73,
   "end": 395.65,
   "text": "پاک‌تر از خون حضرت صدوق شهید سراغ داری؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 395.65,
   "end": 399.89,
   "text": "پاکیته-- پاکیزه تر از خون فرق امیرالمؤمنین سراغ داری؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 399.89,
   "end": 404.47,
   "text": "خون جگر امام مجتبی و خون گلو سیدالشهد سراغ داری؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 404.47,
   "end": 407.05,
   "text": "این‌ها ریخته شده پای هدایت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 407.05,
   "end": 410.17,
   "text": "پای دین که یک پارچه هدایت الهیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 410.17,
   "end": 413.39,
   "text": "لذا اینجا می‌فرماید چی؟ می‌فرماید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 413.39,
   "end": 417.03,
   "text": "قل بگو بهشون اصلاً بگو موضوعیت داره اینجا گفتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 417.03,
   "end": 420.11,
   "text": "میگه بگو فقط تو دل خودت نگه ندار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 420.11,
   "end": 423.89,
   "text": "بگو به بچه‌ت بگو به همسرت بگو به همکارت بگو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 423.89,
   "end": 427.31,
   "text": "به رفیقات بگو مرام نامه‌تو اظهار کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 427.31,
   "end": 432.45,
   "text": "درو نباش به همه بگو چی-- چیکاره‌ای.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 432.45,
   "end": 435.51,
   "text": "قل انه هدى الله هو الهدى.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 435.51,
   "end": 441.11,
   "text": "اون هدایت الله الهیت نظام که پیاده شده هو الهدى",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 441.11,
   "end": 444.75,
   "text": "همون هو الهدى. اون هدایته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 444.75,
   "end": 448.79,
   "text": "هدایت که از ناحیه هو باشه این هو به چی میخوره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 448.79,
   "end": 453.95,
   "text": "هدایت الهی. هدایت که الله داشت تعریفش کرده باشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 453.95,
   "end": 458.01,
   "text": "نه از خودت. بعد جمع شدن برای خودشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 458.01,
   "end": 462.95,
   "text": "همون مثالی که زدم یکی از یعنی مترجم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 462.95,
   "end": 468.63,
   "text": "قالب گفتگوی‌های شهید سید حسن نصرالله شبانه تو اتاق ما بود عزیزان دیدنشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 468.63,
   "end": 471.43,
   "text": "بچه بسیار خوب، باصفا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 471.43,
   "end": 476.63,
   "text": "تقریباً رفاقت ما برمی‌گرده به سی و پنج سال پیش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 476.63,
   "end": 478.61,
   "text": "بسیار آدم عجیبی بود از مکه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 478.61,
   "end": 484.89,
   "text": "برگشته بود. اومد با هم گفت‌وگو داشتیم گفت اونجا جریانشو براتون گفتم دیگه رو به روی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 484.89,
   "end": 487.35,
   "text": "بیت خدا یه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 487.35,
   "end": 492.31,
   "text": "اهل تسننی رو میگه حالا اینطوری تو ذهنم هست که فکر می‌کنم از شهر کشور مصر گفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 492.31,
   "end": 495.25,
   "text": "راست خیلی از ما خوشش اومد و گفت‌وگو کردیم و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 495.25,
   "end": 498.47,
   "text": "تا فهمید من شیعه‌ام فکر می‌کرد من اهل تسننم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 498.47,
   "end": 503.55,
   "text": "گفت تا من ش-- گفت من بهش گفتم شیعه هستم گفت برای چی شیعه چرا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 503.55,
   "end": 507.35,
   "text": "حیفه تو نیست رفتی شیعه شدی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 507.35,
   "end": 509.95,
   "text": "بهش گفتم که شما چرا رفتی سنی شدی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 509.95,
   "end": 514.11,
   "text": "اگه حیفه من شیعه شدم شما چرا سنی شدی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 514.11,
   "end": 517.15,
   "text": "بهش یه جمله گفتم همینطوری هاج و واج موند و رفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 517.15,
   "end": 520.83,
   "text": "هیچ جوابی براش نیاورد. گفتم شما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 520.83,
   "end": 528.95,
   "text": "پس از شهادت پیغمبر هنوز کفن آقا خشک نشده بود دور هم جمع شدید خودتون یکی رو انتخاب کردید جانشین پیغمبر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 528.95,
   "end": 531.15,
   "text": "درسته؟ گفت بله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 531.15,
   "end": 534.43,
   "text": "ما همین کارو کردیم. گفت خب حالا بفرمایید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 534.43,
   "end": 536.77,
   "text": "الان هم جمع شید دور هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 536.77,
   "end": 541.17,
   "text": "همه مشایخ‌تون جمع شید یه نفر رو انتخاب کنید به عنوان امام عصر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 541.17,
   "end": 544.47,
   "text": "مگر میشه دنیا بدون امام بمونه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 544.47,
   "end": 546.75,
   "text": "یعنی خدا معطل قرار بده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 546.75,
   "end": 553.27,
   "text": "بنده گانش رو رها کنه بعد این همه خون‌هایی که ریخته شده، این همه زحمت‌هایی که پیغمبر کشیده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 553.27,
   "end": 555.51,
   "text": "یه کتابی هست حتما اینو بخونید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 555.51,
   "end": 560.03,
   "text": "الفین خدا رحمت کنه علامه حلی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 560.03,
   "end": 567.33,
   "text": "من اون اوایل که منبر می‌رفتم اول هر منبرم یه دونه از اصول هزار و سیصد و تقریباً پنجاه اصله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 567.33,
   "end": 569.55,
   "text": "روش زده الفین یعنی دو هزار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 569.55,
   "end": 573.33,
   "text": "اما بقیه‌ش رو بعضیا میگن پسرش نذاشت به دست دیگران برسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 573.33,
   "end": 574.89,
   "text": "بعضیا میگن نه مفقود شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 574.89,
   "end": 582.49,
   "text": "دو جلد بوده، یه جلدش مونده. سی-- هزار و سیصد و خورده‌ای اصل در اثبات ولایت امیرالمؤمنین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 582.49,
   "end": 584.81,
   "text": "خب اینا رو بخونید به بچه‌هامون بگین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 584.81,
   "end": 587.61,
   "text": "اینجا من آوردم رو میزم شاید باشه الان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 587.61,
   "end": 593.15,
   "text": "الفین علامه حلی. تو اونجا نوشته پ-- یکی از اصولش اینه اینطوری اثبات می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 593.15,
   "end": 599.13,
   "text": "میگه پیغمبر برای پست‌ترین شؤونات بشری دستور داده یعنی خدا بهش دستور داده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 599.13,
   "end": 603.35,
   "text": "پیغمبر هم مبلغه از سمت ناحیه خدا اومده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 603.35,
   "end": 606.37,
   "text": "میگه اگر حرف منو گوش ندادی رگ گردنتو میزنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 606.37,
   "end": 609.55,
   "text": "خدا به پیغمبرش اینطوری غیرت نشون میده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 609.55,
   "end": 611.21,
   "text": "رو ناموسش که دینشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 611.21,
   "end": 614.51,
   "text": "حسین ابن علی شهید شد به خاطر دین خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 614.51,
   "end": 616.23,
   "text": "ناموس خدا دین خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 616.23,
   "end": 619.15,
   "text": "افراد و اشخاص باید فدا بشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 619.15,
   "end": 622.83,
   "text": "اونجا میگه چطور برای پست‌ترین چیزها جسارت می‌کنن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 622.83,
   "end": 631.15,
   "text": "علامه حلی میگه به علمای اهل تسنن میگه مثل اینکه می‌خوای بری تو بیت الخلاء که پست‌ترین شؤونات بشریه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 631.15,
   "end": 636.73,
   "text": "با پای چپ بری برمی‌گردی بیرون با پای راست بیای نشستی سنگینی تو بندازی رو پای چپت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 636.73,
   "end": 642.49,
   "text": "علتشم میگه این ذکرو بگی، سرت پوشیده باشه، دست به شکمت بکشی، این شه--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 642.49,
   "end": 646.27,
   "text": "چطور برای این‌ها هجده تا دستور داره پیغمبر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 646.27,
   "end": 650.85,
   "text": "بعد برای ولایت و زعامت امت دستور نداره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 650.85,
   "end": 654.53,
   "text": "دستشون بسته است. میگه من بهش گفتم آقا بفرمایید همین الان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 654.53,
   "end": 657.59,
   "text": "یه جانشین پیدا کنید خودتون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 657.59,
   "end": 664.41,
   "text": "انتخاب کنید جهان شیع-- جهان اسلام را از این تشدد نجات بده و جلوی ظلم و جور بایسته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 664.41,
   "end": 667.57,
   "text": "امام‌تون کو؟ میگه همین‌طور هاج و واج موند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 667.57,
   "end": 670.65,
   "text": "یه نگاه به کعبه کرد و سرشو انداخت پایین و رفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 670.65,
   "end": 674.99,
   "text": "فهمید چه غلطی کرده. خب بفرمایید اصلاً نمیشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 674.99,
   "end": 677.53,
   "text": "الهیت نظام هستی داره پیاده میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 677.53,
   "end": 680.91,
   "text": "همه چی هم به دست اوست. ما باید دل بسپریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 680.91,
   "end": 683.29,
   "text": "دل نسپری به زور میبرنت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 683.29,
   "end": 685.49,
   "text": "حالا یه جوالانی تو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 685.49,
   "end": 692.23,
   "text": "دنیا به ما دادن فکر می‌کنیم خبریه مثلاً رو بچه‌مون اسم میذاریم تو گوشش می‌زنیم داد می‌زنیم سرش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 692.23,
   "end": 694.03,
   "text": "در صورتی که اونم امانت دست ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 694.03,
   "end": 696.05,
   "text": "منم خودمم مال خودم نیستم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 696.05,
   "end": 698.59,
   "text": "منم امانت الهی دست خودمم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 698.59,
   "end": 702.47,
   "text": "بعد اینو وقت م-- متأسفانه موت می‌فهمیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 702.47,
   "end": 706.19,
   "text": "فبصر الی يوم حدید فکشفنا عنک غطاءک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 706.19,
   "end": 708.09,
   "text": "فبصر الی يوم حدید. وقتی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 708.09,
   "end": 713.39,
   "text": "پرده افتاد چشمت تیز شد تازه می‌فهمی لا حول و لا قوه الا الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 713.39,
   "end": 716.99,
   "text": "چه بهشتی باشی چه جهنم به زور می‌کشن میبرنت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 716.99,
   "end": 719.41,
   "text": "دیگه اصلاً اختیاری وجود نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 719.41,
   "end": 723.03,
   "text": "این توحید افعالی خیلی گم شده ماست رفقا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 723.03,
   "end": 728.47,
   "text": "دارم میگم تازیانه‌هاش داره میاد سمت من فقط به جهت گفتنش برای شماها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 728.47,
   "end": 731.37,
   "text": "خدا توفیق صبرش رو هم به ما عطا کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 731.37,
   "end": 733.73,
   "text": "والحمد لله رب العالمين.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 733.73,
   "end": 736.49,
   "text": "صلوات بفرستید. اللهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 736.49,
   "end": 739.49,
   "text": "صل علی محمد و آل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}