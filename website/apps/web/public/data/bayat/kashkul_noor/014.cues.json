   "title": "## ذکر و اسم؛ ظاهر و باطن",
   "start": 17.34,
   "end": 94.4
  },
  {
   "index": 1,
   "title": "## منابع دعا و اشارهٔ علامه حسن‌زاده",
   "start": 94.4,
   "end": 169.34
  },
  {
   "index": 2,
   "title": "## ظاهر به طاعت؛ باطن به محبت",
   "start": 169.34,
   "end": 201.28
  },
  {
   "index": 3,
   "title": "## قلب به معرفت؛ روح به مشاهده؛ سِرّ به اتصال",
   "start": 201.28,
   "end": 225.98
  },
  {
   "index": 4,
   "title": "## آرامش در معرفت قلبی، نه در کثرت اطلاعات",
   "start": 225.98,
   "end": 587.7
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 2.62,
   "end": 6.26,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 6.26,
   "end": 10.32,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 10.32,
   "end": 17.34,
   "text": "آیاته. السلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 17.34,
   "end": 21.72,
   "text": "بحث ما در خصوص فرق بین ذکر و اسم و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 21.72,
   "end": 28.98,
   "text": "ظاهر و باطن و این‌ها بود و اینکه لفظی که ما استفاده می‌کنیم ولو اگر ورد زبانمون بشه و لب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 28.98,
   "end": 34.58,
   "text": "اون تر بشه باز بهش نمیشه گفت ذکر مگر اینکه همراه با قلب بشه یا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 34.58,
   "end": 38.12,
   "text": "قلب اون رو درک کنه، ادراک قلبی از اون داشته باشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 38.12,
   "end": 40.74,
   "text": "یعنی به مرحله باطن مون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 40.74,
   "end": 48.4,
   "text": "رسیده باشه ولو حالا به اون مراحل باطن‌تر به یک معنا مثل روح",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 48.4,
   "end": 51.4,
   "text": "و سر هنوز نرسیده باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 51.4,
   "end": 55.24,
   "text": "اما به مرحله قلب رسید دیگه میشه ذکر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 55.24,
   "end": 58.52,
   "text": "به یک معنا چشیده شده‌ست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 58.52,
   "end": 61.52,
   "text": "درک شده‌ست. یه--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 61.52,
   "end": 65.1,
   "text": "برای اینکه متوجه بشیم بالاخره اینا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 65.1,
   "end": 68.88,
   "text": "مراتب دارن. انسان همونطور که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 68.88,
   "end": 72.02,
   "text": "نظام آفاقی بیرون از ما، این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 72.02,
   "end": 76.82,
   "text": "چینش و بافت نظام هستی مرربه، ذو مراته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 76.82,
   "end": 80.8,
   "text": "مراتب متعدد هم در خود ما هم هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 80.8,
   "end": 83.24,
   "text": "توجهمون رو جلب می‌کنیم به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 83.24,
   "end": 91.14,
   "text": "یه دعای خیلی شریف و زیبایی بسیار عالی از امیرالمؤمنین حضرت وصی علی علیه الصلاة والسلام که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 91.14,
   "end": 94.08,
   "text": "اگر دوست داشتید یه اشاره لطیفی هم--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 94.08,
   "end": 97.88,
   "text": "من امروز صوت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 97.88,
   "end": 101.66,
   "text": "جلسه هشتاد و یک از شرح اسفار ملاصدرا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 101.66,
   "end": 107.38,
   "text": "علامه حسن زاده رو گوش می‌دادم، خیلی شیرین و لطیف اشاره به این دعا کرده بودند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 107.38,
   "end": 111.44,
   "text": "البته منبع اصلی این دعا اگه خواستید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 111.44,
   "end": 117.74,
   "text": "انوار الحقیقه و اطوار الطریقه و اسرار الشریعه سید حیدر آملی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 117.74,
   "end": 123.56,
   "text": "علامه آملی. به شخصیت ایشون رو تا حدی واقف هستید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 123.56,
   "end": 127.6,
   "text": "علامه حسن زاده علیه الرحمه در هزار و یک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 127.6,
   "end": 131.02,
   "text": "کلمه‌شون، در کتاب هزار و یک کلمه‌شون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 131.02,
   "end": 133.9,
   "text": "جلد چهار صفحه صد و نوزده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 133.9,
   "end": 137.5,
   "text": "به نقل از رساله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 137.5,
   "end": 144.94,
   "text": "بحر المعارف مola عبد الصمد حمدانی این رو آورده، اونجا هم آورده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 144.94,
   "end": 147.08,
   "text": "خیلی دعای شریفیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 147.08,
   "end": 149.68,
   "text": "من این رو براتون قرائت می‌کنم ببینید که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 149.68,
   "end": 152.5,
   "text": "قشنگ داره تداعی می‌کنه که ما یک ظاهر داریم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 152.5,
   "end": 158.7,
   "text": "و یک باطن داریم و اتفاقا مرتبه قلب و روح و سر رو اونجا مola بیان می‌کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 158.7,
   "end": 161.74,
   "text": "و هر کدومشون می‌زنه به یک جا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 161.74,
   "end": 165.24,
   "text": "به یک مرحله، به یک رتبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 165.24,
   "end": 169.34,
   "text": "که الان مثلا خروجی قلب چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 169.34,
   "end": 174.54,
   "text": "دعا اینه که اللهم خیلی شیرینه، خوبه این دعا رو هممون حس کنیم و بخونیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 174.54,
   "end": 181.62,
   "text": "اللهم نور. حالا اینجا چقدر حرف‌ها بزرگان پیاده کردن و چقدر حرف ازش در میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 181.62,
   "end": 184.96,
   "text": "نور، نورانی کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 184.96,
   "end": 187.6,
   "text": "بحث نوره. واهری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 187.6,
   "end": 192.9,
   "text": "ظاهر من رو. به چی؟ این نشون میده که با چی ظاهر من نورانی میشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 192.9,
   "end": 196.64,
   "text": "به طاعتك. که این مرتبه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 196.64,
   "end": 205.38,
   "text": "بعضا فرمودن که از بزرگان که این مرتبه‌ی اتصال اوامر و نواهی در حوزه شریعته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 205.38,
   "end": 207.92,
   "text": "ظاهر. خب این مرحله ظاهر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 207.92,
   "end": 212.44,
   "text": "و باطنی از مرحله ظاهر رفت به باطن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 212.44,
   "end": 215.44,
   "text": "این نشون میده که ما دو وجه داریم ظاهر و باطن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 215.44,
   "end": 218.98,
   "text": "همونطور که قبلا عرض کردیم این یکی از منابع ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 218.98,
   "end": 223.34,
   "text": "و وا-- و باطنی، باطن ما به چی نورانی میشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 223.34,
   "end": 228.14,
   "text": "اگه گفتید طبق فرمایش مola در این دعا و باطنی به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 228.14,
   "end": 232.36,
   "text": "محبتک احسن. محبت اولین وادی سلوکه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 232.36,
   "end": 237.62,
   "text": "یعنی در سیر و سلوک متفق القول قبول کردن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 237.62,
   "end": 239.64,
   "text": "تا عشق، تا محبت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 239.64,
   "end": 242.86,
   "text": "جوشش، خروش، این‌ها نباشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 242.86,
   "end": 248.08,
   "text": "جذبه نباشه، اصلا آدم گامی برنمیداره در مسیر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 248.08,
   "end": 252.84,
   "text": "که این مسیر، این قلب عرض شود باطنی به--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 252.84,
   "end": 257.74,
   "text": "یعنی در حقیقت این میشه خدایا نورانی کن باطنم رو به نور",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 257.74,
   "end": 263.2,
   "text": "محبتت. یعنی غذای باطن میشه محبت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 263.2,
   "end": 266.16,
   "text": "این اشاره داره به این اولین گام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 266.16,
   "end": 271.28,
   "text": "چی؟ سیر و سلوک. که باز این نشون میده ما وجه باطن داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 271.28,
   "end": 274.76,
   "text": "خب حالا باطن رو دوباره مola باز میکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 274.76,
   "end": 280.84,
   "text": "باطن رو چگونه باز میکنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 280.84,
   "end": 285.02,
   "text": "نه اللهم نور ظاهری بطاعتك.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 285.02,
   "end": 289.66,
   "text": "طاعت الهی در حوزه اوامر و نواهی شریعت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 289.66,
   "end": 292.54,
   "text": "نورانی میکنه ظاهر انسان رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 292.54,
   "end": 294.96,
   "text": "باطن به چی نورانی میشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 294.96,
   "end": 299.46,
   "text": "و نه و دیگه نور همون اول اومده، دیگه اینجا تکرار نشد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 299.46,
   "end": 302.74,
   "text": "و باطنی به محبتک.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 302.74,
   "end": 308.42,
   "text": "خب؟ حالا باطن رو حضرت باز میکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 308.42,
   "end": 312.36,
   "text": "جان؟ به محبت. به محبتک،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 312.36,
   "end": 315.54,
   "text": "به محبتش. بعد حالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 315.54,
   "end": 319.72,
   "text": "میره وقتی باطن رو باز میکنه البته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 319.72,
   "end": 322.76,
   "text": "اگر بخوایم مola مثلا ااا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 322.76,
   "end": 327.34,
   "text": "رو در رو باشه با حکما و عرفا که دقت نظر دارن میاد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 327.34,
   "end": 332.88,
   "text": "از حس مشترک شروع میکنه به قوه خیال، وهم، عقل، قلب اینطوری میره جلو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 332.88,
   "end": 338.58,
   "text": "اما بالاخره همه رو در نظر میگیره، خسته نمیکنه جمع رو که بخواها اونطوری بگه یه دعا خیلی ت--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 338.58,
   "end": 341.74,
   "text": "مثلا طولانی میشه و همه هم ظرفیتشو ندارن و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 341.74,
   "end": 343.58,
   "text": "میزنه اولین حوزه‌شو به چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 343.58,
   "end": 350.62,
   "text": "به قلب و قلبی حالا چی تغذیه قلبه و نورانیت قلب به چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 350.62,
   "end": 353.28,
   "text": "خیلی شیرینه. و قلبی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 353.28,
   "end": 358.54,
   "text": "به معرفتك. قلبی به معرفتك.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 358.54,
   "end": 360.66,
   "text": "پس نورانیت قلب به معرفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 360.66,
   "end": 368.32,
   "text": "حالا ما وقتی که فرق بین علم و معرفت رو بفهمیم متوجه میشیم اینجا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 368.32,
   "end": 374.54,
   "text": "چه کلامی رو معجزه آسا در این دعا حضرت پیاده کرده که معرفت اونم نه علم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 374.54,
   "end": 381.28,
   "text": "حالا دعا رو تموم کنیم بعد حالا روزای بعد که ازمون نگرفتن ادامه شرحش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 381.28,
   "end": 384.78,
   "text": "پس قلبی یک رتبه از رتبه‌های باطنی ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 384.78,
   "end": 387.38,
   "text": "قلب قلبی به چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 387.38,
   "end": 389.82,
   "text": "بگید دیگه. احسنت معرفتش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 389.82,
   "end": 394.78,
   "text": "بعد میره سراغ یه رتبه باطن‌تر از قلب و روحی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 394.78,
   "end": 397.96,
   "text": "مرتبه روح باطنی تره، کلی تره به یک معنا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 397.96,
   "end": 399.5,
   "text": "به توحید نزدیک تره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 399.5,
   "end": 402.62,
   "text": "یعنی تأکدش به توحد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 402.62,
   "end": 405.72,
   "text": "شدیدتره. و روحی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 405.72,
   "end": 409.98,
   "text": "ای گفتید؟ روح با چی نورانی میشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 409.98,
   "end": 413.66,
   "text": "روح انسان به چی نورانی میشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 413.66,
   "end": 418.02,
   "text": "یعنی اخت-- نه عبادت که میشه همون اطاعت دیگه همون اولیش بود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 418.02,
   "end": 422.12,
   "text": "که نور واهری بطاعتک.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 422.12,
   "end": 425.52,
   "text": "روح، روح نه اون همون اولش بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 425.52,
   "end": 428.2,
   "text": "اینم همه اینایی که میگید ما همون اولش بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 428.2,
   "end": 430.16,
   "text": "روح مرحله شهوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 430.16,
   "end": 432.92,
   "text": "قربونتون برم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 432.92,
   "end": 436.98,
   "text": "روح مرحله شهوده. رضا حضرت عرض میکنه که خدایا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 436.98,
   "end": 439.74,
   "text": "نورانی کن روحم رو با چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 439.74,
   "end": 442.66,
   "text": "روحی بمشاهدتك.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 442.66,
   "end": 446.26,
   "text": "بمشاهدتك. یعنی تو رو به ش-- یعنی به شهود برسم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 446.26,
   "end": 448.46,
   "text": "حالا اون قلبی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 448.46,
   "end": 451.46,
   "text": "به معرفتك میشه مرحله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 451.46,
   "end": 455.48,
   "text": "علم اليقين. این روحی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 455.48,
   "end": 457.24,
   "text": "به جان؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 457.24,
   "end": 459.46,
   "text": "مشاهده به مشاهدتی میشه چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 459.46,
   "end": 463.0,
   "text": "طبق این بحث ملا محسن فیض بریم جلو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 463.0,
   "end": 465.38,
   "text": "احسنت. میشه عين اليقين.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 465.38,
   "end": 467.96,
   "text": "حالا سومیش. دیگه غوغا کرده ملا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 467.96,
   "end": 470.76,
   "text": "و سري، و سري آقا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 470.76,
   "end": 472.94,
   "text": "تازه سر و سر هم داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 472.94,
   "end": 475.0,
   "text": "مرحله خفی اخفی اینا هم داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 475.0,
   "end": 477.22,
   "text": "دیگه حضرت وسط رو بیان کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 477.22,
   "end": 480.16,
   "text": "بخواد قبل و بعدو بگه میگم در ظرف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 480.16,
   "end": 483.84,
   "text": "همه نیست. یه طوری گفته که همه بگن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 483.84,
   "end": 489.12,
   "text": "و سري حالا سر انسان، اون کانال وجودی ما که ازش بی‌خبریم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 489.12,
   "end": 492.44,
   "text": "اون با چی نورانی میشه؟ با استقلال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 492.44,
   "end": 497.08,
   "text": "اتصال البته وصل که بشه میشه باستقلال اتصال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 497.08,
   "end": 504.02,
   "text": "حضرتک. به وصل به حضرت دوست، به حضرت تو وصل به مقام اندیته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 504.02,
   "end": 508.56,
   "text": "این میشه چی؟ تو اون رتبه بندی‌ها میشه حق اليقين.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 508.56,
   "end": 512.88,
   "text": "که مرتبه فنای کلی در وجود منبسطه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 512.88,
   "end": 516.56,
   "text": "عزیزانی که تو بحث عرفانی کار می‌کنند می‌دونید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 516.56,
   "end": 520.46,
   "text": "دیگه مرتبه فناست. تازه بعد از این هم داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 520.46,
   "end": 523.56,
   "text": "فنای عرض شود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 523.56,
   "end": 527.42,
   "text": "فنای فی الله، بقای بالله، فنای بعد از بقا، قبل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 527.42,
   "end": 529.4,
   "text": "اینا همه مرتبه بعدی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 529.4,
   "end": 532.06,
   "text": "خلاصه خسته تون نکنم وقت ما گذشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 532.06,
   "end": 535.82,
   "text": "این داره اصرار می‌کنه چی رو به ما اول می‌فهمونه که ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 535.82,
   "end": 537.82,
   "text": "وجوهی داریم، مراتبی داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 537.82,
   "end": 541.52,
   "text": "هر کدوم از این‌ها به یک چیزی نورانی میشن و غذاشون مت--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 541.52,
   "end": 545.72,
   "text": "مختلفه، با هم فرق می‌کنه. اون چیزی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 545.72,
   "end": 549.64,
   "text": "ما رو به حقیقت ذهن یعنی آرامش میرسونه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 549.64,
   "end": 553.94,
   "text": "جاییه که به قلب برسه، منجّر به قلب بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 553.94,
   "end": 556.78,
   "text": "قلب از چه طریقی نورانی میشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 556.78,
   "end": 562.58,
   "text": "معرفت. حالا انشاالله فردا کار می‌کنیم رو اینکه فرق بین معرفت و علم چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 562.58,
   "end": 566.26,
   "text": "یا اطلاعات و آگاهی چیه که اون ما رو به آرامش میرسونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 566.26,
   "end": 571.18,
   "text": "امکان داره انسان فوق‌العاده اطلاعات هم داشته باشه تو حوزه فکر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 571.18,
   "end": 574.0,
   "text": "علوم فکریش غوغا کنه اما آرامش نداشته باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 574.0,
   "end": 576.86,
   "text": "علتش چیه؟ چون منجّر به معرفت نشده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 576.86,
   "end": 579.98,
   "text": "حالا فرق علم و معرفت رو انشاالله بعدا عرض می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 579.98,
   "end": 581.8,
   "text": "والحمد لله رب العالمین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 581.8,
   "end": 586.9,
   "text": "صلوات ختم کنیم. اللهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 586.9,
   "end": 587.7,
   "text": "صل علی محمد و آل محمد و عجل فرجهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}