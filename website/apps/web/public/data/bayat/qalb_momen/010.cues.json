   "title": "## ایمان فی یقین؛ از آیهٔ طور",
   "start": 1.02,
   "end": 396.64
  },
  {
   "index": 1,
   "title": "## زیارت و نماز یقینی؛ حیات و ممات اهل‌بیت یکی است",
   "start": 396.64,
   "end": 525.56
  },
  {
   "index": 2,
   "title": "## تعریف ملاصدرا از عبادت سفلی",
   "start": 525.56,
   "end": 621.66
  },
  {
   "index": 3,
   "title": "## شیر فضّه و مسجد اسد فضّه",
   "start": 621.66,
   "end": 1124.3
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 1.02,
   "end": 4.6,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 4.6,
   "end": 8.66,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 8.66,
   "end": 12.84,
   "text": "آیاته. سلام علیکم و رحمه الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 12.84,
   "end": 16.66,
   "text": "در بحث قلب مؤمن روایت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 16.66,
   "end": 22.12,
   "text": "شریفی رو داشتیم دقت می‌کردیم که جلسه پیش هم فراموشمون شد به این روایت توجه کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 22.12,
   "end": 25.24,
   "text": "وعده داده بودیم روایت رو همشو بخونیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 25.24,
   "end": 30.9,
   "text": "در تفسیر روایت اهل بیت علیهم السلام جلد پونزده صفحه دویست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 30.9,
   "end": 34.44,
   "text": "ذیل آیه بیست و دو سوره طور.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 34.44,
   "end": 38.38,
   "text": "که اون آیه چی بود؟ يتنازعون فيها كأسًا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 38.38,
   "end": 40.66,
   "text": "لَغْوٌ فيها ولا تعثیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 40.66,
   "end": 43.98,
   "text": "اینکه بر سر اون جام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 43.98,
   "end": 47.6,
   "text": "لبریز از شراب طهورای معرفت‌ست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 47.6,
   "end": 51.96,
   "text": "این‌ها نزاع می‌کنند تا اینو از هم بگیرن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 51.96,
   "end": 57.94,
   "text": "مؤمنین در بهشت. بعد امیرالمؤمنین علیه الصلاة والسلام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 57.94,
   "end": 64.0,
   "text": "در وصف ذیل این آیه، در وصف اهل ایمان چند تا سخن عالی فرمودن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 64.0,
   "end": 67.5,
   "text": "یعنی این آیه رو قرائت می‌کنند بعد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 67.5,
   "end": 74.16,
   "text": "ااا البته ش-- مشخصات در وصف مؤمنین مشخصاتشونو میگن بعد این آیه رو قرا-قرائت می‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 74.16,
   "end": 81.2,
   "text": "پیداست که ااا هرچی که مولا فرموده از درون مایه های همین آیه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 81.2,
   "end": 84.64,
   "text": "خب تا اینجاشو عرض کردیم که تازه یک،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 84.64,
   "end": 88.84,
   "text": "یه دونه و من علامات از علامتهای احدهم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 88.84,
   "end": 91.42,
   "text": "یه دونه از این مؤمنین رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 91.42,
   "end": 95.76,
   "text": "که بر سر این جام معرفت و بهشت نزاع می‌کنند رو حضرت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 95.76,
   "end": 99.14,
   "text": "بیان کردن. ای کن له حزم فی لين.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 99.14,
   "end": 102.2,
   "text": "اینو که عرض کردیم در حین،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 102.2,
   "end": 107.12,
   "text": "در عین حالی که این‌ها آینده رو نگاه می‌کنند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 107.12,
   "end": 109.6,
   "text": "اما لين",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 109.6,
   "end": 113.4,
   "text": "نرم‌اند. آینده نگر‌اند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 113.4,
   "end": 115.86,
   "text": "اما نرم‌اند اینا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 115.86,
   "end": 119.58,
   "text": "نرم خو هستند. اینو که صحبت کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 119.58,
   "end": 122.4,
   "text": "و ایمان فی یقین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 122.4,
   "end": 124.86,
   "text": "ایمانشون توی يقينه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 124.86,
   "end": 128.56,
   "text": "خیلی جالب. یعنی جنس ایمان این‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 128.56,
   "end": 133.4,
   "text": "از يقينه. یعنی اینطور نیستش که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 133.4,
   "end": 135.54,
   "text": "جان؟ اصلاً.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 135.54,
   "end": 140.36,
   "text": "یعنی ایمانو خیلی شیرین حضرت فرموده ایمان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 140.36,
   "end": 147.86,
   "text": "فی یقین. ایمانی که چون نکره هم اومده ایمانن یعنی ایمانی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 147.86,
   "end": 151.28,
   "text": "فی يقينن در يقینی‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 151.28,
   "end": 153.38,
   "text": "نکره‌ست، ناشناخته‌ست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 153.38,
   "end": 158.58,
   "text": "معرفه نیومده. چی میتونه بفهمه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 158.58,
   "end": 162.66,
   "text": "و به قدری این‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 162.66,
   "end": 166.38,
   "text": "ااا در یقین کامل به سر می برن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 166.38,
   "end": 171.46,
   "text": "که اصلاً مثل این هوا که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 171.46,
   "end": 174.36,
   "text": "از نظر من و شما پنهانه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 174.36,
   "end": 176.76,
   "text": "ما اصلاً توجهی به این هوا نداریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 176.76,
   "end": 178.92,
   "text": "چون ظاهراً نمی‌بینیمش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 178.92,
   "end": 183.92,
   "text": "اصلاً نمی‌دونیم یه هوایی داریم استنشاق می‌کنیمو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 183.92,
   "end": 188.92,
   "text": "که بعضیا استفاده از همین کرده‌ن فرمودن که حضرت حق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 188.92,
   "end": 192.24,
   "text": "به کثرت ظهور غائبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 192.24,
   "end": 195.92,
   "text": "از کثرت ظهور و حضور غائبه از نظر ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 195.92,
   "end": 198.76,
   "text": "مثل این هوا انقدر که حاضره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 198.76,
   "end": 203.28,
   "text": "انقدر که ظاهره، کثرت ظهور داره، غائبه از نظر ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 203.28,
   "end": 210.06,
   "text": "اصلاً کسی توجه بهش نمی‌کنه. اینا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 210.06,
   "end": 214.86,
   "text": "غیب براشون شهوده، شهوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 214.86,
   "end": 216.7,
   "text": "یعنی صفات خدایی پیدا می‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 216.7,
   "end": 219.28,
   "text": "درست خدا فرموده عالم الغیب والشهاده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 219.28,
   "end": 223.04,
   "text": "ولی از نظر حضرت حق که غیبی وجود نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 223.04,
   "end": 226.6,
   "text": "اون غیبی که از نظر ما غیبه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 226.6,
   "end": 233.34,
   "text": "عالم الغیبه. از نظر ما غیبه، ما از اون بی‌خبریم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 233.34,
   "end": 236.46,
   "text": "شهوده به اون نداریم. خدا به اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 236.46,
   "end": 241.1,
   "text": "عالمه. به اون که از نظر من غیبه و الا بر-- از نظر خدا که چیزی غیب نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 241.1,
   "end": 243.92,
   "text": "عالم الغیب والشهاده یعنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 243.92,
   "end": 249.56,
   "text": "به جایی می‌رسن این ایمانشون در يقينه یعنی به جایی می‌رسن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 249.56,
   "end": 251.88,
   "text": "غیب و شهود براشون یکی میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 251.88,
   "end": 255.0,
   "text": "حتی ظهور و غیبت براشون یکی میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 255.0,
   "end": 257.9,
   "text": "یه روایت داریم در خصوصیات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 257.9,
   "end": 262.58,
   "text": "اصحاب آخرالزمان امام عصر فرمودن به جایی می‌رسن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 262.58,
   "end": 268.96,
   "text": "از همه‌ی اعصار مقامشون، رتبه‌شون بالاتر میشه، به جایی می‌رسن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 268.96,
   "end": 273.48,
   "text": "غیبت حضرت براشون به منزله ظهور و حضور حضرته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 273.48,
   "end": 275.34,
   "text": "یعنی اصلاً فرقی براشون نمی‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 275.34,
   "end": 279.78,
   "text": "به همچین جایی می‌رسن. این یکی از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 279.78,
   "end": 283.86,
   "text": "مقامات اصحاب امام عصر یکی از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 283.86,
   "end": 291.52,
   "text": "لوازم چرا بعضیا میگن این آقا رو ما بسیار دیدیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 291.52,
   "end": 297.86,
   "text": "وقتی آز-- آز-- آقا تشریف میارن این روایت داریم خیلیا اظهار می‌کنن ما این آقا رو بسیار دیده بودیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 297.86,
   "end": 301.48,
   "text": "بعد اصلاً س-- السلام علیک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 301.48,
   "end": 307.62,
   "text": "حین تسلی وتغنون، حین ترکع وتسجد، حین تحمد وتستغفر،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 307.62,
   "end": 310.54,
   "text": "حین ات-- همینطوری در هر حالت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 310.54,
   "end": 313.8,
   "text": "حین تمسی به و تمسی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 313.8,
   "end": 318.24,
   "text": "شب و روز آنفآن من به شما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 318.24,
   "end": 323.62,
   "text": "سلام میدم. این یعنی چی؟ این یعنی که همیشه اصلاً همه شما در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 323.62,
   "end": 326.72,
   "text": "مرآه نظر منی. همیشه توجه به شما دارم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 326.72,
   "end": 332.44,
   "text": "یکی از معانی اون سلام‌ها فکر می‌کنم هجده سلام باشه حضرت آل یاسین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 332.44,
   "end": 337.54,
   "text": "همین باشه که انقدر شما حاضری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 337.54,
   "end": 345.54,
   "text": "و غیبت نداری برای ما که من در هر حالتی به شما سلام میدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 345.54,
   "end": 349.62,
   "text": "و این ایمانشون در یقین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 349.62,
   "end": 351.48,
   "text": "بوی حضور میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 351.48,
   "end": 355.78,
   "text": "حضور، حضور که بعد اگه کسی اینطوری شد دیگه براش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 355.78,
   "end": 357.52,
   "text": "معصیت دیگه معنا نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 357.52,
   "end": 363.06,
   "text": "اصلاً معنا نداره. در حقیقت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 363.06,
   "end": 366.48,
   "text": "از اطاعت سرپیچی کردن براش معنا نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 366.48,
   "end": 373.02,
   "text": "دائما انقیاد به حضرت حق داره، خشوع داره، خضوع داره و سر به زیره و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 373.02,
   "end": 375.78,
   "text": "عملش قول و فعل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 375.78,
   "end": 378.78,
   "text": "عملش همون قولشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 378.78,
   "end": 382.42,
   "text": "صفات خدا رو پیدا میکنه. خدا هم قول و فعل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 382.42,
   "end": 386.28,
   "text": "قول خدا فعلشه و فعلش قولشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 386.28,
   "end": 392.7,
   "text": "و که از کسی راضی باشه با فعلش نشون میده از خش-کسی هم خشمگین باشه با فعلش نشون میده حضرت حق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 392.7,
   "end": 400.1,
   "text": "اینام اینطوری میشن. که حالا به همین مناسبت داشتم اسفار رو میخوندم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 400.1,
   "end": 404.08,
   "text": "خیلی شیرین بود که این قسمتش رو در خصوص عبادت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 404.08,
   "end": 405.62,
   "text": "که بحث ما حالا خورده به عبادت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 405.62,
   "end": 408.32,
   "text": "اینا عبادتشون یقینیه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 408.32,
   "end": 414.76,
   "text": "یعنی وقتی که به عبادت می ایستن چه ذکر و ورد و اینا میگن، چه میرن به زیارت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 414.76,
   "end": 424.44,
   "text": "آل الله. که حدیث داریم کسی که در ممات ما، ما رو زیارت کنه مثل اینکه الان بریم مشهد و رضا انشاالله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 424.44,
   "end": 428.24,
   "text": "کأنّ ما رو در حیاتمون زیارت کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 428.24,
   "end": 432.7,
   "text": "این یعنی چی؟ این یعنی چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 432.7,
   "end": 436.28,
   "text": "یعنی الان بره حرم کأنّ حضرت همونجا حضور داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 436.28,
   "end": 438.76,
   "text": "اینطوریه. که ما هربار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 438.76,
   "end": 442.82,
   "text": "کاروانی میرفتیم هیئت رو می‌بردیم مشهد و رضا یا کربلا یادش بخیر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 442.82,
   "end": 446.94,
   "text": "بچه ها رو قبل از سلام اول می‌نشوندیم صحبت می‌کردیم زن و مرد و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 446.94,
   "end": 450.48,
   "text": "می‌گفتیم آقا مگر نفرمودن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 450.48,
   "end": 452.78,
   "text": "حیات و ممات ما یکیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 452.78,
   "end": 458.18,
   "text": "ما اصلا بدن عنصریمون برداشته میشه ولی ما حاضریم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 458.18,
   "end": 460.22,
   "text": "ناظریم. ما حیات داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 460.22,
   "end": 469.06,
   "text": "حیات و ممات ما یکیه. اگر الان به شما بگن که چند متر اونورتر، یک کیلومتر، دو کیلومتر اونورتر امام عصر خیمه زده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 469.06,
   "end": 472.46,
   "text": "وقت داده شما برید محضرش با چه حالی میری؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 472.46,
   "end": 475.04,
   "text": "داری میری اصلا توجه به بازارها می‌کنی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 475.04,
   "end": 478.2,
   "text": "حواس مر-حواستو مردم پرت می‌کنن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 478.2,
   "end": 481.52,
   "text": "با چه حالتی میری؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 481.52,
   "end": 485.8,
   "text": "خب چرا اون حالتو داری میری حرم نداری؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 485.8,
   "end": 489.22,
   "text": "پیداست که ضعف ایمان وجود داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 489.22,
   "end": 494.06,
   "text": "بعد خیلی بچه ها متوجه میشدن اون موقع اینطوری می‌گفتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 494.06,
   "end": 501.44,
   "text": "در هر حال اینها نمازم که می ایستن حالا زیارت که میرن حضرتشون حضوره نمازم که میس-می ایستن نمازشون به قول",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 501.44,
   "end": 505.6,
   "text": "مولا علی امروز عرض کردیم دیگه زیارت خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 505.6,
   "end": 512.78,
   "text": "میرن به زیارت خدا. مثل من نیستن که حالا زور بزنن تا یک بخشی از نماز حواسشون جمع باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 512.78,
   "end": 515.36,
   "text": "و الا از اول تا آخر نماز اینور اونورن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 515.36,
   "end": 517.46,
   "text": "مثل خود من. نه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 517.46,
   "end": 519.22,
   "text": "نه اینها عبادتشون هم یقینیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 519.22,
   "end": 522.72,
   "text": "حالا در خصوص عبادت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 522.72,
   "end": 525.56,
   "text": "خیلی شیرین ملاصدرا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 525.56,
   "end": 529.22,
   "text": "یه جمله خیلی عالی داره. اصلا عبادت رو اینطوری ترجمه کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 529.22,
   "end": 536.32,
   "text": "فرموده عبادت سفلی و پایینی ما یک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 536.32,
   "end": 541.72,
   "text": "اه از جهت موجودات علوی داریم، عالین، بالا نشینن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 541.72,
   "end": 547.12,
   "text": "موجودات سفلی داریم، پایین نشینن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 547.12,
   "end": 550.7,
   "text": "حالا از هر جهت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 550.7,
   "end": 552.9,
   "text": "، از هر حیث رتبه شون پایینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 552.9,
   "end": 557.02,
   "text": "الان مثل همین نشئه طبیعت که انزل مراتب عالم خلقت دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 557.02,
   "end": 560.74,
   "text": "پایین‌ترین، پست‌ترین مرتبه است حضرت فلسفی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 560.74,
   "end": 564.62,
   "text": "می‌فرماید که عبادت سفلی و پایینی هر یک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 564.62,
   "end": 571.76,
   "text": "از آنها را انقیاد و فرمانبرداری از عالی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 571.76,
   "end": 574.68,
   "text": "و خضوع و فروتنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 574.68,
   "end": 581.7,
   "text": "و اطاعت نسبت به آن که برتر و شریف‌تر از او و نزدیک‌تر به عالم اعلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 581.7,
   "end": 587.72,
   "text": "و بالایی‌ست و بر سافل و پایینی خیر را فرومی افشاند هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 587.72,
   "end": 590.58,
   "text": "چقدر قشنگ عبادت رو تعریف کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 590.58,
   "end": 595.06,
   "text": "میگه عبادت واقعی برای این پایینی‌ها مثل ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 595.06,
   "end": 598.3,
   "text": "میگه اینها عبادت واقعیشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 598.3,
   "end": 603.42,
   "text": "حالا بعد البته دیگه پایین‌ترینش میشه جماد دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 603.42,
   "end": 607.82,
   "text": "بعد نباته، حیوانه که الان ما یک نوع از حیوانیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 607.82,
   "end": 612.16,
   "text": "فرمود اینها عبادتشون یعنی خضوع و خشوع",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 612.16,
   "end": 615.08,
   "text": "و انقیاد نسبت به اون بالایی‌ها،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 615.08,
   "end": 618.64,
   "text": "اعلایی‌ها، بالا-- اونایی که بالا نشین هستن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 618.64,
   "end": 621.42,
   "text": "این یعنی چی؟ عبادت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 621.42,
   "end": 626.44,
   "text": "حالا شاید من ظاهراً دارم عبادت می‌کنم اما کورنش نسبت به عالم بالا ندارم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 626.44,
   "end": 628.38,
   "text": "هی انگلت هم وارد می‌کنم. چرا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 628.38,
   "end": 630.38,
   "text": "برای چی؟ من تو کفم نمیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 630.38,
   "end": 632.64,
   "text": "شما بفهمید فلسفه‌ش چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 632.64,
   "end": 635.56,
   "text": "فلسفه احکام از کجا اومده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 635.56,
   "end": 639.36,
   "text": "بعد ملاصدرا خیلی شیرین حوصله‌ش رو دارید بخونید ها؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 639.36,
   "end": 644.56,
   "text": "عبادت معدنیجات یا جمادات و نباتات و حیوانات رو میگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 644.56,
   "end": 647.1,
   "text": "خیلی عالی. خب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 647.1,
   "end": 651.3,
   "text": "می‌فرماید به عبادت جواهر معدنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 651.3,
   "end": 661.86,
   "text": "و قبول و پذیرش‌شان مر نقش و تبع را و انقیاد و فروتنی‌شان برای گداختن و چکش خوردن بنگر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 661.86,
   "end": 665.64,
   "text": "چه جالب! میگه اینا فقط عبادتشونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 665.64,
   "end": 670.16,
   "text": "جمادی‌ها، این آهن و سنگ و کلخ و اینا همین که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 670.16,
   "end": 674.8,
   "text": "دارن چکش می‌کوبن تو سرشون، هیچی نمیگن، شکل می‌گیرن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 674.8,
   "end": 677.78,
   "text": "خب؟ این عبادتشونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 677.78,
   "end": 684.54,
   "text": "چقدر قشنگ فرمود. اینها اقرار و اعتراف و خضوع و خشوع این موجودات است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 684.54,
   "end": 688.34,
   "text": "خضوع و خشوعشون، اینها خودشونو در معرض طبیعت قرار داد-دادن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 688.34,
   "end": 693.68,
   "text": "هیچی هم نمیگن. برعکس ما که چک می‌خوریم دور-- تو راه خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 693.68,
   "end": 697.88,
   "text": "آره. می‌فرماید که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 697.88,
   "end": 703.06,
   "text": "اینها اقرار و اعتراف و خضوع و خشوع این موجودات است نسبت به مبدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 703.06,
   "end": 708.58,
   "text": "پس هر موجودی که از حیث قبول و پذیرش سریع‌تر و تندتر،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 708.58,
   "end": 711.76,
   "text": "ببینید از حیث پذیرش،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 711.76,
   "end": 714.82,
   "text": "قبول و پذیرش. یعنی اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 714.82,
   "end": 718.06,
   "text": "اتفاقی داره براش رقم می‌خوره رو در عالم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 718.06,
   "end": 723.42,
   "text": "طبیعت. اینو سریع‌تر و تندتر بپذیره، قبول کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 723.42,
   "end": 729.38,
   "text": "و از جهت صورت بهتر و تابناک‌تر است، برتر است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 729.38,
   "end": 736.94,
   "text": "یعنی هرچی که زودتر این صورتو به خودش بپذیره و تابناک، تابناک‌تر مثل خورشید بدرخشه این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 736.94,
   "end": 747.5,
   "text": "برتره. و هر موجودی که از این امر در غفلت و بی‌خبری‌ست و بدان بهره‌مند نمی‌شود مانند سنگ‌های سخت و خشن در صلابت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 747.5,
   "end": 753.76,
   "text": "پست‌تر است. یعنی سنگ‌های خشن و سختی که اصلاً نمیشه دست بهشون زد و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 753.76,
   "end": 757.42,
   "text": "اینا مثل فسیل‌های تو غار و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 757.42,
   "end": 761.22,
   "text": "امثالهم. سنگ خارا و اینا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 761.22,
   "end": 769.44,
   "text": "اینا از درجه انقیاد و عبادتشون از بقیه جمادی‌ها پایین‌تره، پست‌ترن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 769.44,
   "end": 771.76,
   "text": "سپس به عبادت قوای نباتی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 771.76,
   "end": 774.54,
   "text": "حالا میره سراغ عبادت قوای نباتی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 774.54,
   "end": 776.54,
   "text": "نبات عبادتش چیه به نظر شما؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 776.54,
   "end": 779.7,
   "text": "چگونه عبادت می‌کنه؟ اونم عبادت می‌کنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 779.7,
   "end": 785.54,
   "text": "چگونه است؟ می‌فرماید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 785.54,
   "end": 795.02,
   "text": "قوای نباتی و حرکاتی که از آنها آشکار می‌شود و به سمت راست و چپ گشتنشان در هوا بنگر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 795.02,
   "end": 800.8,
   "text": "جالبه. چنانکه شاعر پارسی‌گوی گوید درخت سرو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 800.8,
   "end": 803.46,
   "text": "به باد شمال پنداری،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 803.46,
   "end": 807.74,
   "text": "همی فشاند دست و همی گذارد گام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 807.74,
   "end": 813.5,
   "text": "میگه تو فکر می‌کنی که حالا یه باد شمالی داره میاد به درخت سرو برخورد می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 813.5,
   "end": 817.62,
   "text": "تو این رو می‌بینی که حالا باد داره درختو تکون میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 817.62,
   "end": 821.08,
   "text": "اما اون میگه این دست و پا زدن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 821.08,
   "end": 823.14,
   "text": "این درخت همون عبادتشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 823.14,
   "end": 826.72,
   "text": "داره به این سمت و اون سمت حرکت می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 826.72,
   "end": 831.74,
   "text": "این رکوع و سجودشه. چقدر قشنگ.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 831.74,
   "end": 836.62,
   "text": "بعد ادامه میده. پس آن هم سجده کننده است و هم رکوع کننده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 836.62,
   "end": 839.88,
   "text": "و تسبیح گوی و تقدیس کننده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 839.88,
   "end": 842.0,
   "text": "در برخورد برگ‌هایش به هم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 842.0,
   "end": 844.78,
   "text": "چقدر باریک می‌بینه ملاصدرا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 844.78,
   "end": 847.56,
   "text": "میگه این برگاشو ببین به هم می‌خوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 847.56,
   "end": 854.88,
   "text": "در برخرد برگ‌هایش به هم و حرکات شاخه‌هایش و آشکار کردن قنچه ها و گل‌هایش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 854.88,
   "end": 857.9,
   "text": "و تسلیم نمودن میوه‌اش به حیوان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 857.9,
   "end": 860.98,
   "text": "همین که این میوشو تسلیم می‌کنه، تسلیمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 860.98,
   "end": 862.86,
   "text": "نمیگه نه نمیدم، نکن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 862.86,
   "end": 866.36,
   "text": "اینطوری نیست. و تسلیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 866.36,
   "end": 870.5,
   "text": "نمودن میوه‌اش به حیوان، حیوان طبقه بال-- برتره دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 870.5,
   "end": 872.88,
   "text": "و آن نباتی تیز،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 872.88,
   "end": 875.0,
   "text": "ستیزگر و سرکش است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 875.0,
   "end": 877.9,
   "text": "حالا این تا اینجای که تسلیم بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 877.9,
   "end": 881.72,
   "text": "داد تو نباتات. این داره عبادتشو فوق العاده انجام میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 881.72,
   "end": 887.5,
   "text": "اونکه از این پست‌تره می‌فرماید اون نباتی ستیزگر و سرکش است که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 887.5,
   "end": 891.4,
   "text": "بهره‌ای از آن حاصل نشود و جز سزاوار آتش نباشد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 891.4,
   "end": 899.96,
   "text": "اون نباتی که حاضر نیست به این شکل انقیاد کنه، عبادت کنه سزاوار آتشه، می‌سوزوننش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 899.96,
   "end": 903.32,
   "text": "بعد میره سراغ عبادت حیوان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 214,
   "start": 903.32,
   "end": 910.74,
   "text": "سپس به حیوان و خدمتش به انسان و همراهیش با او هر جا که رود بنگر که بارهای سنگین را",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 215,
   "start": 910.74,
   "end": 920.4,
   "text": "به شهر و سرمنزلی حمل می‌کند که انسان جن-- جز با سختی و جان کندن نمی‌توانست آنها را انجام دهد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 216,
   "start": 920.4,
   "end": 924.64,
   "text": "اما دسته‌ای از آنها سرکش و منحط و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 217,
   "start": 924.64,
   "end": 928.7,
   "text": "عصیانگرند و از اطاعت انسان سرکشی می‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 218,
   "start": 928.7,
   "end": 935.12,
   "text": "مانند درخت-- مانند درندگان و انواع ددان یعنی وحشی‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 219,
   "start": 935.12,
   "end": 939.02,
   "text": "چقدر قشنگ میگه شی-- اصلاً عبادت حیوانات چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 220,
   "start": 939.02,
   "end": 942.36,
   "text": "همین که رام شماست، مسخر وجود شما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 221,
   "start": 942.36,
   "end": 944.86,
   "text": "و بار شما رو می‌کشند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 222,
   "start": 944.86,
   "end": 947.94,
   "text": "تو الاغ بیچاره هرچی می‌ریزی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 223,
   "start": 947.94,
   "end": 951.66,
   "text": "آ هم نمیگه و می‌بره. شلاق می‌زنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 224,
   "start": 951.66,
   "end": 955.0,
   "text": "شتر رو میره. اسب رو لجامش رو می‌گیری حرکت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 225,
   "start": 955.0,
   "end": 960.38,
   "text": "این عبادتشونه. بعد میگه اونایی که وحشی‌ان، فراری‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 226,
   "start": 960.38,
   "end": 962.88,
   "text": "اونایی که پررو‌اند به یک معنا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 227,
   "start": 962.88,
   "end": 967.02,
   "text": "اینا سرکشی می‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 228,
   "start": 967.02,
   "end": 972.22,
   "text": "دیگه اینا از اطاعت انسان در حقیقت دارن سرکشی می‌کنند دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 229,
   "start": 972.22,
   "end": 977.1,
   "text": "این عبادت رو گفت چی؟ خضوع و خشوع و انقیاد در برابر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 230,
   "start": 977.1,
   "end": 983.44,
   "text": "بالایی‌ها. وقتی انسان بالا دست حیوانه عبادت حیوان میشه چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 231,
   "start": 983.44,
   "end": 987.8,
   "text": "مطیع بودن و رام بودن در برابر انسان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 232,
   "start": 987.8,
   "end": 990.86,
   "text": "البته شاید بحث پیش بیاد که آقا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 233,
   "start": 990.86,
   "end": 993.52,
   "text": "این یعنی این وحشی‌ها عبادت اصلاً ندارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 234,
   "start": 993.52,
   "end": 996.98,
   "text": "چرا؟ تا کی-- تا با کی طرف بشن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 235,
   "start": 996.98,
   "end": 1000.84,
   "text": "چطور به امام هادی صلوات الله علیه وقتی می‌رسن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 236,
   "start": 1000.84,
   "end": 1003.0,
   "text": "اون شیرهای درنده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 237,
   "start": 1003.0,
   "end": 1006.28,
   "text": "هم‌همه می‌کنند، رام می‌شن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 238,
   "start": 1006.28,
   "end": 1012.06,
   "text": "صورتشونو به خاک می‌مالن در برابر امام معصوم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 239,
   "start": 1012.06,
   "end": 1017.24,
   "text": "چرا اون شیر اسد فذه تو کربلا هم رفته باشید بین الحرمین نزدیک--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 240,
   "start": 1017.24,
   "end": 1019.46,
   "text": "انشالله قسمت شه به زودی بریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 241,
   "start": 1019.46,
   "end": 1025.78,
   "text": "نزدیک مزار شریف آقا ام-- ابا عبدالله العباس صلوات الله علیه میری به سمت--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 242,
   "start": 1025.78,
   "end": 1031.88,
   "text": "پس تو بین الحرمین میری به سمت حرم آقا اباالفضل دست راستت نرسیده به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 243,
   "start": 1031.88,
   "end": 1036.56,
   "text": "حرم یه کوچه است. سرش تابلو زده اسد فذه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 244,
   "start": 1036.56,
   "end": 1040.4,
   "text": "فذه یعنی طلا. کنیز حضرت صدیقه شهیده بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 245,
   "start": 1040.4,
   "end": 1045.8,
   "text": "می‌دونید دیگه حضرت فذه یا فضه خزینی معروفه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 246,
   "start": 1045.8,
   "end": 1051.44,
   "text": "توی لؤلؤء الأخبار و بحار مرحوم مجلسی و این‌ها روایات شد دیدم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 247,
   "start": 1051.44,
   "end": 1056.7,
   "text": "یه شیری داشته فذه که این شیر رو می‌بخشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 248,
   "start": 1056.7,
   "end": 1059.04,
   "text": "به حضرت و به هر حال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 249,
   "start": 1059.04,
   "end": 1065.82,
   "text": "ابا عبدالله که میاد به سمت کربلا این شیر پشت سر کاروان آقا راه می‌افته میاد تو نخلستان‌های کربلا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 250,
   "start": 1065.82,
   "end": 1069.82,
   "text": "بعد از که آقا به شهادت می‌رسه این میره اون پشت همونجایی که الان این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 251,
   "start": 1069.82,
   "end": 1075.48,
   "text": "مسجد ساختن. میره اونجا این صورتشو انقدر می‌کوبه به یه صخره‌ای تا جون میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 252,
   "start": 1075.48,
   "end": 1082.16,
   "text": "لا اله الا-- این شیر. بعد مردم میرن اونجا مسجد ساختن رو اونجایی که این شیر مثلاً دفن شده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 253,
   "start": 1082.16,
   "end": 1086.48,
   "text": "مردم میرن حوائج می‌گیرن، دعا می‌کنن، توسل می‌کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 254,
   "start": 1086.48,
   "end": 1088.7,
   "text": "خیلی یه مسجد کوچولویه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 255,
   "start": 1088.7,
   "end": 1093.0,
   "text": "ما یه سال بغلش فندق فضه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 256,
   "start": 1093.0,
   "end": 1098.14,
   "text": "هتل فضه که اونجا یه سال کاروان ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 257,
   "start": 1098.14,
   "end": 1103.96,
   "text": "مستقر بود. انقدر مردم صبح تا شب می‌اومدن، می‌رفتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 258,
   "start": 1103.96,
   "end": 1107.34,
   "text": "خب این شیر چطور از حضرت فضه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 259,
   "start": 1107.34,
   "end": 1109.94,
   "text": "انقیاد داشت؟ سرکشی نمی‌کرد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 260,
   "start": 1109.94,
   "end": 1111.72,
   "text": "از من می‌کنه. اینا هم هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 261,
   "start": 1111.72,
   "end": 1116.76,
   "text": "اینو هم توجه داشته باشید. البته انسان رو انشالله روزهای بعد عرض می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 262,
   "start": 1116.76,
   "end": 1124.3,
   "text": "روحش شاد. مثارش-- مثار علامه عسگرزاده و مثار هر کسی که مسبب هدایت ما شده صلوات بفرستید. اللهم صل علی محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}