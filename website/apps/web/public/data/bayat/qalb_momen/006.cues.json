   "start": 752.04,
   "end": 1161.92
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.64,
   "end": 4.38,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 4.38,
   "end": 8.32,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 8.32,
   "end": 15.02,
   "text": "آياته. سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 15.02,
   "end": 20.18,
   "text": "خب اواخر ماه عزیز شعبان هست و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 20.18,
   "end": 24.52,
   "text": "میریم ان شا الله به استقبال ماه مبارک رمضان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 24.52,
   "end": 28.6,
   "text": "و خیلی‌ها پرس و جو کردن مخصوصا امروز تو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 28.6,
   "end": 33.06,
   "text": "جلسه مصعب بلال که، ا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 33.06,
   "end": 35.38,
   "text": "در خواست ماه مبارک رمضان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 35.38,
   "end": 42.88,
   "text": "نکاتی رو بگید. من تبرکاً یه دو تا نکته عرض می‌کنم منتها در دل بحث اجازه بدید بگم چون مرتبط هم هست البته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 42.88,
   "end": 46.24,
   "text": "در بحث همون قلب مؤمن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 46.24,
   "end": 56.12,
   "text": "ما آیه اولئک كتب فی قلوبهم الايمان رو داشتیم صحبت می‌کردیم که عرض کردیم ایمان کتب شده در دل‌هاشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 56.12,
   "end": 59.88,
   "text": "نشانه قلب مؤمنه. ایمان کتب شده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 59.88,
   "end": 63.78,
   "text": "ایمان نوشته شده، درج شده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 63.78,
   "end": 68.7,
   "text": "جا انداخته. یعنی دیگه نمی‌تونی از اون دل خارجش کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 68.7,
   "end": 73.08,
   "text": "یه روایتی، این کتابی که الان دست منه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 73.08,
   "end": 76.3,
   "text": "که چندین بار ازش بهره گرفتیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 76.3,
   "end": 81.4,
   "text": "خیلی کتاب شیرین‌تر از عسلیه که بارها عرض کردیم بگیرید بخونید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 81.4,
   "end": 83.7,
   "text": "تأویل الآيات الظاهرة",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 83.7,
   "end": 86.92,
   "text": "فی فوائل العترة الطاهرة.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 86.92,
   "end": 95.42,
   "text": "بعضی از آیاتی رو که در فضیلت اهل بیته آورده بعد روایات رو ذیلش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 95.42,
   "end": 99.16,
   "text": "بحث کرده. خیلی جالب و شیرین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 99.16,
   "end": 104.72,
   "text": "در ذیل همین آیه چون آخر آیه می‌فرمود که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 104.72,
   "end": 113.92,
   "text": "این‌هایی که ما خصوصیت‌هاشون رو براتون شمرده‌ایم که یکیش اینه که در قلبشون ایمان کتب شده، نوشته شده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 113.92,
   "end": 118.4,
   "text": "اینا کیان؟ اولئک حزب الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 118.4,
   "end": 122.54,
   "text": "الا ان حزب الله هم المفلحون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 122.54,
   "end": 125.1,
   "text": "رستگاران عالم اینان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 125.1,
   "end": 132.08,
   "text": "حزب الله‌اند. با ادعا کردن که من حزب الله‌ایم که نمیشه، اون خصوصیت‌ها هم باید باشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 132.08,
   "end": 134.04,
   "text": "که حالا باید به مرور عرض کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 134.04,
   "end": 136.88,
   "text": "چون الان نکته دیگه‌ای رو می‌خوایم تو دل بحث بگیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 136.88,
   "end": 141.12,
   "text": "مربوط به ماه مبارک رمضان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 141.12,
   "end": 146.98,
   "text": "مخصوصا اون کتب ایمان در دل‌هاشون باید باشه تا حزب الله باشن که این‌ها مفله‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 146.98,
   "end": 151.72,
   "text": "این‌ها رستگارن. حالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 151.72,
   "end": 158.02,
   "text": "روایتی که ذیل این آیه، یکی از روایت‌هایی که تو این کتاب اومده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 158.02,
   "end": 164.42,
   "text": "تبرکاً بخونیم خیلی شیرینه که عیسی بن عبدالله بن عبیدالله بن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 164.42,
   "end": 169.28,
   "text": "عمر بن علی بن ابی طالب علیه الصلاة والسلام قال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 169.28,
   "end": 172.28,
   "text": "فرمودن که یعنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 172.28,
   "end": 175.22,
   "text": "فرمایش رو رسوندن به مولامون علی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 175.22,
   "end": 179.88,
   "text": "علیه الصلاة والسلام که مولا فرمودن حدّثنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 179.88,
   "end": 183.72,
   "text": "ابی عن جده عن علی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 183.72,
   "end": 185.9,
   "text": "علیه الصلاة والسلام. این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 185.9,
   "end": 190.62,
   "text": "فرزند حضرت می‌فرمود که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 190.62,
   "end": 193.48,
   "text": "پدرم برای من حدیث کرد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 193.48,
   "end": 196.04,
   "text": "از جدش از علی ابن ابی طالب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 196.04,
   "end": 199.62,
   "text": "یعنی نوه حضرت می‌شده در حقیقت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 199.62,
   "end": 202.66,
   "text": "که عنه قال یعنی مولا فرمودن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 202.66,
   "end": 207.7,
   "text": "فرمایش رو انتساب داد دیگه به خود مولا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 207.7,
   "end": 210.2,
   "text": "قال سلمان الفارسی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 210.2,
   "end": 213.04,
   "text": "حالا امیرالمؤمنین داره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 213.04,
   "end": 216.34,
   "text": "به نقل سلمان فارسی میگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 216.34,
   "end": 219.14,
   "text": "می‌فرمود که سلمان فارسی گفت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 219.14,
   "end": 222.8,
   "text": "یا أبا الحسن. چقدر قشنگ مولا رو صدا می‌زنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 222.8,
   "end": 224.86,
   "text": "اون موقع کنیه رو صدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 224.86,
   "end": 228.3,
   "text": "می‌زدن نشانه حرمت قائل بودن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 228.3,
   "end": 230.64,
   "text": "و شأن قائل شدن بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 230.64,
   "end": 233.26,
   "text": "اسم صدا نمی‌زدن، کنیه رو صدا می‌زدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 233.26,
   "end": 236.7,
   "text": "یا أبا الحسن. توی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 236.7,
   "end": 244.34,
   "text": "حدیث کساء هم حضرت صدیق و شهیده امیرالمؤمنین رو یا أبا الحسن خطاب می‌کنه همش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 244.34,
   "end": 249.92,
   "text": "یا أبا الحسن ما طلعت على رسول الله الا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 249.92,
   "end": 252.68,
   "text": "و ضرب بین کتی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 252.68,
   "end": 255.84,
   "text": "و قال. سلمان میگه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 255.84,
   "end": 258.5,
   "text": "به امیرالمؤمنین عرض می‌کنه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 258.5,
   "end": 262.94,
   "text": "مولا جان هیچگاه نشد که ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 262.94,
   "end": 268.98,
   "text": "در حضور رسول خدا شرفیاب بشیم مگر اینکه چه اتفاقی افتاد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 268.98,
   "end": 271.9,
   "text": "الا و ضرب بین کتی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 271.9,
   "end": 276.64,
   "text": "مگر اینکه پیغمبر زد رو کتفای من.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 276.64,
   "end": 278.66,
   "text": "یا بین کتی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 278.66,
   "end": 281.86,
   "text": "میشه گفت بین دو تا کتف این پشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 281.86,
   "end": 286.24,
   "text": "انگار که حرف مهمی رو میخواد به سلمان بزنه پیغمبر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 286.24,
   "end": 290.28,
   "text": "پیغمبر-- سلمان میگه نشد ما محضر پیغمبر بریم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 290.28,
   "end": 292.7,
   "text": "مگر اینکه این کارو با من کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 292.7,
   "end": 295.58,
   "text": "پس پیداست حرف خیلی مهمه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 295.58,
   "end": 299.68,
   "text": "آیه رو هم یادتون باشه ذیل اون آیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 299.68,
   "end": 305.1,
   "text": "و قال یعنی پیغمبر به سلمان فرمود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 305.1,
   "end": 306.94,
   "text": "بالاخره رسید به پیغمبر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 306.94,
   "end": 309.22,
   "text": "از کی اومد؟ از نوه مولا اومد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 309.22,
   "end": 313.12,
   "text": "از امیرالمؤمنین، از سلمان، حالا پیغمبر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 313.12,
   "end": 317.2,
   "text": "که قال یا سلمان هذا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 317.2,
   "end": 321.56,
   "text": "و حزبه هم المفلحون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 321.56,
   "end": 331.02,
   "text": "که سلمان میگه پیغمبر به کتف من میزد هر وقت محضرش می‌رسیدیم و اشاره به شما می‌کرد یا امیرالمؤمنین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 331.02,
   "end": 334.32,
   "text": "می‌فرمود که هذا یعنی این آقا یعنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 334.32,
   "end": 338.26,
   "text": "هذا علی و حزبه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 338.26,
   "end": 342.7,
   "text": "و حزب این آقا یعنی اون کسی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 342.7,
   "end": 346.7,
   "text": "حزب علیه. حزب الله پس میشه چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 346.7,
   "end": 350.52,
   "text": "حزب علی. حزب امیرالمؤمنین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 350.52,
   "end": 354.72,
   "text": "حضرت ابا الحسن، حضرت الوصی علیه الصلاة والسلام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 354.72,
   "end": 357.02,
   "text": "و حزبه هم المفلحون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 357.02,
   "end": 360.22,
   "text": "اینان که رستگارن. بقیه رو ول کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 360.22,
   "end": 366.96,
   "text": "چقدر شیرینه روایت چقدر مهمه که هر بار سلمان می‌رفته پیغمبر این تاکید رو می‌کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 366.96,
   "end": 370.22,
   "text": "پس پیدا شد حالا با توجه به این روایت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 370.22,
   "end": 376.36,
   "text": "چون اونجا خصوصیت‌های اهل ایمان و کسایی که ایمان تو قلبشون کتب شده رو که می‌شمره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 376.36,
   "end": 378.92,
   "text": "که بعدها انشاالله می‌خوایم بپردازیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 378.92,
   "end": 381.86,
   "text": "آخرش می‌فرماید که این‌ها مفله‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 381.86,
   "end": 386.36,
   "text": "اینا رستگارانند. ذیلش روایت میاره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 386.36,
   "end": 388.6,
   "text": "که پیغمبر فرموده که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 388.6,
   "end": 393.58,
   "text": "اون رستگارها حزب این آقان، ایشون و حزبشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 393.58,
   "end": 398.7,
   "text": "پس تمام خصوصیت‌هایی که در این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 398.7,
   "end": 405.38,
   "text": "آیه اومده مربوط است به ولایت و ولایت مدارها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 405.38,
   "end": 413.3,
   "text": "پس کسی که در مسیر ولایت اهل بیت علیهم الصلاة والسلام هست و التزام عملیه به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 413.3,
   "end": 415.78,
   "text": "فرامین اون‌ها داره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 415.78,
   "end": 419.78,
   "text": "اون‌ها هستند که ایمان در قلبشون کتب شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 419.78,
   "end": 423.9,
   "text": "به جز اونا کتب ایمان نیست، خبری نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 423.9,
   "end": 426.6,
   "text": "حالا اینو شما بری تو رسانه بگی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 426.6,
   "end": 428.9,
   "text": "اوه! چه غوغا‌ای میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 428.9,
   "end": 431.68,
   "text": "اول کسایی که پرچم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 431.68,
   "end": 434.7,
   "text": "دعا بلند می‌کنند و اینا هل أهل تسنن‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 434.7,
   "end": 437.94,
   "text": "یعنی میگن یعنی ما ایمان نداریم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 437.94,
   "end": 440.12,
   "text": "خب بر اساس این روایت ندارن دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 440.12,
   "end": 442.28,
   "text": "کتب ایمان، کتب ایمان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 442.28,
   "end": 444.1,
   "text": "میشه گفت اسلام دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 444.1,
   "end": 449.52,
   "text": "اسلام همین که گفت لا اله الا الله دیگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 449.52,
   "end": 452.96,
   "text": "جان و مال و ناموسش اینا همه در امانن و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 452.96,
   "end": 458.48,
   "text": "مسلمان شدن. اما ایمان قصه‌ش فرق می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 458.48,
   "end": 462.64,
   "text": "تازه به خود اینایی که میگن ایمان یا ایها الذین آمنوا آمنوا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 462.64,
   "end": 467.06,
   "text": "ایمان مرتبه عمیق‌تر از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 467.06,
   "end": 472.58,
   "text": "اسلامه. ت-- اصلاً اینو بدونیم مطلقاً در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 472.58,
   "end": 480.24,
   "text": "قرآن هر کجا از اهل ایمان یاد می‌کنه، از مؤمن یاد می‌کنه یعنی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 480.24,
   "end": 483.64,
   "text": "یعنی کسایی که ولایت امیرالمؤمنین رو دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 483.64,
   "end": 485.66,
   "text": "یعنی شیعیان امیرالمؤمنین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 485.66,
   "end": 491.28,
   "text": "یعنی محبین امیرالمؤمنین علیه أفضّل الصلوات المسلمین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 491.28,
   "end": 496.18,
   "text": "پس حالا ما که ماه ولایت رو که رجب بود پشت سر گذاشتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 496.18,
   "end": 501.68,
   "text": "اومدیم تو ماه شعبان که ماه پیغمبره و داریم میریم به سمت ماه خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 501.68,
   "end": 504.48,
   "text": "قطعاً خیلیا مثل من",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 504.48,
   "end": 508.74,
   "text": "فروگذار کردیم و بسیار کم گذاشتیم و بهره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 508.74,
   "end": 515.46,
   "text": "حداقلی شاید بردیم خیلیامون از این دو ماه که بخوایم آماده بشیم برای ورود به ماه خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 515.46,
   "end": 518.92,
   "text": "این دو ماه رو گذاشتن که ما آماده بشیم برای اونجا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 518.92,
   "end": 523.24,
   "text": "عرض کردیم دیگه قبلاً مسئله حرم رو زدیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 523.24,
   "end": 527.18,
   "text": "که شهری که داخلش حرمه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 527.18,
   "end": 531.36,
   "text": "ماه رجب. خود حرم و صحن‌های اطراف،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 531.36,
   "end": 535.26,
   "text": "ماه شعبانه. اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 535.26,
   "end": 539.9,
   "text": "روزه مقدسه، ماه مبارک رمضان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 539.9,
   "end": 543.0,
   "text": "تربت میشه شب قدر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 543.0,
   "end": 545.58,
   "text": "یعنی تا اونجا باید رفت، این سر رو باید رفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 545.58,
   "end": 551.84,
   "text": "حالا کسی جا مونده باید بره سراغ جبرانی‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 551.84,
   "end": 560.72,
   "text": "جبرانی‌ها اصلاً جز با ولایت اهل بیت علیهم الصلاة والسلام نمیشه هیچی رو جبران کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 560.72,
   "end": 566.4,
   "text": "در بین سوره‌ها چه surه ایه که فرمودن با دشمنان ما در خصوص ما محاجه کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 566.4,
   "end": 569.0,
   "text": "این surه کلاً مال ماست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 569.0,
   "end": 575.22,
   "text": "و اثبات بر وجود انسان کامل در هر عصریست با بدن انصاری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 575.22,
   "end": 578.94,
   "text": "surه قدر. پس با surه قدر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 578.94,
   "end": 581.16,
   "text": "که پیرامون ولایته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 581.16,
   "end": 589.6,
   "text": "میشه جبران کرد. الان متوجه میشیم چرا غروب جمعه، حالا یه بحثی داریم به خصوص جبرانی‌ها، جبرانی‌های متعدد داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 589.6,
   "end": 591.92,
   "text": "چه کنیم که ساعات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 591.92,
   "end": 594.78,
   "text": "شبانه‌روزمون رو جبران کنیم؟ چه کنیم که سا--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 594.78,
   "end": 596.58,
   "text": "روزهای هفتمون رو جبران کنیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 596.58,
   "end": 599.12,
   "text": "چه کنیم که ماه گذشته‌مون رو جبران کنیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 599.12,
   "end": 602.8,
   "text": "چه کنیم که سال گذشته‌مون رو جبران کنیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 602.8,
   "end": 608.9,
   "text": "چه کنیم که عمرمون رو، اینا همش راه اهل بیت علیهم الصلاة والسلام دادن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 608.9,
   "end": 612.76,
   "text": "الان می‌فهمیم سر اینکه چرا فرمودن غروب جمعه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 612.76,
   "end": 617.94,
   "text": "کسی عصر جمعه صد تا surه انا انزلناه بخونه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 617.94,
   "end": 621.36,
   "text": "هرچی ازش تو هفته فوت شده رو بهش میدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 621.36,
   "end": 623.64,
   "text": "از فضائل، از نور، از رحمت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 623.64,
   "end": 630.9,
   "text": "خیلی حرفه. این surه قدر انقدر ظرفیت داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 630.9,
   "end": 637.1,
   "text": "پس بریم به سمت سؤال یکی از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 637.1,
   "end": 642.24,
   "text": "عزیزانی که در کلاس هست، کلاس چهارشنبه مسجد بلال.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 642.24,
   "end": 650.62,
   "text": "دکترای عرفان دارن. خیلی برای من جالب بود که من تنبل که فوقش خودمو بکشم بعد از هر نماز صبحی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 650.62,
   "end": 652.46,
   "text": "ده تا انا انزلنا وارد شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 652.46,
   "end": 655.52,
   "text": "حضرت استاد خیلی تاکید داشتن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 655.52,
   "end": 662.82,
   "text": "اینو بخونید به فرمایش امام صادق صلوات الله عليه قدرت روزی بخشی حضرت حق رو ببینید تو اون روز.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 662.82,
   "end": 665.4,
   "text": "فوقش اون کارو. ریش اون میگفت من",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 665.4,
   "end": 668.8,
   "text": "مدت‌هاست که روزی هزار بار surه قدر می‌خونم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 668.8,
   "end": 672.16,
   "text": "و هدیه می‌کنم به حضرت زهرا و علامه حسن زاده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 672.16,
   "end": 675.32,
   "text": "حالا سر از این کلاس درآوردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 675.32,
   "end": 682.46,
   "text": "خیلی برای من شیرین بود. حالا همین روایت رو اتفاقاً در خصوص ماه مبارک رمضان هم داریم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 682.46,
   "end": 686.64,
   "text": "که اگر کسی می‌خواد کلاً از طبیعت فارغ شه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 686.64,
   "end": 690.14,
   "text": "ارتباط با ملکوت بگیره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 690.14,
   "end": 696.76,
   "text": "و ببینه اون چیزهایی که دیگران نمی‌بینن یعنی چشمش به ملکوت باز بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 696.76,
   "end": 699.96,
   "text": "که حالا بعد یه بحثی داریم که وقتی انسان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 699.96,
   "end": 704.36,
   "text": "مرتبط با ملکوت میشه اول کدوم حاسه و حواسش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 704.36,
   "end": 706.54,
   "text": "به قولی گل می‌کنه؟ کدوم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 706.54,
   "end": 714.52,
   "text": "متوجه ملکوت میشه؟ اول چشمه، اول گوشه، اول لمسه، اول شمه، اول ذوقه، کدومشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 714.52,
   "end": 718.36,
   "text": "اتفاقاً اولین ها-هو-- حسی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 718.36,
   "end": 721.14,
   "text": "ملکوت رو درک می‌کنه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 721.14,
   "end": 724.22,
   "text": "بعدها انشاالله الان وقت نیست بحث می‌کنیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 724.22,
   "end": 726.8,
   "text": "شمه، شامه انسانه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 726.8,
   "end": 731.8,
   "text": "که بعضیا یه دفعه میگن چه بو خوشی اومد، چه بو عطری اومد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 731.8,
   "end": 734.62,
   "text": "کسی عطر زده؟ میگن نه کسی عطر نزده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 734.62,
   "end": 743.82,
   "text": "حضور ملکوت رو و تردد ملکوتیان رو یا حتی انسان کامل رو با شامه شون سریع",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 743.82,
   "end": 746.38,
   "text": "می گیرن. بالاتر حالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 746.38,
   "end": 750.76,
   "text": "حواس دیگه. که معروفه به شامه یعقوبی دیگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 750.76,
   "end": 754.4,
   "text": "شامه یعقوبی باز میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 754.4,
   "end": 761.68,
   "text": "خب برای اینکه باز بشه اونجا که میگه اگر کسی هزار بار در هر روز ماه مبارک رمضان این سوره رو بخونه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 761.68,
   "end": 764.18,
   "text": "میبینه چیز--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 764.18,
   "end": 770.22,
   "text": "غیب رو میبینه، ملکوت رو میبینه، ملائکه رو میبینه، باطن عالم رو و حتی خودش رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 770.22,
   "end": 772.04,
   "text": "پیداست که شامه ش باز شده دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 772.04,
   "end": 777.08,
   "text": "چون اول شامه باز میشه بعد میره مراتب اون حواس دیگه‌ش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 777.08,
   "end": 780.14,
   "text": "توجه کردید؟ انقدر این سوره کارسازه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 780.14,
   "end": 784.6,
   "text": "اصلاً سرش هم در اینه که سوره ولایته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 784.6,
   "end": 787.6,
   "text": "پس تا می‌تونیم حالا من نمیگم هزار تا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 787.6,
   "end": 790.06,
   "text": "سخته هرکسی هم شاید توانش رو نداشته باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 790.06,
   "end": 798.14,
   "text": "خوش به حال اونایی که می‌تونن. وقتی الان داره روزی هزار تا رو میگه ماه مبارک رمضان که دیگه خیلی سهل‌تره براش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 798.14,
   "end": 800.54,
   "text": "خوشا به سعادتشون واقعاً.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 800.54,
   "end": 804.66,
   "text": "خدا توفیق بده ما هم این کارو بکنیم کل ماه مبارک رمضان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 804.66,
   "end": 810.22,
   "text": "هزار بار. البته روایت می‌فرماید هر شب هزار تا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 810.22,
   "end": 816.16,
   "text": "اما بعضی از اساتیدمون داریم که پرسیدیم گفتن که اگر نمی‌تونید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 816.16,
   "end": 819.12,
   "text": "شبانه روز ماه از صبح تا شب بگید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 819.12,
   "end": 822.56,
   "text": "تا سحر اگر نمی‌تونید هر شب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 822.56,
   "end": 827.54,
   "text": "خیلی اثر عجیبی داره. پس جبران",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 827.54,
   "end": 830.6,
   "text": "مافات ماه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 830.6,
   "end": 835.34,
   "text": "رجب و شعبان که چه عرض کنم بلکه جبران",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 835.34,
   "end": 839.74,
   "text": "خود درون مایه ماه مبارک رمضان و درک لیالی قدر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 839.74,
   "end": 841.74,
   "text": "با این سوره امکانش هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 841.74,
   "end": 844.72,
   "text": "چرا؟ چون درون مایه ولایت داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 844.72,
   "end": 850.44,
   "text": "چون تنزل الملائکه والروح فیها باذن ربهم من کل امر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 850.44,
   "end": 854.12,
   "text": "با تمام امور میان نازل میشن بر حضرت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 854.12,
   "end": 862.3,
   "text": "صاحب الامر دیگه. حتی مطلع الفجر هم که آخرش داره از علمای فرمودند این مطلع الفجر،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 862.3,
   "end": 864.86,
   "text": "فجر از انفجاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 864.86,
   "end": 868.78,
   "text": "انفجار نور، انفجار علمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 868.78,
   "end": 874.04,
   "text": "اشاره به ظهور زمان ظهور حضرت داره که حضرت تشریف بیارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 874.04,
   "end": 878.96,
   "text": "احسن تمام علوم از انفجار نور، انفجار علم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 878.96,
   "end": 883.16,
   "text": "و العلم نور یقذفه الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 883.16,
   "end": 888.2,
   "text": "فی قلب من یشاء. پس این یکی از بهترین راه هاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 888.2,
   "end": 893.86,
   "text": "حالا کسی میخواد قبل از ماه مبارک رمضان سریع جبرانی هاشو انجام بده همین جمعه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 893.86,
   "end": 899.14,
   "text": "همین جمعه فرمود عصرش صد تا انزل اینا رو بخونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 899.14,
   "end": 901.86,
   "text": "این تاثیر گذاره. فرمود این سه روز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 901.86,
   "end": 905.5,
   "text": "آخر ماه شعبان عجیبه این جبرانی ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 214,
   "start": 905.5,
   "end": 909.0,
   "text": "سه روز آخر ماه شعبان کسی روزه بگیره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 215,
   "start": 909.0,
   "end": 913.32,
   "text": "براش روزه جبران روزه دو ماه رو می‌نویسن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 216,
   "start": 913.32,
   "end": 915.3,
   "text": "خب اینا جبرانی‌ها رو آدم انجام بده دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 217,
   "start": 915.3,
   "end": 918.44,
   "text": "یه استغفاری داره. حالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 218,
   "start": 918.44,
   "end": 926.48,
   "text": "به جز این استغفار اللهم ان لم تکن غفرت لنا فيما مضى من شعبان فاغفر لنا فيما بقي منه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 219,
   "start": 926.48,
   "end": 930.38,
   "text": "به جز اینکه امام رضا صلوات الله عليه به ابا سلط عربی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 220,
   "start": 930.38,
   "end": 933.94,
   "text": "توصیه کردن که جبران اینا خودش جبرانیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 221,
   "start": 933.94,
   "end": 937.52,
   "text": "این شب‌های آخر آدم نه فقط شب‌ها،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 222,
   "start": 937.52,
   "end": 940.86,
   "text": "این ساعت و روزهای آخر این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 223,
   "start": 940.86,
   "end": 943.32,
   "text": "جمله رو هی به لسانش جاری کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 224,
   "start": 943.32,
   "end": 946.8,
   "text": "استغفار دیگه‌ای هم است توجه کنید مفاتیح هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 225,
   "start": 946.8,
   "end": 949.82,
   "text": "روزهای آخر ماه شعبان که اگر کسی بخونه کل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 226,
   "start": 949.82,
   "end": 954.4,
   "text": "گناه‌هاش محو میشه. کل گناه‌هاش محو میشه یعنی جبران میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 227,
   "start": 954.4,
   "end": 959.44,
   "text": "یعنی همه آلودی‌ها میره. این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 228,
   "start": 959.44,
   "end": 961.96,
   "text": "یکی از دستورالعمل‌های مهمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 229,
   "start": 961.96,
   "end": 965.84,
   "text": "خلاصه‌ش چیه؟ مرتبط با بحث بخوام صحبت کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 230,
   "start": 965.84,
   "end": 971.14,
   "text": "اصلاً آقا جان هیچ چیزی جبران پذیر نیست مگر با ولایت علی ابن ابی طالب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 231,
   "start": 971.14,
   "end": 974.2,
   "text": "صلوات الله عليه امیر المؤمنین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 232,
   "start": 974.2,
   "end": 979.5,
   "text": "مگر با ولایت اهل بیت عصمت و طهارت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 233,
   "start": 979.5,
   "end": 987.42,
   "text": "و تازه اگر اون فرمایش پیغمبر رو توجه کنید که فرمود يا علي افعل ما تؤمر به فاطمة",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 234,
   "start": 987.42,
   "end": 989.74,
   "text": "صلوات الله عليه. خب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 235,
   "start": 989.74,
   "end": 995.48,
   "text": "که اون عمل کن به اون چیزی که امر کرد به تو فاطمه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 236,
   "start": 995.48,
   "end": 1002.78,
   "text": "هر چیزی که فاطمه زهرا صلوات الله عليه به تو يا علي امر کرد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 237,
   "start": 1002.78,
   "end": 1008.52,
   "text": "عمل کن. بعضیا اصلاً دست رو همین روایت داشتن فرمودن که پس حضرت زهرا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 238,
   "start": 1008.52,
   "end": 1013.68,
   "text": "اصلاً مقامش بالاتره. حالا ما کاری به این نداریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 239,
   "start": 1013.68,
   "end": 1022.54,
   "text": "بحث اینجاست که میشه فهمید که هیچ چیزی جبران نمیشه مگر با صدیقه شهیده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 240,
   "start": 1022.54,
   "end": 1025.72,
   "text": "لذا ما شب‌های قدر بعضیا می--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 241,
   "start": 1025.72,
   "end": 1027.92,
   "text": "از الان می‌گفتن برای شب‌های قدر آقا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 242,
   "start": 1027.92,
   "end": 1035.08,
   "text": "یک، یکی که چه عرض کنم ما اصلاً بالاتر از توسل به حضرت صدیقه شهیده شب قدر نداریم آقا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 243,
   "start": 1035.08,
   "end": 1038.34,
   "text": "جبران همه مافات همه عمره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 244,
   "start": 1038.34,
   "end": 1040.84,
   "text": "یک عمر رو جبران می‌کنه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 245,
   "start": 1040.84,
   "end": 1045.54,
   "text": "خير من الف شهر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 246,
   "start": 1045.54,
   "end": 1048.34,
   "text": "هشتاد و چند ماه میشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 247,
   "start": 1048.34,
   "end": 1055.12,
   "text": "هشتاد و چند سال؟ هشتاد و سه سال تقریباً میشه یه عمر دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 248,
   "start": 1055.12,
   "end": 1058.74,
   "text": "درسته؟ هزار ماه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 249,
   "start": 1058.74,
   "end": 1061.24,
   "text": "هشتاد و سه سال تقریباً یک عمره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 250,
   "start": 1061.24,
   "end": 1064.94,
   "text": "همه رو جبران می‌کنه. خیر یعنی بهتر از اون یعنی جبران.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 251,
   "start": 1064.94,
   "end": 1068.52,
   "text": "خير من الف شهر یعنی جبران یک عمر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 252,
   "start": 1068.52,
   "end": 1072.72,
   "text": "با کی؟ با حقیقت لیلة القدر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 253,
   "start": 1072.72,
   "end": 1074.76,
   "text": "لیلة القدر حقیقت کی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 254,
   "start": 1074.76,
   "end": 1079.92,
   "text": "کیه؟ حضرت صدیقه شهیده است که ظرف نوریه آل الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 255,
   "start": 1079.92,
   "end": 1082.68,
   "text": "آنچه که به آل الله داده شده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 256,
   "start": 1082.68,
   "end": 1084.9,
   "text": "به این خانم به یک باره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 257,
   "start": 1084.9,
   "end": 1087.8,
   "text": "در ظرف نوریه ایشون ریخته شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 258,
   "start": 1087.8,
   "end": 1094.7,
   "text": "لذا تنزل الملائکه والروح اون روح رو امام صادق صلوات الله عليه بارها عرض کردیم اینم حرف آخرام باشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 259,
   "start": 1094.7,
   "end": 1099.04,
   "text": "در تفسیر فرات کوفی در گوشي به رفیقای خاصش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 260,
   "start": 1099.04,
   "end": 1101.96,
   "text": "مثل شما که الان این جلسه خاصه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 261,
   "start": 1101.96,
   "end": 1105.78,
   "text": "الان در ملکوت به سر می‌برید، قالب‌تون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 262,
   "start": 1105.78,
   "end": 1114.88,
   "text": "جز خواص هستید. می‌فرماید که این روح که نازل میشه بر انسان کامل مادر ما فاطمه زهراست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 263,
   "start": 1114.88,
   "end": 1117.66,
   "text": "سلام الله علیها. یعنی واسطه فیض",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 264,
   "start": 1117.66,
   "end": 1122.86,
   "text": "بین خدا و انس و امام زمان هم میشه حضرت صدیقه شهیده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 265,
   "start": 1122.86,
   "end": 1130.34,
   "text": "دیگه چی می‌خوایم من و شما؟ نماز استواسه به حضرت صدیقه شهیده شب‌های قدر غوغا می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 266,
   "start": 1130.34,
   "end": 1133.92,
   "text": "انتهای این ماه غوغا می‌کنه، جبران می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 267,
   "start": 1133.92,
   "end": 1140.6,
   "text": "اصلاً نگران نباشیم. یعنی کسی بره به سمت حضرت زهرا کاری بکنه که جگر حضرت زهرا خنک بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 268,
   "start": 1140.6,
   "end": 1144.4,
   "text": "به بچه سیدا برسه به امام عصر که آخرین یادگارشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 269,
   "start": 1144.4,
   "end": 1151.9,
   "text": "هدایایی تقدیم کنه و از این قبیل این‌ها حضرت زهرا دعاش کنه کار تمومه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 270,
   "start": 1151.9,
   "end": 1155.78,
   "text": "انشاالله خدای منان به دعای حضرت زهرا صلوات الله عليه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 271,
   "start": 1155.78,
   "end": 1161.92,
   "text": "جبران کنه برای هممون. والحمد لله رب العالمين صلوات خد کنه. اللهم صل على محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}