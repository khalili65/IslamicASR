 },
 "chapters": [
  {
   "index": 0,
   "title": "## بیست‌وپنجمین قلب؛ ایمانِ مکتوب در سینه",
   "start": 23.62,
   "end": 43.74
  },
  {
   "index": 1,
   "title": "## آنچه کنار ایمان نمی‌نشیند",
   "start": 43.74,
   "end": 504.42
  },
  {
   "index": 2,
   "title": "وعدهٔ خدا بر اهل تقوا و ایمان روشن است. خدا فرموده هر که به دین رو کند کفایتِ امورش را به دست می‌گیرد و کفیل او می‌شود:",
   "start": 504.42,
   "end": 692.06
  },
  {
   "index": 3,
   "title": "## تمثیل بهلول و میزانِ صدقِ ایمان",
   "start": 692.06,
   "end": 947.0
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.68,
   "end": 4.9,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 4.9,
   "end": 10.06,
   "text": "السلام علیک یا داعی الله و ربانی آیات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 10.06,
   "end": 15.38,
   "text": "السلام علیکم و رحمه الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 15.38,
   "end": 19.1,
   "text": "ان‌شاءالله نیت کردیم که دیگه قلب مشروب رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 19.1,
   "end": 26.38,
   "text": "رد کنیم بریم سراغ قلب جدیدی که در سیر بحث قلب در قرآن داشتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 26.38,
   "end": 30.36,
   "text": "بیست و پنجمین قلبی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 30.36,
   "end": 34.76,
   "text": "ما از قرآن استخراج کردیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 34.76,
   "end": 40.82,
   "text": "قلب مشروب بیست و چهارمین قلبی بود که سخن گفتیم در رابطه باهاش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 40.82,
   "end": 47.36,
   "text": "بیست و پنجمین قلبی که ازش حرف می‌زنیم قلب مؤمنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 47.36,
   "end": 50.76,
   "text": "البته یه آیه فقط در قرآن هست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 50.76,
   "end": 56.02,
   "text": "که اشاره مستقیم می‌کنه به قلبی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 56.02,
   "end": 60.26,
   "text": "ایمان درش نوشته شده یا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 60.26,
   "end": 63.52,
   "text": "کتب شده، محکم شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 63.52,
   "end": 68.56,
   "text": "بله در خصوص ایمان تا دلت بخواد الا ماشاالله در قرآن آیه داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 68.56,
   "end": 71.78,
   "text": "الذین آمنوا. تا دلت بخواد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 71.78,
   "end": 74.82,
   "text": "اما اینکه قلبی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 74.82,
   "end": 78.92,
   "text": "ایمان درش کتب شده باشه یه آیه ما در قرآن داریم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 78.92,
   "end": 84.64,
   "text": "که حول و حوش این آیه که خیلی هم کثیر الفروع می‌خوایم انشاالله صحبت کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 84.64,
   "end": 86.62,
   "text": "آیه بیست و دو سوره مجادله است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 86.62,
   "end": 94.48,
   "text": "خیلی آیه سفت و سخت و سرسختیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 94.48,
   "end": 99.9,
   "text": "که انّ اصلا و ابدا خدای منّان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 99.9,
   "end": 105.74,
   "text": "قبول نکرده ایمان رو کنار یه چیزی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 105.74,
   "end": 107.5,
   "text": "یا یه چیزی رو کنار ایمان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 107.5,
   "end": 111.08,
   "text": "اصلاً نپذیرفته خدا. حالا اون چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 111.08,
   "end": 116.04,
   "text": "ببینیم. ما روایاتی داریم مثلا الان به ذهنم اومد که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 116.04,
   "end": 119.34,
   "text": "خدا رحمت کنه حضرت آیت الله مرووی رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 119.34,
   "end": 122.92,
   "text": "می‌رفتیم یه روز درس اخلاق ایشون بودیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 122.92,
   "end": 127.54,
   "text": "ایشون روایتی رو نقل کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 127.54,
   "end": 131.48,
   "text": "یادم از تفسیر صافی بود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 131.48,
   "end": 134.5,
   "text": "که تفسیر روایی خیلی خوبی هست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 134.5,
   "end": 142.16,
   "text": "که مثلا شخصی به امام صادق علیه السلام عرض کرده آقا میشه شیعه شما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 142.16,
   "end": 144.68,
   "text": "بالاخره شیطان گولش بزنه و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 144.68,
   "end": 149.92,
   "text": "اغوا بشه و دست به کارهای شهوانی بزنه و فلان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 149.92,
   "end": 155.24,
   "text": "حضرت اول قبول نکرد با اصرار مردم گفته حالا احتمال داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 155.24,
   "end": 162.8,
   "text": "بعد یه چند تا گناه رو بعد وقتی رسید به دروغ و غیبت مطلقا حضرت قبول نکرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 162.8,
   "end": 167.26,
   "text": "گفت اصلاً نمیشه کسی شیعه ما باشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 167.26,
   "end": 169.58,
   "text": "و دروغ بگه. اینم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 169.58,
   "end": 173.96,
   "text": "یه چیزی رو خدا اصلاً نپذیرفته کنار ایمان بیاد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 173.96,
   "end": 175.88,
   "text": "یا ایمان کنار اون بنشینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 175.88,
   "end": 179.56,
   "text": "ببینیم چیه. اگه اینو به-- متوجه بشیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 179.56,
   "end": 183.12,
   "text": "این آیه رو، خیلی آیاتو می‌خونیم ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 183.12,
   "end": 186.4,
   "text": "ماه مبارک رمضان هم در پیشه انشاالله توفیق باشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 186.4,
   "end": 189.2,
   "text": "ببینیم زیارت کنیم ماه شریف رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 189.2,
   "end": 194.72,
   "text": "ختم قرآن هم می‌کنیم اما توجه به آیه خیلی نداریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 194.72,
   "end": 198.28,
   "text": "ما الان می‌خوایم به این آیه توجه کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 198.28,
   "end": 200.44,
   "text": "اگر خوب توجه کنیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 200.44,
   "end": 209.04,
   "text": "متوجه می‌شیم که یه پایه ایمان خیلیامون می‌لنگه بلکه بسیاری از مسئولین ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 209.04,
   "end": 211.64,
   "text": "میشه گفت بر اساس این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 211.64,
   "end": 215.32,
   "text": "آیه ایمان ندارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 215.32,
   "end": 219.56,
   "text": "اون ایمانی که کتب شده در قلبشون باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 219.56,
   "end": 222.2,
   "text": "حالا اون چیه؟ آیه رو بخونیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 222.2,
   "end": 223.76,
   "text": "آیه بیست و دو سوره مجادله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 223.76,
   "end": 228.3,
   "text": "آخرین آیه سوره است. لا تجد قوما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 228.3,
   "end": 230.2,
   "text": "يؤمنون بالله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 230.2,
   "end": 238.18,
   "text": "واليوم الاخر. تو اصلاً نمی‌بینی از قومی که این‌ها ایمان آوردن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 238.18,
   "end": 241.46,
   "text": "به خدا، به الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 241.46,
   "end": 244.18,
   "text": "و روز قیامت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 244.18,
   "end": 248.24,
   "text": "که چی؟ يوادون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 248.24,
   "end": 251.3,
   "text": "از ود میاد. ود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 251.3,
   "end": 253.02,
   "text": "اسم یکی از اسمای خدا چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 253.02,
   "end": 256.52,
   "text": "ودود. ود یعنی شدت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 256.52,
   "end": 259.94,
   "text": "محبت. خیلی شدید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 259.94,
   "end": 266.08,
   "text": "فکر می‌کنم آیه آخر سوره مریم باشه سلام الله عليها که الذین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 266.08,
   "end": 271.44,
   "text": "آمنوا وعملوا الصالحات سیجعل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 271.44,
   "end": 274.18,
   "text": "لهم الرحمن ودا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 274.18,
   "end": 277.2,
   "text": "ودا. خدا بین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 277.2,
   "end": 284.02,
   "text": "اون گروهی که دو تا خصوصیت دارند، یکی ایمان و یکی عمل صالح",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 284.02,
   "end": 290.28,
   "text": "سیجعل لهم. براشون قرار خواهد داد در آینده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 290.28,
   "end": 292.42,
   "text": "کدوم خدا؟ رحمان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 292.42,
   "end": 298.78,
   "text": "خدای رحمان که منفعت همه رو در نظر می‌گیره ودا محبت شدید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 298.78,
   "end": 304.98,
   "text": "یعنی شما ببینید بین اهل ایمان بدون اینکه هیچ قوم و خیشی با هم باشن یا رابطه مثلا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 304.98,
   "end": 307.18,
   "text": "نسبی آنچنانی داشته باشن یک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 307.18,
   "end": 309.68,
   "text": "محبت خاصی هست، یک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 309.68,
   "end": 313.34,
   "text": "گرایش و یه جذبه خاصی هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 313.34,
   "end": 316.7,
   "text": "این همش کار خداست بر اساس این آیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 316.7,
   "end": 320.68,
   "text": "یعنی وقتی ایمان اومد و عمل صالح اینچنین میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 320.68,
   "end": 323.76,
   "text": "حالا اینجا می‌فرمود که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 323.76,
   "end": 327.42,
   "text": "خدا داره تشر می‌زنه میگه حواستون باشها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 327.42,
   "end": 337.46,
   "text": "انگار خدا داره خط و خطوطشو مشخص می‌کنه میگه اصلاً نمیشه پیدا نمی‌کنی کسی رو که ایمان به الله داره و آخرت که چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 337.46,
   "end": 340.3,
   "text": "حالا در کنار این يوادون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 340.3,
   "end": 344.68,
   "text": "من حاد الله ورسوله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 344.68,
   "end": 349.66,
   "text": "که این دوست داشته باشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 349.66,
   "end": 354.64,
   "text": "محبت پیدا کرده باشه، گرایش و علقه پیدا کرده باشه به کی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 354.64,
   "end": 360.36,
   "text": "به کسی که دشمن خدا و پیغمبرشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 360.36,
   "end": 362.62,
   "text": "ولو کانوا عجیب‌ترش اینجاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 362.62,
   "end": 366.3,
   "text": "ولو کانوا آباءهم-",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 366.3,
   "end": 368.98,
   "text": "أو أبناءهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 368.98,
   "end": 373.36,
   "text": "أو إخوانهم أو عشيرتهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 373.36,
   "end": 377.56,
   "text": "ولو اگرچه اون شخصی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 377.56,
   "end": 380.62,
   "text": "دشمن خدا و پیغمبره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 380.62,
   "end": 384.48,
   "text": "پدرهاشون باشن، فرزندانشون باشن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 384.48,
   "end": 388.7,
   "text": "برادراشون باشه یا قوم و خویششون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 388.7,
   "end": 391.92,
   "text": "حتی اگه پدرش باشه، برادرش باشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 391.92,
   "end": 397.04,
   "text": "بچه‌ش باشه، قوم و خویشش باشه، همین که دشمن خدا و رسوله،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 397.04,
   "end": 400.74,
   "text": "کسی که اهل ایمانه و کسی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 400.74,
   "end": 407.82,
   "text": "واقعاً ایمان درش در قلبش نشسته، اصلاً با همچین کسایی دوستی نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 407.82,
   "end": 409.52,
   "text": "عجب! حتی پدرش؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 409.52,
   "end": 412.72,
   "text": "بله. حتی فرزندش؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 412.72,
   "end": 415.22,
   "text": "بله. حتی برادرش؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 415.22,
   "end": 417.32,
   "text": "بله. قوم و خویشش؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 417.32,
   "end": 421.98,
   "text": "بله. حالا بعد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 421.98,
   "end": 424.7,
   "text": "تصریح آیه رو ببینید. أولئك",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 424.7,
   "end": 429.52,
   "text": "خدا داره غیرت انگار نشون میده سر این اهل ایمان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 429.52,
   "end": 437.26,
   "text": "چرا؟ أولئك اینا کسایی‌ان که كتب في قلوبهم الإيمان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 437.26,
   "end": 444.08,
   "text": "کتب شده. کتب شده ما گفتیم کتاب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 444.08,
   "end": 449.72,
   "text": "کتب شده یا قرآن همین کتابیه که محکم شده، کتب شده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 449.72,
   "end": 452.88,
   "text": "کتابت یعنی دیگه موند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 452.88,
   "end": 454.6,
   "text": "همیشگی شد، ماندنی شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 454.6,
   "end": 456.8,
   "text": "کتب شده انگار که دیگه م--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 456.8,
   "end": 461.04,
   "text": "برای همیشه موند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 461.04,
   "end": 465.14,
   "text": "اینکه می‌فرماید كتب في قلوبهم الإيمان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 465.14,
   "end": 468.6,
   "text": "یعنی اینکه اصلاً انگار درد شد، نقش بست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 468.6,
   "end": 475.66,
   "text": "اصلاً في قلوبهم الإيمان اینجا ایمان و قلب، قلب دارای ایمان کنار هم اومده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 475.66,
   "end": 479.08,
   "text": "این تنها آیه‌ایه که به این شکل اومده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 479.08,
   "end": 483.68,
   "text": "كتب في قلوبهم الإيمان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 483.68,
   "end": 487.88,
   "text": "به خاطر اینکه ایمان به راستی تو قلب اینا وارد شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 487.88,
   "end": 490.1,
   "text": "اینا لقلقه زبان نیستن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 490.1,
   "end": 493.48,
   "text": "اینا به خاطر اه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 493.48,
   "end": 496.24,
   "text": "متامع دنیویشون،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 496.24,
   "end": 499.74,
   "text": "سود دنیاییشون نیومدن سمت دین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 499.74,
   "end": 504.42,
   "text": "که اگر بگیم حالا خدا که البته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 504.42,
   "end": 512.3,
   "text": "کسی که به سمت دین میاد خودش گفته من کفایت امورشو دست می‌گیرم یعنی کافی میشم براش، کفیلش میشم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 512.3,
   "end": 516.88,
   "text": "وعده خداست. وَمَن يَتَّقِ اللَّهَ يَجْعَل لَّهُ مَخْرَجًا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 516.88,
   "end": 518.7,
   "text": "خدا براش محل خروج قرار میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 518.7,
   "end": 522.9,
   "text": "اصلاً بن‌بستی نداره کسی که سمت خدا میره و سمت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 522.9,
   "end": 528.12,
   "text": "تقوا و ایمان میره. وَيَرْزُقْهُ مِنْ حَيْثُ لَا يَحْتَسِبُ از جایی که گمان نمی‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 528.12,
   "end": 530.04,
   "text": "حالا اینا لطف خداست، درست شد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 530.04,
   "end": 533.1,
   "text": "که هوای اهل ایمانو داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 533.1,
   "end": 540.72,
   "text": "الا حالا در مواردی که میخواد امتحانشون کنه یه مقدار در زیغ و گرفتاری قرارشون میده اما در غیر این صورت نه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 540.72,
   "end": 543.6,
   "text": "که یه روز آقای ق-قرائتی داد می‌زد میگفت آی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 543.6,
   "end": 548.22,
   "text": "چه خبرتونه؟ همش میگید گرفتم، مشکل دارم، فقیرم، بدبختم، بیچاره‌ام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 548.22,
   "end": 552.46,
   "text": "پس ایمانتون کجاست؟ تقواتون کجاست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 552.46,
   "end": 558.76,
   "text": "گفت تو ص-- به صریح همین آیه قرآن فرمود تو تقوا پیشه کن ببین خدا چجوری هواتو داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 558.76,
   "end": 563.62,
   "text": "چجوری از زمین و زمان برات میرسونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 563.62,
   "end": 567.54,
   "text": "و این واقعاً یک اصل قرآنیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 567.54,
   "end": 572.12,
   "text": "حالا اگر حتی بگیم این اصل رو هم برداریم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 572.12,
   "end": 575.28,
   "text": "دین رو منهای اه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 575.28,
   "end": 579.66,
   "text": "سود دنیا، منافع دنیوی کنیم بازم دست از دین برنمی‌دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 579.66,
   "end": 581.8,
   "text": "بازم دست از ایمان برنمی‌دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 581.8,
   "end": 585.72,
   "text": "چرا؟ چون كتب في قلوبهم الإيمان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 585.72,
   "end": 588.28,
   "text": "کتب شده. حالا انشاالله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 588.28,
   "end": 595.1,
   "text": "بریم جلوتر. پیرامون این کتب ایمان در قلب‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 595.1,
   "end": 598.8,
   "text": "و أَيَّدَهُم بِرُوحِ مِنْه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 598.8,
   "end": 602.52,
   "text": "اینکه اینها به روح، به روح",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 602.52,
   "end": 604.74,
   "text": "حالا این روح چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 604.74,
   "end": 610.4,
   "text": "تأیید شدن. قلب اینها به روح قدسی تأیید شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 610.4,
   "end": 613.64,
   "text": "حالا این روح چیه؟ یعنی چی تأیید شدن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 613.64,
   "end": 616.44,
   "text": "اینا خصوصیات اهل ایمانن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 616.44,
   "end": 619.36,
   "text": "که به هیچ عنوان حاضر نیستن با دشمن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 619.36,
   "end": 623.94,
   "text": "خدا و پیغمبر مذاکره کنن، حرف بزنن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 623.94,
   "end": 628.5,
   "text": "مصالحه کنن. اصلاً اونا رو دوست ندارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 628.5,
   "end": 632.76,
   "text": "مگر مصالح عموم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 632.76,
   "end": 636.38,
   "text": "مسلمین و اسلام ایجاب کنه بخوان برن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 636.38,
   "end": 640.3,
   "text": "مثل صلح امام حسن که مجبور بشن اجباره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 640.3,
   "end": 642.94,
   "text": "که اونا رو بحثی نداریم. حالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 642.94,
   "end": 645.48,
   "text": "اینج-- اینا رو باید یک یک حرف بزنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 645.48,
   "end": 649.84,
   "text": "ويدخلهم، ويدخلهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 649.84,
   "end": 653.54,
   "text": "جنات تجري من تحتها الأنهار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 653.54,
   "end": 656.28,
   "text": "اونا خ-- داخل میشن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 656.28,
   "end": 663.3,
   "text": "داخل چی؟ بهشت‌هایی که از زیر درخت‌هاش نهرها جاریست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 663.3,
   "end": 665.92,
   "text": "خب معمولاً از کنار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 665.92,
   "end": 668.94,
   "text": "درختان نهرها جاریست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 668.94,
   "end": 673.64,
   "text": "چرا من تحت؟ چرا از زیر درختان نهر جاریست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 673.64,
   "end": 676.64,
   "text": "اینا نکاتیه که دارم میگم یادتون باشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 676.64,
   "end": 678.58,
   "text": "به مرور بگیم جلسات بعد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 678.58,
   "end": 685.08,
   "text": "نکات شیرینی‌ند. یه مقدار دقت کنیم به آیات نکات خیلی شیرینی ازش استخراج میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 685.08,
   "end": 688.32,
   "text": "یا حالا ایام جشنم هست یادم افتاد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 688.32,
   "end": 691.48,
   "text": "مزاحی هم بکنیم، متایری داشته باشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 691.48,
   "end": 693.98,
   "text": "حقیقت در، در تاریخ نوشتن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 693.98,
   "end": 697.92,
   "text": "اه خدا رحمتش کنه بهلول که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 697.92,
   "end": 703.38,
   "text": "میگن بهلول دیوانه اما عاقل بود، خیلی عاقله بود، عاقل بود خیلی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 703.38,
   "end": 708.34,
   "text": "عقل زیادی هم داشت و بعضی حتی گفتن حافظ قرآن بوده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 708.34,
   "end": 715.06,
   "text": "و در زمان امام صادق سلام الله علیه زندگی می‌کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 715.06,
   "end": 718.18,
   "text": "و عمر طولانی هم کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 718.18,
   "end": 720.4,
   "text": "حالا یادم نیست تا کدوم امام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 720.4,
   "end": 723.92,
   "text": "عمرش قطع داد. مثلاً تا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 723.92,
   "end": 727.94,
   "text": "تا زمان هارون الرشید و اصلاً خود هارون الرشید علیه اللعنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 727.94,
   "end": 732.0,
   "text": "وقتی متوجه عقل و درایت و تیزهوشی و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 732.0,
   "end": 734.54,
   "text": "اِاِاِ فطانت ایشون شد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 734.54,
   "end": 737.72,
   "text": "ازش خواست که بیاد تو قاضی القضاة ما باش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 737.72,
   "end": 741.88,
   "text": "یه همچین وجاهتی داشت. بعد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 741.88,
   "end": 744.68,
   "text": "خیلی اصرار کرد. هارون تهدیدش کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 744.68,
   "end": 747.32,
   "text": "گفت اگه قبول نکنی من می‌دونم با تو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 747.32,
   "end": 751.18,
   "text": "تهدیدش کرد. و این اومد پیش امام صادق صلوات الله علیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 751.18,
   "end": 756.0,
   "text": "ببینین خصوصیت همچین آدم‌هاییه که این آیه داره میگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 756.0,
   "end": 758.82,
   "text": "خداوکیلی به ما بگن میگه حالا ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 758.82,
   "end": 761.44,
   "text": "دینمونم داریم. یعنی می‌خوایم دینمونو بفروشیم که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 761.44,
   "end": 766.1,
   "text": "ولی میریم حالا با اینام بالاخره یه پولی هم از اینا میچاپیم و.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 766.1,
   "end": 768.68,
   "text": "ها؟ خیلیامون اینطوری فکر می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 768.68,
   "end": 773.92,
   "text": "حاضریم با دشمنان دینمون هم سفره بشیم به خاطر مطامع دنیویمون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 773.92,
   "end": 776.28,
   "text": "اما حالا نمازمونم بخونیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 776.28,
   "end": 782.56,
   "text": "زمان عمر اونم بودن دیگه به علی علیه الصلاة والسلام افترا می‌کردن سر سفره معاویه می‌شستن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 782.56,
   "end": 786.48,
   "text": "می‌گفتن سفره سفره معاویه، نماز نماز علی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 786.48,
   "end": 790.46,
   "text": "این بود اصلا شعارشون بماند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 790.46,
   "end": 792.96,
   "text": "خلاصه این بهلول بعد چه کرد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 792.96,
   "end": 798.08,
   "text": "وقتی امام صادق صلوات الله علیه اجازه نداد بهش که قاضی القضاة شود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 798.08,
   "end": 802.68,
   "text": "چون می‌خواست قضاوت کنه. مسند قضاوت بنشینه مجبوره به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 802.68,
   "end": 807.46,
   "text": "رای حاکم جا-- مثلا زورگو و ظالم و ستمکار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 807.46,
   "end": 810.32,
   "text": "حکم کنه دیگه. حضرت اجازه نداد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 810.32,
   "end": 812.98,
   "text": "ایشون تنها راهی که پیدا کرد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 812.98,
   "end": 818.8,
   "text": "این بود که حالا بعضیا در تاریخ نوشتن که این هم توصیه‌ی نسخه ای بود که امام صادق براش پیچید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 818.8,
   "end": 822.62,
   "text": "یه چها-جا-- الان جاروهای قدیم بود خیلی بلند بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 822.62,
   "end": 825.7,
   "text": "الانم کارمندای شهرداری دستشون می‌گیرن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 825.7,
   "end": 829.54,
   "text": "آره اینا رو گرفت و نشست روش و تو کوچه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 829.54,
   "end": 834.58,
   "text": "با اون هیبت و اینها با اون آبرو و عزت شروع کرد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 834.58,
   "end": 841.26,
   "text": "بالا پایین پریدن. انگار این مثلا اسبشه و اینم سوارش و معلوم بود که اِ بهلول دیوانه شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 841.26,
   "end": 844.4,
   "text": "هارون می‌دونست این خودشو زده به دیوانگی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 844.4,
   "end": 846.76,
   "text": "خبر داشت، می‌دونست بالاخره می‌شناخت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 846.76,
   "end": 849.38,
   "text": "اما دیگه چه کنه؟ دیگه مجبور بود دست برداره دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 849.38,
   "end": 853.52,
   "text": "چون در انظار شناخته شد به بهلول دیوانه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 853.52,
   "end": 860.32,
   "text": "دیگه دست از جانش برداشت. حالا به هر حال ببینید چه می‌کنم حالا خداوکیلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 860.32,
   "end": 862.68,
   "text": "من خودم، خودم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 862.68,
   "end": 864.84,
   "text": "در درون خودم، خودمو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 864.84,
   "end": 868.38,
   "text": "مهک بزنم کلامو قاضی کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 214,
   "start": 868.38,
   "end": 872.56,
   "text": "اگر به من امروز امام عصر صلوات الله علیه بگه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 215,
   "start": 872.56,
   "end": 877.74,
   "text": "تو از فردا یه جارو دستت بگیر تو همین کوچه برزن و تو همین سازمانی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 216,
   "start": 877.74,
   "end": 880.66,
   "text": "همه جلو-- دولا راست میشن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 217,
   "start": 880.66,
   "end": 883.02,
   "text": "حرمت برات قائلن حاج آقا فلانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 218,
   "start": 883.02,
   "end": 887.74,
   "text": "جارو دستت بگیر و بشین روش و بپر بالا پایین و خودتو به دیوانگی بزن به این دلیل الان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 219,
   "start": 887.74,
   "end": 895.68,
   "text": "ما حاضریم؟ جارو بزنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 220,
   "start": 895.68,
   "end": 902.4,
   "text": "نه و يدخلهم جنات تجری من تحتها الانهار خالدین فيها رضي الله عنهم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 221,
   "start": 902.4,
   "end": 906.82,
   "text": "به به! ورضوا عنه. چه حرفی اینجا باید بزنیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 222,
   "start": 906.82,
   "end": 909.8,
   "text": "عشق دو طرفه، رضایت دو طرفه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 223,
   "start": 909.8,
   "end": 912.66,
   "text": "و اولئک حزب الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 224,
   "start": 912.66,
   "end": 916.24,
   "text": "حزب الله اینان. ما ادعا می‌کنیم حزب اللهی هستیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 225,
   "start": 916.24,
   "end": 919.52,
   "text": "اینا حزب الله‌اند که ما خصوصیاتش چند تاشو گفتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 226,
   "start": 919.52,
   "end": 927.62,
   "text": "و تو این آیه داره میگه. ألا دوباره تاکید می‌کنم حواست-- ألا ای اهل عالم بدانید ألا إن حزب الله هم المفلحون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 227,
   "start": 927.62,
   "end": 930.12,
   "text": "اونایی که رستگارن حزب الله‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 228,
   "start": 930.12,
   "end": 932.48,
   "text": "حزب الله این خصوصیاتشونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 229,
   "start": 932.48,
   "end": 936.84,
   "text": "که ایرا-- ایمان کثر شده در قلوبشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 230,
   "start": 936.84,
   "end": 942.9,
   "text": "فکر کنم اِاِاِ دچار تالقات روحی بشید اگر این بحثو ادامه بدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 231,
   "start": 942.9,
   "end": 947.0,
   "text": "والحمد لله رب العالمين صلوات ختم کنیم. اللهم صل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}