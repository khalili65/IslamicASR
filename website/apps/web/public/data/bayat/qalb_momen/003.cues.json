 ],
 "cues": [
  {
   "i": 0,
   "start": 0.48,
   "end": 4.42,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 4.42,
   "end": 7.48,
   "text": "السلام علیک یا داعی الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 7.48,
   "end": 10.32,
   "text": "و ربانی آیات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 10.32,
   "end": 13.08,
   "text": "السلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 13.08,
   "end": 18.96,
   "text": "در آیه بیست و دو سوره مجادله بودیم پیرامون قلب مؤمن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 18.96,
   "end": 24.02,
   "text": "و داشتیم تاکید می‌کردیم بر اساس این آیه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 24.02,
   "end": 29.72,
   "text": "خیلی اهل بیت علیهم السلام و السلام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 29.72,
   "end": 35.14,
   "text": "توقع دارند از دوستدارانشون که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 35.14,
   "end": 40.02,
   "text": "در بحث تبری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 40.02,
   "end": 42.5,
   "text": "، اون خطوط الهی رو رعایت کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 42.5,
   "end": 44.92,
   "text": "دستورات الهی رو مثل همین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 44.92,
   "end": 48.8,
   "text": "آیه‌ای که قرائت کردیم رعایت کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 48.8,
   "end": 51.52,
   "text": "مثلاً امام رئوف قربونش بریم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 51.52,
   "end": 56.62,
   "text": "در یه روایتی می‌فرماید کمال الدین،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 56.62,
   "end": 58.98,
   "text": "کمال الدین به نظر شما به چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 58.98,
   "end": 64.34,
   "text": "مثلاً اگه کسی دینش به کمال رسیده باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 64.34,
   "end": 67.14,
   "text": "فرمودن کمال الدین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 67.14,
   "end": 74.2,
   "text": "ولایت اونا. ولایت اون‌ها رو هر کسی به هر میزانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 74.2,
   "end": 78.68,
   "text": "اخذ کنه دارا باشه به همون مقدار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 78.68,
   "end": 82.78,
   "text": "دینش ک-- به کمال رسیده، تکمیل شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 82.78,
   "end": 86.44,
   "text": "این اليوم اکملت لکم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 86.44,
   "end": 89.68,
   "text": "این اکملت یعنی همون از ت-- اِ--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 89.68,
   "end": 93.5,
   "text": "اکمال میاد دیگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 93.5,
   "end": 113.5,
   "text": "دروغش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 130.8,
   "end": 150.8,
   "text": "هم دروغ-",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 231.94,
   "end": 246.04,
   "text": "دروغه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 246.04,
   "end": 248.72,
   "text": "دیگه. آره. اصلاً نمیشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 248.72,
   "end": 250.98,
   "text": "هل الدین الا الحب والبغض.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 250.98,
   "end": 256.54,
   "text": "توقع. بله دیگه این دو تا باید با هم باشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 256.54,
   "end": 261.84,
   "text": "که درستش تولی و تبریه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 261.84,
   "end": 268.56,
   "text": "بعد حضرت ادامه میدن کسی که ادعای محبت ما را دارد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 268.56,
   "end": 273.98,
   "text": "و از دشمن ما دوری نجزسته است دروغ می‌گوید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 273.98,
   "end": 279.22,
   "text": "کسی که ادعای دوستی و محبت ما را دارد اما از دشمن ما دوری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 279.22,
   "end": 282.74,
   "text": "نمی‌کند. حالا اینجا یه بحثی پیش میاد که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 282.74,
   "end": 287.66,
   "text": "، خب چطور بعضیا از مراجع مثل رهبر عزیزمون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 287.66,
   "end": 290.34,
   "text": "، اون بحث تبری رو یه مقدار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 290.34,
   "end": 294.04,
   "text": "تذکر دادن که مراقب باشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 294.04,
   "end": 297.36,
   "text": "علنی‌ش نکنید، عمومی‌ش نکنید، لعن نکنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 297.36,
   "end": 300.12,
   "text": "مثلاً لعن علنی یا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 300.12,
   "end": 302.82,
   "text": "ناصزا و اینها که کلاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 302.82,
   "end": 306.04,
   "text": "رد شده. این به جهت مصالح دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 306.04,
   "end": 307.92,
   "text": "عرض کردیم فکر می‌کنم دیروز بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 307.92,
   "end": 310.3,
   "text": "عرض کردیم که ،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 310.3,
   "end": 314.52,
   "text": "اصلاً ، مصالح",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 314.52,
   "end": 318.78,
   "text": "اسلام و مسلمین حرف اول رو می‌زنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 318.78,
   "end": 321.94,
   "text": "این مصلحت ،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 321.94,
   "end": 328.06,
   "text": "گاهی کاری می‌کنه با انسان کامل که می‌شینه تو خونه بیست و پنج ساله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 328.06,
   "end": 330.78,
   "text": "حقش نیست که بشینه ولی می‌شینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 330.78,
   "end": 333.66,
   "text": "مصلحت اسلام و مسلمین خیلی وقت--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 333.66,
   "end": 338.1,
   "text": "اصلاً یه حکیم، یه- احسنت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 338.1,
   "end": 340.48,
   "text": "فق-- اصلاً فقیه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 340.48,
   "end": 342.84,
   "text": "تفقه عمیق در دین،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 342.84,
   "end": 346.6,
   "text": "فهم عمیق در دین پیدا کرده، یکی از نشانه‌های",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 346.6,
   "end": 352.18,
   "text": "عمر فقه و تفقه در دین یک فقیه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 352.18,
   "end": 360.02,
   "text": "یک عالم دیندار و دین‌مدار همینه که بتونه به موقع و به وقتش مصلحت اسلام و مسلمین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 360.02,
   "end": 362.72,
   "text": "یا بتونه سر قصه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 362.72,
   "end": 367.76,
   "text": "حمله‌ی صدام به کویت بعد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 367.76,
   "end": 369.9,
   "text": "بیش از شصت تا کشور چقدر؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 369.9,
   "end": 372.32,
   "text": "عدد بالایی بیش از شصت تا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 372.32,
   "end": 375.54,
   "text": "ریختن سر عراق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 375.54,
   "end": 379.18,
   "text": "بعد نامه زدن کشورهای اسلامی به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 379.18,
   "end": 382.44,
   "text": "رهبر عزیزمون که چه نشسته‌ای؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 382.44,
   "end": 386.24,
   "text": "مضمون نامه این بود. آی وَ عل الإسلام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 386.24,
   "end": 390.32,
   "text": "السلام اینا ریختن سر کشور اسلامی عراق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 390.32,
   "end": 392.0,
   "text": "دارن غارت می‌کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 392.0,
   "end": 394.46,
   "text": "جنگ بین اسلام و کفر صورت گرفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 394.46,
   "end": 397.7,
   "text": "همه کفر ریختن سر اسلام و خلاصه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 397.7,
   "end": 401.66,
   "text": "به نظر شما مثلاً جبهه‌گیری آقا چی بود؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 401.66,
   "end": 404.88,
   "text": "زیرش یه کوچولو مثلا یه امضا زده بود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 404.88,
   "end": 410.26,
   "text": "نوشته بود که این جنگ اسلام و کفر نیست، جنگ نفت است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 410.26,
   "end": 416.1,
   "text": "بصیرت رو ببین. آقا فرمود دیگه بعد از اون معروف شد به جنگ نفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 416.1,
   "end": 420.78,
   "text": "خب اینو کی داره؟ این وساسه العباد باید توی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 420.78,
   "end": 424.02,
   "text": "دانشگاهی درس خونده باشه این سیاست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 424.02,
   "end": 428.26,
   "text": "اهل بیت رو بتونه اخ-- اتخاذ کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 428.26,
   "end": 432.2,
   "text": "مثلا آست-- حسن خمینی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 432.2,
   "end": 437.9,
   "text": "اخیراً یه حرفی که زدن جالب بود از قول پدرشون آست احمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 437.9,
   "end": 440.38,
   "text": "گفتن ما--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 440.38,
   "end": 446.38,
   "text": "ایشون از قول پدرشون آست احمد گفتن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 446.38,
   "end": 449.14,
   "text": "امام بارها و بارها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 449.14,
   "end": 453.7,
   "text": "فرمودن چون یه بحثی بود که مثلا شهید بهشتی یا شهید مطهری اینا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 453.7,
   "end": 457.32,
   "text": "زنده بودن، یه سری میگن اینا رهبر میشدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 457.32,
   "end": 462.2,
   "text": "خب آست احمد محکم واستاده بود که نخیر باز هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 462.2,
   "end": 464.88,
   "text": "آقای خامنه‌ای رهبر میشد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 464.88,
   "end": 470.08,
   "text": "بعد فرموده بودن که بارها ما از حضرت امام شنیدیم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 470.08,
   "end": 477.48,
   "text": "امام عصر به آقای خامنه‌ای خیلی عنایت دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 477.48,
   "end": 483.24,
   "text": "این عنایت یعنی چی؟ مثلا اینکه به من، خب به ما، به شما، به هممون عنایت داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 483.24,
   "end": 488.56,
   "text": "ولا ننسین علی الذکر. حضرت فرمود ما هیچ وقت شما رو فراموش نکردیم و نمی‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 488.56,
   "end": 493.0,
   "text": "اینکه مثلا نظر لطفی به ما دارن مثلا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 493.0,
   "end": 495.74,
   "text": "بلاها رو از ما دفع می‌کنن و نماز شب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 495.74,
   "end": 499.14,
   "text": "اجازه میدن، لطف می‌کنن، پا میشیم و برای ما استغفار می‌کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 499.14,
   "end": 504.66,
   "text": "بله اینا همه عنایت‌ه. بیومنه رو روز غلوه را دیگه همه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 504.66,
   "end": 510.32,
   "text": "همه رزق، رزق‌شون رو بیومنه وجود امام عصر می‌گیرن با همه عنایت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 510.32,
   "end": 512.6,
   "text": "عمومی. اما عنایت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 512.6,
   "end": 514.72,
   "text": "خاص و ویژه به حضرت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 514.72,
   "end": 518.48,
   "text": "آقا یه چیز دیگه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 518.48,
   "end": 523.04,
   "text": "این نشانه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 523.04,
   "end": 529.74,
   "text": "همون خلوص آدمه که حالا به وقتش باید صحبت کنیم که چی باعث می‌شه امام عصر به کسی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 529.74,
   "end": 531.68,
   "text": "توجه خاص و ویژه کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 531.68,
   "end": 533.68,
   "text": "خلوص آقا خلوص، خلوص،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 533.68,
   "end": 539.72,
   "text": "اخلاص نه ها. می‌شه کسی اخلاص داشته باشه اما خلوص نداشته باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 539.72,
   "end": 543.36,
   "text": "مگه فرق می‌کنه بین اخلاص و خلوص؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 543.36,
   "end": 551.32,
   "text": "بله فرق هست. اینا بینشون فرق هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 551.32,
   "end": 557.04,
   "text": "مثلا ملکوت، ملکوت بر وزن فعلوت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 557.04,
   "end": 561.28,
   "text": "جبروت بر وزن فعلوت اینا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 561.28,
   "end": 564.82,
   "text": "شدت جبراً،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 564.82,
   "end": 567.1,
   "text": "شدت ملکن و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 567.1,
   "end": 570.88,
   "text": "سلطنت و حکمرانی و حکم فرماییه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 570.88,
   "end": 573.18,
   "text": "به این شکل. حالا بگذریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 573.18,
   "end": 575.86,
   "text": "پس این خیلی مهمه که الان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 575.86,
   "end": 578.58,
   "text": "انسان در مواجهه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 578.58,
   "end": 582.66,
   "text": "با دشمنان اهل بیت بدونه چگونه رفتار کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 582.66,
   "end": 586.86,
   "text": "حالا اون فرمایش رهبر به جهت مصلحت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 586.86,
   "end": 593.38,
   "text": "اسلام و مسلمین و که به هر حال می‌دونید دیگه جنگ فرقه ای و جنگ قبیله‌ای و جنگ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 593.38,
   "end": 598.66,
   "text": "م-- بین مذاهب دیگه از آرزوهای دشمنان قسم خورده ما بود دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 598.66,
   "end": 600.8,
   "text": "مخصوصا شیعه و سنی رو به جان هم بندازن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 600.8,
   "end": 604.5,
   "text": "رهبر با این فرمایشش یه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 604.5,
   "end": 607.66,
   "text": "تهدید بزرگی رو خنثی کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 607.66,
   "end": 610.98,
   "text": "الان خیلی‌ها تا از شاخک‌هاشون چیز شده دارن می‌فهمن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 610.98,
   "end": 614.66,
   "text": "این از بصیرت ایشونه. حالا ما با اون کاری نداریم ولی خب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 614.66,
   "end": 617.18,
   "text": "مثلا یه روز پسر خود من پرسید بابا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 617.18,
   "end": 618.88,
   "text": "مثلا ما لعن نکنیم واقعاً؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 618.88,
   "end": 620.86,
   "text": "مثلا آقا اینطوری فرمود. چرا؟ لعن کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 620.86,
   "end": 623.2,
   "text": "گفتم چرا؟ لعن کن. ما هم می‌کنیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 623.2,
   "end": 628.98,
   "text": "اما در خفا، علنی نه. به اون شکلی که بیرون بخوای فرقی--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 628.98,
   "end": 633.46,
   "text": "خب اینم یه روایت که پس حضرت امام صادق صلوات الله علیه تشریح دارن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 633.46,
   "end": 639.56,
   "text": "دروغ می‌گوید کسی که ادعای محبت ما را دارد و از دشمنان ما دوری نجستد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 639.56,
   "end": 645.32,
   "text": "این از خصوصیت‌های آدمای مضبضبه هستن اینطوری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 645.32,
   "end": 652.3,
   "text": "داری بر جد. باز یه روایتی در وسایل، کتاب شریف وسایل شیخ حر عاملی جلد سه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 652.3,
   "end": 654.98,
   "text": "صفحه دویست و هفتاد و نه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 654.98,
   "end": 659.1,
   "text": "امام صادق صلوات الله علیه فرمود اینم گوش بدید جالبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 659.1,
   "end": 662.98,
   "text": "أو حل إلى نبي",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 662.98,
   "end": 666.72,
   "text": "من أنبيائه خدای منان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 666.72,
   "end": 670.36,
   "text": "وحی کرد به یک پیغمبری از میان انبیاش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 670.36,
   "end": 672.82,
   "text": "حالا اسم نیاورده حضرت چه پیغمبری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 672.82,
   "end": 678.0,
   "text": "امام صادق صلوات الله. قل للمؤمنین بگو به اهل ایمان،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 678.0,
   "end": 681.78,
   "text": "به این قبیله‌ای که دور و برته هم بهشون بگو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 681.78,
   "end": 685.8,
   "text": "که لا تلبسوا، لا تلبسوا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 685.8,
   "end": 687.76,
   "text": "که اینا نپوشن چی رو؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 687.76,
   "end": 689.66,
   "text": "لباس اعدائی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 689.66,
   "end": 692.14,
   "text": "لباس دشمن منو تنشون نکن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 692.14,
   "end": 695.94,
   "text": "خوش شبیه به دشمنان من نکن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 695.94,
   "end": 700.98,
   "text": "مثلا یکی وجه که توی مثلا مراجع در فقه در شرع مقدس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 700.98,
   "end": 703.98,
   "text": "میگن مثلا کراوات انداختن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 703.98,
   "end": 706.42,
   "text": "یا پوشیدن اینا مثلا حرامه، حرمت داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 706.42,
   "end": 708.78,
   "text": "همون تشبه به کفاره دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 708.78,
   "end": 712.08,
   "text": "چون لباس اوناست. جالبه که اونا خودشون میگن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 712.08,
   "end": 714.86,
   "text": "بی‌مصرف‌ترین چیزی که ما تا حالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 714.86,
   "end": 718.42,
   "text": "ما اروپایی‌ها و غربی‌ها استفاده کردیم همین کراواته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 718.42,
   "end": 720.76,
   "text": "ما نمی‌دونیم مثلا به چه درد می‌خوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 720.76,
   "end": 725.82,
   "text": "خودشون اینو میگن. بعد مسلمونای ما که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 725.82,
   "end": 729.64,
   "text": "ادعای تمدن حالا بمونه. بحثای اینطوری فعلا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 729.64,
   "end": 734.7,
   "text": "پس قل للمؤمنین لا تلبسوا لباس اعدائی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 734.7,
   "end": 737.02,
   "text": "دیگه چی؟ \"ولا تطعموا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 737.02,
   "end": 743.84,
   "text": "متاع أعداء\". قابل توجه فست‌فودخورا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 743.84,
   "end": 747.86,
   "text": "صریح نهی امام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 747.86,
   "end": 753.52,
   "text": "صادق سلام الله علیه. فرمایش ایشون با فرمایش امام زمان ما یکیه فرق نمی‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 753.52,
   "end": 756.2,
   "text": "فرمودن نخورید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 756.2,
   "end": 758.16,
   "text": "غذایی که دشمنان ما می‌خورن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 758.16,
   "end": 760.6,
   "text": "غذای دشمنان ما رو نخورید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 760.6,
   "end": 764.74,
   "text": "بسیاری از غذاهایی که الان تو ایران مد شده اینا مال اوناست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 764.74,
   "end": 768.34,
   "text": "مال کشورا. بعدم با",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 768.34,
   "end": 770.66,
   "text": "افتخار می‌نویسه مثلا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 770.66,
   "end": 773.7,
   "text": "چی چیا ایتالیایی، چی چیا من...",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 773.7,
   "end": 777.5,
   "text": "ها؟ ارمنستان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 777.5,
   "end": 785.02,
   "text": "حالا \"ولا تسلكوا\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 785.02,
   "end": 789.98,
   "text": "عجب! خیلی جالبه. \"ولا تسلكوا مسالك أعداء\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 789.98,
   "end": 794.6,
   "text": "راهی که دشمنان ما میرن شما نرید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 794.6,
   "end": 797.54,
   "text": "خیلی جالبه‌ها. مثلا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 797.54,
   "end": 802.46,
   "text": "با فرم، با این فرمایش امام صادق علیه السلام شما داری توی کوچه‌ای میری، تو خیابونی میری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 802.46,
   "end": 806.1,
   "text": "مثلا می‌بینی یکی از دشمنان قسم خورده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 806.1,
   "end": 810.24,
   "text": "امیرالمؤمنین داره میره. نباید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 810.24,
   "end": 815.6,
   "text": "پشت سرش راه بری. نباید پشت سرش راه بیوفتی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 815.6,
   "end": 817.56,
   "text": "یه تأمل کن. جان؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 817.56,
   "end": 821.16,
   "text": "تجارت کردن باهاش. تجارت رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 821.16,
   "end": 829.5,
   "text": "در صورتی که مراجع هم مثلا خود حضرت آقا فرمودن اگر به اقتصاد اون‌ها کمک بشه جایز نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 829.5,
   "end": 832.64,
   "text": "به اقتصاد کفر و شرک کمک بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 832.64,
   "end": 834.54,
   "text": "همون از شخصیه، اونم شخصیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 834.54,
   "end": 838.3,
   "text": "خیلی به اقتصاد جهان کفر کمک نمیشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 838.3,
   "end": 841.58,
   "text": "ولی اونم مذمومه یعنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 841.58,
   "end": 847.92,
   "text": "ممدوح نیست اینکه شما بری-- خب این همه مسلمون چرا بری به کفار؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 847.92,
   "end": 852.44,
   "text": "خب اینم از این \"فتكونوا أعداء",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 852.44,
   "end": 858.58,
   "text": "كما هم أعداء\". این انتهاش تذکرش خیلی عجیبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 858.58,
   "end": 862.16,
   "text": "می‌فرماید که حالا این تذکراتی که ما به شما دادیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 862.16,
   "end": 864.48,
   "text": "اگر اینطوری شدی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 864.48,
   "end": 867.58,
   "text": "یعنی چی؟ یعنی اینکه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 867.58,
   "end": 870.16,
   "text": "لباس دشمنان ما رو به تن کردی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 870.16,
   "end": 874.14,
   "text": "غذای اونا رو خوردی، راه اونا رو رفتی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 874.14,
   "end": 879.04,
   "text": "\"فتكونوا أعداء",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 879.04,
   "end": 886.84,
   "text": "كما هم أعداء\". همونطور که اونا اعدای ما هستن، دشمنان ما هستن، شما هم دشمنان ما هستین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 886.84,
   "end": 890.46,
   "text": "انقدر مهمه بحث تشبه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 890.46,
   "end": 894.98,
   "text": "که ما دو سه روز پیش با حاج حسین آقا بحث ولایت رو باز کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 894.98,
   "end": 897.0,
   "text": "خیلی برای ایشون شیرین بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 897.0,
   "end": 902.26,
   "text": "گفتیم اصلا همه قرب، قربتا الی الله یعنی تشبه به الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 902.26,
   "end": 908.12,
   "text": "تلبس به اسماء الله و معنای ولایت توش خوابیده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 908.12,
   "end": 911.02,
   "text": "خلیفه باید به صفات مستخلف عنه باشه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 911.02,
   "end": 916.66,
   "text": "اون کسی که جانشین خداست باید شبیه‌ترین فرد به او باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 916.66,
   "end": 919.38,
   "text": "اون کسی هم که میگه شیعه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 919.38,
   "end": 924.24,
   "text": "مشایعت می‌کنه امامش رو دنبال سرش راه میفته،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 924.24,
   "end": 928.24,
   "text": "خب اون باید شبیه‌ترین آدما به امامش باشه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 928.24,
   "end": 932.78,
   "text": "به چه شباهتی با امامت بردی که نه غذات شبیه اونه، نه ق--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 932.78,
   "end": 937.08,
   "text": "نه لباس و پوشاکت، سبک زندگیت، معماریت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 937.08,
   "end": 940.26,
   "text": "راهت، مسلکت، هیچی که بچه...",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 940.26,
   "end": 942.66,
   "text": "این بلایی که متاسفانه سر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 942.66,
   "end": 947.44,
   "text": "کشورهای اسلامی به جمله ایران آوردن به اسم تمدن غرب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 947.44,
   "end": 954.66,
   "text": "اونا می‌خواستن تمدن‌سازی کنن در حالی که تمدن ما چندین هزار ساله بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 954.66,
   "end": 957.36,
   "text": "خب این همه تا-- جان؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 957.36,
   "end": 961.04,
   "text": "وقت تموم شد؟ خب وقت گذشته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 961.04,
   "end": 964.3,
   "text": "پس این رو حالا من هی دارم تاکید می‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 964.3,
   "end": 966.86,
   "text": "همه این خودش جای شرح و تعدیل و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 966.86,
   "end": 969.12,
   "text": "بحث و بسط داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 969.12,
   "end": 974.84,
   "text": "دیگه با خودتون. که ازش می‌گذریم که بریم سراغ نکات دیگه آیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 974.84,
   "end": 977.06,
   "text": "که حالا این خصوصیت کیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 977.06,
   "end": 982.64,
   "text": "کسی که به شدت مراقب این چیزاست که عجب ش-- غذاش،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 982.64,
   "end": 986.54,
   "text": "لباسش، مسلک و راهش شبیه دشمنان نباشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 214,
   "start": 986.54,
   "end": 989.92,
   "text": "مال کیاس که این رو رعایت می‌کنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 215,
   "start": 989.92,
   "end": 992.02,
   "text": "دروغ نمیگه دوست‌دار اهل بیته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 216,
   "start": 992.02,
   "end": 998.14,
   "text": "دروغ نمیگه اهل ایمانه. لازم نیست قرآن بهش تشرح بزنه که \"يا أيها الذين آمنوا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 217,
   "start": 998.14,
   "end": 1000.34,
   "text": "آمنوا\". ای کسی که،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 218,
   "start": 1000.34,
   "end": 1003.68,
   "text": "به کسایی که مدعی هستید ایمان آوردید، ایمان بیارید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 219,
   "start": 1003.68,
   "end": 1007.86,
   "text": "این تشرح لازم نیست. ای کسی که ادعا می‌کنی محب امیرالمؤمنین،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 220,
   "start": 1007.86,
   "end": 1010.94,
   "text": "محب باش. با این تشرح نیاز بهش نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 221,
   "start": 1010.94,
   "end": 1014.0,
   "text": "کیان؟ اینا کسایین که همه حرف اینجاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 222,
   "start": 1014.0,
   "end": 1017.34,
   "text": "\"كتب في قلوبهم الإيمان\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 223,
   "start": 1017.34,
   "end": 1019.74,
   "text": "ایمان نوشته شده تو قلب ایناها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 224,
   "start": 1019.74,
   "end": 1022.08,
   "text": "یعنی نمی‌تونی ایمان رو از این‌ها بگیری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 225,
   "start": 1022.08,
   "end": 1024.76,
   "text": "باور یقین مثل اون شهیدی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 226,
   "start": 1024.76,
   "end": 1032.32,
   "text": "الله اکبر الآن تو زندگی بعضی از شهدا می‌خونا واقعا می‌مونه که اینا کی بودن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 227,
   "start": 1032.32,
   "end": 1035.5,
   "text": "می‌گفت من ااا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 228,
   "start": 1035.5,
   "end": 1040.8,
   "text": "این عقده یه آه کشیدنو به دل دشمن می‌گذارم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 229,
   "start": 1040.8,
   "end": 1043.76,
   "text": "حالا اسمش از خاطرم رفته که از شهدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 230,
   "start": 1043.76,
   "end": 1046.98,
   "text": "که بعد وقتی به اسیر گرفتنش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 231,
   "start": 1046.98,
   "end": 1051.02,
   "text": "زنده زنده این شهید معلّطی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 232,
   "start": 1051.02,
   "end": 1057.64,
   "text": "آره. حالا زنده زنده بعید می‌دونم این که من دارم میگم الان اسمش شهید معلّطی باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 233,
   "start": 1057.64,
   "end": 1059.92,
   "text": "زنده بود. از شدت--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 234,
   "start": 1059.92,
   "end": 1062.64,
   "text": "سرش رو این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 235,
   "start": 1062.64,
   "end": 1066.26,
   "text": "پوست سرش رو با چاقو زنده زنده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 236,
   "start": 1066.26,
   "end": 1071.54,
   "text": "بریدن و کاسه سرش رو زنده زنده جدا کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 237,
   "start": 1071.54,
   "end": 1075.14,
   "text": "خیلی عجیب که-- ولی یه آه نکشیده این بچه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 238,
   "start": 1075.14,
   "end": 1081.02,
   "text": "این شیرمرد. هرچی کردن که یه آه بکشه، یه دادی بزنه، یه فریادی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 239,
   "start": 1081.02,
   "end": 1084.0,
   "text": "هیچی. خیلی آدم تعج-- یه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 240,
   "start": 1084.0,
   "end": 1086.98,
   "text": "سوزن بره تو تن آدم فریاد آدم بلند بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 241,
   "start": 1086.98,
   "end": 1093.48,
   "text": "این جز این همین آیه است، حقیقت این آیه است که \"كتب في قلوبهم الإيمان\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 242,
   "start": 1093.48,
   "end": 1098.86,
   "text": "که ایمان تو بند بند وجودش رسوخ کرده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 243,
   "start": 1098.86,
   "end": 1101.0,
   "text": "و مثل حجر بن عدی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 244,
   "start": 1101.0,
   "end": 1103.44,
   "text": "عُدی میگن ولی درستش عدیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 245,
   "start": 1103.44,
   "end": 1107.78,
   "text": "با پسرش و اینا داشتن می‌رفتن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 246,
   "start": 1107.78,
   "end": 1111.32,
   "text": "که گرفتنش ایشونو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 247,
   "start": 1111.32,
   "end": 1114.88,
   "text": "با پسرشو ظاهراً با سیزده تا از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 248,
   "start": 1114.88,
   "end": 1118.5,
   "text": "یاران امیرالمؤمنین که حالا اعوان و انصار ایشون بودن تو راه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 249,
   "start": 1118.5,
   "end": 1121.52,
   "text": "اینم بگم و دیگه بسه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 250,
   "start": 1121.52,
   "end": 1124.06,
   "text": "امروز. بعد گرفتن و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 251,
   "start": 1124.06,
   "end": 1126.44,
   "text": "می‌خواستن بهش گفتن شما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 252,
   "start": 1126.44,
   "end": 1129.38,
   "text": "ااا اعلام برائت کن از علی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 253,
   "start": 1129.38,
   "end": 1131.9,
   "text": "علیه الصلاة والسلام العزو بالله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 254,
   "start": 1131.9,
   "end": 1135.5,
   "text": "ما در امانی. شروع کرد مدح امیرالمؤمنین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 255,
   "start": 1135.5,
   "end": 1140.32,
   "text": "گفتن شمشیر بالا سرش، خودش، پسرش، اعوان و انصارش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 256,
   "start": 1140.32,
   "end": 1144.74,
   "text": "گفتن خب کسی که از علی دم می‌زنه صداش مرگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 257,
   "start": 1144.74,
   "end": 1147.22,
   "text": "بفرمایین ما حرفی نداریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 258,
   "start": 1147.22,
   "end": 1149.48,
   "text": "گفتن اول خودتو بکشیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 259,
   "start": 1149.48,
   "end": 1153.52,
   "text": "یا پسرتو؟ خیلی جالبه‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 260,
   "start": 1153.52,
   "end": 1157.06,
   "text": "این اصلاً تصورشو از اینجا تا خونه بکنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 261,
   "start": 1157.06,
   "end": 1161.54,
   "text": "دارید از سر کار میرید. گفتش که نه اول پسرم رو جلوی چشم خودم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 262,
   "start": 1161.54,
   "end": 1167.46,
   "text": "گفتن ای قسی القلب تو چه پدری هستی که حاضری پسرتو جلوی خودت سر ببرن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 263,
   "start": 1167.46,
   "end": 1171.44,
   "text": "گفت می‌خوام مطمئن بشم، ببینم با چشم خودم ببینم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 264,
   "start": 1171.44,
   "end": 1178.5,
   "text": "مطمئن بشم که در ولایت امیرالمؤمنین جون داد که بعد از من یه وقت ضعف نفس نگیردش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 265,
   "start": 1178.5,
   "end": 1181.52,
   "text": "پدرشو بکشید بعد دست از علی برداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 266,
   "start": 1181.52,
   "end": 1187.28,
   "text": "الان که می‌دونم سا-- دارای ولایت امیرالمؤمنینه جلوی چشم من با علی از دنیا بره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 267,
   "start": 1187.28,
   "end": 1191.2,
   "text": "ببینید پدر رو. بعد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 268,
   "start": 1191.2,
   "end": 1193.74,
   "text": "جلوی پ-پدر سر از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 269,
   "start": 1193.74,
   "end": 1196.44,
   "text": "بدن جدا کردن از پسر،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 270,
   "start": 1196.44,
   "end": 1199.42,
   "text": "بعدم پدر رو، بعدم اون سیزده نفرن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 271,
   "start": 1199.42,
   "end": 1203.56,
   "text": "این آخه این‌ها حکایت‌های",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 272,
   "start": 1203.56,
   "end": 1205.56,
   "text": "داستان و قصه نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 273,
   "start": 1205.56,
   "end": 1208.88,
   "text": "چیزهاییه که باید مثل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 274,
   "start": 1208.88,
   "end": 1211.0,
   "text": "آینه همیشه جلوی روی ما باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 275,
   "start": 1211.0,
   "end": 1215.34,
   "text": "پس كتب فی قلوبهم الايمان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 276,
   "start": 1215.34,
   "end": 1217.4,
   "text": "والحمد لله رب العالمين.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 277,
   "start": 1217.4,
   "end": 1220.22,
   "text": "صلوات ختم کنیم. اللهم صل على",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}