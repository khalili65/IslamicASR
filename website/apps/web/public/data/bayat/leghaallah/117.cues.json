   "end": 964.86
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.12,
   "end": 6.96,
   "text": "یا رب اعوذبک من همزات الشیاطین و من شر نفسي و من شر خلقک.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 6.96,
   "end": 8.72,
   "text": "بسم الله الرحمن الرحیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 8.72,
   "end": 13.22,
   "text": "لا حول و لا قوة الا بالله العلی العظیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 13.22,
   "end": 18.52,
   "text": "اللهم ایاک نعبد وایاک نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 18.52,
   "end": 22.9,
   "text": "الحمد لله على کل نعمہ و اسال الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 22.9,
   "end": 27.7,
   "text": "من فضله. السلام علیک یا داعی الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 27.7,
   "end": 30.32,
   "text": "و ربانیة آیاته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 30.32,
   "end": 33.64,
   "text": "سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 33.64,
   "end": 38.76,
   "text": "لطف کنید با حضور قلب با توجه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 38.76,
   "end": 45.86,
   "text": "ثواب اونهایی که از جمع ما رفتند و اسیر خاکند بد وارث و بی وارث از محبین امیرالمؤمنین،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 45.86,
   "end": 51.98,
   "text": "مادر و برادر من حقیر، حسین عاطفه عزیزم، شهید شهدای هیئتمون،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 51.98,
   "end": 57.02,
   "text": "آخرین کسی که از جمع ما به رحمت حق رفت حاج آقا پاکزادیان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 57.02,
   "end": 59.69,
   "text": "ثواب همشون یک صلوات هدیه کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 59.69,
   "end": 64.93,
   "text": "اللهم صل على محمد و آل محمد کما صليت على إبراهيم و آل إبراهيم في العالمین إنک حمید مجید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 64.93,
   "end": 67.88,
   "text": "ما در بحث لقاء الله رسیدیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 67.88,
   "end": 75.06,
   "text": "به موضوع ارادت. یه پرانتزی البته در بین بحث و ابتغوا الیه الوسيلة که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 75.06,
   "end": 77.52,
   "text": "فقر بود بین موضوع فقر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 77.52,
   "end": 79.96,
   "text": "ما موضوع فقر رو تمومش نکردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 79.96,
   "end": 85.72,
   "text": "تازه رسیدیم به سر فصلش و ان شا الله از همین کتاب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 85.72,
   "end": 88.32,
   "text": "صد منزل دلی که دست منه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 88.32,
   "end": 91.0,
   "text": "موضوع فقر رو بررسی خواهیم کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 91.0,
   "end": 93.5,
   "text": "اما یه پرانتزی باز کردیم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 93.5,
   "end": 101.32,
   "text": "بگیم. فکر می‌کنم شب آخر فاطمیه بود که عرض کردیم ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 101.32,
   "end": 106.66,
   "text": "برای اینکه به لقاء الله برسیم و حجاب نورانی رو بندازیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 106.66,
   "end": 109.24,
   "text": "نیازمند اراد هستیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 109.24,
   "end": 112.26,
   "text": "ارادت ابتدای محبته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 112.26,
   "end": 115.42,
   "text": "ارادت به قول خواجه عبدالله سه مرحله داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 115.42,
   "end": 119.6,
   "text": "یه مرحله‌ش فعلی بود، یه مرحله‌ش حالی بود،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 119.6,
   "end": 122.36,
   "text": "انقطاع حالی بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 122.36,
   "end": 124.84,
   "text": "مرحله سومش حالت ذهول بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 124.84,
   "end": 127.84,
   "text": "اگه یادتون باشه یعنی سرمستی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 127.84,
   "end": 129.94,
   "text": "یعنی شدت محبت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 129.94,
   "end": 135.28,
   "text": "این حالتی که در جلسات و هیئت‌ها بعضا ایجاد میشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 135.28,
   "end": 141.04,
   "text": "از خود بیخود میشی نسبت به حضرت زهرا، به امیرالمؤمنین، به امام حسین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 141.04,
   "end": 143.74,
   "text": "معلومه که از بیرون یه چیزی تزریق شد به تو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 143.74,
   "end": 147.24,
   "text": "تو اونی نیستی که اومدی تو هیئت نشستی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 147.24,
   "end": 151.22,
   "text": "این ارادت به تو تزریق شد و شدت گرفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 151.22,
   "end": 156.32,
   "text": "وقتی این خیلی زیاد شد بهش میگن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 156.32,
   "end": 160.5,
   "text": "این حالتی که ذهول ازش به ذهول یاد شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 160.5,
   "end": 163.54,
   "text": "حالا ذهول رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 163.54,
   "end": 170.22,
   "text": "دو تا راهکار داره برای اینکه ما این حالت رو در خودمون تقویت کنیم و نگه داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 170.22,
   "end": 174.62,
   "text": "اینجا وایسادیم که خواجه عبدالله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 174.62,
   "end": 180.82,
   "text": "می‌فرمود اولیش اینه \"مع صحت الاستقامة\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 180.82,
   "end": 189.3,
   "text": "که سالک باید توی این منزل که قرار می‌گیره به شدت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 189.3,
   "end": 192.16,
   "text": "اهل استقامت باشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 192.16,
   "end": 195.42,
   "text": "و آنی غافل نشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 195.42,
   "end": 198.26,
   "text": "یعنی عقب گرد مطلقا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 198.26,
   "end": 205.04,
   "text": "پس رفت مطلقا. باید اهل استقامت باشه، مستقیم باشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 205.04,
   "end": 210.32,
   "text": "که البته خیلی سخته. اصلاً این هیئت‌ها رو همین موضوع پیر کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 210.32,
   "end": 217.18,
   "text": "ریش علمداران این هیئت‌ها به جهت نداشتن استقامت توسط کارگزاران ری--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 217.18,
   "end": 220.26,
   "text": "سفید میشه. در شوره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 220.26,
   "end": 223.14,
   "text": "در، ا، اه، شورا هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 223.14,
   "end": 225.5,
   "text": "سوره شورا هم هست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 225.5,
   "end": 229.24,
   "text": "یا شعرا که \"فاستقم كما امرت\" خب؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 229.24,
   "end": 233.92,
   "text": "اما \"ومن تاب معك\" نداره \"ومن تاب معك\" توی سوره هوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 233.92,
   "end": 238.4,
   "text": "ولی پیغمبر فرمود سوره هود محاسن منو سفید کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 238.4,
   "end": 240.64,
   "text": "گفتند کدوم آیه از سوره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 240.64,
   "end": 247.84,
   "text": "فرمودن \"فاستقم كما امرت\"ی که تو اون سوره است چون مـ-م \"ومن تاب معك\" پشتش داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 247.84,
   "end": 251.94,
   "text": "خب تو که استقامت داری یا رسول الله و کسایی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 251.94,
   "end": 253.68,
   "text": "\"معک\" همراه تو هستن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 253.68,
   "end": 258.78,
   "text": "اونا ریشه پیغمبر رو سفید کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 258.78,
   "end": 263.24,
   "text": "استقامت خیلی مهمه. حالا اجازه بفرمایید که از حضرت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 263.24,
   "end": 273.38,
   "text": "آیت الله کمیلی خراسانی من فرمایش ایشون ذیل این موضوع رو براتون بخونم چون ایشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 273.38,
   "end": 276.7,
   "text": "از شاگردان حضرت آقای حداد بودن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 276.7,
   "end": 280.36,
   "text": "نفسشون چاقه. دیگه مثل من",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 280.36,
   "end": 283.52,
   "text": "لاغر نیست. برای همین ان شا الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 283.52,
   "end": 291.62,
   "text": "همتون رو می‌سازه. در خصوص \"مع صحت الاستقامة\" ایشون می‌فرمود:\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 291.62,
   "end": 300.44,
   "text": "سالک باید کاملاً در تحصیل ارادت به معشوق خود پایدار بماند و هیچ گونه ریب، شک،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 300.44,
   "end": 304.16,
   "text": "ضعف، سستی و تنبلی به خود نشان ندهد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 304.16,
   "end": 311.04,
   "text": "چون کمترین ضعف و سستی بیشترین وسوسه شیطانی را در بر دارد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 311.04,
   "end": 319.62,
   "text": "اگر شما یک خرده سست شوی از آن طرف وسوسه نفس و شیاطین بر شما غلبه می‌کند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 319.62,
   "end": 324.36,
   "text": "شیاطین جن و انس منتظرند تا ببینند پای شما چه وقت می‌خواهد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 324.36,
   "end": 331.42,
   "text": "در مسیر حق بلرزد و چه وقت در شما تردید ایجاد می‌شود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 331.42,
   "end": 341.02,
   "text": "لذا خواجه فرمود اگر می‌خواهی ذهول پیدا کنی باید صحت استقامت در اراده را در خود داشته باشی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 341.02,
   "end": 344.22,
   "text": "و یک لحظه پا عقب نگذاری.\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 344.22,
   "end": 351.08,
   "text": "یادمه که حدود سی سال پیش توی مهدیه چهارراه شهید مدنی یه شب جمعه‌ای بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 351.08,
   "end": 355.32,
   "text": "خیلی هم شلوغ بود تا تو خیابون هم بچه‌ها وایساده بودن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 355.32,
   "end": 359.38,
   "text": "وسط کمیل، اون موقع من وسط کمیل زیاد ارجاع می‌کردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 359.38,
   "end": 363.2,
   "text": "وسط کمیل یعنی کمیل‌های ما دو ساعت و نیم بود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 363.2,
   "end": 366.0,
   "text": "اون موقع. تازه اینا نوجوون بودنا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 366.0,
   "end": 369.51,
   "text": "الان نگاه نکن چهل و پنج دقیقه سر تشریف جمع می‌ره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 369.51,
   "end": 376.41,
   "text": "بعد وسط کمه گفتم آقا دامی رو برای ما پهن کردن دشمنان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 376.41,
   "end": 378.55,
   "text": "هرکی رو از نقطه ضعفش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 378.55,
   "end": 382.79,
   "text": "یکی رو از طریق پول، یکی رو از طریق شهوت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 382.79,
   "end": 385.99,
   "text": "یکی رو از طریق مقام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 385.99,
   "end": 390.33,
   "text": "همینطور سر میدن. مراقب باشین مخصوصا آدمایی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 390.33,
   "end": 394.33,
   "text": "پرچمدارن، علم دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 394.33,
   "end": 397.07,
   "text": "اون موقع خیلی مرسوم نبود مثلا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 397.07,
   "end": 402.61,
   "text": "سخنرانی، مداحی چیزی رو بیارن از طریق پول یا شهوت سر بدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 402.61,
   "end": 407.65,
   "text": "اما دیدین بعد از اون چقدر این اتفاق افتاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 407.65,
   "end": 412.17,
   "text": "کی این اتفاق میفته؟ وقتی من و شما متزلزل میشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 412.17,
   "end": 415.17,
   "text": "الان رمز رو داد دیگه کد رو داد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 415.17,
   "end": 421.09,
   "text": "ایشون فرمودن به محض اینکه سست شدید بدونید شیطون اومد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 421.09,
   "end": 424.03,
   "text": "همچی که مردد شدی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 424.03,
   "end": 427.19,
   "text": "حالا برم هیئت یا نرم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 427.19,
   "end": 428.91,
   "text": "حالا الان برم حرم یا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 428.91,
   "end": 435.91,
   "text": "خاک تو سرت کنن که هنوز تشخیص نمیدی که حرم اصلا قابل قیاس با هیچ جا نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 435.91,
   "end": 438.53,
   "text": "هیئت اهل بیت قابل قیاس با هیچ جا نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 438.53,
   "end": 441.27,
   "text": "مونده بره خونه دختر خاله‌ش یا بیاد هیئت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 441.27,
   "end": 447.51,
   "text": "بره خونه پسر خاله‌ش بازی کنه یا بیاد مثلا بره حرم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 447.51,
   "end": 451.15,
   "text": "تو حقته که شیاطین بریزن سرت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 451.15,
   "end": 457.11,
   "text": "هنوز اولویت‌ها رو نمی‌دونی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 457.11,
   "end": 464.35,
   "text": "دومین نکته \"و ملازمت رعایت علی تهذیب الادب.\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 464.35,
   "end": 469.73,
   "text": "چقدر اینجا ما حرف داریم اینجا تو این نکته دوم و آخریش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 469.73,
   "end": 476.27,
   "text": "\"و ملازمت رعایت علی تع-تهذیب الادب.\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 476.27,
   "end": 480.14,
   "text": "باز راضی باشید که از خود استاد براتون بخونم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 480.14,
   "end": 487.13,
   "text": "\"کار دوم آن است که سالک همیشه باید آداب راه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 487.13,
   "end": 490.69,
   "text": "آداب مقابل استاد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 490.69,
   "end": 496.35,
   "text": "رفیق و شئونات سلوک را رعایت کند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 496.35,
   "end": 498.95,
   "text": "بعد از آنکه سالک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 498.95,
   "end": 503.15,
   "text": "سال‌ها در مسیر سلوک بود باید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 503.15,
   "end": 506.75,
   "text": "برایش روشن شود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 506.75,
   "end": 511.97,
   "text": "و بفهمد که باید چگونه رفتار کند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 511.97,
   "end": 516.43,
   "text": "به طور کلی باید ملازم رعایت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 516.43,
   "end": 524.91,
   "text": "باید، باید ملازم رعایت راه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 524.91,
   "end": 527.69,
   "text": "به صورت مدام\" یعنی یک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 527.69,
   "end": 534.93,
   "text": "آن غافل نشه \"به صورت مدام داشته باشه و آن را رعایت نماید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 534.93,
   "end": 537.39,
   "text": "و غفلت نکند.\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 537.39,
   "end": 540.53,
   "text": "ملازمت بر چه چیزی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 540.53,
   "end": 543.09,
   "text": "بر چه چیزی باید ملازمت کنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 543.09,
   "end": 549.27,
   "text": "ملازمت به اینکه آداب سلوک را رعایت و حفظ کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 549.27,
   "end": 553.01,
   "text": "وقتی از هیئت رفت بیرون فکر می‌کنه دیگه از مثلا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 553.01,
   "end": 557.05,
   "text": "حریم حرم دور شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 557.05,
   "end": 560.15,
   "text": "یادتونه اون شب مثال زدم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 560.15,
   "end": 570.67,
   "text": "شما اصلا در، از تعلمه در مصباح العنس می‌خواست مثال بزنه ابدال چگونه بدل انشایی می‌کنند از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 570.67,
   "end": 573.03,
   "text": "بدنشون، از بدنشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 573.03,
   "end": 576.21,
   "text": "هزاران بدل انشایی درست می‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 576.21,
   "end": 579.45,
   "text": "میره اقصا نقاط دنیا آدم‌ها رو کمک می‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 579.45,
   "end": 581.61,
   "text": "اونام فکر می‌کنند امام زمان دیدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 581.61,
   "end": 587.41,
   "text": "همون پنجاه و سه نفر. خب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 587.41,
   "end": 590.17,
   "text": "یادتونه مثالی که علامه زد چی بود؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 590.17,
   "end": 597.81,
   "text": "فرمود چطور شما قبول می‌کنی شما اینجا نشستی سر تا سر دنیا داره تو رو تو تلویزیون نشون میده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 597.81,
   "end": 600.81,
   "text": "تو ماهواره نشون میده. این چیزی شبیه به این.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 600.81,
   "end": 606.71,
   "text": "تازه اون تکنولوژی‌ش خیلی سطح پایین‌تر از این چیزیه که ما می‌گیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 606.71,
   "end": 612.39,
   "text": "این چیزی که ما می‌گیم همیشه کاربرد داره ولی چیزی می‌تونه اونو از کار بندازه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 612.39,
   "end": 617.17,
   "text": "آنتن رو. مانع بشه از مثلا گیرندگی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 617.17,
   "end": 620.35,
   "text": "نگی نرفتی جاهایی که اصلا آنتن نمیده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 620.35,
   "end": 623.83,
   "text": "یه دستگاهی درست می‌کنند آنتن نده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 623.83,
   "end": 628.17,
   "text": "درست شد؟ حالا چه دستگاهی می‌تونه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 628.17,
   "end": 633.13,
   "text": "مقابله کنه با آنتن دهی کانال فیض الهی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 633.13,
   "end": 637.93,
   "text": "کسی می‌تونه جلوی فیض الهی رو بگیره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 637.93,
   "end": 642.83,
   "text": "هر جا تو وسط جهنم هم که باشی تو می‌تونی با حضرت زهرا ارتباط بگیری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 642.83,
   "end": 645.45,
   "text": "مثل همون که مثالشو زدم تو کمر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 645.45,
   "end": 648.11,
   "text": "هفت هزار سال تو آتیش مگه نبود؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 648.11,
   "end": 650.39,
   "text": "یادش اومد گفت یا زهرا کشیدنش بیرون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 650.39,
   "end": 652.27,
   "text": "یعنی چی؟ یعنی ارتباط برقرار شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 652.27,
   "end": 655.23,
   "text": "یعنی کانال وجودی فیض الهی که حضرت زهراست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 655.23,
   "end": 659.39,
   "text": "همیشه جاری و ساریه. اون بسته نمیشه راهش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 659.39,
   "end": 665.59,
   "text": "چگونه قبول می‌کنی که طرف اینجاست تو میلیون‌ها تلویزیون تصویرش داره پخش میشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 665.59,
   "end": 672.91,
   "text": "قبول نمی‌کنی که بتونه از خودش بدل انشایی از بدنش ایجاد کنه، ایجاد کنه همه جا باشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 672.91,
   "end": 676.95,
   "text": "چرا اینو نمی‌پذیری؟ الان تو قوه خیالت شما نمی‌تونی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 676.95,
   "end": 679.91,
   "text": "صورت موهوم اصلا یعنی وهمیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 679.91,
   "end": 682.75,
   "text": "اصلا بیرون خارج از تو اصلا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 682.75,
   "end": 685.53,
   "text": "خروجش امکان‌پذیر نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 685.53,
   "end": 689.13,
   "text": "یعنی عقلانی نیست اصلا. یه صورت عجیب و غریب چه می‌دونم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 689.13,
   "end": 693.99,
   "text": "یه دیو هفت سر در قوه خیالت می‌تونی انشا کنی یا نه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 693.99,
   "end": 696.89,
   "text": "صورتشو، شکلشو ایجاد کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 696.89,
   "end": 701.05,
   "text": "خودت خالقی. خلق کنی و ببینیش به تماشاشم بشینی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 701.05,
   "end": 703.01,
   "text": "می‌تونی دیگه این قدرت رو داری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 703.01,
   "end": 705.55,
   "text": "چگونه تو قوه خیالت می‌تونی این کارو بکنی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 705.55,
   "end": 709.15,
   "text": "بیرون از قوه خیالت نمی‌تونی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 709.15,
   "end": 713.09,
   "text": "بیرون تو قوه خیال که خیلی سخت‌تره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 713.09,
   "end": 717.19,
   "text": "اگر دو، تو چهارتا وادی حکمت و عرفان رو درست بری جلو،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 717.19,
   "end": 727.41,
   "text": "می‌دونی تو قوه خیال خیلی سخت‌تره ایجاد کردن اشکال تا بیرون از تو، تو مرتبه نازله که دنیاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 727.41,
   "end": 730.51,
   "text": "چگونه تو، تو خیالت می‌تونی بیرون از خودت نمی‌تونی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 730.51,
   "end": 733.41,
   "text": "پیداست. یه رمز داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 733.41,
   "end": 735.69,
   "text": "یه فرمول داره مثل طی الارض.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 735.69,
   "end": 740.07,
   "text": "فرمول داره. فرمولشو بلد نیستی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 740.07,
   "end": 742.71,
   "text": "که امان از اینکه این فرمول‌ها بیفته دست آدم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 742.71,
   "end": 746.93,
   "text": "کم ظرفیت. بودن تو همین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 746.93,
   "end": 750.83,
   "text": "بهتون گفتم یه نفر و نصفی دو نفری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 750.83,
   "end": 754.81,
   "text": "آقا مثلا یه شبی فرمول طی الارض رو گفتیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 754.81,
   "end": 761.73,
   "text": "که حدیثه من خودم نگفتم امام صادق فرموده رمزشو گفتیم تو یکی از سور قرآنه چیه و اینا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 761.73,
   "end": 765.77,
   "text": "آقا یه نفر تهذیب نفسش هم خوب رعایت کرده بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 765.77,
   "end": 769.01,
   "text": "من با ایشون صحبت کردم، با خونوادش صحبت کردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 769.01,
   "end": 772.79,
   "text": "دیدم درست میگن افتاده به طی، طی الارض.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 772.79,
   "end": 774.89,
   "text": "رعایت کرده افتاده به طی الارض.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 774.89,
   "end": 778.07,
   "text": "همین فرمولشو هم ما شنید رعایت کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 778.07,
   "end": 783.77,
   "text": "خب کار اینا فو-- اینا همش کد و رمزه خیلی راحت میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 783.77,
   "end": 788.93,
   "text": "منتها خب اون بی ظرفیت بود هرچقدر ما زیرمون دیگه نرسید بهش که متوقفش کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 788.93,
   "end": 792.43,
   "text": "اصلا نیست دیگه. همش این ور اون وره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 792.43,
   "end": 797.59,
   "text": "خونواده بیچاره همشم دادشم سر ما می‌زنن فوششو به ما میدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 797.59,
   "end": 800.73,
   "text": "آدم باید ظرفیت داشته باشه بعد همونجا نگرش می‌دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 800.73,
   "end": 805.49,
   "text": "حالا من منتظرم که متوقف بشه چون اینطوری نیست که همینطوری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 805.49,
   "end": 807.67,
   "text": "آقا خ-خدا عالم خدا داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 807.67,
   "end": 812.21,
   "text": "خداست و خدایی می‌کنه. این همه آدم میرن حرم امام رضا چهارتاش شفا می‌گیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 812.21,
   "end": 815.83,
   "text": "هزاران نفر نمی‌گیرن. خداست و خدایی می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 815.83,
   "end": 817.91,
   "text": "امام رضا هم آقا بالا سرش هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 817.91,
   "end": 823.95,
   "text": "خدا بالا سرشه. اصلا همونجا نگرش میدارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 823.95,
   "end": 830.59,
   "text": "و کسی که استفاده کنه از این نخود کیش میشا همونجا نگرش میدارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 830.59,
   "end": 833.97,
   "text": "اگر کسی ادعا کرد بدونید که در هم-- حالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 833.97,
   "end": 838.27,
   "text": "تکذیب هم نکنید. نگید دروغ میگه ولی اینو بدونید که تو همون سطحه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 838.27,
   "end": 843.93,
   "text": "همونجاست. خب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 843.93,
   "end": 847.93,
   "text": "پس این دومیش که خیلی مهمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 847.93,
   "end": 850.41,
   "text": "چقدر دیگه وقت مونده؟ نکنه نمیگید دوباره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 850.41,
   "end": 854.23,
   "text": "یه دقیقه؟ خب تو یه دقیقه دو سه خط بخونیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 854.23,
   "end": 857.41,
   "text": "می‌فرماید ملاحظت بر اینکه-",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 857.41,
   "end": 863.39,
   "text": "تموم شده. تموم شده؟ یه دقیقه ش تموم شد. یه دقیقه بهمون بدید- حرف کدومتون رو قبول کنیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 863.39,
   "end": 870.13,
   "text": "یه دقیقه وقت اضافه. باشه. به عشق بچه هایی که تو آشپزخونه زحمت می‌کشن، یه دقیقه وقت اضافه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 870.13,
   "end": 874.45,
   "text": "ملاحظت به اینکه ملاحظات به چی آقا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 874.45,
   "end": 879.63,
   "text": "به اینکه آداب سلوک را رعایت و حفظ کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 879.63,
   "end": 882.01,
   "text": "چون اگر بی ادبی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 882.01,
   "end": 884.49,
   "text": "از ما سر بزند،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 884.49,
   "end": 889.99,
   "text": "از چشم خدا می‌افتیم و ساقط و پرت می‌شویم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 889.99,
   "end": 894.05,
   "text": "آنقدر باید مراقبه را در خودمان تشدید کنیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 894.05,
   "end": 899.33,
   "text": "که حتی یک عدد از آداب سلوک،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 899.33,
   "end": 908.35,
   "text": "آداب طریق و آداب ارادتی که مرید باید داشته باشد از دستمان نرود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 908.35,
   "end": 916.43,
   "text": "بعد مثال استادشون آقای حداد رو می‌زنن که یه نفر خیلی هم گوش بود و هوش بود و قشنگ می‌نوشت‌ها خیلی اهله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 916.43,
   "end": 920.47,
   "text": "ولی بی ادبی می‌کرد. چرا تو پرت می‌گفت مثل بعضیا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 920.47,
   "end": 928.07,
   "text": "بعد هرچی بهش تذکر میدادیم گوش نمی‌داد تا رفته رفته آقای حداد ایشون رو طردش کرد از جلسه و از خودش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 928.07,
   "end": 931.63,
   "text": "استاد تشخیص میده این کسی به دردش نمی‌خوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 931.63,
   "end": 934.11,
   "text": "چه به خودش بگه چه نگه میونه طردش می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 934.11,
   "end": 937.21,
   "text": "از چشم استاد میفته و طرد میشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 937.21,
   "end": 940.13,
   "text": "عالم حساب و کتاب داره رفیق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 214,
   "start": 940.13,
   "end": 945.31,
   "text": "یه شب میای اینجا از اول تا آخر تو ق-آغوش امام زمانی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 215,
   "start": 945.31,
   "end": 949.89,
   "text": "یه شب آقا از دور نگات می‌کنه میگه تو هم از دور منو نگاه کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 216,
   "start": 949.89,
   "end": 952.23,
   "text": "حساب کتاب داره داداش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 217,
   "start": 952.23,
   "end": 955.79,
   "text": "همه چی حساب کتاب داره. ما بی‌توجه‌ایم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 218,
   "start": 955.79,
   "end": 957.79,
   "text": "والحمد لله رب العالمین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 219,
   "start": 957.79,
   "end": 963.15,
   "text": "صلوات بفرستید. اللهumma صل علی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 220,
   "start": 963.15,
   "end": 964.86,
   "text": "محمد و آل محمد و عجّل فرجهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}