 "chapters": [
  {
   "index": 0,
   "title": "## دو شرط لقاء رب در آخرین آیهٔ کهف",
   "start": 0.42,
   "end": 49.84
  },
  {
   "index": 1,
   "title": "مطلقاً. در عبادت پروردگارش شریک نگیرد؛ شریک قائل نشود.",
   "start": 49.84,
   "end": 152.6
  },
  {
   "index": 2,
   "title": "## ظاهر عمل صالح و عبور به باطن آیه",
   "start": 152.6,
   "end": 227.22
  },
  {
   "index": 3,
   "title": "## عمل صالح در نص روایت: معرفت اهل بیت",
   "start": 227.22,
   "end": 414.27
  },
  {
   "index": 4,
   "title": "آقا جان،",
   "start": 414.27,
   "end": 434.45
  },
  {
   "index": 5,
   "title": "آقا، چرا خطبهٔ غدیر را صرفاً زوم کرده‌اید روی",
   "start": 434.45,
   "end": 642.61
  },
  {
   "index": 6,
   "title": "## تذکر آقای بهجت و علامه مصباح: شیطان روی ولایت کار می‌کند",
   "start": 642.61,
   "end": 753.59
  },
  {
   "index": 7,
   "title": "## وای بر گناه و تجسس در هیئت",
   "start": 753.59,
   "end": 1050.81
  },
  {
   "index": 8,
   "title": "## سفیر سیدالشهدا؛ زمینه‌سازی برای حسین زمان",
   "start": 1050.81,
   "end": 1156.17
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.42,
   "end": 5.1,
   "text": "خودش رو ملاقات کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 5.1,
   "end": 8.82,
   "text": "چیکار باید بکنه؟ یادتونه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 8.82,
   "end": 11.9,
   "text": "فمن يعمل. فرمود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 11.9,
   "end": 16.7,
   "text": "فمن کان یرجو لقاء ربه فلیعمل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 16.7,
   "end": 19.2,
   "text": "پس عمل کند. چه عملی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 19.2,
   "end": 24.42,
   "text": "عملا صالحا. ظاهرا یعنی اعمال صالح.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 24.42,
   "end": 26.96,
   "text": "عمل صالح هم که قبلا ترجمه کردیم یعنی چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 26.96,
   "end": 29.3,
   "text": "به وقتش باشه، با اخلاص باشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 29.3,
   "end": 36.04,
   "text": "در زمان و مکان درستی انجام بشه و با آداب و تقدّم و تأخراتش که قبلا صحبت کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 36.04,
   "end": 38.08,
   "text": "اما باید ببینیم خب تعبیرش چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 38.08,
   "end": 45.36,
   "text": "عبور کنیم از این ظاهر، یه ورق بزنیم بریم به باطن آیه ببینیم اهل بیت علیهم السلام پیرامون کنه این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 45.36,
   "end": 47.0,
   "text": "عمل صالح چیزی فرمودن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 47.0,
   "end": 49.84,
   "text": "منظور از این منطوق چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 49.84,
   "end": 54.94,
   "text": "آقا شما می‌خوای پروردگارتو زیارت کنی، اولین راه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 54.94,
   "end": 56.74,
   "text": "عمل صالح باید انجام بدی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 56.74,
   "end": 59.56,
   "text": "دومی‌ش چیه؟ حالا بخونم آیه رو بعد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 59.56,
   "end": 63.08,
   "text": "یه ورق بزنیم به باطن‌ش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 63.08,
   "end": 69.5,
   "text": "ولا یشرک بعبادة ربه احدا مطلقا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 69.5,
   "end": 72.46,
   "text": "در پرـ، عبادت پروردگارش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 72.46,
   "end": 75.84,
   "text": "شریک نگیره، شریک قائل نشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 75.84,
   "end": 82.58,
   "text": "لا اله الا الله له الملك وله الحمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 82.58,
   "end": 85.16,
   "text": ". لمن الملك اليوم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 85.16,
   "end": 90.12,
   "text": "لـ، خودش جواب میده. لله الواحد القهار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 90.12,
   "end": 93.26,
   "text": "که این واحدیت تو قبلا که همون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 93.26,
   "end": 100.74,
   "text": "عالم کثرات، کثرته وقتی در کنار قهاریت میاد معنای اهدیّت میده قبلا گفتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 100.74,
   "end": 103.42,
   "text": "یعنی اون دیگه مقام فوق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 103.42,
   "end": 110.5,
   "text": "همه مراتب که حقایق همه اونجا مندمجن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 110.5,
   "end": 116.38,
   "text": "خب این شرک قائل نشه در عبادت پروردگارش یعنی چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 116.38,
   "end": 120.11,
   "text": "میشه بفرمایید؟ آقا مگه ما الان بت می‌پرستیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 120.11,
   "end": 125.66,
   "text": "ما رو به خانه خدا می‌کنیم قربتا الی الله نماز می‌خونیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 125.66,
   "end": 131.12,
   "text": "چه شرکی؟ خب دقت بفرمایید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 131.12,
   "end": 136.82,
   "text": "من همین دو تا نکته رو به، این دو تا سؤال رو جواب بدم امشب بس من و شماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 136.82,
   "end": 145.94,
   "text": "فقط به شرط اینکه از این کوچولوترای ظاهری البته از من بزرگترن، بگیر تا بزرگ‌ترا و ریش سفیدامون که تاج سر منن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 145.94,
   "end": 150.9,
   "text": "خواهر و برادر این دو تا رو جدی بگیریم و هممون بشه، غممون بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 150.9,
   "end": 160.38,
   "text": "دقت بفرمایید. در تفسیر اهل بیت علیهم الصلاة والسلام ذیل این آیه شریفه روایت قشنگی دیدم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 160.38,
   "end": 168.4,
   "text": "که حضرت فرمودن این فمن کان یرجو لقاء ربه فلیعمل عملا صالحا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 168.4,
   "end": 172.12,
   "text": "یک عمل صالح انجام بده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 172.12,
   "end": 174.98,
   "text": "تا به لقاء پروردگارش برسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 174.98,
   "end": 179.56,
   "text": "منظور از این عمل صالح چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 179.56,
   "end": 182.2,
   "text": "آیا اینه که دارید با هم صحبت می‌کنید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 182.2,
   "end": 184.46,
   "text": "لب مطلبه. حیفه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 184.46,
   "end": 187.74,
   "text": "منظور از این عمل صالح چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 187.74,
   "end": 190.86,
   "text": "نمازه؟ روزه است؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 190.86,
   "end": 193.4,
   "text": "حجه؟ جهاده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 193.4,
   "end": 197.96,
   "text": "چیه که این عمل صالح",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 197.96,
   "end": 203.3,
   "text": "کمک میکنه تو رو پروردگارتو ملاقات کنی حتی در همین دنیا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 203.3,
   "end": 206.6,
   "text": "که قبلا بحثش گذشته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 206.6,
   "end": 212.62,
   "text": "که تو همین دنیا میشه خدا رو ملاقات کرد که همون حیوة مطبوعه dalamة مطبوعه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 212.62,
   "end": 215.68,
   "text": "سفر از ظاهر به باطن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 215.68,
   "end": 223.52,
   "text": "به یک معنا زیارت درست و درمون از ولی خدا و انسان کامله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 223.52,
   "end": 226.64,
   "text": "چیه آقا این عمل صالح به نظر شما؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 226.64,
   "end": 236.14,
   "text": "روایت، نص صریح روایت فرمود این عمل صالح معرفت اهل بیت عصمت و طهارت علیهم الصلاة والسلام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 236.14,
   "end": 242.26,
   "text": ". یعنی مافوق نمازه، بلکه روح نمازه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 242.26,
   "end": 244.42,
   "text": "بدون معرفت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 244.42,
   "end": 254.1,
   "text": "چیزی از ما پذیرش نمیشه. قبلا عرض کردم باز هم برای چندمین بار عرض می‌کنم ما یک علم داریم که دانش کلیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 254.1,
   "end": 257.36,
   "text": "می‌گیم پنج به علاوه پنج مساوی با ده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 257.36,
   "end": 259.86,
   "text": "این دانشه، کلیه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 259.86,
   "end": 262.42,
   "text": "خب؟ اما این معرفت نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 262.42,
   "end": 266.6,
   "text": "کی میشه معرفت؟ این علم فکریه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 266.6,
   "end": 269.38,
   "text": "وقتی بدل شد به علم جزئی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 269.38,
   "end": 277.16,
   "text": "دانش جزئی، یعنی این علم نورش به من و تو کمک کرد که بفهمیم یک حقیقتی رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 277.16,
   "end": 280.32,
   "text": "نه یک چیزی رو حفظ کنیم مثل دو دو تا چهار تا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 280.32,
   "end": 282.68,
   "text": "یه حقیقتی رو بچشیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 282.68,
   "end": 285.98,
   "text": "بفهمیم، بهش برسیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 285.98,
   "end": 290.24,
   "text": "دارا بشیم، نه دانا شدن صرفا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 290.24,
   "end": 296.26,
   "text": "به این میگن معرفت. حالا اونجا عمل صالح رو حضرت فرمود چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 296.26,
   "end": 300.2,
   "text": "معرفت اهل بیت علیهم الصلاة والسلام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 300.2,
   "end": 309.22,
   "text": "پس رفقا آیا اگر عمل صالحی که منتج می‌شود به ملاقات رب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 309.22,
   "end": 313.48,
   "text": "معرفت انسان کامل و امام عصر ماست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 313.48,
   "end": 316.78,
   "text": "معرفت امام حسین صلوات الله علیه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 316.78,
   "end": 320.18,
   "text": "معرفت حضرت وسی امیرالمؤمنینه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 320.18,
   "end": 323.98,
   "text": "معرفت حضرت زهرا صلوات الله علیهاست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 323.98,
   "end": 330.14,
   "text": "خواهرم، برادرم آیا این خیمه‌ها، این هیئت‌ها، این جلسات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 330.14,
   "end": 334.34,
   "text": "کمک‌کننده‌ی به ملاقات ربمون نیست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 334.34,
   "end": 336.2,
   "text": "چرا؟ تا کی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 336.2,
   "end": 339.84,
   "text": "مادامی که معرفت افزایی صورت بگیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 339.84,
   "end": 342.32,
   "text": "معرفت امام اینجا افزایش پیدا کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 342.32,
   "end": 344.52,
   "text": "ما اماممون رو بهتر بشناسیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 344.52,
   "end": 347.7,
   "text": "بیشتر بشناسیم. نه دهه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 347.7,
   "end": 350.86,
   "text": "نه کل ماه، بلکه هر شب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 350.86,
   "end": 354.22,
   "text": "که جلسه تموم شد تو قشنگ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 354.22,
   "end": 358.48,
   "text": "احساس کنی شناختت، اون علم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 358.48,
   "end": 362.86,
   "text": "دانش جزئی رو میگم در درونت یعنی چشیدن، رسیدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 362.86,
   "end": 366.68,
   "text": "یعنی یک چشیدن جدیدی از امام حسین داشتی امشب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 366.68,
   "end": 368.8,
   "text": "یه طور دیگه آقا رو درک کردی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 368.8,
   "end": 371.26,
   "text": "یه تقرب دیگه‌ای پیدا کردی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 371.26,
   "end": 375.9,
   "text": "خودمونی بگم، بچگانه بگم امام حسین رو یه طور دیگه دوست داری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 375.9,
   "end": 379.19,
   "text": "احساس قرابت با حضرت می‌کنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 379.19,
   "end": 381.47,
   "text": "بیشتر خوشت اومده از آقا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 381.47,
   "end": 390.81,
   "text": "این معرفت افزایی کارو به اینجا می‌رسونه که علت اینکه خیلیا با امام حسین غریبه‌ن، غریبه‌ن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 390.81,
   "end": 394.49,
   "text": "یا مثلا خدا رو، خیلی خدا رو دوست ندارن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 394.49,
   "end": 397.43,
   "text": "مثلا اهل ایمانو خیلی دوست ندارن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 397.43,
   "end": 400.51,
   "text": "علتش چیه؟ نداشتن معرفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 400.51,
   "end": 404.57,
   "text": "شناخت ندارن. خسته‌تون نکنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 404.57,
   "end": 408.45,
   "text": "قصدم غل و دل هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 408.45,
   "end": 411.25,
   "text": "نکته دوم رو بگم و بسه امشب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 411.25,
   "end": 417.23,
   "text": "آقا جان \"ولا یشرک بعبادة ربه أحدا\" شرط دوم برای ملاقات رب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 417.23,
   "end": 419.29,
   "text": "شرک نداشتن در عبادت رب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 419.29,
   "end": 423.39,
   "text": "منظور از این نداشتن شرک چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 423.39,
   "end": 428.59,
   "text": "امام عزیزم میشه شما بفرمایید که وصل به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 428.59,
   "end": 431.35,
   "text": "عالم قدس بلکه اقدسید،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 431.35,
   "end": 438.65,
   "text": "حضرت فرمودن این \"ولا یشرک بعبادة ربه أحدا\" یعنی به به، به به،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 438.65,
   "end": 441.03,
   "text": "یعنی برای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 441.03,
   "end": 448.21,
   "text": "ولایت امیرالمؤمنین علی ابن ابی طالب شریکی قائل نشو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 448.21,
   "end": 454.17,
   "text": "اللهم صل على محمد و آل محمد و عجل فرج یعنی خلیفه بلا فصل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 454.17,
   "end": 458.43,
   "text": "یعنی وصایت بلا فاصله بعد از پیغمبر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 458.43,
   "end": 461.61,
   "text": "اینه که حضرت علامه تاکید می‌کنه در غدیر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 461.61,
   "end": 469.21,
   "text": "آقا چرا خطبه غدیر رو صرفا شما زوم کردید تو \"من کنت مولا فهذا علی مولا\" اونم به حق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 469.21,
   "end": 471.93,
   "text": "هر جا تابلویی از غدیر بالاست همینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 471.93,
   "end": 481.63,
   "text": "چرا این قسمت نمیاد که پیغمبر مولا رو که کند از زمین که عظمت مولا و این ابلاغ رو برسونه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 481.63,
   "end": 487.85,
   "text": "چرا اینو نمیگیم که فرمود این علی وصی بلا فصل منه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 487.85,
   "end": 492.39,
   "text": "این آقا، این علی وصی بلا فصل یعنی بدون جدایی، بدون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 492.39,
   "end": 497.83,
   "text": "فصل، بدون-- یعنی بلا فاصله بعد از-- نه اینکه بگی خلیفه چهارم، نه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 497.83,
   "end": 499.75,
   "text": "چرا اونو بولدش نمی‌کنید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 499.75,
   "end": 502.83,
   "text": "لذا علامه همیشه می‌فرمودن حضرت وصی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 502.83,
   "end": 507.65,
   "text": "برای خود من سؤال بود اون اوایل که خب صحبت‌های ایشون رو می‌شنیدیم یا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 507.65,
   "end": 511.59,
   "text": "مثلا یادش بخیر اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 511.59,
   "end": 514.71,
   "text": "موقع‌هایی که قم بودیم بعضی موقع محضرشون می‌رفتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 514.71,
   "end": 518.99,
   "text": "خب ایشون می‌دیدن همه میگن امیر المؤمنین، ایشون میگه حضرت وصی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 518.99,
   "end": 523.01,
   "text": "بعدا خب دلیلش رو که بیان کردن دیدم چه شیرین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 523.01,
   "end": 526.33,
   "text": "اون‌ها در مولا می‌تونن انقلاب ایجاد کنن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 526.33,
   "end": 530.79,
   "text": "منقلب کنن، منحرف کنن معنای مولا رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 530.79,
   "end": 533.13,
   "text": "بگن پیغمبر تو اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 533.13,
   "end": 537.15,
   "text": "گرمای شدید جزیرة العرب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 537.15,
   "end": 539.95,
   "text": "سه شبانه روز ملت رو نگه داشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 539.95,
   "end": 544.45,
   "text": "اونایی که جا موندن برسن، اونایی که جلو رفتن برگردن که چی بشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 544.45,
   "end": 547.83,
   "text": "آقا هرکی منو دوست داره این آقا رو دوست داشته باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 547.83,
   "end": 549.91,
   "text": "اون اهل تسنن اینو میگن دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 549.91,
   "end": 555.95,
   "text": "درسته؟ میان از اون هفده معنایی که بر مولا هست این رو قائلن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 555.95,
   "end": 562.54,
   "text": "این تحریفه. و اون مولای اونجا همه کاره بودنه، سرپرسته،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 562.54,
   "end": 570.01,
   "text": "ولایت امریه که \"أولى للمؤمنين بأنفسهم\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 570.01,
   "end": 574.17,
   "text": "یعنی از جان خودت به خودت اولی‌ست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 574.17,
   "end": 576.41,
   "text": "مولا. اینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 576.41,
   "end": 579.15,
   "text": "خب اونجا تونستن انحراف ایجاد کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 579.15,
   "end": 580.85,
   "text": "اما در وصی چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 580.85,
   "end": 584.79,
   "text": "ولی وصی بلا فصل چه می‌تونه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 584.79,
   "end": 588.91,
   "text": "انحراف ایجاد کنه؟ لذا اینو نذاشتن بولد بشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 588.91,
   "end": 593.25,
   "text": "تو غدیر متاسفانه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 593.25,
   "end": 598.99,
   "text": "پس \"ولا یشرک بعبادة ربه أحدا\" هم پدر مادراتونو دعا کنید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 598.99,
   "end": 601.95,
   "text": "که وصایت بلا وصل،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 601.95,
   "end": 605.17,
   "text": "بلا فصل امیرالمؤمنین رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 605.17,
   "end": 608.67,
   "text": "با شیر خودشون، مادر با شیر پاکش،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 608.67,
   "end": 611.13,
   "text": "پدر با لقمه حلالش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 611.13,
   "end": 617.85,
   "text": "و با ادب آموزش اینو در جان و نهاد و نهان‌خانه وجود تو به ودیعت نهاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 617.85,
   "end": 621.09,
   "text": "یعنی تو از اول بچگی گفتی علی ولی الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 621.09,
   "end": 623.79,
   "text": "علی وصی رسول الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 623.79,
   "end": 627.49,
   "text": "توی هیأت‌هام یاد گرفتی تمرینش کردی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 627.49,
   "end": 635.13,
   "text": "دیگه به شرک نمیفتی. تو کارت در ملاقات با خدا خیلی آسون‌تر شده و میشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 635.13,
   "end": 639.71,
   "text": ". باید رو معرفت کار کنیم .",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 639.71,
   "end": 642.61,
   "text": "البته مراقب شیطان هم باید باشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 642.61,
   "end": 649.19,
   "text": "نکته آخری که میگم حالا که حرف به اینجا کشیده شد، پرانتز باز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 649.19,
   "end": 653.83,
   "text": "دقت بفرمایید. هیچ‌وقت یادم نمیره این تاکید آقای مصباح رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 653.83,
   "end": 659.55,
   "text": "روحش شاد. در یه جلسه اخلاقی محضرشون بودیم قم، خیلی سال‌های پیش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 659.55,
   "end": 664.47,
   "text": "ایشون فرمودن که بیش از پونزده سال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 664.47,
   "end": 666.47,
   "text": "استاد ما آقای بهجت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 666.47,
   "end": 669.91,
   "text": "همش حدیث ولایت می‌خوند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 669.91,
   "end": 674.53,
   "text": "ما یه روز جسارت کردیم به ایشون گفتیم آقا بالاخره این همه حدیث هست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 674.53,
   "end": 678.13,
   "text": "اینها یه حدیث جدیدی شما دائم--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 678.13,
   "end": 683.51,
   "text": "ایشون فرمود که وقتی چند تا دونه ریشت که سفید شد، آقای مصباح فرمود و آقای بهجت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 683.51,
   "end": 687.39,
   "text": "همیشه چه خوش که الانم کنارهم دفن‌ن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 687.39,
   "end": 689.41,
   "text": "ریشات که سفید شد چند تاشو می‌فهمی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 689.41,
   "end": 692.19,
   "text": "چرا من انقدر اصرار دارم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 692.19,
   "end": 694.49,
   "text": "چند بارم اینو خدمتتون به یادگار عرض کردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 694.49,
   "end": 696.77,
   "text": "آقای مصباح فرمود الان اون موقع،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 696.77,
   "end": 700.27,
   "text": "خب این چیزی که من الان دارم به شما میگم مال حدود بیست و پنج سال پیشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 700.27,
   "end": 704.41,
   "text": "ایشون فرمود الان که ریشام به سفیدی داره میره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 704.41,
   "end": 708.01,
   "text": "می‌بینم که شیطان میاد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 708.01,
   "end": 714.51,
   "text": "به شدت می‌خواد رو من کار کنه که نسبت به ولایت و وصایت بلا فصلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 714.51,
   "end": 721.25,
   "text": "امیرالمؤمنین حضرت وصی در من تشکیک ایجاد کنه، منو به شک بندازه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 721.25,
   "end": 730.43,
   "text": "علامه مصباح وقتی اینو می‌گفت، بعد می‌فرمود همون تذکرات پونزده ساله آقای بهجت منو حفظ کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 730.43,
   "end": 734.63,
   "text": "یعنی شیطان فکر نکن دیگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 734.63,
   "end": 742.09,
   "text": "ریشی و تسبیحی و دلقی و سجاده‌ای و هیئت یا زهرا و مسجدی و قاری قرآنی و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 742.09,
   "end": 750.05,
   "text": "کتابی و دانشگاهی و حوزه‌ای و امامه ابایی و ایناها دیگه کاری با من-- حتی برعکس با ماها بیشتر کار داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 750.05,
   "end": 757.31,
   "text": "بارها این رو گفتیم. وای به حال کسی که بیاد در هیئت گناه کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 757.31,
   "end": 763.55,
   "text": "وای به حال کسی که بیاد در هیئت تجسس در امور دیگران کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 763.55,
   "end": 768.81,
   "text": "امام حسین منو ببخشه. اخیرا یکی از دوستان‌مون رو دیدم از قدیمی‌های هیئت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 768.81,
   "end": 770.89,
   "text": "که دیگه خیلی دست‌پاشکسته میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 770.89,
   "end": 774.23,
   "text": "معمولا فقط یه شب قدری مثلا شب عاشورایی بیاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 774.23,
   "end": 776.75,
   "text": "یه ذره با هم دردل کردیم گفت بابا حاجی چه خبر؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 776.75,
   "end": 778.73,
   "text": "چه-چیکار دارید می‌کنید شما اهل ایمان؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 778.73,
   "end": 783.05,
   "text": "گفتم چی شده؟ گفت یکی از بچه‌های ثابت هیئت‌تون رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 783.05,
   "end": 786.29,
   "text": "من گوشه خیابون دیدم سوار کردم رفتیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 786.29,
   "end": 789.27,
   "text": "که برسونمش توراه شروع کرد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 789.27,
   "end": 791.61,
   "text": "شنیدم از خانمت جدا شدی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 791.61,
   "end": 794.81,
   "text": "برای چی جدا شدی؟ رفتی ازدواج مجدد کردی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 794.81,
   "end": 803.33,
   "text": "کیو گرفتی؟ میگفت من مونده بودم آخه، آخه به تو چه ربطی داره این حرفای مسائل شخصی زندگی من؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 803.33,
   "end": 805.41,
   "text": "که من چرا از خانومم جدا شدم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 805.41,
   "end": 809.65,
   "text": "با کی ازدواج کردم، کجا زندگی می‌کنم، اصلا قصه ما چی بود به تو چه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 809.65,
   "end": 816.15,
   "text": "دهانت را ببند. از سینه زنی امام حسینم هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 816.15,
   "end": 820.21,
   "text": "غیبت، تهمت، دروغ، تجسس در امور مردم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 820.21,
   "end": 823.43,
   "text": "سوءظن. همینا هیئتا رو پاچون داده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 823.43,
   "end": 827.03,
   "text": "قصه انتخابات ما چرا به این وضعیت کشیده شد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 827.03,
   "end": 831.39,
   "text": "همین چند دستگی‌ها، نداشتن اتحاد اهل ایمان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 831.39,
   "end": 835.65,
   "text": "جز این نبود. چیز دیگه ای رو نگردید دنبالش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 835.65,
   "end": 839.27,
   "text": "زیرکی اون‌ها رو بذارید مرحله بعد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 839.27,
   "end": 845.33,
   "text": "از عدم انسجام ما سواستفاده کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 845.33,
   "end": 849.73,
   "text": "کار کیه؟ شیطان. اتفاقا وقتی میای هیئت تازه زوم میکنه روت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 849.73,
   "end": 852.15,
   "text": "شیطان. چون رسیدی به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 852.15,
   "end": 854.97,
   "text": "اصل. میخواد اصلو ازت بگیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 854.97,
   "end": 859.83,
   "text": "این که سر کوچه‌ست که شیطان کاری باهاش نداره که، با تو کار داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 859.83,
   "end": 864.85,
   "text": "بیایید عهد ببندید هیچ کجا نفاق ایجاد نکنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 864.85,
   "end": 873.11,
   "text": "سر سفره حضرت زهرا نهایت پاکی و طهارت باشیم هممون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 873.11,
   "end": 878.69,
   "text": "یه هدیه هم بهتون از یکی از شهدای زنده بدم و...",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 878.69,
   "end": 882.43,
   "text": "دعا رو-- مناجات شروع کنم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 882.43,
   "end": 884.89,
   "text": "که حالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 884.89,
   "end": 887.43,
   "text": "این قسمت انتها یک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 887.43,
   "end": 892.67,
   "text": "سوم والصلص انتهای بحث ما من اصلا آماده نکردم بگم رزقتون داره میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 892.67,
   "end": 897.55,
   "text": "یکی از دوستان خیلی خوب ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 897.55,
   "end": 900.41,
   "text": "که به واقع شهید زنده است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 900.41,
   "end": 903.61,
   "text": "خیلی من ایشونو دوست دارم. سنش از من بالاتره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 903.61,
   "end": 913.79,
   "text": "هر وقت پا منبر ماست من حرف میزنم بدون استثنا یا اشک تو چشمش جمعه یا اشکش جاریه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 913.79,
   "end": 917.43,
   "text": "ایشون اخیرا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 917.43,
   "end": 921.31,
   "text": "بندر کشید کنار یه جایی که ما مرتبطیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 921.31,
   "end": 928.31,
   "text": "شروع کرد گریه کردن به من گفت حاجی خواب حاج قاسم رو دیدم اخیرا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 214,
   "start": 928.31,
   "end": 936.18,
   "text": "گفت دیدم ایشون بالاتر از من، حالا همینا هم من براشون تعبیر کردم که چرا ایشون بالاتر از شما، شما پایین‌تر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 215,
   "start": 936.18,
   "end": 940.07,
   "text": "اینا همش حساب کتاب داره. داشت وضو می‌گرفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 216,
   "start": 940.07,
   "end": 946.67,
   "text": "من با یه التماسی بهش گفتم من جا موندم از قافله شهدا، چقدر شهدا رو مثلا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 217,
   "start": 946.67,
   "end": 950.37,
   "text": "با دست خودمون بدنشون رو بردیم دفن کردیم فلان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 218,
   "start": 950.37,
   "end": 954.93,
   "text": "خب الان من-- آیا ما هم میشه ملحق بشیم به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 219,
   "start": 954.93,
   "end": 958.35,
   "text": "شهدا؟ حاج قاسم گفت بله میشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 220,
   "start": 958.35,
   "end": 962.37,
   "text": "فقط یه شرط داره. به نظر شما شرطش چی بوده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 221,
   "start": 962.37,
   "end": 964.83,
   "text": "به نظر شما حاج قاسم به ایشون حدیث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 222,
   "start": 964.83,
   "end": 967.63,
   "text": "برزخی به این‌ها میگن حدیث برزخی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 223,
   "start": 967.63,
   "end": 972.71,
   "text": "به قول علمای فرمود بگید حدیث برزخی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 224,
   "start": 972.71,
   "end": 977.53,
   "text": "گفته چیکار کن؟ نماز شب بخون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 225,
   "start": 977.53,
   "end": 981.39,
   "text": "برو جهاد در راه خدا کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 226,
   "start": 981.39,
   "end": 986.99,
   "text": "دائم الذکر باش. برو مسجد و هیئت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 227,
   "start": 986.99,
   "end": 990.19,
   "text": "اینا همش تو سر ما عشق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 228,
   "start": 990.19,
   "end": 999.23,
   "text": "عجیبه حاج قاسم فرموده بود تا اونجایی که امکانش هست میتونی تمام هم و غمت رو جمع کن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 229,
   "start": 999.23,
   "end": 1005.01,
   "text": "دو کار نکنی، دروغ و غیبت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 230,
   "start": 1005.01,
   "end": 1008.43,
   "text": "چقدر مثل نقل و نبات بعضی از ما دروغ میگیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 231,
   "start": 1008.43,
   "end": 1013.59,
   "text": "راحت پشت سر برادر و خواهر ایمانی‌مون حرف میزنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 232,
   "start": 1013.59,
   "end": 1019.89,
   "text": "بعد توقع داریم شهید هم بشیم. این قضاوت‌ها رو باید بریزیم بیرون یا نه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 233,
   "start": 1019.89,
   "end": 1030.27,
   "text": "این شبا. من سعی کردم از اون کس که اهل فن و اهل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 234,
   "start": 1030.27,
   "end": 1034.79,
   "text": "علم و اهل مطالعه و تحقیق و پژوهش و کتاب و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 235,
   "start": 1034.79,
   "end": 1046.69,
   "text": "دفتر و اینهاست تا اونهایی که تازه ملحق شدن به این مسیر، بچه‌های کم سن و سال همه حرفا رو بفهمن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 236,
   "start": 1046.69,
   "end": 1050.81,
   "text": "خب الحمد لله رب العالمین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 237,
   "start": 1050.81,
   "end": 1055.31,
   "text": "شب اول محرم هم دیدیمو نمردیمو خداروشکر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 238,
   "start": 1055.31,
   "end": 1057.83,
   "text": "چقدر باید خدارو شکر کنیم رفقا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 239,
   "start": 1057.83,
   "end": 1063.57,
   "text": "رسیدیم به شب اول محرم و شب عشق‌بازیمون با اربابمون حسین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 240,
   "start": 1063.57,
   "end": 1068.41,
   "text": "خداروشکر الحمد لله نمردیمو سر سفره ارباب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 241,
   "start": 1068.41,
   "end": 1072.09,
   "text": "ای کاش ملکوت این جلسات رو به ما نشون میدادن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 242,
   "start": 1072.09,
   "end": 1074.75,
   "text": "که چه خبره، چه غوغاییه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 243,
   "start": 1074.75,
   "end": 1079.25,
   "text": "چه زجه و سه-سهقه و سرخه و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 244,
   "start": 1079.25,
   "end": 1087.99,
   "text": "ناله و فریاد و شیونیست در ملکوت این جلسات توسط قدسیان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 245,
   "start": 1087.99,
   "end": 1090.21,
   "text": "ما هم هی باید زمزمه کنیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 246,
   "start": 1090.21,
   "end": 1093.87,
   "text": "دیوونه‌بازی راه بندازیم تا به اونجا برسیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 247,
   "start": 1093.87,
   "end": 1097.27,
   "text": "شب اول یه شعر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 248,
   "start": 1097.27,
   "end": 1102.43,
   "text": "خاصی رو میخوام بخونم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 249,
   "start": 1102.43,
   "end": 1106.27,
   "text": "از بچه‌های پاک و معصوم عذرخواهی می‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 250,
   "start": 1106.27,
   "end": 1108.79,
   "text": "ان شا الله امام حسین به هممون نظر کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 251,
   "start": 1108.79,
   "end": 1111.65,
   "text": "نائبش، سفیرش،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 252,
   "start": 1111.65,
   "end": 1117.37,
   "text": "سفیر سید الشهدا که زودتر از همه رفت مهیا کنه راه رو برای اربابش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 253,
   "start": 1117.37,
   "end": 1119.49,
   "text": "دستمون رو بگیره ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 254,
   "start": 1119.49,
   "end": 1126.99,
   "text": "هم بتونیم راه رو برای تشریف فرمایی امام زمانمون، حسین زمانمون هموار کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 255,
   "start": 1126.99,
   "end": 1129.07,
   "text": "ما هم زمینه‌ساز ز--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 256,
   "start": 1129.07,
   "end": 1135.63,
   "text": "تشریف فرمایی امام زمانمون، حسین زمانمون بشیم مثل مسلم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 257,
   "start": 1135.63,
   "end": 1138.21,
   "text": "رفت یار جمع کنه کشتنش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 258,
   "start": 1138.21,
   "end": 1140.77,
   "text": "ما هم یار جمع کنیم برای آقامون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 259,
   "start": 1140.77,
   "end": 1146.31,
   "text": "ان شا الله. برای اینکه حالمون خوش بشه خوب بشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 260,
   "start": 1146.31,
   "end": 1149.59,
   "text": "ما هم بتونیم یه دیوونه بازی راه بندازیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 261,
   "start": 1149.59,
   "end": 1151.75,
   "text": "دلتنگیم یه صلوات ختم کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 262,
   "start": 1151.75,
   "end": 1156.17,
   "text": "اللهم صل على محمد و آله طاهر و طاهرين.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}