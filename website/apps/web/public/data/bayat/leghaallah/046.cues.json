 "chapters": [
  {
   "index": 0,
   "title": "## ادامهٔ لقاءالله؛ از شأن نزول حروف تا نام مهدی",
   "start": 0.08,
   "end": 34.48
  },
  {
   "index": 1,
   "title": "حالا در خصوص خودِ این نام مقدس — بلکه اقدس — «مهدی». چرا اقدس؟ چون از نظامِ اشرف و اقدس‌الاسماء تنزّل کرده است:",
   "start": 34.48,
   "end": 135.56
  },
  {
   "index": 2,
   "title": "میم. آقايمان علی بن موسی الرضا علیه‌السلام فرمود: میم، مُلک الله است. مُلک خدا. قیامت، خودِ خدا فریاد می‌زند:",
   "start": 135.56,
   "end": 155.84
  },
  {
   "index": 3,
   "title": "## واحدیّت کنار قهّاریّت؛ معنای احدیّت در میم نام آقا",
   "start": 155.84,
   "end": 189.66
  },
  {
   "index": 4,
   "title": "## مُلک همهٔ عوالم امکانی؛ نه مُلک دنیا",
   "start": 189.66,
   "end": 212.44
  },
  {
   "index": 5,
   "title": "نگویی مثلاً:",
   "start": 212.44,
   "end": 251.32
  },
  {
   "index": 6,
   "title": "بعد چه؟ هاء؛ همان «ه»ی دوچشم. حضرت فرمودند:",
   "start": 251.32,
   "end": 271.5
  },
  {
   "index": 7,
   "title": "## غیبتِ تلخِ ظاهر و شیرینیِ حصن؛ غیرت خدا",
   "start": 271.5,
   "end": 319.1
  },
  {
   "index": 8,
   "title": "حدیث بعدی است. یک وجه دیگرش را آقا می‌گوید: بحث هدایتگری. هدایتگری.",
   "start": 319.1,
   "end": 341.04
  },
  {
   "index": 9,
   "title": "## زره امیرالمؤمنین؛ هادی پشت به دشمن نمی‌کند",
   "start": 341.04,
   "end": 376.13
  },
  {
   "index": 10,
   "title": "دینی که قرآن می‌فرماید:",
   "start": 376.13,
   "end": 399.95
  },
  {
   "index": 11,
   "title": "تمام شد. اگر تسلیمی، مسلمانی.",
   "start": 399.95,
   "end": 420.13
  },
  {
   "index": 12,
   "title": "## یا: ید الله؛ آیهٔ نور",
   "start": 420.13,
   "end": 506.89
  },
  {
   "index": 13,
   "title": "## خاتمه: پذیرش قلیل و آمادگی جشن",
   "start": 506.89,
   "end": 526.03
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.08,
   "end": 4.78,
   "text": "می‌خواستم بحث به فضل در ادامه بحث لقاءالله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 4.78,
   "end": 10.82,
   "text": "که داشتیم حدیث امام رضا رو تموم کنم امشب که اون شأن نزول حروف و باطن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 10.82,
   "end": 14.34,
   "text": "ظاهر حروف رو بیان کنیم تا انتهای چهار پنج تا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 14.34,
   "end": 18.76,
   "text": "هفت هشت تا حرف مونده بود بگیم تموم شه برسیم به آنالیز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 18.76,
   "end": 22.58,
   "text": "خود حروف کلمه مهدی صلوات الله علیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 22.58,
   "end": 24.66,
   "text": "حالا ما همون آخرشو دیگه میگم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 24.66,
   "end": 27.82,
   "text": "حدیث رو انشاالله هفته‌های بعد تموم کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 27.82,
   "end": 31.0,
   "text": "اما بر اساس فرمایش مولامون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 31.0,
   "end": 34.48,
   "text": "ابالحسن علی بن موسی الرضا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 34.48,
   "end": 42.86,
   "text": "از جدشون امیر بیان، امیرالمؤمنین، علی بن ابی طالب صلوات الله علیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 42.86,
   "end": 44.82,
   "text": "در همین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 44.82,
   "end": 47.82,
   "text": "عرض شود باب سی و دو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 47.82,
   "end": 52.08,
   "text": "باب تفسیر حروف المعجم توحید شیخ صدوق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 52.08,
   "end": 54.92,
   "text": "وقتی میریم جلو حدیث تموم میشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 54.92,
   "end": 63.8,
   "text": "می‌تونیم با توجه به علم حروف که امام رضا اینجا داره دیگه حداقلش و انزل مراتبش رو به ما نشون میده که حروف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 63.8,
   "end": 66.46,
   "text": "هر حرفی چه شأنی دارن و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 66.46,
   "end": 77.02,
   "text": "چه نشانه‌ای‌اند و چه باطنی و بلکه بواتنی دارن تا جایی که فرمود یک حرف از قرآن هفتاد هزار معنا دارد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 77.02,
   "end": 81.74,
   "text": "احادیث اهل بیت هم که منزله بدن اون روح کلی قرآن‌اند،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 81.74,
   "end": 85.34,
   "text": "این چنین هستند. حالا در خصوص",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 85.34,
   "end": 88.5,
   "text": "خود این نام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 88.5,
   "end": 91.94,
   "text": "مقدس بلکه اقدس مهدی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 91.94,
   "end": 94.16,
   "text": "میگیم اقدس چون از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 94.16,
   "end": 96.78,
   "text": "نظام اشرف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 96.78,
   "end": 101.88,
   "text": "و اقدس الاسماء تنزل من السماء از اونجا نازل شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 101.88,
   "end": 104.52,
   "text": "از اونجا اومدن ما این رو بر اساس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 104.52,
   "end": 111.56,
   "text": "فرمایش امام رضا با توجه به حروف که شأن نزولش رو یاد گرفتیم و اون چند تای که هنوز نگفتیم ببینید چی میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 111.56,
   "end": 115.84,
   "text": "خب نساء حضرت مهدی صلوات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 115.84,
   "end": 120.02,
   "text": "اللهم صل على محمد و آل محمد و عجل فرج.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 120.02,
   "end": 123.44,
   "text": "ميم. ميم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 123.44,
   "end": 127.84,
   "text": "آقامون علی بن موسی الرضا فرمود ملک الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 127.84,
   "end": 135.56,
   "text": "ملک الله قیامت خود خدا فریاد میزنه لمن الملك اليوم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 135.56,
   "end": 137.52,
   "text": "ملک امروز مال کیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 137.52,
   "end": 139.5,
   "text": "لمن یعنی برای کیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 139.5,
   "end": 144.28,
   "text": "اليوم امروز. لمن الملك اليوم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 144.28,
   "end": 147.94,
   "text": "ملک امروز مال کیه؟ بعد اینجا امام رضا حالا به شأن نرسیده بودیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 147.94,
   "end": 150.84,
   "text": "می‌فرمود که اونجا انبیا، اولیا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 150.84,
   "end": 153.2,
   "text": "همه فریاد می‌زنن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 153.2,
   "end": 155.84,
   "text": "لله الواحد القهار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 155.84,
   "end": 162.38,
   "text": "که اون واحدیت که کثراته کنار قهاریت که میاد میشه واحدیت که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 162.38,
   "end": 170.87,
   "text": "مرحله ادغام همه این و که استهلاک همه کثرات در اون حقیقت کلیه و بسیط الحقیقه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 170.87,
   "end": 176.94,
   "text": "احدیت. من وقتی گفتیم واحدیت کنار قهاریت میاد معنای احدیت داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 176.94,
   "end": 179.52,
   "text": "یعنی بالاترین مراتب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 179.52,
   "end": 182.14,
   "text": "تو اون میمه دقت بفرمایید چی عرض می‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 182.14,
   "end": 185.84,
   "text": "تو اون میم نام آقامون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 185.84,
   "end": 189.66,
   "text": "همه این جمع تو یک وجهش فقط.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 189.66,
   "end": 200.44,
   "text": "اصلاً ملک و اگر چون جواب لله الواحد القهار اینجا صرفاً ملک دنیوی نیست پیداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 200.44,
   "end": 203.58,
   "text": "اون سلطنت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 203.58,
   "end": 205.8,
   "text": "تمام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 205.8,
   "end": 207.98,
   "text": "عوالم امکانیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 207.98,
   "end": 210.56,
   "text": "یعنی از مادون بگیر تا مافوق؛",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 210.56,
   "end": 215.24,
   "text": "از انزل مراتب بگیر تا اشخخ و اشرف مراتب، اعلی مراتب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 215.24,
   "end": 217.74,
   "text": "همه و همه اینجا ملک در این ملک جمع‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 217.74,
   "end": 221.08,
   "text": "نه ملک دنیایی. بگی مثلاً له",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 221.08,
   "end": 225.56,
   "text": "ملک السماوات والارض بگیری سماوات و ارض دنیا، نه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 225.56,
   "end": 228.94,
   "text": "اون میم همه رو درش جمع کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 228.94,
   "end": 233.82,
   "text": "همه این ملک و ملک و ملکوت رو جمع کن درش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 233.82,
   "end": 237.08,
   "text": "یعنی ببین همه چی دست آقاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 237.08,
   "end": 239.34,
   "text": "ملک و ملکوت سر انگشت آقاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 239.34,
   "end": 241.22,
   "text": "اینه حالا خب اینجا حرف زیاد هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 241.22,
   "end": 243.98,
   "text": "منتها شما گفتین پنج دقیقه سریع می‌گذریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 243.98,
   "end": 248.5,
   "text": "بعد چی؟ ها. ه دو چشم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 248.5,
   "end": 251.32,
   "text": "حضرت فرمودند هان على الله من اساه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 251.32,
   "end": 253.54,
   "text": "در این روایت اینو فرمودن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 253.54,
   "end": 257.22,
   "text": "یعنی هان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 257.22,
   "end": 260.02,
   "text": "سبکه هان یعنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 260.02,
   "end": 265.62,
   "text": "چیزی نیست اصلاً برای خدا على الله که من اساه معصیتشو بکنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 265.62,
   "end": 268.84,
   "text": "اصلاً سر سوزن گزندی به خدا وارد نمیشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 268.84,
   "end": 273.84,
   "text": "همه عالم جمع شن مهدی کشون راه بندازن آقا در یک حصن و پناهی‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 273.84,
   "end": 278.16,
   "text": "اهدی نمی‌تونه الحمدالله و منه جسارتی به آقامون بکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 278.16,
   "end": 279.86,
   "text": "اینم عشقه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 279.86,
   "end": 285.08,
   "text": "تلخه ظاهرش که آقا در غیبته از ظاهر اما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 285.08,
   "end": 290.25,
   "text": "اینم شیرینه که در حصن و پناه مثل اونا نیست که بزنن بکشن هر غلطی بکنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 290.25,
   "end": 293.6,
   "text": "نه این دیگه خب سر این دیگه خدا غیرت نشون داده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 293.6,
   "end": 297.92,
   "text": "به تقاص خون همه اهل بیت علیهم السلام توأسا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 297.92,
   "end": 300.58,
   "text": "این حالا این یک معنا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 300.58,
   "end": 307.16,
   "text": "و البته یه حدیث دیگه که بعد از همین شیخ صدوق میاره فرمود فهاء",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 307.16,
   "end": 312.08,
   "text": "فـ- فلهاء فهاد لخلقه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 312.08,
   "end": 315.74,
   "text": "حدیث بعدیه. یه وجه دیگه‌ش رو آقا میگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 315.74,
   "end": 318.98,
   "text": "بحث هدایتگری. هدایتگری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 318.98,
   "end": 324.58,
   "text": "خب بله کسی باید هدایتگر باشه، جلودار باشه که از اهدی نیست، اهدی نتونه بهش خدشه‌ای وارد کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 324.58,
   "end": 331.5,
   "text": "عصمت مطلقه داشته باشه. هیچکس نتونه اصلاً نه ترسی درش نه رعبی، نه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 331.5,
   "end": 333.3,
   "text": "فراری، نه عرض شود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 333.3,
   "end": 336.08,
   "text": "مثل باباش امیرالمؤمنین که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 336.08,
   "end": 341.04,
   "text": "زره نمی‌بست. هر وقتی هم می‌بست فقط",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 341.04,
   "end": 344.16,
   "text": "رو به فرمایش پیغمبر که حالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 344.16,
   "end": 348.38,
   "text": "دلسوزی می‌کرد برای آقا زره‌ش فقط رو سینه بود، پشتش نداشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 348.38,
   "end": 352.42,
   "text": "گفت آقا چرا شما پشتت، پشتت نداره زره شما پشت نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 352.42,
   "end": 355.22,
   "text": "می‌فرمايد چون من هیچ‌وقت پشت به دشمن نمی‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 355.22,
   "end": 357.98,
   "text": "برای چی پشت داشته باشم؟ دقت بفرمایید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 357.98,
   "end": 359.72,
   "text": "خب یه همچین کسی می‌تونه هادی باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 359.72,
   "end": 362.88,
   "text": "آقامون هم این چنینه. بعد چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 362.88,
   "end": 368.1,
   "text": "دال. دال امام رضا فرمود دین الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 368.1,
   "end": 380.89,
   "text": "دین که إن الدين عندالله الإسلام یعنی اصلاً الإسلام یعنی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 380.89,
   "end": 385.93,
   "text": "هُوَ التسليم الإسلام هُوَ چون امیرالمؤمنین فرمود می‌خوام برای شما بالا منبر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 385.93,
   "end": 389.99,
   "text": "طوری اسلام رو باز کنم که احدی نکرده و همین یه جمله رو فرمود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 389.99,
   "end": 395.69,
   "text": "عجیبه. فرمود الإسلام هُوَ التسلیم تمام شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 395.69,
   "end": 399.95,
   "text": "اگه تسلیمی مسلمانی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 399.95,
   "end": 406.49,
   "text": "حالا اینجا دین دین الله یعنی الإسلام یعنی همه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 406.49,
   "end": 409.69,
   "text": "اسلام همه دین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 409.69,
   "end": 411.69,
   "text": "همه پیش امام عصره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 411.69,
   "end": 414.23,
   "text": "یعنی اونچه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 414.23,
   "end": 420.13,
   "text": "به ارث از همه انبیا رسیده و از همه اولیا رسیده به یک پارچه دست ایشونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 420.13,
   "end": 426.79,
   "text": "و حرف آخرم یا. حیف شد که حالا اینو باید باز میشد هر کدومش ما دیگه تبرکاً رد میشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 426.79,
   "end": 429.33,
   "text": "یا به به، به به.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 429.33,
   "end": 432.65,
   "text": "يد الله که يد الله چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 432.65,
   "end": 439.07,
   "text": "فوق أيديهم. يد الله یعنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 439.07,
   "end": 442.11,
   "text": "يهدي الله بنوره من يشاء.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 442.11,
   "end": 447.33,
   "text": "تو سور آیه نور، آیه سی و پنج سوره نور که معروفه به آیه نور.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 447.33,
   "end": 452.63,
   "text": "یادتونه دیگه در شهادت امام عسکری ع پارسال بیانش کردیم و فضیلت خوندنشو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 452.63,
   "end": 455.09,
   "text": "گفتیم اگه کسی بتونه هر شب چهارده بار قبل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 455.09,
   "end": 459.21,
   "text": "خواب بخونه ببینه چه نوری میاد تو وجودش، زندگیش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 459.21,
   "end": 463.03,
   "text": "خیلی عجیبه چهارده بار قبل خواب بتونی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 463.03,
   "end": 465.61,
   "text": "مخصوصاً امام رضا عاشق این سور این آیه بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 465.61,
   "end": 467.81,
   "text": "کسی بتونه هر شب برای آقا بخونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 467.81,
   "end": 469.77,
   "text": "من هر شب که توفیق میشه می‌خونم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 469.77,
   "end": 475.81,
   "text": "حالا منقطع می‌خونم و متاسفانه توفیقم و هر شب و هر وقت خوندم دیدم این نور رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 475.81,
   "end": 479.63,
   "text": "مخصوصاً به نی به نیت امام رضا اگه بخونی عجیبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 479.63,
   "end": 483.55,
   "text": "چهارده بار قبل خواب. اونجا میگه يهدي الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 483.55,
   "end": 488.97,
   "text": "لنوره من يشاء این نوری که هرکیو خدا بخواد هدایت کنه با اوست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 488.97,
   "end": 492.89,
   "text": "منظور امام زمانه. در شأن نزولش یادتونه دیگه گفتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 492.89,
   "end": 500.53,
   "text": "اینجا هم همینه. او يا يد الله خدا دست هرکیو بخواد بگیره با این دست می‌گیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 500.53,
   "end": 504.17,
   "text": "خدایا دستمو بگیر باید امام عصر دستتو بگیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 504.17,
   "end": 505.87,
   "text": "او يد الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 505.87,
   "end": 509.21,
   "text": "والسلام. ان‌شاءالله که خدا همین قلیل رو از ما بپذیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 509.21,
   "end": 510.89,
   "text": "ذخیره قبر و قیامتمون بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 510.89,
   "end": 513.83,
   "text": "پدر مادرمون بهره ببرن از جلسه ما این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 513.83,
   "end": 520.89,
   "text": "صحبت‌های کوتاه ما ان‌شاءالله تا آماده بشید برای جشن و شما خیلی سریع بیاید جلو مجلسو گرم کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 520.89,
   "end": 523.35,
   "text": "بشکاف آقا خیلی وقته با هم شادی نکردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 523.35,
   "end": 526.03,
   "text": "والحمد لله رب العالمين. صلوات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}