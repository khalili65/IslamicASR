   "start": 48.92,
   "end": 221.76
  },
  {
   "index": 2,
   "title": "## نور علی نور؛ ملحقات؛ آغاز فصّ یوسفی",
   "start": 221.76,
   "end": 271.48
  },
  {
   "index": 3,
   "title": "شیخ اکبر ابتدای آن فصل چنین می‌آورد. نترسید؛ توضیحش می‌دهم:",
   "start": 271.48,
   "end": 294.14
  },
  {
   "index": 4,
   "title": "## وحی تشریعی و نبوت انبایی",
   "start": 294.14,
   "end": 390.7
  },
  {
   "index": 5,
   "title": "## لحظهٔ وصل؛ عنایت مشترک بزرگان",
   "start": 390.7,
   "end": 410.95
  },
  {
   "index": 6,
   "title": "## روایت عایشه؛ رؤیای صادقه همچون فلق صبح",
   "start": 410.95,
   "end": 545.1
  },
  {
   "index": 7,
   "title": "## قوهٔ خیال و عالم مثال",
   "start": 545.1,
   "end": 639.38
  },
  {
   "index": 8,
   "title": "## دیدن صورت اشخاص؛ القاء با واسطه",
   "start": 639.38,
   "end": 763.67
  },
  {
   "index": 9,
   "title": "## صوت و لفظ؛ تجلی بی‌واسطه",
   "start": 763.67,
   "end": 852.55
  },
  {
   "index": 10,
   "title": "## این نقطه، آغاز لقاءالله در همین نشئه",
   "start": 852.55,
   "end": 900.92
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.08,
   "end": 5.66,
   "text": "یا رب اعوذبک من همزات الشیاطین و من شر نفسی و من شر خلقک.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 5.66,
   "end": 8.28,
   "text": "بسم الله الرحمن الرحیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 8.28,
   "end": 12.2,
   "text": "لا حول و لا قوة الا بالله العلی العظیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 12.2,
   "end": 14.8,
   "text": "اللهم ایاک نعبد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 14.8,
   "end": 17.74,
   "text": "و ایاک نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 17.74,
   "end": 21.58,
   "text": "السلام علیک یا داعی الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 21.58,
   "end": 23.9,
   "text": "و ربانی آیات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 23.9,
   "end": 28.09,
   "text": "سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 28.09,
   "end": 33.54,
   "text": "چون فرصت خیلی کمه ما بیشتر به مناجات گذروندیم امشب رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 33.54,
   "end": 39.84,
   "text": "حق هم بود. خب ما این کتاب‌هایی که می‌بینید از هر کدومشون علامت زده بودیم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 39.84,
   "end": 46.24,
   "text": "سیر بحث لقاء الله رو از هر کدوم از این کتاب‌ها یه نکته‌ای عرض کنیم دیگه روزیمون نشد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 46.24,
   "end": 50.76,
   "text": "به جهت اینکه فرصت زیاده من الان این السلام علیک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 50.76,
   "end": 53.16,
   "text": "یا داعی الله و ربانی آیات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 53.16,
   "end": 59.68,
   "text": "اینو که گفتم همون لحظه توسل کردم آقا خودت به دل ما بنداز چه عرض کنیم تو این پنج دقیقه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 59.68,
   "end": 63.94,
   "text": "ما اینو به یادگار از اساتیدمون داریم به شما هم قبلاً عرض کردیم وقتی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 63.94,
   "end": 68.52,
   "text": "امام رو حجت خدا رو در هر مقامی سلام میدی، حجت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 68.52,
   "end": 72.98,
   "text": "خدا در همون مقام، همون لحظه به تو توجه می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 72.98,
   "end": 80.46,
   "text": "مثلاً شما می‌خوای نماز بخونی به حجت خدا میگی السلام علیک حین تصلی و تغنت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 80.46,
   "end": 86.28,
   "text": "می‌خوای استغفار کنی توبه کنی بگو السلام علیک حین تحمد و تستغفر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 86.28,
   "end": 88.72,
   "text": "می‌خوای منبر بری بیان معارف کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 88.72,
   "end": 93.54,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 93.54,
   "end": 97.02,
   "text": "آیات مقام پرورش آیات منبر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 97.02,
   "end": 101.68,
   "text": "و دعوت به حقه. لذا اینو که گفتم اون لحظه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 101.68,
   "end": 109.0,
   "text": "بالاخره تصویر این صفحه‌ای از کتاب شریف نور على نور علامه حسن زاده جلو چشمام اومد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 109.0,
   "end": 111.02,
   "text": "چشمام اون لحظه بسته بودند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 111.02,
   "end": 114.88,
   "text": "گفتم شاید القایی باشه که همین رو عرض کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 114.88,
   "end": 117.94,
   "text": "شاید برای همه ما عزیزان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 117.94,
   "end": 125.38,
   "text": "سؤال بشود که در مسیر سیر و سلوک حتی درک فیض لقاء",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 125.38,
   "end": 129.58,
   "text": "الله پیش از اینکه به اون لقاء الله با موت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 129.58,
   "end": 134.52,
   "text": "اجباری یا اختياري برسیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 134.52,
   "end": 139.96,
   "text": "برای اینکه انشاالله به موت اختیاری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 139.96,
   "end": 146.64,
   "text": "در همین نشئه طبیعت برسیم، اولین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 146.64,
   "end": 153.6,
   "text": "فیضان فیض الهی از اون چشمه فیاض علی الاطلاق چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 153.6,
   "end": 158.54,
   "text": "نشونه‌ش چیه؟ اولین فیض چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 158.54,
   "end": 161.5,
   "text": "اولین فیضی که شروع می‌شه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 161.5,
   "end": 164.44,
   "text": "وقتی بارقه‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 164.44,
   "end": 168.54,
   "text": "در وجود پیاده می‌شه، القاءات حضرت حق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 168.54,
   "end": 172.02,
   "text": "شروع می‌شه. نشانه‌ش چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 172.02,
   "end": 175.14,
   "text": "این که انسان بگه ادعا، ادعا که نه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 175.14,
   "end": 179.96,
   "text": "تو وجود خودش یقین حاصل کنه که شروع شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 179.96,
   "end": 182.54,
   "text": "مژده دهید، مژده دهید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 182.54,
   "end": 185.62,
   "text": "یار پسندید مرا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 185.62,
   "end": 189.78,
   "text": "این کجاست؟ این چگونه است؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 189.78,
   "end": 198.1,
   "text": "حسب ظاهر هیت میای زیارت میری نماز می‌خونی مسجد میره همه اینا قشنگ عالی سحر داری کسب معارف می‌کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 198.1,
   "end": 206.04,
   "text": "اما اونچه که در جواب این سؤال باید گفت رو اجازه بفرمایید که از کتاب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 206.04,
   "end": 209.37,
   "text": "نور على نور در ذکر ذاکر و مذکور",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 209.37,
   "end": 214.56,
   "text": "یادش بخیر خیلی از شما هنوز صورتاتون نور در نیاورده بود که ما این کتاب رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 214.56,
   "end": 218.46,
   "text": "براتون می‌آوردیم و رو منبرها می‌گفتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 218.46,
   "end": 225.58,
   "text": "خیلی سال‌های پیش صفحه دویست و نود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 225.58,
   "end": 227.76,
   "text": "اینجا در ملحقات،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 227.76,
   "end": 231.8,
   "text": "ملحقات، ملحقه صفحه پنجاه و نه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 231.8,
   "end": 237.48,
   "text": "حضرت استاد اشاره می‌کنند در جواب این سؤالی که بنده الان مطرح کردم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 237.48,
   "end": 242.4,
   "text": "اشاره می‌کنند به یک فرمایشی از شیخ اکبر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 242.4,
   "end": 245.06,
   "text": "محی الدین عربی علیه الرحمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 245.06,
   "end": 248.9,
   "text": "در اول فصل یوسفی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 248.9,
   "end": 254.12,
   "text": "خصوص الکرم ایشون رو که توضیح دادیم براتون از سنگین‌ترین کتاب‌های",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 254.12,
   "end": 262.5,
   "text": "عرفانی بودن. اینچنین ابتدای اون فصل شیخ اکبر میاره که حال هل حكمة النوریه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 262.5,
   "end": 266.88,
   "text": "انبساط نورها على خبرة الخيال.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 266.88,
   "end": 269.48,
   "text": "نترسید حالا اینو توضیحش میدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 269.48,
   "end": 272.92,
   "text": "و هو اول، اول دقت بفرمایید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 272.92,
   "end": 275.44,
   "text": "و هو اول",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 275.44,
   "end": 279.12,
   "text": "مباد الوحي الالهی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 279.12,
   "end": 284.7,
   "text": "فی اهل العنایه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 284.7,
   "end": 291.42,
   "text": "این اولین مبادی جنسش از وحی الهیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 291.42,
   "end": 294.14,
   "text": "برای کسی که مورد عنایت حضرت حق واقع شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 294.14,
   "end": 297.78,
   "text": "وحی هم به صورت تشریعی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 297.78,
   "end": 303.38,
   "text": "برای نبی تشریعی، نبوت تشریعیه که خاتم داشت تمام شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 303.38,
   "end": 310.2,
   "text": "اما از جنس وحی به صورت نبوت انبایی یا تعریفی یا عامه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 310.2,
   "end": 317.46,
   "text": "نبوت عامه. یعنی باخبر شدن از حقایق عالم درش بسته نشده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 317.46,
   "end": 320.42,
   "text": "یعنی عرض کردیم قبلاً همه ما می‌تونیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 320.42,
   "end": 323.72,
   "text": "نبی باشیم. نبع",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 323.72,
   "end": 326.26,
   "text": "خبر. نبی. نابع.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 326.26,
   "end": 330.54,
   "text": "نبی می‌شه شدتش به شدت باخبر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 330.54,
   "end": 332.88,
   "text": "عما يتساءلون عن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 332.88,
   "end": 336.56,
   "text": "نبع العظيم. اون نبع خبر عظیم مولا علی بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 336.56,
   "end": 340.0,
   "text": "ولایت کلیه بود. حالا هرکس در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 340.0,
   "end": 346.44,
   "text": "صیعه وجودی خودش به هر میزان که از ولایت بهره گرفت باخبر شده از عالم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 346.44,
   "end": 350.28,
   "text": "حالا این باخبر شدن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 350.28,
   "end": 353.62,
   "text": "این دقت بفرمایید یا به یک معنا در سوق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 353.62,
   "end": 360.44,
   "text": "نفس ناطقه شما یعنی در اون کمون ذاتت، در اون بطنان وجودت، در اون مکمن غیبت، در اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 360.44,
   "end": 363.44,
   "text": "پنهانی‌ترین محل در وجودت دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 363.44,
   "end": 370.86,
   "text": "اون ذات وجودیت که تو یک چیزی رو می‌چشی، می‌فهمی، درک می‌کنی که حضرت علامه از این به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 370.86,
   "end": 374.62,
   "text": "نزول ملک بر تو یاد می‌کنند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 374.62,
   "end": 376.56,
   "text": "و می‌گن این یعنی نزول ملک.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 376.56,
   "end": 380.36,
   "text": "که تو از ملکوت نظام هستی تلقی حقیقت کردی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 380.36,
   "end": 384.62,
   "text": "این جنسش از وحیه. لکن وحی انباییه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 384.62,
   "end": 388.34,
   "text": "نبوت انباییه. باخبر شدن از حقایق عالم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 388.34,
   "end": 390.58,
   "text": "شما هم می‌تونید الان دارید باخبر می‌شید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 390.58,
   "end": 395.18,
   "text": "خب حالا این لحظه اولینش چگونه است؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 395.18,
   "end": 402.32,
   "text": "یعنی لحظه‌ای که انسان متوجه می‌شه به یک معنا خودمونی بگیم سیمش وصل شد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 402.32,
   "end": 410.95,
   "text": "شروع شد. و جالبه که بدونید تمام بزرگان یعنی من تا صبح اینجا بشینم به فضل الهی براتون میگم یک یک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 410.95,
   "end": 416.42,
   "text": "که شما یه زمانی با هم جلسه‌ای داشتیم حالات بزرگان رو از کتاب‌هاشون با هم مرور می‌کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 416.42,
   "end": 423.58,
   "text": "کدوم عالم چه این اتفاق براش افتاد و تا آخر عمرش فرمود هرچی دارم از اون عنایته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 423.58,
   "end": 428.8,
   "text": "از خود علامه حسن زاده بگیر تا بزرگان مثل حاج ملا حسین قلی همه دنیا دیگران.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 428.8,
   "end": 434.86,
   "text": "خود آقای بهجت دارن. اساتید ما بسیار برا ما گفتن آقای حداد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 434.86,
   "end": 437.44,
   "text": "حالا، ایشون می‌فرمایند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 437.44,
   "end": 442.5,
   "text": "که این انبساط نورها علی خبرت الخيال.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 442.5,
   "end": 450.52,
   "text": "به به، به به. اجازه میدید که اصلا ترجمه‌شو، ترجمه خود حضرت استادو براتون بخونم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 450.52,
   "end": 456.98,
   "text": "ترجمه همین عبارت عربی رو که البته ادامه داشت چون وقتی‌ست دیگه همین ترجمه‌شو بخونم خودتون متوجه می‌شید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 456.98,
   "end": 459.98,
   "text": "\"این حکمت نوریه عبارت است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 459.98,
   "end": 463.08,
   "text": "از انبساط نور",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 463.08,
   "end": 468.81,
   "text": "کلمه‌ی یوسفیه\"، یوسفیه چون مرو فص یوسفیه بود،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 468.81,
   "end": 478.06,
   "text": "\"بر حضرت خیال و این انبساط اولین ظهور مبادی وحی الهی‌ست در اهل عنایت\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 478.06,
   "end": 480.76,
   "text": "که البته اینجا می‌فرماید انبیا هستند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 480.76,
   "end": 482.86,
   "text": "می‌شه انبیا تشریعی باشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 482.86,
   "end": 486.48,
   "text": "می‌شه انبیا به نبوت انبایی باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 486.48,
   "end": 488.6,
   "text": "بعد ایشون تصریح می‌کنند،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 488.6,
   "end": 491.44,
   "text": "مثال میارن روایت رو از،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 491.44,
   "end": 495.98,
   "text": "اه، عرض شود اهل تسنن که عایشه گوید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 495.98,
   "end": 500.22,
   "text": "اول چیزی که برای رسول الله آشکار شد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 500.22,
   "end": 503.04,
   "text": "و پیغمبر بدان آغاز کرد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 503.04,
   "end": 505.66,
   "text": "رؤیای صادقه بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 505.66,
   "end": 513.42,
   "text": "پس رسول الله نمی‌دید رؤیایی را مگر اینکه آن رویا به طور آشکار در حس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 513.42,
   "end": 516.9,
   "text": "ظاهر می‌شد مثل سفیدی صبح",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 516.9,
   "end": 521.94,
   "text": "که گویی هیچ خفایی در آن نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 521.94,
   "end": 532.1,
   "text": "خلاصه کسی که در مسیر لقاء الله که بیش از پنجاه جلسه درباره‌ش صحبت کردیم که بچشه، استیاد کنه حقیقت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 532.1,
   "end": 534.74,
   "text": "الوهیت اله عالم رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 534.74,
   "end": 539.78,
   "text": "در این نظام هستی، از اینجا جرقه‌ش شروع می‌شه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 539.78,
   "end": 545.1,
   "text": "که رؤیاهای صادقه می‌بینه در قوه خیالش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 545.1,
   "end": 549.44,
   "text": "ما گفتیم قوه خیال جنسش از عالم مثاله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 549.44,
   "end": 553.52,
   "text": "مثال متصل داریم در خود ما، منفصل بیرون از ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 553.52,
   "end": 557.4,
   "text": "اینکه در خود ماست ما وقتی می‌خوابیم در اون عالم داریم سیر می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 557.4,
   "end": 559.04,
   "text": "همون قوه خیاله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 559.04,
   "end": 566.12,
   "text": "وقتی این قوه خیال پاک شد از متخیلات فاسده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 566.12,
   "end": 569.18,
   "text": "خودمونی بگم از افکار زشت و پلید،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 569.18,
   "end": 579.04,
   "text": "چه اتفاقی می‌افته؟ مثل اون صبح روشن که الان اینجا می‌فرمود که قشنگ سفیدی آشکاره تو قوه خیالت سفیدی می‌بینی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 579.04,
   "end": 582.12,
   "text": "نور می‌بینی، جمال و جلال می‌بینی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 582.12,
   "end": 584.14,
   "text": "مسجد و هیئت می‌بینی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 584.14,
   "end": 587.0,
   "text": "می‌خوابی هم تو هیئتی روضه می‌خونی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 587.0,
   "end": 590.08,
   "text": "دل و تس-تسبیح و سجاده می‌بینی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 590.08,
   "end": 594.1,
   "text": "یا مشغول عبادتی یا عبادت کننده می‌بینی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 594.1,
   "end": 596.52,
   "text": "یا عالمی یا عالم می‌بینی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 596.52,
   "end": 598.34,
   "text": "یا مؤمنی یا مؤمن می‌بینی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 598.34,
   "end": 601.24,
   "text": "نور می‌بینی و نور در خوابت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 601.24,
   "end": 608.32,
   "text": "این اولشه. لذا بزرگان فرمودند ما می‌خوابیم تا خواب ببینیم اصلا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 608.32,
   "end": 611.62,
   "text": "اونایی که در بحث‌ها بودند الان باید بگن یعنی چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 611.62,
   "end": 614.12,
   "text": "برای چی خواب ببینم؟ راحت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 614.12,
   "end": 616.08,
   "text": "به قول حضرت استاد فرمودند چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 616.08,
   "end": 623.7,
   "text": "آنچه که مطلقا در خواب می‌بینی انشائات نفس ناطقه خودت است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 623.7,
   "end": 625.9,
   "text": "چرا این سوبره اشکال رو دیدی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 625.9,
   "end": 628.84,
   "text": "چون با اینا مش-- محشوری، معنوسی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 628.84,
   "end": 631.84,
   "text": "کسی که انس با حقیقت عالم داره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 631.84,
   "end": 635.52,
   "text": "در نشئه برزخ وجودیش هم وقتی می‌خوابه می‌ره اونجا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 635.52,
   "end": 639.2,
   "text": "اونجا هم چی می‌بینه؟ همین حقیق-حقایق رو می‌بینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 639.2,
   "end": 642.77,
   "text": "حالا یکی از بچه‌ها اومده بود منو گفت حاجی من خواب شما رو خیلی می‌بینم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 642.77,
   "end": 645.62,
   "text": "الان همینجا نشسته یه جوری ما رو نگاه می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 645.62,
   "end": 647.94,
   "text": "هفته‌ای دو سه بار شما رو خواب می‌بینم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 647.94,
   "end": 655.48,
   "text": "این حقایقی‌ست. الا از بنده در کسوت عالم دینم اگرچه جاهلم و به واقع نیستم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 655.48,
   "end": 659.88,
   "text": "اما در کس-- از نگاه ایشون به حسن ظن ایشون هستم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 659.88,
   "end": 665.66,
   "text": "از نگاه خودم نه. جایی که عقاب پر بریزد از پشه لاغری چه خیزد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 665.66,
   "end": 668.78,
   "text": "می‌خوام به ایشون و امثال ایشون بگم چرا شما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 668.78,
   "end": 672.82,
   "text": "من نفس مثلا علی اکبر بیات نه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 672.82,
   "end": 677.6,
   "text": "چرا یک عمامه به سر رو در خواب می‌بینی و دیدی هر هفته چند بار؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 677.6,
   "end": 680.04,
   "text": "این یعنی چی؟ داره القاءات صورت می‌گیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 680.04,
   "end": 687.52,
   "text": "تو حقایقی داره از جنس حقیقت بر شما نازل می‌شه، تنزل پیدا می‌کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 687.52,
   "end": 694.46,
   "text": "که این‌ها پشت پرده باید عبور کنی، تعبیر، عبور کنی به اون پیامی برسی که خدا از این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 694.46,
   "end": 697.64,
   "text": "صورت و شکل داره به شما در قوه خیالت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 697.64,
   "end": 701.08,
   "text": "در عالم برزخ وجودیت که خوابه به شما می‌رسونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 701.08,
   "end": 703.02,
   "text": "پیامش چیه؟ اوه، اوه، اوه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 703.02,
   "end": 708.64,
   "text": "دیگه شصت، هفتاد تا منبر باید بریم تا ببینیم اصلا پیام‌ها چگونه باید عبور کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 708.64,
   "end": 711.86,
   "text": "عبور، عبور. مثلا آب در این نشئه همین آبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 711.86,
   "end": 714.88,
   "text": "در نشئه بر مثال آب چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 714.88,
   "end": 717.12,
   "text": "در نشئه عقل آب چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 717.12,
   "end": 720.38,
   "text": "در الوهیت نظام هستی آب چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 720.38,
   "end": 724.0,
   "text": "برنج اینجا اینه. تو عالم خواب یعنی مثال چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 724.0,
   "end": 729.59,
   "text": "در عالم عقول چیه؟ بالا، بالا دست اون در عالم قلب چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 729.59,
   "end": 735.43,
   "text": "آسمان، زمین. همه این‌ها بزرگان گفتن ما علمش رو نداریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 735.43,
   "end": 738.41,
   "text": "بعد اینا رو باید تعبیر کنی که علامه فرمودن--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 738.41,
   "end": 741.77,
   "text": "خط میکردم. فرمودن اگر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 741.77,
   "end": 751.93,
   "text": "صورت اشخاص و افراد ببینی در خواب القاءات و پیام‌های حضرت حق به تو رسیده با واسطه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 751.93,
   "end": 760.31,
   "text": "یعنی آقایی که چهره یه آخوندو در خواب دیده هی می‌بینه، هی می‌بینه داره پیام دریافت می‌کنه از خدا اما با واسطه‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 760.31,
   "end": 763.67,
   "text": "یعنی مقامش پایینه این شخص هنوز.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 763.67,
   "end": 769.79,
   "text": "اما کسی که صوت و لفظ دریافت می‌کنه نه صورت و شکل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 769.79,
   "end": 773.03,
   "text": "صوت و لفظ دیگه بی واسطه‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 773.03,
   "end": 778.77,
   "text": "جزو تجلیات الهیه در ثغ نفس سالک الی الله بی واسطه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 778.77,
   "end": 781.95,
   "text": "یعنی خدا مستقیم با تو سخن گفته مثل قرآن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 781.95,
   "end": 784.01,
   "text": "قرآن لفظه دیگه صوته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 784.01,
   "end": 790.89,
   "text": "قر-- حضرت پیغمبر عظیم الشأن اسلام \"إنك لَتلقى القرآن من لدن حكيم عليم\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 790.89,
   "end": 795.77,
   "text": "بی واسطه تلقی کرد لذا لفظه، صوته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 795.77,
   "end": 802.11,
   "text": "بدون صور و اشکاله. لذا اصلاً مثل اون صبح روشن که الان اینجا فرمود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 802.11,
   "end": 806.91,
   "text": "محی الدین عربی میگه مثل صبح روشن، خواب روشنه، زلاله،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 806.91,
   "end": 810.06,
   "text": "نور محضه. هیچ کس و هیچ چی رو نمی‌بینی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 810.06,
   "end": 813.37,
   "text": "این نشون میده قوه خیال خیلی پاک شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 813.37,
   "end": 817.27,
   "text": "هیچی نمی‌بینی. خیلی به سمت عقل حرکت کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 817.27,
   "end": 819.81,
   "text": "قوه خیال جنسش عقلانی شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 819.81,
   "end": 824.23,
   "text": "کلیه، نور مطلقه. ولی لفظ می‌شنوی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 824.23,
   "end": 829.03,
   "text": "یا لفظ، صوت می‌بینی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 829.03,
   "end": 832.39,
   "text": "اون دیگه خیلی-- اون پیام‌ها اونا دیگه عالیه، عالیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 832.39,
   "end": 839.99,
   "text": "اونا دیگه صادقه صادقه، مبشره صادقه‌ست که اون رو مطمئن باش برات پیاده می‌شه، محقق می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 839.99,
   "end": 845.87,
   "text": "یا فردا یا چهل سال دیگه نسبت به صعه‌ی وجودیت که لایه‌های پایین برزخ اینو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 845.87,
   "end": 849.43,
   "text": "گرفتی فردا می‌بینیش، می‌شنویش، اتفاق میفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 849.43,
   "end": 852.55,
   "text": "اگر خیلی بالا رفته باشی چهل سال بعد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 852.55,
   "end": 861.35,
   "text": "خلاصه مطلب چی؟ کسی که این براش اتفاق افتاد شروع لقاء اللهشه تو همین نشئه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 861.35,
   "end": 867.43,
   "text": "یعنی امشب موشک هیئت ما، موشک منبر ما زد اون نقطه‌ای رو که پنجاه جلسه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 867.43,
   "end": 872.03,
   "text": "شصت جلسه باید حرف می‌زدیم تا بتونیم بزنیمش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 872.03,
   "end": 876.61,
   "text": "اینو یادتون نره. تو این چند دقیقه خیلی مهم البته می‌خواستیم یه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 876.61,
   "end": 880.77,
   "text": "چهل دقیقه مفصل دربارش حرف بزنیم با منابع و موآخذی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 880.77,
   "end": 883.97,
   "text": "کتاب‌ها رو اینجا، علممونم آوردیم اینجا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 883.97,
   "end": 888.51,
   "text": "يحمل أسفارا. ولی خوب نشد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 888.51,
   "end": 890.29,
   "text": "از استاد عزیزم عذرخواهی می‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 890.29,
   "end": 894.25,
   "text": "جسارت کردم. غلط‌گیری کنن انشاالله از ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 894.25,
   "end": 896.31,
   "text": "والحمد لله رب العالمين.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 896.31,
   "end": 900.92,
   "text": "صلوات ختم کنید. اللهم صل علی محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}