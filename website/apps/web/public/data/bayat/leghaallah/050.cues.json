 "cues": [
  {
   "i": 0,
   "start": 0.18,
   "end": 2.92,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 2.92,
   "end": 7.66,
   "text": "السلام علیک یا داعی الله و ربانی آیاته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 7.66,
   "end": 10.22,
   "text": "السلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 10.22,
   "end": 13.34,
   "text": "جلسه پیش ما عرض کردیم در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 13.34,
   "end": 16.46,
   "text": "سیر بحث لقاء الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 16.46,
   "end": 19.98,
   "text": "گفتیم که این لقاء با دیده عقلی رخ میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 19.98,
   "end": 23.86,
   "text": "یعنی ما با نور عقل به ملاقات حضرت حق میریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 23.86,
   "end": 30.5,
   "text": "بعد توضیح دادیم که عده‌ای معتقدند مثل مشاء",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 30.5,
   "end": 36.64,
   "text": "متقدمین البته از مشاء معتق-- معتقدند به تربیع و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 36.64,
   "end": 39.18,
   "text": "چهارگانه بودن ادراک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 39.18,
   "end": 43.3,
   "text": "که از حس به خیال و وهم بعد عقل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 43.3,
   "end": 46.6,
   "text": "می‌رسیدند. اما عرفا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 46.6,
   "end": 51.58,
   "text": "اهل عرفان به قول حضرت استاد علامه حسن زاده علیه الرحمه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 51.58,
   "end": 53.86,
   "text": "اینا قائل به چی‌اند؟ تثلیث‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 53.86,
   "end": 57.14,
   "text": "تثلیثی‌اند. ثلث، سه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 57.14,
   "end": 60.9,
   "text": "این‌ها سه گانه، سه گانه می‌دونن ادراک رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 60.9,
   "end": 65.68,
   "text": "از حوزه احساس، همین طبیعت، حواس پنجگانه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 65.68,
   "end": 68.38,
   "text": "بعد قوه خیال،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 68.38,
   "end": 70.74,
   "text": "بعد وهم و عقل رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 70.74,
   "end": 74.08,
   "text": "از یک جنس و یک سنخ می‌دونن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 74.08,
   "end": 81.76,
   "text": "و اون‌ها در حقیقت وهم رو عقل ساقط شده می‌دونستند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 81.76,
   "end": 86.12,
   "text": "اینکه کسی بخواد حالا بره تحقیق کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 86.12,
   "end": 89.3,
   "text": "من کتاب هزار و یک نکته رو خواستم بیارم از رو بخونم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 89.3,
   "end": 92.42,
   "text": "خیلی عجله‌ای اومدم پیداش نکردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 92.42,
   "end": 100.2,
   "text": "در خواستید رجوع کنید نکته پونصد و پنجاه هزار و یک نکته حضرت استاد رو ببینید یک مجموعه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 100.2,
   "end": 104.26,
   "text": "جالب و چکیده و ذبده‌ای از نظرات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 104.26,
   "end": 109.94,
   "text": "عرفا و حکما و پیرامون همین قصه رو ایشون آورده حتی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 109.94,
   "end": 116.22,
   "text": "مثلا گفته چند جا و کجا‌ها ملاصدرا در اسفار مثلا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 116.22,
   "end": 119.8,
   "text": "تثلیث رو بیان کرده یا مثلا مرحوم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 119.8,
   "end": 125.12,
   "text": "میر ایشون مثلا کجا گفته که حالا اونجا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 125.12,
   "end": 132.72,
   "text": "که اصلش اون اول عرض کردم اولین کسی که یه چرخشی می‌کنه و از تربیع به تثلیث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 132.72,
   "end": 137.74,
   "text": "می‌رسه و بیان می‌کنه مرحوم شیخ الرئیسه در نمت سوم اشارات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 137.74,
   "end": 140.72,
   "text": "من فکر می‌کنم جلسه پیش گفتم شیخ الرئیس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 140.72,
   "end": 144.0,
   "text": "اما اینکه کجا این رو نقد کرده بهتون نگفتم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 144.0,
   "end": 147.46,
   "text": "نمت سوم اشارات رو حالا باز من",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 147.46,
   "end": 149.58,
   "text": "اشارات رو می‌خواستم بیارم اینجا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 149.58,
   "end": 152.94,
   "text": "که دوستان بعد منبر ببینن باز متاسفانه فراموشم شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 152.94,
   "end": 156.22,
   "text": "انشاالله جلسه بعد. مثلا مرحوم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 156.22,
   "end": 167.32,
   "text": "میر در شجراتش در جذباتش اونجا این رو به هم تثلیث رو میاره توضیح میده و عرض شود چند جا ملاصدرا بحث تثلیث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 167.32,
   "end": 169.28,
   "text": "رو میاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 169.28,
   "end": 178.06,
   "text": "جلسه صد و هفتاد و دو شرح فصوص رو که مرحوم قیصری فصوص ابن عربی رو شرح میده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 178.06,
   "end": 187.2,
   "text": "اونجا شرحی که حضرت استاد علامه حسن زاده بر شرح قیصری داره که کتابش هم به نام ممت الهمن بیرون اومده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 187.2,
   "end": 195.62,
   "text": "در جلسه صوتی صد و هفتاد و دویش می‌تونید این رو مبسوط بشنوید که استاد همین رو باز کرده و توضیح داده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 195.62,
   "end": 202.56,
   "text": "و کجای خود فصوص شرح قیصری بر فصوص می‌تونید ببینید به قلم خود قیصری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 202.56,
   "end": 204.88,
   "text": "یکی در فصل آدمیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 204.88,
   "end": 212.02,
   "text": "در فصل آدمی مرحوم قیصری در ش-- بر شرح بر فصوصش این رو همین بحث تثلیث رو آورده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 212.02,
   "end": 214.8,
   "text": "یکی هم در فصل الیاسی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 214.8,
   "end": 223.38,
   "text": "اون کتابای فصوص قدیمی چهارصد و شصت این حدودا صفحه‌اش این حدودا میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 223.38,
   "end": 225.46,
   "text": "جدیدا رو نمی‌دونم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 225.46,
   "end": 228.48,
   "text": "به هر حال اینجاها می‌تونید شما این‌ها رو ببینید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 228.48,
   "end": 231.68,
   "text": "مثلا به عنوان نمونه یه بخشی از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 231.68,
   "end": 240.5,
   "text": "کلام و قلم مرحوم علامه قیصری بر فصوص رو براتون بخونم که ایشون در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 240.5,
   "end": 247.02,
   "text": "همین موضوع که وهم جنسش از عقله این چنین فرموده که ولکن ان وی بخشیشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 247.02,
   "end": 251.14,
   "text": "ولکن انه نورا من انوار العقل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 251.14,
   "end": 258.72,
   "text": "داره توضیح میده که این چیزی که من می‌خوام به شما امشب معرفی کنم امروز نوری‌ست از انوار عقل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 258.72,
   "end": 262.54,
   "text": "کدوم عقل؟ العقل الكلی المنزله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 262.54,
   "end": 265.24,
   "text": "حالا می‌تونید المنزل هم بخونید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 265.24,
   "end": 269.34,
   "text": "الى العالم السفلی مع الروح الانسانی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 269.34,
   "end": 272.0,
   "text": "که نازل شده به اتفاق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 272.0,
   "end": 273.58,
   "text": "روح انسانی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 273.58,
   "end": 275.4,
   "text": "نازل شده در این نشئه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 275.4,
   "end": 279.14,
   "text": "فصغر وضعف کوچک شده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 279.14,
   "end": 282.24,
   "text": "ضعیف شده. چی؟ نوریتہ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 282.24,
   "end": 288.74,
   "text": "و ادراکہ لبعد من منبع الانوار العقليه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 288.74,
   "end": 291.42,
   "text": "از اون منبع نور عقل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 291.42,
   "end": 294.64,
   "text": "این به جهت دور شدنش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 294.64,
   "end": 296.6,
   "text": "چی شده؟ ضعیف شده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 296.6,
   "end": 301.94,
   "text": "کوچیک شده. لذا فتح سما بالوهم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 301.94,
   "end": 304.5,
   "text": "فتح سما به چی؟ بالوهم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 304.5,
   "end": 306.88,
   "text": "لذا اسم گرفته به وهم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 306.88,
   "end": 309.4,
   "text": "اینجا داره چیو تصریح می‌کنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 309.4,
   "end": 312.56,
   "text": "که وهم چیه؟ نوری از انوار عقله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 312.56,
   "end": 316.48,
   "text": "از اون عقل کلی. حالا بقیه‌ش هم شیرینه بخونیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 316.48,
   "end": 323.82,
   "text": "فإذا رجع تنور بحسب اعتدال المزاج الانساني.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 323.82,
   "end": 328.18,
   "text": "یه زمانی چقدر ما پیرامون مزاج انسانی حرف زدیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 328.18,
   "end": 332.08,
   "text": "که این شدت نورش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 332.08,
   "end": 336.96,
   "text": "حالا تو یکی خیلی ضعیفه وهمش میاد خیال گونه میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 336.96,
   "end": 341.06,
   "text": "تو یکی هم خیلی شدیده میره عقل، عقل میشه اصلاً وهم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 341.06,
   "end": 345.04,
   "text": "چرا؟ می‌فرماید بحسب اعتدال المزاج الانساني.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 345.04,
   "end": 347.54,
   "text": "همش بر می‌گرده به اون مزاجشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 347.54,
   "end": 350.58,
   "text": "کس که خیلی شدت می‌گیره اعتدال مزاج داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 350.58,
   "end": 356.76,
   "text": "وقتی اعدل هم زج شد اصلاً وهمش عین عقله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 356.76,
   "end": 360.7,
   "text": "قوی ادراکه. این وقتی اینطور شد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 360.7,
   "end": 363.8,
   "text": "وقتی اعتدال مزاج پیدا کرد انسان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 363.8,
   "end": 367.22,
   "text": "قوی ادراکه ادراکش قوی میشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 367.22,
   "end": 370.59,
   "text": "و صار عقلا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 370.59,
   "end": 373.47,
   "text": "و صار عقلاً من العقول",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 373.47,
   "end": 377.43,
   "text": "هی عقلش و عقل حتی عقلش هم شدت میگیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 377.43,
   "end": 383.73,
   "text": "كذلِك يترقّى العقلُ تا جایی که ترقی پیدا میکنه عقلش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 383.73,
   "end": 390.14,
   "text": "كذلِك يترقّى العقلُ إذاً ويسير عقلًا مستفادا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 390.14,
   "end": 395.87,
   "text": "به به، به یعنی کار به جایی میکشه دیگه اعدل امزجه میشه، میشه عقل مستفاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 395.87,
   "end": 399.69,
   "text": "یادش بخیر تو غروبای جمعه حرم حضرت عبد--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 399.69,
   "end": 403.33,
   "text": "حضرت امامزاده صالح فرحزاد که بودیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 403.33,
   "end": 408.57,
   "text": "اونجا بعد قبل علی سین اونجا سیر عقول رو گفتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 408.57,
   "end": 419.09,
   "text": "اگه یادتون باشه که عقل حیوا بالحیولا یا هیولایی که ابتدا همون عقلی که دیگه ابتدایی‌ترین حالته در انسان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 419.09,
   "end": 422.15,
   "text": "هیولا چرا بهش میگن؟ ناشناخته‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 422.15,
   "end": 424.93,
   "text": "یعنی خیلی مثلا ترسناکه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 424.93,
   "end": 427.61,
   "text": "مثل جنین انسان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 427.61,
   "end": 432.67,
   "text": "دیدید چقدر آدم میبینه یه حالتی بهش دست میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 432.67,
   "end": 435.23,
   "text": "عقل هیولا است. بعد عقل بالملکه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 435.23,
   "end": 437.13,
   "text": "بل بعد عقل فعاله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 437.13,
   "end": 439.39,
   "text": "بعد میشه عقل مستفاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 439.39,
   "end": 442.07,
   "text": "عقل مستفاد چی میشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 442.07,
   "end": 444.83,
   "text": "بر اثر چی؟ اعدل امزجه انسان به اونجا میرسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 444.83,
   "end": 457.31,
   "text": "چه حالتیه؟ حالتیه که در لوح نفس صاحب عقل مستفاد تمام حقایق مندرجن، مندمجن، متنقشن به نقوش نوریشون،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 457.31,
   "end": 459.57,
   "text": "به، به وجود نوریشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 459.57,
   "end": 462.93,
   "text": "یعنی این میشه چی؟ جمع الجمع.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 462.93,
   "end": 468.17,
   "text": "میشه مقام جمعی. همه و همه حقایق در-- میشن شعنی از وجود او.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 468.17,
   "end": 470.47,
   "text": "حتی شما هم یک شأن از شؤون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 470.47,
   "end": 473.93,
   "text": "وجودی صاحب عقل مستفاد میشی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 473.93,
   "end": 478.39,
   "text": "که انسان کامله. حالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 478.39,
   "end": 482.35,
   "text": "انسان میشه مستفید و حقیقت عالم مفید و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 482.35,
   "end": 485.53,
   "text": "اون صور علمیه هم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 485.53,
   "end": 488.37,
   "text": "مستفادن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 488.37,
   "end": 491.39,
   "text": "حالا بعد میخواستیم بعد از این بیاییم ورجـ--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 491.39,
   "end": 495.41,
   "text": "ورود کنیم به بحث امشبمون پیرامون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 495.41,
   "end": 499.87,
   "text": "عرض شود خدمتتون روایت بسیار،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 499.87,
   "end": 502.49,
   "text": "بسیار شیرین و عرشی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 502.49,
   "end": 504.61,
   "text": "روایت علمیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 504.61,
   "end": 507.35,
   "text": "خود ملا محسن فیض از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 507.35,
   "end": 513.43,
   "text": "بحث لقاء الله که ایشون نظرشون پیرامون لقاء الله، ملا محسن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 513.43,
   "end": 519.23,
   "text": "بله، ملا محسن فیض کاشانی، برجسته‌ترین شاگرد ملا صدرا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 519.23,
   "end": 523.01,
   "text": "چقدر حضرت علامه از ایشون به عظمت یاد میکنه و چقدر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 523.01,
   "end": 529.21,
   "text": "توصیه میکنه کتابای ایشون رو علم اليقين و حق اليقين و عين اليقينش و اینا رو بخونید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 529.21,
   "end": 533.87,
   "text": "که الان توی سه جلد کتاب بود، الان تو یک جلد چاپ شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 533.87,
   "end": 536.51,
   "text": "خیلی کتاب‌های شیرین .",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 536.51,
   "end": 538.97,
   "text": "ما بچه که بودیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 538.97,
   "end": 541.95,
   "text": "ایناها رو یادمه که خوندیم با همدیگه تو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 541.95,
   "end": 546.67,
   "text": "هیئت قبلی. خیلی کتاب‌های شیرین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 546.67,
   "end": 553.81,
   "text": "انشاالله رجوع میکنیم ببینیم نظر این بزرگوار از لقاء الله چیه به جهت تأکید حضرت استاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 553.81,
   "end": 556.81,
   "text": "که بعد میبینیم عجب! چه جالب!",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 556.81,
   "end": 566.21,
   "text": "یک مخلصی، یک ذبده‌ای، یک چکیده‌ای‌ست از آنچه که ما تو این همه جلسات تا حالا از لقاء الله گفتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 566.21,
   "end": 573.87,
   "text": "نظر ملا محسن. حتما از اینجا به بعد رو وقتی ورود میکنیم به نظر ملا محسن پیرامون لقاء الله رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 573.87,
   "end": 576.51,
   "text": "حتما باشید. نبودید هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 576.51,
   "end": 579.33,
   "text": "وویسش رو اگر انشاالله قیام امام عصر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 579.33,
   "end": 582.09,
   "text": "وارد شد بر کانال هیئت، وویسش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 582.09,
   "end": 584.19,
   "text": "شما ببینید، گوش بدید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 584.19,
   "end": 589.89,
   "text": "خوب به دردتون میخوره. یک مخلصی‌ست از آنچه که تا حالا ما گفتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 589.89,
   "end": 592.45,
   "text": "خیلی شیرین و خوب که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 592.45,
   "end": 595.09,
   "text": "مخصوصاً پیرامون نگاه ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 595.09,
   "end": 597.83,
   "text": "حالا ای کاش که امشب فرصت می‌کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 597.83,
   "end": 602.27,
   "text": "چه کنیم حالا روزمون هم بد نبود اما فرصت می‌کردیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 602.27,
   "end": 604.73,
   "text": "حداقل یه نیم نگاهی به این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 604.73,
   "end": 608.15,
   "text": "فرمایش می‌کردیم. بعد متوجه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 608.15,
   "end": 610.87,
   "text": "اهمیت این مباحث میشدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 610.87,
   "end": 614.43,
   "text": "قابل توجه اون‌هایی که خیلی شاید به این مباحث دل ندن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 614.43,
   "end": 619.63,
   "text": "بعد می‌بینید که شما رو این مباحث انشاالله که ورزش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 619.63,
   "end": 627.84,
   "text": "فکریتون بده و از ملکوت استیعد کنید حقیقت رو از شرک به وحدت میره، به توحید میرسونه این مباحث.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 627.84,
   "end": 633.15,
   "text": "می‌بینید که واقعاً این مباحث از نون شب برای من و شما واجب‌تره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 633.15,
   "end": 637.49,
   "text": "هی بشینیم داستان و قصه و حکایت، اونام خوبه در صورتی که بیاد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 637.49,
   "end": 640.91,
   "text": "کنار این‌ها قرار بگیره، این‌ها رو بپرورونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 640.91,
   "end": 644.85,
   "text": "این‌ها رو چیکار کنه؟ بپرورانه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 644.85,
   "end": 647.73,
   "text": "این مباحث و اون داستان‌ها و حکایت‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 647.73,
   "end": 650.41,
   "text": "عزیز دلم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 650.41,
   "end": 653.45,
   "text": "بحث نگاه ما،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 653.45,
   "end": 661.87,
   "text": "خوب دقت کنید این ختم کلام رو، نگاه ما به کثرت و وحدت در کنار هم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 661.87,
   "end": 666.25,
   "text": "یه بحث بسیار مهمیه که ارتباط لقاء الله با اون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 666.25,
   "end": 668.19,
   "text": "که ما وقتی میگیم وحدت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 668.19,
   "end": 672.77,
   "text": "شما وقتی به وحدت نگاه میکنی یعنی توحید صمدی قرآن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 672.77,
   "end": 675.45,
   "text": "خب کثرت چی میشه اینجا تکلیفش؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 675.45,
   "end": 679.59,
   "text": "وقتی به کثرت نگاه میکنی بالاخره اینا خلائق هستن یا نه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 679.59,
   "end": 682.53,
   "text": "بالاخره انسان‌ها، ها؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 682.53,
   "end": 685.95,
   "text": "حیوان‌ها، جمادات، نباتات اینا هستن یا نه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 685.95,
   "end": 691.41,
   "text": "خب اگه هستن کثراتن. این‌ها رابطه‌شون با وحدت چگونه است؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 691.41,
   "end": 693.69,
   "text": "یعنی این خیلی مهمه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 693.69,
   "end": 695.73,
   "text": "این نگاه. و بعد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 695.73,
   "end": 699.01,
   "text": "ارتباط لقاء الله با این موضوع.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 699.01,
   "end": 704.63,
   "text": "یعنی شیرینیش اینجاست. اصلاً چگونه، چه نگاهیه که ملا محسن داره میده به ما؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 704.63,
   "end": 706.87,
   "text": "حتما پیش بگیرید. خیلی شیرینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 706.87,
   "end": 709.11,
   "text": "جان؟ همین که عرض کردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 709.11,
   "end": 711.67,
   "text": "که حالا ما قبلاً گفتیم که حالا بعد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 711.67,
   "end": 720.49,
   "text": "بحث حضرات خمس رو حتما یادمون باشه تو این دل این بحث ما شاید یک ساله من میخوام به شما بگم توفیق نمیشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 720.49,
   "end": 724.93,
   "text": "تو دل همین بحث بگیم که حضرات خمس چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 724.93,
   "end": 729.11,
   "text": "همون عالم غیب مطلقه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 729.11,
   "end": 733.65,
   "text": "و عالم غیب مضاف، عالم شهود مطلقه و عالم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 733.65,
   "end": 736.17,
   "text": "شهود مضاف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 736.17,
   "end": 740.37,
   "text": "و اون انسان کامل یا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 740.37,
   "end": 744.83,
   "text": "به یک معنا اون کلمه جامع الهی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 744.83,
   "end": 748.79,
   "text": "اسم جامع این‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 748.79,
   "end": 752.03,
   "text": "بعدا ارتباط اینا با هم چگونه است؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 752.03,
   "end": 762.01,
   "text": "و کسی که بخواهد به کشف و کرامات و اینها بیفته که گفتیم همش زیر سر اسم العلییییم حق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 762.01,
   "end": 767.65,
   "text": "است. اینها پله پله، رتبه رتبه از کجا شروع میکنه به کجا میرسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 767.65,
   "end": 771.07,
   "text": "شما هم اصلا به من تذکر وقت رو نمیدید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 771.07,
   "end": 773.39,
   "text": "قطعا وقت ما تموم شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 773.39,
   "end": 779.37,
   "text": "همینقدر بگم که خدای منان در عالم عینی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 779.37,
   "end": 784.47,
   "text": "عینی که الان شما یه عینییت داری در عالم کثرات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 784.47,
   "end": 790.31,
   "text": "ها؟ عالم وجود عینی خدا، خداوند عالم علیم است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 790.31,
   "end": 799.44,
   "text": "العلییییم. در وجود علمی یعنی اعیان ثابته یعنی در ثغت ذات،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 799.44,
   "end": 803.39,
   "text": "در اون اعیان ثابته یعنی در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 803.39,
   "end": 805.43,
   "text": "صور علمیه، در ثغت ذات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 805.43,
   "end": 808.53,
   "text": "یعنی علمی که خدا به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 808.53,
   "end": 810.71,
   "text": "غیر خودش با ماسوی الله داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 810.71,
   "end": 813.03,
   "text": "علم خدا به ماسوی الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 813.03,
   "end": 817.19,
   "text": "ابدا و ازلا. اونجا خدا چی نامگذاری میشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 817.19,
   "end": 820.35,
   "text": "اونجا أعلم است،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 820.35,
   "end": 824.33,
   "text": "نه علیم. این بحث‌ها رو باید بند داشته باشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 824.33,
   "end": 829.33,
   "text": "کجا خدا خود علمه؟ در کثرات علیمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 829.33,
   "end": 832.67,
   "text": "در عالم علم و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 832.67,
   "end": 837.15,
   "text": "اعیان ثابته در ثغت ذات اونجا چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 837.15,
   "end": 840.79,
   "text": "أعلمه. عالم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 840.79,
   "end": 846.67,
   "text": "وجود علمی. در کجا خود علمه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 846.67,
   "end": 849.59,
   "text": "خدا خود علم میشه یا نه نمیشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 849.59,
   "end": 853.22,
   "text": "کجا خود علم میشه؟ خودش با خودش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 853.22,
   "end": 855.55,
   "text": "آفرین، آفرین به آقا احمد آقا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 855.55,
   "end": 858.65,
   "text": "گفت خودش با خودش یعنی در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 858.65,
   "end": 864.25,
   "text": "ذات غیب الغیوبش. اونجا دیگه خدا علمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 864.25,
   "end": 867.81,
   "text": "خدا علمه و ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 867.81,
   "end": 874.55,
   "text": "این خیلی مهمه که در لقاءالله از اسم علیم از اسم العلییییم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 874.55,
   "end": 878.93,
   "text": "سفر می‌کنیم به اسم أعلم حضرت حق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 878.93,
   "end": 881.09,
   "text": "تا برسیم به علم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 881.09,
   "end": 888.87,
   "text": "این مسیر لقاءاللهه. حالا یه ردپایی گذاشتیم، یه ریلی چیدیم که حالا یه مقدار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 888.87,
   "end": 891.33,
   "text": "توجه داشته باشید. انشاالله جلسه بعد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 891.33,
   "end": 893.47,
   "text": "والحمد لله رب العالمين.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 893.47,
   "end": 900.19,
   "text": "صلوات بفرستید. اللهم صل على محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}