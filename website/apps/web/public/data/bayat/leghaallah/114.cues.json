   "start": 463.23,
   "end": 483.25
  },
  {
   "index": 11,
   "title": "## نزول کثرات از احدیت تا نشئهٔ طبیعت",
   "start": 483.25,
   "end": 590.01
  },
  {
   "index": 12,
   "title": "## درس پنجاه‌ونه اسفار: کثرت بی‌انتها حتی در طبیعت",
   "start": 590.01,
   "end": 644.21
  },
  {
   "index": 13,
   "title": "## ماده‌گرایان و چهار اسم: هو الأول والآخر",
   "start": 644.21,
   "end": 713.33
  },
  {
   "index": 14,
   "title": "آن ثِقل، أثقال، علم است. علم سنگین است.",
   "start": 713.33,
   "end": 748.92
  },
  {
   "index": 15,
   "title": "## هو به ذات غیبی می‌خورد نه به ماده",
   "start": 748.92,
   "end": 794.86
  },
  {
   "index": 16,
   "title": "## جمع‌بندی: پیاده‌کردن اسم الجامع و لقاء الله",
   "start": 794.86,
   "end": 830.32
  },
  {
   "index": 17,
   "title": "## آب تبرکی و ختم جلسه",
   "start": 830.32,
   "end": 905.5
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.16,
   "end": 6.94,
   "text": "یا رب اعوذ به من همزات الشیاطین و من شر نفسي و من شر خلقک.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 6.94,
   "end": 8.76,
   "text": "بسم الله الرحمن الرحیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 8.76,
   "end": 13.34,
   "text": "لا حول ولا قوه الا بالله العلی العظیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 13.34,
   "end": 17.84,
   "text": "اللهم ایك نعبد وایک نستعين.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 17.84,
   "end": 23.08,
   "text": "الحمدالله علی كل نعمه و اسال الله من فضله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 23.08,
   "end": 27.44,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 27.44,
   "end": 33.46,
   "text": "ایات. سلام علیکم و رحمه الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 33.46,
   "end": 39.18,
   "text": "سال حضرت خدیجه در این هیئت سر سفره ایشون نشستیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 39.18,
   "end": 44.12,
   "text": "سفره‌دار مادر حضرت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 44.12,
   "end": 47.0,
   "text": "و سال حضرت خدیجه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 47.0,
   "end": 49.6,
   "text": "با معرفت صلواتی هدیه کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 49.6,
   "end": 55.58,
   "text": "اللهم صل علی محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 55.58,
   "end": 62.38,
   "text": "و آل. این جمله رو، این چند خط رو از کتاب شریف علم الیقین ملا محسن فیض",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 62.38,
   "end": 66.98,
   "text": "جلد یک دقت بفرمایید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 66.98,
   "end": 72.94,
   "text": "اوست که میان هم‌گونه‌ها و ناهم‌گونه‌ها و اشیاء ضد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 72.94,
   "end": 75.6,
   "text": "یا ضد یکدیگر،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 75.6,
   "end": 79.86,
   "text": "میان اشیاء ضد یکدیگر الفت انداخته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 79.86,
   "end": 86.08,
   "text": "و همه را با هم گرد می‌آورد چنانکه انسان‌های بسیاری را بر روی زمین،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 86.08,
   "end": 96.8,
   "text": "اجناس گوناگون موجودات را در عالم و کیفیت‌های متضاد را در مزاج حیوانات گرد آورده است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 96.8,
   "end": 101.66,
   "text": "و نیز سایر چیزهایی را که شرح آن به طول می‌انجامد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 101.66,
   "end": 106.06,
   "text": "جامع از بندگان کسیست که میان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 106.06,
   "end": 112.06,
   "text": "آداب ظاهره اعضا و جوارح با حقایق باطنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 112.06,
   "end": 114.56,
   "text": "در دل‌ها جمع کند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 114.56,
   "end": 121.92,
   "text": "پس هر که معرفتش کامل و سیره و روش او نیکو شده جامع است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 121.92,
   "end": 124.94,
   "text": "یعنی هم معرفتش کامل شده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 124.94,
   "end": 127.96,
   "text": "از حیث شناخت و نظر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 127.96,
   "end": 133.5,
   "text": "و هم سیر و سلوکش، سیرش، عملش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 133.5,
   "end": 136.18,
   "text": "درست شده این آدم جامعیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 136.18,
   "end": 141.22,
   "text": "کامل کسیست که نور معرفتش،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 141.22,
   "end": 146.72,
   "text": "نور پرهیزکاری او را خاموش نسازد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 146.72,
   "end": 149.04,
   "text": "خیلی جمله ارشی‌ایه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 149.04,
   "end": 151.32,
   "text": "یه بار دیگه می‌خونم دقت کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 151.32,
   "end": 154.32,
   "text": "کامل، کامل کیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 154.32,
   "end": 158.0,
   "text": "کسیه که می‌تونه لقاء الله رو درک کنه برسه به ملاقات خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 158.0,
   "end": 162.08,
   "text": "بحث شب‌های ما بود. چون الله اسم جامعه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 162.08,
   "end": 166.54,
   "text": "کسی جامعه، کسی کامله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 166.54,
   "end": 171.32,
   "text": "که در نهایت می‌تونه الله رو ملاقات کنه که این صفتش می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 171.32,
   "end": 175.36,
   "text": "چی؟ کامل کسیست، حالا بگیرید جامع کسیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 175.36,
   "end": 178.6,
   "text": "کسیست که نور معرفتش،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 178.6,
   "end": 184.16,
   "text": "نور پرهیزکاری او را خاموش نسازد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 184.16,
   "end": 188.54,
   "text": "یعنی چی؟ یعنی اینکه عالم با عمل باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 188.54,
   "end": 194.18,
   "text": "خلاصه‌ش اینه. می‌فرماید نور معرفتش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 194.18,
   "end": 198.34,
   "text": "اگرچه معرفتش نوره یعنی به حقه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 198.34,
   "end": 201.18,
   "text": "علمی که اخذ کرده علم باطل نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 201.18,
   "end": 205.94,
   "text": "علم نافعه. اعوذ به من",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 205.94,
   "end": 209.74,
   "text": "علم لا ينفع. تغریبات نماز عصر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 209.74,
   "end": 212.24,
   "text": "علم می‌شه لا ينفع باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 212.24,
   "end": 215.08,
   "text": "علمی که جدا باشه از نور الهی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 215.08,
   "end": 219.78,
   "text": "میگه اگرچه نور معرفت داره یعنی علمش نوره، حقه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 219.78,
   "end": 223.82,
   "text": "اما این امکان وجود داره که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 223.82,
   "end": 225.94,
   "text": "نور معرفتش چیکار کنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 225.94,
   "end": 229.98,
   "text": "نور پرهیزکاری او رو خاموش کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 229.98,
   "end": 232.52,
   "text": "یعنی چی؟ یعنی به عمل نندازش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 232.52,
   "end": 235.2,
   "text": "بشه صرفا علم فکری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 235.2,
   "end": 238.1,
   "text": "اصطلاحات جمع کنه، کتاب جمع کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 238.1,
   "end": 242.12,
   "text": "به قول حضرت استاد اگر بنا بود که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 242.12,
   "end": 248.78,
   "text": "عالم بودن به کتاب جمع کردن باشه، کتابفروشا از همه باید اعلم باشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 248.78,
   "end": 250.86,
   "text": "این همه کتاب تو طبقات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 250.86,
   "end": 252.8,
   "text": "مغازه‌شون چیدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 252.8,
   "end": 255.8,
   "text": "اما می‌بینیم خیلیاشون بی‌سوادن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 255.8,
   "end": 258.98,
   "text": "پول فقط در میارن. مثلا نمی‌فهمن چی دارن می‌فروشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 258.98,
   "end": 261.46,
   "text": "البته بودن بعضیا من سراغ دارم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 261.46,
   "end": 267.44,
   "text": "کتابفروش‌های قدیم که اخیرا یکیشون رو من دیدم پدرش به رحمت خدا رفته بود برادرش شهید بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 267.44,
   "end": 270.78,
   "text": "می‌گفت ما تو ک- اون مغازه‌مون که میش- می‌شستیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 270.78,
   "end": 277.72,
   "text": "اگر مثلا روزی صد تا کتاب می‌خوندیم حداقل، می‌فروختیم حداقل یه ده تاشو می‌خوندیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 277.72,
   "end": 284.1,
   "text": "الان اینطوری نیست که. کتاب‌ها بازاریه، کتابفروشی هم بازاری شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 284.1,
   "end": 294.66,
   "text": "خب پس اگر کسی صرفا به علمی که داره اکتفا کنه یعنی به حوزه عمل کشیده نشه، نشه عقل عملی فقط عقل نظری داشت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 294.66,
   "end": 299.24,
   "text": "این خطرناکه. این در حقیقت اون نوره، نور معرفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 299.24,
   "end": 304.86,
   "text": "اما می‌زنه نور پرهیزکاریشو یعنی نور عملش رو خاموش می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 304.86,
   "end": 310.8,
   "text": "الذین آمنوا این حوزه نظره و عملوا الصالحات حوزه عمله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 310.8,
   "end": 315.36,
   "text": "عقل نظری و عقل-- اون تواصوا بالحق توصیه به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 315.36,
   "end": 317.98,
   "text": "حقه یعنی توصیه به چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 317.98,
   "end": 321.92,
   "text": "عقل نظریه. و تواصوا بالصبر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 321.92,
   "end": 324.74,
   "text": "صبر اینجا منظور توصیه به چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 324.74,
   "end": 329.08,
   "text": "عقل عملیه. یعنی ما باید همدیگه رو به هر دو توصیه کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 329.08,
   "end": 332.54,
   "text": "هم عقل عملی هم عقل نظری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 332.54,
   "end": 337.04,
   "text": "هر کس این دو تا رو جدا کنه صرفا اهل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 337.04,
   "end": 344.4,
   "text": "عبادت باشه. صرفا اهل هیئت و اشک و بکا خیلی عالی، خیلی خوب، پر از نور اما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 344.4,
   "end": 348.64,
   "text": "خالی از عقل نظری باشه، این عقل عملیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 348.64,
   "end": 352.58,
   "text": "این هیئت حالا اومدی نشستی گریه کردی، این عقل عملی بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 352.58,
   "end": 361.18,
   "text": "نورم داره. اما اگر این بدون نور معرفت باشه یعنی خالی از عقل نظری باشه خطرناکه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 361.18,
   "end": 364.53,
   "text": "می‌شه حجابه. می‌شه، همین می‌شه خودش حجاب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 364.53,
   "end": 366.85,
   "text": "و ما به ملاقات الله نمی‌رسیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 366.85,
   "end": 375.11,
   "text": "حالا شما برید بیرون از خارج از وجود خودت ببین همونطور که نفس در وجود تو جامعه، جامع الشتاته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 375.11,
   "end": 378.89,
   "text": "و مظهر اسم الجامع حضرت حقه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 378.89,
   "end": 384.49,
   "text": "این همه کثرات رو در وجود تو کی به گرد هم جمع کرده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 384.49,
   "end": 390.47,
   "text": "که وقتی این نفس، روح بخاری که برزخ بین نفس و بدنه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 390.47,
   "end": 393.91,
   "text": "این روح بخاری سرد شد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 393.91,
   "end": 399.41,
   "text": "دیگه دست نفستو به بدنت نرسید همه کثرات مضمحل میشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 399.41,
   "end": 403.93,
   "text": "متلاشی میشه، از هم گسیخته میشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 403.93,
   "end": 406.79,
   "text": "چشم از حدقه می‌ریزه بیرون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 406.79,
   "end": 413.11,
   "text": "خودت اگر انشاالله بدن‌هاتون به عشق از زهرا سالم بمونه در قبر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 413.11,
   "end": 415.87,
   "text": "اما اگر کسی اینطوریه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 415.87,
   "end": 417.83,
   "text": "غالباً در قبر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 417.83,
   "end": 421.71,
   "text": "بدن پوسید بعد از چهل روز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 421.71,
   "end": 427.63,
   "text": "اینم حرف توش هست که چرا بعد سه روز، بعد هفت روز و بعد چهل روز و بعد یک سال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 427.63,
   "end": 433.27,
   "text": "وقتی رفتی اگه اجازه بدن روح بدن خودش رو ببینه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 433.27,
   "end": 442.07,
   "text": "اونجا فریاد می‌کشه وقتی اون اوضاع رو می‌بینه که موها ریخته، چشم، پا ترکیده ریخته رو صورت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 442.07,
   "end": 444.95,
   "text": "بدن تعفن گرفته، کرم بدن رو--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 444.95,
   "end": 446.59,
   "text": "یه وضعیه آقا، یه وضعیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 446.59,
   "end": 448.55,
   "text": "چرا؟ چون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 448.55,
   "end": 453.67,
   "text": "نفسه که مظهر اسم الجامع و همه این تکثرات رو در هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 453.67,
   "end": 455.83,
   "text": "جمع کرده بود، نگه داشته بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 455.83,
   "end": 460.25,
   "text": "الان بدن شما داره شما رو مدیریت می‌کنه که بدنت خودت برقراری،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 460.25,
   "end": 463.23,
   "text": "سالمی، صحت داری، عافیت داری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 463.23,
   "end": 465.39,
   "text": "معافي از تشتت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 465.39,
   "end": 468.51,
   "text": "معافي. عافیت از معاف بودن میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 468.51,
   "end": 472.49,
   "text": "معاف‌ات می‌کنم از کس-- از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 472.49,
   "end": 474.63,
   "text": "تشتت، از تفرق،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 474.63,
   "end": 480.95,
   "text": "از جدایی. پس اون اسم الجامع که از در تو هست و nefsi که مظهری از اونه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 480.95,
   "end": 488.57,
   "text": "برو بیرون ببین این همه ماشاءالله کثرات از صادر اول که نفس الرحمن است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 488.57,
   "end": 493.23,
   "text": "بگیر بیار ذیل اون که مرتبه ظهور اسماء شروع میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 493.23,
   "end": 499.39,
   "text": "مرتبه احدیت که روح ما از اونجاست و کشیده شده از همین جایی که الان من نشستم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 499.39,
   "end": 509.37,
   "text": "که مرتبه واحدیت و کثرته تا اونجا که احدیت و اندماج حقایق به نحو کلی و بسیط الحقیقه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 509.37,
   "end": 512.0,
   "text": "همه چی اونجاست سرمنشأش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 512.0,
   "end": 515.25,
   "text": "\"بیدهی ملکوتی کل شی\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 515.25,
   "end": 517.61,
   "text": "از اونجا دو مرتبه میای پایین‌تر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 517.61,
   "end": 520.23,
   "text": "از مرتبه احدیت که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 520.23,
   "end": 523.27,
   "text": "میشه کجا؟ بالای مرتبه عقل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 523.27,
   "end": 529.99,
   "text": "یعنی روح عالم. بعد میای پایین‌تر مرتبه کثرات شروع میشه و واحدیت که قلب عالمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 529.99,
   "end": 533.21,
   "text": "عرش الرحمن. قلب المؤمن عرش الرحمن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 533.21,
   "end": 536.29,
   "text": "میای پایین‌تر از اونجا، اونجا لاهوت بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 536.29,
   "end": 540.15,
   "text": "می‌رسی به جبروت، عالم عقول و عالم امیرالمؤمنین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 540.15,
   "end": 543.67,
   "text": "مفارقات، مرسلات، مبدئات،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 543.67,
   "end": 546.15,
   "text": "ملائکه، عقول عالم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 546.15,
   "end": 549.73,
   "text": "سلطنت امیرالمؤمنین به یکبارشه، عالم عقله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 549.73,
   "end": 552.09,
   "text": "میای پایین‌تر یه مقدار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 552.09,
   "end": 555.29,
   "text": "دستش بیشتر میشه، کثرتش بیشتر میشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 555.29,
   "end": 559.21,
   "text": "شکل و صورت می‌گیره. از حالت کلی به جزئی تبدیل میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 559.21,
   "end": 563.19,
   "text": "پیاده داره میشه. این میشه دامنه عقل که میشه نفس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 563.19,
   "end": 567.21,
   "text": "نفس میشه مرتبه پیاده‌سازی عقل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 567.21,
   "end": 571.45,
   "text": "میشه عالم مثال یا ملکوت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 571.45,
   "end": 577.19,
   "text": "یا برزخ که سلطنتش دست حضرت صدیقه شهیده است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 577.19,
   "end": 578.93,
   "text": "باطن این عالمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 578.93,
   "end": 581.71,
   "text": "بعد از اونجا دو مرتبه میای به کجا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 581.71,
   "end": 590.01,
   "text": "دیگه این همه کثرات عالم شهود مطلقه و این همه کثرت انتها نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 590.01,
   "end": 592.45,
   "text": "همین امروز در درس پنجاه و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 592.45,
   "end": 600.85,
   "text": "نه شرح اسفار حضرت علامه حسن زاده علیه الرحمه گوش می‌دادم که جالب بود که همون ابتدای درس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 600.85,
   "end": 606.19,
   "text": "دیدم البته شاید بگم حداقل هفت هشت بار من این مدت اینو گوش دادم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 606.19,
   "end": 609.71,
   "text": "امروز دوباره گوش دادم دیدم انگار اولین بار دارم می‌شنوم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 609.71,
   "end": 612.19,
   "text": "از خاصیت‌های درس، درس‌های استاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 612.19,
   "end": 618.81,
   "text": "دیدم ایشون همون اول فرمودند که در همین خصوص فرمودند که عزیزم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 618.81,
   "end": 623.97,
   "text": "شما وقتی که نگاه می‌کنی به عالم می‌بینی از مبدأ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 623.97,
   "end": 630.45,
   "text": "فیض از فیض اول همینطوری کثرت شروع شده اومده پایین، اومده پایین، اومده پایین،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 630.45,
   "end": 634.35,
   "text": "دور تا دور در این نظام آفرینش انتها نمی‌بینی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 634.35,
   "end": 639.63,
   "text": "تو همین تازه نشئہ طبیعت که از همه مرتبش پایین‌تره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 639.63,
   "end": 642.47,
   "text": "ادناس، دنیه، پست فلسفیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 642.47,
   "end": 648.51,
   "text": "اینجا هم انتها نمی‌بینی. بعد می‌فرمود علامه اینجا می‌فرمود که شما می‌بینی ماد-",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 648.51,
   "end": 654.27,
   "text": "ماده‌گراها، ماده‌پرست‌ها، ماتریالیست‌ها، لیبرال‌ها، اینا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 654.27,
   "end": 657.03,
   "text": "اینا که قائل نیستن به الهیت نظام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 657.03,
   "end": 660.97,
   "text": "اونا هم میگن \"هو الاول والآخر والظاهر والباطن\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 660.97,
   "end": 663.71,
   "text": "تو این چهار تا اسم با ما سهیمن، شریکن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 663.71,
   "end": 666.37,
   "text": "اما اون هو رو به چی می‌زنن؟ به ماده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 666.37,
   "end": 670.45,
   "text": "میگن ماده ازلی بوده و ابدی‌ست، برداشتنی نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 670.45,
   "end": 673.01,
   "text": "درست میگن اما حرف کامل نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 673.01,
   "end": 675.55,
   "text": "نه ماده چون شعون حقه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 675.55,
   "end": 678.47,
   "text": "اگرچه انزل مراتب حقه بله اینم برداشتنی نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 678.47,
   "end": 681.31,
   "text": "اسماء اللهند. اسم الله نمیشه تعطیل بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 681.31,
   "end": 685.01,
   "text": "توقیفیت اسماء، میخ کوب سر جاش واستاده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 685.01,
   "end": 687.22,
   "text": "اون که \"إذا الشمس کورت\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 687.22,
   "end": 689.27,
   "text": "\"إذا زلزلت الأرض زلزالها\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 689.27,
   "end": 694.53,
   "text": "اینا تعویل داره. اون خورشید که خاموش میشه \"وأشرقت الأرض بنور ربها\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 694.53,
   "end": 697.67,
   "text": "ای به نور امامها مرحوم حاج آقا سبزآوری می‌فرمایند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 697.67,
   "end": 701.09,
   "text": "چون به نور امام همه‌جا روشن میشه دیگه خورشید، خورشید نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 701.09,
   "end": 704.88,
   "text": "دیگه خورشید خاموش شد. نه اینکه واقعاً این خورشید خاموش شه یه روزی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 704.88,
   "end": 709.67,
   "text": "\"إذا زلزلت الأرض زلزالها وأخرجت أفغالها\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 709.67,
   "end": 712.05,
   "text": "اون فغل، افغال، علمه. علم سنگینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 712.05,
   "end": 719.61,
   "text": "العلم الثقيل. وقتی از سینه امام می‌ریزه بیرون حضرت تشریف بیاره از هفتاد و از هفت، از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 719.61,
   "end": 722.35,
   "text": "بیست و هفت، هفت علم بیست و پنج تاش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 722.35,
   "end": 725.82,
   "text": "می‌مونه تو سینه آقا تا وقت ظهور میاد می‌ریزه بیرون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 725.82,
   "end": 729.76,
   "text": "و اخرجت الارض اثقالها وقتی خارج میشه از سینه حضرت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 729.76,
   "end": 735.8,
   "text": "اذ ازلزلت الارض بدن‌ها که ارض‌اند بدن تو ارض وجود توست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 735.8,
   "end": 738.4,
   "text": "روحت سماء وجود توئه، می‌لرزه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 738.4,
   "end": 743.34,
   "text": "می‌لرزه. وقال الانسان ما لها میگه چه خبر شده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 743.34,
   "end": 747.38,
   "text": "چی شده؟ ما تا حالا نشنیده بودیم این حرفا رو اسلام جدید اومده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 747.38,
   "end": 750.22,
   "text": "امام عصر که بیاد. خب حالا بحث چی بود؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 750.22,
   "end": 757.98,
   "text": "اونا ماده رو میگن آقا اونم اول و هر اولی ماده‌ست، آخری ماده‌ست، ظاهری ماده‌ست، باطنی هم ماده‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 757.98,
   "end": 763.38,
   "text": "ما میگیم نخیر هوه میخوره به ذات غیبی و قائل به الوهیت نظام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 763.38,
   "end": 769.74,
   "text": "ما به اونکه ماده، ماده‌پرسته میگیم تو چگونه به الوهیت نظام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 769.74,
   "end": 772.86,
   "text": "قائل نیستی در حالی که میگی انتها نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 772.86,
   "end": 777.28,
   "text": "مگه رفتی دیدی؟ تجرید رو مجردات رو قبول نداری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 777.28,
   "end": 781.02,
   "text": "میگی هرچی هست این پوسته ظاهره. خستتون نکنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 781.02,
   "end": 783.28,
   "text": "بیرون از ما هم جمله آخر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 783.28,
   "end": 786.62,
   "text": "میخوان شام بیارن هی به من اشاره میکنن که حاجی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 786.62,
   "end": 791.3,
   "text": "دیر شده. بیر-- من گفتم ده دقیقه به من بگید نمیگید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 791.3,
   "end": 794.86,
   "text": "شده یه ربع، ده دقیقه. این جمله آخر رو ببینید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 794.86,
   "end": 797.22,
   "text": "بیرون از ما هم اسم الجامع",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 797.22,
   "end": 806.06,
   "text": "حق پیاده شده که همه این عوالمی که ما اسم بردیم همه برقرار‌اند، پایدارند و دارن کار خودشونو میکنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 806.06,
   "end": 813.24,
   "text": "اگر کسی اسم الجامع رو در خودش درست پیاده کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 813.24,
   "end": 820.72,
   "text": "میتونه به همین وزانی که ما سخن گفتیم ان شاء الله به ملاقات الله برسه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 820.72,
   "end": 824.76,
   "text": "که الله جمع الجمع و اسم جامع.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 824.76,
   "end": 830.32,
   "text": "همین یه ربع ایشالله برکت دنیا و آخرت همگی مون باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 830.32,
   "end": 836.44,
   "text": "فردا شب حالا بچه‌ها الان گفتن میخوان دویست تا آب معدنی بگیرن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 836.44,
   "end": 843.3,
   "text": "چون این آب تبرکی که هزاران نفر رو تا حالا شفا داده و مادر شهید معماریان به بنده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 843.3,
   "end": 846.52,
   "text": "هدیه دادن آوردن برای هیئت رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 846.52,
   "end": 853.22,
   "text": "یکی یه ذره می‌ریزیم توی این آب معدنی‌ها تقدیم می‌کنیم که معطل نشید فردا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 853.22,
   "end": 857.56,
   "text": "خود هیئت قرار شده آب معدنی تهیه کنه و این آبو من به دستشون برسونم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 857.56,
   "end": 860.94,
   "text": "حضرت العال حضرت آقای گلپایگانی فرمودن یه قطره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 860.94,
   "end": 865.4,
   "text": "پنج قطره‌شو و امروز دوباره صحبت‌های مادر شهید رو با دقت گوش دادم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 865.4,
   "end": 870.44,
   "text": "فرمود پنج قطره‌شو آقای گلپایگانی گفته حالا چه سری در پنجه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 870.44,
   "end": 873.76,
   "text": "پنج قطره‌شو بریزید دریا، دریا متبرک میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 873.76,
   "end": 878.08,
   "text": "این تربتی بوده که چسبیده بوده به بدن سید الشهدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 878.08,
   "end": 885.4,
   "text": "زیر بدن بوده. برداشتن دست به دست رسیده به آقای گلپایگانی و بوش همون بوییه که شهید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 885.4,
   "end": 890.6,
   "text": "مادر شهید معماریان میگه پسر شهیدش تو خواب اون پارچه سبز رو به پاش می‌برده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 890.6,
   "end": 894.04,
   "text": "این پارچه سبز الان هست که مادر رو شفا میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 894.04,
   "end": 896.16,
   "text": "آورد مسجد بلال دوستان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 896.16,
   "end": 899.0,
   "text": "تبرکی کردن. حالا این فردا شب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 899.0,
   "end": 902.78,
   "text": "به شما تقدیم میشه. آخر جلسه دیگه نمی‌خواد آب بیارید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 902.78,
   "end": 905.5,
   "text": "والحمد لله رب العالمين. صلوات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}