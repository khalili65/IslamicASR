 "chapters": [
  {
   "index": 0,
   "title": "## ادامهٔ کلمهٔ مکنونه در شب جمعه",
   "start": 0.84,
   "end": 37.76
  },
  {
   "index": 1,
   "title": "## لذت‌ها متفاوت است؛ حتی لذت مادیِ دیندار",
   "start": 37.76,
   "end": 225.34
  },
  {
   "index": 2,
   "title": "## عشق‌وحال‌ها یکی نیست",
   "start": 225.34,
   "end": 312.3
  },
  {
   "index": 3,
   "title": "## بهشت به اندازهٔ انس دنیا",
   "start": 312.3,
   "end": 404.79
  },
  {
   "index": 4,
   "title": "## نهان‌خانهٔ وجود از زبان و رخسار بیرون می‌ریزد",
   "start": 404.79,
   "end": 485.89
  },
  {
   "index": 5,
   "title": "به قول شاعر: تا مرد سخن نگفته باشد، عیب و هنرش نهفته باشد.",
   "start": 485.89,
   "end": 572.69
  },
  {
   "index": 6,
   "title": "## جستجوهای موبایل و دورهمی‌ها؛ درون بیرون می‌ریزد",
   "start": 572.69,
   "end": 699.09
  },
  {
   "index": 7,
   "title": "## رفاقت جوانان؛ تذکر، نه هم‌صدایی با دلِ بیمار",
   "start": 699.09,
   "end": 719.23
  },
  {
   "index": 8,
   "title": "خب ندهند. آن‌ها بدبخت‌اند. آن‌ها دنیا را همین دیده‌اند و بس. آن‌ها کورند. آن‌ها:",
   "start": 719.23,
   "end": 816.77
  },
  {
   "index": 9,
   "title": "## اسماء الهی؛ باطن اشیا را از امیرالمؤمنین بخواه",
   "start": 816.77,
   "end": 836.83
  },
  {
   "index": 10,
   "title": "چرا فرمود:",
   "start": 836.83,
   "end": 912.53
  },
  {
   "index": 11,
   "title": "## از ایوان طلا تا دیدن باطن؛ وزن اباالفضل",
   "start": 912.53,
   "end": 961.11
  },
  {
   "index": 12,
   "title": "## شرط رفاقت شهید سلیمانی؛ رفاقت بر مدار لقاء الله",
   "start": 961.11,
   "end": 1062.83
  },
  {
   "index": 13,
   "title": "## جرأت درخواست معارف",
   "start": 1062.83,
   "end": 1094.61
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.84,
   "end": 7.96,
   "text": "صحبت ما شب جمعه در خصوص لقاءالله بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 7.96,
   "end": 12.52,
   "text": "جلسه‌ی پیش ما سعی کردیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 12.52,
   "end": 23.5,
   "text": "اون کلمه‌ی مکنونه‌ی فی معانی لقاءالله ملا محسن رو تند تند جمعش کنیم، تمومش کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 23.5,
   "end": 26.74,
   "text": "خب هیف اومد. تو دل اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 26.74,
   "end": 31.2,
   "text": "کلمه نکته‌ای رو می‌خواستم عرض کنم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 31.2,
   "end": 34.02,
   "text": "که بر اساس انتهای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 34.02,
   "end": 37.76,
   "text": "صحبتی که ملا محسن می‌کنه عزیزانی بگم؛",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 37.76,
   "end": 41.56,
   "text": "هر کسی همونطور که تو این دنیا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 41.56,
   "end": 47.12,
   "text": "از یه چیزی لذت می‌بره و لذت‌ها متفاوته،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 47.12,
   "end": 50.28,
   "text": "یکی صرفا لذت بدنی و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 50.28,
   "end": 61.52,
   "text": "جسمی و مادی می‌بره و اصلا بی‌خبره از لذت‌های معنوی و یه کسی هم حتی لذت‌های مادیش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 61.52,
   "end": 66.76,
   "text": "هم معنویه. حتی مسائل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 66.76,
   "end": 69.94,
   "text": "جنسیش. حالا چون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 69.94,
   "end": 72.9,
   "text": "کوچیک‌ترا هستن زبانم بسته است که اینو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 72.9,
   "end": 76.02,
   "text": "بگم یعنی چی. حتی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 76.02,
   "end": 80.92,
   "text": "یعنی حتی معنویت طرف که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 80.92,
   "end": 83.3,
   "text": "زیاد میشه حتی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 83.3,
   "end": 86.76,
   "text": "می‌بینی تاثیرگذار میشه رو مسائل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 86.76,
   "end": 94.37,
   "text": "لذت‌های دنیاییش که حالا اینو من سربسته میگم رد میشم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 94.37,
   "end": 99.14,
   "text": "و باور کنید که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 99.14,
   "end": 107.66,
   "text": "دیندارها از مادیات بیشتر لذت می‌برن تا بی‌دین‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 107.66,
   "end": 112.3,
   "text": "اونا فقط حرصشو می‌زنن اما لذتش رو دیندارها می‌برن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 112.3,
   "end": 115.1,
   "text": "این یه نکته‌ست خودش بماند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 115.1,
   "end": 117.48,
   "text": "همینطور که چون فعلا بحثمون چیز دیگه‌ایست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 117.48,
   "end": 122.54,
   "text": "اینجا همینطور که لذت‌ها متفاوته،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 122.54,
   "end": 126.68,
   "text": "این آخر بحث ملا محسن می‌فرماید که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 126.68,
   "end": 130.26,
   "text": "در بهشت هم اشاره می‌کنه به حدیث امام صادق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 130.26,
   "end": 135.18,
   "text": "صلی الله علیه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 135.18,
   "end": 138.68,
   "text": "در بهشت هم لذائز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 138.68,
   "end": 142.94,
   "text": "فی روضات الجنان مع اولیاء الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 142.94,
   "end": 146.4,
   "text": "متفاوته. بها تلذذ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 146.4,
   "end": 150.96,
   "text": "من لم یزل فی روضات الجنان مع اولیاء الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 150.96,
   "end": 154.68,
   "text": "اونجا ی-یه لذتی دارن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 154.68,
   "end": 160.1,
   "text": "بهشتی‌ها که دیگه اوج لذت‌های بهشته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 160.1,
   "end": 162.76,
   "text": "لذتشون چیه؟ فرمود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 162.76,
   "end": 169.84,
   "text": "و تنعم بمعرفة الله تعالی و تلذذ بها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 169.84,
   "end": 177.24,
   "text": "شناخت خدا. همش بر می‌گرده خدا رحمت کنه شهید مطهری فرمود اسلام در اندیشه‌هاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 177.24,
   "end": 182.9,
   "text": "اینکه نگاه شما به دنیا چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 182.9,
   "end": 185.84,
   "text": "اصلاً گوش بدید، این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 185.84,
   "end": 191.4,
   "text": "شما هم گوش بدید. این حرف خیلی به درد شما می‌خوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 191.4,
   "end": 196.94,
   "text": "اصلاً نگاه ما،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 196.94,
   "end": 201.0,
   "text": "اینکه ما نگاهمون به این دنیا چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 201.0,
   "end": 203.84,
   "text": "در لسانمون مشخص میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 203.84,
   "end": 206.0,
   "text": "در عملکردمون مشخص میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 206.0,
   "end": 211.66,
   "text": "اصلاً اینکه ما چه فکری می‌کنیم، افکار ما چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 211.66,
   "end": 215.16,
   "text": "کاملاً از لسانمون پیداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 215.16,
   "end": 218.12,
   "text": "از سبک زندگیمون پیداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 218.12,
   "end": 223.62,
   "text": "به قول امیرالمؤمنین از چهره‌هامون پیداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 223.62,
   "end": 225.34,
   "text": "معلومه ما از چی لذت می‌بریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 225.34,
   "end": 228.12,
   "text": "الان شما اینجا برای چی اینجایید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 228.12,
   "end": 234.34,
   "text": "شب جمعه که فردا تعطیلن همه دنبال یه فرصتی‌ان برن یه جا عشق و حال کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 234.34,
   "end": 236.68,
   "text": "حالا عشق و حال‌ها هم متفاوته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 236.68,
   "end": 238.5,
   "text": "اگر شما بپرسم آقا برای چی اومدی اینجا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 238.5,
   "end": 240.62,
   "text": "میگی اومدم عشق و حال کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 240.62,
   "end": 245.11,
   "text": "اون کسی هم که الان رفته دربند یا رفته یه ویلا خصوصی گرفته فلان جا اونم بپرسی برای چی اومدی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 245.11,
   "end": 248.76,
   "text": "میگه اومدم عشق و حال کنم. هر دو می‌خوان کیف کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 248.76,
   "end": 251.86,
   "text": "اما کیف‌ها متفاوت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 251.86,
   "end": 254.38,
   "text": "چرا شما این رو کیف می‌دونی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 254.38,
   "end": 258.52,
   "text": "اون سر سفره گناه نشستن رو کیف می‌دونه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 258.52,
   "end": 261.84,
   "text": "همش از درون‌هاست. قبلاً گفتیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 261.84,
   "end": 264.78,
   "text": "بین مدرک و مدرک تناسب هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 264.78,
   "end": 268.56,
   "text": "مشاکلت و مناسبت هست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 268.56,
   "end": 271.36,
   "text": "بین هر کسی و عملش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 271.36,
   "end": 274.04,
   "text": "اینکه شما اینجایید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 274.04,
   "end": 278.0,
   "text": "یک مشاکلت، یک مسانخت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 278.0,
   "end": 285.26,
   "text": "یک مناسبتی قطعاً یک منا-- مؤانست و یک مصاحبتی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 285.26,
   "end": 290.32,
   "text": "بین شما و حضرت زهرا و بچه‌هاش بوده که اینجایید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 290.32,
   "end": 294.34,
   "text": "اگر این نبود نبودی. باید اینو تقویت کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 294.34,
   "end": 296.28,
   "text": "بهشت هم همینطوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 296.28,
   "end": 301.2,
   "text": "بین من و ش-- بین شما و نعمت‌های بهشتی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 301.2,
   "end": 304.38,
   "text": "اون میزان تلذذ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 304.38,
   "end": 309.38,
   "text": "هست که با شما با اون‌ها عجین بودید، با اون‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 309.38,
   "end": 312.3,
   "text": "در حقیقت انس داشتید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 312.3,
   "end": 316.94,
   "text": "کسی که تو دنیا با سیب و گلابی انس داشته،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 316.94,
   "end": 319.4,
   "text": "با حوری‌های دنیایی انس داشته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 319.4,
   "end": 325.64,
   "text": "اگرچه خط قرمز الهی رو رد نکرده ولی منتهی همش این‌ها بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 325.64,
   "end": 330.12,
   "text": "از این چیزا لذت می‌برده یعنی این‌ها براش هم و غم بودن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 330.12,
   "end": 331.89,
   "text": "اگرچه در مسیر حق بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 331.89,
   "end": 335.1,
   "text": "این یه مسلمان معمولی بوده. اونم تو بهشت هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 335.1,
   "end": 339.9,
   "text": "اون هم متلذذ هست، متنعّم هست اما به چه نعمت‌هایی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 339.9,
   "end": 342.78,
   "text": "سیب و گلاب و حور و قصر بهشتی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 342.78,
   "end": 347.98,
   "text": "اما کسی که اینجا مثل شما زانو زده معرفت کسب کنه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 347.98,
   "end": 349.68,
   "text": "الان اینجا برای چی اومدی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 349.68,
   "end": 352.08,
   "text": "حب اهل بیت رو درک کنه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 352.08,
   "end": 355.04,
   "text": "چنین کسی بهشتش هم شبیه همین ما--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 355.04,
   "end": 360.34,
   "text": "اصلاً بین این دنیا و بهشت من و شما هم حتی مشاکلت هست، مناسبت هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 360.34,
   "end": 364.36,
   "text": "حرف ما اینه. یه فرمایشی داره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 364.36,
   "end": 367.22,
   "text": "میگن انتساب دادن به امیرالمؤمنین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 367.22,
   "end": 374.63,
   "text": "تو راه که میومدم پسر عزیزم تو راه از ما یه سوالی کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 374.63,
   "end": 381.49,
   "text": "خیلی سؤال قشنگی بود. چون جوابی که به ایشون دادم به درد همتون میخوره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 381.49,
   "end": 383.59,
   "text": "بگم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 383.59,
   "end": 389.51,
   "text": "یه فرمایشی هست که انتسابش میدن به امیرالمؤمنین در حالی که مال امیرالمؤمنین نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 389.51,
   "end": 391.63,
   "text": "این متن انگلیسیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 391.63,
   "end": 394.67,
   "text": "یه سری اندیشمندان غربی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 394.67,
   "end": 398.63,
   "text": "به فارسی ترجمه شده حتما هم شنیدید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 398.63,
   "end": 406.39,
   "text": "کسی هم شاید گفته بالا منبر گفته امیرالمؤمنین فرموده در صورتی که این هیچ کجا در مجامع روایət ما از مولا نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 406.39,
   "end": 412.19,
   "text": "شبیهش هست اما این نیست که مولا مثلا فرموده مراقب،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 412.19,
   "end": 416.35,
   "text": "دقت بفرمایید، مراقب افکارت باش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 416.35,
   "end": 419.91,
   "text": "که گفتارت رو میسازه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 419.91,
   "end": 423.03,
   "text": "مراقب گفتارت باش که رفتارت رو میسازه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 423.03,
   "end": 426.53,
   "text": "مراقب رفتارت باش که عاداتت رو میسازه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 426.53,
   "end": 429.47,
   "text": "مراقب عاداتت باش که شخصیتت رو میسازه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 429.47,
   "end": 433.61,
   "text": "مراقب شخصیتت باش که سرنوشتت رو میسازه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 433.61,
   "end": 438.27,
   "text": "حرف، حرف درستیه. اگرچه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 438.27,
   "end": 443.89,
   "text": "بعید نیست که اون‌ها اقتباسی کرد-- اقتباس از بزرگان دینی کردند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 443.89,
   "end": 448.07,
   "text": "بالاخره اونا مسیحی‌اند شاید از منابع انبیا این رو استیضاح کردند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 448.07,
   "end": 451.43,
   "text": "هرچه که بوده. اما اون که امیرالمؤمنین می‌فرماید اینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 451.43,
   "end": 455.07,
   "text": "می‌فرماید \"هر کسی در نهان‌خانه وجودش،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 455.07,
   "end": 465.79,
   "text": "در سرش، در قلبش، در فکرش هرچه می‌گذره بالاخره از آنچه که بر لسانش جاری میشه و در چهره‌ش دیده میشه نمایانه.\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 465.79,
   "end": 469.05,
   "text": "یعنی هر کسی هر طرز فکری داره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 469.05,
   "end": 473.45,
   "text": "اون طرز فکرش بر لسانش بالاخره جاری میشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 473.45,
   "end": 478.13,
   "text": "و در رنگ و روی چهره‌ش پیداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 478.13,
   "end": 482.77,
   "text": "مشخصه این چی کاره‌ست. میگه تا مرد سخن نگفته باشد عیب و هنرش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 482.77,
   "end": 488.91,
   "text": "نگفته باشد. کسی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 488.91,
   "end": 495.33,
   "text": "دنبال حضرت زهراست، دنبال بچه های بی-- آواره امام زمانشه، عشقش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 495.33,
   "end": 497.75,
   "text": "ولش کنی می‌بینی حرمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 497.75,
   "end": 500.55,
   "text": "سر از حرم در میاره. عشق-- اوج عشقشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 500.55,
   "end": 503.15,
   "text": "پول جمع میکنه. نمیگم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 503.15,
   "end": 507.93,
   "text": "گردشگری نره، جنگل نره، دریا نره، تفریح نه، اینا نه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 507.93,
   "end": 513.21,
   "text": "اما اونم بخاطر بالاخره طبع بدن، طبیعت بدن، بدن نیاز داره بره یه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 513.21,
   "end": 517.51,
   "text": "تنی به آب بزنه. یا بچه ها بالاخره هنوز معرفتشون کامل نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 517.51,
   "end": 519.93,
   "text": "بچه ها رو یه مثلا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 519.93,
   "end": 522.05,
   "text": "موج‌های آبی ببره اینا. اما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 522.05,
   "end": 527.85,
   "text": "عشقش اینه که پول جمع کنه یه حرم بره، مشهد بره، کربلا بره، سیدالکریم بره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 527.85,
   "end": 535.11,
   "text": "چنین کسی این مؤانستی که براش ایجاد شده یعنی در حقیقت اون خاستگاه درونش،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 535.11,
   "end": 539.47,
   "text": "اون از درونش متبلور شده، ظهور کرده به این شکل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 539.47,
   "end": 543.41,
   "text": "با حرم کیف میکنه. در و دیوار حرم نگاه میکنه صفا میکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 543.41,
   "end": 546.79,
   "text": "ضریح میبینه عشق میکنه. روحش پرواز میکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 546.79,
   "end": 549.69,
   "text": "اصلا بچه هیئتی میبینه، مسجد میبینه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 549.69,
   "end": 552.93,
   "text": "صفا میکنه. یا راحته دیگه فهمش راحته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 552.93,
   "end": 556.91,
   "text": "درست شد؟ این درونش رو داره میریزه بیرون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 556.91,
   "end": 566.05,
   "text": "چنین کسی لسانش هم اونچه که از زبانش هم جاری میشه تو همین هیئته، تو همین کسوته، تو همین شاکله‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 566.05,
   "end": 572.69,
   "text": "رنگ رخسارش هم این چنینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 572.69,
   "end": 575.27,
   "text": "الان جوونای امروزی مثلا خب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 575.27,
   "end": 577.79,
   "text": "خیلیا میبینی همه موبایل دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 577.79,
   "end": 585.07,
   "text": "چرا یکی از اون جستجوهایی که تو موبایلش صورت داده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 585.07,
   "end": 588.23,
   "text": "خبیث‌ترین چیزها رو جستجو کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 588.23,
   "end": 593.93,
   "text": "یکی پاک‌ترین رو، اون خبیثات رو خبیثین و این طیبات و طیبین رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 593.93,
   "end": 596.17,
   "text": "چرا الان اینجا چند تا با هم رفیقید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 596.17,
   "end": 599.27,
   "text": "دو تا، دو تا، چهار تا، چهار تا، پنج تا، پنج تا با هم رفیقید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 599.27,
   "end": 604.71,
   "text": "وقتی پیش هم میشینید چی میگید به همدیگه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 604.71,
   "end": 611.23,
   "text": "از چی لذت میبرید؟ الان جوونا دور هم که جمع میشن چی میگن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 611.23,
   "end": 614.71,
   "text": "از چی لذت میبرن؟ از چه حرفایی کیف میکنن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 614.71,
   "end": 621.77,
   "text": "کاملا معلومه. دور-- درونشونو دارن میریزن بیرون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 621.77,
   "end": 626.55,
   "text": "حالا الان هیئت به صورت رسمی منبره مجبوری بشینی گوش بدی خب تموم که میشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 626.55,
   "end": 632.09,
   "text": "دور هم گرده میگیرید، دور هم جمع میشید چی میگید کیف می‌کنید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 632.09,
   "end": 640.31,
   "text": "از چی لذت میبرید؟ کسی که میاد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 640.31,
   "end": 643.67,
   "text": "خیلی راحت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 643.67,
   "end": 649.31,
   "text": "مسائل جنسی رو بیان میکنه، خیلی راحت بیان میکنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 649.31,
   "end": 651.23,
   "text": "و آمال و آرزوهاش رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 651.23,
   "end": 659.95,
   "text": "بیان میکنه از این حیث که من آرزوم اینه که مثلا از جهت جنسی فلان یا اگر من یه روزی ازدواج کنم اینطوری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 659.95,
   "end": 663.17,
   "text": "مثلا از جهت جنسی رفت و این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 663.17,
   "end": 668.49,
   "text": "قشنگ خاستگاه وجودیش رو، اونچه که درونش، مکمن و غیبشه داره میریزه بیرون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 668.49,
   "end": 673.93,
   "text": "یعنی خودش رو داره نشون میده چی کاره‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 673.93,
   "end": 677.11,
   "text": "این همه حرف مهم، این همه حرف به دردبخور",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 677.11,
   "end": 682.39,
   "text": "چطور شده که با چهار تا رفیقات جمع شدی داری از این حرف می-- آخه به چه درد کسی میخوره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 682.39,
   "end": 686.77,
   "text": "به چه-- به کسی چه ربطی داره که تو اگر ازدواج کردی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 686.77,
   "end": 690.37,
   "text": "مثلا خاستگاهت و همسرت از جهت جنسی چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 690.37,
   "end": 693.17,
   "text": "آخه این چه حرفیه که میشینی میزنی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 693.17,
   "end": 696.93,
   "text": "چه لزومی داره؟ این دل مریضه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 696.93,
   "end": 699.09,
   "text": "دل مریضه باید اصلاح بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 699.09,
   "end": 702.05,
   "text": "تو وقتی میشنوی باید چیکار کنی؟ بگی به به راست میگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 702.05,
   "end": 704.59,
   "text": "تو هم شروع کنی در راستای اون حرف زدن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 704.59,
   "end": 708.83,
   "text": "یا باید جلو دهنشو بگیری یا باید تز-- تربیتش کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 708.83,
   "end": 711.23,
   "text": "رفیقته، تذکر بهش بدی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 711.23,
   "end": 718.27,
   "text": "این حرفو نزن در شأن تو نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 718.27,
   "end": 726.01,
   "text": "هر وقت ازدواج کردی جوون، نوجوون انشاالله ازدواج کردی، اون موقع بشین پیش یه آدمی که این کاره‌ست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 726.01,
   "end": 730.95,
   "text": "اهل تحقیق و بررسی و مبانی دینی رو خوب-- دین رو خوب شناخته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 730.95,
   "end": 734.03,
   "text": "و روانشناسی خوبی داره بشین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 734.03,
   "end": 740.23,
   "text": "زانو بزن. بله. اینکه چگونه اوج لذت رو از مسائل زندگیت هم ببری اشکال نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 740.23,
   "end": 742.43,
   "text": "اونم دستور العمل اهل بیته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 742.43,
   "end": 747.55,
   "text": "اونم اهل بیت دستور دادن. اونم راه داره اما به وقتش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 747.55,
   "end": 756.26,
   "text": "الان تو باید بشینی با رفیقات این نوجوونا، جوونا مراتب ارتقای وجودی‌شون و رشد وجودی‌شون رو با همدیگه بحث کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 756.26,
   "end": 760.81,
   "text": "مثلا چه رشته تحصیلی رو انتخاب کنن، چه شغلی رو اختیار کنن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 760.81,
   "end": 762.47,
   "text": "کی ازدواج کنن، اینطوری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 762.47,
   "end": 765.81,
   "text": "نه مسائل جنسی، نه مسائل-- اینا زشته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 765.81,
   "end": 772.63,
   "text": "اینا تو در شأن شماها و ماها نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 772.63,
   "end": 778.47,
   "text": "الان خیلی راحت دختر پسرا تو مدارس میدونم دیگه من چندین سال معلم بودم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 778.47,
   "end": 785.45,
   "text": "راحت میشینن از این مسائل برای همدیگه میگن و یه کسی اگر جسارت ساعت قدس این جلسه منو ببخشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 785.45,
   "end": 787.29,
   "text": "صاحب جلسه منو ببخشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 787.29,
   "end": 792.45,
   "text": "یه کسی اگر دوست دختر و دوست پسر نداشته باشه میگن این اُمُل این بدبخت، این فلان، فلان شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 792.45,
   "end": 795.23,
   "text": "اصلا راهش نمیدن تو جمع‌های خودشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 795.23,
   "end": 799.37,
   "text": "خب ندن. اونا بدبختن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 799.37,
   "end": 801.51,
   "text": "اونها دنیا رو همین دیدن و بس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 801.51,
   "end": 806.71,
   "text": "اونا کورن. اونا \"نحشرهم يوم القيامة عميا\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 806.71,
   "end": 808.69,
   "text": "اونا کور محشور میشن قیامت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 808.69,
   "end": 813.11,
   "text": "اونا نفهمیدن. اونا باطن اشیاء عالم رو ندیدن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 813.11,
   "end": 814.86,
   "text": "که اسماء الله انجلب کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 814.86,
   "end": 816.77,
   "text": "\"علم آدم الأسماء كلها\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 816.77,
   "end": 819.87,
   "text": "آدم اهل بیت امیر المؤمنینه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 819.87,
   "end": 823.71,
   "text": "حقیقت اسماء یعنی باطن اشیا رو همه رو میدونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 823.71,
   "end": 830.63,
   "text": "خب تو نمیخوای زانو بزنی جلوی امیرالمؤمنین بهش بگی باطن این عالمو، باطن دنیا رو به من بگو نشون بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 830.63,
   "end": 836.43,
   "text": "چرا فرمود \"لو كشف القطا مزدت في يقينی\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 836.43,
   "end": 840.05,
   "text": "اگر پرده بیفته هیچ بر یقین من اضافه نمیشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 840.05,
   "end": 845.25,
   "text": "پرده‌ها بیفته یعنی باطن هر چیزی آشکار بشه به یقین علی اضافه نمیشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 845.25,
   "end": 848.19,
   "text": "یعنی من و شما اگر بمیریم به یقینمون اضافه نمیشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 848.19,
   "end": 850.71,
   "text": "چرا؟ \"فبصرك اليوم حديد\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 850.71,
   "end": 852.97,
   "text": "چرا؟ \"فكشفنا عنك قطاعك\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 852.97,
   "end": 856.23,
   "text": "وقتی پرده رو از جلوی چشمات برداریم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 856.23,
   "end": 860.35,
   "text": "چشمت تیز میشه انقدر که یقین ندیده بوده این حقایق رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 860.35,
   "end": 862.73,
   "text": "لقاء الله یعنی این. یعنی الان ببین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 862.73,
   "end": 865.33,
   "text": "لقاء الله یعنی الان ببین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 865.33,
   "end": 866.91,
   "text": "لقاء الله اسم جامع.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 866.91,
   "end": 872.95,
   "text": "یعنی اسماء رو، اسماء عینی رو و باطن‌شون رو الان ببین که مثل مولا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 872.95,
   "end": 878.85,
   "text": "علی اگر از این دنیا رفتی نه مثل مولا \"لمزدد في يقينی\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 878.85,
   "end": 881.73,
   "text": "حداقل یه يقيني بر بعضی از مسائل داشته باشی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 881.73,
   "end": 886.41,
   "text": "حداقل پنجاه درصد. چه میدونم یه درصدی قبلا برات منکشف شده باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 886.41,
   "end": 888.81,
   "text": "پرده افتاده باشه حقایق رو دیده باشی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 888.81,
   "end": 894.21,
   "text": "الان وقتی خلوت میکنی با زنت، با بچه‌هات، با دور و بری‌هات، با رفیقات،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 894.21,
   "end": 897.57,
   "text": "با بچه محلات، با همکلاسی‌هات، همکارات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 897.57,
   "end": 901.13,
   "text": "چهارتا حرف درست حسابی بزنی لذت ببری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 901.13,
   "end": 906.99,
   "text": "نه اراجيف و بیخود مسائل بیخود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 906.99,
   "end": 909.81,
   "text": "این لقاء الله یعنی الان ملاقات کن حقایق رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 909.81,
   "end": 912.11,
   "text": "الان باطن اشیا رو ببین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 214,
   "start": 912.11,
   "end": 916.85,
   "text": "الان از، الان گریه کردی برای امیرالمؤمنین جلوی ایوان طلا نشستی برای حضرت زهرا و بچه هاش قمر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 215,
   "start": 916.85,
   "end": 919.05,
   "text": "بنی هاشم داد زدی دمت گرم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 216,
   "start": 919.05,
   "end": 927.87,
   "text": "ای ولا مردانگی. حالا داد بزن که من میخوام باطن اشیاء این عالم رو ببینم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 217,
   "start": 927.87,
   "end": 932.37,
   "text": "چرا همه شهدا وقت شهادتشون آب خوردن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 218,
   "start": 932.37,
   "end": 936.79,
   "text": "آب خوردن حتی علی اکبر آب خورد از دست پیغمبر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 219,
   "start": 936.79,
   "end": 941.19,
   "text": "تنها شهیدی که آب ننوشیده ابالفضله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 220,
   "start": 941.19,
   "end": 946.45,
   "text": "گفته تا اربابم امام حسین نیاد اینور من آب نمیخورم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 221,
   "start": 946.45,
   "end": 949.53,
   "text": "نگاه کن وزن رو ببین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 222,
   "start": 949.53,
   "end": 953.43,
   "text": "چرا؟ باطن اشیا رو،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 223,
   "start": 953.43,
   "end": 955.73,
   "text": "حقیقت اشیا رو میبینن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 224,
   "start": 955.73,
   "end": 961.11,
   "text": "نه اینکه بقیه نبینن. نه هر کس به سعه وجودیش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 225,
   "start": 961.11,
   "end": 965.05,
   "text": "حالا شما نوجوونا که اینطوری بغل هم امشب نشستید گروه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 226,
   "start": 965.05,
   "end": 973.13,
   "text": "شهید سلیمانی، من توقع دارم این حرفای بنده رو خوب شماها توجه کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 227,
   "start": 973.13,
   "end": 977.59,
   "text": "شهید سلیمانی چهار تا، چهار تا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 228,
   "start": 977.59,
   "end": 979.18,
   "text": "شرط گذاشته بود برای رفیقاش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 229,
   "start": 979.18,
   "end": 982.37,
   "text": "یعنی من با کسی رفیق-- اصلا قبول نمیکنم کسی رفیقم باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 230,
   "start": 982.37,
   "end": 983.99,
   "text": "الا با چهار شرط.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 231,
   "start": 983.99,
   "end": 987.71,
   "text": "بگو ببینم اون شروط چی‌ند. یکیش نماز اول وقته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 232,
   "start": 987.71,
   "end": 989.37,
   "text": "یکیش نداشتن حق الناس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 233,
   "start": 989.37,
   "end": 994.29,
   "text": "یکیش زیارت عاشورای هر روزه. یعنی اگه اینا رو نداشته اصلا طرفو قبول نمیکرده رفیق من باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 234,
   "start": 994.29,
   "end": 997.49,
   "text": "الان شما رفاقتتون based on چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 235,
   "start": 997.49,
   "end": 1000.99,
   "text": "اصلا شرط دارید بر رفاقتتون؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 236,
   "start": 1000.99,
   "end": 1006.76,
   "text": "کو شرطتون؟ شرط شما بر رفاقتتون باید لقاء الله باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 237,
   "start": 1006.76,
   "end": 1012.35,
   "text": "یعنی دیدن باطن اشیا. یعنی کسی میتونه به من نشون بده باطن اشیا رو؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 238,
   "start": 1012.35,
   "end": 1014.75,
   "text": "حکمت و عرفان به من بیاموزه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 239,
   "start": 1014.75,
   "end": 1019.11,
   "text": "علی علم سلطان. اون بهترین رفیقه برای من.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 240,
   "start": 1019.11,
   "end": 1021.97,
   "text": "اون رفیق منه که چشم منو به حقایق باز کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 241,
   "start": 1021.97,
   "end": 1024.93,
   "text": "نه وقتی سرم به سنگ هلهت خورد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 242,
   "start": 1024.93,
   "end": 1028.89,
   "text": "بگم اوه، اوه! چه غلطی کردیم، چه کردیم، اونجا، اینجا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 243,
   "start": 1028.89,
   "end": 1036.81,
   "text": "اونجا چی بود، اینجا چیه؟ یه دنیای عجیب جدیدی به روش باز بشه و هاج و واج مثل بچه که از رحم مادر میاد بیرون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 244,
   "start": 1036.81,
   "end": 1038.93,
   "text": "جیغ، فریاد، ناله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 245,
   "start": 1038.93,
   "end": 1041.75,
   "text": "چه خبرته؟ چته؟ جای به این خوبی و بزرگی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 246,
   "start": 1041.75,
   "end": 1046.07,
   "text": "نفهمیده. نمی فهمه. ندیده اینجا رو تا حالا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 247,
   "start": 1046.07,
   "end": 1050.57,
   "text": "همینطور که از دنیا میری، ما هم اینطوری میشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 248,
   "start": 1050.57,
   "end": 1053.23,
   "text": "شرط بذارید بر رفاقتتون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 249,
   "start": 1053.23,
   "end": 1056.57,
   "text": "کسی هم به ما نمیگه اصلا آقا وقتت تموم شد بسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 250,
   "start": 1056.57,
   "end": 1058.93,
   "text": "جان؟ هفت دقیقه گذشته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 251,
   "start": 1058.93,
   "end": 1063.81,
   "text": "وقت گذشته میگی؟ چرا جرات ندارید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 252,
   "start": 1063.81,
   "end": 1066.47,
   "text": "جرات داشته باشید. تو وقت روضه الحمدالله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 253,
   "start": 1066.47,
   "end": 1071.45,
   "text": "آهنگ‌های درخواستی و حاجی این روضه رو بخون و این شعر رو بخون، این سلقو بخون دارید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 254,
   "start": 1071.45,
   "end": 1074.03,
   "text": "تو معارف ندارید حاجی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 255,
   "start": 1074.03,
   "end": 1080.69,
   "text": "آره اینم درخواسته. والحمد لله گروه هم رفتیم شب عجیب و غریبی بود همه چیش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 256,
   "start": 1080.69,
   "end": 1083.19,
   "text": "منبرش، روضه‌اش، مناجاتش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 257,
   "start": 1083.19,
   "end": 1086.31,
   "text": "خدا شما رفیق‌های عجیب و غریب رو هم از ما نگیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 258,
   "start": 1086.31,
   "end": 1088.25,
   "text": "والحمد لله رب العالمين.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 259,
   "start": 1088.25,
   "end": 1094.61,
   "text": "صلوات ختم کنید. اللهم صل على محمد و آل محمد و عجل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}