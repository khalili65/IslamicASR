 "chapters": [
  {
   "index": 0,
   "title": "## بسم‌الله، استعانت و سلام بر داعی الله",
   "start": 310.5,
   "end": 330.5
  },
  {
   "index": 1,
   "title": "حکمت را علم به احوالِ اعیانِ موجودات گفته‌اند. قرآن نیز بر صورت حکمت است؛ در آغاز یس می‌فرماید:",
   "start": 330.5,
   "end": 409.92
  },
  {
   "index": 2,
   "title": "دو نکتهٔ مهم را در این آیه گوشزد می‌کنم.",
   "start": 409.92,
   "end": 544.26
  },
  {
   "index": 3,
   "title": "## لقاء به‌قدر وسع",
   "start": 544.26,
   "end": 602.02
  },
  {
   "index": 4,
   "title": "آیهٔ دیگری نیز هست که اکنون به ذهن آمد؛ به خدا باید سورهٔ نجم باشد. خدا به پیامبرش می‌فرماید:",
   "start": 602.02,
   "end": 643.54
  },
  {
   "index": 5,
   "title": "## الحمد لله ربّ العالمین؛ ربّ کانال رزق",
   "start": 643.54,
   "end": 734.16
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.08,
   "end": 3.56,
   "text": "بسم الله الرحمن الرحیم و بهین استعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 3.56,
   "end": 8.16,
   "text": "السلام علیک یا داعی الله و ربانی آیاته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 8.16,
   "end": 10.8,
   "text": "سلام علیکم و رحمه الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 10.8,
   "end": 12.8,
   "text": "بحث لقاء الله ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 12.8,
   "end": 16.12,
   "text": "رسیده بود به جایی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 16.12,
   "end": 23.9,
   "text": "چشیدن و رسیدن و دارا شدن باطن‌ها، بواتن، بطون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 23.9,
   "end": 26.84,
   "text": "ظاهرها و ظواهر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 26.84,
   "end": 33.38,
   "text": "رو ما چاره‌ای ازش نداریم و یک م-- به یک معنا لقاء",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 33.38,
   "end": 36.18,
   "text": "عرض شود خدمتتون این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 36.18,
   "end": 46.04,
   "text": "حقایق نظام هستی می‌شود همون لقاء و بوی لقاء می‌دهد که کلمات وجودی نظام هستی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 46.04,
   "end": 51.54,
   "text": "الا ماشاالله لا تا حد و لا تا حد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 51.54,
   "end": 55.7,
   "text": "تمام شدنی هم نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 55.7,
   "end": 60.32,
   "text": "براتون برای اینکه کامتون شیرین بشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 60.32,
   "end": 67.2,
   "text": "امروز صبح درآوردم از قرآن آیه صد و نه سوره کهف رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 67.2,
   "end": 73.06,
   "text": "قل چون ما می‌خوایم این کلمات وجودی نظام هستی رو بچشیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 73.06,
   "end": 81.38,
   "text": "به لقاء اون‌ها برسیم که به یک معنا همون حقیقت علم حکمت هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 81.38,
   "end": 83.06,
   "text": "همون حقیقت حکمت هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 83.06,
   "end": 85.48,
   "text": "که یٰسٓ إِنَّ الْقُرْآنَ لَحَکیمْ.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 85.48,
   "end": 90.6,
   "text": "که علم به احوال اعیان موجودات می‌شد حکمت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 90.6,
   "end": 93.96,
   "text": "حالا قرآن داره می‌فرماید آیه صد و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 93.96,
   "end": 96.26,
   "text": "نه سوره کهف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 96.26,
   "end": 104.68,
   "text": "\"قل لو کان البحر مدادا لكلمات ربي\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 104.68,
   "end": 108.54,
   "text": "دو تا نکته مهم رو میخوام تو این آیه گوشزد کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 108.54,
   "end": 113.22,
   "text": "بهشون بگو پیغمبر که اگر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 113.22,
   "end": 119.36,
   "text": "البحر، البحر مدادا اگر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 119.36,
   "end": 123.62,
   "text": "این بحر، این دریا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 123.62,
   "end": 129.02,
   "text": "می‌شد چی؟ جوهری برای نوشتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 129.02,
   "end": 132.8,
   "text": "برای چی بنویسی؟ لكلمات ربي",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 132.8,
   "end": 138.54,
   "text": "که کلمات ربي این کلمات وجودی نظام هستی رو، این کلمات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 138.54,
   "end": 140.9,
   "text": "پروردگار مرا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 140.9,
   "end": 144.14,
   "text": "بخواهد بنویسد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 144.14,
   "end": 147.98,
   "text": "لـ-- لنفد البحر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 147.98,
   "end": 151.5,
   "text": "قبل أن تنفد كلمات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 151.5,
   "end": 155.06,
   "text": "ربي. یعنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 155.06,
   "end": 163.64,
   "text": "قبل از اینکه کلمات پروردگار من باز میگه ربي تو اینجا هم یه نکته‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 163.64,
   "end": 168.86,
   "text": "قبل از اینکه این کلمات وجودی پروردگار من تمام بشود،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 168.86,
   "end": 177.64,
   "text": "اون مرکبه و این‌ها تمام شده و قلم از کار افتاده است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 177.64,
   "end": 182.82,
   "text": "این یه آیه. آیه بعدی هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 182.82,
   "end": 188.16,
   "text": "خدمتتون عرض شود که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 188.16,
   "end": 208.16,
   "text": "آیه سوره لقمان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 208.32,
   "end": 213.08,
   "text": "حالا اینجا نشونه گذاشتم ولی پیداش نمی‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 213.08,
   "end": 220.52,
   "text": "یه صلوات بفرستین. اللهم صل على محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 220.52,
   "end": 225.02,
   "text": "و آله محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 225.02,
   "end": 231.32,
   "text": "بله پیدا شد. آیه بیست و هفت بله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 231.32,
   "end": 234.13,
   "text": "آیه بیست و هفت رو براتون بخونم ببینید چی می‌فرماید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 234.13,
   "end": 248.56,
   "text": "\"ولو أنما في الأرض من شجرة أقلام والبحر يمده من بعده سبعة أبحر ما نفدت كلمات الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 248.56,
   "end": 252.8,
   "text": "إن الله عزيز حكیم\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 252.8,
   "end": 255.36,
   "text": "اینجا هم داره میگه که اینجا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 255.36,
   "end": 259.66,
   "text": "یه مقدار بحث رو گسترش داده رو چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 259.66,
   "end": 263.88,
   "text": "شجرة أقلام یعنی درخت‌ها بشن چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 263.88,
   "end": 268.94,
   "text": "قلم. \"والبحر يمده من بعده\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 268.94,
   "end": 275.68,
   "text": "چند تا بعد از این قلم‌ها چند تا دریا بشن مرکب؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 275.68,
   "end": 278.38,
   "text": "فرمود \"سبعة أبحر\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 278.38,
   "end": 282.98,
   "text": "هفت تا. یعنی بحث رو کشونده بالا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 282.98,
   "end": 285.5,
   "text": "خب؟ هفت هم که عدد کثرته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 285.5,
   "end": 289.68,
   "text": "خب. \"ما نفدت كلمات الله إن الله عزيز حكیم\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 289.68,
   "end": 293.02,
   "text": "اون کلماتی که ما الان داریم میگیم باید بریم به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 293.02,
   "end": 295.64,
   "text": "لقایش برسیم چی؟ ما نفدت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 295.64,
   "end": 302.5,
   "text": "تمام شدنی نیست. این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 302.5,
   "end": 310.5,
   "text": "به یک معنا اون کلمات وجودی نظام هستی که حالا یه دونه از این کلمات ما هستیم و کلمات طامات الهی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 310.5,
   "end": 313.7,
   "text": "خود اهل بیت علیهم الصلاة والسلام هستند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 313.7,
   "end": 315.92,
   "text": "ما قراره به لقای این‌ها برسیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 315.92,
   "end": 320.12,
   "text": "یک معنای لقاء می‌شد چشیدن این کلمات نظام هستی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 320.12,
   "end": 324.88,
   "text": "و الا اون ثق ذات حضرت حق، اون ذات غیب الغیوب و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 324.88,
   "end": 329.54,
   "text": "غنی عن العالمین رو که اهدی نمی‌تونه به اون برسه و اونو لقاء کنه و اونو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 329.54,
   "end": 333.38,
   "text": "برسه و ملاقات کنه که نه، این کلمات وجود نظام هستی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 333.38,
   "end": 335.74,
   "text": "مثلا پیغمبر تشریف بردن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 335.74,
   "end": 338.96,
   "text": "به مقام صادر اول رسیدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 338.96,
   "end": 343.42,
   "text": "زیارت وجود منبسط رو کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 343.42,
   "end": 345.7,
   "text": "به یک معنا زیارت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 345.7,
   "end": 351.36,
   "text": "مد رو کردن. \"أَلَمْ تَرَ إِلَىٰ رَبِّكَ كَيْفَ مَدَّ الظِّلَّ\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 351.36,
   "end": 353.5,
   "text": "الظِّلَّ وجود منبسط بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 353.5,
   "end": 355.76,
   "text": "اون وجود منبسط اول،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 355.76,
   "end": 358.96,
   "text": "اون وجود اهدی حضرت حق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 358.96,
   "end": 362.86,
   "text": "که گفتیم همه این کلمات وجودی مندمج در او هستند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 362.86,
   "end": 369.24,
   "text": "خب؟ وجود ما وسط دوم، اون صادر اول بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 369.24,
   "end": 372.48,
   "text": "پیغمبر رفت تا اونجا که دیشب عرض کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 372.48,
   "end": 375.08,
   "text": "به اون مقام رسید یعنی چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 375.08,
   "end": 381.3,
   "text": "یعنی همه این کلمات مادون رو چشید، درک کرد، رفت به حقیقتش رسید،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 381.3,
   "end": 386.64,
   "text": "ملاقات کرد این‌ها رو. به لقای این حقایق رسید و رفت بالا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 386.64,
   "end": 390.36,
   "text": "همه این‌ها تازه شدن ش-شعنی از شؤون او.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 390.36,
   "end": 393.6,
   "text": "خب حالا داره میره که به اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 393.6,
   "end": 399.48,
   "text": "اسم مستعفره، به اون یعنی اون رو ملاقات کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 399.48,
   "end": 403.16,
   "text": "توجه کردید؟ ما هم پشت سرش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 403.16,
   "end": 407.66,
   "text": "حالا هر مقدار که بتوانی از این کلمات وجودی نظام هستی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 407.66,
   "end": 413.98,
   "text": "یکیش خودتی برسی به لقا، به اون لقای نهایی رس- نزدیک شدی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 413.98,
   "end": 416.64,
   "text": "حالا اونچه که اینجا رو،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 416.64,
   "end": 419.22,
   "text": "این تا اینجا رو بحث کلمات و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 419.22,
   "end": 421.5,
   "text": "این نفاد نداشتنشون،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 421.5,
   "end": 425.76,
   "text": "نفاد نداشتنشون یعنی فانی نشدنشون، تمام نشدنشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 425.76,
   "end": 428.02,
   "text": "یه بحث هم رو اون ربی داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 428.02,
   "end": 433.76,
   "text": "اونجا پیغمبر می‌فرماید که کلمات پروردگار من،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 433.76,
   "end": 437.2,
   "text": "تو اون آیه اولیه که خوندیم، چه سوره ای بود؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 437.2,
   "end": 439.28,
   "text": "سوره کف بود. آیه چند بود؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 439.28,
   "end": 441.22,
   "text": "صد و نه هستن. احسنت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 441.22,
   "end": 446.38,
   "text": "اونجا می‌فرماید که \"لکلمات ربی\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 446.38,
   "end": 453.64,
   "text": "دو بارم ربی میاره. پروردگار من، کلمات پروردگار من تمام شدنی نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 453.64,
   "end": 456.72,
   "text": "پروردگار من. اینجا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 456.72,
   "end": 458.56,
   "text": "چی رو ما داریم می‌زنیم الان؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 458.56,
   "end": 460.54,
   "text": "متوجه‌تون به چی می‌کنیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 460.54,
   "end": 464.84,
   "text": "رب ما. احسنت. اون که \"یا ایها الانسان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 464.84,
   "end": 470.02,
   "text": "انک کادح الی ربک کدحا فملاقی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 470.02,
   "end": 474.34,
   "text": "ه\". هرکی رب خودش رو زیارت می‌کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 474.34,
   "end": 480.36,
   "text": "و \"اقرأ بسم ربک الذي خلق\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 480.36,
   "end": 488.4,
   "text": "یه آیه دیگه هم داریم که الان تو ذهنم اومد، به خدا سوره نجم باید باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 488.4,
   "end": 491.58,
   "text": "به خدا، خدا به پیغمبرش می‌فرماید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 491.58,
   "end": 496.84,
   "text": "\"ان الی ربکل منتهی\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 496.84,
   "end": 503.16,
   "text": "خدا به پیغمبرش می‌فرماید \"ان الی ربک المنتهی\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 503.16,
   "end": 505.66,
   "text": "رب تو. کجا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 505.66,
   "end": 507.82,
   "text": "منتهی. یعنی اصلا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 507.82,
   "end": 510.58,
   "text": "اون رب تو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 510.58,
   "end": 514.1,
   "text": "به انتها رسیده. یعنی اصلا دیگه همه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 514.1,
   "end": 516.6,
   "text": "رو-- ارباب، هم-- اصلا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 516.6,
   "end": 523.34,
   "text": "ارباب که جمع ربه، همه و همه مستهلک در رب تواند که ربک کیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 523.34,
   "end": 526.88,
   "text": "المنتهی. یعنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 526.88,
   "end": 530.36,
   "text": "اون رب تو ربی‌ست که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 530.36,
   "end": 537.88,
   "text": "همونطور که کلمات وجودی نظام هستی نفاد نداره، رب تو هم المنتهی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 537.88,
   "end": 542.96,
   "text": "ببینید سعه وجودی پیغمبر به کجا رسیده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 542.96,
   "end": 546.44,
   "text": "توجه کردید؟ حالا رب من و تو چقدره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 546.44,
   "end": 557.4,
   "text": "چی-چجوریه که به جدول وجودی و حصه وجودی ما مرتبطه و اون جدا شده از الله، منتشر شده از اسم الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 557.4,
   "end": 561.48,
   "text": "که ما بتونیم از الله رزق‌مون رو از طریق رب بگیریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 561.48,
   "end": 566.64,
   "text": "لذا شده \"الحمد لله رب العالمين\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 566.64,
   "end": 569.8,
   "text": "الحمد لله الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 569.8,
   "end": 572.16,
   "text": "کدوم الله؟ رب العالمين.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 572.16,
   "end": 577.06,
   "text": "چرا رب بعد الله؟ الله خواسته به هر کدوم از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 577.06,
   "end": 582.42,
   "text": "او-- این کلمات وجودی نظام هستی رزق‌شون رو به فراخوهایشان برسونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 582.42,
   "end": 586.17,
   "text": "هر کدوم از این کلمات که یه دونه‌ش شما هستی رزقی داری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 586.17,
   "end": 589.12,
   "text": "این رزق رو الله با چه کانالی می‌رسونه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 589.12,
   "end": 597.76,
   "text": "رب. اون حصه وجودی تو، اون جدول وجودی‌ست که وصل به دریای الوهیت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 597.76,
   "end": 601.7,
   "text": "یعنی الله، اون دریای بی‌-- لایتناهی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 601.7,
   "end": 603.38,
   "text": "اون رب تو می‌شود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 603.38,
   "end": 605.34,
   "text": "رزق تو از اونجا میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 605.34,
   "end": 608.8,
   "text": "حالا ببین پیغمبر چه رزقی داره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 608.8,
   "end": 613.64,
   "text": "که می‌گه \"ان الی ربکل منتهی\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 613.64,
   "end": 616.04,
   "text": "اصلا انتها نداره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 616.04,
   "end": 618.92,
   "text": "رزق تو چون رب تو انتها نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 618.92,
   "end": 622.0,
   "text": "و اینجا می‌گه، می‌فرماید کلمات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 622.0,
   "end": 626.12,
   "text": "پروردگار من، رب من نفاد نداره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 626.12,
   "end": 628.96,
   "text": "تمام شدنی نیست. توجه کردید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 628.96,
   "end": 632.04,
   "text": "حالا رب من و شما چگونه است؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 632.04,
   "end": 634.0,
   "text": "بسم الله مهک بزن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 634.0,
   "end": 636.26,
   "text": "رب من و شما چگونه است؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 636.26,
   "end": 641.5,
   "text": "رفقا رمزی رو امروز فاش کردم که باید روش یه منبر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 641.5,
   "end": 644.24,
   "text": "استخوندار می‌رفتیم تا به این برسیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 644.24,
   "end": 648.46,
   "text": "به برکت نادبه تو ده دقیقه، ده دوازده دقیقه رسیدیم بهش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 648.46,
   "end": 650.32,
   "text": "می‌خوای مهک بزنی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 650.32,
   "end": 652.72,
   "text": "ربت، رب تو،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 652.72,
   "end": 654.8,
   "text": "اون سعه رب تو،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 654.8,
   "end": 658.2,
   "text": "اون کانال وجودی تو که مت-متصله به اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 658.2,
   "end": 664.26,
   "text": "دریای بیکران، سعه‌ش چگونه است که قراره تو رو زیارت کنی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 664.26,
   "end": 667.22,
   "text": "چون فملاقی ه برمی‌گرده به ربک.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 667.22,
   "end": 671.28,
   "text": "\"یا ایها الانسان انک کادح الی ربک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 671.28,
   "end": 674.38,
   "text": "فملاقی ه\". کدح فملاقی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 674.38,
   "end": 678.88,
   "text": "این سعه رب خودت رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 678.88,
   "end": 681.62,
   "text": "حالا انشالله خدا ما رو ببخشه اینطوری حرف می‌زنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 681.62,
   "end": 689.56,
   "text": "کم و کیف این رب خودت رو که قراره به ملاقاتش برسی از کجا بفهمم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 689.56,
   "end": 691.78,
   "text": "حال و روزشو از کجا بفهمم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 691.78,
   "end": 694.56,
   "text": "الان گفتیم سرشو، از رزقت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 694.56,
   "end": 698.28,
   "text": "تمام. یه مهک.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 698.28,
   "end": 700.48,
   "text": "از رزقت. الان ثابت کردیم دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 700.48,
   "end": 702.6,
   "text": "از طریق رب رزق می‌رسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 702.6,
   "end": 707.1,
   "text": "الله از طریق کانال وجودی‌ش که اسمش ربه به ما رزق می‌رسونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 707.1,
   "end": 710.46,
   "text": "خب اون حال رب چگونه است؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 710.46,
   "end": 712.58,
   "text": "اون رب اصلا چگونه است نس--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 712.58,
   "end": 715.4,
   "text": "که ما می‌خوایم زیارتش کنیم؟ رزقتو نگاه کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 715.4,
   "end": 727.12,
   "text": "هر رزقی. رزق مادی، معنوی، علمی، جسمی، روحی، دنیوی، اخروی، هرچه، همه، اِ-- رزقت دیگه رزق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 727.12,
   "end": 731.24,
   "text": "که اون سعه وجودیت رو تشکیل داده.",
