   "start": 48.06,
   "end": 88.92
  },
  {
   "index": 2,
   "title": "## القا و اخذ؛ جایی که ربط وجودی بسته می‌شود",
   "start": 88.92,
   "end": 119.06
  },
  {
   "index": 3,
   "title": "## نحن أیام الله؛ یوم یعنی ظرف ظهور",
   "start": 119.06,
   "end": 159.84
  },
  {
   "index": 4,
   "title": "اهل‌بیت فرموده‌اند:",
   "start": 159.84,
   "end": 189.08
  },
  {
   "index": 5,
   "title": "## نام‌گذاری روزهای هفته در مفاتیح",
   "start": 189.08,
   "end": 246.62
  },
  {
   "index": 6,
   "title": "## قوس صعود؛ هر کس به‌سوی ربط‌های وجودی‌اش می‌رود",
   "start": 246.62,
   "end": 287.94
  },
  {
   "index": 7,
   "title": "## همه به‌سوی اسماء الله؛ قوس نزول و قوس صعود",
   "start": 287.94,
   "end": 375.12
  },
  {
   "index": 8,
   "title": "این‌ها اسماء جلالیه و قهر خدایند؛ و این‌ها در الله‌اند. دقت بفرمایید.",
   "start": 375.12,
   "end": 397.5
  },
  {
   "index": 9,
   "title": "## جلال اهل‌بیت و جهنم به‌عنوان اسم جلال",
   "start": 397.5,
   "end": 450.42
  },
  {
   "index": 10,
   "title": "اصلاً همهٔ عالم به‌سوی الله می‌روند. همهٔ موجودات، مطلقاً همه، به‌سوی الله‌اند. امر را خدا تدبیر می‌کند:",
   "start": 450.42,
   "end": 478.16
  },
  {
   "index": 11,
   "title": "## نتیجه: صاحبِ روز؛ جلال پیامبر، زهرا، امیرالمؤمنین و امام عصر",
   "start": 478.16,
   "end": 546.66
  },
  {
   "index": 12,
   "title": "## اهل ایمان؛ آغوش صاحب روز",
   "start": 546.66,
   "end": 592.34
  },
  {
   "index": 13,
   "title": "## حدیث امام رضا از امیرالمؤمنین در توحید صدوق؛ باطن حروف",
   "start": 592.34,
   "end": 695.54
  },
  {
   "index": 14,
   "title": "## از حرف طاء تا حرف ظاء",
   "start": 695.54,
   "end": 779.25
  },
  {
   "index": 15,
   "title": "## حدیث قدسی؛ من نزد گمان بنده‌ام هستم",
   "start": 779.25,
   "end": 853.34
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.06,
   "end": 2.58,
   "text": "یه حرفی ما زدیم بچه‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 2.58,
   "end": 7.24,
   "text": "گذاشتنش تو کانال هیئت و یه سری بحث برانگیز شد و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 7.24,
   "end": 12.3,
   "text": "چون بعضیا گفتن ربط وجودی ایجاد میشه بین کسی که میره با چه روزی میره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 12.3,
   "end": 16.32,
   "text": "اینا بعضیا اینو قبول نکردن. من یه چیزی، یه سری رو برای شما فاش کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 16.32,
   "end": 21.34,
   "text": "اگر این یه اصله به شما القا کنم این اصلو همیشه یادتون باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 21.34,
   "end": 30.14,
   "text": "حتی مشایخ ما می‌گفتن اگر لحظه‌ای که از دنیا میخوای بری، اون کسایی که باهاشون ربط وجودی پیدا کردی میان سر،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 30.14,
   "end": 35.04,
   "text": "میان لحظه‌ی جان دادنت، لحظه‌ی لقاء میان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 35.04,
   "end": 42.62,
   "text": "یکی از اونایی که ربط وجودی باهاشون پیدا می‌کنی مثلا معلمته، استادته، اون کسی که طریق و راه رو به تو یاد داده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 42.62,
   "end": 46.26,
   "text": "\"یوم ندعو کل أناس بإمامهم\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 46.26,
   "end": 51.36,
   "text": "این آیه‌شه. روزی که همه پشت سر امامشون محشور میشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 51.36,
   "end": 56.08,
   "text": "این امام اینجا صرفا منظور امام معصوم نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 56.08,
   "end": 64.32,
   "text": "تفاسیر رو مراجعه کرده باشید اونجا فرمودن پیشوای تو، جلودارتو، کسی که راه رو به تو یاد داده، اون،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 64.32,
   "end": 69.76,
   "text": "اون هم میاد. لذا اون مثالی که زدم، اون روضه‌خون لب شه-- مرگش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 69.76,
   "end": 72.78,
   "text": "سی و پنج تا از شهدای کربلا اومدن کنارش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 72.78,
   "end": 75.72,
   "text": "گفت چرا شماها فقط ما شنیده به هفتاد و دو تا بودید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 75.72,
   "end": 80.8,
   "text": "فرمود توئه ذاکر اهل بیت تو جلساتت فقط ما سی و پنج تا یاد کرده بودی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 80.8,
   "end": 85.56,
   "text": "ببین این یاد کردن حتی ربط وجودی میاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 85.56,
   "end": 88.92,
   "text": "یکی از جاهایی که-- اینو خوب گوش بدید به دردتون می‌خوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 88.92,
   "end": 93.44,
   "text": "یکی از جاهایی که ربط وجودی برقرار میشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 93.44,
   "end": 96.8,
   "text": "اینه که من در مقام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 96.8,
   "end": 101.36,
   "text": "القا قرار بگیرم، بخوام با تمام وجودم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 101.36,
   "end": 109.54,
   "text": "حقیقتی رو، رو حساب دارم این کلماتو استفاده می‌کنم، نه باطل، حقیقتی رو به تو القا کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 109.54,
   "end": 112.58,
   "text": "اگر تو، اون مخاطب،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 112.58,
   "end": 117.56,
   "text": "اون هم با تمام قوا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 117.56,
   "end": 120.72,
   "text": "آماده اخذ این القا باشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 120.72,
   "end": 123.22,
   "text": "این الهام باشه، خب؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 123.22,
   "end": 128.14,
   "text": "هر دو این با تمام قوا می‌خواد انتقال بده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 128.14,
   "end": 130.02,
   "text": "تلقین کنه به اصطلاح",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 130.02,
   "end": 134.62,
   "text": "القا کنه. اون که مخاطب در مقام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 134.62,
   "end": 137.56,
   "text": "مخاطب قرار گرفته می‌خواد بگیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 137.56,
   "end": 142.48,
   "text": "اینجا یکی از جاهایی است که ربط وجودی برقرار میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 142.48,
   "end": 147.18,
   "text": "به طوری که تو با تمام وجودت امام عصرتو صدا بزنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 147.18,
   "end": 152.24,
   "text": "و آقام قطعا با تمام وجود لبیک میگه، ربط وجودی برقرار میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 152.24,
   "end": 155.66,
   "text": "بین شما و ایام، ایام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 155.66,
   "end": 159.84,
   "text": "اهل بیت فرمودن \"نحن أيام الله\" ما ایام خداییم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 159.84,
   "end": 162.5,
   "text": "يوم یعنی ظرف ظهور.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 162.5,
   "end": 164.88,
   "text": "ظرف قبلا عرض شده خدمتون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 164.88,
   "end": 170.98,
   "text": "ظرفی که ظهور میشه درش بهش اصطلاحا در حکمت و فلسفه میگن يوم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 170.98,
   "end": 175.22,
   "text": "ظرف ظهور اشیاعه. يوم الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 175.22,
   "end": 177.9,
   "text": "یعنی ظرف ظهور الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 177.9,
   "end": 182.06,
   "text": "اهل بیت فرمودن ما ی-- \"نحن أيام الله\" ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 182.06,
   "end": 186.32,
   "text": "روزهای الهی هستیم، یعنی ما ظرف ظهور",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 186.32,
   "end": 189.08,
   "text": "اللهیم. اینا تا اینجا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 189.08,
   "end": 195.16,
   "text": "بعد شما تو مفاتیح اون روایت شریف آخ-- عاشق عباس قمی که آورده ببینید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 195.16,
   "end": 198.0,
   "text": "هفت-- روز هفته رو به نام اهل بیت گذاشته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 198.0,
   "end": 204.04,
   "text": "شنبه پیغمبر، یکشنبه امیرالمؤمنین، حضرت زهرا، دوشنبه امام حسن، امام حسین همینطور میان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 204.04,
   "end": 207.16,
   "text": "تا جمعه امام عصر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 207.16,
   "end": 212.52,
   "text": "یک یک این ایام بی‌دلیل به نام اهل بیت نامگذاری نشدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 212.52,
   "end": 216.28,
   "text": "هر کس که توی اون روز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 216.28,
   "end": 219.54,
   "text": "به سمت حقیقت حرکت کنه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 219.54,
   "end": 226.72,
   "text": "حالا این به سمت حرکت-- حقیقت حرکت کنه یا در نشئه طبیعته که میشه موت قبل أن تموتو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 226.72,
   "end": 231.74,
   "text": "یا نه فارغ شده از نشئه طبیعت و می‌خواد بره به عالم الوهی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 231.74,
   "end": 235.76,
   "text": "بره اون بالا حالا به لقاء رب خودش حداقل برسه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 235.76,
   "end": 241.26,
   "text": "اونجام میر-میره به سمت اون حقیقت دیگه و \"إنا إليه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 241.26,
   "end": 244.18,
   "text": "راجعون\". إليه راجعون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 244.18,
   "end": 246.62,
   "text": "قوس صعود. میرن همه اونجا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 246.62,
   "end": 250.48,
   "text": "حالا در این قوس صعود که همه دارن حرکت می‌کنن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 250.48,
   "end": 255.82,
   "text": "هر کی میره به سمت چیزهایی که با اونها ربط وجودی برقرار کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 255.82,
   "end": 262.44,
   "text": "حالا اگر یه کافر، یه مشرک، یه منافق در روز شنبه از دنیا بره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 262.44,
   "end": 265.76,
   "text": "آیا ربط وجودی بین او و رسول الله هست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 265.76,
   "end": 269.42,
   "text": "به نظر شما هست؟ یه کافر، یه مشرک منافق،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 269.42,
   "end": 272.24,
   "text": "اصلا از خدا بی‌خبر، شنبه از دنیا رفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 272.24,
   "end": 278.12,
   "text": "این اشکالی بود که بعضیا تو کانال اونجا مطرح کرده بودن با ادمین کانال و به ما رسید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 278.12,
   "end": 280.74,
   "text": "من در جواب پاسخ البته نیستم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 280.74,
   "end": 283.7,
   "text": "نمی‌دونم چی شده یه دفعه اینو مطرح کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 283.7,
   "end": 285.76,
   "text": "جوابش مفصل یه وقت دیگه میدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 285.76,
   "end": 294.48,
   "text": "یه چیزکی می‌خوام عرض کنم. ببینید همه‌ی ما در حرکتمون به سمت خدا میریم به سمت اسماء الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 294.48,
   "end": 298.36,
   "text": "همه میریم به سمت الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 298.36,
   "end": 300.87,
   "text": "الله و \"إنا إليه راجعون\" دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 300.87,
   "end": 307.46,
   "text": "\"إنا لله\" ما از سمت خدا اومدیم قوس نزول و \"إنا إليه راجعون\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 307.46,
   "end": 309.88,
   "text": "این إليه میشه همون الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 309.88,
   "end": 312.3,
   "text": "چون إنا لالله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 312.3,
   "end": 317.18,
   "text": "ما میریم به سمت الله. الله مستجمع جميع اسماء و صفاته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 317.18,
   "end": 320.38,
   "text": "أعم از جلالی و جمالی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 320.38,
   "end": 323.54,
   "text": "شما بفرما ببینم اسماء جمال مثل چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 323.54,
   "end": 327.24,
   "text": "اسماء لطف خداست. غفاره، ستاره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 327.24,
   "end": 330.08,
   "text": "وهابه، هم-- رحیمه، رحمان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 330.08,
   "end": 334.08,
   "text": "خب بالاخره اینا هم اسماء لطف همه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 334.08,
   "end": 338.98,
   "text": "اما آیا الله فقط اسماء لطف رو داره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 338.98,
   "end": 340.8,
   "text": "اسماء جمال رو داره؟ نه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 340.8,
   "end": 343.06,
   "text": "مستجمع جميع اسماء.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 343.06,
   "end": 345.36,
   "text": "اسماء قهر رو هم داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 345.36,
   "end": 348.92,
   "text": "یعنی خدا ذو انتقام هست یا نه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 348.92,
   "end": 350.96,
   "text": "المنتقم اسم خدا هست یا نه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 350.96,
   "end": 356.98,
   "text": "هست دیگه. ز-- مثلا القهار هست یا نه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 356.98,
   "end": 360.78,
   "text": "هست. مثلا شدید العقاب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 360.78,
   "end": 363.54,
   "text": "هست. سریع الحساب هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 363.54,
   "end": 365.52,
   "text": "اینا ه-- اصلاً خود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 365.52,
   "end": 367.1,
   "text": "جلال، اسم جلال.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 367.1,
   "end": 371.82,
   "text": "اینا اسماء جلالیه و قهر خدا در الله‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 371.82,
   "end": 375.12,
   "text": "دقت بفرمایید. می‌فرماید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 375.12,
   "end": 379.82,
   "text": "ما از الله اومدیم. قوس نزول.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 379.82,
   "end": 382.54,
   "text": "در قوس صعود میریم به سمت الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 382.54,
   "end": 387.18,
   "text": "خب الله مستجمع جميع اسماءه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 387.18,
   "end": 397.5,
   "text": "پس پیدا شد که عده‌ای میرن به سمت اسماء جلال خدا، عده‌ای میرن به سمت اسماء جمال خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 397.5,
   "end": 399.5,
   "text": "علامه حسن زاده می‌فرمود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 399.5,
   "end": 402.6,
   "text": "مظهر یا تجلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 402.6,
   "end": 405.34,
   "text": "جلال خدا. یه جا دیگه می‌فرمود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 405.34,
   "end": 408.06,
   "text": "مثلاً مرحوم ابن عربی می‌فرمود جلال خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 408.06,
   "end": 410.32,
   "text": "علامه حسن زاده می‌فرمود جلال سید الشهدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 410.32,
   "end": 413.24,
   "text": "همش هم در طول هم‌ند، فرقی نمی‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 413.24,
   "end": 416.74,
   "text": "مظهر یا تجلی جلال امیرالمؤمنین،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 416.74,
   "end": 422.1,
   "text": "مظهر تجلی مثلاً پیغمبر از همه‌شون چهارده نور پشت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 422.1,
   "end": 426.88,
   "text": "تجلی جلالشون شده جهنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 426.88,
   "end": 430.04,
   "text": "اصلاً جهنم، جهنم هم اسم اللهه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 430.04,
   "end": 432.62,
   "text": "منتها اسم جلال خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 432.62,
   "end": 434.52,
   "text": "اسم قهر خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 434.52,
   "end": 438.74,
   "text": "اما اونم اسم اللهه. اصلاً همه عالم به سمت الله میرن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 438.74,
   "end": 445.48,
   "text": "همه موجودات مطلقا همه به سمت الله‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 445.48,
   "end": 450.42,
   "text": "امر رو خدا تدبیر می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 450.42,
   "end": 454.28,
   "text": "دوباره این قوس نزول. تدبیر خدا از آسمان به زمینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 454.28,
   "end": 456.36,
   "text": "اومدیم ما از اون عالم بالا اومدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 456.36,
   "end": 461.18,
   "text": "ما اونجایی بودیم اومدیم. حالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 461.18,
   "end": 462.8,
   "text": "دو مرتبه رجوع می‌کنی به اون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 462.8,
   "end": 465.96,
   "text": "به کی؟ الله. پس همه به سمت الله‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 465.96,
   "end": 469.32,
   "text": "یعنی آقا مشرک و منافق و کفار هم میرن به سمت الله؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 469.32,
   "end": 471.72,
   "text": "بله. به کدوم سمت؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 471.72,
   "end": 474.86,
   "text": "به سمت اسماء قهر، جلال.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 474.86,
   "end": 477.24,
   "text": "که تجلیش شده چی؟ جهنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 477.24,
   "end": 480.12,
   "text": "به همین راحتی. پس نتیجه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 480.12,
   "end": 483.4,
   "text": "اگر کسی روز شنبه از دنیا بره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 483.4,
   "end": 486.22,
   "text": "کافر باشه، مشرک باشه، منافق باشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 486.22,
   "end": 488.86,
   "text": "چنین کسی میره به سمت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 488.86,
   "end": 491.24,
   "text": "جلال پیغمبر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 491.24,
   "end": 495.84,
   "text": "چون روز شنبه روز یا ظرف ظهور پیغمبره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 495.84,
   "end": 498.16,
   "text": "خودش فرمود یوم الله این دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 498.16,
   "end": 507.22,
   "text": "نحنا ایام الله. اگر کسی روز یکشنبه از دنیا بره، کافر باشه، مشرک باشه، عاصی باشه، گناهکار،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 507.22,
   "end": 510.55,
   "text": "میره به سمت جلال حضرت زهرا و امیرالمؤمنین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 510.55,
   "end": 515.46,
   "text": "اوه، اوه، اوه! یکپارچه جلال‌اند این دو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 515.46,
   "end": 519.08,
   "text": "یکپارچه جلالت‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 519.08,
   "end": 522.7,
   "text": "حالا یه کسی روز جمعه بره، آدم پستی باشه، خبیث باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 522.7,
   "end": 524.8,
   "text": "اوه، اوه! اینو دیگه نگو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 524.8,
   "end": 527.54,
   "text": "میره به سمت جلالت امام عصر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 527.54,
   "end": 532.88,
   "text": "آقا این که چه لحظه‌ای، چه ساعتی، چه یومی که ظرف ظهوره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 532.88,
   "end": 537.5,
   "text": "از دنیا بری کاملاً مرتبطه با صاحب اون روز.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 537.5,
   "end": 542.04,
   "text": "ربط وجودیه. منتها اینکه چگونه ربط وجودیه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 542.04,
   "end": 544.48,
   "text": "این باید باز بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 544.48,
   "end": 546.66,
   "text": "مثل الان که ما یه وجهش رو باز کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 546.66,
   "end": 549.88,
   "text": "اما انشاالله اهل ایمان، شما خوبان، باصفاها،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 549.88,
   "end": 551.96,
   "text": "با مرام‌ها از دنیا برین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 551.96,
   "end": 553.96,
   "text": "بالاخره یکی از این ایام میریم دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 553.96,
   "end": 556.3,
   "text": "جز این نیست که از شنبه تا جمعه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 556.3,
   "end": 559.7,
   "text": "کسی که روز شنبه از دنیا میره اهل ایمانه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 559.7,
   "end": 563.1,
   "text": "میره تو بغل پیغمبر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 563.1,
   "end": 566.08,
   "text": "کسی که روز یکشنبه از دنیا میره اهل ایمانه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 566.08,
   "end": 570.2,
   "text": "چون ربط وجودی اون روز با حضرت زهراست و امیرالمؤمنین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 570.2,
   "end": 574.02,
   "text": "خانم باشه میره تو بغل پ-- حضرت زهرا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 574.02,
   "end": 577.06,
   "text": "آقا باشه میره تو بغل آقا امیرالمؤمنین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 577.06,
   "end": 580.42,
   "text": "به، به، به! حالا کسی روز جمعه بره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 580.42,
   "end": 584.46,
   "text": "به، به، به! میره تو بغل امام عصرش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 584.46,
   "end": 587.92,
   "text": "توجه کردی چی شد؟ این‌ها ربط وجودی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 587.92,
   "end": 598.37,
   "text": "اون بحث ما شب‌های جمعه لقاء الله بود گفتیم همه ما بر اساس آیات قرآن قراره به لقاء حداقل رب خودمون برسیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 598.37,
   "end": 605.06,
   "text": "درسته؟ لقاء رب خودمون این بود که بچشیم باطن این عالم رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 605.06,
   "end": 607.1,
   "text": "و باطن اسماء الهی رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 607.1,
   "end": 615.7,
   "text": "عزیزان همه می‌دونید بر اساس درس و بحث‌هایی که داشتیم تک تک کلمات نجا-- نظام هستی که یکی‌ش شمایید، اسم اللهید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 615.7,
   "end": 620.86,
   "text": "ما وقتی مردیم باطن این کلمات رو می‌چشیم، می‌بینیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 620.86,
   "end": 624.0,
   "text": "می‌رسیم بهشون. این یعنی لقاء.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 624.0,
   "end": 627.88,
   "text": "بر اساس این اومدیم یه روایتی رو از امام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 627.88,
   "end": 636.8,
   "text": "رضا صلوات الله علیه باز کردیم شبای جمعه که از امیرالمؤمنین این روایت رو نقل فرمودن ایشون که حتی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 636.8,
   "end": 640.36,
   "text": "حروف، رفقایی که یه شب، امشب فقط اومدید،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 640.36,
   "end": 643.3,
   "text": "عزیزان دلم پارو چشم من گذاشتید،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 643.3,
   "end": 648.26,
   "text": "آشناها و فامیل‌ها و نزدیکان این مرحومه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 648.26,
   "end": 655.6,
   "text": "این حدیث رو برید ببینید در کتاب توحید شیخ صدوق که به دعای امام عصر به دنیا اومد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 655.6,
   "end": 659.08,
   "text": "میاد امام رضا می‌فرماید حتی حروف،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 659.08,
   "end": 662.46,
   "text": "حروف هم شأن نزول و پنهان دارن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 662.46,
   "end": 667.04,
   "text": "باطن دارن. همین حروف الف، ب، پ، ت، ث، ج، چ.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 667.04,
   "end": 670.18,
   "text": "اینا یک تأویل دارن، یه باطنی دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 670.18,
   "end": 675.22,
   "text": "ما اینو شروع کردیم. یعنی ما بمیریم یکی از چیزایی که قراره بچشیم، برسیم، ببینیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 675.22,
   "end": 679.02,
   "text": "یکی از معنای لقاء، لقاء حتی حروف در عالمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 679.02,
   "end": 681.52,
   "text": "حروف، کلمات، اسماء،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 681.52,
   "end": 683.72,
   "text": "همه رو قراره ببینیم، بچشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 683.72,
   "end": 686.68,
   "text": "خب همینجا بچش. امام رضا این حدیث رو فرمود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 686.68,
   "end": 690.92,
   "text": "ما هم اومدیم، رسیدیم و این جمله آخر منبر امشب من",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 690.92,
   "end": 693.5,
   "text": "رسوندمش به جایی که منبر منقطع نشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 693.5,
   "end": 695.54,
   "text": "چون بحث‌های شب جمعه ما بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 695.54,
   "end": 700.36,
   "text": "ما رسیدیم به اینکه تأویل و شأن نزول حرف تا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 700.36,
   "end": 702.42,
   "text": "چی بود؟ گفتیم توبا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 702.42,
   "end": 704.58,
   "text": "بحث توبا للمؤمنین رو مطرح کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 704.58,
   "end": 707.16,
   "text": "حالا شأن نزول حرف وا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 707.16,
   "end": 709.72,
   "text": "وا با دسته، تازه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 709.72,
   "end": 712.3,
   "text": "اینم از قول کی بدارم میگم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 712.3,
   "end": 718.72,
   "text": "امام رعوف قربونش بریم که وقتی از سر قبر مادر اومدیم گفتیم امام رضا ما مادر رو به تو سپردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 718.72,
   "end": 724.22,
   "text": "اومدیم اینجا امام رضا داره از قول امیرالمؤمنین، امیر بیان می‌فرماید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 724.22,
   "end": 731.41,
   "text": "گوش بدین تمام و ذاع ظن المؤمنین بالله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 731.41,
   "end": 735.87,
   "text": "خيرا وظن الكافرين به سوءا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 735.87,
   "end": 738.63,
   "text": "خیلی پرحرفه اینجا. حالا من حرف نمیزنم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 738.63,
   "end": 742.07,
   "text": "فقط خواستم حدیثو بگم. زا چی شد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 742.07,
   "end": 744.75,
   "text": "وا با دست تا زا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 744.75,
   "end": 748.49,
   "text": "زا یعنی ظن. ظن چی به خدا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 748.49,
   "end": 755.07,
   "text": "چیا؟ میگه مؤمنین به خدا ظن خیر دارن، ظن خوب دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 755.07,
   "end": 757.91,
   "text": "ظن المؤمنین بالله خيرا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 757.91,
   "end": 760.87,
   "text": "همش هرچی براشون پیش میاد میگن خيرا انشاالله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 760.87,
   "end": 764.71,
   "text": "انشاالله خيرا. این ظن مؤمنین به خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 764.71,
   "end": 766.37,
   "text": "اما کفار چه ظنی دارن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 766.37,
   "end": 768.47,
   "text": "فرمود چی؟ سوءا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 768.47,
   "end": 770.67,
   "text": "همش بدگمانن به خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 770.67,
   "end": 773.19,
   "text": "نه به خدا، به زمین و زمان بدگمانن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 773.19,
   "end": 779.25,
   "text": "فحش میدن. این چه عالمیه، این چه دنیاییه، این چه وضعیتیه، این چه-- همش فحش میدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 779.25,
   "end": 784.67,
   "text": "لذا این حدیثه آقا کوچولوترها میخواید تا آخر عمرتون خوشبخت بشید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 784.67,
   "end": 786.49,
   "text": "سرش تو این حدیثه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 786.49,
   "end": 790.79,
   "text": "حدیث قدسی. سند، جواهر الثنیه فی احادیث القدسی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 790.79,
   "end": 795.91,
   "text": "شیخ ر عاملی که هم سن شما حدودا دور از جونتون بود، ده سالش بود مرد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 795.91,
   "end": 799.49,
   "text": "امام زمانو دید گفت آقا من کاری نکردم مردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 799.49,
   "end": 802.23,
   "text": "میشه منو برگردونی برای شما یه کاری بکنم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 802.23,
   "end": 806.93,
   "text": "آقا یه جرعه آب بهش داد. برگشت زنده شد صد و هفتاد جلد کتاب نوشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 806.93,
   "end": 810.13,
   "text": "یکیش همینه. اونجا این حدیث رو آورده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 810.13,
   "end": 812.61,
   "text": "ایشون شیخ ر کی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 812.61,
   "end": 815.89,
   "text": "عاملی. عاملی. فرموده خدا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 815.89,
   "end": 823.39,
   "text": "خدای منان در این حدیث قدسی به پیغمبرش فرمود خواهرا، آقایون گوش بدید خ- فصل الخطاب امشب ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 823.39,
   "end": 830.97,
   "text": "ثوابش برسه به روحáš خانم. فرمود من، خدا در نزد گمان بندمم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 830.97,
   "end": 837.83,
   "text": "ظن بندم. بندم اگه به من گمان خوب داره، خیر داره، من دائم باهاش-- براش خیر میارم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 837.83,
   "end": 842.01,
   "text": "اگه بندم به من گمان بد داره، دائم براش بد میارم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 842.01,
   "end": 845.41,
   "text": "پس مراقب گمان‌ها، ظن‌ها،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 845.41,
   "end": 853.34,
   "text": "اینها باشیم. اللهم مغفر ورحم لمن يقرأ الفاتحة مع الصلوات. اللهم صل على محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}