 "chapters": [
  {
   "index": 0,
   "title": "## سینهٔ گشاده زیر خورشید ولایت",
   "start": 0.1,
   "end": 28.44
  },
  {
   "index": 1,
   "title": "## تمثیل صدف و مروارید در شرح مصباح‌الانس",
   "start": 28.44,
   "end": 65.52
  },
  {
   "index": 2,
   "title": "## مروارید بر گردن حورالعین؛ رشد ولایی",
   "start": 65.52,
   "end": 166.92
  },
  {
   "index": 3,
   "title": "## دردِ جلسه: آمادگی برای لقاءالله",
   "start": 166.92,
   "end": 229.95
  },
  {
   "index": 4,
   "title": "## دو منبر بودن بحث و ختم صلوات",
   "start": 229.95,
   "end": 258.49
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.1,
   "end": 2.66,
   "text": "سینش گشاده‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 2.66,
   "end": 6.4,
   "text": "سینه گشاده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 6.4,
   "end": 9.58,
   "text": "قربونتون برم تحت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 9.58,
   "end": 16.58,
   "text": "آفتاب وجود ولایت قرار گرفته و شمس و این شمس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 16.58,
   "end": 21.56,
   "text": "پیغمبره. قمر که او رو طلوع داده ولایته، امامته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 21.56,
   "end": 24.78,
   "text": "اصل شمسه. چه ربطی به مروارید داره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 24.78,
   "end": 26.44,
   "text": "حالا یه وقتی با هم میشینیم ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 26.44,
   "end": 28.44,
   "text": "الان دیگه وقت نیست دربارش حرف بزنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 28.44,
   "end": 31.2,
   "text": "چقدر شیرین که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 31.2,
   "end": 34.04,
   "text": "حضرت علامه حسن زاده علیه الرحمه در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 34.04,
   "end": 38.68,
   "text": "م-- شرح مصباح الانس همون اوایل دروس حدود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 38.68,
   "end": 42.64,
   "text": "مثلا امروز من چون بیست و نه رو گوش می‌دادم دروس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 42.64,
   "end": 49.56,
   "text": "فکر می‌کنم مثلا ده پونزده این حدودا اوایل می‌فرمودن که این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 49.56,
   "end": 52.5,
   "text": "صدف دقت کنید نوجوان‌ها این صدف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 52.5,
   "end": 56.0,
   "text": "اصلا این مروارید چجوری تو وجودش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 56.0,
   "end": 60.28,
   "text": "ایجاد می‌شه، انشا میشه، درست می‌شه و چرا بعضیا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 60.28,
   "end": 64.62,
   "text": "دو تاست، سه تاست. می‌فرماید توی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 64.62,
   "end": 68.06,
   "text": "زمان خاصی حالا زمانش رو میگه مکانش رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 68.06,
   "end": 70.86,
   "text": "در عرض شود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 70.86,
   "end": 74.66,
   "text": "اردیبهشت ماه یه زمان خاصی اینا میان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 74.66,
   "end": 76.7,
   "text": "باران خاصی که داره میاد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 76.7,
   "end": 79.92,
   "text": "اینا میان در سطح اقیانوس و دریا قرار می‌گیرن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 79.92,
   "end": 86.52,
   "text": "ما نمی‌بینیمشون. وقتی باران خاصی داره میاد اس داره اینو حالا مفصل بعدا صحبت کنم الان بگم یه وقت اشتباه می‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 86.52,
   "end": 90.2,
   "text": "چون حضور ذهن دقیقی ندارم اون مضمون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 90.2,
   "end": 92.04,
   "text": "مطلب رو از جهت علمی بگم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 92.04,
   "end": 95.6,
   "text": "اینا میان لب اقیانوس دهانشون رو باز می‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 95.6,
   "end": 98.64,
   "text": "یه بارم بیشتر اینا تو طول سال دهان باز نمی‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 98.64,
   "end": 101.5,
   "text": "چقدر خوبه آدم دهانش بسته باشه کاملا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 101.5,
   "end": 105.0,
   "text": "بعد اونموقع اگر باز شد می‌بینی گوهر ازش میاد بیرون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 105.0,
   "end": 106.74,
   "text": "دهانشون بسته‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 106.74,
   "end": 112.12,
   "text": "یک بار باز می‌کنند به میزانی که همون قطره‌ها مثلا یه قطره بیفته دهنش بسته می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 112.12,
   "end": 115.88,
   "text": "بعضیا آنند دو قطره میفته دهن بسته می‌شه، بعضیا سه تا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 115.88,
   "end": 119.64,
   "text": "لذا سه تا مروارید، دو تا مروارید، یک مروارید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 119.64,
   "end": 124.68,
   "text": "میان روی دریا و اون آفتاب اون خاص،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 124.68,
   "end": 128.16,
   "text": "اون لحظه آفتابی که داره می‌تابه آفتاب خاصیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 128.16,
   "end": 131.74,
   "text": "میان اون آفتاب رو بگیرن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 131.74,
   "end": 135.94,
   "text": "این قطره بارون می‌زنه دهنشون رو می‌بنده میرن داخل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 135.94,
   "end": 138.78,
   "text": "حالا اینا اسراری داره بماند به وقتش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 138.78,
   "end": 140.7,
   "text": "میرن می‌خوابن کف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 140.7,
   "end": 144.7,
   "text": "اقیانوس بعد از مدتی این می‌شه مروارید؛",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 144.7,
   "end": 152.18,
   "text": "تو صدف. حالا اون مروارید چرا تو گردن حورالین؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 152.18,
   "end": 155.76,
   "text": "خورشید ولایت تابیده به سینش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 155.76,
   "end": 159.66,
   "text": "اصلا یه رشده‌ست، ولایته، حور.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 159.66,
   "end": 164.76,
   "text": "این بحث جنس و اینا رو بریز بیرون بچه بازیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 164.76,
   "end": 169.26,
   "text": "خلاصه چرا بحث ما به اینجا کشیده شد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 169.26,
   "end": 171.88,
   "text": "حالا درد اینجا بود که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 171.88,
   "end": 175.68,
   "text": "یه وقت خدایی نکرده \"فَبَصَرُوا كَلْ يَوْمَ الْحَدِيد\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 175.68,
   "end": 177.9,
   "text": "اون لحظه ما که دفعه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 177.9,
   "end": 182.94,
   "text": "می-می‌خوایم به لقای خدا برسیم به لقای پروردگار ببینیم آمادگی نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 182.94,
   "end": 186.14,
   "text": "نیست. پس چقدر خوب که از الان برسیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 186.14,
   "end": 190.14,
   "text": "چقدر خوب که یعنی به نظرم توی این هیئت از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 190.14,
   "end": 194.5,
   "text": "روز اولش که با سیصد شهید گمنام شروع شد اتفاق کردیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 194.5,
   "end": 198.66,
   "text": "تا حالا، حالا بعدش رو خدا می‌دونه، ولی تا حالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 198.66,
   "end": 205.18,
   "text": "بحثی به دردبخورتر از بحث لقاءالله نشده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 205.18,
   "end": 208.32,
   "text": "هرچی میریم جلو اهمیتشو بهتر می‌فهمیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 208.32,
   "end": 215.2,
   "text": "غذای وجود ماست. کسایی که از این غذا محروم بودن کاملا گرسنه‌ن، لاغرن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 215.2,
   "end": 217.54,
   "text": "لاغرکن. یعنی نگاشون کنی نفس‌هات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 217.54,
   "end": 220.7,
   "text": "ضعیف، نفوس ضعیفه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 220.7,
   "end": 229.95,
   "text": "مضطربه. ولی اونایی که انشاالله رسیدن نفس مطمئنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 229.95,
   "end": 232.86,
   "text": "جا داشت که نسبت به حالا اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 232.86,
   "end": 239.46,
   "text": "غلت ویس‌ها که ما صحبت‌هامون معمولا بیست دقیقه اینا این بحث رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 239.46,
   "end": 244.69,
   "text": "دو منبر می‌کردیم بخشیش رو اینجا بحث شد جلسه بعد اما حیفم اومد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 244.69,
   "end": 248.39,
   "text": "یعنی شما انقدر خوب گوش دادید واقعا حیفم اومد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 248.39,
   "end": 254.9,
   "text": "انشاالله که عاقبت هممون ختم به خیر بشه و برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 254.9,
   "end": 258.49,
   "text": "اللهم صل على محمد و آل محمد. و عجل فرجهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}