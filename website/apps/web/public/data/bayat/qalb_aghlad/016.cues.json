 "chapters": [
  {
   "index": 0,
   "title": "## هنرِ ماندن با یک حدیث",
   "start": 17.98,
   "end": 58.14
  },
  {
   "index": 1,
   "title": "## إلا الذین آمنوا؛ کمال در قوهٔ نظری",
   "start": 58.14,
   "end": 311.44
  },
  {
   "index": 2,
   "title": "«من عرف نفسه فقد عرف ربه.»",
   "start": 311.44,
   "end": 535.38
  },
  {
   "index": 3,
   "title": "## قلب اغلف؛ سه واکنشِ باطل",
   "start": 535.38,
   "end": 600.36
  },
  {
   "index": 4,
   "title": "## پرورشِ درون‌مایهٔ معارفی",
   "start": 600.36,
   "end": 711.4
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.32,
   "end": 4.98,
   "text": "آیه صد و پنجاه و پنج سوره نساء.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 4.98,
   "end": 7.26,
   "text": "و این آخرین آیه‌ای‌ست که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 7.26,
   "end": 11.08,
   "text": "پیرامون قلب و عقل درش حرف زده شده و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 11.08,
   "end": 16.34,
   "text": "مطالبی پیاده شده که البته بسیار این مطالب مهم‌اند و قابل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 16.34,
   "end": 23.04,
   "text": "بررسی. خدا حفظ کنه حضرت آیت‌الله صمدی آملی رو که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 23.04,
   "end": 26.52,
   "text": "می‌فرمودند که به من گاهی اوقات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 26.52,
   "end": 29.16,
   "text": "می‌رسند بعضی از این وعّاظ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 29.16,
   "end": 33.8,
   "text": "و افتخار می‌کنند که مثلاً من پنج هزار منبر رفتم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 33.8,
   "end": 39.42,
   "text": "در حالی که در این پنج هزار منبر یک حدیث تکراری نگفتم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 39.42,
   "end": 47.14,
   "text": "ایشون می‌گفتند من اشکال می‌کردم به این دسته آدما و می‌گفتم هنر اینه که تو پنج هزار منبر بری با یک حدیث.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 47.14,
   "end": 50.98,
   "text": "این درون‌مایه احادیث اهل بیت و آیات رو نشون می‌ده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 50.98,
   "end": 56.6,
   "text": "این‌هایی که اشکال می‌کنند که آقا مثلاً به چه درد ما می‌خوره این مباحث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 56.6,
   "end": 62.98,
   "text": "شصت مورد قلب در قرآن رو ما بشینیم هی بررسی کنیم، بررسی کنیم الان دو سه ساله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 62.98,
   "end": 67.54,
   "text": "تازه مثلاً به هفدهمین موردش رسیدیم به چه درد ما می‌خوره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 67.54,
   "end": 70.34,
   "text": "این‌ها غافلن از این قصه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 70.34,
   "end": 75.54,
   "text": "که حالا مثلاً یه حدیث بگیم بریم، یه ح-- یه داستان، یه حکایت بگیم تموم شه بریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 75.54,
   "end": 80.44,
   "text": "چه گیر ما میاد. در حالی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 80.44,
   "end": 82.8,
   "text": "قوای عقلیه ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 82.8,
   "end": 87.66,
   "text": "در معارف نظریه ضعیف می‌مونه و ما در قصه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 87.66,
   "end": 90.34,
   "text": "تواصوا بالحق مشکل پیدا می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 90.34,
   "end": 93.2,
   "text": "شما توجه داشته باشید به این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 93.2,
   "end": 96.92,
   "text": "مطلبی که در تفسیر سوره عصر مرحوم خواجه نصیر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 96.92,
   "end": 103.64,
   "text": "طوسی که دیروز وعده‌ش رو داده بودیم عرض کنیم خدمتتون بیان فرمودند پیرامون سوره عصر چقدر زیبا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 103.64,
   "end": 105.92,
   "text": "اصلاً جواب همین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 105.92,
   "end": 108.18,
   "text": "شبهه است که «بسم الله الرحمن الرحیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 108.18,
   "end": 113.64,
   "text": "ولعصر» همه حفظید و می‌دونید به هر حال تحت اللفظ این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 113.64,
   "end": 116.78,
   "text": "ترجمه‌ش چیه. «إن الإنسان لفي خسر».",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 116.78,
   "end": 120.92,
   "text": "خب قطعاً همه انسان‌ها در خسران‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 120.92,
   "end": 125.82,
   "text": "اما چه دسته‌ای؟ اینجا خواجه نصیر این محقق ارزشمند و گران‌سنگ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 125.82,
   "end": 130.1,
   "text": "این چنین معرفی می‌کنند این دسته آدم‌هایی که در خسران‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 130.1,
   "end": 137.6,
   "text": "«أي الاشتغال بالأمور الطبيعية والاستغراق بالنفوس البهيمية».",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 137.6,
   "end": 143.98,
   "text": "این‌ها غرق در نفس به-بهیمیت‌شون یعنی خورد و خوراک، بخور و بخواب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 143.98,
   "end": 148.36,
   "text": "شدن. حتی دین رو هم برای خوردن و خوابیدنشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 148.36,
   "end": 153.22,
   "text": "به سمتش می‌رن. چون مثلاً شاید نون در دین‌داریه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 153.22,
   "end": 157.72,
   "text": "و البته مشغول به امور طبیعی‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 157.72,
   "end": 164.76,
   "text": "یعنی ازشون می‌بینی هیچی جز همین مسائل متعارف امروزیه تو مردم و تو بازار و کار و زندگی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 164.76,
   "end": 167.88,
   "text": "همین حالت متعارف چیز دیگه‌ای نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 167.88,
   "end": 171.5,
   "text": "فوقش دین‌داری‌شون خلاصه می‌شه به یک نماز و روزه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 171.5,
   "end": 174.56,
   "text": "و تمام. یعنی دنبال معار-- حالا بقیه‌ش رو دقت کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 174.56,
   "end": 176.76,
   "text": "«إلا الذين آمنوا».",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 176.76,
   "end": 181.68,
   "text": "قرآن داره می‌گه دیگه. حالا این تمیزی که قائل شده اینجا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 181.68,
   "end": 184.2,
   "text": "ممتاز کرده یه عده رو. «إلا»",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 184.2,
   "end": 186.76,
   "text": "اون‌هایی که ظاهراً می‌گیم ایمان آوردند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 186.76,
   "end": 193.16,
   "text": "خب این‌ها چه کسایی‌اند؟ این محقق ارزشمند که جالبه که بدونید این تیکه رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 193.16,
   "end": 197.78,
   "text": "حضرت علامه حسن زاده در کتاب انسان در قرآنشون میارن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 197.78,
   "end": 201.58,
   "text": "و دستمایه مطالب خودشون قرار می‌دن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 201.58,
   "end": 206.22,
   "text": "یعنی ایشون می‌گن شما هم توجه به این مطلب خواجه داشته باشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 206.22,
   "end": 209.48,
   "text": "خواجه «إلا الذين آمنوا» رو اینطوری ترجمه می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 209.48,
   "end": 213.16,
   "text": "«أي الكاملین في القوة النظرية».",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 213.16,
   "end": 216.36,
   "text": "این‌هایی که تو وادی ایمان‌اند،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 216.36,
   "end": 219.54,
   "text": "کسانی‌اند که کامل‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 219.54,
   "end": 222.32,
   "text": "کامل شدن در قوای نظری‌شون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 222.32,
   "end": 224.32,
   "text": "یعنی از عقلشون،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 224.32,
   "end": 226.56,
   "text": "از حوزه تدبر و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 226.56,
   "end": 232.88,
   "text": "تفکرشون بهره جستن، نشستن درون‌مایه معارف رو بیرون کشیدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 232.88,
   "end": 236.42,
   "text": "این‌طور نیست که یه حدیث، یه آره-آیه رو حفظ کنن و تمام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 236.42,
   "end": 239.4,
   "text": "اون که دیگه در حد متعارف و عموم و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 239.4,
   "end": 242.02,
   "text": "دیگه سطح معمول اجتماع است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 242.02,
   "end": 249.56,
   "text": "اگر ما می‌خوایم جزو کسانی باشیم که دل به دین بدیم باید بف-بفهمیم که چه درون‌مایه‌ای.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 249.56,
   "end": 257.56,
   "text": "الان یک حدیث امیرالمؤمنین صلوات الله علیه که واقعاً جزو معجزات قولیه ایشونه، یک حدیثشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 257.56,
   "end": 261.06,
   "text": "براش حداقل در حالت ابتدایی یعنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 261.06,
   "end": 267.64,
   "text": "نمی‌گیم پیشرفته و فوق پیشرفته، نه، در حالت معمول که هر کسی هم این کتابو بخونه می‌فهمه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 267.64,
   "end": 272.72,
   "text": "من قول میدم می‌فهمه. سنگ‌اندازی نکنیم بگیم آقا ما نمی‌فهمیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 272.72,
   "end": 275.18,
   "text": "باور کنید بی‌سواداش خوندن فهمیدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 275.18,
   "end": 278.2,
   "text": "گاهی اوقات ما به خودمون بی‌انصافی و جسارت می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 278.2,
   "end": 282.26,
   "text": "آقا این مطالب سنگینه. خوب گوش بده از اول تا آخرشو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 282.26,
   "end": 286.46,
   "text": "بالاخره یه چیزی می‌فهمی. این‌طور نیست که نفهمه کامل باشه آدم که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 286.46,
   "end": 294.9,
   "text": "اومده این حدیث رو علامه حسن زاده در ابتداییات بحث معرفت صد و پنجاه درسش کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 294.9,
   "end": 298.78,
   "text": "صد و پنجاه تا منبر از یه حدیث مولا علی بیرون کشیده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 298.78,
   "end": 306.78,
   "text": "و شما وقتی اینو می‌خونید تازه می‌افتید رو ریل بندگی، رو ریل توحید، شناخت امام، شناخت نبوت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 306.78,
   "end": 309.4,
   "text": "اونم همین حدیث. «من عرف نفسه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 309.4,
   "end": 313.48,
   "text": "فقد عرف ربه». سه جلد کتاب معرفت النفس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 313.48,
   "end": 316.06,
   "text": "حالا در سطح ابتداییش. بعد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 316.06,
   "end": 318.54,
   "text": "گوهر گنجینه‌ی روان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 318.54,
   "end": 322.8,
   "text": "کلی توش اصله. بعد مثلاً اتحاد، همینطوری پله پله می‌ره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 322.8,
   "end": 325.62,
   "text": "تعالی پیدا می‌کنه. اتحاد عاقل به معقول.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 325.62,
   "end": 329.14,
   "text": "بعد دیگه سنگین‌ترینش عیون مسائل نفس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 329.14,
   "end": 331.22,
   "text": "شصت و شش اصل از مسائل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 331.22,
   "end": 337.5,
   "text": "همین معرفت نفس توشه. خب ما تا کی باید بشینیم یک حدیث رو علامه چندین کتاب کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 337.5,
   "end": 341.74,
   "text": "بعد ما بگیم آقا چرا این آقا نشسته تو قرآن داره بررسی می‌کنه شصت تا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 341.74,
   "end": 344.82,
   "text": "قلب رو از قرآن کشیده بیرون، یه حدیث بخونه بره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 344.82,
   "end": 348.56,
   "text": "یه داستان برای ما بگه بسه. مگه عمرمون رو از سر راه گیر آوردیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 348.56,
   "end": 352.42,
   "text": "این همه منبر، حالا به جسارت به منبریا نشه و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 352.42,
   "end": 355.24,
   "text": "خدایی نکرده اظهار فضل بنده هم نشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 355.24,
   "end": 357.3,
   "text": "چون این حرفا از من نیست اصلاً.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 357.3,
   "end": 363.72,
   "text": "افتخار بنده اینه. اگه از من بود انقدر الحمدالله برکت پیدا نمی‌کرد که الان کانالی که شما دو سال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 363.72,
   "end": 367.14,
   "text": "پیش اینجا تأسیس کردید سه هزار نفر عضو پیدا کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 367.14,
   "end": 374.2,
   "text": "چرا؟ چون مطالب از جاهای مأخذ مهم و بسیار مهم دینی ما اخذ شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 374.2,
   "end": 379.44,
   "text": "\"الا الذين آمنوا\" رو شیخ میگه \"أي الكاملين",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 379.44,
   "end": 385.62,
   "text": "في القوة النظرية\". کامل شدن، قوای نظری‌شون رو شکل دادن، قوت بخشیدن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 385.62,
   "end": 387.8,
   "text": "اهل تدبرن، اهل تفکرن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 387.8,
   "end": 392.26,
   "text": "عرض کردیم قبلاً قلب عبارتی قرآن رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 392.26,
   "end": 396.22,
   "text": "بزرگان درآوردن. همون که قلب قرآن، سوره یاسین،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 396.22,
   "end": 404.58,
   "text": "قلب عبارتی قرآنیه، اون عبارتی که قلب قرآن قرار گرفته از دو طرف دیگه به یک یکسان، یکسان هست، آیات قبلی و بعدی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 404.58,
   "end": 407.62,
   "text": "\"وليتلقف\" است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 407.62,
   "end": 415.1,
   "text": "\"وليتلقف\" که علامه می‌فرماید اگر می‌خوای به جان قرآن، درون قرآن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 415.1,
   "end": 421.46,
   "text": "در حقیقت باطن قرآن برسی هیچ چاره‌ای جز همین آ-- عبارت نیست که \"وليتلقف\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 421.46,
   "end": 425.14,
   "text": "بعد این رو هم‌سنگ علامه، اینو هم‌سنگ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 425.14,
   "end": 429.34,
   "text": "\"يتعقل\" می‌گیره. \"يتأمل\"، \"يتدبر\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 429.34,
   "end": 434.72,
   "text": "عجب! میگه همین \"ولـ\"، \"وليتلقف\"، تلطیف سر از کجا میاد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 434.72,
   "end": 440.4,
   "text": "\"وليتعقل\". سرت رو فرو ببری در گریبان خودت و تأمل کنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 440.4,
   "end": 444.6,
   "text": "به آیات و روایات. بعد \"وتواصوا بالحق\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 444.6,
   "end": 446.98,
   "text": "حالا اینجا رو ببینید چقدر زیبا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 446.98,
   "end": 449.22,
   "text": "شیخ طوسی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 449.22,
   "end": 451.82,
   "text": "چجوری درون مایهشو می‌ریزه بیرون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 451.82,
   "end": 453.6,
   "text": "\"وتواصوا بالحق\" کی‌ان؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 453.6,
   "end": 456.82,
   "text": "مگر اینا وظیفه ما نیست؟ خب بسم الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 456.82,
   "end": 459.46,
   "text": "شیخ می‌فرماید \"أي الذين يكملون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 459.46,
   "end": 463.44,
   "text": "عقول الخلائق بالمعارف النظرية\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 463.44,
   "end": 467.76,
   "text": "اینجا دیگه قبل خودشون رو ساختن، حالا اومدن سراغ چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 467.76,
   "end": 472.36,
   "text": "\"الخلائق\". برنامه دارن برای همه خلائق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 472.36,
   "end": 474.76,
   "text": "در چی؟ \"بالمعارف النظرية\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 474.76,
   "end": 477.36,
   "text": "همین معارف علم نظری رو،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 477.36,
   "end": 482.1,
   "text": "همین علوم نظری رو، معارف الهیه رو، این‌ها رو میارن به همه دیگر،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 482.1,
   "end": 486.18,
   "text": "دیگر خلائق به انحاء مختلف می‌رسونن، خوراک فکری اون‌ها قرار میدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 486.18,
   "end": 489.26,
   "text": "\"وتواصوا بالصبر\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 489.26,
   "end": 493.22,
   "text": "حالا اینا کی‌ان که تواصی می‌کنن، توصیه می‌کنن به صبر؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 493.22,
   "end": 497.98,
   "text": "\"أي الذين يكملون أخلاق الخلائق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 497.98,
   "end": 503.1,
   "text": "ويهذبونها\". اینا میرن سراغ اینکه دیگران رو هم مهذب کنن، متخلق کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 503.1,
   "end": 506.54,
   "text": "اول خودشون رو متخلق کردن، مهذب کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 506.54,
   "end": 508.98,
   "text": "باهاش می‌گردی می‌بینی زندگیش بو خدا می‌ده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 508.98,
   "end": 512.74,
   "text": "تو زندگی شخصی و خونوادگیشم میری می‌بینی بو خدا می‌ده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 512.74,
   "end": 515.74,
   "text": "منیتی، دعوت به خودی خدایی نکرده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 515.74,
   "end": 518.28,
   "text": "سوء استفاده‌ای نیست درش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 518.28,
   "end": 522.08,
   "text": "خب این در حد خودش داره حرکت می‌کنه، دیگران رو هم می‌کشونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 522.08,
   "end": 524.86,
   "text": "خب کدوم یکی از ما زیل این آیات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 524.86,
   "end": 528.3,
   "text": "همیشه گفتیم آقا سوره والعصر رو حفظی، بله بخونم برات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 528.3,
   "end": 532.16,
   "text": "مثل تو-- قشنگ طوطی از به برات از اول تا آخر می‌خونم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 532.16,
   "end": 534.06,
   "text": "اما درونش چی داره به ما میگه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 534.06,
   "end": 539.62,
   "text": "بی‌خبر. حالا مشکل اصلی اون‌هایی که صاحب قلب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 539.62,
   "end": 544.84,
   "text": "اغلفن همینه. دیروز عرض کردیم یعنی قرآن رو ببینید مفسرین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 544.84,
   "end": 550.42,
   "text": "عرض کردم قبلاً معتقدند یا اینا میگن این حرفا رو ما بلدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 550.42,
   "end": 553.56,
   "text": "مثل شمشیر در غلاف دل ما پره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 553.56,
   "end": 556.5,
   "text": "قلب اغلف، قلوب غلف.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 556.5,
   "end": 558.5,
   "text": "پره یعنی اینا رو بلدیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 558.5,
   "end": 561.76,
   "text": "که دچار توهم در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 561.76,
   "end": 564.86,
   "text": "علم شدن، توهم در معارف شدن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 564.86,
   "end": 567.32,
   "text": "علامه می‌فرماید این نشانه مریضیه دله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 567.32,
   "end": 571.46,
   "text": "کسی توقف کنه در مسیر رشد و تعالی این نشانه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 571.46,
   "end": 577.88,
   "text": "یا اینکه میگن نه ما اصلا نمی‌فهمیم باز بی‌انصافی و بی‌معرفتی نسبت به خودشون دارن می‌کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 577.88,
   "end": 582.26,
   "text": "خودشونو دست کم گرفتن در حالی که ظرف نزول",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 582.26,
   "end": 584.5,
   "text": "قرآن قلب انسانه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 584.5,
   "end": 586.9,
   "text": "قرآن می‌تونه در قلب انسان جای بگیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 586.9,
   "end": 588.98,
   "text": "ما متاسفانه ظرفمون رو کوچیک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 588.98,
   "end": 591.5,
   "text": "کردیم. یا اینکه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 591.5,
   "end": 593.98,
   "text": "نه میگن می‌دانیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 593.98,
   "end": 598.84,
   "text": "نه میگن نمی‌فهمیم بلکه میگن این حرفا به درد ما نمی‌خوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 598.84,
   "end": 603.18,
   "text": "مثل کسی که آقا میگه گوش ما از این حرفا پره، به چه درد ما خورد دین،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 603.18,
   "end": 611.02,
   "text": "این احادیث، این آیات. در هر حال هر کدوم که باشه این‌ها باز دارن درون ما-- دقت بفرمایید چی عرض می‌کنم با توجه به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 611.02,
   "end": 615.78,
   "text": "صحبت شیخ طوسی علیه رحمة این محقق ارزشمند و این دانشمند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 615.78,
   "end": 623.44,
   "text": "و این علامه دارن پس می‌زنن درون مایه آیات قرآن و روایات و احادیث رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 623.44,
   "end": 627.24,
   "text": "حالا ظاهرش که شاید از اول تا آخر هم بشینه برات صد تا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 627.24,
   "end": 631.2,
   "text": "آیه و حدیث و داستان و حکایت ردیف کنه یا مثل من منبرم بره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 631.2,
   "end": 634.74,
   "text": "اما درون مایه چی؟ منظور از این منطوق چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 634.74,
   "end": 638.96,
   "text": "مفهومش چیه؟ نمی‌دونه. در حالی که این بسیار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 638.96,
   "end": 645.56,
   "text": "کلاه گشادی بوده که سر ما رفته و حتی متاسفانه منبرهای ما هم تحت شعاعش قرار گرفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 645.56,
   "end": 647.84,
   "text": "شاید آخوندهای بی‌سواد مثل منم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 647.84,
   "end": 654.44,
   "text": "یه خیانت‌هایی کردیم. اممم ذائقه مردم رو در حد متعارف و پایین نگه داشتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 654.44,
   "end": 658.8,
   "text": "مردم رو اهل تأمل تا، تا می‌بینه یه ذره سختش می‌شه پس می‌زنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 658.8,
   "end": 661.16,
   "text": "آقا نمی‌خوایم یه داستان، یه مثال بزن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 661.16,
   "end": 665.44,
   "text": "ما بفهمیم. نمی‌خوایم بریم اهل تأمل و تدبر و تعقل باشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 665.44,
   "end": 668.82,
   "text": "چه اشکالی داره رفقا؟ ختم کلام و بحث من امروز،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 668.82,
   "end": 670.94,
   "text": "یه بحث دوستانه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 670.94,
   "end": 677.64,
   "text": "چه اشکال، اشکالی داره یکی از برنامه‌های این سازمان مثلا این باشه که درون مایه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 677.64,
   "end": 680.52,
   "text": "بچه‌های خودش رو با معارف و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 680.52,
   "end": 683.62,
   "text": "با معارف دقیق و حکمی این چنینی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 683.62,
   "end": 688.38,
   "text": "بسازه، درون مایه شون رو پرورش بده، اصلا برنامه داخلی داشته باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 688.38,
   "end": 694.14,
   "text": "چه اشکالی داره؟ هشتـ، حتما باید رو آنتن مردم رو متوجه کنیم درون خودمون چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 694.14,
   "end": 695.78,
   "text": "بچه‌های خودمون از درون چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 695.78,
   "end": 698.94,
   "text": "چرا باید فراری باشن از این حقایق؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 698.94,
   "end": 703.04,
   "text": "البته این بحث نیمه کاره مون ان‌شاءالله فردا رو که خدا از ما نگرفته،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 703.04,
   "end": 706.68,
   "text": "خدا برکت به وقت و عمرمون بده ان‌شاءالله با هم این مبحث رو ادامه بدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 706.68,
   "end": 711.4,
   "text": "ان‌شاءالله که عاقبتمون ختم به خیر بشه به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}