   "start": 0.26,
   "end": 20.4
  },
  {
   "index": 1,
   "title": "## اعطای کثیر در برابر قلیل؛ قصهٔ ابراهیم",
   "start": 20.4,
   "end": 217.16
  },
  {
   "index": 2,
   "title": "## اعطای من سأل؛ فقر و دعا",
   "start": 217.16,
   "end": 281.56
  },
  {
   "index": 3,
   "title": "## اعطای بی‌سؤال و بی‌معرفت؛ خلقت",
   "start": 281.56,
   "end": 521.76
  },
  {
   "index": 4,
   "title": "## معنای غلف و ادعای پُری دل",
   "start": 521.76,
   "end": 543.54
  },
  {
   "index": 5,
   "title": "## آیات همسو: نفقه نمی‌کنیم؛ قلوب در اکنه",
   "start": 543.54,
   "end": 702.46
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.26,
   "end": 3.04,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 3.04,
   "end": 5.72,
   "text": "السلام علیک ای داعی الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 5.72,
   "end": 8.5,
   "text": "و ربانیه آیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 8.5,
   "end": 12.04,
   "text": "سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 12.04,
   "end": 17.64,
   "text": "دقت بفرمایید این ابتدای دعای بسیار با عظمت و عجیب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 17.64,
   "end": 23.96,
   "text": "ماه رجب رو این سه جمله اول، سه جمله درخواستیش رو یعنی بعد از اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 23.96,
   "end": 30.32,
   "text": "دو تا عبارت اول که دیروز عرض کردیم \"یا من أرجو له کل خیر و آمن سخطه عند کل شر\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 30.32,
   "end": 34.68,
   "text": "از اینجا به بعد رو دقت کنید. سه تا فراز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 34.68,
   "end": 41.98,
   "text": "که این فراز اولش می‌فرماید \"یا من يؤتی الكثير بالقلیل\" ببینید بحث اعطاء.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 41.98,
   "end": 45.9,
   "text": "دوباره \"یا من يؤتی\" بحث اعطاء است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 45.9,
   "end": 51.98,
   "text": "اما \"من سأل\". قسمت سوم هم باز بحث اعطاء الهیه \"یا من يؤتی\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 51.98,
   "end": 53.56,
   "text": "اما به یک نحو دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 53.56,
   "end": 56.84,
   "text": "\"من لم يسأله و من لم يعرفه تهنن منه\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 56.84,
   "end": 62.38,
   "text": "این سه تا بخش سه فراز اعطایی حضرت حق رو داره میگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 62.38,
   "end": 66.4,
   "text": "که حالا می‌خوام ارتباطش بدم با بحث هر روزمون و قلب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 66.4,
   "end": 68.82,
   "text": "اقلف یا قلبی که دچار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 68.82,
   "end": 73.98,
   "text": "غلاف شده. در یک غلاف حالا غفلتی چیزی قرار گرفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 73.98,
   "end": 77.16,
   "text": "قسمت اول میگه \"یا من يؤتی الكثير بالقلیل\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 77.16,
   "end": 79.92,
   "text": "این میگه زیاد رو میدی به کم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 79.92,
   "end": 83.42,
   "text": "پیداست که شما یه کاری انجام میدی، یه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 83.42,
   "end": 86.34,
   "text": "تو یه هبه‌ای داری، هدیه‌ای داری،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 86.34,
   "end": 91.02,
   "text": "بخششی داری، یک کار خیری داری، یه چیزی داری ببخشی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 91.02,
   "end": 94.38,
   "text": "اما قلیل خدا کثیرش می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 94.38,
   "end": 97.66,
   "text": "حالا می‌تونه جان باشه، می‌تونه مال باشه، می‌تونه آبرو باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 97.66,
   "end": 103.84,
   "text": "مثل حضرت ابراهیم صلوات الله عليه و على نبيه و آله تو اون قصه‌ای که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 103.84,
   "end": 106.4,
   "text": "سه مرتبه حضرت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 106.4,
   "end": 109.82,
   "text": "جبرائیل متنفّل شدند بر روی کوه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 109.82,
   "end": 115.08,
   "text": "و گفتند \"سبوح قدوس ربنا و رب الملائكة والروح\" حضرت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 115.08,
   "end": 117.14,
   "text": "ابراهیم خب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 117.14,
   "end": 122.26,
   "text": "شنید و طی سه مرحله خودش رو کشوند به غلامی ایشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 122.26,
   "end": 125.92,
   "text": "اول فرمود، عرض کرد که آقا ای صاحب صدا اینکه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 125.92,
   "end": 131.16,
   "text": "حالا نمی‌دید بعضیا میگن می‌دید اگه ندیده باشه حاطفه دیده باشه تمثله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 131.16,
   "end": 137.7,
   "text": "\"فتمثل لها بشراً سویّاً\" \"فتمثل لها بشراً سویّاً\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 137.7,
   "end": 140.4,
   "text": "یا برای حضرت ابراهیم \"له بشراً سویّاً\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 140.4,
   "end": 142.68,
   "text": "هرچی بوده به هر حال صدا شنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 142.68,
   "end": 146.0,
   "text": "اولین بار حضرت ابراهیم فرمود یک سوم دارایی‌ام رو میدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 146.0,
   "end": 148.94,
   "text": "ببینید اینجا کجا قرار می‌گیره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 148.94,
   "end": 154.06,
   "text": "قلیل. \"یا من يؤتی الكثير بالقلیل\" یعنی من یه چیزی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 154.06,
   "end": 158.04,
   "text": "ولو قلیل میدم تا خدا اعطاء کند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 158.04,
   "end": 160.7,
   "text": "ولی به کثرت اعطاء کند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 160.7,
   "end": 162.64,
   "text": "این تو اینجا قرار می‌گیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 162.64,
   "end": 168.58,
   "text": "این کار حضرت ابراهیم. خب دفعه دوم هم می‌تونست بگه خب همون یک سومو که من بخشیده بودم دیگه از مالم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 168.58,
   "end": 171.04,
   "text": "از گوسفندا و اینا به شما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 171.04,
   "end": 173.72,
   "text": "ای صاحب صدا میشه دوباره بگی سبوح قدوس؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 173.72,
   "end": 177.04,
   "text": "ولی باز گفت یک سوم دیگرم می‌بخشم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 177.04,
   "end": 182.12,
   "text": "این نشون میده که برای رسیدن بعضی از اعطای، عطای الهی باید بخشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 182.12,
   "end": 187.8,
   "text": "برای هر عطایی یه بخشش لازمه ولو قلیل که خدا به کثرت جواب بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 187.8,
   "end": 189.56,
   "text": "اینجا بالاخره شما یه چیزی می‌بخشی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 189.56,
   "end": 194.64,
   "text": "بعد مرتبه سوم میگه همه دارایی‌ام و آخر هم میگه من غلامتم یه بار دیگه بگو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 194.64,
   "end": 198.5,
   "text": "ما مثلاً یه خواب خوب می‌بینیم میگیم خب خدا میشه دوباره خواب خوب ببینیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 198.5,
   "end": 200.66,
   "text": "یه کربلا میریم خدا میشه دوباره ببری؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 200.66,
   "end": 203.72,
   "text": "خب چیکار کردی که دوباره ببرد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 203.72,
   "end": 208.88,
   "text": "چی دادی؟ این قلیل تو چی بود که کثرت پ-پسش بیاد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 208.88,
   "end": 211.36,
   "text": "اعطای ک-کثیر خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 211.36,
   "end": 214.38,
   "text": "یه قلیلی نیاز داره. این یه اعطاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 214.38,
   "end": 217.16,
   "text": "اعطای بعدی میگه \"یا من يؤتی من سأل\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 217.16,
   "end": 220.5,
   "text": "اینجا میگه من اصلاً در مقامی‌ام که هیچی ندارم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 220.5,
   "end": 225.2,
   "text": "هیچی نیست. چیزی ندارم که بخوام ببخشم حتی قلیلی هم وجود ندارد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 225.2,
   "end": 229.68,
   "text": "\"المفلس في امان الله\" فقر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 229.68,
   "end": 233.26,
   "text": "ذاتی و هرچی. اینجا چی میگی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 233.26,
   "end": 235.26,
   "text": "باز تو اعطا داری اما به چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 235.26,
   "end": 240.88,
   "text": "\"من سأل\" که امیرالمؤمنین صلوات الله علیه در ک-کمیل عرضه می‌دارند که چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 240.88,
   "end": 245.0,
   "text": "\"لا یملك إلا الدعاء\" من هیچ ما یملکی ندارم إلا الدعاء.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 245.0,
   "end": 247.64,
   "text": "این همین مقامه. سواله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 247.64,
   "end": 250.06,
   "text": "چیزی ندارم ببخشم. دعا که بلدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 250.06,
   "end": 252.44,
   "text": "سؤال که بلدم. اینم یه نوع اعطاست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 252.44,
   "end": 255.96,
   "text": "که در بس، پس سؤال میاد دعا که هیچی نداری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 255.96,
   "end": 261.38,
   "text": "زبون که داری دعا کنی. که البته این زبون باید همراه با قلب باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 261.38,
   "end": 264.3,
   "text": "لغلق زبون نباشه. این سوال.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 264.3,
   "end": 267.58,
   "text": "نوع سوم اعطای اینجا در این دعا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 267.58,
   "end": 270.9,
   "text": "می‌فرماید \"یا من يؤتی\" اینم باز اعطاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 270.9,
   "end": 276.54,
   "text": "\"من لم يسأله\" اصلاً سؤالی هم وجود داره و \"لم يعرفه\" اصلاً هیچ ته--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 276.54,
   "end": 283.9,
   "text": "بعد \"تهنن منه ورحمة\" این تهنن تو، این محنت، منحت تو، این بخشش تو، رحمت تو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 283.9,
   "end": 286.28,
   "text": "بدون هیچگونه سؤال و حتی معرفتیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 286.28,
   "end": 290.92,
   "text": "این برمی‌گرده به کجا؟ برمی‌گرده حتی به خلقت من و تو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 290.92,
   "end": 293.48,
   "text": "اصلاً ما نه-- اصلاً وجودی نداشتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 293.48,
   "end": 297.2,
   "text": "خدا به ابتدا انشا کرد ما رو خلق کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 297.2,
   "end": 302.78,
   "text": "نه می‌شناختیم، نه اصلاً بودیم که سؤال بکنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 302.78,
   "end": 308.48,
   "text": "این البته یه وجهشه. اینم یه نوع بخشش خداست که نه سؤالی وجود داره از طرف ما،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 308.48,
   "end": 311.86,
   "text": "نه معرفتی و نه چیزی که بخوایم بدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 311.86,
   "end": 315.3,
   "text": "قلیلی هم نیست که بخواد خدا به کثرت ببخشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 315.3,
   "end": 320.9,
   "text": "بعد دقت بفرمایید. بعد میاد اینجا حالا کدوم قسمتو نشونه گرفته دعا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 320.9,
   "end": 324.18,
   "text": "کدوم عطاهارو از این سه دسته عطاء نشونه گرفته؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 324.18,
   "end": 326.7,
   "text": "أعطني، أعطني به کجاست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 326.7,
   "end": 329.84,
   "text": "أعطني به بگید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 329.84,
   "end": 333.8,
   "text": "مسألتی. اون قسمت وسط رو گرفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 333.8,
   "end": 337.26,
   "text": "حالا تو ببخش به من به سوالم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 337.26,
   "end": 339.72,
   "text": "من دارم سؤال می‌کنم دیگه. یعنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 339.72,
   "end": 345.16,
   "text": "نه \"من لم يسأله\" هست و نه \"بالقلیل\" هیچ کدوم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 345.16,
   "end": 348.14,
   "text": "\"بمسألتی\" اون قسمت وسط.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 348.14,
   "end": 353.38,
   "text": "یعنی من دارم یه چیزی رو میگم، می‌خوام، بیان می‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 353.38,
   "end": 354.96,
   "text": "اینطور نیست که هیچی هم نباشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 354.96,
   "end": 358.84,
   "text": "یه م-ما یملکی دارم اونم دعای منه، درخواست منه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 358.84,
   "end": 362.42,
   "text": "بعد حالا جالبه که قسمت انتها که دست به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 362.42,
   "end": 365.18,
   "text": "محاسن شریف می‌گیره یا پوست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 365.18,
   "end": 367.58,
   "text": "چانه مبارک رو این صدا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 367.58,
   "end": 370.58,
   "text": "این سه دسته اسمی که با \"یا\" یا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 370.58,
   "end": 372.62,
   "text": "به هم پیوند خورده برمی‌گرده به اونجا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 372.62,
   "end": 375.58,
   "text": "\"یا ذو الجلال والإكرام\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 375.58,
   "end": 378.18,
   "text": "مال \"یا مَيِّئَتِ الْكَثِيرَ بِالْقَلِيلَ\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 378.18,
   "end": 381.22,
   "text": "\"يا ذَا النَّعْمَاءِ وَالْجُودِ\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 381.22,
   "end": 383.36,
   "text": "مال \"يا مَيِّؤْتي مَنْ سَعَلَس\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 383.36,
   "end": 389.84,
   "text": "\"يا ذَا الْمَنِّ وَالتَّوْلِ\" مال \"يا مَيِّؤْتي مَنْ لَمْ يَسْأَلْهُ وَمَنْ لَمْ يَعْرِفْهُ\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 389.84,
   "end": 392.18,
   "text": "اینا رو حالا من همین الان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 392.18,
   "end": 395.74,
   "text": "قبل نماز داشتم بهش فکر می‌کردم این پیوندها رو خدا عنایت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 395.74,
   "end": 398.26,
   "text": "کرد به قلب ما القاشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 398.26,
   "end": 400.72,
   "text": "ولی خب هـ-- بحث خیلی بالاتر از این حرفاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 400.72,
   "end": 402.82,
   "text": "من تبرکم میگم شما برید دنبالش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 402.82,
   "end": 406.62,
   "text": "حالا حرف چیه؟ چه ربطی به بحث ما داره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 406.62,
   "end": 411.1,
   "text": "اونجایی که به مقام سؤال می‌شینی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 411.1,
   "end": 416.26,
   "text": "که خ-- از خدا عطا بگیری، عطای خدا رو شامل بشه وجودت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 416.26,
   "end": 419.52,
   "text": "میگی \"بمسألتی\" یه چیزی رو بیان می‌کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 419.52,
   "end": 423.64,
   "text": "این بیان، گویش، گفتن، قَالُوا، قَالَ،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 423.64,
   "end": 425.5,
   "text": "قِيلَ اینا خیلی مهمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 425.5,
   "end": 430.26,
   "text": "ما دست کم گرفتیم. لذا حالا برگردید به آیه‌ای که مورد بحث ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 430.26,
   "end": 433.46,
   "text": "ببینید از رو می‌خونم ببینید متوجه شدید کجا رو زدیم یا نه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 433.46,
   "end": 438.4,
   "text": "نشونه‌ی ما کجا بوده. هشت تا هشت بقره \"وَقَالُوا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 438.4,
   "end": 441.12,
   "text": "وَقَالُوا\" درسته؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 441.12,
   "end": 444.88,
   "text": "\"وَقَالُوا\". قَالُوا گفتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 444.88,
   "end": 448.56,
   "text": "\"قُلُوبُنَا غُلْفٌ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 448.56,
   "end": 451.56,
   "text": "بَلْ لَعَنَهُمُ اللهُ بكفرهم فَقَلِيلًا\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 451.56,
   "end": 457.72,
   "text": "چون من وعده داده بودم پیرامون کلمه، کلمه‌شم حرف بزنیم دیگه معنی کلی گفتیم حالا کلمات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 457.72,
   "end": 461.22,
   "text": "قَالُوا گفتن. حتی در خصوص",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 461.22,
   "end": 464.86,
   "text": "اهل ایمان هم میگه \"الذين قالوا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 464.86,
   "end": 467.46,
   "text": "ربنا الله ثم استقاموا\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 467.46,
   "end": 472.38,
   "text": "اول میگه گفتن. \"قالوا ربنا الله\" بعد \"ثم استقاموا\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 472.38,
   "end": 476.54,
   "text": "بدون گویش نمی‌شه. \"قُولُوا لَا إِلَهَ إِلَّا اللهُ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 476.54,
   "end": 479.78,
   "text": "تُفْلَحُوا\". تُفْلَحُوا هست ولی بعد از قُولُوا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 479.78,
   "end": 485.12,
   "text": "اینطور نیست که من زبان ببندم هیچ گویش نداشته باشم، هیچ ادعایی نداشته باشم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 485.12,
   "end": 491.16,
   "text": "هیچ مرامنامه‌ای رو بیان نکنم، خودمو معرفی نکنم، خواست وجودیمو نگم بعد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 491.16,
   "end": 495.8,
   "text": "خبری هم بشه، نه. می‌خواد بگه گویش خیلی مهمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 495.8,
   "end": 501.1,
   "text": "اینطور نیست که ما بگیم ول کن بابا خدا دلتو نگاه می‌کنه دیگه حالا از زبونت هرچی جاری شد شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 501.1,
   "end": 503.5,
   "text": "اینطوری نیست. بله برای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 503.5,
   "end": 506.84,
   "text": "عموم مردم، اینایی که سطح پایینن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 506.84,
   "end": 510.58,
   "text": "یعنی دیگه از عفو مردمن خدا سخت نمی‌گیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 510.58,
   "end": 514.36,
   "text": "ولی وقتی یه ذره میری بالاتر این گویشت خیلی مهمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 514.36,
   "end": 521.38,
   "text": "بخوای یه پله بری بالاتر و به مقام سؤال-- اینجا چون اینا ادعا می‌کنن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 521.38,
   "end": 523.4,
   "text": "میگن \"قالوا قلوبنا غلف\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 523.4,
   "end": 528.7,
   "text": "غلف جمع أغلف. أغلف یعنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 528.7,
   "end": 530.74,
   "text": "در غلاف قرار گرفته شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 530.74,
   "end": 532.58,
   "text": "مثل شمشیری که تو غلافه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 532.58,
   "end": 534.56,
   "text": "پره. یعنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 534.56,
   "end": 539.6,
   "text": "مثل دقیقاً حرف کسایی که میگن بابا حرف گوش ما از این حرفا پره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 539.6,
   "end": 542.88,
   "text": "یا میگن اصلاً چون بعضی از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 542.88,
   "end": 544.88,
   "text": "بنی‌اسرائیل این حرفو می‌زدن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 544.88,
   "end": 547.24,
   "text": "به سابقه خودشون. بعد قرآن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 547.24,
   "end": 549.16,
   "text": "داره میگه اینام پیرو همونان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 549.16,
   "end": 554.88,
   "text": "مشرکین و کفار. اینام میگن که آقا ما با همون آموزه‌های تورات و انجیل بسمونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 554.88,
   "end": 559.34,
   "text": "دل ما، وجود ما، فکر ما، عقل ما پره از اون آموزه‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 559.34,
   "end": 563.12,
   "text": "دیگه نه مثل بعضیا که دو، دو تا کلام حرف یاد می‌گیرن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 563.12,
   "end": 565.18,
   "text": "دو تا رکعت نماز می‌خونن میگن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 565.18,
   "end": 568.36,
   "text": "می‌خوایم دیگه چیکار کنیم؟ همه چی داریم دیگه ما رسیدیم بسمونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 568.36,
   "end": 572.9,
   "text": "بسمونه این. در صورتی که اینطوری نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 572.9,
   "end": 576.44,
   "text": "یعنی تو باید هی پله پله بری بالا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 576.44,
   "end": 582.46,
   "text": "اینجا تو حالا آیه نود و یک هود هم باز میگن \"یا شعيب ما نفقه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 582.46,
   "end": 585.3,
   "text": "ما نفقه\" ما حرف تو رو نمی‌فهمیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 585.3,
   "end": 591.96,
   "text": "آیه پنج فصلت \"قلوبنا في أكنة\" دل‌های ما توی پرده پوشیده شده‌ست که قبلاً بحث کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 591.96,
   "end": 594.32,
   "text": "قلب مکنون. این ادعای ایناست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 594.32,
   "end": 597.46,
   "text": "میاد بعضیا میگن قلب ما کشش داره‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 597.46,
   "end": 601.24,
   "text": "نمی‌خواد بره زیر بار. قبلاً گفتیم خودشو می‌زنه به نفهمی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 601.24,
   "end": 606.22,
   "text": "ما نمی‌فهمیم ما این حرفا رو. یا میگه نه اصلاً ما می‌فهمیم اینکه ما داریم بسمونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 606.22,
   "end": 609.06,
   "text": "این معنا رو هم می‌ده. تو برو دنبال کار خودت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 609.06,
   "end": 612.22,
   "text": "ما می‌فهمیم. دل ما پره از این مسائل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 612.22,
   "end": 614.58,
   "text": "اینا همش باعث می‌شه که چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 614.58,
   "end": 616.68,
   "text": "حالا ترس، ترس از اینجا شروع می‌شه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 616.68,
   "end": 620.98,
   "text": "نهیب. \"بل لعنهم الله\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 620.98,
   "end": 623.48,
   "text": "اینا از رحمت خدا به دور می‌شن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 623.48,
   "end": 626.46,
   "text": "بسیاری از دوری‌های ما از رحمت خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 626.46,
   "end": 629.74,
   "text": "به خاطر همین حالته، همین وضعیت ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 629.74,
   "end": 634.52,
   "text": "که حاضر شدیم درجا بزنیم حتی حالا بریم جلوتر خطرناک‌تر می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 634.52,
   "end": 636.6,
   "text": "امیدوارم شما باشید بشنوید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 636.6,
   "end": 639.2,
   "text": "خطرناک‌تر می‌شه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 639.2,
   "end": 646.2,
   "text": "حتی برای ماها اهل مطالعه و تحقیق و پژوهش و قرآن و هیئت و مسجد و اینها هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 646.2,
   "end": 649.88,
   "text": "تو این آیه نهیب داره. بعداً بهتون میگم کجاش نهیب داره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 649.88,
   "end": 655.22,
   "text": "که درجا می‌زنیم تو یه سطحی میگیم بسه تا همینجا امام حسین، کربلا، مشهد بسه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 655.22,
   "end": 658.02,
   "text": "هیئت بسه. حاضر نیستیم رشد کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 658.02,
   "end": 660.96,
   "text": "باز اینم یه نوع ادعاست که این برای من بسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 660.96,
   "end": 663.64,
   "text": "\"قلوبنا غلف\" پره قلب من.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 663.64,
   "end": 665.28,
   "text": "دیگه نمی‌خوام. نیاز ندارم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 665.28,
   "end": 670.74,
   "text": "اینا خیلی خطر بزرگیه برای امثال ما که هر کدوم ادعای اجتهاد داریم و فکر می‌کنیم خبریه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 670.74,
   "end": 677.0,
   "text": "حتی ت-- صحبت‌های بزرگان و مثل رهبر و دیگران هم میایم تفسیر به رأی خودمون می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 677.0,
   "end": 681.48,
   "text": "میگیم منظور آقا اینه، منظور مرجع اینه، منظور دین اینه، منظور قرآن اینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 681.48,
   "end": 686.22,
   "text": "اینا به خاطر اینکه مدعی هستیم فکر می‌کنیم دلمون پره از حقایق و نیازی نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 686.22,
   "end": 688.6,
   "text": "خیلی آیه عجیبیه کوتاه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 688.6,
   "end": 691.78,
   "text": "پر از نکات. انشاالله خدا توفیق بده به هممون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 691.78,
   "end": 694.42,
   "text": "عاقبتمون انشاالله ختم به خیر بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 694.42,
   "end": 697.36,
   "text": "به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 697.36,
   "end": 699.68,
   "text": "اللهم صل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 699.68,
   "end": 702.46,
   "text": "على محمد و آل محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}