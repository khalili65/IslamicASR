 },
 "chapters": [
  {
   "index": 0,
   "title": "## قالوا قلوبنا غلف؛ مقایسه با یؤمنون",
   "start": 26.8,
   "end": 49.58
  },
  {
   "index": 1,
   "title": "## عیسی بر آب؛ تأسی به ولایت",
   "start": 49.58,
   "end": 266.06
  },
  {
   "index": 2,
   "title": "## دانایی بدون دارایی",
   "start": 266.06,
   "end": 448.2
  },
  {
   "index": 3,
   "title": "## از لقلقه تا پیاده‌سازی",
   "start": 448.2,
   "end": 582.42
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.3,
   "end": 4.9,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 4.9,
   "end": 12.48,
   "text": "السلام علیک ای داعی الله و ربانی آیاته سلام علیکم و رحمه الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 12.48,
   "end": 20.12,
   "text": "نکته‌ی دیگه‌ای که به ذهنم عارض شد که تقدیم شما عزیزان کنیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 20.12,
   "end": 23.56,
   "text": "بر اساس آیه هشتاد و هشت سوره بقره که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 23.56,
   "end": 31.62,
   "text": "دقت فرمودید، جالبه که ابتدای آیه وقتی از لسان مشرکین و منافقین حرف می‌زنه با",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 31.62,
   "end": 33.94,
   "text": "گفت‌وگو سخن رو آغاز می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 33.94,
   "end": 36.7,
   "text": "فقالوا، قلوبنا قلف.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 36.7,
   "end": 43.96,
   "text": "اینا حرف زدن، گفتن که در خصوص نعمت تکلم و حرف زدن و اهمیت اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 43.96,
   "end": 49.58,
   "text": "قبلاً سخن گفتیم. امروز نکته‌ی دیگه‌ای رو می‌خوایم یه تشابهی، یه وجه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 49.58,
   "end": 51.5,
   "text": "در حقیقت مقایسه‌ای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 51.5,
   "end": 53.66,
   "text": "ببخشید. یه مقایسه‌ای بین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 53.66,
   "end": 58.04,
   "text": "این‌ها و اونهایی که از بین این‌ها نجات پیدا می‌کنند رو بیان کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 58.04,
   "end": 62.06,
   "text": "یه مقایسه‌ای. چون انتهای آیه میگه فَقَلِیلًا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 62.06,
   "end": 66.82,
   "text": "مَّا یُؤْمِنُونَ. یه عده خیلی کمی از این‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 66.82,
   "end": 69.12,
   "text": "ایمان میارن و اهل هدایت‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 69.12,
   "end": 73.08,
   "text": "اینجا رو دقت بفرمایید. یه نکته خوبی گیرمون بیاد امروز.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 73.08,
   "end": 79.74,
   "text": "اول وقتی می‌خواد از اونهایی که لعنت خدا شامل حالشون شده و دچار قلب اغلف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 79.74,
   "end": 83.12,
   "text": "و در غلاف غفلت گرفته شده‌اند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 83.12,
   "end": 87.04,
   "text": "سخن بگه، قرآن میگه فقالوا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 87.04,
   "end": 89.9,
   "text": "قلوا گفتند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 89.9,
   "end": 93.72,
   "text": "از صحبت و بیان و کلام حرف می‌زنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 93.72,
   "end": 104.12,
   "text": "وقتی میاد انتهای آیه تمییز قائل میشه میگه عده‌ی قلیلی از این‌ها اهل نجات شدن و ایمان آوردن اصلاً بحث تکلم نیست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 104.12,
   "end": 110.74,
   "text": "بحث ایمان است. فَقَلِیلًا مَّا یُؤْمِنُونَ ایمان ربط به باطن بر-داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 110.74,
   "end": 117.32,
   "text": "هیچ ربطی بر اساس این آیه که داریم یه مقایسه‌ای می‌کنیم به ظاهر نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 117.32,
   "end": 121.16,
   "text": "خیلیا رو می‌بینید شاید ظاهراً حرفی نداشته باشن برای گفتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 121.16,
   "end": 128.64,
   "text": "می‌شینی پیششون حتی شاید بلد نباشن دو کلمه حرف بزنن اما سر تا پای وجودشون ایمان محضند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 128.64,
   "end": 136.68,
   "text": "زیادم دیدیم و بالعکس خیلیا شاید در لسان، در بیان چنان قشنگ و شیوا حرف بزنن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 136.68,
   "end": 142.08,
   "text": "معارف و علوم رو حتی علوم الهی رو چنان خوب بیان کنن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 142.08,
   "end": 146.66,
   "text": "لکن در درونشون می‌بینی تهین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 146.66,
   "end": 148.78,
   "text": "این مقایسه در کجا ایجاد می‌شه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 148.78,
   "end": 153.7,
   "text": "چرا اینا میگن وقالوا و گفتند قلوبنا قلف.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 153.7,
   "end": 157.58,
   "text": "این بر می‌گرده به در حقیقت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 157.58,
   "end": 159.7,
   "text": "دو نوع علم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 159.7,
   "end": 164.18,
   "text": "که حضرت علامه حسن زاده فضله الله تعالی بر اساس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 164.18,
   "end": 168.8,
   "text": "حالا برداشت‌هاشون البته در بسیاری از کتاب‌های حکمت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 168.8,
   "end": 172.34,
   "text": "متعالیه این اومده که ما دو نوع علم داریم:",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 172.34,
   "end": 175.44,
   "text": "علم فکری، علم شهودی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 175.44,
   "end": 178.54,
   "text": "علم فکری یعنی اینکه تو یک چیزی رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 178.54,
   "end": 186.24,
   "text": "می‌فهمی صرفاً بر می‌گرده به عملیات دانش ورزی، دانشجویی، طلبگی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 186.24,
   "end": 188.5,
   "text": "طلبه‌ای، دانشجویی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 188.5,
   "end": 192.32,
   "text": "دانش‌پذیری، دانش و علم رو فرا می‌گیری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 192.32,
   "end": 195.6,
   "text": "اصطلاحاً اینجا حضرت علامه می‌فرمایند تو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 195.6,
   "end": 198.62,
   "text": "در حقیقت دانا می‌شوی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 198.62,
   "end": 201.8,
   "text": "با علم فکری دانا می‌شوی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 201.8,
   "end": 204.54,
   "text": "که میگه قالوا بر می‌گرده به نطق،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 204.54,
   "end": 208.68,
   "text": "بر می‌گرده به کلام، بر می‌گرده به بیان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 208.68,
   "end": 211.14,
   "text": "تا پای درس معلم نشینی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 211.14,
   "end": 213.82,
   "text": "تا خودت نگی که برات تصویر بشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 213.82,
   "end": 222.02,
   "text": "تا کتاب نخونی، تا یک صوتی که کم و کیف مسموع شنیداری صوته عارضیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 222.02,
   "end": 226.38,
   "text": "مربوط به نشئیت طبیعتش ربطی به عالم لکوت نداره ظاهراً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 226.38,
   "end": 230.58,
   "text": "نشنوی، تا صوت معلم رو نشنوی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 230.58,
   "end": 233.82,
   "text": "نمی‌تونی به این علم رو دارا بشی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 233.82,
   "end": 237.82,
   "text": "یا با چشم در کتاب نخونی نمی‌تونی دارا بشی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 237.82,
   "end": 240.16,
   "text": "اما این نمی‌تونی دانا بشی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 240.16,
   "end": 243.5,
   "text": "اما این دانایی توئه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 243.5,
   "end": 246.76,
   "text": "ما داریم چیز دیگه‌ای رو اینجا عرض می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 246.76,
   "end": 251.74,
   "text": "می‌گیم خب این دانایی توئه، حالا دارایی تو چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 251.74,
   "end": 255.9,
   "text": "تو یه چیزی رو دانا شدی اما چی رو داری حالا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 255.9,
   "end": 259.44,
   "text": "دانایی با دارایی به قول علامه فرق می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 259.44,
   "end": 262.12,
   "text": "دانایی اینه که تو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 262.12,
   "end": 266.06,
   "text": "داری علم رو یاد می‌گیری. علمه، علم فکریه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 266.06,
   "end": 268.22,
   "text": "حفظ می‌کنی یه سری محفوظات رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 268.22,
   "end": 271.94,
   "text": "اما دارایی اون چیزی‌ست که تو به علم شهودی بهش می‌رسی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 271.94,
   "end": 275.76,
   "text": "اون دیگه جایگاه قلب ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 275.76,
   "end": 278.52,
   "text": "اگر بخواهیم به یک معنا تفکیک قائل بشیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 278.52,
   "end": 281.48,
   "text": "جایگاه علم فکری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 281.48,
   "end": 286.86,
   "text": "عقل ماست. جایگاه علم شهودی قلب ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 286.86,
   "end": 290.06,
   "text": "لذا دقت کنید الان متوجه می‌شید چی شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 290.06,
   "end": 292.94,
   "text": "اول اینا میان میگن قالوا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 292.94,
   "end": 298.12,
   "text": "اصلاً مستقیم میگه اینا اهل بیان و کلام و محاجه و گفت‌وگو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 298.12,
   "end": 301.36,
   "text": "و شلوغ بازار بودند. اما آخر فَقَلِیلًا مَّا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 301.36,
   "end": 307.52,
   "text": "یُؤْمِنُونَ ایمان. اصلاً حرفی از تکلم و بیان و کلام و این چیزا نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 307.52,
   "end": 309.84,
   "text": "ایمانه، ایمان بر می‌گرده به چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 309.84,
   "end": 318.12,
   "text": "اون دلدادگی، دلش خواسته، دلش ایمان آورده، باور قلبی اصلاً قلبه، جایگاه ایمان قلبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 318.12,
   "end": 321.32,
   "text": "جایگاه ایمان قلبه. لذا این بر می‌گرده به علم شهودی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 321.32,
   "end": 323.98,
   "text": "یعنی چشیدن یعنی دارا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 323.98,
   "end": 328.92,
   "text": "شدن، نه دانا شدن، چشیدن، رسیدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 328.92,
   "end": 333.32,
   "text": "یک وقت هست شما مثلاً حالا اجازه بدید یه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 333.32,
   "end": 335.1,
   "text": "روایت خیلی شیرینی براتون بگم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 335.1,
   "end": 338.06,
   "text": "اینو خوب قشنگ توجه کنید قشنگ متوجه می‌شید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 338.06,
   "end": 340.0,
   "text": "فرقش چیه. خدا حفظ کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 340.0,
   "end": 343.7,
   "text": "علامه اینو در کتاب این روایت رو در کتاب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 343.7,
   "end": 346.56,
   "text": "ولایت تکوینیه‌شون آوردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 346.56,
   "end": 352.7,
   "text": "میگن که یک روزی حضرت عیسی علیه نبي و آله و عليه الصلاة والسلام با یکی از صحابه‌شون می‌رفتند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 352.7,
   "end": 355.66,
   "text": "صحابی پشت سر حضرت عیسی در حرکت بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 355.66,
   "end": 362.0,
   "text": "توجه هم به هیچکس نداشت. قدم به قدم پشت سر حضرت عیسی آن طور سر تا سر پایین داشت می‌رفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 362.0,
   "end": 363.7,
   "text": "حالا جا پای ولایت می‌ذاشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 363.7,
   "end": 367.06,
   "text": "می‌رفت یه دفعه متوجه شد که رواده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 367.06,
   "end": 369.42,
   "text": "رو آبه داره پشت سر حضرت عیسی راه میره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 369.42,
   "end": 374.34,
   "text": "خب پشت سر حضرت عیسی پاشو جای پای حضرت عیسی گذاشته بود می‌رفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 374.34,
   "end": 376.12,
   "text": "تمسک به حضرت عیسی داشته بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 376.12,
   "end": 382.28,
   "text": "دید رو آبه داره راه میره و ظاهراً هم آب عمیقه، فرو نمیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 382.28,
   "end": 386.76,
   "text": "گوش داد دید حضرت عیسی داره میگه بسم الله الرحمن الرحیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 386.76,
   "end": 389.42,
   "text": "بسم الله الرحمن الرحیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 389.42,
   "end": 392.52,
   "text": "هی این کلام مقدس رو میگه و رو آب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 392.52,
   "end": 397.98,
   "text": "راه میره. گفت خب چرا من مثلاً به تبع ایشون رو آب برم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 397.98,
   "end": 399.88,
   "text": "ایشون داره بسم الله میگه رو آب راه میره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 399.88,
   "end": 405.26,
   "text": "خب بذار خودم بگم. تا گفت بسم الله الرحمن الرحیم رفت تو آب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 405.26,
   "end": 410.46,
   "text": "آب هم عمیق بود. داد فریاد حضرت دستشو گرفت نجاتش داد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 410.46,
   "end": 416.48,
   "text": "دو مرتبه رد شدن و بعد که از این حالت فارغ شدن حضرت فرمود که تو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 416.48,
   "end": 418.6,
   "text": "چرا اینطوری شدی؟ چیکار کردی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 418.6,
   "end": 421.44,
   "text": "به چی فکر کردی که این اتفاق افتاد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 421.44,
   "end": 426.56,
   "text": "گفت همچین چیزی شد. گفتم خب خودم میگم بسم الله الرحمن الرحیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 426.56,
   "end": 432.34,
   "text": "این شد که در آب فرو رفت حضرت می‌فرمود که خب تو باید تأسی کنی به ولایت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 432.34,
   "end": 435.28,
   "text": "پشت سر ولایت حرکت کنی. نمیشه مستقلاً.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 435.28,
   "end": 440.76,
   "text": "حالا نتیجه‌ای که از این روایت حضرت علامه دارن در کتاب عنوانش چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 440.76,
   "end": 444.86,
   "text": "ولایت تکوینی. یعنی اساساً تو باید پشت سر ولایت باشی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 444.86,
   "end": 450.18,
   "text": "در طول ولایت باشی. هر چیزی که در طول ولایت بود نتیجه میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 450.18,
   "end": 452.72,
   "text": "اگر استقلال پیدا کنی هیچی نتیجه نمیده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 452.72,
   "end": 454.84,
   "text": "اصلاً عمر ما به باد رفته است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 454.84,
   "end": 458.74,
   "text": "نکته دیگه اینکه همین بحثی که الان داریم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 458.74,
   "end": 461.76,
   "text": "حضرت عیسی مگر بسم الله الرحمن الرحیم نگفت؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 461.76,
   "end": 464.22,
   "text": "این آقا هم مگه بسم الله الرحمن الرحیم نگفت؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 464.22,
   "end": 468.0,
   "text": "فرقشون چیه؟ این داناست، اون هم داناست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 468.0,
   "end": 472.84,
   "text": "فرقشون در چیه که ایشون فرو میره تو آب حضرت عیسی نمیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 472.84,
   "end": 476.32,
   "text": "به جهت اون داشت آقای حضرت عیساست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 476.32,
   "end": 485.1,
   "text": "یعنی حضرت عیسی حقیقت بسم الله الرحمن الرحیم رو به کشف شهودی به قلب مقدس خودش درک کرده، چشیده، رسیده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 485.1,
   "end": 489.84,
   "text": "در حقیقت حقیقت بسم الله الرحمن الرحیم تو وجود حضرت عیسی ایجاد شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 489.84,
   "end": 493.1,
   "text": "در حقیقت این حقیقت در وجودش پیاده شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 493.1,
   "end": 496.64,
   "text": "اما اون شخص نه همینطوری داره میگه بسم الله هیچ اثری هم نمیده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 496.64,
   "end": 502.8,
   "text": "تازه بالعکس خفه میشه. بسیاری از این دعاهایی که یه نهی‌بی هم بزنیم برای امروز بسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 502.8,
   "end": 506.32,
   "text": "بسیاری از این دعاهایی که به ما میگن آقا این کارو بکن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 506.32,
   "end": 512.2,
   "text": "مردت زنده میشه، مریظت شفا می‌گیره، وضع مالیت خوب میشه، گره‌ات اینطوری باز میشه فلان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 512.2,
   "end": 515.6,
   "text": "هرچی انجام میدیم هی خبری نشد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 515.6,
   "end": 521.82,
   "text": "علتش چیه؟ علتش اینه که اون حقیقت اون دعا، اون ذکر، خطب هرچی هست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 521.82,
   "end": 525.06,
   "text": "ما به قلبمون درک نکردیم این حقیقت رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 525.06,
   "end": 527.38,
   "text": "در وجود ما پیاده نشده اون حقیقت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 527.38,
   "end": 530.04,
   "text": "صرفاً شده علم فکری، دانایی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 530.04,
   "end": 534.0,
   "text": "لقلقه‌ی زبانه. این به کاری به جایی نمیرسونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 534.0,
   "end": 538.34,
   "text": "این فرقشه. لذا دقت بفرمایید اینو با یه دقت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 538.34,
   "end": 542.3,
   "text": "کوتاه به آیه خودتون متوجه فرق معامله میشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 542.3,
   "end": 547.92,
   "text": "اینا و قالوا قلوبنا قلف و با واو شروع میشه نه با فاء.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 547.92,
   "end": 551.94,
   "text": "و اینا گفتند قلب ما دچار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 551.94,
   "end": 555.3,
   "text": "غلافی است. خب اینا گفت و گوه، کلامه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 555.3,
   "end": 557.32,
   "text": "حالا بعد در خصوص",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 557.32,
   "end": 561.44,
   "text": "تفاوت بین کلام و گفت و گو و سکوت با هم حرف می‌زنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 561.44,
   "end": 563.9,
   "text": "اما اونه که نجات پیدا کردن آخر آیه میگه چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 563.9,
   "end": 565.66,
   "text": "فَقَلِيلًا مَّا يُؤْمِنُونَ.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 565.66,
   "end": 567.6,
   "text": "يُؤْمِنُونَ. این بحث قلبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 567.6,
   "end": 570.92,
   "text": "بحث کشف و شهوده. به قلبشون دریافتند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 570.92,
   "end": 573.36,
   "text": "اینا فرقش زمین تا آسمونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 573.36,
   "end": 576.18,
   "text": "ما هم باید انشاالله سعی کنیم به این کشف و شهود برسیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 576.18,
   "end": 582.42,
   "text": "کار، کار قلبه عزیزان. انشاالله عاقبتمون ختم به خیر بشه به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}