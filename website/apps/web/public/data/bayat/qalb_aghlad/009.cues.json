   "start": 0.48,
   "end": 77.98
  },
  {
   "index": 1,
   "title": "## حواس پنج‌گانه، خیال و وهم",
   "start": 77.98,
   "end": 171.18
  },
  {
   "index": 2,
   "title": "## عقل حاکم؛ هشت در بهشت",
   "start": 171.18,
   "end": 353.66
  },
  {
   "index": 3,
   "title": "## وهم عقل ساقط؛ عقل وهم ترفیع‌یافته",
   "start": 353.66,
   "end": 420.37
  },
  {
   "index": 4,
   "title": "## از تعبد تا برد الیقین",
   "start": 420.37,
   "end": 440.47
  },
  {
   "index": 5,
   "title": "## قلیل ما یؤمنون",
   "start": 440.47,
   "end": 568.75
  },
  {
   "index": 6,
   "title": "## از بیل تعبد تا برد یقین",
   "start": 568.75,
   "end": 589.23
  },
  {
   "index": 7,
   "title": "## دعای چشاندن حقایق",
   "start": 589.23,
   "end": 908.41
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.48,
   "end": 3.68,
   "text": "بسم الله الرحمن الرحیم و بهین استعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 3.68,
   "end": 7.32,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 7.32,
   "end": 11.78,
   "text": "آیاته. سؤال می‌شه که چرا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 11.78,
   "end": 16.12,
   "text": "در روایات داریم که جهنم هفت تا در داره و بهشت هشت تا در.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 16.12,
   "end": 21.14,
   "text": "خب اینم سری‌ست. یکی از خس میایم همینطوری برای خودمون یه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 21.14,
   "end": 28.48,
   "text": "چیزهایی می‌بافیم به هم برای اینکه یه جوابی بدیم مثل اینکه از اون مداحه پرسیدن چرا به روضه میگن روضه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 28.48,
   "end": 30.2,
   "text": "چرا نمیگن مصیبت‌خوانی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 30.2,
   "end": 34.44,
   "text": "گفت چون روضه بهشته، هیأت هم بهشته و این توجیهه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 34.44,
   "end": 42.58,
   "text": "اساساً چون اولین کتابی که پیرامون روضه افتاد دست مصیبت‌خوانان روضت و ش-- روضت الشهدا بود،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 42.58,
   "end": 47.36,
   "text": "روضه‌خوانی باب شد. روضت الشهدا اسم کتاب بود شد روضه‌خوانی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 47.36,
   "end": 49.54,
   "text": "آدم باید هر حرفی هم می‌زنه علمی بزنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 49.54,
   "end": 53.76,
   "text": "حضرت علامه عظمای زاهد خیلی زیبا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 53.76,
   "end": 57.52,
   "text": "البته بر مبنای نظرات امثال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 57.52,
   "end": 61.6,
   "text": "حضرت محی الدین شیخ اکبر علیه الرحمه فرمودن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 61.6,
   "end": 68.58,
   "text": "که ما در وجودمون، خب همه، همه ما انسان‌ها پنج تا حواس ظاهری داریم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 68.58,
   "end": 70.3,
   "text": "حواس خمسه بهش میگن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 70.3,
   "end": 76.34,
   "text": "این بینایی و شنوایی و بویایی و چشایی و لامسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 76.34,
   "end": 80.5,
   "text": "این پنج تا که مربوط به قوای ظاهری ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 80.5,
   "end": 83.36,
   "text": "بعد برزخ بین این ملک، این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 83.36,
   "end": 89.54,
   "text": "ظاهر و باطن وجود ما که ملکوت ماست، برزخ ما قوه خیال ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 89.54,
   "end": 91.86,
   "text": "یه پله بالاتر از قوه خیال، وهمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 91.86,
   "end": 96.56,
   "text": "قوه خیال که قبلاً عرض شد کارش عکس‌برداری و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 96.56,
   "end": 99.56,
   "text": "تصویربرداری و شکل و ص-صورت ایجاد کردنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 99.56,
   "end": 104.14,
   "text": "اونچه که در خواب مطلقاً هرچی می‌بینیم کار قوه خیال ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 104.14,
   "end": 108.14,
   "text": "یه پله بالاترش وهمه که جزئی می‌کنه حقایق کلیه رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 108.14,
   "end": 110.78,
   "text": "جزئی می‌کنه که تو بتونی بفهمی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 110.78,
   "end": 114.96,
   "text": "چند تاشو؟ دو تا و اونم پنج تا، هفت تا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 114.96,
   "end": 118.02,
   "text": "این هفت تا در جهنمند. چرا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 118.02,
   "end": 120.78,
   "text": "چون این‌ها به شدت انسان رو به بی‌راهه می‌کشونن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 120.78,
   "end": 124.84,
   "text": "چشم، گوش، چشیدن‌ها،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 124.84,
   "end": 130.06,
   "text": "شنیدن، عرض شود لمس کردن‌ها، بوییدن‌ها اینا همه در خطر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 130.06,
   "end": 135.52,
   "text": "این ملک و دنیا و معصیت و شیطنت و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 135.52,
   "end": 137.22,
   "text": "قوه خیال هم که بازیگریه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 137.22,
   "end": 140.48,
   "text": "تو دلت بخواد بازیگری داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 140.48,
   "end": 147.02,
   "text": "زیبایی‌ها رو احتمال داره چون قوه عقل درک می‌کنه به صورت کلی درک می‌کنه زیبایی چیز خوبی است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 147.02,
   "end": 150.28,
   "text": "میده و-- وهم جزئیش می‌کنه، وهم میده خیال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 150.28,
   "end": 153.06,
   "text": "شکلشو نشون بده، صورت بهش بسازه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 153.06,
   "end": 155.4,
   "text": "یه دفعه اشتباهی قوه خیال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 155.4,
   "end": 160.7,
   "text": "یه چیزی که زیبایی ظاهری داره نه باطنی رو به تو نشون میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 160.7,
   "end": 163.94,
   "text": "حالا اینجا نمی‌خوایم بحث کنیم یه ذره اذیت شید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 163.94,
   "end": 167.88,
   "text": "بحث اینطوری. می‌خوایم عرض کنیم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 167.88,
   "end": 172.96,
   "text": "قوه خیال و وهم هر دو بازیگری دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 172.96,
   "end": 177.38,
   "text": "در کنار اون پنج تا، هفت تا میشن در جهنم، هفت تا در جهنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 177.38,
   "end": 181.82,
   "text": "در صورتی که چی؟ نرن تحت سیطره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 181.82,
   "end": 184.58,
   "text": "سلطنت و حکومت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 184.58,
   "end": 187.24,
   "text": "اون یه رتبه بالاتر از خودشون که قوه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 187.24,
   "end": 191.04,
   "text": "عقل است. قوه عقل که اومد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 191.04,
   "end": 196.36,
   "text": "شد همه محکوم او شدن و او حکومت کرد بر این هفت تا قوای دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 196.36,
   "end": 198.94,
   "text": "یعنی انسان عاقلانه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 198.94,
   "end": 206.94,
   "text": "نگاه کرد، عاقلانه شنید، عاقلانه نفس زد، عاقلانه لمس کرد، عاقلانه بویید، عاقلانه چشید،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 206.94,
   "end": 210.36,
   "text": "عاقلانه خیال کرد، عاقلانه توهم کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 210.36,
   "end": 219.26,
   "text": "وهم هم یک نعمته که حیوانات تا وهم رو دارن به شدت هم وهمشون فعاله، دیگه عقل رو ندارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 219.26,
   "end": 224.2,
   "text": "کسی که تو وهمش گیر کرده هنوز به عقل نرسیده این حیون-حیوانه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 224.2,
   "end": 226.4,
   "text": "ظاهراً شبیه انسانه اما حیوانه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 226.4,
   "end": 229.34,
   "text": "چون هنوز به عقل وجودش دسترسی پیدا نکرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 229.34,
   "end": 232.84,
   "text": "قوه خیال و وهم اینا برزخن، بین ملک و ملکوتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 232.84,
   "end": 236.4,
   "text": "ملکوت عقل باطن وجود ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 236.4,
   "end": 238.88,
   "text": "اون پنج تا حواس هم که ظاهر ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 238.88,
   "end": 241.52,
   "text": "اگر کسی نتونه پل بزنه بین،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 241.52,
   "end": 244.08,
   "text": "از طریق برزخ وجودش،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 244.08,
   "end": 250.22,
   "text": "خیال و وهمش نتونه پل بزنه بین، بین ملک یعنی این پنج تا حواس ظاهری به ملکوت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 250.22,
   "end": 252.1,
   "text": "که همون عقلشه گیر می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 252.1,
   "end": 254.74,
   "text": "دیگه در هفت تا در جهنم به روش باز شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 254.74,
   "end": 261.5,
   "text": "اینطوری نیست که جهنمو فرض کن یه مثلاً چاله یه شهر پر از آتشه، هفت تا هم در داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 261.5,
   "end": 267.9,
   "text": "همچین چیزی نیست. بهشت هم اینطوری نیست که یه باغی باشه که هشت تا در براش فرض کرده باشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 267.9,
   "end": 270.62,
   "text": "ظاهراً این درها باز شه تو-- نهه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 270.62,
   "end": 273.6,
   "text": "بارها عرض کردیم علامه می‌فرماد که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 273.6,
   "end": 276.24,
   "text": "در کتاب هزار و یک کلمه‌شون دارن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 276.24,
   "end": 281.78,
   "text": "حالا تو هزار و یک نکته هم نکته‌ای رو پیرامون این قصه دارن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 281.78,
   "end": 285.98,
   "text": "خدا جهنمی را به جهنم نمی‌برد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 285.98,
   "end": 288.6,
   "text": "جهنمی خود جهنم می‌شود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 288.6,
   "end": 290.84,
   "text": "خدا بهشتی را به بهشت نمی‌برد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 290.84,
   "end": 293.22,
   "text": "بهشتی خود بهشت می‌شود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 293.22,
   "end": 296.88,
   "text": "ایناها باید اون کتاب‌ها رو بخونین تا قشنگ تا آخرش برید دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 296.88,
   "end": 300.22,
   "text": "وقتی قوه عقل اومده حاکم شد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 300.22,
   "end": 304.36,
   "text": "تو عاقلانه تصویرسازی کردی تو قوه خیالت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 304.36,
   "end": 308.84,
   "text": "عاقلانه وهم داشتی، توهم داشتی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 308.84,
   "end": 311.88,
   "text": "یعنی وهمتم زیربنای عقلت شد، اون موقع",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 311.88,
   "end": 313.82,
   "text": "میشه هشت تا دیگه. درست شد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 313.82,
   "end": 319.16,
   "text": "اون هفت تا عقل هم که اومد سیطره پیدا کرد میشه مجموعاً هشت تا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 319.16,
   "end": 323.0,
   "text": "میشه هشت در بهشت. یعنی اصلاً بهشت مال عقلاس،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 323.0,
   "end": 329.52,
   "text": "مال عاقله و اگر کسی به عقل به این عقلی که ما داریم الان میگیم این عقل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 329.52,
   "end": 332.16,
   "text": "در حقیقت خالصه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 332.16,
   "end": 336.14,
   "text": "حالا تو کتاب‌های فلاسفه و عرفا شما اینا رو می‌بینید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 336.14,
   "end": 339.28,
   "text": "عقل خالص اگه دیدید یعنی همین، همین عقل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 339.28,
   "end": 343.24,
   "text": "حالا بعضیا بهش گفتن وهم ترفوع یافته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 343.24,
   "end": 347.56,
   "text": "وهمی که مرتفع شده رفته بالا به رتبه بالاتر رسیده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 347.56,
   "end": 350.08,
   "text": "همون وهمه در حقیقت همون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 350.08,
   "end": 353.24,
   "text": "وهم عقل ماست اما ساقط شده، تنزل یافته‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 353.24,
   "end": 357.3,
   "text": "ببینید وهم به قول حضرت علامه ان الوهمه عقل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 357.3,
   "end": 362.42,
   "text": "ساقط. وهم عقل ساقط شده‌ست، تنزل پیدا کرده‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 362.42,
   "end": 365.45,
   "text": "جنس عقل رو داره اما کوچیکه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 365.45,
   "end": 368.27,
   "text": "خب حالا عقل چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 368.27,
   "end": 370.87,
   "text": "وهم ترفوع یافته‌ست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 370.87,
   "end": 373.31,
   "text": "بالا رفته، رفته به یه رتبه بالاتر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 373.31,
   "end": 375.97,
   "text": "در حقیقت وهم و همون خیال این دو تا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 375.97,
   "end": 380.29,
   "text": "برزخن. تا کسی عاقلانه زندگی نکنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 380.29,
   "end": 383.59,
   "text": "نمی‌تونه به بهشت برسه عزیز دلم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 383.59,
   "end": 385.71,
   "text": "اصلا بهشت مال آدم عاقله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 385.71,
   "end": 390.19,
   "text": "لذا مقدس‌ترین چیزی که خدا خلق کرده حدیث داریم عقله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 390.19,
   "end": 395.99,
   "text": "و این عقله که ما رو به اون قلب و س-- روح و سر و سر و سر می‌رسونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 395.99,
   "end": 398.91,
   "text": "باز عقل پل می‌زنه بین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 398.91,
   "end": 404.99,
   "text": "تمام مراتب وجودی ذیل تو، ذیل خودش یعنی از وهم بگیر تا قوای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 404.99,
   "end": 407.53,
   "text": "پنج گانه حواس ظاهریت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 407.53,
   "end": 409.85,
   "text": "پل می‌زنه بین اینا با اون ملکوت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 409.85,
   "end": 412.99,
   "text": "دیگه اون فوق ملکوت ببخشید فوق عرش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 412.99,
   "end": 415.17,
   "text": "یا اصطلاحاً جبروت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 415.17,
   "end": 417.47,
   "text": "بعد لاهوت. اون چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 417.47,
   "end": 422.13,
   "text": "اونا چین؟ اونا دیگه روح و قلب و روح و سر و سر و سر و اینان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 422.13,
   "end": 423.77,
   "text": "عقل باز پل می‌زنه برای اونا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 423.77,
   "end": 427.91,
   "text": "یعنی تو تا به عقلت نرسی نمی‌تونی اهل شهود بشی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 427.91,
   "end": 431.55,
   "text": "ما حالا این رب-- چه ربطی داشت به بحثمون؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 431.55,
   "end": 434.67,
   "text": "ما رو آیه هشتاد و هشت سوره بقره متوقف شدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 434.67,
   "end": 439.19,
   "text": "پیرامون قلب اغلف. گفتیم اینا و قالوا قلوبنا غلف.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 439.19,
   "end": 444.79,
   "text": "اینا مشرک و منافقین میگن قل-قلب ما مثل شمشیر در غلاف، قلب اغلف.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 444.79,
   "end": 447.57,
   "text": "قلبیه که پره از این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 447.57,
   "end": 450.97,
   "text": "حالا این چیزی که پیغمبر تو آوردی ما اینا رو از بحریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 450.97,
   "end": 453.23,
   "text": "پره، گوش ما پره از این حرفا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 453.23,
   "end": 459.43,
   "text": "ما اینا رو بلدیم. خب. و بل عنهم الله بكفرهم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 459.43,
   "end": 462.19,
   "text": "حالا امروز می‌خوایم رو کفر توقف کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 462.19,
   "end": 465.67,
   "text": "اینا مورد لعن واقع شدن چون دچار کفر شدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 465.67,
   "end": 472.27,
   "text": "چرا؟ چرا دچار ک-- اینا که دارن میگن آقا حق این olumi که تو آوردی پیغمبر اون خدایی که داری ما قبول داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 472.27,
   "end": 475.17,
   "text": "ما اصلا دل ما پره. گوش به پیغمبر نمیدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 475.17,
   "end": 478.05,
   "text": "میگن ما موحدیم. قالوا آمنا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 478.05,
   "end": 480.25,
   "text": "خب. اما چرا میگه بكفرهم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 480.25,
   "end": 482.41,
   "text": "چون یه چیزی رو پوشوندن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 482.41,
   "end": 485.83,
   "text": "یک ه-- کفر. كفر عنا سیئاتنا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 485.83,
   "end": 489.61,
   "text": "ریشه کفر، کفر، كفر اینا یعنی پوشاندن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 489.61,
   "end": 493.67,
   "text": "اینا رو یک حقیقتی از حقایق وجودیشونو پوشوندن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 493.67,
   "end": 497.43,
   "text": "اونو نمی‌بینن. استفاده ازش نمی‌کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 497.43,
   "end": 499.35,
   "text": "اون پوشوندن همون عقل وجودشونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 499.35,
   "end": 506.27,
   "text": "عقلشونو پوشوندن لذا دیگه خیلی رشد کرده باشن تا مرتبه وهم رفتن بالا، حیوانن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 506.27,
   "end": 512.69,
   "text": "حیوان هم متوهمه. جالبه که بدونید کسی که به عقلش نرسه قطعاً شیطان درش تصرف می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 512.69,
   "end": 516.59,
   "text": "چون شیطان تا جایی می‌تونه بیاد بالا که وهم انسانه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 516.59,
   "end": 521.25,
   "text": "دیگه به عقل نمی‌تونه-- شیطان مطلقا نمی‌تونه به عقل وجود ما دسترسی پیدا کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 521.25,
   "end": 524.45,
   "text": "به ملکوت ما نمی‌تونه. لذا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 524.45,
   "end": 526.39,
   "text": "تا وهمه، اگر کسی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 526.39,
   "end": 531.63,
   "text": "معذرت می‌خوام عذر می‌خوام حیوانی زندگی کنه قطعاً تحت ص-تصرف شیطانه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 531.63,
   "end": 534.49,
   "text": "اگرچه ان الوهمه عقل ساقط،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 534.49,
   "end": 537.25,
   "text": "یه عقل تنزل یافته‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 537.25,
   "end": 540.57,
   "text": "فکر می‌کنه خیلی چیزی می‌دونه اما اینطوری نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 540.57,
   "end": 543.73,
   "text": "بعد حالا برگردونش الصاقش کنیم به بحث دیروز.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 543.73,
   "end": 545.77,
   "text": "قالوا گفت‌وگو می‌کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 545.77,
   "end": 548.53,
   "text": "اینا حرف می‌زنن، حرف زدن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 548.53,
   "end": 550.87,
   "text": "مال علم فکریه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 550.87,
   "end": 555.11,
   "text": "علم فکریه با وهمش با خیالش فکر می‌کنه عالمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 555.11,
   "end": 557.23,
   "text": "هنوز به عقل وجودش نرسیده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 557.23,
   "end": 559.87,
   "text": "الان تو همون علم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 559.87,
   "end": 562.11,
   "text": "تو همون علم اليقینش گیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 562.11,
   "end": 567.31,
   "text": "چه برسه به عين اليقين و حق اليقين و برد اليقين.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 567.31,
   "end": 571.29,
   "text": "يقين مراطبی داره من و شما یکی از اسمای خدا يقينه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 571.29,
   "end": 575.67,
   "text": "رفیق تا من و شما به يقين نرسیم اهل بهشت نمی‌شیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 575.67,
   "end": 577.43,
   "text": "منتها از علم باید شروع کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 577.43,
   "end": 579.29,
   "text": "نه که علم فکری زیرش رو بزنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 579.29,
   "end": 582.25,
   "text": "نه که بگی شیخ الرئیس مثلاً رئیس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 582.25,
   "end": 589.23,
   "text": "مشاء و مش حرکت، برهان، تلاش، تلاش علمی اینو زیر questions بزنی صرفا بری دنبال عرفا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 589.23,
   "end": 592.65,
   "text": "و مثلاً ملاصدرا و یا عرض شود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 592.65,
   "end": 596.77,
   "text": "مثلاً افلاطون و این‌ها یا شیخ اشراق که اشراقی هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 596.77,
   "end": 601.21,
   "text": "در رتبه عرفانی رو نه، از اون باید به اون رسید که دیروز بحثش گذشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 601.21,
   "end": 605.19,
   "text": "منتها باید اینا بیان تحت سیطره عقل قرار بگیرن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 605.19,
   "end": 611.31,
   "text": "بعد اگر قرار گرفتن یک سر يا مبدل السيئات بالحسنات یعنی این.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 611.31,
   "end": 614.13,
   "text": "اون سیئات من و تو که هفت تا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 614.13,
   "end": 618.03,
   "text": "اون هفت تا رتبه وجودیه، پنج تا حواس با-- ظاهری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 618.03,
   "end": 620.73,
   "text": "به علاوه خیال و وهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 620.73,
   "end": 625.07,
   "text": "مبدل میشن، اون سیئات بدل میشن به حسنات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 625.07,
   "end": 626.91,
   "text": "زیر در سیطره چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 626.91,
   "end": 631.17,
   "text": "عقل. عقل میاد اینا رو به حسنه تبدیل می‌کنه و تو رو بهشتی می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 631.17,
   "end": 634.45,
   "text": "بهشت جایگاه محسنینه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 634.45,
   "end": 638.33,
   "text": "نیکوکاران. حالا تو اگه زرنگ باشی دیگه حالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 638.33,
   "end": 642.23,
   "text": "بکشی بالاتر عقلت رو از عقلت کمک بگیری بکشی بالاتر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 642.23,
   "end": 645.45,
   "text": "بله. دیگه بعد از اون دوباره چی هست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 645.45,
   "end": 648.35,
   "text": "حق اليقين هست. ببینید اینم بگمو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 648.35,
   "end": 653.51,
   "text": "دیگه اذیتتون نکنم. اینم فرمولشو داشته باشید تو ذهنتون روش فکر کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 653.51,
   "end": 657.61,
   "text": "فکر کنید. البته ما باید متفکر، ما که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 657.61,
   "end": 660.83,
   "text": "اهل فکر هستیم اما شاید متفکر نباشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 660.83,
   "end": 665.85,
   "text": "ما اهل تحقیق هستیم. الان این کاری که من دارم می‌کنم با شما با همدیگه بهش میگن تحقیق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 665.85,
   "end": 668.75,
   "text": "اما شاید متحقق نباشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 668.75,
   "end": 672.01,
   "text": "اهل دقت هستیم. داریم دقت به این آیات و روایات می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 672.01,
   "end": 676.55,
   "text": "شاخ‌نباتی از قرآن و سنت. اما شاید متدقق نباشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 676.55,
   "end": 681.35,
   "text": "یعنی این حرفا اگر پیاده شد تو وجودم من متق-- متدققم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 681.35,
   "end": 683.37,
   "text": "من متحققم، من",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 683.37,
   "end": 685.51,
   "text": "عرض شود ااا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 685.51,
   "end": 691.29,
   "text": "حالا معلمم و الا اگر غیر از این باشه یه معلمم، یه مثلاً عالم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 691.29,
   "end": 694.61,
   "text": "صرف فکری. نرسیدم به اون کشف و شهود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 694.61,
   "end": 698.81,
   "text": "این فرمولو داشته باشید. اول از علم اليقين شروع می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 698.81,
   "end": 701.53,
   "text": "اکثراً مردم شما اینو باور کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 701.53,
   "end": 704.67,
   "text": "خیلی از ماها حتی به علم اليقين هم نمی‌رسیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 704.67,
   "end": 706.73,
   "text": "چرا؟ تعبداً می‌پذیریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 706.73,
   "end": 709.51,
   "text": "بد هم نیستا. تعبدًا با",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 709.51,
   "end": 711.55,
   "text": "میگه آقا خدا نیست. میگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 711.55,
   "end": 713.59,
   "text": "ثابت کن. نمی‌دونه، نمی‌تونه ثابت کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 713.59,
   "end": 715.43,
   "text": "میگه یه بار بگی دیگه خدا نیستا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 715.43,
   "end": 717.25,
   "text": "من بیل رو برمی‌دارم می‌کوبم تو کله‌ت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 717.25,
   "end": 719.81,
   "text": "خدا هست. تعبدًا پذیرفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 719.81,
   "end": 725.11,
   "text": "خب علمش کو؟ باید رفت از تعبد یعنی عابد بشه چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 725.11,
   "end": 727.03,
   "text": "عالم. علم اليقين.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 727.03,
   "end": 731.07,
   "text": "این علم فکری رو بره طی کنه، کتاب بخونه، معلم ببینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 731.07,
   "end": 734.83,
   "text": "درسته حجاب اکبره که این حدیث کار دست حکمت داده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 734.83,
   "end": 737.59,
   "text": "العلم حجاب الاکبر کار داده دست حکمت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 737.59,
   "end": 740.85,
   "text": "آقا اول باید حکمت کار کرد بعد رفته سراغ اخلاق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 740.85,
   "end": 742.81,
   "text": "و الا زیر-- یعنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 742.81,
   "end": 746.15,
   "text": "میشه گفت میزنه از زیر حکمتو خال--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 746.15,
   "end": 748.05,
   "text": "کله پا میکنه، چی؟ اخلاق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 748.05,
   "end": 754.79,
   "text": "اول حکمت. ادعو الی سبيل ربک بالحكمة والموعظة الحسنة.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 754.79,
   "end": 758.09,
   "text": "پس بعد از علم یعنی عابد باید بشه عالم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 758.09,
   "end": 761.77,
   "text": "بعد علم اليقين باید بشه عين اليقين.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 761.77,
   "end": 765.53,
   "text": "یعنی ببینی عقلت بیاد کمکت بده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 765.53,
   "end": 768.85,
   "text": "تو بری به مرتبه چی؟ شهود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 768.85,
   "end": 773.33,
   "text": "در حقیقت علم اليقين بشه عين اليقين.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 773.33,
   "end": 777.99,
   "text": "بعد مرتبه حالا فقط به دیدن هم که اکتفا نکنی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 777.99,
   "end": 783.27,
   "text": "نه فقط بری کربلا یه چیزی ببینی بگی چه قشنگه، چه زیباست، بچشی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 783.27,
   "end": 786.41,
   "text": "به اون میگن چی؟ حق اليقين.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 786.41,
   "end": 789.17,
   "text": "چشیدن دیگه قصه‌ش فرق می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 789.17,
   "end": 791.17,
   "text": "حق اليقين دیگه مرتبه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 214,
   "start": 791.17,
   "end": 793.79,
   "text": "شهوده، مرتبه بالای شهوده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 215,
   "start": 793.79,
   "end": 801.19,
   "text": "که حالا به خ-- به شماها بچه هیئتی‌ها اینا چشیدن که میاین هیئت و الا هیئت به ظاهر چی داره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 216,
   "start": 801.19,
   "end": 803.69,
   "text": "چی بهت میدن جز اینکه عمرتو بذاری؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 217,
   "start": 803.69,
   "end": 808.13,
   "text": "این چشیدنه. بعد مرتبه بالاتر هم داریم که خیلیا اینو نگفتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 218,
   "start": 808.13,
   "end": 811.23,
   "text": "امثال علامه حسن زاده گفتن برد اليقين.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 219,
   "start": 811.23,
   "end": 816.25,
   "text": "برد اليقين یعنی اون چشیده‌ت دیگه میشه ملکه وجودت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 220,
   "start": 816.25,
   "end": 819.27,
   "text": "اصلا دیگه نمی‌تونی بدون امام حسین زندگی کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 221,
   "start": 819.27,
   "end": 821.55,
   "text": "نمی‌تونی بدون نماز و زن--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 222,
   "start": 821.55,
   "end": 825.07,
   "text": "معنویت زندگی کنی. یعنی پوستتو بکَنن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 223,
   "start": 825.07,
   "end": 829.49,
   "text": "حاضر نیستی دست از نماز و روزه و کربلا و حسینت بزنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 224,
   "start": 829.49,
   "end": 831.59,
   "text": "نمی‌تونی. به این میگن برد اليقين.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 225,
   "start": 831.59,
   "end": 836.09,
   "text": "آرامیدن است. چشیده‌ها تو وجودت پیاده می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 226,
   "start": 836.09,
   "end": 839.19,
   "text": "یه وقت میری حرم یه حالی بهت دست میده، می‌چشی خب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 227,
   "start": 839.19,
   "end": 844.21,
   "text": "اما این ملکه شد یعنی دائما در حال چشیدن محبت امام حسینی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 228,
   "start": 844.21,
   "end": 849.01,
   "text": "دائما در حال چشیدن نماز و ذکر و این می‌شه دیگه برد اليقين.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 229,
   "start": 849.01,
   "end": 853.27,
   "text": "دیگه اون برو بالا. اون دیگه مال مقام قلب و س-- روح و سر و سر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 230,
   "start": 853.27,
   "end": 855.19,
   "text": "اما باید از فکر شروع کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 231,
   "start": 855.19,
   "end": 857.85,
   "text": "خلاصه از-- اذیتتون نکنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 232,
   "start": 857.85,
   "end": 862.97,
   "text": "اشکال کار اینایی که دشر قلب اغلفن اینه که قالو، گفتن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 233,
   "start": 862.97,
   "end": 865.53,
   "text": "قلوبنا غلف. تو علم فکری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 234,
   "start": 865.53,
   "end": 868.05,
   "text": "قیل و قال. گیر کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 235,
   "start": 868.05,
   "end": 870.51,
   "text": "اما ق-- فقليل ما يؤمنون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 236,
   "start": 870.51,
   "end": 873.41,
   "text": "یه عده کمشون يؤمنون، اهل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 237,
   "start": 873.41,
   "end": 875.49,
   "text": "ایمان و دلدادگی شدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 238,
   "start": 875.49,
   "end": 881.87,
   "text": "ایمان جایگاهش قلبه. یعنی از عقل هم رفتن بالاتر قلب به کشف و شهود چشیدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 239,
   "start": 881.87,
   "end": 885.79,
   "text": "اینا اهل نجات شدن. از همیناها، همینای که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 240,
   "start": 885.79,
   "end": 890.69,
   "text": "گرفتار بودن اما چون چشیدن نجات-- برای همین بخواید و السلام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 241,
   "start": 890.69,
   "end": 899.91,
   "text": "امروز تو این مکان مبدد از حضرت حق بخواهین این حقایقی که ما داریم تو فکرمون باهاش کار می‌کنیم به ما بچشاند،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 242,
   "start": 899.91,
   "end": 902.89,
   "text": "بچشاند. اون موقع دیگه نمی‌تونیم دست از سرش برداریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 243,
   "start": 902.89,
   "end": 905.23,
   "text": "انشاالله عاقبتمون ختم بخیر بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 244,
   "start": 905.23,
   "end": 908.41,
   "text": "به برکت صلوات بر محمد و آل محمد. الله-",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}