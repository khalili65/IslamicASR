   "start": 899.54,
   "end": 965.1
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.4,
   "end": 5.28,
   "text": "السلام علیک یا داعی الله و ربانی آیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 5.28,
   "end": 8.12,
   "text": "سلام علیکم و رحمت الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 8.12,
   "end": 10.76,
   "text": "این اکو شو اگه امکان داره قطع کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 10.76,
   "end": 14.86,
   "text": "خیر ببینیم ان‌شاءالله. امروز به فضل الهی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 14.86,
   "end": 21.22,
   "text": "نکته‌ای که القا شده به قلب ما به شما انتقال بدیم خیلی خیلی خیلی مهمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 21.22,
   "end": 23.86,
   "text": "خیلی به دردتون می‌خوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 23.86,
   "end": 30.18,
   "text": "که البته بحث ما پیرامون قلب اغلف بود که بر اساس آیه هشتاد و هشت سوره بقره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 30.18,
   "end": 33.3,
   "text": "\"و قالوا قلوبنا غلف\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 33.3,
   "end": 37.38,
   "text": "اینا میگن که مثل یک شمشیر در غلاف، قلب ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 37.38,
   "end": 43.34,
   "text": "پره از این حرفایی که تو میخوای به ما بزنی پیغمبر \"بل لعنهم الله بكفرهم\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 43.34,
   "end": 49.46,
   "text": "لذا خدا هم اینا رو از رحمتش به خاطر پوشاندن روی حقیقت دور کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 49.46,
   "end": 56.62,
   "text": "البته \"فَقَلِيلًا مَّا يُؤْمِنُونَ\" یه عده قلیلشون از همین‌ها اهل ایمان شدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 56.62,
   "end": 62.22,
   "text": "این رو دقت بکنید، یه مقدمه‌ای بشینم به چیز به درد بخور امروز ان‌شاءالله گیرمون بیاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 62.22,
   "end": 65.82,
   "text": "همیشه مادون محکوم مافوقه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 65.82,
   "end": 68.34,
   "text": "اساساً اینچنین هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 68.34,
   "end": 73.44,
   "text": "حتی اینکه میگه مردم الناس،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 73.44,
   "end": 77.12,
   "text": "مرد-- الف و لام هم میاره همه مردم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 77.12,
   "end": 79.96,
   "text": "علی دین ملوکه. به دین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 79.96,
   "end": 84.42,
   "text": "اون حکما و حاکمانشون هستن این یه قاعده است اساساً.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 84.42,
   "end": 88.22,
   "text": "و اساساً اینچنین هست و همیشه مافوق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 88.22,
   "end": 90.82,
   "text": "حاکم بر مادونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 90.82,
   "end": 98.98,
   "text": "این یه اصله. که اگر بهش توجه کنید بهش پی می‌برید همیشه اینجوری هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 98.98,
   "end": 102.86,
   "text": "حالا بحث ما چی بود؟ بحث ما این بود که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 102.86,
   "end": 110.2,
   "text": "این‌ها کسانی که میگن مدعی‌اند که دل ما پره از اینجور حرفا و قالو با قالو شروع می‌شه و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 110.2,
   "end": 115.68,
   "text": "میگن به سخ-- به زبان میارن حرفشون رو از کلام شروع می‌کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 115.68,
   "end": 120.8,
   "text": "کلام تو کدوم یکی از قوای وجودی ماست رتبه‌ش؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 120.8,
   "end": 125.96,
   "text": "ما پنج تا حس ظاهریه داریم که قبلاً بحثش اینجا گذشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 125.96,
   "end": 130.16,
   "text": "که این جزء-- یعنی تکلم ما حالا چه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 130.16,
   "end": 134.88,
   "text": "مقابلش رو سمع رو بگیریم که این صدا رو می‌شنوه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 134.88,
   "end": 139.4,
   "text": "چه حالا اونچه که باعث تکلم می‌شود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 139.4,
   "end": 143.54,
   "text": "زبان یا مخارج حروف، حلق این‌ها که مربوط به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 143.54,
   "end": 148.42,
   "text": "قوایی‌اند که یا ابزاری‌اند که می‌چشن قوای ذائقه هستن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 148.42,
   "end": 151.12,
   "text": "این‌ها هرچی که باشه جزء اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 151.12,
   "end": 154.08,
   "text": "انزل مراتب و قوای وجودی‌مان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 154.08,
   "end": 157.82,
   "text": "ربط به ظاهر دارن. اما هرچی که میری بالا--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 157.82,
   "end": 162.34,
   "text": "خ-- باطن‌تر در وجودت می‌بینی عوالمی هست مثل قوه خیال، قوه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 162.34,
   "end": 166.64,
   "text": "وهم همینطوری عقل و قلب و برو الی ماشاءالله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 166.64,
   "end": 169.42,
   "text": "حالا بحث اینجاست. اگر کسی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 169.42,
   "end": 176.5,
   "text": "ظاهراً دقت بفرمایید به کلمات، ظاهراً از خدا سعادت بخواهد، ظاهراً از خدا هدایت بخواهد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 176.5,
   "end": 179.56,
   "text": "ظاهراً از خدا رزق وسیع بخواهد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 179.56,
   "end": 184.24,
   "text": "ظاهراً از خدا ولایت طلب کند، ظاهراً از خدا شهادت طلب کند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 184.24,
   "end": 188.54,
   "text": "اما باطناً طلب نکند، چه اتفاقی می‌افته؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 188.54,
   "end": 193.72,
   "text": "به نظر شما خدا به ظاهر این شخص توجه می‌کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 193.72,
   "end": 196.8,
   "text": "و بهش میده یا به باطن‌ش؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 196.8,
   "end": 201.02,
   "text": "بر اساس قاعده کلی که عرض کردیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 201.02,
   "end": 203.14,
   "text": "قطعاً مادون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 203.14,
   "end": 209.66,
   "text": "محکوم مافوق‌اند و مافوق حاکمن و احکامشون رو بر مادون پیاده می‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 209.66,
   "end": 215.94,
   "text": "مثلاً اگر لایه‌های رتبه‌های بالاتر ما مثل قوه خیال که حاکم است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 215.94,
   "end": 218.76,
   "text": "بر پنج حس ظاهری ما،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 218.76,
   "end": 223.4,
   "text": "بالاتره دیگه رتبه‌ش. به یک معنا باطن‌تره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 223.4,
   "end": 225.7,
   "text": "وقتی قوه خیال ما نخواد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 225.7,
   "end": 228.38,
   "text": "اون صور و اشکالی که در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 228.38,
   "end": 234.82,
   "text": "وجود ما ایجاد کرده و ما رو مشغول به اون کرده و ما رو با اون‌ها بازی داده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 234.82,
   "end": 239.0,
   "text": "چیز دیگه‌ایه بعد به من به زبانم میگم خدایا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 239.0,
   "end": 243.2,
   "text": "مرا مثلاً به ولایت برسان، به شهادت برسان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 243.2,
   "end": 246.28,
   "text": "اون قوه خیال که باطن‌تره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 246.28,
   "end": 252.44,
   "text": "یا حاکم‌تره، اون داره چیز دیگه‌ای رو صور و اشکال دیگه‌ای رو به تو-- برای تو بروز میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 252.44,
   "end": 255.64,
   "text": "خب قطعاً خدا میاد حرف اون رو گوش میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 255.64,
   "end": 258.78,
   "text": "طلب وجودی قوه خیال تو رو میگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 258.78,
   "end": 262.04,
   "text": "حالا اگه ما تازه خیلی پایین صحبت کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 262.04,
   "end": 265.64,
   "text": "وهم حالا چطور؟ اگر عقل اینطور نباشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 265.64,
   "end": 268.5,
   "text": "کسی حتی تا قوه خیال و وهمش هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 268.5,
   "end": 275.02,
   "text": "به طوری رفته که ظاهراً خیال و وهمش هم تونستن درست تصویرگری کنن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 275.02,
   "end": 283.7,
   "text": "و مفاهیم کلیه رو وهم تونسته خوب کوچک‌سازی کنه و مثلاً یه چیزکی هم از ولایت درک کرده، طلب می‌کنه اما عقل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 283.7,
   "end": 287.84,
   "text": "وجودش دقت بفرمایید که یه رتبه بالاتره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 287.84,
   "end": 292.34,
   "text": "یعنی اون علومی که با تعقل بهش رسیده، علوم فکری و این‌ها،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 292.34,
   "end": 295.22,
   "text": "می‌بینی طلب نمی‌کنه. مثلاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 295.22,
   "end": 298.2,
   "text": "مثل بچه هیئتی و مس-- مثال می‌زنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 298.2,
   "end": 301.1,
   "text": "تلك الأمثال دیگه. نظرة بحال الناس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 301.1,
   "end": 305.92,
   "text": "مثل بچه هیئتی و بچه ولایتی که تو مسجد و هیئت‌ها بزرگ شده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 305.92,
   "end": 310.34,
   "text": "اما همش دائماً کتاب‌های بر علیه این مکتب رو خونده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 310.34,
   "end": 315.22,
   "text": "کو-- اون علم فکریش علیه اون چیزیست که ظاهراً به دنبالشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 315.22,
   "end": 317.6,
   "text": "این کار دستش میده. چی می‌شه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 317.6,
   "end": 321.74,
   "text": "قوه عقلش، اون ع-- حالا عقل مقسطه دیگه اینجا دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 321.74,
   "end": 324.1,
   "text": "ساقط شده‌ست. یعنی عقل ب--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 324.1,
   "end": 326.92,
   "text": "در حقیقت عقل مشربه به وهم و خیاله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 326.92,
   "end": 329.8,
   "text": "اون عقل میاد کار دستش میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 329.8,
   "end": 331.64,
   "text": "نمی‌خواد ولایت رو نمی‌خواد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 331.64,
   "end": 336.8,
   "text": "هر چقدر این زبانم طلب کنه عقلش پس می‌زنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 336.8,
   "end": 340.24,
   "text": "اینجا اینا میگن قالو، گفتند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 340.24,
   "end": 342.24,
   "text": "این بر می‌گرده به اون با-- ظاهرشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 342.24,
   "end": 345.06,
   "text": "ظاهرشون میگن آقا وجود ما پره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 345.06,
   "end": 347.0,
   "text": "پره از این معارف، حقایق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 347.0,
   "end": 348.88,
   "text": "ما اصلاً ماییم که مصلحیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 348.88,
   "end": 352.28,
   "text": "نحن مصلحون. ماییم که ایمان آوردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 352.28,
   "end": 355.52,
   "text": "ها؟ اما باطن‌شون چیز دیگه‌ای میگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 355.52,
   "end": 357.44,
   "text": "لذا باطن خ-- حرف اولو می‌زنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 357.44,
   "end": 362.0,
   "text": "شما برگردید به انتهای آیه \"وقليلًا ما يؤمنون\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 362.0,
   "end": 364.14,
   "text": "عرض کردیم ایمان برمی‌گرده به حوزه قلب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 364.14,
   "end": 366.68,
   "text": "اون عده قلیلی که از این‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 366.68,
   "end": 375.6,
   "text": "ایمان آوردن و نجات پیدا کردن اگرچه قلیل‌اند اما يؤمنون ایمان حوزه قلب، قلب رتبه‌ش بالاتر از همه این‌هاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 375.6,
   "end": 378.8,
   "text": "چون باطن وجودشون خواست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 378.8,
   "end": 382.66,
   "text": "خدا هم طلب، طلب‌شون رو، طلب وجودی‌شون رو بهشون داد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 382.66,
   "end": 385.4,
   "text": "لذا حالا فرصت نیست، یه روزی در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 385.4,
   "end": 389.5,
   "text": "رادیو ایران خدا لطف کرد بحث اسم اعظم وجودی رو ما باز کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 389.5,
   "end": 392.8,
   "text": "برای مردم خیلی شیرین بود، پیامک زده بودنو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 392.8,
   "end": 396.58,
   "text": "ظاهراً نشنیده بودن این بحثو که حالا یه روز من اینجا این بحث رو ارائه دادم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 396.58,
   "end": 399.4,
   "text": "برید سرچ کنید بهش می‌رسید. خیلی شیرینه، علمی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 399.4,
   "end": 402.84,
   "text": "اسم اعظم وجودی همون طلب وجودی توئه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 402.84,
   "end": 406.6,
   "text": "یعنی اون باطن وجود تو، اون باطن‌ها طلب کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 406.6,
   "end": 409.68,
   "text": "حالا هرچی رو، هرچی رو حتی باطل رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 409.68,
   "end": 412.38,
   "text": "مثل شیطان که اغواگری رو خواست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 412.38,
   "end": 414.06,
   "text": "زنده بماند تا اغوا کند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 414.06,
   "end": 415.6,
   "text": "خدا هم سریع استجابت کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 415.6,
   "end": 418.98,
   "text": "\"فإنك الرجیم\" بفرمایین. استجابته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 418.98,
   "end": 421.24,
   "text": "اصلاً کلاً این اصل، اصل قرآنیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 421.24,
   "end": 423.82,
   "text": "کلاً \"نمد هاؤلاء و هاؤلاء\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 423.82,
   "end": 430.5,
   "text": "چه اینور باشی، چه اونور باشی. هرچی طلب وجودیت باشه، یعنی لایه‌های پنهانی وجودت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 430.5,
   "end": 434.12,
   "text": "طلب کند، حالا به عبارتی بگیم قلبت، دلت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 434.12,
   "end": 439.78,
   "text": "جانت طلب کند همونی و خدا هم همونو جلو روت می‌گذاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 439.78,
   "end": 442.9,
   "text": "این خیلی اصل مهمیه‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 442.9,
   "end": 449.36,
   "text": "که حالا این دیگه در حقیقت طلب وجودی انسان به کجا برمی‌گرده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 449.36,
   "end": 452.72,
   "text": "دیگه برو سراغ اون ابتداییات بگرد اولش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 452.72,
   "end": 455.32,
   "text": "چون معمولاً همه میگن خدایا عاقبت به خیرمون کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 455.32,
   "end": 460.8,
   "text": "دعای خوبیه. اما به قول خواجه عبدالله انصاری می‌فرماید خدایا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 460.8,
   "end": 464.78,
   "text": "همه از آخرشون می‌ترسن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 464.78,
   "end": 467.88,
   "text": "عبدالله از اولش می‌ترسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 467.88,
   "end": 470.22,
   "text": "خدایا منو اول به خیر کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 470.22,
   "end": 472.6,
   "text": "عجب اینم یه حرفیه، عجب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 472.6,
   "end": 477.04,
   "text": "اول چی بودی؟ اون نطفه‌ای که بسته شد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 477.04,
   "end": 482.72,
   "text": "بر اساس چه نون و آبی بود که پدر، مادر خوردن، اون بستری که درش بزرگ شدی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 482.72,
   "end": 485.72,
   "text": "فضایی که درش نفس کشیدی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 485.72,
   "end": 488.2,
   "text": "محیطی که درش پرورش یافتی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 488.2,
   "end": 493.06,
   "text": "یه کتاب فص الصمتیه فی کلمه فاطمیه که یادش بخیر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 493.06,
   "end": 498.9,
   "text": "دو سال گذشته در ایام فاطمیه تو ده، دوازده شب ما این رو شرح دادیم توی کانال مرام گمنامی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 498.9,
   "end": 502.36,
   "text": "اگر متأسفانه از سرور ایتا پاک نشده باشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 502.36,
   "end": 505.58,
   "text": "مختصراً اونجا اجمالاً این رو بحث اونجا آوردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 505.58,
   "end": 507.84,
   "text": "تو کتاب علامه خیلی عجیب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 507.84,
   "end": 510.84,
   "text": "که اساساً همه چی برمی‌گرده به اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 510.84,
   "end": 512.92,
   "text": "شکل‌گیری نطفه. پدر کیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 512.92,
   "end": 516.06,
   "text": "مادر کیه؟ لذا میگیم بنت رسول الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 516.06,
   "end": 517.82,
   "text": "فاطمه، فاطمه است، غلطه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 517.82,
   "end": 520.26,
   "text": "فاطمه بنت رسول الله است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 520.26,
   "end": 523.38,
   "text": "اینا بحث قبلش بحث گذشته دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 523.38,
   "end": 525.12,
   "text": "که اول خیلی مهمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 525.12,
   "end": 526.62,
   "text": "تازه یه ذره بری بالاتر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 526.62,
   "end": 534.84,
   "text": "از جهت عرفانی شما رشد کنی به جایی برسی که می‌بینی عجب وقتی توحید، توحید وجودی شد نه صرفاً الوهی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 534.84,
   "end": 538.14,
   "text": "بعد می‌بینی عجب یکپارچه نظام هستی یک وجود است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 538.14,
   "end": 540.88,
   "text": "بقیه همه شؤون وجودی اون حضرت حق‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 540.88,
   "end": 543.76,
   "text": "توحید صمدی قرآن. الله الصمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 543.76,
   "end": 546.32,
   "text": "بعد می‌بینی هو الاول",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 546.32,
   "end": 549.04,
   "text": "والآخر اول و آخر یکی شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 549.04,
   "end": 550.94,
   "text": "این عین اینه که بگی یعنی اصلش اینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 550.94,
   "end": 553.6,
   "text": "هو الاول و هو الآخر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 553.6,
   "end": 556.46,
   "text": "حالا هو رو اول آورده دیگه تکرار نکرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 556.46,
   "end": 558.6,
   "text": "هو الاول آیه سه سوره حدید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 558.6,
   "end": 563.02,
   "text": "والآخر و الباطن و اول همون آخره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 563.02,
   "end": 564.98,
   "text": "عجب. حالا یه معناش اینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 564.98,
   "end": 567.12,
   "text": "یه معناش اینه که ذ--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 567.12,
   "end": 574.34,
   "text": "اول، اول هر چیزی خداست، آخر هر چیزی هم خداست، ظاهر عالم خداست، باطن‌ش هم خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 574.34,
   "end": 581.28,
   "text": "این‌ها از هم جدا نیستن. یه معناش اینه که همون چیز، همون خدایی که اول است همون هم آخر است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 581.28,
   "end": 587.42,
   "text": "شما ببینید بر اساس همین آیه \"إنا لله وإنا إليه راجعون\" عجب آیه‌ایه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 587.42,
   "end": 591.04,
   "text": "عجب آیه‌ایه که هم قوس صعود رو در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 591.04,
   "end": 598.88,
   "text": "آورده هم قوس نزول. قوس نزول إنا لله همه از خدا للَّه دیگه از الله آمدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 598.88,
   "end": 606.22,
   "text": "قوس نزول. نازل شدیم همه هم \"كل مولود يولد على الفطرة فطرة الله التي فطر الناس عليها\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 606.22,
   "end": 608.22,
   "text": "آیه و حدیثش که بارها اینجا گفتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 608.22,
   "end": 611.5,
   "text": "همه به یک فطرت. من و شما با پیغمبر، با یزید،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 611.5,
   "end": 613.48,
   "text": "همه با یک فطرت اومدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 613.48,
   "end": 615.68,
   "text": "عدالت برقرار شده. إنا لله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 615.68,
   "end": 619.4,
   "text": "خب به کجا میریم؟ شما بفرمایید در قوس صعود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 619.4,
   "end": 621.9,
   "text": "به کجا باید بریم؟ بقیه آیه چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 621.9,
   "end": 626.88,
   "text": "و إنا إليه این ضمیر ه برمی‌گرده به اون الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 626.88,
   "end": 630.78,
   "text": "إنا لله وإنا إليه راجعون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 630.78,
   "end": 634.32,
   "text": "دو مرتبه برمی‌گردیم به سمت همون الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 634.32,
   "end": 636.62,
   "text": "مگر الله اول نبود؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 636.62,
   "end": 639.06,
   "text": "ابتدای کار ما مگر با الله شروع نشد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 639.06,
   "end": 643.12,
   "text": "إنا لله. حالا معاد ما، بازگشت ما،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 643.12,
   "end": 645.52,
   "text": "آخر کار ما دوباره کیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 645.52,
   "end": 648.16,
   "text": "وإنا إليه راجعون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 648.16,
   "end": 656.76,
   "text": "عجب. پس بازگشت ما هم شد همون اول که آخر ما هم شد همون اول که اساساً اول و آخر یک حقیقته‌ند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 656.76,
   "end": 660.22,
   "text": "هرچی اولته آخرتم همونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 660.22,
   "end": 662.0,
   "text": "عجب. عجب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 662.0,
   "end": 665.18,
   "text": "خیلی حرف عجیبیه. این حرف، حرف فلسفی و عرفانیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 665.18,
   "end": 667.88,
   "text": "خیلی هم مهمه ها. خیلی هم به درد بخوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 667.88,
   "end": 671.2,
   "text": "اینجاست که آدم باید خیلی مراقب باشه عزیز دلم، چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 671.2,
   "end": 673.42,
   "text": "مراحل رشد چی میشه اگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 673.42,
   "end": 679.08,
   "text": "اون دیگه استثنائه. استثنائات بله، استثنائات محیط.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 679.08,
   "end": 681.96,
   "text": "اونا استثنائات که ولی ببین شخصی اومد پیش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 681.96,
   "end": 687.98,
   "text": "آقا امیرالمؤمنین گفت آقا جون چی کار کنم بچه‌ام مثلاً به قول ما با ادب بشه، به راه بیاد فلان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 687.98,
   "end": 690.36,
   "text": "امام علی فرمود دست نگه دار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 690.36,
   "end": 693.66,
   "text": "بچه‌های شما همونی می‌شن که خودتون هستید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 693.66,
   "end": 696.06,
   "text": "مگر استثناء محیط",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 696.06,
   "end": 698.72,
   "text": "مثل فرزند نوح که با badan بگ--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 698.72,
   "end": 702.58,
   "text": "مثلاً نشست و فلان. اما اصل، اون ریشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 702.58,
   "end": 706.58,
   "text": "اون أم، أم به عربی یعنی ریشه، اصل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 706.58,
   "end": 712.16,
   "text": "برمی‌گرده به پدر، مادر. خیلی-- اون ماده اولیه رو پدر می‌بخشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 712.16,
   "end": 715.58,
   "text": "در زمین وجود مادر این دانه رو می‌کاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 715.58,
   "end": 718.04,
   "text": "\"نساءكم حرث لكم\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 718.04,
   "end": 720.2,
   "text": "آیه ز-- قرآن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 720.2,
   "end": 722.8,
   "text": "زنان شما زمین کشزار شما‌ند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 722.8,
   "end": 726.22,
   "text": "دانه رو تویی که مردی می‌کاری در وجود زن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 726.22,
   "end": 731.44,
   "text": "بعد اون دانه نطفه است که پ-- حالا م-- اینجا زن دیگه در مقام پرورش است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 731.44,
   "end": 736.76,
   "text": "اینجا دیگه باز می‌بینید تو بحث پرورش و ربوبیت مادر حرف اول می‌زنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 736.76,
   "end": 743.1,
   "text": "حالا عاشق چشم و ابروی دختره می‌شه می‌ره می‌گیره حالیش نیست که مادر نسل بعدش رو داره می‌سازه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 743.1,
   "end": 746.36,
   "text": "این دختری که گرفت. خیلی این مهمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 746.36,
   "end": 750.72,
   "text": "اینکه دهان-- اصلاً محاله بحثو جمع کنم خسته نشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 750.72,
   "end": 757.96,
   "text": "محال ممکنه کسی دهان باز کنه، دهان به این معنای که الان گفتیم درون بشکافه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 757.96,
   "end": 762.42,
   "text": "دهان وجودش رو باز کنه از خدا از باطن وجود،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 762.42,
   "end": 768.16,
   "text": "از اعماق وجود، از درون چیزی رو طلب کنه خدا بهش نه بگه پس بزنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 768.16,
   "end": 770.04,
   "text": "شیطان طلب کرده گرفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 770.04,
   "end": 773.32,
   "text": "\"فإنک الرجیم\". ادعونی یعنی این.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 773.32,
   "end": 776.28,
   "text": "این ادعونی مرا بخوان نه یعنی لسانتو باز کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 776.28,
   "end": 781.42,
   "text": "اینا تو قلب اغلف میگن و قالو گفتن اینو ولش کن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 781.42,
   "end": 784.94,
   "text": "و قالو قلوبنا غلف باز برگردوندن به قلبشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 784.94,
   "end": 787.1,
   "text": "یعنی اصلاً قلب ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 787.1,
   "end": 789.56,
   "text": "اغلفه. قلب ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 789.56,
   "end": 791.96,
   "text": "پره. اصلاً پس می‌زنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 791.96,
   "end": 795.94,
   "text": "محاله کسی دهان وجودش رو باز کنه خدا بگه نه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 795.94,
   "end": 798.48,
   "text": "شما یه دانه رو بکار خرما،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 798.48,
   "end": 801.08,
   "text": "یه دانه‌ی خرما، یه دانه‌ی گندم، برنج بکار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 801.08,
   "end": 804.22,
   "text": "اگر این دانه فاسد نباشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 804.22,
   "end": 809.32,
   "text": "خب قطعاً تو زمین درستی اگر کاشتیش این رشد می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 809.32,
   "end": 816.82,
   "text": "موانع رو هم البته باید برطرف کنی اما اول از همه برمی‌گرده به اون خود دانه که دانه فاسد نباشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 816.82,
   "end": 819.76,
   "text": "دانه در وجود خودش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 214,
   "start": 819.76,
   "end": 825.34,
   "text": "در حقیقت یک نخل خرما در تکوین وجودش نهفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 215,
   "start": 825.34,
   "end": 829.62,
   "text": "شرایط مهیا باشه می‌رسه. در حقیقت اون آخری الان تو خودشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 216,
   "start": 829.62,
   "end": 833.04,
   "text": "آخر دانه‌ی خرما خودشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 217,
   "start": 833.04,
   "end": 835.16,
   "text": "اگر سالم باشه می‌شه نخل، نباشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 218,
   "start": 835.16,
   "end": 841.26,
   "text": "اینجاست که وقتی شخص اومد محضر امام صادق صلوات الله علیه گفت آقا دوستت دارم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 219,
   "start": 841.26,
   "end": 844.46,
   "text": "فرمود برو پدر و مادرت رو دعا کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 220,
   "start": 844.46,
   "end": 846.8,
   "text": "گفت آقا دوستت-- من شما رو دوست دارم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 221,
   "start": 846.8,
   "end": 849.46,
   "text": "فرمود برو مادرت رو دعا کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 222,
   "start": 849.46,
   "end": 852.84,
   "text": "اختصاص به مادر. باز گفت آقا من شما رو دوست دارم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 223,
   "start": 852.84,
   "end": 858.96,
   "text": "فرمود آقا اگر پدر و مادرت منو دوست نداشتن تو هم نداشتی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 224,
   "start": 858.96,
   "end": 866.12,
   "text": "الله اکبر. این بحث خیلی مهمنها که ما بدونیم برای حداقل بچه‌های بعدیمون می‌خوایم پدر، مادر،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 225,
   "start": 866.12,
   "end": 868.78,
   "text": "عروس، داماد انتخاب کنیم به چه گونه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 226,
   "start": 868.78,
   "end": 873.02,
   "text": "به چه شکل؟ آنچه که طلب کنی همونی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 227,
   "start": 873.02,
   "end": 875.92,
   "text": "یه روایت یه بار اینجا من گفتم اینم بگم و تمام کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 228,
   "start": 875.92,
   "end": 877.66,
   "text": "خیلی این روایت حرف توشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 229,
   "start": 877.66,
   "end": 883.68,
   "text": "خیلی حرف توشه که شخص اومد به امام صادق صلوات الله علیه گلایه کرد از وضع مالیش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 230,
   "start": 883.68,
   "end": 888.28,
   "text": "خیلی حرف عجیبه. حضرت فرمود اون صندوقچه‌ای که تو خونه داری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 231,
   "start": 888.28,
   "end": 893.52,
   "text": "و توش حالا صندوق بعضیا کیسه می‌ذاشتن توش مثلاً انبار می‌ذاشتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 232,
   "start": 893.52,
   "end": 897.24,
   "text": "مثلاً به قول ما برنج یا گندم توش می‌ریختن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 233,
   "start": 897.24,
   "end": 898.92,
   "text": "اون خالیه یا پره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 234,
   "start": 898.92,
   "end": 901.78,
   "text": "گفت آقا خالیه. فرمود خب خالی باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 235,
   "start": 901.78,
   "end": 906.74,
   "text": "چرا دهانشو بستی؟ دهان صندوقچه‌ی محل جمع‌آوری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 236,
   "start": 906.74,
   "end": 909.04,
   "text": "گندم و جوتو چرا بستی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 237,
   "start": 909.04,
   "end": 913.08,
   "text": "به سوی آسمان؟ \"و فی السماء رزقكم وما توعدون\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 238,
   "start": 913.08,
   "end": 915.18,
   "text": "اونو باز بذار اگرچه خالیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 239,
   "start": 915.18,
   "end": 917.86,
   "text": "بعد ببین خدا اگه پرش نکرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 240,
   "start": 917.86,
   "end": 920.26,
   "text": "مثل سفره‌ی ما. چرا می‌گه رو سفره بشین؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 241,
   "start": 920.26,
   "end": 923.54,
   "text": "سفره دهان توئه. دهان زندگی توئه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 242,
   "start": 923.54,
   "end": 928.08,
   "text": "هرچی سفره بازتر، هرچی دهان بازتر، رزق بیشتر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 243,
   "start": 928.08,
   "end": 931.0,
   "text": "یکی اونور می‌شینه، یکی رو میز می‌شینه، یکی اینور.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 244,
   "start": 931.0,
   "end": 935.56,
   "text": "سفره‌ها جدا جدا کوچولو، دهان‌های کوچولو، کوچولو، خدا هم همون کوچولو میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 245,
   "start": 935.56,
   "end": 938.28,
   "text": "اما یکی سفره‌ش بزرگ شه، بزرگ شه، بزرگ شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 246,
   "start": 938.28,
   "end": 942.62,
   "text": "حاتم طایی چقدر سفره مینداخت خدا هم هی بزرگ، بزرگ بهش میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 247,
   "start": 942.62,
   "end": 944.56,
   "text": "یکی مثل پیغمبر ت--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 248,
   "start": 944.56,
   "end": 951.3,
   "text": "سفره‌ش می‌شه به قدر وسعت نظام هستی خدا هم همه‌ی اسرار نظام هستی رو می‌ریزه تو وجودش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 249,
   "start": 951.3,
   "end": 953.18,
   "text": "این دهان وجود انقدر مهمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 250,
   "start": 953.18,
   "end": 955.56,
   "text": "اینا دهانشون کوچولو بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 251,
   "start": 955.56,
   "end": 957.9,
   "text": "قالو قلوبنا غلف.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 252,
   "start": 957.9,
   "end": 961.52,
   "text": "لذا گرفتار شدن. انشاالله عاقبتمون ختم به خیر بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 253,
   "start": 961.52,
   "end": 965.1,
   "text": "به برکت صلوات بر محمد و آل محمد. الله-",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}