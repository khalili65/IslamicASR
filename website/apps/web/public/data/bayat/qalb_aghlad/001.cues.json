 },
 "chapters": [
  {
   "index": 0,
   "title": "## عظمت ماه رجب و دعای یا من ارجوه",
   "start": 13.18,
   "end": 192.78
  },
  {
   "index": 1,
   "title": "## بهترین عمل رجب؛ استغفار",
   "start": 192.78,
   "end": 213.52
  },
  {
   "index": 2,
   "title": "## مقدمه‌ی فصل قلب اغلف؛ فرار از حقایق سنگین",
   "start": 213.52,
   "end": 717.03
  },
  {
   "index": 3,
   "title": "## شعور نشئه‌ی طبیعت؛ لشکریان اسماء",
   "start": 717.03,
   "end": 884.4
  },
  {
   "index": 4,
   "title": "## وجود و اسماء در ذره‌ی طبیعت",
   "start": 884.4,
   "end": 964.18
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 1.78,
   "end": 5.46,
   "text": "بسم الله الرحمن الرحیم و به این استعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 5.46,
   "end": 12.36,
   "text": "السلام علیک یا داعی الله و ربانی ایاته سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 12.36,
   "end": 18.64,
   "text": "تبریک میگم این ماه بسیار با عظمت رو که عصب است دیگه فهم می‌دانید،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 18.64,
   "end": 25.26,
   "text": "آگاه هستید که شدت ریزش رحمت حق در این ماه به حدی‌ست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 25.26,
   "end": 28.78,
   "text": "که قابل قیاس با هیچ ماه دیگه‌ای نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 28.78,
   "end": 33.18,
   "text": "و جالبه که خدا به عنوان یک فیلتری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 33.18,
   "end": 38.26,
   "text": "صافی قرار داده تا اون‌هایی که گرفتار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 38.26,
   "end": 40.62,
   "text": "دام شیطان و نفس شدن رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 40.62,
   "end": 43.32,
   "text": "به نوعی در دام عشق خودش گرفتار کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 43.32,
   "end": 49.8,
   "text": "شما همین دعایی که هر روز خونده می‌شه رو دقت کنید همین دو تا عبارت اولش بسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 49.8,
   "end": 53.54,
   "text": "برای عظمت این ماه که پ-- به پیغمبر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 53.54,
   "end": 57.36,
   "text": "شیخ عباس آورده دیگه در مفاتیح که کسی عرض کرد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 57.36,
   "end": 59.7,
   "text": "دعایی رو به من تعلیم بده که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 59.7,
   "end": 64.66,
   "text": "نفع ببرم. خیلی از دعاها رو ما می‌خونیم نفعی از قبلش نمی‌بریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 64.66,
   "end": 68.2,
   "text": "نه اصلاً من هر طور شده این دعا رو بخونم نفعی ببرم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 68.2,
   "end": 73.72,
   "text": "خیلی اصلاً این درخواست خیلی عجیبه خدا حالا رو همین درخواست بخواد آدم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 73.72,
   "end": 80.12,
   "text": "کار کنه. که حالا همین دو تا عبارت اول \"یا من ارجو له کل خیر\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 80.12,
   "end": 85.22,
   "text": "هر خیری. آقا من بدترین آدمم، اشرار رو زمینم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 85.22,
   "end": 88.54,
   "text": "چون کسی شاید بگه آقا مال همه نیستش که،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 88.54,
   "end": 91.94,
   "text": "مال اهل خیره. پس عبارت دوم چی کار می‌کنه اینجا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 91.94,
   "end": 96.0,
   "text": "\" و آمن سخطه عند کل شر\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 96.0,
   "end": 103.58,
   "text": "آقا یکی از گناهان کبیره اینه که انسان خودش رو ایمن از مکر خدا بدونه، از عذاب و سخط خدا بدونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 103.58,
   "end": 105.88,
   "text": "اصلاً اینجا یه کار عجیبی خدا کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 105.88,
   "end": 111.18,
   "text": "دست و بال همه گناهکارای عالمو بسته اینطوری بگم حتی شیطان رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 111.18,
   "end": 117.2,
   "text": "یعنی اگر شیطان به طمع همین جمله بیاد در خانه خدا حقه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 117.2,
   "end": 120.88,
   "text": "که \" و آمن سخطه عند کل شر\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 120.88,
   "end": 124.38,
   "text": "همه شرها رو به کل شر رو بریزی رو هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 124.38,
   "end": 130.26,
   "text": "باز من ایمنم از سخط تو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 130.26,
   "end": 132.9,
   "text": "چرا؟ چون کم ماهی نیومده که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 132.9,
   "end": 138.38,
   "text": "ببین همین، همین دو تا عبارتو روش کار کنی عجب عظمتی داره این ماه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 138.38,
   "end": 143.12,
   "text": "یعنی اینطوری بگم دیگه تمام شیاطین عالم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 143.12,
   "end": 146.72,
   "text": "گنده‌تر از شیاطین اِم تو این ماه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 146.72,
   "end": 148.82,
   "text": "در خانه خدا برن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 148.82,
   "end": 153.7,
   "text": "اولاً ایمنن، ثانیا همه خیرات درش به روشون بازه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 153.7,
   "end": 161.6,
   "text": "الله اکبر. آخه چی بده دیگه آدم چجوری خدا چجوری بار بده، بار عام بده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 161.6,
   "end": 167.12,
   "text": "یه نکته هم عرض کنم بعد ورود به بحث دنباله‌دار قلب در قرآنمون کنم کوتاه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 167.12,
   "end": 169.62,
   "text": "امروز دیگه فرصت نمی‌کنیم خیلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 169.62,
   "end": 175.2,
   "text": "بازش کنیم بحث رو. ولی حداقل مقدمه فصل جدیدمون رو بگیم صبح بخیر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 175.2,
   "end": 180.96,
   "text": "اونم اینکه بهترین کاری که حالا شاید یه کسی بگه آقا من خیلی گرفتارم، مشکل دارم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 180.96,
   "end": 187.28,
   "text": "نمی‌تونم این اعمال متعدد این ماه رو هرچی ماه وزین‌تر، سنگین‌تر اعمالشم بیشتر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 187.28,
   "end": 189.72,
   "text": "خب نمی‌رسم. چه کنم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 189.72,
   "end": 192.78,
   "text": "عزیز دلم، آب پاکی رو دست هممون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 192.78,
   "end": 196.16,
   "text": "بهترین کار در این ماه استغفار است و السلام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 196.16,
   "end": 199.6,
   "text": "همین طوری که داری میری خونه میای پشت میز کارتی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 199.6,
   "end": 204.2,
   "text": "در-- داری می‌خوابی از خوابی داشته دائماً لبت تر باشه به ذکر استغفار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 204.2,
   "end": 208.26,
   "text": "هر استغفاری که بلدی، هرچی بلدی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 208.26,
   "end": 210.38,
   "text": "حالا اونایی که معثور است که چه بهتر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 210.38,
   "end": 213.52,
   "text": "استغفرالله و اتوب الیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 213.52,
   "end": 218.24,
   "text": "جالبه همه جا میگه بگو استغفرالله و اسأله التوبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 218.24,
   "end": 222.42,
   "text": "اینم باز یک نکته‌ست. تو ماه مبارک رمضان ببینید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 222.42,
   "end": 227.9,
   "text": "دستور مثلاً شب‌های قدر، شب‌های خاص ماه میگه بگو و اسأله التوبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 227.9,
   "end": 229.98,
   "text": "ادعا نکن من اومدم توبه کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 229.98,
   "end": 232.56,
   "text": "بگو خدایا منو ببخش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 232.56,
   "end": 234.54,
   "text": "بعد از تو درخواست توبه دارم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 234.54,
   "end": 236.72,
   "text": "تو این ماه میگه بگو و اتوب الیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 236.72,
   "end": 239.22,
   "text": "بگو اصلاً اومدم، من اومدم که توبه کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 239.22,
   "end": 241.48,
   "text": "ادعا کن برای توبه کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 241.48,
   "end": 246.32,
   "text": "عجیبه. لذا اصلاً مدعی باش برای توبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 246.32,
   "end": 248.9,
   "text": "تا می‌تونی لبت تر باشه تو این ماه برای توبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 248.9,
   "end": 253.5,
   "text": "بعد البته ق-- سوره قل هو الله احد خیلی کمک‌کننده‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 253.5,
   "end": 256.12,
   "text": "ذکر لا اله الا الله خیلی کمک‌کننده‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 256.12,
   "end": 260.44,
   "text": "اون ادعیه که بخوایم درباره‌ش حرف بزنیم زبانمون لاله که حداقل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 260.44,
   "end": 266.08,
   "text": "سه تا از ادعیه بسیار مهم و وزین و سنگین که همش بوی توحید میده تو این ماه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 266.08,
   "end": 270.22,
   "text": "توسط حضرت ولی عصر از طریق نواب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 270.22,
   "end": 273.28,
   "text": "خاصه‌شون رسیده به دست ما تو مفاتیح اومده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 273.28,
   "end": 277.86,
   "text": "عجیبه. همه اینا کمک میده به همون توبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 277.86,
   "end": 282.86,
   "text": "حالا تا همین مقدار پیرامون این ماه بسنده کنم که اگرچه تا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 282.86,
   "end": 286.88,
   "text": "قیام قیامت هم اهلش حرف بزنن و من بی‌سواد واقعاً کمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 286.88,
   "end": 289.16,
   "text": "تبرکاً نکته‌ای عرض کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 289.16,
   "end": 293.28,
   "text": "سرفصل بحث جدیدمون رو به فضل الهی بگیم تا ببینیم خدا چی می‌خواد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 293.28,
   "end": 297.04,
   "text": "ما قلب مغفول رو دیگه جمع کردیم سفره‌شو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 297.04,
   "end": 300.56,
   "text": "اگرچه حرف‌ها موند اما خیلی نمی‌خوایم طولانی بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 300.56,
   "end": 303.62,
   "text": "قلب مغفول با قاف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 303.62,
   "end": 306.44,
   "text": "قلبی بود که قفل شده بود. حالا میریم سراغ ب--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 306.44,
   "end": 310.26,
   "text": "اون شونزدهمین قلب در قرآن، قرآن طبق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 310.26,
   "end": 315.38,
   "text": "بررسی‌مون بود. تا حدود شصت تا قلب گفتیم در قرآن رو بررسی کردیم دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 315.38,
   "end": 320.2,
   "text": "قلب جدیدی که انشالله یه چند سباحی سر سفره‌ش می‌نشینیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 320.2,
   "end": 325.2,
   "text": "قلب غلف است، نه قفل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 325.2,
   "end": 327.92,
   "text": "غو-- غلف. لامش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 327.92,
   "end": 329.7,
   "text": "زودتر از فاء اومده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 329.7,
   "end": 333.34,
   "text": "یعنی چی؟ قلبی که در غلاف است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 333.34,
   "end": 337.2,
   "text": "حالا فرقش با قلبی که قفل شده چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 337.2,
   "end": 339.28,
   "text": "حالا باید بحث کنیم. قلب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 339.28,
   "end": 342.68,
   "text": "غلف. حالا اینا رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 342.68,
   "end": 345.34,
   "text": "ما از کجا درآوردیم؟ از قرآنه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 345.34,
   "end": 351.66,
   "text": "برید آیه س-- هشتاد و هشت سوره بقره رو دقت کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 351.66,
   "end": 359.04,
   "text": "می‌فرماید و قالوا قلوبنا غلف با غای-- غین نه قف، غین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 359.04,
   "end": 361.42,
   "text": "اینا میگن که قلب ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 361.42,
   "end": 363.96,
   "text": "قلوبنا غلف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 363.96,
   "end": 369.65,
   "text": "غلاف گرفته. یه غلافی از غفلت گرفته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 369.65,
   "end": 374.89,
   "text": "بعد خدا می‌فرماید \"بل عنهم الله بكفرهم فقلیلا ما یؤمنون\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 374.89,
   "end": 382.17,
   "text": "حالا ب-به انشاالله ترتیب روزا که میریم به توفیق حضرت حق در رابطه با کلمه کلمه‌ش حرف می‌زنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 382.17,
   "end": 388.81,
   "text": "فعلا اینو تو این جلسه بدونیم که این‌ها میخوان به نوعی فرار کنن از حقایق نظام هستی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 388.81,
   "end": 393.61,
   "text": "خودشونو راحت می‌کنن. بعضی موقع‌هام ما اینطوری می‌شیم ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 393.61,
   "end": 397.59,
   "text": "یه حرف حقی که یه مقدار برامون سنگین تموم می‌شه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 397.59,
   "end": 401.23,
   "text": "ظاهر قضیه می‌بینیم مثلاً به ضررمونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 401.23,
   "end": 403.75,
   "text": "اگر بریم زیر بار این حرف حق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 403.75,
   "end": 407.65,
   "text": "توون باید پس بدیم. اینطوری دیگه راحت بگم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 407.65,
   "end": 413.57,
   "text": "یا توون دنیوی یا برزخی یا اخروی میگیم ولش کن بابا اصلاً ما نمی‌فهمیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 413.57,
   "end": 416.59,
   "text": "یه معنای این قلب غلف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 416.59,
   "end": 420.85,
   "text": "یعنی نمی‌فهمم. میخوام ادعا کنم که قلبم در یک غلافه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 420.85,
   "end": 423.15,
   "text": "آقا ولمون کن، ما رو ول کن، ما نمی‌فهمیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 423.15,
   "end": 429.87,
   "text": "خودت می‌دونی‌ها خودتو برو. بسیاری از متأسفانه گرفتاری‌های ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 429.87,
   "end": 438.63,
   "text": "همینجاست که تن نمیدیم به حرف‌های بسیار پرقیمت، ذی‌قیمت و البته سنگین معارف الهی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 438.63,
   "end": 442.93,
   "text": "بسنده کردیم به همین چهار تا احکامی که از رساله خوندیم و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 442.93,
   "end": 447.91,
   "text": "یه چهار تا کتاب داستان معذرت میخوام از حقایق معرفتی عالم و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 447.91,
   "end": 454.23,
   "text": "منبرامونم که متأسفانه امثال من که میرم منبر غالباً دو تا داستان و حکایت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 454.23,
   "end": 456.93,
   "text": "همین. یه نمازی و روزه‌ای.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 456.93,
   "end": 462.75,
   "text": "اما اینکه پشت پرده این معارف چی خوابیده میگیم ولمون کن آقا من نمی‌فهمم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 462.75,
   "end": 465.39,
   "text": "حواسمون باشه گرفتار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 465.39,
   "end": 469.39,
   "text": "یعنی در حقیقت در ذیل این آیه گرفتار نشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 469.39,
   "end": 472.75,
   "text": "اینام همینطوری به پیغمبر-- اینا به کی میگن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 472.75,
   "end": 475.79,
   "text": "قالو گفتن قلوبنا غلف.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 475.79,
   "end": 478.35,
   "text": "به کی گفتن؟ به پیغمبران دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 478.35,
   "end": 480.47,
   "text": "پیغمبران می‌اومدن اینا رو دعوت کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 480.47,
   "end": 482.83,
   "text": "پیغمبر عظیمالشأن اسلام قرآن رو آورده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 482.83,
   "end": 485.89,
   "text": "می‌بینن حرف خیلی وزینه، خیلی سنگینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 485.89,
   "end": 488.75,
   "text": "خودشونو راحت می‌کنن. میگن آقا این حرفا رو برای ما نزن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 488.75,
   "end": 490.37,
   "text": "ما نمی‌فهمیم. گوش ما پره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 490.37,
   "end": 493.05,
   "text": "چقدر ما از این امروز از این حرفا می‌شنویم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 493.05,
   "end": 499.05,
   "text": "چهار که الان میخوای با جوون حرف بزنی انقدر گوشش پر شده از دنیا و لهو و لعب و موسیقی و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 499.05,
   "end": 504.59,
   "text": "چیزای بیخودی، اصلاً حاضر نیست تن به حرف حق بده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 504.59,
   "end": 508.81,
   "text": "که اگر بده می‌بینه مثل اون که میگه آقا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 508.81,
   "end": 512.15,
   "text": "یه بار نه میگم نه ماه راحتم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 512.15,
   "end": 516.35,
   "text": "میگه ولش کن بابا ب-- من، من این کاره نیستم ولش کن راحت بشم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 516.35,
   "end": 519.95,
   "text": "دیگه از گرفتاری‌های بشر در صورتی که نمی‌دونه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 519.95,
   "end": 523.31,
   "text": "\"إن دار الآخرة",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 523.31,
   "end": 525.63,
   "text": "لهی الحيوان\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 525.63,
   "end": 527.99,
   "text": "اینکه ما میگیم حیوان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 527.99,
   "end": 531.35,
   "text": "اصلش حیوانه. قرآن داره میگه‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 531.35,
   "end": 538.13,
   "text": "میگه بدونید قطعاً دار آخرت قبلاً هم اینجا عرض کردیم اون آخرت نه-- یعنی بگیری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 538.13,
   "end": 541.29,
   "text": "مثلاً آخر یعنی یه اولی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 541.29,
   "end": 545.75,
   "text": "یه آخری. نه، آخر یعنی یه چیز دیگه‌ای.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 545.75,
   "end": 549.27,
   "text": "به، به تو میگن آخر مثلاً مرام ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 549.27,
   "end": 551.91,
   "text": "میگی اصلاً مرامش یه چیز دیگه‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 551.91,
   "end": 555.75,
   "text": "\"إن دار الآخرة\" اون آخرت، اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 555.75,
   "end": 561.49,
   "text": "در حقیقت عالمی که یه چیز دیگریست \"لهی الحيوان\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 561.49,
   "end": 564.61,
   "text": "یکپارچه حیات محض.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 564.61,
   "end": 567.23,
   "text": "این مال کیه؟ اون عالم دیگره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 567.23,
   "end": 574.51,
   "text": "حالا می‌خوای بگی قیامت براش زمان درست کن که متأسفانه کتب متعارف در باب قیامت این اشتباه فاحش رو کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 574.51,
   "end": 578.87,
   "text": "قیامت هم مسئولن. باید جوابگوی ما و جوونای ما باشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 578.87,
   "end": 582.39,
   "text": "یک جایی رو برای قیامت فرض کردن در صورتی که اینطوری نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 582.39,
   "end": 587.27,
   "text": "اگر شما حکمت رو، همین حکمت که ما ازش فرار می‌کنیم میگیم آقا ولم کن نمی‌فهمم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 587.27,
   "end": 589.61,
   "text": "قلب من دچار یه غلافیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 589.61,
   "end": 591.87,
   "text": "غفلت گرفتم. نمی‌خوام، نمی‌فهمم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 591.87,
   "end": 594.65,
   "text": "زور نزن برا من. در حالی که من عقل دارم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 594.65,
   "end": 597.41,
   "text": "عقل. قلب دارم، قلب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 597.41,
   "end": 600.05,
   "text": "محل انقلاب، عقل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 600.05,
   "end": 601.85,
   "text": "بسته شدن به حضرت حق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 601.85,
   "end": 606.83,
   "text": "جایی که شتر رو می‌بندن میگن عقال.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 606.83,
   "end": 609.39,
   "text": "یعنی می‌بندی خودتو به حق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 609.39,
   "end": 616.47,
   "text": "جایی که سنگین می‌شه معرفت، حقایق، اسرار سنگین می‌شه خدا عقل داده دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 616.47,
   "end": 622.29,
   "text": "وقتی تو حاضر نیستی فکر کنی، تعقل کنی زیر بار سنگین این حقیقت بری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 622.29,
   "end": 626.55,
   "text": "یعنی می‌خوای معذرت میخوام ببخشید میخوای بگی آقا من حیوونم ولم کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 626.55,
   "end": 628.35,
   "text": "من نمی‌خوام انسان باشم. یعنی همین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 628.35,
   "end": 633.27,
   "text": "یعنی، یعنی همون عبارتی که میگه قلوب-- قال و قلوبنا غلف.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 633.27,
   "end": 634.99,
   "text": "من تو یه غلاف حیوانیت هستم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 634.99,
   "end": 642.91,
   "text": "ولم کن. تازه اگر بحث حیوانیت باز بشه می‌بینیم اصلاً اون هم یکپارچه حیات محضه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 642.91,
   "end": 647.69,
   "text": "اصلاً نش، نش-- همین نشئه طبیعت یکپارچه حیات محضه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 647.69,
   "end": 650.37,
   "text": "چرا خ-- قرآن اومده گفته که اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 650.37,
   "end": 656.07,
   "text": "دار یک چیز دیگری حالا تو بخوای بگیری آخرت قیامتیه اونطوری،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 656.07,
   "end": 658.55,
   "text": "یکپارچه حیات محضه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 658.55,
   "end": 665.75,
   "text": "به خاطر اینکه اگه یه دفعه بیاد بگه آقا این سنگریزه هم که پای پاتو رو روش می‌ذاری اینم حیوانه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 665.75,
   "end": 668.73,
   "text": "حیوانه به فرض من و تو هم حیوانه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 668.73,
   "end": 671.33,
   "text": "آسمان حیوانه، قطره آب حیوانه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 671.33,
   "end": 673.97,
   "text": "همه چی یکپارچه حیات محضه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 673.97,
   "end": 676.45,
   "text": "تو اصلاً گرفتار میشی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 676.45,
   "end": 681.17,
   "text": "یعنی می‌بینی اصلاً سبک زندگیت باید عوض شه اگه همه چی حیات محضه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 681.17,
   "end": 684.29,
   "text": "باید مراقب خلوتت باشی. اصلاً چیزی مرده ما نداریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 684.29,
   "end": 689.35,
   "text": "مرده چیه؟ حتی بدن ما هم که نفس ناطقه انصراف میده ازش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 689.35,
   "end": 694.27,
   "text": "منصرف می‌شه، این بدن میره تو نشئه طبیعت با حرکت جوهری در حال حرکته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 694.27,
   "end": 696.73,
   "text": "حرکت یعنی حیات، یعنی زندگی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 696.73,
   "end": 699.15,
   "text": "میره تو چرخه خودش. چون از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 699.15,
   "end": 704.33,
   "text": "نان و آب و نطفه به وجود اومده این بدن باید بره تو همین چرخه، همین جا بمونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 704.33,
   "end": 707.35,
   "text": "بره حالا یه حیوونی بخورش بره تو بدن حیوان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 707.35,
   "end": 711.99,
   "text": "ریشه گیاهی جذبش کنه بدن من و تو رو بشه یه گیاه، بشه نبات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 711.99,
   "end": 714.93,
   "text": "عاقبت خاک گل کوزه گران خواهیم شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 714.93,
   "end": 719.67,
   "text": "این چرخه بر می‌گرده. ولی اون نفس ناطقه با بدن اخرویش راهشو داره میره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 719.67,
   "end": 722.65,
   "text": "اینجام حیاته، اونجام حیاته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 722.65,
   "end": 727.39,
   "text": "یه نکته‌ای بگم این سر فصل فردامون باشه که خیلی سنگینه این بحث.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 727.39,
   "end": 732.13,
   "text": "خیلی به توحید صمدی قرآن بر می‌گرده و ما باید اینطوری نگاه کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 732.13,
   "end": 736.6,
   "text": "اگر غیر از این باشه انقلاب ما، انقلاب ناب نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 736.6,
   "end": 742.98,
   "text": "انقلاب وقتی نابه که ناب‌ترین معارف بیان بشه نه اینکه تا میگی فلسفه حکمت ملاصدرا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 742.98,
   "end": 745.8,
   "text": "محی الدین بزنن تو دهنت بگن نه همین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 745.8,
   "end": 751.22,
   "text": "چهار تا حرفی که تو کتاب اومده و سلام بقیه رو ولش کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 751.22,
   "end": 754.46,
   "text": "من از شما سؤال می‌کنم مگر یک وجود بیش نداریم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 754.46,
   "end": 761.34,
   "text": "قبلاً بحث کردیم وجود صمدی حضرت حق که اون همه جا هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 761.34,
   "end": 765.62,
   "text": "، به هر طرف رو کنی رو به خدا کرده‌ای.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 765.62,
   "end": 768.38,
   "text": "، از رگ گردن نزدیک‌ترم به همه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 768.38,
   "end": 774.02,
   "text": "ها؟ ، هر کجا باشی خدا با شماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 774.02,
   "end": 776.58,
   "text": "این فقط به ما نیست، به سنگ هم هست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 776.58,
   "end": 780.08,
   "text": "به حیوان هم هست، به آسمان. هر-- اصلاً خدا همه جا هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 780.08,
   "end": 782.9,
   "text": "هیچ چیزی جدای از خدا نیست. همه جلوه حق‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 782.9,
   "end": 787.92,
   "text": "ظهور و بروز حضرت حق‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 787.92,
   "end": 791.82,
   "text": ". تو پره، پره، پره، پر. هیچ جا نیست که از خدا خالی باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 791.82,
   "end": 795.14,
   "text": "همه شأن حق‌اند. ظهور و بروز حق‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 795.14,
   "end": 798.36,
   "text": "درست شد؟ پس همه جا حقه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 798.36,
   "end": 800.64,
   "text": "همه جا جزو وجوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 800.64,
   "end": 804.08,
   "text": "پس نشئه طبیعت بالاخره وجود داره یا نه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 804.08,
   "end": 810.02,
   "text": "عدم که نیست. دارم می‌بندم جمع و بحث رو انشاالله بعدش فردا ادامه میدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 810.02,
   "end": 811.86,
   "text": "نشئه طبیعت وجود هست یا نه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 811.86,
   "end": 814.9,
   "text": "اگر وجود هست پس از وجود صمدی حضرت حقه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 814.9,
   "end": 817.7,
   "text": "وجود صمدی حضرت حق مگر حی نیست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 817.7,
   "end": 819.66,
   "text": "مگر قادر نیست؟ مگر مرید نیست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 819.66,
   "end": 822.76,
   "text": "مگر متکلم نیست؟ ها؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 822.76,
   "end": 825.64,
   "text": "مگر این اسماء الهی عین ذاتش نیست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 825.64,
   "end": 830.28,
   "text": "پس تمام این ذات الهی هویت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 830.28,
   "end": 834.7,
   "text": "حض-حضرت حق سرایان داره در همه جز جز نظام هستی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 834.7,
   "end": 838.3,
   "text": "یعنی ه-- یک سنگریزه هم حی است،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 838.3,
   "end": 844.18,
   "text": "قدیر است، مرید است، متکلم است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 844.18,
   "end": 847.88,
   "text": ". خب چطور میشه که داره میگه قیامت یک پارچه حیات،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 847.88,
   "end": 850.2,
   "text": "حیوانه. اون حیات محضه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 850.2,
   "end": 852.36,
   "text": "میگه آقا جون موتو قبلاً تموتو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 852.36,
   "end": 854.72,
   "text": "تو همین دنیا بمیر،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 214,
   "start": 854.72,
   "end": 859.24,
   "text": "اون نفستو بکش، چشمت باز بشه همین دنیا رو اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 215,
   "start": 859.24,
   "end": 861.34,
   "text": "نشئه آخرت همین جا رو می‌بینی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 216,
   "start": 861.34,
   "end": 863.56,
   "text": "می‌بینی یک طور دیگه‌ای میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 217,
   "start": 863.56,
   "end": 866.08,
   "text": "چشمت باز میشه می‌بینی عجب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 218,
   "start": 866.08,
   "end": 870.68,
   "text": "این حیوونای بدبخت که می‌زدیم تو سرشون اینام یک پارچه شعورن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 219,
   "start": 870.68,
   "end": 872.74,
   "text": "یک سنگریزه هم شعوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 220,
   "start": 872.74,
   "end": 877.22,
   "text": "آب حیا-- هرچی که شما ببینی نشئه طبیعت شعور محضه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 221,
   "start": 877.22,
   "end": 880.06,
   "text": "می‌فهمه، ادراک داره، تسبیح میگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 222,
   "start": 880.06,
   "end": 887.6,
   "text": "هر کجا سلطان این جمله‌ی آخرمو دقت کنین مال مرحوم علامه رفیعی قزوینیه و علامه حسن زاده ذیلش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 223,
   "start": 887.6,
   "end": 893.82,
   "text": "غوغا کرده. هر کجا سلطان وجود قدم گذاشت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 224,
   "start": 893.82,
   "end": 896.48,
   "text": "بالاخره تو نشئه طبیعت وجود داره یا نه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 225,
   "start": 896.48,
   "end": 900.42,
   "text": "هر کجا سلطان وجود قدم گذاشت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 226,
   "start": 900.42,
   "end": 904.26,
   "text": "اساکر اسماء و صفات به دنبالش هستن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 227,
   "start": 904.26,
   "end": 908.22,
   "text": "لشکریان اسماء و صفات حضرت حق که عین ذاتشن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 228,
   "start": 908.22,
   "end": 910.96,
   "text": "بالاخره اسمش حی هست یا نه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 229,
   "start": 910.96,
   "end": 913.72,
   "text": "اسمش مرید هست یا نه؟ یعنی اراده داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 230,
   "start": 913.72,
   "end": 915.7,
   "text": "اسمش متکلم هست یا نه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 231,
   "start": 915.7,
   "end": 918.6,
   "text": "قدیر هست یا نه؟ سميع و بصیر هست یا نه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 232,
   "start": 918.6,
   "end": 922.36,
   "text": "پس همه اینا هم حاضرن حتی در یک سنگریزه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 233,
   "start": 922.36,
   "end": 926.1,
   "text": "پس همین نشئه طبیعت هم حیات محضه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 234,
   "start": 926.1,
   "end": 927.9,
   "text": "چرا نمی‌خوای قبول کنی؟ میگه .",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 235,
   "start": 927.9,
   "end": 930.56,
   "text": "آقا ول کن ما رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 236,
   "start": 930.56,
   "end": 935.8,
   "text": "دل ما تو یه غلافی قرار گرفته این حرفا رو برو برای بزرگان بزن ما نمی‌فهمیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 237,
   "start": 935.8,
   "end": 938.24,
   "text": "بعد قرآن میگه لعن می‌کنیم ما اینا رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 238,
   "start": 938.24,
   "end": 940.18,
   "text": "اینا رو از رحم-- اینا دارن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 239,
   "start": 940.18,
   "end": 944.46,
   "text": "در حقیقت حالا عرض می‌کنم اینا رو یکی یکی میگم الان دیگه نریم جلوتر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 240,
   "start": 944.46,
   "end": 949.28,
   "text": "دارن پشت پا می‌زنن به خودشون که خودشون یک وجودین که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 241,
   "start": 949.28,
   "end": 954.1,
   "text": "به وزان حضرت حق آفریده شدن، خودشون رو دارن می‌زنن، خودزنی می‌کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 242,
   "start": 954.1,
   "end": 957.96,
   "text": "لذا ما لعنشون می‌کنیم. خدا به هممون رحم کنه انشاالله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 243,
   "start": 957.96,
   "end": 960.78,
   "text": "به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 244,
   "start": 960.78,
   "end": 964.18,
   "text": "الله- الله-- الله علی محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}