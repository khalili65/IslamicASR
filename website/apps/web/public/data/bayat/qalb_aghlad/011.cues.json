 "chapters": [
  {
   "index": 0,
   "title": "## قلبِ أغلف و شکاف در تعریفِ منطقیِ انسان",
   "start": 14.84,
   "end": 34.88
  },
  {
   "index": 1,
   "title": "## جماد و نبات و حیوان و دعویِ نطق",
   "start": 34.88,
   "end": 54.9
  },
  {
   "index": 2,
   "title": "## پرسشِ بی‌پاسخ از منطقی",
   "start": 54.9,
   "end": 327.72
  },
  {
   "index": 3,
   "title": "## محشور شدن به صورتِ حیوانات",
   "start": 327.72,
   "end": 399.64
  },
  {
   "index": 4,
   "title": "## گرگ در سخنِ یعقوب و خطبهٔ حسین و انگشتانِ سجاد",
   "start": 399.64,
   "end": 521.3
  },
  {
   "index": 5,
   "title": "## نسیان یا انس؛ و خطرِ غلافِ غفلت",
   "start": 521.3,
   "end": 743.26
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.26,
   "end": 2.94,
   "text": "السلام علیک ای داعی الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 2.94,
   "end": 8.9,
   "text": "و ربانی آیات. سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 8.9,
   "end": 13.34,
   "text": "یکی از اشکالاتی که بحث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 13.34,
   "end": 17.1,
   "text": "ما در خصوص اساساً این شصت قلبی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 17.1,
   "end": 24.24,
   "text": "الان رسیدیم به هفدهمین قلب در قرآن، حدود شصت تا خدا لطف کرده پژوهش کردیم از قرآن درآوردیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 24.24,
   "end": 27.9,
   "text": "و الان دو سه سالی هست سر سفره‌ی این آیاتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 27.9,
   "end": 31.02,
   "text": "یکی از اشکالاتی که وارد میشه بهش، به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 31.02,
   "end": 33.74,
   "text": "اون تعریفی که منطقیین بر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 33.74,
   "end": 37.62,
   "text": "انسان دارن. تو همین آیه یا اساساً خود همین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 37.62,
   "end": 44.6,
   "text": "آیات، دسته آیات پیرامون قلب در قرآن من جمله همین قلب اغلف، قلبی که در غلاف هست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 44.6,
   "end": 46.96,
   "text": "وارد میشه. همینجاست که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 46.96,
   "end": 51.72,
   "text": "خب ما میگیم آقا این‌ها میگن قلب ما در غلاف پره، نمی‌فهمیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 51.72,
   "end": 54.9,
   "text": "یکی از معانی‌ای که مفسرین گفتن اینه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 54.9,
   "end": 57.42,
   "text": "اینا مدعی‌اند که قلب ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 57.42,
   "end": 60.7,
   "text": "یا وجود ما یا گوش ما پره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 60.7,
   "end": 64.3,
   "text": "از حرف‌هایی که دیگه حرف‌های شما رو نمی‌فهمیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 64.3,
   "end": 67.52,
   "text": "اصلاً خودشونو می‌خوان راحت کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 67.52,
   "end": 73.4,
   "text": "اگر این چنینه از قدیم شنیدید جسارتاً میگن یاسین در گوش خر خواندن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 73.4,
   "end": 77.48,
   "text": "خب اگر این چنینه چه فرقی بین شما و حیوان است؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 77.48,
   "end": 81.82,
   "text": "اینجا یه اشکال اساسی به تعریف منطقیین بر انسان وارد میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 81.82,
   "end": 88.02,
   "text": "منطقی می‌دونید که میگه که بین موجودات عالم یه دسته جمادند که جسم‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 88.02,
   "end": 90.86,
   "text": "حجم و طول و عرض و رنگ و بو و این‌ها دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 90.86,
   "end": 94.46,
   "text": "هیچ درکی ندارن. البته نظر این‌هاست‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 94.46,
   "end": 96.64,
   "text": "اشتباه نشه ما حرف دیگه‌ای داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 96.64,
   "end": 100.56,
   "text": "یسبح وقتی به وادی عرفان قدم می‌گذاری و قرآن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 100.56,
   "end": 107.12,
   "text": "\"یسبح لله ما في السماوات وما في الأرض\" حتی این‌ها هم دارای یک شعور ابتدایی هستند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 107.12,
   "end": 110.28,
   "text": "اما خب حالا این شد. بعد به دسته دوم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 110.28,
   "end": 114.26,
   "text": "می‌رسی به در حقیقت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 114.26,
   "end": 116.64,
   "text": "مخلوقاتی که این‌ها بر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 116.64,
   "end": 121.66,
   "text": "اضافه‌ی بر جسمیت رشد و نمو هم دارن، بهش میگن نبات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 121.66,
   "end": 124.86,
   "text": "اما باز ادراکات اولیه رو ندارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 124.86,
   "end": 127.6,
   "text": "دسته دوم حیوانن، سوم ببخشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 127.6,
   "end": 132.28,
   "text": "سوم حیوانند که علاوه بر جسمیت و رشد و نمو،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 132.28,
   "end": 136.4,
   "text": "این‌ها شعور و آگاهی هم دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 136.4,
   "end": 139.26,
   "text": "آگاهی حیوانات البته بر اساس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 139.26,
   "end": 144.04,
   "text": "خیال و وهمشونه بسطام، نه اون آگاهی حالا انسانی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 144.04,
   "end": 146.82,
   "text": "مثلاً زن و بچه‌شون رو می‌شناسن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 146.82,
   "end": 151.44,
   "text": "حب و بغض دارن، دشمنشون رو تشخیص میدن، دوستشون رو تشخیص میدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 151.44,
   "end": 154.82,
   "text": "این‌ها بر اساس وهمشونه حیوانات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 154.82,
   "end": 157.38,
   "text": "عرض شود هم قوای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 157.38,
   "end": 160.44,
   "text": "ادراکی دارن، حواس پنجگانه دارن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 160.44,
   "end": 163.92,
   "text": "هم قوای تحریکی دارن یعنی شهوت و غضب دارن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 163.92,
   "end": 167.24,
   "text": "حب و بغض دارن. حالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 167.24,
   "end": 171.68,
   "text": "در بین این حیوانات منطقی اینجا میاد یه تمایز قائل میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 171.68,
   "end": 177.02,
   "text": "میگه هیچ‌کدوم از این همین حیوانات که حالا اصلش حیوانه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 177.02,
   "end": 184.28,
   "text": "\"وإن دار الآخرة لهي الحيوان\" یعنی حیات، یکپارچه حیات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 184.28,
   "end": 186.68,
   "text": "اینا میگن بین این حیوانات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 186.68,
   "end": 189.9,
   "text": "یه دسته‌شون هستن که فقط ناطق‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 189.9,
   "end": 193.8,
   "text": "می‌تونن کلمه بر زبان خودشون جاری کنن و کلام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 193.8,
   "end": 196.32,
   "text": "بیان کنن. \"وخلق الأزواج",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 196.32,
   "end": 199.02,
   "text": "كلها\" قرآن میگه همه چی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 199.02,
   "end": 202.24,
   "text": "با هم ازدواج می‌کنه بر اساس صنعه الهی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 202.24,
   "end": 205.16,
   "text": "این حروف بر مخارج حلق،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 205.16,
   "end": 209.64,
   "text": "مخارج حروف در حلق با هم مزدوج می‌شن، کلمه رو تشکیل میدن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 209.64,
   "end": 212.92,
   "text": "و کلمات با هم در-- تزویج می‌کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 212.92,
   "end": 214.8,
   "text": "کلام و جملات و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 214.8,
   "end": 218.56,
   "text": "موضوعات. این از عهده‌ی حیوانات دیگه بر نمیاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 218.56,
   "end": 221.96,
   "text": "فقط یک دسته از این جانوران،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 221.96,
   "end": 226.68,
   "text": "جان، جان دارن. مثل نباتات و جمادات و این‌ها نیستن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 226.68,
   "end": 231.56,
   "text": "یک دسته‌شون از این جانوران که جان دارن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 231.56,
   "end": 235.98,
   "text": "تمایز بهشون میده منطقی میگه که این‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 235.98,
   "end": 238.26,
   "text": "ناطق‌اند، حیوان ناطق‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 238.26,
   "end": 245.02,
   "text": "خب حالا شما بفرمایید اگر حیوان ناطق‌اند و این‌ها تمایز دارن از حیوانات دیگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 245.02,
   "end": 248.46,
   "text": "که در این نطق رو بر اساس همون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 248.46,
   "end": 253.28,
   "text": "فکرشون، بر اساس همون قوه عاقله‌شون پیدا کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 253.28,
   "end": 257.22,
   "text": "هیچ دیدید تا حالا حیوانی کتاب بنویسه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 257.22,
   "end": 260.1,
   "text": "حیوانی بحث علمی بکنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 260.1,
   "end": 263.02,
   "text": "حیوا-حیوانی اساساً کار علمی انجام بده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 263.02,
   "end": 265.28,
   "text": "چرا؟ چون قوه عقل رو ندارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 265.28,
   "end": 269.82,
   "text": "خب حالا بر اساس اینکه انسان تمایز پیدا کرد و قوای عاقله پیدا کرد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 269.82,
   "end": 271.64,
   "text": "این‌ها میگن نطق داره و این‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 271.64,
   "end": 274.92,
   "text": "خب الان شما بفرمایید آقای منطقی اینجا جواب بدید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 274.92,
   "end": 277.08,
   "text": "چطور اینجا هم تو گوش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 277.08,
   "end": 280.14,
   "text": "حیوان یاسین بخونی جواب نمیده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 280.14,
   "end": 282.82,
   "text": "هم تو گوش این انسان. پس این چگونه انسانه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 282.82,
   "end": 286.8,
   "text": "این که حیوانه. جوابتون چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 286.8,
   "end": 288.78,
   "text": "گیر می‌کنن. باید رفت سراغ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 288.78,
   "end": 290.72,
   "text": "انسان در عرف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 290.72,
   "end": 294.1,
   "text": "عرفان که یک رساله است حضرت آلامه دارن بسیار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 294.1,
   "end": 298.48,
   "text": "رساله وزینی و امید دارم یه روزی این رساله رو اینجا با هم کار کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 298.48,
   "end": 301.12,
   "text": "بسیار رساله ارشی‌ایه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 301.12,
   "end": 304.48,
   "text": "در عرف ارس-عرفان که همون قرآن است و برهان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 304.48,
   "end": 307.94,
   "text": "البته منطق هم برهانه، همون برهان ابتداییه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 307.94,
   "end": 310.58,
   "text": "برهان رو ببری بالا میشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 310.58,
   "end": 313.46,
   "text": "همون برهان فلسفی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 313.46,
   "end": 317.62,
   "text": "حالا در هر حال این‌ها گیرن تو این قصه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 317.62,
   "end": 321.2,
   "text": "حالا خ-خدا انشالله حفظ کنه از آیت الله مصمدی آملی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 321.2,
   "end": 324.02,
   "text": "اینجا اشکالات زیادی هم متأ-- حتی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 324.02,
   "end": 329.66,
   "text": "تعدد اشکال دارن در این قصه که آقا اصلاً مثلاً اشاره می‌کنم به اون آیه \"یوم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 329.66,
   "end": 332.66,
   "text": "ينفخ في الصور فتأتون أفواجا\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 332.66,
   "end": 338.14,
   "text": "تو سوره نبع. پیغمبر ذیل این آیه فرمود فوج فوج امت من",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 338.14,
   "end": 341.6,
   "text": "محشور می‌شن اما به قیافه های حیوانات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 341.6,
   "end": 343.26,
   "text": "خب آقای منطقی بیا جواب بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 343.26,
   "end": 346.28,
   "text": "شما که گفتی خوک ناطق نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 346.28,
   "end": 351.18,
   "text": "ها؟ سگ ناطق نیست، الاغ ناطق نیست، میمون ناطق نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 351.18,
   "end": 354.86,
   "text": "انسان است که ناطق است. پس چطور تو قیامت اینا همه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 354.86,
   "end": 362.26,
   "text": "همین انسان ناطق تو به شکل حیوانات محشور می‌شه فوج فوج پیغمبر فرمود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 362.26,
   "end": 364.06,
   "text": "اشکالش رو نمی‌تونه جواب بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 364.06,
   "end": 367.64,
   "text": "فوقش به، تو همین دنیا بتونه جوابگو باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 367.64,
   "end": 372.94,
   "text": "یا مثلاً اذا عرض شود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 372.94,
   "end": 376.8,
   "text": "اونجایی که می‌فرماید \"اذ الوحوش حشرت\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 376.8,
   "end": 379.44,
   "text": "محشور می‌شن وحوش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 379.44,
   "end": 383.5,
   "text": "محشور می‌شن برای چی؟ باز فرمودن این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 383.5,
   "end": 386.62,
   "text": "وحوش انسان‌های وحشی‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 386.62,
   "end": 389.66,
   "text": "حیوان که حشر نداره که. خب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 389.66,
   "end": 392.64,
   "text": "اگه انسان می‌خواد حشر پیدا کنه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 392.64,
   "end": 396.2,
   "text": "چهره‌ش بعد وحشیه یعنی شبیه گرگ محشور می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 396.2,
   "end": 399.14,
   "text": "خب گرگ که ناطق نیست. آقای منطقی جواب نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 399.14,
   "end": 403.64,
   "text": "یا اونجا که حضرت یعقوب علی‌نبی‌نا و آله و علیه صلوات و سلام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 403.64,
   "end": 405.76,
   "text": "خیلی با احترام به بچه‌هاش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 405.76,
   "end": 413.46,
   "text": "گفت شما گرگید \"اني اخاف ان يأكله الذئب\" یوسف رو می‌خواستن ببرن فرمود من می‌ترسم گرگ اینا رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 413.46,
   "end": 415.68,
   "text": "\"يأكله الذئب\" گرگ اینا رو بخوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 415.68,
   "end": 419.44,
   "text": "این منظور گرگ وجود فرزندانش بود نه که اون گرگ.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 419.44,
   "end": 422.1,
   "text": "حضرت یعقوب که می‌دونه گرگ اینو نمی‌خوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 422.1,
   "end": 424.04,
   "text": "این ولی‌الله یوسفه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 424.04,
   "end": 426.48,
   "text": "ولی‌الله رو هیچ حیوانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 426.48,
   "end": 428.92,
   "text": "آزار نمی‌رسونه. منظور",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 428.92,
   "end": 430.92,
   "text": "گرگ وجود فرزندانش بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 430.92,
   "end": 432.98,
   "text": "لذا بعضی از بزرگان قائل‌اند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 432.98,
   "end": 436.0,
   "text": "اون چندین سال‌ها، سی و چندین سال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 436.0,
   "end": 441.12,
   "text": "نزدیک چهل سال گریه حضرت یعقوب به خاطر این گرگ بودن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 441.12,
   "end": 443.46,
   "text": "صفت گرگ داشتن فرزندانش بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 443.46,
   "end": 446.12,
   "text": "برای اصلاح اونا همش گریه می‌کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 446.12,
   "end": 448.02,
   "text": "از یوسف که خیالش راحت بود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 448.02,
   "end": 453.5,
   "text": "و چقدر همین صبر جواب داد و اون‌ها همه نجات پیدا کردن و تائب شدن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 453.5,
   "end": 457.06,
   "text": "فرزندان. دیدی صبر چهل ساله ولی خدا چه می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 457.06,
   "end": 459.56,
   "text": "خب بازم می‌گه آقا اینا داره می‌گه گرگید دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 459.56,
   "end": 461.58,
   "text": "خب اینا که انسان‌اند چطور می‌گه گرگه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 461.58,
   "end": 470.2,
   "text": "منطقی بیا جواب بده. یا حتی حضرت امام حسین صلوات الله علیه می‌خواستن تشریف ببرن به سمت کربلا تو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 470.2,
   "end": 475.0,
   "text": "مکه خطبه خوندن فرمودن به سمت سرزمینی می‌روم که گرگ‌ها چ--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 475.0,
   "end": 478.12,
   "text": "دندان تیز کردن تا مرا بدرند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 478.12,
   "end": 480.56,
   "text": "خب اینا که انسان‌اند که. گرگ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 480.56,
   "end": 485.56,
   "text": "به این معنای حیوان گرگ اینطوری و زمینی که این که کاری به ولی خدا نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 485.56,
   "end": 491.06,
   "text": "منطقی بیا جواب بده. امام سجاد همه شنیدید انگشت‌های مبارک رو باز کرد از لای انگشتاش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 491.06,
   "end": 494.26,
   "text": "حاجی‌ها رو نشون داد. فرمود ما اكثر ال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 494.26,
   "end": 499.34,
   "text": "\"ما اكثر الزجير\" اکثراً زجره کننده‌اند و \"أقل الحجيج\" اقلشون حاجی‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 499.34,
   "end": 504.5,
   "text": "بعد طرف از میان دو انگشت امام سجاد صلوات-- صلوات الله علیه نگاه کرد همه رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 504.5,
   "end": 508.66,
   "text": "حیوان دید \"إلا قليل\". خب اینا که، اینا که حیوانن که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 508.66,
   "end": 514.5,
   "text": "مگه ناطق نیستن؟ مگه تو نگفتی منطقی که حیوانی که ناطق نیست انسان نیست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 514.5,
   "end": 516.4,
   "text": "اینا که همه سگ و خوک‌اند که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 516.4,
   "end": 520.04,
   "text": "پس چطور اینا ناطق‌اند؟ دارن زجره می‌کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 520.04,
   "end": 524.34,
   "text": "نه جواب نداره. اساساً انسان از ریشه یا أنثى است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 524.34,
   "end": 527.7,
   "text": "یا نسیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 527.7,
   "end": 530.44,
   "text": "اگه از ریشه نسیه باشه یعنی فراموشکار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 530.44,
   "end": 534.82,
   "text": "اگه أنثى باشه یعنی انس گیرنده، خو گرفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 534.82,
   "end": 542.64,
   "text": "حالا اگر انسان فوقش منطقی بیاد اینطوری پاسخ بده یا توجیه کنه بگه آقا اگر انسان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 542.64,
   "end": 546.46,
   "text": "بیاد فراموش کند دنیا را",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 546.46,
   "end": 549.88,
   "text": "و خو بگیرد با ملکوت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 549.88,
   "end": 553.46,
   "text": "این اون انسانه مدنظر ماست و وجه تمایز با خـ--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 553.46,
   "end": 560.58,
   "text": "اگه برعکس بشه بیاد خو بگیرد با دنیا و فراموش کند آخرت را، این می‌شه همون حیوان دوپا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 560.58,
   "end": 565.44,
   "text": "فوقش دیگه اینجا بتونه حرف بزنه یا تمیز قائل بشه بین ملک و ملکوت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 565.44,
   "end": 569.9,
   "text": "در هر حال با اون جواب نمی‌شه، با اون منطق نمی‌شه رفت جلو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 569.9,
   "end": 572.12,
   "text": "ت-- اساساً اینو می‌خوام امروز عرض کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 572.12,
   "end": 576.48,
   "text": "همین قلب اغلف یه نمونه از این شصت قلب داره می‌گه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 576.48,
   "end": 579.04,
   "text": "که آقا جان اگر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 579.04,
   "end": 585.0,
   "text": "همین انسانی ب-- حالا به ما و انسان که منطقی ازش یاد می‌کنه، اگر این هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 585.0,
   "end": 587.52,
   "text": "گوش شنوا نداشته باشد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 587.52,
   "end": 591.7,
   "text": "این هم قلبش دچار غفلت شود،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 591.7,
   "end": 593.98,
   "text": "دچار غلاف شود،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 593.98,
   "end": 599.92,
   "text": "گرفتار بشود، قلبش رو نده به حقایق نظام هستی و عقلش رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 599.92,
   "end": 603.54,
   "text": "مشوب به وهم و خیال بکند، این هم می‌شود حیوان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 603.54,
   "end": 608.46,
   "text": "آقا اصلاً البته منطق کاری با قرآن نداره ها اما قرآن داره می‌گه چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 608.46,
   "end": 611.9,
   "text": "\"أُولَٰئِكَ كَالْأَنْعَامِ\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 611.9,
   "end": 615.48,
   "text": "مثل حیوان، بدتر از اون \"بَلْ هُمْ أَضَلُّ\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 615.48,
   "end": 617.9,
   "text": "این خطره. اینجا خطره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 617.9,
   "end": 621.06,
   "text": "اگر کسی-- اینو می‌خوام عرض کنم، این خطر رو می‌خوام بگم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 621.06,
   "end": 626.42,
   "text": "اگر کسی نره به حوزه تعقلش و گرفتار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 626.42,
   "end": 628.84,
   "text": "فوقش خیال و وهمش بمونه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 628.84,
   "end": 632.66,
   "text": "اساساً به انسانیت انسان، وجودش نرسیده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 632.66,
   "end": 635.86,
   "text": "وجه تمایز انسان با حیوان عقلشه، تفکرشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 635.86,
   "end": 645.52,
   "text": "\"الرحمن خلق القرءان-- الرحمن علم القرآن خلق الإنسان علمه البيان\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 645.52,
   "end": 647.6,
   "text": "خلقت انسان بین دو تا بیانه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 647.6,
   "end": 649.8,
   "text": "دو تا ببخشید تعلیمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 649.8,
   "end": 654.74,
   "text": "\"علم القرآن خلق الإنسان علمه البيان\" دو تا تعلیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 654.74,
   "end": 657.02,
   "text": "اصلاً خلقت انسان اومده برای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 657.02,
   "end": 661.2,
   "text": "کتابت، برای نویسندگی، برای تفکر، برای تعقل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 661.2,
   "end": 664.36,
   "text": "\"اقرأ باسم ربك الذي خلق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 664.36,
   "end": 666.82,
   "text": "خلق الإنسان من علق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 666.82,
   "end": 669.9,
   "text": "اقرأ\". دوباره بین \"اقرأ وربك الأكرم\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 669.9,
   "end": 672.4,
   "text": "بین دو تا اقرأ خلقت انسان واقع شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 672.4,
   "end": 676.06,
   "text": "قرائت. هیچ حیوانی قرائت نداره، انسان داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 676.06,
   "end": 682.34,
   "text": "اگر قرار باشه قرائت حقایق نظام هستی رو بیان تو گوش امثال من و شماها بکنن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 682.34,
   "end": 685.68,
   "text": "مام بگیم، مام پس بزنیم یعنی قلب اغلف دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 685.68,
   "end": 688.52,
   "text": "خب ما چه فرقی با حیوان می‌کنیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 688.52,
   "end": 691.9,
   "text": "ختم کلام اینکه عزیزان دلم قربونتون برم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 691.9,
   "end": 696.5,
   "text": "خیلی خطر عزی-- عجیبی بر اساس قرآن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 696.5,
   "end": 703.0,
   "text": "وجود انسان رو در برگرفته و انسان در یک غلافی از غفلت قرار داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 703.0,
   "end": 710.6,
   "text": "در حالی که خدا با شصت نوع قلب در حد فکر من بیچاره تو قرآن به نهیب ما اومده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 710.6,
   "end": 714.12,
   "text": "هی نهیب می‌زنه می‌گه این قلبت دچار غفلت نشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 714.12,
   "end": 717.76,
   "text": "قلبت دچار غفلت نشه، تو غلاف نره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 717.76,
   "end": 720.5,
   "text": "تو فرقت با حیوان خیلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 720.5,
   "end": 723.02,
   "text": "بالاست. اصلاً تو-- حالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 723.02,
   "end": 725.36,
   "text": "این رو باید مراقبت کرد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 725.36,
   "end": 728.38,
   "text": "و وظیفه ما اینه که هر روز با هم چیکار کنیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 728.38,
   "end": 730.14,
   "text": "پند و اندرز بدیم بر اساس قرآن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 730.14,
   "end": 732.74,
   "text": "انشالله که عاقبتمون ختم بخیر بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 732.74,
   "end": 735.6,
   "text": "به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 735.6,
   "end": 743.26,
   "text": "اللهم صل على محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}