  {
   "index": 4,
   "title": "## حرکت ایجادی و وجودی؛ مثال مشک",
   "start": 401.08,
   "end": 484.76
  },
  {
   "index": 5,
   "title": "## بقیة الله؛ خلیفهٔ دوازدهم",
   "start": 484.76,
   "end": 570.7
  },
  {
   "index": 6,
   "title": "## اقتدای عیسی به امام عصر",
   "start": 570.7,
   "end": 747.43
  },
  {
   "index": 7,
   "title": "## اقرأ باسم ربک؛ آغاز پل ملک و ملکوت",
   "start": 747.43,
   "end": 847.51
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.86,
   "end": 8.88,
   "text": "بسم الله الرحمن الرحیم و به او استعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 8.88,
   "end": 13.58,
   "text": "السلام علیک یا داعی الله و ربانی آیات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 13.58,
   "end": 19.2,
   "text": "سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 19.2,
   "end": 25.54,
   "text": "تبریک عرض می‌کنم این شب بسیار با عظمت رو که به قول حضرت امام علیه الرحمه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 25.54,
   "end": 28.12,
   "text": "با عظمت‌ترین شب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 28.12,
   "end": 34.3,
   "text": "سال است و دیگه بالاتر از ما شب مبعث به قول حضرت امام نداریم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 34.3,
   "end": 39.24,
   "text": "و در حقیقت در اسلام عیدی بالاتر از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 39.24,
   "end": 47.18,
   "text": "عید ب-بعثت نداریم که اگه همچین شبی نبود ارتباط بین ملک و ملکوت اتفاق نمی‌افتاد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 47.18,
   "end": 50.32,
   "text": "و دست ما از ملکوت نظام هستی کوتاه می‌موند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 50.32,
   "end": 53.64,
   "text": "الف لام میم. اون الف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 53.64,
   "end": 58.44,
   "text": "الله هست دلالت بر الله و الوهیت حضرت حق دارد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 58.44,
   "end": 61.74,
   "text": "لام اشاره به حضرت جبرائیل دارد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 61.74,
   "end": 67.04,
   "text": "و میم اشاره دارد به نام مقدس محمد صلى الله عليه و آله وسلم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 67.04,
   "end": 73.14,
   "text": "صلى الله علیه و آله وسلم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 73.14,
   "end": 80.5,
   "text": "در حقیقت نبی اکرم اسلام واسطه‌ی بین حضرت حق و مخلوقات شده است که اگر او نبود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 80.5,
   "end": 82.68,
   "text": "دست ما از همه مخلوق، همه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 82.68,
   "end": 84.94,
   "text": "ملکوت، همه ملکوت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 84.94,
   "end": 87.96,
   "text": "به واقع کوتاه می‌شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 87.96,
   "end": 90.5,
   "text": "حالا برای اینکه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 90.5,
   "end": 99.06,
   "text": "بحث ما هم قلب اغلف و قل-قلب در غلاف بود مرتبط به بحث هم بشه موضوع مبعث و پیغمبر ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 99.06,
   "end": 103.7,
   "text": "این چنین بحث را آغاز می‌کنیم در این کوتاه سخن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 103.7,
   "end": 108.22,
   "text": "عزیزان توجه داشته باشن که بی‌توجهی و پس زدن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 108.22,
   "end": 115.24,
   "text": "یکی مثل نبی اکرم اسلام که خلاصه‌ی خلقت است خیلی گناهش سنگین‌تر است از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 115.24,
   "end": 117.42,
   "text": "دیگر انبیا رو پس زدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 117.42,
   "end": 121.74,
   "text": "درسته همه در طول هم‌ان اما گناه این سنگین‌تر از اونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 121.74,
   "end": 125.44,
   "text": "اگر شما به یک یتیمی یه سیلی بزنی خب دل می‌سوزه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 125.44,
   "end": 129.22,
   "text": "باید هم انتقام گرفت. چرا یه یتیمو شما سیلی زدی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 129.22,
   "end": 134.62,
   "text": "اما اون کجا که به یک کسی سی-سیلی بزنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 134.62,
   "end": 139.02,
   "text": "که تمام عالم به یمن وجود او رزق می‌خورن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 139.02,
   "end": 146.18,
   "text": "خب قطعاً این‌ها شما یه آدم جاهل رو اساء ادب کن، بده حتی اساء ادب به جاهل هم نباید کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 146.18,
   "end": 150.46,
   "text": "اما حالا شما بیا به عقل کل نظام هستی، به یه دانشمند اصلاً.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 150.46,
   "end": 156.38,
   "text": "این‌ها با هم متفاوته دیگه. صاحبان قلب اغ-اغلف یا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 156.38,
   "end": 160.24,
   "text": "در حقیقت قلوب قلف این‌ها پس زدن کیو؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 160.24,
   "end": 163.68,
   "text": "پیغمبر رو که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 163.68,
   "end": 168.48,
   "text": "صاحب در حقیقت عصری‌ست که اون عصر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 168.48,
   "end": 172.5,
   "text": "خلاصه‌ی تمام حسنه ها و خوبی‌هاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 172.5,
   "end": 177.76,
   "text": "بر اساس آیه‌ی surah Al-Asr خیلی این surah عجیبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 177.76,
   "end": 185.32,
   "text": "و العصر اون الف و لامی که اومده سر عصر، اون عصر استقراقی‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 185.32,
   "end": 190.66,
   "text": "خوب اینو گوش بدید. عصر استقراقی یعنی تمام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 190.66,
   "end": 199.08,
   "text": "اعصار دیگه که به قول حضرت علامه حسن زاده میاد ازل و ابد رو میاره اینجا پیاده می‌کنه تو همین عصر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 199.08,
   "end": 203.12,
   "text": "چون بر اساس رساله‌ی رزق و فتح ایشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 203.12,
   "end": 205.88,
   "text": "که یک دوره‌ای حالا ایشون بر اساس علم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 205.88,
   "end": 211.84,
   "text": "هیئت و نجوم و این‌ها حسابرسی کردن و به هر حال حساب ریاضی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 211.84,
   "end": 215.6,
   "text": "صد و هشتاد و شش هزار سال بعد این اتفاق می‌افته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 215.6,
   "end": 217.88,
   "text": "دو مرتبه کل زمینو آب می‌گیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 217.88,
   "end": 222.88,
   "text": "به یک معنا قیامت دوره‌ی ما اون می‌شه و بعد دو مرتبه کل آب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 222.88,
   "end": 226.4,
   "text": "که زمین رو گرفت شروع می‌شه بر اساس همین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 226.4,
   "end": 229.84,
   "text": "قاعده‌ی رزق و فتح که رساله‌ی ایشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 229.84,
   "end": 232.56,
   "text": "در کتاب هزار و یک کلمه هم اومده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 232.56,
   "end": 234.78,
   "text": "می‌تونید اونجا ببینید این رساله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 234.78,
   "end": 241.56,
   "text": "در یکی از کلمات اومده. اندیشمندان کشورهای دیگه رو به هم ریخته چنان و ما در خواب خرگوشی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 241.56,
   "end": 245.54,
   "text": "ما که بغل ایشونیم. بر اساس این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 245.54,
   "end": 248.26,
   "text": "قاعده دو مرتبه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 248.26,
   "end": 250.58,
   "text": "خشکی دحل الارض.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 250.58,
   "end": 252.8,
   "text": "تو دوره‌ی ما از زیر کعبه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 252.8,
   "end": 255.5,
   "text": "زمین خودش رو نشون داد، آب فروکش کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 255.5,
   "end": 260.24,
   "text": "اون دوره هم حالا به شکل خودش که ما بی‌خبریم چه شکلی زمین از کجا خودش رو نشون میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 260.24,
   "end": 262.64,
   "text": "دو مرتبه دوره‌ی جدید خلقت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 262.64,
   "end": 267.08,
   "text": "که امام صادق صلوات الله علیه فرمود ألف ألف هزار هزار خلقت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 267.08,
   "end": 269.96,
   "text": "دوره دوره‌ی آدم بوده و خواهد بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 269.96,
   "end": 274.04,
   "text": "اما ح-حضرت علامه حسن زاده می‌فرماید این دوره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 274.04,
   "end": 280.3,
   "text": "که حضرت ختمی مرتبت تشریف آوردند ازل ابد رو میاره پیاده می‌کنه بر اساس آیه‌ی و العصر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 280.3,
   "end": 285.36,
   "text": "می‌فرماید تمام اعصار چه قبل، چه بعد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 285.36,
   "end": 287.6,
   "text": "مستغرق در این عصراً.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 287.6,
   "end": 290.1,
   "text": "غرق در این ق-عصراً.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 290.1,
   "end": 295.16,
   "text": "لذا اسمشو می‌گذارن عصر محمدی صلى الله عليه و آله وسلم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 295.16,
   "end": 299.78,
   "text": "صلى الله علیه و آله وسلم عصر هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 299.78,
   "end": 302.3,
   "text": "اساره، اساره میگن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 302.3,
   "end": 304.7,
   "text": "اساره یعنی چکیده‌گیری،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 304.7,
   "end": 307.22,
   "text": "خلاصه، ذوبده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 307.22,
   "end": 310.14,
   "text": "یعنی تمام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 310.14,
   "end": 315.46,
   "text": "در حقیقت شما اون-اونچه که در نظام هستی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 315.46,
   "end": 317.56,
   "text": "اسرار و حقایق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 317.56,
   "end": 321.48,
   "text": "و نیکی و حسن هرچی، هرچی خوبیست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 321.48,
   "end": 326.22,
   "text": "بریزی روی هم چکیده، ذوبده‌ی همه‌ی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 326.22,
   "end": 330.48,
   "text": "عظمت‌ها، جبروت‌ها، عظمت‌ها،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 330.48,
   "end": 333.0,
   "text": "هرچی نمی‌دونم دیگه چه اسمشو بذاریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 333.0,
   "end": 337.98,
   "text": "هرچی خیره است در کل اعصار در این عصر جمع شده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 337.98,
   "end": 346.04,
   "text": "و اون هم تنزل پیدا کرده بر قلب پیغمبر عظیم الشأن اسلام که انا انزلناه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 346.04,
   "end": 348.56,
   "text": "به انزال دفعی بر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 348.56,
   "end": 351.7,
   "text": "في ليلة القدر بر قلب مقدس پیغمبر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 351.7,
   "end": 357.82,
   "text": "این چیز کمی نیست که در عصر ما اتفاق افتاده که حالا شما حساب کنید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 357.82,
   "end": 364.32,
   "text": "فقط خلیفه‌ی دوازدهم ایشون که ما در عصر ایشون هستیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 364.32,
   "end": 366.56,
   "text": "باز میگیم چی؟ صاحب ال،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 366.56,
   "end": 369.02,
   "text": "صاحب العصر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 369.02,
   "end": 371.8,
   "text": "یعنی صاحب هر چیزی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 371.8,
   "end": 376.28,
   "text": "شما خوبی هست و چکیدش رو بگیری گذاشتی تو وجود این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 376.28,
   "end": 381.52,
   "text": "حالا این عصری که ما هستیم صاحب همه این خوبی‌ها این آقاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 381.52,
   "end": 384.52,
   "text": "که حالا اگر کتاب فصل اسمی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 384.52,
   "end": 395.5,
   "text": "فی کلمه فاطمی از ت-- استاد رو بخونید خیلی زیبا اونجا بحث می‌کنند ایشون که تماماً نظام هستی در حرکت است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 395.5,
   "end": 398.84,
   "text": "سکون محض در وجود حضرت حق است و ذات او.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 398.84,
   "end": 401.08,
   "text": "بقیه همه در حرکت‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 401.08,
   "end": 403.42,
   "text": "عالم بالا حرکت ایجادیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 403.42,
   "end": 406.8,
   "text": "هی ما رو ترغیب می‌کنند، ایجاد می‌کنند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 406.8,
   "end": 409.24,
   "text": "نشئه ملکوط رو. عالم مَ--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 409.24,
   "end": 414.5,
   "text": "ملک که ما هستیم حرکت وجودیه که یادم یه جلسه اینجا درباره این‌ها بحث کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 414.5,
   "end": 418.7,
   "text": "حرکت وجودیه یعنی وجود تو دائم در حال شدت وجودیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 418.7,
   "end": 423.9,
   "text": "هی داری علم کسب می‌کنی، رشد می‌کنی، از نقص به کمال میری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 423.9,
   "end": 427.46,
   "text": "دائم تمام نظام هستی آن به آن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 427.46,
   "end": 430.12,
   "text": "در حرکت وجودین. این حرکت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 430.12,
   "end": 433.56,
   "text": "علامه میاد مثال میزنه در اون کتاب شریف مثل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 433.56,
   "end": 436.92,
   "text": "مشک. میگه مثل اینکه مشک رو داری تکون میدی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 436.92,
   "end": 440.84,
   "text": "خدا هم نظام هستی رو داره به حرکت در میاره، تکون میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 440.84,
   "end": 448.24,
   "text": "اون زبده، چکیده، خلاصه، اون روغن، اون کره، اون خامه، چی می‌خوای اسمشو بذاری که اون رو جمع می‌شه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 448.24,
   "end": 450.88,
   "text": "چکیده همه خلاصه همه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 450.88,
   "end": 456.84,
   "text": "اونچه که در مشک وجود داره اون رو جمع می‌شه، اون انسان است، نطفه انسان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 456.84,
   "end": 459.8,
   "text": "و اون ثمر خلقت است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 459.8,
   "end": 468.52,
   "text": "حالا در میان همه این انسان‌ها، اونکه رتبه یک گرفته و پل زده بین ملک و ملکوک پیغمبر عظیم الشأن اسلامه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 468.52,
   "end": 472.92,
   "text": "که اگر او نبود اصلاً ثمره‌ای نداشت نظام هستی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 472.92,
   "end": 475.66,
   "text": "شما درختی می‌کاری که ثمر بهت نده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 475.66,
   "end": 480.48,
   "text": "نه. خدا این درخت وجود رو کاشت که ثمره‌ش بشه پیغمبر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 480.48,
   "end": 483.1,
   "text": "لذا فرمود لولاک لما خلقت الافلاک.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 483.1,
   "end": 490.76,
   "text": "اگر تو نبودی. حالا خلیفه دوازدهم ایشون کسی‌ست که بهش میگن بقیت الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 490.76,
   "end": 495.52,
   "text": "بقیه الله. لغت‌شناسا میگن شما یه مقدار به همین مثال می‌زنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 495.52,
   "end": 498.4,
   "text": "گندم بریز رو زمین، یه مقدارش هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 498.4,
   "end": 501.34,
   "text": "رو دستت. میگه آقا این گندم بقیه اونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 501.34,
   "end": 506.4,
   "text": "چرا بقیه اونه؟ میگه چون عین اونه، جنس اونه، مثل اونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 506.4,
   "end": 509.2,
   "text": "هم شکل و هم خاصیت همونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 509.2,
   "end": 512.44,
   "text": "به همین مثال میگن بقیت الله یعنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 512.44,
   "end": 516.0,
   "text": "مثل خداست. یعنی تمام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 516.0,
   "end": 522.18,
   "text": "صفات و اسماء حضرت حق درش پیاده شده که لا فرق بینک و بینهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 522.18,
   "end": 525.2,
   "text": "الا انهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 525.2,
   "end": 527.26,
   "text": "عبادک و خلقک.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 527.26,
   "end": 531.34,
   "text": "هیچ فرقی بین خدا و اون‌ها نیست مگر اینکه اونا بنده خدااند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 531.34,
   "end": 539.34,
   "text": "دیگه هرچی تو خدا. میگه ما رو خدا ندونید، رب مطلق ندونید، الله ندونید، هرچی می‌خواید درباره ما بگید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 539.34,
   "end": 547.74,
   "text": "الله اکبر. حالا شما حساب کنید این خلیفه دوازدهم تازه که تونسته اتحاد وجودی با جان پیغمبر برقرار کنه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 547.74,
   "end": 549.86,
   "text": "ایشون تمام خلاصه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 549.86,
   "end": 554.64,
   "text": "تمام خوبی‌ها و خیرات همه اعصار رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 554.64,
   "end": 560.7,
   "text": "که در این عصر جمع شده ایشون صاحبش شده باز ایشون خلیفه و جانشینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 560.7,
   "end": 564.62,
   "text": "ببینید اون عقل کل چیه، اون ختم رسل چیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 564.62,
   "end": 570.34,
   "text": "که ختم کرده تمام رسالت رو تا آخرش رفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 570.34,
   "end": 577.46,
   "text": "البته نبوت انبایی یعنی باخبر شدن از اسرار نظام هستی ادامه دارد اما نبوت تشریعی تمام شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 577.46,
   "end": 580.48,
   "text": "دیگه هیچکس نمی‌تونه بیاد تشریع ایجاد کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 580.48,
   "end": 585.0,
   "text": "احکام تمام شد. شما ببینید حالا همچین کسی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 585.0,
   "end": 590.6,
   "text": "خود شما ببینید امام عصر تازه وقتی تشریف میاره اینو خوب دقت کنید، فاصله‌ها رو دقت کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 590.6,
   "end": 594.94,
   "text": "امام عصر وقتی تشریف بیارن انشاالله زنده باشید در رکاب حضرت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 594.94,
   "end": 599.26,
   "text": "حضرت عیسی یکی از انبیایی که آسمونن و تشریف میارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 599.26,
   "end": 602.7,
   "text": "اینکه حالا چرا آسمونن؟ چون پدر ایشون آسمانی بود دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 602.7,
   "end": 605.26,
   "text": "فتمثل لها بشرا سویا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 605.26,
   "end": 610.58,
   "text": "قرآن میگه حضرت جبرائیل یا حالا موجود مجرد عقلی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 610.58,
   "end": 612.66,
   "text": "ایشون اومد تمثل پیدا کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 612.66,
   "end": 616.62,
   "text": "فتمثل، فتمثل لها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 616.62,
   "end": 620.96,
   "text": "در عالم مثال و قوه خیال حضرت مریم ایشون متمثل شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 620.96,
   "end": 624.34,
   "text": "موجود مجرد عقلی و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 624.34,
   "end": 627.46,
   "text": "به قاعده کن حضرت حق،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 627.46,
   "end": 631.58,
   "text": "حضرت عیسی رو به قاعده کن حضرت حق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 631.58,
   "end": 634.7,
   "text": "ایجاد کرد در رحم حضرت مریم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 634.7,
   "end": 640.06,
   "text": "که حضرت عیسی شد در حقیقت یکون کن حضرت حق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 640.06,
   "end": 646.24,
   "text": "کن فیکون. حضرت عیسی پدرش می‌شه اون حالا روح‌الامین هرچی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 646.24,
   "end": 648.4,
   "text": "که تمثل در قوه خیال.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 648.4,
   "end": 651.94,
   "text": "یعنی چون پدر ال-- الولد سر ابیه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 651.94,
   "end": 656.02,
   "text": "چون پدر ایشون آسمانی بود حضرت عیسی هم باید آسمانی می‌شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 656.02,
   "end": 662.44,
   "text": "بعد ایشون وقتی که امام عصر ما تشریف بیارن، میارن اقتدا می‌کنند به امام عصر ما و میگن امروز کی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 662.44,
   "end": 665.78,
   "text": "حضرت عیسی که آسمانن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 665.78,
   "end": 668.7,
   "text": "به که پدرش اینطوری بگیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 668.7,
   "end": 670.46,
   "text": "پدرجد علمه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 670.46,
   "end": 673.4,
   "text": "همه علم از حضرت جبرائیله دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 673.4,
   "end": 678.68,
   "text": "موجود مجرد عقلی وقتی قاعده علمی پیدا کنه اسمش می‌شه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 678.68,
   "end": 682.84,
   "text": "جبرائیل. پس همه علم به یک معنا می‌تونه از حضرت عیسی باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 682.84,
   "end": 688.38,
   "text": "حالا ایشون میاد به حضرت صاحب الامر ما میگه امروز امیر الامرا تویی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 688.38,
   "end": 691.48,
   "text": "شما جلو وایسا و حضرت عیسی به ایشون اقتدا می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 691.48,
   "end": 696.1,
   "text": "به یک معنا وقتی عصاره انبیا که حضرت عیساست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 696.1,
   "end": 700.66,
   "text": "تشریف میارن به امام عصر ما اقتدا می‌کنند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 700.66,
   "end": 705.8,
   "text": "تمام انبیا، علامه میگن تمام انبیا اگر به جز ختم رسل،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 705.8,
   "end": 711.0,
   "text": "تمام انبیا تشریف بیارن به امام عصر ما میگن شما امامت داری بر ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 711.0,
   "end": 717.24,
   "text": "بر خلیفه پیغمبر، دوازدهمین خلیفه پیغمبر ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 717.24,
   "end": 719.1,
   "text": "سره بر همه انبیا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 719.1,
   "end": 723.7,
   "text": "حالا دیگه شما ببین پیغمبر ما چه وضعیتی داره، چه جایگاهی داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 723.7,
   "end": 727.2,
   "text": "پیغمبر ما جایگاهش اصلاً یک دانه خلقته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 727.2,
   "end": 732.39,
   "text": "نمی‌دونم چی باید گفت حالا لطیفانه‌ش رو برای همه فهم گفتن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 732.39,
   "end": 735.61,
   "text": "اگر دنیا بگی-- به قائ-- به این قاعده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 735.61,
   "end": 739.29,
   "text": "نظام‌بندی کنی که یک گل دارد و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 739.29,
   "end": 746.09,
   "text": "یک گل و تک، تک گل نظام هستی اون پیغمبر است بقیه عطر گل‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 746.09,
   "end": 750.83,
   "text": "یه دونه خلقته. حالا امشب ایشون پل زده بین زمین و آسمان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 750.83,
   "end": 752.93,
   "text": "و شروع می‌شه دیگه از امشب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 752.93,
   "end": 755.15,
   "text": "اقرأ باسم ربک الذي خلق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 755.15,
   "end": 760.89,
   "text": "اونم ربک، پروردگار تو که هر چقدر تو محبوب باشی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 760.89,
   "end": 762.99,
   "text": "رب به تو رو می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 762.99,
   "end": 766.37,
   "text": "میگه بخوان پروردگار خودت رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 766.37,
   "end": 770.15,
   "text": "هر چقدر تو محبوب باشی رب به تو رو می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 770.15,
   "end": 773.19,
   "text": "خدای پیغمبر امشب توجه به زمین کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 773.19,
   "end": 776.73,
   "text": "الله اکبر. اقرأ باسم ربک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 776.73,
   "end": 785.83,
   "text": "الذي خلق. خدای پیغمبر با اون ربوبیت پیغمبر که دیگه به گردش کسی، کسی نرسیده و نخواهد رسید،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 785.83,
   "end": 787.79,
   "text": "توجه به زمین کرده امشب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 787.79,
   "end": 792.51,
   "text": "این چیز کمی نیست و قرآن از امشب به صورت تشریعی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 792.51,
   "end": 798.15,
   "text": "دفعةً که قبلاً نازل شد انا انزلنا به یکباره تمام قرآن که انک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 798.15,
   "end": 800.87,
   "text": "لتلقى القرآن من لدن حکیم علیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 800.87,
   "end": 806.19,
   "text": "تمام قرآن که تمام علم حضرت حق است رو خدا بر قلب پیغمبر نازل کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 806.19,
   "end": 809.03,
   "text": "حالا بعضیا گفتن سیزده سالگی پیغمبر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 809.03,
   "end": 817.05,
   "text": "اما از امشب در سن چهار-- سی سالگی بیست و سه سال تدریجی تنزل الملائکه والروح شروع می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 817.05,
   "end": 819.29,
   "text": "پل زده می‌شه بین ملک و ملکوت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 819.29,
   "end": 821.67,
   "text": "اگه امشب نبود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 821.67,
   "end": 823.39,
   "text": "دیگه ما سر به سجده نداشتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 823.39,
   "end": 825.53,
   "text": "اصلاً خدایی نمی‌شناختیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 825.53,
   "end": 830.77,
   "text": "لذا خیلی امشب گردن همه مبهدین نظام هستی حق دارد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 830.77,
   "end": 835.43,
   "text": "نصار پیغمبر هر چقدر که از این حرف‌ها کیف کردی عزیز دلم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 835.43,
   "end": 839.89,
   "text": "نصار پیغمبر و خلفای پیغمبر که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 839.89,
   "end": 845.57,
   "text": "راه او رو رفتن و اتحاد وجودی با جان پیغمبر پیدا کردن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 845.57,
   "end": 847.51,
   "text": "صلوات قشنگ بفرستین. الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}