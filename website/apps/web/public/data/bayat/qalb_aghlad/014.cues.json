 "chapters": [
  {
   "index": 0,
   "title": "## قلوبنا غلف؛ علم فکری نه شهودی",
   "start": 14.14,
   "end": 191.94
  },
  {
   "index": 1,
   "title": "کسب ثلاثی مجرد است. حضرت علامه می‌فرمایند کسب آن است که مطابق فطرت اولیه باشد:",
   "start": 191.94,
   "end": 257.68
  },
  {
   "index": 2,
   "title": "## قوای وجودی در حد اعتدال",
   "start": 257.68,
   "end": 279.98
  },
  {
   "index": 3,
   "title": "حضرت علامه بر اساس آیهٔ فاطر می‌فرمایند:",
   "start": 279.98,
   "end": 709.27
  },
  {
   "index": 4,
   "title": "## جمع‌بندی؛ غلف بودن گرفتاری در ملح اجاج",
   "start": 709.27,
   "end": 793.77
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 3.22,
   "end": 6.48,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 6.48,
   "end": 10.26,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 10.26,
   "end": 14.14,
   "text": "آیات. السلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 14.14,
   "end": 17.38,
   "text": "در ادامه بحث قلب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 17.38,
   "end": 25.56,
   "text": "اغلف، نکته‌ی دیگه‌ای رو هم عارض بشیم بر اساس آیه هشتاد و هشت سوره بقره که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 25.56,
   "end": 27.66,
   "text": "و قالوا قلوبنا غلف.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 27.66,
   "end": 31.52,
   "text": "اینا مدعی‌اند که ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 31.52,
   "end": 35.52,
   "text": "دلمون پره از این معارفی که به یک معنا از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 35.52,
   "end": 40.28,
   "text": "جهت مفسرین از این حقایق که شما-- علومی که شما آوردید دلمون پره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 40.28,
   "end": 43.16,
   "text": "قطعاً قبلاً بحث شد که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 43.16,
   "end": 45.4,
   "text": "این‌ها اگر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 45.4,
   "end": 51.36,
   "text": "قبول کنیم که عالم هم بودند مثل علمای یهود،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 51.36,
   "end": 55.26,
   "text": "اگر بپذیریم که این‌ها حتی علم هم داشتند،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 55.26,
   "end": 60.56,
   "text": "این علم در حد علم فکری بوده و به علم شهودی بدل نشده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 60.56,
   "end": 63.18,
   "text": "قرآن بر اساس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 63.18,
   "end": 66.2,
   "text": "آیه دویست و هشتاد و شش بقره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 66.2,
   "end": 72.4,
   "text": "صراحتاً می‌فرماید که \"لها ما كسبت وعليها ما اكتسبت\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 72.4,
   "end": 74.44,
   "text": "این خیلی نکته‌ی مهمیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 74.44,
   "end": 77.22,
   "text": "این آیه اساساً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 77.22,
   "end": 79.9,
   "text": "به قول حضرت آیت الله مصباح",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 79.9,
   "end": 86.74,
   "text": "یزدی جا داره که انسان بر اساس این آیه یک دور کل قرآن رو طی کنه، بخونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 86.74,
   "end": 93.38,
   "text": "چگونه؟ دو گونه اینجا بر اساس این آیه ما عمل داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 93.38,
   "end": 98.1,
   "text": "یک عمل ما بر علیه ماست، یک عمل ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 98.1,
   "end": 102.26,
   "text": "به نفع ماست. میگه \"لها ما كسبت\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 102.26,
   "end": 105.94,
   "text": "كسب ما لها برای ماست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 105.94,
   "end": 108.34,
   "text": "و \"وعليها ما اكتسبت\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 108.34,
   "end": 111.8,
   "text": "اكتساب ما بر علیه ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 111.8,
   "end": 117.82,
   "text": "دقت بفرمایید \"لها ما كسبت وعليها ما اكتسبت\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 117.82,
   "end": 121.78,
   "text": "حالا كسب با اكتساب چه فرقی می‌کنه که این‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 121.78,
   "end": 125.8,
   "text": "كسب به نفع ماست و اكتساب به ضرر ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 125.8,
   "end": 128.72,
   "text": "مثلاً یکی میره در دادگاه شهادت می‌ده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 128.72,
   "end": 132.88,
   "text": "میگه شهادت تو باله بود یا علیه بود؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 132.88,
   "end": 134.92,
   "text": "اینجا میگه \"لها ما كسبت\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 134.92,
   "end": 139.92,
   "text": "كسب این‌ها به نفعشونه، براشونه، به دردشون می‌خوره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 139.92,
   "end": 142.18,
   "text": "و \"وعليها ما اكتسبت\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 142.18,
   "end": 145.96,
   "text": "اكتساب این‌ها به علیه اون‌هاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 145.96,
   "end": 149.16,
   "text": "چه فرقی بین كسب و اكتساب هست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 149.16,
   "end": 152.08,
   "text": "كسب میگه \"لها ما كسبت\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 152.08,
   "end": 158.72,
   "text": "این كسب که ثلاثی مجرد است و به بابی هم نرفته،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 158.72,
   "end": 161.62,
   "text": "در حقیقت حضرت علامه علیه--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 161.62,
   "end": 164.34,
   "text": "حفظه الله تعالی من سحری داشت--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 164.34,
   "end": 168.64,
   "text": "دیشب داشتم کتاب معاصر آثار رو می‌خوندم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 168.64,
   "end": 174.24,
   "text": "خیلی جالب بود برام که حالا یادم نیست در کدوم شماره کدوم لطیفه‌اش بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 174.24,
   "end": 178.46,
   "text": "حضرت علامه می‌فرمایند که این كسب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 178.46,
   "end": 184.02,
   "text": "اون چیزی‌ست که مطابق با فطرت اولیه انسان باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 184.02,
   "end": 187.1,
   "text": "فطرت انسان، فطرت الله،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 187.1,
   "end": 191.74,
   "text": "الله التي فطر الناس عليها، فطرت الهی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 191.74,
   "end": 194.7,
   "text": "اون فطرت خداجوی تو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 194.7,
   "end": 201.14,
   "text": "که سالم و دست نخورده به ودیعت به تو سپرده شده، هر عملی که مطابق با او باشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 201.14,
   "end": 210.5,
   "text": "این می‌شه كسب ما. و اگر خدایی نکرده مغایر با فطرت اولیه ما باشد می‌شود اكتساب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 210.5,
   "end": 218.1,
   "text": "اكتساب هم همون كسب وقتی میره به باب افتعال می‌شه اكتساب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 218.1,
   "end": 220.98,
   "text": "این همراه با یک كره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 220.98,
   "end": 223.7,
   "text": "یک در حقیقت کراهت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 223.7,
   "end": 229.62,
   "text": "یک سختی همراهشه. یک انفعالی همراهشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 229.62,
   "end": 232.34,
   "text": "که در حقیقت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 232.34,
   "end": 235.62,
   "text": "بر علیه انسان تموم می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 235.62,
   "end": 239.42,
   "text": "چرا؟ چون مطابق با فطرت اولیه نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 239.42,
   "end": 243.38,
   "text": "خدایی نیست، الهی نیست، دین من درآوردیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 243.38,
   "end": 250.84,
   "text": "حتی اگر قوای وجودی ماست، استعدادات وجودی ماست، ما یک قابلیتی داریم، یک استعدادی داریم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 250.84,
   "end": 253.78,
   "text": "به قولی یک منه‌ای داریم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 253.78,
   "end": 257.2,
   "text": "منه، یک قوه در وجود ماست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 257.2,
   "end": 259.4,
   "text": "که مثل غضب، مثل شهوت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 259.4,
   "end": 264.76,
   "text": "این‌ها خلقت این‌ها بد نیست که خدا به نحو احسن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 264.76,
   "end": 270.9,
   "text": "این‌ها رو در وجود ما تعبیه کرده که به موقع هم از این‌ها استفاده بشه در حد اعتدال.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 270.9,
   "end": 274.34,
   "text": "این‌ها بودنش اشکال نداره در فطرت ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 274.34,
   "end": 278.0,
   "text": "اگر ما بی-- این فطرت اولیه داره میگه آقا در-- تو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 278.0,
   "end": 282.06,
   "text": "غضب هست برای اینکه بتونی خودت رو در برابر دشمن حفظ کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 282.06,
   "end": 287.34,
   "text": "شهوت هست برای اینکه بتونی نسلت رو ادامه بدی و قوای وجودیتو تعدیل کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 287.34,
   "end": 290.02,
   "text": "اگر کسی شهوت رو بکشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 290.02,
   "end": 292.14,
   "text": "دچار مریضی‌های آنچنانی می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 292.14,
   "end": 296.4,
   "text": "اگر کسی غضبش رو از بین ببره قطعاً بهش ظلم می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 296.4,
   "end": 298.88,
   "text": "این‌ها باید به موقعش استفاده بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 298.88,
   "end": 307.26,
   "text": "اما اگر این قوا، این استعدادها، این منه‌ها، این قابلیت‌ها رها بشن، لجام گسیخته بشن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 307.26,
   "end": 312.3,
   "text": "یعنی یا انسان وجودش، اون فطرت اولیه‌اش چنان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 312.3,
   "end": 317.08,
   "text": "منحرف بشه که بره مثلاً از جهت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 317.08,
   "end": 320.0,
   "text": "غضب و این‌ها بره به سمت سبوعی‌گری،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 320.0,
   "end": 324.16,
   "text": "سبوع بشه، مثل گرگ و پلنگ بشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 324.16,
   "end": 330.5,
   "text": "که میگن وجود انسان شده مثل یک حیوان درنده‌ی سبوع که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 330.5,
   "end": 337.84,
   "text": "تمام این حیواناتی که ما می‌بینیم امام صادق صلوات الله علیه فرمود آنچه که در این حیوانات بیابانی می‌بینید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 337.84,
   "end": 341.14,
   "text": "تمثلات صور برزخی شماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 341.14,
   "end": 345.32,
   "text": "اگر شما بر اساس فطرت اولیه‌تون رفتار نکنید،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 345.32,
   "end": 351.26,
   "text": "یعنی اگر اون غضب رو، قوه غضب رو رها کنی هرجا پاچه یکی رو بگیره، این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 351.26,
   "end": 356.0,
   "text": "یعنی اون صور برزخی یعنی اون چهره‌ی برزخی ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 356.0,
   "end": 361.4,
   "text": "می‌شه شبیه گرگ و پلنگ. اینه که تو خواب می‌خوابی همش گرگ و پلنگ می‌بینی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 361.4,
   "end": 365.26,
   "text": "اگر خدایی نکرده شهوت رو رها کنی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 365.26,
   "end": 368.21,
   "text": "شهوت رو رها کنی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 368.21,
   "end": 372.07,
   "text": "د-به موقعش ازش استفاده نشه، در طریق حرام استفاده بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 372.07,
   "end": 374.97,
   "text": "این هم یه جور میزنه به انسان لثه می‌زنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 374.97,
   "end": 378.19,
   "text": "که خروس مظهر شهوته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 378.19,
   "end": 381.71,
   "text": "خروس شما صد تا مرغ بنداز کنارش، یه خروس دیگه هم بنداز.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 381.71,
   "end": 386.79,
   "text": "دو تا خروس کن تا انقدر با هم می‌جنگن تا یکیشون پیروز بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 386.79,
   "end": 388.89,
   "text": "سیر مونی نداره این عجیبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 388.89,
   "end": 391.93,
   "text": "مظهر در، در بین حیوانات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 391.93,
   "end": 394.39,
   "text": "تمثلات برزخی ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 394.39,
   "end": 397.19,
   "text": "شبیه اون میشه. اگر کسی لج--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 397.19,
   "end": 402.99,
   "text": "ول کنه یعنی این فطرت اولیش رها بشه، هرچی تو این وادی کسب کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 402.99,
   "end": 407.45,
   "text": "البته کسب اینجا دیگه غلطه بر اساس این آیه اکتساب میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 407.45,
   "end": 411.79,
   "text": "هرچی اینجا اکتساب کنه \"لها علیها مكتسبت\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 411.79,
   "end": 415.57,
   "text": "به علیهش هرچی شهوت راه می‌کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 415.57,
   "end": 419.91,
   "text": "به علیهش می‌شه چون داره بر اساس فطرت اولیش رفتار نمی‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 419.91,
   "end": 423.57,
   "text": "از حالت اعتداد، اعتدال رها کرده اون رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 423.57,
   "end": 426.13,
   "text": "حالا مثلاً بره به سمت بهیمیت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 426.13,
   "end": 431.77,
   "text": "بهائم، گاو و گوسفند اینو بخور بخور همش بخوره بخوابه بخوره بخوابه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 431.77,
   "end": 434.41,
   "text": "اینم می‌شه این سمت از این سمت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 434.41,
   "end": 437.05,
   "text": "باز بر اساس فطرت اولیش نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 437.05,
   "end": 439.65,
   "text": "اسلام نیومده بگه اینو بکش،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 439.65,
   "end": 444.31,
   "text": "اصلاً نخور، اصلاً نخواب، اصلاً شهوت نداشته باش، اصلاً غضب نکنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 444.31,
   "end": 448.99,
   "text": "کی گفته اینا رو؟ دین اومده اینا رو معتدل کرده که تو مع--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 448.99,
   "end": 451.23,
   "text": "مزاجت معتدل باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 451.23,
   "end": 458.55,
   "text": "بعد اگر این‌ها رو درست استفاده نکنی به بی‌راهه بره می‌شه \"عليها مكتسبت\" می‌شه اکتساب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 458.55,
   "end": 461.31,
   "text": "و اینجا حالا چه ربطی به بحث داشت؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 461.31,
   "end": 464.99,
   "text": "حضرت علم میان خیلی زیبا می‌فرمایند که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 464.99,
   "end": 470.79,
   "text": "بر اساس دو مرتبه آیه دوازده سوره فاطر می‌فرماید \"و ما يستوي البحران\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 470.79,
   "end": 476.71,
   "text": "چقدر زیباست این آیه. البته آیه طولانیه من ابتداش فقط می‌خونم براتون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 476.71,
   "end": 479.49,
   "text": "این دو تا دریا با هم مساوی نیستند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 479.49,
   "end": 482.39,
   "text": "کدام دو تا دریا؟ \"هذا عذب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 482.39,
   "end": 485.01,
   "text": "فرات\". \"عذب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 485.01,
   "end": 491.81,
   "text": "فرات\". ابی عبدالله در اون تمثلی که حضرت سکینه کنار گودی قتلگاه داشتند فرمود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 491.81,
   "end": 495.17,
   "text": "\"شیعتي مهما شرطت مع",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 495.17,
   "end": 499.39,
   "text": "عذب\". \"مع عذب\" با عین و ضاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 499.39,
   "end": 501.69,
   "text": "ضاد، ضاد دال. \"مع",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 501.69,
   "end": 507.65,
   "text": "عذب\". یعنی ماع گوارا آب گوارا نوشیدی یاد ما باش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 507.65,
   "end": 512.69,
   "text": "این تو آیه قرآن اومده \"و ما يستوي البحران هذا\" این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 512.69,
   "end": 514.27,
   "text": "دو تا دریا مساوی نیستند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 514.27,
   "end": 517.09,
   "text": "کدوم دو تا دریا؟ \"هذا عذب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 517.09,
   "end": 519.95,
   "text": "فرات سائق شرابه\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 519.95,
   "end": 523.63,
   "text": "یه آب گوارا، خوشگوار،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 523.63,
   "end": 527.21,
   "text": "شیرین، مطابق با طبع و مزاج تو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 527.21,
   "end": 529.37,
   "text": "و حالا \"ملح",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 529.37,
   "end": 531.91,
   "text": "أجاج\". این یکی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 531.91,
   "end": 534.13,
   "text": "آب، آب شور و تلخه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 534.13,
   "end": 536.23,
   "text": "این‌ها قطعاً با هم مساوی نیستند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 536.23,
   "end": 539.29,
   "text": "حضرت علم می‌فرماید که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 539.29,
   "end": 544.91,
   "text": "منظور از این آب شیرین و گوارا \"عذب فرات\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 544.91,
   "end": 548.55,
   "text": "در حقیقت علم شهودی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 548.55,
   "end": 551.59,
   "text": "و مراد از اون \"ملح",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 551.59,
   "end": 555.99,
   "text": "أجاج\" آب تلخ و شور و بدمزه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 555.99,
   "end": 560.09,
   "text": "علم فکری‌ایه که تو رو به شهودی نرسونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 560.09,
   "end": 563.13,
   "text": "و در حقیقت می‌شه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 563.13,
   "end": 568.21,
   "text": "این که انسان از حالت اعتدال خارج بشه به سراغ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 568.21,
   "end": 572.17,
   "text": "علومی برود که صرفاً دنیاشو تأمین کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 572.17,
   "end": 577.73,
   "text": "همونطور که قوای وجودیش رو صرفاً شهوتش، صرفاً غضبش، صرفاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 577.73,
   "end": 581.41,
   "text": "بهیمیتش، شی-- صرفاً شیطنتش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 581.41,
   "end": 587.85,
   "text": "اگر کسی شیطنت کنه همش حیله‌گری شیطنت زیر پای اونو خالی کنه، آبروی اونو ببره، برای اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 587.85,
   "end": 591.11,
   "text": "پرونده درست کنه. این هم حیله‌گریه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 591.11,
   "end": 593.45,
   "text": "می‌شه مثل چی؟ روباه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 593.45,
   "end": 597.35,
   "text": "تمثل برزخی‌ش شبیه روباحه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 597.35,
   "end": 601.43,
   "text": "اما نه، اگر کسی این قوا رو تو وجودش تعدیل کرد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 601.43,
   "end": 604.53,
   "text": "از طریق علم فکری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 604.53,
   "end": 606.77,
   "text": "رفت به سمت علم شهودی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 606.77,
   "end": 611.33,
   "text": "جایگاه خودش رو در نظام هستی به عنوان اشرف مخلوقات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 611.33,
   "end": 613.53,
   "text": "قشنگ دید و تشخیص داد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 613.53,
   "end": 615.67,
   "text": "و از این علم فکری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 615.67,
   "end": 621.35,
   "text": "در مسیر سعادت ابدیش استفاده کرد، اون موقع می‌شه علم شهودی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 621.35,
   "end": 626.69,
   "text": "یعنی شاهد می‌شه بر این عظمت نظام هستی که این‌ها بیهوده آفریده نشدند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 626.69,
   "end": 629.73,
   "text": "اون موقع میره به سمت ملکیت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 629.73,
   "end": 634.43,
   "text": "از صبوعیت، بهیمیت و شیطنت خارج می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 634.43,
   "end": 637.73,
   "text": "میره به سمت چی؟ ملکیت وجودش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 637.73,
   "end": 640.39,
   "text": "اون فرشته گونه بودنش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 640.39,
   "end": 643.01,
   "text": "اون موقع میره به سمت اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 643.01,
   "end": 645.05,
   "text": "آب \"عذب فرات\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 645.05,
   "end": 648.49,
   "text": "اون موقع \"ومن الماء كل شيء حي\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 648.49,
   "end": 652.15,
   "text": "از آب همه چی زنده است. خدا زنده اش می‌کند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 652.15,
   "end": 655.63,
   "text": "اون آب فرات، \"عذب فرات\"، ما--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 655.63,
   "end": 657.65,
   "text": "آب شیرین و گوارا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 657.65,
   "end": 659.81,
   "text": "اون شربت ولایت است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 659.81,
   "end": 663.15,
   "text": "خدا اون موقع ولایت رو به وجودش می‌چشونه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 663.15,
   "end": 666.99,
   "text": "که در تعبیر این \"من الماء كل شيء\" فرمودن این ما،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 666.99,
   "end": 670.97,
   "text": "منظور ولایت ما اهل بیتی که همه چی به اون حیات داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 670.97,
   "end": 676.63,
   "text": "اون موقع اگر به سمت ملکیت وجودش رفت، به سمت فرشته گونه بودن خودش رفت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 676.63,
   "end": 682.11,
   "text": "قوای وجودش رو تعدیل کرد و از علم فکری رفت به سمت علم شهودی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 682.11,
   "end": 684.21,
   "text": "نمازش شد شهود،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 684.21,
   "end": 689.83,
   "text": "روزه‌ش شد شهود، ذکرش داره تسبیح دستش صحبت می‌کنه با یکی دیگه هم داره حرف می‌زنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 689.83,
   "end": 692.21,
   "text": "هی دو تا ذکر می‌گه با اون هم حرف. تو چی فهمیدی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 692.21,
   "end": 698.59,
   "text": "گفتی این شهود نیست که. اگر فکرش شد شهود، علم فکری بدل به شهود شد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 698.59,
   "end": 701.05,
   "text": "عین این که اون آب تلخ شده آب گوارا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 701.05,
   "end": 703.49,
   "text": "اون موقع وارد محیط ولایت می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 703.49,
   "end": 705.89,
   "text": "تازه اینجا کارش آغاز می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 705.89,
   "end": 709.27,
   "text": "که خلاصه کلام خسته تون نکنم، اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 709.27,
   "end": 712.23,
   "text": "\"وقالوا قلوبنا غلف\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 712.23,
   "end": 714.97,
   "text": "گیر کردن تو چی؟ توی اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 714.97,
   "end": 718.61,
   "text": "علم فکری‌شون. توی اون \"ملح أجاج\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 718.61,
   "end": 721.05,
   "text": "آب تلخ و شور",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 721.05,
   "end": 723.45,
   "text": "گمان می‌کنند آب گوارا دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 723.45,
   "end": 727.41,
   "text": "و به جهت این هستش که حالا تحلیلی که ما ارائه دادیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 727.41,
   "end": 735.49,
   "text": "اون قوای وجودیشون، استعداداتشون، قابلیت‌هاشون، اون منه‌ها رو در مسیر فطرت اولیشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 735.49,
   "end": 739.31,
   "text": "استفاده نکردند ازش. این مهم بود که بدونیم امروز.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 739.31,
   "end": 742.65,
   "text": "یعنی فطرت-- بعد می‌زنن فطرتو داغون می‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 742.65,
   "end": 746.73,
   "text": "یک فطرت ثانویه‌ای برای خودشون درست می‌کنند شبیه حیوانات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 746.73,
   "end": 748.65,
   "text": "با همون هم متمثل می‌شن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 748.65,
   "end": 751.41,
   "text": "یعنی بدن برزخی‌شون شبیه حیوانات می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 751.41,
   "end": 758.01,
   "text": "اما اگر نه کسی درست رفتار کرد بر اساس فطرت اولیه رفت جلو اون موقع تمثلاتش روحانی می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 758.01,
   "end": 761.93,
   "text": "تمثلاتش ملکی می‌شه، فرشته گونه می‌شه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 761.93,
   "end": 766.05,
   "text": "خواب‌هاش فرق می‌کنه. و وقتی هم که از دنیا رفت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 766.05,
   "end": 771.93,
   "text": "آنچه که در نفس ناطقه‌ش إنشاء می‌شود و می‌بیند مثل این که تو می‌خوابی در نفس ناطقه خودت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 771.93,
   "end": 778.25,
   "text": "آنچه می‌بینی در جان خودت إنشاء می‌شه همه این‌ها رنگ و بوی خدا داره و الوهیت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 778.25,
   "end": 784.89,
   "text": "نه حیوانات. ان‌شاءالله که عاقبتمون ختم به خیر بشه به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 784.89,
   "end": 787.05,
   "text": "اللهم صل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 787.05,
   "end": 793.77,
   "text": "على محمد و آل محمد. عزیزheartheart",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}