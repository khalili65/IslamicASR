 "chapters": [
  {
   "index": 0,
   "title": "## قلب اغلف و نشانهٔ علم فکری",
   "start": 10.46,
   "end": 34.96
  },
  {
   "index": 1,
   "title": "چنان‌که پیش‌تر گفته شد، انتهای آیه خداوند دربارهٔ جمعیتی که بعدها لعنتشان می‌کند می‌فرماید:",
   "start": 34.96,
   "end": 129.22
  },
  {
   "index": 2,
   "title": "## جمع علم فکری و شهودی",
   "start": 129.22,
   "end": 162.4
  },
  {
   "index": 3,
   "title": "## وحدت برهان و عرفان",
   "start": 162.4,
   "end": 410.19
  },
  {
   "index": 4,
   "title": "## خطرات علم فکری",
   "start": 410.19,
   "end": 458.69
  },
  {
   "index": 5,
   "title": "## خطر افشای سر در شهود",
   "start": 458.69,
   "end": 633.07
  },
  {
   "index": 6,
   "title": "## جابر بن یزید جعفی و سرّ چاه",
   "start": 633.07,
   "end": 787.85
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.24,
   "end": 5.9,
   "text": "السلام علیک ای داعی الله و ربانی ایاته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 5.9,
   "end": 10.02,
   "text": "سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 10.02,
   "end": 15.34,
   "text": "ما رسیده بودیم به آیه هشتاد و هشت سوره بقره پیرامون قلب اغلف.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 15.34,
   "end": 20.5,
   "text": "عرض کردیم که اگر دقت کنید ابتدای آیه که با و قلوبنا--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 20.5,
   "end": 24.66,
   "text": "قالو و قالو قلوبنا غلف شروع میشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 24.66,
   "end": 27.38,
   "text": "چون قالو داره اینا گفتند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 27.38,
   "end": 36.12,
   "text": "قلب ما اغلفه است. در حقیقت این رو اشاره کردیم به بحث کلام و گفت‌گوی علمی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 36.12,
   "end": 43.76,
   "text": "چون اینا مدعی بودند قلب ما غلاف مثل شمشیر در غلاف که پره، پره از این معارف.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 43.76,
   "end": 49.74,
   "text": "منتها چون میگه و قالو گفتند این نشانه از-- حکایت از علم فکری دارد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 49.74,
   "end": 53.06,
   "text": "علم فکری حالا بعضیا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 53.06,
   "end": 56.84,
   "text": "در منطق گفتن علم حصولی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 56.84,
   "end": 59.96,
   "text": "علم حصولی و حضوری رو در منطق گفتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 59.96,
   "end": 65.72,
   "text": "حالا عرض شود در عرفان میگن علم فکری و علم شهودی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 65.72,
   "end": 68.46,
   "text": "البته مرحوم اه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 68.46,
   "end": 71.84,
   "text": "سید حیدر آملی در اسرار جوا--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 71.84,
   "end": 77.4,
   "text": "جامع الاسرارش، ایشون میفرماید که علم رسمی، علم فکری رو میگه علم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 77.4,
   "end": 82.62,
   "text": "رسمی و اون علم شهودی رو میگه علم وهبی که خدا عطا میکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 82.62,
   "end": 87.3,
   "text": "حالا در هر حال این‌ها گرفتار علم فکری بودند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 87.3,
   "end": 95.02,
   "text": "و اگر دقت کرده باشید همونطور که دیروز عرض کردیم انتهای آیه و چون خدا میفرماید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 95.02,
   "end": 99.56,
   "text": "از این جمعیتی که این حالا بعداً خدا لعنتشون میکنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 99.56,
   "end": 106.16,
   "text": "قلیلا مما يؤمنون، فَقَلِيلًا مِمَّا يُؤْمِنُونَ یا ما يؤمنون ببخشید فَقَلِيلًا ما يؤمنون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 106.16,
   "end": 108.94,
   "text": "یه عده قلیلیشون ایمان میارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 108.94,
   "end": 112.8,
   "text": "اینا از اون دور بودن از رحمت خدا نجات پیدا می‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 112.8,
   "end": 116.28,
   "text": "منتها چون اشاره میکنه به يؤمنون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 116.28,
   "end": 118.6,
   "text": "عرض کردیم این ایمان ربط به قلب داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 118.6,
   "end": 124.26,
   "text": "جایگاه ایمان، دلدادگی به قلبه و این همون ارتباط شهودی به عالمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 124.26,
   "end": 127.4,
   "text": "یعنی این‌ها به شهود رسیدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 127.4,
   "end": 131.88,
   "text": "البته اینجا باید این رو توجه داشت چون بحث ما دیروز پیرامون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 131.88,
   "end": 135.08,
   "text": "اختلاف بین علم فکری و شهودی بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 135.08,
   "end": 137.3,
   "text": "این یه وقت نتیجه‌ش این نشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 137.3,
   "end": 140.7,
   "text": "این رو برای تکمله بحث دیروز عرض کردم لذا مقدمه شدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 140.7,
   "end": 144.28,
   "text": "نتیجه‌ش این نشه که پس علم فکری رو رها کنیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 144.28,
   "end": 148.96,
   "text": "دنبال درس و بحث و کلاس و معلم و ک-کتاب و اینها نریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 148.96,
   "end": 154.32,
   "text": "بریم سراغ ذوق و صرفاً عرفان و کشف و شهود و نه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 154.32,
   "end": 157.22,
   "text": "باید از علم فکری رسید به علم شهودی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 157.22,
   "end": 163.48,
   "text": "دو تاشو باید با هم داشت. اون اهل بیت علیهم الصلاة و السلام بودند که صرفاً علم شهودی داشتند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 163.48,
   "end": 165.74,
   "text": "اساساً علم فکری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 165.74,
   "end": 168.0,
   "text": "پیاده کردنش در اهل بیت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 168.0,
   "end": 170.44,
   "text": "آورد-- تنزل دادن به مقام اوناست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 170.44,
   "end": 173.24,
   "text": "اهل بیت اصلاً کاری به علم فکری نداشتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 173.24,
   "end": 178.54,
   "text": "اون‌ها یکپارچه تمام علم حضرت حق در وجود اون‌ها پیاده شده بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 178.54,
   "end": 182.94,
   "text": "اون‌ها علم محض نظام هستی‌اند که قبلاً بحثش گذشته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 182.94,
   "end": 185.86,
   "text": "اما ما که ضعیف هستیم چاره‌ای نداریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 185.86,
   "end": 188.22,
   "text": "باید از علم فکری که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 188.22,
   "end": 192.16,
   "text": "در حقیقت به قول مرحوم حاجی سبزواری علیه رحمة",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 192.16,
   "end": 195.26,
   "text": "این إعداده من الفکر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 195.26,
   "end": 197.72,
   "text": "در حقیقت علت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 197.72,
   "end": 201.44,
   "text": "معده‌ست. آماده‌سازی میکنه ما رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 201.44,
   "end": 206.52,
   "text": "برای اینکه برسیم به علم حالا اشراقی میخوای بگی، میخوای بگی شهودی هرچی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 206.52,
   "end": 210.1,
   "text": "یا حضوری به قول منطقیین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 210.1,
   "end": 217.12,
   "text": "باید دو تاشو با هم داشت. الان یه بحثی هم که تو متاسفانه جوامع علمی و دانشگاه‌ها اینها هست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 217.12,
   "end": 223.26,
   "text": "وقتی درست متوجه این قصه نشدند میان یه دعوایی بین امثال شیخ الرئیس‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 223.26,
   "end": 225.46,
   "text": "و شیخ اشراق‌ها راه میندازن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 225.46,
   "end": 231.44,
   "text": "مثلاً میگن شیخ الرئیس که میدونید شیخ الرئیس دیگه حکمت مشاء به ایشون بسته‌ست و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 231.44,
   "end": 234.5,
   "text": "پایه گذار و به هر حال بهترین کتاب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 234.5,
   "end": 240.48,
   "text": "یعنی به قول علامه، پدر جد کتاب منطق رو ایشون بر اساس منطق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 240.48,
   "end": 243.02,
   "text": "ارسطو پایه‌ریزی کرد. منطق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 243.02,
   "end": 245.52,
   "text": "منطق یعنی همون علم فکری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 245.52,
   "end": 253.08,
   "text": "لکن همین حالا شیخ الرئیس رو شما میری کتاب اشاره‌شو نگاه می‌کنی اشاراتشو البته اشارات و تنبیهاته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 253.08,
   "end": 257.96,
   "text": "اشاره حرفای بسیار سنگینی که خودش میگه ما یه اشاره می‌کنیم رد میشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 257.96,
   "end": 261.28,
   "text": "نمیشه فهمید انقدر عمیقه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 261.28,
   "end": 265.46,
   "text": "اسمشو گذاشته اشارات. اما کتاب تنبیهات هم داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 265.46,
   "end": 269.78,
   "text": "تنبیه یعنی چیزی که آقا تو هم یه ذره فکر کنی بهش میرسی، متنبه میشی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 269.78,
   "end": 271.54,
   "text": "اونا هم البته سنگینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 271.54,
   "end": 279.42,
   "text": "شما همین کتاب اشارات شیخ الرئیس رو ببین از نمت هفتم، هشتم، نهم، دهمش دیگه همش بحثای سنگین عرفانیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 279.42,
   "end": 283.78,
   "text": "خب کوشن اونایی که بحث دارند میگن شیخ الرئیس صرفاً علم فکرایی--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 283.78,
   "end": 287.12,
   "text": "فکری داشته، علم حصولی داشته،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 287.12,
   "end": 291.18,
   "text": "عرض شود برهان و اصلاً از عرفان فاصله داشته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 291.18,
   "end": 298.84,
   "text": "کی گفته اینو؟ خب شما برو همون-- جواب بده ببینم چرا نمت هفتم به بعد اشاراتش همش مسائل سنگین عرفانیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 298.84,
   "end": 300.86,
   "text": "که واقعاً هر کسی درکش نمی‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 300.86,
   "end": 303.2,
   "text": "اون عرفانه دیگه. نه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 303.2,
   "end": 305.94,
   "text": "علم فکری مقدمه علم شهودیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 305.94,
   "end": 310.48,
   "text": "منتها این‌ها و قالو قلوبنا غلف میگن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 310.48,
   "end": 312.7,
   "text": "دل ما پره از این حرف‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 312.7,
   "end": 317.9,
   "text": "قالو گفتن بحث گفت‌گوی اینا اشارات قرآن هم روش حرف داریم دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 317.9,
   "end": 321.12,
   "text": "اینا میخواست خدا بگه که اینا موندن در علم فکریشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 321.12,
   "end": 325.46,
   "text": "این، این خطره که کسی صرفاً تو علم فکری بمونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 325.46,
   "end": 329.66,
   "text": "و الا دعوایی بین شیخ الرئیس و شیخ اشراق نیست که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 329.66,
   "end": 337.64,
   "text": "و اتفاقاً شیخ اشراق هم که در حقیقت دنباله رو حضرت افلاطون بوده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 337.64,
   "end": 341.64,
   "text": "که ارسطو و افلاطون ما میگیم حضرت چون حدیث داریم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 341.64,
   "end": 347.42,
   "text": "حضرت علامه هم در کتابش آورده که این دو تا پیغمبر بودند، ارسطو و افلاطون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 347.42,
   "end": 349.72,
   "text": "یه روایت داریم از امام صادق صلوات الله علیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 349.72,
   "end": 355.96,
   "text": "افلاطون خب پایه‌گذار همین بحث اشراقیون بود که شیخ اشراق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 355.96,
   "end": 358.34,
   "text": "این کتاب رو بر اساس اون تنظیم کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 358.34,
   "end": 362.62,
   "text": "اما اون هم وقتی شما کتاب شیخ اشراق رو میری میبینی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 362.62,
   "end": 369.33,
   "text": "وقتی حکمت اشراقیه ایشون رو میری مطالع-- ملاحظه می‌کنی، میبینی همش بر اساس برهان شروع شده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 369.33,
   "end": 373.07,
   "text": "از همون ابتدا کتاب بر اساس برهانه، فکره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 373.07,
   "end": 374.85,
   "text": "یعنی این دو از هم جدا نیستن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 374.85,
   "end": 377.71,
   "text": "نه باید درس و بحث تعطیل بشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 377.71,
   "end": 382.53,
   "text": "نه صرفاً تو درس و بحث موند و سراغ مسائل ذوقی و عرفانی نرفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 382.53,
   "end": 388.37,
   "text": "و من توصیه می‌کنم بارها اینجا عرض کردم کتاب عرفان و برهان و قرآن علامه رو بخونید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 388.37,
   "end": 394.47,
   "text": "که ایشون اون تو، تو اون کتاب شریف و وزین و ارشی به نظر من اثبات می‌کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 394.47,
   "end": 399.45,
   "text": "که برهان و عرفان ما یک حقیقتن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 399.45,
   "end": 403.05,
   "text": "و برهان و برهان همون فلسفه است یا حکمت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 403.05,
   "end": 405.19,
   "text": "و عرفان ما همون قرآن مان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 405.19,
   "end": 408.29,
   "text": "اینو اثبات می‌کنه. اصلاً جدایی از هم ندارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 408.29,
   "end": 413.55,
   "text": "منتها ما متوجه نیستیم. خطرات علم فکری اینه که اینجا داره قرآن گوش زد می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 413.55,
   "end": 418.23,
   "text": "اینا مورد لعن خدا واقع شدن اکثرشون چون دچار علم فکری شدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 418.23,
   "end": 421.33,
   "text": "گفتن ما داریم دیگه می‌خوایم چه کنیم پیغمبر؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 421.33,
   "end": 426.73,
   "text": "ها قلوبنا قلف. قلب اغلف یعنی مثل شمشیری که در غلافه پره، پره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 426.73,
   "end": 431.19,
   "text": "میگه ما نمیخوایم گوش ما دیگه این چیزا رو انقدر شنیده که اما این علم فکریه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 431.19,
   "end": 435.67,
   "text": "بیا ببین چه اشراقاتی پیغمبر بر قلب شما داره، چه القاءاتی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 435.67,
   "end": 438.99,
   "text": "چه القاءات سبوهی از حضرت حق برات هدیه آورده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 438.99,
   "end": 441.13,
   "text": "برو بشین پای اون‌ها که نرفتن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 441.13,
   "end": 445.39,
   "text": "این ضرر رو کردن. علم فکری این مشک-- این مشکلات رو داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 445.39,
   "end": 451.71,
   "text": "تکبر، غرور. اما علم شهودی اینطوری نیست چون ش-- به شهود می‌شینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 451.71,
   "end": 453.73,
   "text": "خاص در حقیقت حصولی نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 453.73,
   "end": 457.07,
   "text": "حضوره. همش یکپارچه حضور محضه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 457.07,
   "end": 458.69,
   "text": "این دیگه مشکلی براش پیش نمیاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 458.69,
   "end": 461.01,
   "text": "فقط یه خطر داره علم شهودی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 461.01,
   "end": 463.19,
   "text": "عرفان، ذوق. یه خطر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 463.19,
   "end": 466.05,
   "text": "خیلی خطر، خطر عظیمی هم هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 466.05,
   "end": 469.89,
   "text": "فی خطر عظیم. اونم افشاء سره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 469.89,
   "end": 472.83,
   "text": "چون شهود سر عالم دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 472.83,
   "end": 475.31,
   "text": "به کسی میدن که ظرفیتشو داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 475.31,
   "end": 479.15,
   "text": "سعه وجودیشو داره. لا یمسه إلا المتهرون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 479.15,
   "end": 482.55,
   "text": "یه طهارتهایی تو وجودش هست به شهود مینشوننش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 482.55,
   "end": 485.11,
   "text": "یه حقایقی براش تو--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 485.11,
   "end": 487.43,
   "text": "در وجود خودش کشف میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 487.43,
   "end": 490.77,
   "text": "بعد اینو بیاد طوطی صفتی کنه یه دفعه افشا کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 490.77,
   "end": 493.83,
   "text": "این مشکل میشه. این خطر افشاء سر اینجا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 493.83,
   "end": 497.97,
   "text": "معمولا تو قدم‌های اول جوون‌ها هم چون پاکن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 497.97,
   "end": 502.25,
   "text": "زود به قولی گر می‌گیرن، آتش می‌گیرن و یه اشراقاتی براشون ایجاد میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 502.25,
   "end": 505.03,
   "text": "یه شهودهایی حالا یا تو خواب یا تو بیداری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 505.03,
   "end": 508.79,
   "text": "بعد سریع میگن ظرف کمه، ظرف کوچیکه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 508.79,
   "end": 510.91,
   "text": "سریع لبریز میشه، میگن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 510.91,
   "end": 513.33,
   "text": "این البته فرق می‌کنه با گفتن بزرگان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 513.33,
   "end": 520.09,
   "text": "باز خلط بحث نشه. امثال مثل حضرت علامه حسن زاده که در کتاب انسان در عرف عرفانش میاد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 520.09,
   "end": 525.65,
   "text": "چندین واقعه از اتفاقات اشراقی و معرفتی و کشف و شهودیشو بیان می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 525.65,
   "end": 530.81,
   "text": "خودش میگه آقا بر اساس واما بنعمت ربک فحدث میگیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 530.81,
   "end": 535.83,
   "text": "قرآن تو گف-- می‌فرماید اگه به تو نعمت داد خدا فحدث حدیث کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 535.83,
   "end": 537.87,
   "text": "در همین حد فقط",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 537.87,
   "end": 540.45,
   "text": "که بدانید آقا راه بازه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 540.45,
   "end": 545.29,
   "text": "بسم الله شما هم امیدوار بشید بگید بسم الله ما هم پس بریم برسیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 545.29,
   "end": 550.25,
   "text": "در همین حد که گول نخورید فکر کنید فقط علم فکریه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 550.25,
   "end": 554.11,
   "text": "علم شهودی تا إلا ماشاءالله تعالى، تعالى بیا بالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 554.11,
   "end": 560.29,
   "text": "در همین حد که من و تو امیدوار بشیم یه چیزکی گفتن از اون سرریز کاسه‌شون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 560.29,
   "end": 562.67,
   "text": "و الا این بیا خلط بحث نشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 562.67,
   "end": 566.61,
   "text": "فرق می‌کنه با منی که یه شب یه دفعه یه خواب امامزاده‌ای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 566.61,
   "end": 568.55,
   "text": "چه می‌دونم یه حقیقتی، یه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 568.55,
   "end": 574.97,
   "text": "نورانیتی، یه چیزی توی خواب یا شهید سلیمانی یه چیزی تو خوابی ببینم و بعد بیام یه دفعه همه جا بق و کرنا کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 574.97,
   "end": 577.81,
   "text": "خب چطور به قول حضرت آیت الله صانعی آملی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 577.81,
   "end": 579.95,
   "text": "شش ماه داشتی خاک خواب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 579.95,
   "end": 582.27,
   "text": "خوک و نمی‌دونم الاغ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 582.27,
   "end": 585.65,
   "text": "و گاو و عقرب و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 585.65,
   "end": 589.09,
   "text": "خبائث رو تو خواب می‌دیدی شش ماه هیچی نمی‌گفتی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 589.09,
   "end": 590.85,
   "text": "الان تو خواب یه امامزاده دیدی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 590.85,
   "end": 594.37,
   "text": "گفت من دیشب خواب امامزاده دیدم. گفت شش ماه تو چرا نمی‌گی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 594.37,
   "end": 596.93,
   "text": "اینا این خطر شهود اینه فقط.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 596.93,
   "end": 598.79,
   "text": "افشاء سر بعد می‌گیرن از آدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 598.79,
   "end": 601.49,
   "text": "دیگه بعد انقدرم ناز داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 601.49,
   "end": 604.49,
   "text": "انقدر کشف و شهود، عرفان، ناز داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 604.49,
   "end": 609.01,
   "text": "انقدر نازنینه. حالا حالا بشین تا دوباره برگرده برات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 609.01,
   "end": 610.93,
   "text": "فقط با یک افشاء سر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 610.93,
   "end": 613.91,
   "text": "مگر جاش رو اونم اهلش باید تشخیص بدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 613.91,
   "end": 618.29,
   "text": "پس اینو فقط به عنوان تکمله بحث دیروز عرض کردم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 618.29,
   "end": 620.61,
   "text": "که خلط بحث نشه. اینا رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 620.61,
   "end": 622.53,
   "text": "در تقابل به هم ببینیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 622.53,
   "end": 624.77,
   "text": "نه. منتها اون‌ها که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 624.77,
   "end": 628.27,
   "text": "و قالوا قلوبنا گفتن قلوبنا قلف،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 628.27,
   "end": 631.81,
   "text": "اونا متوقف شدن تو علم فکری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 631.81,
   "end": 634.85,
   "text": "و الا سلام علیکم. خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 634.85,
   "end": 641.85,
   "text": "حفظ کنه شاگر-- رحمت کنه شاگردان اهل بیت که کارایی کردن این سر و سر را به ما برسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 641.85,
   "end": 644.93,
   "text": "مثلا جابر بن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 644.93,
   "end": 652.45,
   "text": "یزید جعفی. الان به ذهنم اومد این روایت عجیب که یادمه در اصول کافی مرحوم کلینی اعلا الله مقامه الشریف دیدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 652.45,
   "end": 655.43,
   "text": "اینم بگم و چاشنی بحث و بحثه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 655.43,
   "end": 660.75,
   "text": "ایشون هفت تا-- الان چند تا حدیث من و تو دیدیم اصلاً نمیگم حفظیم، دیدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 660.75,
   "end": 663.95,
   "text": "چند تا انصافاً؟ می‌تونی بشمری چند تا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 663.95,
   "end": 667.65,
   "text": "مثلاً کافیه اولین کتاب اصول ارب--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 667.65,
   "end": 674.37,
   "text": "کتو-- كتب اربع شیعه رو اگر ما از اول تا آخرشو خونده باشیم حدود شونزده هزار تا حدیث رو دیدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 674.37,
   "end": 681.09,
   "text": "بحار الانوار فکر می‌کنم قریبه به هفتاد هزار تا حدیث توش جمع شده باشه تو همشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 681.09,
   "end": 683.91,
   "text": "فقط جابر بن یزید جعفی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 683.91,
   "end": 689.73,
   "text": "ایشون از امام باقر فقط، تازه محضر امام صادق هم در کرده، فقط از امام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 689.73,
   "end": 693.39,
   "text": "باقر هفتاد هزار سر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 693.39,
   "end": 696.21,
   "text": "یاد گرفته بود. الله اکبر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 696.21,
   "end": 701.03,
   "text": "هفتاد هزار سر در سر و سرش امام باقر نفس از نشون--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 701.03,
   "end": 704.13,
   "text": "بعد اومد گفت آقا سینه ام سنگین شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 704.13,
   "end": 707.15,
   "text": "اجازه بده با یه نفر برم یه دونه از اینا رو بگم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 707.15,
   "end": 711.83,
   "text": "حضرت فرمود مطلقا. هر وقت دیدی سنگین شدی برو یه چاهی بکن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 711.83,
   "end": 715.29,
   "text": "اینم سریا ها. چرا باید اصلاً چاه بکنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 715.29,
   "end": 718.33,
   "text": "چرا رو زمین نشینه بگه؟ چاه بکن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 718.33,
   "end": 720.65,
   "text": "اینم سریا. با",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 720.65,
   "end": 723.49,
   "text": "چاه حرفاتو بزن خالی شو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 723.49,
   "end": 725.07,
   "text": "که امیرالمؤمنین تو چاه می‌زد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 725.07,
   "end": 732.61,
   "text": "ابو تراب، پدر خاک. بله نفس علی باید به این چاه مخصوصاً هم چاه بکنه چون ریشه درخت‌ها میره اون تو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 732.61,
   "end": 737.11,
   "text": "نطفه آدمای بعدی هم از همین آب و درخت و گل و گیاه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 737.11,
   "end": 740.21,
   "text": "و میوه درخت و از همینا نطفه و رستن داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 740.21,
   "end": 742.61,
   "text": "سردار سلیمانی هم نطفه‌ش از همین خاکه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 742.61,
   "end": 744.65,
   "text": "نطفه من و تو هم از همین خاکه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 744.65,
   "end": 747.63,
   "text": "نفس امیرالمؤمنین باید چاه بکنه بره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 747.63,
   "end": 749.41,
   "text": "جایی که ریشه درخت دوانده میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 749.41,
   "end": 756.05,
   "text": "این بخوره به خاک که از دل این خاک امثال حججی‌ها و سردار سلیمانی‌ها بیان بیرون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 756.05,
   "end": 761.85,
   "text": "جابر بن یزید جعفی تو هم چاه بکن نفس بزن این اسرار بره تو دل خاک.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 761.85,
   "end": 766.31,
   "text": "نطفه‌هایی که بعدها از این خاک میخوان رستن کنن بیان بیرون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 766.31,
   "end": 768.27,
   "text": "اون‌ها صاحبان این سر باشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 768.27,
   "end": 770.73,
   "text": "اینم یه سر ما. حالا جزء--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 770.73,
   "end": 773.47,
   "text": "حالا میگم سر نگی پس خودت چرا سر رو فاش کردی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 773.47,
   "end": 776.63,
   "text": "نه بزرگان فاش کردن ما داریم به شما منتقل می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 776.63,
   "end": 780.65,
   "text": "اونم بر اساس چی؟ فأما بنعمت ربك",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 780.65,
   "end": 782.25,
   "text": "فحدث. والسلام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 782.25,
   "end": 784.93,
   "text": "ان‌شاءالله که عاقبتمون ختم بخیر باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 784.93,
   "end": 787.85,
   "text": "به برکت صلوات بر محمد و آل محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}