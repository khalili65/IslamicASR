 ],
 "cues": [
  {
   "i": 0,
   "start": 0.26,
   "end": 3.96,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 3.96,
   "end": 7.98,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 7.98,
   "end": 13.28,
   "text": "آیات. سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 13.28,
   "end": 17.4,
   "text": "روز میلاد خانم حضرت رقیه سلام الله علیها به روایت است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 17.4,
   "end": 23.88,
   "text": "نثار بی بی دو عالم حضرت رقیه بنت الحسین زهرای کربلا صلواتی هدیه کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 23.88,
   "end": 29.64,
   "text": "الله. اللهumma صل علی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 29.64,
   "end": 31.3,
   "text": "محمد و آل محمد. هدیه می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 31.3,
   "end": 35.24,
   "text": "نکته‌ای که امروز می‌خوایم القا کنیم به جان شما و به این بی بی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 35.24,
   "end": 37.5,
   "text": "که گردن ما حق حیاس دارد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 37.5,
   "end": 42.58,
   "text": "ان‌شاءالله که بی بی بپذیره و برای هممون کربلا امضا کنه امروز.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 42.58,
   "end": 46.3,
   "text": "نکته‌ای که می‌خوام عارض کن-- عارض داشته باشم خدمت شما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 46.3,
   "end": 49.0,
   "text": "و عارض باشم و و آنچه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 49.0,
   "end": 53.64,
   "text": "از آثار حضرت علامه در این بحث متوجه شدم رو ام پی تیری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 53.64,
   "end": 57.34,
   "text": "تو حدود ده دقیقه برای شما عرض کنم خیلی به دردتون می‌خوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 57.34,
   "end": 59.72,
   "text": "خوب این رو توجه بکنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 59.72,
   "end": 61.98,
   "text": "خیلی خیلی خیلی به درد می‌خوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 61.98,
   "end": 65.18,
   "text": "خیلی گره‌ها رو ان‌شاءالله تو ذهنتون باز می‌کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 65.18,
   "end": 71.3,
   "text": "و کمکتون می‌کنه درون مایه آیات و روایات و احادیث رو خوب بفهمید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 71.3,
   "end": 73.14,
   "text": "سؤال، با یک سؤال مطرح کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 73.14,
   "end": 76.38,
   "text": "ما بحثمون پیرامون قلب اغلف بود و رسیدیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 76.38,
   "end": 79.7,
   "text": "به آیه صد و پنجاه و پنج سوره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 79.7,
   "end": 83.12,
   "text": "نساء که و قولهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 83.12,
   "end": 85.66,
   "text": "قلوبنا قلف. این‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 85.66,
   "end": 91.86,
   "text": "حرفشون اینه که ما این چیزایی که پیغمبر تو در قالب قرآن آوردی رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 91.86,
   "end": 94.54,
   "text": "ما دلمون پره، داریم این‌ها رو تو وجودمون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 94.54,
   "end": 105.0,
   "text": "خب ما دو جلسه پیش عرض کردیم بر اساس اون روایت شریف که قرآن مئدبت الله هست با ضم دال یعنی سفره طعام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 105.0,
   "end": 106.72,
   "text": "سفره طعامه دیگه. غذاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 106.72,
   "end": 108.6,
   "text": "هر کی بخوره چاق و چله می‌شه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 108.6,
   "end": 113.0,
   "text": "درسته؟ غذاست. غذا رو هر کی، غذا هرچی هم خالص‌تره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 113.0,
   "end": 114.92,
   "text": "که دیگه خالص‌تر از غذای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 114.92,
   "end": 119.72,
   "text": "قرآن که ما نداریم. چطور بعضیا می‌خورن چاق و چله می‌شن و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 119.72,
   "end": 124.24,
   "text": "لپ معنوی‌شون گل می‌ندازه و بعضیا لاغر مردنی و بدتر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 124.24,
   "end": 126.34,
   "text": "مریض می‌شن تا جایی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 126.34,
   "end": 128.62,
   "text": "آیه، این سؤال خیلی جدیه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 128.62,
   "end": 134.36,
   "text": "آیه هشتاد و دو سوره اسرا می‌فرماید که \"و نزل من القرآن ماء و شفاء",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 134.36,
   "end": 137.22,
   "text": "و رحمة للمؤمنین\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 137.22,
   "end": 139.72,
   "text": "اونچه که ما نازل کردیم از قرآن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 139.72,
   "end": 142.72,
   "text": "هم شفاس هم رحمت. البته برای اهل ایمان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 142.72,
   "end": 146.78,
   "text": "اما \"ولا يزيد الظالمين الا خسارا\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 146.78,
   "end": 149.18,
   "text": "برای اهل ظلم خسارته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 149.18,
   "end": 151.34,
   "text": "همین قرآن، همین طعام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 151.34,
   "end": 154.7,
   "text": "چرا این‌ها رو حالشون رو خوب می‌کنه، اون‌ها رو بد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 154.7,
   "end": 156.36,
   "text": "چرا اینا رو به خسران می‌کشونه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 156.36,
   "end": 160.08,
   "text": "دیروز ما \"ان الانسان لفی خسر\" رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 160.08,
   "end": 163.76,
   "text": "درسته در سوره عصر بحث کردیم از نظر خواجه نصیر طوسی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 163.76,
   "end": 169.72,
   "text": "اگر کسی خواست بره تو کانال معراج الغمامی بحث دیروز رو حتما گوش بده خیلی به دردتون می‌خوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 169.72,
   "end": 172.74,
   "text": "\"ان الانسان لفی خسر الا فلان\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 172.74,
   "end": 175.86,
   "text": "حالا اونا رو گفتیم یعنی چی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 175.86,
   "end": 181.58,
   "text": "حالا اینجا هم میگه که قطعاً همین قرآن، همین مئدبت الله خسارت می‌شه برای عده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 181.58,
   "end": 186.92,
   "text": "برای اهل ق-- اون‌هایی که قلب اغلف دارن یا قلوب قلف دارن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 186.92,
   "end": 189.56,
   "text": "به قول خودشون اصلاً میگن قرآن رو ما داشتیم دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 189.56,
   "end": 194.26,
   "text": "قرآن هم که در ادامه کتب انبیاست که \"لا نفرق بین احد من",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 194.26,
   "end": 196.82,
   "text": "رسله\". هیچ فرقی هم بین رسولان نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 196.82,
   "end": 198.72,
   "text": "کتابش اصلاً ما یک دین بیشتر نداریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 198.72,
   "end": 201.46,
   "text": "\"ان الدين عند الله الاسلام\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 201.46,
   "end": 203.92,
   "text": "حضرت ابراهیم هم اقرار می‌کنه منم مسلمانم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 203.92,
   "end": 210.18,
   "text": "همه این بحث مسیحیت و یهودیت اسماییه که دیگران لقب دادن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 210.18,
   "end": 216.2,
   "text": "و الا همه اسلامن. حالا هرچی میره جلوتر بخش کامل‌تری از اسلام میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 216.2,
   "end": 219.04,
   "text": "کتاب‌های اونا هم بخشی از قرآن بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 219.04,
   "end": 221.54,
   "text": "بعضی از انبیا یه صفحه مثلاً قرآن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 221.54,
   "end": 224.86,
   "text": "یک صفحه سهف یا کتاب داشتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 224.86,
   "end": 227.22,
   "text": "اما خب قصه چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 227.22,
   "end": 232.68,
   "text": "چطوره که این‌ها خب مدعی‌ان که پیغمبر این آموزه‌هایی که تو آوردیم انّ،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 232.68,
   "end": 234.7,
   "text": "توی آخر سوره اعلی باید باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 234.7,
   "end": 238.92,
   "text": "\"ان هذا لفی صحف الاولى",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 238.92,
   "end": 241.08,
   "text": "صحف ابراهیم و موسی\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 241.08,
   "end": 244.8,
   "text": "میگه این همین حرفی که ما داریم الان تو این سوره به شما می‌گیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 244.8,
   "end": 246.5,
   "text": "تو صحف ابراهیم و موسی هم بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 246.5,
   "end": 248.66,
   "text": "خب حرف اینا در حقیقت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 248.66,
   "end": 250.24,
   "text": "به یک معنا لغو نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 250.24,
   "end": 252.7,
   "text": "خب اونچه که شما برای ما آوردی در ادامه همونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 252.7,
   "end": 255.04,
   "text": "پس چرا برای اینا خسارت شده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 255.04,
   "end": 262.48,
   "text": "چرا اینا قلب اغلف گر-- چرا اینا گرفتار شدن تا جایی که بعدش تو همین آیه می‌فرماید \"بل تبع الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 262.48,
   "end": 265.42,
   "text": "علیها بكفرهم\". خدا مهر می‌زنه به دلشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 265.42,
   "end": 268.3,
   "text": "قصه اینجاست. اینو خوب گوش بدین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 268.3,
   "end": 271.58,
   "text": "ببینید عزیزان دلم در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 271.58,
   "end": 275.56,
   "text": "نظام هستی یک فیض بیشتر نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 275.56,
   "end": 282.58,
   "text": "یعنی در حقیقت نظام هستی که البته در توحید صمدی اگر شما پیش برید اینو خوب بهتر متوجه می‌شید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 282.58,
   "end": 285.26,
   "text": "درس اول معرفت نفس از علامه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 285.26,
   "end": 288.56,
   "text": "یک حقیقت، یک وجود در نظام هستی بیش نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 288.56,
   "end": 291.16,
   "text": "اساساً یک وجود داریم که ما اینو متوجه شدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 291.16,
   "end": 293.6,
   "text": "همه کثرات که یکیش ما هستیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 293.6,
   "end": 296.56,
   "text": "نمودار اون وجودن. شعون اون وجودن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 296.56,
   "end": 298.76,
   "text": "ظهور و بروز همون وجودن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 298.76,
   "end": 303.54,
   "text": "حالا این فیض که از حقیقت از اون ذات حضرت حق که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 303.54,
   "end": 309.38,
   "text": "مثل قرآن سلام علیکم نازل می‌شود، بسته به اینکه این فیض",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 309.38,
   "end": 315.26,
   "text": "به چه کسی برسه، به چه قابلی، به چه قابلیتی برسد این فیض،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 315.26,
   "end": 322.16,
   "text": "فاعلیت نظام هستی، اون بالا، ملکوت، جبروت، لاهوت، ذات، هرچی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 322.16,
   "end": 327.06,
   "text": "اون فاعلیت نسبت به قابلیت‌ها بروز می‌کند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 327.06,
   "end": 329.7,
   "text": "ببینید باران میگه \"و انزلنا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 329.7,
   "end": 333.62,
   "text": "من السماء ماء طهورا\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 333.62,
   "end": 338.74,
   "text": "فکر می‌کنم آیه اگر اشتباه نکنم چهل و هشت فرقان باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 338.74,
   "end": 345.58,
   "text": "\"و هو الذي ارسل الرياح بشرا بین یدي رحمته و انزلنا من السماء ماء طهورا\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 345.58,
   "end": 349.42,
   "text": "این آب از آسمان اومده ماء طهور هم هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 349.42,
   "end": 355.22,
   "text": "اما همین آب چرا می‌زنه به گلزار بوی گل بلند می‌کنه، به لجنزار بوی لجن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 355.22,
   "end": 357.22,
   "text": "چرا به خواص می‌رسه وقتی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 357.22,
   "end": 360.24,
   "text": "می-می‌خوره به عین نجاست نجس می‌کنه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 360.24,
   "end": 362.82,
   "text": "به عین طهارت طهارت پخش می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 362.82,
   "end": 364.86,
   "text": "ربطی به آب داره به نظر شما؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 364.86,
   "end": 369.86,
   "text": "نه. ربطه به قابلیت اون کسی که این فیض رو داره درک می‌کنه داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 369.86,
   "end": 374.16,
   "text": "ربطی به کس دیگه نداره این رو باید در قابلیت‌ها دید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 374.16,
   "end": 379.2,
   "text": "لذا خدا رحمت کنه شیخ اکبر حضرت محی الدین عربی در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 379.2,
   "end": 382.46,
   "text": "فصل، فصل شیفی یا شیفی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 382.46,
   "end": 386.5,
   "text": "فصوص الحکمش اون اصلی رو که قبلاً القا کردیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 386.5,
   "end": 391.68,
   "text": "خیلی اصل طلاییه بیان می‌کنه اینجا که می‌رسه که إن الأعطیات یادتونه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 391.68,
   "end": 395.44,
   "text": "إن الأعطیات على قدر القابليات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 395.44,
   "end": 399.02,
   "text": "هرچی تو قابلیت داری همون مقدار رو ظهور میدی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 399.02,
   "end": 402.6,
   "text": "خدایه که یک حقیقت، اصلاً وجود یک حقیقت بیش نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 402.6,
   "end": 406.94,
   "text": "تمام این اص-- این اسماء الهی هم که از ذات حق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 406.94,
   "end": 411.54,
   "text": "ظهور کردن چون ظهور کردن به عالم کثرت خوردن که ظهور کردن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 411.54,
   "end": 414.54,
   "text": "و الا از یک حقیقت یا از یک وجود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 414.54,
   "end": 417.0,
   "text": "ناشی شدن، ظهور کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 417.0,
   "end": 421.88,
   "text": "به کثرت خوردن. شما ببینید آب رو باز مثال آب رو بزنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 421.88,
   "end": 426.34,
   "text": "همین آب وقتی در دهان شماست، آب سبب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 426.34,
   "end": 428.66,
   "text": "ت-- هضم غذا می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 428.66,
   "end": 432.64,
   "text": "دانشمندان تجربی ثابت کردن اگر چشمه‌های",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 432.64,
   "end": 437.1,
   "text": "آب دهان و این سیستم هضم خشک بشه به هر دلیلی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 437.1,
   "end": 443.98,
   "text": "شما غذای کال و هوای کال رو می‌خوری، استنشاق می‌کنی، هوای کال، غذای کال،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 443.98,
   "end": 446.9,
   "text": "معده خشک دهان خشک باعث می‌شه بزنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 446.9,
   "end": 449.86,
   "text": "داغون کنه، متلاشی کنه بدنت رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 449.86,
   "end": 455.54,
   "text": "اصلاً نمی‌تونه هضم بشه. سیستم هضم از کار می‌افته و اصلاً نمی‌تونی ببلعی حتی بلع مشک--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 455.54,
   "end": 461.16,
   "text": "همین آب رو، همین آب دهان مبارک خودت رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 461.16,
   "end": 465.22,
   "text": "که برای تو چقدر به درد بخور بود، چقدر خوب بود، شفا و رحمت بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 465.22,
   "end": 467.94,
   "text": "همین آب رو ببر بریز تو دهان مار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 467.94,
   "end": 471.08,
   "text": "مار رو می‌کشه. برای مار حالت سمی داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 471.08,
   "end": 475.02,
   "text": "برعکس آب دهان مار رو بردار بریز تو دهن خودت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 475.02,
   "end": 480.02,
   "text": "خودکشی می‌کنی. خودتو می‌کشی. مگر آب دهان مار برای خودش شفا و رحمت نیست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 480.02,
   "end": 482.62,
   "text": "چرا برای تو و بالعکس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 482.62,
   "end": 484.44,
   "text": "ببین ربط به قابلیت‌ها داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 484.44,
   "end": 490.34,
   "text": "همین آب و همین خاک و همین هوا و همین آفتاب یک حقیقتن، چهار عنصر اربع.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 490.34,
   "end": 492.5,
   "text": "هم همین‌ها وقتی می‌تابن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 492.5,
   "end": 494.56,
   "text": "می‌بارن، می‌بارن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 494.56,
   "end": 497.96,
   "text": "همین‌ها جلوه می‌کنند در هر درختی یه گونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 497.96,
   "end": 500.34,
   "text": "در درخت خار، خار می‌رویه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 500.34,
   "end": 503.5,
   "text": "درخت گل، گل. نسبت به طبیعتش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 503.5,
   "end": 506.38,
   "text": "این یک اصلی‌ست که در معرفت نفس هم هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 506.38,
   "end": 509.36,
   "text": "عوارض ربطی به ذاتیات ندارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 509.36,
   "end": 512.44,
   "text": "مثلاً عوارض آب سردی گرمی‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 512.44,
   "end": 515.86,
   "text": "عوارض مثلاً خاک سختی و نرمی‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 515.86,
   "end": 519.64,
   "text": "این ربطی به ذاتش نداره. ذات خاک یک خاکه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 519.64,
   "end": 525.3,
   "text": "ذات آب آبه. به هر طبعی که دقت کنید به، به طبایع،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 525.3,
   "end": 529.6,
   "text": "به هر طبعی که برخورد کنه نسبت به اون طبع",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 529.6,
   "end": 534.76,
   "text": "یا شیرین می‌شه یا شور می‌شه یا تلخ می‌شه یا سخت می‌شه یا نرم می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 534.76,
   "end": 539.4,
   "text": "و الا ذاتی آب شیرینی نیست، تلخی نیست، ترشی نیست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 539.4,
   "end": 542.26,
   "text": "سختی و نرمی نیست ذاتی خاک.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 542.26,
   "end": 545.12,
   "text": "توجه کردید؟ نسبت به طبایعه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 545.12,
   "end": 550.1,
   "text": "اساساً عالم خلقت یک حقیقت، فیض یک حقیقته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 550.1,
   "end": 552.16,
   "text": "مگر نمیگی عالم مجردات؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 552.16,
   "end": 555.36,
   "text": "ها؟ این بحث خیلی داره خیلی دقیق می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 555.36,
   "end": 558.18,
   "text": "شما هم الحمد لله دقیق دارید گوش میدید منو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 558.18,
   "end": 560.74,
   "text": "مشوق من می‌شید که دقیق‌ترش کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 560.74,
   "end": 564.62,
   "text": "یه چیزی هم که نباید بگم بگم امروز.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 564.62,
   "end": 567.56,
   "text": "مگر عالم مجردات، عالم عقول،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 567.56,
   "end": 570.5,
   "text": "حالا نوریه، اونجا یک حقیقت بیش نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 570.5,
   "end": 574.52,
   "text": "مجرده دیگه. تهی از ماده و کثرت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 574.52,
   "end": 580.02,
   "text": "چگونه‌ست که ما حتی در قرآن هم می‌گیم ملائکت الله جمع می‌بندیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 580.02,
   "end": 582.74,
   "text": "ها؟ می‌گیم جبرائیل، عزرائیل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 582.74,
   "end": 585.68,
   "text": "یه مثال بزنم اینم براتون متوجه بشید قشنگ.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 585.68,
   "end": 590.82,
   "text": "شما وقتی وارد منزل می‌شید همسرت هست، بچه‌هات هستن، مثلاً بچه‌های برادرت هستن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 590.82,
   "end": 593.8,
   "text": "بچه‌های خواهرت هستن، چند نفر رفیقات هستن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 593.8,
   "end": 596.14,
   "text": "هرکس شما یک وجودی، یک منی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 596.14,
   "end": 600.46,
   "text": "اما هرکس شما رو به شأنی که مربوط به خودشه می‌خواند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 600.46,
   "end": 604.6,
   "text": "همسرت میگه همسرم، بچه‌ها میگن پدرم، رفیقت میگه رفیقم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 604.6,
   "end": 608.1,
   "text": "بچه‌های خواهرت میگن چی؟ بهت میگن دایی جون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 608.1,
   "end": 611.52,
   "text": "بچه‌های برادرت میگن عمو جون. مگه یک حقیقت نیستی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 611.52,
   "end": 614.16,
   "text": "چرا اسامی مختلف پیدا کردی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 614.16,
   "end": 621.56,
   "text": "وقتی فیض جاری شد به عالم کثرت که می‌خواد بخوره، اگر علم نسبت به این نشئه طبیعت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 621.56,
   "end": 625.26,
   "text": "علم می‌خواد نازل بشه اسمش رو همون یک حقیقتو اومده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 625.26,
   "end": 627.2,
   "text": "همون تویی وارد خونه شدی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 627.2,
   "end": 630.84,
   "text": "اما از این جهت که به کی می‌خواد چی رو برسونه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 630.84,
   "end": 632.84,
   "text": "می‌خواد علم برسونه اسمش جبرائیله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 632.84,
   "end": 636.78,
   "text": "همون یک حقیقته. می‌خواد قبض روح کنه قابض الارواحه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 636.78,
   "end": 639.52,
   "text": "می‌خواد اماته و احیا کنه عزرائیله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 639.52,
   "end": 643.02,
   "text": "می‌خواد روزی برسونه کِیل مکیال.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 643.02,
   "end": 645.72,
   "text": "کِیل فعوفلن الکَیل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 645.72,
   "end": 648.52,
   "text": "پیمانه. میکائیله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 648.52,
   "end": 650.9,
   "text": "می‌خواد چی کار کنه؟ روزی برسونه. یک حقیقته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 650.9,
   "end": 654.12,
   "text": "اساساً نظام هستی یک حقیقته، یک وجوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 654.12,
   "end": 660.38,
   "text": "جلوه‌هاش فرق کرده. این جلوه‌ها نسبت به طبایع موجوداته، به طبع توئه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 660.38,
   "end": 662.6,
   "text": "اصطلاحاً به قابلیت توئه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 662.6,
   "end": 666.2,
   "text": "به فاعلیت ربط نداره. لذا بزرگان گفتن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 666.2,
   "end": 669.0,
   "text": "فیض علی الدوام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 669.0,
   "end": 672.22,
   "text": "به یکباره بر تمام موجودات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 672.22,
   "end": 675.56,
   "text": "چه شمع، چه پیغمبر به یک اندازه جاریه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 675.56,
   "end": 678.66,
   "text": "الله اکبر. حالا ظرف هرکی هر چقدره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 678.66,
   "end": 684.06,
   "text": "یکی یه پیاله آب ظرفشه از یه پیاله جمع کنه، یکی اقیانوس اقیانوس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 684.06,
   "end": 687.02,
   "text": "یکی همون پیاله‌شو نجس کرده، آب می‌ریزه توش نجس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 687.02,
   "end": 689.18,
   "text": "ظهور می‌کنه. یکی پاک نگه داشته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 689.18,
   "end": 695.0,
   "text": "پاکی. الطیبات للطيبين والخبيثات للخبيثين این می‌شه آیه‌ش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 695.0,
   "end": 699.68,
   "text": "در حقیقت اشکال کار برمی‌گرده به خود اون قابلیت‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 699.68,
   "end": 702.46,
   "text": "شما دقت بفرمایید. یه مثال دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 702.46,
   "end": 707.94,
   "text": "می‌گه آقا جان جهنم، حضرت علامه حسن زاده دارن که جهنم تجلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 707.94,
   "end": 709.84,
   "text": "جلال سید الشهداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 709.84,
   "end": 712.06,
   "text": "بهشت تجلی ر--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 712.06,
   "end": 715.24,
   "text": "جمال سید الشهداست. سؤال،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 715.24,
   "end": 717.98,
   "text": "مگر از ش-- سید الشهدا شرخ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 717.98,
   "end": 721.44,
   "text": "ساطع می‌شه؟ مگر از سید الشهدا چیز بدی ساطع می‌شه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 721.44,
   "end": 724.2,
   "text": "ما می‌گیم جهنم می‌گیم چه جای بدیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 724.2,
   "end": 728.36,
   "text": "خب آقا بزرگان، حکما فرمودن تجلی جلال سید الشهداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 728.36,
   "end": 730.34,
   "text": "تو چرا میگی بده؟ چرا میگی می‌سوزونه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 730.34,
   "end": 732.78,
   "text": "چرا میگی آتیشه؟ چرا میگی شکنجه‌ست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 732.78,
   "end": 737.51,
   "text": "از سید الشهداست. ربطی به خودت داره به سید الشهدا نداره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 737.51,
   "end": 739.91,
   "text": "به قابلیت وجود تو داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 739.91,
   "end": 742.79,
   "text": "و الا سید الشهدا همه چیز، همه چیزش خوبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 742.79,
   "end": 747.45,
   "text": "مثال اون ببینید آب میاد تو وجودت \"و أنزلنا من السماء ماء\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 747.45,
   "end": 750.81,
   "text": "یا و \"من الماء كل شيء حي\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 750.81,
   "end": 753.95,
   "text": "مـ-مار هم از آب زنده است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 753.95,
   "end": 758.09,
   "text": "اما اون آب میاد تو وجود مار می‌شه نیش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 758.09,
   "end": 760.85,
   "text": "از-- زنبور عسل هم از آب زنده است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 760.85,
   "end": 764.85,
   "text": "اون آب میاد تو وجود زنبور عسل می‌شه نوش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 764.85,
   "end": 767.83,
   "text": "توجه کردی؟ این‌ها بستگی به اون داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 767.83,
   "end": 775.33,
   "text": "در حقیقت اینکه قرآن میگه \"و إن منهم إلا واردها\" هیچ کس نیست مگر اینکه وارد جهنم می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 775.33,
   "end": 777.13,
   "text": "یعنی سید الشهدا هم میره تو جهنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 777.13,
   "end": 781.15,
   "text": "بله همه میرن جهنم. باید دید جهنم چیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 214,
   "start": 781.15,
   "end": 784.67,
   "text": "جهنم تجلی جلال حضرت حقه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 215,
   "start": 784.67,
   "end": 788.69,
   "text": "حالا برای یکی جلال می‌بینی عین جمال می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 216,
   "start": 788.69,
   "end": 793.75,
   "text": "من و تو شاید نتونیم بگیم یا قهار اما خیلی بزرگان مثلا دوست دارن قهاریت خدا رو ببینن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 217,
   "start": 793.75,
   "end": 798.57,
   "text": "به من و تو چه. بعضیا می‌بینی فقط با جمال خدا سروکار دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 218,
   "start": 798.57,
   "end": 802.03,
   "text": "ها. همون ماری که برای من و تو جلاله دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 219,
   "start": 802.03,
   "end": 803.69,
   "text": "ها جلاله. می‌ترسیم ازش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 220,
   "start": 803.69,
   "end": 808.25,
   "text": "جلالت داره. جبروت داره. همون مار برای بچه‌اش چرا جماله؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 221,
   "start": 808.25,
   "end": 811.25,
   "text": "نباشه بچه‌اش دق می‌کنه. ها؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 222,
   "start": 811.25,
   "end": 819.91,
   "text": "پس باز حتی جنبه یک معنا اسماء جلالیه و جمالیه حضرت حق هم نسبت به طبایع",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 223,
   "start": 819.91,
   "end": 822.93,
   "text": "افرادند که ظهور و بروز می‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 224,
   "start": 822.93,
   "end": 829.05,
   "text": "یعنی آدم بهشتی اگه تو جهنم هم که اگه نه قطعاً تو جهنم هم میره لذت می‌بره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 225,
   "start": 829.05,
   "end": 835.77,
   "text": "شما بفرمایید چطور قرآن میگه حضرت ابراهیم رو آتش که ذاتیش سوزوندنه نسوزوند؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 226,
   "start": 835.77,
   "end": 837.93,
   "text": "تازه نسوزوند که هیچی لذت برد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 227,
   "start": 837.93,
   "end": 840.33,
   "text": "کن و برد و سلام و برد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 228,
   "start": 840.33,
   "end": 843.43,
   "text": "خنک‌ها. کیف می‌کرد. گلستان شد براش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 229,
   "start": 843.43,
   "end": 845.37,
   "text": "مگه آتش نبود؟ چرا نسوزوند؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 230,
   "start": 845.37,
   "end": 851.63,
   "text": "چرا امیرالمؤمنین فرمود تو آت-- تو جهنم منو ببری خدا، اونجا داد می‌زنم که من إني أحبك تو رو دوست دارم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 231,
   "start": 851.63,
   "end": 853.55,
   "text": "امام سجاد میگه. چرا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 232,
   "start": 853.55,
   "end": 860.23,
   "text": "اصلا جهنم نسبت به-- اگر تو وجودت جهنمه تو بهشت هم میری تو یک حقیقت می‌برنت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 233,
   "start": 860.23,
   "end": 863.29,
   "text": "توجه کنید. تو یک حقیقت می‌برنت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 234,
   "start": 863.29,
   "end": 865.95,
   "text": "همون نار برای تو نور می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 235,
   "start": 865.95,
   "end": 868.55,
   "text": "اگر بهشتی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 236,
   "start": 868.55,
   "end": 870.35,
   "text": "تو همون ناری که میری نور می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 237,
   "start": 870.35,
   "end": 874.05,
   "text": "اگر تو خودت جهنمی تو نار هم بری، یعنی تـ--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 238,
   "start": 874.05,
   "end": 878.07,
   "text": "ببخشید تو نور هم بری، تو بهشت هم بری جهنمی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 239,
   "start": 878.07,
   "end": 880.41,
   "text": "نار می‌شی. پس بستگی به خوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 240,
   "start": 880.41,
   "end": 884.21,
   "text": "نار و نور بودن به ذات وجودی من و تو بستگی داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 241,
   "start": 884.21,
   "end": 889.31,
   "text": "اینه که کسی که دچار قلب اقلب شده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 242,
   "start": 889.31,
   "end": 894.79,
   "text": "مائده آسمانی، اون سفره طعام رو پس زده به خودش ربط داره، نه به قرآن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 243,
   "start": 894.79,
   "end": 897.13,
   "text": "اشتباه نشه. به امام عصر ربطی نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 244,
   "start": 897.13,
   "end": 901.71,
   "text": "به من و تو ربط داره. این بحث خیلی به دردمون می‌خوره در فهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 245,
   "start": 901.71,
   "end": 908.81,
   "text": "روایات و آیات. حالا من متأسفم چرا که چرا بعضیا هی منو خفه می‌کنن که حاج آقا یه حدیث بگو رد شو برو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 246,
   "start": 908.81,
   "end": 910.53,
   "text": "این بحث‌ها به چه درد ما می‌خوره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 247,
   "start": 910.53,
   "end": 913.15,
   "text": "اساسا اینه که به درد من و شما می‌خوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 248,
   "start": 913.15,
   "end": 916.13,
   "text": "درون مایه آیات و روایات رو فهمیدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 249,
   "start": 916.13,
   "end": 918.37,
   "text": "البته بحث کالمون نپخته شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 250,
   "start": 918.37,
   "end": 920.55,
   "text": "ببخشید چون فر-- فرصت نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 251,
   "start": 920.55,
   "end": 923.93,
   "text": "انشاالله که عاقبتمون ختم بخیر باشه به برکت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 252,
   "start": 923.93,
   "end": 929.15,
   "text": "صلوات بر محمد و آل محمد. اللهم صلي على محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}