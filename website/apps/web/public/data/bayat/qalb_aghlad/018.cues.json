 "chapters": [
  {
   "index": 0,
   "title": "## تمثیل تنزل حقیقت از جان به کاغذ",
   "start": 27.5,
   "end": 101.34
  },
  {
   "index": 1,
   "title": "## تجلی حق بر شاکله؛ تنزل برای فهم",
   "start": 101.34,
   "end": 339.56
  },
  {
   "index": 2,
   "title": "## نظام تکوین به منزلهٔ ظهور؛ نه جسمانیت",
   "start": 339.56,
   "end": 502.95
  },
  {
   "index": 3,
   "title": "## نظام تدوین؛ قرآن بر شاکلهٔ حق",
   "start": 502.95,
   "end": 579.45
  },
  {
   "index": 4,
   "title": "## چهار نهر بهشت؛ علم و حکمت و عشق و شهود",
   "start": 579.45,
   "end": 737.89
  },
  {
   "index": 5,
   "title": "## نتیجه؛ پس زدن حق همان پس زدن خداست",
   "start": 737.89,
   "end": 880.18
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.24,
   "end": 3.7,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 3.7,
   "end": 7.46,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 7.46,
   "end": 12.84,
   "text": "آیات. سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 12.84,
   "end": 16.72,
   "text": "امروز انشاالله دیگه نیت کردیم بحث قلب اقلف رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 16.72,
   "end": 22.38,
   "text": "به اتمام برسونیم اگرچه تازه تو یه شیبی از بحث افتادیم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 22.38,
   "end": 26.6,
   "text": "واقعاً تازه حقایق دیگری داره هی آشکار می‌شه از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 26.6,
   "end": 29.66,
   "text": "درون مایه این آیه اما دیگه بسه دیگه ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 29.66,
   "end": 32.88,
   "text": "متهم نشیم به که این که کش و قوس می‌ده به موضوع.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 32.88,
   "end": 38.9,
   "text": "حالا هرچی. بماند انشاالله قیامت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 38.9,
   "end": 43.8,
   "text": "اشاره می‌کنم امروز توکل به خدا به یک نکته‌ای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 43.8,
   "end": 47.84,
   "text": "که در کلمه، بله کلمه نود و هشت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 47.84,
   "end": 53.14,
   "text": "رساله یا کتاب صد کلمه در معرفت نفس از تعلّمه آمده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 53.14,
   "end": 57.58,
   "text": "اینو مقدمه قرار می‌دم تا یک نکته‌ای رو عارض باشم خدمت شما پیرامون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 57.58,
   "end": 63.9,
   "text": "صاحبان قلب اقلف. اون هم اشاره به آیه \"قل کل يعمل على",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 63.9,
   "end": 68.2,
   "text": "شاکلته\" است که حضرت تعلّمه حسن زاده اونجا اشاره می‌کنند به این آیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 68.2,
   "end": 73.32,
   "text": "خیلی آیه عجیبی است. بسیاری از بزرگان در موضوعات مختلف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 73.32,
   "end": 75.64,
   "text": "من دیدم که اشاره می‌کنند به این آیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 75.64,
   "end": 81.94,
   "text": "عجیب آیه‌ای است. می‌گه پیغمبر بگو که هر کسی عمل می‌کنند بر مبنای شاکله‌ش،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 81.94,
   "end": 87.16,
   "text": "بر مبنای شکلش. اون حالا ذاتش، خمیرمایه‌ش، درون مایه‌ش،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 87.16,
   "end": 90.86,
   "text": "ذاتش، هرچی. به شکل خودش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 90.86,
   "end": 93.46,
   "text": "عمل می‌کند. حالا اینو شما بیایید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 93.46,
   "end": 96.2,
   "text": "بالاخره آیه است دیگه مثل این که شما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 96.2,
   "end": 99.26,
   "text": "وقتی می‌خواید یک حقیقت کلیه رو از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 99.26,
   "end": 102.88,
   "text": "عقل وجودتون، از روحتون تنزل بدید،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 102.88,
   "end": 106.44,
   "text": "می‌خواید بیاریدش پیاده‌اش کنید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 106.44,
   "end": 114.66,
   "text": "و مثلاً در معرض فهم دیگران قرارش بدید، من که چه می‌دونم در عقل شما، در جان و روح شما چه می‌گذره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 114.66,
   "end": 116.84,
   "text": "از شما یک سوالی رو می‌پرسم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 116.84,
   "end": 119.44,
   "text": "شما میگم حالا یا بگو یا بنویس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 119.44,
   "end": 124.84,
   "text": "شما میاید در قالب صوت یا نوشتن، جوهر در رو کاغذ یک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 124.84,
   "end": 128.2,
   "text": "مسئله‌ای رو که منظور نظر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 128.2,
   "end": 133.12,
   "text": "جان و روح و عقل وجود شماست رو می‌نویسی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 133.12,
   "end": 138.02,
   "text": "درست شد؟ مثلاً شما میای اونچه که در درون خودت هست از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 138.02,
   "end": 143.56,
   "text": "داشته‌های درونی‌ات رو می‌ریزی رو کاغذ، می‌شه کتاب وجودی تو، کتاب تو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 143.56,
   "end": 146.48,
   "text": "این‌هایی که رو کاغذه چی‌ان؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 146.48,
   "end": 148.86,
   "text": "اون داشته‌های درونی توئه اند دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 148.86,
   "end": 152.56,
   "text": "اون بافت وجودی تو رو دارن ظهور و بروز می‌دن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 152.56,
   "end": 154.7,
   "text": "درونیات تو رو دارن می‌ریزن بیرون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 154.7,
   "end": 157.56,
   "text": "البته این همون نیست ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 157.56,
   "end": 161.36,
   "text": "دقت بفرمایید. مثلاً شما می‌نویسی رو کاغذ خورشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 161.36,
   "end": 167.58,
   "text": "آیا اون خورشید به اون عظمت که اصلاً نمی‌شه توصیفش کرد و نزدیکش شد و نگاهش کرد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 167.58,
   "end": 172.94,
   "text": "همین خوا و وا و را و شین و یا و دالیه که شما رو کاغذ نوشتی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 172.94,
   "end": 175.36,
   "text": "نه، این قطعاً اون نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 175.36,
   "end": 181.48,
   "text": "این کجا، اون کجا؟ تفاوت از زمین تا به آسمان هم بیشتر است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 181.48,
   "end": 186.0,
   "text": "اما هرچی که هست این یک موضوعی است، یک مفهومی است،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 186.0,
   "end": 190.84,
   "text": "یک داشته‌ای است از درون تو، درون توست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 190.84,
   "end": 195.02,
   "text": "ذاتی وجود توست تنزل پیدا کرده به مراتب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 195.02,
   "end": 199.76,
   "text": "حالا انزل مراتب خودش که تو حالت ماده جوهر است، صوت است،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 199.76,
   "end": 203.64,
   "text": "عرض است. دراومده که دیگران بفهمند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 203.64,
   "end": 205.56,
   "text": "یا بماند اثر وجودی تو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 205.56,
   "end": 208.16,
   "text": "درست شد؟ خب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 208.16,
   "end": 210.48,
   "text": "حالا خدا هم همین‌چیکاری کرده دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 210.48,
   "end": 214.28,
   "text": "خدا هم اومده \"قل کل يعمل على شاکلته\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 214.28,
   "end": 217.9,
   "text": "خدا هم به شکل وجود خودش، به بافت خودش،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 217.9,
   "end": 222.52,
   "text": "به ذاتی خودش تجلی کرده، ظهور کرده، بروز کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 222.52,
   "end": 225.58,
   "text": "در حقیقت اگر شما بخواید، حکما می‌گن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 225.58,
   "end": 229.18,
   "text": "اگر شما بخواید این بحث از تعلّمه‌ست ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 229.18,
   "end": 233.28,
   "text": "تا اینجا من دارم می‌گم این از من نیست ها، یه وقت اشتباه نگیرید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 233.28,
   "end": 240.38,
   "text": "من کجا و این مباحث. ولی خب این‌ها باعث می‌شه که درون مایه احادیث و آیات رو بهتر بفهمیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 240.38,
   "end": 243.52,
   "text": "حکما و عرفا کاری که کردن با ما با این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 243.52,
   "end": 248.3,
   "text": "مباحث باعث می‌شن که ما از این به بعد قال صادق قال واقع یه جور دیگه نگاه کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 248.3,
   "end": 252.52,
   "text": "واقعاً بفهمیم که حدیث اون‌ها صعب و مستصعب است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 252.52,
   "end": 256.7,
   "text": "خیلی دشوار و سخته. این‌طوری نیست که یه حدیث بخونی بری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 256.7,
   "end": 258.7,
   "text": "باید به درون مایه اش پی ببری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 258.7,
   "end": 264.62,
   "text": "اگر چنانچه بخواهیم خدا رو تنزل بدیم برای اینکه بتونیم بفهمیمش،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 264.62,
   "end": 268.94,
   "text": "خدا رو تنزل بدیم در نظام تکوین،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 268.94,
   "end": 271.22,
   "text": "هیکل و شکل و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 271.22,
   "end": 273.76,
   "text": "بافت و ذات حضرت حق،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 273.76,
   "end": 280.26,
   "text": "اون سر، سرّ السر، اون حقیقت الحوائق که کسی هم نمی‌تونه ذات غیب الغیب، اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 280.26,
   "end": 285.18,
   "text": "وقتی تجلی کرده، ظهور کرده مثل تجلی حقیقت درونی تو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 285.18,
   "end": 291.74,
   "text": "که می‌ریزه رو کاغذ، یه کلمه‌ای رو می‌نویسی که دیگری به اثر وجودی تو پی ببره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 291.74,
   "end": 296.64,
   "text": "از این اثر به مؤثر که تو هستی پی ببره که درون تو چه خبره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 296.64,
   "end": 299.16,
   "text": "اگر خدا رو بخواهیم مثل همین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 299.16,
   "end": 304.86,
   "text": "تنزل بدیم که چون حقایق تنزل پیدا کردن برای که ما بتونیم بفهمیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 304.86,
   "end": 306.78,
   "text": "\"انا انزلناه\" تنزل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 306.78,
   "end": 310.02,
   "text": "\"وننزل من القرآن\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 310.02,
   "end": 312.8,
   "text": "تنزل پیدا کردن تا ما بتونیم بفهمیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 312.8,
   "end": 316.62,
   "text": "\"ام من شيء الا وعندنا خزائنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 316.62,
   "end": 323.76,
   "text": "وما ننزله\" ببینید \"وما ننزله الا بقدر معلوم\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 323.76,
   "end": 329.36,
   "text": "خزينه‌ها اونجاست اما نازل کرده به قدر معلوم که ماها اون خزینه رو بشناسیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 329.36,
   "end": 332.8,
   "text": "خب از چی باید بشناسی همین آیات، این نشانه‌ها؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 332.8,
   "end": 338.22,
   "text": "اینا چی‌ان؟ بر اساس شاکله رب اند، بر اساس ذاتی حق‌اند،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 338.22,
   "end": 344.84,
   "text": "درون مایه حق‌اند. لذا حکما و عرفا این جمله سنگین رو از تعلّمه میاد پیاده می‌کنه، القا می‌کنه، عجیب جمله‌ایه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 344.84,
   "end": 347.2,
   "text": "من این مقدمه رو شدم که اینو بفهمین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 347.2,
   "end": 348.76,
   "text": "که اگر بخواهیم به حضرت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 348.76,
   "end": 355.58,
   "text": "حق تنزل بدهیم که دیگران بتونن اون رو به عنوان یک آیه مشاهده کنند یعنی ظهور بدیم به حضرت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 355.58,
   "end": 362.7,
   "text": "به حضرت حق در نشئת تکوین، در نظام تکوینی و افقی عالم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 362.7,
   "end": 366.41,
   "text": "کل این نظام هستی به شکل حق است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 366.41,
   "end": 372.45,
   "text": "مثل این که شو-شما یک باطن داری، یک نفس داری، یک ذات داری، یه نفس داری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 372.45,
   "end": 376.99,
   "text": "این نفستو تنزل پیدا کرده اومده شده بدن تو، این جسم تو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 376.99,
   "end": 380.35,
   "text": "جسم تو که خود تو نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 380.35,
   "end": 385.43,
   "text": "درسته؟ اما مظهر توست، تو رو ظهور داده، جان تو رو ظهور داده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 385.43,
   "end": 387.35,
   "text": "قوای نفس در او پیاده می‌شود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 387.35,
   "end": 392.85,
   "text": "دقت بفرمایید. این مسائل معرفت نفس برای فهم حقیقت توحیدی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 392.85,
   "end": 398.55,
   "text": "همین طوری هم هست خدا-- لذا بعضی از حکما به خودشون جرات دادن همونطور که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 398.55,
   "end": 407.51,
   "text": "تو ز-- این ظهور تو، بروز تو شده بدن و حکایت از نفس تو داره و اساساً به اون و از این جهت بهش می‌گن نفس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 407.51,
   "end": 410.81,
   "text": "چون تعلق به مادون که بدن توئه داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 410.81,
   "end": 414.15,
   "text": "می‌خواد این بدن رو رشد بده، ارتقا بده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 414.15,
   "end": 417.13,
   "text": "به یک معنا. خدا نفس داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 417.13,
   "end": 420.17,
   "text": "مگه نداره خدا نفس؟ داره یا نداره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 420.17,
   "end": 423.75,
   "text": "خدا نفس داره. اللهم عرفنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 423.75,
   "end": 427.69,
   "text": "نفسک. قرآن چند بار، ویا حضرکم الله نفسا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 427.69,
   "end": 432.09,
   "text": "نه یعنی که نزدیک نفس من نشو، یعنی حواست باشه خیلی خطرناکه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 432.09,
   "end": 436.29,
   "text": "هر کسی جاهایی که عقاب پروازی زد از پشه‌ل آقجش برخیزد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 436.29,
   "end": 440.67,
   "text": "نفس داره پس خدا. اگر نفس داره به جهت تعلقش به مادونه نه از رو احتیاج،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 440.67,
   "end": 444.53,
   "text": "از رو عشق و محبتش دوست داره خدا همه رو بکشونه بالا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 444.53,
   "end": 448.15,
   "text": "فاحببت ان اعرف دوست داشتم شناخته بشم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 448.15,
   "end": 453.19,
   "text": "فخلقت الخلق خلق لکی اعرف خلق کردم تا شناخته بشم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 453.19,
   "end": 458.61,
   "text": "خدا از این جهت که ما-- به مادونش یعنی به همین نظام تکوین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 458.61,
   "end": 463.01,
   "text": "تعلق داره که اینا رو بالا بکشونه نفس داره، اونم نفس داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 463.01,
   "end": 466.43,
   "text": "اگر نفس داره پس بدن هم داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 466.43,
   "end": 468.89,
   "text": "اون ذات رو کاری نداریم ما حواستون باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 468.89,
   "end": 475.95,
   "text": "خدا برای اینکه درون مایه خودش رو ظهور بده، نظام تکوین رو ظهور داده از خودش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 475.95,
   "end": 479.01,
   "text": "مثل نفس تو که بدنت رو ظهور داده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 479.01,
   "end": 486.57,
   "text": "و در حقیقت اینطوری می‌شه گفت که این نظام تکوین رو ش-- به شکل حق یعنی بافت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 486.57,
   "end": 489.71,
   "text": "تکوینی حضرت حق کل نظام هستیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 489.71,
   "end": 492.49,
   "text": "حالا شما بگید به منزله بدن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 492.49,
   "end": 495.07,
   "text": "بدن اون نفس کلی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 495.07,
   "end": 498.97,
   "text": "نه اینکه استغفرالله بگی حاجی گفت دیگه حا-- خدا جسم، جسم داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 498.97,
   "end": 502.67,
   "text": "نه. منظورم رو از جهت فلسفی بگیرید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 502.67,
   "end": 508.15,
   "text": "یا از باب دیگه‌ای حالا اگر بخواید خدا رو حضرت حق رو تنزل بدید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 508.15,
   "end": 514.87,
   "text": "تو نظام تدوین، چطور شما وجودت رو تنزل دادی تو نظام تدوینی، نوشتن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 514.87,
   "end": 517.47,
   "text": "تدوین. نوشتی از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 517.47,
   "end": 521.97,
   "text": "اثر وجودی خودت یه کتاب باز گذاشتی که از اون به تو پی ببرن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 521.97,
   "end": 524.43,
   "text": "از اثر به مؤثر پی ببرن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 524.43,
   "end": 528.21,
   "text": "خدا هم اومده در نظام تکوین یک کتاب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 528.21,
   "end": 531.97,
   "text": "جعل کرده، ایجاد کرده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 531.97,
   "end": 535.31,
   "text": "ایجاد کرده که این کتاب به شکل وجودی خودشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 535.31,
   "end": 537.63,
   "text": "حالا درستش بگیم به شکل،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 537.63,
   "end": 541.25,
   "text": "به بافت قل کل یعمل على شاکلته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 541.25,
   "end": 544.27,
   "text": "اون کتاب چیه؟ قرآنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 544.27,
   "end": 546.63,
   "text": "پس قرآن هم به شکل حقه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 546.63,
   "end": 553.05,
   "text": "اصلاً قرآن تمام ذاتی حضرت حق توش جلوه کرده از جهت علمی و حکمی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 553.05,
   "end": 554.67,
   "text": "لذا قرآن سرتاسر علم است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 554.67,
   "end": 558.13,
   "text": "من اراد علم الاولین والآخرین فلیطلع على القرآن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 558.13,
   "end": 560.25,
   "text": "سرتاسر حکمت است،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 560.25,
   "end": 562.03,
   "text": "قرآن سرتاسر حکمت است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 562.03,
   "end": 564.11,
   "text": "بفرمایید. یٰس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 564.11,
   "end": 566.57,
   "text": "وَالْقُرْآنِ الْحَکیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 566.57,
   "end": 570.09,
   "text": "سرتاسر حکمته. همش اصلاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 570.09,
   "end": 574.57,
   "text": "آیه‌ای که می‌خواستم امروز براتون برائت کنم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 574.57,
   "end": 578.45,
   "text": "ترسیدم بهش نرسیم بحثو منقطع کردم خیلی آیه شیرینیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 578.45,
   "end": 583.13,
   "text": "شما دقت بفرمایید آیه نود و پنج سوره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 583.13,
   "end": 587.85,
   "text": "محمد صلى الله عليه وآله وسلم رو برید بخونید چقدر شیرینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 587.85,
   "end": 592.05,
   "text": "مثل، حالا خدا می‌خواد از اون بهشت ذاتی خودش، اون بهشتی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 592.05,
   "end": 597.09,
   "text": "گذاشته کنار برای من و تو، تجلی کرده خدا در اون خودش رو اونطوری نشون داده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 597.09,
   "end": 599.87,
   "text": "که ما بریم به مرحله اتم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 599.87,
   "end": 604.95,
   "text": "حالا ملکوت و جبروت و این‌ها بریم اونجا خدا رو اونچنین مشاهده کنیم مثال زده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 604.95,
   "end": 607.09,
   "text": "چون مثال نزنه ما نمی‌فهمیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 607.09,
   "end": 610.47,
   "text": "مثل الجنة التي وعد المتقون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 610.47,
   "end": 614.79,
   "text": "مثال م-- اون جنتی که خدا زده وعده داده برای متقین رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 614.79,
   "end": 617.01,
   "text": "فيها انهار من ماء",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 617.01,
   "end": 621.35,
   "text": "غير آنس. یه نهر، چهار تا نهر رو اینجا مثال زده خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 621.35,
   "end": 628.29,
   "text": "یه نهر میگه آب گوارا است که اینو گفتن حالا بر اساس روایات من دیگه وقتتون نگیرم بخوام دیگه شیب بحثه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 628.29,
   "end": 633.09,
   "text": "روایات گفتن این ماء گوارا و بدون غبار علم است، علم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 633.09,
   "end": 636.31,
   "text": "الان شما دارید علم می‌نشید تو این جلسه چون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 636.31,
   "end": 639.61,
   "text": "ماء گوارا اهل بیته دیگه آیات و روایاته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 639.61,
   "end": 643.09,
   "text": "و انهار من لبن لم يتغير طعمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 643.09,
   "end": 645.45,
   "text": "یه نهر است از شیر،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 645.45,
   "end": 649.45,
   "text": "شیر سفید سفید که طعمش هم تغییر نمی‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 649.45,
   "end": 654.09,
   "text": "این رو حکمت گرفتن. روایات ما فرمودن اهل بیت فرمودن این حکمت است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 654.09,
   "end": 656.29,
   "text": "یٰس وَالْقُرْآنِ الْحَکیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 656.29,
   "end": 658.89,
   "text": "شما الان سرچشمه حکمت رو نشستید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 658.89,
   "end": 661.01,
   "text": "و انهار من خمر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 661.01,
   "end": 664.05,
   "text": "لذة للشاربين. خمر چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 664.05,
   "end": 666.65,
   "text": "اون و سقاهم ربهم شرابا طهورا چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 666.65,
   "end": 670.19,
   "text": "شراب طهورا چیه؟ مگه امیرالمؤمنین ساقی نیست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 670.19,
   "end": 672.65,
   "text": "اون چیز، اون ما--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 672.65,
   "end": 675.35,
   "text": "اون در حقیقت خمر چیه که مولا ساقیشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 675.35,
   "end": 677.11,
   "text": "اینجا این نهر خمر چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 677.11,
   "end": 679.37,
   "text": "فرمودن عشق به الله،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 679.37,
   "end": 681.97,
   "text": "حب ولایت، حب الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 681.97,
   "end": 685.75,
   "text": "در طولش حب مهدی فاطمه، حب ابی عبدالله الحسین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 685.75,
   "end": 689.51,
   "text": "اینا می‌شه این خمر. دیدی از خود بی خودت می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 689.51,
   "end": 692.81,
   "text": "اینجا همون در می‌گردیم ذیل اشعار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 692.81,
   "end": 699.03,
   "text": "مثل حضرت امام و سعد-- حافظ و دیگران که اینجا از خمر و این‌ها به بت و بتکده یاد می‌کنند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 699.03,
   "end": 703.13,
   "text": "و آخرین نهر هم می‌فرماید و انهار من عسل مصفى.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 703.13,
   "end": 706.61,
   "text": "این عسل مصفى رو روایات فرمودن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 706.61,
   "end": 709.79,
   "text": "کشف شهودی‌ست، علم شهودی‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 709.79,
   "end": 713.31,
   "text": "اینکه تو نه صرفاً با علم فکری بلکه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 713.31,
   "end": 716.79,
   "text": "به نظاره بنشینی حقایق نظام هستی رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 716.79,
   "end": 719.67,
   "text": "که به یک معنا همه این‌ها همون علمن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 719.67,
   "end": 722.05,
   "text": "به یک معنا همه این‌ها همون حکمten.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 722.05,
   "end": 724.55,
   "text": "به یک معنا همه این‌ها حب الله‌ن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 724.55,
   "end": 727.19,
   "text": "به یک معنا همه این‌ها کشف شهودی‌ن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 727.19,
   "end": 733.77,
   "text": "مثل دیروز که گفتیم نظام احسن عالم یک حقیقت بیش نیست، ظهور و بروزش چند گونه‌ست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 733.77,
   "end": 737.59,
   "text": "بلکه بی‌نهایت گونه‌ست. ظهورش بی‌نهایت مظهر دارد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 737.59,
   "end": 741.84,
   "text": "خب اینو تا اینجا داشته باشیم. به کجا می‌خواستیم برسیم ما اینو گفتیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 741.84,
   "end": 752.1,
   "text": "که حالا اگر خدا بخوای خدا رو تنزل بدیم در نظام تکوین کل نظام هستی بشود به منزله بدن یا بشود شکل حق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 752.1,
   "end": 757.98,
   "text": "اگر در نظام تدوین می‌شود قرآن و اگر در نظام انفسی یعنی جان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 757.98,
   "end": 765.62,
   "text": "در نظام نفس، نفوس، جان‌ها بخواهیم خدا را تنزل بدیم می‌شود جان انسان کامل به شکل حضرت حق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 765.62,
   "end": 767.78,
   "text": "به بافت حضرت حق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 767.78,
   "end": 774.34,
   "text": "لذا ذاتی حضرت حق که علمشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 774.34,
   "end": 778.56,
   "text": "همون قرآنه ریخته شده تو وجود حضرت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 778.56,
   "end": 780.8,
   "text": "حالا پیامبر و تا امام عصر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 780.8,
   "end": 782.9,
   "text": "خب ختم کلام نتیجه بگیریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 782.9,
   "end": 784.98,
   "text": "چه ربطی به قلب اغلف داشت؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 784.98,
   "end": 793.84,
   "text": "ما تا حالا ثابت کردیم به انحاء مختلف که مثلاً کسی که قلبش در غلافه داره مثلاً ناموس حق رو پس می‌زنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 793.84,
   "end": 796.24,
   "text": "تو یه بحثمون گفتیم امام رو پس می‌زنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 796.24,
   "end": 800.76,
   "text": "یه جا گفتیم پیغمبر رو، یه-- اخیراً گفتیم قرآن رو،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 800.76,
   "end": 803.58,
   "text": "یه جا گفتیم حکمت و حقایق نظام هستی رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 803.58,
   "end": 809.8,
   "text": "الان فهمیدیم که اگر این نظام، اگر این قرآن، اگر این نظام احسن عالم و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 809.8,
   "end": 814.2,
   "text": "نظام تکوین، اگر جان امام عصر که نظام انفسی است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 814.2,
   "end": 818.96,
   "text": "به شکل حضرت حق به بافت اوست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 818.96,
   "end": 823.78,
   "text": "که در کلمه نود و هشت کتاب معرفت نفس حضرت علامه داره میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 823.78,
   "end": 826.98,
   "text": "پس اینا حق رو دارن پس می‌زنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 826.98,
   "end": 829.56,
   "text": "اصلاً خدا رو دارن پس می‌زنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 829.56,
   "end": 832.96,
   "text": "بی‌خود میگن که ما بله ما موحد هستیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 832.96,
   "end": 835.44,
   "text": "یا رسول الله ما به دین آبائمون هستیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 835.44,
   "end": 837.34,
   "text": "دین کجا بود؟ اصلاً تو دین نداری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 837.34,
   "end": 840.22,
   "text": "ان الدين عند الله الاسلام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 840.22,
   "end": 842.22,
   "text": "تمام شد. تو دین نداری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 842.22,
   "end": 848.92,
   "text": "کسی که گرفتار قلب قلوب مقلوب عرض شود قلف شدن قلف جمع اغلافه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 848.92,
   "end": 853.76,
   "text": "قلب‌هاشون در غلافه و پس می‌زنن حق رو دارن پس می‌زنن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 853.76,
   "end": 857.62,
   "text": "و اصلاً اینا وجدان ندارن، دین ندارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 214,
   "start": 857.62,
   "end": 859.56,
   "text": "تمام. این ختم کلام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 215,
   "start": 859.56,
   "end": 862.5,
   "text": "دیگه اوج بحث بود که امروز زور زدیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 216,
   "start": 862.5,
   "end": 866.02,
   "text": "ام پی تری بتونیم به مطلب برسیم با آیات و روایات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 217,
   "start": 866.02,
   "end": 868.82,
   "text": "الحمدلله خداروشکر که تونستیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 218,
   "start": 868.82,
   "end": 870.5,
   "text": "این بحث رو هم به پایان برسونیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 219,
   "start": 870.5,
   "end": 874.22,
   "text": "ان‌شاءالله از شنبه وارد بحث جدید قلب جدید می‌شیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 220,
   "start": 874.22,
   "end": 880.18,
   "text": "عاقبتمون ان‌شاءالله ختم بخیر بشود به برکت صلوات بر محمد و آل محمد. اللهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}