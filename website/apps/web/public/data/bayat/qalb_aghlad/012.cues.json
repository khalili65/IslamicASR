 },
 "chapters": [
  {
   "index": 0,
   "title": "## ناموس خلقت؛ علم در خفا",
   "start": 126.52,
   "end": 223.64
  },
  {
   "index": 1,
   "title": "## پاسخ حکیمان و دعوت به سیر معرفتی",
   "start": 223.64,
   "end": 309.72
  },
  {
   "index": 2,
   "title": "## قلب اغلف و پس زدن علم",
   "start": 309.72,
   "end": 856.94
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.26,
   "end": 2.78,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 2.78,
   "end": 7.28,
   "text": "السلام علیک ای داعی الله و ربانی آیات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 7.28,
   "end": 9.68,
   "text": "سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 9.68,
   "end": 15.36,
   "text": "تسلیت عرض می‌کنم شهادت جانسوز حضرت موسی بن جعفر باب الحوائج",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 15.36,
   "end": 18.84,
   "text": "علیهم الصلاة والسلام را انشاالله بعد از نماز عصر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 18.84,
   "end": 21.72,
   "text": "یه روضه نمکی عزیزان می‌خونن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 21.72,
   "end": 24.26,
   "text": "تبرکاً نکته‌ای عرض کنم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 24.26,
   "end": 29.8,
   "text": "در صلوات منسوب به خواجه نصیر علیه رحمة،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 29.8,
   "end": 34.0,
   "text": "اون لقبی که پیرامون امام کاظم صلوات الله علیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 34.0,
   "end": 36.9,
   "text": "استعمال شده خیلی عجیبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 36.9,
   "end": 39.14,
   "text": "کمتر کسی شاید به این توجه کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 39.14,
   "end": 41.54,
   "text": "تو اون صلواتی که میگه اللهم صل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 41.54,
   "end": 43.92,
   "text": "و سلم وزد و بارک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 43.92,
   "end": 47.4,
   "text": "على صاحب الدعوة النبوية.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 47.4,
   "end": 49.7,
   "text": "صاحب این دعوة النبوية الان کیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 49.7,
   "end": 57.04,
   "text": "امام Asره. صلوات برمی‌گرده به حضرت صاحب اما القاب رو ببینید از اجدادشون چه جوری گرفتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 57.04,
   "end": 64.52,
   "text": "و ثقل حیدریه و عصمت فاطمیه و حلم حسنیه و شجاعت حسینیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 64.52,
   "end": 67.36,
   "text": "و عبادات سجادیه و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 67.36,
   "end": 70.5,
   "text": "آثار باقریه و ماثر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 70.5,
   "end": 72.48,
   "text": "جعفریه و چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 72.48,
   "end": 76.18,
   "text": "علوم کاظمیه. و العلوم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 76.18,
   "end": 79.86,
   "text": "کاظمیه. جالبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 79.86,
   "end": 86.64,
   "text": "یعنی اگر به آقامون علی بن موسی الرضا علیهم الصلاة و السلام هم لقب دادن که عالم آل محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 86.64,
   "end": 91.64,
   "text": "است صلی الله عليه و آله و سلم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 91.64,
   "end": 97.64,
   "text": ". اون بزرگوار هم در دامن علمی حضرت موسی بن جعفر پرورش یافتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 97.64,
   "end": 106.3,
   "text": "این شوخی نیست. تا حالا کدوم یکی از ماها در خانه باب الحوائج موسی بن جعفر رو به جهت علمی زدیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 106.3,
   "end": 108.82,
   "text": "انصافاً تو وجود خودمون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 108.82,
   "end": 112.04,
   "text": "چقدر برای حاجت‌های دنیاییمون بیشتر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 112.04,
   "end": 116.78,
   "text": "داد زدیم، ناله زدیم، گریه کردیم، اشک ریختیم، توسل کردیم به این آقا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 116.78,
   "end": 120.2,
   "text": "یک بار شد از نهای وجودمون بسوزیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 120.2,
   "end": 125.18,
   "text": "آتیش بگیریم، داد بزنیم که آقا من از درون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 125.18,
   "end": 127.66,
   "text": "معرفت می‌خوام، علم می‌خوام،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 127.66,
   "end": 130.3,
   "text": "آگاهی به حقایق نظام هستی می‌خوام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 130.3,
   "end": 134.62,
   "text": "خب و العلوم کاظمیه و این ارث رسیده به امام عصر ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 134.62,
   "end": 141.06,
   "text": "چند تامون اینطوری خداوکیلی نسبت به امام کاظم صلوات الله علیه اینطوری نگاه کردیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 141.06,
   "end": 146.38,
   "text": "که حالا غالباً تا میگیم موسی بن جعفر یاد اون مصیبات که حق اون هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 146.38,
   "end": 149.82,
   "text": "چهارده سال در زندان، کم هم نیست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 149.82,
   "end": 152.52,
   "text": "که البته اون هم باز گردن ما بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 152.52,
   "end": 158.24,
   "text": "حضرت فرمود من مخیر شدم بین اینکه بلا سر شیعیان ما بیاد یا ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 158.24,
   "end": 164.12,
   "text": "چون شیعیان ما خطاهایی کرده بودند قرار بود بلای سنگینی سرشون نازل شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 164.12,
   "end": 169.34,
   "text": "من انتخاب کردم بلاکش شیعیان و محبینمون شدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 169.34,
   "end": 172.94,
   "text": "اینه که بیش از هر امامی تحت شکنجه و سختی و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 172.94,
   "end": 181.54,
   "text": "السلام الیک ایها المعذب فی قعر السجون و ظلم المطامیر معذب تحت عذاب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 181.54,
   "end": 187.04,
   "text": "خب اینا شوخی نیست. ولی در همین وضعیت حضرت رو ببینید لقبی که محقق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 187.04,
   "end": 196.82,
   "text": "طوسی علیه رحمة، این علامه بزرگوار دادن که رسیده به امام عصر از امام کاظم و العلوم کاظمیه می فرمایند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 196.82,
   "end": 201.88,
   "text": "بعد و الحجج الرضویه و الجود التقویه که دنبال اونه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 201.88,
   "end": 207.0,
   "text": "و النقابة النقویه و الهیبة العسکریة و الغیبة الالهیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 207.0,
   "end": 211.74,
   "text": "علم، علم که ناموس خلقه، ناموس دهره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 211.74,
   "end": 218.28,
   "text": "ناموس می‌دونید به چیزی میگن که پوشانده‌ست، از دیگران پوشیده شده است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 218.28,
   "end": 221.66,
   "text": "اینطور نیست؟ به مرد که نمیگن ناموس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 221.66,
   "end": 224.68,
   "text": "زن چون در قالب پوشش قرار می‌گیره میگن ناموس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 224.68,
   "end": 228.8,
   "text": "ناموس خلقت، ناموس حضرت حق علمشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 228.8,
   "end": 231.42,
   "text": "همه داشته حضرت حق علمشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 231.42,
   "end": 238.82,
   "text": "اساس، اساساً درست اینه از جهت فلسفی که بگیم خدا علم است نه که بگیم خدا علیم است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 238.82,
   "end": 242.18,
   "text": "علیم تبدیل شده به یه اسم که ما مرتبط بشیم با خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 242.18,
   "end": 246.74,
   "text": "بتونیم خدا رو بخوانیم. صفت حضرت حق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 246.74,
   "end": 254.96,
   "text": "علم بوده. این علم برای اینکه ما بتونیم مرتبط باهاش بشیم بدل به اسم شده، تنزل پیدا کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 254.96,
   "end": 257.38,
   "text": "الاسماء تنزل من السماء.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 257.38,
   "end": 259.82,
   "text": "نازل شده به نشئه طبیعت از عالم بالا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 259.82,
   "end": 262.22,
   "text": "اونم این اسم هم نازل شده‌ست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 262.22,
   "end": 265.14,
   "text": "که ما بتوان، بتوانیم خدا را بخوانیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 265.14,
   "end": 269.1,
   "text": "و الا اصلش اینه که خدا علم است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 269.1,
   "end": 271.32,
   "text": "العلم نور.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 271.32,
   "end": 275.0,
   "text": "خدا هم تو قرآن میگه الله نور السماوات والأرض.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 275.0,
   "end": 282.76,
   "text": "این دو یک حقیقت‌اند. یعنی ناموس حضرت حق، اون پنهانی حضرت حق علم است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 282.76,
   "end": 287.0,
   "text": "خود خدا هم در کتاب حدیث اومده در کتاب کامل بهائی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 287.0,
   "end": 292.82,
   "text": "مرحوم میرداماد علیه رحمة این کتاب رو بخشید به یه کسی به نام کامل بهائی که خیلی عاشقش بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 292.82,
   "end": 295.3,
   "text": "نه اینکه کتاب مال کامل بهائی باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 295.3,
   "end": 300.4,
   "text": "مال مرحوم میرداماده. این محقق عظیم الشأن این روایت رو اونجا آورده، این حدیث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 300.4,
   "end": 304.4,
   "text": "قدسی رو که خدا فرمود انی یا فرمود کنت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 304.4,
   "end": 307.64,
   "text": "کنزا مخفیا. من یک گنج مخفی بودم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 307.64,
   "end": 311.36,
   "text": "قطعاً شنیدید چون رو این حدیث اینجا ما بحث کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 311.36,
   "end": 315.3,
   "text": "خدا می‌فرماید من یک گنج مخفی بودم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 315.3,
   "end": 318.78,
   "text": "مخفی. گفتیم ناموس در خفاست دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 318.78,
   "end": 321.04,
   "text": "خب فاحببت ان اعرف.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 321.04,
   "end": 323.78,
   "text": "عشقم، به قول ما عشقم کشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 323.78,
   "end": 329.42,
   "text": "خودمونیش این می‌شه. یعنی دوست داشتم که ان اعرف شناخته بشم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 329.42,
   "end": 331.9,
   "text": "دوست داشتم نه که محتاج بودم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 331.9,
   "end": 335.56,
   "text": "خب حالا که خواستی شناخته بشی خودت چه کار کردی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 335.56,
   "end": 338.66,
   "text": "فخلقت الخلق لکی اعرف.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 338.66,
   "end": 342.96,
   "text": "دست به خلقت زدم بلکه شناخته شوم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 342.96,
   "end": 347.9,
   "text": "پس اون ذاتی حضرت حق، علم حضرت حقه که در خفا بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 347.9,
   "end": 349.9,
   "text": "اصلاً علم در خفا بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 349.9,
   "end": 354.48,
   "text": "چی این رو آشکار کرد؟ خود حضرت حق عاشق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 354.48,
   "end": 357.18,
   "text": "خودش بود. خود-- خواست آشکار بشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 357.18,
   "end": 360.63,
   "text": "از طریق حجت‌هاش. و العلوم کاظمیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 360.63,
   "end": 362.75,
   "text": "علم رو ریخت تو دامن این آل الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 362.75,
   "end": 365.19,
   "text": "کدوم یکی از ما انصافاً رفتیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 365.19,
   "end": 372.13,
   "text": "ضریح آقا علی ابن موسی الرضا رو گرفتیم اشک ریختیم که من این موضوع سنگین علمی رو نمی‌فهمم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 372.13,
   "end": 375.05,
   "text": "من مثلاً قصه قیامت رو متوجه نمی‌شم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 375.05,
   "end": 378.71,
   "text": "خداییش کدوم یکیمون؟ قیامت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 378.71,
   "end": 385.71,
   "text": "یه ذره فکر کنیم حالا من سؤال ایجاد می‌کنم اما الان تو مجامع علمی، تو دانشگاه‌ها، حتی تو حوزه‌ها این‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 385.71,
   "end": 387.97,
   "text": "مورد سؤال جوانان ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 387.97,
   "end": 392.81,
   "text": "الان شما، من و شما یک عمر پای این هیئت‌ها، منبرها،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 392.81,
   "end": 394.67,
   "text": "روضه‌ها، جلسات بزرگ شدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 394.67,
   "end": 399.47,
   "text": "یه آدمی که تازه می‌خواد بیاد تو وادی ما، کمونیسمه نمی‌دونم حالا که کمونیست بیایم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 399.47,
   "end": 406.15,
   "text": "مثلاً مسیحه هرچی. اصلاً گبره می‌خواد بیاد بگه آقا شما میگید بهترین کتابتون قرآنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 406.15,
   "end": 412.27,
   "text": "تو قرآن میگه که وقتی زمین نمی‌دونم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 412.27,
   "end": 415.97,
   "text": "منفجر میشه، زلزله میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 415.97,
   "end": 423.41,
   "text": "خورشید خاموش میشه. خورشید و ماه به هم برخورد می‌کنند جمع میشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 423.41,
   "end": 425.51,
   "text": "خب از این طرف آیه داریم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 425.51,
   "end": 430.29,
   "text": "که خداوند در خودش در قرآن فرموده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 430.29,
   "end": 433.27,
   "text": "آنچه که خدا آفریده است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 433.27,
   "end": 436.67,
   "text": "به حق آفریده. خلق الس-- هو الذی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 436.67,
   "end": 439.53,
   "text": "هو به خدا برمی‌گرده. هویت حضرت حق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 439.53,
   "end": 442.85,
   "text": "هو الذی خلق السماوات والأرض بالحق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 442.85,
   "end": 448.29,
   "text": "آسمان و زمین به حق آفریده شده یعنی تارش حقه، پودش حقه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 448.29,
   "end": 453.63,
   "text": "شما بفرمایید خدا برای اینکه چهار تا آدمی که گناه کردند رو پاداش بده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 453.63,
   "end": 457.01,
   "text": "جزا بده. چهار تا آدمی که ثواب کردند رو پاداش بده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 457.01,
   "end": 461.27,
   "text": "میاد این نظام عظیم هستی رو با عظمت رو میزنه داغون میکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 461.27,
   "end": 463.35,
   "text": "یه توپ میزنه زمین رو منفجر میکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 463.35,
   "end": 467.23,
   "text": "یه توپ میزنه نمی‌دونم ماه و خورشید و همه رو از بین می‌بره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 467.23,
   "end": 470.39,
   "text": "در حالی که به حق این‌ها رو آفریده بوده که چی بشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 470.39,
   "end": 475.51,
   "text": "چهار تا آدم روی این کره زمین یا ثواب یا عقاب شامل حالشون شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 475.51,
   "end": 478.45,
   "text": "شما بیا جواب بده. آیا قیامت اینه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 478.45,
   "end": 482.99,
   "text": "یعنی باید زمین و زمان به هم برخورد کنه واقعاً قیامت بشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 482.99,
   "end": 485.45,
   "text": "اگه نیست چرا قرآن داره میگه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 485.45,
   "end": 489.67,
   "text": "اگر هست پس چگونه این تعارضات رو حل کنیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 489.67,
   "end": 492.85,
   "text": "یا میگیم عالم عقول. ختم کلام یه سواله دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 492.85,
   "end": 498.75,
   "text": "حالا این سؤال هم روش فکر کنید. اگرچه اینجا تو سیر بحث‌هامون ما بحث رو جواب دادیم اما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 498.75,
   "end": 501.73,
   "text": "سؤال، آقا مگه نمیگن عالم مجردات؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 501.73,
   "end": 503.47,
   "text": "مگه عالم عقول نمیگن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 503.47,
   "end": 507.39,
   "text": "مگر نظام ملکوت یکپارچه یک حقیقت نیست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 507.39,
   "end": 510.47,
   "text": "مجرده دیگه. یعنی از کثرات بریه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 510.47,
   "end": 515.07,
   "text": "کثرات، تعداد، تعدد مال آدم عالم ماده‌ست نه ملکوت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 515.07,
   "end": 518.69,
   "text": "پس چرا میگیم ملائکه؟ جبرائیل یه اسم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 518.69,
   "end": 521.29,
   "text": "اسرافیل یه اسم، عزرائیل یه اسم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 521.29,
   "end": 523.77,
   "text": "این همه اسم. میکائیل یه اسم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 523.77,
   "end": 528.83,
   "text": "اگر یک حقیقت کلی ثعی اونور وجود داره پس این همه کثرات چیه اونور؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 528.83,
   "end": 531.33,
   "text": "اصلاً بهشت، جهنم، ها؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 531.33,
   "end": 534.91,
   "text": "تعدده. عدده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 534.91,
   "end": 538.45,
   "text": "عقول، عقل‌ها. مگه یک حقیقت نیست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 538.45,
   "end": 540.11,
   "text": "ملکوت مگه یک حقیقت نیست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 540.11,
   "end": 541.73,
   "text": "این کثرات اونور چی کار می‌کنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 541.73,
   "end": 546.51,
   "text": "خب بیا جواب بده. اینا همه جواب‌ها رو بزرگان ما،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 546.51,
   "end": 554.25,
   "text": "حکمای ما در کتاب‌هاشون، مرحوم ابن عربی شیخ اکبر علیه رحمة در فتوحاتش، در فصوصش جواب داده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 554.25,
   "end": 559.69,
   "text": "مرحوم ملاصدرا در اسفارش که ام‌الکتاب فلسفه است جواب داده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 559.69,
   "end": 562.01,
   "text": "حضرت علامه حسن زاده علیه--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 562.01,
   "end": 565.05,
   "text": "سلام-- السلام الله علیه و حفظه الله تعالی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 565.05,
   "end": 568.27,
   "text": "در کتاب‌های مختلفش مثل انسان در عرف انس--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 568.27,
   "end": 570.63,
   "text": "عرفان جواب داده. مثل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 570.63,
   "end": 572.89,
   "text": "مدارج و معارجش جواب داده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 572.89,
   "end": 577.19,
   "text": "در هزار و یک کلمه و هزار نک-- یک نکته‌ش جواب داده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 577.19,
   "end": 580.77,
   "text": "اما شما بفرمایید کدوم یکی از ما دنبال جوابشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 580.77,
   "end": 584.27,
   "text": "مگر امام ما، بزرگ ما، رهبر عزیز ما،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 584.27,
   "end": 589.05,
   "text": "روحش شاد که بنیانگذار بلکه احیاگر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 589.05,
   "end": 592.37,
   "text": "اسلام و تک تک نفوس ما مردم بود،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 592.37,
   "end": 594.25,
   "text": "ما رو با اسلام ناب آشنا کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 594.25,
   "end": 599.97,
   "text": "مگر دعوت از اندیشمندان غربی و شرقی نکرد با همین عناوین که الان من خوندم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 599.97,
   "end": 603.21,
   "text": "مگر اون‌ها رو دعوت نکرد بر سر کتاب محی الدین عربی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 603.21,
   "end": 606.93,
   "text": "مگر اسم نبرد شیخ، شیخ الرئيس ما از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 606.93,
   "end": 609.97,
   "text": "ملاصدراها، محقق طوسی‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 609.97,
   "end": 613.95,
   "text": "گفت بیا سر این کتاب‌ها. چند تا از ما با این‌ها آشناییم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 613.95,
   "end": 617.31,
   "text": "منبرهای ما هم غالباً شده اقناعی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 617.31,
   "end": 618.91,
   "text": "م-مستمع قانع بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 618.91,
   "end": 622.51,
   "text": "یه دو تا د-داستان بگیم چاره‌ای هم نیست چون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 622.51,
   "end": 625.17,
   "text": "حوصله درس و بحث مردم ندارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 625.17,
   "end": 627.35,
   "text": "اما میخوام این رو امروز همینو عرض کنم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 627.35,
   "end": 633.77,
   "text": "انقدر ما نیاز داریم به چکش کاری علمی تو همین مفروضات و من به شما قول میدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 633.77,
   "end": 640.33,
   "text": "من به همه شماهایی که اینجا نشستید دست رو قرآن میذارم قسم یاد می‌کنم به حضرت حق قسم قول میدم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 640.33,
   "end": 645.23,
   "text": "اگر شما فقط یک سیر مطالعاتی علامه حسن زاده رو برید جلو،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 645.23,
   "end": 652.03,
   "text": "میتونم قسم یاد کنم اکثر غریب به اتفاقات مفروضات ذهنی‌تون، برداشت‌های",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 652.03,
   "end": 655.67,
   "text": "اصیل مذهبی و معنوی‌تون رو می‌شورید می‌ذارید کنار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 655.67,
   "end": 659.57,
   "text": "اصلاً یه نگاه جدیدی به دین، به قیامت، به خودتون،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 659.57,
   "end": 663.87,
   "text": "به خدای خودتون و اهل بیت عصمت پیدا می‌کنید و قرآن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 663.87,
   "end": 666.73,
   "text": "همین سیر کتاب معرفت نفس ایشون رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 666.73,
   "end": 671.49,
   "text": "که به نظر بنده حقیر واجب اخلاقی هر کسیه این سیر رو بره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 671.49,
   "end": 675.91,
   "text": "کتاب معرفت نفس سه جلدی ایشون مبتدیات شناخت نفسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 675.91,
   "end": 679.37,
   "text": "همه هم می‌فهمید. برید بگیرید بخوانید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 679.37,
   "end": 685.59,
   "text": "منو به عنوان یه آخوندی که بیاد برای شما دو کلمه حرف بزنه و یه احکام و یه نماز نبینید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 685.59,
   "end": 688.71,
   "text": "این سیر رو برید. بعد کتاب گنجینه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 688.71,
   "end": 692.37,
   "text": "گوهر روان ایشون. حالا ما میگیم نفس‌شناسی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 692.37,
   "end": 696.37,
   "text": "معرفت. اونا، غربیا میگن روان‌شناسی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 696.37,
   "end": 699.69,
   "text": "بعد کتاب اتحاد عاقل به معقول ایشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 699.69,
   "end": 703.19,
   "text": "بعد آخرش دیگه اون س-- پیشرفته‌ترین سیر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 703.19,
   "end": 706.57,
   "text": "مراتب معرفت نفس، کتاب عیون مسائل نفس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 706.57,
   "end": 710.37,
   "text": "شصت و شش عین از مسائل نفس من و شما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 710.37,
   "end": 715.37,
   "text": "که باعث میشه من خودم رو بشناسم، درون خودم چه خبره رو بشناسم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 715.37,
   "end": 718.41,
   "text": "که وقتی از نشئ ملک رفتم به ملکوت کف نکنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 718.41,
   "end": 720.91,
   "text": "اونجا یه دفعه مت-- متحیر نشم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 720.91,
   "end": 723.07,
   "text": "سکره به من، بیهوشی به من دست نده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 723.07,
   "end": 726.08,
   "text": "نگم سکرات مرگی گرفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 726.08,
   "end": 728.02,
   "text": "مثل مولامون امیرالمؤمنین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 728.02,
   "end": 730.86,
   "text": "که لو کشف القتال مزدت یقینا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 730.86,
   "end": 734.2,
   "text": "اگه پرده بره کنار سر سوزنی به یقینش اضافه نمی‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 734.2,
   "end": 737.02,
   "text": "ما میایم بهره‌برداری از مولامون بکنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 737.02,
   "end": 743.56,
   "text": "یهو کپ می‌کنه آدم وقتی میره عمر آقا تق-- دقیقا هرچی دیدیم مغایر با این چیزی بود که شنیدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 743.56,
   "end": 748.86,
   "text": "یه چیز دیگه‌ست اصلا. این‌ها خب باید بریم آدم سیر کنه، بررسی کنه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 748.86,
   "end": 751.54,
   "text": "دنبالش بره. والعلوم الكاظمیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 751.54,
   "end": 758.86,
   "text": "عزیزان دلم علم رو بخواهیم امروز از روضه‌ای که عزیزان الان می‌خوان بخونن بعد نماز عصر هر کی نشست حوصله‌شو داشت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 758.86,
   "end": 762.24,
   "text": "اشکی ریخت التماس کنه از گرفتن علم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 762.24,
   "end": 766.16,
   "text": "عزیزان دلام که اون بحث هر روزه‌مان فعلاً تو بحث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 766.16,
   "end": 770.32,
   "text": "قلب اغلفیم گرفتاری قلب اغلف هم همینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 770.32,
   "end": 775.84,
   "text": "قلبی که در غلافه دچار غفلته میگه آقا پس می‌زنه، علم رو پس می‌زنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 775.84,
   "end": 778.68,
   "text": "پیغمبر اومده بهش علم بده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 778.68,
   "end": 780.96,
   "text": "پس می‌زنه. میگه نمی‌خوام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 780.96,
   "end": 784.42,
   "text": "لذا چی شاملش می‌شه؟ آیه هشتاد و هشت سوره بقره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 784.42,
   "end": 789.56,
   "text": "بخونید با هم من صلوات ازتون بگیرم و قالوا قلوبنا قلف.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 789.56,
   "end": 792.62,
   "text": "چه اتفاقی می‌افته وقتی میگه قلب من اغلفه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 792.62,
   "end": 796.54,
   "text": "یعنی علم رو ناموس حضرت حق رو پس می‌زنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 796.54,
   "end": 798.88,
   "text": "عین اینه که موسی بن جعفر رو پس بزنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 798.88,
   "end": 800.98,
   "text": "عین اینه که حضرت حق رو پس بزنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 800.98,
   "end": 806.08,
   "text": "چه اتفاقی می‌افته؟ بل لعنهم الله بكفرهم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 806.08,
   "end": 807.92,
   "text": "این عین پوشوندن روی حقه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 807.92,
   "end": 810.34,
   "text": "لعنت خدا شامل حالشون می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 810.34,
   "end": 814.26,
   "text": "البته امیدوار باشیم و قلیلا ما يؤمنون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 814.26,
   "end": 817.84,
   "text": "یه عده خیلی قلیلی از همین‌هام اهل ایمان می‌شن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 817.84,
   "end": 819.82,
   "text": "اما کی؟ دیگه تا کی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 819.82,
   "end": 822.38,
   "text": "ریشامون سفید شد. موهامون سفید شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 822.38,
   "end": 827.16,
   "text": "یه حرکتی کنیم امروز عزیز دلم حاج رضا که می‌خونه من خواهش می‌کنم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 827.16,
   "end": 833.96,
   "text": "به ناموس حق قسم که حضرت موسی بن جعفر و علم ذاتی حضرت حق است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 833.96,
   "end": 840.3,
   "text": "که هنوزم که هنوزه م-مکشوف نشدن پنهانن و در خفا حتی برای ما محبینشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 840.3,
   "end": 842.6,
   "text": "قسم بخورید، قسم بدید،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 842.6,
   "end": 847.06,
   "text": "اشک بریزید که ما رو متوجه حقایق نظام هستی بکنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 214,
   "start": 847.06,
   "end": 849.52,
   "text": "از این بی‌خبری بیرون بیاییم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 215,
   "start": 849.52,
   "end": 854.58,
   "text": "انشاالله که عاقبتمون خیر بشه به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 216,
   "start": 854.58,
   "end": 856.94,
   "text": "الله الله الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}