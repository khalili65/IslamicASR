 ],
 "cues": [
  {
   "i": 0,
   "start": 0.52,
   "end": 8.82,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 8.82,
   "end": 11.68,
   "text": "السلام علیک ای داعی الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 11.68,
   "end": 15.08,
   "text": "و ربانی ایاته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 15.08,
   "end": 17.44,
   "text": "یکی دیگه از آیاتی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 17.44,
   "end": 22.72,
   "text": "بهش ما نپرداختیم در خصوص قلب اقلف،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 22.72,
   "end": 25.68,
   "text": "این اکوش اگر روشنه ببخشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 25.68,
   "end": 29.76,
   "text": "آیه صد و پنجاه و پنج سوره نساء هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 29.76,
   "end": 32.32,
   "text": "دقت بفرمایید به این آیه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 32.32,
   "end": 35.06,
   "text": "موضوع قلب اقلف رو چگونه بیان کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 35.06,
   "end": 37.48,
   "text": "خیلی به دردمون می‌خوره این بحث‌ها خیلی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 37.48,
   "end": 44.9,
   "text": "چون اونچه که ما قراره ماحصل عمرمون رو از این دنیا با خودمون ببریم چیزی نیست جز همون قلبمون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 44.9,
   "end": 50.74,
   "text": "که حالا بعداً بحث می‌کنیم که اساساً هر چیزی که مرتبط با قلب باشد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 50.74,
   "end": 55.5,
   "text": "چه گناهی است که مرتبط با قلب باشد اون می‌ماند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 55.5,
   "end": 62.54,
   "text": "و اون گناه محسوب می‌شود و چه عملی که مرتبط با قلب باشد اون هم می‌ماند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 62.54,
   "end": 64.14,
   "text": "و حساب و کتاب می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 64.14,
   "end": 71.72,
   "text": "هر چیزی مرتبط با قلب نباشه حتی اگر خطایی بر اساس آیه قرآن که حالا بعداً بحث می‌کنیم الان وقت نیست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 71.72,
   "end": 74.36,
   "text": "انجام بشه خدا منظور نمی‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 74.36,
   "end": 77.78,
   "text": "پس خیلی مهمه. در اینجا در این آیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 77.78,
   "end": 81.98,
   "text": "ابتداً می‌فرماید فبما نقضهم ميثاقهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 81.98,
   "end": 87.0,
   "text": "این یه گناه. به خاطر اون نقض پیمانی که داشتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 87.0,
   "end": 90.52,
   "text": "و کفرهم بآیات الله، کفر به آیات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 90.52,
   "end": 92.92,
   "text": "خدا و این دومیش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 92.92,
   "end": 97.44,
   "text": "و قتلهم الأنبياء بغير حق، به غیر حق کشتن انبیا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 97.44,
   "end": 101.58,
   "text": "نه اینکه کشتن انبیا می‌شه به حق هم باشه ها نه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 101.58,
   "end": 104.52,
   "text": "موضوع این نیست. یعنی اساساً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 104.52,
   "end": 108.4,
   "text": "این کار به حق نبوده مطلقاً.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 108.4,
   "end": 116.06,
   "text": "اینم سومین گناه. چهارمین گناه که حالا خیلی نهیب داره که این‌ها رو در عرض هم خدا مطرح کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 116.06,
   "end": 123.4,
   "text": "شاید حالا اینم باز بعد بعداً انشاالله اگر فرصت بشه، توفیق بشه بحث کنیم که شاید ماها متوجه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 123.4,
   "end": 130.44,
   "text": "قبح و زشتی این گناه قلب یعنی گرفتاری قلب اقل-اقلف نشدیم که خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 130.44,
   "end": 134.9,
   "text": "به اجبار اومده سه تا گناه رو زمینه کرده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 134.9,
   "end": 140.32,
   "text": "برای اینکه ما متوجه زشتی این قلب اقلف بشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 140.32,
   "end": 146.0,
   "text": "یعنی کأنّ که به قول آیه قرائتی که این‌ها رو تو یک با همدیگه مطرح کرده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 146.0,
   "end": 148.34,
   "text": "بالاخره یه خبری هست دیگه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 148.34,
   "end": 150.44,
   "text": "این‌ها رو پشت سر هم آورده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 150.44,
   "end": 152.86,
   "text": "فبما نقضهم ميثاقهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 152.86,
   "end": 157.3,
   "text": "نقض پیمان. و کفرهم بآیات الله، کفر به آیات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 157.3,
   "end": 160.0,
   "text": "و قتلهم الأنبياء بغير حق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 160.0,
   "end": 164.8,
   "text": "حالا جالبه که این‌ها که پیغمبر رو نکشته بودن که پیغمبرها رو، انبیا رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 164.8,
   "end": 167.84,
   "text": "الان زمان پیغمبر اکرمه مربوط به اون زمانه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 167.84,
   "end": 172.12,
   "text": "میگه قتلهم ال این‌ها کشتن انبیا رو بغير حق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 172.12,
   "end": 176.06,
   "text": "خب چه ربطی به این‌ها داره؟ چون این‌ها راضی بودن به کار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 176.06,
   "end": 181.38,
   "text": "پدراشون. این‌ها هم نوشته شده و منظور شده براشون که حالا این‌ها رو حالا بعداً بحث می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 181.38,
   "end": 184.88,
   "text": "قابل توجه اینه که پادشاهان قدیم رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 184.88,
   "end": 189.58,
   "text": "مرحوم خطاب می‌کنند مثلاً رحمت، میگن خدا رحمت کنه شاه فلان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 189.58,
   "end": 192.24,
   "text": "این‌ها بعد این‌ها همه چی‌ان؟ راضی‌ان به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 192.24,
   "end": 195.74,
   "text": "کردار اون‌ها و همه گناهان این پادشاهان و شاهنشاهان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 195.74,
   "end": 200.4,
   "text": "قدیم برای اون‌ها منظور می‌شه که حالا جای بحث داره و قولهم اینجا می‌رسیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 200.4,
   "end": 202.4,
   "text": "باز اینجا تو اون آیه هشتاد و هشت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 202.4,
   "end": 210.02,
   "text": "سوره بقره می‌فرماید و قالوا گفتند قلوبنا غلف و اینجا دوباره می‌فرماید گناه بعدی رو که مطرح می‌کنه و قولهم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 210.02,
   "end": 212.94,
   "text": "خیلی جالبه باز اشاره به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 212.94,
   "end": 216.44,
   "text": "این قولشون، گفته‌شون می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 216.44,
   "end": 219.6,
   "text": "که حالا چرایش قبلاً بحث شده چرا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 219.6,
   "end": 223.3,
   "text": "و قولهم قلوبنا غلف.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 223.3,
   "end": 225.74,
   "text": "انقدر زشته این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 225.74,
   "end": 233.94,
   "text": "حالت، انقدر این حالت در برابر حقایق نظام هستی و دعوت حضرت پیغمبر که با قرآن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 233.94,
   "end": 237.5,
   "text": "به عبارتی معدبت الله اومده به سراغ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 237.5,
   "end": 240.88,
   "text": "خلائق که اون‌ها رو بکشونه سر سفره حضرت حق،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 240.88,
   "end": 244.86,
   "text": "پس زدن این قرآن رو و دعوت رو انقدر زشته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 244.86,
   "end": 249.36,
   "text": "که این‌ها رو اولاً در عرض اون گناه‌ها قرار داده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 249.36,
   "end": 252.32,
   "text": "این حالت رو، این حالت اینکه انسان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 252.32,
   "end": 259.5,
   "text": "گمان کنه وجودش پره از این حقایق و معارف، اصلاً نیازی به گوش دادن به این حقایق نداره دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 259.5,
   "end": 268.1,
   "text": "گفتیم یکی از تعابیری که مفسرین کردن این بود دیگه که میگن قلوبنا غلف مثل شمشیره در غلاف،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 268.1,
   "end": 270.88,
   "text": "قلب ما، گوش ما پره از این حرف‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 270.88,
   "end": 274.42,
   "text": "تا دلت بخواد ما این‌ها رو می‌دونیم و شنیدیم و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 274.42,
   "end": 279.18,
   "text": "پس می‌زنن حقایق رو. از حقایق، از اسرار، از علوم فرار می‌کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 279.18,
   "end": 283.8,
   "text": "که به قول upstate علامه حسن زاده چنین چیزی اصلاً نشانه مریضی قلبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 283.8,
   "end": 289.56,
   "text": "کسی بسنده کنه به یک حدی از رشد، از علم، از تعالی، از عبادت اینا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 289.56,
   "end": 295.22,
   "text": "مریض دل‌اند. حالا انقدر زشته که خدا می‌فرماید صراحتاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 295.22,
   "end": 300.22,
   "text": "بلافاصله بعد از معرفی این چهار دسته گناه در عرض هم بل تبع،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 300.22,
   "end": 304.54,
   "text": "تبع، تبع الله علیها بکفرهم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 304.54,
   "end": 309.5,
   "text": "اینجا بعد می‌ریم سراغ قلب مطبوع که قلب‌هایی که هنوز بررسی نکردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 309.5,
   "end": 313.26,
   "text": "قلبی که مطبوع می‌شه با تای دسته‌دار و عین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 313.26,
   "end": 316.74,
   "text": "یعنی مهر می‌خوره. بل تبع الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 316.74,
   "end": 321.54,
   "text": "علیها بکفرهم. این‌ها رو به خاطر کفرشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 321.54,
   "end": 325.48,
   "text": "مهر می‌زنه خدا به دلاشون. البته باز یه نقطه امیدی هست ولا يؤمنون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 325.48,
   "end": 331.76,
   "text": "إلا قليلا، یه عده قلیلشون ایمان میارن که این قبلاً بحث شد که چرا این‌ها عده قلیلی هستند و این‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 331.76,
   "end": 337.8,
   "text": "موضوعی که امروز می‌خوایم بهش توجه کنیم اینه که چی رو خ-- این‌ها پس زدن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 337.8,
   "end": 344.32,
   "text": "معدبت الله رو. یا به عبارتی اگر بگیریم با فتح دال بخونیم مأدبت الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 344.32,
   "end": 348.28,
   "text": "یه روایتی هست من بارها دیدم از علامه حسن زاده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 348.28,
   "end": 352.72,
   "text": "این روایت شریف رو مورد توجه قرار دادن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 352.72,
   "end": 356.22,
   "text": "من بررسی کردم دیدم تو چند تا کتاب مهم ما هم هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 356.22,
   "end": 363.3,
   "text": "البته از علامه، علامه در کتاب انسان در قرآنشون اینو میارن و بحث شیرینی پیاده می‌کنن در کنارش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 363.3,
   "end": 367.76,
   "text": "می‌تونید این کتابو بخونید کتاب بسیار زیبا و عرشی‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 367.76,
   "end": 372.52,
   "text": "اما در کتاب مثلا مجمع البیان، جلد یک، صفحه شونزده دیدم هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 372.52,
   "end": 375.78,
   "text": "در کتاب بهار هست، در کنز العمال هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 375.78,
   "end": 380.24,
   "text": "این حدیث خیلی شیرین می‌فرماید دقت کنید چقدر حدیث جالبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 380.24,
   "end": 382.34,
   "text": "\"إن هذا القرآن\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 382.34,
   "end": 384.68,
   "text": "قطعاً این قرآن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 384.68,
   "end": 387.1,
   "text": "\"معدوبة الله\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 387.1,
   "end": 390.84,
   "text": "معدوبة اگر معدوبة رو با ف--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 390.84,
   "end": 393.72,
   "text": "ضم دال بگیریم بگیم معدوبة",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 393.72,
   "end": 396.12,
   "text": "فرمودن که سفره‌ی طعامه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 396.12,
   "end": 400.08,
   "text": "طعامیه که میزبان آماده می‌کنه برای مهمان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 400.08,
   "end": 404.64,
   "text": "اگر به فتح دال بگیریم بگیم معدبة یعنی ادبستان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 404.64,
   "end": 409.68,
   "text": "قرآن ادبستانه، ادب کننده‌ست، تأدیب کننده‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 409.68,
   "end": 414.02,
   "text": "حد هر کسی رو مشخص می‌کنه که تو، تو چه حدودی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 414.02,
   "end": 417.62,
   "text": "زندگی کنی تا مؤدب به آداب الله بشی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 417.62,
   "end": 420.36,
   "text": "در هر صورت میگه این قرآن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 420.36,
   "end": 424.12,
   "text": "سفره و طعام حضرت حق است یا ادبستان است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 424.12,
   "end": 427.46,
   "text": "\"فتعلموا معدوبته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 427.46,
   "end": 431.04,
   "text": "ما استطعتم\". هر چقدر استطاعت دارید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 431.04,
   "end": 434.76,
   "text": "تعلیم بگیرید از این معدوبه‌ی الهی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 434.76,
   "end": 438.18,
   "text": "بعد نهیب می‌زنه پیغمبر فرموده این حدیث رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 438.18,
   "end": 441.38,
   "text": "و \"إن أسفر البيوت\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 441.38,
   "end": 449.74,
   "text": "می‌خواید به شما بگم تهی‌ترین، خالی‌ترین به عبارتی فقیرترین، بی‌چیزترین خونه‌ها کدوم خونه‌ست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 449.74,
   "end": 452.74,
   "text": "لا، لام تأکید. \"لا بيت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 452.74,
   "end": 454.98,
   "text": "أسفر من كتاب الله\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 454.98,
   "end": 458.6,
   "text": "قطعاً اون خونه‌ایه که خالیه از کتاب خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 458.6,
   "end": 462.12,
   "text": "خالیه که تو خونه‌ی همه‌ی ما کتاب خدا هست که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 462.12,
   "end": 468.66,
   "text": "پیداست که این من-- منظور پیاده نشدن آیات الهی در زندگی و در سبکی که زندگی و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 468.66,
   "end": 471.46,
   "text": "در معاشرت‌ها و به هر حال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 471.46,
   "end": 478.98,
   "text": "عرض شود اون مسائل زناشویی، تربیت فرزند، کسب و درآمد و چه و چه همه‌ی این‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 478.98,
   "end": 481.86,
   "text": "که حالا اینجا علامه البته ص-- خیلی بحث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 481.86,
   "end": 485.56,
   "text": "زیبایی اینجا دارن برید رجوع کنید به اون کتاب فرصت نیست من عرض کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 485.56,
   "end": 490.28,
   "text": "بحثمون امروز اشاره به این نکته‌ست که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 490.28,
   "end": 495.6,
   "text": "خدای منان مهمانی‌ای به پا کرده که مهمانش انسان است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 495.6,
   "end": 500.46,
   "text": "بقیه مستقیماً مهمان حضرت حق حساب نمی‌شن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 500.46,
   "end": 503.72,
   "text": "اون‌ها در سیر تطور و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 503.72,
   "end": 510.74,
   "text": "تبدل امثال و این‌ها حرکت جوهری، نف-- جمادات همه‌ی همتشون اینه که بشن نبات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 510.74,
   "end": 514.06,
   "text": "قبله‌شون نباته. نباتات قبله‌شون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 514.06,
   "end": 517.94,
   "text": "حیوانه. همه‌ی همتشون مصروف به اینه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 517.94,
   "end": 519.94,
   "text": "حیوان این‌ها رو بخوره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 519.94,
   "end": 523.9,
   "text": "حیوان بشوند. حیوانات قبله‌شون انسانه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 523.9,
   "end": 526.92,
   "text": "انسان بیاد این‌ها رو بخوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 526.92,
   "end": 530.8,
   "text": "کمال یک گوسفند اینه که انسان اون رو بخوره، نه تلف شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 530.8,
   "end": 533.14,
   "text": "اونم انسانه، نه هر انسانی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 533.14,
   "end": 536.9,
   "text": "انسان منطقی، نه. نه یعنی صرفاً حیوان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 536.9,
   "end": 540.1,
   "text": "ناطق، نه. انسان در عرف ع--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 540.1,
   "end": 543.76,
   "text": "عرفان که در رساله از تعلم شرح مبسوطی داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 543.76,
   "end": 545.32,
   "text": "قبله‌ی حیوان می‌شه انسان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 545.32,
   "end": 547.1,
   "text": "قبله‌ی انسان کی می‌شه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 547.1,
   "end": 553.18,
   "text": "می‌شه انسان کامل. این سیر مدارج که انسان کامل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 553.18,
   "end": 555.34,
   "text": "در حقیقت اگر ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 555.34,
   "end": 559.88,
   "text": "همه‌ی هدفمون باید این باشه که انسان کامل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 559.88,
   "end": 563.22,
   "text": "ما بشیم یک شأنی از شؤون وجودی او.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 563.22,
   "end": 567.86,
   "text": "بریم تو وجود او در قلب او سیر کنیم، در جان او جای بگیریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 567.86,
   "end": 573.0,
   "text": "حالا این بحثی‌ست بماند. در هر حال انسان است که مهمان است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 573.0,
   "end": 577.32,
   "text": "بقیه مهمان انسان‌اند. انسان مهمان خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 577.32,
   "end": 579.5,
   "text": "حالا اون طعام چی بوده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 579.5,
   "end": 582.88,
   "text": "این حدیث داره بیان می‌کنه. معدوبة الله چی بود؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 582.88,
   "end": 584.94,
   "text": "قرآن. قرآن طعامه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 584.94,
   "end": 587.94,
   "text": "شما زشته چقدر که به مهمانی بروی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 587.94,
   "end": 593.56,
   "text": "میزبان بهترین غذا رو نسبت به سعه‌ی وجودی و اشتهای تو \"لهم ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 593.56,
   "end": 597.12,
   "text": "يشتهون\". \"لهم فیها ما يشاءون\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 597.12,
   "end": 601.7,
   "text": "هرچی که انشا-- دوست داری، دلت می‌خواد، اشتها کردی، هرچی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 601.7,
   "end": 604.44,
   "text": "برات سر سفره بذاره بعد تو پس بزنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 604.44,
   "end": 606.46,
   "text": "خیلی گناه بدیه دیگه. این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 606.46,
   "end": 611.7,
   "text": "در حقیقت صاحبان قلب اغلف یا قلوب قلف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 611.7,
   "end": 613.24,
   "text": "زشتی‌شون اینطوریه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 613.24,
   "end": 617.96,
   "text": "حالا متوجه می‌شیم. میان پس می‌زنن معدوبة الله رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 617.96,
   "end": 619.64,
   "text": "طعام الهی رو پس می‌زنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 619.64,
   "end": 627.52,
   "text": "آقا همه‌ی این عرش و فرش و کرسی و ملائکه و این آسمان‌ها و حرف فلک و کرخ گردون و همه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 627.52,
   "end": 630.68,
   "text": "به پا شده که خدا برای تو مهمانی داده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 630.68,
   "end": 635.72,
   "text": "که تو مؤدب بشی به آداب الله، متلبس بشی به اسماء الله،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 635.72,
   "end": 639.06,
   "text": "بعد تو پس بزنی. اون چی رو؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 639.06,
   "end": 642.1,
   "text": "معدوبة رو، اون طعام سر سفره رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 642.1,
   "end": 646.16,
   "text": "اون موقع تو اصلاً دیگه مهمان نیستی که وقتی مهمان از چیزی نخوری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 646.16,
   "end": 650.2,
   "text": "بی‌احترامی به میزبان بکنی، مهمان حساب نمی‌شی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 650.2,
   "end": 652.72,
   "text": "تو عذر می‌خوام می‌شی حیوان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 652.72,
   "end": 655.4,
   "text": "\"أولئک كالأنعام بل هم أضل\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 655.4,
   "end": 658.48,
   "text": "بدتر از اون یعنی می‌شی معذرت می‌خوام مثل ج--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 658.48,
   "end": 661.22,
   "text": "نباتات زندگی کردن مثل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 661.22,
   "end": 666.7,
   "text": "جمادات زندگی، زند-زندگی جمادی بعضیا دارن، سنگ دل‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 666.7,
   "end": 669.46,
   "text": "حالا پس این رو در نظر داشته باشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 669.46,
   "end": 676.18,
   "text": "اگر خدای منان اومده این حالت قلب اغلف رو در کنار اون سه تا گناه سنگین،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 676.18,
   "end": 680.74,
   "text": "پیمان شکنی، کفر به آیات و کشتن انبیا و اولیا حق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 680.74,
   "end": 682.94,
   "text": "معرفی کرده به جهت اینه که چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 682.94,
   "end": 685.8,
   "text": "معدوبة الله رو پس زدن این‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 685.8,
   "end": 688.96,
   "text": "قرآن براشون اومد و اینا گفته نمی‌خوایم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 688.96,
   "end": 690.56,
   "text": "دل ما پره از این حرف‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 690.56,
   "end": 692.56,
   "text": "ما بلدیم خودمون راه رو می‌دونیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 692.56,
   "end": 697.14,
   "text": "ولمون کن آقا جون. چقدر ما به علما و الان بزرگانمون،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 697.14,
   "end": 700.5,
   "text": "مراجع‌مون که به هر حال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 700.5,
   "end": 702.84,
   "text": "مرجع‌اند دیگه باید بهشون رجوع کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 702.84,
   "end": 709.04,
   "text": "مخصوصاً این علمایی که جامع الشرايطند، جامع الاطراف‌اند مثل حضرت علامه حسن زاده و اینا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 709.04,
   "end": 717.36,
   "text": "چقدر ما اینا رو سفره‌ای که ایناست در کتاب‌هاشون، در کتاب‌های عرشی‌شون برای ما پیاده کردن از آیات رو پس زدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 717.36,
   "end": 720.54,
   "text": "چقدر پس زدیم، چقدر بی‌توجه کردیم به آیات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 720.54,
   "end": 724.8,
   "text": "چند تامون در روز داریم تدبر در قرآن می‌کنیم خدا وکیلی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 724.8,
   "end": 729.46,
   "text": "چند دقیقه وقت برای عبور از ظاهر به باطن قرآن گذاشتیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 729.46,
   "end": 734.12,
   "text": "حالا بعد انشاالله فردا می‌گیم که مثلاً یه سفره باز کنیم از مثلاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 734.12,
   "end": 738.54,
   "text": "مثل یکی مثل شیخ خواجه نصیر طوسی از قرآن ببینید چقدر زیبا همین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 738.54,
   "end": 744.52,
   "text": "سوره ولعصر رو که ما می‌خونیم و رد می‌شیم رو باز کرده برای ما توضیح داده که تو این سوره چه خبره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 744.52,
   "end": 746.9,
   "text": "آدم دوست داره سر به بیابون بگذاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 746.9,
   "end": 750.12,
   "text": "واقعاً خدا ما رو از این غلاف غفلت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 750.12,
   "end": 752.98,
   "text": "و قلب اغلف نجات بدهد انشاالله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 752.98,
   "end": 756.9,
   "text": "به برکت صلوات بر محمد و آل محمد. الله اکبر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}