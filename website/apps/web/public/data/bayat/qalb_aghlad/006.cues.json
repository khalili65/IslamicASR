 "chapters": [
  {
   "index": 0,
   "title": "## میلاد جواد و سه نیاز مؤمن",
   "start": 0.26,
   "end": 30.2
  },
  {
   "index": 1,
   "title": "## قلوبنا غلف و مراتب گوش‌نبستن",
   "start": 30.2,
   "end": 187.54
  },
  {
   "index": 2,
   "title": "## امتحان سنگین شیعه با امامتِ کودک",
   "start": 187.54,
   "end": 240.74
  },
  {
   "index": 3,
   "title": "## معجزات و نورِ ولادت",
   "start": 240.74,
   "end": 325.3
  },
  {
   "index": 4,
   "title": "یکی از بزرگان می‌گفت اگر قرآن دو آیه بیش نداشت بس بود:",
   "start": 325.3,
   "end": 345.36
  },
  {
   "index": 5,
   "title": "## نماز معراج و پرهیز از قلب اغلف",
   "start": 345.36,
   "end": 764.52
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.26,
   "end": 7.48,
   "text": "اینجا آیات، سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 7.48,
   "end": 10.44,
   "text": "امام جواد صلوات الله عليه ایام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 10.44,
   "end": 13.66,
   "text": "میلاد این بزرگوار هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 13.66,
   "end": 21.64,
   "text": "یه حدیث معروفی دارن که حالا قسمت سومش مربوط به بحث هر روز ماست، قلب اغلف.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 21.64,
   "end": 24.6,
   "text": "اون هم حضرت می‌فرمایند که المؤمن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 24.6,
   "end": 27.7,
   "text": "يحتاج إلى ثلاث. هر مؤمنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 27.7,
   "end": 32.06,
   "text": "احتیاج داره به سه چیز. الان به ما بگن احتیاجاتی زندگیتو بشمر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 32.06,
   "end": 37.12,
   "text": "چی می‌شماریم؟ چند تا؟ غالباً مسائل دنیوی و مالی و...",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 37.12,
   "end": 41.6,
   "text": "اما حضرت سه تا چیزو نیاز ضروری و احتیاج مبرم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 41.6,
   "end": 45.3,
   "text": "هر مؤمنی شمردند. اول فرمودند التوفيق من الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 45.3,
   "end": 49.06,
   "text": "اونم توفیقی که از سمت خدا بیاد نه خودت برای خودت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 49.06,
   "end": 51.62,
   "text": "بازی درآری گمان کنی که حالا موفق بودی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 51.62,
   "end": 54.16,
   "text": "نه، توفیق از سمت بالا میاد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 54.16,
   "end": 58.42,
   "text": "که هندسه توفیق بالا به پایینه، هندسه اخلاص پایین به بالاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 58.42,
   "end": 61.18,
   "text": "تو اخلاص به خرج بدی بری بالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 61.18,
   "end": 63.64,
   "text": "از اون بالا هم توفیق میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 63.64,
   "end": 69.64,
   "text": "بعد فرمودند واعظ من نفسه در درون خودش هر مؤمنی یه واعظی باشه که هی دائماً چیکار کنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 69.64,
   "end": 75.42,
   "text": "نصیحتش کنه. خودش رو، خودش، خودش رو وعظ کنه، خطاب کنه، مراقبت کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 75.42,
   "end": 79.7,
   "text": "سوم که بیشتر منظورمون این هست فرمودند که قبول",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 79.7,
   "end": 84.56,
   "text": "من من ینسخه هر کس که نصیحتش کردین بپذیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 84.56,
   "end": 89.34,
   "text": "چون تو آیه هشتاد و هشت سوره بقره عرض کردیم که مشرکین و کفار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 89.34,
   "end": 94.32,
   "text": "به پیغمبر می‌گفتن و قلوبنا قلف.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 94.32,
   "end": 99.92,
   "text": "می‌گفتن که آقا دل ما تو یه غلافی قرار گرفته، قلب اغلف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 99.92,
   "end": 106.66,
   "text": "و توجه نمی‌کردند به صحبت‌های پیغمبر که حالا سه وجه داشت که بیشتر مفسرین فرموده بودند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 106.66,
   "end": 108.94,
   "text": "الان هم این چنین هست. خیلی از ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 108.94,
   "end": 113.72,
   "text": "البته این مراتب داره. اینکه گوش به حرف ندیم مراتب داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 113.72,
   "end": 120.2,
   "text": "خب یه وقت بنا به فرمایش امام جواد صلوات الله عليه حتی بچه هم آدم رو نصیحت کرد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 120.2,
   "end": 128.26,
   "text": "باید توجه کرد. در کتاب جواهر الثنیة فی أحادیث القدسیه حدیث عجیب قدسی دیدم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 128.26,
   "end": 130.84,
   "text": "حضرت داوود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 130.84,
   "end": 135.0,
   "text": "سلام الله عليه وقتی می‌خواستن کسی رو اعدام کنن، حالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 135.0,
   "end": 137.9,
   "text": "حد جاری کنن و اعدامش کنن، بکشنش،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 137.9,
   "end": 140.54,
   "text": "حضرت فرمود دست نگه دارید. رفت گفت منو نصیحت کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 140.54,
   "end": 142.86,
   "text": "به یه آدم گناهکاری که می‌خوان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 142.86,
   "end": 146.1,
   "text": "بکشنش گفت منو نصیحت کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 146.1,
   "end": 148.48,
   "text": "به این مقام خیرخواهی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 148.48,
   "end": 150.98,
   "text": "همه جا در و دیوار می‌تونه آدم رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 150.98,
   "end": 154.14,
   "text": "نصیحت کنه. ما أكثر العبر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 154.14,
   "end": 156.42,
   "text": "و أقل الاعتبار ملا علی فرمود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 156.42,
   "end": 160.98,
   "text": "در و دیوار می‌تونن عبرت بدن به انسان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 160.98,
   "end": 163.44,
   "text": "پس آدم اگه بچه، منتها این مراتب داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 163.44,
   "end": 168.94,
   "text": "اون کجا که آدم حرف یه بچه رو گوش نده، حرف یه آدم گناهکار یا جاهل رو توجه نکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 168.94,
   "end": 172.42,
   "text": "اون کجا که بی‌توجهی کنه به یک حرف عالم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 172.42,
   "end": 175.92,
   "text": "به حرف یک آدم متخصص و اون کجا که به حرف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 175.92,
   "end": 178.54,
   "text": "پیغمبر خدا، عقل کل،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 178.54,
   "end": 183.34,
   "text": "ختم رسل گوش نده. حرف انبیا رو گوش نده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 183.34,
   "end": 187.06,
   "text": "این دیگه خیلی مراتبش سنگین‌تره دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 187.06,
   "end": 189.48,
   "text": "البته شیعیان در زمان امام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 189.48,
   "end": 193.4,
   "text": "جواد صلوات الله عليه امتحان سنگینی رو پس دادن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 193.4,
   "end": 195.8,
   "text": "الحمد لله رو سفید هم درومدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 195.8,
   "end": 199.82,
   "text": "یعنی هیچ دوره‌ای مثل این دوره امتحان سنگین نبوده ظاهراً.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 199.82,
   "end": 202.92,
   "text": "چون هیچ امامی در هشت نه سالگی امام نشد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 202.92,
   "end": 208.7,
   "text": "شما تصور کنید یه پسره هشت نه ساله به شما بگن آقا این آقا پسره هشت نه ساله که هنوز به سن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 208.7,
   "end": 211.94,
   "text": "تکلیف هم نرسیده امام شماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 211.94,
   "end": 215.8,
   "text": "یعنی به راه‌های آسمان واقف‌تره تا زمین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 215.8,
   "end": 223.1,
   "text": "همه علم خدا نه اون-- آنچه که داشته‌هایی که در خصوص امام داری باید پیاده کنی روی پسر هشت نه ساله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 223.1,
   "end": 225.88,
   "text": "سخته. واقعاً کار، اونم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 225.88,
   "end": 233.18,
   "text": "امام رضا چرا فرمود برای شیعیان ما پربرکت‌ترین مولود اهل بیت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 233.18,
   "end": 236.06,
   "text": "پسرم جواد الأئمة سلام الله عليه هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 236.06,
   "end": 239.42,
   "text": "یه وجهش اینه دیگه. تا چهل و هفت سالگی امام رضا بچه‌دار نشد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 239.42,
   "end": 242.56,
   "text": "شوخی نیست. امتحان‌های خدا عجیبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 242.56,
   "end": 244.34,
   "text": "عجیبه واقعاً امتحانات خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 244.34,
   "end": 246.54,
   "text": "تا چهل و هفت سالگی بچه‌دار نمی‌شد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 246.54,
   "end": 250.16,
   "text": "که بهش گفتن عبتر. استغفرالله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 250.16,
   "end": 254.66,
   "text": "در سال صد و نود و پنج هجری بود دیگه آخر عمر حضرت بود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 254.66,
   "end": 257.32,
   "text": "که بچه‌دار شدن حضرت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 257.32,
   "end": 262.18,
   "text": "و خدا البته معجزات عجیبی هم از امام جواد صلوات الله عليه نشون داد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 262.18,
   "end": 267.02,
   "text": "این معجزات رو هم باید در نظر گرفت اما باز سخته .",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 267.02,
   "end": 274.32,
   "text": "مثلاً اینکه حضرت دو سه روزه بودند وقتی که شیعیان اومدن تبریک بگن به امام رضا صلوات الله عليه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 274.32,
   "end": 280.52,
   "text": "تو همون حالت بچگی حالا تو گهواره هرچی حضرت شروع کرد شهادتین گفتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 280.52,
   "end": 283.36,
   "text": "همه شنیدن و سجده کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 283.36,
   "end": 287.14,
   "text": "تو اون حالتی که اصلاً بچه نمی‌تونه تکون بخوره، نمی‌تونه لب باز کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 287.14,
   "end": 290.48,
   "text": "به قدرت حضرت حق. این رو دیدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 290.48,
   "end": 292.2,
   "text": "شیعیان دیدن. این‌ها رو هم دیدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 292.2,
   "end": 294.7,
   "text": "این‌ها رو هم باید گفت. اما بازم سخته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 294.7,
   "end": 301.32,
   "text": "و خیلی‌ها چیـ، چیزهای این چنینی گفتن، گفتن استغفرالله سحره، جادوعه پیغمبر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 301.32,
   "end": 306.48,
   "text": "و یکی از کارهای عجیبی که خدا کرد در خصوص حضرت جواد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 306.48,
   "end": 310.16,
   "text": "خیلی جالبه، خیلی-- توش نکات عجیبی هست این.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 310.16,
   "end": 313.74,
   "text": "پس معمولاً به عنوان یک داستان، یک قصه شیرین میان می‌گن می‌رن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 313.74,
   "end": 315.84,
   "text": "اما تو اون نقطه‌ها، اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 315.84,
   "end": 318.68,
   "text": "سررشته‌هاشو دست بگیری سر نخ،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 318.68,
   "end": 323.26,
   "text": "وقتی که حضرت می‌خواست به دنیا بیاد یه چراغی تو خونه امام رضا بود خاموش شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 323.26,
   "end": 325.3,
   "text": "اصلاً خدا خواست این چراغا خاموش شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 325.3,
   "end": 333.28,
   "text": "تاریکی محض. امام جواد صلوات الله عليه به محض اینکه به دنیا اومد کل خونه حضرت روشن شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 333.28,
   "end": 336.34,
   "text": "خب این خیلی این نکته‌ست اصلاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 336.34,
   "end": 341.72,
   "text": "که باید تاریک می‌شد که نور ایشون جلوه کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 341.72,
   "end": 345.36,
   "text": "یعنی هر وقت تاریک شد حواستون باشه یه نوری به نام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 345.36,
   "end": 349.32,
   "text": "نور ولایت هست. سردرگم نیستیم ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 349.32,
   "end": 352.58,
   "text": "منتها خب دیگه و قلوبنا قلف به شرطی که نگیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 352.58,
   "end": 354.48,
   "text": "نگیم بابا گوش ما از این حرفا پره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 354.48,
   "end": 359.88,
   "text": "ولمون کن بابا این حرفا برامون سنگینه یا ما نمی‌فهمیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 359.88,
   "end": 365.28,
   "text": "به نظر شما ما بیشتر می‌فهمیم یا مثلاً علامه حسن زاده‌ها؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 365.28,
   "end": 373.64,
   "text": "یا شیخ الرایس‌ها که کتاب‌هاش الان تو دانشگاه‌های خارج از کشور متاسفانه از این جهت که کشور خودمون بی‌رغبته،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 373.64,
   "end": 376.28,
   "text": "اونجا داره تدریس می‌شه اینجا نه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 376.28,
   "end": 378.48,
   "text": "یا ملاصدراها که یا ف--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 378.48,
   "end": 382.98,
   "text": "ابن عربی‌ها که امام بزرگ ما حضرت امام به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 382.98,
   "end": 386.56,
   "text": "گورباچف وقتی نامه نوشت گفت بیاید سر کتاب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 386.56,
   "end": 392.46,
   "text": "فسوس ابن عربی، سر کتاب اسفار ملاصدرا ببینید چی داریم ما برای شما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 392.46,
   "end": 395.84,
   "text": "اون که بزرگ ما بود. ما کی نشستیم رو این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 395.84,
   "end": 399.16,
   "text": "مبانی کار کردن؟ کی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 399.16,
   "end": 402.14,
   "text": "خود عالمه‌ حسن‌زاده می‌فرمود من",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 402.14,
   "end": 405.92,
   "text": "منظومه ملا هادی سبزواری زیر بغلم بود، طلبه بودم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 405.92,
   "end": 411.64,
   "text": "داشتم می‌رفتم یه آدم حالا یه آخوند سن و سالداری منو دید گفت منظومه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 411.64,
   "end": 417.56,
   "text": "باز کرد گفت ببین اینجا مثلا نوشته اعاده المعدومه امتنا--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 417.56,
   "end": 425.3,
   "text": "امتنع. مثلا اینکه معدوم بخواد برگرده دوباره وجود پیدا کنه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 425.3,
   "end": 428.16,
   "text": "این محاله. اینا اصلا قبول نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 428.16,
   "end": 433.54,
   "text": "یعنی ما حال-- حاجی ملا هادی سبزواری علیه الرحمه این مثلا معاد رو قبول نداشته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 433.54,
   "end": 436.84,
   "text": "نه تو نفهمیدی معاد چیه، نه که اون قبول نداشته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 436.84,
   "end": 439.56,
   "text": "تو معنای معاد رو نفهمیدی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 439.56,
   "end": 442.22,
   "text": "اینکه این جسم اینجا معدوم شد رفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 442.22,
   "end": 449.1,
   "text": "معدوم شد از بین رفت. اصلا شد یه چیزی رفت تو دل یک گرگی، یه نمی‌دونم درختی، سنگ شد اصلا خاک شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 449.1,
   "end": 452.78,
   "text": "خاک گل کوزه گران خواهیم شد، میگن خاک کوزه شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 452.78,
   "end": 455.96,
   "text": "خب این بخواد برگرده دوباره به اون شکل، خب این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 455.96,
   "end": 458.78,
   "text": "معدوم شده اصلا این جسم دوباره برگرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 458.78,
   "end": 460.84,
   "text": "ما نمی‌گیم که قیامت نیست که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 460.84,
   "end": 464.44,
   "text": "می‌گیم این چیزی که معدوم شد دیگه برگشتش محاله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 464.44,
   "end": 467.94,
   "text": "می‌گیم اصلا بدن همیشه با ما هست، این جسم رفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 467.94,
   "end": 473.04,
   "text": "بدن برزخی که هست. برای چی خدا بیاد چیزی که از بین رفته دوباره برش گردونه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 473.04,
   "end": 477.6,
   "text": "خب بدن برزخی من که هست تو خواب دارم باهاش این ور اون ور میرم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 477.6,
   "end": 480.96,
   "text": "انقدر بحث‌های شیرین جوابشه نمی‌شه نه جواب بگیرن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 480.96,
   "end": 487.42,
   "text": "همین یه دفعه میگن آها انکار خدا نکنه مسلمین هم دست به انکار کسی بزنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 487.42,
   "end": 494.1,
   "text": "انقدر براش متاسفانه پرونده‌سازی هم می‌کنن، آبروشو می‌برن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 494.1,
   "end": 498.12,
   "text": "و خدا وکیلی خود علامه می‌گه من اینو که شنیدم یه لحظه ریختم به هم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 498.12,
   "end": 501.0,
   "text": "بعد نشستم فکر کردم. پیش خودم علامه می‌گه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 501.0,
   "end": 504.58,
   "text": "ما تا حالا اینطوری فکر کردیم آقای حسن‌زاده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 504.58,
   "end": 511.38,
   "text": "شما حالا که طلبه بود، ایشون تازه مثلا جوون بوده طلبه، تو بیشتر-- علمت بیشتره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 511.38,
   "end": 514.42,
   "text": "یا ملاصدرا؟ تو بیشتر علم داری یا شیخ رایس؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 514.42,
   "end": 517.5,
   "text": "تو بیشتر علم داری یا عرض شود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 517.5,
   "end": 520.94,
   "text": "محقق حلی؟ تو بیشتر علم داری یا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 520.94,
   "end": 526.98,
   "text": "ابن عربی؟ که هفتصد و پنجاه جلد کتاب داره ایشون محی الدین عربی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 526.98,
   "end": 529.62,
   "text": "یه دونش فسوسه که می‌گه القاءات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 529.62,
   "end": 535.02,
   "text": "صبحی حضرت حق به لسان پیغمبر بر قلب من بوده این کتاب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 535.02,
   "end": 537.76,
   "text": "چند تامون خوندیمش. حالا اینو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 537.76,
   "end": 540.76,
   "text": "علامه می‌گه من فکر کردم که تو بیشتر می‌دونی یا اونا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 540.76,
   "end": 542.7,
   "text": "به خودم گفتم خب اونا عالم‌ترن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 542.7,
   "end": 545.04,
   "text": "اونا عالمن. اونا بیشتر می‌فهمن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 545.04,
   "end": 552.52,
   "text": "بعد توی این گیره ذهنی خودم نشستم فکر کردم تو بیشتر به سمت خطا نزدیک‌تری،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 552.52,
   "end": 557.04,
   "text": "تو بیشتر امکان داره خطا کنی، بیشتر اشتباه بفهمی یا اونا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 557.04,
   "end": 560.26,
   "text": "باز گفتم من به خطا رفتن بیشتر نزدیک‌ترم تا اونا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 560.26,
   "end": 562.78,
   "text": "اونا عالمن. آروم شدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 562.78,
   "end": 564.46,
   "text": "علامه خودش خودشو نجات داده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 564.46,
   "end": 568.42,
   "text": "ببین واعظ من نفسه. ولی ما نه، همینطوری شروع می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 568.42,
   "end": 573.48,
   "text": "خدا نکنه یه التهابی، اضطرابی، مشکلی تو زندگیمون پیش بیاد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 573.48,
   "end": 578.72,
   "text": "حالا هر-- از هر حیث، مخصوصا مشکلی که ما رو به اضطراب بندازه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 578.72,
   "end": 584.54,
   "text": "دیگه دهن باز می‌شه از اون خدا بگیر تا پایین و استغفرالله می‌بریم زیر سؤال و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 584.54,
   "end": 588.74,
   "text": "در حالی که الان تو وجود خود من قیامت شده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 588.74,
   "end": 590.56,
   "text": "قیامت وجودم به پا شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 590.56,
   "end": 592.54,
   "text": "چرا تو آروم نیستی؟ قیامتت به پا شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 592.54,
   "end": 596.26,
   "text": "این هم یه معنای قیامته. چیز عجیب و غریبی نیست قیامت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 596.26,
   "end": 599.68,
   "text": "تو وجود تو الان قیامت قیام کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 599.68,
   "end": 603.72,
   "text": "الان چرا آرامش نداری؟ اذا زلزلت الارض زلزالها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 603.72,
   "end": 607.5,
   "text": "ارض این زمین وجود تو به زلزله دراومده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 607.5,
   "end": 612.36,
   "text": "تکون شد. تکانه اومد. حالا هر تکانه از هر جایی که هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 612.36,
   "end": 615.66,
   "text": "خب، تو اونجا وقال الانسانا و ا--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 615.66,
   "end": 619.74,
   "text": "اونجا وقتی این افقالها،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 619.74,
   "end": 624.08,
   "text": "این ثقیل‌ها، سنگینی‌ها، این بار و بار سنگینه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 624.08,
   "end": 627.62,
   "text": "می‌ریزه بیرون یعنی داشته‌های وجودیش رو می‌ریزه بیرون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 627.62,
   "end": 629.78,
   "text": "وقال الانسان ما لها. چه خبر شده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 629.78,
   "end": 632.8,
   "text": "چرا اینطوری شدم؟ چرا انقدر من آرامش ندارم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 632.8,
   "end": 638.32,
   "text": "خب درونتو ریختی بیرون. و اخرجت الارض افقالها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 638.32,
   "end": 643.44,
   "text": "دیگه از ار-- ارض از زمین وجود خودت این ثقل‌ها ریخت بیرون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 643.44,
   "end": 648.62,
   "text": "این یه معنای قیامته که حالا اتم اکملش زمان مرگ اتفاق می‌افته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 648.62,
   "end": 650.82,
   "text": "تمام داشته‌های وجودیت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 650.82,
   "end": 653.14,
   "text": "می‌ریزه بیرون. که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 653.14,
   "end": 659.7,
   "text": "اینم عرض کنم و بسه. که یکی از بزرگان بارها عرض کردم فرمود اگر قرآن دو تا آیه بیشتر نداشت بس بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 659.7,
   "end": 665.02,
   "text": "فمن يعمل مثقال ذرة خيرا يره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 665.02,
   "end": 670.92,
   "text": "نمی‌گه بهش میدن، نشونش میدن، می‌بینه مثلا یه پرونده رو می‌بینه نگاه می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 670.92,
   "end": 673.48,
   "text": "يره. يره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 673.48,
   "end": 677.62,
   "text": "يعني همون عمل. ببین فمن يعمل، يعمل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 677.62,
   "end": 682.28,
   "text": "مثقال ذرة خيرا. یعنی کوچک‌ترین کاری بکنی يره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 682.28,
   "end": 685.16,
   "text": "اون عملو می‌بینی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 685.16,
   "end": 689.54,
   "text": "فمن يعمل مثقال ذرة شرا يره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 689.54,
   "end": 692.26,
   "text": "همون رو می‌بینی. همون عین عملو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 692.26,
   "end": 696.06,
   "text": "رضا فرمودن جزاء نفس عمله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 696.06,
   "end": 699.1,
   "text": "عملت چی بوده؟ نفس عمل تو چی بوده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 699.1,
   "end": 701.7,
   "text": "جزای تو همونه. دیدن همونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 701.7,
   "end": 703.96,
   "text": "حقیقت عمل تو،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 703.96,
   "end": 709.1,
   "text": "جزای توئه. قرآن می‌گه کسی که مال یتیم بخوره آتیش داره می‌خوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 709.1,
   "end": 711.22,
   "text": "نه اینکه انگار داره آتیش می‌خوره ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 711.22,
   "end": 715.32,
   "text": "می‌گه اصلا آتیش می‌خوره. نفس عمل آتیشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 715.32,
   "end": 717.06,
   "text": "جزاش چیه؟ خب آتیشه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 717.06,
   "end": 721.88,
   "text": "عین همون. يره همونو می‌بینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 721.88,
   "end": 723.94,
   "text": "قرآن-- اهل بیت می‌فرمایند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 723.94,
   "end": 727.32,
   "text": "الصلاة معراج المؤمن. این نماز معراج مؤمنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 727.32,
   "end": 730.42,
   "text": "اگر معراجه يره تو معراج می‌بینی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 730.42,
   "end": 732.5,
   "text": "وقت مرگت میری به معراج.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 732.5,
   "end": 735.96,
   "text": "حقیقت نماز اینطوری جلوه می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 735.96,
   "end": 740.52,
   "text": "یعنی قیامت این شکلیه. در درون خودت اعمالت رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 740.52,
   "end": 745.82,
   "text": "نفس عمل رو به صورت جزاء می‌بینی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 745.82,
   "end": 749.58,
   "text": "ای کاش که ما گرفتار قلب اقلف نشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 749.58,
   "end": 754.12,
   "text": "گرفتاری که-- این قلبی که گرفتار یه غلافی می‌شه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 754.12,
   "end": 756.26,
   "text": "دیگه حاضر نیست حرف هیچکسو بشنوه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 756.26,
   "end": 759.12,
   "text": "ان‌شاءالله که عاقبتمون ختم به خیر باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 759.12,
   "end": 764.52,
   "text": "به برکت صلوات بر محمد و آل محمد. اللهم صل على محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}