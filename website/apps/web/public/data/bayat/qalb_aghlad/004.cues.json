 "chapters": [
  {
   "index": 0,
   "title": "## لیلة الرغائب",
   "start": 10.8,
   "end": 268.34
  },
  {
   "index": 1,
   "title": "## مرتبه‌ی قلب در قوا و قوس نزول قرآن",
   "start": 268.34,
   "end": 441.45
  },
  {
   "index": 2,
   "title": "## از سرّ السر تا لفظ؛ جبرئیل و قلب پیامبر",
   "start": 441.45,
   "end": 462.07
  },
  {
   "index": 3,
   "title": "## انزال و تنزیل؛ حقیقت غیر از کاغذ و صوت",
   "start": 462.07,
   "end": 575.53
  },
  {
   "index": 4,
   "title": "## تمثیل درخت؛ فهم از ملکوت می‌آید",
   "start": 575.53,
   "end": 899.39
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 2.5,
   "end": 6.7,
   "text": "السلام علیک یا داعی الله و ربانی آیات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 6.7,
   "end": 10.8,
   "text": "سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 10.8,
   "end": 15.38,
   "text": "فردا شب لیلة الرغائب است که بسیار شب پرفضیلتی‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 15.38,
   "end": 20.4,
   "text": "حتما حواسمون باشه عزیزان که هست حواس‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 20.4,
   "end": 22.96,
   "text": "فذکر فإن الذکرى تنفع المؤمنین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 22.96,
   "end": 24.56,
   "text": "به این، به این باب عرض می‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 24.56,
   "end": 27.56,
   "text": "به هر حال یه عمل خیلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 27.56,
   "end": 31.32,
   "text": "مورد تأکیدی از سمت علما هست که تو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 31.32,
   "end": 34.56,
   "text": "مفاتیح شیخ عباس رحمة الله علیه آورده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 34.56,
   "end": 37.1,
   "text": "اونو حواستون باشه چون بین مغرب و عشا است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 37.1,
   "end": 42.42,
   "text": "معمولا خب می‌رید مساجد مغرب و عشا جماعت خونده می‌شه بعد جا می‌مونه دیگه نمی‌خوننش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 42.42,
   "end": 45.34,
   "text": "در حالی که فضیلتش بین مغرب و عشا است؛",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 45.34,
   "end": 47.72,
   "text": "یعنی ثوابش بیشتره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 47.72,
   "end": 50.14,
   "text": "و الا تا اذان صبح وقت داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 50.14,
   "end": 53.66,
   "text": "اصلاً اون عمل مخصوص لیلة الرغائب هست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 53.66,
   "end": 57.68,
   "text": "و خیلی عمل عجیبیه. دیگه در آثارش قطعاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 57.68,
   "end": 59.88,
   "text": "انجام دادید سال‌های پیش دیدید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 59.88,
   "end": 65.1,
   "text": "اطاله کلام نکنم برگردیم به موضوعمون که قلب اغلف بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 65.1,
   "end": 69.02,
   "text": "امروز چهارمین جلسه است که پیرامون قلبی که در غلاف هست حرف می‌زنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 69.02,
   "end": 72.24,
   "text": "اشاره کردیم به آیه هشتاد و هشت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 72.24,
   "end": 77.22,
   "text": "سوره بقره که مشرکین و کفار و این‌ها می‌گفتند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 77.22,
   "end": 81.62,
   "text": "و قالوا گفتند قلوبنا غلف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 81.62,
   "end": 85.18,
   "text": "که حالا در خصوص قالو دیروز صحبت کردیم قلوبنا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 85.18,
   "end": 87.64,
   "text": "اینجا رو قلوبنا توقف کنیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 87.64,
   "end": 91.18,
   "text": "یه ذره حرف بزنیم درباره‌ش تو این چند دقیقه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 91.18,
   "end": 95.72,
   "text": "خیلی جالبه که این‌ها مقام قلب رو باور دارند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 95.72,
   "end": 99.54,
   "text": "قرآن تک تک کلمات و حروفش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 99.54,
   "end": 106.52,
   "text": "رو حسابه. می‌گن قلوبنا یعنی باور به مقام قلب دارند که حالا الان عرض می‌کنم چه مقامی‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 106.52,
   "end": 110.72,
   "text": "حالا البته مفسرین اینجا سه تا، سه گونه حرف زدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 110.72,
   "end": 114.92,
   "text": "گفتن یا این‌ها منظورشون از اینکه می‌گن قلوبنا غلف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 114.92,
   "end": 117.76,
   "text": "نسبت به دعوت پیغمبر می‌گفتن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 117.76,
   "end": 122.64,
   "text": "دل ما توی غلافیه یا منظورشون این بوده که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 122.64,
   "end": 127.12,
   "text": "ما د-- گوشمون مثل امروزی‌ها که می‌گن گوشمون از این حرف‌ها پره و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 127.12,
   "end": 129.7,
   "text": "این حرف‌ها به درد ما نمی‌خوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 129.7,
   "end": 135.82,
   "text": "یا حرفشون اینه که اگر میگن این حرف‌ها به درد ما نمی‌خوره، این‌ها قائل به اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 135.82,
   "end": 140.38,
   "text": "مقام در حقیقت سیر نزولی حقایق قرآنی ندارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 140.38,
   "end": 144.22,
   "text": "یعنی باور ندارند که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 144.22,
   "end": 150.72,
   "text": "حقایق هست، این قرآن کلاً معارف از نشئه بالا از ملکوت بیاد به ملک.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 150.72,
   "end": 159.48,
   "text": "حالا اینو بحث می‌کنیم. اون یه عده دیگه هستن حالا بعض نظر بعضی مفسرین می‌گن نه، این‌ها می‌گن که اصلاً این حرف‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 159.48,
   "end": 162.98,
   "text": "ما در حقیقت قبلاً اینا رو شنیدیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 162.98,
   "end": 165.22,
   "text": "از تورات و انجیل. اینکه میگن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 165.22,
   "end": 168.8,
   "text": "مثل غلافه که شمشیر تو غلافه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 168.8,
   "end": 173.8,
   "text": "تمام در حقیقت این غلاف رو شمشیر پر کرده دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 173.8,
   "end": 176.2,
   "text": "میگن این حرف‌ها برای ما تکراریه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 176.2,
   "end": 178.4,
   "text": "یعنی ما قبلاً اینا رو شنیدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 178.4,
   "end": 181.16,
   "text": "این‌ها باز قائل به این‌اند که این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 181.16,
   "end": 183.66,
   "text": "حرف‌ها حرفای ملکوتیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 183.66,
   "end": 186.06,
   "text": "از این جهت هم بعدش قرآن می‌گه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 186.06,
   "end": 191.6,
   "text": "ما این‌ها رو مورد لعن قرار می‌دیم چون باور دارند که این حرف‌ها ملکوتیه و باز گوش نمی‌دن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 191.6,
   "end": 195.58,
   "text": "این خیلی خطرناکه. یه قسمشون هم می‌گن نه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 195.58,
   "end": 201.66,
   "text": "اصلاً ما نمی‌فهمیم. ما این حرفایی که تو می‌زنی، حالا این نظر مفسرین هست، منظورشون این بوده که ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 201.66,
   "end": 203.66,
   "text": "نمی‌فهمیم این حرف‌ها رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 203.66,
   "end": 205.34,
   "text": "حرف‌ها سنگینه، ملکوتیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 205.34,
   "end": 209.0,
   "text": "باز شیعه باور دارند که ملکوتیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 209.0,
   "end": 215.96,
   "text": "خیلی خطرناکه عزیزان که کسی باور داشته باشه یک حقیقتی، یه انقلابی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 215.96,
   "end": 220.06,
   "text": "یه معرفتی، یه ح-- یه کلمه حقی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 220.06,
   "end": 222.5,
   "text": "حقه به تمام معنا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 222.5,
   "end": 227.66,
   "text": "ارتباط با عالم ملکوت داره بعد پشت پا بهش بزنه به هر دلیلی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 227.66,
   "end": 235.12,
   "text": "اینایی که مثلاً می‌گن آقا انقلاب ما قبول داریم خب انقلاب واقعاً به حقی بود اما خیانت می‌کنند به همین انقلاب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 235.12,
   "end": 238.26,
   "text": "اینا خیلی در حقیقت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 238.26,
   "end": 242.54,
   "text": "ااا اون پا-- حالا اجری که، اجرت که نمی‌شه گفت، اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 242.54,
   "end": 248.86,
   "text": "جزایی که خدا به این‌ها باید بده خیلی سنگین‌تر از اوناییه که خبر ندارن، بی‌خبرن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 248.86,
   "end": 252.54,
   "text": "کسی که می‌دونه این دین بر حقه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 252.54,
   "end": 257.44,
   "text": "امیرالمؤمنین بر حقه، بعد التزام عملیه نداره، اون خیلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 257.44,
   "end": 261.32,
   "text": "در حقیقت جزاش سنگین‌تره کسی که بی‌خبره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 261.32,
   "end": 263.38,
   "text": "و جالب اینجاست، اینو می‌خوام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 263.38,
   "end": 268.34,
   "text": "تو این سه چهار دقیقه آخر بحث کنیم، بحث قلب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 268.34,
   "end": 274.54,
   "text": "در هر حال ما هر مرتبه رو بگیریم، نظر هر مفسری رو بگیریم باز می‌گن قلوبنا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 274.54,
   "end": 279.06,
   "text": "یعنی خب قلب جایگاهش خیلی مرات-- مرتبه‌ش بالاتر از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 279.06,
   "end": 281.46,
   "text": "قوای دیگه‌ی وجودی انسانه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 281.46,
   "end": 289.92,
   "text": "ما حس مشترک داریم، حواس ظاهریه داریم، حس خیال، قوه خیال داریم، وهم داریم، عقل داریم، بعد قلبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 289.92,
   "end": 294.28,
   "text": "بعد در سیر نزول شما توجه بفرمایید قرآن نزول،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 294.28,
   "end": 297.28,
   "text": "بحث انزال و تنزيل و این‌ها داره دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 297.28,
   "end": 300.86,
   "text": "نزول، نزول قرآن، خودمون می‌گیم نزول",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 300.86,
   "end": 303.16,
   "text": "یعنی این مربوط به قوس نزوله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 303.16,
   "end": 305.02,
   "text": "قرآن اون بالا بالاها بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 305.02,
   "end": 308.26,
   "text": "إنک لتعلق القرآن من لدن حکیم علیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 308.26,
   "end": 312.56,
   "text": "علم ذاتی حضرت حق بوده به صورت مفاهیم کلیه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 312.56,
   "end": 315.3,
   "text": "معانی کلیه، اینو گرفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 315.3,
   "end": 321.6,
   "text": "اگه تو بگی همین قرآنیه که اینجا سیاهه است جلوی ماست و ما دستمون می‌گیریم می‌خونیم، این که مال نشئه طبیعته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 321.6,
   "end": 326.68,
   "text": "اگه بگی همین صوته، صوتیه، این کیف مسموعی که ما داریم بیان می‌کنیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 326.68,
   "end": 331.28,
   "text": "أعوذ بالله، بسم الله الرحمن، اینم که مربوط به عالم ماده‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 331.28,
   "end": 333.94,
   "text": "ربطی به اون عالم بالا نداره که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 333.94,
   "end": 342.94,
   "text": "وقتی می‌گی عالم بالا، وقتی می‌گی نزول، وقتی می‌گی از علم حضرت حق نازل شده، معلومه سیر، سیر قوس نزولی بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 342.94,
   "end": 345.52,
   "text": "یعنی از بالا اومده نه از پایین بیاد به بالا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 345.52,
   "end": 353.44,
   "text": "اگه قرآن این باشه که دست من و شماست، این می‌شه از مرتبه ماده‌ست، طبیعته، جوهره، کاغذه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 353.44,
   "end": 355.32,
   "text": "شنیداریه، صوته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 355.32,
   "end": 357.18,
   "text": "این‌ها مربوط به عالم ماده‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 357.18,
   "end": 360.86,
   "text": "این که قرآن، اون حقیقت قرآن نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 360.86,
   "end": 366.37,
   "text": "لذا می‌گه از نیزه بریزیدش. اصل قرآن، حقیقت قرآن از سیر نزولی داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 366.37,
   "end": 371.03,
   "text": "می‌گه انا انزلناه تنز-- تنزل تنزیلا من القرآن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 371.03,
   "end": 374.71,
   "text": "از بالا اومده، سیر قوس نزول داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 374.71,
   "end": 376.57,
   "text": "یعنی از ملکوت عالم اومده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 376.57,
   "end": 378.25,
   "text": "خب چی؟ کی اینو گرفته؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 378.25,
   "end": 383.35,
   "text": "پیغمبر صرفا شنیده، شنیده که باز می‌شه صوت که مال عالم ماده‌ست که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 383.35,
   "end": 388.61,
   "text": "می‌گیم از بالا اومده. از بالا اومده، اون مرتبه بالا چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 388.61,
   "end": 392.13,
   "text": "اصلا نمی‌دونیم چیه. حالا if میخوای اسمشو بذار سرّ السر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 392.13,
   "end": 394.97,
   "text": "حکما ق-- اسم گذاشتنا، میگن سرّ السر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 394.97,
   "end": 400.57,
   "text": "یه مرتبه پایین‌تر سر، یه مرتبه پایین‌تر روح، یه مرتبه پایین‌تر قلب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 400.57,
   "end": 407.69,
   "text": "اصلا بعضیا میگن قلب، مرتبه ملکوتی وجود ما قلب ماست و اینا میگن قلوبنا قلف.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 407.69,
   "end": 412.39,
   "text": "یعنی اینا باور دارن سیر ملکوتیه، حرفای پیغمبر از ملکوته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 412.39,
   "end": 416.57,
   "text": "این کلمات نظام هستی، کلمات عالیه رو می‌دونن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 416.57,
   "end": 419.45,
   "text": "مثل خیلی از ماها که باور داریم آقا نماز، آقا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 419.45,
   "end": 421.13,
   "text": "قبول داری نماز به حقه؟ بله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 421.13,
   "end": 422.89,
   "text": "قبول داری پیغمبر به حقه؟ بله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 422.89,
   "end": 425.89,
   "text": "قبول داری انقلاب معجزه قرن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 425.89,
   "end": 427.89,
   "text": "بلکه تاریخ باشه؟ بله واقعا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 427.89,
   "end": 430.33,
   "text": "پس چرا تو التزام عملیه نداری؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 430.33,
   "end": 432.69,
   "text": "چرا برعکس عمل می‌کنی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 432.69,
   "end": 437.57,
   "text": "این خیلی خطرناک‌تره تا کسی که اصلا اعتقاد نداره، باور نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 437.57,
   "end": 440.05,
   "text": "پس این ز-- سیر نزول رو ق--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 440.05,
   "end": 444.05,
   "text": "حواسمون باشه. قرآن قوس نزول طی کرده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 444.05,
   "end": 447.39,
   "text": "تا بر وجود پیغمبر نازل شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 447.39,
   "end": 449.91,
   "text": "یعنی اون موجود مجرد عقلی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 449.91,
   "end": 452.49,
   "text": "مجرد عقلی مربوط به عالم عقله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 452.49,
   "end": 456.39,
   "text": "اصلا نه شکل داره، نه اندازه داره، نه بو داره، نه طعم داره، نه ش--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 456.39,
   "end": 458.69,
   "text": "عرض شود طول و عرض و حجم داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 458.69,
   "end": 462.07,
   "text": "موجود، موجود مجرد عقلی یعنی جبرائیل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 462.07,
   "end": 465.85,
   "text": "ها؟ یه موجود مجرد عقلیه، تو عالم عقله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 465.85,
   "end": 468.25,
   "text": "که تنزل پیدا کرده از ملکوت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 468.25,
   "end": 470.27,
   "text": "اونم معانی کلیه که از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 470.27,
   "end": 478.69,
   "text": "قرآن هست. اون مفاهیم کلیه رو، اون‌ها رو از حضرت حق اخذ کرده پیغمبر با چه مقامی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 478.69,
   "end": 481.71,
   "text": "شنیده؟ نه. با چه مقامی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 481.71,
   "end": 487.95,
   "text": "با سرّ السرش این نازل شده از علم ذاتی حضرت حق بر سرّ السر پیغمبر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 487.95,
   "end": 490.47,
   "text": "قوس رو ببینید از بالا به پایین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 490.47,
   "end": 497.75,
   "text": "بعد سر پیغمبر، روح-- اگر این ترتیبی که حکما قائله رو ما بپذیریم، حکما در حکمت متعالیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 497.75,
   "end": 500.07,
   "text": "بعد روح پیغمبر، بعد قلب، قلب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 500.07,
   "end": 503.17,
   "text": "این اومده در قلب دیگه سان دیده یعنی محا--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 503.17,
   "end": 506.27,
   "text": "م-محل حضوره، کشفه، شهوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 506.27,
   "end": 509.83,
   "text": "اینا تا اینجا رفتن میگن و قلوبنا قلف.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 509.83,
   "end": 515.87,
   "text": "قبول داریم که از اونجا اومده، از مرتبه قلب اومده به وهم و خیال پیغمبر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 515.87,
   "end": 518.57,
   "text": "صورت گرفته به خودش، شکل گرفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 518.57,
   "end": 522.55,
   "text": "این انا انزلنا لفظه، شکل داره دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 522.55,
   "end": 525.29,
   "text": "این کار قوه خیاله. یعنی از قلب اومد پایین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 525.29,
   "end": 528.55,
   "text": "ما قبول داریم قوس، قوس نزول این کارو کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 528.55,
   "end": 531.87,
   "text": "بعد به لفظ که میاد صوته، دیگه ماده‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 531.87,
   "end": 535.33,
   "text": "بعد عالم خیال اینو تبدیلش می‌کنه می‌ده به حسه مشترک.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 535.33,
   "end": 539.77,
   "text": "تو لفظ رو بیان می‌کنی ولی اصلش معانی کلیه است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 539.77,
   "end": 546.47,
   "text": "در ذات حضرت حق. اینو قبول داشتن باز پشت پا می‌زدن، این خیلی خطر بزرگیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 546.47,
   "end": 550.03,
   "text": "این باید حواسمون جمع باشه. برای همین دقت بفرمایید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 550.03,
   "end": 554.15,
   "text": "که بعد تو آیه اینطوری خدا بحث رو یه دفعه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 554.15,
   "end": 556.05,
   "text": "جمع می‌کنه. بله، بله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 556.05,
   "end": 558.05,
   "text": "اینا گفتن قلوبنا قلف. بله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 558.05,
   "end": 561.35,
   "text": "لعنهم الله بكفرهم، بكفرهم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 561.35,
   "end": 567.31,
   "text": "لعنهم الله. حالا رو فقل il ما يؤمنون باید جلسات بعد صحبت کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 567.31,
   "end": 570.65,
   "text": "عزیزان این مطالبی که ما می‌گیم نیاز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 570.65,
   "end": 573.45,
   "text": "مبرم از نون شب واجب‌تره به ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 573.45,
   "end": 576.73,
   "text": "همین، همین حقیقت کلیه که الان ما فهمیدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 576.73,
   "end": 581.19,
   "text": "اساسا الان یه مثال می‌زنم. مثلا شما می‌گی آره این درخت رو ببین، درخت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 581.19,
   "end": 585.97,
   "text": "خب الان قوه خیال تو یه تصوری، یه تصویری از این درخت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 585.97,
   "end": 590.63,
   "text": "تو قوه خیالت، عالم مثال و برزخت ایجاد-- تو اونو نمی‌بینی که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 590.63,
   "end": 593.05,
   "text": "تصویر اونو تو وجود خودت داری می‌بینی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 593.05,
   "end": 598.61,
   "text": "این باز یه صورتی داره. اما مفهوم درختو کجای تو درک می‌کنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 598.61,
   "end": 602.63,
   "text": "قوه خیالتو، نه، اون صورت بهش می‌ده که تو ببینیش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 602.63,
   "end": 608.37,
   "text": "درون خودت اون درخت بیرونی رو تو داخل خودت ببینی و الا کوری نمی‌بینی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 608.37,
   "end": 610.91,
   "text": "قوه خیال صورت اونو برای تو ایجاد می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 610.91,
   "end": 614.67,
   "text": "خب مفهوم کلی درختو کی به تو می‌فهمونه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 614.67,
   "end": 617.43,
   "text": "اصلا اون چیه؟ مفهومش، نه خود درخت ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 617.43,
   "end": 619.19,
   "text": "اصلا درخت چیه؟ آب چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 619.19,
   "end": 621.57,
   "text": "نبات چیه؟ انسان، این مفهوماتو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 621.57,
   "end": 624.09,
   "text": "از کجا میاد؟ فهمش از کجا میاد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 624.09,
   "end": 627.15,
   "text": "از بیرون میاد؟ از عالم ماده میاد تو وجود من؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 627.15,
   "end": 630.95,
   "text": "نه. اینکه می‌شه قوس صعود که از ماده بیاد بره بالا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 630.95,
   "end": 633.79,
   "text": "می‌شه قوس صعود. همش نزوله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 633.79,
   "end": 638.21,
   "text": "یعنی فهم از بالا اتفاق میفته، از ملکوت میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 638.21,
   "end": 640.71,
   "text": "قوه قلب تو حقایق رو درک می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 640.71,
   "end": 644.17,
   "text": "بعد می‌خواد بچشی، بفهمی می‌ده به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 644.17,
   "end": 647.09,
   "text": "در حقیقت عقلت، عقلت مفهوم کلی رو می‌فهمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 647.09,
   "end": 652.41,
   "text": "بعد اون تازه باز می‌ده وهم جزئی‌ش می‌کنه، تیکه‌تیکه‌ش می‌کنه، اون می‌ده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 652.41,
   "end": 657.09,
   "text": "قوه خیالت صورت براش می‌گیره که تو قشنگ بتونی اینو دیگه درک کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 657.09,
   "end": 660.49,
   "text": "صورت‌گری می‌کنه. این قوس نزوله، از بالا اومده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 660.49,
   "end": 663.81,
   "text": "یعنی فهم من و تو نسبت به امیرالمؤمنین،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 663.81,
   "end": 667.81,
   "text": "فهم من و تو نسبت به قرآن، نسبت به این حقایق، هرچی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 667.81,
   "end": 677.23,
   "text": "همش ملکوتیه. اگر نسبت به اون اوامر اون ولایت، اوامر اون قرآن، اون حقایق کلی بخوای--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 677.23,
   "end": 682.99,
   "text": "بخوام پشت پا بزنم عملاً بعد می‌گه پشت پا زدن به ملکوت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 682.99,
   "end": 686.27,
   "text": "اینه که وقتی شیخ الرئیس رو-- اینم بگم شیرین بشه کامتون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 686.27,
   "end": 691.63,
   "text": "ما معمولا 항상 حکایت و داستان اینا نمیگیم چون بحثامون علمیه معمولا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 691.63,
   "end": 695.49,
   "text": "اما این مرتبطه. فکر می‌کنم حضرت آقای الهی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 695.49,
   "end": 698.51,
   "text": "تعا و تبایی برادر علامه بودن که دیدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 698.51,
   "end": 701.29,
   "text": "یعنی ارتباط گرفتن با شیخ الرئیس علیه الرحمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 701.29,
   "end": 704.99,
   "text": "می‌دونید دیگه شما هم الحمد لله اهلش هستید دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 704.99,
   "end": 711.01,
   "text": "این می‌چشید، می‌کشید یعنی این بارهای سنگین معارف رو که ایشون مرتبط می‌شده با خیلی از بزرگان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 711.01,
   "end": 714.13,
   "text": "البته دو سه تا رو نتونست. هرچی زور زد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 714.13,
   "end": 720.45,
   "text": "برادر علامه تعا و تبایی، یکی ابن فهد حلی رو نتونست ارتباط بگیره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 720.45,
   "end": 723.67,
   "text": "یکی سید ابن طاووس رو، یکی سید بحر العلوم رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 723.67,
   "end": 727.05,
   "text": "نتونست که بعد علامه طباطبایی می‌فرمود اونا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 727.05,
   "end": 730.35,
   "text": "اه، شرف تنازل نمی‌دن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 730.35,
   "end": 732.33,
   "text": "یعنی اصلا نمی‌خوان نازل شن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 732.33,
   "end": 739.37,
   "text": "اصلا ببخشید اینطوری میگم، اصلا آدم حساب نمی‌کنن نشئه ملکوت، مل- ملک رو و ماده و طبیعت رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 739.37,
   "end": 742.27,
   "text": "اون بالا مال‌ان. نزد خود مولا امیرالمؤمنین \"عند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 742.27,
   "end": 745.47,
   "text": "ربهم یُرجى، عرض شود عند ملیک مقتدر\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 745.47,
   "end": 747.85,
   "text": "حالا ایشون با شیخ الرئیس مرتبط می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 747.85,
   "end": 752.13,
   "text": "مرحوم آقای الهی-- الهی طباطبایی برادر علامه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 752.13,
   "end": 757.37,
   "text": "بعد در خصوص این حقایق که تو کتاب‌هاش ریخته مثل اشاراتش،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 757.37,
   "end": 761.25,
   "text": "شفا و قانونش که متحیر کرده حکمّا رو،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 761.25,
   "end": 763.75,
   "text": "صحبت علمی می‌کنن. جالبه این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 763.75,
   "end": 767.99,
   "text": "حالا حضرت علامه حسن‌زاده یه نکته کلیدی رو اینجا می‌کشه بیرون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 767.99,
   "end": 771.21,
   "text": "خب اینو خوب گوش بدید تموم شد بحثم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 771.21,
   "end": 773.43,
   "text": "ایشون می‌فرمود که کی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 773.43,
   "end": 777.89,
   "text": "شیخ الرئیس. می‌گه که آنچه که ما در کتاب‌هامون گفتیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 777.89,
   "end": 782.07,
   "text": "حالا یه نمونه‌ای از این قوس نزول رو من امرو- امروز به شما گفتم مثلا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 782.07,
   "end": 787.15,
   "text": "حرف همین حکمّاست. آنچه که ما در کتاب‌هامون گفتیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 787.15,
   "end": 791.13,
   "text": "و بیان کردیم و نوشتیم اینو وقتی اومدیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 791.13,
   "end": 796.59,
   "text": "تو نشئه ملکوت دیدیم مطلب فوق این‌هاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 796.59,
   "end": 798.51,
   "text": "بالاتر از این‌هاست. تعال.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 798.51,
   "end": 802.01,
   "text": "بعد علامه حسن‌زاده اینجا یه نکته‌سنجی قشنگی به خرج می‌ده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 802.01,
   "end": 804.71,
   "text": "می‌فرمایند شیخ الرئیس نگفتی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 804.71,
   "end": 809.25,
   "text": "اومدیم اینور دیدیم نه یه چیز دیگه‌ایه مثلا، اصلا اینا نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 809.25,
   "end": 812.39,
   "text": "رد نمی‌کنه اینا رو. می‌گه فوق این‌هاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 812.39,
   "end": 815.87,
   "text": "می‌گه همین‌هاست اما تعالی پیدا کرده‌تر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 815.87,
   "end": 820.13,
   "text": "یعنی تعال بیا بالاتر. تو دیدتو بازتر کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 820.13,
   "end": 822.03,
   "text": "همین‌هاست‌ها ولی بالاتر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 822.03,
   "end": 824.33,
   "text": "مثل این‌که نش-- وقت مرگ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 824.33,
   "end": 826.79,
   "text": "تو همین طبیعت رو یه طور دیگه می‌بینی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 214,
   "start": 826.79,
   "end": 833.51,
   "text": "طورت عوض می‌شه. همین عالم نشئه طبیعت رو به طور باطنی و قیامتی می‌بینی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 215,
   "start": 833.51,
   "end": 840.47,
   "text": "نه این‌که خدا بخواد کن فیکون کنه خورشیدو بزنه به ماه و زمین و متلاشی کنه که قیامت تو بخواد بر- برقرار بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 216,
   "start": 840.47,
   "end": 842.85,
   "text": "\"و الذی خلق السماوات والأرض بالحق\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 217,
   "start": 842.85,
   "end": 845.37,
   "text": "اینا همه خ-- حق آفریده شدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 218,
   "start": 845.37,
   "end": 847.47,
   "text": "متلاشی شدنی در کار نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 219,
   "start": 847.47,
   "end": 850.53,
   "text": "طور وجودی ما عوض می‌شه بال- به قول ملاصدرا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 220,
   "start": 850.53,
   "end": 855.01,
   "text": "یه طور دیگه می‌بینی. همین زمین و آسمون و خودت و دیگران،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 221,
   "start": 855.01,
   "end": 857.75,
   "text": "باطنش رو می‌بینی. این می‌شه ملکوت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 222,
   "start": 857.75,
   "end": 859.65,
   "text": "که این می‌شه الانم می‌شه اتفاق بیفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 223,
   "start": 859.65,
   "end": 864.65,
   "text": "در حالی که زمین برقرار است، خورشید می‌تابد، ماه گردش دارد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 224,
   "start": 864.65,
   "end": 870.19,
   "text": "روزگار در جریانه است، تو طورت عوض بشه همین الان ملکوت رو ببینی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 225,
   "start": 870.19,
   "end": 873.61,
   "text": "این قیامت تو به پا شده. چیز عجیبی نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 226,
   "start": 873.61,
   "end": 876.97,
   "text": "حالا این قرآن ببینید یه روی قلوبنا ما الان مت--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 227,
   "start": 876.97,
   "end": 880.61,
   "text": "توقف کردیم. قالو دیروز صحبت کردیم حالا قلوبنا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 228,
   "start": 880.61,
   "end": 884.53,
   "text": "ببین چقدر توش حرفه. چی بگه آدم در خصوص قرآن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 229,
   "start": 884.53,
   "end": 887.97,
   "text": "ما هم که حرفی نداریم. دست ما کوتاه و خرما بر نخیل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 230,
   "start": 887.97,
   "end": 891.73,
   "text": "انشاالله خودشون ما تفهیم کنن به ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 231,
   "start": 891.73,
   "end": 894.21,
   "text": "فردا شب ما رو هم یادتون نره دعا می‌کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 232,
   "start": 894.21,
   "end": 899.39,
   "text": "انشاالله که عاقبت ما ختم بخیر بشه و برکت صلوات بر محمد و آل محمد. الله الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}