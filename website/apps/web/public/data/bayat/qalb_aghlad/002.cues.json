   "start": 773.96,
   "end": 811.04
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 1.7,
   "end": 5.2,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 5.2,
   "end": 9.44,
   "text": "السلام علیک یا داعی الله و ربانی آیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 9.44,
   "end": 12.24,
   "text": "سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 12.24,
   "end": 15.46,
   "text": "تسلیت عرض می‌کنم، تعزیت می‌گم این روز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 15.46,
   "end": 22.12,
   "text": "بسیار پرحزن و اندوه رو، شهادت حضرت امام هادی صلوات الله عليه رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 22.12,
   "end": 28.94,
   "text": "که به حق از حیث هدایت بر گردن همه‌ی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 28.94,
   "end": 32.22,
   "text": "ما حق حیات دارن دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 32.22,
   "end": 37.58,
   "text": "زحمات بسیار بی‌نظیری که ایشون در همون کوتاه زمان عمرشون کشیدن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 37.58,
   "end": 42.78,
   "text": "حلقه‌های وصلی که-- اتصالی که بین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 42.78,
   "end": 47.1,
   "text": "صفوف اهل ایمان ایجاد کردن و تونستن به توسط",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 47.1,
   "end": 52.84,
   "text": "وکلاى خودشون یه حلقه، حلقه، حلقه‌ای رو ایجاد کنن بین همه‌ی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 52.84,
   "end": 57.04,
   "text": "طوایف و اهل ایمان که این در زمان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 57.04,
   "end": 59.84,
   "text": "امام عسکری دیگه به اوج رسید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 59.84,
   "end": 65.12,
   "text": "که این حلقه‌ها مثل این حلقه‌های صالحین بسیج",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 65.12,
   "end": 73.56,
   "text": "از ابداعات امام سجاد سلام الله عليه بعد از کربلا بود که هرچی رفت جلو رشد کرد تا در زمان امام هادی و امام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 73.56,
   "end": 75.22,
   "text": "عسکری دیگه به اوج رسید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 75.22,
   "end": 79.1,
   "text": "طوری که تمام اهل ایمان در سیطره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 79.1,
   "end": 83.64,
   "text": "حجاز و کشورهای دیگه همه با هم مرتبط بودن اما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 83.64,
   "end": 88.86,
   "text": "به قول ما زیرزمینی. گردن ما حق حیات بزرگی دارن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 88.86,
   "end": 91.8,
   "text": "و اساساً هدایت رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 91.8,
   "end": 94.42,
   "text": "خدای منان ارائه کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 94.42,
   "end": 96.28,
   "text": "اونجا که قرآن می‌فرماید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 96.28,
   "end": 100.22,
   "text": "\"انا هدیناه السبیل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 100.22,
   "end": 103.82,
   "text": "اما شاكرا واما كفورا\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 103.82,
   "end": 109.12,
   "text": "ما هدایت رو در قالب سبيل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 109.12,
   "end": 113.24,
   "text": "به شما رو نشون دادیم. حالا شما می‌خوای شاکر باش، می‌خوای کف--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 113.24,
   "end": 116.5,
   "text": "كفر ببر. دیگه به ضرر یا به خیر خودته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 116.5,
   "end": 120.2,
   "text": "ما هدایت رو \"انا هدیناه السبیل\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 120.2,
   "end": 123.66,
   "text": "نشون دادیم که حالا خودشون فرمودن \"نحن السبیل الی اعظم\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 123.66,
   "end": 127.78,
   "text": "اون سبيل ما هستیم. امام هادی صلوات الله عليه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 127.78,
   "end": 132.32,
   "text": "اون سبيل هست، اون راه هست که اگر غیر از او بری هرچی تو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 132.32,
   "end": 134.48,
   "text": "تلاش کنی بیهوده است. لذا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 134.48,
   "end": 140.02,
   "text": "تو همین دعای امروز، دعای ماه مبارک، ماه رجب اگر دقت کنید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 140.02,
   "end": 143.98,
   "text": "وقتی به شر می‌رسه آخرت رو یه شر استفاده می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 143.98,
   "end": 146.42,
   "text": "نمیگه جمع الشر الآخرة.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 146.42,
   "end": 152.24,
   "text": "شر الآخرة. جمع شر دنیا اما به آخرت شر الآخرة.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 152.24,
   "end": 156.92,
   "text": "شر آخرت یه چیز بیشتر نیست، اونم جدایی از ولایت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 156.92,
   "end": 159.6,
   "text": "تمام. یعنی اگر کسی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 159.6,
   "end": 165.46,
   "text": "از ولایت، از امام هادی به عنوان مصداق اتم ولایت جدا شد تمام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 165.46,
   "end": 167.18,
   "text": "دیگه این شر آخرت می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 167.18,
   "end": 169.7,
   "text": "حالا هرچی خیر می‌خواد ازش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 169.7,
   "end": 173.7,
   "text": "ساطع بشه سی‌ش ارزش نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 173.7,
   "end": 176.24,
   "text": "حالا بحث ما چون قلب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 176.24,
   "end": 183.16,
   "text": "قلف بود از دیروز شروع کردیم آیه‌ی هشتاد و هشت سوره بقره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 183.16,
   "end": 186.76,
   "text": "مختصرًا توضیح بیشتری بدیم بهتر جا بیفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 186.76,
   "end": 189.44,
   "text": "\"وقالو قلوبنا قلف\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 189.44,
   "end": 195.46,
   "text": "اینایی که پیغمبر اومده بود هدایت رو براشون بیاره از طریق قرآن و ولایت کلیه، اینا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 195.46,
   "end": 200.74,
   "text": "خودشونو راحت می‌کردن. قالو، می‌گفتن \"قلوبنا قلف\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 200.74,
   "end": 203.18,
   "text": "ما دل ما توی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 203.18,
   "end": 205.4,
   "text": "غلافی از غفلت قرار گرفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 205.4,
   "end": 207.96,
   "text": "حرفای شما هرچی بزنی به درد ما نمی‌خوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 207.96,
   "end": 211.96,
   "text": "تو گوش ما فرو نمیره. الانم خیلیا این حرفا رو می‌زنن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 211.96,
   "end": 214.5,
   "text": "که بعد ماحصلش می‌شه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 214.5,
   "end": 217.34,
   "text": "\"بل لعنهم الله بكفرهم\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 217.34,
   "end": 220.34,
   "text": "خدا اینا رو از رحمت خودش دور می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 220.34,
   "end": 222.48,
   "text": "لعن خدا یعنی دوری از رحمت خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 222.48,
   "end": 226.26,
   "text": "\"فقلیلا ما يؤمنون\". حالا اینا پیرامون این کلمات بعدا حرف می‌زنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 226.26,
   "end": 233.14,
   "text": "فعلاً بحث اون چیز دیگه است که این‌ها جالبه شما این رو، این نکته رو خوب دقت کنید که قرآن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 233.14,
   "end": 240.16,
   "text": "اساساً خدای منان که می‌فرماید \"انا هدیناه السبیل\" ما هدایت رو آوردیم و راه هدایت رو معرفی کردیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 240.16,
   "end": 246.48,
   "text": "به شکل انزل مراتب آورده حتی معرفی کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 246.48,
   "end": 250.34,
   "text": "یعنی چنان خوردش کرده مثل بچه‌ای که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 250.34,
   "end": 255.48,
   "text": "مادر غذا رو می‌جوه نرم می‌کنه تو دهانش می‌گذاره اینچنین،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 255.48,
   "end": 259.58,
   "text": "خدا اومده هدایت رو چنان همه فهم کرده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 259.58,
   "end": 263.66,
   "text": "شما قرآن رو هرچی نگاه می‌کنی می‌بینی همش مثله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 263.66,
   "end": 270.4,
   "text": "اون کلمات عالیه نظام هستی رو، اون حقایق بسیار سنگین و اسرار پشت پرده رو،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 270.4,
   "end": 278.66,
   "text": "اون ولایت کلیه الهیه که شامل سر و سر نظام هستی‌ست و علم اول و آخر نظام هستی درش جمع شده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 278.66,
   "end": 280.94,
   "text": "اومده در قالب چشیده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 280.94,
   "end": 285.3,
   "text": "یعنی محسوسات دیگه که کاملاً همه بچشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 285.3,
   "end": 288.72,
   "text": "شما نمی‌تونی رحمت امام رضا رو بچشی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 288.72,
   "end": 293.7,
   "text": "امام الرهوف که می‌گی چگونه عسل انگار به کامت می‌گذارن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 293.7,
   "end": 298.3,
   "text": "در حالی که اون مقامات سنگین امام الرهوف رو کی می‌تونه درک کنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 298.3,
   "end": 301.26,
   "text": "اساساً حقیقت حضرت ولی عصر،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 301.26,
   "end": 305.62,
   "text": "حقیقت امام هادی صلوات الله عليه مجمعاً رو کی می‌تونه درک کنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 305.62,
   "end": 308.58,
   "text": "اما اون رو در قالب حسی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 308.58,
   "end": 312.24,
   "text": "که محسوسات تو بتونن این‌ها رو بچشن آورده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 312.24,
   "end": 316.6,
   "text": "به انزل مراتب حتی می‌گه \"انا قل\" بگو \"انا بشر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 316.6,
   "end": 319.36,
   "text": "مثلکم\". اصلاً مثل شما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 319.36,
   "end": 324.34,
   "text": "بشرم. البته بله \"يوحي إلي أنما آلهکم الله واحد\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 324.34,
   "end": 328.5,
   "text": "اصلاً وحی که میاد دیگه دهان، دهان عصمت است رو قصه فرق می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 328.5,
   "end": 333.42,
   "text": "اما منم بشرم مثل شما یعنی به انزل مراتب رسونده‌ش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 333.42,
   "end": 337.88,
   "text": "عزیز دلم هدایت رو که تو قشنگ بچشی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 337.88,
   "end": 341.58,
   "text": "کاملاً بچشی. با این حال،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 341.58,
   "end": 344.88,
   "text": "با این حال که به انزل مراتب کشونده‌ش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 344.88,
   "end": 349.2,
   "text": "و دائماً هم در قرآن مثال می‌زنه باز با این حال می‌گن \"قلوبنا قلف\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 349.2,
   "end": 352.92,
   "text": "ول کن بابا ما قلبمون توی غلافه هرچی بگی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 352.92,
   "end": 361.58,
   "text": "فایده نداره. دیگه در حقیقت دارن پشت پا می‌زنن به سعادت دنیوی و اخروی خودشون دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 361.58,
   "end": 363.54,
   "text": "چرا قرآن سراسر مثله؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 363.54,
   "end": 366.24,
   "text": "می‌گه ک--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 366.24,
   "end": 372.08,
   "text": "ااا کذالک الأمثال ندر به على الناس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 372.08,
   "end": 375.92,
   "text": "ما دائما این‌ها همه مثلیه که برای شما می‌زنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 375.92,
   "end": 378.92,
   "text": "ضرب می‌کنیم برای مردم این مثل‌ها رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 378.92,
   "end": 383.94,
   "text": "چرا مثل می‌زنه؟ چون قوه‌ی خیال انسان با مثال حشر و نشر داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 383.94,
   "end": 391.76,
   "text": "ببینید شما حقایق کلیه، علمیه، عقلیه، چه می‌دونم اینا رو هرچی میگی طرف نمی‌فهمه بهت میگه میشه یه مثال بزنی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 391.76,
   "end": 398.7,
   "text": "چون قوه خیال یا همون عالم مثال انسان، قوه خیال همون عالم مثال انسانه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 398.7,
   "end": 403.6,
   "text": "بین دو عالم واقع شده، عالم طبیعت که کاملا مادیه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 403.6,
   "end": 407.0,
   "text": "محسوسات محض، حس محض",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 407.0,
   "end": 409.24,
   "text": "و عالم عقل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 409.24,
   "end": 413.92,
   "text": "که کاملا مجرد و خالی از ماده و احکام ماده‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 413.92,
   "end": 417.1,
   "text": "قوه مثال یا اون قوه خیال تو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 417.1,
   "end": 424.66,
   "text": "میاد کمک میده اتصال برقرار می‌کنه بین عالم عقل، مجردات عقلیه ملائکه الله، اون عالم ملکوت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 424.66,
   "end": 427.36,
   "text": "با نشئه طبیعت یا مل-- یا ملک.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 427.36,
   "end": 430.38,
   "text": "یعنی تو وجود تو هم ملک هست و ملکوت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 430.38,
   "end": 434.56,
   "text": "قوه م-- خیال میاد بین این دو پل می‌زنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 434.56,
   "end": 439.14,
   "text": "لذا مثال کمک می‌کنه برای اینکه قوه خیال صورت‌گری می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 439.14,
   "end": 444.36,
   "text": "اون مفاهیم کلیه عقلیه که تو بخوای دین رو بفهمی، هدایت رو بفهمی، ح--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 444.36,
   "end": 448.96,
   "text": "ولایت رو بفهمی به شکل مثال، مثل در میاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 448.96,
   "end": 451.82,
   "text": "قرآن هم کا-- دائما این کارو کرده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 451.82,
   "end": 457.9,
   "text": "برای اینکه تو در نشئه طبیعت با این صورت‌ها و اشکال محشوری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 457.9,
   "end": 460.92,
   "text": "قوه خیال حقایق عقلیه رو میاره به صورت میاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 460.92,
   "end": 468.08,
   "text": "قرآن هم این کارو کرده. میگه مثل و ببینید مثل نوره کمش کات الله نور السماوات والارض.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 468.08,
   "end": 471.74,
   "text": "یه حقیقت کلیه خیلی سنگین کی می‌فهمه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 471.74,
   "end": 475.82,
   "text": "باید مثالش می‌زنه. مثل نوره کمش کات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 475.82,
   "end": 481.16,
   "text": "مثال می‌زنه که قوه خیال صورت‌گری کنه از مشقات یعنی چراغدان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 481.16,
   "end": 483.34,
   "text": "یا مثلا اون مثلش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 483.34,
   "end": 489.0,
   "text": "کلمه طیبه یعنی حقیقت و باطن دین و ولایت رو میگه کشجرة",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 489.0,
   "end": 494.16,
   "text": "طيبة مثال می‌زنه مثل شجرة طيبة که اصل‌ها،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 494.16,
   "end": 497.72,
   "text": "اصل‌ها ثابت و فرع‌ها في السماء همه می‌فهمن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 497.72,
   "end": 501.04,
   "text": "می‌خوام به شما بگم حتی با اینکه خدا اومده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 501.04,
   "end": 508.22,
   "text": "قوه خیال فعال من و شما رو که می‌تونه صورت‌گری کنه به صور و اشکال متعدد از عالم طبیعت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 508.22,
   "end": 511.64,
   "text": "هدایت رو به انزل مراتب کشونده که قوه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 511.64,
   "end": 514.46,
   "text": "خیال تو اون حقایق عقلی و کلیه رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 514.46,
   "end": 518.8,
   "text": "بتونه صورت‌گری کنه به وزان عالم طبیعت به تو بفهمونه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 518.8,
   "end": 522.72,
   "text": "به ما بفهمونه. باز میگیم ول کن قلب ما حالیش نمی‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 522.72,
   "end": 524.48,
   "text": "این دیگه دست و بال ما بسته است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 524.48,
   "end": 526.82,
   "text": "این دروغ محضه. چرا حالیت نمی‌شه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 526.82,
   "end": 531.32,
   "text": "مگه قوه خیال نداری؟ چطور خیلی چیزا رو نمی‌فهمی با مثال می‌فهمی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 531.32,
   "end": 534.72,
   "text": "ولی هدایت رو که خدا برات مثل می‌زنه نمی‌فهمی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 534.72,
   "end": 538.28,
   "text": "دیگه مثلی شیرین‌تر از عرض شود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 538.28,
   "end": 541.28,
   "text": "نهر و بهشت رو می‌خواد مثال بزنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 541.28,
   "end": 543.96,
   "text": "میگه مثل، مثل بهشت ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 543.96,
   "end": 547.42,
   "text": "که مثلا اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 547.42,
   "end": 550.4,
   "text": "من تحت الأنهار ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 550.4,
   "end": 553.36,
   "text": "اون جنات تجری من تحت الأنهار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 553.36,
   "end": 555.48,
   "text": "اون تحت الأنهار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 555.48,
   "end": 561.54,
   "text": "نهر دیگه مثال شیرین‌تر از این واضح‌تر از نهر آب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 561.54,
   "end": 565.28,
   "text": "جنات تجری میاد مثل می‌زنه به نهرها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 565.28,
   "end": 569.1,
   "text": "برای اینکه ما بفهمیم بعد بگیم نه قلب ما در یک قلفیه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 569.1,
   "end": 570.9,
   "text": "در یک قلافیه از غفلت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 570.9,
   "end": 574.96,
   "text": "اینا رو هم نمی‌فهمیم. معذرت می‌خوام شما حیوان که نیستی که اینو میگی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 574.96,
   "end": 578.48,
   "text": "ولی گفتن. لذا خدا میگه لعنت خدا بر اینها باد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 578.48,
   "end": 584.26,
   "text": "من به انزل مراتب رسوندم اون إنک لَتلقى القرآن من لدن حكيم عليم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 584.26,
   "end": 588.32,
   "text": "اون تلقي حضرت پیغمبر قرآن رو از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 588.32,
   "end": 592.9,
   "text": "علم لدنیه خودم، ذات وجودی خودم رو کشوندم به انزل مراتب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 592.9,
   "end": 595.96,
   "text": "یعنی مثال‌های قرآنی باز میگی نمی‌خوام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 595.96,
   "end": 599.54,
   "text": "دیگه به چه زوری من تو رو بهشتیش-- بهشتید کنم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 599.54,
   "end": 601.78,
   "text": "ببین اینطوری که بحث می‌کنی. حالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 601.78,
   "end": 604.34,
   "text": "خدا حفظ کنه از تعلّمه رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 604.34,
   "end": 609.68,
   "text": "در کتاب عجیب و بسیار شریف و سنگین انسان در عرف انسان،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 609.68,
   "end": 612.06,
   "text": "انسان در عرف عرفانش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 612.06,
   "end": 615.64,
   "text": "اون فکر می‌کنم اصل دهام به بعد باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 615.64,
   "end": 619.0,
   "text": "پیرامون قوه خیال وقتی حرف می‌زنه میگه شما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 619.0,
   "end": 621.08,
   "text": "اساساً تو خود خواب، این خواب،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 621.08,
   "end": 626.68,
   "text": "خوابی که می‌بینی در رفتی تو عالم مثالت دیگه رفتی تو قوه خیالت داره صورت‌گری می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 626.68,
   "end": 629.86,
   "text": "عالم مثالت تو خواب که رفتی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 629.86,
   "end": 632.8,
   "text": "به یک معنا عالم آخرتته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 632.8,
   "end": 635.6,
   "text": "اینم خوب توجه کنید و دیگه بسه امروز.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 635.6,
   "end": 643.0,
   "text": "جالبه میگه اونجا اگر شما در عالم مثال مجردات عقلیه و نوریه یعنی ملائکه رو ببینی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 643.0,
   "end": 647.22,
   "text": "یعنی مرتبط بشه قوه خیال تو با",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 647.22,
   "end": 650.3,
   "text": "عقل عالم به یک پله بالاتر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 650.3,
   "end": 652.2,
   "text": "خیال تو می‌خواد اینو صورت‌گری کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 652.2,
   "end": 657.12,
   "text": "به چه صورتی درش میاره؟ چون قوه خیال باید صورت بذار-- بسازه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 657.12,
   "end": 660.34,
   "text": "شکل بسازه. مرتبطه بین عقل و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 660.34,
   "end": 663.46,
   "text": "یعنی ملکوت و ملکه. باید به ن--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 663.46,
   "end": 667.12,
   "text": "یه ذره نش-- اینو بیاره نزدیکش کنه به ملکوت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 667.12,
   "end": 676.46,
   "text": "میاره اون حقایق سنگین یعنی مثلا ملائکه‌ای که در خواب تو دیدی رو قوه خیالت به شکل انسان‌ها در میاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 676.46,
   "end": 682.12,
   "text": "چون وزین‌ترین شکل، معتدل‌ترین شکل در نظام طبیعت شکل انسانه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 682.12,
   "end": 684.58,
   "text": "تو تو خواب انسان‌ها رو می‌بینی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 684.58,
   "end": 691.2,
   "text": "که هرچی اون خوابت شفاف‌تر باشه تو انسان شریف‌تری رو می‌بینی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 691.2,
   "end": 696.12,
   "text": "و هرچی قوه خیالت طهارت بالاتری داشته باشه انسان‌های",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 696.12,
   "end": 701.56,
   "text": "اشرف رو می‌بینی. مثلا مرجع تقلید می‌بینی، یکی وقت امام زمان می‌بینی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 701.56,
   "end": 704.72,
   "text": "اما شما در حقیقت در قوه خیال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 704.72,
   "end": 707.1,
   "text": "چه اتفاقی افتاده در خوابت؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 707.1,
   "end": 711.7,
   "text": "قوه خیالت مرتبط شده با عالم عقل، عالم عقل، همون ملائکه الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 711.7,
   "end": 715.98,
   "text": "ملک دیدی تو خواب انسان می‌بینی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 715.98,
   "end": 718.72,
   "text": "اگر معانی کلیه اونجا مت--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 718.72,
   "end": 721.18,
   "text": "متوجه بشی مثلا تو خواب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 721.18,
   "end": 726.68,
   "text": "وجود تو مرتبط بشه با حقایق کلیه، با اصل هدایت، با اصل ولایت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 726.68,
   "end": 731.48,
   "text": "حقایق کلی‌ان. درک اون تو خواب به چه صورت در میاد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 731.48,
   "end": 734.86,
   "text": "قوه خیال ازش لفظ می‌سازه، لفظ.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 734.86,
   "end": 739.02,
   "text": "تو تو خواب یه صدایی، لفظی می‌شنوی یا یه لفظی رو بیان می‌کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 739.02,
   "end": 741.8,
   "text": "این حقایق کلیه‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 741.8,
   "end": 745.02,
   "text": "باز خدای منّان تو خواب تو رو کمک میده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 745.02,
   "end": 749.02,
   "text": "که چه حقایق کلیه که به صورت لفظ در میاد تو خواب،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 749.02,
   "end": 755.82,
   "text": "چه مجردات عقلیه و نوریه که واسطه خیرن یعنی ملائکه که به صورت انسان تو خواب در میان برای تو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 755.82,
   "end": 758.58,
   "text": "تو تو خواب انسان می‌بینی یعنی ملک دیدی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 758.58,
   "end": 762.94,
   "text": "لفظ می‌شنوی و بیان می‌کنی یعنی به حقایق کلی دست پیدا کردی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 762.94,
   "end": 764.78,
   "text": "به انزل مراتب می‌کشونش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 764.78,
   "end": 767.02,
   "text": "یعنی لفظ یعنی شکل انسان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 767.02,
   "end": 773.7,
   "text": "که تو بفهمی حقیقت رو از عالم بالا درک کنی، اخذ کنی و هدایت رو پیش بگیری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 773.7,
   "end": 778.96,
   "text": "اما باز بی‌معرفتی تمامه که انسان بیاد بگه ولمون کن بابا این حرفا چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 778.96,
   "end": 782.24,
   "text": "ما نمی‌فهمیم. دل ما توی قلافیه، نمی‌فهمیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 782.24,
   "end": 787.1,
   "text": "ما رو بی‌خیال شو. حرفای متداول امروز جوونا میگن ول کن بابا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 787.1,
   "end": 788.84,
   "text": "نرود میخ آهنی در سنگ.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 788.84,
   "end": 791.22,
   "text": "به خودشون دارن اهانت می‌کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 791.22,
   "end": 796.3,
   "text": "در حالی که خدا این رشد رو در وجودشون قرار داده به وسیله قوای متعدد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 796.3,
   "end": 799.28,
   "text": "این بحث ادامه داره چون خیلی علمی و دقیق هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 799.28,
   "end": 803.42,
   "text": "انشاالله که خدا توفیق فهم و عملش رو به ما عطا کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 803.42,
   "end": 805.74,
   "text": "عاقبتمون انشاالله به برکت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 805.74,
   "end": 808.5,
   "text": "هدایتگری امام هادی ختم به خیر بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 808.5,
   "end": 811.04,
   "text": "به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}