 ],
 "cues": [
  {
   "i": 0,
   "start": 0.26,
   "end": 2.8,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 2.8,
   "end": 10.72,
   "text": "السلام علیک یا داعی الله و ربانی آیاته سلام علیکم و رحمه الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 10.72,
   "end": 14.66,
   "text": "بحث ما قلب اغلف بود قلبی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 14.66,
   "end": 18.3,
   "text": "در یک غلافی قرار گرفته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 18.3,
   "end": 25.1,
   "text": "و به زعم خود این اشخاص که در آیه هشتاد و هشت سوره بقره مورد بحث بود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 25.1,
   "end": 28.98,
   "text": "میگن و قالوا قلوبنا غلف.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 28.98,
   "end": 33.88,
   "text": "اگر این بخش از نظر مفسرین رو بپذیریم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 33.88,
   "end": 40.28,
   "text": "منظورشون از اینکه قلب ما در غلافه است اینه که به پیغمبر میگن ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 40.28,
   "end": 44.9,
   "text": "این حرفا رو نمی‌فهمیم. قرآن رو نمی‌فهمیم، معارف رو نمی‌فهمیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 44.9,
   "end": 49.76,
   "text": "این برهان و عرفان و قرآنی که تو آوردی رو نمی‌فهمیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 49.76,
   "end": 53.62,
   "text": "این اگر به این بخش توجه کنیم که حالا اینو خیلی بهش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 53.62,
   "end": 58.68,
   "text": "تو این چند قسمت قبلی جلسات قبلیمون توجه نکردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 58.68,
   "end": 60.66,
   "text": "امروز یه چیزکی اینجا توقف کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 60.66,
   "end": 68.94,
   "text": "اگه این مورد بحث باشه به نوعی همون اهانت نفس است عزیزان یعنی طرف ناخودآگاه یا خودآگاه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 68.94,
   "end": 72.32,
   "text": "دچار اهانت به خودش شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 72.32,
   "end": 78.8,
   "text": "میگه من این حرفا رو نمی‌فهمم در حالی که صریح آیه قرآن است که و ما خلقت الجن والانس الا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 78.8,
   "end": 85.06,
   "text": "ليعرفون. ليعرفون رو مفسرین گذاشتن ذیل چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 85.06,
   "end": 90.74,
   "text": "ليعبدون. و ما خلقت الجن والانس الا ليعبدون اصل آیه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 90.74,
   "end": 97.14,
   "text": "مفسرین گفتن بر اساس روایات اهل بیت که ذیل این آیه آوردن ای ليعرفون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 97.14,
   "end": 102.32,
   "text": "یعنی اساسا فلسفه خلقت ما عرفان است، عرفان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 102.32,
   "end": 108.54,
   "text": "که البته بر اساس رساله ای که حضرت علامه حسن زاده حفظه الله تعالی نوشتند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 108.54,
   "end": 111.92,
   "text": "سراسر برهان و یا همون حکمت و فلسفه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 111.92,
   "end": 116.26,
   "text": "برهان و قرآن و عرفان رو یک حقیقت میدونن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 116.26,
   "end": 120.36,
   "text": "در هر حال اونها در برابر این حقیقت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 120.36,
   "end": 127.5,
   "text": "نظام هستی که چاره‌ای هم جز اون نیست چون فلسفه خلقت ماست مقاومت می‌کنند میگن ما نمی‌فهمیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 127.5,
   "end": 129.14,
   "text": "این چیزا این حرفا برا ما سنگینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 129.14,
   "end": 134.02,
   "text": "الان برا ما پیش میاد خیلی. تو چهار تا کلمه حرف درست حسابی علمی داری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 134.02,
   "end": 135.96,
   "text": "میگه آقا ما نمی‌فهمیم. ولش کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 135.96,
   "end": 138.4,
   "text": "این حرفا رو به دیگران بزن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 138.4,
   "end": 141.88,
   "text": "برای ما داستان بگو. مثال بزن تا بفهمیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 141.88,
   "end": 146.34,
   "text": "یعنی ما به قوه عقل وجود خودمون متاسفانه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 146.34,
   "end": 148.16,
   "text": "دسترسی پیدا نکردیم هنوز.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 148.16,
   "end": 150.62,
   "text": "تو عالم مثال و خیال خودمون موندیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 150.62,
   "end": 153.16,
   "text": "این خیلی خطرناکه. امثال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 153.16,
   "end": 159.78,
   "text": "ملاصدراها، صدرا المتألهین اینا بیکار نبودن که برن حالا تبعید شد کهک قم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 159.78,
   "end": 163.86,
   "text": "خب شب‌ها تا صبح اونجا عبادت می‌کرد، سجده طولانی، گریه زاری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 163.86,
   "end": 170.3,
   "text": "خودش میگه من با این اشک‌ها، این ناله‌ها از خدا این عرفان و این علم رو گرفتم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 170.3,
   "end": 173.96,
   "text": "ام الکتاب فلسفه یعنی شناخت خودت رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 173.96,
   "end": 176.4,
   "text": "می‌خوای نفس ناطقه خودت رو بشناسی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 176.4,
   "end": 180.48,
   "text": "چاره‌ای نیست جز اینکه کتاب اسفار ایشون رو بخونی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 180.48,
   "end": 185.76,
   "text": "جالبه که بدونید من حيث المجموع بر اساس حالا اون ق-- کتاب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 185.76,
   "end": 191.08,
   "text": "شریف صد کلمه در معرفت نفس حضرت علامه حسن زاده حفظه الله تعالی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 191.08,
   "end": 199.3,
   "text": "حدود صد قول بر چیستی نفس در میان علما و حکما وجود داره که اصلا نفس انسان چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 199.3,
   "end": 206.42,
   "text": "که ملاصدرا چهل قولش رو در کتاب اسفارش نشسته بررسی علمی کرده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 206.42,
   "end": 210.94,
   "text": "که حالا سه تاش دیگه مخلص و چکیده و زبده و مثلا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 210.94,
   "end": 216.42,
   "text": "خیلی از همه متعالی‌ترن که حالا بعضی معتقدند انسان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 216.42,
   "end": 226.24,
   "text": "جسمانیة الحدوثه و روحانیة البقاء است با جسم حادث شده، ایجاد شده، به وجود اومده و به سمت روحانیت در حرکته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 226.24,
   "end": 235.28,
   "text": "بعضیا میگن نه. روحانیة الحدوثه و روحانیة البقاء هم هست یعنی با روح حادث شده با روح به سمت روحش هم میره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 235.28,
   "end": 239.46,
   "text": "یا به سر-- به سمت همون و نفخت فیهم من روحی منه میره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 239.46,
   "end": 245.74,
   "text": "بعضیا میگن نه. جسمانی-- روحانیة الحدوثه یا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 245.74,
   "end": 250.26,
   "text": "این نظر هم وجود داره. جسمانیة الحدوث و جسمانیة البقاء.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 250.26,
   "end": 255.04,
   "text": "میگن با این جسم حادث میشه با این، با همین جسم هم میره باقیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 255.04,
   "end": 264.36,
   "text": "حالا این ت-- بحث تجسم اعمال رو میارن که اصلا متوجه قضیه تجسم اعمال نشدن که اساسا تجسم اعمال چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 264.36,
   "end": 266.04,
   "text": "یا تجسد ا-اعمال.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 266.04,
   "end": 271.58,
   "text": "برمی‌گردونن به عالم ماده در حالی که شما وقتی می‌خوای عالم ماده فارغ بشی بری به مجردات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 271.58,
   "end": 275.86,
   "text": "عقلیه و بری به ملکوت، اونجا اصلا ماده نیست، چه جسمی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 275.86,
   "end": 277.98,
   "text": "حالا اونجا بحث تجسم اعمال چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 277.98,
   "end": 285.48,
   "text": "الان شما هرچی که در نشئه طبیعت در همین متن، متن خارج وجود خودت دیدی و می‌بینی که هم محسوساتم هستن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 285.48,
   "end": 289.98,
   "text": "ماده هم هستن. ببین تو قوه خیالت می‌تونی اینو مجسمش کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 289.98,
   "end": 296.08,
   "text": "قوه خیال پنجاه درصدش حالا نیمیش مادیش مادیه نیمیش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 296.08,
   "end": 299.88,
   "text": "ملکوتیه دیگه. برزخ بین دنیا و آخرته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 299.88,
   "end": 302.46,
   "text": "خب قوه خیال الان اینو مجسم کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 302.46,
   "end": 305.94,
   "text": "مگه مجرد نیست؟ مجرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 305.94,
   "end": 310.36,
   "text": "الان وجود خارجی نداره که تو وجود توعه داری می‌بینیش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 310.36,
   "end": 314.0,
   "text": "این همون تجسم اعماله. حالا باید درباره‌ش بحث بشه که علامه در کتاب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 314.0,
   "end": 319.08,
   "text": "انسان در عرفانش خیلی حرف‌های سنگین و قشنگی پیرامون این قضیه پیاده کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 319.08,
   "end": 322.74,
   "text": "خب ملاصدرا که بیکار نبوده بشینه وقتشو تلف کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 322.74,
   "end": 328.12,
   "text": "یه عمر مرحوم آخوند که چهل نظر از ن--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 328.12,
   "end": 330.6,
   "text": "مثلا نظر حالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 330.6,
   "end": 334.58,
   "text": "نظر مشاء بگیر، حکمت اشراق بگیر، متعالیه بگیر که اینا چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 334.58,
   "end": 337.4,
   "text": "مثلا نفس انسان چیه؟ بیکار بوده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 337.4,
   "end": 339.48,
   "text": "و شیخ الرئیس استغفرالله بیکار بوده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 339.48,
   "end": 342.62,
   "text": "علامه حسن زاده بیکاره عمرشو بذاره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 342.62,
   "end": 345.4,
   "text": "یه حدیث از امام هادی صلوات الله علیه عرض کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 345.4,
   "end": 349.6,
   "text": "این حدیث رو خوب د-- توجه کنید که چرا عرض کردم اگر کسی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 349.6,
   "end": 355.28,
   "text": "اینطوری فکر کنه مثل اینایی که تو این آیه گفتن به پیغمبر، یهودیا و مشرکین و اینا مکه یا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 355.28,
   "end": 360.36,
   "text": "هر جا اینا اینطوری گفتن و قالوا قلوبنا غلف دچار اهانت نفس شده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 360.36,
   "end": 367.62,
   "text": "اینو امام هادی صلوات الله علیه به زیبایی تمام معجزه وار در یک، جز معجزات قولیه‌ی امام هادیه بیان کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 367.62,
   "end": 370.81,
   "text": "من هانت علیه نفسه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 370.81,
   "end": 373.47,
   "text": "اگر کسی دچار اهانت نفس بشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 373.47,
   "end": 375.97,
   "text": "اهانت از توهین میاد، وهن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 375.97,
   "end": 380.75,
   "text": "وهن میگن مثلا آقا اشکال داره ما تو مسجد دست بزنیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 380.75,
   "end": 385.37,
   "text": "مراجع بل-- بلاتفاق میگن که آقا چون وهن دین می‌شه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 385.37,
   "end": 388.37,
   "text": "مسجد رو چون عظمت داره مسجد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 388.37,
   "end": 392.23,
   "text": "کوچیک می‌کنه. وهن یعنی کوچیک کردن، تحقیر دین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 392.23,
   "end": 394.87,
   "text": "برای همین جایز نیست در مسجد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 394.87,
   "end": 399.21,
   "text": "حالا جاهای دیگه می‌خوای بزن. این وهن یعنی کوچیک کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 399.21,
   "end": 406.61,
   "text": "امام هادی صلوات الله علیه می‌فرمود \"من هانت علیه نفسه\" کسی که دچار اهانت به نفسش بشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 406.61,
   "end": 413.79,
   "text": "یعنی این نفس انقدر مراتبش عالیه است که قبلاً عرض شد تنها وجودی‌ست که به وزان حضرت حق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 413.79,
   "end": 419.45,
   "text": "خدا ایجاد کرده و آفریده‌ش هم در صفات، هم در افعال و هم در ذات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 419.45,
   "end": 423.23,
   "text": "لذا تو خودتو، نفستو بشناسی خدا رو شناختی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 423.23,
   "end": 425.13,
   "text": "میگه این چه اتفاقی براش میفته؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 425.13,
   "end": 427.39,
   "text": "\"من هانت علیه نفسه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 427.39,
   "end": 430.93,
   "text": "فلا تأمن شرّه\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 430.93,
   "end": 434.01,
   "text": "دیگه از شرش ایمن نباش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 434.01,
   "end": 438.39,
   "text": "مراقب باش. حالا می‌خوای خودت باشی، نفس خودت باشه بهش توهین کنی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 438.39,
   "end": 441.61,
   "text": "می‌خوای دیگران. اینا دچار اهانت به نفس شدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 441.61,
   "end": 443.65,
   "text": "یعنی میگم بابا ول کن این حرفا چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 443.65,
   "end": 446.29,
   "text": "سنگینه نمی‌فهمیم. حکمت چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 446.29,
   "end": 451.63,
   "text": "عرفان چیه؟ قرآن چیه؟ بابا د-دو تا حکمت چه عرض شود، مثال بزن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 451.63,
   "end": 453.33,
   "text": "دو تا داستان برای ما بگو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 453.33,
   "end": 456.63,
   "text": "حکایت بگو ما اینطوری دا-- دین رو بفهمیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 456.63,
   "end": 459.75,
   "text": "با اینکه همش قوه خیاله که مثال و مثال،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 459.75,
   "end": 462.79,
   "text": "مثال وجود ما برزخ وجود ما خیاله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 462.79,
   "end": 467.37,
   "text": "که تصویرسازی می‌کنه برای فهم سهولت فهم مطالب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 467.37,
   "end": 473.19,
   "text": "ولی فهم مربوط به قوای عقلیه است، مربوط به مراتب بالا است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 473.19,
   "end": 475.33,
   "text": "بعد ما دستمون به عقل وجودمون نمی‌رسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 475.33,
   "end": 480.07,
   "text": "انگار که پرده انداختیم رو عقل وجودمون، رو باطن وجودمون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 480.07,
   "end": 482.09,
   "text": "همش خیالی داریم زندگی می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 482.09,
   "end": 485.31,
   "text": "آقا مثال بزن، آقا داستان بگو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 485.31,
   "end": 491.11,
   "text": "بحثای تا بحث علمی و سنگین و عقلی میره-- میاد وسط پا پیش می‌کشن همه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 491.11,
   "end": 494.13,
   "text": "پا پس می‌کشن همه می‌کشن کنار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 494.13,
   "end": 499.39,
   "text": "ول کن بابا سخته. حالا درسته قرآن هم سرتا سر مثاله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 499.39,
   "end": 502.41,
   "text": "\"تلك الأمثال نضربها للناس\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 502.41,
   "end": 505.63,
   "text": "قرآن هم چون با عموم مردم مرتبطه مثال می‌زنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 505.63,
   "end": 512.79,
   "text": "مثل. مثال. مثال همون مرتبطه با قوه خیال تو یا عالم مثال وجودی تو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 512.79,
   "end": 519.61,
   "text": "اما همون هم ادامه آیه می‌فرماید \"ولا يعقلها إلا العالمون\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 519.61,
   "end": 522.31,
   "text": "همین را هم تعقل نمی‌کنند مگر علما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 522.31,
   "end": 524.91,
   "text": "همین مثال‌های قرآنی رو. خیلی س--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 524.91,
   "end": 530.19,
   "text": "بله سنگینه اما خدا قوه‌ای رو در وجود ما گذاشته به نام عقل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 530.19,
   "end": 538.05,
   "text": "که پل بزنه بین برزخ وجود ما یا خیال با عالم کشف و شهود که قلب ماست یا روح ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 538.05,
   "end": 542.83,
   "text": "داریم ما اینو. بعد ما می‌خوایم تو همین انزل مراتب توقف کنیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 542.83,
   "end": 545.37,
   "text": "می‌خوایم بریم تو پایین شهر بهشت فوقش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 545.37,
   "end": 549.77,
   "text": "با یه شفاعت و اینا. در حالی که شفاعت هم فرمودن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 549.77,
   "end": 556.33,
   "text": "شفاعت یعنی همون مقام استعداد درونی تو، اون استعداد، اون فطرت وجودی تو باید از م--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 556.33,
   "end": 560.17,
   "text": "از گناه و معصیت و قذارات و آلودگی حفظ کنی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 560.17,
   "end": 562.27,
   "text": "پاک حفظش کنی ببریش اونور.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 562.27,
   "end": 565.95,
   "text": "لذا علامه می‌فرما تو شفاعت رو از همین دنیا باید ببری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 565.95,
   "end": 569.45,
   "text": "شفع یعنی جفت. تو این اس--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 569.45,
   "end": 578.59,
   "text": "این فطرت که در درونت که از ولایت کلیه الهیه است باید ببری جفت بشه با اون ولایتی که قراره شفاعت، شفیعت باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 578.59,
   "end": 582.25,
   "text": "اگه استعداد از این دنیا نره، اون دنیا شفاعتی نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 582.25,
   "end": 587.55,
   "text": "ما با گناه، با معصیت، با بی‌توجهی، با بی‌معرفتی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 587.55,
   "end": 592.43,
   "text": "به معارف ز-- می‌زنیم این استعدادو از بین می‌بریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 592.43,
   "end": 595.05,
   "text": "بعد می‌خوایم اونور شفاعت کنن. این حرفا چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 595.05,
   "end": 598.43,
   "text": "حواسمون به این آیه باشه. اینم بخونم برام تو ذهنم اومد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 598.43,
   "end": 600.03,
   "text": "\"يرفع\". بله درسته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 600.03,
   "end": 602.53,
   "text": "\"يرفع الله الذين آمنوا\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 602.53,
   "end": 604.83,
   "text": "خدا ارتفاع مقام میده، می‌بره بالا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 604.83,
   "end": 607.07,
   "text": "کیارو؟ اونایی که اهل ایمانن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 607.07,
   "end": 610.81,
   "text": "اما \"والذين أوتوا العلم درجات\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 610.81,
   "end": 614.37,
   "text": "اون مدارج یا به عبارتی اون معارج،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 614.37,
   "end": 619.85,
   "text": "معارج انسانی، معراج‌ها که بر اساس مدارج قرآنیه درجه‌ها،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 619.85,
   "end": 623.51,
   "text": "مال علمائه. \"والذين أوتوا العلم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 623.51,
   "end": 625.93,
   "text": "درجات\". کسایی که بهشون علم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 625.93,
   "end": 628.29,
   "text": "داده شده است. علم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 628.29,
   "end": 632.85,
   "text": "علم مال مرحله عقل انسانه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 632.85,
   "end": 634.75,
   "text": "به هر حال اینا دچار این اهانت شدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 634.75,
   "end": 637.65,
   "text": "مراقب باشید ما دنبال روای اونا رو نکنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 637.65,
   "end": 642.27,
   "text": "از الان یه برنامه‌ای داشته باشیم هر روز برای شناخت نفس خودمون قدم برداریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 642.27,
   "end": 645.53,
   "text": "همینطوری دیگه عمر داره میره و خبر نداریم کی هستیم، چی هستیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 645.53,
   "end": 647.73,
   "text": "یکی از مراتب سنگینی و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 647.73,
   "end": 652.29,
   "text": "فشار قبر و ظلمت و تاریکی و اون فشارهای روحی و این‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 652.29,
   "end": 655.59,
   "text": "برمی‌گرده به همین که یه دفعه پرده‌ها میفته از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 655.59,
   "end": 661.79,
   "text": "ظاهر خودت وارد به باطن وجود خودت میشی میگی اوه، اوه، اوه چه خبر بوده تو وجودت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 661.79,
   "end": 665.47,
   "text": "این فشار روحی و سختی و سنگینی اون موقع اتفاق خواهد افتاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 665.47,
   "end": 667.07,
   "text": "همینجا موتو قبلاً تموتو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 667.07,
   "end": 669.91,
   "text": "بسم الله. از الان این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 669.91,
   "end": 674.17,
   "text": "پرده رو بنداز، ظاهراً بمیر، برو به درون خودت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 674.17,
   "end": 677.43,
   "text": "که اونور راحت باشی. مثل ملا علی چی فرمودن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 677.43,
   "end": 680.81,
   "text": "\"لو كشف الغطاء",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 680.81,
   "end": 684.51,
   "text": "ما زادت يقينا\". اگه پرده بیفته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 684.51,
   "end": 687.39,
   "text": "سر سوزنی به یقین من اضافه نمی-- نمی‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 687.39,
   "end": 690.65,
   "text": "یعنی اصلاً ظاهر و باطن برای من یکی شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 690.65,
   "end": 692.53,
   "text": "خب اون مگر امام ما نیست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 692.53,
   "end": 695.63,
   "text": "پیشوای ما مگه نیست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 695.63,
   "end": 702.77,
   "text": "اگر ما پشت سرها حرکت کنیم دیگه چه فشار قبری، چه سكرات مرگی، چه ترس و وحشت و چه ظلمت و چه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 702.77,
   "end": 705.27,
   "text": "فشارهای روحی و عذابی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 705.27,
   "end": 708.83,
   "text": "خب همینجا پرده‌ها میفته، ظاهر و باطن یکی می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 708.83,
   "end": 712.25,
   "text": "اصلاً آخرت ازل و ابد یکی می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 712.25,
   "end": 716.33,
   "text": "آخرتت تو همین دنیا قیامت، قیامتت همینجا قیام می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 716.33,
   "end": 718.87,
   "text": "ببخشید طویل الكلام شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 718.87,
   "end": 720.81,
   "text": "انشاالله خدا ما بپذیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 720.81,
   "end": 726.37,
   "text": "عاقبتمون انشاالله ختم بخیر بشه به برکت صلوات بر محمد و آل محمد. الله-",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}