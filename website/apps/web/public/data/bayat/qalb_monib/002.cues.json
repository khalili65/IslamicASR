 },
 "chapters": [
  {
   "index": 0,
   "title": "## سوار شدن بر وسیله‌ای که برای نماز نمی‌ایستد",
   "start": 13.04,
   "end": 95.28
  },
  {
   "index": 1,
   "title": "## قلب منیب؛ دروازهٔ قلب مطمئن",
   "start": 95.28,
   "end": 532.08
  },
  {
   "index": 2,
   "title": "## نهیب الهی برای محبوبان",
   "start": 532.08,
   "end": 608.5
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 2.3,
   "end": 5.4,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 5.4,
   "end": 8.96,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 8.96,
   "end": 13.04,
   "text": "آیاته. سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 13.04,
   "end": 16.18,
   "text": "از رهبر عزیزمون استفتاء کردن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 16.18,
   "end": 23.0,
   "text": "اگر بخوایم سوار وسیله‌ای بشیم که مثلاً اتوبوس می‌دونیم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 23.0,
   "end": 26.06,
   "text": "اه بین راه برای نماز نگه نمی‌داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 26.06,
   "end": 30.74,
   "text": "می‌تونیم سوار بشیم؟ شرعا جایزه هست سوار شدن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 30.74,
   "end": 35.72,
   "text": "متاسفانه این هست خیلی از این راننده‌ها حتی تو راه هم بهشون بگی وا نمی‌ایستن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 35.72,
   "end": 41.56,
   "text": "انقدر پررو شدن. حالا رهبر جوابشون این هست در این استفتائه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 41.56,
   "end": 45.04,
   "text": "اگر در صورتی که شما بدونید که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 45.04,
   "end": 48.06,
   "text": "اون شخص منظورش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 48.06,
   "end": 55.9,
   "text": "و این کاری که می‌کنه استخفاف نماز نیست، سبک شمردن نماز نیست، چیز دیگه‌ایه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 55.9,
   "end": 62.4,
   "text": "یا و مخصوصاً اینکه این قید هم هست اینکه وقت نماز هنوز نشده باشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 62.4,
   "end": 64.94,
   "text": "در این صورت می‌تونید سوار بشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 64.94,
   "end": 69.78,
   "text": "اما اگر وقت نمازه یعنی وقت اذان داده وقت نماز شده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 69.78,
   "end": 73.36,
   "text": "و شما می‌دونی سوار شی وا نمی‌ایسته حق نداری سوار شی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 73.36,
   "end": 80.56,
   "text": "باید نمازتو بخونی و بری. در خصوص قلب که موضوع بسیار مهمی رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 80.56,
   "end": 85.38,
   "text": "خدا لطف کرده و حالا ما دست گرفتیم و هرچی هم میریم جلوتر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 85.38,
   "end": 89.92,
   "text": "نگرانی من و دل دل کردنم برای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 89.92,
   "end": 94.94,
   "text": "ادامه این بحث بیشتر می‌شه چون خیلی دقیق‌تر و ظریف‌تره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 94.94,
   "end": 103.92,
   "text": "موضوع قلب منیب که عرض کردیم پنجمین نوع قلبی که ما مورد بحث قرار میدیم در قرآن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 103.92,
   "end": 105.9,
   "text": "مطالبه همه ما هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 105.9,
   "end": 110.36,
   "text": "همه ما اهل توبه و استغفار و برگشت به سمت خدا هستیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 110.36,
   "end": 113.84,
   "text": "لکن مهم اینه که این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 113.84,
   "end": 115.46,
   "text": "عنابه دائماً باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 115.46,
   "end": 123.88,
   "text": "در صورتی ما دارای قلب منیب خواهیم بود، دیروز عرض کردیم که دائماً مشغول برگشت به سمت خدا باشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 123.88,
   "end": 131.12,
   "text": "آن به آن مشغول استغفار و طلب مغفرت از خدای منان باشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 131.12,
   "end": 138.96,
   "text": "و شما می‌دونید یکی از دلایلی که هستن این جایگاه رو در وجود ما اسمش رو گذاشتن قلب که منقلب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 138.96,
   "end": 143.44,
   "text": "است یعنی دائماً در حالت دگرگونی‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 143.44,
   "end": 145.74,
   "text": "سیری هم ندارد چه تو بحث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 145.74,
   "end": 148.8,
   "text": "شهوات و ماديات،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 148.8,
   "end": 151.06,
   "text": "چه تو بحث معنویات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 151.06,
   "end": 157.28,
   "text": "سیری و حد یقف نداره تا انتهای راهی رو پیدا کنه میره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 157.28,
   "end": 164.0,
   "text": "و برای اینکه نجات پیدا کنه از لغزش‌ها و از هواها و هوس‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 164.0,
   "end": 166.64,
   "text": "قطعاً نیاز به عنابه هست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 166.64,
   "end": 171.34,
   "text": "که انسان با خلوص متوجه خدا بشه آن به آن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 171.34,
   "end": 181.36,
   "text": "راه رسیدن به-- اینو دقت کنین، راه رسیدن یا میشه گفت دروازه یا ابتدای راه رسیدن به قلب مطمئن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 181.36,
   "end": 183.44,
   "text": "که اگر می‌خوایم ما در قیامت انشاالله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 183.44,
   "end": 185.38,
   "text": "هم‌نشین با اولیا و اهل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 185.38,
   "end": 192.84,
   "text": "بیت علیهم الصلاة والسلام باشیم که باید دارای قلب مطمئن باشیم تا به اونجا برسیم راه رسیدنش قلب منیبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 192.84,
   "end": 196.18,
   "text": "یعنی عنابه دائم. نمیشه انسان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 196.18,
   "end": 201.6,
   "text": "شب که می‌خواد بخوابه توبه کنه، شب جمعه هفته‌ای یه بار توبه کنه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 201.6,
   "end": 205.86,
   "text": "شب قدر سالی یه بار توبه کنه، بعد منیب باشه و به قلب مطمئن برسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 205.86,
   "end": 210.52,
   "text": "نمیشه اصلاً این اتفاق نمیفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 210.52,
   "end": 216.06,
   "text": "در هر حال شما حساب کنید به قول پیغمبر کسی که هر روز پنج نوبت بره حموم اصلاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 216.06,
   "end": 223.48,
   "text": "چیزی از رژ و ناپاکی تو وجودش می‌مونه که اشاره به نماز کردن تا کسی که بخواد هفته‌ای یه بار بره حموم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 223.48,
   "end": 229.52,
   "text": "یا سالی یه بار. چه چرکی رو بدنش می‌مونه تا کیسه و چه سنگا و چیا اینا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 229.52,
   "end": 235.24,
   "text": "روشوره و اینا نکشه نمیره. تازه همونش هم خیلی‌هاش نمیره بدل به دمل و چرک و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 235.24,
   "end": 237.28,
   "text": "سرطان و چه و چه می‌شه بخواد بمونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 237.28,
   "end": 243.44,
   "text": "خیلی از گناهان ما به خاطر باقی موندنش بدل به سرطان اخلاقی و روحی روانی می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 243.44,
   "end": 246.4,
   "text": "حالا یه راهی هست این راه رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 246.4,
   "end": 250.16,
   "text": "اگر دقت کنید یه مقدار این حدیث می‌ریزه به هم ما رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 250.16,
   "end": 256.76,
   "text": "من خودم وقتی مطالعه کردم خیلی به هم ریختم و هرکی اومد پیشم گفتم یه ذره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 256.76,
   "end": 259.76,
   "text": "مشوشم، کاری به کار من نداشته باش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 259.76,
   "end": 264.48,
   "text": "این حدیث خیلی عجیبه. از امیرالمؤمنین علیه الصلاة والسلام هست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 264.48,
   "end": 269.04,
   "text": "که حضرت آقای ری‌شهری حفظه الله تعالی در کتاب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 269.04,
   "end": 276.5,
   "text": "منتخب المیزان والحکمه‌شون جل یک صفحه پونصد و چهار این حدیث را آوردن که البته ایشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 276.5,
   "end": 280.78,
   "text": "نقل کردن از بحار جل صد و چهار صفحه چهل و یک.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 280.78,
   "end": 284.2,
   "text": "مولامون علی علیه الصلاة والسلام فرمودن راه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 284.2,
   "end": 286.58,
   "text": "اینکه شما می‌خوای پیدا کنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 286.58,
   "end": 289.7,
   "text": "چی رو؟ قلبت در چه وضعیتیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 289.7,
   "end": 292.22,
   "text": "حالت وضعیت قلبت رو بسنجی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 292.22,
   "end": 295.02,
   "text": "گمان کن رفتی دکتر، طبیب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 295.02,
   "end": 299.52,
   "text": "می‌گوید من می‌خوام ببینم وضع قل-- چطور نوار قلب می‌گیری؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 299.52,
   "end": 303.16,
   "text": "می‌خوام ببینم وضعیت قلبم در چه حالتی‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 303.16,
   "end": 307.3,
   "text": "مولا بسیار زیرکانه در چند کلمه این رو فرمودن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 307.3,
   "end": 309.9,
   "text": "چون کسی اومد پیش امیرالمؤمنین گفت آقا من",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 309.9,
   "end": 312.4,
   "text": "جاهلم و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 312.4,
   "end": 316.4,
   "text": "فقیرم و مریضم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 316.4,
   "end": 321.28,
   "text": "و ضعیفم. حضرت فرمود اگه ضعیفی برو به یک قوی رجوع کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 321.28,
   "end": 324.5,
   "text": "اگه مریضی برو به طبیب رجوع کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 324.5,
   "end": 326.86,
   "text": "اگه فقیری برو به یک غنی رجوع کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 326.86,
   "end": 328.88,
   "text": "اگه جاهلی برو به یه عالم رجوع کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 328.88,
   "end": 331.18,
   "text": "گفت خب آقا منم رجوع کردم دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 331.18,
   "end": 334.2,
   "text": "طبیب من شمایی، عالم من شمایی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 334.2,
   "end": 338.06,
   "text": "حالا این عالم دوار،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 338.06,
   "end": 341.68,
   "text": "این طبیب دوار نسخه پیچیده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 341.68,
   "end": 343.56,
   "text": "فرم-- خیلی عجیبه این حدیث.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 343.56,
   "end": 346.88,
   "text": "واقعاً تن آدم رو می‌لرزونه. می‌فرماید العین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 346.88,
   "end": 349.94,
   "text": "جاسوس القلب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 349.94,
   "end": 352.52,
   "text": "و برید العقل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 352.52,
   "end": 356.14,
   "text": "تو همین سندی که عرض کردم تو همین صفحه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 356.14,
   "end": 361.14,
   "text": "باز از مولا یه روایت آورده با همین مضمون می‌فرماید القلب برید--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 361.14,
   "end": 363.86,
   "text": "العين برید القلب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 363.86,
   "end": 365.9,
   "text": "اولی می‌فرماید العین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 365.9,
   "end": 368.54,
   "text": "چشم جاسوس القلب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 368.54,
   "end": 371.24,
   "text": "چشم جاسوس قلبه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 371.24,
   "end": 374.56,
   "text": "و برید العقل و پیغام‌رسان عقله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 374.56,
   "end": 376.94,
   "text": "تو دومیش می‌فرماید العین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 376.94,
   "end": 380.72,
   "text": "برید القلب. فرق نمی‌کنه دو تاش یه، یه مضمونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 380.72,
   "end": 384.28,
   "text": "چشم جاسوس و پیغام‌رسان چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 384.28,
   "end": 391.24,
   "text": "قلب انسانه. کسی که یکی رو جاسوس می‌کنه میره میگه برو فلان، براش ماموریت تعیین می‌کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 391.24,
   "end": 395.1,
   "text": "طبق اون چیزی که می‌خواد، دلخواشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 395.1,
   "end": 398.42,
   "text": "ماموریت برای جاسوس و پیغام‌رسانش تعیین می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 398.42,
   "end": 401.22,
   "text": "میگه برو این چیزا رو برای من جمع کن بیار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 401.22,
   "end": 405.18,
   "text": "درسته؟ لذا بهش میگن جاسوس یا پیغام‌رسان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 405.18,
   "end": 407.7,
   "text": "چشم پیغام‌رسان قلبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 407.7,
   "end": 413.62,
   "text": "یعنی اگر کسی می‌خواد بدونه قلبش در چه وضعیتی قرار گرفته قربونتون برم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 413.62,
   "end": 417.84,
   "text": "باید ببینه چشمش دنبال چه چیزهایی می‌گرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 417.84,
   "end": 421.22,
   "text": "چم-- چشمش از چی خوشش میاد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 421.22,
   "end": 423.84,
   "text": "چشم به کجاها دوخته میشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 423.84,
   "end": 426.1,
   "text": "از چه چیزهایی لذت می‌بره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 426.1,
   "end": 428.46,
   "text": "به چه چیزهایی توجه داره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 428.46,
   "end": 430.52,
   "text": "این چشم داره پیغام میده به قلب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 430.52,
   "end": 433.46,
   "text": "قلب هم حقیقتی‌ست که ما وقتی می‌میریم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 433.46,
   "end": 437.1,
   "text": "جسمه که می‌ندازنش اونور تا قیامت ما کاری باهاش نداریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 437.1,
   "end": 442.22,
   "text": "تو برزخ هم یه جسم جدید مثال همون که تو خواب باشیم اینور اونور میریم به ما میدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 442.22,
   "end": 446.18,
   "text": "اون حقیقتی که باقی می‌مونه و بر اساس اون ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 446.18,
   "end": 450.42,
   "text": "بعد و قربمون به خدا تعیین میشه قلب ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 450.42,
   "end": 454.64,
   "text": "حقیقت تثبیت شده در وجود ما همون حقیقت قلب ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 454.64,
   "end": 457.54,
   "text": "این قلب رو بررسی می‌کنند دم مرگ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 457.54,
   "end": 460.48,
   "text": "که در چه وضعیتی هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 460.48,
   "end": 464.08,
   "text": "اما بررسی‌ش قبلش دست خود ما سپرده شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 464.08,
   "end": 466.86,
   "text": "از چی؟ از چه طریقی؟ خیلی هم راحته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 466.86,
   "end": 471.86,
   "text": "چشم، اگر چشمی به دنبال شهوات و یه سری‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 471.86,
   "end": 475.98,
   "text": "زیبایی‌های شهوانی و هوای نفس رو خیلی دوست دارن، نمی‌تونن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 475.98,
   "end": 478.6,
   "text": "بارها به ما میگن آقا چه کنیم چشممونو تو این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 478.6,
   "end": 480.68,
   "text": "وانفسای روزگار چه کنیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 480.68,
   "end": 483.98,
   "text": "شهوات فلان. خب ببند کاری نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 483.98,
   "end": 486.62,
   "text": "آه بستن، بستن این پلک.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 486.62,
   "end": 490.46,
   "text": "یه اراده‌ست. یعنی انقدر ما اراده‌مون کم میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 490.46,
   "end": 493.13,
   "text": "اما اگر بازش بذاری دیگه سیرمونی نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 493.13,
   "end": 495.12,
   "text": "بعضیا عاشق تکنولوژی میشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 495.12,
   "end": 497.28,
   "text": "بعضیا عاشق همین موبایل میشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 497.28,
   "end": 500.08,
   "text": "دائما سرشون تو موبایل. بعضیا عاشق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 500.08,
   "end": 501.64,
   "text": "ماشین، بعضیا عاشق پولن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 501.64,
   "end": 503.28,
   "text": "اصلا پول می‌بینن حال می‌کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 503.28,
   "end": 506.8,
   "text": "امیرالمؤمنین یه شبم پول پیش خودش نگه نمی‌داشت، می‌ترسید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 506.8,
   "end": 508.5,
   "text": "می‌فرمود شاید مردم این بمونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 508.5,
   "end": 513.26,
   "text": "همون شب تقسیم می‌کرد. اما حساب بانکی ما چقدره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 513.26,
   "end": 518.3,
   "text": "بعضیا عاشق طبیعت، حیوانات، با حیوانات خو می‌گیرن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 518.3,
   "end": 521.36,
   "text": "هرکی-- بعضیا هم عاشق معنویت میشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 521.36,
   "end": 524.08,
   "text": "هرچی که می‌بینن خدا رو می‌بینن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 524.08,
   "end": 525.52,
   "text": "اینا با هم فرق می‌کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 525.52,
   "end": 531.4,
   "text": "پس اگر می‌خوایم وضعیت قلبمون رو بسنجیم، حالا این بحث رو انشالله ادامه میدیم الان فرصت نیست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 531.4,
   "end": 534.72,
   "text": "چشممونو و اگر خدا ما رو دوست داشته باشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 534.72,
   "end": 541.36,
   "text": "یه موانعی قرار میده که اگر چشم تخطی کرد، اگر قلب ما رو دوست داشته باشه، اگر چشم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 541.36,
   "end": 544.02,
   "text": "تخطی کنه خدا سریع میزنه تو حالمون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 544.02,
   "end": 546.22,
   "text": "یه مثال و مصداق بگم و السلام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 546.22,
   "end": 548.64,
   "text": "شخصی چشم‌چرونی می‌کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 548.64,
   "end": 551.86,
   "text": "هی نگاه می‌کرد به یه نامحرمی داشت همینطوری که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 551.86,
   "end": 554.84,
   "text": "نگاه می‌کرد لذت می‌برد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 554.84,
   "end": 558.18,
   "text": "حواسش نبود از بغل بغل می‌رفت، می‌رفت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 558.18,
   "end": 559.98,
   "text": "تو-- حالا پیغمبر داشت نگاه می‌کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 559.98,
   "end": 563.42,
   "text": "یه دیواری بود، یه استخوان شتر از این دیواره زده بود بیرون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 563.42,
   "end": 567.72,
   "text": "این همینطوری که بغل بغل می‌رفت خورد این استخونه زیر چشمش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 567.72,
   "end": 572.86,
   "text": "کبود شد و خون اومد و داد و فریاد و نشست چشمش رو گرفت و پیغمبر اومد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 572.86,
   "end": 576.08,
   "text": "بهش گفت عزیزم خیلی خدا دوستت داشته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 576.08,
   "end": 581.6,
   "text": "برو خدا رو شکر کن. به محض این رها کردن چشمت سریع چی کار کرد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 581.6,
   "end": 587.22,
   "text": "این نهیب رو بهت زد، این بلا رو سرت آورد که حواستو جمع کنی دیگه چشمتو رها نکنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 587.22,
   "end": 590.5,
   "text": "اما کسی که خدا نمی‌خواد و قلبش رو نپسنده ولش می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 590.5,
   "end": 592.84,
   "text": "اصلاً هر کاری بکنه، هر جا رو نگاه کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 592.84,
   "end": 596.34,
   "text": "این راه‌هاییه که میشه انسان تا حدودی قلبش رو بسنجه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 596.34,
   "end": 602.78,
   "text": "انشالله این بحث رو ادامه میدیم. عاقبتمون به خیر باشه ان شاء الله به ذکر صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 602.78,
   "end": 608.5,
   "text": "اللهم صل على محمد و آل محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}