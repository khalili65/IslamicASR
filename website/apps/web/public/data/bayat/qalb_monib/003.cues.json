 "chapters": [
  {
   "index": 0,
   "title": "## وام خرید کالا و فاکتور صوری",
   "start": 12.7,
   "end": 142.74
  },
  {
   "index": 1,
   "title": "## قلب منیب و سنجش از راه چشم",
   "start": 142.74,
   "end": 334.9
  },
  {
   "index": 2,
   "title": "## نگاه مؤمنانه و دیدن مظاهر اسماء",
   "start": 334.9,
   "end": 356.28
  },
  {
   "index": 3,
   "title": "## نقطهٔ مرکزی؛ وما رأیت إلا جمیلا",
   "start": 356.28,
   "end": 506.27
  },
  {
   "index": 4,
   "title": "## سلام بر قلب زینب؛ تقبل هذا القلیل",
   "start": 506.27,
   "end": 659.05
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 2.42,
   "end": 5.58,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 5.58,
   "end": 10.08,
   "text": "السلام علیک یا داعی الله و بانی ایاته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 10.08,
   "end": 12.7,
   "text": "سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 12.7,
   "end": 19.7,
   "text": "چون یه س-- مسئله شرعی تو خود سازمان پیش اومده فراگیر و خیلی‌هام به بنده رجوع کردن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 19.7,
   "end": 27.52,
   "text": "برای اطمینان خود شما البته من خودم مطمئن بودم ولی باز با دفتر آقا امروز صحبت کردم در خصوص این وامی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 27.52,
   "end": 31.8,
   "text": "دارن بابت خرید کالا میدن از بانک معرفی می‌کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 31.8,
   "end": 37.38,
   "text": "گفتم که خود سازمان اعلام کرده برید وامو بگیرید حالا هر جایی می‌خواید هزینه کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 37.38,
   "end": 40.6,
   "text": "این شرعا حرام است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 40.6,
   "end": 46.06,
   "text": "و هر مدیری هر بخشی نمی‌دونم تو سازمان داره این کارو می‌کنه باید بهش تذکر بدید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 46.06,
   "end": 51.92,
   "text": "و بگید که این حرام است و توصیه به حرام است و بانک داره این پول رو بابت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 51.92,
   "end": 57.04,
   "text": "خرید کالا میده. میگن بانک گفته برید یه فاکتور صوری بیارید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 57.04,
   "end": 60.28,
   "text": "صوری خرید و فروش بشه. اینا همش حرامه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 60.28,
   "end": 62.2,
   "text": "تنها یک راه، یعنی شما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 62.2,
   "end": 64.66,
   "text": "شرعا وقتی یک وامی رو به عنوان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 64.66,
   "end": 71.14,
   "text": "خرید کالا می‌گیری برای هر چیزی، برای هر چیزی وام گرفتی شرعا باید همونجا هزینه کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 71.14,
   "end": 74.84,
   "text": "نمی‌تونی جای دیگه هزینه کنی. حالا این بابت خرید کالاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 74.84,
   "end": 81.72,
   "text": "شما فقط یه راه داری که شرعیش کنی که این وامو گرفتی بری باهاش کالا بخری بعد بفروشیش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 81.72,
   "end": 84.74,
   "text": "وقتی فروختی با اون پول هر کاری می‌تونی بکنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 84.74,
   "end": 91.82,
   "text": "این معامله بین هم باید باز امروز اینو مؤکدا پرسیدم باید صوری نباشه، واقعی باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 91.82,
   "end": 99.36,
   "text": "نبری تو مغازه بگه آقا همینطوری من و شما حرفاً خرید و فروش می‌کنیم بعد پولو بده من برم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 99.36,
   "end": 102.42,
   "text": "آقا این جنست چند؟ این پول پیش شما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 102.42,
   "end": 105.1,
   "text": "حالا پولو برگردون به من فروختم به شما فلان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 105.1,
   "end": 108.5,
   "text": "اینم غلطه. نمیشه. اینا پلا شرعیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 108.5,
   "end": 110.12,
   "text": "حرامه. رُک.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 110.12,
   "end": 116.5,
   "text": "پول حروم هم بیاد تو خونه هزاران برابرش رو با درد و بلا و بدبختی می‌بره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 116.5,
   "end": 120.06,
   "text": "ایشالله که خدا شفا بده همه مرضا رو برداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 120.06,
   "end": 125.86,
   "text": "عزیزمونم حالا چون صدا ضبط میشه میره تو کانال من اسم نمی‌برم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 125.86,
   "end": 132.16,
   "text": "مریض هستن، مریض احوالن برای شفای ایشون تا من صحبتمو ادامه میدم یه حمد شفا قرائت کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 132.16,
   "end": 134.12,
   "text": "اللهم صل علی محمد و آل محمد و عجل فرجهم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 134.12,
   "end": 140.66,
   "text": "اللهم صل علی محمد و آل محمد و عجل فرجهم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 140.66,
   "end": 144.78,
   "text": "یا شافی یا غافی. موضوع ما قلب منیب بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 144.78,
   "end": 148.7,
   "text": "نکته بسیار مهمی رو دیروز در اون حدیث اشاره کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 148.7,
   "end": 154.7,
   "text": "قلب منیب رو توضیح دادیم یعنی قلبی که دائم در حال رجوع به خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 154.7,
   "end": 157.58,
   "text": "آن به آن در حال رجوع به خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 157.58,
   "end": 162.72,
   "text": "عرض کردیم برای اینکه وضعیت قلبمون رو بسنجیم راهش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 162.72,
   "end": 166.7,
   "text": "چشم است. امیرالمؤمنین فرمود العین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 166.7,
   "end": 173.12,
   "text": "جاسوس القلب و برید العقل پیام‌رسان و جاسوس قلب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 173.12,
   "end": 180.14,
   "text": "چشم است. ببینید چشم از چه چیزهایی، چه چیزهایی لذت می‌بره اون ماموریتیه که قلب بهش داده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 180.14,
   "end": 183.92,
   "text": "لذا می‌تونی وضعیت قلبت رو بسنجی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 183.92,
   "end": 189.74,
   "text": "یه حدیث بسیار زیبا که ماموریت، اصلاً حکمت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 189.74,
   "end": 196.3,
   "text": "حکمت و فلسفه اینکه ما پلک داریم و لب داریم رو پیغمبر توی این حدیث فرمودند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 196.3,
   "end": 198.66,
   "text": "در تفسیر نور الثقلین،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 198.66,
   "end": 204.02,
   "text": "جلد پنج، صفحه پونصد و هشتاد و یک پیغمبر از قول خدای متعال فرمودند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 204.02,
   "end": 207.34,
   "text": "که این حدیث قدسی‌ست پیغمبر می‌فرماید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 207.34,
   "end": 213.4,
   "text": "که حالا من عربیشو نخونم. خدا فرمود يا ابن آدم می‌دونی چرا دو تا پلک بهت دادم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 213.4,
   "end": 217.42,
   "text": "برای اینکه هروقت چشم تو رو تحریک کرد که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 217.42,
   "end": 220.34,
   "text": "به مناظر گناه نگاه کنی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 220.34,
   "end": 223.2,
   "text": "تو به وسیله این چشم‌ها،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 223.2,
   "end": 227.7,
   "text": "به وسیله این پلک‌ها چشم‌ها رو از حرام حفظ کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 227.7,
   "end": 229.64,
   "text": "و می‌دونی چرا دو لب بهت دادم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 229.64,
   "end": 233.04,
   "text": "برای اینکه هر وقت وسوسه کرد تو رو زبان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 233.04,
   "end": 238.16,
   "text": "که بخواد به جایی به زبان بیفته که رضایت من درش نیست تو لباتو ببندی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 238.16,
   "end": 241.58,
   "text": "اینا قفل دهانن. اونا قفل چشمن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 241.58,
   "end": 245.3,
   "text": "اصلاً فلسفه اینکه ما پلک داریم اینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 245.3,
   "end": 248.88,
   "text": "این حالا یه فلسفشه ها هزاران فلسفه داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 248.88,
   "end": 255.26,
   "text": "خیلی جالبه. اصلاً اینکه ما پلک داریم برای اینکه از نگاه به حرام، نگاه به چیزی که خدا دوست نداره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 255.26,
   "end": 259.66,
   "text": "نگه داریم خودمون رو. عرض کردیم بعضیا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 259.66,
   "end": 262.36,
   "text": "از نگاه‌های شهوانی لذت-- اصلاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 262.36,
   "end": 264.22,
   "text": "در بند نگاه‌های شهوانی‌ان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 264.22,
   "end": 267.68,
   "text": "نمی‌تونن وقتی یه نماهنگ هم رد میشه همینطوری چشم باهاش می‌دوه میره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 267.68,
   "end": 271.5,
   "text": "نمی‌تونه کاری بکنه. یکی در بند مثلا ماشین‌های لوکسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 271.5,
   "end": 273.32,
   "text": "ماشین میاد میره آخ ماشین!",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 273.32,
   "end": 278.54,
   "text": "همینطوری چشم میره باهاش. یکی در بند خونه و تو خیابون که میری اون میره تو جوب میفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 278.54,
   "end": 282.04,
   "text": "انقدر محو این خونه‌ها و این قصرها و اینا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 282.04,
   "end": 285.16,
   "text": "یکی در بند قیافه و تیپ و مد روزه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 285.16,
   "end": 288.0,
   "text": "هرکی در بند یه چیزی کرده خودشو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 288.0,
   "end": 292.2,
   "text": "بعضیا از مناظر خشونت‌آمیز لذت می‌برن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 292.2,
   "end": 300.52,
   "text": "مثلا مظهر سیادتون رو من عرض کردم که ملا محسن فیض کاشانی در کتاب مهجت‌البیضاش فرموده بود که مظهر شهوت خوک است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 300.52,
   "end": 304.56,
   "text": "مظهرِ قوه غضبیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 304.56,
   "end": 310.7,
   "text": "سگ است. کسی که از مظاهر خشونت‌آمیز مثلا می‌بینه داعش داره سر می‌بره این حال می‌کنه، متأثر نمیشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 310.7,
   "end": 312.8,
   "text": "این خطرناکه. قلبش در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 312.8,
   "end": 314.94,
   "text": "معرض خطر بزرگی قرار گرفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 314.94,
   "end": 319.42,
   "text": "قسی القلب شده. چنین کسی بمیره حقیقت وجودیش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 319.42,
   "end": 321.36,
   "text": "سگه. یعنی مثل سگ محشور میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 321.36,
   "end": 325.78,
   "text": "من گفتم اون روحه و قلبه که می‌مونه جسمو که می‌اندازن بیرون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 325.78,
   "end": 331.8,
   "text": "و کسی که خدای نکرده با حالت شهوانی بمیره همینطور شبیه خوک محشور میشه یا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 331.8,
   "end": 334.62,
   "text": "خوک صفت محشور. اینا خیلی خطرناکن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 334.62,
   "end": 340.16,
   "text": "حالا نگاه انسان به هر چیز، بعضیا هستن که عالم می‌بینن لذت می‌برن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 340.16,
   "end": 341.9,
   "text": "مسجد می‌بینن کیف می‌کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 341.9,
   "end": 344.26,
   "text": "پرچم سید و شهدا می‌بینن حال می‌کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 344.26,
   "end": 347.4,
   "text": "مؤمن می‌بینن عبادت می‌کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 347.4,
   "end": 351.42,
   "text": "نگاه می‌کنه به چهره پدر، مادر لذت می‌بره چون می‌دونه این عبادته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 351.42,
   "end": 358.82,
   "text": "اینا جلوه‌های خدااند دیگه. بعضیا به قدری عمیق‌تر میشن که همه چی رو مظهر اسماء الهی می‌بینن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 358.82,
   "end": 363.22,
   "text": "حتی مصائبی که براشون وارد میشه رو از ناحیه خدا می‌بینن و شکر میگن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 363.22,
   "end": 367.66,
   "text": "مگه موسی بن جعفر در زندان همش شکر نمی‌کرد که خدایا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 367.66,
   "end": 371.12,
   "text": "ممنونتم یه جایی رو برا ما قرار دادی با تو خلوت کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 371.12,
   "end": 374.5,
   "text": "هر زندانی می‌بردنش از خدا تشکر می‌کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 374.5,
   "end": 380.03,
   "text": "این یعنی همه چی رو لطف و محبت خدا می‌بینه حتی شدیاد-- شدائد و سختی‌ها رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 380.03,
   "end": 384.49,
   "text": "انسان-- می‌خوام یه نقطه‌ای رو بزنم البته فردا می‌خواستم عرض کنم چون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 384.49,
   "end": 390.17,
   "text": "عزیزان خیلی‌شون فردا راهی مشهد انشاالله معبذیه هستن امروز میگم که یادگاری ذهنشون بمونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 390.17,
   "end": 393.23,
   "text": "یه نقطه‌ای رو می‌خوام بزنم مثل این موشک‌های نقطه زن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 393.23,
   "end": 396.17,
   "text": "همه اینا رو مقدمه قرار دادم برای اون نقطه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 396.17,
   "end": 402.53,
   "text": "اونم اینه که شما ببینید اگر ج-- اگر چشم پیغام‌رسان قلب است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 402.53,
   "end": 406.19,
   "text": "و مأموریت چشم رو قلب تعیین می‌کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 406.19,
   "end": 410.83,
   "text": "و هرچه چشم به دنبال او گردش می‌کنه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 410.83,
   "end": 413.11,
   "text": "حقیقت قلب همونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 413.11,
   "end": 418.47,
   "text": "شما به من بگید م-- حقیقت و پشت پرده و ملکوت این سخن چیست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 418.47,
   "end": 421.77,
   "text": "\"وما رأیت إلا جمیلا\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 421.77,
   "end": 423.93,
   "text": "و من جز زیبایی ندیدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 423.93,
   "end": 429.33,
   "text": "دختر امیرالمؤمنین بعد از اون همه مصائب و سختی‌ها در این شب میلاد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 429.33,
   "end": 431.67,
   "text": "حالا با نگاه روضه اینو نبینیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 431.67,
   "end": 434.99,
   "text": "یه چند لحظه‌ای که اشک بخواد بریزیم باهاش همین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 434.99,
   "end": 436.65,
   "text": "\"وما رأیت إلا جمیلا\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 436.65,
   "end": 438.83,
   "text": "اینجا که می‌فرماید \"العین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 438.83,
   "end": 442.05,
   "text": "برید العقل\" چشم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 442.05,
   "end": 443.65,
   "text": "پیغام‌رسان عقل است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 443.65,
   "end": 446.41,
   "text": "یعنی هر چقدر که عقل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 446.41,
   "end": 450.79,
   "text": "فروزان‌تر و بزرگ‌تر و با عظمت‌تر باشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 450.79,
   "end": 454.75,
   "text": "چشم پیغام‌هایی رو متناسب با اون برمی‌داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 454.75,
   "end": 459.35,
   "text": "اینکه بهش میگن عقیلت العرب یا عقیله بنی هاشم یعنی چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 459.35,
   "end": 464.41,
   "text": "شما به من بگید. یعنی به قدری این عقل وسعت پیدا کرده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 464.41,
   "end": 469.03,
   "text": "همین جمله داره میگه دیگه چشم داره میگه هرچی می‌بینم زیبایی‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 469.03,
   "end": 471.33,
   "text": "هرچی می‌بینم زیباست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 471.33,
   "end": 473.11,
   "text": "نشان از چیه؟ عقلش داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 473.11,
   "end": 475.59,
   "text": "بیخود بهش نمیگن عقیلت العرب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 475.59,
   "end": 478.05,
   "text": "چون برید العقل چشم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 478.05,
   "end": 484.31,
   "text": "پیغام‌رسان عقله. چشم داره میگه همه چی رو زیبا می‌بینم، جلوه خدا می‌بینم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 484.31,
   "end": 488.47,
   "text": "خب چنین چشمی که پیغام‌رسان عقله ببین عقل چیه پس؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 488.47,
   "end": 493.79,
   "text": "قطعاً عقیلت العربه. حالا از وادی اخلاقیات ما یه لحظه زدیم تو این وادی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 493.79,
   "end": 498.53,
   "text": "یه نقطه‌ای رو زدیم و بالاتر از این خواهش می‌کنم اینو به دید روضه یه لحظه نبینید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 498.53,
   "end": 504.45,
   "text": "یه بحث استدلالیه. ببینید عمق معرفت رو، عمق توحید رو، عمق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 504.45,
   "end": 506.27,
   "text": "جایگاه قلب بی بی هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 506.27,
   "end": 509.29,
   "text": "بیخود نیست سلامٌ على قلب زینب الصبور.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 509.29,
   "end": 512.13,
   "text": "در این شب میلاد سلام کنیم به قلب این بی بی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 512.13,
   "end": 515.15,
   "text": "چرا؟ و همیشه برای من سؤال بود چرا قلب زینب؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 515.15,
   "end": 519.09,
   "text": "چرا قلب زینب؟ عل-- به زبان حضرت زینب سلام نمیدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 519.09,
   "end": 523.11,
   "text": "زبانی که خطبه‌های، خطبه‌های خان گفتن علی زنده شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 523.11,
   "end": 525.63,
   "text": "چرا به قلب؟ الان متوجه میشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 525.63,
   "end": 528.43,
   "text": "چون حقیقت وجودی بی بی قلبشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 528.43,
   "end": 530.79,
   "text": "حالا این قلب چه جایگاهی پیدا کرده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 530.79,
   "end": 533.91,
   "text": "چه نگاه توحیدی داره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 533.91,
   "end": 539.37,
   "text": "که وقتی میره بدن سید الشهدا رو دست می‌بره زیرش یه هوا از زمین بلند می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 539.37,
   "end": 542.57,
   "text": "حالا تو این هم فلسفه هست، حرف‌ها هست که چرا یه هوا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 542.57,
   "end": 546.59,
   "text": "بدن رو بلند می‌کنه. نگاه با-- اصلاً این جمله رو تو خودت دقت کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 546.59,
   "end": 550.51,
   "text": "اگه لغت‌شناس باشید به عمق این جمله پی می‌برید تا حدودی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 550.51,
   "end": 552.53,
   "text": "اللهم تقبل منا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 552.53,
   "end": 555.77,
   "text": "تقبل عرب به جایی استفاده می‌کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 555.77,
   "end": 562.11,
   "text": "که می‌خواد یه پیشکشی ببره، هدیه‌ای به کسی بده که می‌دونه این هدیه در شأن و در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 562.11,
   "end": 564.51,
   "text": "شأن و در خور اون شخص نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 564.51,
   "end": 567.59,
   "text": "یعنی در حقیقت میگه این کمه، خیلی ناچیزه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 567.59,
   "end": 571.17,
   "text": "شما ب-- منت بذار از ما این هدیه رو قبول کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 571.17,
   "end": 574.03,
   "text": "اونجا لفظ تقبل استفاده می‌کنه عرب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 574.03,
   "end": 577.23,
   "text": "تا-- اینم مؤید بعد-- جمله بعدش مؤید همینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 577.23,
   "end": 580.03,
   "text": "اللهم تقبل منا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 580.03,
   "end": 584.03,
   "text": "یعنی خدایا منت بذار از ما بپذیر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 584.03,
   "end": 588.25,
   "text": "چی رو؟ هذا القلیل من القربان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 588.25,
   "end": 590.65,
   "text": "این قربانی کمو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 590.65,
   "end": 598.11,
   "text": "الله اکبر. ببین حضرت زینب به کجا رسیده که ابا عبدالله الحسین رو که همه عالم فداش میشن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 598.11,
   "end": 601.45,
   "text": "کائنات به یمن وجودش برقرار است،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 601.45,
   "end": 605.93,
   "text": "از زمین بلند می‌کنه میگه خدایا این کمه در برابر تو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 605.93,
   "end": 608.97,
   "text": "اما تو منت بذار بر ما و قبولش کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 608.97,
   "end": 611.71,
   "text": "جایگاه قلب رو ببین به کجا رسیده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 611.71,
   "end": 614.53,
   "text": "چنین کسی باید هم عقیلت العرب باشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 614.53,
   "end": 619.67,
   "text": "باید هم عقیله بنی هاشم باشه، باید هم به مقام اسمت رسیده باشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 619.67,
   "end": 622.87,
   "text": "باید هم زینت باباش علی بوده باشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 622.87,
   "end": 624.95,
   "text": "و الا نمیشه. باید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 624.95,
   "end": 629.21,
   "text": "\"وما رأیت إلا جمیلا\" از لسان همچین زنی بلند بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 629.21,
   "end": 638.23,
   "text": "چون اون نگاهش پیغام‌رسان و جاسوس قلبشه و داره وضعیت قلبش رو بیان می‌کنه که این قلب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 638.23,
   "end": 641.95,
   "text": "به کجا رسیده و واقعاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 641.95,
   "end": 647.17,
   "text": "بسط البته که سلامٌ على قلب زینب الصبور.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 647.17,
   "end": 650.97,
   "text": "برای بی بی دو عالم حضرت زینب کبری صلوات فرست کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 650.97,
   "end": 654.65,
   "text": "اللهُمَّ صَلِ عَلَى",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 654.65,
   "end": 659.05,
   "text": "مُحَمَّد وَ آلِ مُحَمَّد و آخر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}