 },
 "chapters": [
  {
   "index": 0,
   "title": "## ششمین شکِ بی‌اعتنا؛ شک پس از وقت",
   "start": 11.98,
   "end": 35.72
  },
  {
   "index": 1,
   "title": "## آیهٔ هفدهمِ زمر و بشارتِ اهلِ إنابه",
   "start": 35.72,
   "end": 128.66
  },
  {
   "index": 2,
   "title": "## بشارت و انذار؛ سنتِ الهی",
   "start": 128.66,
   "end": 214.68
  },
  {
   "index": 3,
   "title": "آیا کسانی هستند که هم بشارتِ دنیا داشته باشند هم آخرت؟ آری. در آیهٔ شصت‌ودو و شصت‌وچهارِ یونس:",
   "start": 214.68,
   "end": 577.94
  },
  {
   "index": 4,
   "title": "## بشارت‌هایِ اخروی؛ شوری و توبه و حدید",
   "start": 577.94,
   "end": 683.12
  },
  {
   "index": 5,
   "title": "آیهٔ سی‌اُمِ فصلت محبوب است:",
   "start": 683.12,
   "end": 712.88
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 1.26,
   "end": 4.5,
   "text": "بسم الله الرحمن الرحیم و به این استعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 4.5,
   "end": 8.34,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 8.34,
   "end": 11.98,
   "text": "آیات. سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 11.98,
   "end": 16.1,
   "text": "آخرین شکی که نباید بهش اعتنا کرد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 16.1,
   "end": 19.52,
   "text": "شک بعد از وقت نمازه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 19.52,
   "end": 27.06,
   "text": "یعنی وقت نماز عصر تموم شده، اذان مغرب و عشا رو داده شما شک کنی نماز عصر رو درست خوندی یا نه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 27.06,
   "end": 32.44,
   "text": "اینو نباید اعتنا کنی. پس مجموعاً شش تا شک بود که تموم شد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 32.44,
   "end": 39.62,
   "text": "که به اون‌ها نباید اعتنا کرد. یکیش در نماز مستحبی بود، یکی در رکعت‌های نماز جماعت بود، یکی کثیر الشک بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 39.62,
   "end": 46.08,
   "text": "سه تاش هم این بود که شک بعد از محل یعنی جزئی از نماز تموم شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 46.08,
   "end": 50.48,
   "text": "بعد یکی شک بعد از خود نماز بود، یکی هم امروز شک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 50.48,
   "end": 52.5,
   "text": "بعد از وقت نماز.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 52.5,
   "end": 55.08,
   "text": "این شش تا. اما در خصوص",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 55.08,
   "end": 58.88,
   "text": "قلب منیب خب ما بخوایم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 58.88,
   "end": 61.14,
   "text": "بعضی نکاتو نگیم، دلمون نمیاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 61.14,
   "end": 63.48,
   "text": "بعضی از نکاتو بخوایم بگیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 63.48,
   "end": 70.1,
   "text": "به قدر این‌ها درش ذرائفی نهفته که به هر حال نمی‌دونم خدا انشاالله برکت بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 70.1,
   "end": 72.78,
   "text": "مثلاً یکی از آیاتی که پیرامون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 72.78,
   "end": 77.24,
   "text": "انابه در قرآن اومده آیه هفده سوره زمر رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 77.24,
   "end": 79.94,
   "text": "می‌فرماید اناب الی الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 79.94,
   "end": 83.14,
   "text": "کسایی که انابه به سمت خدا کردند،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 83.14,
   "end": 84.96,
   "text": "خدا یه کاری باهاشون می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 84.96,
   "end": 87.52,
   "text": "چی؟ لهم البشرى",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 87.52,
   "end": 89.94,
   "text": "برای این‌ها از ناحیه خدا بشارته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 89.94,
   "end": 92.8,
   "text": "خب به همین راحتی ما از کنارش می‌گذریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 92.8,
   "end": 95.82,
   "text": "اما یک خصوصیت بسیار مهمه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 95.82,
   "end": 98.26,
   "text": "برای اهل انابه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 98.26,
   "end": 100.76,
   "text": "بشارت خدا شوخی نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 100.76,
   "end": 104.86,
   "text": "همینطوری من تو همین فکر بودم یه بررسی اجمالی کردم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 104.86,
   "end": 107.66,
   "text": "اصلاً تو قرآن خدا به چه کسایی بشارت داده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 107.66,
   "end": 110.04,
   "text": "برای چه چیزایی بشارت داده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 110.04,
   "end": 111.78,
   "text": "بعد یه چیزای عجیبی دستگیرم شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 111.78,
   "end": 116.1,
   "text": "حالا تبرکاً چند مثالشو برای شما عرض می‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 116.1,
   "end": 120.16,
   "text": "اولاً بشارت و انذار سنت الهیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 120.16,
   "end": 123.9,
   "text": "حالا خود بشارت می‌دونید مصدر ثلاثی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 123.9,
   "end": 126.58,
   "text": "مجرده بر وزن فعاله،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 126.58,
   "end": 131.0,
   "text": "ریشه‌ش هم یا بشره که به معنای مژده و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 131.0,
   "end": 136.06,
   "text": "خبر مصر-- سرور آفرین هست یا از بشره‌ست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 136.06,
   "end": 140.16,
   "text": "که به ظاهر بر می‌گرده مثل پوست و وجه و صورت و بشره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 140.16,
   "end": 144.74,
   "text": "که منظور خبریه که در ظاهر طرف تأثیر می‌گذاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 144.74,
   "end": 147.28,
   "text": "ض-- خوشحالیشو تو چهره می‌بینی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 147.28,
   "end": 149.7,
   "text": "در هر حال این سنت الهی‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 149.7,
   "end": 154.8,
   "text": "مثلاً در آیه پنجاه و شش کهف و بیست و چهار فاطر من سریع میگم رد میشم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 154.8,
   "end": 160.02,
   "text": "هرکی حالشو داشت وقت داشت بعداً بره این آدرس‌ها رو نگاه کنه کیف کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 160.02,
   "end": 164.02,
   "text": "خدا می‌فرمود و ما نرسل المرسلين الا مبشرين و منذرین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 164.02,
   "end": 168.02,
   "text": "ما اصلاً پیغمبرها رو نمی‌فرستیم مگر برای اینکه بشارت بدن و انذار بدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 168.02,
   "end": 171.56,
   "text": "پس این یک سنت الهی‌ست یعنی یک کار الهیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 171.56,
   "end": 175.84,
   "text": "خدا این کارو می‌کنه. بشارتو باید جدی گرفت همونطور که انذار رو باید جدی گرفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 175.84,
   "end": 178.98,
   "text": "همینطوری نباید از کنارش رد شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 178.98,
   "end": 184.8,
   "text": "همچنین حالا این بشارت‌ها بخشیش شامل دنیاست، بخشیش سا شامل اخ-- آخرت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 184.8,
   "end": 190.48,
   "text": "آیا دسته‌ای هستند که خدا هم بشارت دنیا بهشون داده باشه هم آخرت؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 190.48,
   "end": 192.76,
   "text": "بله. به عنوان نمونه آیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 192.76,
   "end": 195.5,
   "text": "شصت و دو و شصت و چهار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 195.5,
   "end": 199.34,
   "text": "سوره یونس. الا ان اولیاء الله همینطور",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 199.34,
   "end": 203.84,
   "text": "آیه هست تا الذین آمنوا و کانوا یتقون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 203.84,
   "end": 205.46,
   "text": "کیا رو داره خدا معرفی می‌کنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 205.46,
   "end": 209.3,
   "text": "ان اولیاء الله دوستاش، اولیاء خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 209.3,
   "end": 214.68,
   "text": "اینا چی میشن؟ لهم البشرى فی الحیاة الدنيا و فی الآخرة.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 214.68,
   "end": 219.48,
   "text": "فقط اولیاء خدااند که هم دنیا خدا بهشون بشارت داده هم آخرت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 219.48,
   "end": 225.36,
   "text": "این یه نکته‌ست خودش. اگه کسی می‌خواد هم دنیاش سر و سامون داشته باشه هم آخرتش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 225.36,
   "end": 229.3,
   "text": "لاجرم باید ولی خدا باشه، دوست خدا باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 229.3,
   "end": 232.8,
   "text": "اونم خودش بسیار نکات درش هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 232.8,
   "end": 240.9,
   "text": "حالا بشارت‌هایی که در دنیا مربوط به دنیا در ق-قرآن وارد شده چند تاشو من عرض می‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 240.9,
   "end": 241.92,
   "text": "به عنوان نمونه خود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 241.92,
   "end": 247.3,
   "text": "فرشته‌ها، نزول فرشته‌ها بر بنده و الان این بارون‌هایی که داره میاد سر ما الحمد لله رحمت خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 247.3,
   "end": 251.42,
   "text": "خدا هر دونه، دونه این بارون‌ها رو فرشته میاره و می‌بره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 251.42,
   "end": 254.1,
   "text": "نزول فرشته‌ها کجا اومده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 254.1,
   "end": 258.36,
   "text": "مثلاً در آیه بیس-صد و بیست و شش آل عمران",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 258.36,
   "end": 267.88,
   "text": "و ده انفال که در ارتباط با مجاهدین بعد وقتی اینا مضطرب شدن که تعداد دشمن سه برابرشونه مضطرب شدن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 267.88,
   "end": 270.22,
   "text": "خدا فرمود و ما جعله الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 270.22,
   "end": 277.88,
   "text": "ما این نزول ملائکه رو که اومدن کمکشون کنن قرار ندادیم الا بشری لکم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 277.88,
   "end": 281.0,
   "text": "لتطمئن قلوبکم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 281.0,
   "end": 284.66,
   "text": "یعنی بشارت ملائکه. یعنی که ملائکه اومدن خودش یه بشارتی بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 284.66,
   "end": 290.26,
   "text": "پس ببینید جنس بشارت دنیایی خدا هم ویژه‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 290.26,
   "end": 293.2,
   "text": "ورود و خروج ملائکه بشارته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 293.2,
   "end": 295.44,
   "text": "یعنی جنس بشارت چیز کمی نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 295.44,
   "end": 297.8,
   "text": "فکر نکنید بشارت خدا چیز کمیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 297.8,
   "end": 303.48,
   "text": "اگه به منیب این گفته لهم البشرى خیلی خدا تحویل گرفته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 303.48,
   "end": 305.88,
   "text": "و مقام منیب خیلی بالاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 305.88,
   "end": 313.12,
   "text": "یا در آیه شش سوره صف می‌فرمود مبشرا برسول یأتی من بعد اسمه احمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 313.12,
   "end": 315.08,
   "text": "صلی الله عليه و آله و سلم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 315.08,
   "end": 318.02,
   "text": "اللهم صل على",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 318.02,
   "end": 323.96,
   "text": "محمد و آل- اینجا بشارت داده به آمدن پیغمبر اخص می مرتبت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 323.96,
   "end": 329.14,
   "text": "یعنی تشریف آوردن خود پیغمبر به این دنیا خودش بشارت داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 329.14,
   "end": 338.74,
   "text": "در آیه چهل و پنج سوره آل عمران می‌فرماید ان الله يبشر که بكلمة منه الصمر المسيح عیسی ابن مریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 338.74,
   "end": 341.0,
   "text": "یعنی به حضرت مریم بشارت عیسی رو میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 341.0,
   "end": 347.06,
   "text": "همونطور که به حضرت ابراهیم بشارت اسحاق رو میده، به حضرت زکریا بشارت یحیی رو میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 347.06,
   "end": 350.16,
   "text": "دادن فرزند صالح",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 350.16,
   "end": 353.08,
   "text": "خودش بشارته. بشارت خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 353.08,
   "end": 355.68,
   "text": "ما این بشارت‌ها رو باید تو زندگیمون ببینیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 355.68,
   "end": 357.6,
   "text": "و قدرشناس باشیم. در...",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 357.6,
   "end": 365.92,
   "text": "این‌ها تازه دنیاییاشه. آیه بیست و پنج فرقان، هفت-- پنجاه و هفت اعراف، شصت و سه نمل، چهل و شش روم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 365.92,
   "end": 368.42,
   "text": "حالا من اینا رو تبرکاً یکیشو بخونم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 368.42,
   "end": 374.88,
   "text": "\"هو الذي أرسل الرياح بشراً بين يدي رحمته وأنزلنا من السماء ماء طهورا\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 374.88,
   "end": 380.64,
   "text": "الان داره اتفاق میفته. این بارانی که از آسمان میاد، باران پاک، آب پاک؛",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 380.64,
   "end": 383.94,
   "text": "می فرماید این چیه؟ \"هو الذي أرسل الرياح بشرا\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 383.94,
   "end": 386.1,
   "text": "این بشاره، بشارت خودش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 386.1,
   "end": 389.3,
   "text": "لذا لحظه استجابت دعاست وقتی بارون میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 389.3,
   "end": 395.48,
   "text": "حالا این بس على هذا یه بخشیش بود من تبرکاً عرض کردم اما بشارت‌هایی که در آخرت هست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 395.48,
   "end": 398.64,
   "text": "شوره س-- ااا عرض کنم، شورا بیست و دو، بیست و سه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 398.64,
   "end": 401.96,
   "text": "سوره شورا بیست و دو، بیست و سه رو ببینید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 401.96,
   "end": 408.5,
   "text": "\"والذین آمنوا وعملوا الصالحات\" حالا این مشخصات و دقت کنید ها من دیگه فرصت ندارم اینا رو بررسی کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 408.5,
   "end": 410.84,
   "text": "چه کسانی؟ \"آمنوا وعملوا الصالحات\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 410.84,
   "end": 415.9,
   "text": "اینا \"في روضات الجنات لهم ما یشاءون عند ربهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 415.9,
   "end": 418.52,
   "text": "ذلك هو الفضل الكبير\" که غوغاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 418.52,
   "end": 422.56,
   "text": "علامه طباطبایی تویش سوره تو این آیه ذیلش غوغا کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 422.56,
   "end": 428.72,
   "text": "این \"لهم ما یشاءون عند ربهم\" یعنی هرچی که اینا بخوان پیش خدا \"عند ربهم\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 428.72,
   "end": 431.08,
   "text": "الله اکبر. یعنی دیگه بالاترین مقام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 431.08,
   "end": 437.26,
   "text": "هرچی بخوای اراده کنی همونجا پیش خدا برات محقق میشه و این فوز بل-- بزرگی‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 437.26,
   "end": 440.16,
   "text": "بعد خدا از کلمه بشارت بعدش استفاده میکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 440.16,
   "end": 443.48,
   "text": "\"ذلك\" این با این، این عظمت رو دیدی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 443.48,
   "end": 447.08,
   "text": "\"ذلك الذي يبشر الله\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 447.08,
   "end": 449.58,
   "text": "خدا این چیزیه که خدا بشارت قرار داده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 449.58,
   "end": 452.88,
   "text": "برای کی؟ \"عباده\". برای بندگانش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 452.88,
   "end": 455.42,
   "text": "ما فکر میکنیم بنده خدا چیز کمیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 455.42,
   "end": 457.6,
   "text": "داستان بشر حافي رو شنیدید دیگه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 457.6,
   "end": 460.94,
   "text": "بشر حافي، حافي یعنی پا برهنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 460.94,
   "end": 467.32,
   "text": "جریانش مفصله که میدونید وقتی زمان امام حسن مجتبی این یه آدمی بود که مثلا اهل بزن برقص بود و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 467.32,
   "end": 472.6,
   "text": "ااا تو خونه‌ش مطرب دعوت میکرد و حضرت امام حسن مجتبی از کنارش رد میشد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 472.6,
   "end": 474.82,
   "text": "دید صدای بزن برقص از تو خونه میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 474.82,
   "end": 478.24,
   "text": "غلام بش اومده بود آشغال بذاره سر کوچه بره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 478.24,
   "end": 482.38,
   "text": "حضرت امام حسن مجتبی پرسید که اینجا صاحب خونه کیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 482.38,
   "end": 487.7,
   "text": "بنده‌ست یا آزاده؟ یعنی غلامه یا اربابه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 487.7,
   "end": 491.58,
   "text": "غلام بش عرض کرد که--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 491.58,
   "end": 493.8,
   "text": "نمیشناخت 아직 حضرت امام حسن مجتبی رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 493.8,
   "end": 496.4,
   "text": "عرض کرد نه، این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 496.4,
   "end": 498.98,
   "text": "اربابه یعنی آزاده، غلام نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 498.98,
   "end": 503.2,
   "text": "حضرت یه آه کشید فرمود همون، آزاده که اینطور وضعشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 503.2,
   "end": 507.02,
   "text": "اگه عبد بود، اگه بنده بود اینطور نبود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 507.02,
   "end": 510.64,
   "text": "قید و بند داشت. خیلی کلام بالاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 510.64,
   "end": 513.28,
   "text": "ما تو تش-تشهد میگیم ر--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 513.28,
   "end": 517.14,
   "text": "یعنی مقدمه رسالت پیغمبر عبودیت رو قرار میدیم دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 517.14,
   "end": 520.74,
   "text": "میگیم بنده بود که رسول شد، نبی شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 520.74,
   "end": 522.86,
   "text": "آقا رفت داخل گفت چرا دیر اومدی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 522.86,
   "end": 527.86,
   "text": "بش گفت چرا دیر اومدی به غلامش؟ گفت آقا یه آقایی خیلی نورانی اینطوری، اینطوری به من گفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 527.86,
   "end": 530.62,
   "text": "آقا برق کلام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 530.62,
   "end": 532.8,
   "text": "حضرت امام حسن مجتبی گرفتش بش رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 532.8,
   "end": 535.6,
   "text": "تو خونه بود. امام حسن مجتبی گفته بود رفته بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 535.6,
   "end": 540.1,
   "text": "دوید، دوید دیوانه وار دن-- هی اینور اونور نگاه میکرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 540.1,
   "end": 543.16,
   "text": "پای برهنه لذا بهش گفتن حافي یعنی پا برهنه یعنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 543.16,
   "end": 547.86,
   "text": "دنبال امام حسن مجتبی راه افتاد. پیدا کرد حضرت رو زد تو سرش گفت آقا غلط کردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 547.86,
   "end": 553.42,
   "text": "این یک نک-- یک حرف با واسطه امام چه گونه به همش ریخت و عبدش کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 553.42,
   "end": 555.78,
   "text": "این بشارت برای بندگان خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 555.78,
   "end": 558.48,
   "text": "بندگی خدا چیز کمی نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 558.48,
   "end": 561.16,
   "text": "نتیجه‌ش \"عند ربهم\" है.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 561.16,
   "end": 564.04,
   "text": "اینا رو ما نباید کم بگیریم. حالا من نمیخوام خیلی هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 564.04,
   "end": 565.98,
   "text": "توضیح هم مبسوط بشه سریع بگذریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 565.98,
   "end": 568.68,
   "text": "توبه، سوره توبه آیه بیست و یک رو ببینید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 568.68,
   "end": 571.58,
   "text": "\"يبشرهم ربهم برحمة منه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 571.58,
   "end": 574.88,
   "text": "ورضوان وجنات لهم فيها نعيم مقيم\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 574.88,
   "end": 581.58,
   "text": "الله اکبر. سه تا نعمت بزرگ که خدا در بهشت رو اینجا بشارت داده خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 581.58,
   "end": 589.56,
   "text": "یکی رحمتش رو، یکی رضوان رو، مقام رضوان از بالاترین مقامات بهشتی‌ست، یکی هم خود جنات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 589.56,
   "end": 592.1,
   "text": "سوره حدید آیه دوازده. \"بشرىكم 园",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 592.1,
   "end": 595.5,
   "text": "جنات تجري من تحتها الأنهار خالدين فيها\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 595.5,
   "end": 600.44,
   "text": "بشارت باد به چی؟ بهشت‌هایی که از زیر ره-- درختانش نهرها جاریست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 600.44,
   "end": 607.18,
   "text": "یه روزی براتون ثابت می‌کنم که این نهر‌های زیر بهشت از کوثر زهرا جوشیده میشه با آیات و روایات انشاالله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 607.18,
   "end": 609.9,
   "text": "غوغاست آقا. این بشارت چیز کمی نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 609.9,
   "end": 612.4,
   "text": "خدا هر جایی بشارت نداده خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 612.4,
   "end": 616.22,
   "text": "اینکه به منیب بشارت داده یعنی جایگاه خیلی بالاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 616.22,
   "end": 620.0,
   "text": "فرقان آیه بیست و دو. \"يوم يرون الملائكة لا بشرى\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 620.0,
   "end": 626.18,
   "text": "این خیلی البته نهیب داره. میگه ا-- برای یه دسته خدا بشارت نداده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 626.18,
   "end": 629.3,
   "text": "برای کیاس؟ بخونیم آیه رو متوجه میشید دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 629.3,
   "end": 634.08,
   "text": "\"يوم يرون الملائكة لا بشرى يومئذ للمجرمين\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 634.08,
   "end": 637.8,
   "text": "استغفرالله. خدا برای یه عده اصلاً بشارتی نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 637.8,
   "end": 639.76,
   "text": "نه تو دنیا، نه آخرت. کیا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 639.76,
   "end": 642.28,
   "text": "\"للمجرمين\" برای گناهکارا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 642.28,
   "end": 646.68,
   "text": "پس حواسمون جمع باشه. گناهکار، مجرم نمیتونه به عنابه برسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 646.68,
   "end": 649.12,
   "text": "نمیتونه به مقام عنابه مگر اینکه بکشه بیرون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 649.12,
   "end": 652.82,
   "text": "گفتیم یکی از معنای عنابه اولین پله‌ش کشیدن از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 652.82,
   "end": 657.52,
   "text": "گناه بیرونه. یعنی بیاد از معصیت ترک معصیت کنه تا منیب باشه و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 657.52,
   "end": 659.48,
   "text": "بس على هذا حالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 659.48,
   "end": 663.68,
   "text": "آخریشم آیه سی فصلت قرار بدیم که خیلی این آیه رو من دوست دارم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 663.68,
   "end": 668.86,
   "text": "\"إن الذين قالوا ربنا الله\" کسانی که خود-- گفتن خدا پروردگار ماست \"ثم استقاموا\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 668.86,
   "end": 672.18,
   "text": "استقامت ورزیدن چی میشه؟ \"تتنزل عليهم الملائكة\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 672.18,
   "end": 678.4,
   "text": "ملائکه به اینا نازل میشن میگن \"الله تخافوا ولا تحزنوا\" نترسید محزون نباشید \"وأبشروا\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 678.4,
   "end": 683.12,
   "text": "به این‌ها بشارت میدن. \"بالجنة التي كنتم توعدون\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 683.12,
   "end": 686.38,
   "text": "ملائکه دسته دسته میان بشارت بش بدن به این‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 686.38,
   "end": 690.92,
   "text": "این‌ها شوخی نیست. بشارت‌های خدا یکیش در عنابه‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 690.92,
   "end": 693.26,
   "text": "خدا به منیب بشارت داده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 693.26,
   "end": 697.38,
   "text": "انشاالله که ما به عنابه بیوفتیم بشارت‌های خدا رو اخذ کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 697.38,
   "end": 700.7,
   "text": "جا نمونیم. حیف به خدا غافله جا بمونیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 700.7,
   "end": 705.44,
   "text": "انشاالله عاقبتمون خیر بشه به ذکر صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 705.44,
   "end": 712.88,
   "text": "اللهم صل على محمد و آل محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}