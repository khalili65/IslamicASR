 },
 "chapters": [
  {
   "index": 0,
   "title": "## پرده میان زنان و مردان در جماعت",
   "start": 30.62,
   "end": 527.3
  },
  {
   "index": 1,
   "title": "شکر در کنار ایمان؛ نه نالیدن از برف و سرما، بلکه الحمد لله علی کل نعمة. سوم:",
   "start": 527.3,
   "end": 625.26
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 1.86,
   "end": 5.76,
   "text": "بسم الله الرحمن الرحیم و بهین استعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 5.76,
   "end": 8.44,
   "text": "السلام علیک یا داعی الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 8.44,
   "end": 10.44,
   "text": "و ربانی آیاته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 10.44,
   "end": 13.88,
   "text": "السلام علیکم و رحمه الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 13.88,
   "end": 16.14,
   "text": "حمد و ثفاست میگیم خدای،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 16.14,
   "end": 22.22,
   "text": "خدای منان رو به جهت این بارش رحمتش که ما این همه گناه میکنیم و خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 22.22,
   "end": 27.2,
   "text": "با رحمتش جواب میده. ان شا الله که حمد کنیم و خدا این نعمت رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 27.2,
   "end": 30.62,
   "text": "افزون کنه و قطع نکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 30.62,
   "end": 42.1,
   "text": "از رهبر عزیزمون استفتاء شده که وقتی خانم‌ها اقتدا می‌کنند به امام جماعت و جمعیتی از مردان جلوی خانوما هست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 42.1,
   "end": 49.04,
   "text": "چه-- اشکالی پیش نمیاد اینجا اگر پرده‌ای بین خانوما و آقایان نباشه، خانوما که پشت سر هستن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 49.04,
   "end": 52.78,
   "text": "الان نگاه کنید اینجا این خواهرهایی که اون پشت اقتدا کردن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 52.78,
   "end": 56.76,
   "text": "پرده‌ای بین شما و اون‌ها نباشه اشکالی داره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 56.76,
   "end": 61.36,
   "text": "یا از کنار، از بغل دست هم گاهی اوقات خانوما وایمیستن دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 61.36,
   "end": 65.22,
   "text": "از حالا یا سمت چپ یا راست جماعت گاهی اوقات خانوما وایمیستن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 65.22,
   "end": 68.58,
   "text": "پرده باشه یا نباشه این حکمش چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 68.58,
   "end": 75.06,
   "text": "رهبر فرمودن نیازی به بودن پرده نیست خصوصا وقتی که خواهرها پشت سر قرار میگیرن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 75.06,
   "end": 78.74,
   "text": "نیازی به بودن پرده نیست لکن وقتی از کنار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 78.74,
   "end": 83.36,
   "text": "یعنی سمت چپ و راست خانم‌ها به جماعت متصل‌اند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 83.36,
   "end": 85.76,
   "text": "کراهت داره که پرده نباشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 85.76,
   "end": 87.92,
   "text": "بهتره که پرده باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 87.92,
   "end": 90.96,
   "text": "بعد در این استفتاء گفت--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 90.96,
   "end": 93.78,
   "text": "در این سوالی که شده بود من دیدم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 93.78,
   "end": 97.78,
   "text": "ااا اون کسی که سؤال کرده گفته که این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 97.78,
   "end": 100.38,
   "text": "آیا بی‌حرمتی به زنان نیست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 100.38,
   "end": 103.82,
   "text": "بی‌حرمتی به شأن خانم‌ها نیست که با پرده جدا بشن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 103.82,
   "end": 111.68,
   "text": "رهبر خیلی محکم فرمودن این توهم شماست و اصلا ربطی به مسائل فقهی نداره اینجور چیزا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 111.68,
   "end": 114.62,
   "text": "شارع مقدس اشکال نکرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 114.62,
   "end": 117.24,
   "text": "این دیگه شما خودتون نشستید برای خودتون دو تا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 117.24,
   "end": 122.14,
   "text": "دو تا چهار تا کردید که این مثلا بی‌حرمتی به خانوماست که با پرده جدا بشن یا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 122.14,
   "end": 124.78,
   "text": "هرچی. به هر حال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 124.78,
   "end": 127.66,
   "text": "این‌ها در م-- در احکام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 127.66,
   "end": 132.52,
   "text": "مصالح و مفاسدی وجود داره که ماها بی‌خبریم، امام معصوم می‌داند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 132.52,
   "end": 138.18,
   "text": "پس فقط وقتی کراهت داره که پرده نباشد که از کنار دست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 138.18,
   "end": 142.12,
   "text": "خواهرها اقتدا کرده که اونم نباشه باز اشکالی نداره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 142.12,
   "end": 145.42,
   "text": "فقط ثواب نماز کم میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 145.42,
   "end": 149.22,
   "text": "در خصوص قلب منیب نکاتی رو دیروز عرض کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 149.22,
   "end": 152.06,
   "text": "یکی از دوستان خوبمون بعد از جلسه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 152.06,
   "end": 153.74,
   "text": "چند تا سؤال خوب پرسید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 153.74,
   "end": 157.8,
   "text": "یکی دو تاشو من بگم چون قطعا تو ذهن کسی که فعال باشه پیش میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 157.8,
   "end": 163.04,
   "text": "حالا یکی میاد حالا خیر شده می‌پرسه یکی هم نمی‌پرسه تو ذهنش میمونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 163.04,
   "end": 168.5,
   "text": "گفتن که شما حاج آقا گفتید که اول توبه است بعد استغفار بعد ندبه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 168.5,
   "end": 174.24,
   "text": "عنابه ببخشید. که حالا اینو ما بر اساس مبانی میگیم، بنده حقیر نمیگم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 174.24,
   "end": 179.98,
   "text": "اگر اول توبه است بعد استغفار چطور ما توی لفظ ظاهری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 179.98,
   "end": 183.66,
   "text": "اینا رو جابجا میبینیم. استغفرالله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 183.66,
   "end": 188.72,
   "text": "و اتوب الیه از اول استغفار اومده بعد توبه اومده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 188.72,
   "end": 191.52,
   "text": "یا استغفرالله و اسأله التوبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 191.52,
   "end": 195.3,
   "text": "توش دو شکلشم اول استغفار اومده بعد توبه اومده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 195.3,
   "end": 203.16,
   "text": "اما شما گفتید اول توبه یعنی ندامت و پشیمانی اتفاق میفته بعد انسان استغفار میکنه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 203.16,
   "end": 207.04,
   "text": "بعد به عنابه میفته. چطور اینجا برعکسه اول",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 207.04,
   "end": 211.06,
   "text": "استغفار بعد توبه. جوابش اینجاست دقت کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 211.06,
   "end": 216.6,
   "text": "اونجایی که میگی استغفرالله و اسأله التوبه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 216.6,
   "end": 220.2,
   "text": "اینجوری عظمت و جایگاه استغفار هم جا می افتاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 220.2,
   "end": 228.84,
   "text": "اونجایی که میگی طلب مغفرت از خدا می‌کنم و از او و اسأله التوبه و از او طلب توبه می‌کنم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 228.84,
   "end": 233.58,
   "text": "برمی‌گرده به اون روایت بسیار عجیب و زیبایی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 233.58,
   "end": 239.18,
   "text": "فرمودن که هر توبه بنده بین دو توبه خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 239.18,
   "end": 245.02,
   "text": "واقع شده. دو تا توبه خدا و توبه بنده رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 245.02,
   "end": 248.1,
   "text": "محسوب کرده. یعنی اول خدا توبه میکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 248.1,
   "end": 253.14,
   "text": "خدا هم تواب است به شدت توبه کننده و برگشت کننده به سمت بنده‌ش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 253.14,
   "end": 256.78,
   "text": "اول خدا توبه میکنه به سمت بنده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 256.78,
   "end": 260.68,
   "text": "بعد بنده توفیق پیدا میکنه که برگرده به سمت خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 260.68,
   "end": 264.32,
   "text": "حالا برگشت خب توبه کرد برگشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 264.32,
   "end": 267.16,
   "text": "یه توبه دیگه هم از خدا اینجا نیازه که چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 267.16,
   "end": 270.82,
   "text": "دو مرتبه خدا این توبه‌ش رو بپذیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 270.82,
   "end": 274.58,
   "text": "خدا اجازه داد تو توبه کنی. خب توبه کردی پذیرش توبه چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 274.58,
   "end": 279.42,
   "text": "باید خدا دو مرتبه به سمت تو توبه کنه به سمت تو برگشت کنه تا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 279.42,
   "end": 282.22,
   "text": "مهر بزنه به توبت. پس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 282.22,
   "end": 286.1,
   "text": "اونجا که میگی استغفرالله و اسأله التوبه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 286.1,
   "end": 288.92,
   "text": "دنبال اون توبه دومیه هستی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 288.92,
   "end": 292.48,
   "text": "یعنی تو اگر توبه نکرده باشی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 292.48,
   "end": 296.76,
   "text": "اگر پشیمون نشده باشی که استغفار نمی‌کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 296.76,
   "end": 299.9,
   "text": "اول پشیمون شدی، توبه کردی این توبه اول.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 299.9,
   "end": 308.32,
   "text": "بعد استغفار می‌کنی. خدایا منو ببخش و اسأله التوبه یعنی خدایا اون توبه دومیه‌تو هم از تو می‌خوام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 308.32,
   "end": 310.38,
   "text": "که این توبه من رو تو بپذیری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 310.38,
   "end": 311.98,
   "text": "این استغفار منو تو بپذیری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 311.98,
   "end": 319.16,
   "text": "پس این اشکال رفع شد. اون اسأله التوبه توبه دوم خدا رو ما داریم طلب می‌کنیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 319.16,
   "end": 321.04,
   "text": "نه توبه اول خودمون رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 321.04,
   "end": 324.36,
   "text": "توبه اول اتفاق افتاده که الان استغفار می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 324.36,
   "end": 329.08,
   "text": "اشکال دوم توی استغفرالله و اتوب الیه چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 329.08,
   "end": 331.44,
   "text": "اینجا که میگیم دیگه صراحتا میگیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 331.44,
   "end": 338.06,
   "text": "خدایا ما رو ببخش استغفار می‌کنیم و اتوب الیه ما به سوی تو برمی‌گردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 338.06,
   "end": 340.0,
   "text": "اینجا باز استغفار مقدمه بر توبه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 340.0,
   "end": 344.78,
   "text": "میگیم این اتوبو دقت کنید اتوبو فعل مضارعه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 344.78,
   "end": 346.92,
   "text": "متکلم وحده مضارعه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 346.92,
   "end": 350.48,
   "text": "اتوبو نتوبو. مضارع هم دلالت بر چی رو داره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 350.48,
   "end": 355.04,
   "text": "استمرار. اینجا که میگی و اتوب الیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 355.04,
   "end": 365.12,
   "text": "این توبه دائمی‌ست یعنی دائما من به سمت تو برمی‌گردم و دائما به سمت خدا برگشتن چی بود؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 365.12,
   "end": 371.74,
   "text": "عنابه بود. پس اینجا منظور از اتوب الیه عنابه است نه اون توبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 371.74,
   "end": 374.96,
   "text": "توجه کردید باز عنابه قسمت سوم واقع شده بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 374.96,
   "end": 377.96,
   "text": "این اشکال رفع شد. پس اول توبه است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 377.96,
   "end": 380.0,
   "text": "بعد استغفاره بعد عنابه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 380.0,
   "end": 384.2,
   "text": "اینجا اگر استغفار من-- مقدم شده بر توبه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 384.2,
   "end": 389.52,
   "text": "چون که این اتوب الیه دلالت بر استمرار دارد، استمرار در توبه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 389.52,
   "end": 393.68,
   "text": "یعنی همون عنابه. باز فرمول رعایت شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 393.68,
   "end": 397.44,
   "text": "جایگاه استغفار خیلی بالا است، خیلی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 397.44,
   "end": 400.44,
   "text": "در قرآن اگر شما دقت کنید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 400.44,
   "end": 404.04,
   "text": "سه تا آیه قرآن من بهتون بگم که این‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 404.04,
   "end": 408.94,
   "text": "نشون میده که تا وقتی سه چیز حتی یه دونش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 408.94,
   "end": 412.26,
   "text": "در امت وجود داره عذاب نازل نمیشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 412.26,
   "end": 414.96,
   "text": "انقدر اینو عظمت داره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 414.96,
   "end": 417.98,
   "text": "تا این سه تا هست خدا عذابشو نازل نمیکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 417.98,
   "end": 422.32,
   "text": "می‌خواید محفوظ باشه زندگیتون، زنتون، بچه‌تون، خودتون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 422.32,
   "end": 424.68,
   "text": "حتی از زلزله محفوظ باشید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 424.68,
   "end": 428.22,
   "text": "وعده خدا تو قرآنه. اصلا تخلف نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 428.22,
   "end": 430.72,
   "text": "دیدم من خانه‌ای که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 430.72,
   "end": 432.94,
   "text": "تمام خانه‌ها ویران شده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 432.94,
   "end": 436.88,
   "text": "با خاک یکسان شده، یه خونه ستونش سالم مونده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 436.88,
   "end": 439.82,
   "text": "اصلا همه تعجب می‌کنند این خونه چرا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 439.82,
   "end": 442.82,
   "text": "ستونش سالم مونده در صورتی که مثل اونای دیگه بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 442.82,
   "end": 446.88,
   "text": "یه سری درش هست. سر در اینجاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 446.88,
   "end": 449.34,
   "text": "این سه تا آیه قرآن رو ببینید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 449.34,
   "end": 454.8,
   "text": "خیلی زیباست. در سه صورت که اگر حتی یکیش باشه عذاب نیست تو این آیات اومده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 454.8,
   "end": 458.76,
   "text": "\"ما کان الله ليعذبهم\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 458.76,
   "end": 464.58,
   "text": "خدا به پیغمبر می‌فرماید من معذب نمی‌کنم، عذابشون نمی‌کنم مردم رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 464.58,
   "end": 469.66,
   "text": "کی؟ \"وأنت فيهم\" و وقتی که تو بین اون‌ها هستی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 469.66,
   "end": 473.0,
   "text": "پس یک-- یکیش پیغمبره که متاسفانه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 473.0,
   "end": 474.96,
   "text": "\"فقد نبينا\" از دست دادیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 474.96,
   "end": 478.1,
   "text": "این امان رو از دست دادیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 478.1,
   "end": 481.86,
   "text": "پس اگر پیغمبر بود عذاب نمی‌اومد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 481.86,
   "end": 486.28,
   "text": "دوم \"ما يفعل الله بعذابكم\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 486.28,
   "end": 488.36,
   "text": "خدا شما رو عذاب نمی‌کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 488.36,
   "end": 492.5,
   "text": "تا کی؟ \"إن شكرتم وآمنتم\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 492.5,
   "end": 496.42,
   "text": "وقتی که شکرگزار باشید در کنار ایمان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 496.42,
   "end": 498.86,
   "text": "الان برف اومده باید شکرگزاری کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 498.86,
   "end": 500.86,
   "text": "الحمدلله على كل نعمة.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 500.86,
   "end": 503.74,
   "text": "نه این نق بزنیم ای بابا ماشینمون گیر کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 503.74,
   "end": 506.82,
   "text": "ای بابا سرما خوردیم. ای بابا فلان شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 506.82,
   "end": 509.58,
   "text": "شکر می‌خواد. شکر در کنار ایمان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 509.58,
   "end": 512.66,
   "text": "اگر شکر در کنار ایمان بود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 512.66,
   "end": 516.12,
   "text": "عذاب نیست. سومیش که مورد بحث ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 516.12,
   "end": 519.0,
   "text": "\"ما كان الله معذبهم\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 519.0,
   "end": 520.9,
   "text": "خدا اینا رو عذاب نمی‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 520.9,
   "end": 523.92,
   "text": "در چه صورتی؟ \"وهم يستغفرون\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 523.92,
   "end": 526.88,
   "text": "در حالی که این‌ها در حال استغفار هستند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 526.88,
   "end": 529.48,
   "text": "پس استغفار امان الهی است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 529.48,
   "end": 532.12,
   "text": "بسیاری از بزرگان فرمودن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 532.12,
   "end": 535.4,
   "text": "اگر پیغمبر رفت امان بعدی وجود دارد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 535.4,
   "end": 538.58,
   "text": "اون هم استغفار است. تا می‌تونید استغفار کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 538.58,
   "end": 542.42,
   "text": "به قول آقای بهجت می‌فرمود لبت تر باشه به استغفار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 542.42,
   "end": 547.14,
   "text": "من خودم خدا مرا ببخشه گاهی اوقات می‌گفتیم به امتحان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 547.14,
   "end": 549.6,
   "text": "مثلا گفتم دو تا دهه مجلس داشتم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 549.6,
   "end": 553.34,
   "text": "گفتم خدایا یه دهه‌شو تا می‌تونم استغفار می‌گیرم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 553.34,
   "end": 557.08,
   "text": "همین تسبیح دستم صبح تا شب استغفار می‌کنم این منبر رو میرم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 557.08,
   "end": 559.8,
   "text": "یه دهه صبح تا شب صلوات می‌فرستم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 559.8,
   "end": 564.72,
   "text": "ببینم کدومش نورانیت این جلسات بیشتر شد و دیدم اون جل-- اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 564.72,
   "end": 568.4,
   "text": "ده جلسه‌ای که استغفار هر روز می‌کردم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 568.4,
   "end": 571.12,
   "text": "خیلی در حد درک خودم خیلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 571.12,
   "end": 575.32,
   "text": "بهتر دراومد تا اون... حالا نمیگم استغفرالله صلوات شد ولی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 575.32,
   "end": 578.92,
   "text": "استغفار خیلی-- امان الهیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 578.92,
   "end": 581.58,
   "text": "و ما متاسفانه کمیم. آقای بهجت هر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 581.58,
   "end": 588.96,
   "text": "کس در مورد هر مشکلی بهش رجوع می‌کرد، شما برید ببینید حالات ایشونو که کتاب‌ها و مطالبی که یا شاگرداشون رو بپرسید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 588.96,
   "end": 592.7,
   "text": "بدون استثنا اس-- توصیه به استغفار می‌کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 592.7,
   "end": 595.16,
   "text": "که حالا یه روایت از امیرالمؤمنین تو همین خصوص هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 595.16,
   "end": 598.6,
   "text": "ذیل یکی از آیات سوره نور. انشاالله فردا میگیم الان وقت نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 598.6,
   "end": 600.72,
   "text": "استغفار، استغفار،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 600.72,
   "end": 603.98,
   "text": "استغفار. انشاالله اگر این استغفار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 603.98,
   "end": 606.82,
   "text": "مداومت داشته باشه میشه عنابه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 606.82,
   "end": 610.54,
   "text": "همون یکی دو بار و یه بار و دو بار و سه بار و اینا باشه عنابه نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 610.54,
   "end": 614.02,
   "text": "پشت سر هم و مستمر شد میشه عنابه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 614.02,
   "end": 618.74,
   "text": "انشاالله عاقبتمون خیر بشه به ذکر صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 618.74,
   "end": 625.26,
   "text": "اللهم صل على محمد و آل محمد و عجل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}