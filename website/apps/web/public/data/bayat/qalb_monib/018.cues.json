  {
   "index": 1,
   "title": "## انابه و تسلیم",
   "start": 102.98,
   "end": 233.08
  },
  {
   "index": 2,
   "title": "## حوالهٔ امام رضا",
   "start": 233.08,
   "end": 391.42
  },
  {
   "index": 3,
   "title": "## گسترش مطلب 018/3",
   "start": 391.42,
   "end": 465.86
  },
  {
   "index": 4,
   "title": "## گسترش مطلب 018/5",
   "start": 465.86,
   "end": 609.98
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.98,
   "end": 3.36,
   "text": "یه دختر سه چهار ساله مریضه ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 3.36,
   "end": 9.56,
   "text": "اما بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 9.56,
   "end": 13.18,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 13.18,
   "end": 17.1,
   "text": "آیاته. سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 17.1,
   "end": 21.86,
   "text": "در خصوص احکام داشتیم شکیات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 21.86,
   "end": 26.58,
   "text": "مبـ-- باطل رو، شکیاتی که نماز رو باطل میکنه عرض میکردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 26.58,
   "end": 32.34,
   "text": "چهارتاشو گمان کنم گفتیم که شک در نماز دو رکعتی، در سه رکعتی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 32.34,
   "end": 37.1,
   "text": "در چهار رکعتی‌هایی که شک یه طرفش یک باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 37.1,
   "end": 39.86,
   "text": "شک داری یک یا هر چند تا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 39.86,
   "end": 44.56,
   "text": "و چهارمش هم شکی بود که یه طرفش دو باشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 44.56,
   "end": 49.22,
   "text": "بین دو یا حالا هر چند تا اما قبل از سجده دوم شک کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 49.22,
   "end": 52.64,
   "text": "این چهار تا رو فکر کنم گفتم. اما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 52.64,
   "end": 56.26,
   "text": "شکیات بعدی که باطل میکنه چهار تا دیگه هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 56.26,
   "end": 60.52,
   "text": "یکی دیگش این هستش که شک بین دو و پنج یا بیشتر،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 60.52,
   "end": 62.72,
   "text": "حالا هر جای نماز چهار رکعتی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 62.72,
   "end": 65.94,
   "text": "قبل سجده دوم، بعد سجده دوم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 65.94,
   "end": 69.04,
   "text": "در حقیقت اختلاف اینجا اشکال ایجاد کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 69.04,
   "end": 71.24,
   "text": "یعنی کسی که نمیتونه تشخیص بده که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 71.24,
   "end": 77.34,
   "text": "دو رکعت یا پنج رکعت، سه رکعت اختلافه آقا بیش بشکن این نماز اصلا به درد نمیخوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 77.34,
   "end": 79.7,
   "text": "چه درد میکنه؟ باطله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 79.7,
   "end": 82.78,
   "text": "خودشم نمیدونه چیکار داره میکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 82.78,
   "end": 84.54,
   "text": "در حقیقت خب خیلی اختلافه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 84.54,
   "end": 86.6,
   "text": "سه تا اختلافه حالا دیگه بیشتر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 86.6,
   "end": 90.38,
   "text": "دو و شش بگیریم و هفت که هیچی دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 90.38,
   "end": 94.62,
   "text": "و اینجا بعضیا گمان میکنن باید سلام نماز رو بدن بعد مثلا دوباره بخونن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 94.62,
   "end": 96.26,
   "text": "نه میگه اصلا باطله بشکن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 96.26,
   "end": 102.26,
   "text": "این اصلا نماز نیست که. اما در خصوص عنابه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 102.26,
   "end": 108.2,
   "text": "در آیه پنجاه و چهار سوره زمر یه نکته‌ی دیگه‌ای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 108.2,
   "end": 110.48,
   "text": "در خصوص قلب منیب عرض کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 110.48,
   "end": 114.72,
   "text": "ببینید آیه رو \"و انیبوا الی ربکم\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 114.72,
   "end": 117.8,
   "text": "برگردید به سمت خودت- خدا تون عنابه کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 117.8,
   "end": 122.06,
   "text": "\"انیبوا الی ربکم و اسلموا له\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 122.06,
   "end": 126.26,
   "text": "بلافاصله بعدش میگه بعد از عنابه تسلیمم باشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 126.26,
   "end": 129.42,
   "text": "همینطوری منافقانه روحتون رو به سمت خدا نکنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 129.42,
   "end": 132.82,
   "text": "تسلیمم اینجا شرطه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 132.82,
   "end": 138.6,
   "text": "که \"من قبل ان یاتیکم العذاب\" قبل از اینکه عذاب بیاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 138.6,
   "end": 142.58,
   "text": "یعنی نشون میده که وقتی عذاب اومد دیگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 142.58,
   "end": 146.18,
   "text": "عنابه و توبه و اینا فایده‌ای نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 146.18,
   "end": 149.06,
   "text": "بعد میفرماید \"ثم لا تنصرون\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 149.06,
   "end": 153.16,
   "text": "میگه اگر شما در حقیقت این رو نداشته باشید، چی رو؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 153.16,
   "end": 160.36,
   "text": "\"انیبوا و اسلموا\" اگه این‌ها رو با هم نداشته باشید \"ثم لا تنصرون\" خدا یارتون نمیده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 160.36,
   "end": 164.3,
   "text": "در حقیقت اینجا نکته‌ای که هست، فرمولی که ایجاد میشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 164.3,
   "end": 167.78,
   "text": "فعلاً این فرمول نیمه کاره است چون آیه بعدشم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 167.78,
   "end": 172.04,
   "text": "با \"و اتبعوا\" شروع میشه، تبعیت هم میاد کنارش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 172.04,
   "end": 174.92,
   "text": "اینجا فرمول این میشه \"انیبوا\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 174.92,
   "end": 179.88,
   "text": "عنابه به علاوه \"اسلموا\" به علاوه تسلیم مساوی است با چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 179.88,
   "end": 185.38,
   "text": "نصرت پروردگار. چون میگه اگه عنابه و تسلیم نبود \"لا تنصرون\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 185.38,
   "end": 187.68,
   "text": "پس اگر عنابه و تسلیم بود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 187.68,
   "end": 191.72,
   "text": "شما رو یاری میده خدا. نصرت خدا خواهد بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 191.72,
   "end": 193.82,
   "text": "حالا آیه قبلش چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 193.82,
   "end": 196.84,
   "text": "\"قل یا عبادی الذين اسرفوا علی انفسهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 196.84,
   "end": 201.02,
   "text": "لا تقنطوا من رحمة الله ان الله يغفر الذنوب جميعاً\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 201.02,
   "end": 206.98,
   "text": "چون داره بحث رحمت و مغفرت \"يغفر الذنوب جميعاً\" بخشش گناهان رو میگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 206.98,
   "end": 211.88,
   "text": "بعد میگه \"انیبوا\" نشون میده که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 211.88,
   "end": 216.6,
   "text": "راه رسیدن به مغفرت گناهان عنابه به علاوه تسلیمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 216.6,
   "end": 220.2,
   "text": "آیه بعدش هم ببینید میفرماید آیه‌ی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 220.2,
   "end": 223.78,
   "text": "این چند بود؟ گفتم شماره‌شو پنجاه و چهار سوره زمر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 223.78,
   "end": 229.86,
   "text": "آیه بعد، آیه پنجاه و پنج هست \"و اتبعوا احسن ما انزل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 229.86,
   "end": 231.86,
   "text": "انزل الیکم من ربکم\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 231.86,
   "end": 234.08,
   "text": "چون با \"و اتبعوا\" شروع میکنه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 234.08,
   "end": 236.58,
   "text": "آقای قرائتی در تفسیر نورش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 236.58,
   "end": 241.06,
   "text": "نکات رو که بیان میکنه میفرماید که پس فرمول اینطوری میشه \"انیبوا\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 241.06,
   "end": 245.42,
   "text": "عنابه به علاوه \"اسلموا\" تسلیم به علاوه \"اتبعوا\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 245.42,
   "end": 247.22,
   "text": "تبعیت میشه چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 247.22,
   "end": 249.82,
   "text": "مساوی است با مغفرت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 249.82,
   "end": 253.56,
   "text": "اون موقع است که تازه خدا شما رو یاری میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 253.56,
   "end": 260.34,
   "text": "نصرت خدا میاد. حالا یه آیه داریم \"ان تنصروا الله ينصركم ويثبت اقدامكم\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 260.34,
   "end": 262.5,
   "text": "اگه خدا رو یاری دادید، خدا یاریتون میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 262.5,
   "end": 265.82,
   "text": "پس اگر خدا یاری نداد \"ثم لا تنصرون\" یعنی چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 265.82,
   "end": 269.94,
   "text": "\"ان تنصروا الله\" اگه شما یاری دادید خدا یاری میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 269.94,
   "end": 273.32,
   "text": "اگه خدا یاری نداد یعنی ما یاری ندادیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 273.32,
   "end": 275.94,
   "text": "توجه کردید؟ با چی یاری ندادیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 275.94,
   "end": 280.62,
   "text": "با همون عنابه، تسلیم بودن و تبعیت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 280.62,
   "end": 284.04,
   "text": "لذا توقع هم نداشته باشیم گناهامونو خدا ببخشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 284.04,
   "end": 286.36,
   "text": "تسلیم بودن و تبعیت خیلی مهمه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 286.36,
   "end": 289.42,
   "text": "و اینکه انسان اون جایی هزینه کنه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 289.42,
   "end": 293.72,
   "text": "چه اعضا و جواره‌ش و چه قوای درونی‌ش و چه فکر و علمش و چه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 293.72,
   "end": 300.68,
   "text": "پولش و چه اعتبار و آبروش و جایی هزینه کنه که خدا دست گذاشته، خدا فرموده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 300.68,
   "end": 303.86,
   "text": "الان وقته ظرف نمازه، وقت نمازه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 303.86,
   "end": 308.12,
   "text": "خدا گفته اینجا تو این ظرف، تو این ظرف زمان نماز بخون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 308.12,
   "end": 311.8,
   "text": "خدا فرموده تو اینجا، تو این ظرف مکان مسجد نماز بخون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 311.8,
   "end": 316.84,
   "text": "تو میگی نه من عشقم کشیده یه ظرف دیگه‌ای برا نمازم پیدا کنم چه از زمان، چه از مکان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 316.84,
   "end": 321.18,
   "text": "میگه تس-تسلیم نبود که حتی برو نمازم بخون،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 321.18,
   "end": 322.86,
   "text": "بهترین نمازم ارائه بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 322.86,
   "end": 327.7,
   "text": "میگه تسلیم نیست. \"انیبوا\" شاید عنابه شاید ظاهراً باشه اما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 327.7,
   "end": 330.04,
   "text": "تسلیم نیست. \"اتبعوا\" هم نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 330.04,
   "end": 333.38,
   "text": "لذا نه مغفرت گناهان هست، نه نصرت الهی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 333.38,
   "end": 338.12,
   "text": "حتی تو پول خرج کردن آدم باید بدونه پولشو اهم فلان اهم کن ببینه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 338.12,
   "end": 342.78,
   "text": "چی به-- الان بخواد پولو هزینه کنه کجا مهم‌تر از جای دیگه‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 342.78,
   "end": 346.62,
   "text": "این خیلی مهمه. یکی از،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 346.62,
   "end": 353.64,
   "text": "از یکی از علما شنیدم این داستانو الفظا می‌کنم متوجه بشیم این تسلیم و تبعیت یعنی چی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 353.64,
   "end": 357.54,
   "text": "حتی رو کردن به امام معصوم هم نیازش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 357.54,
   "end": 364.4,
   "text": "تب-- اون عنابه‌ست دیگه. برگشتن به سمت خدا یه، یه ر-رکنش، یه خودش یه وجهش میشه زیارت امام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 364.4,
   "end": 369.18,
   "text": "اما اون هم باید همراه با این باشه که بدونه چیکار کنه تا امام رضا تحویلش بگیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 369.18,
   "end": 373.22,
   "text": "اگه تسلیم نباشه، اگه تبعیت نداشته باشه امام رضا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 373.22,
   "end": 377.78,
   "text": "حالی بهش نمیده. که آقای بهجت میگه خواستی بری ببین قلبتو بررسی کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 377.78,
   "end": 381.8,
   "text": "یکی از سرمایه‌دارا که هنوزم زنده است ایشون،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 381.8,
   "end": 388.2,
   "text": "وضع مالیش خیلی خوبه. من شنیدم حتی بعضی فرش‌ها و این لوسترهای خیلی قیمتی و میلیاردی حرم هم ایشون هدیه کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 388.2,
   "end": 390.66,
   "text": "خیلی وضعش خوبه و از دست به خیر هم هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 390.66,
   "end": 396.1,
   "text": "اون روز به قصد اینکه زیارت کنه آقا رو بالاخره امام رضا از اون توقعی رو داره که از من",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 396.1,
   "end": 398.32,
   "text": "بچه طلبه مستضعف نداره که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 398.32,
   "end": 401.32,
   "text": "از هر کی یه طلبه، یه توقعی داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 401.32,
   "end": 405.68,
   "text": "میگه رفتم زیارت آقا علی بن موسی الرضا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 405.68,
   "end": 412.2,
   "text": "مثلا صبح بلیط گرفتم صبح برم حرم مثلا بعدازظهر دم غروب برگردم، شب برگردم اینطوری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 412.2,
   "end": 414.98,
   "text": "او تاجر بود بالاخره وقت داشت، ارزش داشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 414.98,
   "end": 418.3,
   "text": "رفت صبح رسید مشهد رفت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 418.3,
   "end": 424.8,
   "text": "حرم هرچی زور زد دید اصلا ارتباط و اتصالی بین او و امام رضا برقرار، برقرار نمیشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 424.8,
   "end": 428.98,
   "text": "هرچی سلام و اذن دخول و نماز و هیچ فایده نداشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 428.98,
   "end": 431.04,
   "text": "گفت نه مثل اینکه امام رضا ما رو راه نمیده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 431.04,
   "end": 434.0,
   "text": "برگشت گفت بریم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 434.0,
   "end": 435.96,
   "text": "اینطوری معلومه آقا راهمون نمیده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 435.96,
   "end": 440.36,
   "text": "برگشت بیاد گفت حالا چند ساعت مونده تا هواپیمامون بریم یه گشتی بزنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 440.36,
   "end": 445.46,
   "text": "همینجوری داشت راه می‌رفت دید یه پیرمرد درب و داغون یه گاری داره هل میده توش پر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 445.46,
   "end": 449.78,
   "text": "جنسه. این گیر کرده توی جوب و داره چپه میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 449.78,
   "end": 452.54,
   "text": "رفت کمکش کرد، گاری رو صاف کرد و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 452.54,
   "end": 457.64,
   "text": "گفت آخه پیرمرد مگه مجبوری تو جو-جون نداری این همه بار بزنی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 457.64,
   "end": 461.2,
   "text": "این پیرمرد با یه دل شکسته گفت اگر من",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 461.2,
   "end": 465.76,
   "text": "وضعم خوب بود که اینطوری با این سنم می‌آمدم گاری بکشم که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 465.76,
   "end": 467.6,
   "text": "تو اصلا از دل من خبر داری؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 467.6,
   "end": 470.9,
   "text": "چیه؟ دردت چیه؟ پدر پیرم. این امام رضا بخواد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 470.9,
   "end": 478.44,
   "text": "گفت من مثلا چند تا دختر دم وقت دارم و مستاجرم و صاحبخونه جوابم کرده و به قول ما هشت هم یه رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 478.44,
   "end": 481.8,
   "text": "کمکش کرد تا در خونه این بارش رو رسوند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 481.8,
   "end": 485.1,
   "text": "بعد به دلش افتاد گفت پیرمرد میشه ما بیایم مهمونت باشیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 485.1,
   "end": 487.3,
   "text": "اون اول یه ذره سرش رو خاروند که آخه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 487.3,
   "end": 491.0,
   "text": "این کیه؟ من نمیشناسم. گفت حالا باشه بیا کمک کردی تا اینجا به ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 491.0,
   "end": 497.5,
   "text": "بیا بریم یه چایی با ما بخور. رفت تو خونه و دید اصلا این منزل در و دیوارش فقر می‌ریزه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 497.5,
   "end": 499.64,
   "text": "مثلا رو زیلون زندگی می‌کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 499.64,
   "end": 504.86,
   "text": "یه وضعی. نشست خلاصه یه چایی با این بنده خدا خورد و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 504.86,
   "end": 506.76,
   "text": "باهاش درد و دل کرد. گفت مشکلت چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 506.76,
   "end": 514.1,
   "text": "چیکار می‌کنی؟ اونم گفت خلاصه دید چند تا دختر دم وقت و مستاجر و هیچی هم نداره و نه کاری نه کاسبی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 514.1,
   "end": 516.22,
   "text": "چکشو برداشت دمشم گرم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 516.22,
   "end": 518.02,
   "text": "به قول اون بچه‌های نظامآباد دمش گرم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 518.02,
   "end": 523.26,
   "text": "برداشت چکشو نوشت حساب کرد جهیزیه چقدر میشه برای هر دخترش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 523.26,
   "end": 525.36,
   "text": "خونه چقدر میشه براش خونه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 525.36,
   "end": 527.18,
   "text": "همون مقدارو حساب کرد بره بخره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 527.18,
   "end": 530.04,
   "text": "یه پول درشتی هم داد که بره کاسبی راه بندازه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 530.04,
   "end": 533.96,
   "text": "چکو به این داد. پیرمرد هم با ناباوری شروع کرد زار زار گریه کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 533.96,
   "end": 536.84,
   "text": "زنش گریه افتاد، دخترا هم به گریه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 536.84,
   "end": 540.48,
   "text": "حالا این هی تا دم در اومدن تشکر و قدردانی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 540.48,
   "end": 544.04,
   "text": "آخه شما کی هستی؟ رو چه حسابی چک رو-- شما چیکار دارید من کیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 544.04,
   "end": 549.64,
   "text": "حواله امام رضا بوده. تا گفت حواله امام رضا بوده برگشت بره که مثلا سمت فرودگاه دید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 549.64,
   "end": 553.1,
   "text": "سیل اشکی که از چش-چشمش داره جاری میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 553.1,
   "end": 558.4,
   "text": "اصلا دل زنده شده، اون دل مرده انگار قفلش باز شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 558.4,
   "end": 563.84,
   "text": "دید نمی‌تونه بره فرودگاه. دوباره برگشت رفت سمت حرم و چه کیفی، چه صفایی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 563.84,
   "end": 566.1,
   "text": "فهمید که ببینید ت--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 566.1,
   "end": 572.96,
   "text": "اصل مو اگر میخوای عناب کنی تسلیمم باش، تبعیتو-- بدون کجا باید هزینه کنی تا راه بدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 572.96,
   "end": 578.74,
   "text": "اینطور نیست که تو حالا مثلا یکی مشکل داره بعد تو بری تو بهترین هتل‌ها و بهترین غذاها،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 578.74,
   "end": 585.36,
   "text": "اوبر مثلا بهترین تفریح‌هات تو مشهد و اون زیارتت هم بخواد قبول باشه بغل دست حرم هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 585.36,
   "end": 591.7,
   "text": "فقرا. بالاخره باید آدم بدونه این تسلیم بودن چگونه است و الا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 591.7,
   "end": 596.36,
   "text": "خب یه فیضی، یه فیضکی از زیارت می‌بری اما اونطور نیست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 596.36,
   "end": 598.7,
   "text": "که تو دل آقا جا کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 598.7,
   "end": 603.52,
   "text": "انشاالله عاقبتمون ختم بخیر بشه به ذکر صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 603.52,
   "end": 609.98,
   "text": "اللهم صل على محمد و آل محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}