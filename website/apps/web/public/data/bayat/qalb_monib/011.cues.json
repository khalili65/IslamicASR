 "chapters": [
  {
   "index": 0,
   "title": "## کثیرالشک در نماز",
   "start": 1.04,
   "end": 68.98
  },
  {
   "index": 1,
   "title": "## قلب منیب؛ توکل پیش‌نیاز انابه",
   "start": 68.98,
   "end": 243.92
  },
  {
   "index": 2,
   "title": "### تدبیر یعقوب و تفویض به خدا",
   "start": 243.92,
   "end": 318.08
  },
  {
   "index": 3,
   "title": "### خودباوری همراه توکل",
   "start": 318.08,
   "end": 382.92
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 1.04,
   "end": 4.96,
   "text": "بسم الله الرحمن الرحیم و بهی نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 4.96,
   "end": 7.7,
   "text": "السلام علیک یا داعی الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 7.7,
   "end": 10.26,
   "text": "و ربانی آیات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 10.26,
   "end": 12.42,
   "text": "سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 12.42,
   "end": 17.5,
   "text": "در خصوص شکیات عرض کردیم که شک‌هایی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 17.5,
   "end": 22.66,
   "text": "در نماز نباید به اونا اعتنا کرد شش مورد داشت که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 22.66,
   "end": 25.74,
   "text": "اِاِامروز عرض می‌کنیم یکی از اون‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 25.74,
   "end": 29.06,
   "text": "کثیرالشک است. یعنی کسی که زیاد شک کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 29.06,
   "end": 32.12,
   "text": "البته این کثیرالشک در هر چیزی هست؛",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 32.12,
   "end": 39.12,
   "text": "در متحرکات و وضو و غسل و این‌ها آدم اگه کسی زیاد شک میکنه نباید به شکش اعتنا کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 39.12,
   "end": 45.98,
   "text": "بعد اِاِ حالا سؤال این هستش که چطور میشه تشخیص داد ما کثیرالشک هستیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 45.98,
   "end": 52.96,
   "text": "غالب مراجع فرمودن که اگر چنانچه در یک نماز سه مرتبه شک کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 52.96,
   "end": 57.3,
   "text": "غالبا اینطوری باشه که در یک نماز سه مرتبe شک میکنه یا اینکه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 57.3,
   "end": 66.44,
   "text": "در سه نماز متوالی مثل صبح و ظهر و عصر در هر کدوم یک بار شک کنه چنین کسی کثیرالشک است و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 66.44,
   "end": 68.98,
   "text": "نباید به شکش اعتنا کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 68.98,
   "end": 74.38,
   "text": "موضوع ما به فضل الهی بحث قلب منیب بود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 74.38,
   "end": 77.38,
   "text": "و عرض کردیم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 77.38,
   "end": 82.12,
   "text": "پیش نیاز این که انسان به عنابه بیفته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 82.12,
   "end": 84.06,
   "text": "اِاِ توکل بر خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 84.06,
   "end": 88.46,
   "text": "یعنی تا کسی به خدا اعتماد نکنه کاملاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 88.46,
   "end": 93.12,
   "text": "به سمت خدا نمیاد، به خدا توجه و عنابه نمیکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 93.12,
   "end": 101.0,
   "text": "قدیم‌ها نقل می‌کنند که یکی از علما نماز است-- اِاِ استغاثه و طلب باران اعلام میکنه که میخوام بخونم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 101.0,
   "end": 102.96,
   "text": "مردم جمع شن بیرون شهر و اینها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 102.96,
   "end": 105.18,
   "text": "وقتی که میره بیرون شهر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 105.18,
   "end": 113.52,
   "text": "مردم رو تجمع که کردن رو نگاه میکنه برای اینکه شروع کنه به نماز چشمش میفته به یک بچه‌ای که،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 113.52,
   "end": 116.58,
   "text": "بچه نوجوانی که چتر دستش گرفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 116.58,
   "end": 119.6,
   "text": "میبینه تنها کسی که در جمعی است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 119.6,
   "end": 122.76,
   "text": "چتر دستش این بچه نوجوان هست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 122.76,
   "end": 126.18,
   "text": "و اونجاست که به همه میگه برگردید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 126.18,
   "end": 131.54,
   "text": "معلومه که جز این نوجوان کسی به خدا اعتماد نداشته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 131.54,
   "end": 133.28,
   "text": "برگردید. واقعاً هم اینطوریه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 133.28,
   "end": 137.2,
   "text": "اگر کسی به خدا اعتماد داشته باشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 137.2,
   "end": 142.1,
   "text": "اِاِ ملزومات کار رو هم فراهم میکنه مثل این بچه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 142.1,
   "end": 144.94,
   "text": "انقدر یقین داشته که باران خواهد بارید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 144.94,
   "end": 150.84,
   "text": "با خودش چتر برده بوده. در هر حال حالا سؤالی که اینجا پیش میاد اینه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 150.84,
   "end": 153.92,
   "text": "آیا این توکل منافات با",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 153.92,
   "end": 157.6,
   "text": "اعتماد به نفس داره که یک موضوع روانشناختی است؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 157.6,
   "end": 159.66,
   "text": "آیا اسلام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 159.66,
   "end": 162.92,
   "text": "اصلاً اعتماد به نفس رو قبول داره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 162.92,
   "end": 166.36,
   "text": "آیا متعارض با توکل و اعتماد به خداست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 166.36,
   "end": 169.86,
   "text": "در این خصوص شارحین و مفسرین نظرات متعددی دادن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 169.86,
   "end": 176.46,
   "text": "عده‌ای قبول کردن اِاِ نظر موافق دارن، عده‌ای مخالف، عده‌ای هم بینابین‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 176.46,
   "end": 179.22,
   "text": "اما اونچه که برای ما اهمیت داره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 179.22,
   "end": 186.56,
   "text": "بیشتر نظر اِاِ حضرت استاد علامه طباطبایی رحمة الله علیه هست که در کتاب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 186.56,
   "end": 189.66,
   "text": "گران سنگ تفسیر المیزانشون آوردن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 189.66,
   "end": 191.34,
   "text": "با شرحی مفصلی البته دادن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 191.34,
   "end": 194.34,
   "text": "خلاصه‌ش اینه که وقتی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 194.34,
   "end": 197.78,
   "text": "خالق ما انس-- خدای منّان است،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 197.78,
   "end": 200.14,
   "text": "یعنی خدای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 200.14,
   "end": 203.52,
   "text": "متعال است که انسان رو خلق کرده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 203.52,
   "end": 205.96,
   "text": "پس مالک ما هم خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 205.96,
   "end": 211.86,
   "text": "لذا جمیع قوای درونی ما اون هم مالکش خداست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 211.86,
   "end": 217.72,
   "text": "و این قوا رو خدای منّان در اختیار ما قرار داده و باید از اون‌ها هم استفاده کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 217.72,
   "end": 226.02,
   "text": "در حقیقت این جمع‌بندی علامه این هست که اگر کسی از قوای عقل و تدبیرش استفاده کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 226.02,
   "end": 228.94,
   "text": "باز به نوعی به خدا اعتماد کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 228.94,
   "end": 233.34,
   "text": "لکن این قوا به صورت استقلالی نیستند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 233.34,
   "end": 238.62,
   "text": "در حقیقت علت طامه نیستن، علت ناقصه‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 238.62,
   "end": 242.36,
   "text": "اصالت ندارن، مستقلن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 242.36,
   "end": 246.44,
   "text": "در حقیقت مثالی که علامه آوردن مثل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 246.44,
   "end": 252.68,
   "text": "جریان حضرت یعقوب نبی علی نبیانا و آله و عليه الصلاة والسلام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 252.68,
   "end": 258.04,
   "text": "که میفرماید به فرزندانش وقتی می‌خواید وارد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 258.04,
   "end": 263.08,
   "text": "شهر مصر بشید از درب‌های متعدد وارد بشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 263.08,
   "end": 264.68,
   "text": "یعنی تدبیر میکنه ایشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 264.68,
   "end": 271.08,
   "text": "میگه از درب‌های متعدد وارد بشید لکن در انتها اعتمادتون به خدا باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 271.08,
   "end": 280.1,
   "text": "در حقیقت اِاِ میشه گفت که انسان از این قوه عقل و تدبیری که خدای منّان به انسان داده استفاده میکنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 280.1,
   "end": 286.58,
   "text": "لکن امر رو تفویض به خدا میکنه و به جهت اعتماد کاملی که به خدا داره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 286.58,
   "end": 289.42,
   "text": "منتظر میشه که نتیجه تحت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 289.42,
   "end": 294.02,
   "text": "کنترل و رضایت الهی انشاالله حاصل بشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 294.02,
   "end": 297.3,
   "text": "و همونطور که در آیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 297.3,
   "end": 301.76,
   "text": "هشتاد و هشت اِاِ عرض کنم خدمتتون سوره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 301.76,
   "end": 305.12,
   "text": "مبارکه هود واقع شده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 305.12,
   "end": 307.72,
   "text": "\"و ما توفیقی الا بالله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 307.72,
   "end": 310.92,
   "text": "عليه توکلت و اليه انیب\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 310.92,
   "end": 317.92,
   "text": "ما نتیجه میگیریم که مقدمه و پیش نیاز عنابه، توکل است و اعتماد بر خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 317.92,
   "end": 328.88,
   "text": "و رهبر عزیزمون هم در اِاِ سخنرانی سال هشتاد و هشت یادم ایشون بحث اعتماد به نفس ملی رو مطرح کردن و خودباوری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 328.88,
   "end": 335.52,
   "text": "در حقیقت انسان باید زحمتشو بکشه اما در عین حال اعتماد کاملش به خدا باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 335.52,
   "end": 338.16,
   "text": "بیاد سر کار اما بدونه روزی رو خدا میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 338.16,
   "end": 346.08,
   "text": "نمیشه تو خونه بنشینه و از وسایل استفاده نکنه صرف اینکه بگه من به خدا اعتماد دارم روزی میرسونه، نه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 346.08,
   "end": 351.74,
   "text": "قوایی که خدا به انسان عطا کرده در مسیر خود خدا هزینه بشه، خرج بشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 351.74,
   "end": 354.84,
   "text": "اما اعتماد انسان فقط به خدا باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 354.84,
   "end": 358.3,
   "text": "خصوصاً وقتی گرهی پیش میاد، مانعی پیش میاد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 358.3,
   "end": 361.64,
   "text": "آرام باشه، مضطرب نشه بدونه که خدا او گره رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 361.64,
   "end": 368.1,
   "text": "انشاالله برطرف خواهد کرد. حالا به امید خدا فردا اگر خدا توفیقی داد و عمری داد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 368.1,
   "end": 372.3,
   "text": "پیش نیاز توکل رو با هم بررسی می‌کنیم که حالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 372.3,
   "end": 377.78,
   "text": "چی میشه که انسان توکل بر خدا میکنه که در نهایت به عنابه میرسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 377.78,
   "end": 379.9,
   "text": "انشاالله که عاقبتمون خیر و به خیر بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 379.9,
   "end": 382.92,
   "text": "به برکت ذکر صلوات بر محمد و آل محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}