  {
   "index": 1,
   "title": "## جمع‌بندی قلب منیب و معنای انابه",
   "start": 83.02,
   "end": 103.32
  },
  {
   "index": 2,
   "title": "## انابه فطری ناپایدار و انابه پایدار اختیاری",
   "start": 103.32,
   "end": 123.88
  },
  {
   "index": 3,
   "title": "## سه پایهٔ تحقق انابه",
   "start": 123.88,
   "end": 144.14
  },
  {
   "index": 4,
   "title": "## توکل مقدم بر انابه",
   "start": 144.14,
   "end": 407.8
  },
  {
   "index": 5,
   "title": "## داستان امام و خانهٔ نجف",
   "start": 407.8,
   "end": 614.08
  },
  {
   "index": 6,
   "title": "## جمع‌بندی",
   "start": 614.08,
   "end": 640.74
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.0,
   "end": 5.8,
   "text": "بسم الله الرحمن الرحیم و به این استعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 5.8,
   "end": 8.42,
   "text": "السلام علیک یا داعی الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 8.42,
   "end": 10.62,
   "text": "و ربانی آیاته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 10.62,
   "end": 13.94,
   "text": "سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 13.94,
   "end": 16.38,
   "text": "طبق نظر جمیع مراجع",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 16.38,
   "end": 19.8,
   "text": "ما در بحث شکیات نماز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 19.8,
   "end": 27.58,
   "text": "سه بخش داریم. یکی شکیاتی که نباید بهش اعتنا کرد در نماز اگر این شک پیش بیاد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 27.58,
   "end": 30.96,
   "text": "در حوزه نماز نباید بهش اعتنا کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 30.96,
   "end": 37.4,
   "text": "یکی شک‌های صحیحه که اگر این شک ایجاد شد نماز درسته لکن یه دستور العملی داره باید پیاده بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 37.4,
   "end": 42.26,
   "text": "یکی هم شک‌های با-- مبتله که باطل میکنه نمازو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 42.26,
   "end": 44.06,
   "text": "این‌ها رو ما باید، باید بشناسیم دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 44.06,
   "end": 51.78,
   "text": "حالا فضل الهی هر روز یه دونه‌شو بگیم در خصوص شک‌هایی که نباید اعتنا کرد یکیش همین شکی که در نماز جماعت هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 51.78,
   "end": 54.3,
   "text": "یکی از کارهایی که دیگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 54.3,
   "end": 57.24,
   "text": "از برکات نماز جماعت همینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 57.24,
   "end": 59.9,
   "text": "به هر حال آدمای شکاک که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 59.9,
   "end": 63.94,
   "text": "زیاد شک می‌کنند و این‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 63.94,
   "end": 67.62,
   "text": "اه وقتی که نماز جماعت شرکت می‌کنند دیگه خیالشون راحت میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 67.62,
   "end": 73.96,
   "text": "یکی از برکات جماعت اینه. میگه اعتنا نکن بهش هرچه امام جماعت باشی چه مأموم باشی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 73.96,
   "end": 76.98,
   "text": "اونچه که جماعت داره انجام میده رو تبعیت می‌کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 76.98,
   "end": 83.02,
   "text": "پس یکی از جاهایی که نباید به شک اعتنا کرد در نماز جماعت هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 83.02,
   "end": 92.98,
   "text": "تا یه جمع‌بندی به فضل الهی در خصوص بحث قلب منیب داشته باشیم بعضی از نکات رو البته هر کدوم از این‌ها جای بحث و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 92.98,
   "end": 97.2,
   "text": "توضیح و این‌ها داره. لکن خب حالا ما تبرّکاً رد میشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 97.2,
   "end": 100.98,
   "text": "عناب مصدر باب افعال از ریشه نون،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 100.98,
   "end": 107.42,
   "text": "واو و به که معمولاً با الا و بیشتر با الا و بعضا با عن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 107.42,
   "end": 110.92,
   "text": "میاد با عین و نون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 110.92,
   "end": 113.88,
   "text": "به معنای بازگشت مکرر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 113.88,
   "end": 117.18,
   "text": "این معنای که همه غالباً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 117.18,
   "end": 120.12,
   "text": "شارحین و مفسرین پذیرفتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 120.12,
   "end": 123.88,
   "text": "به زنبور عسل هم اگر برید دقت کنید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 123.88,
   "end": 127.82,
   "text": "اسامی که به زنبور عسل دادن نوب هم گفتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 127.82,
   "end": 132.6,
   "text": "نوب. چرا؟ به جهت اینکه مکرراً به کندوش برمی‌گرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 132.6,
   "end": 137.72,
   "text": "هر جا بره هی دائماً در حال برگشته در جای به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 137.72,
   "end": 140.44,
   "text": "کندوشه. لذا بهش نوب میگن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 140.44,
   "end": 144.14,
   "text": "اگر کسی این حالت را به درگاه خدا داشته باشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 144.14,
   "end": 148.12,
   "text": "او هم نوب هست یعنی در حقیقت در حال عنابه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 148.12,
   "end": 151.0,
   "text": "حادثه هم از این جهت بهش نائبه میگن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 151.0,
   "end": 155.3,
   "text": "حادثه چون هر آن در حال اتفاقه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 155.3,
   "end": 157.72,
   "text": "هر آن یه حادثه‌ای داره رخ میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 157.72,
   "end": 164.16,
   "text": "لذا بهش نائبه گفتن چون در، در، در هر حالت در هر آن به آن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 164.16,
   "end": 166.84,
   "text": "این داره تکرار میشه و اتفاق میفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 166.84,
   "end": 171.62,
   "text": "پس این‌ها رو حالا ما تو ترجمه محتوایش عرض کردیم که یعنی دائماً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 171.62,
   "end": 173.22,
   "text": "به سمت خدا حرکت کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 173.22,
   "end": 175.74,
   "text": "عنابه دو گونه‌ست. یکی بحث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 175.74,
   "end": 180.72,
   "text": "عنابه فطری اصطلاحاً بهش میگن یا عنابه ظاهری بهش میگن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 180.72,
   "end": 184.44,
   "text": "یا عنابه اضطراری و ناپایدار بهش میگن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 184.44,
   "end": 187.02,
   "text": "که مثالشو عرض کردیم در آیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 187.02,
   "end": 189.76,
   "text": "سی تا سی و سه سوره روم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 189.76,
   "end": 193.92,
   "text": "که این مشترکه بین مؤمن و کافر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 193.92,
   "end": 197.32,
   "text": "وقتی که به گرفتاری می‌افتند صریح آیه قرآن چی بود؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 197.32,
   "end": 203.38,
   "text": "\"وإذا مس الناس\" الف و لام سر الناس میاره همه مردم غالبا، غالباً اینطوری هستن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 203.38,
   "end": 205.3,
   "text": "حالا چه مؤمن باشن چه کافر و مشرک.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 205.3,
   "end": 207.36,
   "text": "\"ضر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 207.36,
   "end": 213.28,
   "text": "دعاء ربهم\" وقتی که پریشانی بهشون برسه \"دعاء ربهم\" خداشونو می‌خونن \"منيبين إليه\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 213.28,
   "end": 217.76,
   "text": "این عنابه‌ای که اینجا اومده عنابه ناپایداره چون مشرک و منافق هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 217.76,
   "end": 221.46,
   "text": "الناس همه رو گفته شامل میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 221.46,
   "end": 224.12,
   "text": "این عنابه، اون عنابه‌ای نیستش که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 224.12,
   "end": 227.34,
   "text": "عنابه، این عنابه فطری یعنی ذاتاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 227.34,
   "end": 230.68,
   "text": "در همه این برگشت به سمت خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 230.68,
   "end": 238.08,
   "text": "وجود داره. در حقیقت بهش بعضیا عنابه دروغین هم گفتن که برای ربوبیت خدا پیش میاد چون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 238.08,
   "end": 241.38,
   "text": "م-- هر کسی در وجود فطرت خودش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 241.38,
   "end": 246.72,
   "text": "میدونه یه ربی داره، یه پروردگاری داره در نهاد وجودش وقت مشکل به سمت او میره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 246.72,
   "end": 253.72,
   "text": "دومیش عنابه پایدار و اختیاریه که این برای راست-- آنهایی‌اند که راست قامت‌اند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 253.72,
   "end": 256.96,
   "text": "و عنابه‌شون حقیقی‌ست و آن به آن چه در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 256.96,
   "end": 261.84,
   "text": "پریشانی چه در آسایش باشن به سمت خدا حرکت می‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 261.84,
   "end": 264.94,
   "text": "اما عنابه بر سه امر محقق میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 264.94,
   "end": 270.64,
   "text": "یعنی سه پایه داره. باید تو این سه قسم عنابه وجود داشته باشه و الا عنابه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 270.64,
   "end": 276.34,
   "text": "کامل نیست. یکی در باطن و قلب هست که بحث ما بیشتر این بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 276.34,
   "end": 279.92,
   "text": "یعنی عنابه قلبی، انسان قلباً به سمت خدا بره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 279.92,
   "end": 284.44,
   "text": "مصداقش هم همون آیه سی و سه سوره قافه که عرض کردیم \"وجاء",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 284.44,
   "end": 289.78,
   "text": "منحشی الرحمن بالقلب\" به اشتیاق فطرشون این بود و جاء بقلب--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 289.78,
   "end": 292.8,
   "text": "وجاء بربّه بقلب منیب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 292.8,
   "end": 296.0,
   "text": "میان به سمت خدا وجاء بقلب منیب ببخشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 296.0,
   "end": 298.84,
   "text": "به سمت خدا میان بقلب مبین،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 298.84,
   "end": 301.16,
   "text": "م-منیب با قلبی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 301.16,
   "end": 304.52,
   "text": "دائماً در حال برگشت به سمت خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 304.52,
   "end": 307.56,
   "text": "این صراحتاً تو این آیه داره اشاره به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 307.56,
   "end": 314.54,
   "text": "برگشت قلبی می‌کنه. دومی عنابه‌ای در گفتاره بهش میگن ذکر دائمی لسانی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 314.54,
   "end": 316.94,
   "text": "مصداقش هم در آیه سیزده سوره غافر هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 316.94,
   "end": 320.06,
   "text": "\"وما يتذكر إلا من ينيب\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 320.06,
   "end": 325.8,
   "text": "میگه کسی به حال ذکر و یادآوری خدا نمیفته مگر من-منیب باشه، در حال عنابه باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 325.8,
   "end": 329.48,
   "text": "حتی ذکر ظاهری هم توفیق هر کسی نمیشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 329.48,
   "end": 331.86,
   "text": "سومیش هم عنابه در اعمال ظاهریه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 331.86,
   "end": 336.06,
   "text": "یعنی همون اطاعت خ-اطاعت الهی و عبادیت و این‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 336.06,
   "end": 341.26,
   "text": "که در آیه هشتاد و هشت سوره هود این رو از توفیقات الهی میدونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 341.26,
   "end": 344.08,
   "text": "\"وما توفیقی إلا بالله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 344.08,
   "end": 347.74,
   "text": "عليه توکلت والیه أنيب\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 347.74,
   "end": 353.28,
   "text": "میگه در حال عبادت هم این‌ها به سمت خدا عملیات ظاهرشون رو برمی‌گردونن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 353.28,
   "end": 355.78,
   "text": "حالا نکته‌ای که اینجا هست و این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 355.78,
   "end": 358.12,
   "text": "توجه ویژه لازم داره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 358.12,
   "end": 362.0,
   "text": "تو همین آیه هشتاد و هشت هود اگه دقت کنید می‌فرماید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 362.0,
   "end": 366.0,
   "text": "\"عليه توکلت واليه أنيب\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 366.0,
   "end": 372.48,
   "text": "شاه رین اینجا فرمودن که چون توکل مقدم بر انابه اومده پس از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 372.48,
   "end": 377.08,
   "text": "لوازم مهم و ضروری انابه توکله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 377.08,
   "end": 382.92,
   "text": "یعنی کسی به حالت انابه نمیفته مگر اینکه اعتماد به خدا داشته باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 382.92,
   "end": 389.02,
   "text": "اگر کسی انابه نداره یعنی دائما به سمت خدا نمیره، یعنی اعتماد به خدا نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 389.02,
   "end": 392.3,
   "text": "کلید واژه اینجاست. توکل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 392.3,
   "end": 395.94,
   "text": "رمز اساسی برای برگشت دائم به سمت خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 395.94,
   "end": 398.82,
   "text": "اگر کسی خداشو قبول کرد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 398.82,
   "end": 407.8,
   "text": "قبول کرد که خدا قابل اعتماده بلکه معتمد‌ترین است، اون موقع دائما به سمت معتمدترینش حرکت میکنه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 407.8,
   "end": 412.0,
   "text": "از حضرت امام رحمت الله علیه که به هر حال اسطوانه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 412.0,
   "end": 418.38,
   "text": "اعتماد به خدا در زمان ما بودند، یه داستان عجیب من در زندگی نامه‌شون می‌خوندم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 418.38,
   "end": 421.96,
   "text": "و البته برای امثال من ضعیف الإيمان عجیبه این‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 421.96,
   "end": 425.68,
   "text": "آستاد احمد نقل می‌کردن رحمت الله علیه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 425.68,
   "end": 430.71,
   "text": "امام که تو نجف بود، خب یه جا رو اجاره کرده بودن، یه خونه‌ای.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 430.71,
   "end": 433.22,
   "text": "همون خونه‌ای که خیلی معروف هست تو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 433.22,
   "end": 436.96,
   "text": "شارع‌الرسول میرید می‌بینید باب القبل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 436.96,
   "end": 440.44,
   "text": "آقا امیرالمؤمنین یه خونه برید ببینید خیلی نورانیه این خونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 440.44,
   "end": 444.22,
   "text": "این خونه رو اجاره کرده بودن. خلاصه اجاره عقب افتاده بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 444.22,
   "end": 448.28,
   "text": "حالا مرجع جهان تقلید جهان شیعه اجاره‌ش عقب افتاده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 448.28,
   "end": 450.5,
   "text": "صاحبخونه یه فشار آورده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 450.5,
   "end": 453.42,
   "text": "آستاد احمد روش نمیشد. آخر به امام گفت آره بابا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 453.42,
   "end": 456.12,
   "text": "صاحبخونه اومده میگه اجاره چی شد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 456.12,
   "end": 459.52,
   "text": "امام فرمودن که بهش بگو که میفروشی خونه‌تو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 459.52,
   "end": 462.44,
   "text": "آستاد احمد تعجب کرد گفت ما اجاره نداریم بدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 462.44,
   "end": 464.62,
   "text": "شما می‌خواید بخرید با چه پولی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 464.62,
   "end": 467.84,
   "text": "فرمود با توکل بر خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 467.84,
   "end": 471.38,
   "text": "بعد دوباره صاحبخونه اومد پرسید آقا اجاره چی شد و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 471.38,
   "end": 475.16,
   "text": "باز اومد به امام-- آستاد احمد گفت دوباره اومد sagt گفت گفتی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 475.16,
   "end": 477.28,
   "text": "امام فرمود گفتی میف-می‌فروشی یا نه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 477.28,
   "end": 479.72,
   "text": "گفت آخه من روم نشد با چه پولی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 479.72,
   "end": 482.76,
   "text": "امام فرمود باباجون با توکل بر خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 482.76,
   "end": 486.16,
   "text": "روز دو-- سوم دوباره صاحبخونه اومد گفت آقا شما می‌فروشی خونه رو؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 486.16,
   "end": 488.24,
   "text": "گفت بله که می‌فروشم. مشتری هم دارم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 488.24,
   "end": 493.02,
   "text": "چقدر؟ بیست هزار تومن. بیست هزار تومن اون موقع خیلی بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 493.02,
   "end": 495.44,
   "text": "بعد گفت آره می‌فروشم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 495.44,
   "end": 497.3,
   "text": "امام به آستاد احمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 497.3,
   "end": 503.5,
   "text": "وقتی خبر رسید که گفته بیست هزار تومن امام فرمود بهش بگو که فردا بعدازظهر قرار بذارین برای معامله،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 503.5,
   "end": 507.2,
   "text": "برای نوشتن معامله،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 507.2,
   "end": 509.1,
   "text": "این بیعنامه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 509.1,
   "end": 514.8,
   "text": "خلاصه آستاد احمد میگه دوباره به امام گفتم بابا آخه با چه پولی می‌خوای شما این قولنامه رو بنویسی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 514.8,
   "end": 519.78,
   "text": "گفت با توکل بر خدا. خلاصه فردا شد دیدیم خبری هم نشد تا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 519.78,
   "end": 522.98,
   "text": "دمدمای ظهر یه دفعه یه گروهی اومدن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 522.98,
   "end": 528.02,
   "text": "حاجی‌هایی بودن که از مریدای امام و مقلدین حضرت امام بودن می‌خواستن برن حج.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 528.02,
   "end": 532.46,
   "text": "به امام گفتن آقا ما پول‌هایی رو داریم رو هم می‌خوایم بگذاریم به شما بدیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 532.46,
   "end": 538.32,
   "text": "امانته‌ست اما قصد تصرفش هم اشکال نداره، یعنی می‌تونید تصرف کنید، ازش استفاده کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 538.32,
   "end": 541.98,
   "text": "لکن ما از حج برگشتیم عین پولو به ما برگردونید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 541.98,
   "end": 544.4,
   "text": "امام هم قبول کرد گفت توکل به خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 544.4,
   "end": 547.86,
   "text": "این پولو گرفت و گفت خب با این معامله می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 547.86,
   "end": 551.82,
   "text": "بعد آستاد احمد گفت خب اینو از حج برگشتن با چی می‌خوای اینو برگردونی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 551.82,
   "end": 554.08,
   "text": "فرمود با توکل بر خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 554.08,
   "end": 559.38,
   "text": "آقا رفت و یک ساعت بعد آستاد احمد میگه دیدم اینا برگشتن، حاجی‌ها برگشتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 559.38,
   "end": 561.88,
   "text": "گفتن آقا سفرمون کنسل شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 561.88,
   "end": 563.68,
   "text": "پول امانتی رو به ما بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 563.68,
   "end": 565.3,
   "text": "امام امانتی رو برگردوند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 565.3,
   "end": 567.28,
   "text": "آستاد احمد گفت وای دیگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 567.28,
   "end": 569.98,
   "text": "چند ساعت دیگه بعدازظهر قولنامه باید بنویسیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 569.98,
   "end": 573.94,
   "text": "هیچی هم نداریم. با چه پولی؟ امام گفت با توکل بر خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 573.94,
   "end": 579.36,
   "text": "یک ساعت مونده بود که به ساعت قولنامه برادر حضرت امام،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 579.36,
   "end": 583.24,
   "text": "آقای پسندیده معروف، ایشون از خمین میان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 583.24,
   "end": 589.56,
   "text": "به نجف. خلاصه اون موقع هیچ وسایل ارتباطی نبوده که موبایل و تلفن اینا خبر بدن من اومدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 589.56,
   "end": 591.88,
   "text": "ناخودآگاه یه دفعه وارد میشه ایشون،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 591.88,
   "end": 594.54,
   "text": "یک ساعت مونده به قولنامه. میاد میگه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 594.54,
   "end": 597.88,
   "text": "به امام سلام علیک کن. می‌شینن میگن که آره ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 597.88,
   "end": 602.7,
   "text": "انحصار وراثه کردیم. ارثی که از بابا می‌رسید به ماها حسابرسی کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 602.7,
   "end": 606.82,
   "text": "اینم سهم شما از زمین‌های بابا بیست هزار تومن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 606.82,
   "end": 609.66,
   "text": "دقیقا بیست هزار تومن میدن و خونه رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 609.66,
   "end": 611.98,
   "text": "قولنامه می‌کنن. این داستانی بود که از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 611.98,
   "end": 613.7,
   "text": "آستاد احمد نقل می‌کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 613.7,
   "end": 621.76,
   "text": "واقعا اگر کسی اعتماد به خدا داشته باشه خدا ولش نمی‌کنه و چنین کسی دائما در حال رجوع به خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 621.76,
   "end": 624.76,
   "text": "خدا این صفت رو انشاالله در وجود ما زنده کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 624.76,
   "end": 626.94,
   "text": "عاقبتمون ختم به خیر بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 626.94,
   "end": 630.7,
   "text": "بعدازظهر همه تو بنگاهید دیگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 630.7,
   "end": 635.44,
   "text": "عاقبتمون انشاالله ختم به خیر بشه به ذکر صلواتی بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 635.44,
   "end": 640.74,
   "text": "اللهم صل على محمد وآل محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
