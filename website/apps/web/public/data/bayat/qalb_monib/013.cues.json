 "chapters": [
  {
   "index": 0,
   "title": "## شک پس از محل",
   "start": 14.72,
   "end": 86.98
  },
  {
   "index": 1,
   "title": "## احمد بن اسحاق و حسین شراب‌خوار در قم",
   "start": 86.98,
   "end": 260.2
  },
  {
   "index": 2,
   "title": "## عنابه پاسخ می‌دهد؛ تأثیر نفس امام",
   "start": 260.2,
   "end": 301.94
  },
  {
   "index": 3,
   "title": "## عنابه سبب هدایت؛ آیات رعد و شوری",
   "start": 301.94,
   "end": 509.46
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 2.26,
   "end": 6.02,
   "text": "بسم الله الرحمن الرحیم و بهی نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 6.02,
   "end": 9.78,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 9.78,
   "end": 14.56,
   "text": "آیاته. سلامٌ علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 14.56,
   "end": 21.64,
   "text": "خب یکی دیگه از شک‌هایی که نباید بهش اعتنا کرد، شک بعد از محله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 21.64,
   "end": 25.12,
   "text": "در نماز محل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 25.12,
   "end": 27.8,
   "text": "یک مثلا ااا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 27.8,
   "end": 30.22,
   "text": "حمد گذشته، شما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 30.22,
   "end": 32.76,
   "text": "می-می‌خوای بری رکوع یا رفتی رکوع،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 32.76,
   "end": 35.94,
   "text": "یه دفعه یادت میاد که حمدو خوندی یا نه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 35.94,
   "end": 38.56,
   "text": "فکر می‌کنی که چی شد؟ خوندم، نخوندم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 38.56,
   "end": 41.9,
   "text": "سو-سوره رو می‌دونی خوندی مثلا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 41.9,
   "end": 47.06,
   "text": "دیگه گذشته چون وقت حمد گذشته سوره رو هم خوندی اینجا گفتن اعتنا نکن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 47.06,
   "end": 50.54,
   "text": "وقتی که گذشت از محلش در هر چیزی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 50.54,
   "end": 53.98,
   "text": "رفتی سجده شک کردی که رکوع انجام دادی اصلا یا نه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 53.98,
   "end": 57.68,
   "text": "یا یکباره اومدی سجده، تو سجده یادت--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 57.68,
   "end": 61.3,
   "text": "این چون محل رو گذروندی دیگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 61.3,
   "end": 64.08,
   "text": "البته شک‌ها اگه یقین کنی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 64.08,
   "end": 69.78,
   "text": "تکلیفش چیز دیگه‌ایه. اینجا میشه-- میگه اعتنا نکن خدا آسون گرفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 69.78,
   "end": 72.1,
   "text": "پس بعد از محل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 72.1,
   "end": 77.78,
   "text": "هر کدوم از اجزاء نماز محلش گذشت شک کردی در رابطه با اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 77.78,
   "end": 83.58,
   "text": "که درست انجام دادی یا نه، اصلا انجام دادی یا نه به شکه اعتنا نکن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 83.58,
   "end": 86.78,
   "text": "این یه حکم کلی هم هست‌ها همه مراجع فرمودن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 86.78,
   "end": 92.56,
   "text": "اما در خصوص قلب منیت در تاریخ نقل می‌کنند که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 92.56,
   "end": 96.84,
   "text": "ااا برای اینکه نکته‌ای رو پیرامون این قضیه و خیلی مهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 96.84,
   "end": 99.5,
   "text": "نکته‌ی قرآنی رو عرض کنم مصداقش رو اول بگم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 99.5,
   "end": 101.94,
   "text": "در تاریخ نقل می‌کنند که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 101.94,
   "end": 106.92,
   "text": "شخصی بود به نام احمد بن اسحاق که وکیل اوقاف قم بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 106.92,
   "end": 110.22,
   "text": "در اون زمان ایشون یکی از ااا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 110.22,
   "end": 112.28,
   "text": "فقها و علمای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 112.28,
   "end": 114.96,
   "text": "خوب و برجسته اون زمان بود که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 114.96,
   "end": 117.36,
   "text": "در همون شهر قم یه آدم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 117.36,
   "end": 125.62,
   "text": "حالا می‌شه گفت مؤمن و دوستار اهل بیتی بود اما گرفتار گناه شرابخواری شده بود به نام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 125.62,
   "end": 129.68,
   "text": "حسین، معروفه در تاریخ به نام حسین در قم زندگی می‌کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 129.68,
   "end": 131.92,
   "text": "این حسین حالا هر کاری که با این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 131.92,
   "end": 135.56,
   "text": "احمد بن اسحاق وکیل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 135.56,
   "end": 142.6,
   "text": "اوقاف قم داشت اومد یه روز به دیدن ایشون کارشو حالا بگه و اینا یا هرچی تاریخ ننوشته چه کاری داشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 142.6,
   "end": 148.02,
   "text": "اومد ایشون رو ببینه. احمد بن اسحاق چون می‌دونست ایشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 148.02,
   "end": 154.46,
   "text": "اگرچه سادات هم بوده حسین از فرزندان و نوادگان امام صادق صلی الله علیه بوده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 154.46,
   "end": 157.02,
   "text": "لکن چون شرابخواری می‌کرد راهش نداد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 157.02,
   "end": 160.12,
   "text": "گفت نه آخه بگید بره من کاری باهاش ندارم و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 160.12,
   "end": 165.36,
   "text": "ایشون خیلی پژمرده شد حسین خیلی غم‌زده شد و محزون برگشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 165.36,
   "end": 171.16,
   "text": "بعد ایشون، احمد بن اسحاق اون سال توفیق شد که بره مکه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 171.16,
   "end": 174.76,
   "text": "رفت حج رو انجام داد به هنگام برگشتن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 174.76,
   "end": 177.0,
   "text": "گفت بریم زیارت امام زمانمون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 177.0,
   "end": 180.98,
   "text": "امام زمان ایشون امام حسن عسکری سلام الله علیه بودن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 180.98,
   "end": 184.5,
   "text": "رفتن سامرا محضر امام عسکری رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 184.5,
   "end": 190.46,
   "text": "درک کنن. وقتی که وارد شدن خواستن اذن ورود بگیرن حضرت راهشون ندادن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 190.46,
   "end": 195.0,
   "text": "گفتن بهش بگید بره. خیلی ایشون ناراحت شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 195.0,
   "end": 204.42,
   "text": "خب اگر ما بریم در خونه اماممون رو یا یکی از وکلای اماممون رو که مراجع و علما و فقها اینا وکیل امامن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 204.42,
   "end": 209.5,
   "text": "، وکیل عام و خاص. این‌ها مثلا رمون، ردمون کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 209.5,
   "end": 213.38,
   "text": "اگر بریم معلومه ما اهل عنابه نبودیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 213.38,
   "end": 217.66,
   "text": "عنابه یعنی هی دائم برگردی دیگه قبلا ترجمه کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 217.66,
   "end": 221.06,
   "text": "پس چیزی هم گیرمون نمیاد اگرچه با دل شکسته بریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 221.06,
   "end": 226.78,
   "text": "اما نه اگر تضرع کنیم، زاری کنیم، دو مرتبه در بزنیم، خواهش کنیم، التجا کنیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 226.78,
   "end": 229.9,
   "text": "اصرار کنیم، التماس کنیم قطعا در باز میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 229.9,
   "end": 232.18,
   "text": "کما اینکه ایشون این کارو کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 232.18,
   "end": 235.0,
   "text": "چون اهل عنابه بود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 235.0,
   "end": 237.84,
   "text": "رم-- برنگشت حالا با همون دل شکسته بره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 237.84,
   "end": 245.04,
   "text": "واستاد ساعت‌ها گریه کرد، تضرع کرد، زاری کرد، هی پیغام داد، خواهش کرد از آقا عذرخواهی کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 245.04,
   "end": 252.36,
   "text": "آقا هرچی بوده ببخشید، حلال کنید، اجازه بدید ما از موالیان شماییم، از شیعیان و دوستان شما هستیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 252.36,
   "end": 256.16,
   "text": "ما رو رد نکنید از راه دور. اینقدر ااا اصرار کرد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 256.16,
   "end": 258.0,
   "text": "تا امام عسکری سلام الله علیه چی شد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 258.0,
   "end": 259.96,
   "text": "جواب داد دیگه راهش داد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 259.96,
   "end": 262.3,
   "text": "ببین عنابه اینجا جواب میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 262.3,
   "end": 268.12,
   "text": "اومد محضر حضرت و به گریه افتاد که يا ابن رسول الله آخه چرا منو شما راه ندادی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 268.12,
   "end": 272.16,
   "text": "چه خطای بزرگی از من سر زده که شما امام من رام ندادی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 272.16,
   "end": 277.54,
   "text": "خیلی از موقع‌هامون این میریم حرم رامون نمیدن یه خطایی از ما سر زده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 277.54,
   "end": 284.3,
   "text": "خلاصه امام فرمودن که حسین از نوادگان جد ما امام صادق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 284.3,
   "end": 287.06,
   "text": "اومد تو رو کار داشت و تو ردش کردی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 287.06,
   "end": 288.96,
   "text": "اولا اهانت کردی بهش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 288.96,
   "end": 297.92,
   "text": "اصلا قبولش نکردی. آدم می‌تونه یکم اگه مشکلی داره بیارش تو دفتر کارش چه میدونم بشینه نصیحتش کنه دوستانه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 297.92,
   "end": 299.92,
   "text": "خیلی برادرانه، پدرانه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 299.92,
   "end": 302.92,
   "text": "نه اینکه اصلا آخه ایشونو بگید بره، این اهانته دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 302.92,
   "end": 306.84,
   "text": "دوما ایشون سادات بودن. بچه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 306.84,
   "end": 308.88,
   "text": "ضراری از حضرت زهرا شما اهانت کردی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 308.88,
   "end": 312.82,
   "text": "خلاصه ایشون فهمید که از کجا خورده افتاد به گریه و توبه و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 312.82,
   "end": 318.72,
   "text": "عنابه و از حضرت خواست که او هم او رو ببخشه و حضرت راضی شد و خلاصه برگشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 318.72,
   "end": 323.66,
   "text": "وقتی که اومد قم خب وکیل بودن ایشون عالم بودن خیلیا اومدن سرش شلوغ شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 323.66,
   "end": 327.36,
   "text": "اون موقع‌ها حج‌های قدیم اومدن دور و برش رو گرفتن و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 327.36,
   "end": 334.78,
   "text": "جالبه که این حسین شرابخوار هم گفت خب آقا از مکه اومده رفته بعدم زیارت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 334.78,
   "end": 338.34,
   "text": "شنیده بود که رفته زیارت امام زمانش هم کرده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 338.34,
   "end": 342.78,
   "text": "این هم به عنابه افتاد. می‌تونست وقتی این ردش کرد بره دیگه هم نیاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 342.78,
   "end": 346.32,
   "text": "اما ببینید این معلومه تو دلش یه نوری هست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 346.32,
   "end": 350.86,
   "text": "که برش می‌گردونه. برمی‌گرده دوباره میاد در خونه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 350.86,
   "end": 359.74,
   "text": "احمد بن اسحاق وارد میشه قاطی مهمونا می‌شینه زیارت قبول میگه و جالبه که تو تاریخ نوشته تا ایشون وارد میشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 359.74,
   "end": 362.82,
   "text": "احمد بن اسحاق خیلی احترام می‌کنه به ایشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 362.82,
   "end": 367.1,
   "text": "بلند میشه کنار خودش جاش میده، تکریمش می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 367.1,
   "end": 370.34,
   "text": "حسین خیلی تعجب می‌کنه. این چه کاریه نه به اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 370.34,
   "end": 373.36,
   "text": "طرد کردنش، نه به این تحقیر گرفتنش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 373.36,
   "end": 378.28,
   "text": "خلاصه بهش میگه چی شد بعد که مهمونا رفتن چرا تو با من اینطوری دوگانه رفتار کردی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 378.28,
   "end": 384.34,
   "text": "جریان رو تعریف میکنه. میگه امامم آقا اینطوری فرمودن و حسین-- ببین تأثیر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 384.34,
   "end": 387.04,
   "text": "نفس امام از فرسنگ‌ها راه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 387.04,
   "end": 390.06,
   "text": "چگونه در قلبش تأثیر میذاره، می‌شکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 390.06,
   "end": 394.98,
   "text": "می‌شکنه و برای همیشه شراب‌خواری رو کنار میذاره که هیچی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 394.98,
   "end": 398.7,
   "text": "دائماً تا آخر عمرش هی معتکف میشد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 398.7,
   "end": 402.44,
   "text": "هی میرفت تو مساجد اعتکاف میکرد و اهل عبادت شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 402.44,
   "end": 406.56,
   "text": "جالبه که انقدر مقام عالی پیدا کرد که نزدیک قبر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 406.56,
   "end": 409.9,
   "text": "حضرت معصومه سلام الله علیها هم دفنش کردن ایشون رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 409.9,
   "end": 413.54,
   "text": "مردم شهر قم میشناسن. خب این عنابه‌ست تو یک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 413.54,
   "end": 416.66,
   "text": "روایت تاریخی دو جا جوابشو دیدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 416.66,
   "end": 419.54,
   "text": "پس عنابه سببش چی میشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 419.54,
   "end": 423.26,
   "text": "هدایت. آیا منشأ یا م-منبع قرآنی داره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 423.26,
   "end": 426.78,
   "text": "بله. دقت کنید آیه بیست و هفت سوره ی--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 426.78,
   "end": 430.8,
   "text": "رعد انتهاش میفرماید خدا که \"ويهدي",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 430.8,
   "end": 433.42,
   "text": "الیه من عاب\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 433.42,
   "end": 436.5,
   "text": "خدا هدایت میکنه به سوی خودش، کیا رو؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 436.5,
   "end": 440.58,
   "text": "\"من عاب\". هر کسی که برگرده به سمت خدا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 440.58,
   "end": 444.44,
   "text": "اهل رجوع باشه، ول نکنه بره، خسته نشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 444.44,
   "end": 448.5,
   "text": "باز هم در آیه سیزده سوره شورا همین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 448.5,
   "end": 451.66,
   "text": "اومده. حالا آیات زیادی هست من تبرکاً عرض می‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 451.66,
   "end": 455.2,
   "text": "انتهای آیه میفرماید \"ويهدي الیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 455.2,
   "end": 459.16,
   "text": "من ینیب\". اون عاب بود این ینیب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 459.16,
   "end": 462.12,
   "text": "هردوی از رو یک ریشه‌اند. خدا هدایت میکنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 462.12,
   "end": 465.86,
   "text": "اون کسی رو که عنابه میکنه یعنی برمیگرده دائم در خونه خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 465.86,
   "end": 471.82,
   "text": "پس ما سعی کنیم اگر میخوایم انشاالله نور هدایت در وجودمون تلألو کنه و در هر گناهی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 471.82,
   "end": 474.86,
   "text": "خدایی نکرده افتادیم بپذیرن ما رو،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 474.86,
   "end": 478.6,
   "text": "برگردیم و متوجه اشتباهی بشیم باید اهل عنابه باشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 478.6,
   "end": 484.68,
   "text": "یاد بگیریم که دائماً به سوی خدا رجوع کنیم بعد از هر گناهی حتی اگر از ما سر زد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 484.68,
   "end": 488.06,
   "text": "به خدا رجوع کنیم. که البته این پایه اول عنابه‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 488.06,
   "end": 496.54,
   "text": "بعداً و قبلاً البته عرض کردیم که عنابه درجات بالایی داره تا جایی که همه انبیا تو قرآن اهل عنابه یاد شدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 496.54,
   "end": 498.98,
   "text": "انشاالله که اهل عنابه باشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 498.98,
   "end": 503.88,
   "text": "عاقبت ما ختم به خیر بشه به ذکر صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 503.88,
   "end": 509.46,
   "text": "اللهم صل على محمد و آل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}