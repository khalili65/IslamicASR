 },
 "chapters": [
  {
   "index": 0,
   "title": "## شک در نمازهای مستحب",
   "start": 12.82,
   "end": 372.36
  },
  {
   "index": 1,
   "title": "## داستان نانوا و انگشتر پادشاه",
   "start": 372.36,
   "end": 588.54
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.24,
   "end": 4.94,
   "text": "برجا. بسم الله الرحمن الرحیم و بهین استعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 4.94,
   "end": 8.64,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 8.64,
   "end": 12.28,
   "text": "آیاته سلامٌ علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 12.28,
   "end": 21.64,
   "text": "یکی دیگه از جاهایی که در شک نماز، در شک در نماز نباید بشه اعتنا کرد شک در نمازهای مستحبیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 21.64,
   "end": 31.58,
   "text": "یعنی هر وقت هر نماز مستحبی ما خوندیم در نماز در هر مسئله‌ای شک کردیم میگیم آقا مستحبه دیگه خیلی سختش نگیر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 31.58,
   "end": 34.32,
   "text": "به هر حال دین اسلام هم دین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 34.32,
   "end": 38.9,
   "text": "آسانیه. دین یسره، دین عسر نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 38.9,
   "end": 43.0,
   "text": "خدا سخت نگرفته، خدا تو گناه سخت می‌گیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 43.0,
   "end": 45.04,
   "text": "لذا اعتنا نکن و رد شو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 45.04,
   "end": 48.44,
   "text": "موضوع ما که قلب منیب بود رسیدیم به بحث توکل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 48.44,
   "end": 52.56,
   "text": "اشاره می‌کنم به بخشی از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 52.56,
   "end": 60.76,
   "text": "خطبه صد و شصت و یک نهج البلاغه که امیرالمؤمنین علیه الصلاة والسلام توکل و عنابه رو اینجا کنار هم گذاشتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 60.76,
   "end": 67.02,
   "text": "فرمودن و اتوکل على الله توکل العنابه الیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 67.02,
   "end": 71.28,
   "text": "به گونه‌ای به خدا اعتماد داشته باش،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 71.28,
   "end": 74.94,
   "text": "اعتمادی که تو رو به عنابه بکشونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 74.94,
   "end": 77.5,
   "text": "اعتمادی که شخص منیب به خدا داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 77.5,
   "end": 80.7,
   "text": "این نشون میده که اصلا نمیشه کسی منیب باشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 80.7,
   "end": 83.8,
   "text": "و دائما به خدا رجوع کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 83.8,
   "end": 86.62,
   "text": "به جز اینکه اعتماد به خدا داشته باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 86.62,
   "end": 89.98,
   "text": "این رو ما عرض کردیم جلسه پیش که پیش نیاز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 89.98,
   "end": 93.32,
   "text": "رسیدن به قلب منیب توکل بر خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 93.32,
   "end": 98.64,
   "text": "حالا سوالی که دیروز عرض کردیم امروز جواب بدیم اینکه پیش نیاز توکل چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 98.64,
   "end": 101.72,
   "text": "چی سبب اعتماد به خدا میشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 101.72,
   "end": 104.96,
   "text": "به سادگی تمام در آیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 104.96,
   "end": 107.46,
   "text": "دو و سه سوره طلاق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 107.46,
   "end": 110.6,
   "text": "این وارد شده. جالبه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 110.6,
   "end": 115.22,
   "text": "اه اصلا اینکه چرا ما تقوا پیشه می‌کنیم در این آیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 115.22,
   "end": 122.16,
   "text": "سببش و علت اصلی اینکه ما تقوا پیشه می‌کنیم یعنی ام-امر خدا رو انجام میدیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 122.16,
   "end": 126.44,
   "text": "چه در نهیش، چه در ترکش، چه در فعلش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 126.44,
   "end": 129.7,
   "text": "توکل بیان شده. بعد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 129.7,
   "end": 132.6,
   "text": "اینکه چرا به خدا توکل می‌کنیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 132.6,
   "end": 137.18,
   "text": "این بیان شده که خدا نافذ امرش در دنیا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 137.18,
   "end": 139.88,
   "text": "آیه رو می‌دونید. این آیه ایست که اگر کسی براش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 139.88,
   "end": 146.38,
   "text": "مداومت کنه همون کیمیایی‌ست که مرحوم نخودکی اصفهانی به دست امام رحمت الله علیه ما داده بودند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 146.38,
   "end": 153.3,
   "text": "کسی مداومت کنه خدا از ضیغ معاش نجاتش میده، براش گشایش قرار میده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 153.3,
   "end": 156.84,
   "text": "و تمام بزرگان این رو تصریح کردن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 156.84,
   "end": 162.52,
   "text": "که \"و من یتق الله يجعل له مخرجا و يرزقه من حيث لا يحتسب\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 162.52,
   "end": 166.16,
   "text": "هر کسی که تقوا پیشه کنه، خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 166.16,
   "end": 171.5,
   "text": "از بن‌بست‌ها نجاتش میده و از اونجایی که گمان نمی‌کنه براش روزی می‌رسونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 171.5,
   "end": 175.46,
   "text": "چرا؟ جان؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 175.46,
   "end": 178.78,
   "text": ". خب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 178.78,
   "end": 183.04,
   "text": "مثل همین عمل کردن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 183.04,
   "end": 188.38,
   "text": "نه، نه، سوال خوبیه. ایشون میگن عمل کردن به این ذکر مهمه یا خود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 188.38,
   "end": 191.4,
   "text": "صرفا اینکه انسان ذکر رو بیان کنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 191.4,
   "end": 202.48,
   "text": "قطعا و اصلا تمام بزرگان سفارش کردن که مهم ذکر قلبی‌ست و ذکر لسانی مقدمه ورود به ذکر قلبی‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 202.48,
   "end": 207.4,
   "text": "یعنی باید انسان ذکر لسانی بگه، تمرین کنه، مداومت کنه تا به ذکر قلبی برسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 207.4,
   "end": 214.68,
   "text": "ذکر قلبی هم یعنی اینکه اون چیزی که تو آیه گفته رو شما بهش توجه کنی و به عمل بکشونی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 214.68,
   "end": 219.36,
   "text": "یعنی در ح-حقیقت در وجودت برای کسی که آدم بی‌تقوایی باشه هی هم اینو بگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 219.36,
   "end": 224.32,
   "text": "اصطلاحا صریح آیه قرآن چون آیات رو به قول عالم تبری باید کنار هم دید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 224.32,
   "end": 228.04,
   "text": "توی یه آیه دیگه می‌فرمود که رحمتي وسعت کل شیء.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 228.04,
   "end": 229.84,
   "text": "همه جا رو رحمت من گرفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 229.84,
   "end": 236.66,
   "text": "که قبلا روایتش رو گفتم شیطان به اساس این آیه قیامت میاد میگه خدا منم ببخش تو که رحمتت همه جا رو گرفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 236.66,
   "end": 242.78,
   "text": "ملائکه می‌زنن تو دهنش میگن بقیه آیه رو هم بخون \"فسأكتبها للذين اتقون\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 242.78,
   "end": 246.64,
   "text": "این رحمت من نوشته شده برای اونایی که اهل تقوااند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 246.64,
   "end": 252.92,
   "text": "پس نمیشه آدم بی‌تقوایی با- بکنه و بعدم توقع داشته باشه که آره من هی این ذکرو هر روز بگم و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 252.92,
   "end": 255.34,
   "text": "تو مثلا ااا تاثیر کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 255.34,
   "end": 258.14,
   "text": "نه، زمینه و بسترش اینه که به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 258.14,
   "end": 263.06,
   "text": "عمل بیاد. به هر حال اینجا اینکه ما متوکل-- ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 263.06,
   "end": 266.26,
   "text": "تقوا پیشه می‌کنیم رو بلافاصله بعدش آورده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 266.26,
   "end": 270.46,
   "text": "چرا ما ام-امورات خدا، دستورات خدا رو اجرا می‌کنیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 270.46,
   "end": 273.82,
   "text": "چون \"و من يتوكل على الله فهو حسبه\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 273.82,
   "end": 276.46,
   "text": "چون اگه به خدا اعتماد کنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 276.46,
   "end": 280.4,
   "text": "در حقیقت اعتماد به خدا سبب تقوا میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 280.4,
   "end": 286.52,
   "text": "درست شد؟ چون به خدا اعتماد می‌کنی که هرچی میگه به صلاح توه تو هم حرفشو گوش میدی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 286.52,
   "end": 289.22,
   "text": "درست شد؟ حالا چرا اعتماد می‌کنی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 289.22,
   "end": 293.38,
   "text": "هم از جهت تقوا ورود کردیم به این بحث، هم از جهت منیب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 293.38,
   "end": 297.18,
   "text": "چرا اعتماد می‌کنیم؟ آیه ب-- دوباره ادامه آیه همین جواب رو داده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 297.18,
   "end": 299.64,
   "text": "\"ان الله\" قطعا خدا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 299.64,
   "end": 302.46,
   "text": "خدای من \"بالغ امره\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 302.46,
   "end": 304.08,
   "text": "خدا نافذ امرش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 304.08,
   "end": 306.98,
   "text": "تو این عالم هرچی خدا بگه همونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 306.98,
   "end": 310.3,
   "text": "خالقیت دست خداست لذا مالکیت هم دست خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 310.3,
   "end": 313.78,
   "text": "همه چی، همه آدما، اه-اهل و ایال خداند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 313.78,
   "end": 319.18,
   "text": "خ-- نافذ امر خدا. چون نا-- امر خدا نافذه لذا بهش اعتماد باید کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 319.18,
   "end": 321.5,
   "text": "چون همه جا امر خدا نافذه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 321.5,
   "end": 327.24,
   "text": "\"قد جعل الله لكل شيء قدرا\" برای هر چیزی یک مقدراتی خدا قرار داده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 327.24,
   "end": 330.34,
   "text": "اگه قرار باشه به تو به خیری چیزی برسه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 330.34,
   "end": 335.72,
   "text": "خدا قرار داده و می‌رسه. آدمش رو، یه کسی رو مأمور می‌کنه وسیله‌ش رو در برابر تو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 335.72,
   "end": 337.54,
   "text": "تو نباید سر خم کنی جلوی دیگرون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 337.54,
   "end": 341.3,
   "text": "با عزت زندگی کن و ببین خدا چجوری دیگران رو مأم--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 341.3,
   "end": 344.72,
   "text": "برای تو خادم می‌کند، خدوم تو می‌کند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 344.72,
   "end": 347.26,
   "text": "حالا داستان‌های زیادی هم ذیل این هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 347.26,
   "end": 349.44,
   "text": "به‌عنوان نمونه سریع عرض کنم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 349.44,
   "end": 353.0,
   "text": "مطالعه می‌کردم در عصر قدیم میگن که--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 353.0,
   "end": 357.06,
   "text": "و دقت کنید این که امر خدا نافذه یعنی چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 357.06,
   "end": 360.36,
   "text": "یعنی هرچی خدا بخواد مقدر کنه همونه ق-",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 360.36,
   "end": 361.94,
   "text": "باشه خیری به کسی برسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 361.94,
   "end": 364.88,
   "text": "قرار کس- قرار باشه کسی عزیز باشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 364.88,
   "end": 368.12,
   "text": "رزقی بهش برسه. چه م-- اینا رو خدا خودش مقدر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 368.12,
   "end": 371.62,
   "text": "اگر همه عالم جمشن نمی‌تونند مانع بشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 371.62,
   "end": 374.04,
   "text": "نقل می‌کنن یه پیرمرد و پیرزنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 374.04,
   "end": 380.28,
   "text": "یه جا زندگی می‌کردن خیلی با خدا بودند به گونه‌ای که حالا یه ز-- در عصر پادشاه مغروری هم بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 380.28,
   "end": 383.38,
   "text": "که حالا سریع عرض می‌کنم میرم توضیحاتش بماند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 383.38,
   "end": 385.8,
   "text": "فقط اصل مطلب و لب م-- لب مطلب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 385.8,
   "end": 391.08,
   "text": "که حالا انقدر این پیرمرد با خدا بود خب کسی که با خداست دلش تو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 391.08,
   "end": 394.84,
   "text": "مردم به ایشون روجه می‌کنن و محبتش به دل‌ها می‌افته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 394.84,
   "end": 397.0,
   "text": "خیلی اهل وثوق بود همه دوسش داشتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 397.0,
   "end": 402.26,
   "text": "پادشاه مغرور و خودخواه دید اینو بیشتر از او دوست دارن بیشتر به او روجه می‌کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 402.26,
   "end": 406.02,
   "text": "مردم میرن بهش التماس دعا میگن و فلان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 406.02,
   "end": 409.84,
   "text": "خلاصه این تکبر و غرورش باعث شد که حسودی هم بکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 409.84,
   "end": 412.86,
   "text": "گفت نه من باید یه کاری با این بکنم از چشم مردم بیفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 412.86,
   "end": 416.08,
   "text": "با وزیرش مشورت کرد. نونوایی داشت این پیرمرد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 416.08,
   "end": 421.22,
   "text": "با خدا که بعد از نونوایی هم میگن می‌رفت ماهیگیری می‌کرد و میومد با زنش روزگار خوشی داشتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 421.22,
   "end": 425.48,
   "text": "این پادشاهی گفت با وزیرش لباس مبدل پوشیدن رفتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 425.48,
   "end": 428.38,
   "text": "نون ازش گرفتن گفتن ما مسافریم و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 428.38,
   "end": 430.58,
   "text": "پول همرامون نیست. اشک--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 430.58,
   "end": 435.48,
   "text": "بعد گفت که اشکال نداره برید دفعه بعد که اومدید پیرمرد نونوای گفت دفعه بعد که اومدید پولو بدید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 435.48,
   "end": 439.28,
   "text": "گفت نه نمیشه بالاخره اینطوری که نمیشه معلومه باز بیاین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 439.28,
   "end": 444.08,
   "text": "پادشاه انگشتری که نشان پادشاهی بود درآورد بهش داد گفت پیشت باشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 444.08,
   "end": 448.38,
   "text": "دفعه بعد اومدیم پول میدیم اینو پس بگیریم ولی خیلی قیمتیه مراقبش باش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 448.38,
   "end": 451.18,
   "text": "قبول نکرد گفت نه من امانت نمی‌تونم قبول کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 451.18,
   "end": 455.26,
   "text": "اونم به زور گفت باید بگی و الا نمیشه که بالاخره ما نونت رو برداشتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 455.26,
   "end": 459.46,
   "text": "اونم قبول کرد. رفت خونه و خانمش دعواش کرد که چرا گرفتی چیزو این جرو-",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 459.46,
   "end": 462.46,
   "text": "گرون قیمتیو ما چجوری پس بدیم اگه گم بشه و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 462.46,
   "end": 469.0,
   "text": "همون شب پادشاه و یه سری مامورا ریختن به هم و اینا رفتن تو خونه و این انگشتر رو دزدیدن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 469.0,
   "end": 471.42,
   "text": "که این مثلاً آبروش بره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 471.42,
   "end": 474.6,
   "text": "که دیگه مثلاً از اون وجاهت بیفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 474.6,
   "end": 482.48,
   "text": "آقا ایشون، ایشون و پادشاه فردا وزیر اومد بهش گفتش که آره پادشاه بوده اومده از تو خرید کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 482.48,
   "end": 485.06,
   "text": "اینم پولش. حالا نشان پادشاهی رو بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 485.06,
   "end": 489.92,
   "text": "اینم گم کرده بود دیگه. گفت پادشاه که کشون کشون بردش پیش پادشاه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 489.92,
   "end": 491.88,
   "text": "پادشاه گفت از این یه هفته وقت میدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 491.88,
   "end": 495.42,
   "text": "اگه آوردی آوردی نیاوردی گردنت رو از ملأ عام میزنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 495.42,
   "end": 502.3,
   "text": "این رفت خونه ناراحت و خانمش گفت بریم یه انگشتر ساز می‌شناسم بدلشو بسازه گفت آقا من که کاری که نکردم چرا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 502.3,
   "end": 505.2,
   "text": "خودمو متهم کنم؟ توکل بر خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 505.2,
   "end": 508.2,
   "text": "به خدائه اعتماد می‌کنیم که هرچی او بخواد همونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 508.2,
   "end": 510.78,
   "text": "ما که گناهی نکردیم. چرا بترسیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 510.78,
   "end": 513.26,
   "text": "بذار هرچی خدا می‌خواد همون بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 513.26,
   "end": 518.66,
   "text": "ببین توکلی که کردن و اعتماد کردن به نفوذ خدا در این عالم این مهمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 518.66,
   "end": 521.16,
   "text": "بال ان الله بالغ امره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 521.16,
   "end": 524.0,
   "text": "چه اتفاقی می‌افته؟ پادشاه میره ماهیگیری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 524.0,
   "end": 529.46,
   "text": "میفته تو آب انگشترش از دستش در میاد میفته یه ماهی اینو میخوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 529.46,
   "end": 532.84,
   "text": "بعد می‌برنش هرچی هم می‌گردن انگشتر پیدا نمیشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 532.84,
   "end": 537.6,
   "text": "عصر روز آخر که این دیگه می‌خواسته دیگه گمان می‌کرده فردا اعدام میشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 537.6,
   "end": 540.04,
   "text": "روز ششم میاد میره ما-- بعد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 540.04,
   "end": 546.7,
   "text": "نونوایش ماهی رو میگیره از غذا همون ماهی که انگشتر رو خورده می‌برن خونه تمیز می‌کنن، میبینن انگشتر پیدا شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 546.7,
   "end": 553.76,
   "text": "اونجا میگه دیدی خانم گفتم اگر کسی نفوذ خدا در این عالم رو اعتقاد داشته باشه خدا وا نمی‌گذاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 553.76,
   "end": 559.34,
   "text": "او اگر خدا خواسته وجیه باشه و با عزت فلله العزة ولرسوله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 559.34,
   "end": 563.64,
   "text": "وللمؤمنین فلله العزة جمیعا همه چی دست خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 563.64,
   "end": 567.0,
   "text": "این باور سبب میشه که انسان چیکار کنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 567.0,
   "end": 570.8,
   "text": "توکل به خدا کنه. توکل سبب میشه که انسان چیکار کنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 570.8,
   "end": 573.86,
   "text": "دائماً به سمت خدا بره و قلب منیب پیدا کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 573.86,
   "end": 579.36,
   "text": "انشاالله که عاقبتمون ختم به خیر بشه به ذکر صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 579.36,
   "end": 582.88,
   "text": "اللهم صل على",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 582.88,
   "end": 585.5,
   "text": "محمد و آل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 585.5,
   "end": 588.54,
   "text": "محمد و عجل فرجهم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}