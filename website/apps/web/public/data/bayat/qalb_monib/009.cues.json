 "chapters": [
  {
   "index": 0,
   "title": "## قلب منیب و حقیقت وجودی صدیقهٔ طاهره",
   "start": 27.94,
   "end": 60.5
  },
  {
   "index": 1,
   "title": "## شش حالت روح و قلب در روایت امیرالمؤمنین",
   "start": 60.5,
   "end": 199.92
  },
  {
   "index": 2,
   "title": "## جان متوفّی همان قلب؛ احزاب و هویت وجودی",
   "start": 199.92,
   "end": 320.8
  },
  {
   "index": 3,
   "title": "## انفال؛ رعب در قلوب کفار؛ ترس برادر مرگ",
   "start": 320.8,
   "end": 395.5
  },
  {
   "index": 4,
   "title": "## قاف/۳۷؛ ذکر برای صاحب قلب بیدار",
   "start": 395.5,
   "end": 507.46
  },
  {
   "index": 5,
   "title": "## انابه؛ نقطهٔ پرواز پس از توبه و استغفار دائم",
   "start": 507.46,
   "end": 561.48
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.46,
   "end": 3.12,
   "text": "آقا امام زمان صلوات بلند کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 3.12,
   "end": 6.48,
   "text": "اللهم صل علی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 6.48,
   "end": 9.24,
   "text": "محمد و آل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 9.24,
   "end": 11.92,
   "text": "محمد و عجل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 11.92,
   "end": 19.48,
   "text": "فرجهم بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 19.48,
   "end": 24.38,
   "text": "السلام علیک یا داعی الله و ربانیة آیات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 24.38,
   "end": 27.94,
   "text": "سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 27.94,
   "end": 33.88,
   "text": "جهت اینکه بحث ما بحث قلب منیب بود و خیلی هم مهم بود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 33.88,
   "end": 41.34,
   "text": "و یک با یک لطائف الهی ال این بحث به نوعی مرتبط میشه با حقیقت وجودی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 41.34,
   "end": 47.68,
   "text": "حضرت صدیقه طاهره صلوات الله علیها و آل ملکوتی که تحت تصرف ایشون هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 47.68,
   "end": 50.4,
   "text": "پس این بحث رو تو این مختصر ادامه میدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 50.4,
   "end": 54.2,
   "text": "هر روز هفت هشت ده دقیقه ما حرفی زدیم حالا شاید امروز یه ربع شد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 54.2,
   "end": 60.5,
   "text": "به برکت مجلس عزای زهرا و انشاالله عزیزان روضه بخونن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 60.5,
   "end": 64.16,
   "text": "اولاً به جهت اهمیت بحث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 64.16,
   "end": 69.94,
   "text": "باز هم مقدمتاً عرض می‌کنم که خب ما بحث قلب در قرآن رو داشتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 69.94,
   "end": 75.32,
   "text": "یک روایتی رو عرض کنم خدمتتون که در کتاب قلب سلیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 75.32,
   "end": 78.78,
   "text": "شهید دستغیب این روایت به نقل از کتاب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 78.78,
   "end": 86.74,
   "text": "بهار مرحوم مجلسی اعلا الله مقامه الشریف جلد چهارده صفحه سیصد و نود و هشت وارد شده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 86.74,
   "end": 91.16,
   "text": "که امیرالمؤمنین علیه الصلاة والسلام روح والقلب رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 91.16,
   "end": 94.32,
   "text": "مثل جسم دارای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 94.32,
   "end": 96.48,
   "text": "شش حالت برشمردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 96.48,
   "end": 101.38,
   "text": "فرمودن همونطور که جسم شش تا حالت داره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 101.38,
   "end": 105.36,
   "text": "قلب و روح هم شش تا حالت داره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 105.36,
   "end": 108.84,
   "text": "که این حالت‌ها باید شناسایی بشن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 108.84,
   "end": 112.74,
   "text": "والا انسان متحیر میمونه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 112.74,
   "end": 116.7,
   "text": "و در مسیر سیر و سلوکش باز میمونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 116.7,
   "end": 120.46,
   "text": "حضرت میفرمایند یکی حیات است و مرگ که این‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 120.46,
   "end": 127.44,
   "text": "متقابل هم‌ند. یعنی نمیشه کسی بمیره اما حیات داشته باشه که حیات داشته باشه اما به مرگ داشته باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 127.44,
   "end": 132.5,
   "text": "نمیشه یکی از این‌هاست. یا مرگ است یا حیات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 132.5,
   "end": 134.42,
   "text": "دیگری بیداری و خواب است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 134.42,
   "end": 136.24,
   "text": "قلبی که بیدار است خواب نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 136.24,
   "end": 139.06,
   "text": "قلبی که خواب است بیدار نیست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 139.06,
   "end": 143.12,
   "text": "و دیگری هم سلامت و مریضی‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 143.12,
   "end": 146.42,
   "text": "یا قلب سالم است یا مریض است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 146.42,
   "end": 151.36,
   "text": "در یک تقسیم‌بندی کلی پیرامون قلب در قرآن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 151.36,
   "end": 156.42,
   "text": "که حالا بعدها انشاالله به این بخش هم خواهیم رسید که قلب سلیم و قلب مریض",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 156.42,
   "end": 160.24,
   "text": "اونجا بحث می‌کنیم انشاالله به شرط توفیق و حیات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 160.24,
   "end": 162.5,
   "text": "که دل به،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 162.5,
   "end": 165.2,
   "text": "به صورت کلی به دو قسم تقسیم میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 165.2,
   "end": 167.88,
   "text": "یا قلب سلیم است و سالم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 167.88,
   "end": 173.34,
   "text": "یا مریض است و مرضی عارض شده بر او.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 173.34,
   "end": 180.54,
   "text": "گرفتار شده این قلب رو باید نجات داد که اگه نجاتش ندیم اول به خواب میره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 180.54,
   "end": 185.08,
   "text": "بعد میمیره. حالا این مراتب رو بعداً باید بگیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 185.08,
   "end": 189.22,
   "text": "پس قلب خیلی مهمه. مستقیماً به حیات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 189.22,
   "end": 190.9,
   "text": "معنوی ما بستگی داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 190.9,
   "end": 193.26,
   "text": "اگر قلب بمیره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 193.26,
   "end": 197.4,
   "text": "ما می-- مثل یک مرده متحرکی میشیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 197.4,
   "end": 199.92,
   "text": "که گمان می‌کنیم زنده هستیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 199.92,
   "end": 205.86,
   "text": "در بعضی از آیات قرآن مثل آیه ده سوره احزاب حوزه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 205.86,
   "end": 208.9,
   "text": "عرض کنم خدمتتون روح و جان رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 208.9,
   "end": 211.82,
   "text": "به همون قلب منس--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 211.82,
   "end": 215.32,
   "text": "منتسب میکنه. یعنی میگه اون جانی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 215.32,
   "end": 219.46,
   "text": "الله يتوفى الأنفس حين موتها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 219.46,
   "end": 222.4,
   "text": "اون جانی که خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 222.4,
   "end": 227.52,
   "text": "تماماً و کاملاً وقت مرگ میگیره از ما همون قلب ماست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 227.52,
   "end": 229.32,
   "text": "که قبلاً اینو مختصر عرض کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 229.32,
   "end": 232.48,
   "text": "لذا ماهیت وجودی ما قلب ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 232.48,
   "end": 234.72,
   "text": "به شما میگن تو زندگی چی داری؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 234.72,
   "end": 239.18,
   "text": "چی داری؟ رو کن ببینم. از جهت مالی دنیایی چی داری؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 239.18,
   "end": 241.1,
   "text": "اون اصل موضوع رو رو میکنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 241.1,
   "end": 244.12,
   "text": "مثلاً یه خونه قیمتی داری. نمی‌دونم هرچی هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 244.12,
   "end": 247.7,
   "text": "حالا اگر به ما بگن از جهت ماهیت وجودیت چی داری؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 247.7,
   "end": 249.66,
   "text": "ما باید بگیم قلب رو داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 249.66,
   "end": 253.04,
   "text": "اون چیزیست که وقت مرگ از ما میگیرن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 253.04,
   "end": 257.36,
   "text": "یعنی احزی که خدا میکنه هنگام مرگ قلب ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 257.36,
   "end": 259.94,
   "text": "ماهیت و هستی ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 259.94,
   "end": 263.42,
   "text": "سرمایه ما برای قیامت قلب ماست که گرفته میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 263.42,
   "end": 268.56,
   "text": "حالا هر بلایی که سر این قلب آوردیم و هرچی با این قلب کردیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 268.56,
   "end": 271.64,
   "text": "همون میمونه برای همیشه ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 271.64,
   "end": 278.6,
   "text": "جالبه که اینجا به تایید این نکته‌ای که عرض کردم همین آیه ده احزاب میفرماید و اذا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 278.6,
   "end": 282.34,
   "text": "زغت الابصار این همه هم میفهمن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 282.34,
   "end": 288.1,
   "text": "و اذا زغت الابصار وقتی که چشم‌ها از وحشت فرو میمونه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 288.1,
   "end": 291.54,
   "text": "و بلغت القلوب الحناجر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 291.54,
   "end": 293.86,
   "text": "جان به لب میرسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 293.86,
   "end": 301.1,
   "text": "میگه بلغت القلوب الحناجر وقتی که قلب به حنجر میرسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 301.1,
   "end": 304.96,
   "text": "ببینید اینجا جان رو با قلب خدا بیان کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 304.96,
   "end": 308.64,
   "text": "پس اون جانی که از ما میگیرن قلب ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 308.64,
   "end": 312.38,
   "text": "این خودش یک نهیب بزرگیه تو این آیه اینچنین اومده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 312.38,
   "end": 316.68,
   "text": "تج-- توجه به این ظرائف آیات خیلی مهمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 316.68,
   "end": 319.32,
   "text": "پس ما باید بدونیم به سر این قلب چی آوردیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 319.32,
   "end": 323.5,
   "text": "باهاش چه کردیم؟ در آیه دوازده انفال نیز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 323.5,
   "end": 325.78,
   "text": "مرکز عواطف رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 325.78,
   "end": 329.54,
   "text": "مرکز تدبر و تعقل رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 329.54,
   "end": 332.68,
   "text": "خدای منان در این آیه به قلب نسبت میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 332.68,
   "end": 338.44,
   "text": "سألقی في قلوب الذين كفروا الرعب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 338.44,
   "end": 346.22,
   "text": "میفرماید که به زودی تو دل‌های سألقی به زودی میندازیم في قلوب الذين كفروا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 346.22,
   "end": 349.82,
   "text": "تو دل، تو قلب‌های اونایی که کفر ورزیدن چی رو؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 349.82,
   "end": 352.6,
   "text": "الرعب ترس رو میندازیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 352.6,
   "end": 355.06,
   "text": "ترس در محیط",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 355.06,
   "end": 357.0,
   "text": "عاطفه انسان ایجاد میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 357.0,
   "end": 362.66,
   "text": "یک نوع انگیزه‌ایست که در عاطفه انسان در حوزه عاطفه انسان ایجاد میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 362.66,
   "end": 364.86,
   "text": "این رو خدا منتسب کرده به قلب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 364.86,
   "end": 368.78,
   "text": "یعنی حتی ترس هم که در کفار ایجاد میشه مال قلبشونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 368.78,
   "end": 371.94,
   "text": "حالا ترس کجاست؟ جایی که عصیان باشد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 371.94,
   "end": 376.24,
   "text": "امیرالمؤمنین سلام الله علیه فرمود: \"هر کجا که عصیان باشد ترس هم می‌آید.\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 376.24,
   "end": 380.68,
   "text": "لذا ترس برابد-- برادر مرگ است زیرا مرگ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 380.68,
   "end": 383.36,
   "text": "چیزیست که، ااا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 383.36,
   "end": 388.0,
   "text": "گناه باعثش میشه. گناه انسان رو می‌میراند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 388.0,
   "end": 392.44,
   "text": "لذا کسی که گناهکاره است ترسوست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 392.44,
   "end": 395.5,
   "text": "پس ترس برادر مرگ است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 395.5,
   "end": 400.76,
   "text": "در جای دیگه از قرآن حالا من فرصت ندارم اینا رو خیلی تبیین کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 400.76,
   "end": 405.72,
   "text": "\"آن کس از اهل بشارت که اشارت داند.\" سوره قاف، آیه سی و هفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 405.72,
   "end": 410.04,
   "text": "اینجا هم حوزه درک و عقل رو به قلب نسبت داده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 410.04,
   "end": 413.72,
   "text": "رفقا اگر ما چیزی نفهمیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 413.72,
   "end": 418.32,
   "text": "خیلی بیچاره‌ایم ها. اگر درکمون ضعیف باشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 418.32,
   "end": 423.8,
   "text": "درک نداشته باشیم، نفهمیم هرکی هرچی رو ما میگه نفهمیم خیلی خطرناکه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 423.8,
   "end": 430.88,
   "text": "این مربوط به قلبه. اگر کسی چیزی نمی‌فهمه چون قلبش یا خوابه یا مرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 430.88,
   "end": 438.32,
   "text": "یکی از این دو تا. حالا اینجا در این آیه خدا می‌فرماید إن في هذا لذكرى لمن كان له قلب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 438.32,
   "end": 443.12,
   "text": "در این إن في هذا در اون چیزی که ما گفتیم لذكرى",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 443.12,
   "end": 448.18,
   "text": "یه یادآوری‌ست. لمن كان این یادآوری برای کیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 448.18,
   "end": 451.06,
   "text": "لمن كان له قلب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 451.06,
   "end": 456.02,
   "text": "برای کسی که قلبش باقیست، مونده، سالمه، بیداره، نمرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 456.02,
   "end": 460.48,
   "text": "اگر کسی قلبش خواب بود، کسی که خواب باشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 460.48,
   "end": 462.04,
   "text": "تو چجوری می‌خوای بیدارش کنی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 462.04,
   "end": 464.32,
   "text": "مخصوصا اینایی که خوابشون سنگینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 464.32,
   "end": 470.46,
   "text": "وقتی هم که بیدار میشن دهشت‌زدن، متحیرن، نمی‌فهمن کجان، چیکار باید بکنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 470.46,
   "end": 473.84,
   "text": "اگه مرده باشه که هیچی دیگه تو هرچی بزنیش بیدار نمیشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 473.84,
   "end": 481.36,
   "text": "دلیل اینکه بعضی از حقایق در مخ ما نمیره، در مغز ما فرو نمیره چون قلبمون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 481.36,
   "end": 484.2,
   "text": "متاسفانه ضعیف شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 484.2,
   "end": 493.18,
   "text": "قبلا عرض کردیم حتی حوزه تدبر و تفکر و اندیشه و حواجس افکار و عقل هم از ابزار قلبن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 493.18,
   "end": 498.2,
   "text": "اگر قلب مریض شد دیگه انسان بر اساس همین آیه هم فهمیدیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 498.2,
   "end": 502.86,
   "text": "نمی‌تونه چیزی بفهمه. ما متاسفانه از این قلب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 502.86,
   "end": 507.46,
   "text": "غافل شدیم لذا گرفتاریای بسیاری برای ما پیش اومد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 507.46,
   "end": 514.5,
   "text": "حالا این قلب ما گفتیم بخش‌هایی داره، یکی از مهم‌ترین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 514.5,
   "end": 518.04,
   "text": "شقوق و اشکال قلب که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 518.04,
   "end": 522.5,
   "text": "میشه گفت نقطه پرواز به سمت عالم بالا است،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 522.5,
   "end": 525.38,
   "text": "وقتی‌ست که قلب در حالت انابه قرار می‌گیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 525.38,
   "end": 530.28,
   "text": "ما تازه سر خط شدیم به بحث هر روزمون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 530.28,
   "end": 532.84,
   "text": "وقتی‌ست که قلب در حالت انابه قرار می‌گیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 532.84,
   "end": 538.94,
   "text": "توضیح هم دادیم انابه فرقش با توبه و استغفار اینه که توبه ابتدا پشیمانی‌ست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 538.94,
   "end": 541.88,
   "text": "بعد با استغفار رشد می‌کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 541.88,
   "end": 544.32,
   "text": "به درجات بالاتر می‌رسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 544.32,
   "end": 548.3,
   "text": "لذا غیر مستقیم ما سه تا قلب رو اصلا بحث کردیم؛",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 548.3,
   "end": 550.66,
   "text": "قلب تائب، قلب مستغفر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 550.66,
   "end": 554.9,
   "text": "و قلب مونی که حالا این تائب و مستغفر رو بعدا توضیح میدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 554.9,
   "end": 561.48,
   "text": "بعد تازه بعد از استغفار وقتی استغفار شدت گرفت، کثرت پیدا کرد و دائم شد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}