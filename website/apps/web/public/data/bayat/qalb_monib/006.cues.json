   "start": 117.0,
   "end": 198.96
  },
  {
   "index": 2,
   "title": "## مناجات منیبین: توبه ندامت است، انابه ترک معصیت",
   "start": 198.96,
   "end": 296.72
  },
  {
   "index": 3,
   "title": "## وجوه فرق: ظاهر و باطن، مقدمه و نتیجه، خوف و شوق",
   "start": 296.72,
   "end": 316.92
  },
  {
   "index": 4,
   "title": "## بازگشت به طاعت یا به خدا؛ استقرار یا سیر",
   "start": 316.92,
   "end": 551.22
  },
  {
   "index": 5,
   "title": "## فرمول ترتیب و نشانهٔ لقاء قلب",
   "start": 551.22,
   "end": 717.08
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 2.6,
   "end": 6.66,
   "text": "بسم الله الرحمن الرحیم و به این استعوذ.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 6.66,
   "end": 12.14,
   "text": "السلام علیک ای داعی الله و ربانیة آیاته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 12.14,
   "end": 16.02,
   "text": "سلام علیکم و رحمه الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 16.02,
   "end": 18.5,
   "text": "ضمن خیر مقدم محضر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 18.5,
   "end": 22.64,
   "text": "زوار آقا علی ابن موسی الرضا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 22.64,
   "end": 25.5,
   "text": "الحمد لله جمع نورانیت خاصی داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 25.5,
   "end": 32.42,
   "text": "این نورانیت هم به برکت زیارت امام رئوف است که زیارت این آقا از زیارت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 32.42,
   "end": 36.76,
   "text": "مکه و مدینه و نجف و سامرا و کاظمین و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 36.76,
   "end": 38.46,
   "text": "حتی کربلا بالاتره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 38.46,
   "end": 40.7,
   "text": "اما ما متاسفانه خیلی قدرشونو،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 40.7,
   "end": 48.2,
   "text": "از کربلا یکی میاد همه میریزن سرش اما از مشهد میاد انگار از یه امامزاده اومده و این خوب نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 48.2,
   "end": 52.54,
   "text": "از رهبر عزیزمون استفتاء شده که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 52.54,
   "end": 57.32,
   "text": "آیا امام جماعت می تونه زن باشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 57.32,
   "end": 59.92,
   "text": "جواب حضرت این هست که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 59.92,
   "end": 63.54,
   "text": "البته این غالبا مراجع همین رو فرمودن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 63.54,
   "end": 69.54,
   "text": "جواب این هستش که در صورتی که همه مأمومین زن باشن اشکال نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 69.54,
   "end": 74.32,
   "text": "اگه یه دونه مرد توی مأمومین وجود داشته باشه، زن دیگه نمی تونه امام جماعت باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 74.32,
   "end": 79.9,
   "text": "پس زن می تونه با داشتن اون شرایطی که حالا عدالت و این‌ها هست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 79.9,
   "end": 83.92,
   "text": "عدالت و بلوغ و قرا-- صحت قرائت و این‌ها،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 83.92,
   "end": 88.62,
   "text": "می تونه امام جماعت جمعیتی از زنان بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 88.62,
   "end": 95.04,
   "text": "پس اگر تو هیئت ما گاها حسینیه اینا مثل یه هیئت میریم خونه‌مون هیئت می‌گیریم خانومان فقط.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 95.04,
   "end": 98.6,
   "text": "لزومی نداره بفرستیم یه آخوندی بیاد، یه مردی بیاد جلو وایسته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 98.6,
   "end": 103.7,
   "text": "همون خانوما یکی که همه قبولش دارن وایسته جلو نماز جماعت بخونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 103.7,
   "end": 108.84,
   "text": "بعدا س-- تمام احکامش هم همون احکام مربوط به جماعت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 108.84,
   "end": 112.24,
   "text": "مردان هست. اینکه مثلا فاصله امام جماعت با",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 112.24,
   "end": 117.0,
   "text": "مردم چقدر باشه اینا همش همونطور هست فرقی نمی‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 117.0,
   "end": 125.96,
   "text": "در خصوص قلب منیب وعده داده بودیم که نکته‌ای رو که البته خودش یک بحث بسیار مبسوطیه این نکته‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 125.96,
   "end": 128.32,
   "text": "که واقعا وقت می‌طلبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 128.32,
   "end": 132.0,
   "text": "ما همونطور که وعده دادیم تبرکاً عرض کنیم بریم بگیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 132.0,
   "end": 137.54,
   "text": "در خصوص فرق عنابه با توبه و استغفار، اینا چگونه‌اند؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 137.54,
   "end": 140.08,
   "text": "آیا کسی که تائه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 140.08,
   "end": 144.82,
   "text": "توبه می‌کنه لاجرم چنین کسی منیب هم هست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 144.82,
   "end": 149.32,
   "text": "کسی که استغفار می‌کنه یا \"استغفر الله و أسأل التوبه\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 149.32,
   "end": 152.92,
   "text": "آیا چنین کسی عنابه کرده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 152.92,
   "end": 156.32,
   "text": "ما اون پیرامون قلب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 156.32,
   "end": 159.96,
   "text": "منیب مطالب بسیار عالی ای شنیدیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 159.96,
   "end": 164.64,
   "text": "از روایات و آیات که مقامشون خیلی بالاست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 164.64,
   "end": 172.3,
   "text": ". تا جایی که \"وجاء ابى قلب منیب\" آیه سی و سه سوره قاف میگه اصلا بهشتی‌ها با قلب منیب میان تو بهشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 172.3,
   "end": 175.18,
   "text": "یعنی ما خیالمون راحت باشه که استغفار کردیم منیبیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 175.18,
   "end": 180.72,
   "text": "نخیر اینا با هم فرق می‌کنن. چند تا وجهش رو من با توجه به وقت کمم تبرکاً عرض می‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 180.72,
   "end": 189.34,
   "text": "البته برا هر وجهی حدیث و روایت و آیه‌ای هست یا توی آیه مثلاً توی قسمتی از یک دعا اهل بیت اشاره کردن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 189.34,
   "end": 192.3,
   "text": "و من چون فرصت ندارم تبرکاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 192.3,
   "end": 196.1,
   "text": "یه دونش رو فقط براش یه سند میارم بقیه رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 196.1,
   "end": 198.6,
   "text": "کسی خواست پژوهش کنه بره اسنادش رو پیدا کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 198.6,
   "end": 207.62,
   "text": "مثلا در کتاب این دعای شریف خمسة عشر امام سجاد که پانزده مناجات امام ذی العابدین سلام الله علیه درش اومده، یه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 207.62,
   "end": 210.38,
   "text": "مناجات هست به نام مناجات م-منیبین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 210.38,
   "end": 215.32,
   "text": "مثلا مناجا– مناجات تائبین اینا خائفین اینا رو برید بخونید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 215.32,
   "end": 219.14,
   "text": "یه بخشیش امام سجاد به خدا اینچنین می‌فرماید،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 219.14,
   "end": 223.58,
   "text": "عرض می‌کنه که \"اللهم ای کن الندم توبه\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 223.58,
   "end": 227.98,
   "text": "اگر توبه ندامت است یعنی پشیمانی‌ست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 227.98,
   "end": 231.82,
   "text": "، ف ا\"فأنا أندم النادمین\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 231.82,
   "end": 235.4,
   "text": "پس من پشیمان‌ترین پشیمانانم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 235.4,
   "end": 239.56,
   "text": "در حقیقت اینج-اینجا حضرت داره اشاره می‌کنه که توبه چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 239.56,
   "end": 244.04,
   "text": "پشیمانیه. اگه کسی پشیمون شد توبه کرده تمام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 244.04,
   "end": 248.36,
   "text": "اما آیا اینکه کسی که پشیمون شد عنابه کرده یا نه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 248.36,
   "end": 254.2,
   "text": "تو بخش بعدش حضرت می‌فرماید \"و ای کن ترک کل معصیة که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 254.2,
   "end": 259.16,
   "text": "عنابه\" اگر ترک معصیت عنابه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 259.16,
   "end": 262.82,
   "text": "است \"فأنا اول المنیبین\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 262.82,
   "end": 266.18,
   "text": "پس من اولین چی‌ام؟ منیبین هستم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 266.18,
   "end": 270.08,
   "text": "پس نتیجه فاصله‌ش چی شد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 270.08,
   "end": 272.44,
   "text": "توبه فقط ندامته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 272.44,
   "end": 277.66,
   "text": "اما اگر ترک معصیت هم به دنبالش اومد میشه عنابه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 277.66,
   "end": 279.94,
   "text": "نه اینکه آدم از یه گناه پشیمون بشه توبه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 279.94,
   "end": 282.24,
   "text": "همین که پشیمون شد توبه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 282.24,
   "end": 286.16,
   "text": "بعد دوباره بره یه گناه دیگه‌ای دو مرتبه انجام بده، این منیب نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 286.16,
   "end": 290.82,
   "text": "تائب بوده، توبه کرده حالا دوباره توبه شکسته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 290.82,
   "end": 296.62,
   "text": "اما وقتی به گناه برگشت دیگه معلومه منیب نبوده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 296.62,
   "end": 300.82,
   "text": ". توبه در افعال ظاهری است مثلا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 300.82,
   "end": 304.06,
   "text": "بیشتر مربوط به افعال ظاهری انسان هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 304.06,
   "end": 310.16,
   "text": "اینکه انسان به مسائل ظاهری یا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 310.16,
   "end": 313.0,
   "text": "رجوع می‌کنه یا ترک می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 313.0,
   "end": 316.68,
   "text": "اما عنابه در امور باطنی است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 316.68,
   "end": 321.54,
   "text": "این یه وجه دیگه. یه وجه دیگه اینکه توبه مقدمه است،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 321.54,
   "end": 327.76,
   "text": "عنابه پس از آن است. یعنی عنابه بدون پشیمانی نمی‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 327.76,
   "end": 329.86,
   "text": "پشیمانی هم چی بود؟ توبه بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 329.86,
   "end": 332.58,
   "text": "پس اول توبه است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 332.58,
   "end": 335.38,
   "text": "بعد عنابه است .",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 335.38,
   "end": 339.76,
   "text": "وجه دیگه اینکه توبه بازگشت از معصیت به طاعت است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 339.76,
   "end": 343.84,
   "text": "یعنی طرف تسلیم می‌گیره دیگه گناه نکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 343.84,
   "end": 347.16,
   "text": "گناه نکنه یعنی چی؟ در اطاعت الهی باشه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 347.16,
   "end": 350.88,
   "text": "میشه که برگشت از معصیت به طاعت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 350.88,
   "end": 356.24,
   "text": "اما عنابه بازگشت از غفلت به ذکر و فکر است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 356.24,
   "end": 358.32,
   "text": "حالا اینا نظرات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 358.32,
   "end": 363.28,
   "text": "شارحین و مفسرین بزرگ ماست ها من اینطوری جمله، جمله دارم میگم میرم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 363.28,
   "end": 365.84,
   "text": "روش خیلی بحث کردن و من--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 365.84,
   "end": 369.52,
   "text": "ااا عرض کنم مبانی خوبی هم آوردن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 369.52,
   "end": 374.1,
   "text": "متبرکاً میگیم. پس فرقش چی شد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 374.1,
   "end": 382.12,
   "text": "در توبه شما برگشت می‌کنی از معصیت به طاعت، در عنابه برگشت می‌کنی از غفلت، نه معصیت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 382.12,
   "end": 385.26,
   "text": "اصلاً یک لحظه میخوای از خدا غافل نباشی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 385.26,
   "end": 388.6,
   "text": "بر می‌گردی به یاد و ذکر خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 388.6,
   "end": 393.06,
   "text": "و فکر در خصوص خدا. وجه بعدیش اینه که توبه سبب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 393.06,
   "end": 395.98,
   "text": "بازگشت یعنی اینکه شما س--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 395.98,
   "end": 402.64,
   "text": "دلیله اینکه بازگشت می‌کنی یعنی سبب بازگشت در توبه ترسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 402.64,
   "end": 406.92,
   "text": "به خاطر ترست از توبه بازگشت می‌کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 406.92,
   "end": 410.7,
   "text": "اصطلاح، اه، اصطلاحاً بهش میگن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 410.7,
   "end": 413.4,
   "text": "خوف یا عرض کنم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 413.4,
   "end": 416.26,
   "text": "رَهب، رَهب هم بهش میگن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 416.26,
   "end": 419.04,
   "text": "یعنی یه رُعبی می‌گیردت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 419.04,
   "end": 424.38,
   "text": "می‌ترسی بر می‌گردی. اما سبب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 424.38,
   "end": 426.9,
   "text": "عنابه شوقه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 426.9,
   "end": 431.08,
   "text": "ترس نیست. کسی که شائق میشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 431.08,
   "end": 434.62,
   "text": "مثلاً روایاتی رو می‌شنوه، می‌شنوه در خصوص",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 434.62,
   "end": 439.86,
   "text": "لطف و عنایت خدا نسبت به بندگانش شوق پیدا می‌کنه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 439.86,
   "end": 445.54,
   "text": "میاد به سمت خدا. اما کسی که عقوبت خدا رو می‌شنوه بر گناه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 445.54,
   "end": 448.96,
   "text": "می‌ترسه و گناه رو ترک می‌کنه، می، میاد به سمت خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 448.96,
   "end": 452.76,
   "text": "اینا با هم فرق می‌کنند. پس سبب هم مهمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 452.76,
   "end": 458.2,
   "text": "سبب در توبه عقوبت است و ترس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 458.2,
   "end": 462.22,
   "text": "سبب در عنابه شوق است و ثواب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 462.22,
   "end": 465.84,
   "text": "و رغبت به سمت خدا. اینا با هم فرق دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 465.84,
   "end": 471.26,
   "text": "یه وجه دیگه اینه که در توبه بازگشت به طاعت است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 471.26,
   "end": 474.14,
   "text": "اما در عنابه بازگشت به سمت خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 474.14,
   "end": 477.9,
   "text": "میشه کسی به سمت اطاعت خدا بره اما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 477.9,
   "end": 479.9,
   "text": "خالصانه نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 479.9,
   "end": 482.16,
   "text": "چرا؟ مگه به سمت اطاعت نرفته؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 482.16,
   "end": 485.7,
   "text": "شاید شوق بهشت داره، شاید ترسه از جهنم داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 485.7,
   "end": 487.76,
   "text": "خود خدا منظورش نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 487.76,
   "end": 490.04,
   "text": "توجه بکنین اینا ظرافت‌هاشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 490.04,
   "end": 492.44,
   "text": "اما منیب خدا مدنظرشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 492.44,
   "end": 495.58,
   "text": "کاری نداره خدا او رو جهنم ببره یا بهشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 495.58,
   "end": 498.48,
   "text": "عاشق خدا شده. توجه کردید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 498.48,
   "end": 503.06,
   "text": "پس منظر نگاه منیب خداست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 503.06,
   "end": 505.44,
   "text": "منظر نگاه تائب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 505.44,
   "end": 508.36,
   "text": "اون وجه اطاعتی قضیه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 508.36,
   "end": 512.42,
   "text": "اون عبادت لذتیه که مثلاً از نماز می‌بره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 512.42,
   "end": 517.74,
   "text": "نه خود خدا. وجه بعدی فرمودن توبه استقرار است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 517.74,
   "end": 522.26,
   "text": "یعنی در یک جایگاهی انسان قرار می‌گیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 522.26,
   "end": 525.7,
   "text": "یک جایگاهی‌ست که رسید تمام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 525.7,
   "end": 528.72,
   "text": "دیگه پله‌های بعدی نداره که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 528.72,
   "end": 530.92,
   "text": "اما عنابه پله پله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 530.92,
   "end": 535.9,
   "text": "میگه-- لذا غالباً هر کجا شما ببینید عناب-- بحث از عنابه و،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 535.9,
   "end": 538.74,
   "text": "اِممم، منیب میاد با \"إلى\" شروع میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 538.74,
   "end": 541.7,
   "text": "\"إلى\" یعنی سیر یعنی به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 541.7,
   "end": 548.06,
   "text": "سویه. عنابه إلى الله یعنی یک سیریه تازه شروع شده و ادامه پیدا می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 548.06,
   "end": 551.22,
   "text": "اما توبه نه، استقراره، یک جا قرار می‌گیری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 551.22,
   "end": 553.86,
   "text": "با توجه به این مطالبی که من گفتم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 553.86,
   "end": 557.0,
   "text": "فرمولش چی میشه؟ اول چی میشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 557.0,
   "end": 559.0,
   "text": "اول به نظر شما توبه است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 559.0,
   "end": 562.88,
   "text": "یا عنابه است یا استغفاره؟ اول توبه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 562.88,
   "end": 565.4,
   "text": "چرا؟ چون با پشیمانی شروع میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 565.4,
   "end": 567.38,
   "text": "نمیشه اول با استغفار باشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 567.38,
   "end": 571.6,
   "text": "نه. چون تا آدم پشیمون نشه استغفار نمی‌کنه که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 571.6,
   "end": 575.02,
   "text": "پس اول پشیمانیه. وقتی پشیمانی توبه است، اول توبه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 575.02,
   "end": 578.98,
   "text": "فرمول اینطور شد. اول توبه یعنی پشیمانی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 578.98,
   "end": 580.92,
   "text": "دو، چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 580.92,
   "end": 587.54,
   "text": "استغفار. چون بلافاصله بعد پشیمانی طرف اگه واقعاً پشیمان باشه، واقعاً توبه کرده استغفار می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 587.54,
   "end": 590.1,
   "text": "بعد از استغفار عنابه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 590.1,
   "end": 592.5,
   "text": "این وجه سوم قضیه قرار می‌گیره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 592.5,
   "end": 597.84,
   "text": "که انسان وقتی به وجه سوم رسید عنابه کرررد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 597.84,
   "end": 604.48,
   "text": "احساس حضور در محضر خدا می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 604.48,
   "end": 610.12,
   "text": "می‌دونید نشانه ای که آقای بهجت گفتن تو در محضر خدا به لقاء خدا می‌رسی چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 610.12,
   "end": 614.54,
   "text": "مخصوصاً در نماز. این یکی از اسراره‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 614.54,
   "end": 617.96,
   "text": "من دارم به شما میگم نه که خودم اهل سر باشم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 617.96,
   "end": 621.64,
   "text": "ولی واقعاً اینا رو شما هر جایی نمی‌تونید پیدا کنید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 621.64,
   "end": 624.84,
   "text": "و هر کسی هم درک این چیزا رو نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 624.84,
   "end": 627.08,
   "text": "خیلی زیباست و خیلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 627.08,
   "end": 629.68,
   "text": "رهگشا است و خیلی کلیدیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 629.68,
   "end": 636.68,
   "text": "آدم از کجا بفهمه که به لقاء خدا رسید، قلبش منیب شد و در محضر خدا قرار گرفت، رجوع کرد به خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 636.68,
   "end": 639.06,
   "text": "یه نشونه داره من به شما بگم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 639.06,
   "end": 645.2,
   "text": "خیلی این نشونه عجیبه. احتمال داره این همون اول نماز رخ بده بعد آدم شل بشه تا آخرش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 645.2,
   "end": 650.84,
   "text": "اما کسی اینو تا آخر نماز ببره میشه همون دورکت نمازی که امیرالمؤمنین فرمود کسی انجام بده همه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 650.84,
   "end": 654.7,
   "text": "گناهاش رو خدا می‌بخشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 654.7,
   "end": 656.88,
   "text": "آقای بهجت یه جمله‌ست فرمود:",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 656.88,
   "end": 662.14,
   "text": "\"وقتی که در نماز\" حالا ایشون مثال نماز رو زده یا غیر نماز هم فرق نمی‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 662.14,
   "end": 666.68,
   "text": "\"وقتی که در نماز قلبت داغ شد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 666.68,
   "end": 671.1,
   "text": "بفهم به لقاء رب رسیدی.\" الله اکبر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 671.1,
   "end": 675.42,
   "text": "چقدر قشنگ گفته. یه دفعه دلت داغ میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 675.42,
   "end": 678.1,
   "text": "یه حالت عجیبیه باید درکش کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 678.1,
   "end": 682.98,
   "text": "من نمی‌فهمم. اون لحظه، لحظه اول عنابه‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 682.98,
   "end": 685.06,
   "text": "اول تازه عنابه‌ست. انسان به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 685.06,
   "end": 688.34,
   "text": "لقاء ربش می‌رسه. یک آن و یک لحظه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 688.34,
   "end": 690.4,
   "text": "اصلاً تو رنگ چهره‌ش تغییر می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 690.4,
   "end": 693.18,
   "text": "که امیرالمؤمنین تو محراب وایمیستاد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 693.18,
   "end": 696.64,
   "text": "رنگش برمی‌گشت که هیچ جرأت نمی‌کرد نزدیکش شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 696.64,
   "end": 699.68,
   "text": "یعنی این اول عنابه اینه، داغ شدن قلبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 699.68,
   "end": 702.66,
   "text": "حالا دیگه تو خود حدیث مفصل بخوان از این مجمل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 702.66,
   "end": 707.22,
   "text": "ان‌شاءالله عاقبتمون خیر بشه به ذکر صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 707.22,
   "end": 709.6,
   "text": "اللهumma",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 709.6,
   "end": 713.0,
   "text": "صلي على محمد و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 713.0,
   "end": 717.08,
   "text": "آل محمد و عجل فرجهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}