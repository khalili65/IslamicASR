 "chapters": [
  {
   "index": 0,
   "title": "## اقتدا با نماز شکسته و شرط نماز قضا",
   "start": 13.66,
   "end": 195.82
  },
  {
   "index": 1,
   "title": "## قلب منیب در آیۀ قاف؛ صفت بهشتیان",
   "start": 195.82,
   "end": 250.58
  },
  {
   "index": 2,
   "title": "## علامه طباطبایی و توقف در معاد؛ درک قلبی",
   "start": 250.58,
   "end": 270.86
  },
  {
   "index": 3,
   "title": "## حضرت زینب؛ علم ربانی و قلب منیب",
   "start": 270.86,
   "end": 509.98
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 2.62,
   "end": 6.54,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 6.54,
   "end": 9.82,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 9.82,
   "end": 13.66,
   "text": "آیاته. السلام علیکم و رحمه الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 13.66,
   "end": 16.36,
   "text": "از رهبر عزیزمون سؤال شده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 16.36,
   "end": 20.86,
   "text": "که اگر چنانچه کسی در نماز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 20.86,
   "end": 23.44,
   "text": "جماعتی شرکت کنه لکن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 23.44,
   "end": 27.22,
   "text": "نمازش شکسته باشه؛ مثلا انشاالله میریم مشهد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 27.22,
   "end": 31.44,
   "text": "بعد اون‌ها دور-- چهار رکعتی می‌خونن تو دو رکعتی نماز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 31.44,
   "end": 37.92,
   "text": "ظهر یا عصرتو تموم می‌کنی بعد دو رکعت اینجا می‌خوای پاشی اقتدا کنی دو رکعت دیگه رو فیز ببری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 37.92,
   "end": 40.68,
   "text": "اگ-- در چه صورت کسی می‌تونه اینجا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 40.68,
   "end": 43.46,
   "text": "اقتدا کنه نماز واجبش رو؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 43.46,
   "end": 49.02,
   "text": "در صورتی که نماز قضا قطعاً گردنش باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 49.02,
   "end": 55.92,
   "text": "اگر کسی مطمئنه که نماز قضا به گردنش نیست حق نداره اینجا دو مرتبه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 55.92,
   "end": 60.04,
   "text": "نماز قضا نیت کنه اقتدا کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 60.04,
   "end": 67.26,
   "text": "مگر اینکه شک داشته باشه مثلا محتاط باشه از رو احتیاط میگه شاید داشتم حواسم نیست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 67.26,
   "end": 73.04,
   "text": "اون اشکال نداره. اما کسی که مطمئنه نماز قضا گردنش نیست نمی‌تونه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 73.04,
   "end": 77.36,
   "text": "چه جماعت چه فرادا دو مرتبه نماز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 77.36,
   "end": 80.46,
   "text": "قضا نشده‌شو بخونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 80.46,
   "end": 83.2,
   "text": "حتی برای میت. حالا میگه خب من",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 83.2,
   "end": 85.48,
   "text": "یه راه دیگه‌ای داره خودش نماز قضا نداره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 85.48,
   "end": 88.06,
   "text": "برای یه میتی می‌خونه اقتدا می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 88.06,
   "end": 92.76,
   "text": "نماز قضای صبح مثلا مادر بزرگم اقتدا می‌کنه و می‌خونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 92.76,
   "end": 100.0,
   "text": "اونم در صورتی می‌تونه این کارو بکنه که مطمئن باشه که اون شخص متوفی نماز قضا داشته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 100.0,
   "end": 104.62,
   "text": "اگه احتیاطی و این حرفا نه، باید مطمئن باشه که نماز قضا داشته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 104.62,
   "end": 112.32,
   "text": "جانم. اون‌ها اولا خودشون مجتهد بودن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 112.32,
   "end": 116.56,
   "text": "کسانی-- به ندرت پیش اومده که این اتفاق بیفته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 116.56,
   "end": 122.18,
   "text": "و من دیدم اینای-- کسانی که این کارو کردن خودشون مجتهد بودن یعنی از کسی تقلید نمی‌کردن، حکم شرعی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 122.18,
   "end": 124.88,
   "text": "خودشان بوده یک- جماعت میشه قضا کرد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 124.88,
   "end": 128.14,
   "text": "بله میشه قر- جماعت قضا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 128.14,
   "end": 131.86,
   "text": "فقط مشکل جماعت؟ نه، نه فرادا هم نمیشه. به فتوای رهبر و بسیاری از مراجع،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 131.86,
   "end": 139.88,
   "text": "مراجع ما اگر یقین داری که نماز جماعت گردنت نی-- نماز قضا گردنت نیست، نمی‌تونی حتی فرادا بخونی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 139.88,
   "end": 144.86,
   "text": "شما شرعا انجام دادی. من حتی دیروز با دفتر آقا صحبت کردم که آقا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 144.86,
   "end": 148.82,
   "text": "پس ما تو جبهه می‌دیدیم یه نفر پنج بار نماز صبح خوند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 148.82,
   "end": 152.12,
   "text": "بعد گفتیم چرا؟ گفت آخریش بهم حال داد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 152.12,
   "end": 153.64,
   "text": "اون چهار تا قبلی‌ها حال نداد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 153.64,
   "end": 156.52,
   "text": "گفت ایشون خلاف شرع مرتکب شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 156.52,
   "end": 158.28,
   "text": "خلاف شرعه یعنی اجازه‌ش نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 158.28,
   "end": 161.66,
   "text": "همین جوری که آدم نباید نمازی رو برای خودش بخونه که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 161.66,
   "end": 165.66,
   "text": "مگر اینکه طرف اه-- اونا که می‌خونن احتیاط می‌کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 165.66,
   "end": 168.16,
   "text": "میگن مثلا شاید من یه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 168.16,
   "end": 170.42,
   "text": "ل-- مثلا لفظم رو درست نمی‌خوندم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 170.42,
   "end": 173.28,
   "text": "شاید نمی‌دونم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 173.28,
   "end": 176.72,
   "text": "یه مشکل شرعی یا الان متوجه شده احتیاط می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 176.72,
   "end": 181.42,
   "text": "اون کسی که مطمئنه نماز قضا گردنش نیست، نمی‌تونه بخونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 181.42,
   "end": 184.32,
   "text": "نه می‌تونه اقتدا کنه، نه می‌تونه فرادا بخونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 184.32,
   "end": 186.34,
   "text": "یه نکته‌ای بگم که این نکته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 186.34,
   "end": 189.76,
   "text": "حالا چون این بحث احکام کشف پیدا کرد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 189.76,
   "end": 195.82,
   "text": "اونو شاخ و برگشو بچینم سریع عرض کنم برم بحث قلب منیب رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 195.82,
   "end": 198.48,
   "text": "آیه سی و سه سوره قاف رو نگاه کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 198.48,
   "end": 205.32,
   "text": "می‌فرماید که من خشی رحمان بالغیب در بحث قلب خاشع ما این آیه رو ابتداءش رو گفتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 205.32,
   "end": 208.72,
   "text": "از صفات بهشتیان اینه که خاشعن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 208.72,
   "end": 212.0,
   "text": "من کسی که خشی رحمان بالغیب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 212.0,
   "end": 215.84,
   "text": "می‌ترسه، ترس داره از خودش بالغیب در خلوتش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 215.84,
   "end": 218.48,
   "text": "خاش-- قلب خاشع رو در خلوت داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 218.48,
   "end": 223.96,
   "text": "بعد ادامه همین آیه می‌فرماید وجاء بقلب منیب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 223.96,
   "end": 227.78,
   "text": "و این اومده با قلب منیب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 227.78,
   "end": 231.08,
   "text": "یعنی از صفات بهشتیان داشتن قلب منیبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 231.08,
   "end": 235.2,
   "text": "یعنی قلبی که دائما در حال ارجاع به خداست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 235.2,
   "end": 240.06,
   "text": "و در حقیقت کسی که منیب است خاشع خواهد شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 240.06,
   "end": 243.76,
   "text": "نمیشه قلب خاشع کسی داشته باشه اما منیب نباشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 243.76,
   "end": 246.36,
   "text": "منیب یعنی دائما در حال رجوع به خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 246.36,
   "end": 250.58,
   "text": "حالا ببینید یه جمله داره خیلی خوب گوش بدید ام پی تری من حرف بزنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 250.58,
   "end": 255.76,
   "text": "علامه طباطبایی وقتی که اسفار رو درس می‌داد رحمت الله علیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 255.76,
   "end": 259.92,
   "text": "بحث نفس رو که تموم کرد رسید به بحث معاد توقف کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 259.92,
   "end": 262.42,
   "text": "گفتن آقا چرا معاد رو تدریس نمی‌کنی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 262.42,
   "end": 267.36,
   "text": "فرمودن ظرف وجود مردم الان به قدر کشش معاد نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 267.36,
   "end": 269.96,
   "text": "الان وقت درس معاد نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 269.96,
   "end": 274.66,
   "text": "الان مردم گنجایش قلبشون در حد درک موضوع معاد نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 274.66,
   "end": 276.66,
   "text": "باید بگذره سال‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 276.66,
   "end": 279.26,
   "text": "تا اینا قلبشون مستعد و آماده بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 279.26,
   "end": 281.9,
   "text": "گفت موضوع معاد هم خیلی پیچیده است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 281.9,
   "end": 284.18,
   "text": "ق-- این حوزه ادراک دست قلبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 284.18,
   "end": 289.46,
   "text": "مرحوم آقای بهادی دین رحمت الله علیه هم می‌فرمودن که آقا کار اخلاقی به گفتن نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 289.46,
   "end": 292.96,
   "text": "همین که گفتی چهار تا حدیث، آیه گفتی، آره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 292.96,
   "end": 295.52,
   "text": "علامه جوادی آملی اخیرا یه همچین حرفی دارن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 295.52,
   "end": 297.38,
   "text": "که هی بگی، بگی کار اخلاقی نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 297.38,
   "end": 302.82,
   "text": "کار اخلاقی درک قلبی‌ست یعنی قلبت پذیرش کنه، بپذیره، قبول کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 302.82,
   "end": 305.36,
   "text": "حالا این قلب در چه صورت؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 305.36,
   "end": 310.22,
   "text": "چون العلم نورٌ یضعه الله فی قلب من اراد ان يهديه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 310.22,
   "end": 312.22,
   "text": "علم این دانش، این اف--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 312.22,
   "end": 318.48,
   "text": "این یافته‌ها نور است که خدا هر کی بخواد هدایتش کنه میندازه به دلش این نور رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 318.48,
   "end": 321.16,
   "text": "کی خدا این نور رو به دل میندازه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 321.16,
   "end": 323.24,
   "text": "وقتی که در خونه‌ش رو بزنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 323.24,
   "end": 326.4,
   "text": "خدا به ما دو تا پا داده، پای جسمی، پای روحی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 326.4,
   "end": 328.94,
   "text": "باید با پای دل در خانه خدا رو بزنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 328.94,
   "end": 331.04,
   "text": "این یعنی اختیار. خدا میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 331.04,
   "end": 335.34,
   "text": "همه چی دست خداست. اما ما باید با پای خودمون در خانه خدا رو بزنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 335.34,
   "end": 337.9,
   "text": "هرچی بیشتر بزنی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 337.9,
   "end": 341.94,
   "text": "بیشتر رجوع کنی در خانه خدا بیشتر کاسه‌تو پر می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 341.94,
   "end": 348.88,
   "text": "این یعنی عنابه. پس درک حقایق پیچیده معنوی امثال معاد و چه وچه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 348.88,
   "end": 351.84,
   "text": "نیاز به یک قلبی داره که این منیب باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 351.84,
   "end": 355.66,
   "text": "یعنی انقدر در خونه رو بزنه تا جواب بگیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 355.66,
   "end": 359.86,
   "text": "لذا مثلا خواب رو اصلا از اسرار اینکه خواب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 359.86,
   "end": 364.74,
   "text": "اومده ما می‌خوابیدیم، همه انسان‌ها می‌خوابیدن از ابتدا اما خواب نمی‌دیدن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 364.74,
   "end": 366.92,
   "text": "انبیا اولی اینم حالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 366.92,
   "end": 370.3,
   "text": "یادم نیست کدوم یکی از اون انبیا اول، متأخرین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 370.3,
   "end": 376.62,
   "text": "این‌ها-- متقدمین، این‌ها به خدا گله کردن ما هرچی می‌کنیم زور می‌زنیم نمی‌فهمن مردم معاد رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 376.62,
   "end": 380.84,
   "text": "خدا خواب رو ایجاد کرد که بتونه خواب ببینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 380.84,
   "end": 383.42,
   "text": "خدا-- جسمش اینجاست ولی مثلاً جای دیگه‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 383.42,
   "end": 386.98,
   "text": "می‌فهمه که میشه. پس چیز پیچیده‌ایه اما با",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 386.98,
   "end": 390.44,
   "text": "عنابه میشه کسی که دائماً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 390.44,
   "end": 392.72,
   "text": "مشغول ذکر و یاد و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 392.72,
   "end": 395.14,
   "text": "در کوبی درگاه خدا باشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 395.14,
   "end": 397.86,
   "text": "کاسه‌ش پر میشه. حالا یه نقطه دیگه بزنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 397.86,
   "end": 402.4,
   "text": "دیروز یه نقطه زدیم امروزم یه نقطه متناسب با",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 402.4,
   "end": 404.5,
   "text": "روز دختر امیرالمؤمنین سلام الله علیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 404.5,
   "end": 407.68,
   "text": "حالا شاید متوجه بشیم عجب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 407.68,
   "end": 418.22,
   "text": "چه جایگاهی که امام زمانش در خصوص این خانم حضرت سجاد در خصوص حضرت زینب علیهم السلام فرمودند \"انته بحمدالله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 418.22,
   "end": 423.24,
   "text": "فهمت غیر مفهمه و علمت غیر معلمه\" الله اکبر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 423.24,
   "end": 429.22,
   "text": "بعضی از بزرگان فرمودن این معجزه است اصلاً این کلام امام معصوم در خصوص یک شخصی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 429.22,
   "end": 431.98,
   "text": "یعنی تو علم ربانی داری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 431.98,
   "end": 437.08,
   "text": "یعنی تو انقدر در خانه خدا رو کوبیدی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 437.08,
   "end": 444.7,
   "text": "عنابه کردی، چنان قلب منیب خدا به تو داده، انقدر در زدی پر شده وجودت از علم الهی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 444.7,
   "end": 449.44,
   "text": "و این فهم پیچیدگی‌های معارف توحیدی رو خدا به تو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 449.44,
   "end": 451.7,
   "text": "به یکباره عطا کرده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 451.7,
   "end": 459.38,
   "text": "که دیروز عرض کردیم ابا عبدالله رو پیشکش می‌بری در کا-- درگاه خدا میگی اللهم تقبل منا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 459.38,
   "end": 461.1,
   "text": "هذا القلیل من القربان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 461.1,
   "end": 466.42,
   "text": "این استدلالش رو آوردیم. یعنی ابا عبدالله رو کم می‌شمری برای خدا، برای قربونی کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 466.42,
   "end": 468.96,
   "text": "این فهم توحیدی، این پیچیدگی‌های",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 468.96,
   "end": 474.78,
   "text": "درونی کار قلبه و قلب منیب که دائماً به سمت خدا حر-حرکت باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 474.78,
   "end": 480.86,
   "text": "اگر می‌خوایم خلاصه اگر می‌خوایم به لطف و عنایت بیبی حضرت زینب سلام الله علیها یک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 480.86,
   "end": 485.42,
   "text": "چیزی از معارف کسب کنیم و بفهمیم، قلبمون آینه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 485.42,
   "end": 487.52,
   "text": "معارف و نورانیت بشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 487.52,
   "end": 492.74,
   "text": "چاره‌ای جز در کوبیدن دائم درگاه خدا رو نداریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 492.74,
   "end": 497.68,
   "text": "این سرشه. انشاالله که حضرت زینب عیدی‌های خوب به هممون بده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 497.68,
   "end": 501.32,
   "text": "از صدرش انشاالله ز-ظهور و فرج آقامون باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 501.32,
   "end": 509.98,
   "text": "عاقبتمونم انشاالله ختم به خیر بشه به ذکر صلوات بر محمد و آل محمد. اللهم صل على محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}