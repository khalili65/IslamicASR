 },
 "chapters": [
  {
   "index": 0,
   "title": "## شک میان سه و شش رکعت",
   "start": 18.4,
   "end": 40.26
  },
  {
   "index": 1,
   "title": "## فرمول عنابه و نصرت الهی",
   "start": 40.26,
   "end": 60.74
  },
  {
   "index": 2,
   "title": "## وجه تسمیهٔ فاطمه و منصوره",
   "start": 60.74,
   "end": 121.34
  },
  {
   "index": 3,
   "title": "آیه‌ای دیگر:",
   "start": 121.34,
   "end": 600.42
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.26,
   "end": 4.92,
   "text": "بسم الله الرحمن الرحیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 4.92,
   "end": 9.98,
   "text": "لا حول ولا قوة الا بالله العلی العظیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 9.98,
   "end": 14.94,
   "text": "السلام علیک یا داعی الله و ربانی ایاته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 14.94,
   "end": 18.4,
   "text": "سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 18.4,
   "end": 23.44,
   "text": "یکی دیگه از شکیاتی که مبتلاست و نماز رو باطل میکنه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 23.44,
   "end": 27.68,
   "text": "شک بین سه و شش هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 27.68,
   "end": 31.6,
   "text": "یعنی کسی شک کنه سه رکعت نماز خونده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 31.6,
   "end": 34.32,
   "text": "یا شش رکعت. اختلافش خیلیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 34.32,
   "end": 40.26,
   "text": "سه رکعت اینجا اختلاف داره لذا میگه آقا باطله بش کن نمازد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 40.26,
   "end": 49.16,
   "text": "و همونجا باید-- اگه البته شک بدل به یقین نشد، هرچی زور زدی نف-- نمیفهمی تشخیص نمیدی سه رکعت خوندی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 49.16,
   "end": 55.7,
   "text": "یا شش رکعت. البته این مربوطه به نمازهای چهار رکعتیه دیگه قبلا گفتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 55.7,
   "end": 58.86,
   "text": "خب یه نکته‌ای رو من امروز عرض کنم به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 58.86,
   "end": 64.04,
   "text": "گمانم امام زمان سلام الله علیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 64.04,
   "end": 71.54,
   "text": "به کرمش خواسته یک عسلی امروز تو کام شما بگذاره با این نکته‌ای که عرض می‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 71.54,
   "end": 73.76,
   "text": "ان شا الله به کامتون شیرین بیاد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 73.76,
   "end": 82.0,
   "text": "که حتما میاد. دیروز ما بحث کردیم رو آیه پنجاه و سه و پنجاه و چهار و پنجاه و پنج سوره زمر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 82.0,
   "end": 85.72,
   "text": "آخرش رسیدیم تو بحث عنابه و قلب منیب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 85.72,
   "end": 88.84,
   "text": "رسیدیم به یه فرمولی. گفتیم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 88.84,
   "end": 92.98,
   "text": "عنابه به علاوه تسلیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 92.98,
   "end": 96.62,
   "text": "نتیجه‌ش میشه چی؟ نصرت الهی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 96.62,
   "end": 102.18,
   "text": "وقتی که نصرت اومد خود اولین کاری که نصرت الهی میکنه غفرانه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 102.18,
   "end": 104.46,
   "text": "بخشش گناهان. چون آیه قبلش اینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 104.46,
   "end": 109.82,
   "text": "البته با آیه بعدش هم ثابت کردیم که اون فرمول کامل‌تر میشه با چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 109.82,
   "end": 113.58,
   "text": "با عنابه به علاوه تسلیم به علاوه تبعیت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 113.58,
   "end": 115.62,
   "text": "نتیجه چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 115.62,
   "end": 125.86,
   "text": "نصرت الهی. چون آخر آیه میفرماید ثم لا تنصرون اگر تسانیبو الی الله اگر عنابه نداشته باشید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 125.86,
   "end": 128.58,
   "text": "و اسلمو اگر تسلیم هم نباشید،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 128.58,
   "end": 132.84,
   "text": "آیه بعدش هم که با واو عطف ادامه مطلبو میگه و اتبعو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 132.84,
   "end": 137.74,
   "text": "اگر اینا نباشه یعنی یه دونه از اینا نباشه، عنابه نباشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 137.74,
   "end": 141.46,
   "text": "تسلیم نباشه انسان و تبعیت هم نکنه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 141.46,
   "end": 145.66,
   "text": "ثم لا تنصرون میگه یاریتون نمیدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 145.66,
   "end": 148.12,
   "text": "پس بودن این‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 148.12,
   "end": 150.26,
   "text": "میشه یاری خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 150.26,
   "end": 155.74,
   "text": "حالا اینو اونتر داشته باشید تو ذهنتون تو بحث عنابه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 155.74,
   "end": 158.26,
   "text": "یه حدیث بسیار زیبا که مبثوته من",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 158.26,
   "end": 161.36,
   "text": "بخشی‌ش رو عرض می‌کنم در وجه تسمیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 161.36,
   "end": 167.28,
   "text": "این که چرا به حضرت زهرا سلام الله علیها فاطمه و منسوره گفتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 167.28,
   "end": 170.16,
   "text": "حدود بیست مورد داره این من--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 170.16,
   "end": 172.08,
   "text": "یعنی خودش یک منبر میخواد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 172.08,
   "end": 179.04,
   "text": "تبرکاً یک بخشیش رو من عرض بکنم در کتاب شریف خصال سلف فاطمیه صفحه پنجاه و شش و پنجاه و هفت دیدم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 179.04,
   "end": 184.56,
   "text": "در معانی اخبارم هست. رسول خدا میفرماید وقتی که رفتم به آل،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 184.56,
   "end": 187.08,
   "text": "چون می‌دونید صد و بیست شیخ صدوق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 187.08,
   "end": 193.66,
   "text": "در کتاب خصالش صد و بیست معراج رو روایت میاره که پیغمبر صد و بیست معراج داشته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 193.66,
   "end": 196.32,
   "text": "یکی از اون معراج‌ها قصه حضرت زهراست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 196.32,
   "end": 199.3,
   "text": "یعنی پیغمبر رو بردن نه اینکه نور زهرا رو بیارن پایین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 199.3,
   "end": 204.12,
   "text": "انقدر این نور شرف داشت پیغمبر رو بردن بالا که اون نورو اخذ کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 204.12,
   "end": 209.1,
   "text": "یه داستانش هم مفصله که در همین روایت اومده که یک سیبی شکافته میشه نورش از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 209.1,
   "end": 212.84,
   "text": "نور حضرت صدیقه طاهره سلام الله علیها از اون خارج میشه به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 212.84,
   "end": 216.88,
   "text": "حضرت جبرائیل به پیغمبر میفرماید تناول کنید نترسید بخورید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 216.88,
   "end": 220.64,
   "text": "بعد این نور جلوه گر که میشه پیغمبر میفرماید این چه نوریست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 220.64,
   "end": 223.92,
   "text": "جبرائیل توضیح میده که بله این نور",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 223.92,
   "end": 231.32,
   "text": "دختر شماست و توضیح میده که او در زمین خدا براش نام فاطمه رو مقرر کرده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 231.32,
   "end": 236.04,
   "text": "مسمی به فاطمه‌ست و در آسمان منسوره است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 236.04,
   "end": 239.9,
   "text": "بعد سؤال میکنه پیغمبر که ای حبیب من چطور این گونه است؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 239.9,
   "end": 242.12,
   "text": "حضرت جبرائیل علیه الصلاة والسلام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 242.12,
   "end": 244.4,
   "text": "نکاتی رو میگه حالا. یه بخشی‌ش رو من عرض کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 244.4,
   "end": 249.98,
   "text": "میفرماید که از این جهت فاطمه گفتن چون کنده شده او و دوستانش از آتش جهنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 249.98,
   "end": 253.74,
   "text": "یعنی هر کس که او رو دوست داره به آتش جهنم نمیسوزه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 253.74,
   "end": 256.44,
   "text": "و از این جهت منسوره است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 256.44,
   "end": 260.66,
   "text": "که دو تا وجه گفته یکی اینکه فاطمه سلام الله علیها لن--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 260.66,
   "end": 263.18,
   "text": "له نصرت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 263.18,
   "end": 266.38,
   "text": "فاطمه لمحبیها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 266.38,
   "end": 274.52,
   "text": "لا-- یا لنصر فاطمه ص لمبی-- لمحبیها یعنی فاطمه زهرا دوستاشو یاری میده، اعانت میکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 274.52,
   "end": 279.6,
   "text": "یه وجهش هم گفتن چون منسوره است یعنی دوستان فاطمه هم او رو یاری میدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 279.6,
   "end": 285.5,
   "text": "پس این دو طرفه‌ست. بعد جالبه حضرت جبرائیل سلام الله علیه اشاره میکنه به این آیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 285.5,
   "end": 287.24,
   "text": "چهار و پنج سوره روم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 287.24,
   "end": 289.7,
   "text": "برید بخونیدش. خیلی زیبا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 289.7,
   "end": 292.32,
   "text": "این آیه مخصوص حضرت زهراست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 292.32,
   "end": 296.24,
   "text": "همم می‌دونستید، دونم. من خیلی لذت بردم از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 296.24,
   "end": 300.9,
   "text": "ذیل این آیه که میفرماید و یومئذ ظاهرش تأویلش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 300.9,
   "end": 308.04,
   "text": "عرض کنم ببخشید. ااا شأن نزولش مربوطه به غالب شدن رومیان بر فارسیان یا ایرانیانه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 308.04,
   "end": 311.64,
   "text": "لکن متن آیه و تأویلش در خصوص حضرت زهراست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 311.64,
   "end": 315.42,
   "text": "حضرت جبرائیل در عالم بالا به پیغمبر اشاره میکنه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 315.42,
   "end": 318.54,
   "text": "یوم-- خداوند این چنین مگه نفرموده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 318.54,
   "end": 324.26,
   "text": "یا رسول الله که و یومئذ يفرح المؤمنون این روزی‌ست که مؤمنین خوشحال میشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 324.26,
   "end": 328.28,
   "text": "مؤمنین هم هر کجای قرآن اومد مطلق فرمودن محبین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 328.28,
   "end": 331.36,
   "text": "اهل بیت علیهم الصلاة والسلام هستند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 331.36,
   "end": 333.06,
   "text": "يفرح المؤمنون به چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 333.06,
   "end": 340.1,
   "text": "بنصر الله. ينصر من يشاء وهو العزيز--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 340.1,
   "end": 343.48,
   "text": "عزيز رحيم. بعد اینجا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 343.48,
   "end": 349.38,
   "text": "وقتی اشاره میکنه به این، چون پیغمبر سؤال کرده بود چرا منسوره در آسمان‌ها دیگه درسته؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 349.38,
   "end": 352.44,
   "text": "حضرت جبرائیل مبناشو رو این آیه قرار میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 352.44,
   "end": 355.56,
   "text": "در حقیقت یعنی تأویل این آیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 355.56,
   "end": 362.98,
   "text": "حضرت زهراست و نصرت الهی هر کج-- هر کجا که باشه بانی اون نصرت حضرت زهراست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 362.98,
   "end": 368.02,
   "text": "یعنی اهل ایمان نصرتشون رو از حضرت زهرا سلام الله علیها می‌گیرن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 368.02,
   "end": 374.5,
   "text": "لذا بزرگان فرمودن که اون نصرالله یا نصرت الله هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 374.5,
   "end": 376.8,
   "text": "حالا شما اینو بذارید رو اون بخشی که،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 376.8,
   "end": 381.92,
   "text": "اون فرمولی که گفته بودیم. در چه صورت نصرت الهی میاد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 381.92,
   "end": 388.1,
   "text": "وقتی که ت-- ع-عنابه بیاد به همراه تسلیم و تبعیت، خدا گناهان رو می‌بخشه، نصرت میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 388.1,
   "end": 392.08,
   "text": "این نصرت از کجا میاد؟ از حضرت زهرا سلام الله علیها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 392.08,
   "end": 394.56,
   "text": "اینم مطلقه، برا همه. اصلاً به غیر از این نمیشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 394.56,
   "end": 396.98,
   "text": "اصلاً نمیشه کسی رو خدا ببخشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 396.98,
   "end": 402.0,
   "text": "به غیر از طریق فاطمه زهرا چون نصرت خدا و شعطمش اونجاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 402.0,
   "end": 404.9,
   "text": "این آیات و مبناش که قرار دادن برای اثبات این موضوع.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 404.9,
   "end": 409.78,
   "text": "پس هر وقت ما به حال عنابه افتادیم، ببینید تو عنابه چه چیزهایی خوابیده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 409.78,
   "end": 413.5,
   "text": "عنابه‌ای که تو دلش تسلیم و تبعیت داشته باشه انسان رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 413.5,
   "end": 417.72,
   "text": "به حضرت زهرا سلام الله علیها می‌رسونه و خانم او رو یاری میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 417.72,
   "end": 422.36,
   "text": "عنابه چیز کمی نیست. قلب مرید جایگاهش خیلی بالاست در این عالم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 422.36,
   "end": 427.86,
   "text": "حالا یه آیه دیگه داریم \"إن تنصروا الله ينصركم ويثبت أقدامكم\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 427.86,
   "end": 431.2,
   "text": "اگه خدا رو یاری بدید، خدا هم به شما یاری میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 431.2,
   "end": 433.82,
   "text": "اگر خدا نصرتش نبود یعنی چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 433.82,
   "end": 437.78,
   "text": "یعنی ما یاری ندادیم. یاری ما چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 437.78,
   "end": 440.84,
   "text": "یعنی اینکه حضرت زهرا رو یاری بدید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 440.84,
   "end": 443.04,
   "text": "گفت از این جهت منصور است چون دو وجهی؛",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 443.04,
   "end": 446.52,
   "text": "یکی اینکه شما یاری‌ش میدید، یکی هم او شما رو یاری میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 446.52,
   "end": 449.54,
   "text": "پس اینکه \"إن تنصروا الله\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 449.54,
   "end": 452.44,
   "text": "میشه چی؟ بگذاریدش کنار اون آیه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 452.44,
   "end": 459.32,
   "text": "آیه سوره روم. یعنی که اگر فاطمه زهرا رو یاری دادید،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 459.32,
   "end": 463.04,
   "text": "خدا یاریتون میده. \"ينصركم\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 463.04,
   "end": 468.54,
   "text": "اگر نصرتون به زهرای مرضیه رسید \"ينصركم\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 468.54,
   "end": 472.48,
   "text": "بعد چه اتفاقی می‌افته؟ کسی که حضرت زهرا رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 472.48,
   "end": 476.94,
   "text": "در مسیر ولایت که حالا این خودش بحث مبسوطیه، یعنی چی یاری رسوندن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 476.94,
   "end": 479.74,
   "text": "خودش ده تا منبر می‌طلبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 479.74,
   "end": 485.94,
   "text": "بدون اغراق عرض کنم. این چی-- نتیجه‌ی همه‌ی این بحث‌ها چی میشه قربونتون برم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 485.94,
   "end": 490.26,
   "text": "\"ويثبت أقدامكم\" محکم‌تون می‌کنه حضرت زهرا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 490.26,
   "end": 496.42,
   "text": "ثبات قدم میده، ثبات اندیشه و رأی و قلب مطمئن یعنی از عنابه می‌رسید به اطمینان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 496.42,
   "end": 498.68,
   "text": "لذا می‌بینید سادات تو عالم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 498.68,
   "end": 502.22,
   "text": "همه کاره‌ان، محکم‌ان، بزرگان از سادات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 502.22,
   "end": 507.06,
   "text": "و هر کس که تو مسیر حضرت زهرا قرار می‌گیره، چنان محکم وایمیسته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 507.06,
   "end": 511.86,
   "text": "سر امثال شهید حججی‌ها که اونطوری مقتدرانه وایمیستن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 511.86,
   "end": 515.1,
   "text": "چیه فکر می‌کنید؟ انقدر که ایشون به حضرت زهرا ارادت داشته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 515.1,
   "end": 517.32,
   "text": "من درآوردم از تو زندگی نامه‌ش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 517.32,
   "end": 519.82,
   "text": "اصلاً سر-- خب انگشتر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 519.82,
   "end": 522.66,
   "text": "عقیق، عرض کنم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 522.66,
   "end": 526.06,
   "text": "دور نجف تو دستش بوده وقت شهادت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 526.06,
   "end": 531.46,
   "text": "خانمش میگن ر-- اون وقتی می‌خواست بره داد روش تراشیدن یا زهرا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 531.46,
   "end": 535.5,
   "text": "رو دور نجفش. یعنی این نشون میده الا-- ارادتش به حضرت زهرا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 535.5,
   "end": 540.28,
   "text": "شهدا همه‌شون سر و رمز اینکه شهید شدن حضرت زهرا بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 540.28,
   "end": 543.46,
   "text": "اونا رفتن نصرت بدن، حضرت زهرا نصرتشون داد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 543.46,
   "end": 547.88,
   "text": "اون‌ها رو شاهد بر عالم کرد و به مقام \"إِنْ دَرَبْ بِهِمْ يَرْزَقُهُمْ\" رسوند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 547.88,
   "end": 551.52,
   "text": "ببینید عنابه این چجوری پهلوش می‌خوره به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 551.52,
   "end": 555.44,
   "text": "موضوع حضرت زهرا و تو خود حدیث مفصل بخوان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 555.44,
   "end": 559.02,
   "text": "از این مجمل. اما اونایی که باید یاری می‌کردن بی بی رو تو این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 559.02,
   "end": 567.08,
   "text": "ایام نصرت می‌دادن حضرت زهرا، دختر پیغمبر رو چه بلایی سر حضرت زهرا آوردن که فرمود اگر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 567.08,
   "end": 573.7,
   "text": "ظلمی که به من فاطمه دختر پیغمبر شد بر روزها وارد میشد همچون پاره‌های",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 573.7,
   "end": 575.94,
   "text": "شب تار میشدند این روزها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 575.94,
   "end": 579.98,
   "text": "این عمق مصیبتی که بر حضرت زهرا سلام الله علیها وارد شد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 579.98,
   "end": 583.38,
   "text": "که دیگه قصد روضه ندارم. انشاالله که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 583.38,
   "end": 590.68,
   "text": "عاقبت هممون زیر سایه حضرت زهرا سلام الله علیها ختم به خیر بشه به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 590.68,
   "end": 594.18,
   "text": "اللهم صل على",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 594.18,
   "end": 596.48,
   "text": "محمد و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 596.48,
   "end": 600.42,
   "text": "آل محمد و عجل فرجهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}