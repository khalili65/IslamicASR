 "chapters": [
  {
   "index": 0,
   "title": "## خمس پول ذخیره‌شده برای ازدواج",
   "start": 0.38,
   "end": 94.1
  },
  {
   "index": 1,
   "title": "## توبه‌نامه و برکات سورهٔ نوح",
   "start": 94.1,
   "end": 126.96
  },
  {
   "index": 2,
   "title": "## سنت خدا؛ کشاندن به انابه",
   "start": 126.96,
   "end": 442.61
  },
  {
   "index": 3,
   "title": "## داستان گناهکار بنی‌اسرائیل",
   "start": 442.61,
   "end": 629.41
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.38,
   "end": 2.92,
   "text": "بسم الله الرحمن الرحیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 2.92,
   "end": 10.32,
   "text": "به نستعین. السلام علیک یا داعی الله و ربانی ایاته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 10.32,
   "end": 14.02,
   "text": "السلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 14.02,
   "end": 17.64,
   "text": "ما احکامی رو که این چند ماه داریم میگیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 17.64,
   "end": 19.22,
   "text": "همه پیرامون نماز بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 19.22,
   "end": 23.62,
   "text": "لکن یکی از عزیزان چه سوالی کردن من",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 23.62,
   "end": 25.94,
   "text": "همین جوابش رو به عنوان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 25.94,
   "end": 30.74,
   "text": "حکم فقهی امروز عرض می‌کنم که سؤال شده به فتوای رهبری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 30.74,
   "end": 37.26,
   "text": "اگر کسی برای ازدواج پول ذخیره کنه و چند سال هم بگذره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 37.26,
   "end": 41.26,
   "text": "فعلا نتونسته ازدواج کنه ولی پول رو برای ازدواج ذخیره کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 41.26,
   "end": 43.72,
   "text": "خب این خمسش چی میشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 43.72,
   "end": 46.26,
   "text": "ببینید عزیزم به طور کلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 46.26,
   "end": 51.4,
   "text": "به انواع مختلف استفتائات که امروز دیدم از رهبری عزیزمون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 51.4,
   "end": 54.76,
   "text": "برای هر چیزی انسان پول ذخیره کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 54.76,
   "end": 57.74,
   "text": "اگر سال بهش بگذره خمس بهش تعلق می‌گیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 57.74,
   "end": 65.22,
   "text": "می‌خواد برای ازدواج باشه، می‌خواد برای خونه باشه، می‌خواد برای هر چیزی باشه حتی برای ضروریات زندگی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 65.22,
   "end": 69.76,
   "text": "تا اون پول بدل به جنس نشده سال بهش خورد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 69.76,
   "end": 74.12,
   "text": "خمس بهش تعلق می‌گیره. این یه حکم کلی‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 74.12,
   "end": 77.54,
   "text": "اما به فضل الهی رد شیم بریم به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 77.54,
   "end": 81.82,
   "text": "قلب منیب برسیم. ما قلب مختوم رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 81.82,
   "end": 87.94,
   "text": "نکاتی رو عرض کردیم. امروز قلب منیب رو اجازه بدید مختصری درباره‌ش صحبت کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 87.94,
   "end": 94.1,
   "text": "در قرآن یکی از قلب‌هایی که ازش نام برده شده قلب منیب است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 94.1,
   "end": 98.54,
   "text": "کسی که عنابه می‌کنه و به سمت خدا برمی‌گرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 98.54,
   "end": 102.9,
   "text": "منیب رو من فرهنگ لغت رو دقت کردم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 102.9,
   "end": 105.94,
   "text": "غالباً به دو تا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 105.94,
   "end": 108.84,
   "text": "تعبیر و ترجمه اکتفا کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 108.84,
   "end": 112.04,
   "text": "یکی باران بسیار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 112.04,
   "end": 114.78,
   "text": "و دیگری زیبایی بهار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 114.78,
   "end": 118.58,
   "text": "تو فرهنگ لغت عربی به فارسی هم اینا اومده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 118.58,
   "end": 122.54,
   "text": "یکی باران بسیار رو بهش میگن منیب یا عنابه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 122.54,
   "end": 127.7,
   "text": "یکی هم به-- زیبایی بهار شکوفه‌هایی که بهار میده و اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 127.7,
   "end": 132.92,
   "text": "طراوتی که داره به این حالت میگن حالت عنابه طبیعت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 132.92,
   "end": 138.74,
   "text": "که به بار می‌نشینند. در حقیقت کسی که صاحب قلب منیب است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 138.74,
   "end": 141.44,
   "text": "قلبش به بار نشسته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 141.44,
   "end": 144.52,
   "text": "و زیبا خواهد شد، جلوه گری می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 144.52,
   "end": 147.5,
   "text": "حالا این‌ها رو باید بعداً توضیح بدیم یعنی چی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 147.5,
   "end": 152.24,
   "text": "در کتاب مفردات مرحوم راغب اصفهانی هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 152.24,
   "end": 154.52,
   "text": "گفته منیب از عنابه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 154.52,
   "end": 159.3,
   "text": "میاد در لغت به معنی برگشتن به سوی خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 159.3,
   "end": 164.02,
   "text": "با توجه، توبه و اخلاص در عمل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 164.02,
   "end": 165.82,
   "text": "یعنی این‌ها باید توأمان باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 165.82,
   "end": 170.02,
   "text": "توبه می‌کنه، متوجه خداست اما با اخلاص.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 170.02,
   "end": 172.52,
   "text": "برای منافع دنیوی نمیاد توبه کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 172.52,
   "end": 175.6,
   "text": "بگه خب حالا بریم توبه کنیم belki رزق‌مون زیاد بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 175.6,
   "end": 179.36,
   "text": "این‌ها هم نیت‌های خالصی نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 179.36,
   "end": 184.28,
   "text": "آقای مکارم در تفسیر نمونه این چنین فرموده در خصوص",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 184.28,
   "end": 187.62,
   "text": "منیب یا کسی که صاحب قلب منیب است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 187.62,
   "end": 190.2,
   "text": "فرموده در اصطلاح قرآن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 190.2,
   "end": 193.1,
   "text": "به شخص منیب چی میگن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 193.1,
   "end": 197.06,
   "text": "آقای مکارم می‌فرماید در اصطلاح قرآن یعنی شخص",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 197.06,
   "end": 200.08,
   "text": "همیشه متوجه خدا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 200.08,
   "end": 203.08,
   "text": "کسی که همیشه متوجه خداست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 203.08,
   "end": 205.92,
   "text": "و به اطاعت او رو آورد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 205.92,
   "end": 211.56,
   "text": "و از هر گناه و لغزشی توبه نماید و این حال را، اینجا دقت کنید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 211.56,
   "end": 218.34,
   "text": "و این حال را تا پایان عمر ادامه دهد و با همین حالت وارد عرصه محشر شود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 218.34,
   "end": 225.04,
   "text": "کسی که تا آخر لحظه نفس آخر عمرش حالت برگشت به سمت خدا داره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 225.04,
   "end": 228.9,
   "text": "حالت توبه و استغفار داره، ببینید such such کسی میگن منیب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 228.9,
   "end": 231.72,
   "text": "نه اینکه یه بار کسی بره حالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 231.72,
   "end": 237.34,
   "text": "مسجد یا شب قدر بیاد قرآن سرش بذاره توبه کنه، نه！تو-- پس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 237.34,
   "end": 244.3,
   "text": "اون حالا مستغفر هست. اما منیب کسیه که دائماً در حال بر-- دائماً مشغول استغفاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 244.3,
   "end": 251.2,
   "text": "به محض اینکه به قول امیرالمؤمنین علیه الصلاة والسلام به محض اینکه کار خطایی ازش سر زد، همون لحظه برمی‌گرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 251.2,
   "end": 253.86,
   "text": "همون لحظه بلافاصله بعد از-- لذا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 253.86,
   "end": 256.74,
   "text": "امیرالمؤمنین فرمود خوشا به حال کسانی که زیر هر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 256.74,
   "end": 259.38,
   "text": "گناهشون یک استغفار ثبت شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 259.38,
   "end": 261.62,
   "text": "این استغفار زیر هر گناه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 261.62,
   "end": 264.78,
   "text": "مال سال‌های بعد از گناه نیست، مال همون لحظه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 264.78,
   "end": 269.02,
   "text": "بذار یکی اومد خدمت امیرالمؤمنین علیه الصلاة والسلام گفت آقا من",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 269.02,
   "end": 272.52,
   "text": "چه کنم؟ شما فرمودید همه چی تو استغفاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 272.52,
   "end": 278.78,
   "text": "آیه قرآن هم هست. بارش باران، فرزنددار شدن، نمی‌دونم کثرت مال، اینا همه تو استغفاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 278.78,
   "end": 282.12,
   "text": "در حالت عنابه است. من استغفار زیاد می‌کنم اما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 282.12,
   "end": 285.0,
   "text": "این‌ها رو ندارم. حضرت فرمود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 285.0,
   "end": 288.18,
   "text": "برای هر گناهی باید استغفار می‌کردی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 288.18,
   "end": 294.34,
   "text": "بعد شمرد حضرت. یه توبه نامه‌ای امیرالمؤمنین بهش یاد داد هفتاد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 294.34,
   "end": 297.9,
   "text": "دسته گناه رو میگه باید این‌ها رو دسته‌بندی کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 297.9,
   "end": 301.7,
   "text": "مولا یک توبه، توبه نامه عجیبی‌ست من اینو دارم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 301.7,
   "end": 306.36,
   "text": "یک توبه نامه برای منیبین و مستغفرین عجیب هم هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 306.36,
   "end": 310.36,
   "text": "دسته‌بندی کرده مولا اینطوری باید به خدا پناه ببریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 310.36,
   "end": 315.94,
   "text": "یعنی حالا یادت رفته آن به آن باید انسان به سمت خدا حرکت کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 315.94,
   "end": 319.96,
   "text": "و برکتی که در این عنابه هست و این حالت آن به آن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 319.96,
   "end": 322.58,
   "text": "استغفاره در درگاه خداست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 322.58,
   "end": 325.3,
   "text": "که طبق سوره نوح",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 325.3,
   "end": 330.66,
   "text": "می‌فرماید باران بر سر شما نازل میشه، بچه‌دار حتی می‌شید، خدا بهتون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 330.66,
   "end": 332.84,
   "text": "یمدد کن به اموال و بنین،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 332.84,
   "end": 336.14,
   "text": "مالتونو زیاد می‌کنه، بچه‌هاتونو زیاد می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 336.14,
   "end": 339.8,
   "text": "حالا یه داستانی زایل این آیه هست که بعداً عرض می‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 339.8,
   "end": 343.38,
   "text": "همه جور برکات. تا جایی که آقای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 343.38,
   "end": 348.76,
   "text": "بهجت رحمة الله علیه هر کسی هر سوالی ازش می‌کرد، آقا گرم مثلاً مالیه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 348.76,
   "end": 352.88,
   "text": "گرم اینه که بچه‌دار نمی‌شم، گرم اینه که حال خوش ندارم، گرم...",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 352.88,
   "end": 355.54,
   "text": "هرچی میگفت می‌فرمود استغفار، کثرت استغفار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 355.54,
   "end": 358.64,
   "text": "همش آقای بهجت می‌گفت استغفار، استغفار، استغفار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 358.64,
   "end": 360.74,
   "text": "اینو از امیرالمؤمنین یاد گرفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 360.74,
   "end": 365.29,
   "text": "اصلاً عنابه به شما دقت کنید یکی از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 365.29,
   "end": 368.47,
   "text": "حالا شیب بحثمون این باشه که جمع‌بندی کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 368.47,
   "end": 372.79,
   "text": "یکی از کارهایی که خدا با بندگانش می‌کنه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 372.79,
   "end": 375.07,
   "text": "انقدر که خدا ارحم الراحمینه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 375.07,
   "end": 380.11,
   "text": "او رو به سمتی می‌کشونه که با حالت انابه برگرده به سمت خودش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 380.11,
   "end": 385.93,
   "text": "شما دقت کنید غالب اولیاء خدا آخر عمرشون زمین‌گیر میشن، مریض میشن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 385.93,
   "end": 389.65,
   "text": "تو بستر می‌افتن یا به اون چیزی که می‌خواستن نمی‌رسن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 389.65,
   "end": 391.95,
   "text": "عرفت الله بفصل الارائم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 391.95,
   "end": 396.41,
   "text": "عزائم امیرالمؤمنین رخ میده یعنی چیزی که می‌خواستن نمی‌رسن، یه چیز دیگه میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 396.41,
   "end": 398.87,
   "text": "برای اینکه بفهمن اراده‌ای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 398.87,
   "end": 407.19,
   "text": "فوق اراده اون‌هاست و با حالت انکسار و انابه و اینکه هیچم و همه چی تویی برگردن به سمت خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 407.19,
   "end": 411.95,
   "text": "این کار خداست. حتی گناه، شما نگاه نکنید الان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 411.95,
   "end": 416.09,
   "text": "حالا فرصت نیست ولی من ثابت می‌کنم اکثر مردم بهشتی میشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 416.09,
   "end": 417.87,
   "text": "یعنی خدا می‌خواد اینطور باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 417.87,
   "end": 422.53,
   "text": "ارحم الراحمین یعنی این. ما همه رو گناهکار می‌بینیم و بد و جهنمی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 422.53,
   "end": 425.93,
   "text": "قرآن میگه اکثرهم لا يعقلون، لا يفقهون، لا يتدبرون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 425.93,
   "end": 432.95,
   "text": "اما خدا اینطوری نیست. خدا از همین لا يعقلون‌ها، لا يتدبرون‌ها ل-- شده لحظه آخر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 432.95,
   "end": 434.61,
   "text": "یه منيب می‌سازه و می‌بره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 434.61,
   "end": 438.73,
   "text": "او دنبال بهانه است. مثل من و شما نیست که کاهی رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 438.73,
   "end": 442.41,
   "text": "کوه کنه و روایت داره که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 442.41,
   "end": 446.21,
   "text": "ب-- در زمان بنی‌اسرائیل حالا یه مصداق من عرض کنم و تمام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 446.21,
   "end": 449.65,
   "text": "در زمان بنی‌اسرائیل یه گناهکاری بود خیلی گناه می‌کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 449.65,
   "end": 451.41,
   "text": "یعنی دیگه همه از دستش عاصی بودند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 451.41,
   "end": 457.47,
   "text": "تو روایت هم میگن که انقدر این گناه می‌کرد، شهره‌ی بازار بود تا جایی که به پیغمبر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 457.47,
   "end": 461.47,
   "text": "خدا حضرت موسی علیه النبيین و آله و علیه الصلاة والسلام شکایت کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 461.47,
   "end": 467.29,
   "text": "کدوم یکی از ما از یه گناهکار رفتیم به مرجعی شکایت کردیم فلانی دیگه حدشو گذرونده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 467.29,
   "end": 470.65,
   "text": "یعنی انقدر اهل گناه بود. موسی هم به خدا گله کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 470.65,
   "end": 473.83,
   "text": "خدا فرمود تبعیدش کن از شهر بیرونش کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 473.83,
   "end": 477.47,
   "text": "حضرت موسی اینو از شهر بیرون کرد رفت به یه شهر دیگه پناه برد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 477.47,
   "end": 480.45,
   "text": "خدا فرمود موسی برو از اون شهر هم بیرونش کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 480.45,
   "end": 484.17,
   "text": "ببین این کار خداست. ظاهراً داره می‌زنه، تشنه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 484.17,
   "end": 487.35,
   "text": "تنبیهه اما می‌خواد برش گردونه به سمت خودش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 487.35,
   "end": 489.29,
   "text": "این کار خداست، سنت خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 489.29,
   "end": 492.31,
   "text": "آواره‌ش کرد. رفت به یه غاری پناه برد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 492.31,
   "end": 496.13,
   "text": "هیچکس هم نبود نه بهش غذا بده، نه آب بده، نه تیمارش کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 496.13,
   "end": 500.15,
   "text": "حالش بد شد، انقدر گریه کرد حالش بد شد، بیمار شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 500.15,
   "end": 506.19,
   "text": "لحظات آخر گریه‌ش گرفت که خدایا اگه همسرم بود، اگر فرزندانم بودند، پدر و مادرم بودند،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 506.19,
   "end": 508.23,
   "text": "منو تو این وضع رها نمی‌کردند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 508.23,
   "end": 510.87,
   "text": "تو که خدای منی، تو که خالق منی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 510.87,
   "end": 512.71,
   "text": "کاری نداره برات، ما رو ببخش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 512.71,
   "end": 515.55,
   "text": "تو ب-- تو مثل برای ما مثل پدر و مادر باش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 515.55,
   "end": 519.91,
   "text": "از این حرفا شروع کرد زدن. حرفایی که تو خلوت غوغا می‌کنه با خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 519.91,
   "end": 524.25,
   "text": "حرف دلتو بزنی. تو همین حالت تو روایت میگه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 524.25,
   "end": 530.31,
   "text": "خدای منان فرشته‌هایی رو به شکل پدر، مادرش و همسرش و فرزندانش کرد، اومدن تو غار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 530.31,
   "end": 535.99,
   "text": "بهش رسیدگی کردن. لحظات آخر با چشمش روشن شد از خونوادش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 535.99,
   "end": 541.01,
   "text": "گ-گفت خدایا ممنونتم که حاجت منو دادی و آه کشید و تمام کرد و مرد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 541.01,
   "end": 543.53,
   "text": "و از خدا لحظات آخر خواست که او را ببخشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 543.53,
   "end": 549.89,
   "text": "این کار خداست. بعد خدا به موسی کلیم الله دستور داد برو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 549.89,
   "end": 552.11,
   "text": "بدن فلان دوست ما،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 552.11,
   "end": 557.21,
   "text": "محب ما، بنده خوب ما فلان جا تو یه غاری مرده بردار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 557.21,
   "end": 559.03,
   "text": "بهش نماز بخون، دفنش کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 559.03,
   "end": 561.23,
   "text": "حضرت موسی رفت، یه دلم با خودش برد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 561.23,
   "end": 563.93,
   "text": "خدا پیغام داده این چیه؟ رفت دید اِ!",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 563.93,
   "end": 565.61,
   "text": "این که شکل همون جوونه‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 565.61,
   "end": 570.87,
   "text": "حالا خیلی هم ژولیده شده بود بر اثر کثرت انابه و گریه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 570.87,
   "end": 574.11,
   "text": "گفت خدایا این همون جوون نیست که تبعیدش کردی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 574.11,
   "end": 578.07,
   "text": "خدا فرمود چرا همونه. این چ-- به من گفتی بیام اینو دفن کنم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 578.07,
   "end": 580.43,
   "text": "بنده خوب تو. خدا پرده‌برداری کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 580.43,
   "end": 585.75,
   "text": "فرمود لحظات آخر چنان انکسار و شکستگی در قلبش ایجاد شد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 585.75,
   "end": 594.03,
   "text": "و چنان پشیمانی نسبت به اعمال ق-قبلش درش ایجاد شد که به یکباره همه گناه‌هاش تکفیر شد و من بخشیدمش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 594.03,
   "end": 600.13,
   "text": "اون حالا بنده خوب منه. من و شما نمی‌تونیم تشخیص بدیم کی آخرش شره، کی آخرش خیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 600.13,
   "end": 603.15,
   "text": "ولی انشاالله با این خدایی که ما داریم اما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 603.15,
   "end": 606.69,
   "text": "با راه‌ها و سنت‌هایی که ما رو به اون حالت بکشونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 606.69,
   "end": 611.11,
   "text": "انابه از بهترین دست‌آویزهایی‌ست که انسان می‌تونه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 611.11,
   "end": 614.61,
   "text": "به دریای رحمت وسیع رحمت خدا خودش رو برسونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 614.61,
   "end": 617.75,
   "text": "انشاالله که عاقبتمون ختم بخیر بشه به ذکر",
   "kind": "speech",
   "chapter": null,
