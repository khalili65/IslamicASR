 "chapters": [
  {
   "index": 0,
   "title": "## حدیث پیامبر دربارهٔ احاطهٔ شیاطین بر قلوب",
   "start": 58.84,
   "end": 230.38
  },
  {
   "index": 1,
   "title": "## توبه، استغفار و انابه؛ استقرار و استمرار",
   "start": 230.38,
   "end": 370.34
  },
  {
   "index": 2,
   "title": "## سخن آقا نجفی؛ غبار آینهٔ دل",
   "start": 370.34,
   "end": 599.72
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 1.58,
   "end": 5.1,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 5.1,
   "end": 8.64,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 8.64,
   "end": 12.82,
   "text": "آiate. السلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 12.82,
   "end": 16.16,
   "text": "از رهبر عزیزمون استفتاء شده که در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 16.16,
   "end": 18.82,
   "text": "بعضی از کشورهایی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 18.82,
   "end": 22.98,
   "text": "افق خیلی از هم دورن مثلاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 22.98,
   "end": 25.52,
   "text": "اذان صبح حدود دو،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 25.52,
   "end": 29.32,
   "text": "دو و خورده‌ای مثلاً سحره در تابستان،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 29.32,
   "end": 32.32,
   "text": "دو مثلاً با نیمه شب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 32.32,
   "end": 38.26,
   "text": "حدوداً یا مثلاً چهار طول آفتاب میشه بعد از اون طرفم حدود بیست و سه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 38.26,
   "end": 42.82,
   "text": "غروب آفتاب میشه؛ یعنی یازده شب ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 42.82,
   "end": 47.78,
   "text": "خب اینجا چی میشه؟ سؤال شده از آقا که اینجا نماز و روزه به چه صورته؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 47.78,
   "end": 51.84,
   "text": "مثل دانمارک، نروژ اینا اینطورین تو تابستان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 51.84,
   "end": 54.82,
   "text": "یعنی مثلاً حدود سه ساعت تقریباً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 54.82,
   "end": 57.82,
   "text": "شب میبینن با خودشون، بقیه همش روزه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 57.82,
   "end": 59.56,
   "text": "خب چه باید کرد برای روزه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 59.56,
   "end": 65.48,
   "text": "خب خیلی سخته برای روزe تقریباً بیست و یکی دو ساعت باید طرف روزه باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 65.48,
   "end": 68.62,
   "text": "بعد آقا فرمودن که فرقی نمی‌کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 68.62,
   "end": 74.88,
   "text": "باید طبق همون افق محلی که مستقر هستید طبق همون نماز و روزه رو بگیرید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 74.88,
   "end": 77.78,
   "text": "نماز رو همونطور با همون افق باید بخونید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 77.78,
   "end": 79.54,
   "text": "روزه رم باید همونطور بگیرید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 79.54,
   "end": 82.64,
   "text": "همون بیست و دو سه ساعت باید طرف روزه باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 82.64,
   "end": 87.64,
   "text": "لکن آقا فرمودن اگر گرفتن روزه مقدور نیست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 87.64,
   "end": 92.6,
   "text": "در چنین وضعیتی بر استطاعت بدنی انسان یا اینکه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 92.6,
   "end": 99.34,
   "text": "به حرج میفته اینا طرف فرمودن که اداش واجب نیست یعنی ساقط میشه وجوبش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 99.34,
   "end": 103.64,
   "text": "اما قضا اش واجبه. یعنی بعداً که استطاعت پیدا کرد اگر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 103.64,
   "end": 107.7,
   "text": "رفت یه افق جای دیگه ای که دید می‌تونه به اون ساعتش روزه‌شو بگیره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 107.7,
   "end": 109.88,
   "text": "واجبه که قضاشو ادا کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 109.88,
   "end": 113.8,
   "text": "ولی تو اون وضعیت در عسر و حرج",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 113.8,
   "end": 118.26,
   "text": "ادای اون روزه ساقط میشه وجوبش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 118.26,
   "end": 121.7,
   "text": "خب در خصوص قلب منیب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 121.7,
   "end": 124.4,
   "text": "برای اینکه اهمیت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 124.4,
   "end": 129.02,
   "text": "بحثی که ما داریم می‌کنیم متوجه این اهمیت بشیم اجازه بدید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 129.02,
   "end": 132.5,
   "text": "اشاره کنم به یک حدیث عجیبی از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 132.5,
   "end": 135.6,
   "text": "پیامبر عظیم الشأن اسلام در کتاب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 135.6,
   "end": 141.86,
   "text": "مرحوم مجلسی، بهار مرحوم مجلسی رحمة الله علیه جض شصت و هفت، صفحه پنجاه و نه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 141.86,
   "end": 145.7,
   "text": "در باب، باب القلب و صلاحه این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 145.7,
   "end": 153.16,
   "text": "حدیث وارد شده. لولا ان الشياطين يحومون على قلوب بني آدم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 153.16,
   "end": 156.04,
   "text": "اگه شیطان‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 156.04,
   "end": 158.64,
   "text": "نمی‌اومدن دور",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 158.64,
   "end": 164.26,
   "text": "قلب بچه‌های آدم دور قلب انسان رو بگیرن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 164.26,
   "end": 167.38,
   "text": "اجتماع نمی‌کردن و احاطه نمی‌کردن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 167.38,
   "end": 173.12,
   "text": "قلوب بنی آدم رو، ببین بحث قلب اومده دیگه على قلوب بنی آدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 173.12,
   "end": 178.5,
   "text": "اگر شیاطین احاطه نمی‌کردن قلوب بنی آدم رو چه اتفاقی می‌افتاد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 178.5,
   "end": 183.1,
   "text": "به نظر شما؟ لنظروا الى الملكوت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 183.1,
   "end": 187.32,
   "text": "لام تأکیده، قطعاً اینا نظر می‌انداختن به ملکوت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 187.32,
   "end": 190.22,
   "text": "یعنی همه پرده‌ها براشون کنار می‌رفت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 190.22,
   "end": 195.64,
   "text": "و می‌تونستن پشت پرده‌ها رو ببینن، ملکوت رو ببینن، عالم بالا و اولی رو ببینن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 195.64,
   "end": 199.32,
   "text": "ما در ناصوتیم، ملکوت عالم بالاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 199.32,
   "end": 207.92,
   "text": "این خیلی ضرر بزرگیه که احاطه شیاطین بر قلوب ما باعث شده ما چشممون بسته بشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 207.92,
   "end": 209.88,
   "text": "و وجه ملکوت رو نتونیم ببینیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 209.88,
   "end": 212.7,
   "text": "پس این که انسان قلب رو بشناسه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 212.7,
   "end": 216.92,
   "text": "و آسیب‌هاش رو شناسایی کنه و یک جداری دورش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 216.92,
   "end": 223.5,
   "text": "ایجاد کنه، حصاری ایجاد کنه که نتونن شیاطین يحومون على قلوب بني آدم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 223.5,
   "end": 226.0,
   "text": "اتفاق نیفته، خیلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 226.0,
   "end": 230.26,
   "text": "رشد بزرگی انسان می‌کنه، از عالم طبیعت کنده میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 230.26,
   "end": 236.98,
   "text": "ما بحث توبه و استغفار و عنابه رو و ج-وجه تفاوت‌هاشو تا حدی با هم کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 236.98,
   "end": 240.58,
   "text": "فقط اینو بدونیم که هر کجا توبه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 240.58,
   "end": 246.64,
   "text": "آن به آن شد و مستمر شد، ما چون گفتیم از وجوه توبه استقراره دیگه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 246.64,
   "end": 249.78,
   "text": "یک مقامه، مستقر میشه در مقام توبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 249.78,
   "end": 251.8,
   "text": "اما وقتی همین مستقر،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 251.8,
   "end": 258.08,
   "text": "مستمر شد یعنی استمرار توبه ایجاد شد میشه عنابه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 258.08,
   "end": 261.84,
   "text": "مثل أستغفر الله و أتوب الیک توضیح دادیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 261.84,
   "end": 266.16,
   "text": "أتوب فعل مضارعه و دلالت بر استمرار داره، همون عنابه‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 266.16,
   "end": 268.74,
   "text": "یه حدیث بسیار خوبی هم هست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 268.74,
   "end": 272.88,
   "text": "اتفاقاً حرفی از عنابه توش نیست، حرف از استغفاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 272.88,
   "end": 277.78,
   "text": "اما چون پیامبر عظیم الشأن اسلام در این حدیث عجیب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 277.78,
   "end": 286.34,
   "text": "میگه در همه لحظات و شؤونات زندگیتون مستغفر باشید، در حقیقت داره می‌فرماید عنابه کنید، منیب باشید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 286.34,
   "end": 288.04,
   "text": "تا چه اتفاقی بیفته؟ برای چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 288.04,
   "end": 290.7,
   "text": "ما چرا نیاز به عنابه داریم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 290.7,
   "end": 294.0,
   "text": "می‌فرماید اكثروا من الاستغفار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 294.0,
   "end": 298.12,
   "text": "بسیار، ببین کثرت آورده یعنی میشه عنابه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 298.12,
   "end": 299.7,
   "text": "بسیار استغفار کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 299.7,
   "end": 303.56,
   "text": "چطوری؟ کجا؟ می‌فرماید في بيوتكم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 303.56,
   "end": 308.74,
   "text": "تو خونه‌هاتون و في مجالسكم هرجا میرید با کسی می‌شینید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 308.74,
   "end": 311.52,
   "text": "و على موائدكم عجب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 311.52,
   "end": 317.78,
   "text": "سر سفره هم می‌شینید. ما تا کی شن-- مثلاً شنیده بودیم سر سفره استغفار کنید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 317.78,
   "end": 320.9,
   "text": "و على-- و في أسواقكم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 320.9,
   "end": 327.6,
   "text": "و في أسواقكم جمع سوقه یعنی در بازارها تون، یعنی در محل کارتون هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 327.6,
   "end": 331.3,
   "text": "اكثروا، اكثروا من الاستغفار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 331.3,
   "end": 337.22,
   "text": "و في طرقكم تو راه دارید راه می‌رید، اینور اونور می‌رید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 337.22,
   "end": 343.12,
   "text": "چیکار کنید؟ زیاد استغفار کنید و أينما كنتم هر کجا که بودید،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 343.12,
   "end": 348.28,
   "text": "عجب! میگه هر کجا بودید استغفار کنید، هر جا دیگه أينما كنتم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 348.28,
   "end": 352.8,
   "text": "هیچی اینجا ااا از قلم نیفتاده با این جمله پیغمبر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 352.8,
   "end": 355.92,
   "text": "خب این یعنی عنابه دیگه. یعنی دائماً مشغول عنابه باشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 355.92,
   "end": 358.68,
   "text": "چرا؟ از خصوصیات عنابه چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 358.68,
   "end": 361.22,
   "text": "اینجا پرده‌برداری کرده حضرت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 361.22,
   "end": 365.58,
   "text": "که لا تدرون فإنكم لا تدرون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 365.58,
   "end": 367.44,
   "text": "متى تنزل المغفرة.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 367.44,
   "end": 372.12,
   "text": "شما نمی‌دونید که کی مغفرت خدا نازل میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 372.12,
   "end": 377.56,
   "text": "چون بی‌خبرید دائما مشغول استغفار یعنی حالت عنابه داشته باشید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 377.56,
   "end": 380.34,
   "text": "بلکه برسید به اون مغفرت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 380.34,
   "end": 382.98,
   "text": "مغفرت مثل چی می‌مونه؟ نزول مغفرت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 382.98,
   "end": 385.24,
   "text": "یه مثال بزنم. ببینید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 385.24,
   "end": 387.36,
   "text": "مثال همه فهم بزنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 387.36,
   "end": 391.42,
   "text": "الان این برفی که اومد به نظر شما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 391.42,
   "end": 394.8,
   "text": "رحمت خداست یا عذر ข อ لا نعمته؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 394.8,
   "end": 397.46,
   "text": "برف چیه بالاخره؟ رحمته دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 397.46,
   "end": 402.18,
   "text": "همه میگیم رحمت خداست. نزول برکات آسمانی و چقدر دعا کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 402.18,
   "end": 406.78,
   "text": "اما همین برف اومد چقدر ما رو به دردسر انداخت، بیچاره‌مون کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 406.78,
   "end": 412.5,
   "text": "دو سه روز بعضیا سر کار نیومدن، مدارس تعطیل شد، خیلیا مریض شدن، خوردن زمین دست پاشون شکست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 412.5,
   "end": 415.58,
   "text": "راه بسته شد. اوه تا دلت بخواد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 415.58,
   "end": 417.48,
   "text": "خب چرا این اتفاق می‌افته؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 417.48,
   "end": 423.9,
   "text": "مگه رحمت نیست؟ ما بستر رو آماده برای رحمت خدا و مغفرت خدا نکردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 423.9,
   "end": 426.0,
   "text": "اگر بستر رو آماده کنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 426.0,
   "end": 429.84,
   "text": "وقتی رحمت نازل شد تو به نحو احسن استفاده می‌کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 429.84,
   "end": 433.92,
   "text": "خانه‌ای که سقف شیروانیه اصلاً نیاز به برف روبی داره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 433.92,
   "end": 436.44,
   "text": "نه. خودش می‌ریزه، آب میشه می‌ریزه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 436.44,
   "end": 438.12,
   "text": "هیچ لطمه‌ای هم به خونه نمی‌زنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 438.12,
   "end": 444.44,
   "text": "بستر سازی کرده. اما باید تا برف میاد آخ، آخ، آخ باید بریم دو ساعت وایسیم با رو-- پارو کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 444.44,
   "end": 447.68,
   "text": "درستا غیر از اینه؟ چون بستر آماده نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 447.68,
   "end": 452.32,
   "text": "پس باید بستر آماده-- یه مثال دیگه‌ش مثل خدا رحمت کنه آستاد علی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 452.32,
   "end": 454.6,
   "text": "نجفی مربوط به آقا نجفی رحمت الله علیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 454.6,
   "end": 457.22,
   "text": "ایشون می‌فرمودن که شما که دوست دار--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 457.22,
   "end": 464.96,
   "text": "کلام ایشونه دقیقا. شما که دوست دارید دل‌هاتون سالم بمونه چرا از استغفار ک-کثرت استغفار غافلید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 464.96,
   "end": 467.8,
   "text": "با کثرت استغفاررر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 467.8,
   "end": 472.08,
   "text": "غبار روی آینه‌ی دلتون رو پاک کنید تا نور خدا بتابه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 472.08,
   "end": 475.54,
   "text": "یعنی چی؟ نور، رحمت و مغفرت خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 475.54,
   "end": 478.64,
   "text": "وجه نور و مغفرت خدا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 478.64,
   "end": 486.14,
   "text": "نور الهیه. خب این نور وقتی تابید اگر رو آینه غبار باشه به نظر شما این آینه منعکس می‌کنه نور رو؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 486.14,
   "end": 490.0,
   "text": "نه. با چی این غبار برطرف میشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 490.0,
   "end": 492.94,
   "text": "با کثرت استغفار. با چی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 492.94,
   "end": 497.1,
   "text": "بستر آماده‌ی ریزش رحمت و مغفرت خدا میشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 497.1,
   "end": 500.32,
   "text": "برای ما؟ با کثرت-- با حالت عنابه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 500.32,
   "end": 507.34,
   "text": "عنابه باعث میشه وجود ما، زمین وجود ما آماده بشه برای نزول برکات آسمانی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 507.34,
   "end": 512.98,
   "text": "برای نزول رحمات و مغفرت الهی که اگر این نشد می‌زنه لطمه می‌زنه به ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 512.98,
   "end": 516.9,
   "text": "یه دفعه برفی می‌باره یعنی یه دفعه رحمت الهی مثل همین حدیث.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 516.9,
   "end": 521.16,
   "text": "می‌گه شما که نمی‌دونید رحمت خدا کی نازل میشه، مغفرت خدا کی نازل میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 521.16,
   "end": 524.58,
   "text": "دائما مشغول عنابه باشید یعنی بستر رو آماده نگه دارید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 524.58,
   "end": 528.86,
   "text": "یه دفعه نازل میشه و تو آماده نیستی، خراب میشی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 528.86,
   "end": 532.78,
   "text": "یه دفعه آقا ظهور می‌کنه تو آماده نیستی، خودتو داغون می‌کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 532.78,
   "end": 539.38,
   "text": "یه دفعه یه وجهی پیش میاد که آقا بری خط مقدم جنگ اصلاً حمله می‌کنند جنگ خیابونی میشه، تو آماده نیستی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 539.38,
   "end": 546.12,
   "text": "قسط و قرض و بدهکاری و بدبختی و کوفت و زحمت‌ها رو نماز صبحت هم قضا شده، با زنت دعوات شده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 546.12,
   "end": 549.16,
   "text": "انقدر بدهکاری داره اصلاً حوصله این حرفا رو نداری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 549.16,
   "end": 551.5,
   "text": "جهاد چیه؟ یهو می‌ریزن تو خونه بزن بکش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 551.5,
   "end": 554.8,
   "text": "تمام. یعنی اصلاً آمادگی نداری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 554.8,
   "end": 557.8,
   "text": "در صورتی که کسی آماده‌ست به قول",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 557.8,
   "end": 560.12,
   "text": "یه حدیثی هست که میگه آخری-- حالا می‌فهمید یعنی چی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 560.12,
   "end": 565.8,
   "text": "آخرالزمان دوست‌دارا و یاران خاص آقا دائما شمشیرشون زیر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 565.8,
   "end": 569.86,
   "text": "بسترشون وقتی می‌خوابن شمشیرشون زیر بسترشون هست، آماده‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 569.86,
   "end": 572.64,
   "text": "یعنی این که ما از فردا شب شمشیر بذاریم زیر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 572.64,
   "end": 574.86,
   "text": "لشت مثلا تشکمون، نه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 574.86,
   "end": 579.72,
   "text": "وسلاح البکا سلاح مؤمن اشکشه، آهشه، دعاشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 579.72,
   "end": 582.5,
   "text": "یعنی آماده‌ست. دائما مشغول عنابه‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 582.5,
   "end": 586.04,
   "text": "آماده‌ی ریزش رحمت خدا از انواع مختلفشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 586.04,
   "end": 587.98,
   "text": "ان شا الله که همیشه آماده باشیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 587.98,
   "end": 589.58,
   "text": "و عاقبتمون ختم به خیر بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 589.58,
   "end": 592.5,
   "text": "به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 592.5,
   "end": 596.14,
   "text": "اللهم صل على",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 596.14,
   "end": 599.72,
   "text": "محمد و آل محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}