 },
 "chapters": [
  {
   "index": 0,
   "title": "## بقاء بر میت؛ اجازه از أعلمِ حیّ",
   "start": 0.12,
   "end": 261.24
  },
  {
   "index": 1,
   "title": "## قلبِ منیب؛ راه به اطمینان",
   "start": 261.24,
   "end": 365.97
  },
  {
   "index": 2,
   "title": "## فطرت و انابه؛ شرک عارضی است",
   "start": 365.97,
   "end": 414.53
  },
  {
   "index": 3,
   "title": "بلافاصله ادامه چنین است:",
   "start": 414.53,
   "end": 450.01
  },
  {
   "index": 4,
   "title": "## انابه حتی بیرون از هیئتِ عبادت؛ حکایتِ مادر",
   "start": 450.01,
   "end": 758.01
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.12,
   "end": 3.3,
   "text": "بسم الله الرحمن الرحیم ربنا استعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 3.3,
   "end": 6.98,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 6.98,
   "end": 11.06,
   "text": "ایاته. السلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 11.06,
   "end": 16.96,
   "text": "دیروز که اینجا نماز تموم شد چند تا از دوستان نشستن یه بحث فقهی کردیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 16.96,
   "end": 19.94,
   "text": "و یه موضوعی رو خیلی شبهه داشتن ازش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 19.94,
   "end": 22.08,
   "text": "من به صورت کلی این فقه رو، این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 22.08,
   "end": 27.18,
   "text": "حکم رو عرض کنم که باز هم برای اطمینان امروز از دفتر آقا پرسیدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 27.18,
   "end": 29.8,
   "text": "ببینید عزیزانی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 29.8,
   "end": 34.24,
   "text": "قبلاً از یه مرجعی تقلید می‌کردن، ایشون از دنیا رفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 34.24,
   "end": 37.2,
   "text": "مثلا حضرت امام، خود مـ، خود من",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 37.2,
   "end": 39.5,
   "text": "از حضرت امام تقلید که از دنیا رفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 39.5,
   "end": 51.1,
   "text": "در صورتی می‌تونند بقاء بر میت بگیرن که اون مرجع أعلم زنده ای که اختیار کردن ایشون اجازه بقاء بر میت داده باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 51.1,
   "end": 52.7,
   "text": "حالا غالباً هم اجازه دادن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 52.7,
   "end": 55.34,
   "text": "مثلا رهبر عزیزمون که الان ازشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 55.34,
   "end": 59.26,
   "text": "اجازه گرفتن، ایشون اجازه‌ی بر بقاء بر میت رو چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 59.26,
   "end": 62.32,
   "text": "دادن. حالا مسئله اینجاست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 62.32,
   "end": 66.48,
   "text": "آیا من اجازه دارم که در بعضی از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 66.48,
   "end": 69.04,
   "text": "فتواها از رهبر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 69.04,
   "end": 76.3,
   "text": "تأیید مثلا اِاِاِ تأییدیه بگیرم و طبق فتوای رهبر عمل کنم و بعضی فتواها رو طبق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 76.3,
   "end": 80.8,
   "text": "فتوای حضرت امام یا مرجعی که از دنیا رفته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 80.8,
   "end": 82.56,
   "text": "چجوریه؟ ببینید سؤال دیگه‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 82.56,
   "end": 87.02,
   "text": "یعنی من وقتی اجازه‌ی بقای بر میت از رهبر گرفتم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 87.02,
   "end": 91.82,
   "text": "باید تمام احکام رو دیگه از این به بعد از رهبر تقر، تبعیت کنم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 91.82,
   "end": 101.22,
   "text": "نمیشه از امام کنم؟ یا نه بالعکس همه رو باید از امام چون اجازه‌ی بقای بر میت گرفتم همه رو از امام تبعیت کنم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 101.22,
   "end": 105.76,
   "text": "یا میشه هر کدومو دوست داشتم از رهبر هر کدومو دوست داشتم از امام؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 105.76,
   "end": 109.46,
   "text": "مثلا امام تهران رو بلاد کبیره می‌دونه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 109.46,
   "end": 111.3,
   "text": "رهبر بلاد کبیره نمی‌دونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 111.3,
   "end": 114.4,
   "text": "این فق، خیلی حکمش فرق می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 114.4,
   "end": 116.94,
   "text": "خب من چه کنم؟ می‌تونم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 116.94,
   "end": 119.66,
   "text": "هر وقت دوست داشتم عشقم کشید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 119.66,
   "end": 126.32,
   "text": "بگم امام می‌دونست اینجا تبعیت از امام کنم، هر وقت دوست داشتم بگم رهبر نمی‌دونه تبعیت از...",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 126.32,
   "end": 128.6,
   "text": "این حکم کلیش به این صورت‌ه. ببینید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 128.6,
   "end": 133.22,
   "text": "ما وقتی اجازه‌ی بقاء بر میت گرفتیم از رهبر،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 133.22,
   "end": 141.14,
   "text": "می‌تونیم هر چند درصدی که دوست داریم از امام تبعیت کنیم مثلا شصت درصد احکام رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 141.14,
   "end": 147.22,
   "text": "از امام تبعیت کنیم، چهل درصد از رهبر یا بالعکس ده درصد، هفتاد درصد فرق نمی‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 147.22,
   "end": 152.68,
   "text": "یا صد درصد از امام، صد درصد از رهبر، همه‌شو جایزیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 152.68,
   "end": 156.66,
   "text": "لکن نکته اینجاست که اگر من",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 156.66,
   "end": 164.2,
   "text": "فق، اِاِاِ حکمی رو از امام تبعیت کردم دیگه نمی‌تونم رجوع کنم به رهبر توی اون حکم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 164.2,
   "end": 167.26,
   "text": "اینو دقت کنید، اینو معمولاً دقت نمی‌کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 167.26,
   "end": 171.1,
   "text": "نمیشه یه روز یه حکمی که متضاد هست مثل بلاد کبیره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 171.1,
   "end": 173.62,
   "text": "یه روز از امام تبعیت کنم، یه روز از رهبر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 173.62,
   "end": 180.58,
   "text": "نمیشه. وقتی یک بار از امام تبعیت کردم دیگه باید این حکم رو تا آخرش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 180.58,
   "end": 183.9,
   "text": "از امام تبعیت کنم. یا اگه از رهبر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 183.9,
   "end": 188.92,
   "text": "تبعیت کردم دیگه نمی‌تونم توی اون حکم برگردم به حکم امام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 188.92,
   "end": 192.06,
   "text": "تا آخر عمرم باید همون حکم رو باقی بمونم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 192.06,
   "end": 194.3,
   "text": "درست شد؟ این یه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 194.3,
   "end": 196.5,
   "text": "موضوعی که ما باید بهش دقت کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 196.5,
   "end": 198.48,
   "text": "حالا اگر چنانچه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 198.48,
   "end": 204.92,
   "text": "ما خواستیم همه احکام و بقاء بر میت بر امام باقی بمونه، همه رو از امام باقی بذاریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 204.92,
   "end": 210.44,
   "text": "خب اینجا می‌تونیم برگردیم مثلا بعد یه دونه حکم رو از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 210.44,
   "end": 215.68,
   "text": "رهبر، نه هیچ اجازه نداریم مگر در احکام مستحضر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 215.68,
   "end": 219.18,
   "text": "یعنی احکامی که امام براش فتوا نداره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 219.18,
   "end": 225.92,
   "text": "یعنی جدید پیش اومده مثل لقاح در حر، مثلا رحم مادر و چنین چیزا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 225.92,
   "end": 228.46,
   "text": "متوجه شدین قشنگ؟ پس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 228.46,
   "end": 234.56,
   "text": "ما ف، در صورتی که از یه حکم امام تبعیت کردیم دیگه نمی‌تونیم برگردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 234.56,
   "end": 242.52,
   "text": "در صورتی که یه حکم رهبری رو تبعیت کردیم دیگه نمی‌تونیم برگردیم توی اون حکم، دیگه تا آخر باید باقی بمونیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 242.52,
   "end": 245.06,
   "text": "و اما می‌تونیم درصد بگیریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 245.06,
   "end": 250.48,
   "text": "من مثلا تو این احکام، این درصد از احکام از امام تبعیت می‌کنم همیشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 250.48,
   "end": 254.22,
   "text": "این درصد از احکام همیشه از رهبر تبعیت می‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 254.22,
   "end": 261.24,
   "text": "اینو حواستون باشه. خب حالا که احکامو مجبور شدم یه ذره leftش بدم که قشنگ جا بیفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 261.24,
   "end": 263.3,
   "text": "بحث منیبین رو من دو شکاف می‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 263.3,
   "end": 267.3,
   "text": "می‌خواستم فاصله یا اختلاف بین توبه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 267.3,
   "end": 270.1,
   "text": "استغفار و عنابه رو بگم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 270.1,
   "end": 275.1,
   "text": "و وجوهی رو از عنابه براتون بگم چون تو، ما تو بحث قلب منیب هستیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 275.1,
   "end": 278.2,
   "text": "حالا اون بحث اختلاف بین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 278.2,
   "end": 285.72,
   "text": "شخص منیب، شخص تائب و شخص مستغفر رو که ظاهراً هر سه تاش یه ترجمه داره رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 285.72,
   "end": 289.34,
   "text": "جلسه بعد میگیم. الان یه چند تا وجه از منیب رو عرض کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 289.34,
   "end": 293.32,
   "text": "بر اساس آیه بیست و هفت و بیست و هشت رعد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 293.32,
   "end": 295.52,
   "text": "برید بخونید من بخشی از آیه رو می‌خونم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 295.52,
   "end": 299.14,
   "text": "\"و يهدي اليه من عاب\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 299.14,
   "end": 301.96,
   "text": "کسانی که منیب‌اند،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 301.96,
   "end": 304.28,
   "text": "خدا اینا رو هدایت کرده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 304.28,
   "end": 309.78,
   "text": "و به عنابه، به حالت عنابه افتادن اینا خصوصیتی دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 309.78,
   "end": 312.36,
   "text": "آیه بعدش خصوصیت اینا رو می‌شماره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 312.36,
   "end": 317.1,
   "text": "\"الذین آمنوا و تطمئن قلوبهم بذكر الله\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 317.1,
   "end": 321.18,
   "text": "اینا کسایین که ایمان دارن، دل دادن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 321.18,
   "end": 325.3,
   "text": "یعنی اعتقاداتشون باور دارن قلباً فقط",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 325.3,
   "end": 333.14,
   "text": "این نیست که بدانند، باور دارن بر اساس دل دادگیشون عمل می‌کنن و تطمئن و عجب، دید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 333.14,
   "end": 342.4,
   "text": "دیروز عرض کردم راه رسیدن به بالاترین مراتیب که قلب اطمینانه است همین قلب منیب هست این سندشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 342.4,
   "end": 345.16,
   "text": "یعنی میگه کسانی منیب میشن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 345.16,
   "end": 347.38,
   "text": "یا کسانی منیب هستن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 347.38,
   "end": 350.6,
   "text": "که در نهایت می‌رسن به قلب مطمئن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 350.6,
   "end": 353.0,
   "text": "یعنی از عنابه شروع می‌کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 353.0,
   "end": 355.48,
   "text": "عنابه هم که عرض کردیم که یعنی چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 355.48,
   "end": 359.46,
   "text": "یعنی آن به آن انسان برگرده به سمت خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 359.46,
   "end": 362.69,
   "text": "نکته دوم اینجاست که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 362.69,
   "end": 365.97,
   "text": "کسانی که منیب هستن این حالت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 365.97,
   "end": 371.71,
   "text": "بازگشت به خدا، خدا به صورت فطری در وجودشون نهادینه کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 371.71,
   "end": 374.33,
   "text": "چون شما وقتی بعضی از آیات رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 374.33,
   "end": 378.47,
   "text": "بررسی می‌کنی می‌بینی چقدر خدا تاکید داره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 378.47,
   "end": 382.43,
   "text": "که اینو درگیر کنه با مسائل عارضی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 382.43,
   "end": 387.59,
   "text": "مسائل عارضی مثل شرکه. توحید رو تا بحث توحید میشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 387.59,
   "end": 391.61,
   "text": "و متوجه منیبین میشه خدا تو قرآن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 391.61,
   "end": 393.89,
   "text": "سریع بحث شرک رو هم کنارش میاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 393.89,
   "end": 398.89,
   "text": "دو تا نمونه من به شما میگم. آیه سی و سی و یک روم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 398.89,
   "end": 401.33,
   "text": "و آیه سی و سه روم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 401.33,
   "end": 405.49,
   "text": "آیه سی و سی و یک روم میگه \"فَأَقِمْ وَجْهَكَ لِلدِّينِ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 405.49,
   "end": 412.27,
   "text": "حَنِيفًا فِطْرَتَ اللَّهِ الَّتِي فَطَرَ النَّاسَ عَلَيْهَا\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 412.27,
   "end": 416.95,
   "text": "می‌فرماید این کس-- این فطرت که خدا قرار داده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 416.95,
   "end": 420.61,
   "text": "که خدا بر همه این فطرت رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 420.61,
   "end": 424.05,
   "text": "بالفطره قرار داده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 424.05,
   "end": 428.31,
   "text": "میگه تو رو کن به اون خدایی که این فطرتو در وجودت قرار داده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 428.31,
   "end": 434.07,
   "text": "بلافاصله اول آیه بعد شروع میشه با \"مُنِيبِينَ إِلَيْهِ\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 434.07,
   "end": 438.97,
   "text": "یعنی کسانی که، کسانی منيبن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 438.97,
   "end": 441.51,
   "text": "فطرتشون رو توجه کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 441.51,
   "end": 445.53,
   "text": "فطرت هم کارش چیه؟ کارش توحیده؛",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 445.53,
   "end": 448.37,
   "text": "یعنی یادآوردن خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 448.37,
   "end": 452.35,
   "text": "این یه نکته. تو آیه بعد می‌فرماید و اذ-- آیه سی و سه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 452.35,
   "end": 458.29,
   "text": "\"وَإِذَا مَسَّ النَّاسَ الضُّرُّ دَعَوْا رَبَّهُمْ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 458.29,
   "end": 461.89,
   "text": "مُنِيبِينَ إِلَيْهِ\". وقتی که یه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 461.89,
   "end": 464.49,
   "text": "خیلی عجیبه این و متاسفانه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 464.49,
   "end": 469.03,
   "text": "خیلی ما گرفتاریم. میگه وقتی که ذره، پریشونی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 469.03,
   "end": 474.27,
   "text": "مصیبتی براشون وارد میشه \"مُنِيبِينَ إِلَيْهِ\" سریع برمی‌گردن به سمت خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 474.27,
   "end": 477.09,
   "text": "درست شد؟ اما \"ثُمَّ إِذَا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 477.09,
   "end": 479.19,
   "text": "أَذَاقَهُمْ مِنْهُ رَحْمَةً\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 479.19,
   "end": 482.97,
   "text": "وقتی یه خوب و خوشی از طرف خدا بهشون می‌رسه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 482.97,
   "end": 486.39,
   "text": "\"إِذَا فَرِيقٌ مِنْهُمْ\" بعضیاشون \"بَرَبِّهِمْ مُشْرِكُونَ\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 486.39,
   "end": 489.99,
   "text": "میگه مشرکون. بحث شرک رو سریع میاره خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 489.99,
   "end": 493.05,
   "text": "وقتی اون مصیبت برطرف شد، مشرک میشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 493.05,
   "end": 496.23,
   "text": "اینجا شرک رو قرار داده در برابر چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 496.23,
   "end": 501.91,
   "text": "توحید. در حقیقت توحید فطری است، شرک عارضی است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 501.91,
   "end": 504.09,
   "text": "بعد چه کسایی توجه به این دارن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 504.09,
   "end": 507.17,
   "text": "منیبین. میگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 507.17,
   "end": 511.27,
   "text": "کسانی که \"دَعَوْا رَبَّهُمْ\" خداشونو می‌خونن تو پریشونی‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 511.27,
   "end": 514.33,
   "text": "\"مُنِيبِينَ إِلَيْهِ\". چرا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 514.33,
   "end": 518.41,
   "text": "چون پریشون شدن، دل از همه جا کندن، مستر شدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 518.41,
   "end": 523.29,
   "text": "این نشون میده که منیب کسی‌ست که دل از همه جا کنده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 523.29,
   "end": 525.95,
   "text": "اگر کسی یه گوشه دلش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 525.95,
   "end": 531.47,
   "text": "جایی به غیر از خدا تعلق پیدا کرد، اون دیگه به منیب، یعنی منیب نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 531.47,
   "end": 538.49,
   "text": "به حالت انابه نیفتاده. مفسرین عزیز فرمودن که انابه متضمن چهار امره؛",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 538.49,
   "end": 541.47,
   "text": "یعنی چهار تا امر با هم باید باشه دقت کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 541.47,
   "end": 543.67,
   "text": "یه دونش نباشه شخص منیب نیست؛",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 543.67,
   "end": 547.55,
   "text": "یعنی نمی‌تونه به شاهراه اطمینان برسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 547.55,
   "end": 549.67,
   "text": "اول فرمودن محبت خدا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 549.67,
   "end": 551.93,
   "text": "این طرف باید عاشق خدا بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 551.93,
   "end": 555.73,
   "text": "دو فرمودن خضوع برای خدا، در برابر خدا افتاده حاله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 555.73,
   "end": 560.01,
   "text": "یعنی اینکه عاشقه بعضیا یکیو دوست دارن سر کله‌شم می‌زنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 560.01,
   "end": 563.83,
   "text": "وقتی دوست، وقتی خیلی باهاش رفیق نیستن میگن آقای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 563.83,
   "end": 569.11,
   "text": "فلانی وقتی که یه ذره رفیقشن آقاش میفته بعد اسمم می‌شکونن و اسم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 569.11,
   "end": 572.57,
   "text": "مثقر استفاده می‌کنن بعدشم چیزای دیگه روش میذارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 572.57,
   "end": 575.91,
   "text": "اینه که خضوع نیستش که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 575.91,
   "end": 580.13,
   "text": "سوم اقبال به او یعنی توجه داشته باشن به او.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 580.13,
   "end": 585.87,
   "text": "خب یکی یکیو دوست داره وقتی هم می‌بینش خاضه نسبت بهشه اما توجهی نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 585.87,
   "end": 587.75,
   "text": "نه زنگی می‌زنه حالشو بپرسه نه هیچی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 587.75,
   "end": 592.91,
   "text": "اینم باز فایده نداره. آخریشم اعراض از غیر اوئه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 592.91,
   "end": 598.21,
   "text": "از غیر خدا باید اعراض کنی، پشت کنی به هر چیز و هرکس که غیر خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 598.21,
   "end": 602.49,
   "text": "چون اگر این چهار تا با هم بود تو منیب هستی و امید هست که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 602.49,
   "end": 605.03,
   "text": "آیات منیبین در خصوص ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 605.03,
   "end": 608.95,
   "text": "محقق بشه. و این نکته آخر این که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 608.95,
   "end": 615.37,
   "text": "میشه انسان در حالت ظاهراً غیر عبادت باشه اما منیب باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 615.37,
   "end": 618.11,
   "text": "چون منیب یعنی توجه کامل به خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 618.11,
   "end": 621.87,
   "text": "این چهار تا تزمنی که عرض کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 621.87,
   "end": 624.31,
   "text": "میشه انسان ظاهراً در حال عبادت نباشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 624.31,
   "end": 627.65,
   "text": "آدم عابد، آدم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 627.65,
   "end": 630.23,
   "text": "تائب خب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 630.23,
   "end": 637.27,
   "text": "در حال عبادت هست اما تمام وجودش شاید تو خود عبادت هم به خدا نباشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 637.27,
   "end": 642.11,
   "text": "اما منیب حتی در غیر عبادت هم توجهش به خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 642.11,
   "end": 647.87,
   "text": "مثال، چون من معمولاً با یه داستان مصداق میگم خوبتر جا بیفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 647.87,
   "end": 653.69,
   "text": "ختم کلام این که مطالعه می‌کردم در احوالات بعضی از بزرگان توی جلسه‌ای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 653.69,
   "end": 656.93,
   "text": "شیخ الشیوخ نشسته بودن و همه طلا و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 656.93,
   "end": 663.61,
   "text": "علما دورشون. بعد ایش-- هر کسی کشف و کرامتش رو در جلسه خصوصی بوده می‌گفتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 663.61,
   "end": 666.89,
   "text": "شیخ الشیوخ برمی‌گرده میگه که آقا جون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 666.89,
   "end": 671.51,
   "text": "اصل عبادت خدمت به خلقه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 671.51,
   "end": 673.45,
   "text": "اصل عبادت خدمت به خلق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 673.45,
   "end": 678.35,
   "text": "میگن چطور؟ هی هرکی از عبادتش و شبش و سحرش و اینا می‌گفتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 678.35,
   "end": 680.79,
   "text": "بعد اینو میگه. میگه یه طلبه‌ای بود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 680.79,
   "end": 683.87,
   "text": "که ایشون شاگرد خوبی بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 683.87,
   "end": 687.83,
   "text": "یه داداش داشت. اینا یکی از این داداش‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 687.83,
   "end": 690.17,
   "text": "یه مادر مری-- یه مادر مریضی داشتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 690.17,
   "end": 695.49,
   "text": "یکی از اینا به مادره رسیدگی می‌کرد، یکیشون فقط عبادت می‌کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 695.49,
   "end": 701.67,
   "text": "نمی‌رفت به مادره برسه. این عابد یه روز تو سجده خوابش میره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 701.67,
   "end": 709.87,
   "text": "یا از عالم غیب صدایی می‌شنوه که بهش میگن داداشت رو که به مادرش رسیدگی می‌کنه رو بخشیدیم، آمرزیدیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 709.87,
   "end": 713.05,
   "text": "و تو رو هم به خاطر او بخشیدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 713.05,
   "end": 714.99,
   "text": "از اون حالت که میاد بیرون ناراحت میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 714.99,
   "end": 718.47,
   "text": "میگه بابا من این همه دارم عبادت می‌کنم اون مثلاً عبادت نمی‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 718.47,
   "end": 721.33,
   "text": "چرا منو به خاطر او بخشیدند؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 721.33,
   "end": 724.95,
   "text": "دو مرتبه تو اون حالت صدای غیبی بهش،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 724.95,
   "end": 727.37,
   "text": "اینطور نهیب می‌زنه که چون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 727.37,
   "end": 730.93,
   "text": "خدا از عبادت تو بی‌نیاز است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 730.93,
   "end": 735.39,
   "text": "اما مادرت به کمک تو محتاج بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 735.39,
   "end": 743.63,
   "text": "این ختم کلام. یعنی در حقیقت میشه گفت میشه کسی ظاهراً هم خیلی عبادت نمی‌کنه، یه واجبشو انجام میده اما در خدمت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 743.63,
   "end": 746.49,
   "text": "خلقه و اون در حالت انابه‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 746.49,
   "end": 748.75,
   "text": "چون به خاطر خدا این کارو داره می‌کنه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 748.75,
   "end": 754.77,
   "text": "نه چیز دیگه. ان شا الله که عاقبت ما ختم به خیر بشه به ذکر صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 754.77,
   "end": 758.01,
   "text": "اللهم صل علی محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}