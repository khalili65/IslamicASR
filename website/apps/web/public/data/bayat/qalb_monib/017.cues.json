  },
  {
   "index": 1,
   "title": "## قلب منیب؛ انابه و تقوا",
   "start": 81.36,
   "end": 160.88
  },
  {
   "index": 2,
   "title": "## خاطرهٔ آیت‌الله موسوی لاری؛ مورچه",
   "start": 160.88,
   "end": 222.2
  },
  {
   "index": 3,
   "title": "## آیت‌الله خوانساری؛ گناه رجس است",
   "start": 222.2,
   "end": 459.92
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.12,
   "end": 3.84,
   "text": "بسم الله الرحمن الرحیم و به این استعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 3.84,
   "end": 6.52,
   "text": "السلام علیک یا داعی الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 6.52,
   "end": 8.6,
   "text": "و ربانی ایات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 8.6,
   "end": 12.2,
   "text": "سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 12.2,
   "end": 17.56,
   "text": "خب رسیدیم به شکیات باطل که نماز رو باطل میکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 17.56,
   "end": 23.8,
   "text": "عرض کردیم که در نمازهای دو رکعتی و سه رکعتی شک کردن سبب بطلان نماز میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 23.8,
   "end": 27.8,
   "text": "حالا این دو رکعتی اگر حتی قضای نماز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 27.8,
   "end": 32.58,
   "text": "باشه یا حتی اینکه نماز مسافر باشه؛",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 32.58,
   "end": 35.56,
   "text": "مثلا چهار رکعتی‌ها در سفر دو رکعتی میشه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 35.56,
   "end": 38.74,
   "text": "تو همونم اگر انسان شک کنه باطله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 38.74,
   "end": 41.52,
   "text": "نوع سوم شک باطل اینه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 41.52,
   "end": 44.5,
   "text": "به طور کلی یه طرف شک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 44.5,
   "end": 46.66,
   "text": "رو رکعت‌های نماز یک باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 46.66,
   "end": 52.98,
   "text": "یعنی طرف شک کنه یک رکعت خونده یا بیشتر، حالا دو، سه، چهار هرچی باشد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 52.98,
   "end": 56.72,
   "text": "یه طرف شک یک باشه این نشون میده که بابا تو که تو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 56.72,
   "end": 62.48,
   "text": "نمیدونی هنوز یک رکعت خوندی یا بیشتر آقا تعطیل کن این نماز به درد نمیخوره، باطله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 62.48,
   "end": 65.4,
   "text": "اما در خصوص قلب منیب نکته دیگه ای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 65.4,
   "end": 73.32,
   "text": "به هر حال هی استخراج میشه از این آیات بسیار شریف، آیه سی و یک سوره روم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 73.32,
   "end": 79.6,
   "text": "میفرماید منیبین الیه واتقوه واقیموا الصلاة ولا تكونوا من المشرکین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 79.6,
   "end": 84.2,
   "text": "سی و یک روم. بلافاصله بعد از اینکه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 84.2,
   "end": 88.58,
   "text": "ااا بحث عنابه رو اینجا خدا میفرماید که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 88.58,
   "end": 92.5,
   "text": "فاقم وجهک آیه قبلش میفرماید فاقم وجهک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 92.5,
   "end": 97.58,
   "text": "للدین حنیفا. رو کن به خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 97.58,
   "end": 99.6,
   "text": "میفرماید چی جوری رو کن به خدا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 99.6,
   "end": 104.24,
   "text": "منیبین الیه با حالت عنابه رو کن به خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 104.24,
   "end": 108.38,
   "text": "واتقوه بلافاصله تقوا رو پیش میکشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 108.38,
   "end": 112.96,
   "text": "در حقیقت اینجا میشه نتیجه گرفت که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 112.96,
   "end": 116.14,
   "text": "از آثار عنابه تقواست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 116.14,
   "end": 118.74,
   "text": "یعنی اگر کسی میخواد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 118.74,
   "end": 123.52,
   "text": "بفهمه که اهل عنابه شده یا نه، این همه ما حرف زدیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 123.52,
   "end": 129.3,
   "text": "از قلب منیب ببینه به تقوای الهی رسیده یا نه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 129.3,
   "end": 133.56,
   "text": "و این تقوا هم در عالم حرف اول رو میزنه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 133.56,
   "end": 138.36,
   "text": "یه قانون الهیه که ان اکرمکم عندالله اتقاکم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 138.36,
   "end": 144.18,
   "text": "چیزی هم که به تقوا انسان رو میکشونه درک این موضوعه که خدا یک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 144.18,
   "end": 149.74,
   "text": "خالق و یک اله بیشتر نداره و هرچی که او گفت رو چشمت بذاری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 149.74,
   "end": 152.26,
   "text": "فاصله ما با اولیای خدا هم همینه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 152.26,
   "end": 158.18,
   "text": "که ما شک میکنیم اما اون‌ها یقین کامل به ربوبیت خدا دارند و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 158.18,
   "end": 160.88,
   "text": "حرف خدا رو رو چشمشون میذارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 160.88,
   "end": 163.66,
   "text": "خدا رحمت کنه آیت الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 163.66,
   "end": 167.48,
   "text": "موسوی لاری رحمت الله علیه این عالم عظیم الشأن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 167.48,
   "end": 169.96,
   "text": "یه روز تو خاطراتشون من خودم ازشون شنیدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 169.96,
   "end": 173.34,
   "text": "می‌فرمایوند که زیر درخت، سایه درخت نشسته بودم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 173.34,
   "end": 175.98,
   "text": "یه مورچه‌ای از بغلم داره میره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 175.98,
   "end": 179.96,
   "text": "بهش گفتم وایسا. به مورچه گفتم وایسا دیدم اعتنا نکرد رفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 179.96,
   "end": 183.02,
   "text": "بهش گفتم آقا، آقا مورچه برگرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 183.02,
   "end": 185.74,
   "text": "دیدم اعتنا نکرد راهشو کشید رفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 185.74,
   "end": 188.12,
   "text": "پیش خودم تفکر کردم، تامل کردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 188.12,
   "end": 191.78,
   "text": "این حالات قلب منیبه‌ها. تامل کردم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 191.78,
   "end": 196.78,
   "text": "منی که توی مورچه نمی‌تونم تو این عالم تاث-تاثیر کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 196.78,
   "end": 199.52,
   "text": "نمی‌تونم جلوی مورچه رو بگیرم به چه درد می‌خوره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 199.52,
   "end": 206.94,
   "text": "چطور من انقدر ادعا دارم و گمان می‌کنم کسی هستم و چیزی هستم و عالم تحت تدبیر و اراده الهیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 206.94,
   "end": 213.46,
   "text": "ان الله بالغ امره. همه چی در-- وقتی این رو فهمیدی اون موقع دستور خدا رو چشمت میذاری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 213.46,
   "end": 219.18,
   "text": "نمیگی که حالا من هم یه ان قلتی دارم خدا رو این امر شما من هم فلان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 219.18,
   "end": 222.2,
   "text": "دیگه هرچی خدا گفت میگی چشم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 222.2,
   "end": 226.42,
   "text": "خدا رحمت کنه آقای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 226.42,
   "end": 231.32,
   "text": "آستاد احمد، حضرت آیت الله العظمی آستاد احمد خوانساری بزرگ، حالات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 231.32,
   "end": 235.06,
   "text": "عجیبی از ایشون میگن و بعضی از علما من شنیدم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 235.06,
   "end": 239.78,
   "text": "از یکی از اساتید اخلاق شنیدم که در ایشان شبهه عصمت داشتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 239.78,
   "end": 244.24,
   "text": "یعنی می‌گفتن ایشون ید تمیل به عصمت رسیده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 244.24,
   "end": 247.4,
   "text": "حالا رمز این عصمت، حالا این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 247.4,
   "end": 252.12,
   "text": "پاکی و دوری از گناهش رو یه روزی به یه جوونی گفته بود ایشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 252.12,
   "end": 253.72,
   "text": "با یک آیه خیلی جالب بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 253.72,
   "end": 255.94,
   "text": "من رفتم این آیه رو دقت کردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 255.94,
   "end": 259.7,
   "text": "ظاهرا آیه پیراهون تحریم و حرمت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 259.7,
   "end": 263.04,
   "text": "شراب است. آیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 263.04,
   "end": 266.38,
   "text": "عرض کنم خدمتتون نود مائده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 266.38,
   "end": 269.84,
   "text": "حالا یه بخشیشو که مربوط، مرتبط هست من می‌خونم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 269.84,
   "end": 273.16,
   "text": "آیه نود سوره مائده. برید ببینید ذیل آیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 273.16,
   "end": 274.72,
   "text": "شأن نزول‌هایی هم آوردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 274.72,
   "end": 280.24,
   "text": "حالا دو تا شأن نزولشو من سریع بگم در حرمت شراب یکیش اینه که در کتاب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 280.24,
   "end": 286.6,
   "text": "ااا در المنصور که یک تفسیر اهل تسنن S300 جلده دو صفحه سیصد و پونزده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 286.6,
   "end": 290.5,
   "text": "نوشته که سعد بن وقاص ادعا کرد که این آیه برای من نازل شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 290.5,
   "end": 293.0,
   "text": "چرا؟ مختصرش اینه که یکی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 293.0,
   "end": 296.26,
   "text": "قبل از اینکه این آیه نازل شه یه کسی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 296.26,
   "end": 300.32,
   "text": "مردمو جمع کرد خونه‌شو مهمونی داد و غذا داد و شراب هم خوردن با هم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 300.32,
   "end": 304.38,
   "text": "بعد که مغزشون گرم شد و قاطی کردن به قول ماها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 304.38,
   "end": 307.42,
   "text": "شروع کردن تفاخر کردن به چیزای بیخودی و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 307.42,
   "end": 311.32,
   "text": "بعد یه نفر اونجا یه استخوان شتر برداشت کوبید تو بینی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 311.32,
   "end": 316.66,
   "text": "سعد بن وقاص و شکافته شد و رفت پیش پیغمبر و پیغمبر همون لحظه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 316.66,
   "end": 318.62,
   "text": "الهام شد بهش این آیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 318.62,
   "end": 321.42,
   "text": "یه روایت دیگه خوب اینو شما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 321.42,
   "end": 324.36,
   "text": "بچه‌شیا بدونید. ااا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 324.36,
   "end": 329.88,
   "text": "عجیبم هستش که سند چند تا سند براش پیدا کردم تو کتاب‌های اهل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 329.88,
   "end": 332.9,
   "text": "تسنن. یکی مسند ابن ابی داووده، یکی سنا--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 332.9,
   "end": 335.54,
   "text": "نساییه، یکی ترمزیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 335.54,
   "end": 340.8,
   "text": "همشونم تصریح کردن از تفسیر فی الولاء جلد سه صفحه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 340.8,
   "end": 343.7,
   "text": "سی و سه که میگن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 343.7,
   "end": 346.4,
   "text": "دومی خیلی علاقه داشت به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 346.4,
   "end": 350.04,
   "text": "شراب. خیلی دوست داشت شراب بخوره و می‌خورد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 350.04,
   "end": 352.54,
   "text": "می‌دونید مثلا اون مشرک بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 352.54,
   "end": 357.0,
   "text": "بعد هی دعا می‌کرد که خدایا یه جوری به ما بفهمون بالاخره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 357.0,
   "end": 361.0,
   "text": "آیه روشنی برای ما بفرست که نظرت در رابطه با شراب چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 361.0,
   "end": 364.2,
   "text": "که این آیه بعد از درخواست این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 364.2,
   "end": 370.1,
   "text": "شخص نازل شد. حالا شأن نزول اینطوری داره ولی در هر حال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 370.1,
   "end": 374.7,
   "text": "انتهای آیه جمله‌ای رو گفته که مرحوم آقای خوانساری به اون جوان گفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 374.7,
   "end": 382.12,
   "text": "جریانش چیه بگم و تمام. اون جوونه بهش میگه آقای خوانساری فکر کنید الان رسیدید مرج-- مثلا محضر یه عالمه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 382.12,
   "end": 385.66,
   "text": "مرجع جلیلو Frage سوال کرد چطور میشه آدم عصمت پیدا کنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 385.66,
   "end": 388.92,
   "text": "اصلا میشه آدم گناه نکنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 388.92,
   "end": 391.78,
   "text": "ایشون جوابش جواب امام رضا بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 391.78,
   "end": 395.04,
   "text": "فرموده بود که تا حالا شما گمان کردی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 395.04,
   "end": 399.12,
   "text": "نجاست بخوری؟ تو دستشویی که نشستی شلوارتو اون رو ورداری بخوریش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 399.12,
   "end": 401.34,
   "text": "اصلا فکر کردی به این گفت؟ میگه نه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 401.34,
   "end": 404.18,
   "text": "جوونه میگه نه من تاحالا همچین فکری نکردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 404.18,
   "end": 411.88,
   "text": "آقای خوانساری هم می‌فرماید من از نوجوانی آیه نود سوره مائده رو که دیدم فهمیدم که گناه نجاست است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 411.88,
   "end": 414.06,
   "text": "مثل اینه که داری می‌خوری اون نجاستو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 414.06,
   "end": 417.1,
   "text": "برای همین برای همیشه خودم رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 417.1,
   "end": 420.54,
   "text": "پاک نگه داشتم از گناهان و اشاره کرد به این قسمت آیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 420.54,
   "end": 424.98,
   "text": "انه رجس من عمل الشيطان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 424.98,
   "end": 427.84,
   "text": "این ناپاکیه و از اول شیطانه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 427.84,
   "end": 429.94,
   "text": "اگر کسی اینو فهمید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 429.94,
   "end": 437.7,
   "text": "اون موقع است که نگه می‌داره اون چارچوب تقوا رو تو وجودش و روز به روز عنابش رشد می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 437.7,
   "end": 439.84,
   "text": "اون موقع نمازش نماز درست حسابی میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 439.84,
   "end": 444.06,
   "text": "چون بلافاصله بعد از واتقوه فرمود واقیموا الصلاة.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 444.06,
   "end": 446.2,
   "text": "اون موقع است که نمازش هم بهش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 446.2,
   "end": 451.52,
   "text": "مزه میده. ان شا الله عاقبت بخیر بشه با ذکر صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 451.52,
   "end": 459.92,
   "text": "اللهم صل علی محمد و آل محمد و عجل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}