 "chapters": [
  {
   "index": 0,
   "title": "## شک پس از نماز؛ بی‌اعتنایی",
   "start": 12.3,
   "end": 32.48
  },
  {
   "index": 1,
   "title": "## آیات انابه و قلب منیب",
   "start": 32.48,
   "end": 69.64
  },
  {
   "index": 2,
   "title": "آیهٔ سیزده سورهٔ غافر:",
   "start": 69.64,
   "end": 239.68
  },
  {
   "index": 3,
   "title": "## آینده‌نگری امام؛ سه هدف انقلاب",
   "start": 239.68,
   "end": 308.44
  },
  {
   "index": 4,
   "title": "## خواب امام و تعبیر آقای کشمیری",
   "start": 308.44,
   "end": 538.75
  },
  {
   "index": 5,
   "title": "## والشمس و ضحاها؛ نور پس از ظلمت",
   "start": 538.75,
   "end": 762.33
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.78,
   "end": 4.9,
   "text": "بسم الله الرحمن الرحیم و بهین استعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 4.9,
   "end": 8.64,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 8.64,
   "end": 12.3,
   "text": "آیاته سلامٌ علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 12.3,
   "end": 17.6,
   "text": "یکی دیگه از شک‌هایی که نباید بهش در نماز اعتنا کرد شک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 17.6,
   "end": 20.06,
   "text": "بعد از خود نمازه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 20.06,
   "end": 23.08,
   "text": "جلسه پیش گفتیم شک بعد از محل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 23.08,
   "end": 29.28,
   "text": "یعنی اینکه محل مثلا از سجده گذشتی شک کنی تو خود نماز از رکوع گذشتی شک کنی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 29.28,
   "end": 32.48,
   "text": "سجده انجام دادی، رکوع انجام-- اوه هیچ.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 32.48,
   "end": 38.34,
   "text": "اونم نباید اعتنا کنی. این میگه بعد از نماز کلا نماز تموم شد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 38.34,
   "end": 42.96,
   "text": "شک می‌کنی که مثلا بخشی از نماز رو درست خوندی یا نه، یه جزئش رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 42.96,
   "end": 47.82,
   "text": "دیگه میگه اعتنا نکن. تموم شد دیگه نماز تموم شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 47.82,
   "end": 51.84,
   "text": "دو سه تا آیه براتون بخونم ببینید برداشتمون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 51.84,
   "end": 54.5,
   "text": "از این آیات با این عقل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 54.5,
   "end": 56.94,
   "text": "کم بنده حقیر چی میشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 56.94,
   "end": 62.16,
   "text": "چون این آیات ربطی به بحث منیب و قلب منیب داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 62.16,
   "end": 64.84,
   "text": "اما نکته بسیار برجسته‌ای درش هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 64.84,
   "end": 69.64,
   "text": "یکی آیه سیزده سوره غافره می‌فرماید \"هو اللوی\" دقت کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 69.64,
   "end": 71.42,
   "text": "خدا خودش رو اینطوری معرفی کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 71.42,
   "end": 73.6,
   "text": "\"یریکم آیاته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 73.6,
   "end": 77.22,
   "text": "و ينزلکم من السماء رزقا\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 77.22,
   "end": 80.64,
   "text": "خدا کسیست که آیاتش رو برای شما آورده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 80.64,
   "end": 83.22,
   "text": "از آسمون برای شما رزق آورده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 83.22,
   "end": 90.14,
   "text": "\"وما يتذكر\" منتها خدا می‌فرماید صراحتا می‌فرماید اینو هر کسی نمی‌فهمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 90.14,
   "end": 93.1,
   "text": "متوجه این امر نمیشه \"وما يتذكر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 93.1,
   "end": 97.02,
   "text": "إلا\" یک عده فقط \"من ینیب\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 97.02,
   "end": 99.22,
   "text": "الا کسی که اهل عنابه‌ست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 99.22,
   "end": 101.08,
   "text": "یعنی دارای قلب منیب هست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 101.08,
   "end": 103.8,
   "text": "که یعنی د-دائما در حال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 103.8,
   "end": 107.26,
   "text": "رجوع به خداست. آن به آن به خدا توجه داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 107.26,
   "end": 111.12,
   "text": "در آیه دیگه‌ای در سوره قاف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 111.12,
   "end": 116.44,
   "text": "آیات شش و هفت و هشت رو که بررسی کنید انتهاش می‌فرماید \"تبصره\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 116.44,
   "end": 119.02,
   "text": "اشاره می‌کنه به، اه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 119.02,
   "end": 123.78,
   "text": "آسمان‌ها و زمین و جایگاه خدا، عظمت خدا در این خ-خلائق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 123.78,
   "end": 127.32,
   "text": "بعد می‌فرماید \"تبصره\" این‌ها یک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 127.32,
   "end": 132.44,
   "text": "بصیرتی می‌خواد. دقت به این‌ها و \"ذكرى\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 132.44,
   "end": 135.56,
   "text": "و این‌ها همه یک ذکر و یادآوری‌ست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 135.56,
   "end": 138.56,
   "text": "برای کی؟ \"لكل عبد\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 138.56,
   "end": 141.44,
   "text": "نون هم نه هر عبدی، \"منیب\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 141.44,
   "end": 144.8,
   "text": "بر بنده‌ای که به حالت عنابه رسیده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 144.8,
   "end": 149.74,
   "text": "اینم می‌تونه کشف کنه حقایق و کنح",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 149.74,
   "end": 153.86,
   "text": "رموز این عالم هستی رو به غیر از قلب منیب نمی‌تونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 153.86,
   "end": 157.62,
   "text": "باز یه آیه دیگه هم تبر-- زیاده حالا من تبرکاً عرض کنم آیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 157.62,
   "end": 161.0,
   "text": "نه سوره سبأ \"إن في ذلك",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 161.0,
   "end": 163.2,
   "text": "لآية\" باز بحث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 163.2,
   "end": 166.0,
   "text": "نظر انداختن به آسمان‌ها و زمین هست و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 166.0,
   "end": 168.5,
   "text": "انتهای سوره می‌فرماید \"إن في ذلك آية\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 168.5,
   "end": 171.52,
   "text": "\"إن في ذلك لآية\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 171.52,
   "end": 176.04,
   "text": "این چیزی که ما گفتیم دقت کنید به آسمان‌ها و زمین و چه وچه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 176.04,
   "end": 180.9,
   "text": "این یه نشانه‌ایست که هر کسی هم متوجه نمیشه فقط یه عده‌ای خاصی هستن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 180.9,
   "end": 183.72,
   "text": "اینا کیان که متوجه نشانه‌های خدااند؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 183.72,
   "end": 188.74,
   "text": "\"لكل عبد منيب\" دوباره اینجا داره تکرار می‌کنه خدا آیه صریح آیه قرآنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 188.74,
   "end": 191.84,
   "text": "فقط بندگان منیب می‌فهمن این آیات رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 191.84,
   "end": 195.68,
   "text": "کسانی که دائما به سمت خدا رجوع کرده باشن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 195.68,
   "end": 201.52,
   "text": "و اون هم البته خب ما عرض کردیم عنابه چون در قرآن هم در خصوص",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 201.52,
   "end": 207.94,
   "text": "گناهکاران واقع شده، کسی که گناه می‌کنه برمی‌گرده به سمت خدا و ترک معصیت می‌کنه و هم در خصوص",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 207.94,
   "end": 211.88,
   "text": "پ-پیامبران و انبیا نشون میده که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 211.88,
   "end": 216.68,
   "text": "این خب مربوط به درجات عالیه عنابه است، نه درجات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 216.68,
   "end": 224.4,
   "text": "ابتدایی و سفلی اون. در حقیقت اینطوری هم میشه گفت هر چقدر که انسان عنابش بیشتر شد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 224.4,
   "end": 228.02,
   "text": "تذکرش و فهمش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 228.02,
   "end": 233.14,
   "text": "و نکته سنجیش و رمز یابیش در این عالم هم بیشتر میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 233.14,
   "end": 238.5,
   "text": "تا جایی که می‌تونه حقایقی رو بفهمه از آینده که هر کسی نمی‌فهمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 238.5,
   "end": 240.94,
   "text": "که ما جل-- ما خوشحالیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 240.94,
   "end": 243.48,
   "text": "که الحمدالله طی تاریخ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 243.48,
   "end": 250.14,
   "text": "در جایگاه ولایت بعد از امام عصر ما کسایی قرار گرفتن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 250.14,
   "end": 256.54,
   "text": "تونستند آینده شناسی کنند، آینده نگری کنند و این‌ها بصیرت داشتند،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 256.54,
   "end": 260.88,
   "text": "متوجه بودند دارن چیکار می‌کنن و ما پشت سرشون راه افتادیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 260.88,
   "end": 262.94,
   "text": "مثلا یکی مثل حضرت امام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 262.94,
   "end": 268.18,
   "text": "خدا رحمت کنه حضرت، اه خدا رحمت کنه آقای عسگر اولادی رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 268.18,
   "end": 273.98,
   "text": "من با یک واسطه از یکی از بزرگان نقل می‌کنم که ایشون نقل کردن که من",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 273.98,
   "end": 277.14,
   "text": "از آقای عسگر اولادی روزای آخر عمرش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 277.14,
   "end": 279.22,
   "text": "دست‌نوشتی گرفتم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 279.22,
   "end": 283.92,
   "text": "ایشون نوشته من دیدم این دست‌نوشتو خود بنده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 283.92,
   "end": 286.34,
   "text": "که توش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 286.34,
   "end": 288.58,
   "text": "نوشته که اواخر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 288.58,
   "end": 291.12,
   "text": "ثون ماه سال چهل و یک،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 291.12,
   "end": 293.38,
   "text": "سال چهل و یک کجا؟ پیروزی انقلاب کجا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 293.38,
   "end": 297.9,
   "text": "هنوز تازه سال چهل و دو هم نرسیده که سرمنشأ انقلاب باشه و اینا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 297.9,
   "end": 301.4,
   "text": "با امام یک دیدار، یک خلوت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 301.4,
   "end": 305.0,
   "text": "حالا خصوصی داشتن فقط آقای عسگر اولادی بود و امام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 305.0,
   "end": 311.72,
   "text": "دل شب. بعد اونجا امام جمله جالب و عجیبی به آقای عسگر اولادی میده، میگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 311.72,
   "end": 316.24,
   "text": "می‌فرماید که اهداف ما برای این انقلاب،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 316.24,
   "end": 319.42,
   "text": "هنوزم هیچ خبری نبوده پونزده خرداد هم هنوز رخ نداده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 319.42,
   "end": 323.38,
   "text": "چند ماه مونده هنوز. اهداف ما برای این انقلاب سه چیزه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 323.38,
   "end": 325.52,
   "text": "ببینید اهداف بلند امام رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 325.52,
   "end": 328.92,
   "text": "اول اسلامی کردن ایران.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 328.92,
   "end": 331.56,
   "text": "دو، اینا جملات امامه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 331.56,
   "end": 335.66,
   "text": "دو، اسلامی کردن کشورهای اسلامی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 335.66,
   "end": 339.2,
   "text": "سه، جهانی کردن اسلام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 339.2,
   "end": 342.3,
   "text": "و خب فاز اولش که تو انقلاب خودمون رخ داد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 342.3,
   "end": 345.36,
   "text": "اسلامی کردن ایران. به سمت این داریم حرکت می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 345.36,
   "end": 348.74,
   "text": "البته به تمام کمال که نرسیده ولی به سمتش داریم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 348.74,
   "end": 351.72,
   "text": "حرکت می‌کنیم. بنامون این بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 351.72,
   "end": 355.92,
   "text": "الان تو فاز دوم اون اهداف بلند امامیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 355.92,
   "end": 358.88,
   "text": "جه-- اسلامی کردن کشورهای اسلامی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 358.88,
   "end": 362.06,
   "text": "کشورهایی که به ظاهر اسلامی‌اند اما باید اسلامی بشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 362.06,
   "end": 365.33,
   "text": "همین بیداری اسلامی که تو منطقه رخ داد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 365.33,
   "end": 369.67,
   "text": "اخیراً رهبر عزیزمون یه جمله خیلی کلیدی و جالبی داشتن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 369.67,
   "end": 374.91,
   "text": "مخاطبین و اینها هم حضار هم خندیدن به این جمله آقا ولی خیلی جالب بود که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 374.91,
   "end": 377.19,
   "text": "آقا فرمودن میگن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 377.19,
   "end": 380.33,
   "text": "اِاِاِ آمریکایی‌ها میگن مردم ایران اما می‌ترسن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 380.33,
   "end": 383.37,
   "text": "اگر از شما می‌ترسن چطور در دهه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 383.37,
   "end": 386.37,
   "text": "پنجاه شما رو از ایران بیرون کردن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 386.37,
   "end": 389.03,
   "text": "و در دهه نود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 389.03,
   "end": 391.17,
   "text": "از منطقه بیرونتون کردن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 391.17,
   "end": 395.87,
   "text": "این از منطقه بیرون کردن یعنی همین اه هدف فاز دوم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 395.87,
   "end": 398.01,
   "text": "امام رحمت الله علیه که مد نظرش بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 398.01,
   "end": 404.21,
   "text": "یعنی بیداری اسلامی یا اسلامی کردن کشورهای اسلامی که داره اتفاق میفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 404.21,
   "end": 406.69,
   "text": "سومیش هم جهانی‌سازی اسلامه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 406.69,
   "end": 410.15,
   "text": "بعد امام می‌فرمود آقای عسگر اولادی میگه امام فرمودن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 410.15,
   "end": 414.03,
   "text": "وقتی این فاز سوم رخ داد، اون موقع ما محضر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 414.03,
   "end": 416.39,
   "text": "ولی نعمت‌مون امام عصر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 416.39,
   "end": 418.55,
   "text": "عرض می‌کنیم که مولا جان مو--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 418.55,
   "end": 420.57,
   "text": "جهان در انتظار قدومت است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 420.57,
   "end": 424.33,
   "text": "ببینید نگاه رو، نگاه بلند رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 424.33,
   "end": 429.69,
   "text": "این ناشی از چی میشه؟ همین آینده‌نگری، این‌ها از چی ناشی میشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 429.69,
   "end": 433.01,
   "text": "صریح آیه قرآن میگه این باید قلب منیب داشته باشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 433.01,
   "end": 435.85,
   "text": "و الا نمی‌تونم به وجه اتم و بالاش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 435.85,
   "end": 439.15,
   "text": "و الا نمی‌تونه. جالبه که تازه بعضی جاها اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 439.15,
   "end": 444.27,
   "text": "اوایل حضرت امام خب خیلی به خواب و این‌ها توجه نمی‌کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 444.27,
   "end": 446.75,
   "text": "بعضی جاها هم که اگر یه وقت امام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 446.75,
   "end": 449.31,
   "text": "نمیشه گفت متزلزل یا مثلاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 449.31,
   "end": 452.15,
   "text": "اِمم تصمیم قاطعی نداشتن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 452.15,
   "end": 459.79,
   "text": "بزرگانی بودن در کنارش محکمش کنن مثل امثال آقای بهجت خاک که کنار رهبر ما بودن محکمش می‌کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 459.79,
   "end": 463.67,
   "text": "مثل آقای کشمیری. نمونه زیاد اینطوری هست که آقا سید احمد می‌گفت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 463.67,
   "end": 470.51,
   "text": "من قبلاً براتون عرض کردم تو نجف وقتی امام یه خواب دید که امیرالمؤمنین تو قبر میگذارش و پشت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 470.51,
   "end": 472.89,
   "text": "کمر آقا یه چیزی تو قبر اذیتش می‌کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 472.89,
   "end": 474.79,
   "text": "امیرالمؤمنین برمی‌داره میگه راحت شدی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 474.79,
   "end": 482.75,
   "text": "میگه بله و امام تعبیرش این بوده که تو همون نجف از دنیا میره و به دست امام انقلاب پیروز نمیشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 482.75,
   "end": 486.13,
   "text": "پیروز خواهد شد اما نه به دست-- بعد خبر می‌رسه با آقای کشمیری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 486.13,
   "end": 489.75,
   "text": "حالا ج-- جریانش مفصله که آقا سید احمد معرفی می‌کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 489.75,
   "end": 493.53,
   "text": "و خواب امام رو تعبیر می‌کنه که اون آقای کشمیری بزرگ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 493.53,
   "end": 496.31,
   "text": "که حالات عجیبی هم داشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 496.31,
   "end": 500.87,
   "text": "مثلاً هشت ساعت عبا رو سر رو به روی حرم امیرالمؤمنین دائم الذکر بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 500.87,
   "end": 503.09,
   "text": "یه آدم عجیبی بوده. ایشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 503.09,
   "end": 509.87,
   "text": "می‌فرمود نخیر، این خواب اتفاقاً یعنی اینکه انقلاب به س-- به زودی پیروز خواهد شد و حضرت امام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 509.87,
   "end": 512.55,
   "text": "پرچم ولایت رو بلند خواهد کرد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 512.55,
   "end": 514.81,
   "text": "و اونچه که در این مسیر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 514.81,
   "end": 522.27,
   "text": "امام امت را اذیت می‌کنه مثل اون چیزی که کمر آقا رو تو قبر اذیت می‌کرده، مولا برمی‌داره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 522.27,
   "end": 525.03,
   "text": "خود اهل بیت براش رفع می‌کنن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 525.03,
   "end": 527.97,
   "text": "تا متصل بشه به قیام جهانی حضرت حجت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 527.97,
   "end": 530.45,
   "text": "ببین این بلند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 530.45,
   "end": 534.11,
   "text": "نظری‌های عرفانی و معنوی ناشی از انابه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 534.11,
   "end": 537.73,
   "text": "چیزی به جز این نیست. و البته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 537.73,
   "end": 542.45,
   "text": "ما در صریح آیات قرآن هم داریم \"والشمس وضحاها\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 542.45,
   "end": 545.73,
   "text": "حالا این بحث مبسوط باید ادامه‌ش بدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 545.73,
   "end": 552.93,
   "text": "ولی چه کنیم فرصت هم محدوده و ما هم تبرکاً میگیم اگرچه امروز من باید خوب نیم ساعت، یک ساعت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 552.93,
   "end": 555.57,
   "text": "خطبه‌خوانی می‌کردیم، جشن می‌گرفتیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 555.57,
   "end": 559.77,
   "text": "شادی می‌کردیم. امروز برنامه ویژه اصلاً ارائه می‌دادیم تو این محل،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 559.77,
   "end": 562.23,
   "text": "شیرینی می‌دادیم اصلاً یک برنامه ویژه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 562.23,
   "end": 566.29,
   "text": "ولی چه کنیم؟ به هر حال شب بسیار با عظمت و فرخنده‌ایست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 566.29,
   "end": 568.77,
   "text": "شب آزادی و رهایی ما از بنده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 568.77,
   "end": 572.13,
   "text": "واقعاً بخوایم اینو تعبیرش کنیم تا شب باید بشینیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 572.13,
   "end": 575.83,
   "text": "به هر حال می‌خوام عرض کنم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 575.83,
   "end": 579.41,
   "text": "اِاِاِ در یه همچین شبی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 579.41,
   "end": 583.67,
   "text": "اون بلند نظری امام از جهت عرفانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 583.67,
   "end": 588.27,
   "text": "توسط بزرگانی که طی تاریخ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 588.27,
   "end": 590.55,
   "text": "گفته بودن حتی میگن امام وقتی ب--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 590.55,
   "end": 597.57,
   "text": "خیلی سنش کم بود طلبه بود، مرحوم آقای شهاب الدین بزرگ رحمت الله علیه امام رو تو سن جوانی دیده بود،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 597.57,
   "end": 599.83,
   "text": "صداش کرده بود تو گوشش گفته بود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 599.83,
   "end": 602.29,
   "text": "که آره تو یکی روزی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 602.29,
   "end": 604.53,
   "text": "دولت اسلامی تشکیل خواهی داد و چه و چه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 604.53,
   "end": 607.21,
   "text": "این‌ها تو خاطرات هست. حالا من می‌خوام بگم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 607.21,
   "end": 610.35,
   "text": "امشب همون شبه که کلید واژه‌ش خورد و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 610.35,
   "end": 615.99,
   "text": "به هر حال ما می‌خوام عرض کنم که در سوره \"والشمس وضحاها\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 615.99,
   "end": 621.53,
   "text": "میگه خورشید و ضحاها، خورشید پیغمبره، ضحاها دینشه، نورشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 621.53,
   "end": 625.23,
   "text": "بلافاصله می‌فرماید \"والقمر اذا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 625.23,
   "end": 628.61,
   "text": "تلاها\" میگه اِاِ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 628.61,
   "end": 632.49,
   "text": "اِاِ ماهی که اِاِ شبها خودش رو نشون میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 632.49,
   "end": 635.31,
   "text": "ماه شب میاد بیرون دیگه. داره در حقیقت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 635.31,
   "end": 641.59,
   "text": "تلویحاً میگه که بعد از هر نوری یه ظلمتی در طبیعت روزگار آشکار میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 641.59,
   "end": 646.63,
   "text": "ولی \"والنهار اذا جلا\" در نهایت نور خودش رو متجلی می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 646.63,
   "end": 648.95,
   "text": "اینجا یک نهی بیست و امثال ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 648.95,
   "end": 653.99,
   "text": "پیغمبر با اون عظمتش وقتی اسلام رو جهانی‌سازی کرد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 653.99,
   "end": 656.43,
   "text": "خیلی-- اصلاً کسی باورش نمیشد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 656.43,
   "end": 661.49,
   "text": "روزای اول. هرچی پیغمبر تو گوش بعضیا می‌خوند صبور باشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 661.49,
   "end": 666.67,
   "text": "چرا پیغمبر فرمود این آیه سوره هود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 666.67,
   "end": 670.97,
   "text": "من رو پیر کرد، محاسنم رو سفید کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 670.97,
   "end": 674.89,
   "text": "تو سوره هود که می‌فرماید اِاِاِ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 674.89,
   "end": 678.91,
   "text": "استبر جان؟ استقم كما امرت آفرین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 678.91,
   "end": 682.45,
   "text": "ومن تاب معك فاستقم كما امرت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 682.45,
   "end": 685.49,
   "text": "میگه استقامت ببرز به اونچه که ما به تو امر کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 685.49,
   "end": 687.13,
   "text": "توجه بهش نمی‌کنن خیلیا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 687.13,
   "end": 691.27,
   "text": "تفسیر میگه این قسمت دومش بوده که پیر کرده پیغمبر رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 691.27,
   "end": 694.81,
   "text": "ومن تاب معك یعنی استقامت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 694.81,
   "end": 697.49,
   "text": "مسلمونا، امت اونا باید مستقیم باشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 697.49,
   "end": 700.29,
   "text": "تا می‌بینن شب شد می‌بازن خودشونو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 700.29,
   "end": 701.93,
   "text": "خب خیلی جنگ‌ها ما داشتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 701.93,
   "end": 705.31,
   "text": "روزی یه دونه خرما دو نفر می‌خوردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 705.31,
   "end": 707.71,
   "text": "شب ابی طالب داشتیم. خونریزی‌ها داشتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 707.71,
   "end": 710.27,
   "text": "باورشون نمیشد یه روزی اسلام جهانگیر بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 710.27,
   "end": 712.65,
   "text": "وقتی پیغمبر مژده فتح",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 712.65,
   "end": 714.69,
   "text": "روم و ایران رو داد، کسی باورش نمیشد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 714.69,
   "end": 719.15,
   "text": "ولی شد. خب می‌خوام بگم که تو بحث انقلاب ما هم همین هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 719.15,
   "end": 724.93,
   "text": "یک سختی‌هایی قطعاً در مسیر ما، یک شب‌هایی، یک ظلمت‌هایی وجود داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 724.93,
   "end": 728.61,
   "text": "اما در نهایت انشاالله واللیلة والنهار اذا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 728.61,
   "end": 732.79,
   "text": "جلا. حالا این بحث رو خیلی نصفه نیمه من گفتم و نپخته شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 732.79,
   "end": 736.19,
   "text": "ببخشید. انشاالله که این شب فرخنده باشه برای هممون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 736.19,
   "end": 743.21,
   "text": "من خواهش می‌کنم امشب تو خونه‌مون لااقل برای زن و بچه‌مون شده به برکت امام و خون شهدا تعظیم کنیم امشب رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 743.21,
   "end": 747.87,
   "text": "واما بنعمت ربک فحدث نعمت رو حدیث کن، بیان کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 747.87,
   "end": 749.77,
   "text": "یه شیرینی بگیریم بریم خونه‌مون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 749.77,
   "end": 752.01,
   "text": "انشاالله روح امام و شهدا از ما راضی باشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 752.01,
   "end": 754.29,
   "text": "نثار همشون صلوات بفرستیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 754.29,
   "end": 757.59,
   "text": "اللهم صل على",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 757.59,
   "end": 762.33,
   "text": "محمد و آل محمد و عجل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}