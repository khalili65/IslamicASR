 },
 "chapters": [
  {
   "index": 0,
   "title": "بحث در قلب مرعوب بود — بر وزن مفعول: قلبی که ترسانده شده و ترسیده است. در آیهٔ بیست و ششم سورهٔ احزاب آمده است:",
   "start": 40.66,
   "end": 74.92
  },
  {
   "index": 1,
   "title": "## قذف الرعب: بیداری و یغظه",
   "start": 74.92,
   "end": 820.19
  },
  {
   "index": 2,
   "title": "## قتل و اسیر در جهاد نفس",
   "start": 820.19,
   "end": 840.33
  },
  {
   "index": 3,
   "title": "## ترس ضعف و ترس لوّامه",
   "start": 840.33,
   "end": 902.37
  },
  {
   "index": 4,
   "title": "دو آیه همواره بر لب است:",
   "start": 902.37,
   "end": 1098.53
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.72,
   "end": 5.0,
   "text": "بسم الله الرحمن الرحیم و به این استعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 5.0,
   "end": 9.92,
   "text": "السلام علیک ای داعی الله و ربانی آیاته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 9.92,
   "end": 12.52,
   "text": "سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 12.52,
   "end": 15.96,
   "text": "ما در قلب مرعوب بودیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 15.96,
   "end": 21.42,
   "text": "بر وزن مفعول قلبی که ترسانده شده، ترسیده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 21.42,
   "end": 26.56,
   "text": "در آیه بیست و شش surه احزاب داشتیم توجه می‌کردیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 26.56,
   "end": 29.76,
   "text": "که می‌فرماید و انزل الذين باهرهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 29.76,
   "end": 34.62,
   "text": "من اهل الكتاب. من",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 34.62,
   "end": 40.04,
   "text": "سیاسیهم و قذف في قلوبهم الرعب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 40.04,
   "end": 43.38,
   "text": "می‌فرماید کسانی از اهل کتاب رو که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 43.38,
   "end": 49.28,
   "text": "از اون‌ها یعنی از مشرکین پشتیبانی کردن، یهودیانی‌اند که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 49.28,
   "end": 52.12,
   "text": "عهدشون رو با پیغمبر شکستند و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 52.12,
   "end": 55.38,
   "text": "رفتن به کمک مشرکین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 55.38,
   "end": 59.14,
   "text": "می‌فرماید که از استحکاماتشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 59.14,
   "end": 61.96,
   "text": "سیاسی دژ بود دیگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 61.96,
   "end": 67.04,
   "text": "صحبت کردیم. از د- استحکاماتشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 67.04,
   "end": 77.34,
   "text": "فرود آورد. بعد از اینکه از اون دژهای محکم، سنگرهای محکم اینها رو بیرون کشید و قذف في قلوبهم الرعب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 77.34,
   "end": 80.76,
   "text": "یه ترسی تو دلشون خدا انداخت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 80.76,
   "end": 85.42,
   "text": "طوری شد که فریقا تقتلون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 85.42,
   "end": 92.44,
   "text": "یه عده‌شون رو شما کشتید یا می‌کشید و تأسرون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 92.44,
   "end": 97.96,
   "text": "فریقا. یه عده‌شون هم که اسیر گرفتید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 97.96,
   "end": 100.22,
   "text": "حالا پیرامون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 100.22,
   "end": 102.9,
   "text": "تفسیر آفاقش که جلسه پیش صحبت کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 102.9,
   "end": 105.56,
   "text": "امروز چند تا نکته پیرامون تفسیر انفسي.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 105.56,
   "end": 109.4,
   "text": "اگر این آیه رو بخواهیم با تفسیر انفسي نگاه کنیم؛",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 109.4,
   "end": 116.42,
   "text": "یعنی اینکه این رو برگردونیم به نفس، به روح خودمون، به باطن خودمون، به درگیری‌های درون خودمون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 116.42,
   "end": 120.06,
   "text": "ببین الان این آیه برای ما چه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 120.06,
   "end": 122.58,
   "text": "خروجی‌ای داره؟ با ما چه حرفی داره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 122.58,
   "end": 127.9,
   "text": "خب اون که منقرض شد، منقضی شد، منسرم بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 127.9,
   "end": 130.3,
   "text": "اصلاً تموم شد و رفت. زمان‌بردار بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 130.3,
   "end": 133.7,
   "text": "اون لحظه‌ای که این جنگ رخ داد و این اتفاق افتاد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 133.7,
   "end": 136.94,
   "text": "تموم شد و رفت دیگه. خب الان به چه درد من می‌خوره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 136.94,
   "end": 140.4,
   "text": "اینجا بحث تفسیر انفسي پیش میاد که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 140.4,
   "end": 143.84,
   "text": "در تفسیر انفسي این اهل کتاب رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 143.84,
   "end": 149.98,
   "text": "که اومدن در بیرون، در خارج از نفس ما، در خارج عهدشون رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 149.98,
   "end": 155.8,
   "text": "با پیغمبر شکستند و رفتن به کمک مشرکین و یهودیا بودند دیگه اهل کتاب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 155.8,
   "end": 158.56,
   "text": "این رو میشه گرفت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 158.56,
   "end": 161.34,
   "text": "به فرمایش بزرگان اهل معرفت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 161.34,
   "end": 167.44,
   "text": "در حقیقت نماد بخشی از وجود خود آدمه که دارای استدلال و دانش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 167.44,
   "end": 170.38,
   "text": "برخورد کردن با دیگرانه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 170.38,
   "end": 177.94,
   "text": "اما گاهی توی این استدلالاتش دچار تعصبات ذهنی و قالب‌های فکری میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 177.94,
   "end": 183.38,
   "text": "به جای اینکه تسلیم بشه. اینا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 183.38,
   "end": 187.5,
   "text": "در خارج، در محیط بیرون، بیرون از نفس،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 187.5,
   "end": 190.52,
   "text": "اینها به مقداری از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 190.52,
   "end": 193.98,
   "text": "آیات و علوم الهی دسترسی داشتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 193.98,
   "end": 197.5,
   "text": "دسترسی پیدا کرده بودن در کتب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 197.5,
   "end": 200.08,
   "text": "انبیا دسترسی داشتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 200.08,
   "end": 205.74,
   "text": "یعنی مقداری اطلاعات داشتند، استدلال‌هایی داشتن از علوم از دانش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 205.74,
   "end": 210.84,
   "text": "حتی علوم الهی. اما دچار تعصبات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 210.84,
   "end": 216.42,
   "text": "ذهنی و قالب‌های فکری و جمود فکری و اینها شدند و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 216.42,
   "end": 221.44,
   "text": "متأسفانه جلوی پیغمبر زمانشون ایستادند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 221.44,
   "end": 226.36,
   "text": "این یه نکته که عرض کنم که الان تو این آیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 226.36,
   "end": 231.04,
   "text": "وقتی به خودمون نگاه می‌کنیم، اهل کتاب در درون ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 231.04,
   "end": 235.76,
   "text": "میشه همون. در حقیقت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 235.76,
   "end": 243.3,
   "text": "میشه گفت بخشی از وجود ماست که دارای اطلاعاتی است که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 243.3,
   "end": 247.78,
   "text": "تعصب‌وار با این اطلاعات رفتار می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 247.78,
   "end": 252.64,
   "text": "سیاسی که سنگرهای محکمه گفتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 252.64,
   "end": 258.66,
   "text": "نماد س-- این سنگرهای محکم در بیرون، در درون ما میشه چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 258.66,
   "end": 260.68,
   "text": "میشه اون، صحبت نکن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 260.68,
   "end": 263.0,
   "text": "میشه عادات. صحبت نکن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 263.0,
   "end": 265.7,
   "text": "میشه افکار یا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 265.7,
   "end": 269.7,
   "text": "ویژگی‌های ریشه‌داری که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 269.7,
   "end": 273.02,
   "text": "تو انسان ایجاد شده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 273.02,
   "end": 279.24,
   "text": "و وقتی که انسان می‌خواد فرار کنه به اونا پناه می‌بره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 279.24,
   "end": 283.5,
   "text": "عادتهای غلط. به یک معنا میشه گفت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 283.5,
   "end": 288.28,
   "text": "تعصب، تعصبات بیخود یا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 288.28,
   "end": 291.1,
   "text": "بخوایم خیلی فلسفیش کنیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 291.1,
   "end": 294.44,
   "text": "میشه ملکات نفس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 294.44,
   "end": 300.12,
   "text": "عادت‌ها وقتی اصرار به عمل رخ داد میشه ملکات نفس دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 300.12,
   "end": 305.82,
   "text": "یادتون هست ملکات نفس، اصلاً ما با ملکات نفسمون محشوریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 305.82,
   "end": 310.28,
   "text": "مطلقاً اون صور و اشکالی که در عالم برزخ خواهیم دید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 310.28,
   "end": 313.4,
   "text": "ملاطش ملکات نفسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 313.4,
   "end": 314.98,
   "text": "ملکات نفس از کجاست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 314.98,
   "end": 317.28,
   "text": "ملکه، ملکه وجود شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 317.28,
   "end": 320.68,
   "text": "اون از کجاست؟ از اصرار بر اعمال.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 320.68,
   "end": 324.84,
   "text": "حالا این اصرار بر اعمال خیلیش از رو تعصباته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 324.84,
   "end": 327.24,
   "text": "رشد برزخ هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 327.24,
   "end": 329.46,
   "text": "احساس همین ملکه- احسن. همینه آفرین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 329.46,
   "end": 333.42,
   "text": "اون رو-- سیر استکمالی که ما قبلاً گفتیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 333.42,
   "end": 336.66,
   "text": "اونجا چگونه سیر هست در حالی که استعداد نیست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 336.66,
   "end": 340.24,
   "text": "اونجا عالم ماده نیست، عالم فعلیته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 340.24,
   "end": 344.42,
   "text": "خب؟ چگونه سیر هست؟ گفتیم بر اساس همون ملکات نفسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 344.42,
   "end": 347.42,
   "text": "احسن که یادتون بود. حالا این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 347.42,
   "end": 351.14,
   "text": "باورهای غلطی که مانع رشد روحی میشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 351.14,
   "end": 353.44,
   "text": "اینا همون چین؟ سنگرهایت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 353.44,
   "end": 357.08,
   "text": "اونجا میگه سیاسی. اینا پناه می‌بردند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 357.08,
   "end": 365.66,
   "text": "توی اون سنگرهای محکمشون، تو قلعه و دژشون گمان می‌کردند که دیگه خدا دستش به اینا نمی‌رسه، پیغمبر و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 365.66,
   "end": 373.12,
   "text": "اهل ایمان دستش به اینا. این همون تعصبات، همون ملکات، همون باورهای غلط درونی ماست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 373.12,
   "end": 378.64,
   "text": "ببینید چقدر قشنگ میشه تفسیر انفسیه آیه رو در درون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 378.64,
   "end": 382.46,
   "text": "مصادیقش رو پیدا کرد و متوجه شد که حالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 382.46,
   "end": 385.82,
   "text": "این آیه داره به من چه تذکری رو میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 385.82,
   "end": 389.3,
   "text": "دارم یه نمونه کار می‌کنم با هم که متوجه بشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 389.3,
   "end": 393.04,
   "text": "خیلی هم سهل الوصول و فهمش آسونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 393.04,
   "end": 399.28,
   "text": "پس این سیاحی که اون‌ها بهش پناه می‌بردن خدا میگه اینا رو ما خراب کردیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 399.28,
   "end": 403.22,
   "text": "و از بین بردیمشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 403.22,
   "end": 406.02,
   "text": "میشه همون در حقیقت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 406.02,
   "end": 411.16,
   "text": "نماد افکار و عادات و ویژگی‌های ریشه‌داری که تو انسان هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 411.16,
   "end": 414.6,
   "text": "و اینا رو من یک یک میگم بعد جمع‌بندی کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 414.6,
   "end": 427.32,
   "text": "اما اون قذف فی قلوبهم الرعب اون ترسی که تو دلشون می‌افته اینو برگردونیم به نفس که بشه تفسیر انفسی چی میشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 427.32,
   "end": 430.7,
   "text": "میشه ببینید اونا وقتی می‌ترسن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 430.7,
   "end": 440.16,
   "text": "مضطرب میشن، می‌لرزن، به خودشون میان، در درون خودشون شکست می‌خورن، در درون خودشون متوجه ضعفشون میشن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 440.16,
   "end": 442.9,
   "text": "در درون خودشون می‌فهمن که چه غلطی کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 442.9,
   "end": 445.38,
   "text": "در حقیقت هوشیار میشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 445.38,
   "end": 447.48,
   "text": "ولو ظهور ندن به این.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 447.48,
   "end": 451.94,
   "text": "اما در درون خودشون وقتی خدا رعب میندازه تو دلشون مضطرب میشن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 451.94,
   "end": 457.98,
   "text": "می‌فهمن چه غلطی کردن. دقیقاً این نمادش در درون ما در تفسیر انفسی میشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 457.98,
   "end": 462.2,
   "text": "حالتی که انسان متوجه اشتباهاتش میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 462.2,
   "end": 466.12,
   "text": "پی می‌بره به ضعفش و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 466.12,
   "end": 469.18,
   "text": "حالت انکسار و شکست در درون خودش رخ میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 469.18,
   "end": 474.32,
   "text": "رو-- میره، میره تا میرسه به منزل اول",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 474.32,
   "end": 481.16,
   "text": "م-منازل سیر و سلوک که مثلاً خواجه عبدالله انصاری در منازل الصائرینش صد منزل رو آورده که هر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 481.16,
   "end": 484.46,
   "text": "منزل رو البته سه رتبه کرده میشه سیصد منزل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 484.46,
   "end": 487.98,
   "text": "منزل اول رو گرفته یغزه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 487.98,
   "end": 491.62,
   "text": "یعنی بیداری. این منجر میشه به بیداری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 491.62,
   "end": 495.2,
   "text": "در حقیقت وقتی انسان با حق و حقیقت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 495.2,
   "end": 502.94,
   "text": "رو به رو میشه متوجه اون ضعف‌ها، اون باورهای غلطش، عادات بیخودش اینها میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 502.94,
   "end": 508.72,
   "text": "یه نوع در حقیقت اضطراب و ترس درونی تو وجودش ایجاد میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 508.72,
   "end": 512.94,
   "text": "در حقیقت میشه گفت وجدانش بیدار میشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 512.94,
   "end": 517.02,
   "text": "و یک تحول مثبت درش رخ میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 517.02,
   "end": 521.4,
   "text": "وجدان که بیدار شد. ما یه نفس یکی از رو--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 521.4,
   "end": 527.36,
   "text": "در حقیقت یک روح یا یک وجه از وجوه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 527.36,
   "end": 530.66,
   "text": "و معانی متعدد نفس،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 530.66,
   "end": 534.86,
   "text": "نفس لوامه است دیگه. سرزنش کننده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 534.86,
   "end": 539.54,
   "text": "اون وجدانه. انسان رو سرزنش می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 539.54,
   "end": 542.4,
   "text": "بعد آدم یاد گناه‌هاش می‌کنه می‌ترسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 542.4,
   "end": 550.24,
   "text": "روایت داریم مؤمن نسبتش با گناهان خودش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 550.24,
   "end": 557.52,
   "text": "مثل اینه که کوه بلندی از می‌خواد بر سر-- اون کوه بلنده که حالا بلندترین کوهه که تو منطقه ما هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 557.52,
   "end": 560.7,
   "text": "اگر بگیریم دم اوون، اون می‌خواد به سرش خراب شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 560.7,
   "end": 564.28,
   "text": "یه همچین نگرانی نسبت به گناهان خودش داره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 564.28,
   "end": 567.56,
   "text": "که اون رو به خوف می‌کشونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 567.56,
   "end": 570.7,
   "text": "یه حالت خوف و رجا که مؤمن داره اینه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 570.7,
   "end": 576.78,
   "text": "وقتی میگه چون به تو می‌نگرم از جمله تاج‌گذارانم و تاج بر سر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 576.78,
   "end": 579.3,
   "text": "او رو که نگاه می‌کنی امید میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 579.3,
   "end": 584.32,
   "text": "ولی وقتی خودتو می‌بینی، گناهانتو می‌بینی، چون به خود می‌نگرم از زمره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 584.32,
   "end": 591.3,
   "text": "خاک سارانم و خاک بر سر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 591.3,
   "end": 593.74,
   "text": "پس مؤمن یکی از نشانه‌هاش اینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 593.74,
   "end": 600.18,
   "text": "به شدت نگران گناهاشه انگار یه کوه بزرگی می‌خواد الان تو سرش خراب شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 600.18,
   "end": 602.22,
   "text": "برعکس منافق میگن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 602.22,
   "end": 605.72,
   "text": "نگاهش به گناهاش مثل اینه که یه پشه‌ای دور",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 605.72,
   "end": 607.76,
   "text": "بینیش بچرخه و هی اینو پرش بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 607.76,
   "end": 611.56,
   "text": "اینطوریه. اصلا توجهی نداره به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 611.56,
   "end": 615.52,
   "text": "گناهاش. از اینجا میشه انسان خودش رو بشناسه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 615.52,
   "end": 619.72,
   "text": "خدایی نکرده به سمت نفاق رفته قلبش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 619.72,
   "end": 623.62,
   "text": "یا اهل ایمان ان‌شاءالله هست و ثبات قدم داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 623.62,
   "end": 627.02,
   "text": "پس اون حالت تحول و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 627.02,
   "end": 629.91,
   "text": "تحول مثبت، اون بیداری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 629.91,
   "end": 638.8,
   "text": "درون و وجدان که منجر به یغزه میشه و انسان رو می‌کشونه به منزل دوم منازل الصائرین که تو-توبه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 638.8,
   "end": 643.66,
   "text": "تو این مرحله پیش میاد و قذف فی قلوبهم الرعب در بیرون که خدا در دل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 643.66,
   "end": 648.6,
   "text": "دشمن، دشمن اون ترس و رعب رو می‌اندازه در درون ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 648.6,
   "end": 653.26,
   "text": "خدا انکسار ایجاد می‌کنه، شکست ایجاد می‌کنه، خوف ایجاد می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 653.26,
   "end": 656.08,
   "text": "همش جالب دست خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 656.08,
   "end": 660.6,
   "text": "ما از-- آیا این بیدار-- این بیداری، این یغزه خوبه یا بده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 660.6,
   "end": 663.76,
   "text": "این انکسار درونی خوبه یا بده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 663.76,
   "end": 667.96,
   "text": "انا عند منكسرة قلوبهم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 667.96,
   "end": 673.38,
   "text": "من نزد دل‌های شکستم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 673.38,
   "end": 677.78,
   "text": "در درگه ما شکسته دلی می‌خرند و بس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 677.78,
   "end": 682.38,
   "text": "بازار خودفروشی از آن سوی دیگر است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 682.38,
   "end": 684.98,
   "text": "این پس خوبه. انکسار خیلی خوبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 684.98,
   "end": 687.42,
   "text": "هرچی آدم شکسته تر میشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 687.42,
   "end": 692.2,
   "text": "خاشع‌تر میشه، افتاده‌تر میشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 692.2,
   "end": 699.58,
   "text": "از خدا بیشتر می‌ترسه. انما، انما حصر دیگه فقط و فقط آیه قرآنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 699.58,
   "end": 701.96,
   "text": "انما یخشالله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 701.96,
   "end": 712.5,
   "text": "من عباده العلماء. قرآن می‌فرماید یخشالله خشوع، ترس از خدا رو فقط علما دارن، بندگان عالم خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 712.5,
   "end": 717.06,
   "text": "این اون الهام الهیه. اعلام، اعلام که بعد منجر میشه به القا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 717.06,
   "end": 722.94,
   "text": "بعد الهام برای اخص اولیاء الله یا انبیا میشه ایها،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 722.94,
   "end": 725.3,
   "text": "وحی. برای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 725.3,
   "end": 729.66,
   "text": "اولیا میشه الهام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 729.66,
   "end": 731.74,
   "text": "برای انسان‌های",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 731.74,
   "end": 737.44,
   "text": "مبتدی یا بش-بهتره بگیم متوسط میشه الهام، القا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 737.44,
   "end": 740.81,
   "text": "برای مبتدیین میشه اعلام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 740.81,
   "end": 745.61,
   "text": "بالاخره خدا اون علمش رو منتقل می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 745.61,
   "end": 748.77,
   "text": "من عباده العلماء دیگه تا اون خوف بیاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 748.77,
   "end": 754.93,
   "text": "خب خیلی خوبه انسان بیدار بشه بعد بره به سمت توبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 754.93,
   "end": 760.27,
   "text": "نکته بعدی که توی آیه می‌فرماید کشته شدن و اسیر شدنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 760.27,
   "end": 766.35,
   "text": "این در وجود چیه؟ می‌فرماید بعضی از این صفات و عادات زشت رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 766.35,
   "end": 769.33,
   "text": "وقتی خدای ممنون کمک کرد، اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 769.33,
   "end": 771.93,
   "text": "اهل کتاب باطنیت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 771.93,
   "end": 774.37,
   "text": "اون تعصبات، اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 774.37,
   "end": 779.95,
   "text": "در حقیقت تفکرات غلط و منفی ذهنی‌ت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 779.95,
   "end": 786.99,
   "text": "اون چارچوب غلطی که در درون خودت درست کردی و در اون دژ و در اون سنگر بیخود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 786.99,
   "end": 792.13,
   "text": "سنگر گرفتی ، مجاهدات نفس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 792.13,
   "end": 797.53,
   "text": "وقتی خدا کمک کرد نظر کرد تو بیدار شدی و رفتی به سمت مجاهده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 797.53,
   "end": 801.05,
   "text": "جهاد کردی اهل سیر و سلوک شدی و رفتی به سمت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 801.05,
   "end": 804.97,
   "text": "توبه کردن و جبران مافات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 804.97,
   "end": 809.47,
   "text": "مجاهده نفس باعث می‌شه که این سنگرها رو فتح کنی و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 809.47,
   "end": 812.07,
   "text": "این تعصبات و بخشیش رو ریشه‌کن کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 812.07,
   "end": 816.15,
   "text": "یعنی این کشته شدن که میگه وقتی ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 816.15,
   "end": 818.61,
   "text": "و غذف فی قلوبهم الرب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 818.61,
   "end": 824.61,
   "text": "بعد آیه می‌فرمود فریقا تقتلون دیگه عده‌ای اینا رو می‌کشید یا کشتید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 824.61,
   "end": 828.11,
   "text": "و تأسرون فریقا. یه عده‌شونم که اسیر کردید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 828.11,
   "end": 832.03,
   "text": "این کشتن وقتی سیر انفسی میری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 832.03,
   "end": 837.39,
   "text": "می‌شه ریشه‌کن کردن اون ملکات غلط نفس به توسط",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 837.39,
   "end": 842.47,
   "text": "مجاهده نفس. درک کردی چی شد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 842.47,
   "end": 845.75,
   "text": "حالا اسیر کردن چی می‌شه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 845.75,
   "end": 848.07,
   "text": "می‌شه به-- بخشی از این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 848.07,
   "end": 853.33,
   "text": "افکار منفی و غلط تحت کنترلت قرار می‌گیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 853.33,
   "end": 858.33,
   "text": "یعنی هنوز ریشه‌کنش نکردی اما تحت کنترلت قرار می‌گیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 858.33,
   "end": 865.13,
   "text": "مثل کسی که غضب یه دفعه میاد بهش دست میده اما کنترل می‌کنه خودشو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 865.13,
   "end": 868.65,
   "text": "اینطور نیست که اصلاً غضب نیاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 868.65,
   "end": 870.85,
   "text": "غضبناک نشه، خشمگین نشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 870.85,
   "end": 873.69,
   "text": "می‌شه اما خودش رو کنترل می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 873.69,
   "end": 876.73,
   "text": "اسیر می‌کنه غضبش رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 876.73,
   "end": 880.95,
   "text": "این هم باز از عنایات- نفس رو درست نمی‌نویسن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 880.95,
   "end": 882.81,
   "text": "یعنی گفت کنترل- احسن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 882.81,
   "end": 886.03,
   "text": "بله. اینکه بارها از تو استاد فرمودن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 886.03,
   "end": 889.93,
   "text": "بله. از بین بردن نفس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 889.93,
   "end": 892.83,
   "text": "که اصلاً خوب نیست. تموم شد. چهار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 892.83,
   "end": 899.79,
   "text": "بله. خب این پس این شد یک الگو خیلی خوبی از پیروزی انسان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 899.79,
   "end": 909.83,
   "text": "علیه نیروهای منفی و درونی خودش که هر وقت انسان حقیقتی رو بپذیره و از سنگرهای زن-ذهنی و تعصباتش خارج بشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 909.83,
   "end": 913.25,
   "text": "خدا تو دلش یه بیداری ایجاد می‌کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 913.25,
   "end": 920.87,
   "text": "و در نهایت با اراده حضرت حق می‌تونه این ضعف‌ها رو ریشه‌کن کنه و عده‌ش هم غلبه کنه براش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 920.87,
   "end": 929.39,
   "text": "که این یک آیه ایه که ببین وقتی میری به تفسیر انفسی به درش می‌کنی چقدر رهگشاست برای درون انسان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 929.39,
   "end": 932.23,
   "text": "ای کاش پروردگار ممنون کمک کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 932.23,
   "end": 939.07,
   "text": "به همه ما بتونیم تمام آیات قرآن رو بتونیم همینطور تفسیر انفسی بریم از ابت-ابتدا به اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 214,
   "start": 939.07,
   "end": 942.53,
   "text": "با بسم الله تا سین و الناس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 215,
   "start": 942.53,
   "end": 944.47,
   "text": "خیلی شیرین می‌شه. خیلی به درد بخوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 216,
   "start": 944.47,
   "end": 947.35,
   "text": "جانم آقای. ببخشید وقت رو- خواهش می‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 217,
   "start": 947.35,
   "end": 950.63,
   "text": "موقعی که یه انسان یه کار اشتباهی می‌کنه یا مثلاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 218,
   "start": 950.63,
   "end": 954.41,
   "text": "دزدی می‌کنه، دستش می‌لرزه، بدنش می‌لرزه اینا، اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 219,
   "start": 954.41,
   "end": 958.55,
   "text": "ترسه. اون همون نفس لوامه است یعنی گواه طرف.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 220,
   "start": 958.55,
   "end": 960.45,
   "text": "تمام. تو چه مقوله‌ای هست این؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 221,
   "start": 960.45,
   "end": 964.21,
   "text": "نه. می‌تونه اون ترس از روی ضعف نفس باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 222,
   "start": 964.21,
   "end": 967.71,
   "text": "ترس همش که نفس لوامه نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 223,
   "start": 967.71,
   "end": 970.55,
   "text": "ترس میگن برادر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 224,
   "start": 970.55,
   "end": 974.45,
   "text": "مرگه- بله و ضعف ایمان میاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 225,
   "start": 974.45,
   "end": 979.75,
   "text": "کسی که ایمان ضعفش، ضعف ایمان داره و ایمانش ضعیفه دچار ترس می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 226,
   "start": 979.75,
   "end": 986.07,
   "text": "مثلاً حضرت امام ول-- فرمود والله قسم یک بار تو عمرم نترسیدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 227,
   "start": 986.07,
   "end": 991.29,
   "text": "یا حضرت آیت الله اشرافی اصفهانی شهید محراب فرمودن که به خدا که این معجزه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 228,
   "start": 991.29,
   "end": 994.77,
   "text": "یه مردی بیاد بگه یک بار تو عمرم نترسیدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 229,
   "start": 994.77,
   "end": 998.51,
   "text": "خب این س-صلابت ایمان رو می‌رسونه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 230,
   "start": 998.51,
   "end": 1001.81,
   "text": "اون ترسی که شما الان ازش یاد کردید،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 231,
   "start": 1001.81,
   "end": 1009.41,
   "text": "اون ضعف نفسه. ولی وج-- وقتی وجدان بیدار می‌شه، این چیزی که ما الان عرض کردیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 232,
   "start": 1009.41,
   "end": 1014.57,
   "text": "و حالت یغظه ایجاد می‌شه و انسان از درون انکسار بهش دست میده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 233,
   "start": 1014.57,
   "end": 1020.91,
   "text": "اون نفس لوامه شروع می‌کنه با کار کردن انسان رو سرزنش می‌کنه که چرا این کارو بعدا کردی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 234,
   "start": 1020.91,
   "end": 1022.97,
   "text": "این اتفاقاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 235,
   "start": 1022.97,
   "end": 1028.09,
   "text": "نشان دهنده اینه که اون در حقیقت- بیداری احسن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 236,
   "start": 1028.09,
   "end": 1031.43,
   "text": "اون ک-- می‌شه گفت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 237,
   "start": 1031.43,
   "end": 1034.07,
   "text": "آتشفشان، آتشفشان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 238,
   "start": 1034.07,
   "end": 1036.51,
   "text": "نورانی نفس شروع به کار کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 239,
   "start": 1036.51,
   "end": 1038.93,
   "text": "داره تو رو بیدار می‌کنه. اون خیلی خوبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 240,
   "start": 1038.93,
   "end": 1041.93,
   "text": "صفت خوبیه. هرکسی اینو نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 241,
   "start": 1041.93,
   "end": 1044.51,
   "text": "آره. خب مطلقش تو اون آیه قرآنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 242,
   "start": 1044.51,
   "end": 1048.37,
   "text": "من همیشه گفتم این من لبم تره به این دو آیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 243,
   "start": 1048.37,
   "end": 1051.77,
   "text": "ما اصابک من حسنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 244,
   "start": 1051.77,
   "end": 1057.55,
   "text": "هیچ حسنه ای به تو اصابت نمی‌کنه فمن الله مگر اینکه از خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 245,
   "start": 1057.55,
   "end": 1061.93,
   "text": "ببین خدا چه می‌کنه تو همین آیه چه می‌کنه برای اینکه ما رو بیدار کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 246,
   "start": 1061.93,
   "end": 1064.73,
   "text": "و ما اصابک من سیئه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 247,
   "start": 1064.73,
   "end": 1071.05,
   "text": "هیچ سیئه و بدی به تو اصابت نمی‌کنه فمن نفسك مگر اینکه از نفس خودته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 248,
   "start": 1071.05,
   "end": 1075.85,
   "text": "بدی هرچی هست از ماست. ضعف، بدی، نقص،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 249,
   "start": 1075.85,
   "end": 1078.97,
   "text": "ظلمت، شر همش مال ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 250,
   "start": 1078.97,
   "end": 1082.59,
   "text": "اما حسنه، حق، نور،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 251,
   "start": 1082.59,
   "end": 1085.53,
   "text": "خیر، قوت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 252,
   "start": 1085.53,
   "end": 1089.85,
   "text": "اینا همه از حضرت حقه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 253,
   "start": 1089.85,
   "end": 1093.07,
   "text": "اللهم بارک لمولانا صاحب الزمان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 254,
   "start": 1093.07,
   "end": 1095.01,
   "text": "والحمد لله رب العالمين.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 255,
   "start": 1095.01,
   "end": 1098.53,
   "text": "صلوات. اللهم صل علی محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}