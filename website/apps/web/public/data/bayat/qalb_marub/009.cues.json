 "chapters": [
  {
   "index": 0,
   "title": "## آیهٔ بیست‌وشش احزاب و معنای قلب مرعوب",
   "start": 0.62,
   "end": 108.54
  },
  {
   "index": 1,
   "title": "## توحید افعالی؛ خرمشهر و کلید بصره",
   "start": 108.54,
   "end": 283.04
  },
  {
   "index": 2,
   "title": "## بنی‌قریظه، احزاب و شتاب تا عصر",
   "start": 283.04,
   "end": 477.72
  },
  {
   "index": 3,
   "title": "## حکم سعد بن معاذ میان مهاجر و انصار",
   "start": 477.72,
   "end": 519.74
  },
  {
   "index": 4,
   "title": "## نوار کاست، حکمت منافق و نفس به نفس",
   "start": 519.74,
   "end": 1059.27
  },
  {
   "index": 5,
   "title": "## هستهٔ خرما و دست باغبان",
   "start": 1059.27,
   "end": 1121.23
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.62,
   "end": 4.72,
   "text": "بسم الله الرحمن الرحيم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 4.72,
   "end": 8.84,
   "text": "السلام علیک یا داعی الله و ربانی یا آیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 8.84,
   "end": 12.3,
   "text": "سلام علیکم و رحمه الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 12.3,
   "end": 16.72,
   "text": "امروز تبرکی بجوییم از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 16.72,
   "end": 19.54,
   "text": "آیه بیست و شش سوره احزاب که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 19.54,
   "end": 24.56,
   "text": "این آیه هم سومین آیه ایست که پیرامون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 24.56,
   "end": 26.94,
   "text": "قلب مرعوب سخن گفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 26.94,
   "end": 29.82,
   "text": "قلب مرعوب بر وزن مفعول.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 29.82,
   "end": 33.92,
   "text": "عرض کردیم قلبیه که ترسانده شده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 33.92,
   "end": 41.64,
   "text": "ترس بر اون واقع شده. در این آیه می‌فرماید که و انزل الذين",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 41.64,
   "end": 44.74,
   "text": "ظاهروهم من اهل الكتاب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 44.74,
   "end": 48.44,
   "text": "من سیاسیهم بصاده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 48.44,
   "end": 53.12,
   "text": "و قذف في قلوبهم الرعب فریقا تقتلون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 53.12,
   "end": 55.58,
   "text": "و تأسرون فریقا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 55.58,
   "end": 58.6,
   "text": "تأسرون آخر با سینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 58.6,
   "end": 62.2,
   "text": "و خدا کسانی رو که از اهل کتاب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 62.2,
   "end": 67.76,
   "text": "که گروه های دشمن رو پشتیبانی کردند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 67.76,
   "end": 71.98,
   "text": "از قلعه های محکم و استوارشان پایین کشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 71.98,
   "end": 79.88,
   "text": "این سیاسیهم یعنی قلب، قلعه‌های محکم، کوه‌های",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 79.88,
   "end": 83.88,
   "text": "بسیار مستحکم. مثلاً به شاخ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 83.88,
   "end": 86.32,
   "text": "بز یا گاو و اینها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 86.32,
   "end": 90.58,
   "text": "اصطلاحاً این اصطلاح شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 90.58,
   "end": 95.26,
   "text": "که خیلی محکمه. این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 95.26,
   "end": 106.94,
   "text": "داره تمثیل می‌گیره قرآن قلعه‌های محکم این‌ها رو که درش پناه گرفته بودند و فکر می‌کردند دیگه کسی حریفشون نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 106.94,
   "end": 113.32,
   "text": "می‌فرماید خدا این اتفاقا یکی از آیاتیه که بحث توحید افعالی هم درش هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 113.32,
   "end": 117.24,
   "text": "و انزل. کی انزل؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 117.24,
   "end": 122.46,
   "text": "کی کسانی از اهل کتاب رو که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 122.46,
   "end": 127.9,
   "text": "دشمنشون رو پشتیبانی کرده بودند از قلعه‌های محکم و استوار پایین کشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 127.9,
   "end": 130.6,
   "text": "انزل حضرت حقه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 130.6,
   "end": 133.76,
   "text": "خودش توحید افعالی هم درش خوابیده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 133.76,
   "end": 141.32,
   "text": "چه کار دیگه کرد حضرت حق برای اینکه اینجا به داد اهل ایمان برسه، به داد پیغمبر برسه، در برابر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 141.32,
   "end": 144.76,
   "text": "این همه دشمنان و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 144.76,
   "end": 151.0,
   "text": "پشتیبانشون که دست به دست هم داده بودند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 151.0,
   "end": 154.28,
   "text": "دیگه فرمود و قذف في قلوبهم الرعب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 154.28,
   "end": 160.62,
   "text": "تو دلشون یک رعبی رو یک ترسی رو انداخت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 160.62,
   "end": 168.32,
   "text": "البته در پس این ترس وقتی اونا ترسیدن و شما متوجه شدید که دشمن ترسیده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 168.32,
   "end": 171.26,
   "text": "فریقا تقتلون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 171.26,
   "end": 175.9,
   "text": "یه عده‌شون رو شما می‌کشید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 175.9,
   "end": 178.64,
   "text": "و تأسرون فریقا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 178.64,
   "end": 180.46,
   "text": "گروهی‌شون رو هم چیکار می‌کنید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 180.46,
   "end": 185.78,
   "text": "اسیر می‌کنید. متأسفانه اهل ایمان وقتی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 185.78,
   "end": 188.7,
   "text": "پیروز میشن، غره میشن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 188.7,
   "end": 192.4,
   "text": "مغرور میشن، فکر می‌کنن کار خودشونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 192.4,
   "end": 195.0,
   "text": "صریح این آیه داره می‌فرماید که ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 195.0,
   "end": 200.44,
   "text": "یعنی حضرت حق ترس رو می‌ندازه به دل دشمن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 200.44,
   "end": 206.48,
   "text": "از این ترس و واهمه‌ای که اونا گرفتارش میشن، مضطرب میشن و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 206.48,
   "end": 211.34,
   "text": "خودشونو جمع می‌کنن از تعرض به شما به عبارتی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 211.34,
   "end": 214.44,
   "text": "منصرف میشن. بعد شما دست می‌زنید به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 214.44,
   "end": 220.1,
   "text": "کشتن‌شون و اسیر کردن‌شون و فز‌ش رو میدید که آره ما این کارو کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 220.1,
   "end": 224.62,
   "text": "واقعاً آزاد شدن خرمشهر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 224.62,
   "end": 227.62,
   "text": "کار عجیبی بود. یعنی کسی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 227.62,
   "end": 230.4,
   "text": "تاریخ جنگ رو خوب مرور کرده باشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 230.4,
   "end": 233.64,
   "text": "تأیید می‌کنه که کار کمی نبود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 233.64,
   "end": 236.52,
   "text": "آزاد سازی خرمشهر توسط رزمندگان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 236.52,
   "end": 242.6,
   "text": "اما باز حضرت امام علیه الرحمه فرمود خرمشهر رو خدا آزاد کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 242.6,
   "end": 245.76,
   "text": "ببینید چقدر در ادبیات حضرت امام توحید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 245.76,
   "end": 249.2,
   "text": "موج می‌زنه. در حالی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 249.2,
   "end": 251.78,
   "text": "رزمنده‌ها توی اوج",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 251.78,
   "end": 256.28,
   "text": "غرور ناشی از آزادی اون شهر شده بودند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 256.28,
   "end": 262.58,
   "text": "خب این یادته دیگه صدام گفته بود که اگه اینا خرمشهر رو بگیرن من کلید بصره رو بهشون تحویل میدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 262.58,
   "end": 265.88,
   "text": "انقدر مطمئن بود از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 265.88,
   "end": 271.38,
   "text": "استحکاماتی که اونجا یا تسلیحات نظامی که اونجا پیاده کرده بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 271.38,
   "end": 275.68,
   "text": "باید توجه کرد اینجا آیه واقعاً سراسر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 275.68,
   "end": 278.5,
   "text": "نشان از توحید افعالی داره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 278.5,
   "end": 283.04,
   "text": "که همش کار خداست. البته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 283.04,
   "end": 286.92,
   "text": "تفسیر نور آقای قرائتی رو که نگاه می‌کردم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 286.92,
   "end": 292.34,
   "text": "ایشون از نظر شیخ طوسی مطلبی رو میاره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 292.34,
   "end": 297.78,
   "text": "روحشون شاد. که می‌فرمود شیخ طوسی گوید این آیه درباره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 297.78,
   "end": 300.22,
   "text": "بنی قریظه نازل شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 300.22,
   "end": 302.98,
   "text": "اون آیه قبلی که خوندیم بار کی بود؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 302.98,
   "end": 307.36,
   "text": "بن النظیر. اگه یادتون باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 307.36,
   "end": 310.92,
   "text": "یه بنی-- بن النظیر بود، بنی قینقا بود،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 310.92,
   "end": 315.58,
   "text": "اینام بنی قریظه. اینا طایفه‌هایی بودند که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 315.58,
   "end": 319.44,
   "text": "با پیغمبر خیلی درگیر شدند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 319.44,
   "end": 324.46,
   "text": "این آیه درباره بنی قریظه نازل گردیده که پیمان و عهدی که با رسول خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 324.46,
   "end": 329.52,
   "text": "صلی الله علیه و آله وسلم داشتند بسته بودند رو شکستند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 329.52,
   "end": 333.74,
   "text": "و در جنگ احزاب به ابوسفیان کمک نموده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 333.74,
   "end": 339.84,
   "text": "و به او پیوستند. پس اینکه می‌فرمود که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 339.84,
   "end": 343.86,
   "text": "دشمن‌شون رو یاری دادن، پشتیبانی کردن چرا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 343.86,
   "end": 346.54,
   "text": "چون رفتن تو جنگ احزاب رفتن کمک--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 346.54,
   "end": 349.66,
   "text": "ممنونم از-- رفتن کمک ابوسفیان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 349.66,
   "end": 353.38,
   "text": "پیغمبر رو رها کردن. در حالی که پیمان داشتند با پیغمبر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 353.38,
   "end": 357.86,
   "text": "عهد شکستند، پیمانشون رو شکستند و رفتند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 357.86,
   "end": 364.84,
   "text": "کمک ابوسفیان. نظر شیخ طوسی رو دارم خدمتتون عرض می‌کنم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 364.84,
   "end": 368.26,
   "text": "تا وقتی که دشمن فرار اختیار کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 368.26,
   "end": 375.36,
   "text": "یعنی تا اون لحظه اینا پشتبانی می‌کردن از ابوسفیان تا اینکه دیگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 375.36,
   "end": 379.5,
   "text": "فرار کردن به جهت اون ترسی که خدا تو دلشون انداخت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 379.5,
   "end": 383.8,
   "text": "در این میان منادی مسلمین ندا کرد که ای مسلمانان!",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 383.8,
   "end": 389.56,
   "text": "پیامبر فرماید تا نماز عصر باید بنی قریظه دستگیر شوند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 389.56,
   "end": 394.86,
   "text": "این فرمایش پیغمبر نشون میده که به نظر شیخ طوسی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 394.86,
   "end": 400.28,
   "text": "گنده‌ نماز ظهر رو خوندن درگیر شدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 400.28,
   "end": 406.64,
   "text": "بعد پیغمبر فرمود بنی قریظه رو بگیرید بعد نماز عصر رو بخونید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 406.64,
   "end": 410.52,
   "text": "یعنی انقدر مهم بوده. گاهی اوقات ما مهلت میدیم به دشمن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 410.52,
   "end": 418.02,
   "text": "این نشون دهنده اینه که چقدر پیغمبر سیاس بود، زیرک بود در امر جنگ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 418.02,
   "end": 420.14,
   "text": "که به دشمن نباید مجال داد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 420.14,
   "end": 422.28,
   "text": "نباید فرصت داد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 422.28,
   "end": 427.4,
   "text": "ما متاسفانه خیلی به دشمنمون فرصت میدیم تا تجهیز بشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 427.4,
   "end": 430.1,
   "text": "این شتاب سریع این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 430.1,
   "end": 433.48,
   "text": "فرمایش خدا در این قرآن داره همین رو تصریح می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 433.48,
   "end": 440.58,
   "text": "البته روایاتی هم که ذیلش امثال شیخ طوسی‌ها آوردن داره همین رو بیان می‌کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 440.58,
   "end": 445.22,
   "text": "که پیغمبر فرمود اول برید بنی قریظه رو دستگیر کنید بعد نماز عصر رو می‌خونیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 445.22,
   "end": 449.48,
   "text": "یعنی پس از گرفتار ساختن آنان نماز عصر خوانده شود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 449.48,
   "end": 453.72,
   "text": "زیرا جبرئیل بر پیغمبر نازل گردیده و گوید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 453.72,
   "end": 458.98,
   "text": "هنوز فرشتگان سلاح و اسلحه خویش به زمین ننهاده‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 458.98,
   "end": 465.14,
   "text": "لذا بنی قریظه را گرفتار ساختند و چندین روز آنها را در محاصره گذاشتند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 465.14,
   "end": 467.62,
   "text": "یعنی گرفتارشون کردن. دیگه خیالشون راحت شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 467.62,
   "end": 469.58,
   "text": "محاصره‌شون کردن که دیگه ت--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 469.58,
   "end": 472.24,
   "text": "مطمئن شدن اینا نمی‌تونن فرار کنن از اینجا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 472.24,
   "end": 477.2,
   "text": "دیگه نماز عصرشونو خوندن. البته اون محاصره چند روز طول کشیده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 477.2,
   "end": 479.94,
   "text": "تا اینکه یهود بنی قریظه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 479.94,
   "end": 485.76,
   "text": "سعد بن معاذ را وسیله قر-- یه وسیله‌ای براداد سعد رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 485.76,
   "end": 487.64,
   "text": "که اون حکم کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 487.64,
   "end": 490.14,
   "text": "گفتن ما هرچی این سعد بگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 490.14,
   "end": 492.92,
   "text": "ما راضی ایم. سعد حرف بزنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 492.92,
   "end": 498.08,
   "text": "خب سعد هم می‌دونید از صحابی خیلی خاص پیغمبر محمد مؤمنین بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 498.08,
   "end": 502.24,
   "text": "جانباز جنگ بود و بر اثر همون جراحتی هم که برداشت به شهادت رسید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 502.24,
   "end": 508.54,
   "text": "داستانش مفصله. می‌دونید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 508.54,
   "end": 514.68,
   "text": "سعد حکم داد که مردان آنان کشته شوند و زنان و کودکان آنها اسیر گردند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 514.68,
   "end": 524.06,
   "text": "و اموال آنها نیز تقسیم گردد و زمین آنها به مهاجرین برسد و انصار در زمین مزبور سهمی نداشته باشند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 524.06,
   "end": 526.74,
   "text": "خب اونا که مهاجر بودن اسمشون رو خودشونه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 526.74,
   "end": 529.98,
   "text": "مهاجرت کرده بودند، اومده بودند مدینه کمک پیغمبر کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 529.98,
   "end": 534.86,
   "text": "خب جا نداشتن. ایشون گفت که این زمین‌ها برسه به مهاجرین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 534.86,
   "end": 539.12,
   "text": "انصار دیگه اونجا خونه زندگی داشتن، زمین داشتن، اینا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 539.12,
   "end": 544.42,
   "text": "به اونا چیزی نرسه. پیغمبر فرمود ای سعد!",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 544.42,
   "end": 547.6,
   "text": "به حکم خداوند میان آنان حکم کرده‌ای.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 547.6,
   "end": 550.02,
   "text": "اینجا یه نکته‌ای هست اینکه سعد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 550.02,
   "end": 557.26,
   "text": "حکم می‌کنه درست هم حکم می‌کنه چون پیغمبر این البته اینکه تا اینجا خوندم به نظر شیخ طوسی‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 557.26,
   "end": 559.34,
   "text": "بعد رحمت الله علیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 559.34,
   "end": 564.44,
   "text": "این نشون میده که با تاییدی که پیغمبر می‌کنه سعد درست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 564.44,
   "end": 567.14,
   "text": "حکم رو بیان می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 567.14,
   "end": 572.44,
   "text": "اولاً اینجا جایگاه صحابی پیغمبر مشخص میشه که چقدر این‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 572.44,
   "end": 574.4,
   "text": "در تشخیص احکام قوی بودند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 574.4,
   "end": 576.18,
   "text": "یعنی فقیه بودند اینطوری بگیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 576.18,
   "end": 579.74,
   "text": "فقیه بودند و الا چگونه حکم می‌تونه صادر کنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 579.74,
   "end": 584.16,
   "text": "اونم درست و قاطع. نکته دوم اینکه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 584.16,
   "end": 588.48,
   "text": "ما در تاریخ داریم در تاریخ اسلام که بعضیا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 588.48,
   "end": 593.44,
   "text": "اه حتی یک مورد دیدم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 593.44,
   "end": 598.04,
   "text": "زودتر از اینکه وحی به پیغمبر نازل بشه، یه نفر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 598.04,
   "end": 601.48,
   "text": "یه آیه رو گفت. بعد پیغمبر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 601.48,
   "end": 604.22,
   "text": "وقتی آیه نازل شد همون رو تایید کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 604.22,
   "end": 607.3,
   "text": "فرمود همون که ایشون گفت رو خدا فرمود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 607.3,
   "end": 611.08,
   "text": "اون شخص راه افتاد برای خودش تو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 611.08,
   "end": 616.62,
   "text": "همسایه و مردم و کوچه و بازار که آره به منم وحی میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 616.62,
   "end": 623.1,
   "text": "این ادعا رو کرد. فرمود-- پیغمبر فرمود این داره فساده می‌کنه و بکشیدش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 623.1,
   "end": 627.14,
   "text": "از این غافلن. نفس پیغمبر ببین چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 627.14,
   "end": 631.7,
   "text": "همنشینی با پیغمبر انسان رو تا جایی می‌بره که وح--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 631.7,
   "end": 633.62,
   "text": "وصل بشه به مرکز مه--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 633.62,
   "end": 636.02,
   "text": "وحی و مبدأ فیض.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 636.02,
   "end": 638.42,
   "text": "وصل بشه به مبدأ فیض،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 638.42,
   "end": 640.7,
   "text": "به مرکز وحی. چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 640.7,
   "end": 645.68,
   "text": "همنشینی با پیغمبر. این نکته خیلی حائز اهمیته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 645.68,
   "end": 656.76,
   "text": "مثل اینکه وقتی که ابا بصیر صلوات الله علیه اومد پیش امام صادق صلوات الله علیه گفت آقا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 656.76,
   "end": 660.3,
   "text": "من اه شنیدم که شما فرمودید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 660.3,
   "end": 663.98,
   "text": "خدا رو روز قیامت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 663.98,
   "end": 667.84,
   "text": "رؤیت می‌کنن، ملاقات می‌کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 667.84,
   "end": 670.9,
   "text": "حضرت تایید کردن. بعد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 670.9,
   "end": 673.58,
   "text": "فرمودن البته نه با چشم بصر،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 673.58,
   "end": 678.0,
   "text": "با چشم دل. بعد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 678.0,
   "end": 681.42,
   "text": "فرمود نه روز ق-- حضرت فرمود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 681.42,
   "end": 686.4,
   "text": "فرمود نه روز قیامت بلکه همین جا رؤیت می‌کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 686.4,
   "end": 690.96,
   "text": "یعنی همین جا هم خدای منان قابل ملاقاته، قابل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 690.96,
   "end": 694.74,
   "text": "لقاست. همین جا میشه لقاء الله رو درک کرد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 694.74,
   "end": 698.26,
   "text": "و موت قبل انتمتو بهش رسید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 698.26,
   "end": 702.76,
   "text": "بعد ابا بصیر خیلی شگفت زده شده دست پاشو گم کرد انگار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 702.76,
   "end": 708.52,
   "text": "انقدر هیجان زده شد از این فرمایش حضرت که همین جا میشه خدا رو ملاقات کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 708.52,
   "end": 711.84,
   "text": "حرف، حرف سنگینیه. خب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 711.84,
   "end": 715.02,
   "text": "رفیقایی داشت، عیلت و طوائر و فامیلی‌هایی داشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 715.02,
   "end": 719.46,
   "text": "از حضرت اذن خواست که بره اینو به اونام بگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 719.46,
   "end": 723.72,
   "text": "گفت آقا اجازه دارم برم این فرمایش شما رو به اون‌ها بگم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 723.72,
   "end": 730.55,
   "text": "حضرت یه جمله‌ای دارن اگر کسی متوجه منظور حضرت نباشه اشتباه برداشت می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 730.55,
   "end": 733.65,
   "text": "حضرت فرمودن که از کجا می‌دونی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 733.65,
   "end": 738.51,
   "text": "اون‌ها مثل تو این رو درست برداشت کنن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 738.51,
   "end": 743.75,
   "text": "مورد ملاقات با خدا در همین دنیا رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 743.75,
   "end": 745.69,
   "text": "تو یعنی چی رو می‌خواد بفرماید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 745.69,
   "end": 749.65,
   "text": "می‌خواد بفرماید که تو الان در محضر امامی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 749.65,
   "end": 752.77,
   "text": "امام به تو القا کرد که خوب گرفتی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 752.77,
   "end": 758.09,
   "text": "گفتی آها روشن شدم، گرفتم، فهمیدم، رسیدم، چشیدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 758.09,
   "end": 762.13,
   "text": "دیگه دارا شدم نه صرفاً دانا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 762.13,
   "end": 765.29,
   "text": "یعنی علم فکریم تبدیل شد به علم شهودی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 765.29,
   "end": 770.45,
   "text": "این از اثر هم‌نشینی با امام معصومه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 770.45,
   "end": 773.93,
   "text": "حالا شما می‌خوای پاشی بری به کسی دیگه بگی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 773.93,
   "end": 780.57,
   "text": "اینکه می‌فرماید از کجا می‌دونه که اون‌ها هم همونطور که تو درست متوجه ملاقات با خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 780.57,
   "end": 786.21,
   "text": "شدی، یعنی اصلاً یعنی چی ملاقات با خدا که تو این دنیا هم امکانش هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 786.21,
   "end": 790.79,
   "text": "از کجا معلوم دوستان شما هم اینو خوب متوجه بشن درست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 790.79,
   "end": 793.05,
   "text": "اونطور که تو درست متوجه شدی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 793.05,
   "end": 796.69,
   "text": "منظور حضرت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 796.69,
   "end": 802.29,
   "text": "به تصریح حضرت استاد دارم عرض می‌کنم خدمتتون، حضرت علامه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 802.29,
   "end": 805.73,
   "text": "که تو یکی از مباحث همین رو ازشون شنیدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 805.73,
   "end": 808.19,
   "text": "چه همون مبحثی که شخص زود،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 808.19,
   "end": 813.85,
   "text": "زودتری آیه‌ی قرآن رو احضار کرد از ایشون شنیدیم، چه این موضوع رو روح ایشون شاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 813.85,
   "end": 820.79,
   "text": "فرمودن این اثر هم‌نشینی یا اثر نفس امام معصومه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 820.79,
   "end": 825.01,
   "text": "این رو نباید ازش غافل شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 825.01,
   "end": 828.29,
   "text": "که متأسفانه ما معمولاً از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 828.29,
   "end": 830.57,
   "text": "اثر هم‌نشینی غافلیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 830.57,
   "end": 834.25,
   "text": "شما دقت کنین الان ک-ک در حقیقت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 834.25,
   "end": 836.21,
   "text": "درس و بحث‌های ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 836.21,
   "end": 838.77,
   "text": "حتی جلسات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 838.77,
   "end": 842.89,
   "text": "یا به عبارتی بگیم دستورالعمل‌های سیر و سلوکی ما که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 842.89,
   "end": 846.95,
   "text": "حیثیتش عملیه، نظری که نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 846.95,
   "end": 849.45,
   "text": "شما یه کتاب بخونی و نمی‌دونم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 849.45,
   "end": 852.03,
   "text": "علم فکری‌ت زیاد بشه و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 852.03,
   "end": 854.75,
   "text": "عقل نظری‌ت زیاد بشه و قوی بشه که نیست که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 854.75,
   "end": 858.95,
   "text": "حیثیت عمله، عقل عملیه، سیر و سلوکه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 858.95,
   "end": 862.95,
   "text": "غالباً بسنده می‌کنیم به صوت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 862.95,
   "end": 868.43,
   "text": "صوت گوش میدیم. یه فیلم و کلیپ اون عالم رو، اون مثلاً شخصیتو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 868.43,
   "end": 875.43,
   "text": "گوش میدیم. فوقش خیلی هنر کنیم کتابشو بخونیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 875.43,
   "end": 880.45,
   "text": "این غافل شدن از اثر هم‌نشینی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 880.45,
   "end": 886.25,
   "text": "این بلا رو سر ما آورده. در صورتی که بارها عرض کردیم حضرت علامه روحشون شاد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 886.25,
   "end": 889.79,
   "text": "بارها از ایشون شنیدیم که فرمودن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 889.79,
   "end": 892.49,
   "text": "گول این نوامغ و نوار رو،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 892.49,
   "end": 894.59,
   "text": "گول این نوارهای کاست رو نخورید ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 894.59,
   "end": 898.57,
   "text": "اینا ماده‌س، اینا ماده‌س.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 898.57,
   "end": 902.25,
   "text": "ملکوت نیست، مجرد نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 902.25,
   "end": 907.41,
   "text": "اثری که در حضور هست در این شنیدن نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 214,
   "start": 907.41,
   "end": 911.27,
   "text": "یعنی عادت کنی بری حاضر بشی در محضر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 215,
   "start": 911.27,
   "end": 917.77,
   "text": "استاد، در کلاس درس و بحث و مخصوصاً در بحث سیر و سلوک.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 216,
   "start": 917.77,
   "end": 922.59,
   "text": "اصلاً حرف اول رو نفس طرف می‌زنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 217,
   "start": 922.59,
   "end": 926.19,
   "text": "خیلی هم مخصوصاً عرض می‌کنم ها تو بحث سیر و- یه وقت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 218,
   "start": 926.19,
   "end": 932.11,
   "text": "بحث نظری امیرالمؤمنین علیه السلام فرمود حکمت رو ولو از منافق فرا بگیرید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 219,
   "start": 932.11,
   "end": 933.85,
   "text": "حکمت رو ولو از منافق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 220,
   "start": 933.85,
   "end": 938.07,
   "text": "اینجا منظور از حکمت اون علم باطنی نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 221,
   "start": 938.07,
   "end": 946.99,
   "text": "و الا خب علم باطنی حکمت اگر بگیم علم به احوال اعیان موجوداته به قدر طاقت بشری پیش منافق که حکمت نیست که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 222,
   "start": 946.99,
   "end": 951.61,
   "text": "منظور اینجا همون علمه، علم ظاهریه، علم فکریه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 223,
   "start": 951.61,
   "end": 953.73,
   "text": "پیش منافق علم فکریه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 224,
   "start": 953.73,
   "end": 955.37,
   "text": "دو تا نکته‌ی مهم فرمودید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 225,
   "start": 955.37,
   "end": 958.33,
   "text": "یکی از سیره همرات دشمنان غافل نشیم-",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 226,
   "start": 958.33,
   "end": 960.53,
   "text": "بله از هم‌نشینی با ایام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 227,
   "start": 960.53,
   "end": 965.95,
   "text": "احسن به شما. بله این دو تا نکته رو خوب شما فرمودید و گرفتید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 228,
   "start": 965.95,
   "end": 970.29,
   "text": "اونجا حضرت استاد فرمودن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 229,
   "start": 970.29,
   "end": 973.75,
   "text": "توجه به این، یعنی اکتفا نکنید به صوت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 230,
   "start": 973.75,
   "end": 976.21,
   "text": "چند؟ ها چهار دقیقه شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 231,
   "start": 976.21,
   "end": 977.91,
   "text": "اکتفا به این صوت نکنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 232,
   "start": 977.91,
   "end": 983.37,
   "text": "حتماً دعوتون این باشه که برید بشینید پای درس استاد و اثر هم‌نشینی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 233,
   "start": 983.37,
   "end": 986.59,
   "text": "همیشه همین دو تا انگشت مبارک رو اینطوری به هم می‌زدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 234,
   "start": 986.59,
   "end": 990.33,
   "text": "نفس به نفس یا نفس به نفس،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 235,
   "start": 990.33,
   "end": 994.43,
   "text": "تعبیر ایشون بود. اثر اصلی رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 236,
   "start": 994.43,
   "end": 998.17,
   "text": "در نفس به نفس یا نفس به نفس می‌گیریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 237,
   "start": 998.17,
   "end": 1000.29,
   "text": "مخصوصاً تو بحث‌های سیر و سلوکی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 238,
   "start": 1000.29,
   "end": 1005.29,
   "text": "عرض کردم یه وقت حیثیت نظر و علم فکریه که از منافق هم می‌شه کسب کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 239,
   "start": 1005.29,
   "end": 1012.53,
   "text": "اما سیر و سلوک عملی رو آـ- انسان فقط باید بره پای درس کسی که نفس دارد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 240,
   "start": 1012.53,
   "end": 1016.23,
   "text": "یعنی چی نفس داره؟ یعنی خودش اهل عمله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 241,
   "start": 1016.23,
   "end": 1021.33,
   "text": "یعنی در خودش پیاده کرده، نه صرفاً علم فکری‌ش باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 242,
   "start": 1021.33,
   "end": 1024.07,
   "text": "و الا تأثیر نمی‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 243,
   "start": 1024.07,
   "end": 1030.03,
   "text": "میری یه چهار تا حرف قشنگ می‌زنه طرف و تو هم خوشت میاد و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 244,
   "start": 1030.03,
   "end": 1035.35,
   "text": "مثل امیرالمؤمنین علیه السلام در این خصوص فرمودن اثرش در تو مثل بارشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 245,
   "start": 1035.35,
   "end": 1038.21,
   "text": "یه نمی از باران به سینه صخره‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 246,
   "start": 1038.21,
   "end": 1041.71,
   "text": "یه نمی می‌زنه و بعدم خشک می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 247,
   "start": 1041.71,
   "end": 1044.01,
   "text": "برکه‌ای از آب جمع نمی‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 248,
   "start": 1044.01,
   "end": 1047.55,
   "text": "استخری از آب روـ چقدر زیبا میگه: \"رودی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 249,
   "start": 1047.55,
   "end": 1053.95,
   "text": "رودی راه بیفته\" در تو جریان پیدا کنه، نه خیر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 250,
   "start": 1053.95,
   "end": 1057.81,
   "text": "اینا خیلی مهمه. یعنی ببینید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 251,
   "start": 1057.81,
   "end": 1060.53,
   "text": "دانه، دانه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 252,
   "start": 1060.53,
   "end": 1062.73,
   "text": "دانه در خودش چی داره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 253,
   "start": 1062.73,
   "end": 1066.07,
   "text": "دانه در خودش مثلاً دانه‌ی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 254,
   "start": 1066.07,
   "end": 1068.75,
   "text": "خرما، هسته‌ی خرما،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 255,
   "start": 1068.75,
   "end": 1071.97,
   "text": "خود نخل خرما درش تعبیه شده دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 256,
   "start": 1071.97,
   "end": 1074.25,
   "text": "مندمج شده در خرماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 257,
   "start": 1074.25,
   "end": 1077.97,
   "text": "اما این خرما باید کاشته بشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 258,
   "start": 1077.97,
   "end": 1081.71,
   "text": "بره در اون قعر زمین، تو تاریکی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 259,
   "start": 1081.71,
   "end": 1085.13,
   "text": "تو سختی فشار زمین، گل و لای،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 260,
   "start": 1085.13,
   "end": 1089.49,
   "text": "آب بهش بدن، چی بدونم سم و چی و اینا بهش رسیدگی کنن تا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 261,
   "start": 1089.49,
   "end": 1092.43,
   "text": "استعدادش پرورش پیدا کنه بیاد بیرون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 262,
   "start": 1092.43,
   "end": 1098.33,
   "text": "اون استعداد درون اون هسته‌ی خرما چی باعث شد که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 263,
   "start": 1098.33,
   "end": 1102.71,
   "text": "بیاد بیرون و اون قابلیتش تبدیل بشه به فعلیت؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 264,
   "start": 1102.71,
   "end": 1106.21,
   "text": "چی؟ اون اثر باغبون،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 265,
   "start": 1106.21,
   "end": 1108.77,
   "text": "دست باغبون، نفس باغبون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 266,
   "start": 1108.77,
   "end": 1113.85,
   "text": "اینو روش فکر کنید حالا انشاالله چون دیگه یه رب هم گذشت شده جلسه بعد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 267,
   "start": 1113.85,
   "end": 1117.15,
   "text": "اللهم بارک لمولانا صاحب الزمان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 268,
   "start": 1117.15,
   "end": 1121.23,
   "text": "والحمد لله رب العالمين. صلوات. اللهم صلي",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}