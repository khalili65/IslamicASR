   "start": 43.44,
   "end": 236.04
  },
  {
   "index": 1,
   "title": "## یقظه و توبه در منازل السائرین",
   "start": 236.04,
   "end": 363.09
  },
  {
   "index": 2,
   "title": "## عیش گوارا: ذکر دائم و طلب رضا",
   "start": 363.09,
   "end": 525.59
  },
  {
   "index": 3,
   "title": "## حیات جاودان: رضا و پاکی قلب",
   "start": 525.59,
   "end": 614.83
  },
  {
   "index": 4,
   "title": "## محبت الهی و تنگی دنیا برای اهل ایمان",
   "start": 614.83,
   "end": 751.85
  },
  {
   "index": 5,
   "title": "## زیور هیبت و سه عطای اهل رضا",
   "start": 751.85,
   "end": 1024.65
  },
  {
   "index": 6,
   "title": "## همت واحد و غفلت از خدا",
   "start": 1024.65,
   "end": 1173.01
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.48,
   "end": 5.04,
   "text": "صلی الله علیه و آله و سلم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 5.04,
   "end": 9.56,
   "text": "بسم الله الرحمن الرحیم و به این استعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 9.56,
   "end": 13.28,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 13.28,
   "end": 18.78,
   "text": "آیاته. سلامٌ علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 18.78,
   "end": 24.56,
   "text": "ما در آیه بیست و شش surah Ahzab بودیم پیرامون قلب مرعوب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 24.56,
   "end": 30.24,
   "text": "و انزل الذین باهروهم من اهل الكتاب من",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 30.24,
   "end": 40.0,
   "text": "سیاسیهم و قذف في قلوبهم الرعب فريقا تقتلون و تأسرون فريقا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 40.0,
   "end": 43.44,
   "text": "عرض کردیم که ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 43.44,
   "end": 46.84,
   "text": "جلسه پیش این آیه رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 46.84,
   "end": 50.94,
   "text": "با نگاه تفسیر انسی نگاه کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 50.94,
   "end": 60.12,
   "text": "این سیاسیهم رو که این‌ها میرن تو سنگرهایی که یهودیانی که عهدشون رو با پیغمبر شکسته بودند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 60.12,
   "end": 65.6,
   "text": "طبق صریح این آیه میرن در اون سنگرها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 65.6,
   "end": 67.58,
   "text": "خودشون رو مثلاً جان پناه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 67.58,
   "end": 71.84,
   "text": "قرار میدن. این رو عرض کردیم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 71.84,
   "end": 75.98,
   "text": "عادات و یعنی در حقیقت نماد افکار و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 75.98,
   "end": 78.3,
   "text": "عادات و ویژگی‌های",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 78.3,
   "end": 81.56,
   "text": "ریشه‌داریه که تو وجود انسان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 81.56,
   "end": 87.06,
   "text": "هست و آدم وقتی می‌خواد از حقیقت فرار کنه پناه می‌بره به اون‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 87.06,
   "end": 90.54,
   "text": "وقتی با نگاه انسی به آیه نگاه می‌کنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 90.54,
   "end": 96.34,
   "text": "میگه اون‌ها رفتن توی توی سنگرهاشون می‌رفتند پنهان می‌شدند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 96.34,
   "end": 98.76,
   "text": "اینجا هم انسان تو خودش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 98.76,
   "end": 102.46,
   "text": "میره تو اون افکار پلیدش، موهوماتش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 102.46,
   "end": 106.0,
   "text": "که حقیقت نداره پنهان می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 106.0,
   "end": 110.58,
   "text": "بعد این و قذف في قلوبهم الرعب رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 110.58,
   "end": 113.34,
   "text": "تو بحث تفسیر انسی گفتیم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 113.34,
   "end": 116.52,
   "text": "خب از اونجایی که خدای منان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 116.52,
   "end": 122.98,
   "text": "می‌خواد مردم رو هدایت کنه به سمت خودش،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 122.98,
   "end": 128.28,
   "text": "حقیقت رو، نور حقیقت رو که به اون‌ها می‌تابونه، اون کسی که هنوز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 128.28,
   "end": 131.98,
   "text": "قلبش کاملاً نمرده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 131.98,
   "end": 134.2,
   "text": "و قلبش هنوز بیداره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 134.2,
   "end": 136.0,
   "text": "چه اتفاقی براش رخ میده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 136.0,
   "end": 141.2,
   "text": "اصطلاحاً میگیم وجدانش بیدار می‌شه، یغزه براش رخ میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 141.2,
   "end": 145.72,
   "text": "این بیداری از جهت اضطراب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 145.72,
   "end": 149.38,
   "text": "و استیسال ناشی از تابیدن نور خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 149.38,
   "end": 153.5,
   "text": "وقتی مواجه با عظمت حضرت حق می‌شه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 153.5,
   "end": 157.04,
   "text": "حق رو متوجه می‌شه اصطلاحاً می‌گیره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 157.04,
   "end": 161.96,
   "text": "می‌فهمه، می‌چشه، متوجه می‌شه که حق چیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 161.96,
   "end": 167.14,
   "text": "بعد چون خودش ضعیفه، ذلیله، فقیره، حقیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 167.14,
   "end": 173.22,
   "text": "یا مولای، یا مولای انت القوی و انا الضعیف و هل يرحم ال--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 173.22,
   "end": 175.58,
   "text": "هل يرحم الضعيف الا القوي؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 175.58,
   "end": 179.2,
   "text": "متوجه این می‌شه چون خودش ضعیفه در برابر،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 179.2,
   "end": 185.3,
   "text": "در برابر عظمت حضرت حق به لرزه می‌افته، به استیسال می‌افته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 185.3,
   "end": 191.6,
   "text": "و حالت ترس و خوف و اضطراب و اینا بهش دست میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 191.6,
   "end": 196.98,
   "text": "این هم اون رعب برای اهل ایمانه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 196.98,
   "end": 202.84,
   "text": "و قذف في قلوبهم الرعب رو ما از حیث شأن نزول و ظاهر آیه بحث کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 202.84,
   "end": 205.9,
   "text": "بحث تفسیر تاریخیش رو بیان کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 205.9,
   "end": 209.44,
   "text": "حالا با نگاه تفسیر انسی که نگاه می‌کنیم این شکلی شد دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 209.44,
   "end": 212.1,
   "text": "اینا رو گفتیم که اون کشته شدن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 212.1,
   "end": 215.06,
   "text": "که میگه دلشون رو می‌کشید، ده‌دشون رو اسیر می‌کنید؛",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 215.06,
   "end": 220.74,
   "text": "گفتیم اون طرف وقتی حالت بیداری براش پیش اومد شروع می‌کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 220.74,
   "end": 224.14,
   "text": "اون افکار غلط رو، موهومات رو،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 224.14,
   "end": 229.1,
   "text": "قبائح وجودیش رو ریشه‌کن می‌کنه، می‌شه کشتید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 229.1,
   "end": 232.24,
   "text": "بر اون‌ها غالب می‌شه، می‌شه اسیرشون کردید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 232.24,
   "end": 235.4,
   "text": "تا اینجا رو جلسه پیش گفتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 235.4,
   "end": 238.02,
   "text": "حالا این کی پیش میاد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 238.02,
   "end": 242.78,
   "text": "چگونه پیش میاد؟ برای اینکه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 242.78,
   "end": 248.5,
   "text": "ما چون گفتیم که با عظمت خدا، با جلال حضرت حق وقتی رو به رو می‌شیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 248.5,
   "end": 258.08,
   "text": "این حالت رعب در دل ایجاد می‌شه که وجدان بیدار می‌شه و یغزه پیش میاد که انسان در اولین منزل منازل الصائرین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 258.08,
   "end": 260.6,
   "text": "یا صد منزل دل خواجه عبدالله قرار می‌گیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 260.6,
   "end": 262.74,
   "text": "منزل دوم می‌شه توبه. از این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 262.74,
   "end": 266.02,
   "text": "بی-بیداری که براش رخ داد میره به سمت توبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 266.02,
   "end": 270.94,
   "text": "برای اینکه اینو خوب متوجه بشیم که کار کار کیه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 270.94,
   "end": 275.4,
   "text": "یه روایت خیلی قشنگ براتون می‌خونم، کیف کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 275.4,
   "end": 277.8,
   "text": "فقط خواهشا تو چرت نرید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 277.8,
   "end": 281.02,
   "text": "حیفه. منظورش اینه که بیدار باشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 281.02,
   "end": 287.44,
   "text": "این البته کتابی که الان دست بنده است سبک زندگی مؤمنانه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 287.44,
   "end": 291.16,
   "text": "از مجموعه آثار علامه طباطبایی علیه الرحمه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 291.16,
   "end": 293.98,
   "text": "منتها اینجا حضرت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 293.98,
   "end": 298.86,
   "text": "علامه سند آوردن از بهار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 298.86,
   "end": 303.94,
   "text": "که بهار هم از اش-- ارشاد دیلمی این روایت رو نقل کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 303.94,
   "end": 307.74,
   "text": "جزو احادیث معراجیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 307.74,
   "end": 319.24,
   "text": "که وقتی پیغمبر اعز الله علمه معراج رفتند، خدای سبحان به رسول خدا فرمود ای احمد صلی الله علیه و آله و سلم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 319.24,
   "end": 322.3,
   "text": "سلام. هیچ،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 322.3,
   "end": 327.16,
   "text": "هیچ می‌دانی کدام زن-- حالا خدا اول یه سؤال می‌کنه از پیغمبر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 327.16,
   "end": 330.36,
   "text": "خیلی جالبه. یکی از سبک‌های",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 330.36,
   "end": 333.7,
   "text": "خوب و اثرگذار در تعلیم ایجاد سؤاله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 333.7,
   "end": 338.56,
   "text": "سؤال کنی بعد جواب بدی. همین کارو خدا در معراج با پیغمبر کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 338.56,
   "end": 341.66,
   "text": "سؤال پرسیده آیا می‌دانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 341.66,
   "end": 345.78,
   "text": "کدام زندگی گوارات، گواراتر یعنی شیرین‌تر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 345.78,
   "end": 349.36,
   "text": "و کدام حیات جاودانه تر است؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 349.36,
   "end": 353.08,
   "text": "دو تا سؤاله. کدوم زندگی شیرین‌تره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 353.08,
   "end": 357.18,
   "text": "و کدوم حیات ابدی‌تره، جاودانه‌تره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 357.18,
   "end": 363.09,
   "text": "پیغمبر اعز الله علمه عرض کرد که پروردگارا نمی‌دونم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 363.09,
   "end": 366.03,
   "text": "خدا فرمود اما عیش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 366.03,
   "end": 370.19,
   "text": "گوارا یعنی اون زندگی که شیرینه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 370.19,
   "end": 376.93,
   "text": "آن عیشی‌ست که صاحبش از ذکر و یاد من سست نشود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 376.93,
   "end": 380.57,
   "text": "و نعمت مرا فراموش نکند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 380.57,
   "end": 383.51,
   "text": "و جاهل به حق من نشود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 383.51,
   "end": 388.23,
   "text": "شب و روز رضای مرا طلب کند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 388.23,
   "end": 394.85,
   "text": "این مشخصاتی که چند جمله خدا فرمود شب و روز رضایت منو طلب کنه، در ذکر من باشه و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 394.85,
   "end": 397.73,
   "text": "رضایت منو دنبال کنه میشه چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 397.73,
   "end": 402.87,
   "text": "شیرینی زندگی. اصلاً شنیدید اون روایتو که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 402.87,
   "end": 406.97,
   "text": "امیرالمؤمنین علیه الصلاة والسلام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 406.97,
   "end": 411.33,
   "text": "نشسته بودند با پیغمبر زیر سایه یه درختی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 411.33,
   "end": 415.19,
   "text": "بعد یه زنبوری اومد دور سر پیغمبر هی چرخید،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 415.19,
   "end": 418.89,
   "text": "هی وز وز کرد و بعد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 418.89,
   "end": 422.43,
   "text": "پیغمبر اعظظم لبخند زد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 422.43,
   "end": 425.95,
   "text": "امیرالمؤمنین سؤال کرد یا رسول الله چی شد که شما این زنبورو دیدید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 425.95,
   "end": 429.67,
   "text": "چی شد که خندیدی؟ فرمود این زنبور",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 429.67,
   "end": 437.45,
   "text": "یه چیزی به من گفت برام جالب بود که گفت یا رسول الله ما اون شهد رو که می‌گیریم به خرطوممون خیلی تلخه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 437.45,
   "end": 439.59,
   "text": "می‌دونید چی میشه که شیرین میشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 439.59,
   "end": 443.63,
   "text": "میشه عسل. من پرسیدم چیکار می‌کنید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 443.63,
   "end": 447.07,
   "text": "گفت همون لحظه خدا به ما وحی می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 447.07,
   "end": 450.01,
   "text": "تو قرآن هست. بله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 450.01,
   "end": 454.05,
   "text": "و او حائل النحل. ما وحی می‌کنیم به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 454.05,
   "end": 460.25,
   "text": "زنبور عسل. همون لحظه خدا به ما وحی می‌کنه بر شما و اهل بیتت صلوات بفرستیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 460.25,
   "end": 463.83,
   "text": "اللهم صل على محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 463.83,
   "end": 469.63,
   "text": "بر اثر صلواتی که ما می‌فرستیم به شما و اهل بیتتون، اون شهد عسل تلخ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 469.63,
   "end": 471.91,
   "text": "بدل میشه به شیرینی عسل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 471.91,
   "end": 474.49,
   "text": "اینه که عسل تو قرآن می‌فرماید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 474.49,
   "end": 479.65,
   "text": "شفاست. تو قرآن چند تا چیزو شفا معرفی کرده یکیش عسله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 479.65,
   "end": 484.71,
   "text": "به همین جهت. حالا فلسفه آب لیمو عسل‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 484.71,
   "end": 487.93,
   "text": "مشخص شد. بله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 487.93,
   "end": 492.71,
   "text": "پس این زندگی رو شیرین می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 492.71,
   "end": 496.81,
   "text": "اینکه اول فرمود س-ا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 496.81,
   "end": 501.83,
   "text": "صاحبش را ذکر و یاد من سست نشود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 501.83,
   "end": 504.95,
   "text": "صاحب این زندگی شیرین رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 504.95,
   "end": 508.83,
   "text": "وقتی که ذکر و یاد من می‌کنه سست نمیشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 508.83,
   "end": 510.91,
   "text": "یعنی دائم الذکره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 510.91,
   "end": 517.17,
   "text": "خیلی دوست داره ذکر رو. خوشش میاد و این ذکر شیرین می‌کنه زندگی رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 517.17,
   "end": 518.87,
   "text": "اما حیات جاودانت چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 518.87,
   "end": 522.41,
   "text": "حالا اونجا خیلی خدا حرف، حرف قشنگ‌تری و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 522.41,
   "end": 525.43,
   "text": "جالب‌تر و عالی‌تری پیاده کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 525.43,
   "end": 531.81,
   "text": "و اما حیات جاودان، آن حیاتيست که یکسره و همه دقایقش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 531.81,
   "end": 534.83,
   "text": "به نفع صاحبش تمام شود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 534.83,
   "end": 540.51,
   "text": "واقعاً ما از صبح تا شب هر کاری می‌کنیم به نفع خودمونه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 540.51,
   "end": 547.03,
   "text": "و آنچنان در بهره‌گیری از آن حریص باشد که دنیا در نظرش خوار گردد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 547.03,
   "end": 550.23,
   "text": "آقا مصطفی که گفتم بحث امروز ربطه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 550.23,
   "end": 555.95,
   "text": "یه ربطی به دنیا داره. دنیا در نظرش خوار گردد و کوچک شود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 555.95,
   "end": 559.99,
   "text": "و در مقابل آخرت در نظرش عظیم شود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 559.99,
   "end": 563.53,
   "text": "و خواست مرا بر خواست خودش مقدم بدارد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 563.53,
   "end": 567.77,
   "text": "بنده من خواست منو مقدم می‌داره بر خواست خودش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 567.77,
   "end": 571.29,
   "text": "و همواره در پی بدست آوردن رضای من باشد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 571.29,
   "end": 573.93,
   "text": "حق نعمتم را عظیم شمرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 573.93,
   "end": 577.75,
   "text": "رفتاری که با او کردم به یاد آورد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 577.75,
   "end": 582.49,
   "text": "شب و روز در برابر هر کار زشت و گناه مراقب من باشد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 582.49,
   "end": 584.67,
   "text": "چون من رقیب اونم دیگه باید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 584.67,
   "end": 588.31,
   "text": "یکی از اسامی خدا یا رقیبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 588.31,
   "end": 594.13,
   "text": "مراقب من باشد. قلب خویش را از آنچه ناخوشایند من است پاک کند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 594.13,
   "end": 597.79,
   "text": "شیطان و وساوس او را دشمن بدارد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 597.79,
   "end": 604.51,
   "text": "و ابلیس را بر قلب خود مسلط نسازد و در آن راه ندهد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 604.51,
   "end": 607.77,
   "text": "حالا اینجا اگه کسی اینطوری بود چی میشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 607.77,
   "end": 612.35,
   "text": "چه اتفاقی میفته؟ حیاتش که ابدیه که هیچ،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 612.35,
   "end": 616.51,
   "text": "خدا باهاش چیکار می‌کنه؟ که اگر چنین کند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 616.51,
   "end": 621.11,
   "text": "به به چقدر شیرین. اونایی که میگن که چیکار کنیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 621.11,
   "end": 624.69,
   "text": "محبتمون به خدا زیاد بشه و اینا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 624.69,
   "end": 628.77,
   "text": "اگر چنین کند محبتی در دلش می‌افکنم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 628.77,
   "end": 633.01,
   "text": "که همه فکر و ذکرش و فراغ و اشتغالش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 633.01,
   "end": 637.01,
   "text": "و هم و غم و گفت و گوییش از نعمت‌های من شود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 637.01,
   "end": 640.87,
   "text": "همش داره از خدا و نعمت‌های خدا میگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 640.87,
   "end": 646.61,
   "text": "چرا؟ جالبه. خدا میگه خودم این محبتو تو دلش میندازم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 646.61,
   "end": 650.61,
   "text": "من، من عاشقش می‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 650.61,
   "end": 654.83,
   "text": "انشاالله- آن نعمت‌ها که به سایر اهل محبتم دادم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 654.83,
   "end": 659.33,
   "text": "و در نتیجه چشم و گوش دلش را باز کنم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 659.33,
   "end": 664.25,
   "text": "تا دیگر با قلب خود بشنود و با قلب ببیند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 664.25,
   "end": 666.61,
   "text": "جالبه هم با قلبش می‌شنوه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 666.61,
   "end": 673.09,
   "text": "هم با قلبش می‌بینه و به جلال و عظمتم نظر افکند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 673.09,
   "end": 675.45,
   "text": "این جلال و عظمتم نظر افکند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 675.45,
   "end": 683.73,
   "text": "یعنی خدا رخ نشون میده با جلالش که این بتونه ببینه بیفته به رعب و قذف فی قلوبهم الرعب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 683.73,
   "end": 686.09,
   "text": "و دنیا را بر او تنگ کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 686.09,
   "end": 689.45,
   "text": "قابل توجه اهل ایمانی که میگن آقا خدا فقط ما رو گیر آورده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 689.45,
   "end": 691.73,
   "text": "چرا اینقدر مشکلات سر ما ریخته؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 691.73,
   "end": 695.51,
   "text": "کار، کار خداست و دنیا را بر او تنگ کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 695.51,
   "end": 699.05,
   "text": "چرا؟ برای چی تنگ می‌کنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 699.05,
   "end": 705.45,
   "text": "برای اینکه چی؟ می‌فرماید و آنچه لذت دنیاییست از نظرش بیندازم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 705.45,
   "end": 708.83,
   "text": "یعنی یه کاری می‌کنه از دنیا لذت نبره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 708.83,
   "end": 717.55,
   "text": "برای چی؟ تا حدی که آن را دشمن بدارد و همانطور که چوپان گله را از ورطه های حرکات دور می‌کند، ما او،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 717.55,
   "end": 722.35,
   "text": "من او را از دنیا و آنچه در آن است دور می‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 722.35,
   "end": 730.49,
   "text": "این کار خداست آن وقت است که از مردم می‌گریزد و سرانجام از دار فنا به دار بقا و از دار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 730.49,
   "end": 733.73,
   "text": "شیطان به دار رحمان منتقل می‌شود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 733.73,
   "end": 736.49,
   "text": "اص-- عبارات رو ببینید. حدیث قدسیه‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 736.49,
   "end": 740.73,
   "text": "خدا فرموده اسم این دنیا رو گذاشته دار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 740.73,
   "end": 742.97,
   "text": "فنا، اونور بقا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 742.97,
   "end": 745.69,
   "text": "اینجا دار شیطان، اونور",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 745.69,
   "end": 748.83,
   "text": "رحمان. جالبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 748.83,
   "end": 751.15,
   "text": "اینا عبارات جالب توجهه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 751.15,
   "end": 755.53,
   "text": "باز می‌فرماید ای احمد صلی الله علیه و آله و سلم من او را،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 755.53,
   "end": 760.11,
   "text": "حالا کسی که، کسی که اینطوری شد متوجه آخرت شد و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 760.11,
   "end": 767.75,
   "text": "به دنیا پشت کرد. من او را به زیور هیبت و عظمت می‌آرایم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 767.75,
   "end": 776.83,
   "text": "یعنی هیبتی بهش میدم. این است آن عیش گوارا و آن حیات جاودان و این مقام خاص دارندگان رضاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 776.83,
   "end": 780.21,
   "text": "پس هر کس بر وفق رضای من عمل کند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 780.21,
   "end": 786.75,
   "text": "مداومت و ملازمت بر سه چیز را به او بدهم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 786.75,
   "end": 792.07,
   "text": "کسی که-- این نشانه کسی که بر طبق رضای خدا عمل می‌کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 792.07,
   "end": 794.21,
   "text": "این سه تا چیزه که خدا بهش میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 794.21,
   "end": 801.29,
   "text": "آنکه با شکری آشنایش کنم که دیگر مانند شکر دیگران آمیخته با جهل نباشد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 801.29,
   "end": 803.73,
   "text": "شکرگزاریه که جاهل نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 803.73,
   "end": 806.33,
   "text": "یعنی قدر نعمتش-- اینا رو میدونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 806.33,
   "end": 813.25,
   "text": "دو، قلبش را آنچنان سرشار از یاد خودم کنم که دیگر جایی برای نسیان در آن نباشد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 813.25,
   "end": 815.73,
   "text": "یعنی دائم یاد خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 815.73,
   "end": 823.83,
   "text": "سه، آنچنان او را سرشار از محبت خودم کنم که دیگر جایی برای محبت مخلوق‌ها در او نماند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 823.83,
   "end": 826.63,
   "text": "که امیرالمؤمنین در عرض طه و الف فز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 826.63,
   "end": 829.19,
   "text": "عدد یاد می‌داد. فرمود بگو واحد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 829.19,
   "end": 831.43,
   "text": "یادتونه یه روز عرض کردیم. گفت واحد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 831.43,
   "end": 835.29,
   "text": "فرمود بگو اثنین. عرض کرد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 835.29,
   "end": 841.25,
   "text": "بابا زبانی که به واحد باز میشه دیگه به اثنین باز نمیشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 841.25,
   "end": 843.51,
   "text": "یعنی دویت دیگه نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 843.51,
   "end": 846.89,
   "text": "یک وجود واحد هست. بخشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 846.89,
   "end": 850.33,
   "text": ". آن وقت است که حالا این سه تا لطف خدا می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 850.33,
   "end": 855.59,
   "text": "بعد چی میشه؟ آن وقت است که وقتی به من محبت، محبت می‌ورزد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 855.59,
   "end": 857.29,
   "text": "به او محبت می‌ورزم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 857.29,
   "end": 861.21,
   "text": "یعنی هرچی او به من محبتش بیشتر میشه منم به او محبتم بیشتر میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 861.21,
   "end": 866.09,
   "text": "هی دو طرفه دیگه. طرف دیگه انقدر میره تا به اوج عشق برسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 866.09,
   "end": 869.99,
   "text": "اینجا این نکته‌ست که مربوط به بحث قلب مرعوب میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 869.99,
   "end": 871.81,
   "text": "همه رو خوندیم تا اینجا برسه. تموم بکن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 871.81,
   "end": 879.27,
   "text": "تا به اینجا برسیم. و چشم دلش را به سوی جلالم باز می‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 879.27,
   "end": 883.35,
   "text": "گفتیم که اسماء جلال می‌ریزه تو دلش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 883.35,
   "end": 888.33,
   "text": "این حالت تنبه خاطر براش پیش میاد و قذف فی قلوبهم الرب،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 888.33,
   "end": 892.41,
   "text": "فی قلوبهم الرب برای اهل ایمان این شکلی میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 892.41,
   "end": 896.57,
   "text": "اینم باز کار خداست و دیگر هیچ سری از اسرار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 896.57,
   "end": 902.97,
   "text": "خلقتم را از او مخفی نمی‌دارم و در تاریکی‌های شب و روشنایی روز با او راز می‌گویم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 902.97,
   "end": 906.25,
   "text": "یعنی هرچی در و دیوار رو نگاه می‌کنه باهاش راز داره میگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 906.25,
   "end": 909.17,
   "text": "معلمش شدن. آسمون و زمین معلمش میشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 909.17,
   "end": 911.97,
   "text": "بهش درس میدن. آنچنان که دیگر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 911.97,
   "end": 918.27,
   "text": "مجالی برای سخن گفتن با مخلوقین و نشست و برخاست با آنان براش برایش نماند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 214,
   "start": 918.27,
   "end": 920.91,
   "text": "مردم غرق دنیاشونم این غرق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 215,
   "start": 920.91,
   "end": 926.77,
   "text": "خدا شد. سخن خود و ملائکه‌ام را به گوشش می‌شنوانم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 216,
   "start": 926.77,
   "end": 931.85,
   "text": "و با آن اسرار که از خلق خود پوشانده‌ام آشنایش سازم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 217,
   "start": 931.85,
   "end": 934.67,
   "text": "جامه حیا بر تنش بپوشانم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 218,
   "start": 934.67,
   "end": 938.47,
   "text": "آنچنان که تمامی خلائق از او شرم بدارند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 219,
   "start": 938.47,
   "end": 943.11,
   "text": "و هنگامی که در زمین راه می‌رود آمـ-آمرزیده برود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 220,
   "start": 943.11,
   "end": 946.79,
   "text": "ظرفیت و بصیرت قلبش را بسیار کنم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 221,
   "start": 946.79,
   "end": 950.51,
   "text": "و هیچ چیز از بهشت و آتش را از او مخفی ندارم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 222,
   "start": 950.51,
   "end": 958.51,
   "text": "و او را با آن دلهره‌ها و شدائد که مردم در قیامت آیند و با آن گرفتاری حساب و سختی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 223,
   "start": 958.51,
   "end": 960.65,
   "text": "سختی که از توانگران",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 224,
   "start": 960.65,
   "end": 964.15,
   "text": "و فقرا و علما و جهال می‌کشند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 225,
   "start": 964.15,
   "end": 971.27,
   "text": "آشنایش می‌سازم. وقتی او را در قبر می‌خوابانند نکیر و منکر را بر او نازل کنم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 226,
   "start": 971.27,
   "end": 981.81,
   "text": "تا بازجویی‌اش کنند در حالی که هیچ اندوهی از مردن و هیچ ظلمتی از قبر و لحد و هیچ همی از هول مطلع",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 227,
   "start": 981.81,
   "end": 985.69,
   "text": "نداشته باشد. آنگاه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 228,
   "start": 985.69,
   "end": 992.73,
   "text": "میزانی برایش نصب کنم و برنامه‌ای برایش بکشایم و نامه‌اش را به دست راستش بدهم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 229,
   "start": 992.73,
   "end": 995.43,
   "text": "او را در حالی که باز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 230,
   "start": 995.43,
   "end": 998.45,
   "text": "و روشن است بخواند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 231,
   "start": 998.45,
   "end": 1001.69,
   "text": "اون کتابو یعنی خودش رو، کتاب وجودی خودش رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 232,
   "start": 1001.69,
   "end": 1007.07,
   "text": "بخواند و آنگاه بین خودم و او مترجمی نگذارم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 233,
   "start": 1007.07,
   "end": 1013.19,
   "text": "یعنی مترجم نمی‌خواد. خودش کاملاً کتاب وجودی خودش رو آگاهانه می‌خونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 234,
   "start": 1013.19,
   "end": 1017.39,
   "text": "اقرأ كتابك كفى بنفسك اليوم عليك حسيبا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 235,
   "start": 1017.39,
   "end": 1021.97,
   "text": "این حساب دوستداران است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 236,
   "start": 1021.97,
   "end": 1023.87,
   "text": "خطوط آقای دو، سه خط دیگه مونده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 237,
   "start": 1023.87,
   "end": 1027.91,
   "text": "حوصله کنید. ای احمد صلی الله علیه و آله و سلم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 238,
   "start": 1027.91,
   "end": 1030.83,
   "text": "هم خود را، حالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 239,
   "start": 1030.83,
   "end": 1034.71,
   "text": "دستور نقایای خدا، هم خود را هم واحد کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 240,
   "start": 1034.71,
   "end": 1036.75,
   "text": "انقدر متفرق و پراکنده نباش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 241,
   "start": 1036.75,
   "end": 1039.29,
   "text": "گاهی دنیا رو می‌خوای، گاهی آخرت رو می‌خوای.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 242,
   "start": 1039.29,
   "end": 1042.17,
   "text": "دفعه توبه می‌کنی میای به سمت من، دفعه ول می‌کنی میری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 243,
   "start": 1042.17,
   "end": 1044.91,
   "text": "اینطوری نه. همت رو واحد کن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 244,
   "start": 1044.91,
   "end": 1049.31,
   "text": "و زبانت را زبانی واحد و بدنت را بدنی زنده ساز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 245,
   "start": 1049.31,
   "end": 1052.39,
   "text": "که تا ابد غافل نماند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 246,
   "start": 1052.39,
   "end": 1054.93,
   "text": "جالبه بدن هم خدا میگه زنده‌اش کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 247,
   "start": 1054.93,
   "end": 1059.11,
   "text": "ز-- با چی زنده میشه بدن؟ بدن هم با ذکر خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 248,
   "start": 1059.11,
   "end": 1062.87,
   "text": "شما اولیای خدا رو ببینید اصن بدنشون هم حتی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 249,
   "start": 1062.87,
   "end": 1065.63,
   "text": "با بدن آدمای دیگه فرق می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 250,
   "start": 1065.63,
   "end": 1068.83,
   "text": "چهرشون رو شما چهره رهبر رو ببینید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 251,
   "start": 1068.83,
   "end": 1072.99,
   "text": "چهره سید حسن نصرالله رو به خاطر بیارید روحش شاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 252,
   "start": 1072.99,
   "end": 1075.99,
   "text": "چهره آقای بهجت رو یادتونه. اصن اولیای خدا رو ببینید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 253,
   "start": 1075.99,
   "end": 1080.65,
   "text": "چهره صورت دیگه. پوست و گوشت و خون و عهدی که دیگران دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 254,
   "start": 1080.65,
   "end": 1082.49,
   "text": "اما چقدر چهره متفاوته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 255,
   "start": 1082.49,
   "end": 1084.81,
   "text": "نور الهی در چهره تابیده شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 256,
   "start": 1084.81,
   "end": 1088.13,
   "text": "مخصوصا سحرخیزی. کسی که نماز شب می‌خونه خدا او رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 257,
   "start": 1088.13,
   "end": 1094.15,
   "text": "روایت داریم با نور خاص خودش می‌پوشونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 258,
   "start": 1094.15,
   "end": 1103.45,
   "text": "می‌پوشونش با نور خودش. زیرا هرکس از من غافل شود من در امر او بی‌اعتنا شوم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 259,
   "start": 1103.45,
   "end": 1107.45,
   "text": "کسی که خدا باهاش بی‌اعتنا میشه دیگه ولش می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 260,
   "start": 1107.45,
   "end": 1112.01,
   "text": "چرا ولش می‌کنه؟ چون او بی‌اعتنا شده به خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 261,
   "start": 1112.01,
   "end": 1115.37,
   "text": "و دیگر باکی ندارم که در کدام وادی هلاک شود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 262,
   "start": 1115.37,
   "end": 1117.53,
   "text": "یعنی اصن دیگه با-- کاری به کارش ندارم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 263,
   "start": 1117.53,
   "end": 1120.77,
   "text": "هرچی بلایی می‌خواد سرش بیاد، بیاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 264,
   "start": 1120.77,
   "end": 1125.09,
   "text": "یه وقت می‌بینی یه عمر دارایی‌شو جمع می‌کنه، یه شبه دزد می‌برش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 265,
   "start": 1125.09,
   "end": 1128.87,
   "text": "یا یه شبه بوس می‌کشه پایین، طلا می‌کشه پایین،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 266,
   "start": 1128.87,
   "end": 1133.05,
   "text": "دلار فلان میشه یا جنگ میشه چه می‌دونم همه چی از بین میره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 267,
   "start": 1133.05,
   "end": 1136.13,
   "text": "مثل اون بدبخت سلطان سکه بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 268,
   "start": 1136.13,
   "end": 1139.43,
   "text": "رفت الان گوشه گور خوابیده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 269,
   "start": 1139.43,
   "end": 1149.51,
   "text": "سکه‌هاش کجاست؟ اینجاست. و البته که این حرفا گفتنش البته آسون نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 270,
   "start": 1149.51,
   "end": 1153.05,
   "text": "گفتنشم سخته اما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 271,
   "start": 1153.05,
   "end": 1155.71,
   "text": "عمل به اون‌ها خیلی سخت‌تره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 272,
   "start": 1155.71,
   "end": 1157.89,
   "text": "میشه راحت این حرفا رو زد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 273,
   "start": 1157.89,
   "end": 1161.73,
   "text": "با سختی که داره اما عمل کردنش یه چیز دیگه‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 274,
   "start": 1161.73,
   "end": 1164.09,
   "text": "عملش هم نور الهی رو می‌خواد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 275,
   "start": 1164.09,
   "end": 1167.41,
   "text": "اللهم بارک لمولانا صاحب الزمان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 276,
   "start": 1167.41,
   "end": 1169.41,
   "text": "والحمد لله رب العالمين.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 277,
   "start": 1169.41,
   "end": 1171.45,
   "text": "صلوات. اللهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 278,
   "start": 1171.45,
   "end": 1173.01,
   "text": "صل على محمد وآل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}