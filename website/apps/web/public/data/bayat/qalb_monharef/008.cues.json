 },
 "chapters": [
  {
   "index": 0,
   "title": "## شک میان سه و پنج",
   "start": 12.28,
   "end": 71.74
  },
  {
   "index": 1,
   "title": "## هوای نفس؛ بزرگ‌ترین عامل زیغ قلب",
   "start": 71.74,
   "end": 130.32
  },
  {
   "index": 2,
   "title": "## حکمت لقمان؛ روایت تفسیر قمی",
   "start": 130.32,
   "end": 407.53
  },
  {
   "index": 3,
   "title": "## هنر مجاهده در وسط زندگی",
   "start": 407.53,
   "end": 540.37
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 2.32,
   "end": 5.54,
   "text": "بسم الله الرحمن الرحیم و بهین استعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 5.54,
   "end": 9.64,
   "text": "السلام علیک یا داعی الله و ربانی ایه آیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 9.64,
   "end": 12.28,
   "text": "سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 12.28,
   "end": 17.44,
   "text": "یکی دیگه از شک‌های صحیح شک بین سه و پنج است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 17.44,
   "end": 21.04,
   "text": "اگه کسی در حال ایستاده در رکعت در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 21.04,
   "end": 25.46,
   "text": "نماز چهار رکعتی شک کنه که سه رکعت خونده یا پنج رکعت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 25.46,
   "end": 32.64,
   "text": "باید سریع بشینه. وقتی که نشست اون رکعت آخر رو ادامه نداد، یه رکعت از شکش کم میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 32.64,
   "end": 36.22,
   "text": "در حقیقت میشه شک بین دو و چهار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 36.22,
   "end": 42.88,
   "text": "اون موقع شک دو و چهار حکمش این بود دیگه شاید دو رکعت خونده دو تا جاخالی داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 42.88,
   "end": 46.06,
   "text": "دو تا نماز یعنی دو رکعت نماز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 46.06,
   "end": 49.68,
   "text": "احتیاط ایستاده باید بخونه نه دو تا، دو رکعت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 49.68,
   "end": 52.86,
   "text": "دو رکعت نماز احتیاط ایستاده می‌خونه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 52.86,
   "end": 58.8,
   "text": "لکن رهبر عزیزمون فرمودن اینجا احتیاطاً نمازو دوباره اعاده کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 58.8,
   "end": 60.74,
   "text": "توی این خصوصه سه و چهار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 60.74,
   "end": 62.72,
   "text": "البته اون سه و پنج.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 62.72,
   "end": 65.64,
   "text": "اون شک دیروزم که عرض کرده بودیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 65.64,
   "end": 71.74,
   "text": "اون هم در حال ایستاده اگر این شک اتفاق افتاد باید اعاده می‌کرد، یعنی احتیاطاً.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 71.74,
   "end": 74.42,
   "text": "در خصوص نماز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 74.42,
   "end": 77.94,
   "text": "عرض کنم موضوع انحراف قلبی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 77.94,
   "end": 81.68,
   "text": "ما یه ذره بیشتر رو این وایسادیم چون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 81.68,
   "end": 84.52,
   "text": "خیلی مهمه و مبتلا به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 84.52,
   "end": 89.22,
   "text": "و کمتر کسی هست که درگیر دلایل انحراف قلبی بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 89.22,
   "end": 94.28,
   "text": "حالا ما نمیگیم کمتر کسی هست که دچار انحراف قلبی بشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 94.28,
   "end": 97.86,
   "text": "اما درگیر با عواملش میشه قطعا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 97.86,
   "end": 99.88,
   "text": "ما گفتیم از مهم‌ترین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 99.88,
   "end": 103.3,
   "text": "عوامل انحراف قلبی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 103.3,
   "end": 108.78,
   "text": "که چیزی که باعث میشه انسان قلبش به زایغ بیفته،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 108.78,
   "end": 113.62,
   "text": "هوای نفسه. اون که پیغمبر فرمود انی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 113.62,
   "end": 115.9,
   "text": "اخوف اخاف علیکُم افنان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 115.9,
   "end": 119.6,
   "text": "من بیشترین چیزی که برای شما می‌ترسم دو چیزه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 119.6,
   "end": 122.18,
   "text": "اتباع الهوی و طول العمل دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 122.18,
   "end": 124.02,
   "text": "هوای نفس و آرزوی طولانی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 124.02,
   "end": 130.32,
   "text": "این چون بیشترین چیزی هم که از پیغمبر در موردش می‌ترسه ما بیشتر روش توقف می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 130.32,
   "end": 134.42,
   "text": "دقت داشته باشید همیشه برای من سؤال بود که چرا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 134.42,
   "end": 136.66,
   "text": "لقمان حکیم، حکیم شد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 136.66,
   "end": 140.28,
   "text": "و چرا تو قرآن اصلاً یه سوره به نامش داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 140.28,
   "end": 145.16,
   "text": "در حالی که ما روایاتی داریم که لقمان پیغمبر نبوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 145.16,
   "end": 147.96,
   "text": "خب این همه ما پیغمبر داشتیم براشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 147.96,
   "end": 151.54,
   "text": "سوره ای نیست. اما لقمان یه سوره به نامشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 151.54,
   "end": 153.26,
   "text": "و به عظمت هم یاد میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 153.26,
   "end": 159.18,
   "text": "خدا در قرآن به عظمتشون یاد کرده و بهش حکمت خود خدا فرموده بهش حکمت دادیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 159.18,
   "end": 162.74,
   "text": "چرا؟ چرا اصلاً این سؤال خیلی مهمیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 162.74,
   "end": 165.8,
   "text": "چرا به ه-لقمان حکیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 165.8,
   "end": 168.82,
   "text": "حکمت دادن و خدا تو قرآن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 168.82,
   "end": 172.92,
   "text": "ازش یاد کرده؟ برای خود من این سؤال بود که الحمد لله حالا در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 172.92,
   "end": 174.72,
   "text": "لسان اهل بیت جوابشو پیدا کردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 174.72,
   "end": 179.18,
   "text": "برای شما عرض می‌کنم. طولانیه یه ذره حدیث من بخشیش رو عرض می‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 179.18,
   "end": 182.64,
   "text": "تفسیر قمی جلد دو، صفحه صد و شصت و دو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 182.64,
   "end": 184.88,
   "text": "از امام صادق صلوات الله علیه سؤال شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 184.88,
   "end": 191.18,
   "text": "سألت ابا عبدالله عن لقمان وحكمة التي ذكرها الله عز وجل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 191.18,
   "end": 194.76,
   "text": "چرا خدا یاد کرده تو قرآن از لقمان و بهش حکمت داده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 194.76,
   "end": 197.2,
   "text": "از امام صادق پرسیدن حضرت چنین جواب دادن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 197.2,
   "end": 201.14,
   "text": "فقال حضرت فرمود اما والله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 201.14,
   "end": 204.68,
   "text": "خب نگاه کنید خیلی مهمه اینکه خدا چه رسول--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 204.68,
   "end": 210.68,
   "text": "حضرت امام صادق با قسم لفظ جلاله شروع میکنه صحبتشو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 210.68,
   "end": 213.98,
   "text": "والله ما اوتی لقمان الحکمة",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 213.98,
   "end": 219.8,
   "text": "به خدا قسم به لقمان حکمت نداده خدا بحسب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 219.8,
   "end": 223.74,
   "text": "ولا مال ولا اهل ولا بسط",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 223.74,
   "end": 226.32,
   "text": "فی جسم ولا جمال.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 226.32,
   "end": 229.14,
   "text": "به خاطر زیبایی و نمی‌دونم جسم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 229.14,
   "end": 231.32,
   "text": "قوی و نمی‌دونم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 231.32,
   "end": 236.82,
   "text": "فامیل و نسب و مال و اهل و این‌ها نبوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 236.82,
   "end": 242.06,
   "text": "حضرت فرمود و لکنّه کان رجلاً قویاً فی امر الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 242.06,
   "end": 244.24,
   "text": "متورعاً في الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 244.24,
   "end": 247.6,
   "text": "بلکه او یک مردی بود که قوی بود در امر خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 247.6,
   "end": 249.84,
   "text": "یعنی به شدت رعایت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 249.84,
   "end": 252.06,
   "text": "حدود الهی رو انجام می‌داد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 252.06,
   "end": 254.78,
   "text": "باورع بود. متورعاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 254.78,
   "end": 258.18,
   "text": "في الله. اینجاش حالا بعد ادامه پیدا می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 258.18,
   "end": 262.98,
   "text": "من این بخشش رو بیشتر توجه میدم بهش که موضوع بحث ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 262.98,
   "end": 267.2,
   "text": "ويعتبر و يتعلم ما يغلب به نفسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 267.2,
   "end": 271.48,
   "text": "ایشون ع-عبرت می‌گرفت از همه چی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 271.48,
   "end": 275.74,
   "text": "و می‌دونست چگونه به نفسش غالب بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 275.74,
   "end": 280.6,
   "text": "خیلی مهمه. و يجاهد بهي هواه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 280.6,
   "end": 283.48,
   "text": "با هوای نفسش در مجاهده بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 283.48,
   "end": 285.88,
   "text": "در حال جهاد با",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 285.88,
   "end": 290.84,
   "text": "هوای نفسش بود. اینطور نبود که نفسش اجازه داشته باشه جولان بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 290.84,
   "end": 293.7,
   "text": "و يعترض به من الشيطان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 293.7,
   "end": 297.02,
   "text": "و از همین جهت از شیطان اعتراض می‌کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 297.02,
   "end": 299.4,
   "text": "فكان يداوي قلبه بالفکر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 299.4,
   "end": 302.44,
   "text": "حالا اینجا داره راهکارا رو ارا-ارائه میده حضرت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 302.44,
   "end": 306.08,
   "text": "ایشون کسی بود که يداوي دوا می‌کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 306.08,
   "end": 310.52,
   "text": "قلبه بالفکر قلبش رو با فکر دوا می‌کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 310.52,
   "end": 314.52,
   "text": "چ-چیزی که تو ما کمه. همش دائماً می‌خوایم حرف بزنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 314.52,
   "end": 317.12,
   "text": "و يداوي نفسه بالعبر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 317.12,
   "end": 320.3,
   "text": "نفسش رو دوا می‌کرد با عبرت گرفتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 320.3,
   "end": 323.38,
   "text": "هر چیزی رو به راحتی از کنارش رد نمی‌شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 323.38,
   "end": 326.48,
   "text": "عبرت می‌گرفت. و كان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 326.48,
   "end": 330.94,
   "text": "لا يذعن الا فیها ينفع و این خیلی مهمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 330.94,
   "end": 338.34,
   "text": "می‌فرماید که نزدیک هیچ چیزی نمی‌شد در حالی که نفعی براش نداشته باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 338.34,
   "end": 344.32,
   "text": "هر چیزی رو می‌خواست ورود کنه درش حتی فکر، کلام، نیت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 344.32,
   "end": 347.3,
   "text": "جایی می‌خواست بره، هر کاری می‌خواست بکنه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 347.3,
   "end": 350.68,
   "text": "در صورتی که نفعی براش داشته باشه این کارو می‌کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 350.68,
   "end": 355.74,
   "text": "نفع اخروی. فبذلك بعد حضرت می‌فرماید فبذلك",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 355.74,
   "end": 359.7,
   "text": "به این خاطر بود که اوتی الحکمة و منح الاسم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 359.7,
   "end": 361.94,
   "text": "قابل توجه اینایی که گمان می‌کنند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 361.94,
   "end": 363.98,
   "text": "عصمت به غیر از معصومین نمی‌رسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 363.98,
   "end": 366.85,
   "text": "و منح الاسم اینجا حضرت فرمود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 366.85,
   "end": 369.21,
   "text": "به مقام عصمت رسیده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 369.21,
   "end": 373.73,
   "text": "اینکه بهش حکمت داده خدا، مال همون مخالفت با هوای نفس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 373.73,
   "end": 377.33,
   "text": "همین. اصلا عمده و ریشه‌ی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 377.33,
   "end": 380.21,
   "text": "سر خوردن بزرگ-- هر کسی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 380.21,
   "end": 386.37,
   "text": "به سمت هوای نفس رفته به سمت انحرافات عقیدتی و اخلاقی رفته و بعداً از اسلام جدا شده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 386.37,
   "end": 388.37,
   "text": "اینه که پا داده به هوای نفسش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 388.37,
   "end": 392.71,
   "text": "اجازه داده نوا-- این هوای نفسش، خواهش نفسش،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 392.71,
   "end": 395.97,
   "text": "التماس نفسش جولان بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 395.97,
   "end": 400.69,
   "text": "برای همین اه-- بزرگان ما به شدت احراز می‌کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 400.69,
   "end": 403.97,
   "text": "مراقب بودن. البته این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 403.97,
   "end": 407.53,
   "text": "یک تمرین و ممارست بسیار زیادی رو می‌طلبه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 407.53,
   "end": 411.01,
   "text": "مخصوصاً کسانی که حالا گاهی اوقات این حرفا که زده میشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 411.01,
   "end": 413.53,
   "text": "یه عده من دیدم تو هیئت خودمون بعضیا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 413.53,
   "end": 416.33,
   "text": "مجرد موندن. دیگه داره چهل سالش میشه با--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 416.33,
   "end": 419.39,
   "text": "بهش که میگی نه میگه سخته نه نمیخوام من میخوام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 419.39,
   "end": 422.73,
   "text": "مخالفت نفس کنم. خدا رحمت کنه شیخ انصاری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 422.73,
   "end": 425.65,
   "text": "رحمت الله علیه دید دو نفر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 425.65,
   "end": 430.69,
   "text": "نشستن دارن با هم بحث می‌کنن بغل کرسی از این شاگرداش بودن ظاهراً.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 430.69,
   "end": 433.09,
   "text": "یکی اون یکی رو نصیحت می‌کنه که آره ازدواج کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 433.09,
   "end": 436.05,
   "text": "این میگه نه بابا سخته ول کن تهذیب نفس و عشقه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 436.05,
   "end": 438.81,
   "text": "از این حرفایی که بعضی طلبه‌ها می‌زنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 438.81,
   "end": 442.01,
   "text": "شیخ خیلی ناراحت شد. گفت چی دارید شما به هم میگید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 442.01,
   "end": 445.49,
   "text": "به فلانی گفتن که نمی‌دونم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 445.49,
   "end": 448.71,
   "text": "یه کسیو پیدا کردن تو هوا می‌پره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 448.71,
   "end": 451.01,
   "text": "مثلاً پر می‌کشه تو آسمونا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 451.01,
   "end": 453.63,
   "text": "گفت هنر نکرده که کبوتر هم می‌پره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 453.63,
   "end": 458.27,
   "text": "گفت یکیو پیدا کردن رو آب راه میره گفت اون هنر نکرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 458.27,
   "end": 460.65,
   "text": "روغنم ولش کنی رو آب راه میره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 460.65,
   "end": 464.99,
   "text": "اینا هنر نیستش که. کن فی الناس ولا تكن معهم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 464.99,
   "end": 467.43,
   "text": "این حدیثه. بین مردم باش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 467.43,
   "end": 469.07,
   "text": "ولی از اونها نباش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 469.07,
   "end": 477.37,
   "text": "هنر اینه که ازدواج کنی، درگیر بشی، چرخنده‌های وجودت درگیر بشه با این شؤون اجتماعی، با زنت، با بچه‌هات، خواهش‌ها،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 477.37,
   "end": 481.99,
   "text": "بایدها، نبایدها اینا. باید در عین حال مخالفت نفس داشته باشی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 481.99,
   "end": 485.73,
   "text": "این در حال دائما در حال مجاهده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 485.73,
   "end": 491.07,
   "text": "و تلاش باشی. نه اینکه حالا یه گوشه ای روحانیت پیشه کنی و مجرد بمونی و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 491.07,
   "end": 493.43,
   "text": "دائما هم زمین لعنتت کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 493.43,
   "end": 497.05,
   "text": "ما هیئت خودمون که منبر میریم میگیم ملعون‌ها کجا نشستن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 497.05,
   "end": 499.75,
   "text": "همه میدونن منظورم کیه. یعنی مجردها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 499.75,
   "end": 503.09,
   "text": "حدیث داریم دائما زمین مجردها رو لعن می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 503.09,
   "end": 506.35,
   "text": "تازه هست-- اگرم تازه شهید بشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 506.35,
   "end": 510.75,
   "text": "کسی که متأهل شهید شده هفتاد برابر اجر می‌بره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 510.75,
   "end": 517.11,
   "text": "شوخی هم اگه. درگیر شده باید تو این حالت خودشو بسکه کرده، این هنره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 517.11,
   "end": 522.87,
   "text": "پس یادمون باشه روحانیت هم خوب نیست اما در خ- وسط خط مقدم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 522.87,
   "end": 525.83,
   "text": "جهاد باید مراقب هوا و خواهش‌های نفسانی بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 525.83,
   "end": 529.07,
   "text": "حالا یه بعضی از وجوهش رو انشاالله روزهای بعد عرض می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 529.07,
   "end": 534.67,
   "text": "عاقبتمون انشاالله که ختم به خیر بشه و برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 534.67,
   "end": 540.37,
   "text": "اللهم صل علی محمد و آل محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}