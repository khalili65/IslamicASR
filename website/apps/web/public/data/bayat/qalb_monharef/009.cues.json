 "chapters": [
  {
   "index": 0,
   "title": "بسم الله الرحمن الرحیم و به نستعین. درود بر داعیِ خدا و ربّانیِ آیات.",
   "start": 12.28,
   "end": 32.78
  },
  {
   "index": 1,
   "title": "## قلبِ منحرف؛ آیهٔ صف",
   "start": 32.78,
   "end": 193.9
  },
  {
   "index": 2,
   "title": "## آغازِ انحراف؛ تصدیقِ نفس و رکون به هوا",
   "start": 193.9,
   "end": 291.28
  },
  {
   "index": 3,
   "title": "## شیخ انصاری و نانِ حلوایی",
   "start": 291.28,
   "end": 457.56
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 1.12,
   "end": 4.78,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 4.78,
   "end": 8.14,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 8.14,
   "end": 12.28,
   "text": "آیات. السلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 12.28,
   "end": 20.54,
   "text": "یکی دیگه از شکیات صحیح شک بین سه و چهار و پنج در رکعت در نماز چهار رکعتی در حال ایستاده است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 20.54,
   "end": 27.22,
   "text": "ایستادی در نماز چهار رکعتی شک می‌کنی سه رکعت خوندی یا چهار رکعت خوندی یا پنج رکعت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 27.22,
   "end": 29.0,
   "text": "خب بلافاصله باید بنشینی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 29.0,
   "end": 32.78,
   "text": "وقتی که نشستی و اون رکعت آخر رو ادامه ندادی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 32.78,
   "end": 35.44,
   "text": "یکی، یه دونه از این شک‌هات کم میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 35.44,
   "end": 40.66,
   "text": "دیگه به جای شک سه و چهار و پنج میشه شک دو و سه و چهار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 40.66,
   "end": 44.76,
   "text": "شک دو و سه و چهار هم قبلاً گفته بودیم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 44.76,
   "end": 49.6,
   "text": "عملیاتش چگونه است. شاید دو رکعت خوندی چون پایه شک دوه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 49.6,
   "end": 52.1,
   "text": "شاید دو رکعت خوندی. اینجا باید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 52.1,
   "end": 56.74,
   "text": "دو رکعت نماز احتیاط ایستاده بخونی این جای خالی پر شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 56.74,
   "end": 63.64,
   "text": "شاید سه رکعت خوندی. اینجا باید یه دو رکعتی نماز احتیاط نشسته بخونی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 63.64,
   "end": 66.76,
   "text": "تا جای اون یک رکعت پر بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 66.76,
   "end": 71.62,
   "text": "تمام. پس دو رکعت نماز احتیاط ایستاده دو رکعت نماز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 71.62,
   "end": 74.18,
   "text": "احتیاط نشسته می‌خونی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 74.18,
   "end": 83.56,
   "text": "تمام. لکن رهبر عزیزمون اینجا یه احتیاط کردن فرمودن احتیاطاً نماز رو هم اعاده کن بعد از اینکه این کارو کردی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 83.56,
   "end": 85.96,
   "text": "اما در خصوص قلب منحرف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 85.96,
   "end": 89.54,
   "text": "یکی دیگه از آیاتی که اشاره به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 89.54,
   "end": 94.6,
   "text": "قلبی که دچار زگ شده کرده آیه پنج سوره صفه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 94.6,
   "end": 102.72,
   "text": "می‌فرماید و اذ قال موسى لقومه یا قوم لم تؤذوننی و قد تعلمون انی رسول الله الیکم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 102.72,
   "end": 106.42,
   "text": "حضرت، حضرت موسی به قومش گفت چگونه منو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 106.42,
   "end": 108.78,
   "text": "شما اذیت می‌کنید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 108.78,
   "end": 113.78,
   "text": "لم تؤذوننی چرا منو اذیت می‌کنید با اینکه می‌دونید قد تعلمون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 113.78,
   "end": 119.4,
   "text": "با اینکه می‌دونید انی رسول الله من رسول خدایم به سوی شما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 119.4,
   "end": 122.22,
   "text": "فلما زاغوا ازاغ الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 122.22,
   "end": 124.96,
   "text": "اینجا دیگه بحث انحراف قلبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 124.96,
   "end": 129.18,
   "text": "وقتی که اون‌ها از حق منحرف شدند،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 129.18,
   "end": 137.62,
   "text": "فلما زاغوا وقتی اون‌ها منحرف شدند ازاغ الله قلوبهم اون موقع خدا هم قلبشون رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 137.62,
   "end": 142.5,
   "text": "منحرف‌تر کرد. یعنی راه رو هموار کرد برای اینکه این‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 142.5,
   "end": 144.08,
   "text": "قلبشون منحرف‌تر بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 144.08,
   "end": 147.66,
   "text": "والله چرا؟ والله لا يهدي القوم الفاسقین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 147.66,
   "end": 150.98,
   "text": "چون خدا فسق، آدمای فاسق رو دوست نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 150.98,
   "end": 154.54,
   "text": "پس یکی از دلایل انحراف قلب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 154.54,
   "end": 156.58,
   "text": "که همون بحث فسق است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 156.58,
   "end": 162.56,
   "text": "اینه که انسان خودش، خودش با پای خودش به سمتی بره که خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 162.56,
   "end": 164.2,
   "text": "او رو منحرف‌تر کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 164.2,
   "end": 168.96,
   "text": "یعنی خودش موجبات انحراف قلبش رو فراهم کنه با پای خود، با دست خودش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 168.96,
   "end": 171.64,
   "text": "این آیه صراحتاً می‌فرماید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 171.64,
   "end": 176.58,
   "text": "زاغوا اون‌ها منحرف کردن، منحرف شدند بعد ازاغ الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 176.58,
   "end": 179.9,
   "text": "خدا هم سنتش اینه. اگه کسی به سمتش بره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 179.9,
   "end": 182.16,
   "text": "راه رو به سمت هدایت براش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 182.16,
   "end": 187.74,
   "text": "بازتر می‌کنه. کسی به سمت ضلالت بره راه رو برای به سمت ضلالت رفتن براش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 187.74,
   "end": 191.68,
   "text": "فراهم می‌کنه. پس هرچی که هست دست خود طرفه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 191.68,
   "end": 193.9,
   "text": "و انحراف،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 193.9,
   "end": 197.4,
   "text": "شروع انحراف از اینه که ما به هوای نفسمون پا بدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 197.4,
   "end": 202.98,
   "text": "اینو قبلاً عرض کردیم که یه دلیلی که ما رو هوای نفس خیلی پافشاری می‌کنیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 202.98,
   "end": 204.9,
   "text": "چون حدیث داریم شروع انحرافه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 204.9,
   "end": 210.3,
   "text": "در کتاب دعائم الاسلام جلد دو صفحه سیصد و پنجاه و دو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 210.3,
   "end": 213.5,
   "text": "از مولاemon علی علیه الصلاة والسلام یه حدیث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 213.5,
   "end": 217.96,
   "text": "پرنهیب وارد شده که و ان اول المعاصی می‌خوایم بدونیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 217.96,
   "end": 220.6,
   "text": "اصلاً اولین معصیتی که ما کردیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 220.6,
   "end": 223.24,
   "text": "پایه‌ش چی بوده؟ مبناش چی بوده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 223.24,
   "end": 225.66,
   "text": "توی این حدیث به زیبایی تمام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 225.66,
   "end": 228.68,
   "text": "فرموده است ما چرا گناهکار شدیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 228.68,
   "end": 231.88,
   "text": "فرمودن و ان اول المعاصی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 231.88,
   "end": 235.0,
   "text": "اصلاً آغاز گناهان از اینجاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 235.0,
   "end": 242.28,
   "text": "تصدیق النفس که انسان تصدیق کنه نفسشو هوا و خواهش نفسشو همون اولین بار که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 242.28,
   "end": 247.16,
   "text": "خواهش کرد، هوا گرفت وجود انسان رو همون لحظه تصدیقش می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 247.16,
   "end": 249.72,
   "text": "این پایه اول معصیته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 249.72,
   "end": 254.24,
   "text": "و همچنین فرمود و الركون الی الهوی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 254.24,
   "end": 257.64,
   "text": "رکون یعنی تمایل پیدا کردن، اعتماد کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 257.64,
   "end": 261.22,
   "text": "اینکه انسان اعتماد کنه به هوای نفسش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 261.22,
   "end": 263.76,
   "text": "تمایل کنه به هوای نفسش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 263.76,
   "end": 266.18,
   "text": "یعنی همون پا دادن به هوای نفسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 266.18,
   "end": 270.6,
   "text": "اگر اون لحظه اول جلوشو گرفتی سوارش میشی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 270.6,
   "end": 273.36,
   "text": "اما اگر ولش کردی بیچاره‌مون می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 273.36,
   "end": 275.82,
   "text": "می‌برمون تا نا کجا آباد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 275.82,
   "end": 277.98,
   "text": "علت اصلی انحرافات همه همینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 277.98,
   "end": 283.02,
   "text": "اول از اینجا شروع شده. خدا رحمت کنه شیخ مرتضی انصاری بزرگ رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 283.02,
   "end": 287.4,
   "text": "ایشون وقتی که در تهران تو مدرسه مادرشاه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 287.4,
   "end": 291.06,
   "text": "با یکی از طلاب هم حجره شده بودند،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 291.06,
   "end": 296.6,
   "text": "خب تازه که آمده بود هم حجره شده بود شیخ مرتضی انصاری بزرگ، اون عالم جلیل القدر،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 296.6,
   "end": 301.22,
   "text": "زعیم جهان شیعه به این طلبه هم حجره‌ش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 301.22,
   "end": 305.06,
   "text": "حالا هم مباحث بودند یا هرچی یا هم پایه بودند بهش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 305.06,
   "end": 309.56,
   "text": "گفت داری میری خرید برای ما یه نون بخر برای غذامون، ناهارمون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 309.56,
   "end": 312.48,
   "text": "این طلبه هم رفت گفت آخه نونه به تنهایی که فایده نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 312.48,
   "end": 315.08,
   "text": "اینم تازه اومده با ما هم حجره شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 315.08,
   "end": 318.26,
   "text": "یه مقدار حلوا هم خرید گذاشت رو نون و آورد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 318.26,
   "end": 323.44,
   "text": "شیخ مرتضی وقتی رسید تو حجره دید حلوا هم رو نونه گفت حلوا رو از کجا آوردی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 323.44,
   "end": 325.56,
   "text": "من فقط پول نون به تو دادم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 325.56,
   "end": 328.62,
   "text": "گفت قرض کردم. پولم نداشتم اما قرض کردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 328.62,
   "end": 331.04,
   "text": "شیخ مرتضی گفت من",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 331.04,
   "end": 334.18,
   "text": "کی می‌خواد به من بگه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 334.18,
   "end": 338.7,
   "text": "ضمانت بده که من تا فردا زنده‌ام که می‌تونم قرضم رو ادا کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 338.7,
   "end": 341.38,
   "text": "نمی‌خوام. خدا خیرت بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 341.38,
   "end": 343.12,
   "text": "همون نونو می‌خورم. نونه رو خورد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 343.12,
   "end": 346.44,
   "text": "تازه نونی که زیر حلوا بود هم نخورد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 346.44,
   "end": 349.94,
   "text": "یعنی حلوایی شده بود. این یعنی چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 349.94,
   "end": 352.26,
   "text": "جلوگیری از خواهش و هوای نفس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 352.26,
   "end": 354.88,
   "text": "دوست داره بخوره. خوشمزه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 354.88,
   "end": 360.98,
   "text": "امیرالمؤمنین علیه الصلاة والسلام یه حلوای خیلی خوشمزه‌ای که توش بادوم و چی و اینا هم ریخته بودند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 360.98,
   "end": 364.44,
   "text": "خیلی خوش طعم و خوشبو آوردن تعارف کنند حضرت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 364.44,
   "end": 371.26,
   "text": "یه نگاه کرد نخورد. یه بار دیگه هم یه تا-- فالوده آوردن جلو به حضرت انگشت زد تو دهانش دید خیلی خوشمزه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 371.26,
   "end": 373.66,
   "text": "نخورد. گفتن یا مولا چرا نمی‌خوری؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 373.66,
   "end": 377.9,
   "text": "فرمود می‌ترسم پررو بشه نفسم چیزای بهتر از این بخواد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 377.9,
   "end": 382.86,
   "text": "حالا ما که نمی‌تونیم مثل مولا علی علیه الصلاة والسلام باشیم ولی حداقل مراقبت کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 382.86,
   "end": 386.74,
   "text": "اینا به گوشمون بخوره. فکر نکنیم خیلی علیه السلام هستم من.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 386.74,
   "end": 388.8,
   "text": "بعد اینجا شیخ مرتضی نخورد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 388.8,
   "end": 392.44,
   "text": "نون زیر حلوا رو هم نخورد. نون، نون‌هایی که حلوایی نبودو خورد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 392.44,
   "end": 395.74,
   "text": "این قصه تموم شد و رفت تا چندین سال بعد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 395.74,
   "end": 402.26,
   "text": "اتفاقاً همین طلبه هم حجره شیخ مرتضی انصاری اومد نجف محضر حضرت آیت الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 402.26,
   "end": 404.34,
   "text": "شیخ مرتضی انصاری بزرگ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 404.34,
   "end": 406.72,
   "text": "بهش گفت آقا شما چه کردی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 406.72,
   "end": 409.78,
   "text": "شدی زعیم جهان شیعه، مرجع عالیقدر جهان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 409.78,
   "end": 412.18,
   "text": "مثل، مثل یکی بره پیش حضرت امام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 412.18,
   "end": 416.22,
   "text": "یا رهبر عزیز بگه شما چه کردی علمدار اسلام و انقلاب شدی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 416.22,
   "end": 422.66,
   "text": "ایشون جوابشو اینطوری داد. فرمود از همون جایی که اون نون حلوایی رو نخوردم، نه حلوه رو ها،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 422.66,
   "end": 425.66,
   "text": "اون نونی که حلوایی شده بود رو نخوردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 425.66,
   "end": 429.84,
   "text": "اما شما با ولاع تمام هم نان رو خوردی هم حلوا رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 429.84,
   "end": 435.7,
   "text": "این‌ها ر-ر-ریزه کاری‌هاییه که بزرگان رعایت کردن لذا خدا هم علم داد دستشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 435.7,
   "end": 440.6,
   "text": "پرچم داد دستشون. ولی من وقتی رعایت نمی‌کنم خدا هم اعتماد نمی‌کنه به من که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 440.6,
   "end": 443.92,
   "text": "تو همین جایی که هستم درجا می‌زنم یا پس رفتم میرم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 443.92,
   "end": 448.56,
   "text": "ان شا الله عاقبتmon ختم بخیر بشه به ذکر صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 448.56,
   "end": 452.0,
   "text": "اللهم صل على",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 452.0,
   "end": 454.7,
   "text": "محمد و آل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 454.7,
   "end": 457.56,
   "text": "محمد و عجل فرج",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}