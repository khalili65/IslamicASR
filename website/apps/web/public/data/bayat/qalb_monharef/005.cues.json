   "start": 12.24,
   "end": 106.4
  },
  {
   "index": 1,
   "title": "## آیهٔ توبه؛ زیغ قلوب در ساعة العسرة",
   "start": 106.4,
   "end": 184.34
  },
  {
   "index": 2,
   "title": "## عنایت خفیه؛ حتی در افضل قربات",
   "start": 184.34,
   "end": 273.08
  },
  {
   "index": 3,
   "title": "## علامه، اسفار و محضر قاضی",
   "start": 273.08,
   "end": 442.05
  },
  {
   "index": 4,
   "title": "## علم الهیات؛ حجاب اکبر و دو ملاک",
   "start": 442.05,
   "end": 575.73
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.36,
   "end": 3.66,
   "text": "بسم الله الرحمن الرحیم و بهین استعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 3.66,
   "end": 7.84,
   "text": "السلام علیک یا داعی الله و ربانی ایات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 7.84,
   "end": 10.36,
   "text": "سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 10.36,
   "end": 13.96,
   "text": "در خصوص احکام رسیدیم به سومین بخش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 13.96,
   "end": 16.78,
   "text": "شکیات صحیح. شک بین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 16.78,
   "end": 21.52,
   "text": "دو و چهار. دو و چهار شک می‌کنی دو رکعت خوندی یا چهار رکعت؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 21.52,
   "end": 25.64,
   "text": "لکن اینجا چون گفتیم یه پایه دوئه گفتیم تو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 25.64,
   "end": 31.36,
   "text": "شک‌هایی که یه پایه دو هست باید کی این شک اتفاق بیفته تا رو-- درست باشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 31.36,
   "end": 34.32,
   "text": "آف، نه ب-سجدتین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 34.32,
   "end": 41.4,
   "text": "سجدتین همیشه بگید که چون یه سجده ن-- سجده یعنی بعد از دو تا سجده رکعت دوم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 41.4,
   "end": 44.48,
   "text": "اگر قبلش اتفاق افتاد باطله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 44.48,
   "end": 49.22,
   "text": "مگر اون احتیاطی که تو سجده بعد از ذکر آخر بگیم که اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 49.22,
   "end": 51.54,
   "text": "کلیه‌ست حالا عرض می‌کنم. اینجا چه باید کرد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 51.54,
   "end": 55.04,
   "text": "بین دو و چهار شک کردیم تو نماز چهار رکعتی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 55.04,
   "end": 59.96,
   "text": "گفتیم برنامه رو میذاریم رو اون بیشتره، رو چهار نماز رو تموم می‌کنیم شاید دو رکعت خوندیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 59.96,
   "end": 65.72,
   "text": "دو تا رکعت اینجا جاخالی داریم برای همین دو رکعت نماز احتیاط ایستاده باید بخونیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 65.72,
   "end": 71.98,
   "text": "تمام. اما اگر این شک چون گفتیم اونایی که رو پایه دوئن اگر این شک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 71.98,
   "end": 79.3,
   "text": "بعد از سجده دوم ذکر آخرش ذکر واجبو که گفتی تو خود سجده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 79.3,
   "end": 81.8,
   "text": "بعد از ذکر واجب سجده دوم تو خود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 81.8,
   "end": 89.2,
   "text": "سجده یعنی سر برنداختی شک کردی آقا فرمودن همین عملیات رو انجام میدی اما احتیاطاً نماز رو اعاده می‌کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 89.2,
   "end": 93.0,
   "text": "دوباره نماز بخون. هر کجا که شک رو پایه‌ش دو بود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 93.0,
   "end": 97.12,
   "text": "و شک بعد از سجدتین اتفاق نیفتاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 97.12,
   "end": 100.66,
   "text": "تو سجده دوم بعد از ذکر واجب اتفاق افتاد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 100.66,
   "end": 105.9,
   "text": "آقا فرمودن همون عملیاته اما احتیاطاً اعاده نماز داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 105.9,
   "end": 109.02,
   "text": "بحث ما در خصوص قلب منحرف بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 109.02,
   "end": 113.32,
   "text": "قلبی که دچار زغ شد و یکی دیگه از آیات رو با هم بخونیم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 113.32,
   "end": 115.86,
   "text": "پیرامون قلبی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 115.86,
   "end": 119.88,
   "text": "زغ گرفته و منحرف شده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 119.88,
   "end": 121.66,
   "text": "نکته جالبی را اشاره کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 121.66,
   "end": 128.76,
   "text": "آیه صد و هفده سوره توبه می‌فرماید \"لَقَدْ تَابَ اللَّهُ عَلَى النَّبِيِّ وَالْمُهَاجِرِينَ وَالْأَنْصَارِ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 128.76,
   "end": 135.22,
   "text": "الَّذِينَ اتَّبَعُوهُ فِي سَاعَةِ الْعُسْرَةِ مِنْ بَعْدِ مَا كَادَ يَزِيغُ\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 135.22,
   "end": 138.84,
   "text": "از زغ میاد. \"يَزِيغُ قُلُوبُ\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 138.84,
   "end": 142.94,
   "text": "قلوب کیا؟ کسانی که \"فَرِيقٌ مِنْهُمْ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 142.94,
   "end": 148.3,
   "text": "ثُمَّ تَابَ عَلَيْهِمْ إِنَّهُ بِهِمْ رَءُوفٌ رَحِيمٌ.\" بر می‌گرده به جنگ تبوک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 148.3,
   "end": 151.96,
   "text": "که عده‌ای از اهل ایمان اینجا متزلزل شدن در جنگ.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 151.96,
   "end": 154.9,
   "text": "ترسیدن. یه اضطرابی به اینا وارد شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 154.9,
   "end": 160.36,
   "text": "قلبشون داشت انحراف پیدا می‌کرد از اینکه واجب الهی رو ترک کنن، پیغمبر رو ترک کنن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 160.36,
   "end": 166.2,
   "text": "و برگردن. اینجا خدا می‌فرماید که \"لَقَدْ تَابَ اللَّهُ\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 166.2,
   "end": 168.66,
   "text": "خدا به سمت اونا توبه کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 168.66,
   "end": 171.76,
   "text": "قبلاً گفتیم توبه ما محصور بین دو توبه خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 171.76,
   "end": 177.34,
   "text": "اول خدا توبه می‌کنه، تو توبه می‌کنی بعد توبه تو رو می‌پذیره دوباره توبه می‌کنه خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 177.34,
   "end": 184.34,
   "text": "اینجا خدا می‌فرماید که برگشت یعنی توجه کرد به قلب این‌ها، دل این‌ها رو از انحراف حفظ کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 184.34,
   "end": 188.02,
   "text": "معمولاً این چنینه. کسی که خدا دوسش داره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 188.02,
   "end": 191.48,
   "text": "به محض اینکه قلبش دچار کوچک‌ترین زغ و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 191.48,
   "end": 196.0,
   "text": "انحرافی شد، خدا یه جوری حالیش می‌کنه با یک عنایتی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 196.0,
   "end": 199.32,
   "text": "از آن الطاف خفیه الهی شمرده می‌شه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 199.32,
   "end": 203.4,
   "text": "قلبش رو متوجه می‌کنه که این کارت اشتباه است حواست باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 203.4,
   "end": 207.84,
   "text": "حتی احتمال داره انسان با عبادات با همه عبادات خیلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 207.84,
   "end": 209.9,
   "text": "نمره بالا مثل نماز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 209.9,
   "end": 213.98,
   "text": "که بالاخره ذکر الله اکبره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 213.98,
   "end": 217.96,
   "text": "حتی گریه بر امام حسین که دیگه به قول آقای بهجت افضل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 217.96,
   "end": 220.1,
   "text": "قرابات و از نماز شب افضل است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 220.1,
   "end": 222.9,
   "text": "از نماز شب بالاتره. یعنی شما اگر عمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 222.9,
   "end": 227.38,
   "text": "دعایی شد بین اینکه الان وقت داری فقط برای امام حسین گریه کنی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 227.38,
   "end": 232.56,
   "text": "زیارت امام حسین بکنی یا نماز شب، آقای بهجت میگه زیارت امام حسین را انجام بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 232.56,
   "end": 238.58,
   "text": "گریه بر امام حسین افضل است. حتی اون افضل رو انجام دادی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 238.58,
   "end": 240.98,
   "text": "قلبت داشت منحرف میشد. چطوری؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 240.98,
   "end": 249.12,
   "text": "مگه میشه انسان؟ بله. فرمود با تکبر، با غرور، با خودشیفتگی، با خود برتربینی، با ریا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 249.12,
   "end": 254.6,
   "text": "با وسمعه. حالا ریا انشاالله شما همه شماها بری هستید اما سمع خطرناکه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 254.6,
   "end": 260.76,
   "text": "یعنی کاری رو قبلاً با اخلاص انجام دادی تموم شده الان به دیگران میگی که بشنون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 260.76,
   "end": 262.98,
   "text": "یا کسی میبی-- میگه تو خوشت میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 262.98,
   "end": 267.8,
   "text": "سمع است. سمع میاد، می‌شنوی، دیگران می‌شنوند، خوشت میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 267.8,
   "end": 270.56,
   "text": "این‌ها ریزه کاری‌هات که خدا اینجا سریع--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 270.56,
   "end": 273.08,
   "text": "مثلا خدا رحمت کنه آقای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 273.08,
   "end": 276.7,
   "text": "شهید مطهری تو دست نوشت‌هاش یه جمله‌ای داشت خیلی جالب بود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 276.7,
   "end": 283.48,
   "text": "از استادش آقای علامه طباطبایی رحمة الله علیه که ایشون می‌فرمودن شهید مطهری می‌فرمودند که استاد ما آقای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 283.48,
   "end": 286.82,
   "text": "علامه طباطبایی می‌فرمودند وقتی من اسفار رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 286.82,
   "end": 293.86,
   "text": "شروع کردم به بررسی و مداقه‌ کردن و با دقت نظر اون رو تجزیه تحلیل می‌کردم عبارات اسفار رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 293.86,
   "end": 297.2,
   "text": "تو بحث وجود و وحدت وجود و چه و چه و اینا بعد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 297.2,
   "end": 305.56,
   "text": "میگه به جا-- انقدر دقت نظرم رو عمیق کردم در بحث اسفار، ایشون یعده بیضایی داشت در این زمینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 305.56,
   "end": 309.34,
   "text": "خود علامه طباطبایی میگه دیگه من پیش خودم گفتم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 309.34,
   "end": 314.5,
   "text": "اگر خود ملاصدرا هم بیاد نمی‌تونه اینطوری تجزیه تحلیل کنه عبارات اسفار رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 314.5,
   "end": 316.78,
   "text": "یعنی یه ذره خوشش اومده بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 316.78,
   "end": 323.12,
   "text": "خودش میگه، خود علامه میگه که آره یه حالت خودشیفتگی به ما دست داد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 323.12,
   "end": 325.86,
   "text": "بعد بلافاصله میره محضر استاد خودش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 325.86,
   "end": 329.22,
   "text": "کی؟ آقای قاضی. محضر استاد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 329.22,
   "end": 333.36,
   "text": "استاد علی آقای قاضی که می‌رسه خود علامه می‌فرماید که وقتی نشستم ایشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 333.36,
   "end": 339.04,
   "text": "دیگه ناخودآگاه بحث وحدت رو شروع، وحدت وجود و کل وجود رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 339.04,
   "end": 341.14,
   "text": "شروع کردن فلسفه‌ش رو بحث کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 341.14,
   "end": 344.88,
   "text": "مطالبی رو چنان پیچیده و غامض",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 344.88,
   "end": 352.86,
   "text": "برای من بیان کردن که من اقرار کردم تو وجود خودم که تا حالا یه کلمه از اسفار رو نفهمیده بودم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 352.86,
   "end": 356.94,
   "text": "چرا خدا این کارو باهاش می‌کنه؟ چون قلبش داشت به انحراف می‌رفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 356.94,
   "end": 360.3,
   "text": "چون ما گاهی اوقات گمان می‌کنیم با کسب معارف دینی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 360.3,
   "end": 365.6,
   "text": "انجام عبادیات و کارهای خوب و که چهار تا کربلا رفتن و یه کار خیر کردن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 365.6,
   "end": 368.54,
   "text": "دیگه الان باید از جبرائیل نازل بشه برامون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 368.54,
   "end": 371.5,
   "text": "این واقعاً این خودشیفتگی در ما بسیار خطرناکه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 371.5,
   "end": 375.41,
   "text": "خیلی اصلاً مغز کبریا مخصوص خداست دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 375.41,
   "end": 379.71,
   "text": "البته خدا متنفر، بدش میاد هرکس به قول خودش دچار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 379.71,
   "end": 382.93,
   "text": "تکبر بشه. برای همین باید خیلی مراقب باشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 382.93,
   "end": 385.35,
   "text": "خوش به حال کسی که به محض اینکه دلش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 385.35,
   "end": 389.59,
   "text": "یه ذره به هر سمت انحراف از هر حیث رفت خدا به دادش برسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 389.59,
   "end": 394.33,
   "text": "اینجا صراحتاً تو این آیه صد و هفتای توبه میگه خدا به داد دل اهل ایمان رسید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 394.33,
   "end": 396.63,
   "text": "ثبات قدم دوباره بهشون داد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 396.63,
   "end": 400.45,
   "text": "سریع سکینه آرامش به دلشون وارد شد، برگشتند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 400.45,
   "end": 405.65,
   "text": "بسیار اتفاق افتاده که ما اصلاً خواستیم این دین رو ببوسیم بذاریم کنار، رک باشیم با هم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 405.65,
   "end": 410.57,
   "text": "واستا حسینی با خدا بگیم. اما یه چیزی تو درون دوباره ما رو محکم کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 410.57,
   "end": 413.57,
   "text": "اون عنایت خداست از انحراف ما رو حفظ کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 413.57,
   "end": 416.29,
   "text": "یه آدم چهار تا پنج تا تو دانشگاه، تو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 416.29,
   "end": 421.79,
   "text": "محل کار، یه جا آدم مثلاً حتی چادری میره تو بین چهار تا بی‌حجاب قرار می‌گیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 421.79,
   "end": 424.77,
   "text": "چهار تا مسئله شبه‌ناک بهش می‌گن سریع متزلزل می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 424.77,
   "end": 428.43,
   "text": "این تزلزل همون رد پای شیطان و این انحراف قلبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 428.43,
   "end": 430.67,
   "text": "خ-خدا سریع به دادش می‌رسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 430.67,
   "end": 435.55,
   "text": "یه جوری دستشون می‌گیره. این عنایت‌ها اگه نباشه وا مسله و واقعاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 435.55,
   "end": 438.47,
   "text": "حتی تو بحث کسب علوم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 438.47,
   "end": 443.41,
   "text": "معنوی همین لباس پیغمبر، طلبگی، اینها امام می‌فرماید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 443.41,
   "end": 447.47,
   "text": "اصلاً خود کسب علم الهیات حجاب اکبر است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 447.47,
   "end": 450.69,
   "text": "امام می‌فرمودن دیگه. هجا-- بزرگ‌ترین حجابه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 450.69,
   "end": 453.23,
   "text": "همینش. آدم گمان کنه دیگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 453.23,
   "end": 455.15,
   "text": "بله دیگه چهار تا حدیث حفظ کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 455.15,
   "end": 460.23,
   "text": "آقای جوادی آملی هم که میگه همین حفظ اینا و بیانش اصلاً این کار اخلاقی نیستش که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 460.23,
   "end": 465.63,
   "text": "تا به عملیات کشیده نشه. ما گمان می‌کنیم چهار تا حدیث گفتیم دیگه تمامه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 465.63,
   "end": 470.35,
   "text": "یادمون باشه اینا ملاک‌هان. در خصوص خود علم یه نکته بگم و السلام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 470.35,
   "end": 475.23,
   "text": "وقتی دقت کنید می‌بینید دو تا ملاک اساسی بر-در خصوص علم داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 475.23,
   "end": 480.41,
   "text": "حالا هر علمی می‌خواد باشه. چون ما حدیث داریم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 480.41,
   "end": 485.69,
   "text": "یک ساعت کار علمی کردن افضل از هفتاد سال عبادته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 485.69,
   "end": 489.83,
   "text": "یا یک عالم از هفتاد عابد اجرش پیش خدا بالاتره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 489.83,
   "end": 495.29,
   "text": "اینا رو داریم. حالا بعضیا میان بحث می‌کنند کدوم علم زیل این حدیث جا می‌گیره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 495.29,
   "end": 498.47,
   "text": "چی؟ شیمی، هندسه، فیزیک، هنر، موسیقی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 498.47,
   "end": 501.29,
   "text": "اینا کدومش؟ یا فقط الهیاته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 501.29,
   "end": 506.97,
   "text": "ما کاری نداریم حالا هرچی که هست دو تا ملاک کلی داریم برای اینکه این علم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 506.97,
   "end": 509.69,
   "text": "علمی‌ست که خدا در قلب ایجاد کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 509.69,
   "end": 513.39,
   "text": "العلم نور یغرفه‌الله فی قلب من اراد ان یهدیا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 513.39,
   "end": 515.61,
   "text": "دو تا ملاک داریم یادمون باشه. یک،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 515.61,
   "end": 521.57,
   "text": "پیغمبر فرمود این علمی که نوره و سبب هدایت می‌شه علمی‌ست که خروجی‌ش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 521.57,
   "end": 524.53,
   "text": "زهد باشه، بی‌رغبتی به دنیا باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 524.53,
   "end": 529.01,
   "text": "یعنی به محض اینکه تو این علم رو کسب کردی به دنیا بی‌رغبت بشی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 529.01,
   "end": 535.05,
   "text": "این یه نشونه. نشونه دوم اینکه اون علمی که ضد ولو به اسم الهیات باشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 535.05,
   "end": 539.53,
   "text": "اون، اون تو رو داره به انحراف می‌کشونه قلب تو رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 539.53,
   "end": 543.71,
   "text": "نشونه‌ش اینه که تو رو دچار خودشیفتگی و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 543.71,
   "end": 546.83,
   "text": "خودبرتربینی و تکبر و این‌ها باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 546.83,
   "end": 551.89,
   "text": "خصوصاً پیغمبر فرمود اگر کسی کسب علم کنه حتی این علوم الهیات رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 551.89,
   "end": 557.47,
   "text": "برای اینکه توجه مردم رو به خودش جلب کنه بگن به به حاج آقا چه--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 557.47,
   "end": 563.73,
   "text": "این فرمود با رو می‌ندازنش تو آتیش یا حتی فرمود جایی قرارش میدن که اونجا پر از آتشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 563.73,
   "end": 569.35,
   "text": "این ملاک‌ها یادمون باشه. ان شا الله عاقبت بخیر بشه به ذکر صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 569.35,
   "end": 572.83,
   "text": "الله- اللهُم صَلِّ عَلَى",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 572.83,
   "end": 575.73,
   "text": "مُحَمَّد وَآلِ مُحَمَّد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}