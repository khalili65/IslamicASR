 },
 "chapters": [
  {
   "index": 0,
   "title": "## یادآوری شک دو و سه و قاعدهٔ پایهٔ دو",
   "start": 13.42,
   "end": 324.16
  },
  {
   "index": 1,
   "title": "## داستان جوان هفده‌ساله و مخالفت نفس",
   "start": 324.16,
   "end": 348.72
  },
  {
   "index": 2,
   "title": "## حجت بر اهل توجیه",
   "start": 348.72,
   "end": 582.06
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.12,
   "end": 4.02,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 4.02,
   "end": 7.44,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 7.44,
   "end": 11.28,
   "text": "آiate سلامٌ علیکم و رحمه الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 11.28,
   "end": 16.06,
   "text": "در خصوص اولین شکی که در شک‌های صحیح بود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 16.06,
   "end": 20.98,
   "text": "عرض کردیم که بین دو و سه بود بنا رو میذاشتیم بر چهار،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 20.98,
   "end": 27.02,
   "text": "یک رکعت دیگه می‌خوندی بنا رو میذاشتیم بر سه، یک رکعت دیگه می‌خوندیم تا بشه چهار رکعت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 27.02,
   "end": 30.16,
   "text": "چون ما بین دو و سه شک داشتیم یا دو یا سه؛",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 30.16,
   "end": 35.5,
   "text": "گفتیم همیشه اون بیشتره رو تا قبل چهار در نظر می‌گیریم تا قبل، تا چهار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 35.5,
   "end": 38.42,
   "text": "بنا رو میذاشتیم سه، یه رکعت دیگه می‌خوندیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 38.42,
   "end": 46.46,
   "text": "در حقیقت ما چهار رکعت یحتمل خوندیم تموم می‌کنیم به خاطر اینکه شاید دو رکعت خونده بودیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 46.46,
   "end": 48.26,
   "text": "یه رکعت جا خالی بود چیکار می‌کردیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 48.26,
   "end": 50.72,
   "text": "یه رکعت نماز احتیاط می‌خوندیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 50.72,
   "end": 52.92,
   "text": "منتها اینجا این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 52.92,
   "end": 58.82,
   "text": "یادمون باشه شک‌هایی که یه پایه‌ش دوئه، این بحث کلی در شک‌های",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 58.82,
   "end": 62.58,
   "text": "صحیح، اینو فکر کنم یادم رفته بهتون بگم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 62.58,
   "end": 66.22,
   "text": "شک‌های صحیح اونی که یه پایه‌ش رو دوئه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 66.22,
   "end": 73.16,
   "text": "اکثرشون غالبشون باید بعد از سجده بین رکعت دومی شک رخ داده باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 73.16,
   "end": 77.48,
   "text": "یعنی رکعت دوم سجده دوم تموم شده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 77.48,
   "end": 79.8,
   "text": "سر برداشتی شک می‌کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 79.8,
   "end": 86.3,
   "text": "اگر قبل از سجده دوم رکعت دوم شک کرده باشی باز باطله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 86.3,
   "end": 88.52,
   "text": "فقط یه احتیاط رهبر داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 88.52,
   "end": 92.18,
   "text": "اونایی که پایه‌ش رو دوئه یعنی یه پایه شکت رو دوئه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 92.18,
   "end": 99.28,
   "text": "یه احتیاط آقا داره اگر بعد از تمام شدن ذکر سجده دوم تو سجده شک کردی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 99.28,
   "end": 102.32,
   "text": "یعنی سجده دوم تو سجده‌ای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 102.32,
   "end": 104.6,
   "text": "ذکر واجبتم گفتی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 104.6,
   "end": 108.98,
   "text": "می‌خوای سر برداری، اون موقع تو سجده شک کردی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 108.98,
   "end": 115.76,
   "text": "درست شد؟ اینجا آقا می‌فرماید شما همون دستورالعمل رو انجام بده احتیاطاً البته، احتیاط واجب کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 115.76,
   "end": 120.16,
   "text": "یا می‌تونی اینو انجام بدی یا مرجع علم دیگه ای روجه کن چون احتیاط واجبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 120.16,
   "end": 123.3,
   "text": "آقا فرمودن یا وقتی که این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 123.3,
   "end": 126.3,
   "text": "عملی که گفتیم مثلا اینجا نماز احتیاط داره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 126.3,
   "end": 129.96,
   "text": "داری یک رکعت نماز احتیاطو خوندی بین دو و سه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 129.96,
   "end": 134.72,
   "text": "بعدا احتیاطا نمازو دوباره اعاده کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 134.72,
   "end": 140.02,
   "text": "این فرمایش آقاست. حالا کسی نمی‌تونه بگه آقا ولش کن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 140.02,
   "end": 142.46,
   "text": "من واسه این کارو انجام میدم مثلا نخواستی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 142.46,
   "end": 147.32,
   "text": "اینجوری نیست. باید اگر، اگه به فتوای آقا خواستی عمل کنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 147.32,
   "end": 150.86,
   "text": "باید ضمن اینکه نماز احتیاطو خوندی بعدش دوباره نمازم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 150.86,
   "end": 153.22,
   "text": "اعاده کنی در اصل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 153.22,
   "end": 156.9,
   "text": "البته احتیاط واجب. در خصوص",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 156.9,
   "end": 164.62,
   "text": "قلب منحرف نکات بسیاری رو خدا لطفی کرد ما از قرآن درآوردیم بعضیاشو ما تبرکاً یکی یکی هر روز میگیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 164.62,
   "end": 169.98,
   "text": "اگه یادتون باشه گفتیم که عواملی که ایجاد انحراف در قلب می‌کنند یا قلب،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 169.98,
   "end": 173.04,
   "text": "قلبی که دچار ضعیف و انحراف شده رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 173.04,
   "end": 175.28,
   "text": "مهم‌ترین اون عوامل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 175.28,
   "end": 182.72,
   "text": "که ایجاد انحراف می‌کنند رو ظلم و فسق و عصیان و تبعیت شیطان و پیروی از شهوات شمردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 182.72,
   "end": 187.72,
   "text": "حالا خود ظلم رو وقتی من یه بررسی اجمالی کردم دیدم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 187.72,
   "end": 190.72,
   "text": "برخی از مصادیق ظلم‌اند که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 190.72,
   "end": 193.48,
   "text": "این‌ها ااا خود مص--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 193.48,
   "end": 195.68,
   "text": "خود ظلم مصادیق مختلفی داره دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 195.68,
   "end": 198.58,
   "text": "بعضی از این مصادیق ظلم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 198.58,
   "end": 205.32,
   "text": "خیلی سریع‌تر انحراف ایجاد می‌کنن و این‌ها به شدت بعضیاش که دیگه یعنی حد اعلان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 205.32,
   "end": 209.72,
   "text": "طوری که خدا میگه اصلاً ظالم‌تر از اینا نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 209.72,
   "end": 214.5,
   "text": "سه تا از اینا رو که از همشون شدت بیشتری داشت رو من انتخاب کردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 214.5,
   "end": 217.52,
   "text": "حالا به فراخور هر روز یکیشو عرض می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 217.52,
   "end": 220.22,
   "text": "یکیش تبعیت از هوای نفسه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 220.22,
   "end": 224.64,
   "text": "که به شدت انحراف قلبی ایجاد می‌کنه که البته این دو بخشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 224.64,
   "end": 229.16,
   "text": "یه بخشش مال کسیه که علم و اطلاع نداره، آگاهی نداره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 229.16,
   "end": 231.58,
   "text": "یه کار خلافی رو می‌کنه نمی‌دونه این خلافه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 231.58,
   "end": 234.38,
   "text": "تب-- هوای نفسشو داره تبعیت می‌کنه اما علم و آگاهی نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 234.38,
   "end": 237.82,
   "text": "مثل ما نیست با منبر نشسته باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 237.82,
   "end": 241.02,
   "text": "یه بخشش مال کسیه که اطلاع، آگاهی داره باز تبعیت می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 241.02,
   "end": 244.52,
   "text": "اون خیلی خطرناک‌تره که حالا ما بعداً عرض می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 244.52,
   "end": 249.9,
   "text": "اما این مصداقش مثلاً در آیه پنجاهه قصه‌ست و من أظلمُ،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 249.9,
   "end": 254.88,
   "text": "أضل ببخشید. یعنی من أضل یعنی کیه گمراه‌تر؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 254.88,
   "end": 257.68,
   "text": "خدا داره می‌فرماید. نشون میده که این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 257.68,
   "end": 264.34,
   "text": "مصداق بالاترین حد ظلمه که سبب انحراف و ضعیف قلب میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 264.34,
   "end": 270.68,
   "text": "و من أضل کیه گمراه‌تر از کسی که من من تبع هواه بغير هدى",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 270.68,
   "end": 274.04,
   "text": "من الله إن الله لا يهدي القوم الظالمین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 274.04,
   "end": 276.62,
   "text": "خدا اینا رو هدایت نمی‌کنه. کیا رو؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 276.62,
   "end": 280.5,
   "text": "کسی که ظلم می‌کنند. مصداق ظلم در این آیه چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 280.5,
   "end": 286.28,
   "text": "تبعیت هوای نفس. پس اگر همینجوری کسی دلشو ول کنه آقا عشقم کشید این کارو بکنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 286.28,
   "end": 289.22,
   "text": "دوست دارم الان دلم اینو می‌خواد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 289.22,
   "end": 294.7,
   "text": "این به شدت انسان رو دچار بیچارگی و انحراف عجیبی می‌کنه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 294.7,
   "end": 303.18,
   "text": "خیلی خطرناکه و اینکه بزرگان بعضا حتی غذاشون رو به خاطر مزش نمی‌خوردن برای اینکه پایه این هوا رو بکنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 303.18,
   "end": 309.56,
   "text": "اونقدر که خطرناکه می‌خوان دیگه کوچک‌ترین اثر رد پای اینو تو وجودشون بکنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 309.56,
   "end": 316.72,
   "text": "اینکه بزرگان ما به شدت اهل مراقبه بودند علتش اینه، اینا خطراتیه که ما رو یه دفعه ضربه فنی می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 316.72,
   "end": 319.32,
   "text": "نمی‌فهمی از کجا خوردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 319.32,
   "end": 325.88,
   "text": "و این خب یادش بخیر یه داستانی من فکر می‌کنم اواخر جنگ بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 325.88,
   "end": 329.54,
   "text": "شیخ حسین انصاریان این داستان رو گفت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 329.54,
   "end": 337.54,
   "text": "از مخالفت نفس یک جوان هفده ساله بچه پولدار بالاشهری که بعدا میره جبهه و شهید میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 337.54,
   "end": 342.04,
   "text": "که واقعا من یادمه چند ساعت تو سجده گریه می‌کردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 342.04,
   "end": 345.6,
   "text": "اون موقع خودم نوجوون بودم این داستانو شنیدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 345.6,
   "end": 349.66,
   "text": "یادمه از صبح تا ظهر تو سجده اشک ریختم وقتی این داستانو شنیدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 349.66,
   "end": 351.42,
   "text": "گفتم بابا اینا کی‌ان؟ ما کی هستیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 351.42,
   "end": 354.78,
   "text": "چون منم خب یه همچین وضعیتی از جهاتی داشتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 354.78,
   "end": 357.94,
   "text": "توی خانواده بسیار مرفه بودیم، نوجوونیمون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 357.94,
   "end": 361.7,
   "text": "یه شباهت‌هایی وجود داشت. اون خطراتی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 361.7,
   "end": 367.08,
   "text": "حالا داستانشو سرچ کنید البته اینجا هست اگه کسی خواست اینجا من چاپ کردم هست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 367.08,
   "end": 371.22,
   "text": "ولی سرچ کنید هست تو اینترنت من نگاه کردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 371.22,
   "end": 376.34,
   "text": "که داستان خلاصه‌ش اینه که یه جوون هفده ساله نامه می‌نویسه اون موقع",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 376.34,
   "end": 382.28,
   "text": "به حالا اواسط جنگ بوده ظاهراً به مجله‌ی معروف زن روس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 382.28,
   "end": 384.96,
   "text": "از مردم کمک می‌خواد. اونایی که تو این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 384.96,
   "end": 388.02,
   "text": "روزنامه می‌خوندن این روزنامه رو کمک می‌خواد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 388.02,
   "end": 390.88,
   "text": "حرفش هم این بوده که آقا من یه جوون هفده ساله‌م،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 390.88,
   "end": 392.64,
   "text": "پدر مادر هم هر دو پزشکن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 392.64,
   "end": 396.1,
   "text": "صبح شش صبح می‌زنن تا یازده شب بیرون خونه هیچکس نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 396.1,
   "end": 400.26,
   "text": "من تا دوازده ظهر مدرسه ام بعد میام تو خونه تنها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 400.26,
   "end": 403.84,
   "text": "وضع مالی توپ، همه چی over به قول ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 403.84,
   "end": 409.76,
   "text": "حالا اینا از اینکه من یه بچه تنهام، تنها نباشم دختر خاله‌ام و به مثلاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 409.76,
   "end": 412.14,
   "text": "عه فرزندی گرفتن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 412.14,
   "end": 415.28,
   "text": "و آوردن تو خونه. این دختر خاله‌ام هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 415.28,
   "end": 422.9,
   "text": "فرزند شیطانه. هم پدر مادر هم منحرف‌اند، خودشون فاسدن، هم این دائماً من رو دعوت به گناه می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 422.9,
   "end": 428.18,
   "text": "این نامه رو برید بخونید خیلی عجیبه و این میگه به من کمک بدید بگید من چیکار کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 428.18,
   "end": 430.32,
   "text": "یک سال تمامه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 430.32,
   "end": 433.88,
   "text": "که من هر روز چندین ساعت با این دختر تو خونه تنها‌م.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 433.88,
   "end": 436.5,
   "text": "هر روز منو دعوت به گناه می‌کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 436.5,
   "end": 439.56,
   "text": "و من نمی‌خوام این گناه کبیره رو مرتکب بشم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 439.56,
   "end": 443.12,
   "text": "تا حالا دامنم آلوده به گناه کبیره نشده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 443.12,
   "end": 445.66,
   "text": "این بچه هفده ساله تو خونه فساد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 445.66,
   "end": 449.12,
   "text": "تو خونه اونطوری. اینا داره حجت رو برای ما تمام می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 449.12,
   "end": 456.0,
   "text": "بعد عجیبه تو نامه اولش می‌نویسه که ای کاش من زشت‌ترین جوون دنیا بودم که کسی به من رغبت نمی‌کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 456.0,
   "end": 461.32,
   "text": "ای کاش تو خانواده‌ی فقیر زندگی می‌کردم که این اتفاق برای من نمی‌افتاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 461.32,
   "end": 466.32,
   "text": "خیلی این‌ها عجیبه. بعضیا گمان می‌کنند که اینکه ما برسمون خوب بود، اینکه در معرض فا--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 466.32,
   "end": 470.26,
   "text": "فساد قرار گرفتیم، تو محیط گناه بودیم، توجیه می‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 470.26,
   "end": 472.86,
   "text": "خدا اینا رو حجت میاره برای ما قیامت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 472.86,
   "end": 475.46,
   "text": "کاری نداریم. بعدش خلاصه ک--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 475.46,
   "end": 480.74,
   "text": "یک هفته بعد ایشون خواب آقا اباعبدالله الحسین علیه السلام رو می‌بینه قربونش بریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 480.74,
   "end": 486.5,
   "text": "آقا بهش می‌فرماید که انقدر این دست اون دست نکن به قول ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 486.5,
   "end": 489.4,
   "text": "عجله کن و خودتو به دانشگاه اصلی برسون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 489.4,
   "end": 492.56,
   "text": "معطل نکن خودتو. و ایشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 492.56,
   "end": 496.0,
   "text": "وقتی که از خواب بیدار میشه خیلی متنبّه میشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 496.0,
   "end": 498.18,
   "text": "و خلاصه راهی جبهه میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 498.18,
   "end": 502.5,
   "text": "منظور آقا رو اینطوری برداشت می‌کنه که ج-- چون امام روتون باشه می‌فرمود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 502.5,
   "end": 505.68,
   "text": "جبهه ها دانشگاه است دیگه. ایشون راهی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 505.68,
   "end": 509.52,
   "text": "جبهه میشه و نامه دومش رو قبل از شهادتش توی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 509.52,
   "end": 513.86,
   "text": "جبهه می‌نویسه برای همین مجله زن روس که آره خدا منو نجات داد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 513.86,
   "end": 519.58,
   "text": "این نامه‌ش اینجا الان هست. یه نامه خیلی قشنگی می‌نویسه که من منتظر جواب شما بودم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 519.58,
   "end": 521.34,
   "text": "منو کمک بدید، جواب ندادید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 521.34,
   "end": 525.54,
   "text": "خود آقا دست به کار شد و ما رو-- راه رو به ما نشون داد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 525.54,
   "end": 530.92,
   "text": "و من از شما خواهش می‌کنم دعا کنید برای دخترها، برای نمی‌دونم نجات جوون‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 530.92,
   "end": 533.2,
   "text": "که امثال من آلوده به گناه نشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 533.2,
   "end": 536.3,
   "text": "خیلی چیز عجیبیه و آخر هم این شهید میشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 536.3,
   "end": 540.94,
   "text": "به شهادت می‌رسه. یه حجت بزرگی‌ست برای امثال بنده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 540.94,
   "end": 543.68,
   "text": "که گمان نکنم اگر امروز دنیای ما،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 543.68,
   "end": 550.4,
   "text": "جامعه‌ی ما، خیابون‌های ما پر از فساد شده ما مجوز گناه داریم و بگیم نه توجیه کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 550.4,
   "end": 555.62,
   "text": "به شدت تبعیت از خواهش دل انسان رو به انحراف می‌کشونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 555.62,
   "end": 559.2,
   "text": "انحراف هم دیگه خشت اول چون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 559.2,
   "end": 563.94,
   "text": "عه نهاد مع-- یا معمار کج تا ثریا می‌رود دیوار کج.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 563.94,
   "end": 567.2,
   "text": "همون اول اگر خطا کنی دیگه رفتی تا آخرش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 567.2,
   "end": 569.6,
   "text": "انشالله عاقبتمون ختم بخیر بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 569.6,
   "end": 572.42,
   "text": "به ذکر صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 572.42,
   "end": 576.22,
   "text": "اللهم صل على",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 576.22,
   "end": 578.92,
   "text": "محمد و آل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 578.92,
   "end": 582.06,
   "text": "محمد و عجل فرجهم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}