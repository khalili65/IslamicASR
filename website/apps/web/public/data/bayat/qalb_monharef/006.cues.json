 "chapters": [
  {
   "index": 0,
   "title": "## شک میان دو و سه و چهار",
   "start": 13.88,
   "end": 33.94
  },
  {
   "index": 1,
   "title": "## قلب منحرف و سه سطح نفس",
   "start": 33.94,
   "end": 171.28
  },
  {
   "index": 2,
   "title": "قرآن با صراحت می‌فرماید خدا فقط از اهل تقوا عمل را می‌پذیرد:",
   "start": 171.28,
   "end": 213.32
  },
  {
   "index": 3,
   "title": "## حقیقت تقوا؛ انجام واجب و ترک حرام",
   "start": 213.32,
   "end": 294.52
  },
  {
   "index": 4,
   "title": "## حکایت سه وزیر و کیسه‌های میوه",
   "start": 294.52,
   "end": 499.1
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.68,
   "end": 4.74,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 4.74,
   "end": 8.18,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 8.18,
   "end": 13.88,
   "text": "آیاته. السلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 13.88,
   "end": 19.22,
   "text": "چهارمین شکی که صحیح هست شک بین دو و سه و چهار هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 19.22,
   "end": 25.84,
   "text": "اگر کسی در نماز چهار رکعتی شک کنه دو رکعت خونده یا سه رکعت خونده یا چهار رکعت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 25.84,
   "end": 29.62,
   "text": "گفتیم این چون پایه دو درش داره باید کی این اتفاق بیفته؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 29.62,
   "end": 33.36,
   "text": "بعد از سجده بین رکعت دوم این شک باید رخ بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 33.36,
   "end": 36.4,
   "text": "اگه قبلش باشه باطله. پس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 36.4,
   "end": 41.22,
   "text": "بعد از سجده بین رکعت دوم نماز چهار رکعتی شک کرد دو،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 41.22,
   "end": 46.44,
   "text": "سه یا چهار رکعت خونده بنا رو میزاره بر چهار نماز رو تموم میکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 46.44,
   "end": 48.5,
   "text": "خب احتمال داره دو رکعت خونده باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 48.5,
   "end": 52.36,
   "text": "اینجا باید دو رکعت نماز احتیاط ایستاده بخونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 52.36,
   "end": 55.24,
   "text": "احتمال داره سه رکعت خونده باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 55.24,
   "end": 59.42,
   "text": "اینجا باید دو رکعت نماز احتیاط نشسته بخونه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 59.42,
   "end": 61.88,
   "text": "که یه رکعت حساب میشه در حقیقت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 61.88,
   "end": 66.88,
   "text": "پس دو رکعت احتیاط ایستاده و دو رکعت احتیاط نشسته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 66.88,
   "end": 69.74,
   "text": "براش واجب میشه. در خصوص",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 69.74,
   "end": 74.5,
   "text": "قلب ضعیف و گرفتار انحراف، یه سوالی اینجا ایجاد میشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 74.5,
   "end": 79.56,
   "text": "که خب این قلب رو شیطان میاد با کمک نفس،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 79.56,
   "end": 87.08,
   "text": "نفس اماره چون ما سه تا سطح نفس در وجود داریم دیگه سطح پست و سفلاس که همون نفس اماره است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 87.08,
   "end": 92.04,
   "text": "یک ن-- سطح علوای نفس، nefsi که مطمئنه است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 92.04,
   "end": 97.9,
   "text": "یک نفس بینابین داریم که معمولا اهل ایمان این حالت رو دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 97.9,
   "end": 101.3,
   "text": "بهش میگن نفس لوانه، سرزنش کننده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 101.3,
   "end": 108.7,
   "text": "این گناه میکنه، گرفتار اماره میشه اما سریع خودش رو سرزنش میکنه میاد به سمت نفس مطمئنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 108.7,
   "end": 116.4,
   "text": "حالا این حالت در غالب ماها وجود داره که اگر این سرزنش کنندگی نباشه بیچاره میشیم ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 116.4,
   "end": 118.52,
   "text": "حالا سوال اینه که این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 118.52,
   "end": 121.18,
   "text": "شیطان ملعون میاد با کمک نفس،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 121.18,
   "end": 124.46,
   "text": "این نفس اماره چیکار میکنه که ما میگیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 124.46,
   "end": 131.34,
   "text": "قلب منحرف میشه به سمت ضعیف میره تا جایی که ما تو دعا از خدا میخوایم لا تزغ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 131.34,
   "end": 134.24,
   "text": "لا تزغ قلوبنا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 134.24,
   "end": 136.28,
   "text": "منحرف نکن دل ما رو،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 136.28,
   "end": 141.02,
   "text": "قلب ما رو بعد الهدایتنا وقتی ما رو هدایت کردی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 141.02,
   "end": 145.6,
   "text": "چیکار میکنه؟ کجا دسترسی داره شیطان که میتونه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 145.6,
   "end": 149.08,
   "text": "جواب اینه که سرمایه ما رو،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 149.08,
   "end": 157.7,
   "text": "قلب رو به سمتی منحرف میکنه که ما سرمایه مون در حقیقت مثل این هکرها هستن دسترسی به حساب شخصی ما پیدا میکنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 157.7,
   "end": 162.84,
   "text": "نمیدونم رمز دوم اینترنتی رو پیدا میکنن یا هرچی حسابو خالی میکنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 162.84,
   "end": 165.64,
   "text": "دقیقا همین حالته. چیزی غیر از این نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 165.64,
   "end": 169.5,
   "text": "شیطان از طریق نفس یه کاری میکنه قلب منحرف میشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 169.5,
   "end": 174.2,
   "text": "و به صراحت آیه قرآن که إنما يتقبل الله من المتقين",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 174.2,
   "end": 179.98,
   "text": "خدا فقط از اهل تقوا اعمال رو قبول میکنه، یه کاری میکنه که تقوای تو رو بگیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 179.98,
   "end": 182.86,
   "text": "وقتی تقوای ما رو گرفت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 182.86,
   "end": 186.54,
   "text": "چی میشه اون موقع؟ هیچ عملی ما قبول نمیشه، بالا نمیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 186.54,
   "end": 193.62,
   "text": "صریح آیه قرآن إنما هم که همه میدونید دیگه حصر یعنی فقط و فقط بدون برو برگرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 193.62,
   "end": 200.14,
   "text": "يتقبل الله من فقط، فقط خدا از اهل تقوا عمل رو قبول میکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 200.14,
   "end": 204.88,
   "text": "پس این زغ یعنی انحراف قلب یعنی هر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 204.88,
   "end": 207.82,
   "text": "میل قلبی به سمت کار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 207.82,
   "end": 212.82,
   "text": "عمل غیر تقوایی یعنی چیزی که انسان را از تقوا دور کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 212.82,
   "end": 217.24,
   "text": "، این تقوا هم بعضیا فقط صرفا میان تو بحث گناه مطرحش میکنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 217.24,
   "end": 220.1,
   "text": "میگن تقوا یعنی گناه نکردن، پرهیزکاری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 220.1,
   "end": 223.34,
   "text": "درصورتی که این غلطه. علامه جواد ائمه میفرمایند که نه خیر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 223.34,
   "end": 226.7,
   "text": "بر اساس روایات ما تقوا دو بخشش هم داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 226.7,
   "end": 230.22,
   "text": "هم انجام واجبات رو داره هم ترک محرمات رو داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 230.22,
   "end": 233.54,
   "text": "تقوا یعنی این. لذا إن أكرمكم عند الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 233.54,
   "end": 242.54,
   "text": "أتقاكم. اصلا ربطی نداره تو پستت چیه، شغلت چیه، نسبت چیه، چقدر پول داری، رنگ قیافت چیه، سیاهی، سفیدی، سرخی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 242.54,
   "end": 246.72,
   "text": "زردی، سبزه ای، زبونت چیه، این حرفا چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 246.72,
   "end": 251.58,
   "text": "بابات عالمه، بابات معروفه، خودت معروفی، مشهوری، اصلا کارت چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 251.58,
   "end": 254.0,
   "text": "مدیری، مدیر کلی، کارگری، جزئی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 254.0,
   "end": 256.86,
   "text": "این حرفا اصلا در درگاه خدا مهم نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 256.86,
   "end": 259.78,
   "text": "تو قبر ما رو میذارن از اینا سؤال میکنن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 259.78,
   "end": 262.36,
   "text": "اتفاقا خیلی از موقعا اونا میشه بار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 262.36,
   "end": 266.26,
   "text": "دوش یعنی بیشتر باعث میشه بیشتر ازت سؤال کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 266.26,
   "end": 269.6,
   "text": "اونچه که مهمه صراحتا قرآن میفرماید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 269.6,
   "end": 273.2,
   "text": "إن أكرمكم گرامی ترینتون اهل تقوا باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 273.2,
   "end": 275.98,
   "text": "تقوا حرف اول و آخر رو میزنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 275.98,
   "end": 278.34,
   "text": "جالبه که در سوره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 278.34,
   "end": 284.24,
   "text": "بقره آیه صد و نود و هفت خیلی زیبا این توشه و تع-- ااا عرض کنم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 284.24,
   "end": 291.3,
   "text": "زادی که ما باید با خودمون ببریم به اون دنیا باز به این چه-- به این زیبایی مطرح شده که وتزودوا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 291.3,
   "end": 293.08,
   "text": "زاد و توشه بردارید با خودتون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 293.08,
   "end": 296.58,
   "text": "خدا داره به من و شما میگه وتزودوا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 296.58,
   "end": 301.0,
   "text": "زاد و توشه بردارید. حالا میخواید به شما معرفی کنم بهترین زاد و توشه چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 301.0,
   "end": 303.68,
   "text": "فإن خير الزاد التقوى",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 303.68,
   "end": 305.94,
   "text": "واتقون يا أولي الالباب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 305.94,
   "end": 308.14,
   "text": "عقلتونو به کار بندازید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 308.14,
   "end": 311.8,
   "text": "أولي الالباب صاحبان خرد حواستون باشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 311.8,
   "end": 314.26,
   "text": "که بهترین توشه برای قیامت تقواست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 314.26,
   "end": 320.56,
   "text": "تموم شد. پس هر وقت که قلب ما داره منحرف میشه یعنی ما رو میخواد به بی تقوایی بکشونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 320.56,
   "end": 325.92,
   "text": "ما باید بچه هامونو در تربیت به گونه ای با تقوا آشنا کنیم یعنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 325.92,
   "end": 329.0,
   "text": "خیر گزینی رو به بچه ها همیشه بهشون یاد بدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 329.0,
   "end": 331.5,
   "text": "دیشب من به پسرم داشتم میگفتم پسرم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 331.5,
   "end": 333.48,
   "text": "همیشه ما بین دوراهی هستیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 333.48,
   "end": 336.08,
   "text": "دوراهی خیر و شر، خیر و شر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 336.08,
   "end": 338.12,
   "text": "تو باید خیر رو انتخاب کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 338.12,
   "end": 340.96,
   "text": "با عقلت کار کن خیر رو گزینش کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 340.96,
   "end": 344.2,
   "text": "اون خیر هم باید بدون تقواس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 344.2,
   "end": 347.32,
   "text": "تا همیشه خیر گزین باشی یعنی متقی باشی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 347.32,
   "end": 352.26,
   "text": "جالبه یه پادشاهی، این بگیم حالا قشنگ جا بیفته جریان بسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 352.26,
   "end": 357.84,
   "text": "یه پادشاهی میگن که این حکایت ها خیلی توش آموزش هست، آموزنده است خیلی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 357.84,
   "end": 360.54,
   "text": "سه تا وزیرشو صدا زد گفت بیاید اینجا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 360.54,
   "end": 364.3,
   "text": "یکی یک کیسه خیلی بزرگ بهشون داد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 364.3,
   "end": 367.66,
   "text": "خیلی کیسه‌های بزرگ گفت میرید تو باغ قصر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 367.66,
   "end": 374.98,
   "text": "هر کدومتون بدون اینکه از کسی کمک بخواید یا اینو بد- بار بکنید به دوش کسی دیگه خودتون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 374.98,
   "end": 378.86,
   "text": "صرفا میوه‌های خوب و مرغوب جمع کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 378.86,
   "end": 381.98,
   "text": "ببینم کی بیشتر جمع می‌کنه، کی میوه‌های بهتر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 381.98,
   "end": 384.9,
   "text": "آقا این سه تا وزیر رفتن و مشغول شدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 384.9,
   "end": 389.08,
   "text": "یکیشون گمان می‌کرد پادشاه اینو برای خودش می‌خواد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 389.08,
   "end": 396.16,
   "text": "لذا بهترین میوه‌ها و بهترین مرغوب‌ترین میوه‌ها رو تا می‌تونست پر کرد تا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 396.16,
   "end": 401.56,
   "text": "دهنه کیسه پر کرد. یکیشون گمان می‌کرد که حالا پادشاه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 401.56,
   "end": 405.16,
   "text": "اینو برای خودش نمی‌خواد، حتما به کسی می‌خواد بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 405.16,
   "end": 409.16,
   "text": "لذا قاطی جمع کرد خوب و بد میوه‌ها رو با هم جمع کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 409.16,
   "end": 412.96,
   "text": "یکی دیگه‌شون می‌گفت بابا این که پادشاه وضعش توپه، ما رو گذاشته سر کار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 412.96,
   "end": 415.42,
   "text": "اصلا نگاه نمی‌کنه این تو چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 415.42,
   "end": 417.86,
   "text": "علف توش ریخت. میوه اینا نریخت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 417.86,
   "end": 421.02,
   "text": "حالا چهار تا دونه میوه و بقیه‌ش هم علف.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 421.02,
   "end": 427.72,
   "text": "سه تایی اومدن دادن و پادشاه دستور داد سه تاشون رو توی مدت طولانی زندانی کنید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 427.72,
   "end": 432.84,
   "text": "طوری که هیچ غذایی هم بهشون ندید با همین کیسه‌ای که دستشونه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 432.84,
   "end": 439.58,
   "text": "سر کنن. حالا یادم نیست چند ماه به اینا فرصت داد که با این سه ماه چقدر با این کیسه‌ها باشن تو زندون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 439.58,
   "end": 444.08,
   "text": "این یعنی همون چیزایی که قرآن به نهی می‌زنه عملیاتی شده‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 444.08,
   "end": 450.8,
   "text": "خیر زاده تقوا. این بیچاره، اون که میوه‌های خوب جمع کرده بود سه ماه قشنگ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 450.8,
   "end": 453.18,
   "text": "میوه‌های خوب و مرغوب رو خورد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 453.18,
   "end": 455.16,
   "text": "و هیچ مشکلی هم پیدا نکرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 455.16,
   "end": 460.92,
   "text": "اون بیچاره که قاطی جمع کرده بود به سختی تونست جان سالم به در ببره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 460.92,
   "end": 465.36,
   "text": "لاغر شد و ضعیف شد. اون بدبختی که علف جمع کرده بود مرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 465.36,
   "end": 469.3,
   "text": "در زندون رو باز کردن دیدن مرده چند وقته از دنیا رفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 469.3,
   "end": 472.12,
   "text": "این یعنی زاد تقوا برای اون روز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 472.12,
   "end": 474.06,
   "text": "یک چیزاییه که مرغوب جمع کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 474.06,
   "end": 480.58,
   "text": "هر وقت که قلب منحرف میشه میخواد ما رو از تقوا و از این میوه‌های مرغوب که زاد اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 480.58,
   "end": 482.88,
   "text": "سرای آخرتی مونه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 482.88,
   "end": 486.12,
   "text": "بی‌رغبت کنه. انشاالله عاقبتمون را خیر کند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 486.12,
   "end": 490.14,
   "text": "بشه به ذکر پربرکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 490.14,
   "end": 499.1,
   "text": "اللهم صل على محمد و آل محمد و عجل فرج-",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}