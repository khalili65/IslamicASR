 },
 "chapters": [
  {
   "index": 0,
   "title": "## استفتا در شکیّاتِ عباداتِ گذشته",
   "start": 14.32,
   "end": 68.94
  },
  {
   "index": 1,
   "title": "## انحرافِ قلب؛ نداشتنِ جرأت در اظهارِ دین",
   "start": 68.94,
   "end": 180.72
  },
  {
   "index": 2,
   "title": "## تکبّر؛ سببِ انحراف",
   "start": 180.72,
   "end": 251.34
  },
  {
   "index": 3,
   "title": "## حکایتِ شیخ جعفر کاشف‌الغطاء",
   "start": 251.34,
   "end": 390.74
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.36,
   "end": 2.66,
   "text": "اللهم صل على",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 2.66,
   "end": 6.94,
   "text": "محمد و آل محمد بسم الله الرحمن الرحیم و به نستعين.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 6.94,
   "end": 11.12,
   "text": "السلام علیک یا داعی الله و ربانی ایاته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 11.12,
   "end": 14.32,
   "text": "السلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 14.32,
   "end": 19.2,
   "text": "از رهبر عزیزمون پیرامون بحث شکیات یه استفتایی شده که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 19.2,
   "end": 25.04,
   "text": "سؤال، سؤال کردن از آقا که اگر کسی بعد از چندین سال متوجه شد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 25.04,
   "end": 31.14,
   "text": "حالا یا شک داشت یا یقین کرد که عباداتش باطل بوده به هر دلیلی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 31.14,
   "end": 34.86,
   "text": "یا شک کرد، بحث شکیات ما بودیم دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 34.86,
   "end": 38.08,
   "text": "اینم خودش یه وجه شک دیگه شکیات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 38.08,
   "end": 42.06,
   "text": "شک کرد یا یقین کرد عباداتش باطل بوده به هر دلیلی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 42.06,
   "end": 47.96,
   "text": "چه باید بکنه؟ آقا فرمودن که اگر شک کنه که عباداتش به هر دلیلی باطل بوده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 47.96,
   "end": 51.24,
   "text": "برمی‌گرده به اون شک بعد از محل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 51.24,
   "end": 55.6,
   "text": "و نباید بهش اعتنا کنه چون محلش گذشته تموم شده رفته هیچ.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 55.6,
   "end": 63.12,
   "text": "اما اگر یقین کرد که عباداتش باطل بوده، هر مقدارش که براش میسوره باید تدارک کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 63.12,
   "end": 65.94,
   "text": "یعنی قضا کنه اون عباداتی که ازش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 65.94,
   "end": 68.82,
   "text": "حالا اشتباه انجام شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 68.82,
   "end": 72.46,
   "text": "یه نکته‌ای رو عرض کنم پیرامون قلب منحرف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 72.46,
   "end": 75.42,
   "text": "که خیلی هم مرتبط با این ایام هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 75.42,
   "end": 85.06,
   "text": "یکی از راه‌هایی که قلب انسان به انحراف کشیده می‌شه، نداشتن جرات و جسارت در بیان حقایق و معارف و نشون دادن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 85.06,
   "end": 87.78,
   "text": "خود به عنوان یک شخص دینداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 87.78,
   "end": 90.46,
   "text": "یعنی انسان به چنان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 90.46,
   "end": 95.28,
   "text": "ثبات اندیشه و رأی و قلبی نرسیده که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 95.28,
   "end": 98.52,
   "text": "بتونه فعال باشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 98.52,
   "end": 100.74,
   "text": "بلکه منفعلانه برخورد می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 100.74,
   "end": 104.34,
   "text": "مثلاً یه مصداقی که عرض کنم الان پیش روی ماست مثل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 104.34,
   "end": 107.2,
   "text": "امسال که ااا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 107.2,
   "end": 109.72,
   "text": "عجیبه که دقیقاً شب سال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 109.72,
   "end": 111.76,
   "text": "نو برخورده به چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 111.76,
   "end": 113.74,
   "text": "شهادت یک امام معصوم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 113.74,
   "end": 120.34,
   "text": "امام هادی علیه السلام. اینجا عده‌ای از اهل دین و مذهبیون میان منفعلانه برخورد می‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 120.34,
   "end": 123.82,
   "text": "به اونجا هنوز نرسیدن، جرات و جسارت اینو ندارن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 123.82,
   "end": 127.32,
   "text": "که مثلاً آقا شب سال نو ما مشکی بپوشیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 127.32,
   "end": 130.8,
   "text": "یا عزادار باشیم یا هیئت بگیریم یا هیئت بریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 130.8,
   "end": 139.22,
   "text": "دیدم بعضیا خجالت می‌کشن از اظهار و بیان حقایق در اینجور مواقع که شاید البته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 139.22,
   "end": 142.0,
   "text": "نمی‌شه از روی اتفاق گفت اما شاید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 142.0,
   "end": 145.36,
   "text": "بسیاری از مردم مثلاً متمایل به سمت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 145.36,
   "end": 147.78,
   "text": "این باشن که نه آقا ول کن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 147.78,
   "end": 152.68,
   "text": "مثلاً شب عید و عشق و سفره هفت سین و عشق و حال و همین حرفا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 152.68,
   "end": 159.82,
   "text": "لذا شاید امثال ماهایی که اون شب مشکی بپوشیم به خاطر جد امام عصرمون رو امل بدونن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 159.82,
   "end": 168.22,
   "text": "اگر کسی قلبش ثابت قدم بوده باشه و دچار انحراف نشده باشه، اینجا محکم وایمیسته رو اعتقاداتش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 168.22,
   "end": 175.26,
   "text": "این چیزی نیستش که اونهایی که پای مرگ و شهادتش وایسادن که دیگه اظهار یک حقیقت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 175.26,
   "end": 180.72,
   "text": "یک واقعیتی از دینماست که البته پایه‌ی دینماست ولادت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 180.72,
   "end": 186.12,
   "text": "یکی از وجوهی که بزرگان گفتن سبب انحراف قلب می‌شه تکبره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 186.12,
   "end": 190.0,
   "text": "و جالبه که در این قصه ما در تکبر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 190.0,
   "end": 193.32,
   "text": "شخص مقابل منفعلانه برخورد می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 193.32,
   "end": 195.88,
   "text": "یعنی طرف تکبر می‌کنه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 195.88,
   "end": 200.38,
   "text": "متکبرانه رفتار می‌کنه از اینکه بخواد خودش رو عزادار جلوه بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 200.38,
   "end": 204.44,
   "text": "بعد ما منفعل می‌شیم. سختمونه مثلاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 204.44,
   "end": 210.62,
   "text": "اون شب می‌خوایم ه-- مهمون خونمون بیاد یا ما جایی بریم مشکی تنمون باشه، یه پرچم عزای سر نفس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 210.62,
   "end": 217.14,
   "text": "سر در خونمون باشه. در برابر تکبر اون شخص نسبت به دین ما منفعلانه رفتار می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 217.14,
   "end": 221.16,
   "text": "این خیلی خطرناکه. آیه هشت سوره آل عمران",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 221.16,
   "end": 224.66,
   "text": "ما از خدا صراحتاً می‌خوایم که ربنا لا تزغ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 224.66,
   "end": 228.12,
   "text": "قلوبنا بعد إذ هدیتنا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 228.12,
   "end": 232.32,
   "text": "خدایا بعد از اینکه ما رو هدایت کردی، نه-- قلب ما رو منحرف نکن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 232.32,
   "end": 235.62,
   "text": "پس می‌شه بعد از هدایت هم قلب منحرف بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 235.62,
   "end": 239.5,
   "text": "این یه وجه‌ش که عرض کردیم در برابر تکبر دیگران انسان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 239.5,
   "end": 243.56,
   "text": "منفعلانه رفتار کنه یا خودش هم متکبرانه رفتار کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 243.56,
   "end": 245.84,
   "text": "در هر حال تکبر یکی از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 245.84,
   "end": 251.34,
   "text": "جاهایی‌ست که انسان رو به شدت به انحراف می‌کشونه و قلب متمایل می‌شه به انحراف.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 251.34,
   "end": 256.68,
   "text": "خدا رحمت کنه شیخ جعفر کاشف الغطا رو اخیراً در احوالاتشون می‌خوندم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 256.68,
   "end": 258.3,
   "text": "بچه که بودم کتاباشونو می‌خوندم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 258.3,
   "end": 262.72,
   "text": "یه کتابی دارن به نام کشف الغطا بخونید، خیلی کتاب عالیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 262.72,
   "end": 265.48,
   "text": "ایشون، یه حالت عجیبی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 265.48,
   "end": 269.1,
   "text": "از ایشون نقل شده در تاریخ که حالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 269.1,
   "end": 272.08,
   "text": "مصداق این حرف ماست عرض کنم و السلام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 272.08,
   "end": 274.7,
   "text": "میگن ایشون تو نماز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 274.7,
   "end": 277.78,
   "text": "می‌خواست نماز شروع بشه، یه مقدار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 277.78,
   "end": 281.04,
   "text": "صدقاتی پیشش بود. این پول‌ها رو بین فقرا تقسیم کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 281.04,
   "end": 285.02,
   "text": "وایساد نماز رو ظاهراً نماز اول رو خوند تموم شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 285.02,
   "end": 288.1,
   "text": "بین دو نماز یه سیدی اومد وایساد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 288.1,
   "end": 290.86,
   "text": "روبه‌روی ایشون با بی‌ادبی تمام گفت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 290.86,
   "end": 293.96,
   "text": "\"آهای! سهم منو بده ببینم.\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 293.96,
   "end": 298.46,
   "text": "سهمش چون سید بود منظورش سهم من از همون خمس و این‌ها بود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 298.46,
   "end": 301.16,
   "text": "که یه سهمش برای سادات فقیر هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 301.16,
   "end": 304.34,
   "text": "گفت سهم منو بده. شیخ جعـ-- با خیلی بی‌ادبی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 304.34,
   "end": 306.72,
   "text": "شیخ جعفر هم گفت عزیزم ببخشید دیر اومدی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 306.72,
   "end": 310.02,
   "text": "ما هرچی بود تقسیم کردیم، چیزی نمونده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 310.02,
   "end": 314.1,
   "text": "اونم آب دهانشو جمع کرد جسارتا یه تف انداخت به ریش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 314.1,
   "end": 318.88,
   "text": "شیخ جعفر کاشف الغطای بزرگ که از علمای بزرگ زمانش بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 318.88,
   "end": 323.46,
   "text": "حالا ما بودیم در برابر این تکبر این شخص چه کر-- چه می‌کردیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 323.46,
   "end": 326.12,
   "text": "ما متکبرانه رفتار می‌کردیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 326.12,
   "end": 328.16,
   "text": "اما شیخ جعفر رو ببینید بلند شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 328.16,
   "end": 330.58,
   "text": "اینا یه ذره ثقیله برای امثال من.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 330.58,
   "end": 334.62,
   "text": "باورش-- چون فاصله گرفتم از حقایق و اخلاقیات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 334.62,
   "end": 339.34,
   "text": "بلند شد قباشو دامن کرد، راه افتاد تو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 339.34,
   "end": 345.54,
   "text": "صف گفت هرکس ریش سید براش، ریش شیخ جعفر براش ارزش داره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 345.54,
   "end": 348.92,
   "text": "برای این سید کمک کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 348.92,
   "end": 353.08,
   "text": "اتفاقاً وقتی این حرفو زد شیخ جعفر دامنشو پر پول کردن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 353.08,
   "end": 357.98,
   "text": "نمازگزارا. بعد پولا رو آورد ریخت جلوی آقا سید گفت بفرمایید ببخشید اگه کمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 357.98,
   "end": 362.38,
   "text": "اینم قیمت ریش ما بود. اون تف انداخت به ریش این.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 362.38,
   "end": 366.42,
   "text": "این از این حرفه اصلاً استفاده کرد برای کمک رسانی به همون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 366.42,
   "end": 371.96,
   "text": "اگر کسی اینطوری بود بله هیچوقت لا تزغ قلوبنا بعد إذ هدیتنا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 371.96,
   "end": 374.1,
   "text": "هیچ‌وقت قلبش به انحراف نمیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 374.1,
   "end": 380.88,
   "text": "اما اگر بخواد متزلزل باشه و منفعلانه برخورد کنه حتی در برابر تکبر دیگران،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 380.88,
   "end": 383.54,
   "text": "اون موقع‌ست که دینشو می‌بازه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 383.54,
   "end": 388.46,
   "text": "ان‌شاءالله که عاقبتمون خیر بشه به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 388.46,
   "end": 390.74,
   "text": "اللهم صل على محمد و آل محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}