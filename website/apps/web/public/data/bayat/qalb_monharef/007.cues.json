  {
   "index": 5,
   "title": "## وقتی منفعت سلب شود؛ آزمون محبت",
   "start": 485.48,
   "end": 547.06
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.12,
   "end": 2.86,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 2.86,
   "end": 5.3,
   "text": "السلام علیک یا داعی الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 5.3,
   "end": 7.12,
   "text": "و ربانی ایاته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 7.12,
   "end": 10.08,
   "text": "السلام علیکم و رحمه الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 10.08,
   "end": 15.7,
   "text": "یکی دیگه از شکیات صحیح که خودش دو تا وجه داره شک بین چهار و پنجه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 15.7,
   "end": 18.52,
   "text": "در نماز چهار رکعت کسی شک کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 18.52,
   "end": 21.18,
   "text": "چهار رکعت خونده یا پنج رکعت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 21.18,
   "end": 27.04,
   "text": "اینجا دو صورت داره. اگر بعد از سجده دو این شک رخ بده یعنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 27.04,
   "end": 31.04,
   "text": "سر از سجده دوم برداشت شک کرد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 31.04,
   "end": 34.4,
   "text": "الان چهار رکعت خونده یا پنج رکعت؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 34.4,
   "end": 39.8,
   "text": "اینجا فرمودن که بنا رو بر چهار میگذاره سلام نماز رو میده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 39.8,
   "end": 45.32,
   "text": "چون شاید پنج رکعت خونده باشه اینجا دو سجده سهو براش واجب میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 45.32,
   "end": 48.08,
   "text": "این یه نکته. اما اگر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 48.08,
   "end": 50.64,
   "text": "بعد از سجده‌ی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 50.64,
   "end": 53.84,
   "text": "ببخشید بعد از اینکه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 53.84,
   "end": 58.72,
   "text": "متوجه شد شک کرده ببینه ایستاده‌ست و این شک رو کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 58.72,
   "end": 61.78,
   "text": "اون اولیه کی بود؟ بعد از سجده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 61.78,
   "end": 67.24,
   "text": "دو. سجده تموم شد میخواد نشسته شک میکنه چهار یا پنجه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 67.24,
   "end": 74.6,
   "text": "اما این ایستاده‌ست. وقتی که ایستاده‌ست شک میکنه چهار یا پنجه اگه بشینه شیه شکش کم میشه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 74.6,
   "end": 78.46,
   "text": "درسته؟ ایستاده شک میکنه چهار رکعت خونده یا پنج رکعت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 78.46,
   "end": 82.1,
   "text": "یعنی الان یا رکعت چهارمه یا رکعت پنجمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 82.1,
   "end": 85.84,
   "text": "اگه اون رکعتو ادامه نده بشینه یه رکعت کم میشه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 85.84,
   "end": 89.24,
   "text": "در حقیقت شکش میشه بین سه و چهار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 89.24,
   "end": 91.44,
   "text": "چهار و پنج تبدیل میشه به سه و چهار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 91.44,
   "end": 94.6,
   "text": "اگه ایستاده باشه شک کنه ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 94.6,
   "end": 99.28,
   "text": "بعد از سجده که هیچی بنا رو چهار میذاره دو تا سجده سهو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 99.28,
   "end": 101.82,
   "text": "اگر ایستاده بود شک کرد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 101.82,
   "end": 106.52,
   "text": "میشینه دیگه ادامه نمیده اون رکعتو که بین همون چهار و پنج بمونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 106.52,
   "end": 109.7,
   "text": "میشینه یه رکعت کم میشه شکش میشه بین سه و چهار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 109.7,
   "end": 112.34,
   "text": "سه و چهارم که مشخص بود دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 112.34,
   "end": 120.36,
   "text": "چون شاید سه رکعت بوده یه رکعت کم داره باید یک نماز احتیاط ایستاده یا دو رکعت نشسته بخونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 120.36,
   "end": 122.32,
   "text": "این دو وجهش. اما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 122.32,
   "end": 125.8,
   "text": "صحبت ما پیرامون قلب منحرف بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 125.8,
   "end": 132.28,
   "text": "یه نکته خیلی کلیدی و مهمی رو عرض کنم که تو مباحث تربیتی هم خیلی به درد بخوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 132.28,
   "end": 135.62,
   "text": "خیلی هم کوتاه عرض می‌کنم بالاخره روز اول هفته‌ست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 135.62,
   "end": 141.2,
   "text": "تبرکاً. دقت داشته باشید ما یه بحثی داریم به نام وابستگی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 141.2,
   "end": 144.68,
   "text": "و ب- یک بحثی به نام دلبستگی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 144.68,
   "end": 148.64,
   "text": "اینا با هم فرق میکنن. اگر کسی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 148.64,
   "end": 151.22,
   "text": "قرار خودش رو و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 151.22,
   "end": 154.36,
   "text": "منفعت خودش رو صرفا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 154.36,
   "end": 158.52,
   "text": "در دنیا خلاصه کنه و مظاهرش،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 158.52,
   "end": 168.52,
   "text": "یعنی این قلب وقتی منحرف شد دچار محیط ولایت طاغوت میشه که مظهرش عرض کردیم دنیاست و حب این دنیا باعث همه خطاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 168.52,
   "end": 173.66,
   "text": "خب جلوه‌های مختلفی این دنیا داره هم از پول و جمال و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 173.66,
   "end": 175.92,
   "text": "منصب و مقام و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 175.92,
   "end": 178.56,
   "text": "خیلی چیزاست، قیافه و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 178.56,
   "end": 186.88,
   "text": "نسب و. حالا اگر کسی گرفتار هر کدوم از این‌ها شد، نقطه آغازین انحراف قلبی‌ش از این جهت شروع شد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 186.88,
   "end": 189.34,
   "text": "که مثلاً همه چی رو تو پول خلاصه کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 189.34,
   "end": 192.34,
   "text": "الان خیلیا اینطورین‌ها. همین مذهبی‌های ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 192.34,
   "end": 194.26,
   "text": "گمان می‌کنن پول حرف اول رو میزنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 194.26,
   "end": 196.96,
   "text": "باور کن بارها من تو مذهبی‌هامون دیدم این حرفو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 196.96,
   "end": 201.58,
   "text": "آقا پول حرف اول رو میزنه. این شرکه اصلاً.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 201.58,
   "end": 204.4,
   "text": "مگه پ- پیغمبر مثلا با پول",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 204.4,
   "end": 208.9,
   "text": "مب از، به صد از خدای منان گرفت مبعوث شد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 208.9,
   "end": 213.86,
   "text": "خدا بعدا براش رسول. ولی اصل کار رو که با پای برهنه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 213.86,
   "end": 217.0,
   "text": "یتیمی بود دیگه. کسی هم تعبیری‌ش نمیارد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 217.0,
   "end": 220.36,
   "text": "حالا اگه کسی این رو فقط در پول خلاصه کنه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 220.36,
   "end": 223.2,
   "text": "مخصوصا بچه انحرافش از اینجا شروع میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 223.2,
   "end": 226.6,
   "text": "به این میگن دل بس وابستگی، نه دلبستگی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 226.6,
   "end": 228.34,
   "text": "وابسته به پول میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 228.34,
   "end": 233.08,
   "text": "چگونه رفتار میکنه؟ تا وقتی که باباش پول داره عاشق باباشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 233.08,
   "end": 236.58,
   "text": "وقتی باباش حقوقشو دیر گ- دادن یا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 236.58,
   "end": 241.6,
   "text": "حقوقش وسط ماه مثل معظم شما زود تموم شد قابل توجه مدیران محترم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 241.6,
   "end": 245.0,
   "text": "اینها چی میشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 245.0,
   "end": 247.26,
   "text": "بچه بدش میاد از باباش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 247.26,
   "end": 249.7,
   "text": "میگه چه باباییه داریم مخصوصا تو ب-",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 249.7,
   "end": 253.14,
   "text": "تو مدرسه میبینه که همه بچه‌ها یکی میگه آقا بابای من",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 253.14,
   "end": 254.86,
   "text": "ماهی صد میلیون تومن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 254.86,
   "end": 265.56,
   "text": "پسرم چربیشون گفت بابا هم‌شاگردی ما همکلاسی‌م گفته بابام یک میلیارد و پونصد میلیون در ماه درآمدشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 265.56,
   "end": 270.92,
   "text": "گفتم بابا اشتباه شنیدی پسرم اصلاً یک میلیارد میدونی چند تا صفر داره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 270.92,
   "end": 279.24,
   "text": "اینا یه دفعه میبینی بچه اگر درست تربیت نشه یعنی نظام فکری‌ش و قلبی‌ش درست شکل نگرفته باشه بدش میاد از باباش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 279.24,
   "end": 282.84,
   "text": "میگه چه باباییه؟ هرچی میخوایم وعده میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 282.84,
   "end": 285.52,
   "text": "وعده‌ی آخر ماه و سر خرمahn.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 285.52,
   "end": 289.64,
   "text": "یا ب مثلاً مادرش تا وقتی براش عزیزه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 289.64,
   "end": 291.52,
   "text": "که شکمشو پر کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 291.52,
   "end": 294.2,
   "text": "حال مادر خوب باشه، غذا بپزه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 294.2,
   "end": 299.98,
   "text": "وقتی که غذا نمیتونه بپزه، حالش خوب نیست یا یه غذای غیر باب میلشو پخته دیگه از مادره خوشش نمیاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 299.98,
   "end": 302.74,
   "text": "اخم میکنه به مادر، بدش میاد از مادر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 302.74,
   "end": 305.94,
   "text": "این وابسته‌ست، این دل بسته نیست که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 305.94,
   "end": 310.16,
   "text": "این خطره این در، در تربیت این بچه ما اشتباه عمل کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 310.16,
   "end": 314.02,
   "text": "انحراف قلبی هم از همین جاها شروع میشه که طرف این بچه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 314.02,
   "end": 316.56,
   "text": "گرفتار یکی از مظاهر دنیا شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 316.56,
   "end": 319.74,
   "text": "همو حتی احتمال داره ما بزرگ بچه باشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 319.74,
   "end": 322.78,
   "text": "یعنی چی؟ آدم بزرگ هم بچه میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 322.78,
   "end": 328.66,
   "text": "گرفتار جمال خانومش میشه تا وقتی خانومش ترگل مرگله به خودش میرسه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 328.66,
   "end": 334.24,
   "text": "حالش خوبه، جوونه، خوشگله، خوش تیپ میکنه اینم مثلاً گروه صفقه‌ش میبا-- خوشش میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 334.24,
   "end": 339.56,
   "text": "به محض اینکه مادره زنه یا خدای نکرده مریضی گرفت، مریضی پوستی گرفت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 339.56,
   "end": 347.46,
   "text": "نمیدونم موهاش ریخت، یه مشکل سنش رفت بالا دیگه این چون دل بسته نبوده وابسته بوده به جمال خانومش وابسته بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 347.46,
   "end": 353.9,
   "text": "لذا اگه کسی حدیث داریم به خاطر پول و جمال کسی باهاش ازدواج کنه خدا میگیره اونا رو ازش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 353.9,
   "end": 360.5,
   "text": "اما اگه کسی به خاطر ایمان ازدواج کرد و اعتقاد، اونا رو خرد خرد خدا بهش میده اون دو تای دیگه رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 360.5,
   "end": 363.08,
   "text": "پس این وابسته به چی شده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 363.08,
   "end": 366.64,
   "text": "جمال همسرش. زن هم همین طور اگر ببینه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 366.64,
   "end": 371.36,
   "text": "مردش تا وقتی که سرحاله، سرزنده است، عزیز است، جیبش پر پول است،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 371.36,
   "end": 376.02,
   "text": "چه می‌دونم جوونه، قویه، خوش تیپه، کچل نشده فلان اینا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 376.02,
   "end": 379.86,
   "text": "دوسش داره. همسر شهید چمران می‌گفت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 379.86,
   "end": 381.98,
   "text": "من وقتی شهید شد فهمیدم کچله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 381.98,
   "end": 387.9,
   "text": "حالا اینو ما نمی‌فهمیم. شهید چمران همسرش می‌گفت وقتی شهید شد من فهمیدم که این کچل بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 387.9,
   "end": 389.96,
   "text": "یعنی اصلاً من توجه نمی‌کردم به این قصه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 389.96,
   "end": 393.2,
   "text": "اینا یه ذره برای ما ثقیله. ولی کسی عاشق شد اینجوری میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 393.2,
   "end": 395.16,
   "text": "کور میشه اصلاً چیزای دیگه نمی‌بینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 395.16,
   "end": 397.62,
   "text": "این دلبسته است نه وابسته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 397.62,
   "end": 403.1,
   "text": "خیلی خطرا، بزرگی‌ها، انحراف از هر قسمش از هر وجهش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 403.1,
   "end": 408.5,
   "text": "تو م-مظاهر دنیا اگه اِج-- ایجاد شد می‌کشونه بچه رو تا جایی که جلو پدر مادرش هم وایمیسته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 408.5,
   "end": 411.66,
   "text": "ما هم همینطور. یهو کارمون به جدایی از همسر می‌کشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 411.66,
   "end": 414.76,
   "text": "چرا؟ وابسته به جمال او هستیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 414.76,
   "end": 418.46,
   "text": "وابسته به کرشما و ناز و اشواهاش هستیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 418.46,
   "end": 423.06,
   "text": "وابسته به خودش نیست. دلبسته به خود همسر نیستیم به جای--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 423.06,
   "end": 427.38,
   "text": "حضرت زهرا دلبسته به امیرالمؤمنین بود، وابسته نبود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 427.38,
   "end": 431.34,
   "text": "لذا وقتی امیرالمؤمنین وضع مالیش خوب نبود، بیشتر علی رو دوست داشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 431.34,
   "end": 433.4,
   "text": "بیشتر علی رو تحویل می‌گرفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 433.4,
   "end": 438.3,
   "text": "دور علی می‌چرخید که علی علیه الصلاة و السلام خجالت نکشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 438.3,
   "end": 445.92,
   "text": "آخر عمرش هم عرض کرد علی جان تو عمرم چیزی از تو نخواستم که شرمنده بشی نتونی، نتونی تهیه کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 445.92,
   "end": 450.24,
   "text": "بچه هاش هم همینطور. سائل داره خونه ملا علی رو زد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 450.24,
   "end": 454.04,
   "text": "یا، یا فاطمه زهرا چیزی تو خونه هست ما کمک کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 454.04,
   "end": 456.34,
   "text": "چه ایثاری دارن خداوکیلی اینا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 456.34,
   "end": 461.8,
   "text": "حضرت فرمودند که علی جان هیچی تو خونه نیست جز یه قرص نانی مال زینب و اونم خوابه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 461.8,
   "end": 463.54,
   "text": "حضرت زینب بچه بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 463.54,
   "end": 469.62,
   "text": "امیرالمؤمنین رفت دم در سائل رو عذرخواهی کنه دید حضرت زینب دم دره قرص نانشو داره میده به سائل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 469.62,
   "end": 472.52,
   "text": "دخترم چه می‌کنی تو خودت گرسنه می‌مونی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 472.52,
   "end": 479.14,
   "text": "کلامو ببین. عرض کرد بابا تر-- نمی‌خوام یه سائل از در خونه بابام دست خالی بره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 479.14,
   "end": 483.16,
   "text": "ببینید یعنی این، این دلبسته است، عاشق باباشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 483.16,
   "end": 485.48,
   "text": "برای باباش هم حرمت نگه می‌داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 485.48,
   "end": 488.72,
   "text": "اما کسی که دلبسته نیست، وابسته است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 488.72,
   "end": 492.88,
   "text": "بالعکس وقتی اون سر فصل‌هایی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 492.88,
   "end": 496.86,
   "text": "منفعتش رو در او دید ازش سلب میشه دیگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 496.86,
   "end": 502.06,
   "text": "کاری نداره با طرف می‌خواد پدرش باشه، مادرش باشه، بچه‌ش باشه یا هرکی همسرش باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 502.06,
   "end": 508.94,
   "text": "دل می‌کید-- می‌کنه ازش. این وابسته بوده به خاطر اون سر فصل‌های مظاهر دنیایی، دلبسته نبوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 508.94,
   "end": 514.0,
   "text": "اگر بچه دلبسته شد وقتی باباش نداره بیشتر عاشق باباشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 514.0,
   "end": 517.92,
   "text": "امتحان کنید بچه‌هاتونو ببینید چجوری از آب در میان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 517.92,
   "end": 520.24,
   "text": "مثلاً یه چ-- یه روزی، یه وقتی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 520.24,
   "end": 523.4,
   "text": "یه جوری فیلم بازی کنید. فیلم ندارم ما که هر روزمون اینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 523.4,
   "end": 525.12,
   "text": "ندارم .",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 525.12,
   "end": 531.24,
   "text": "ببینید چیکار می‌کنه بچه. میگه غصه نخور باباجون خودم برات مثلاً می‌خرم خودم فلان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 531.24,
   "end": 534.16,
   "text": "فیلم بازی می‌کنه بچه چون دلبسته است، وابسته نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 534.16,
   "end": 538.74,
   "text": "انشاالله که عاقبتmon خط به خیر بشه به ذکر صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 538.74,
   "end": 540.96,
   "text": "اللهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 540.96,
   "end": 547.06,
   "text": "صل علی محمد و آل محمد و عجل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}