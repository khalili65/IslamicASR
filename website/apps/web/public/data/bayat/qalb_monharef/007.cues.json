   "start": 31.04,
   "end": 228.34
  },
  {
   "index": 2,
   "title": "## رفتار وابسته به پول و روزی در خانه",
   "start": 228.34,
   "end": 322.78
  },
  {
   "index": 3,
   "title": "## وابستگی به جمال در ازدواج",
   "start": 322.78,
   "end": 423.06
  },
  {
   "index": 4,
   "title": "## الگوی دلبستگی؛ زهرا و زینب علیهماالسلام",
   "start": 423.06,
   "end": 485.48
