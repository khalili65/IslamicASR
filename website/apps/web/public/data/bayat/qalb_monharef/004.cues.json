 },
 "chapters": [
  {
   "index": 0,
   "title": "بسم الله الرحمن الرحیم و به نستعین. درود بر داعیِ خدا و ربّانیِ آیاتش.",
   "start": 12.62,
   "end": 82.36
  },
  {
   "index": 1,
   "title": "## هوای نفس؛ به‌ویژه با علم",
   "start": 82.36,
   "end": 159.56
  },
  {
   "index": 2,
   "title": "آیه‌ای از قرآن صریحاً این موضوع را نهیب می‌زند؛ آیهٔ بیست و سهٔ جاثیه:",
   "start": 159.56,
   "end": 458.4
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 1.78,
   "end": 5.36,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 5.36,
   "end": 8.92,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 8.92,
   "end": 12.62,
   "text": "آیات سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 12.62,
   "end": 16.34,
   "text": "در خصوص دومین شک صحیح",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 16.34,
   "end": 24.98,
   "text": "عرض کنیم که شک بین سه و چهار هست و در هر کجای نماز که اتفاق بیفته این شک صحیحه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 24.98,
   "end": 28.0,
   "text": "چون می‌دونید عرض کردیم که شک‌هایی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 28.0,
   "end": 37.64,
   "text": "غالباً یه پایه‌اش روی دو هست یعنی یک وجه شک روی دو هست باید بعد از سجده بین رکعت دومی شک رخ بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 37.64,
   "end": 39.86,
   "text": "اما در خصوص شک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 39.86,
   "end": 45.34,
   "text": "سه و چهار هر کجای نماز این شک رخ بده در نماز چهار رکعتی البته،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 45.34,
   "end": 48.6,
   "text": "صحیحه و کاری که باید بکنیم خیلی آسونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 48.6,
   "end": 51.24,
   "text": "خب ما بنا رو میذاریم بر چهار دیگه گفتیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 51.24,
   "end": 55.72,
   "text": "تا چهار هر شکی که کردیم اون بیشتره رو قرار میدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 55.72,
   "end": 58.54,
   "text": "بنا رو میذاریم رو چهار چون بین سه و چهار بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 58.54,
   "end": 63.98,
   "text": "نماز رو تموم می‌کنیم. نماز که تموم شد خب شاید احتمال داشته ما سه رکعت خوندیم دیگه، درسته؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 63.98,
   "end": 66.2,
   "text": "چون شک داریم بین سه و چهار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 66.2,
   "end": 74.22,
   "text": "یه رکعت اینجا خالی مونده. اون یه رکعت خالی رو میگن با یک نماز احتیاط ایستاده یا دو رکعت نشسته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 74.22,
   "end": 77.24,
   "text": "جبرانش کنین. یا دو رکعت نشسته هم چون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 77.24,
   "end": 82.36,
   "text": "نماز وقتی نشسته خونده میشه ثوابش نصف میشه لذا دو رکعت می‌خونیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 82.36,
   "end": 90.52,
   "text": "در خصوص قلب زایغ و قلبی که به انحراف رفته گفتیم یکی از مهم‌ترین عواملی که سبب زایغ قلب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 90.52,
   "end": 94.0,
   "text": "و انحراف قلبی میشه هوای نفسه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 94.0,
   "end": 96.9,
   "text": "و عرض کردیم که این هوای نفس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 96.9,
   "end": 101.1,
   "text": "بعضی موقع‌ها شامل کسی میشه که علم و آگاهی نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 101.1,
   "end": 106.84,
   "text": "اما خطر وقت خطر عمده و مهم وقتیه که طرف علم و آگاهی‌شو داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 106.84,
   "end": 113.34,
   "text": "میدونه، پای منبر بزرگ شده، توی هیأت و مساجد، اهل کتابه، میدونه، کتاب خونده، مطالعه کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 113.34,
   "end": 117.42,
   "text": "میدونه این کار خلافه، میدونه این خواهش نفسشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 117.42,
   "end": 120.6,
   "text": "باز با اینکه هدایت به او رسیده انجام میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 120.6,
   "end": 123.96,
   "text": "این خیلی خطرناکتره و این نکته رو هم عرض کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 123.96,
   "end": 126.64,
   "text": "اتفاقاً نفس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 126.64,
   "end": 130.16,
   "text": "با کمک شیطان بیشتر سراغ اهل دین میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 130.16,
   "end": 135.32,
   "text": "اهل مذهب، اونایی که دیندار نیستن و اینا کاری به اونا نداره اصلا نفس و شیطان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 135.32,
   "end": 138.14,
   "text": "اونا راهشون چون به بی‌راه رفته اصلاً کاری به اون‌ها نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 138.14,
   "end": 141.06,
   "text": "بیشتر سراغ اتفاقاً ماها رو می‌گیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 141.06,
   "end": 144.52,
   "text": "شیطان هم تو قرآن به خدا وعده داده که من میام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 144.52,
   "end": 147.8,
   "text": "در صراط مستقیم کمین می‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 147.8,
   "end": 152.02,
   "text": "یعنی جایی که مردم خوب هستن کاری با بدها نداره که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 152.02,
   "end": 156.72,
   "text": "حالا اتفاقاً یک آیه‌ای از قرآن هست که صراحتاً این موضوع رو نهیب می‌زنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 156.72,
   "end": 159.56,
   "text": "آیه بیست و سه جاسیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 159.56,
   "end": 165.34,
   "text": "آیا ندیدی کسی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 165.34,
   "end": 171.22,
   "text": "هوای نفسشو الهه خودش قرار داده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 171.22,
   "end": 176.72,
   "text": "بعضی از مفسرین رو برگردوندن به خود طرف، نه به خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 176.72,
   "end": 179.18,
   "text": "یعنی خدا اون رو گمراه می‌کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 179.18,
   "end": 186.52,
   "text": "در حالی که علمشو داشته، می‌دونسته طرف که این کار یعنی تبعیت هوای نفس کار زشتی‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 186.52,
   "end": 191.92,
   "text": "با توجه به اینکه این علم رو داشته باز تبعیت کرده لذا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 191.92,
   "end": 198.64,
   "text": "خدا هم گمراهش می‌کنه چون براش حجت رو تموم کرده بود بارها و بارها بهش فهمونده بود این کار اشتباهه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 198.64,
   "end": 200.4,
   "text": "بعد اینجاش خیلی خطرناکه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 200.4,
   "end": 204.24,
   "text": "بعد خدا چی کار می‌کنه با همچین کسی که علمشو داشته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 204.24,
   "end": 206.92,
   "text": "باز تبعیت نفس کرده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 206.92,
   "end": 209.92,
   "text": "خیلی خطرناکه. دیگه انسان رو می‌کشونه به وادی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 209.92,
   "end": 212.86,
   "text": "قلب مختوم که قبلاً عرض کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 212.86,
   "end": 221.64,
   "text": "ختمه، دیگه بحث قلب مختومه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 221.64,
   "end": 232.62,
   "text": "خدا یه کاری می‌کنه مهری، پرده‌ای جلوی چشاش اصلاً دیگه نمی‌ذاره این حقایق رو بفهمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 232.62,
   "end": 236.04,
   "text": "یا آیا نمی‌خواید متوجه بشید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 236.04,
   "end": 237.88,
   "text": "حواستون نمی‌خواد دیگه جمع بشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 237.88,
   "end": 240.56,
   "text": "تا کی؟ جالبه ما به این سن دیگه رو--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 240.56,
   "end": 248.5,
   "text": "موهامون داره سفید میشه تازه مثلاً داریم تصمیم می‌گیریم چگونه مخالفت با نفس کنیم و یه نماز باحال بخونیم و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 248.5,
   "end": 253.84,
   "text": "کار از کار گذشت. خیلی باید مراقب باشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 253.84,
   "end": 257.1,
   "text": "در هر حال یادم میاد که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 257.1,
   "end": 260.34,
   "text": "یه روز داشتم بررسی می‌کردم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 260.34,
   "end": 263.1,
   "text": "تو همین موضوع",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 263.1,
   "end": 266.3,
   "text": "که مثلاً هوای نفس چگونه میاد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 266.3,
   "end": 269.82,
   "text": "قدم اول خودش رو نشون میده یا شیطان کمک می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 269.82,
   "end": 272.66,
   "text": "مخصوصاً تو شهرهای مذهبی. برخوردم به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 272.66,
   "end": 275.76,
   "text": "خاطره‌ای که یکی از امام جماعت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 275.76,
   "end": 279.2,
   "text": "مسجد لندن تعریف کرده بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 279.2,
   "end": 282.42,
   "text": "خیلی متنبّه کننده‌ست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 282.42,
   "end": 286.2,
   "text": "که ایشون می‌گفت که من خب وقتی که مامور شدم برم توی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 286.2,
   "end": 290.3,
   "text": "یکی از مساجد شهر لندن نماز بخونم، خونه‌م به مسجد دور بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 290.3,
   "end": 293.52,
   "text": "مجبور بودم که هر روز سوار اتوبوس بشم و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 293.52,
   "end": 295.54,
   "text": "این مسیر رو برم. چند وقتی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 295.54,
   "end": 298.86,
   "text": "خب هر روز با اتوبوس می‌رفتم و یه روز نشستیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 298.86,
   "end": 301.76,
   "text": "سوار اتوبوس شدیم. خب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 301.76,
   "end": 309.14,
   "text": "پولمون رو دادیم. وقتی پولم، بقیشو پس گرفتم، شمردم، نشستم سر جام تو اتوبوس دیدم بیست پنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 309.14,
   "end": 310.76,
   "text": "اضافه بهم داده راننده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 310.76,
   "end": 312.62,
   "text": "حالا بیست پنی چیزی نمیشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 312.62,
   "end": 315.46,
   "text": "به قول خودش میگه من دیدم خیلی کمه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 315.46,
   "end": 318.72,
   "text": "مثلاً فکر کنید بیست ریال، دو تومن چی میشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 318.72,
   "end": 322.52,
   "text": "میگه همینجوری مونده بودم. گفتم ولش کن آخه دیگه بیست پنی چیه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 322.52,
   "end": 326.66,
   "text": "به چه درد راننده می‌خوره؟ با خودم درگیر بودم که اینو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 326.66,
   "end": 330.16,
   "text": "پس بدم، ندم، مثلاً برم به راننده بگم چون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 330.16,
   "end": 332.0,
   "text": "چیزی نبود که. درسته؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 332.0,
   "end": 334.06,
   "text": "پول پوشه هله به نظر ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 334.06,
   "end": 337.24,
   "text": "اما حالا خداروشکر که خود غالب شد به نفسش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 337.24,
   "end": 339.2,
   "text": "میگه وقتی پیاده شدم بهش برگردوندم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 339.2,
   "end": 341.74,
   "text": "گفت آقای راننده این بیست پنی رو شما اضافه به من دادی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 341.74,
   "end": 346.46,
   "text": "گفت آقا یه دقیقه وایسا، شما امام جماعت این مسجده نیستی جدیدا اومدی تو این محل؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 346.46,
   "end": 348.94,
   "text": "گفتم چرا؟ گفت آها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 348.94,
   "end": 353.54,
   "text": "من چند وقته در خصوص دین اسلام دارم تحقیق می‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 353.54,
   "end": 357.06,
   "text": "مخصوصاً هم این بیست پنی رو اضافه به شما دادم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 357.06,
   "end": 361.72,
   "text": "که امتحان کنم ببینم یه مسلمون اینجور مواقع",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 361.72,
   "end": 368.3,
   "text": "چگونه رفتار می‌کنه. رفتار یک مسلمان در چنین مواقعی چگونه است؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 368.3,
   "end": 373.02,
   "text": "میگه من خشکم زد. وقتی از اتوبوس پیاده شدم سرمو گذاشتم رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 373.02,
   "end": 376.26,
   "text": "یه تیر چراغ برق. های های گریه کردم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 376.26,
   "end": 379.1,
   "text": "و از خدا تشکر کردم که دیدم تو مرز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 379.1,
   "end": 382.2,
   "text": "فروختن دین به بیست پنی بودم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 382.2,
   "end": 389.24,
   "text": "دین رو به بیست پنی بفروشم. ببین این خط به این خطوات شیطان که قدم اول نفس اینطوری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 389.24,
   "end": 391.06,
   "text": "از همین جزئیات شروع می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 391.06,
   "end": 394.18,
   "text": "یه دفعه نمیاد بگه برو اختلاس کن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 394.18,
   "end": 396.12,
   "text": "به چاب چند میلیارد. از همین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 396.12,
   "end": 402.72,
   "text": "جاها شروع می‌کنه یواش یواش انسان رو می‌کشونه، قلب رو به انحراف می‌کشونه تا جایی که دیگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 402.72,
   "end": 410.84,
   "text": "می‌زنه آدم می‌کشه با اتوبوس می‌زنه چند نفر رو آش و لاش می‌کنه بعد با پررویی تمام میگه که مگه چیزی نشده حالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 410.84,
   "end": 413.58,
   "text": "چند نفر رو زدیم حالا ما هم می‌خواید جو--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 413.58,
   "end": 417.88,
   "text": "اعدام کنید دو تا بچه داریم مثلاً اعداممون کنید چی میشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 417.88,
   "end": 422.8,
   "text": "اینقدر خ-- قلبش مه خورده که حالیش نمیشه چه جنایتی کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 422.8,
   "end": 426.34,
   "text": "یا آخه اختلاس کردن با پررویی تمام وکیلم می‌گیرن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 426.34,
   "end": 430.22,
   "text": "آخه نامرده هیچ نفهم، تو وکیل برای چی می‌گیری؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 430.22,
   "end": 434.72,
   "text": "ملتو خونشو تو شیشه کردی بعد وکیل می‌گیری برای اختلاس میلیاردی‌ت؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 434.72,
   "end": 441.66,
   "text": "این انحراف از قدم اول شروع میشه به جایی می‌رسونه انسان مهر می‌خوره اصلاً قبول نداره که جنایت کرده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 441.66,
   "end": 444.42,
   "text": "خیانت کرده. خودش هم علیه السلام می‌دونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 444.42,
   "end": 449.88,
   "text": "انشاالله عاقبت ما ختم به خیر بشه به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 449.88,
   "end": 453.4,
   "text": "اللهم صل على",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 453.4,
   "end": 458.4,
   "text": "محمد وآل محمد وعجل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}