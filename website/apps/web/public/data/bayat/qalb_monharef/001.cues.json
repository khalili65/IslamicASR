 "chapters": [
  {
   "index": 0,
   "title": "## شکیات صحیح؛ نه شک با دستور ویژه",
   "start": 21.38,
   "end": 119.3
  },
  {
   "index": 1,
   "title": "## رجوع به رساله نه به ذوق",
   "start": 119.3,
   "end": 165.1
  },
  {
   "index": 2,
   "title": "## پیوند بی‌دقتی در شک و ضعف توکل",
   "start": 165.1,
   "end": 569.42
  },
  {
   "index": 3,
   "title": "## یوسف؛ متن مختصر درس",
   "start": 569.42,
   "end": 599.98
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 2.18,
   "end": 5.44,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 5.44,
   "end": 8.86,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 8.86,
   "end": 12.88,
   "text": "آیاته. السلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 12.88,
   "end": 15.88,
   "text": "رسیدیم به شک‌هایی که صحیح هستن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 15.88,
   "end": 19.34,
   "text": "شک‌های که نباید بهش اعتنا کرد رو عرض کردیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 19.34,
   "end": 24.26,
   "text": "باطل‌ها رو هم عرض کردیم. نه تا شک هستن که اینا صحیح‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 24.26,
   "end": 29.08,
   "text": "یعنی نماز درسته لکن یه دستور اولی باید در هر کدوم لحاظ بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 29.08,
   "end": 35.78,
   "text": "یه چند تا نکته قبل از اینکه این‌ها رو به مرور ما عرض کنیم چند تا نکته کلی در خصوص شکیات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 35.78,
   "end": 42.72,
   "text": "صحیح عرض کنیم این نه تا. اولا اینکه شکیات صحیح همه در نمازهای چهار رکعتی‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 42.72,
   "end": 46.1,
   "text": "دوما اینکه به غیر از اونجاهایی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 46.1,
   "end": 48.98,
   "text": "رهبری احتیاط کردن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 48.98,
   "end": 51.02,
   "text": "همه ااا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 51.02,
   "end": 54.64,
   "text": "اون‌هایی که یه پایه شک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 54.64,
   "end": 60.36,
   "text": "دو هست، یه پایه شک دو هست بعد حالا دو و سه و چهار، دو و چهار، دو و پنج",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 60.36,
   "end": 70.24,
   "text": "هرچی که هست این‌ها وقتی یه پایه شک دو هست باید بعد از سجده بین رکعت دوم این شک اتفاق بیفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 70.24,
   "end": 76.3,
   "text": "اگه قبل از سجده یعنی دو سجده رکعت دوم باشه باطله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 76.3,
   "end": 78.04,
   "text": "و این شک صحیح نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 78.04,
   "end": 83.5,
   "text": "مگر اونجایی چند جا هستش که آقا احتیاط کردن گفتن بعد از اتمام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 83.5,
   "end": 85.96,
   "text": "ذکر سجده یعنی سجده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 85.96,
   "end": 91.08,
   "text": "دوم ذکر سجده رو گفتی تموم شد هنوز سر برنداشتی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 91.08,
   "end": 94.16,
   "text": "اون موقع شک کنی اونو احتیاطه باز.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 94.16,
   "end": 97.38,
   "text": "نکته سوم اینکه هر کجا که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 97.38,
   "end": 102.38,
   "text": "شک یه پایه‌ش کمتر از چهار بود چون تو نماز چهار رکعتیه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 102.38,
   "end": 104.84,
   "text": "مثلا بین سه و چهار،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 104.84,
   "end": 107.18,
   "text": "دو و چهار کمتر از چهاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 107.18,
   "end": 110.24,
   "text": "اونجا برای اون جای خالی نماز احتیاط گذاشتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 110.24,
   "end": 114.3,
   "text": "یه حکم کلیه. نماز احتیاط اون جای خالی رو پر میکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 114.3,
   "end": 116.78,
   "text": "شما بین مثلا سه و چهار شک داری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 116.78,
   "end": 120.4,
   "text": "خب اگه سه تا خونده باشی چی؟ یه رکعت کم داری که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 120.4,
   "end": 123.92,
   "text": "درسته شک داری و نمیزاری به چهار اما یک رکعت اینجا کم داری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 123.92,
   "end": 128.04,
   "text": "اون احتیاط، نماز احتیاط اون جای خالی رو پر میکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 128.04,
   "end": 129.6,
   "text": "اگه بیشتر بود شکه چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 129.6,
   "end": 132.92,
   "text": "از چهار زد بالا مثلا سه و پنج،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 132.92,
   "end": 138.34,
   "text": "سه و چهار و پنج، اصلا از چهار زد به بالا برای اضافه چی کار می‌کنن تو نماز؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 138.34,
   "end": 143.46,
   "text": "سجده سهو انجام میدن. خیلی این فرمول خیلی راحت می‌کنه کار ما رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 143.46,
   "end": 148.04,
   "text": "پس هر کجا که شک یه پایه‌ش کمتر از چهار اومده بود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 148.04,
   "end": 150.38,
   "text": "نماز احتیاط حتما داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 150.38,
   "end": 152.56,
   "text": "اگه مثلا دو، دو،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 152.56,
   "end": 156.42,
   "text": "دو چهار بود مثلا دو رکعت مونده دو تا چهار خب دو تا نماز احتیاط داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 156.42,
   "end": 159.46,
   "text": "اما سه بود یه رکعت داره خیلی راحته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 159.46,
   "end": 161.5,
   "text": "اگه بیشتر از پنج تو شک--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 161.5,
   "end": 166.1,
   "text": "بیشتر از چهار تو شکت اومد پنج و شش و اینا اومد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 166.1,
   "end": 170.1,
   "text": "فرق نمی‌کنه چه پنج باشه چه شش باشه چه ده باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 170.1,
   "end": 173.04,
   "text": "نه-- چی کار میکنه؟ دو سجده سهو رو به وجود میاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 173.04,
   "end": 176.92,
   "text": "خیلی آسونه. حالا بعدا یکی یکی میگیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 176.92,
   "end": 182.06,
   "text": ". بله از امثال من بعید نیست یهو شک بین مثلا دو و هشت هم بکنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 182.06,
   "end": 185.3,
   "text": ". شیش-- دو شش بیاره یهو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 185.3,
   "end": 191.04,
   "text": ". بله اما در خصوص-- بیاییم بگذریم اجازه بدید بگذریم از قلب منیب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 191.04,
   "end": 196.4,
   "text": "و از این سد قلب منیب گذر کنیم که بدجوری ما رو نگه داشت تو خودش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 196.4,
   "end": 200.04,
   "text": "بریم به پنجمین نوع قلب قرآن بپردازیم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 200.04,
   "end": 202.6,
   "text": "انشاالله در هیچ کدوم از شماها نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 202.6,
   "end": 205.84,
   "text": "قلب منیب چون شماها انشاالله یه جلوه‌هایی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 205.84,
   "end": 210.42,
   "text": "یکی از جلوه‌های اون بودید ما زیاد می‌دیدیم، زیاد تلف کردیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 210.42,
   "end": 213.72,
   "text": ". اما این انشاالله در ش-- یه خوب میگیم یه بد دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 213.72,
   "end": 216.52,
   "text": "پنجمین نوع، شیشمی ببخشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 216.52,
   "end": 220.1,
   "text": "شیشمین نوع قلب در قرآن قلب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 220.1,
   "end": 224.92,
   "text": "منحرف است که از زایغ در قرآن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 224.92,
   "end": 229.38,
   "text": "نام برده شده. اونجایی که صراحتا قلب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 229.38,
   "end": 232.08,
   "text": "منحرف رو بیان کرده سه تا آیه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 232.08,
   "end": 234.48,
   "text": "سه تا آیه در قرآن هست یکی--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 234.48,
   "end": 237.96,
   "text": "البته هفت و هشت آل عمران دیگه پشت سر هم اومده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 237.96,
   "end": 243.46,
   "text": "هفت و هشت آل عمران، صد و هفده توبه است و پنج صف.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 243.46,
   "end": 250.42,
   "text": "ولی کلا کلمه زایغ در جا-جاهای دیگه قرآن هم اومده اما منهای بحث قلب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 250.42,
   "end": 255.18,
   "text": "حالا اونا رو هم اشاره میکنیم. به عنوان نمونه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 255.18,
   "end": 259.16,
   "text": "آیه هفت و هشت آل عمران رو بخونیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 259.16,
   "end": 262.18,
   "text": "فأما، البته آیه اولشو از وسطش من میخونم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 262.18,
   "end": 266.72,
   "text": "جایی که به زایغ مرتبط میشه. فأما الذين في قلوبهم زایغ.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 266.72,
   "end": 270.22,
   "text": "اما اون کسایی که تو دلشون انحرافی ایجاد میشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 270.22,
   "end": 274.62,
   "text": "فيتبعون ما تشابه منه ابتغاء الفتنة.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 274.62,
   "end": 277.58,
   "text": "اینا به جای اینکه برن سراغ محکمات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 277.58,
   "end": 280.24,
   "text": "آیات ما میرن سراغ متشابهات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 280.24,
   "end": 283.08,
   "text": "چرا؟ برای اینکه فتنه به پا کنن. تو دوره‌ی ما هم خیلی زیاده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 283.08,
   "end": 285.96,
   "text": "هی شبهه در میارن از آیات متشابه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 285.96,
   "end": 289.24,
   "text": "مثلا ید الله ملجأ، ید الله فوق أیدیهم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 289.24,
   "end": 293.1,
   "text": "میگن ببین خدا دست داره. این آیات متشابهه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 293.1,
   "end": 297.4,
   "text": "میگه خدا دست داره. شما دروغ میگید خدا دیده نمیشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 297.4,
   "end": 299.5,
   "text": "این وهابیت‌ها راست میگن. اینا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 299.5,
   "end": 304.28,
   "text": "اینا آدمایی که دنبال فتنه‌اند قلبشون منحرف شده میرن سراغ چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 304.28,
   "end": 306.7,
   "text": "متشابهات، محکمات رو ول میکنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 306.7,
   "end": 312.5,
   "text": "وابتغاء تأویله. میخوان یه تأویلی، یه تفسیری از خودشون ببافن و بچسبونن به قرآن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 312.5,
   "end": 319.28,
   "text": "مثل الان که تقطیع می‌کنن بعضی آیات رو، بعضی روایات رو و بعضی از گفتار بزرگان رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 319.28,
   "end": 321.92,
   "text": "که دیگه از عجائب روزگاره دیگه الان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 321.92,
   "end": 326.46,
   "text": "تقطیع می‌کنن هی کس-- مثل آقای وحید که سینه چاک رهبریه هی میچسبونن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 326.46,
   "end": 329.26,
   "text": "به خودشون و مقابل نظام قرارش میدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 329.26,
   "end": 333.02,
   "text": "آره دیدید آقای وحید هم تومار رهبری رو پیچوند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 333.02,
   "end": 335.2,
   "text": "تقطیع می‌کنن صحبت‌ها رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 335.2,
   "end": 338.3,
   "text": "این تو قرآن صراح-- اینا دو شر قلب منحرفند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 338.3,
   "end": 340.0,
   "text": "و ما يعلم تأويله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 340.0,
   "end": 345.2,
   "text": "میگه این تأویلی که شما میبافید تأویل حقیقی این آیاتو هیچکس نمی‌تونه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 345.2,
   "end": 347.9,
   "text": "بگه الا الله والراسخون في العلم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 347.9,
   "end": 350.62,
   "text": "الراسخون في العلم هم که اهل بیتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 350.62,
   "end": 354.56,
   "text": "بعد آیه بعد که حالا میفرمود یقولون آمنا به.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 354.56,
   "end": 358.02,
   "text": "اینو که این‌ها کسایی که ایمان میارن به خدا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 358.02,
   "end": 361.14,
   "text": "به همه‌ی آیات ایمان میارن اولوالاباب هستن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 361.14,
   "end": 365.16,
   "text": "بعد این دعاشونه. ربنا لا تزغ،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 365.16,
   "end": 370.64,
   "text": "لا تزغ قلوبنا خدای دل ما رو منحرف نکن بعد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 370.64,
   "end": 372.86,
   "text": "هدایتنا بعد از اینکه هدایت کردی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 372.86,
   "end": 376.3,
   "text": "خیلی دعای مهمیه. خیلی مهمه این دعا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 376.3,
   "end": 378.48,
   "text": "بسیار آدما بودن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 378.48,
   "end": 383.96,
   "text": "بعد از هدایت منحرف شدن [سخنگوی 1 دعای صباحانه را خوانت می کند] .",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 383.96,
   "end": 386.28,
   "text": "این، این دعا رو حفظ کنیم سعی کنیم بالاخره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 386.28,
   "end": 391.08,
   "text": "یکی در میون، دو تا در میون، چهار تا در میون تو خلوتای نمازمون این دعا رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 391.08,
   "end": 396.16,
   "text": "داشته باشیم. اما در خصوص خود زغ دو تا نکته عرض کنم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 396.16,
   "end": 401.28,
   "text": "از خود ادب از در وادی ادبیات بعد حالا توضیحاتش جلسات بعد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 401.28,
   "end": 408.3,
   "text": "زغ رو راغب اصفهانی که میدونید از لغت شناسان سده ششم و هفتمه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 408.3,
   "end": 413.52,
   "text": "در خصوص واژه زغ در اصطلاح اینچنین فرموده زغ این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 413.52,
   "end": 421.7,
   "text": "جمله ایشونه \"زغ در اصطلاح به معنای انحراف و تمایل از پایداری‌ست.\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 421.7,
   "end": 427.52,
   "text": "یعنی اینکه طرف میل پیدا می‌کنه از تمایل به انحراف بره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 427.52,
   "end": 430.68,
   "text": "و میل که می‌کنه تم-- از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 430.68,
   "end": 433.22,
   "text": "ثبات قدم به سمت انحراف بره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 433.22,
   "end": 438.54,
   "text": "و تزایق تمایل و انحراف دو جانبه‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 438.54,
   "end": 441.98,
   "text": "از هر دو جهت این منحرف می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 441.98,
   "end": 447.12,
   "text": "زغ رو در لغت لغت شناسا این چند تا رم معنی کردن اینم بدونید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 447.12,
   "end": 450.64,
   "text": "انحراف از حق، میل،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 450.64,
   "end": 453.5,
   "text": "کشش، عدول.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 453.5,
   "end": 456.0,
   "text": "این‌ها معنای لغوی‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 456.0,
   "end": 459.98,
   "text": "اما معنای اصطلاحی‌ش گفتن انحراف و تمایل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 459.98,
   "end": 462.64,
   "text": "از پایداری در راه دین است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 462.64,
   "end": 464.98,
   "text": "یعنی کسانی که حتی تو راه دین‌اند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 464.98,
   "end": 469.24,
   "text": "اما منحرف می‌شن. پایدار نمی‌مونن، ثابت قدم نمی‌مونن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 469.24,
   "end": 473.8,
   "text": "و معمولا مثلا آقای قرائتی در تفسیر نورش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 473.8,
   "end": 477.58,
   "text": "زیر زیل زغ می‌فرمود که تعبیر ایشون اینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 477.58,
   "end": 481.4,
   "text": "می‌فرمود انحراف از توحید و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 481.4,
   "end": 483.96,
   "text": "ااا تکیه به غیر خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 483.96,
   "end": 486.44,
   "text": "زغ به قول آقای قرائتی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 486.44,
   "end": 489.72,
   "text": "انحراف از توحید است و تکیه به غیر خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 489.72,
   "end": 492.98,
   "text": "یعنی هر تکیه کردنی به هر چیزی به غیر خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 492.98,
   "end": 495.28,
   "text": "لا حول ولا قوه الا بالله،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 495.28,
   "end": 503.08,
   "text": "تو وجودت تثبیت نشده. گاهی بعضیا به علمشون تکیه می‌کنن، گاهی به تیپ‌شون، به مدرک‌شون، به مدیریت‌شون،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 503.08,
   "end": 505.68,
   "text": "به عبادت‌شون، به داشته‌‌هاشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 505.68,
   "end": 509.2,
   "text": "دیگه هر کی به یه چیزی به نسب‌شون به سبب‌شون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 509.2,
   "end": 511.5,
   "text": "تکیه می‌کنن. مثلا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 511.5,
   "end": 514.02,
   "text": "آی-- خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 514.02,
   "end": 521.24,
   "text": "حفظ کنه آقای قرائتی رو در همین تفسیر نورش اشاره می‌کنه تو این باب تکیه به غیر به خنده حضرت یوسف.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 521.24,
   "end": 527.42,
   "text": "یه مصداقه. حضرت یوسف می‌دونید وقتی که سلام الله علیه می‌خواستن بندازنش تو چاه برادراش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 527.42,
   "end": 531.52,
   "text": "دیدن داره می‌خنده. حالا زدن خونی مالیش کردن می‌خوان بندازن تو چاه می‌خنده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 531.52,
   "end": 535.52,
   "text": "گفتن چرا می‌خندی؟ برای چی داری می‌خندی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 535.52,
   "end": 538.28,
   "text": "برادرهای پرروش گفتن واسه چی می‌خندی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 538.28,
   "end": 544.94,
   "text": "گفتش که خنده‌ام از اینه که پیش از این من افتخار می‌کردم ده تا برادر پشتوانه منن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 544.94,
   "end": 547.56,
   "text": "کی می‌تونه به من بگه پشت چشمت ابروعه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 547.56,
   "end": 551.82,
   "text": "الان می‌بینم در همون ده تایی که من دلم خوش کرده بودم گرفتار شدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 551.82,
   "end": 556.4,
   "text": "همونا دارن منو می‌کشن. این یعنی تکیه به غیر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 556.4,
   "end": 562.44,
   "text": "لذا خدا یه کاری می‌کنه اگر بنده شو دوست داشته باشه هر آیینه از هر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 562.44,
   "end": 566.18,
   "text": "چیزی که انسان بهش تکیه کرده امیدشو قطع می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 566.18,
   "end": 569.42,
   "text": "مثل اینجا حضرت یوسف. حالا مصادیق زیاده دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 569.42,
   "end": 572.22,
   "text": "تو خود بخون حدیث مفصل از این مجمع.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 572.22,
   "end": 576.18,
   "text": "هر کجا ما تو زندگیمون به هر چیزی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 576.18,
   "end": 580.8,
   "text": "به غیر از خدا متکی بشیم اگر خدا ما رو دوست داشته باشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 580.8,
   "end": 583.84,
   "text": "قلبمون رو می‌کنه از اون تا به او متمایل بشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 583.84,
   "end": 589.0,
   "text": "و الا اگر نکنه دچار زغ و انحراف قلبی می‌شیم و قصه علی هذا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 589.0,
   "end": 593.88,
   "text": "ان شا الله که عاقبت ما всех خیر باشه به ذکر صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 593.88,
   "end": 597.3,
   "text": "اللهم صل على",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 597.3,
   "end": 599.98,
   "text": "محمد و آل محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}