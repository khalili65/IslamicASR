 "chapters": [
  {
   "index": 0,
   "title": "## شک در اجزای نماز نافله",
   "start": 12.62,
   "end": 88.34
  },
  {
   "index": 1,
   "title": "## قلب منحرف؛ چاره جز مخالفت با نفس نیست",
   "start": 88.34,
   "end": 137.96
  },
  {
   "index": 2,
   "title": "چنان‌که پیامبر فرمود نور چشم من در نماز است:",
   "start": 137.96,
   "end": 171.78
  },
  {
   "index": 3,
   "title": "## حدیث معراج؛ نهیب خدا به پیامبر دربارهٔ نفس",
   "start": 171.78,
   "end": 217.44
  },
  {
   "index": 4,
   "title": "یعنی به لباس‌های نرم و لطیف و طعام‌های خوشمزه و خوش‌نشینی مأنوس مباش که همواره جای نرم را اختیار کنی. آنگاه می‌فرماید:",
   "start": 217.44,
   "end": 251.84
  },
  {
   "index": 5,
   "title": "## ابو حمزة ثمالی؛ لقمان زمان از راه عبادت",
   "start": 251.84,
   "end": 616.45
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.34,
   "end": 3.14,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 3.14,
   "end": 6.6,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 6.6,
   "end": 10.0,
   "text": "آیاته. السلام علیکم و رحمه الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 10.0,
   "end": 14.64,
   "text": "یکی از استفتائاتی که پیرامون شکیات از مقام معظم رهبری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 14.64,
   "end": 17.7,
   "text": "شده پرسیدن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 17.7,
   "end": 20.62,
   "text": "اگر چنانچه در نماز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 20.62,
   "end": 22.62,
   "text": "نافله، نه واجب،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 22.62,
   "end": 27.34,
   "text": "ما شک در اجزاء نماز بکنیم نه رکعت‌ها،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 27.34,
   "end": 31.28,
   "text": "این چگونه است؟ مثلاً در نماز مستحبی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 31.28,
   "end": 33.72,
   "text": "شک کنیم که دو رک--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 33.72,
   "end": 38.16,
   "text": "دو تا سجده انجام دادی یا یک رک-- یک سجده و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 38.16,
   "end": 42.08,
   "text": "اجزاء نماز به رکعتش ربط نداره دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 42.08,
   "end": 46.2,
   "text": "شک کنی که تشهدو انجام دادی یا ندادی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 46.2,
   "end": 49.3,
   "text": "اجزاء نماز در نماز مستحبی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 49.3,
   "end": 52.44,
   "text": "این وظیفه چیه؟ آقا فرمودن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 52.44,
   "end": 54.94,
   "text": "مثل نمازهای واجبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 54.94,
   "end": 60.32,
   "text": "در نمازهای نافله هم شک در اجزاء نماز مثل نماز واجبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 60.32,
   "end": 68.7,
   "text": "یادتون باشه این بود اگر از محل اون جزء گذشتی، رد شدی که هیچ اعتنا نمی‌کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 68.7,
   "end": 76.06,
   "text": "مثلاً شما پا شدی قیام کردی شک می‌کنی که سجده یه دونه بوده دو تا بوده، رد شدی دیگه از محلش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 76.06,
   "end": 79.08,
   "text": "حمدو شروع کردی. اینجا دیگه اعتنا نمی‌کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 79.08,
   "end": 86.54,
   "text": "اما نه، اگر هنوز در همون محل واقع شدی شکت رو، اون چیزی که نزدیکه به یقینه عمل می‌کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 86.54,
   "end": 91.06,
   "text": "این جواب آقا بود. اما در خصوص قلب منحرف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 91.06,
   "end": 93.76,
   "text": "ما نکاتی رو عرض کردیم و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 93.76,
   "end": 96.46,
   "text": "نکته‌ای که امروز عرض می‌کنیم اینه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 96.46,
   "end": 99.18,
   "text": "ما عزیزان دلم چاره‌ای نداریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 99.18,
   "end": 103.48,
   "text": "ما میایم خب از یه وجه اینکه ما باید مراقب باشیم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 103.48,
   "end": 108.06,
   "text": "قلبمون منحرف نشه براساس، براساس هوای نفس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 108.06,
   "end": 111.02,
   "text": "مثال‌هایی رو میاریم، مصادیق رو می‌آوریم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 111.02,
   "end": 114.78,
   "text": "چه کسانی دچار انحراف قلبی شدند و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 114.78,
   "end": 119.82,
   "text": "نفسشون رو لبیک به خواهش‌های نفسشون گفتن و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 119.82,
   "end": 122.58,
   "text": "منحرف شدند. بعد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 122.58,
   "end": 127.34,
   "text": "توجه به این نداریم که هر کسی هم که اگر نمرش بیست شده یا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 127.34,
   "end": 134.78,
   "text": "قبول شده، اونم لاجرم با نفسش مخالفت کرده و اجازه نداده قلبش منحرف بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 134.78,
   "end": 136.76,
   "text": "اینو حواسمون جمع باشه. یعنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 136.76,
   "end": 139.76,
   "text": "چاره‌ای ما نداریم. اگر می‌خوایم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 139.76,
   "end": 144.52,
   "text": "نمره‌ای بگیریم در درگاه اهل بیت و به اون‌ها مقرب بشیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 144.52,
   "end": 149.58,
   "text": "هیچ چاره‌ای نداریم. عملیاتش مخالفت با نفسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 149.58,
   "end": 153.36,
   "text": "مثل اینکه پیغمبر فرمود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 153.36,
   "end": 155.94,
   "text": "نور چشم من در نمازه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 155.94,
   "end": 158.38,
   "text": "قرة عینی في الصلاة.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 158.38,
   "end": 162.54,
   "text": "خب اگه کسی می‌خواد قیامت چشم داشته باشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 162.54,
   "end": 164.14,
   "text": "چاره‌ای جز نماز نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 164.14,
   "end": 168.44,
   "text": "کسی که نماز نمی‌خونه قیامت نابینا محشور می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 168.44,
   "end": 170.96,
   "text": "همین طور اگر کسی می‌خواد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 170.96,
   "end": 176.16,
   "text": "نمره‌ای بگیره در درگاه اهل بیت اختیار بشه، امتیاز بگیره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 176.16,
   "end": 180.62,
   "text": "و کاری انجام بده، عملیاتش مخالفت با نفسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 180.62,
   "end": 184.94,
   "text": "یعنی چاره‌ای جز این نیست. اگه کسی نفسشو رها کرد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 184.94,
   "end": 188.72,
   "text": "نه تنها به اهل بیت تبری پیدا نمی‌کنه و امتیازی نمی‌گیره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 188.72,
   "end": 195.76,
   "text": "جزو کارگزاران و اصطلاحاً نوکران درگاه اهل بیت نمی‌شه، هیچی، اصلاً منحرف می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 195.76,
   "end": 202.94,
   "text": "یه در همین حدیث معراج تو جواهر الثنیه فی الاحادیث القدسی صفحه سیصد و هشتاد و سه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 202.94,
   "end": 206.02,
   "text": "یه بخشیش خدای منان تو حدیث معراج",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 206.02,
   "end": 208.4,
   "text": "که خیلی حدیث معروفی‌ست به پیغمبر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 208.4,
   "end": 212.32,
   "text": "صحبت عجیبی می‌کنه. البته خب این خطاب به پیغمبره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 212.32,
   "end": 215.26,
   "text": "ما نمی‌تونیم بگیم خب صد درصد ما انجام بدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 215.26,
   "end": 222.32,
   "text": "اما وقتی با پیغمبرش خدا اینطوری میگه ما هم باید بالاخره گوش خودمونو بپیچونیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 222.32,
   "end": 224.6,
   "text": "می‌فرمود يا احمد لا تزین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 224.6,
   "end": 230.22,
   "text": "بلین اللباس حواست باشه پیغمبر من",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 230.22,
   "end": 234.28,
   "text": "با ل-- خودت رو زینت نبخش به لباس‌های",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 234.28,
   "end": 237.16,
   "text": "نرم و لطیف و طيب الطعام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 237.16,
   "end": 239.66,
   "text": "با طعام‌های خوشمزه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 239.66,
   "end": 245.5,
   "text": "و لئن الوتا یعنی به خوش نشینی معانوس نباش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 245.5,
   "end": 247.98,
   "text": "همش جای خوش رو اختیار کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 247.98,
   "end": 251.38,
   "text": "فإن النفس مأوى کل شر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 251.38,
   "end": 255.72,
   "text": "ببینید خدا داره به پیغمبرش در معراج چی میگه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 255.72,
   "end": 258.08,
   "text": "نمیگه قربون اون چشم و ابروت برم قربون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 258.08,
   "end": 261.18,
   "text": "می‌فرمود که حواست جمع باشه إن النفس،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 261.18,
   "end": 263.88,
   "text": "فإن النفس مأوى کل شر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 263.88,
   "end": 266.94,
   "text": "نفس محل همه بدی‌هاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 266.94,
   "end": 269.3,
   "text": "وهي رفیق کل سوء",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 269.3,
   "end": 272.18,
   "text": "رفیق می‌شه با هر بدی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 272.18,
   "end": 277.58,
   "text": "تجرها إلى طاعة الله تو رو به سمت اطاعت خدا دعوت می‌کنی، می‌کشونی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 277.58,
   "end": 283.18,
   "text": "و تجرک إلى معصية اما نفس تو، تو رو به سمت معصیت می‌کشونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 283.18,
   "end": 290.1,
   "text": "هرکس جواب به نفسش بده قطعاً به سمت معصیت رفته چون خدا صراحتا داره میگه کار نفس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 290.1,
   "end": 294.3,
   "text": "دعوت به معصیته و تخالفک في طاعته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 294.3,
   "end": 298.2,
   "text": "مخالفت تو رو می‌کنه در اطاعتش،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 298.2,
   "end": 302.5,
   "text": "در ا... و تطيعک فيما تكرهه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 302.5,
   "end": 306.54,
   "text": "تو رو می‌کشونه به کاری که تو ازش بدش، بدت میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 306.54,
   "end": 309.56,
   "text": "بعداً خودت، خودتو سرزنش می‌کنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 309.56,
   "end": 313.52,
   "text": "و تطغى إذا شبعت اینجا رو دقت کنید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 313.52,
   "end": 317.68,
   "text": "تطغى طغیان می‌کنه إذا شبعت وقتی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 317.68,
   "end": 320.98,
   "text": "سیر شد، نفست سیر شد طغیان می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 320.98,
   "end": 325.84,
   "text": "فکر نکن حالا سیرابش کردی دیگه ولت می‌کنه، بدتر طغیان می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 325.84,
   "end": 329.56,
   "text": "و تشكو إذا جاعت وقتی گرسنه می‌مونه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 329.56,
   "end": 333.22,
   "text": "شکوه می‌کنه و تغب إذا افتقرت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 333.22,
   "end": 335.6,
   "text": "وقتی که فقیر می‌شه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 335.6,
   "end": 338.32,
   "text": "فزع می‌کنه، غضب می‌کنه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 338.32,
   "end": 342.52,
   "text": "داد و فریاد می‌کنه و تتكبر إذا از--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 342.52,
   "end": 347.22,
   "text": "از-- از استغنت وقتی که غنی شد، توانگر شد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 347.22,
   "end": 350.82,
   "text": "تتكبر و متکبرانه رفتار می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 350.82,
   "end": 357.26,
   "text": "اینها نهیب‌هاییه که خدا به پیغمبر در خصوص نفس داده و این نفس تو وجود ما نهادینه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 357.26,
   "end": 359.6,
   "text": "ما ازش مصون نیستیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 359.6,
   "end": 362.31,
   "text": "یک دشمنه. حالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 362.31,
   "end": 366.31,
   "text": "این بعداً عرض می‌کنیم هفته بعد اگر توفیق بود که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 366.31,
   "end": 371.39,
   "text": "واقعاً بدترین دشمنان ماست در حالی که ما بهش میدون دادیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 371.39,
   "end": 373.27,
   "text": "این نشون میده که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 373.27,
   "end": 377.63,
   "text": "هیچکس از شر نفس در امان نیست مگر اینکه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 377.63,
   "end": 380.53,
   "text": "استعدادشناسی کنه خودش رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 380.53,
   "end": 383.57,
   "text": "و نفسش رو مستعد کنه برای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 383.57,
   "end": 385.51,
   "text": "رسیدن به قرب الهی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 385.51,
   "end": 388.99,
   "text": "اونم راهی نیست جز مخالفت با نفس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 388.99,
   "end": 391.31,
   "text": "خیلی راحت. یعنی اصلاً تمام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 391.31,
   "end": 395.37,
   "text": "سیر و سلوک ما کلاً هیچی نیست جز مخالفت با نفس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 395.37,
   "end": 398.57,
   "text": "همه بزرگانم از همین راه رسیدن به اونجا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 398.57,
   "end": 400.91,
   "text": "خدا رحمت کنه ابو حمزه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 400.91,
   "end": 403.11,
   "text": "صومالی. ایشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 403.11,
   "end": 405.99,
   "text": "یه روایت ازش دیدم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 405.99,
   "end": 409.41,
   "text": "امام رضا صلوات الله علیه فرمودن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 409.41,
   "end": 413.33,
   "text": "به جهت اینکه ایشون چهار نفر از ما رو درک کرد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 413.33,
   "end": 415.25,
   "text": "ایشون لقمان زمان خودشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 415.25,
   "end": 419.35,
   "text": "ابو حمزه صومالی همین آدمی که خیلی راحت اسمش رو زبان ما میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 419.35,
   "end": 421.67,
   "text": "امام رضا فرمود لقمان زمان خودش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 421.67,
   "end": 427.81,
   "text": "سندش هم ش-- در کتاب شاکر-- شاگردان مکتب ائمه، جلده یک، صفحه صده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 427.81,
   "end": 431.63,
   "text": "که حضرت رضا فرمودن لقمان زمان خودشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 431.63,
   "end": 436.67,
   "text": "کیا رو درک کرد؟ امام سجاد و امام باقر، امام صادق و امام کاظم رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 436.67,
   "end": 440.05,
   "text": "جالبه که یه حدیث دیدم از امام صادق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 440.05,
   "end": 442.41,
   "text": "صلوات الله عليه که فرمودن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 442.41,
   "end": 446.59,
   "text": "\"اني لأستريح إذا رأيتك\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 446.59,
   "end": 449.49,
   "text": "به ابو حمزه. امام صادق فرمود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 449.49,
   "end": 457.45,
   "text": "هر وقت که تو رو می‌بینم \"لأستريح\" و قطعاً آرامش پیدا می‌کنم، راحت می‌شم، احساس راحتی می‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 457.45,
   "end": 463.93,
   "text": "امام زمان یکی به یکی بگه من هر وقت تو رو می‌بینم راحت می‌شم، آرامش پیدا می‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 463.93,
   "end": 465.75,
   "text": "این چه مقامی پیدا کرده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 465.75,
   "end": 468.93,
   "text": "حالا همین ابو حمزه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 468.93,
   "end": 473.19,
   "text": "راه دستیابیش به ائمه این بود که خود-- اصلاً عاشق عبادت بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 473.19,
   "end": 479.45,
   "text": "خیلی عبادت رو دوست داشت. دائماً می‌رفت مسجد کوفه و اونجا مشغول به عبادت بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 479.45,
   "end": 486.01,
   "text": "یه روز نشسته بود رو به روی ستون هفتم که انشاالله قسمت شه برید رو به رو شبستانی که ضربت خورده مولا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 486.01,
   "end": 488.63,
   "text": "یک ستونی هست به نام ستون هفتم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 488.63,
   "end": 490.45,
   "text": "مقام امام سجاد سلام الله عليه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 490.45,
   "end": 497.37,
   "text": "اونجا نشسته بود دید یه جوانی خیلی خوش سیما، دیگه خوش سیما ترین و خوش عطر ترین آقا ندیده بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 497.37,
   "end": 501.81,
   "text": "وارد از در، از باب الكنده شد اومد داخل شد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 501.81,
   "end": 507.85,
   "text": "در همین رو به رو ستون هفتم مشغول یک نماز عالی شد با یک لحن زیبایی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 507.85,
   "end": 511.77,
   "text": "میگه من عاشق چهره و لحن زیبای ایشون و خوش--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 511.77,
   "end": 517.55,
   "text": "عطرش شدم. یک امام-- عمامه به سر داشت و یک نیم لباسی به تن و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 517.55,
   "end": 520.63,
   "text": "و خیلی هم عبا هم رو دوشش نبود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 520.63,
   "end": 526.77,
   "text": "یک عجیب نمازی خوند. بعد چهار رکعت نماز دعایی خوند که اونجا جزو اعمال اون محله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 526.77,
   "end": 529.23,
   "text": "بعد رفت من دنبال سرش رفتم بیرون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 529.23,
   "end": 533.63,
   "text": "همین حاشیه کوفه که رسیدیم دیدم یه کسی یه غلام و یه شتر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 533.63,
   "end": 535.23,
   "text": "نگه داشته که ایشون سوار شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 535.23,
   "end": 538.05,
   "text": "رفتم به این غلامه گفتم کیه ایشون؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 538.05,
   "end": 541.05,
   "text": "گفت شما از چهره‌ی ایشون نشناختیش؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 541.05,
   "end": 544.11,
   "text": "علی بن الحسین زین العابدینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 544.11,
   "end": 546.89,
   "text": "دیگه فهمید. می‌دونست امام زمان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 546.89,
   "end": 550.01,
   "text": "ولی عجیبه که حالا دست از دستش دسترسی نداشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 550.01,
   "end": 552.67,
   "text": "نشون میده که چه خفقانی بوده اون زمان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 552.67,
   "end": 555.43,
   "text": "افتاد به پای امام زمانش که آقاشو پیدا کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 555.43,
   "end": 557.67,
   "text": "بعد حضرت بلندش کرد فرمود نکن این کارو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 557.67,
   "end": 560.45,
   "text": "سجده به جز در برابر خدا جایز نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 560.45,
   "end": 564.03,
   "text": "بلندش کرد و و از مریدان امام سجاد شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 564.03,
   "end": 569.21,
   "text": "بعد امام باقر، امام صادق و امام کاظم شد لقمان زمان خودش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 569.21,
   "end": 574.83,
   "text": "یعنی از طریق مخالفت با نفس از به وسیله عبادات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 574.83,
   "end": 577.19,
   "text": "خدا راهش رو باز کرد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 577.19,
   "end": 579.07,
   "text": "رسید به امام زمانش. اما من",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 579.07,
   "end": 586.19,
   "text": "اگر این nefsi که پیغمبر اونطوری خدا در معراج داره بهش میگه که محل همه شرها، شرها و بدی‌هاست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 586.19,
   "end": 590.21,
   "text": "رهاش کنم امیدی نیست من دستم به دامن امام زمان برسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 590.21,
   "end": 599.61,
   "text": "چون با نفسم تا تونستم مدارا کردم و باهاش مثل یک دشمن بلکه دشمن‌ترین دشمن با نفسم رفتار نکردم، مراقبش نبودم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 599.61,
   "end": 602.47,
   "text": "لذا دائماً در تک او قرار گرفته‌ام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 602.47,
   "end": 607.69,
   "text": "ان شا الله که عاقبتمون ختم به خیر بشه و برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 607.69,
   "end": 611.27,
   "text": "اللهم صل على",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 611.27,
   "end": 613.67,
   "text": "محمد وآل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 613.67,
   "end": 616.45,
   "text": "محمد وعجل لفرج.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}