 },
 "chapters": [
  {
   "index": 0,
   "title": "## شک بین پنج و شش در نماز چهاررکعتی",
   "start": 1.06,
   "end": 71.9
  },
  {
   "index": 1,
   "title": "## انحراف قلب و اعتماد به نفس",
   "start": 71.9,
   "end": 129.9
  },
  {
   "index": 2,
   "title": "## نفس همچون شترمرغ و خرزهره",
   "start": 129.9,
   "end": 149.98
  },
  {
   "index": 3,
   "title": "## لذت آنی و لذت پایدار",
   "start": 149.98,
   "end": 410.22
  },
  {
   "index": 4,
   "title": "## داستان آب‌لیمو در کربلا",
   "start": 410.22,
   "end": 552.16
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 1.06,
   "end": 4.4,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 4.4,
   "end": 7.94,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 7.94,
   "end": 12.1,
   "text": "آیاته سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 12.1,
   "end": 17.02,
   "text": "آخرین شک صحیح یعنی نهمین شکی که صحیح هست شک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 17.02,
   "end": 21.1,
   "text": "در نماز چهار رکعتی شک بین پنج و شش هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 21.1,
   "end": 28.26,
   "text": "کسی البته خیلی به ندرت پیش میاد اما خب احتمالش هست کسی شک کنه که آقا پنج رکعت خونده یا شش رکعت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 28.26,
   "end": 30.26,
   "text": "اینجا در حال ایستاده البته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 30.26,
   "end": 34.0,
   "text": "ایستاده شک می‌کنه که پنج رکعت خونده یا شش رکعت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 34.0,
   "end": 36.32,
   "text": "اینجا باید چیکار کنه؟ باید سریع بنشینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 36.32,
   "end": 38.64,
   "text": "ادامه نده اون رکعت آخر رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 38.64,
   "end": 44.28,
   "text": "وقتی نشست اون رکعت آخر ادامه نداد، یه رکعت از پایه های شکش کم میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 44.28,
   "end": 46.38,
   "text": "میشه شک بین چهار و پنج.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 46.38,
   "end": 48.8,
   "text": "پنج و شش بود نشست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 48.8,
   "end": 51.68,
   "text": "سلام داد میشه چی؟ شک بین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 51.68,
   "end": 56.9,
   "text": "چهار و پنج. چون شاید پنج رکعت خونده یعنی یک رکعت اضافه کرده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 56.9,
   "end": 59.82,
   "text": "دو سجده سهو براش واجب میشه همین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 59.82,
   "end": 62.2,
   "text": "اما باز رهبر عزیزمون اینجا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 62.2,
   "end": 67.9,
   "text": "احتیاط کردن فرمودن احتیاطاً نماز رو دوباره بعد از این عملیات اعاده هم بکنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 67.9,
   "end": 73.74,
   "text": "در بحث قلبی که به انحراف کشیده شده ما گفتیم از مهم‌ترین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 73.74,
   "end": 76.56,
   "text": "عوامل انحراف قلب ظلم است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 76.56,
   "end": 79.52,
   "text": "ظلم به نفس یا به دیگری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 79.52,
   "end": 83.68,
   "text": "و عرض کردیم از مصادیق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 83.68,
   "end": 89.64,
   "text": "ظلم اونجاهایی که مصداق ظلم به نفس و دیگران رخ میده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 89.64,
   "end": 92.1,
   "text": "پادادن به هوای نفسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 92.1,
   "end": 99.74,
   "text": "یعنی جایی که انسان نفسش رو اعتماد کنه بهش و خواهش‌ها و هواهای نفسانی رو لبیک بگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 99.74,
   "end": 106.02,
   "text": "و دیروز عرض کردیم اصلا به فرمایش مولا پِی-- پله اول معصیت همینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 106.02,
   "end": 109.96,
   "text": "بدون استثناء هرکس در این عالم معصیت کرده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 109.96,
   "end": 115.08,
   "text": "و گنهکار شده، پایه اولش از اعتماد به نفسش شروع شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 115.08,
   "end": 119.46,
   "text": "از توجه به هوای نفس و لبیک گفتن به خواهش نفسه شروع شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 119.46,
   "end": 124.0,
   "text": "این حدیث خیلی عجیب رو دقت داشته باشید که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 124.0,
   "end": 126.76,
   "text": "می‌فرمود که البته این حدیث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 126.76,
   "end": 129.9,
   "text": "ادامه یک حدیث مفصلی است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 129.9,
   "end": 135.44,
   "text": "در جواهر الثنیه فی الاحادیث القدسیه، شیخ حر عاملی که بارها این رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 135.44,
   "end": 138.14,
   "text": "معرف حضورتون بوده. صفحه سیصد و هشتاد و سه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 138.14,
   "end": 141.2,
   "text": "یک روایت خیلی مفصلیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 141.2,
   "end": 145.04,
   "text": "که پیغمبر من توصیه می‌کنم این روایت رو برید ببینید طولانیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 145.04,
   "end": 147.18,
   "text": "یعنی بخوایم همینطوری بخونیمش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 147.18,
   "end": 152.12,
   "text": "چند جلسه زمان می‌بره. گفت‌وگوی خدا با پیغمبرش در خصوص",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 152.12,
   "end": 155.86,
   "text": "مخالفت با نفس و اینا. یه بخش آخرش رو من",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 155.86,
   "end": 160.1,
   "text": "عرض می‌کنم که حالا بخش اولش رو بعدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 160.1,
   "end": 163.54,
   "text": "می‌فرماید مثل النفس کلام، کلام خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 163.54,
   "end": 165.96,
   "text": "مثل النفس کمثل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 165.96,
   "end": 168.9,
   "text": "نعامة. نعامة یعنی شترمرغ.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 168.9,
   "end": 171.92,
   "text": "خدا می‌فرماید نفستو می‌خوای بشناسی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 171.92,
   "end": 174.54,
   "text": "که دیگه بهش توجه نکنی؟ مثل شترمرغ.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 174.54,
   "end": 176.98,
   "text": "خیلی جالبه خدا وجه اینکه چرا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 176.98,
   "end": 179.08,
   "text": "تشابه به شترمرغ رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 179.08,
   "end": 181.14,
   "text": "داده تو این حدیث رو بیان می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 181.14,
   "end": 183.58,
   "text": "می‌فرماید تأکل الكثير؛ خیلی می‌خوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 183.58,
   "end": 188.14,
   "text": "شترمرغ غذاش زیاده. و إذا حمل عليها لا تطیر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 188.14,
   "end": 191.16,
   "text": "این وقتی که این همم که می‌خوره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 191.16,
   "end": 194.46,
   "text": "نه بار می‌کشه، نه پرواز می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 194.46,
   "end": 197.98,
   "text": "یعنی نه تو لذت نمیبری از پرواز کردنش،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 197.98,
   "end": 202.66,
   "text": "نه سود می‌بری، منفعت می‌بری از بارکشیش فقط زیاد می‌خوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 202.66,
   "end": 209.04,
   "text": "بعد فرمود دو مرتبه فرمود و مثل دفلی دوباره اون نفس رو خدا داره می‌فرماید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 209.04,
   "end": 211.96,
   "text": "و مثل دفلی یعنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 211.96,
   "end": 214.56,
   "text": "شاید شنیده باشید خرزهره میگن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 214.56,
   "end": 217.78,
   "text": "یه گیاهی هست به نام خرزهره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 217.78,
   "end": 219.82,
   "text": "خیلی ظاهر خوشگلی داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 219.82,
   "end": 222.9,
   "text": "خوش عرض کنم خوش رنگه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 222.9,
   "end": 226.18,
   "text": "خوشبوه و رنگ‌های مختلفی داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 226.18,
   "end": 231.26,
   "text": "اینجا خدا مثال می‌زنه از نفس به خر-- گیاه خرزهره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 231.26,
   "end": 234.0,
   "text": "عرب، عرب، عرب‌ها بهش میگن دفلی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 234.0,
   "end": 239.34,
   "text": "چرا؟ می‌فرماید به جهت اینکه لونه حسن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 239.34,
   "end": 242.96,
   "text": "رنگش زیباست و طعمه مر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 242.96,
   "end": 246.22,
   "text": "طعمش مثل تلخ، مثل زهر مار می‌مونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 246.22,
   "end": 249.98,
   "text": "خیلی تلخه. نفس هم میگه خدا داره مثال می‌زنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 249.98,
   "end": 256.68,
   "text": "پیغمبرش فرمود اینطوریه. ظاهرش خیلی زیباست، خیلی گول زننده است، کیف هم می‌کنی اولش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 256.68,
   "end": 259.02,
   "text": "اما بعدا تلخیش به کامت می‌شینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 259.02,
   "end": 262.14,
   "text": "شما بر-- یه بررسی روانشناسی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 262.14,
   "end": 266.1,
   "text": "کردن کسانی که تو این کارا هستن، روانشناس‌های اسلامی گفتن آقا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 266.1,
   "end": 269.2,
   "text": "بالاترین لذت‌های دنیا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 269.2,
   "end": 271.6,
   "text": "ارتباط جنسی با یک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 271.6,
   "end": 274.72,
   "text": "مخ-- مثلاً جنس مخالفه نهایت‌ش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 274.72,
   "end": 276.98,
   "text": "که اونم گفتن وقتی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 276.98,
   "end": 282.86,
   "text": "اینو-- اونا میگن این بالاترین لذته تو این دنیاست از جهت حالا لذت‌های طبیعی، ناصوتی، حیوانی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 282.86,
   "end": 287.96,
   "text": "یهو آخرش تموم شد، لذت تموم شد، کوفتگی و کرختی و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 287.96,
   "end": 295.66,
   "text": "نمی‌دونم، نمی‌دونم اون گرفتاری‌های بعدش که جسم انسان درگیر میشه، اعصاب انسان خورد میشه، بعضاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 295.66,
   "end": 300.98,
   "text": "ضعف حاصل میشه، اینا میاد و هیچوقت وقتی یادت میاد لذتی حاصل نمیشه تو وجودت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 300.98,
   "end": 303.16,
   "text": "احساس بد هم از بعدتم میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 303.16,
   "end": 308.58,
   "text": "از اون کار بدتم میاد. گاهی اوقات تو خودت می‌مونی چرا من این کارو کردم با اینکه حلال هم بوده اما خیلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 308.58,
   "end": 310.98,
   "text": "یک آنه لذتش یه آنه تموم میشه میره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 310.98,
   "end": 316.58,
   "text": "اینو روانشناس‌های اسلامی میگن. همون لحظه یک آنه تموم میشه میره بعد بدبختی‌هاش می‌مونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 316.58,
   "end": 320.6,
   "text": "اما شما وقتی یه نیمه شب پاشده باشی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 320.6,
   "end": 323.54,
   "text": "یه دو رکعت نماز خونده باشی، یه اشکی، یه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 323.54,
   "end": 328.28,
   "text": "لحظه‌ای از عمرت برای امام حسین ریخته باشی، دستی سر یه یتیم کشیده باشی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 328.28,
   "end": 333.4,
   "text": "تا آخر عمرت هر وقت یادت میاد همون موقع هم لذتشو می‌چشی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 333.4,
   "end": 337.88,
   "text": "کیف می‌کنی. میگی ای کاش دوباره این صحنه تکرار بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 337.88,
   "end": 340.9,
   "text": "این یعنی همین. همین مثالی که خدا داره می‌زنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 340.9,
   "end": 343.78,
   "text": "اونا ظاهرش وقتی به خواهش نفست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 343.78,
   "end": 345.94,
   "text": "عمل کردی، ظاهرش ظاهر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 345.94,
   "end": 350.26,
   "text": "زیبایی داره اما باطنش خیلی سخته، خیلی بده، خیلی تلخه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 350.26,
   "end": 352.82,
   "text": "هیچ نفعی هم برات نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 352.82,
   "end": 355.08,
   "text": "خدا رحمت کنه یکی از علما حالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 355.08,
   "end": 356.58,
   "text": "اسمش متاسفانه از ذهنم رفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 356.58,
   "end": 362.7,
   "text": "یکی از علمای دنيا درشتی که در خاطراتش نقل می‌کنه وقتی رفته بودم کربلا اینو خوب دقت کنید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 362.7,
   "end": 366.56,
   "text": "خیلی مثال جالبی یک داستان که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 366.56,
   "end": 369.06,
   "text": "پیش اومده تو کربلا و خیلی هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 369.06,
   "end": 374.58,
   "text": "به روزه. یعنی امروز باید اصلاً رفت تو بازار تهران داد زد اینو برای ملت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 374.58,
   "end": 379.02,
   "text": "میگه رفتم یه، اِاِاِ کسی بود اونجا از روبروی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 379.02,
   "end": 381.36,
   "text": "حرم اباعبدالله این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 381.36,
   "end": 383.1,
   "text": "فروشگاهی داشت شنیدم مریض شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 383.1,
   "end": 386.42,
   "text": "آدم مؤمنی بود. شنیدم مریض شده رفتیم عیادتش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 386.42,
   "end": 391.56,
   "text": "خیلی مریضی‌ش سخت شده. رفتم تو خونه دیدم ای داد و بیداد این هیچی براش نمونده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 391.56,
   "end": 397.68,
   "text": "همه اساس منزل رو فروخته و یکی دو تا تیکه اساس براش مونده و داره دیگه جون میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 397.68,
   "end": 403.78,
   "text": "آخرای عمرش و بعد به پسرش میگه پسرم برو این چند تا تیکه رو هم بفروش ما خرج مداوامون کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 403.78,
   "end": 406.16,
   "text": "یا می‌میریم یا شفا می‌گیریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 406.16,
   "end": 408.42,
   "text": "بعد من تعجب کردم این با این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 408.42,
   "end": 412.46,
   "text": "معروف بود تو کربلا به مرد ألف ألف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 412.46,
   "end": 417.52,
   "text": "یعنی هزار هزار مثل ما میگیم میلیاردی، یه همچین چیزی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 417.52,
   "end": 420.3,
   "text": "خیلی معروف بود داشتن و دارایی و اینا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 420.3,
   "end": 423.26,
   "text": "من تعجب کردم این چرا به این فلاکت افتاده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 423.26,
   "end": 426.22,
   "text": "آخه شما چ-چي شده که اینطوری شدی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 426.22,
   "end": 428.8,
   "text": "بمیرم برات و فلان قربون صدقه‌ش رفتیم و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 428.8,
   "end": 431.26,
   "text": "اومدیم آرومش کنیم. گفت به من نصیحت نکن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 431.26,
   "end": 433.22,
   "text": "میخوای بهت بگم؟ من خودم میدونم چمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 433.22,
   "end": 435.34,
   "text": "از کجا دارم میخورم. جالبه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 435.34,
   "end": 439.82,
   "text": "حالا کسی اهل ایمان باشه خدا هم بهش می فهمونه که کجا خطا کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 439.82,
   "end": 442.1,
   "text": "اینو خدا دوسش داشته وگرنه زدش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 442.1,
   "end": 446.72,
   "text": "اما کار خودش خودشو زده. مثل همه این چی خر زهره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 446.72,
   "end": 451.96,
   "text": "میگه من یه مدت بود که یه مریضی تو کربلا شایع شده بود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 451.96,
   "end": 457.12,
   "text": "و این داروش فال-- اِاِاِ آب لیمو شیرازی بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 457.12,
   "end": 459.72,
   "text": "آب لیمو شیرازی داروی این مریضی بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 459.72,
   "end": 461.88,
   "text": "من یه مقداری از این آب لیمو داشتم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 461.88,
   "end": 465.7,
   "text": "هیچکس دیگه هم نداشت. برای اینکه خوب فروش کنم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 465.7,
   "end": 467.54,
   "text": "اومدم آبم قاطیش کردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 467.54,
   "end": 472.74,
   "text": "آب انداختم تنگش یا یه شربت‌های دیگه‌ای درست می‌کردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 472.74,
   "end": 477.84,
   "text": "رنگ آب لیمو داشت. حالا یه مقدار کمی هم از این آب لیمو شیرازی می‌ریختم توش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 477.84,
   "end": 479.44,
   "text": "دیگه مثل آب لیمو میشد دقیقاً.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 479.44,
   "end": 486.32,
   "text": "از این میدادم به مردم. به رفته رفته خیلی وضعم خوب شد و تا اینکه خونه و مال و منال و ماشین و فلان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 486.32,
   "end": 489.42,
   "text": "خیلی وضعم از این راه خوب شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 489.42,
   "end": 492.7,
   "text": "یه چند سالی گذشت و من دیگه گرم زندگی بودم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 492.7,
   "end": 495.1,
   "text": "این مریضی برای من اتفاق افتاد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 495.1,
   "end": 497.52,
   "text": "که هرچی اتفاق هر کاری کردم خوب نشد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 497.52,
   "end": 501.6,
   "text": "یواش یواش هرچی مال از این راه کسب کرده بودمو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 501.6,
   "end": 503.56,
   "text": "دادم رفت. حتی خونه‌مو فروختم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 503.56,
   "end": 506.72,
   "text": "مال و منال و باغ و ماشین و اتفاقه نکرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 506.72,
   "end": 511.76,
   "text": "همین چند تا تیکه مونده. این چند تا تیکه هم که مونده از همون پوله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 511.76,
   "end": 514.94,
   "text": "برای همین به پسرم گفتم اینم ببر که دیگه نمی‌خوام ببینمش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 514.94,
   "end": 517.68,
   "text": "بفروشش یا می‌میرم یا شفا می‌گیرم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 517.68,
   "end": 525.48,
   "text": "اینطوریه حالت نفس شاید یه چند صباحی باهاش جولان بده انسان تو دنیا اما آخر سرش جفتک میندازه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 525.48,
   "end": 529.62,
   "text": "آخر سرش مثل اون خر زهره چنان تلخ میکنه به کامت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 529.62,
   "end": 533.98,
   "text": "بهترینه که انسان خواهش نفسو سرکوب کنه و در حد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 533.98,
   "end": 539.36,
   "text": "کفافش در زندگی داشته باشه و بندگی خدا رو بکنه و خودش هم آرامش داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 539.36,
   "end": 543.92,
   "text": "انشاالله عاقبت هممون ختم به خیر بشه به ذکر صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 543.92,
   "end": 547.7,
   "text": "اللهم صل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 547.7,
   "end": 552.16,
   "text": "علی محمد و آل محمد و عجل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}