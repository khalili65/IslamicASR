   "title": "## شک میان دو و سه در نماز چهاررکعتی",
   "start": 12.16,
   "end": 97.98
  },
  {
   "index": 1,
   "title": "## قلب منحرف؛ مترادفات زیغ",
   "start": 97.98,
   "end": 118.4
  },
  {
   "index": 2,
   "title": "## عوامل انحراف قلب؛ ظلم در صدر",
   "start": 118.4,
   "end": 330.98
  },
  {
   "index": 3,
   "title": "## روایت موسی و چاه؛ عدالت پنهان",
   "start": 330.98,
   "end": 561.69
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.54,
   "end": 4.04,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 4.04,
   "end": 7.74,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 7.74,
   "end": 12.16,
   "text": "آیات. سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 12.16,
   "end": 18.82,
   "text": "بحث احکام ما رسیده بود به احکام مربوط به شکیات صحیح در نماز.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 18.82,
   "end": 21.36,
   "text": "گفتیم نه تا شک در نماز صحیح‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 21.36,
   "end": 24.64,
   "text": "البته همه در نمازهای چهار رکعتی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 24.64,
   "end": 27.1,
   "text": "اولیش شک بین دو و سه هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 27.1,
   "end": 30.6,
   "text": "اگر کسی در نماز چهار رکعتی شک کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 30.6,
   "end": 33.24,
   "text": "دو رکعت خونده یا سه رکعت خونده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 33.24,
   "end": 38.96,
   "text": "اینو یادمون باشه تا چهار اگر شک کنیم همیشه بنا رو میذاریم بر اون بیشتره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 38.96,
   "end": 41.4,
   "text": "بین دو، سه، چهار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 41.4,
   "end": 44.4,
   "text": "هروقت شک کردیم بنا رو روی اون بیشتره میذاریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 44.4,
   "end": 46.36,
   "text": "اگر از چهار گذشت دیگه نه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 46.36,
   "end": 49.38,
   "text": "بنا رو که نمی‌تونیم بیشتر از چهار بذاریم که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 49.38,
   "end": 52.48,
   "text": "از چهار گذشت اون که کمتره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 52.48,
   "end": 54.34,
   "text": "یا چهاره یا زیر چهاره میذاریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 54.34,
   "end": 57.86,
   "text": "حالا که بین دو و سه با این قاعده ما باید شک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 57.86,
   "end": 61.2,
   "text": "بذاریم بنا رو بر اون بیشتره یعنی سه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 61.2,
   "end": 64.66,
   "text": "خب اگر سه رکعت خوندیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 64.66,
   "end": 69.96,
   "text": "یعنی بنا رو گذاشتیم رو سه رکعت، نماز چهار رکعتیه دیگه باید یه رکعت دیگه بخونیم که بشه چهار رکعت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 69.96,
   "end": 75.18,
   "text": "پس یه رکعت دیگه نمازمو ادامه میدیم، سلام میدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 75.18,
   "end": 79.84,
   "text": "تموم که شد احتمال داره ما دو رکعت خونده بودیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 79.84,
   "end": 85.6,
   "text": "وقتی دو رکعت احتمالش هست خونده باشیم، یه رکعت هم که دوباره اضافه خوندیم میشه سه رکعت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 85.6,
   "end": 88.0,
   "text": "اینجا یه رکعت جاخالی داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 88.0,
   "end": 91.28,
   "text": "برای اون جای خالی نماز احتیاط گذاشتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 91.28,
   "end": 93.82,
   "text": "یه رکعت نماز احتیاط اینجا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 93.82,
   "end": 96.1,
   "text": "واجبه که انسان بخونه برای اون جای خالی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 96.1,
   "end": 99.28,
   "text": "به همین سادگی. اما در خصوص",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 99.28,
   "end": 102.8,
   "text": "قلب منحرف ما رسیده بودیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 102.8,
   "end": 108.6,
   "text": "به قلبی که دچار انحراف میشه و خیلی هم خطرش بزرگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 108.6,
   "end": 111.6,
   "text": "یه نکته‌ای رو امروز عرض کنم و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 111.6,
   "end": 117.22,
   "text": "تبرکاً روایتی رو. مفاهیمی که مترادف‌اند، مرادف‌اند با",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 117.22,
   "end": 120.78,
   "text": "زyg یا انحراف قلبی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 120.78,
   "end": 124.34,
   "text": "یعنی بوی همونو میدن. یکی ضلالت هست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 124.34,
   "end": 127.7,
   "text": "یکی غوایت هست با غین،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 127.7,
   "end": 130.6,
   "text": "یکی هم میل. اینها مرادف‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 130.6,
   "end": 134.34,
   "text": "یعنی میشه تشخیص داد که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 134.34,
   "end": 137.3,
   "text": "قلبی که دچار انحراف شده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 137.3,
   "end": 143.3,
   "text": "چگونه‌ست. یعنی اولا میلش عوض شده، میل دل عوض شده به سمت باطل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 143.3,
   "end": 145.98,
   "text": "یا غوایت یعنی گمراه شده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 145.98,
   "end": 151.92,
   "text": "یا اینکه ضلالت هم که باز همون گمراهی‌ست لکن حالا یه فرق کوچولویی با هم دارن که بعداً میگیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 151.92,
   "end": 153.68,
   "text": "اما مقابل زyg چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 153.68,
   "end": 155.82,
   "text": "مقابل گمراهی چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 155.82,
   "end": 159.36,
   "text": "یعنی نقطه مقابلش. یکی هدایت است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 159.36,
   "end": 162.86,
   "text": "فرمودن شارحین، یکی رشد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 162.86,
   "end": 168.52,
   "text": "دیگری قصد و آخرش هم ثبات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 168.52,
   "end": 170.86,
   "text": "پس هر قلبی که دوچه--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 170.86,
   "end": 173.26,
   "text": "رسیده باشه به ثبات،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 173.26,
   "end": 177.22,
   "text": "ثبات اعتقاد و رأی و اندیشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 177.22,
   "end": 180.18,
   "text": "این دیگه قلب منحرف نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 180.18,
   "end": 184.16,
   "text": "هر قلبی که هدایت شده باشه، قلب منحرف نمی‌تونه باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 184.16,
   "end": 188.9,
   "text": "هر قلبی که رشد پیدا کرده باشه یا قصد خدا کرده باشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 188.9,
   "end": 191.82,
   "text": "مثلاً حاجی بهش میگن قصد خدا کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 191.82,
   "end": 194.36,
   "text": "حج یعنی قصد کردم، قصد خدا کردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 194.36,
   "end": 196.78,
   "text": "این دیگه منحرف نمی‌تونه باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 196.78,
   "end": 201.32,
   "text": "پس اینها رو مخصوصا عرض کردم برای اینکه بهتر جا بیفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 201.32,
   "end": 205.44,
   "text": "اما اونچه که قبلاً هم عرض کردیم خیلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 205.44,
   "end": 212.86,
   "text": "عوامل از همه بیشتر باعث میشه که انسان به زyg بیفته، قلبش منحرف بشه رو هم بگیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 212.86,
   "end": 215.62,
   "text": "بعد حالا به مرور اینها رو توضیح بدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 215.62,
   "end": 217.78,
   "text": "اول از همه گفتن ظلم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 217.78,
   "end": 222.46,
   "text": "ظلم از هر چیزی زودتر قلب رو به انحراف می‌کشونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 222.46,
   "end": 224.64,
   "text": "یعنی اگر کسی می‌ترسه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 224.64,
   "end": 228.48,
   "text": "دچار انحراف قلبی بشه باید مراقب ظلم بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 228.48,
   "end": 230.98,
   "text": "این ظلم چه به خودش باشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 230.98,
   "end": 235.9,
   "text": "چه به جسمش، چه به روحش، چه به خونوادش، چه به اجتماع",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 235.9,
   "end": 238.8,
   "text": "و به دینش و خدایی نکرده به خدا و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 238.8,
   "end": 241.66,
   "text": "اینها. در هر حال باید مراقب ظلم باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 241.66,
   "end": 243.94,
   "text": "بعد فرمودن فسق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 243.94,
   "end": 245.62,
   "text": "حالا اینا رو بعداً باید توضیح بدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 245.62,
   "end": 251.44,
   "text": "بعد عصیان است یا عصیان، بعد تبعیت شیطان است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 251.44,
   "end": 254.16,
   "text": "و پیروی از شهوات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 254.16,
   "end": 257.0,
   "text": "اینها عوامل اصلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 257.0,
   "end": 261.78,
   "text": "انحراف قلبی‌ست. در خصوص ظلم سخن بسیار است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 261.78,
   "end": 264.48,
   "text": "تبرکاً فقط عرض کنم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 264.48,
   "end": 273.0,
   "text": "هرکس یکی از گناهان بزرگی که هرکس مرتکب اون بشه، خدا وعده کرده تو همین دنیا جزشو ببینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 273.0,
   "end": 276.78,
   "text": "بعضی از گناهان رو خدا می‌ندازه برای روز قیامت و حالا برزخ و قیامت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 276.78,
   "end": 280.54,
   "text": "اما بعضی گناهان هست خدا وعده کرده تو همین دنیا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 280.54,
   "end": 283.92,
   "text": "می‌بینه، می‌چشه و میره کیفرشو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 283.92,
   "end": 289.58,
   "text": "یکیش ظلمه. یعنی نمیشه کسی تو این دنیا ظلم بکنه بعد نبینه و بمیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 289.58,
   "end": 291.86,
   "text": "شاید خودش نفهمه از کجا داره می‌خوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 291.86,
   "end": 297.4,
   "text": "البته این به این معنا نیست که اگر کسی بلایی سرش اومد، اشکالی تو زندگی براش پیش اومد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 297.4,
   "end": 299.5,
   "text": "به کسی ظلم کرده داره تلافی اونو میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 299.5,
   "end": 303.86,
   "text": "ما نمی‌تونیم، در اون حد نیستیم اینو تشخیص بدیم چون بسیاری از بلاها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 303.86,
   "end": 306.46,
   "text": "رشده، تکفیر گناهانه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 306.46,
   "end": 308.3,
   "text": "نمی‌دونم تعالی درجه‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 308.3,
   "end": 312.78,
   "text": "اما اگر کسی ظلم کنه، مخصوصا اگر خدا دوسش داشته باشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 312.78,
   "end": 315.38,
   "text": "قطعاً تو همین دنیا می‌بینش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 315.38,
   "end": 316.72,
   "text": "مگر یه عده‌ای که دچار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 316.72,
   "end": 322.7,
   "text": "سنت املاء استدراج میشن دیگه انقدر ظلمشون گسترش پیدا می‌کنه که خدا اونا رو اصلاً می‌ندازه برای اون دنیا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 322.7,
   "end": 326.38,
   "text": "اونا دیگه استثناء که پدرشونو اونور دراره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 326.38,
   "end": 329.64,
   "text": "اما قاعده اینطوریه که این دنیا اگر کسی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 329.64,
   "end": 335.66,
   "text": "ظلم کرد جزشو ببینه. در کتاب سفینه بحار جلد دو صفحه دویست چهل و دو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 335.66,
   "end": 341.84,
   "text": "یه روایتی که اینو خیلی قشنگ توضیح داده آورده اینو بگیم ما تبرکاً والسلام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 341.84,
   "end": 347.16,
   "text": "از حضرت موسی علی النبیین و آله و علیه الصلاة والسلام روایت شده که ایشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 347.16,
   "end": 349.66,
   "text": "از یه جایی عبور می‌کردن رسیدن به یک چاه آبی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 349.66,
   "end": 354.88,
   "text": "بزرگانم قاعده‌شون این بوده وقتی می‌رسیدن به یک چیزی که طهارت داره، طهور است،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 354.88,
   "end": 359.5,
   "text": "آب اینا سریع وضو می‌گرفتن حتی اگر وضو داشتن و این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 359.5,
   "end": 362.0,
   "text": "عادت بزرگان بوده. حضرت موسی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 362.0,
   "end": 367.68,
   "text": "تا این چاه آبو دید خوشحال شد و وضو گرفت رفت بالای تپه‌ای که اونجا نماز بخونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 367.68,
   "end": 375.13,
   "text": "نگاه کرد دید یه اِاِاِ اسب سواری اومد اونجا با این آبه آبی سر صورتش زد و آب می‌خورد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 375.13,
   "end": 377.11,
   "text": "و بسته پولشو اونجا جا گذاشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 377.11,
   "end": 379.61,
   "text": "حالا یه همیان یا چیزی داشت که توش پر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 379.61,
   "end": 382.19,
   "text": "جواهر و سکه و هرچی بود اونجا جا گذاشت و رفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 382.19,
   "end": 385.37,
   "text": "حضرت موسی اون سمت نگاه می‌کرد که چه کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 385.37,
   "end": 386.89,
   "text": "این برمی‌گرده، برنمی‌گرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 386.89,
   "end": 390.69,
   "text": "دید یک چوپانی اومد بلافاصله از اونجا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 390.69,
   "end": 393.91,
   "text": "داشت رد میشد. نگاهش افتاد به این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 393.91,
   "end": 395.87,
   "text": "همیان و توش هم پر پول.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 395.87,
   "end": 400.47,
   "text": "خلاصه برداشت و آدمی که اعتقاد نداشته باشه اینه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 400.47,
   "end": 403.53,
   "text": "حالا شایدم انشاالله که ما میگیم دنبال صاحبش می‌گشته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 403.53,
   "end": 406.01,
   "text": "برداشته ببره دنبال صاحبش بگرده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 406.01,
   "end": 411.21,
   "text": ". برداشت و رفت. بلافاصله بعد از اون یه پیرمرد ضعیف،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 411.21,
   "end": 414.57,
   "text": "فقیر، مستضعف، هیزم کشی اومد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 414.57,
   "end": 417.43,
   "text": "از خستگی کنار این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 417.43,
   "end": 422.13,
   "text": "چاه آبی، آب هم زد سر صورتش و شنا-- کنار این چاه آب خوابش رفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 422.13,
   "end": 424.71,
   "text": "بلافاصله حالا حضرت موسی اون بالا داره نگاه می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 424.71,
   "end": 427.55,
   "text": "بلافاصله اون اسب سواره برگشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 427.55,
   "end": 429.21,
   "text": "تا برگشت نگاه کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 429.21,
   "end": 432.43,
   "text": "این ور اون ور دید همیان پر از پولش نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 432.43,
   "end": 438.53,
   "text": "این پیرمرد رو بیدار کرد و باهاش گفت و گو کرد که تو ندیدی گفت نه من ندیدم و بحثشون شد و اونم از،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 438.53,
   "end": 444.17,
   "text": "از عصبیت گمان می‌کرد این پیرمرد برداشته داره حاشا می‌کنه زد پیرمرد رو کشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 444.17,
   "end": 446.33,
   "text": "کشت و رفت. حضرت موسی موند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 446.33,
   "end": 448.87,
   "text": "این جریان چیه؟ اون پولو چوپانه برداشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 448.87,
   "end": 451.97,
   "text": "این پیرمرد فقیر بیچاره کشته شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 451.97,
   "end": 455.15,
   "text": "اینجا بحث عدالت خدا چی میشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 455.15,
   "end": 458.27,
   "text": "این ظلمی که اینا مرتکب شدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 458.27,
   "end": 461.05,
   "text": "از خدا سؤال کرد. خوش به حالش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 461.05,
   "end": 463.41,
   "text": "تا سؤال می‌کرد جواب می‌گرفت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 463.41,
   "end": 466.87,
   "text": ". خدا فرمود موسی عزیز من",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 466.87,
   "end": 469.79,
   "text": "بشین تا برات به قول ما بگیم چی بوده جریان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 469.79,
   "end": 473.11,
   "text": "جریان اینه که ما همه حکم فرماییم بر اساس عدالته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 473.11,
   "end": 476.15,
   "text": "هرکس ظلم کنه سریع به خودش میرسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 476.15,
   "end": 478.67,
   "text": "اون چوپونه از این،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 478.67,
   "end": 486.35,
   "text": "از پدر، پدر این چوپونه از پدر این اسب سواره همون مقداری که پول تو این همیان بود طلب داشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 486.35,
   "end": 489.61,
   "text": "یه بار دیگه میگم اون چوپونه که پولو برداشت رفت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 489.61,
   "end": 494.83,
   "text": "پدرش از پدر این اسب سواره که پولشو جا گذاشته بود خدا داره به حضرت موسی میگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 494.83,
   "end": 496.99,
   "text": "همون مقدار طلب داشت و این نداده بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 496.99,
   "end": 500.09,
   "text": "مونده بود گردنش. ما صافش کردیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 500.09,
   "end": 503.71,
   "text": "که چی؟ این پول به حقدار برسه، حق به حقدار برسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 503.71,
   "end": 510.85,
   "text": "اما قصه اون که زد کشتی، این پیرمرد یه زمانی زده بود پدر این اسب سواره رو کشته بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 510.85,
   "end": 514.25,
   "text": "اینا خبر نداشتن. دست به یقه شدن و زد کشتش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 514.25,
   "end": 517.11,
   "text": "اینا هم تلاوشونو پس دادن تموم شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 517.11,
   "end": 521.71,
   "text": "حالا شاید بشه گفت خدا اینا رو هم دوست داشته تو همین دنیا صاف کرد رفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 521.71,
   "end": 528.05,
   "text": "اما این مهمه که بدونیم ظلم قطعا توی این دنیا جوابش انسان می‌گیره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 528.05,
   "end": 531.75,
   "text": "و این ظلم گفتن نقطه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 531.75,
   "end": 536.69,
   "text": "خدایی نکرده انشاالله برای هیچکس پیش نیاد، افتادن تو مسیر انحرافه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 536.69,
   "end": 540.89,
   "text": "یعنی قلب کسی که ظلم کنه قطعا میره به سمت انحراف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 540.89,
   "end": 549.13,
   "text": "از پله پله خطوات شیطان یعنی قدم به قدم، قدم به قدم هم انسان یواش یواش میره به سمت اونجایی که ناکجا آباده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 549.13,
   "end": 551.35,
   "text": "یه دفعه نمیره. انشاالله عاقبتمون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 551.35,
   "end": 559.49,
   "text": "خیر باشه به ذکر صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 559.49,
   "end": 561.69,
   "text": "اللهم صل علی محمد و آل محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}