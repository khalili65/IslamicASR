 },
 "chapters": [
  {
   "index": 0,
   "title": "## استفتاء؛ روزهٔ واجب و اجبار به خوردن",
   "start": 0.64,
   "end": 402.2
  },
  {
   "index": 1,
   "title": "## مراقبه؛ ظرف پاره نباشد",
   "start": 402.2,
   "end": 472.8
  },
  {
   "index": 2,
   "title": "## سه کتاب از علمای سلف",
   "start": 472.8,
   "end": 580.76
  },
  {
   "index": 3,
   "title": "## ناپاکی عرضی است نه ذاتی",
   "start": 580.76,
   "end": 626.74
  },
  {
   "index": 4,
   "title": "## خروجی رمضان و خطر تأثیم",
   "start": 626.74,
   "end": 761.11
  },
  {
   "index": 5,
   "title": "## حکایت اقتدا و سوءظن چندساله",
   "start": 761.11,
   "end": 900.55
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.64,
   "end": 7.54,
   "text": "و بهین استعین. السلام علیک یا داعی الله و ربانی آیات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 7.54,
   "end": 10.06,
   "text": "آقا دانش اینو بکش و به زحمت قطع کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 10.06,
   "end": 16.06,
   "text": "ببخشید. استفتائا شد برای رهبر عزیزمون که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 16.06,
   "end": 19.74,
   "text": "خب بعضی از بچه‌ها هستن که توان روزه ندارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 19.74,
   "end": 22.96,
   "text": "خب وظیفه شون اینه که روزه رو بگیرن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 22.96,
   "end": 25.5,
   "text": "و اگر می‌تونن ادامه بدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 25.5,
   "end": 31.92,
   "text": "اما اونجاهایی که دیگه به مشقت میفتن و روزه حرجی می‌شه قبلاً بحثش شد که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 31.92,
   "end": 35.94,
   "text": "باید تا اونجا که توان دارن ادامه بدن بعد بخورن بعداً غذاشو بگیرن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 35.94,
   "end": 39.5,
   "text": "حالا یه بچه‌ای هستش که توانشو داره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 39.5,
   "end": 41.92,
   "text": "می‌خواد بگیره، پدر مادر نمی‌ذارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 41.92,
   "end": 46.12,
   "text": "می‌گه بابا، مادر، پدر من می‌تونم توانشم دارم به منم واجبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 46.12,
   "end": 48.76,
   "text": "پدر مادر دلسوزی بی‌مورد می‌کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 48.76,
   "end": 51.6,
   "text": "به زور غذا می‌ریزن تو دهن بچه، آب می‌ریزن تو دهن بچه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 51.6,
   "end": 55.14,
   "text": "نمی‌ذارن. روزه مستحبی فرق می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 55.14,
   "end": 60.08,
   "text": "روزه مستحبی بدون اذن پدر و مادر نمی‌شه روزه بگیره بچه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 60.08,
   "end": 63.76,
   "text": "اما در روزه واجب دیگه حالا به سن تکلیف رسیده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 63.76,
   "end": 66.98,
   "text": "اینجا سؤال شده که آقا تکلیف این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 66.98,
   "end": 71.14,
   "text": "بچه‌ای که حالا به زور یا اصلاً آدم بزرگیه و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 71.14,
   "end": 74.64,
   "text": "مثلاً توی شرکتی کار می‌کنه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 74.64,
   "end": 79.74,
   "text": "آدم‌هاش خیلی علیه السلام نیستن به زور غذا می‌ریزن تو دهنش چی می‌شه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 79.74,
   "end": 82.98,
   "text": "هست پیش میاد. آقا فرمودن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 82.98,
   "end": 91.56,
   "text": "همین که دیگری به زور غذا بریزه دهن شما چون به زور ریخته دلیل نمی‌شه که شما روزت باطل نشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 91.56,
   "end": 96.04,
   "text": "چون خوردن و آشامیدن همین که وارد دهان و حلق شد تمام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 96.04,
   "end": 101.28,
   "text": "ولو به زور کسی به گ-گلوی تو غذا بریزه، ولو پدر مادر بریزه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 101.28,
   "end": 104.26,
   "text": "روزت اون لحظه باطل می‌شه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 104.26,
   "end": 107.94,
   "text": "و باید بعداً غذاشو بگیری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 107.94,
   "end": 112.44,
   "text": "ما ان شا الله یکی دو جلسه دیگه اگه خدا توفیق بده پیرامون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 112.44,
   "end": 116.76,
   "text": "قلب آثِم و معنای اِثم در قرآن حرف بزنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 116.76,
   "end": 121.68,
   "text": "دیگه سفره این نوع از قلب رو هم جمع می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 121.68,
   "end": 124.38,
   "text": "اِثم بر base",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 124.38,
   "end": 129.32,
   "text": "سه نقطه قبلاً عرض شد که حالا بهش فعل حرام می‌گن دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 129.32,
   "end": 133.06,
   "text": "گناه، فعل حرام که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 133.06,
   "end": 141.64,
   "text": "چهل با مشتقاتش چهل و هشت بار تو قرآن اومده مثل مثلاً \"إن بعض بن إثم\" رو هم راهروی شما نوشته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 141.64,
   "end": 145.74,
   "text": "\"إن بعض بن إثم\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 145.74,
   "end": 150.56,
   "text": "که حالا ما چون بحثمون قلب آثِم هست یعنی قلبی که این گناه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 150.56,
   "end": 155.24,
   "text": "درونش رسوخ کرده که با اصرار بر گناه پیش میاد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 155.24,
   "end": 158.76,
   "text": "باید خیلی حواسمون در اصرار به گناهان باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 158.76,
   "end": 164.3,
   "text": "اما اونچه که مهمه است این هستش که سرمایه ماه مبارک رمضان رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 164.3,
   "end": 169.12,
   "text": "مراقب باشیم که همون تقوا و ورع هست اون رو نگه داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 169.12,
   "end": 174.68,
   "text": "قبلاً بحث شد که ما در برزخ هم سیر استکمالی داریم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 174.68,
   "end": 179.68,
   "text": "بر اساس شفاعت آل الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 179.68,
   "end": 184.46,
   "text": "و هم سنخی و هم جنسی با اون‌ها گر در اون ذات و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 184.46,
   "end": 190.76,
   "text": "سرشت و استعداد وجودیمون اگر حفظش کنیم با دوری از گناه، اون‌ها میان ما رو سیر میدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 190.76,
   "end": 194.66,
   "text": "اگرچه اونجا حرکت خیلی کندتر از دنیا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 194.66,
   "end": 196.82,
   "text": "هست و خیلی دشوارتر و سخت‌تره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 196.82,
   "end": 199.54,
   "text": "اما بالاخره سیر برزخی هست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 199.54,
   "end": 202.42,
   "text": "که قبلاً بحث شده. اگر کسی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 202.42,
   "end": 205.22,
   "text": "بزنه با اِثم با گناه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 205.22,
   "end": 210.28,
   "text": "استعدادش رو از بین ببره، محروم می‌شه از سیر برزخی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 210.28,
   "end": 215.66,
   "text": "و اگر کسی سؤال کنه که آقا مگر نداریم که \"و إنّا إلیه راجعون\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 215.66,
   "end": 218.2,
   "text": "انا لله دیگه خب تو قوس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 218.2,
   "end": 224.24,
   "text": "صعود هم ما داریم میریم به سمت او یا و این همه قرآن میگه \"و إلي المسیر\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 224.24,
   "end": 231.02,
   "text": "راه شما به سمت منه یا به هر طرف رو کنید \"ففما وجه الله\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 231.02,
   "end": 236.1,
   "text": "به سمت خدا رو کردید. پس این بالاخره گناهکار که داره میره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 236.1,
   "end": 237.7,
   "text": "آیا این هم به سمت خدا میره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 237.7,
   "end": 239.64,
   "text": "می‌گیم بله، همه به سمت خدا میرن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 239.64,
   "end": 242.16,
   "text": "اما به سمت چه اسمی از اسامی خدا میره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 242.16,
   "end": 246.02,
   "text": "این مهمه. و الا جهنمی هم به سمت خدا میره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 246.02,
   "end": 248.4,
   "text": "اونم میره به سمت اسماء حضرت حق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 248.4,
   "end": 251.3,
   "text": "همه در حال حرکت به سمت حضرت حق‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 251.3,
   "end": 258.9,
   "text": "منتها کسی که دچار قلب آثِمه به سمت اسماء جلالیه از نوع فعلیه حضرت حق میره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 258.9,
   "end": 263.08,
   "text": "این خیلی خطرناکه. یه آیه تو قرآن داریم خیلی عجیبه این آیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 263.08,
   "end": 266.14,
   "text": "دیشب من دیدی گاهی اوقات یه عمر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 266.14,
   "end": 270.04,
   "text": "یه آیه رو می‌خونی، یه دفعه برقش یه روزی می‌گیردت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 270.04,
   "end": 274.04,
   "text": "عجب! من تا دیشب توجه نکردم که \"أن الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 274.04,
   "end": 280.6,
   "text": "شديد العقاب\" تو همون آیه و \"أن الله غفور رحیم\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 280.6,
   "end": 284.5,
   "text": "حالا برای استخاره اگه این آیه بیاد چه باید کرد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 284.5,
   "end": 288.04,
   "text": "هم خدا رو شدید العقاب معرفی کرده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 288.04,
   "end": 293.36,
   "text": "عین هم به همون عبارت و هم غفور و رحیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 293.36,
   "end": 298.96,
   "text": "خیلی عجیبه. این نشون میده که اهل جهنم میرن به سمت اسم شدید العقاب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 298.96,
   "end": 303.7,
   "text": "بهشتیان میرن به سمت اسم غفور و رحیم حضرت حق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 303.7,
   "end": 306.84,
   "text": "ش-- غفور و رحیم اسم ذاتی حضرت حقه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 306.84,
   "end": 311.28,
   "text": "ذاتشه. خب؟ اما شدید العقاب که اسم ذاتی نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 311.28,
   "end": 314.2,
   "text": "خدا ذاتش اصلاً شدید العقاب نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 314.2,
   "end": 318.36,
   "text": "ذاتش یکپارچه رحمت و مهربانی و لطفه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 318.36,
   "end": 319.98,
   "text": "پس چطور شدید العقاب شد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 319.98,
   "end": 321.52,
   "text": "چطور انتقام شد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 321.52,
   "end": 325.1,
   "text": "دارای انتقام شد؟ چطور قهار شد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 325.1,
   "end": 329.58,
   "text": "شیکنده شد؟ بر اساس فعل من و شما، خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 329.58,
   "end": 333.1,
   "text": "لذا بهش میگن اسماء فعلیه حضرت حق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 333.1,
   "end": 335.86,
   "text": "بر اساس فعل من و شما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 335.86,
   "end": 338.26,
   "text": "خدا این چنین رفتار می‌کند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 338.26,
   "end": 341.4,
   "text": "یعنی فعلش این چنین می‌شه. پس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 341.4,
   "end": 345.12,
   "text": "کسی هم که دچار اِثمه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 345.12,
   "end": 348.3,
   "text": "به سمت اسماء فعلیه حضرت حق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 348.3,
   "end": 351.68,
   "text": "از نوع جلالیه‌ش حرکت می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 351.68,
   "end": 354.14,
   "text": "خب کسی جیگر داره حالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 354.14,
   "end": 355.82,
   "text": "د-دنیا رو نگاه نکن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 355.82,
   "end": 358.4,
   "text": "هرکی برای خودش اردی میده و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 358.4,
   "end": 361.86,
   "text": "گمان می‌کنه که خبریه و مثلاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 361.86,
   "end": 370.3,
   "text": "منصبی داره و مال و منالی داره و ورودی‌هایی داره و بذار دماغش به خاک کشیده بشه وقت مرگ.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 370.3,
   "end": 374.66,
   "text": "همه هم الحمدلله على كل نعمة این حالتو درک می‌کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 374.66,
   "end": 377.46,
   "text": "خیلی خوشحالم. من هر وقت که بحث‌های",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 377.46,
   "end": 384.46,
   "text": "عمیق دینی با کسی می‌کنم و طرف لجاجت می‌کنه یا بر گناهش اصرار می‌کنه، تمسخر در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 384.46,
   "end": 389.98,
   "text": "مقدسات و این‌ها داره ج-- آخرین جوابی که بهش میدم میگم وقت مرگ می‌بینمت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 389.98,
   "end": 393.76,
   "text": "ببینم اون موقع چجوری دست و پا می‌زنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 393.76,
   "end": 396.8,
   "text": "که خیلی باید مراقب بود. به هر حال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 396.8,
   "end": 399.86,
   "text": "این سرمایه ماه مبارک رمضونمونو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 399.86,
   "end": 404.84,
   "text": "حفظش کنیم دیگه. حفظش مهمه که از آقای بهجت پرسیدن شما چه کردی به اینجا رسیدی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 404.84,
   "end": 409.12,
   "text": "یادش به خیر ما قم زیاد آویزون ایشون می‌شدیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 409.12,
   "end": 411.72,
   "text": "و ایشون هم اینو زیاد می‌گفتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 411.72,
   "end": 415.28,
   "text": "فکر می‌کنم در آثار ایشونم در یه کتابی دیدم بود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 415.28,
   "end": 419.08,
   "text": "که شما چه کردی به این رتبه و این معنویت و نورانیت؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 419.08,
   "end": 423.06,
   "text": "ایشون از لسان استادش،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 423.06,
   "end": 428.02,
   "text": "از لسان استاد استادش، یعنی از، از خودش هم مایه نگذاشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 428.02,
   "end": 433.18,
   "text": "فرمود استاد استاد ما به ما فرمودن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 433.18,
   "end": 437.78,
   "text": "اگر من به این مقام و رتبه رسیدم به جهت اینکه توبرم پاره نبود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 437.78,
   "end": 441.6,
   "text": "یعنی هرچی که جمع می‌کردم سوراخ نبود که بریزه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 441.6,
   "end": 446.24,
   "text": "هی-- اینا نوره دیگه، نماز نوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 446.24,
   "end": 448.3,
   "text": "روزه رو نوره، ذکر نوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 448.3,
   "end": 451.22,
   "text": "هی نور على نور می‌شه نور على نور.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 451.22,
   "end": 455.38,
   "text": "هی اینطوری به این شدت معنویت و شدت وجودی می‌رسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 455.38,
   "end": 461.2,
   "text": "و الا قرار باشه توب انسان پاره باشه این همه زحمت بکش، تلاش کن، توفیق پیدا کن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 461.2,
   "end": 463.26,
   "text": "شبای قدر فلان بعد یه دفعه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 463.26,
   "end": 467.26,
   "text": "بعد عید فطر تمام. برای همین اصل مراقبه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 467.26,
   "end": 470.54,
   "text": "اصل، یعنی تمام بزرگان رو مراقبه تاکید کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 470.54,
   "end": 474.98,
   "text": "یه کتابی داره خدا رحمت کنه سید ابن طاووس رو که به قول",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 474.98,
   "end": 477.8,
   "text": "حضرت علامه طباطبایی علیه الرحمه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 477.8,
   "end": 484.52,
   "text": "جزو علمای سلف امامیه است که ایشان سید بحر العلوم صاحب، صاحب کتاب شریف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 484.52,
   "end": 487.26,
   "text": "لب اللباب در سیر و سلوک رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 487.26,
   "end": 491.6,
   "text": "و ابن فهد حلی، استاد علامه حلی رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 491.6,
   "end": 494.16,
   "text": "که کتاب شریف عُدَّة الداعی داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 494.16,
   "end": 496.6,
   "text": "اینا دارم میگم برای اینکه برید سراغ این کتابا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 496.6,
   "end": 500.42,
   "text": "خیلی این کتابا شریف و به دردبخور و ارشی‌ان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 500.42,
   "end": 504.64,
   "text": "عُدَّة الداعی اتفاقا از سفارش‌های حضرت علامه حسن زاده هم هست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 504.64,
   "end": 508.5,
   "text": "در خواندن این کتاب. مال ابن فهد حلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 508.5,
   "end": 510.84,
   "text": "و همچنین کتاب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 510.84,
   "end": 512.98,
   "text": "عذر شود سید ابن طاووس،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 512.98,
   "end": 516.0,
   "text": "صاحب همین لهوفی که آقا فرمودن بخونید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 516.0,
   "end": 519.86,
   "text": "این‌ها این سه تا رو علامه طباطبایی جز بزرگان می‌شمردن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 519.86,
   "end": 525.68,
   "text": "که در شب قدر عزیزانی که اون فایلی که تو مرام گمنامی بارگذاری شد ما اونجا بحث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 525.68,
   "end": 529.8,
   "text": "ليلة القدر وجودی رو داشتیم، اونجا عرض کردیم شب بیست و سوم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 529.8,
   "end": 536.28,
   "text": "که اونجا تو کتاب اقبالش سید ابن طاووس می‌فرماید که شب قدر شده حالت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 536.28,
   "end": 542.58,
   "text": "اس-استجابت دعا به دست داد و تقرب شدیدی به خدا و یه حال خاصی برای شما پیش میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 542.58,
   "end": 545.46,
   "text": "چی بخوام از خدا؟ استجابت قطعیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 545.46,
   "end": 548.02,
   "text": "عجیبه این حرف. فرمودن من",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 548.02,
   "end": 551.18,
   "text": "غیرتم قبول نمی‌کنه عرض کردم به خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 551.18,
   "end": 555.18,
   "text": "خدایا غیرت من قبول نمی‌کنه مردم گناه می‌کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 555.18,
   "end": 558.1,
   "text": "به غیرت من بر می‌خوره در محضر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 558.1,
   "end": 560.48,
   "text": "حضور تو گناه می‌کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 560.48,
   "end": 562.72,
   "text": "امشب از تو می‌خوام خدایا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 562.72,
   "end": 565.78,
   "text": "مردم گناه نکنن. الله اکبر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 565.78,
   "end": 569.52,
   "text": "که به قول حضرت علامه حسن زاده نظام عالم نظام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 569.52,
   "end": 572.82,
   "text": "احسن طهارت است بر اساس طهارت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 572.82,
   "end": 577.02,
   "text": "ذاتیه همه چی ظهور و بروز حضرت حق است دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 577.02,
   "end": 580.76,
   "text": "همه چی پاکه، پاکه، پاک آفریده شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 580.76,
   "end": 583.92,
   "text": "اگر ناپاکیم هست ع Rضه ذاتی نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 583.92,
   "end": 587.22,
   "text": "حتی توی حیوانات مثل سگ و خوک که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 587.22,
   "end": 590.9,
   "text": "مثلاً شرعاً نجسن قبلاً عرض شد این‌هام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 590.9,
   "end": 595.24,
   "text": "تو نشئه طبیعت بنا به بعضی مصالح و مفاسد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 595.24,
   "end": 597.4,
   "text": "نشئه دنیایی ما،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 597.4,
   "end": 602.4,
   "text": "این‌ها نجس فرض شدن نه اینکه ذاتاً نجس باشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 602.4,
   "end": 608.1,
   "text": "یعنی شما اگر بری تو عالم برزخ مثلاً خواب، خواب که قبلاً بحث شد دیگه اینو که با گوشتون آشناست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 608.1,
   "end": 610.08,
   "text": "خواب عالم برزخ وجودته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 610.08,
   "end": 616.4,
   "text": "وقتی رفتی تو خواب مثلاً یه سگی رو خیس باشه بغلش کنی، یه خوک خیس باشه تو خواب بغلش کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 616.4,
   "end": 618.76,
   "text": "بیدار شدی باید بری خودتو آب بکشی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 618.76,
   "end": 623.14,
   "text": "نه. نجس نیست که اونجا. مثلاً اونجا معنیش فرق می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 623.14,
   "end": 626.02,
   "text": "معنای اون قصه فرق می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 626.02,
   "end": 628.32,
   "text": "ولی اینجا نه. پس اصلاً تمام ک--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 628.32,
   "end": 631.02,
   "text": "کی تا حالا دیده که یه درخت بی‌طهارتی کنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 631.02,
   "end": 634.38,
   "text": "یه حیوان بی‌طهارت کنه؟ یه جماد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 634.38,
   "end": 637.68,
   "text": "کوه، زمین، آسمان بی‌طهارت کنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 637.68,
   "end": 641.46,
   "text": "کی تا حالا دیده نظام احسن حضرت حق بی‌طهارت کنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 641.46,
   "end": 644.08,
   "text": "فقط یه انسان دوپاست که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 644.08,
   "end": 650.9,
   "text": "اونم از این کرات بی‌نهایت که نشئه ملک خودش بی‌نهایت است چون اثر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 650.9,
   "end": 654.96,
   "text": "مؤثر است که لا مؤثر في الوجود إلا الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 654.96,
   "end": 660.08,
   "text": "خب پس این نشئه ملک هم که به منزله بدن نفس کلیه الهی است،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 660.08,
   "end": 664.38,
   "text": "این هم پاک پاکه و این هم بی‌نهایت است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 664.38,
   "end": 666.64,
   "text": "خب اینم ظهور و بروز از ذات داشته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 666.64,
   "end": 674.88,
   "text": "همین نشئه ملک. یه انسان دوپاست تو همین کره زمینی که اصلاً قابل قیاس با کرات نیست با این منظومه شمسی و با",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 674.88,
   "end": 679.0,
   "text": "عذر شود کهکشان راه شیری و ش-ستاره شعرا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 679.0,
   "end": 684.62,
   "text": "شعراء یمانی و خود خورشید صد و پنجاه میلیون کیلومتر با زمین فاصله داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 684.62,
   "end": 688.14,
   "text": "چهارده تن در ثانیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 688.14,
   "end": 690.4,
   "text": "داره انرژی تولید می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 690.4,
   "end": 695.44,
   "text": "این فاصله سیصد و بیست و هشت هزار و هشتصد برابر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 695.44,
   "end": 697.5,
   "text": "زمین اندازشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 697.5,
   "end": 702.34,
   "text": "این تازه بعد می‌بینه خورشید در برابر ستاره شعراء یمانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 702.34,
   "end": 705.58,
   "text": "مثل یک ارزن، بزرگان فرمودن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 705.58,
   "end": 708.68,
   "text": "اهل نجوم، مثل یک ارزن در برابر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 708.68,
   "end": 711.44,
   "text": "کوه دماوند ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 711.44,
   "end": 716.22,
   "text": "حالا شما اصلاً اینا با قابل قیاس با هم-- اصلاً تو همین کره زمین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 716.22,
   "end": 721.78,
   "text": "کوچولویی که اصلاً قابل قیاس با نظام خلقت نیست، چهار تا آدمم، یه چند تا آدمم دارن چیکار می‌کنن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 721.78,
   "end": 725.18,
   "text": "یه خطاهایی می‌کنن که اینا هم عرضه ذات نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 725.18,
   "end": 729.32,
   "text": "یعنی با خودشون دارن لطفه می‌زنن، نه به نظام احسن طبیعت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 729.32,
   "end": 739.69,
   "text": "نه به-- اینه که پس مهم اینه که مراقبت کنیم خروجی ما از ماه مبارک رمضان به امید حضرت حق عزیزان دلم طهارت باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 739.69,
   "end": 741.65,
   "text": "اگر می‌خوایم به سمت بهشت بریم دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 741.65,
   "end": 743.91,
   "text": "امروز می‌دیدم این آیه قرآن رو بگم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 743.91,
   "end": 746.41,
   "text": "کامتون با این آیه هم شیرین بشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 746.41,
   "end": 748.81,
   "text": "و دیگه بسه امروز. لا یس-- چقدر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 748.81,
   "end": 753.87,
   "text": "زیباست. \"لا یسمعون فیها لغوا ولا تعثیما\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 753.87,
   "end": 756.59,
   "text": "از اسم میاد. اهل بهشت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 756.59,
   "end": 761.11,
   "text": "نه لغو میگن نه تعثیم یعنی تهمت زدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 761.11,
   "end": 763.21,
   "text": "کسی رو متهم به اثم کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 763.21,
   "end": 765.53,
   "text": "میگه \"إن بعضهن لأثم\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 765.53,
   "end": 769.47,
   "text": "بعضی از زن‌ها اثمه که چقدر ما گرفتارشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 769.47,
   "end": 773.37,
   "text": "می‌خوای بهشتی باشی؟ میگه نباید کسی رو متهم به گناه کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 773.37,
   "end": 777.51,
   "text": "چرا-- جالبه که تو همین اداره ما ثبت شده تو راهرو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 777.51,
   "end": 781.75,
   "text": "بعد بازم آدم از خیلیا می‌بینه به راحتی قضاوت می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 781.75,
   "end": 791.99,
   "text": "به راحتی و خدا نکنه یه دفتر، قلمی و میز و کتابتی و مدیریتی هم دستش باشه دیگه راحت زیر دستشو له می‌کنه، له.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 791.99,
   "end": 794.79,
   "text": "چرا امروز مثلاً سلام منو درست جواب ندادی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 794.79,
   "end": 799.41,
   "text": "حالا بیا و درستش کن. چنان پرونده‌سازی کنه اینا می‌بینید کجا در میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 799.41,
   "end": 803.31,
   "text": "طرف تسبیح هم دستشه مسجد هم میره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 803.31,
   "end": 806.45,
   "text": "خیلی باید مراقب بود. خیلی یک ماه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 806.45,
   "end": 809.65,
   "text": "جون بکنی بعد به راحتی بدی بره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 809.65,
   "end": 815.61,
   "text": "یه طرف می‌گفت رفتم یه عم پیش نمازی بود بهش اقتدا می‌کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 815.61,
   "end": 818.45,
   "text": "بعد رفتیم دیدم یه روز رفت مستراح،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 818.45,
   "end": 820.73,
   "text": "بیت الخلاء، حالا هرچی بخواید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 820.73,
   "end": 824.05,
   "text": "اسمشو بذار. دورت المیاه هرچی میگی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 824.05,
   "end": 831.47,
   "text": "رفتم دیدم رفت داخل و اومد بیرون وضو نگرفت رفت تو محراب عبادت، عبادت مسجد و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 831.47,
   "end": 835.45,
   "text": "دیگه من بهش اقتدا نکردم. گفتم عجب آدم فلان، فلان شده‌ایه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 835.45,
   "end": 837.93,
   "text": "یک عمرو گذاشته سر کار بدون وضو میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 837.93,
   "end": 843.35,
   "text": "ببین با یک مثلاً با یک اتفاق که نرفت ته و توشو دربیاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 843.35,
   "end": 846.01,
   "text": "ول کرد رفت. دیگه به این آقا اقتدا نکرد، رفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 846.01,
   "end": 849.91,
   "text": "تا چند سال گذشت. یه روزی خودش رفت آمپول زد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 214,
   "start": 849.91,
   "end": 852.69,
   "text": "وضو گرفته بود. گفت حالا مسجد گفت برم آمپولمم بزنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 215,
   "start": 852.69,
   "end": 855.71,
   "text": "آمپول زد. رفت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 216,
   "start": 855.71,
   "end": 861.43,
   "text": "رسید به مسجد. رفت تو دستشویی مسجد جای آمپولو شست که اون اگه نجس شده بره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 217,
   "start": 861.43,
   "end": 863.31,
   "text": "بعد اومد بیرون وضو داشت دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 218,
   "start": 863.31,
   "end": 865.55,
   "text": "رفت نماز بخونه. یاد اون اتفاق افتاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 219,
   "start": 865.55,
   "end": 868.15,
   "text": "گفت اِ! من امروز همین‌طوری شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 220,
   "start": 868.15,
   "end": 872.51,
   "text": "رفتم تو دستشویی اومدم بیرون بدون وضو چون قبلاً وضو داشتم دارم میرم نماز بخونم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 221,
   "start": 872.51,
   "end": 875.69,
   "text": "نکنه قصه این بوده رفت پیدا کرد حاج آقا رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 222,
   "start": 875.69,
   "end": 879.55,
   "text": "بهش گفت حاج آقا این‌طوری. گفت بله اتفاقاً اون روز منم آمپول زده بودم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 223,
   "start": 879.55,
   "end": 882.47,
   "text": "این‌طوری شده بود. گفت منو ببخشید من یه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 224,
   "start": 882.47,
   "end": 886.07,
   "text": "چندین سال تو ذهن، ذهن خودم اثم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 225,
   "start": 886.07,
   "end": 892.09,
   "text": "گناه به شما نسبت دادم. ببین چقدر راحت بهشتو می‌فروشیم به جهنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 226,
   "start": 892.09,
   "end": 894.71,
   "text": "خدا انشاالله عاقبت همونو خیر بکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 227,
   "start": 894.71,
   "end": 900.55,
   "text": "به برکت صلوات بر محمد و آل محمد. اللهم صل على محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}