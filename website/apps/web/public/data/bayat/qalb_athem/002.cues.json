 "chapters": [
  {
   "index": 0,
   "title": "## حکم فقهیِ روزِ تردید میان شعبان و رمضان",
   "start": 0.26,
   "end": 182.7
  },
  {
   "index": 1,
   "title": "باید درون آن‌ها را بر اساس حکمت دید. پیامبر فرمود:",
   "start": 182.7,
   "end": 322.12
  },
  {
   "index": 2,
   "title": "## خطبهٔ شعبانیه؛ ایها الناس و اقبل و شهر الله",
   "start": 322.12,
   "end": 351.9
  },
  {
   "index": 3,
   "title": "## شهر الله؛ جامع اسماء",
   "start": 351.9,
   "end": 391.04
  },
  {
   "index": 4,
   "title": "## برکت و رحمت و مغفرت؛ سه شاخه",
   "start": 391.04,
   "end": 424.62
  },
  {
   "index": 5,
   "title": "برای جمع بحث به آیهٔ پانزده سورهٔ فاطر رجوع شود:",
   "start": 424.62,
   "end": 580.0
  },
  {
   "index": 6,
   "title": "## بازگشت به خطبه؛ ضیافت الله",
   "start": 580.0,
   "end": 879.7
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.26,
   "end": 6.08,
   "text": "[سخنگوی 1] و بهک نستهین. السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 6.08,
   "end": 8.9,
   "text": "آیات. السلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 8.9,
   "end": 12.94,
   "text": "[سخنگوی 1] می‌دانید که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 12.94,
   "end": 16.5,
   "text": "آخرین روز ماه شعبان رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 16.5,
   "end": 20.12,
   "text": "شما نمی‌تونید اگر شک دارید که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 20.12,
   "end": 24.64,
   "text": "روز آخر ماه شعبان است یا اول رمضان نمی‌تونید به نیت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 24.64,
   "end": 28.86,
   "text": "اول ماه شعبان، ماه رمضان روزه بگیرید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 28.86,
   "end": 31.7,
   "text": "مگر اینکه بر شما ثابت بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 31.7,
   "end": 36.64,
   "text": "حالا یا خودت رؤیت ماه رمضان برات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 36.64,
   "end": 39.12,
   "text": "مسجل بشه یا اینکه مراجع اعلام کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 39.12,
   "end": 42.4,
   "text": "گروه‌هایی که مراجع گسیل می‌دارند به این ور اون ور اعلام کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 42.4,
   "end": 45.2,
   "text": "خب بعد چی میشه؟ در هر حال وقتی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 45.2,
   "end": 47.72,
   "text": "حالا شما مثلا روز اول",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 47.72,
   "end": 50.76,
   "text": "ماه رمضان بود نمی‌دونستی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 50.76,
   "end": 53.48,
   "text": "اگر روزه نگرفتی بعداً قضاش گردنته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 53.48,
   "end": 60.5,
   "text": "اگر روزه گرفتی به نیت آخر شعبان که غیر از اینم نیست باید به نیت آخر شعبان اگر خواستی روزه بگیری بگیری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 60.5,
   "end": 65.74,
   "text": "چون هنوز مسجل نشده. بعد اون موقع جزو ماه رمضان حساب می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 65.74,
   "end": 68.6,
   "text": "این حالا حکم فقهی بود که عرض کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 68.6,
   "end": 71.3,
   "text": "بحث ما بحث قلب عاثم هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 71.3,
   "end": 76.18,
   "text": "خودبه‌خود تو جلسه پیش که خواستیم ارزش این نوع بحث‌ها رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 76.18,
   "end": 78.56,
   "text": "بیان کنیم وارد شدیم به حوزه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 78.56,
   "end": 83.72,
   "text": "قلب جدید. هجدهمین نوع قلب در قرآن به نام قلب عاثم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 83.72,
   "end": 86.32,
   "text": "با ث سه نقطه ثم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 86.32,
   "end": 89.78,
   "text": "که حالا اینکه این‌ها چه فرقی با هم دارن با مثلا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 89.78,
   "end": 92.92,
   "text": "غم، با خطیئه، با سیئه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 92.92,
   "end": 95.54,
   "text": "با عصیان این‌ها چه فرق‌هایی دارن جلسه بعد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 95.54,
   "end": 99.82,
   "text": "فعلاً اینو بدونیم که هم-همه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 99.82,
   "end": 103.72,
   "text": "ماها در معرض قلب عاثم هستیم که قبلاً عرض شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 103.72,
   "end": 110.72,
   "text": "یعنی اینکه کار حرامی رو انجام بده انسان که کاری رو که خدا این رو براش حرمت قرار داده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 110.72,
   "end": 113.72,
   "text": "یعنی در حقیقت خط قرمز خدا رو رد کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 113.72,
   "end": 118.2,
   "text": "اگه کسی این کارو عمداً انجام بده از رو قلب و با نیت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 118.2,
   "end": 120.1,
   "text": "چنین کسی دارای قلب عاثمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 120.1,
   "end": 124.48,
   "text": "خب برای اینکه مرتبط بشیم با یه همچین شب باعظمتی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 124.48,
   "end": 131.14,
   "text": "اجازه بدید بف-- یه سوالی رو طرح کنیم که آیا اگر کسی حتی دچار قلب عاثم هم شد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 131.14,
   "end": 136.14,
   "text": "چنین کسی هم دعوت شده است به ماه مهمانی خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 136.14,
   "end": 141.86,
   "text": "که دعیتم الی ضیافت الله آیا چنین کسی هم دعوت شده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 141.86,
   "end": 147.5,
   "text": "امروز شیرینی این دو سال بحث حکمی که ما داشتیم رو به نوعی متوجه می‌شیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 147.5,
   "end": 151.88,
   "text": "ما گفتیم که آقا جون احادیث اهل بیت صعب مستصعبن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 151.88,
   "end": 156.42,
   "text": "خودشون فرمودن ان حدیثنا صعب مستصعب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 156.42,
   "end": 160.82,
   "text": "حالا باید رفت درون این‌ها رو بر اساس حکمت دید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 160.82,
   "end": 165.46,
   "text": "که البته پیغمبر فرمود انا مدینة الحكمة و هی الجنة.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 165.46,
   "end": 168.8,
   "text": "من شهر حکمتم و این بهشته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 168.8,
   "end": 172.94,
   "text": "به دنبال این باش. به بهشت سیب و گلابی چه دردت می‌خوره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 172.94,
   "end": 175.96,
   "text": "و علی باب البته. و انت یا علی بابا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 175.96,
   "end": 179.08,
   "text": "تو در اون هستی. در بهشت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 179.08,
   "end": 181.12,
   "text": "امیرالمؤمنین. بهشت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 181.12,
   "end": 185.26,
   "text": "شهر حکمت. سیری که ما این دو سال به فضل الهی رفتیم حکمت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 185.26,
   "end": 187.74,
   "text": "حالا کارآیی‌ش رو اینجا ببینید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 187.74,
   "end": 194.54,
   "text": "همیشه ما شنیدیم معمولاً این ایام آخوند‌ها که بالا منبر میرن توجه ما رو جلب می‌کنند به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 194.54,
   "end": 198.64,
   "text": "اون خطبه پیغمبر در آخرین روزهای ماه شعبان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 198.64,
   "end": 202.76,
   "text": "که خطبه اینطوری شروع می‌شه. ایها الناس حالا شما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 202.76,
   "end": 205.38,
   "text": "خداوکیلی دقت کنید ببینید چقدر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 205.38,
   "end": 209.82,
   "text": "شیرین می‌شه براتون وقتی با حکمت می‌رید تو دل قضیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 209.82,
   "end": 213.56,
   "text": "انه قد اقبل الیکم شهر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 213.56,
   "end": 216.34,
   "text": "الله. ما رو این کلمات الآن حرف می‌زنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 216.34,
   "end": 219.2,
   "text": "یکی الناس. یکی اقبل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 219.2,
   "end": 221.14,
   "text": "یکی شهر الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 221.14,
   "end": 223.88,
   "text": "نه الرحمن. نه الرحیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 223.88,
   "end": 227.26,
   "text": "یکی بالبركة والرحمة والمغفرة.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 227.26,
   "end": 229.62,
   "text": "همه اینا حساب شده کنار هم اومدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 229.62,
   "end": 231.94,
   "text": "انه و الا وحی یوحا دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 231.94,
   "end": 234.9,
   "text": "پیغمبر هرچی می‌گه وحیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 234.9,
   "end": 237.4,
   "text": "ما ینطق عن الهوی از رو هوی نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 237.4,
   "end": 242.06,
   "text": "وحی محضه. لذا اینا همه حساب شده کنار همه ما بعضیش رو عرض می‌کنیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 242.06,
   "end": 245.88,
   "text": "که خدا لطف کرد دیشب سحر ما داشتیم یه لحظه برامون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 245.88,
   "end": 247.46,
   "text": "حالا یه انقلاب ایجاد شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 247.46,
   "end": 254.54,
   "text": "تو همین زمینه داشتم فکر می‌کردم دیدم عجب درون مایه ای داره همین جمله اول خطبه پیغمبر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 254.54,
   "end": 258.4,
   "text": "اولاً می‌فرماید ایها الناس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 258.4,
   "end": 260.7,
   "text": "الناس یعنی همه مردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 260.7,
   "end": 264.86,
   "text": "به من و تو چه که بگیم آقا فلانی گناهکار دلش خوش اومده تو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 264.86,
   "end": 268.74,
   "text": "شهر الله. خدا دعوت کرده از همه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 268.74,
   "end": 273.3,
   "text": "حالا چرا الناس؟ الآن عرض می‌کنیم چون اونجا می‌گه شهر چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 273.3,
   "end": 276.08,
   "text": "الله. الآن بهش می‌رسیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 276.08,
   "end": 278.14,
   "text": "اولاً الناس یعنی همه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 278.14,
   "end": 281.04,
   "text": "بار عام ماه مبارک رمضان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 281.04,
   "end": 285.96,
   "text": "بار عام خداست. خوب و بد رو خدا دعوت کرده به همین صراحت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 285.96,
   "end": 288.8,
   "text": "الناس یعنی شما ببین توجه که می‌کنید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 288.8,
   "end": 292.1,
   "text": "به کلمات بر اساس حکمت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 292.1,
   "end": 295.56,
   "text": "می‌بینید با چه حکمتی قرآن هم همش حکمته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 295.56,
   "end": 299.52,
   "text": "این‌ها کنار هم قرار گرفته. یٰسٓ وَالْقُرْآنِ الْحَكِیمِ.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 299.52,
   "end": 303.5,
   "text": "انه قد اقبل الیکم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 303.5,
   "end": 305.4,
   "text": "به اون آسمونی‌ها نه به شما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 305.4,
   "end": 309.76,
   "text": "اونم اقبل. ما یه ادبار داریم یه اقبال،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 309.76,
   "end": 313.42,
   "text": "یه بینابین هم داریم. این نه ادباره، نه بینابینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 313.42,
   "end": 317.22,
   "text": "اقباله. وقتی با توجه به شما کسی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 317.22,
   "end": 322.86,
   "text": "رو کنه با چهره بشاش یعنی آغوش باز کنه به این میگن حالت اقبال.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 322.86,
   "end": 329.94,
   "text": "دیدی گاهی، گاهی اوقات انشراح قلبی پیدا می‌کنی، دوست داری عبادت کنی، گریه کنی، حرف خوب بشنوی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 329.94,
   "end": 332.5,
   "text": "هیئت بری، مسجد بری. این حالت اقباله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 332.5,
   "end": 335.82,
   "text": "برعکسش ادباره. بینابینش خیلی خطرناکه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 335.82,
   "end": 338.1,
   "text": "اقبال میگه اقبل الیکم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 338.1,
   "end": 345.44,
   "text": "حالا فرصت نیست و الا هر کدوم از اینا اهل البته باسوادش باید چند تا منبر برن به خدا قسم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 345.44,
   "end": 350.14,
   "text": "اقبل الیکم یعنی نترس این ماه خدا آغوش باز کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 350.14,
   "end": 353.64,
   "text": "اونم برای الناس. حالا چرا برای همه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 353.64,
   "end": 356.26,
   "text": "چرا برای همه باز کرده؟ چون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 356.26,
   "end": 358.22,
   "text": "این شهر الله هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 358.22,
   "end": 361.5,
   "text": "شهر الله. الله اسم خاص خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 361.5,
   "end": 363.72,
   "text": "تمام اسماء ذیلشن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 363.72,
   "end": 365.88,
   "text": "تمام اسمای خدا. می‌خوای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 365.88,
   "end": 374.58,
   "text": "اون ائمه اسما رو، اون امام جماعت اسما رو بعد از الله الرحمن و الرحیم بگیر باز همه اسما ذیلشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 374.58,
   "end": 381.82,
   "text": "می‌خوای اون اسمای اربعه بگیر \"هو الأول والآخر والظاهر والباطن\" آیه سه سوره حدید، همه اسما ذیلشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 381.82,
   "end": 386.32,
   "text": "می‌خوای اون هفت اسم اسماء در حقیقت ائمه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 386.32,
   "end": 389.08,
   "text": "سبعه اسماء الهی بگیر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 389.08,
   "end": 393.24,
   "text": "که اولیش با الحي هست، خدا حیات داره، همه چی حیات داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 393.24,
   "end": 395.2,
   "text": "بعد العلیم است؛ همه چی علمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 395.2,
   "end": 398.28,
   "text": "اصلا خدا علمه. اینا بحثاش گذشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 398.28,
   "end": 404.56,
   "text": "القدیر است، هم قدرت داره خدا همه چی هم به قدرتش خلق کرده لجا-- لذا همه قدرت دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 404.56,
   "end": 409.76,
   "text": "تو هم قدرت داری. السميع البصير المريد، تو هم اراده داری دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 409.76,
   "end": 413.06,
   "text": "المتكلم که اینا بحثاش قبلاً گذشته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 413.06,
   "end": 415.68,
   "text": "می‌خوای اینطوری بگیر همه اسما ذیلش قرار می‌گیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 415.68,
   "end": 418.26,
   "text": "می‌خوای هزار و یک اسم جوشن کبیر رو بگیر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 418.26,
   "end": 425.9,
   "text": "می‌خوای \"وما يعلم جنود ربك إلا هو\" این آیه رو بگیر که اسما بی‌نهایت‌اند چون خدا لا یتناهیه باز هم فرق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 425.9,
   "end": 428.2,
   "text": "همش جمع می‌شه در الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 428.2,
   "end": 432.02,
   "text": "حالا خدا اومده به زیبایی تمام اینو سه شاخه قرار داده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 432.02,
   "end": 434.48,
   "text": "رحمت خدا مثل نفسه، این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 434.48,
   "end": 439.82,
   "text": "آسمانه، این هوا، این استنشاقی که می‌کنی، این اکسیژن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 439.82,
   "end": 445.22,
   "text": "کافر و مشرک و منافق و مسلمون و شیعه همه دارن ازش انس-- استنشاق می‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 445.22,
   "end": 447.58,
   "text": "از چی؟ از این هوا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 447.58,
   "end": 453.02,
   "text": "رحمت خدا مثل اینه. لذا پیغمبر فرمود انبیا هم با رحمت خدا وارد بهشت می‌شن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 453.02,
   "end": 457.86,
   "text": "اگر رحمت خدا نباشه من خاتم الانبیا هم وارد بهشت نمی‌شن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 457.86,
   "end": 466.8,
   "text": "درست شد؟ اومده این هوایی که الان داره عوض می‌شه از امشب برای من و تو رو که یک پارچه رحمت محض است رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 466.8,
   "end": 471.28,
   "text": "قرار داده بین دو وجه یا دو قسم از اسمایش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 471.28,
   "end": 473.9,
   "text": "ببینید بالبركة",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 473.9,
   "end": 476.92,
   "text": "بعد الرحمة اون هوا است الرحمة.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 476.92,
   "end": 480.22,
   "text": "بعد المغفرة. الرحمة مال همه‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 480.22,
   "end": 484.84,
   "text": "همه. بعدم نیومده بگه الرحم-- الشهر الرحمن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 484.84,
   "end": 486.94,
   "text": "مال مثلاً یه چیزیه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 486.94,
   "end": 489.12,
   "text": "یه چیز عادیه، یه چیز عادی نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 489.12,
   "end": 492.52,
   "text": "نه بازم نگفته شهر الرحیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 492.52,
   "end": 494.62,
   "text": "یعنی مال یه عده خاصیه فقط.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 494.62,
   "end": 497.24,
   "text": "نه، خیلی با زیبایی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 497.24,
   "end": 499.5,
   "text": "تمام می‌گه اصلا مقیدش نکرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 499.5,
   "end": 503.76,
   "text": "الرحمة یعنی این رحمت بر سر همه نازله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 503.76,
   "end": 507.64,
   "text": "اما دقت کنید قبلش می‌گفت، فرموده بالبركة.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 507.64,
   "end": 514.22,
   "text": "بركة امثال مثلاً اسم‌هایی مثل بارک، جابر، فاضل تو این حیس‌ن، ذیل اینن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 514.22,
   "end": 517.96,
   "text": "بركة یعنی تو هر کاری بکنی ضربدر می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 517.96,
   "end": 520.02,
   "text": "ضریب می‌خوره، چندین برابر می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 520.02,
   "end": 523.3,
   "text": "\"من جاء بالحسنة فله عشر أمثالها\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 523.3,
   "end": 527.42,
   "text": "ده برابر می‌شه، هفت-- هفتاد برابر می‌شه، هفتصد برابر می‌شه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 527.42,
   "end": 529.74,
   "text": "بی‌نهایت برابر می‌شه. ها؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 529.74,
   "end": 531.88,
   "text": "این همه ذیل اسم بر-- این برای کیاست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 531.88,
   "end": 536.38,
   "text": "شاگرد زرنگ‌ها. شاگرد زرنگ‌ها هر کاری بکنن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 536.38,
   "end": 540.08,
   "text": "الا ما-- الا بی‌نهایت خدا براشون اینجا به رحمتش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 540.08,
   "end": 545.72,
   "text": "وعده داده. اما اونایی که مثل من گناهکارن حتی دچار غالب آفه می‌شن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 545.72,
   "end": 549.32,
   "text": "اینجا اسم بعدی بعد از الرحمة میاد کمکشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 549.32,
   "end": 551.6,
   "text": "المغفرة .",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 551.6,
   "end": 555.18,
   "text": "چقدر جالب، قشنگ پیغمبر یعنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 555.18,
   "end": 557.2,
   "text": "چی بگم نسخه‌ای پیچیده که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 557.2,
   "end": 559.36,
   "text": "هیچکس نمی‌تونه بگه به درد من نمی‌خوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 559.36,
   "end": 563.12,
   "text": "آقا من نمی‌تونم بهره‌ای از ماه بگیرم، از این ماه بگیرم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 563.12,
   "end": 566.5,
   "text": "حالا مغفرت هم که همون رفع نواقص و بدی‌هاست دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 566.5,
   "end": 570.62,
   "text": "درسته؟ بالاخره نقض‌هایی، بدی‌هایی ما داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 570.62,
   "end": 574.46,
   "text": "اسامی‌ای مثل غافر، ساتر، قابل، مغل، مبدل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 574.46,
   "end": 578.48,
   "text": "اینا همه ذیلش تعریف می‌شن. همه‌ی اینا رو جمع کن اونجا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 578.48,
   "end": 582.26,
   "text": "حالا شهر الله. پس همه می‌تونن بیان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 582.26,
   "end": 588.26,
   "text": "و دقت بفرمایید من این رو اینجا اگرچه این موضوع حداقل برای اینکه خوب ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 588.26,
   "end": 593.44,
   "text": "متوجهش بشیم یه سیر ده جلسه‌ای می‌خواد همین آیه‌ای که الان می‌خوام عرض کنم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 593.44,
   "end": 597.6,
   "text": "در انتهای بحث. اما تا یارkra خواهد و میلش به که باشد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 597.6,
   "end": 601.3,
   "text": "برید سراغ آیه پونزده سوره فاطر جمع کنم بحثو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 601.3,
   "end": 603.06,
   "text": "ببینید چقدر شیرین می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 603.06,
   "end": 606.52,
   "text": "من با یه مثال براتون متوجه‌تون کنم چه خبره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 606.52,
   "end": 610.82,
   "text": "این آیه رو معمولاً همه حفظیم. يا أيها باز می‌گه الناس،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 610.82,
   "end": 614.12,
   "text": "الناس، يا أيها الناس أنتم الفقراء",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 614.12,
   "end": 616.5,
   "text": "اونم الفقراء. إلا کی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 616.5,
   "end": 618.26,
   "text": "شما فقیر به سمت کی هستید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 618.26,
   "end": 622.76,
   "text": "إلا الله. والله دوباره تاکید الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 622.76,
   "end": 625.98,
   "text": "الله دوباره الله. هو دوباره هویت بعد از الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 625.98,
   "end": 627.98,
   "text": "اینا حکمای ابراش خیلی حرف زدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 627.98,
   "end": 632.02,
   "text": "مثلاً از ته علم حسن زاده اصلا قیامت کرده ذیل این آیه برید بخونید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 632.02,
   "end": 635.02,
   "text": "\"والله هو الغني الحميد\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 635.02,
   "end": 639.06,
   "text": "اینجا فقر شما به سوی کدوم اسم خداست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 639.06,
   "end": 643.18,
   "text": "إلا الله. نه الرحمن، نه الرحیم، نه هر کدوم از این اسما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 643.18,
   "end": 647.12,
   "text": "یعنی چی؟ من یه مثال بزنم شیرینیش به جانتون بشینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 647.12,
   "end": 649.8,
   "text": "وقتی من اینو متوجه شدم اشک شوق ریختم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 649.8,
   "end": 654.62,
   "text": "خدا شاهده. اینو ب- دقت کنید توی بتونم یکی دو دقیقه جمعش کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 654.62,
   "end": 660.58,
   "text": "اگر شما تشنه باشید برید لب دریا یه جرعه آب بخورید عطشتون برطرف بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 660.58,
   "end": 667.52,
   "text": "به نظر شما، شما تشنه دریا بودی یا تشنه این یک جرعه آب؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 667.52,
   "end": 670.36,
   "text": "تشنه بودی رفتی لب دریا، خب آبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 670.36,
   "end": 672.7,
   "text": "اما یه جرعه خوردی سیر شدی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 672.7,
   "end": 676.1,
   "text": "تش-- به شما می‌گن تشنه این دریا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 676.1,
   "end": 678.76,
   "text": "نه، تشنه یه لیوان آب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 678.76,
   "end": 685.08,
   "text": "اما اگر شما به جایی رسیدی هرچی این دریا رو خوردی، خوردی، خوردی تشنه‌تر شدی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 685.08,
   "end": 690.46,
   "text": "هی می‌گی حلم مزید از بالا صدای تعالى میاد بیا بالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 690.46,
   "end": 693.02,
   "text": "از پایین صدای حلم مزید میاد که تویی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 693.02,
   "end": 696.12,
   "text": "می‌گی بیشتر نبود؟ من تشنه‌تر شدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 696.12,
   "end": 698.44,
   "text": "همه دریا رو هم بهت بدن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 698.44,
   "end": 700.18,
   "text": "حالا مثاله دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 700.18,
   "end": 702.94,
   "text": "اگر بگی مثلاً تمام شدنی که نیست، کی نیست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 702.94,
   "end": 704.86,
   "text": "کلمات الهیه تمام نمی‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 704.86,
   "end": 708.54,
   "text": "حالا فرض کن تمام شد بازم بگه حلم مزید دیگه نیست که تمامم نمی‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 708.54,
   "end": 710.98,
   "text": "هرچی بخوای الا ما شاء الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 710.98,
   "end": 716.0,
   "text": "خب؟ اون موقع به تو می‌گن تشنه یه جرعه آبی یا دریایی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 716.0,
   "end": 718.5,
   "text": "دریا. درست شد؟ حالا برگرد به آیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 718.5,
   "end": 722.64,
   "text": "می‌گه أنتم الفقراء اگر اون فقیرو شما تشنه فرض کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 722.64,
   "end": 724.7,
   "text": "شما تشنه به چی هستید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 724.7,
   "end": 727.6,
   "text": "به الرحمن، به الرحیم، به الحکیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 727.6,
   "end": 729.62,
   "text": "المرید، المتكلم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 729.62,
   "end": 732.08,
   "text": "اینا؟ نه. الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 732.08,
   "end": 736.58,
   "text": "عجب. أنتم الفقراء إلى الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 736.58,
   "end": 739.46,
   "text": "یعنی الله اسم خاص.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 739.46,
   "end": 743.16,
   "text": "خدا با تمام اسماء و صفاتش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 743.16,
   "end": 745.52,
   "text": "سفره پهن کرده برای تو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 745.52,
   "end": 748.66,
   "text": "تو تشنه باش هرچی میخوای برات مهیاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 748.66,
   "end": 754.08,
   "text": "الله اکبر. یعنی اگر به همین ظعمی که حضرت علامه حسن زاده می‌فرمود اگر کسی یه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 754.08,
   "end": 759.28,
   "text": "چند رکعت نماز خون، نماز شبی، سیر و سلوکی، عبادت یا حتی علمی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 759.28,
   "end": 761.58,
   "text": "معرفتی کسب کرد بعد دید دیگه بسه شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 761.58,
   "end": 764.26,
   "text": "احساس کرد دیگه مثلاً به جایی رسیده و دیگه بسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 764.26,
   "end": 766.36,
   "text": "این مریضه این قلبش مریضه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 766.36,
   "end": 769.18,
   "text": "تو بحث قلب مریض اینو ما بحث کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 769.18,
   "end": 773.92,
   "text": "چون الی يتناهی اصلاً لا يتناهی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 773.92,
   "end": 779.18,
   "text": "انتها نداره. پس فقر یعنی خدا نسخه انسان رو،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 779.18,
   "end": 783.02,
   "text": "من و شما رو فطرت الله التي فطر الناس عليها رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 783.02,
   "end": 788.4,
   "text": "چنان إنشاء کرده هو الذي أنشأکم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 788.4,
   "end": 791.46,
   "text": "چنان إنشاء کرده که تشنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 791.46,
   "end": 793.26,
   "text": "الله باشی نه اسماء.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 214,
   "start": 793.26,
   "end": 797.48,
   "text": "همه اسماء خدا. حالا برگرد به این خطبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 215,
   "start": 797.48,
   "end": 801.28,
   "text": "این همه زور زدم که همین یه کلمه رو متوجه بشین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 216,
   "start": 801.28,
   "end": 804.36,
   "text": "يا أيها الناس بدی خوبی به من چه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 217,
   "start": 804.36,
   "end": 807.4,
   "text": "همه رو دعوت کرد. إنه قد أقبل الیکم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 218,
   "start": 807.4,
   "end": 810.94,
   "text": "چگونه دعوت کرد؟ او به شما آغوش باز کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 219,
   "start": 810.94,
   "end": 813.38,
   "text": "هر چقدر هم که بدی. پس پس نزن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 220,
   "start": 813.38,
   "end": 816.46,
   "text": "اونم چی؟ شهر الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 221,
   "start": 816.46,
   "end": 820.08,
   "text": "شهر الله. تمام اسماء به سوی تو آمده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 222,
   "start": 820.08,
   "end": 823.78,
   "text": "مگر یه دونه از این اسماء مبدل السيئات بالحسنات نیست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 223,
   "start": 823.78,
   "end": 828.12,
   "text": "مگر یکیش جابر العظم الكسير نیست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 224,
   "start": 828.12,
   "end": 830.8,
   "text": "جبران کننده شکسته استخوان‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 225,
   "start": 830.8,
   "end": 835.44,
   "text": "ها؟ مگر غافر الذنب الكبير نیست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 226,
   "start": 835.44,
   "end": 838.46,
   "text": "خب همینه. خب اگر همینم هستی بسم الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 227,
   "start": 838.46,
   "end": 842.36,
   "text": "اونم به چه وضع؟ بالبركة والرحمة والمغفرة.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 228,
   "start": 842.36,
   "end": 844.28,
   "text": "دیگه نمی‌دونم دیگه چی بگم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 229,
   "start": 844.28,
   "end": 854.12,
   "text": "شهر هو عند الله أفضل الشهور وأيامه أفضل الأيام ولياليه أفضل الليالي وساعاته أفضل الساعات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 230,
   "start": 854.12,
   "end": 860.46,
   "text": "حالا می‌فهمین چرا بالاترین ساعاته، بالاترین شب‌هاست، بالاترین روزهاست، بالاترین ماه‌هاست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 231,
   "start": 860.46,
   "end": 865.08,
   "text": "و شهر و هو شهر دعيتم فيه إلى ضيافة",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 232,
   "start": 865.08,
   "end": 868.1,
   "text": "الله. الله اکبر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 233,
   "start": 868.1,
   "end": 870.4,
   "text": "دیگه بیشتر از این من اذیتتون نکنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 234,
   "start": 870.4,
   "end": 872.24,
   "text": "ان شا الله عاقبتمون ختم بخیر بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 235,
   "start": 872.24,
   "end": 875.22,
   "text": "به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 236,
   "start": 875.22,
   "end": 879.7,
   "text": "اللهم صل على محمد و آل محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}