   "title": "## جمع سفرهٔ قلب آثم",
   "start": 74.4,
   "end": 166.82
  },
  {
   "index": 2,
   "title": "## تهمت، تحریف کلام و سوءظن",
   "start": 166.82,
   "end": 187.54
  },
  {
   "index": 3,
   "title": "## گونه‌های عذاب در قرآن",
   "start": 187.54,
   "end": 293.02
  },
  {
   "index": 4,
   "title": "## عذاب مهین؛ وهن و درد روح",
   "start": 293.02,
   "end": 368.14
