   "start": 493.62,
   "end": 665.9
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.36,
   "end": 2.88,
   "text": "الرحیم و به hän نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 2.88,
   "end": 5.78,
   "text": "السلام علیک یا داعی الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 5.78,
   "end": 7.98,
   "text": "و ربانی آیاته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 7.98,
   "end": 10.82,
   "text": "سلامٌ علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 10.82,
   "end": 14.58,
   "text": "عزیزانی که بعضاً جاهایی کار می‌کنند که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 14.58,
   "end": 19.38,
   "text": "مثلاً غبار غلیظ، دود غلیظ،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 19.38,
   "end": 23.6,
   "text": "خاک غلیظ این چیزا مثلا غبار خاک بلند میشه تو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 23.6,
   "end": 26.72,
   "text": "مثل بناها، مثل کارگرا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 26.72,
   "end": 29.8,
   "text": "یا بعضی مکانیک‌ها که دارن ماشینو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 29.8,
   "end": 31.96,
   "text": "درست می‌کنن میگن گاز بده یهو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 31.96,
   "end": 35.26,
   "text": "دود غلیظی میاد تو مغازه‌شون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 35.26,
   "end": 41.64,
   "text": "سؤالشون این میشه که مجرد اینکه این غبار غلیظ، دود غلیظ،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 41.64,
   "end": 48.34,
   "text": "این‌ها یا خاک اینا وارد دهان و بینی ما شد روزه‌مون باطله؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 48.34,
   "end": 54.7,
   "text": "بالاخره هر روز ما کارمون اینه یا اینایی که تو معدن کار می‌کنن دائماً با غبار و خاک و...",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 54.7,
   "end": 59.7,
   "text": "رهبر عزیزمون فرمودن که نه، مجرد اینکه وارد دهان و بینی بشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 59.7,
   "end": 64.82,
   "text": "روزه باطل نیست. اگر وارد حلق بشه باطله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 64.82,
   "end": 68.92,
   "text": "صرف اینکه وارد دهان یا بینی بشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 68.92,
   "end": 71.34,
   "text": "روزه باطل نمیشه. باید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 71.34,
   "end": 74.4,
   "text": "بره وارد فضای حلق بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 74.4,
   "end": 80.12,
   "text": "بحث ما امروز دیگه سفره قلب آثِم رو انشاالله به امید خدا جمع کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 80.12,
   "end": 86.3,
   "text": "من بررسی می‌کردم آیات زیادی بود، خیلی یعنی در خصوص تک‌تک این آیات میشه حرف زد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 86.3,
   "end": 91.3,
   "text": "منتها چه کنیم دیگه باید به قلب‌های دیگه هم برسیم انشاالله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 91.3,
   "end": 95.84,
   "text": "شما خودتون هر کی دوست داره در حد تحقیق و تفحص بره ببینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 95.84,
   "end": 100.82,
   "text": "چند تاشو من میگم البته چهل و هشت تا عرض کردیم چهل و هشت بار این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 100.82,
   "end": 105.24,
   "text": "با حالا به لفظ مختلف به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 105.24,
   "end": 109.78,
   "text": "عرض شود از همین ریشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 109.78,
   "end": 112.9,
   "text": "به معانی مختلف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 112.9,
   "end": 114.96,
   "text": "کلمه‌ی اثم در قرآن اومده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 114.96,
   "end": 119.74,
   "text": "مثلاً یه جا می‌فرماید \"يسألونك عن الخمر والميسر\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 119.74,
   "end": 124.54,
   "text": "در خصوص قمار و شراب‌خواری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 124.54,
   "end": 127.42,
   "text": "قل بهشون بگو \"فيها اثم كبير\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 127.42,
   "end": 135.08,
   "text": "اثم كبير. اینجا شراب و قمار رو قرآن اثم نام می‌بره با سه سه نقطه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 135.08,
   "end": 142.6,
   "text": "یه گناه سنگین. یا \"يلقى اثاما\" اونجایی که بحث عذاب و عقوبت رو میاره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 142.6,
   "end": 146.46,
   "text": "اون عقوبت رو با اثاما یاد می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 146.46,
   "end": 150.24,
   "text": "یعنی یک ضرر حتمی و چشمگیر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 150.24,
   "end": 155.08,
   "text": "یا جای دیگه می‌فرماید همون آیه‌ای که اصلاً قلب آثِم رو از اونجا اقتباس کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 155.08,
   "end": 157.34,
   "text": "\"ومن يكتمها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 157.34,
   "end": 159.62,
   "text": "فانه آثم القلب\" این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 159.62,
   "end": 165.9,
   "text": "کتمان شهادته. کسی شهادت رو کتمان کنه، نده شهادت به حق نده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 165.9,
   "end": 168.28,
   "text": "اینم از اثمه. \"ويل لكل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 168.28,
   "end": 174.28,
   "text": "افّاك أثيم\". این نسبت دادن گناه به دیگری، تهمت زدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 174.28,
   "end": 177.14,
   "text": "چند تا آیه داریم که اونجا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 177.14,
   "end": 180.8,
   "text": "اثم رو تهمت زدن به دیگران بیان می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 180.8,
   "end": 187.54,
   "text": "یا \"فمن بدلّه بعدما سمعه فإنما اثمه على الذين يبدلونه\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 187.54,
   "end": 193.76,
   "text": "اینکه یه حرفی رو بشنوی بدلش کنی جور دیگه بیان کنی، انحراف در معنا، انحراف در لفظ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 193.76,
   "end": 196.68,
   "text": "مثل این تقطیعی که خیلی‌ها الان انجام میدن صحبت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 196.68,
   "end": 201.14,
   "text": "یکی رو برمی‌دارن تقطیع می‌کنن یه جور دیگه بیان می‌کنن آبروی طرفو می‌برن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 201.14,
   "end": 205.6,
   "text": "اینا اثم حساب میشه یا \"إن بعض الظن اثم\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 205.6,
   "end": 211.48,
   "text": "گمان بد کردن، ظن و گمان بد نسبت به کسی کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 211.48,
   "end": 214.32,
   "text": "اینا گناه، گناه اثم حساب میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 214.32,
   "end": 216.9,
   "text": "\"بل ای حسبن الذين كفروا\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 216.9,
   "end": 220.12,
   "text": "اینم بحث کفر که آخرش می‌فرماید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 220.12,
   "end": 222.52,
   "text": "\"ولهم عذاب مهین\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 222.52,
   "end": 225.76,
   "text": "شرک، دروغ به خدا، عدوان،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 225.76,
   "end": 230.14,
   "text": "اینا همه-- عداوت، اینا همه به اثم یاد شده خیلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 230.14,
   "end": 233.3,
   "text": "بعضیاشون چندین بار. حالا زیاده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 233.3,
   "end": 235.42,
   "text": "چیزی که اینجا میخوام عرض کنم دو نکته‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 235.42,
   "end": 238.16,
   "text": "اول اینکه اینجا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 238.16,
   "end": 240.48,
   "text": "ثمره‌ی اثم رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 240.48,
   "end": 244.12,
   "text": "می‌فرماید \"لهم عذاب مهین\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 244.12,
   "end": 248.14,
   "text": "عذاب مهین. ما چند جور عذاب در قرآن داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 248.14,
   "end": 252.14,
   "text": "عذاب مهین داریم، علیم داریم، عظیم داریم، شدید داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 252.14,
   "end": 256.72,
   "text": "اینا چه فرقی با هم می‌کنن؟ عذاب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 256.72,
   "end": 259.38,
   "text": "شدید مثل زندان‌های بلندمدت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 259.38,
   "end": 263.22,
   "text": "مثلاً خیلی شدیده، زیاده، طول می‌کشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 263.22,
   "end": 266.22,
   "text": "خیلی اذیت میشه طرف. عذاب عظیم رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 266.22,
   "end": 269.52,
   "text": "مفسرین فرمودن مثل مجازات‌های پرسر و صدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 269.52,
   "end": 275.96,
   "text": "مثل اینکه در ملأ عام یکی رو اعدامش کنن، جلوی چشم دیگران بندازنش تو جهنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 275.96,
   "end": 281.0,
   "text": "سر و صدا کنه. هیاهو اینا بهش میگن عذاب عظیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 281.0,
   "end": 283.14,
   "text": "علیم هم که رو خودشه. دردناک.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 283.14,
   "end": 290.2,
   "text": "شلاق بزنن، سیخ داغی تو بدن طرف فرو کنن، نیشش بزنه عقرب اینا میگن ع-- چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 290.2,
   "end": 292.52,
   "text": "عذاب علیم با الف.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 292.52,
   "end": 296.84,
   "text": "اما اینجا میگه اثم عقوبتش عذاب مهینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 296.84,
   "end": 299.36,
   "text": "از وهن میاد یعنی توهین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 299.36,
   "end": 303.76,
   "text": "یعنی توهینش می‌کنن. شاید اصلاً دردش هم نیاد جسمش ها،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 303.76,
   "end": 310.36,
   "text": "جسمش درد نیاد اما مثلاً خارش کنن جلوی چشم دیگران، تف بکنن سر صورتش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 310.36,
   "end": 314.0,
   "text": "یا یه ح-- یه آیه در قرآن هست که خدا به بعضیا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 314.0,
   "end": 317.76,
   "text": "تو قیامت نظر نمی‌کنه، اصلاً نگاهشون نمی‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 317.76,
   "end": 320.08,
   "text": "اصلاً نگاهشون نمی‌کنه چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 320.08,
   "end": 322.14,
   "text": "وهن دیگه، ت-توهینه بهشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 322.14,
   "end": 324.06,
   "text": "اینا عذاب مهینه. خیلی دردنیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 324.06,
   "end": 327.0,
   "text": "در حقیقت این درد روحیه عزیزان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 327.0,
   "end": 329.44,
   "text": "درد روحه. خیلی بدتر از درد جسمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 329.44,
   "end": 331.88,
   "text": "شاید بشه درد جسمو تحمل کرد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 331.88,
   "end": 334.94,
   "text": "اما درد روح رو نمیشه. این نشون میده که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 334.94,
   "end": 338.76,
   "text": "خیلی بحث که حالا قلب آثِم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 338.76,
   "end": 342.42,
   "text": "دشواره. یعنی قلبی خدا نکنه گرفتار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 342.42,
   "end": 347.22,
   "text": "اثم بشه، این گناهانی که دست به دست اثم نامگذاری شد دیگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 347.22,
   "end": 349.16,
   "text": "خیلی سخت میشه ظاهرًا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 349.16,
   "end": 352.3,
   "text": "یعنی جوری میشه که دیگه قیامت به روحش،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 352.3,
   "end": 357.36,
   "text": "به روانش، به ذاتش، چی بگیم به نفسش جسارت میشه، توهین میشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 357.36,
   "end": 364.46,
   "text": "حقش هم هست. اما حالا این همه حرف زدیم چند جلسه، بیست جلسه نمی‌دونم در خصوص قلب آثِم حرف زدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 364.46,
   "end": 368.82,
   "text": "این اثما به کار یه نکته‌ای هم عرض کنیم، نسخه‌ای بپیچیم از-",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 368.82,
   "end": 371.6,
   "text": "لسان علامه حسن زاده امفزی الله تعالی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 371.6,
   "end": 375.5,
   "text": "بالاخره چه کنیم؟ حالا کسی گرفتار شد، آلوده شد دلش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 375.5,
   "end": 381.16,
   "text": "راهش چیه؟ عزیزان هیچ راهی نداره الا به قول علامه سوختن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 381.16,
   "end": 384.48,
   "text": "سوختن، ساختن به دنبال داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 384.48,
   "end": 389.12,
   "text": "سوختن. اتفاقاً حضرت علامه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 389.12,
   "end": 395.34,
   "text": "دستورالعمل نسخه باری داره خیلی زیبا می‌فرمود که می‌خواد به، به شما عرض کنم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 395.34,
   "end": 400.06,
   "text": "تمام قرآن که حدیث داریم در بسم الله الرحمن الرحیم جمعه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 400.06,
   "end": 403.8,
   "text": "بسم الله الرحمن الرحیم سوره حمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 403.8,
   "end": 407.24,
   "text": "که فرمود هرکی صبح وضو کنه و نوزده بار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 407.24,
   "end": 410.0,
   "text": "بسم الله الرحمن الرحیم رو بگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 410.0,
   "end": 417.1,
   "text": "بعد خدا اون رو از آفات و بلیات و آتش دنیا و آخرت و اینا حفظ می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 417.1,
   "end": 421.54,
   "text": "بعد از اینکه وضوشو گرفت و اینجا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 421.54,
   "end": 427.14,
   "text": "اون بسم الله الرحمن الرحیم که همه قرآن درش جمع و همه قرآن هم همه علم حضرت حق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 427.14,
   "end": 431.36,
   "text": "که تنزل کرده در باش و اونم در نقطه تحت با.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 431.36,
   "end": 436.88,
   "text": "علامه فرمود که می‌خواید به شما بگم اون نقطه تحت با چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 436.88,
   "end": 440.86,
   "text": "می‌فرمود سوختن، حضور.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 440.86,
   "end": 442.76,
   "text": "البته ایشون می‌فرمود حضور.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 442.76,
   "end": 446.34,
   "text": "اون نقطه حضور عالم محضر خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 446.34,
   "end": 448.22,
   "text": "در محضر خدا معصیت نکنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 448.22,
   "end": 452.78,
   "text": "جمله معروف حضرت امام که نشانه‌ش سوختنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 452.78,
   "end": 457.16,
   "text": "یعنی اگر کسی نسوخت به حضور نرسیده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 457.16,
   "end": 459.52,
   "text": "حالا چه باید کرد که به حضور رسید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 459.52,
   "end": 465.36,
   "text": "فرمود مراقبت. این نسخه‌ای که امروز عرض کردیم خدمتتون و خیلی هم مهم بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 465.36,
   "end": 471.44,
   "text": "یعنی که انّی کم-- تمام درس و بحث‌های ارمان-- عرفان و حکمت عملی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 471.44,
   "end": 475.44,
   "text": "حضرت علامه رو جمع کنی تو همین جمله خلاصه می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 475.44,
   "end": 477.9,
   "text": "تو اصلاً باید سوخت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 477.9,
   "end": 480.04,
   "text": "حالا اگر گناه کردیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 480.04,
   "end": 484.14,
   "text": "بسوزیم که هم گناه هم اثرش از بین بره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 484.14,
   "end": 492.8,
   "text": "و اگر نه گناه نکردیم ان‌شاءالله اهل ثوابی، این سوختن ارتقای وجودی و ارتقای درجه و ثعه‌ی وجودی به تو می‌ده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 492.8,
   "end": 499.5,
   "text": "حالا بعضیا متأسفانه اینجا ما خیلی حرف داریم که جوابشون هم ان‌شاءالله میدم توی لایو جداگانه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 499.5,
   "end": 502.72,
   "text": "که متأسفانه تو فضای مجازی دیدم پر شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 502.72,
   "end": 505.34,
   "text": "اخیراً همین چند روز که یه آقایی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 505.34,
   "end": 510.36,
   "text": "که باز با کمال تأسف ایشون رو قاری قرآن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 510.36,
   "end": 514.1,
   "text": "حافظ قرآن و دکتر روانشناس معرفی می‌کنند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 514.1,
   "end": 518.78,
   "text": "شروع می‌کنه زیراب همین به این نحو و کیفیتی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 518.78,
   "end": 524.28,
   "text": "شیخ محدث قومی در مفاتیح شب قدر رو بیان کرده رو زدن و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 524.28,
   "end": 529.04,
   "text": "که آره کی گفته حالا شیخ عباس به زعم خودش گفته اینطوری قرآن سر بگیرید اینطوری--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 529.04,
   "end": 532.06,
   "text": "اصلاً کی گفته شب قدر شب گریه کردنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 532.06,
   "end": 534.0,
   "text": "یه حرف‌های زشت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 534.0,
   "end": 538.02,
   "text": "و بی‌اساس و بی‌علم، بدون علم، بدون بنا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 538.02,
   "end": 545.14,
   "text": "همینطوری باد هوا معذرت می‌خوام یه چیزی یه ارتعاشی تو هوا ایجاد کنه که بابا من حرف دارم برای زدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 545.14,
   "end": 550.44,
   "text": "متأسفانه اون آقایی هم که حرفای اینو گوش داده می‌گه من امروز یک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 550.44,
   "end": 555.42,
   "text": "تصور جدیدی از شب قدر پیدا کردم به جهت صحبت این آقای روانشناس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 555.42,
   "end": 558.18,
   "text": "آخه چیه تو یک کلمه حرف جدید شنیدی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 558.18,
   "end": 560.72,
   "text": "بعد به اسم روانشناسی و روان-- چی میگن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 560.72,
   "end": 563.94,
   "text": "روشنفکری بیا به خورد مردم بدی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 563.94,
   "end": 566.0,
   "text": "شیخ عباس این روایتو از کجا آورده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 566.0,
   "end": 570.98,
   "text": "شما ببینید را-- امم مفاتیح، دا-- همه رو قشنگ سند زده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 570.98,
   "end": 574.02,
   "text": "نمی‌دونم مصباح کف امی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 574.02,
   "end": 577.1,
   "text": "نمی‌دونم اقبال سید ابن طاووس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 577.1,
   "end": 580.54,
   "text": "یک یک همینجوری بهار مرحوم مجلسی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 580.54,
   "end": 582.28,
   "text": "همینطوری یک یک سند زده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 582.28,
   "end": 584.24,
   "text": "کی و اینا. اینا از کجا آوردن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 584.24,
   "end": 588.42,
   "text": "وقتی میریم می‌بینی همه نوشته قال الصادق، قال علی، قال رسول الله، قال امیر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 588.42,
   "end": 593.58,
   "text": "بابا اهل بیت شب قدر اینطوری ناله زدن، قرآن سر گرفتن، سوختن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 593.58,
   "end": 596.86,
   "text": "او می‌سوزه بعد من و تو نسوزیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 596.86,
   "end": 600.82,
   "text": "انقدر آدم بی‌غیرت بشه نسبت به مسائل دینی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 600.82,
   "end": 603.9,
   "text": "و بی پایه و اساس نظر بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 603.9,
   "end": 608.82,
   "text": "من از حرص می‌خورم از آدمایی که چهار تا کلام مطلب یاد می‌گیرن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 608.82,
   "end": 613.84,
   "text": "بعد سریع به اسم روشنفکری و مخصوصاً این عنوان روانشناسی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 613.84,
   "end": 621.52,
   "text": "که امروز خیلی بابه. بابا ما هم دانشگاه روانشناسی خوندیم به خدا این سیر معرفت نفس علامه یعنی همون روانشناسی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 621.52,
   "end": 626.02,
   "text": "معرفت نفس یعنی معرفت روان دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 626.02,
   "end": 631.44,
   "text": "و متأسفانه میان به خورد مردم میدن شب قدر شب شادی کردنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 631.44,
   "end": 633.4,
   "text": "این آقا با چه آب و تابی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 633.4,
   "end": 636.36,
   "text": "اون طرفم می‌شنید به به چه حرف قشنگی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 636.36,
   "end": 639.1,
   "text": "راست میگی شما. برای چی بشینم گریه کنم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 639.1,
   "end": 645.0,
   "text": "و چقدر حرف‌های بی‌اساس تو این وویس هست که حالا من می‌خوام جوابشو بدم در خصوص فقه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 645.0,
   "end": 647.28,
   "text": "در خصوص اسماء الهی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 647.28,
   "end": 649.08,
   "text": "و، و، و، و.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 649.08,
   "end": 651.22,
   "text": "خدا انشاالله عاقبتمون رو خیر کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 651.22,
   "end": 654.46,
   "text": "به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 654.46,
   "end": 657.26,
   "text": "اللهم صل علی محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 657.26,
   "end": 665.9,
   "text": "و آل محمد و عجل فرجهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}