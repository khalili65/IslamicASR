 "chapters": [
  {
   "index": 0,
   "title": "## آنچه پس از مرگ می‌ماند قلب است",
   "start": 0.26,
   "end": 20.34
  },
  {
   "index": 1,
   "title": "## حدیث صعب مستصعب؛ حاملان امر اهل‌بیت",
   "start": 20.34,
   "end": 341.74
  },
  {
   "index": 2,
   "title": "## الیه یصعد الکلم الطیب؛ عمل صالح و معارف",
   "start": 341.74,
   "end": 605.76
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.26,
   "end": 2.4,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 2.4,
   "end": 5.02,
   "text": "السلام علیک یا داعی الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 5.02,
   "end": 7.56,
   "text": "و ربانی ایات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 7.56,
   "end": 13.32,
   "text": "برای بعضی از عزیزان این سؤال مطرح شده بود که چرا ما بحث قلب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 13.32,
   "end": 21.62,
   "text": "حالا در قرآن رو به عنوان شصت نوع قلب حداقل در قرآن یه دو سالی هست به فضل الهی داریم ادامه میدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 21.62,
   "end": 23.78,
   "text": "من برای حجت برای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 23.78,
   "end": 27.24,
   "text": "عزیزان در جواب دو تا آیه رو براتون قضاوت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 27.24,
   "end": 31.82,
   "text": "به عنوان قضاوت خودتون در معرض نگاهتون قرار میدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 31.82,
   "end": 35.68,
   "text": "آیه دویست و هشتاد و سه بقره رو دقت بفرمایید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 35.68,
   "end": 37.92,
   "text": "که در خصوص همین موضوع چی میفرماید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 37.92,
   "end": 42.46,
   "text": "\"ولیتق الله ربه ولا تكتم الشهادة",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 42.46,
   "end": 44.64,
   "text": "ومن يكتمها فإنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 44.64,
   "end": 47.38,
   "text": "آثم قلب\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 47.38,
   "end": 51.22,
   "text": "اینجا میفرماید که اگر کسی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 51.22,
   "end": 53.84,
   "text": "کتمان شهادت بکنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 53.84,
   "end": 56.52,
   "text": "\"فإنه آثم قلب\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 56.52,
   "end": 60.34,
   "text": "کتمان شهادت گناه قلب حساب میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 60.34,
   "end": 63.3,
   "text": "یعنی قرآن اینجا داره خیلی صریح",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 63.3,
   "end": 72.02,
   "text": "جایگاه قلب رو بیان میکنه که گناه وقتی گناه هست که جایگاهش به قلب \"آثم قلب\" به قلب برگرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 72.02,
   "end": 77.94,
   "text": "در آیه دیگه‌ای که در سوره احزاب هست، آیه پنج میفرماید \"ولیس عليكم جناح",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 77.94,
   "end": 83.36,
   "text": "فيما أخطأتم به ولكن ما تعمدت قلوبكم\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 83.36,
   "end": 87.8,
   "text": "میفرماید که اگر شما یه خطایی ازتون سر بزنه، حالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 87.8,
   "end": 93.6,
   "text": "خطا کنید، اشتباهی به هر حال حتی گناهی ازتون سر بزنه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 93.6,
   "end": 97.6,
   "text": "در حالی که این خطا محسوب بشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 97.6,
   "end": 104.86,
   "text": "یعنی چی خطا محسوب بشه؟ تو قسمت بعدی جوابشو میده \"ولكن ما تعمدت قلوبكم\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 104.86,
   "end": 108.04,
   "text": "یعنی قلباً شما این کارو نکردی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 108.04,
   "end": 110.92,
   "text": "عمد قلبی نداشتی، نیت قلبی نداشتی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 110.92,
   "end": 113.66,
   "text": "این برات نوشته نمیشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 113.66,
   "end": 117.36,
   "text": "خیلی جالبه. چه در بحث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 117.36,
   "end": 119.2,
   "text": "عبادیات هم این چنینه‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 119.2,
   "end": 122.42,
   "text": "فرمودن خدا رحمت کنه مرحوم حضرت آیت الله زیابادی رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 122.42,
   "end": 127.02,
   "text": "کتابی دارن به نام راه‌های کنترل نفوذ شیطان در انسان که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 127.02,
   "end": 131.88,
   "text": "یادمه سه چهار سال پیش اینجا ما تدریس کردیم این کتابو تو چند ماه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 131.88,
   "end": 135.7,
   "text": "بین دو نماز داشتیم اینجا مراسم‌هایی یادش بخیر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 135.7,
   "end": 138.68,
   "text": "و کتاب شریفیه، خوبه بخونیدش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 138.68,
   "end": 143.94,
   "text": "بحث مبثوتی اونجا حضرت آیت الله زیابادی با آیات و روایات میاره که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 143.94,
   "end": 148.24,
   "text": "حتی عبادتی که از رو قلب با-- نباشد، خیری درش نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 148.24,
   "end": 151.18,
   "text": "یعنی شما نمازی بخونی، ذکری بگی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 151.18,
   "end": 154.74,
   "text": "چه میدونم هر، هر عبادتی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 154.74,
   "end": 157.84,
   "text": "که حتی قرآن بخونی بدون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 157.84,
   "end": 162.42,
   "text": "حضور قلب، مولا علی علیه الصلاة والسلام فرمود خیری درش نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 162.42,
   "end": 169.38,
   "text": "این جایگاه قلبه. یعنی اگر بعد وقتی هم که ما می‌میریم قبلاً عرض شده خدمت شما مقدمتا چندین جلسه پیرامون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 169.38,
   "end": 170.72,
   "text": "جایگاه قلب حرف زدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 170.72,
   "end": 173.32,
   "text": "ماهثله اونچه که برای ما می‌ماند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 173.32,
   "end": 176.54,
   "text": "بعد از مرگ قلب ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 176.54,
   "end": 181.56,
   "text": "هرچی که این قلب وضعیتش چگونه است، مریضه یا سالمه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 181.56,
   "end": 187.94,
   "text": "اونور مشخص میشه. ولی ما داریم اینجا الان بازنشانه می‌کنیم علائمشو بر اساس آیات قرآن بررسی می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 187.94,
   "end": 192.7,
   "text": "اصلاً ماهثله اونچه که از ما می‌مونه اینه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 192.7,
   "end": 196.8,
   "text": "و سخته که بالاخره الحمد لله اینجا هم رسانه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 196.8,
   "end": 199.04,
   "text": "ما باید متوجه باشیم چی میگیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 199.04,
   "end": 203.48,
   "text": "میگیم که آقا برای مردم حرف داشته باش برای گفتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 203.48,
   "end": 207.72,
   "text": "حرف محکم بزن. روایات رو درست بیان کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 207.72,
   "end": 210.26,
   "text": "درون مایه شو بریز بیرون رو آنتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 210.26,
   "end": 214.22,
   "text": "خب درون خودمون چی؟ در حالی که تو جمع ما الان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 214.22,
   "end": 219.88,
   "text": "فرهیختگانی نشستن. میدونم حتی عزیزانی هم که اخیراً از سفار تشریف آوردن الحمد لله اهل تحقیق‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 219.88,
   "end": 223.32,
   "text": "دیروز داشتیم تو صحبت می‌کردیم که راجع به سیر بحث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 223.32,
   "end": 228.36,
   "text": "معرفت نفس دیدیم یکی از عزیزان چه خوب قشنگ آگاهی داشته، کتاب‌هاشو خونده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 228.36,
   "end": 232.72,
   "text": "و بعضیا تشنه‌ن اصلاً دنبال این مباحث حکمی‌آن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 232.72,
   "end": 237.82,
   "text": "و ما وظیفه داریم عزیزان اگر همین طوری اونایی که میگن آقا یه حدیث بگو برو حاجی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 237.82,
   "end": 242.98,
   "text": "آقا حالا می‌خوای یه حدیث بگو برو در حالی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 242.98,
   "end": 244.84,
   "text": "آقا امام باقر-- این حدیث دو جور اومده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 244.84,
   "end": 247.72,
   "text": "امام باقر صلوات الله علیه فرموده \"إن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 247.72,
   "end": 251.24,
   "text": "حديثنا صعب مستصعب\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 251.24,
   "end": 257.4,
   "text": "امیر المؤمنین علیه الصلاة والسلام فرموده \"إن أمرنا صعب مستصعب\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 257.4,
   "end": 261.5,
   "text": "صعب به اون ااا حالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 261.5,
   "end": 265.72,
   "text": "مرکبی میگن که فراری، فراریه هی میره فرار میکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 265.72,
   "end": 271.56,
   "text": "مستصعب به اون اصطلاحاً مرکبی میگن که هیچکس سواری نمیده اصلاً.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 271.56,
   "end": 274.92,
   "text": "حالا چرا میگن؟ چرا به این صورت میگن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 274.92,
   "end": 277.9,
   "text": "دو جور ازش یاد کردن بزرگان در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 277.9,
   "end": 284.64,
   "text": "شرح این حدیث که حدیث ما خیلی پیچیده‌ست، سنگینه، دشواره، قامضه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 284.64,
   "end": 286.78,
   "text": "بعضیا گفتن اساساً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 286.78,
   "end": 294.98,
   "text": "اون صعب بودن در علمیت کلام اهل بیته یعنی اصلاً خیلی این علمیتش خیلی سنگینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 294.98,
   "end": 297.9,
   "text": "علم ثقیل و سنگینیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 297.9,
   "end": 302.64,
   "text": "بعضیا فرمودن نه پذیرشش سنگینه برگردوندن به ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 302.64,
   "end": 305.66,
   "text": "در هر حال شما ببینید چه اونجا که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 305.66,
   "end": 308.76,
   "text": "أمرنا و چه اونجا که حديثنا هر،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 308.76,
   "end": 313.44,
   "text": "هر دو حدیث میفرمایند سه دسته فقط حدیث ما رو برمی‌دارند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 313.44,
   "end": 316.54,
   "text": "\"لا يحتمله\" امام باقر فرموده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 316.54,
   "end": 319.6,
   "text": "امیرالمؤمنین فرموده \"لا يغر به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 319.6,
   "end": 325.38,
   "text": "إلا\" اول فرمودن نبی و مرسل تازه اونم نه همه انبیا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 325.38,
   "end": 329.32,
   "text": "انبیایی که رسالت داشتن تا ته حدیث ما رو میرن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 329.32,
   "end": 333.34,
   "text": "این بارو می‌تونن بردارن یا پذیرش قشنگی دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 333.34,
   "end": 337.38,
   "text": "بعد ملک مقربونند، نه هر ملکی‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 337.38,
   "end": 339.8,
   "text": "بعد عبد، حالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 339.8,
   "end": 344.18,
   "text": "در حدیث امام باقر میفرماید \"عبد مؤمن امتحن الله قلبه للإيمان\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 344.18,
   "end": 347.92,
   "text": "امیرالمؤمنین میفرماید \"عبد امتحن الله قلبه للإيمان\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 347.92,
   "end": 349.78,
   "text": "قلبش با ایمان امتحان شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 349.78,
   "end": 352.14,
   "text": "باید امتحان پس بده. اینطوری نیست که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 352.14,
   "end": 354.1,
   "text": "همینطوری بگذری از کنار حدیث.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 354.1,
   "end": 360.68,
   "text": "یعنی یک یک این احادیث و آیات رو ما در گوشه گوشه زندگیمون باید تجربه کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 360.68,
   "end": 365.52,
   "text": "خب قبل از اینکه تجربه عملی کنیم بیاییم کار نظری‌شو انجام بدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 365.52,
   "end": 368.06,
   "text": "همون کار نظری که در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 368.06,
   "end": 370.64,
   "text": "نظر شیخ طوسی بر اساس آیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 370.64,
   "end": 377.84,
   "text": "ولعصر عرض کردیم اون الا-- اونجا که تمایز قائل می‌شه می‌خواد بگه کیا اهل خسران نیستن الا الذین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 377.84,
   "end": 380.7,
   "text": "آمنوا. اول میگه آمنوا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 380.7,
   "end": 386.16,
   "text": "شیخ طوسی چی فرمود؟ فرمود اونایی که کامل شدن در قوای نظری‌شون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 386.16,
   "end": 391.2,
   "text": "نمی‌شه صرفاً مثلاً اهل عمل صالح بود بدون قوای نظری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 391.2,
   "end": 396.1,
   "text": "اصلاً نمی‌شه گرفتاری ما اینه که کار نظری نمی‌کنیم، کار فکری نمی‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 396.1,
   "end": 398.32,
   "text": "یه راست می‌ریم سراغ عملیات،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 398.32,
   "end": 402.12,
   "text": "عباديات. این گیر کار ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 402.12,
   "end": 405.14,
   "text": "اتفاقاً باید تا می‌تونیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 405.14,
   "end": 411.56,
   "text": "تا اونجایی که توان داریم و نفس داریم در پرورش قوای نظری‌مون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 411.56,
   "end": 417.12,
   "text": "واقعاً کار کنیم، تلاش کنیم تا این بکشه ما رو به سمت عمل و الا عمل‌مون توخالی می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 417.12,
   "end": 423.66,
   "text": "اتفاقاً تو همون کتاب انسان و قرآن از تعالم حسن‌زاده که این نظر شیخ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 423.66,
   "end": 426.04,
   "text": "طوسی رو مقدمه آورده بود،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 426.04,
   "end": 429.74,
   "text": "دیدم علامه اشاره کرده به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 429.74,
   "end": 432.64,
   "text": "کتاب نفحات صدر‌الدین قونوی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 432.64,
   "end": 435.9,
   "text": "اینم خدمتتون عرض کنم تبرکاً و بگذریم دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 435.9,
   "end": 438.5,
   "text": "خیلی جالبه و همین رو دوباره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 438.5,
   "end": 441.24,
   "text": "مرحوم ملاصدرا در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 441.24,
   "end": 443.92,
   "text": "آخر مرحله چهارم اسفارش میاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 443.92,
   "end": 448.28,
   "text": "ذیل آیه ی-- اونجا که می‌فرماید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 448.28,
   "end": 452.1,
   "text": "و الیه يسعد الكلم الطيب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 452.1,
   "end": 454.84,
   "text": "به سمت خدا صعود می‌کنه کلمه طيب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 454.84,
   "end": 462.64,
   "text": "این کلمه طيب چیه؟ حضرت علامه حسن‌زاده در این کتاب انسان و قرآنش اشاره می‌کنه به این فرمایش ملاصدرا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 462.64,
   "end": 465.2,
   "text": "می‌فرماید اونجا ملاصدرا میگه این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 465.2,
   "end": 468.3,
   "text": "روح مؤمنه. دائماً در حال صعوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 468.3,
   "end": 474.28,
   "text": "در و دیوار و زمین و آسمان و مردم و حیوانات و نباتات و جامعه هرچی رو می‌بینه داره صعود می‌کنه سمت خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 474.28,
   "end": 477.64,
   "text": "اینا رو آیات الله می‌بینن. درست شد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 477.64,
   "end": 481.9,
   "text": "این نگاه مؤمن. بعد حالا چی اینو رفعت می‌بخشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 481.9,
   "end": 483.76,
   "text": "ولعمل صالح",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 483.76,
   "end": 486.42,
   "text": "دقت بفرمایید کلمه، آیه قرآنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 486.42,
   "end": 489.34,
   "text": "ولعمل صالح يرفعه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 489.34,
   "end": 491.52,
   "text": "ظاهرش اینه که عمل صالح، عمل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 491.52,
   "end": 493.46,
   "text": "عمل صالح اینو رفعت می‌بخشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 493.46,
   "end": 496.78,
   "text": "این صعود مؤمن رو هی بالاتر می‌بره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 496.78,
   "end": 504.48,
   "text": "ملاصدرا، مرحوم صدر‌الدین قونوی، علامه حسن‌زاده ساده-- زاده آملی، شیخ طوسی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 504.48,
   "end": 507.98,
   "text": "عرض شود محی‌الدین عربی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 507.98,
   "end": 510.18,
   "text": "شیخ الرئیس چند تا براتون بگم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 510.18,
   "end": 514.4,
   "text": "همه اومدن بسیاری از مفسرین ما حتی اومدن گفتن این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 514.4,
   "end": 517.32,
   "text": "ولعمل صالح يرفعه رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 517.32,
   "end": 523.66,
   "text": "اون عمل صالح منظور قرآن که رفعت می‌بخشد به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 523.66,
   "end": 528.56,
   "text": "صعود روح مؤمن رو گرفتن به معارف نظری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 528.56,
   "end": 532.04,
   "text": "معارف، همین کاری که الان ما تو این چند دقیقه می‌کنیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 532.04,
   "end": 534.66,
   "text": "هر روز با هم سر این سفره می‌شینیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 534.66,
   "end": 537.84,
   "text": "یعنی زیر و رو کردن معارف.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 537.84,
   "end": 542.36,
   "text": "نه اینکه یه حدیث بگی، یه آیه بخونی، یه داستانی و بریم به امید خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 542.36,
   "end": 544.58,
   "text": "نه، این اصلاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 544.58,
   "end": 548.84,
   "text": "شوق و ذوق ما باید این باشه که بحث سلسله‌وار باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 548.84,
   "end": 553.08,
   "text": "یه موضوع رو بذاری زمین، پنج هزار تا منبر به قول",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 553.08,
   "end": 555.34,
   "text": "حضرت آیت الله سعمت آملی براش بری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 555.34,
   "end": 557.64,
   "text": "نه اینکه پنج هزار تا منبر بری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 557.64,
   "end": 560.22,
   "text": "تو هر منبری یه حدیث جدید و یه آیه جدید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 560.22,
   "end": 562.8,
   "text": "خب درون مایه این حدیث چی شد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 562.8,
   "end": 565.44,
   "text": "اساساً اینه که به درد من و شما می‌خوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 565.44,
   "end": 570.16,
   "text": "درون مایه آیات و روایات رو که حالا اصطلاحاً بهش می‌گن همون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 570.16,
   "end": 574.1,
   "text": "برهان. به یک معنا عرفان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 574.1,
   "end": 580.14,
   "text": "که علامه حسن‌زاده در رساله قرآن و برهان و عرفانش میگه همه این سه یک حقیقتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 580.14,
   "end": 582.4,
   "text": "ما دنبال یک حقیقتیم. قرآن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 582.4,
   "end": 587.3,
   "text": "برهان، عرفان. عرفان ما هم بدون-- شناخت ما هم بدون برهان نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 587.3,
   "end": 589.4,
   "text": "برهان ما هم پشتوانه عرفانی داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 589.4,
   "end": 591.36,
   "text": "همه این‌ها هم عین قرآنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 591.36,
   "end": 594.54,
   "text": "ما دنبال این هستیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 594.54,
   "end": 598.1,
   "text": "نه به تلف کنی. ایشالله که خدا عاقبتمون رو ختم به خیر کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 598.1,
   "end": 601.14,
   "text": "به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 601.14,
   "end": 605.76,
   "text": "اللهم صل على محمد و آل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}