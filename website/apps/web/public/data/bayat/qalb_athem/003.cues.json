 "chapters": [
  {
   "index": 0,
   "title": "## استفتای روزهٔ روزهای نخست؛ صوم حرجی",
   "start": 2.94,
   "end": 121.62
  },
  {
   "index": 1,
   "title": "وعده بود فرق اثم با ذنب و عصیان و سیئه و خطیئه گفته شود.",
   "start": 121.62,
   "end": 250.16
  },
  {
   "index": 2,
   "title": "## علم بدون عمل و حدیث جهل و علم",
   "start": 250.16,
   "end": 361.74
  },
  {
   "index": 3,
   "title": "## حکمت ۳۶۶ نهج‌البلاغه؛ علم مقرون به عمل",
   "start": 361.74,
   "end": 477.72
  },
  {
   "index": 4,
   "title": "## علم اسماء، حیرت و حکمت",
   "start": 477.72,
   "end": 662.36
  },
  {
   "index": 5,
   "title": "## جمع‌بندی: آثم القلب",
   "start": 662.36,
   "end": 714.34
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 2.94,
   "end": 6.0,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 6.0,
   "end": 10.52,
   "text": "السلام علیک یا داعی الله و ربانی ایات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 10.52,
   "end": 13.34,
   "text": "سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 13.34,
   "end": 22.66,
   "text": "استفتا شده از رهبر عزیزمون که اگر اونهایی که روز اول هستن خصوصا این دختر بچه ها اینا اذیت میشن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 22.66,
   "end": 25.72,
   "text": "میخوان روزه بگیرن سختشونه اینا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 25.72,
   "end": 29.22,
   "text": "چیکار کنن؟ اشکال نداره روزه‌شون رو بخورن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 29.22,
   "end": 34.34,
   "text": "آقا فرمودن که صرف اینکه حالا اذیت میشن که نمیشه واجب الهیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 34.34,
   "end": 41.24,
   "text": "اما اگر چنانچه ضرری متحمل اون‌ها میشه یعنی یه ضرری، یه مریضی براشون ایجاد میشه یا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 41.24,
   "end": 44.86,
   "text": "مش-- به مشقت میفتن، تحملش سخته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 44.86,
   "end": 47.94,
   "text": "اصطلاحا صوم حرجیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 47.94,
   "end": 51.86,
   "text": "سخته خیلی براشون. اونم نه اینکه اصلا روزه نگیرن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 51.86,
   "end": 57.64,
   "text": "آقا فرمودن روزه رو نیت کنن بگیرن جایی که دیگه بهشون سخت شد اونجا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 57.64,
   "end": 64.72,
   "text": "افطار کنن. ولی در عین حال قضای این روزه به گردنشون هست تا ماه سال،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 64.72,
   "end": 66.6,
   "text": "ماه رمضان سال بعد باید بگیرن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 66.6,
   "end": 69.6,
   "text": "این نکته رو توجه داشته باشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 69.6,
   "end": 73.8,
   "text": "می‌رسیم سراغ بحث قلب آثم با سه سه نقطه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 73.8,
   "end": 78.54,
   "text": "ورود به این بحث کردیم در قرآن بر اساس آیه دویست و هشتاد و سه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 78.54,
   "end": 81.92,
   "text": "سوره بقره صراحتا می‌فرماید \"فإنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 81.92,
   "end": 84.78,
   "text": "آثم قلب\". اینا دچار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 84.78,
   "end": 87.3,
   "text": "قلب آثمن. چرا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 87.3,
   "end": 89.5,
   "text": "چون پا گذاشتن روی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 89.5,
   "end": 92.1,
   "text": "حق. شهادتی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 92.1,
   "end": 94.44,
   "text": "باید بیان می‌کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 94.44,
   "end": 97.32,
   "text": "حالا یا نوشته‌ست یا به صورت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 97.32,
   "end": 105.12,
   "text": "بیان و صوتی هرچی که بوده این‌ها شهادت رو پوشوندن، شهادت ندادن یا اون شهادت نامه‌شون رو گم و گور کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 105.12,
   "end": 108.52,
   "text": "این یعنی می‌دونسته دیگه طرف از رو عمد گناه کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 108.52,
   "end": 112.54,
   "text": "لذا ارتباط میده این اثم رو، این گناه رو به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 112.54,
   "end": 119.52,
   "text": "قلب. البته وعده داده بودیم که فرق اثم رو با ذنب و عصیان و سیئه و خطیه و اینها عرض کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 119.52,
   "end": 122.6,
   "text": "ذنب یعنی ذنب از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 122.6,
   "end": 125.24,
   "text": "اصطلاحا ریشه‌ش از ذنب میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 125.24,
   "end": 128.68,
   "text": "در عرب به ذنب میگن دم حیوان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 128.68,
   "end": 131.48,
   "text": "از این جهت بهش میگن ذنب که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 131.48,
   "end": 138.78,
   "text": "پیامد داره. یعنی یا یک بلایی میاره، عقوبتی میاره یا یک توفیقی رو از انسان سلب می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 138.78,
   "end": 143.78,
   "text": "بعضی از گناهان اینطورین، عقوبت دارن یعنی ادامه دارن، دنباله دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 143.78,
   "end": 150.7,
   "text": "از این جهت به عصیان میگن عصیان که نافرمانیه که روبه‌روی طاعت قرار گرفته دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 150.7,
   "end": 153.56,
   "text": "یعنی در حقیقت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 153.56,
   "end": 157.6,
   "text": "طاعت الهی رو زمین میگذاره و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 157.6,
   "end": 161.24,
   "text": "خط قرمز الهی رو رد می‌کنه که al-- اساسا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 161.24,
   "end": 164.62,
   "text": "عصیان ریشه‌ش از عصاس،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 164.62,
   "end": 170.18,
   "text": "از چوب، چوب که مثلا میگن عصا از این جهت بهش میگن چوب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 170.18,
   "end": 174.06,
   "text": "از، اصلا از این جهت بهش میگن عصا که جنسش از چوبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 174.06,
   "end": 180.8,
   "text": "عصیان یعنی قلبش یه طوری میشه مثل سنگ و چوب میشه که خط قرمز الهی رو جرات می‌کنه رد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 180.8,
   "end": 185.36,
   "text": "رد کنه. سیئه از ریشه سوئه به معنای بدیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 185.36,
   "end": 191.26,
   "text": "هر چیز بدی رو حالا چه پیامدش بد باشه، چه خود عمل،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 191.26,
   "end": 198.1,
   "text": "چه صورت ظاهرش، چه باطنش بهش میگن سیئه که کسی این کارو کنه مسیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 198.1,
   "end": 201.92,
   "text": "خطیه که از ریشه‌ی خطاست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 201.92,
   "end": 207.08,
   "text": "و قبلا بحث کوچکی درباره‌ش داشتیم مقابل صواب با صاده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 207.08,
   "end": 209.62,
   "text": "یعنی محکم یه کار درستی رو انجام میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 209.62,
   "end": 212.98,
   "text": "خطا نه، اصلا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 212.98,
   "end": 214.9,
   "text": "یه حرکت زشتی رو انجام میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 214.9,
   "end": 220.74,
   "text": "اما مسئله اینجاست که فرقش با اونای دیگه اینه که خطا از رو عمد نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 220.74,
   "end": 224.0,
   "text": "اشتباها، سهوا یه خطایی کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 224.0,
   "end": 225.86,
   "text": "که حالا قرآن وعده داده که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 225.86,
   "end": 232.12,
   "text": "خطاها، خطاها یعنی اون‌هایی که از رو عمد نیست، قلب همراهی انسان نمی‌کنه، اینا رو خدا می‌بخشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 232.12,
   "end": 234.92,
   "text": "اما وقتی میگه آثمن قلبه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 234.92,
   "end": 239.3,
   "text": "این دلشون گرفتار اثم شده یعنی دیگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 239.3,
   "end": 241.98,
   "text": "آثمن قلبه. یعنی دیگه دل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 241.98,
   "end": 244.3,
   "text": "خواسته که گناه کنه، از رو عمد بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 244.3,
   "end": 250.16,
   "text": "یا به عبارتی میشه گفت علم به گناه داشته و گناه کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 250.16,
   "end": 254.44,
   "text": "حدیث عجیبیه. خیلی حدیث می‌فرماد حالا یادم نیست در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 254.44,
   "end": 257.94,
   "text": "اصول کافی مرحوم کلینی اعلا الله مقامه الشریف دیدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 257.94,
   "end": 260.82,
   "text": "در هر حال در مجامع روایی خوبمون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 260.82,
   "end": 265.26,
   "text": "که هفتاد هزار گناه از جاهل بخشیده میشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 265.26,
   "end": 270.2,
   "text": "در حالی که یک گناه از عالم هنوز بخشیده نشده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 270.2,
   "end": 272.72,
   "text": "جاهل. البته اون جهل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 272.72,
   "end": 274.52,
   "text": "در برابر عقل نیستا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 274.52,
   "end": 277.64,
   "text": "جهل در برابر علمه، نه در برابر عقله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 277.64,
   "end": 281.24,
   "text": "در برابر علمه. نمی‌دونه خبر نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 281.24,
   "end": 286.64,
   "text": "و اینکه انسان علم به گناه داشته باشه و گناه کنه این خیلی بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 286.64,
   "end": 295.38,
   "text": "تا جایی که در کتاب شریف جو-جواهر الثنیه فی احادیث القدسیه شیخ خراسانی می‌خوندم خیلی سال‌های پیش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 295.38,
   "end": 297.64,
   "text": "یه نهیب عجیبی خدا زده بود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 297.64,
   "end": 302.66,
   "text": "و ظاهرا حضرت موسی علی نبی و آله و عليه الصلاة والسلام کسی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 302.66,
   "end": 306.48,
   "text": "گناه می‌کند از یه بچه خجالت می‌کشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 306.48,
   "end": 309.74,
   "text": "بچه رو می‌بینه خجالت می‌کشه نمی‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 309.74,
   "end": 313.86,
   "text": "اما با اینکه می‌داند من خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 313.86,
   "end": 318.62,
   "text": "سميع و بصیرم، مضمون روایت این بود چون خیلی سال‌های پیش خوندم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 318.62,
   "end": 321.24,
   "text": "مضمونش اینه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 321.24,
   "end": 326.88,
   "text": "می‌داند، ببینید علم دارد که من می‌بینم، می‌شنوم، می‌بینم، گناه کند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 326.88,
   "end": 332.4,
   "text": "معذرت می‌خوام این رو من از-- خدا می‌فرماید منو از یک بچه کمتر فرض کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 332.4,
   "end": 334.22,
   "text": "یعنی منو به تمسخر گرفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 334.22,
   "end": 337.28,
   "text": "خیلی بده انسان بداند چیزی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 337.28,
   "end": 342.86,
   "text": "لذا در روایات زیادی اهل بیت علیهم الصلاة والسلام ما رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 342.86,
   "end": 346.38,
   "text": "نهیب زدن، ترسوندن از اینکه یه وقت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 346.38,
   "end": 349.24,
   "text": "علمی رو بهش عمل نکنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 349.24,
   "end": 356.98,
   "text": "توجه داشته باشید در حکمت سیصد و شصت و شش نهج البلاغه در لزوم عمل به دانسته ها امیرالمؤمنین چنین فرمودند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 356.98,
   "end": 361.26,
   "text": "\"العلم مقرون بالعمل\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 361.26,
   "end": 367.08,
   "text": "اساسا علم و عمل هم‌نشین هم‌ند، همراه هم‌ند، قرین هم‌ند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 367.08,
   "end": 369.8,
   "text": "فمن علم عمل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 369.8,
   "end": 373.72,
   "text": "پس هر کسی که دانست باید عمل کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 373.72,
   "end": 377.94,
   "text": "یعنی در حقیقت به اونچه که دانسته باید اون دانسته شو پیاده کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 377.94,
   "end": 380.46,
   "text": "والعلم يهتف بالعمل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 380.46,
   "end": 383.34,
   "text": "يهتف، خاطف، خاطف،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 383.34,
   "end": 385.92,
   "text": "عرب‌ها به تلفن مثلاً می‌گن حاطف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 385.92,
   "end": 389.46,
   "text": "که فقط صدا داره. میگه علم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 389.46,
   "end": 392.38,
   "text": "می‌خواند صدا می‌زنه عمل رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 392.38,
   "end": 395.54,
   "text": "بلا می‌فرماید. فإن أجابه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 395.54,
   "end": 398.08,
   "text": "اگه جوابشو دادی این علم می‌مونه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 398.08,
   "end": 402.58,
   "text": "برای تو می‌مونه. وإلا، وإلا ارتحل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 402.58,
   "end": 408.12,
   "text": "عنه اگر جواب ندادی، اگه عمل نکردی به علمت ارتحل عنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 408.12,
   "end": 411.86,
   "text": "این رحل اقامت می‌گذنه میره یه جای دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 411.86,
   "end": 414.88,
   "text": "رحل اقامت می‌گذریند مثل اینکه شما راهل می‌شی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 414.88,
   "end": 416.94,
   "text": "راهل یعنی میری دیگه برنگردی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 416.94,
   "end": 420.64,
   "text": "اگه مسافر باشی فرق مسافر و راهل رو قبلاً گفتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 420.64,
   "end": 422.98,
   "text": "اگر س-- مسافر باشی میری که برگردی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 422.98,
   "end": 427.78,
   "text": "قصدت برگشتنه. قصد توطن هم حتی بکنی میخوای برگردی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 427.78,
   "end": 431.86,
   "text": "اما در راهل نه، میری که برنگردی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 431.86,
   "end": 437.06,
   "text": "جالبه أن الراحل قريب المسافة تو دعای ابوحمزه باید باشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 437.06,
   "end": 442.58,
   "text": "که راهل به تو یعنی کسی که قصد کرده بیاد به سوی تو و دیگه برنگرده چنین کسی راهش نزدیکه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 442.58,
   "end": 448.3,
   "text": "میگن ظاهر امام حسین باید قصد رحل کنه، راهل باشه نه مسافر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 448.3,
   "end": 452.8,
   "text": "حالا اینجا عجیبه ببین می‌خوایم حالا این عبارت رو بشکافیم این توضیح رو دادیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 452.8,
   "end": 456.48,
   "text": "وإلا و اگر عمل نکنه به علمش ارتحل عنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 456.48,
   "end": 463.0,
   "text": "اون علم راهل می‌شه. یعنی رحل اقامت می‌گذریند به جای دیگر و دیگه بشین تا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 463.0,
   "end": 465.58,
   "text": "صبح دولتش بدمد. این علم رفت دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 465.58,
   "end": 469.6,
   "text": "العلم نور يقذفه الله في قلب من يشاء.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 469.6,
   "end": 474.28,
   "text": "علم نوره. در قلبی که ظلمت گرفته هیچوقت جا نمی‌گیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 474.28,
   "end": 476.98,
   "text": "لا يمسه إلا المتحرون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 476.98,
   "end": 485.06,
   "text": "و اساساً اولین عالم دنیا، اولین معلم دنیا، اصلاً ع-- ما قبلاً ثابت کردیم علم خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 485.06,
   "end": 489.04,
   "text": "خدا علم است. اولین معلمم خود حضرت حق است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 489.04,
   "end": 493.44,
   "text": "علم ببینید و علم، علم، معلم اول خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 493.44,
   "end": 496.76,
   "text": "علم آدم الأسماء كلها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 496.76,
   "end": 503.8,
   "text": "همه چی رو که حالا حضرت علامه حسن زاده می‌فرمودند معنای بخواهید معنای، معنای باطنی این ه--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 503.8,
   "end": 506.9,
   "text": "آیه رو بفهمید به جای اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 506.9,
   "end": 511.76,
   "text": "بر اساس روایات می‌فرمونن تو حکمت به جای اون اسما اشیا بگذارید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 511.76,
   "end": 517.1,
   "text": "وعلم آدم الأشياء كلها یعنی همه چیزو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 517.1,
   "end": 524.38,
   "text": "هر چیزی که ماسوی الله هست که این اسما در حقیقت ظهور و بروز حضرت حق‌اند دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 524.38,
   "end": 526.74,
   "text": "شما هم اسم اللهی منم اسم اللهم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 526.74,
   "end": 532.16,
   "text": "یه زمین و آسمان و پشه و حیوان و هرچی که فرض کنید همه اسماء الله‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 532.16,
   "end": 537.98,
   "text": "یعنی همین اشیا. جالبه که پیغمبر به خدا یه جا میگه رب زدني علما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 537.98,
   "end": 541.64,
   "text": "خدایا علمم رو زیاد کن. یه جا می‌فرماید رب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 541.64,
   "end": 548.9,
   "text": "زدني فيك تحيرا نشون میده که علم تحيراور است انقدر که نظام احسن عالم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 548.9,
   "end": 550.96,
   "text": "با عظمت خلق شده است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 550.96,
   "end": 554.38,
   "text": "یه جا دیگه می‌فرماید رب یا اللهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 554.38,
   "end": 556.94,
   "text": "ارني نشونم بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 556.94,
   "end": 559.76,
   "text": "چی رو نشونم بده؟ الأشياء",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 559.76,
   "end": 566.0,
   "text": "كما هي. رب یا اللهم ارني الأشياء كما هي.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 566.0,
   "end": 571.6,
   "text": "اشیا رو اونطور که هستن به من نشون بده نه اینطور که من چشمم داره می‌بینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 571.6,
   "end": 573.74,
   "text": "یعنی باطن اشیا حقیقت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 573.74,
   "end": 578.74,
   "text": "اشیا. یعنی همینطور که داری می‌بینی ظاهرشو که می‌بینی باطنشو هم ببینی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 578.74,
   "end": 583.18,
   "text": "این بله فیک تحيرا. تحيرا آور-- تحیر هم میاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 583.18,
   "end": 585.7,
   "text": "اما در صورتی که قصد عمل باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 585.7,
   "end": 588.42,
   "text": "اگر قصد عمل نباشد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 588.42,
   "end": 593.9,
   "text": "و اساساً خیلی جالبه اینجا که پیغمبر می‌فرماید رب اللهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 593.9,
   "end": 596.96,
   "text": "ارني اینجا که میگم رب یا اللهم چون دو جورش همه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 596.96,
   "end": 601.16,
   "text": "اللهم ارني الأشياء كما هي.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 601.16,
   "end": 604.08,
   "text": "اونطور که باطن این اشیا هست به من نشون بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 604.08,
   "end": 610.04,
   "text": "اینو میگن همون علم حکمت که ما دو سالی هست سر سفره‌شیم تو این نمازخونه بحث‌هامون رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 610.04,
   "end": 616.12,
   "text": "تو این قید قرار دادیم تو این رنج و رو این ریل قرار دادیم بر اساس نظر حضرت علامه این حکمته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 616.12,
   "end": 621.6,
   "text": "که دیروز عرض کردیم که پیغمبر فرمود أنا مدينة الحكمة وهي الجنة.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 621.6,
   "end": 623.82,
   "text": "اصلاً حکمت همون بهشته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 623.82,
   "end": 627.32,
   "text": "بهشت چیز عجیبی نیست. چشمت باز می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 627.32,
   "end": 630.16,
   "text": "اینه. چشمت باز می‌شه به ملکوت عالم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 630.16,
   "end": 633.14,
   "text": "همین ملک رو ملکوتش رو می‌بینی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 633.14,
   "end": 635.68,
   "text": "همین عالم رو باطن‌ش رو می‌بینی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 635.68,
   "end": 641.12,
   "text": "این معنای رفتن از این عالمه و به بهشت رسیدنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 641.12,
   "end": 645.4,
   "text": "اگر کسی تو همین جا چشمش باز شد موت قبل ان تموت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 645.4,
   "end": 648.2,
   "text": "چشمش باز شد باطن رو دید،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 648.2,
   "end": 652.42,
   "text": "اون موقع به-- تو همین جا وارد بهشت شده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 652.42,
   "end": 657.26,
   "text": "رفته به بهشت و ملکوت همین ملک رو داره می‌بینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 657.26,
   "end": 659.88,
   "text": "مرگ همینه چیزی غیر از این نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 659.88,
   "end": 664.9,
   "text": "اگر کسی خلاصه مطلب جمع‌بندی می‌کنم، اگر کسی بداند،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 664.9,
   "end": 668.38,
   "text": "ببیند، بچشد که دیگه بدتر،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 668.38,
   "end": 672.54,
   "text": "بچشد، مس کند، لمس کند، حس کند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 672.54,
   "end": 676.06,
   "text": "حقایق رو، اشیا رو، اسما رو،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 676.06,
   "end": 682.64,
   "text": "علوم و اسرار نظام هستی رو بعد بر علیه اونا عمل کند وای به حالش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 682.64,
   "end": 685.98,
   "text": "اینجا قرآن می‌فرماید آثم القلب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 685.98,
   "end": 691.64,
   "text": "چنین کسی دچار از عمد گناه عمدی شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 691.64,
   "end": 696.18,
   "text": "والله بما تعملون علیم و اونچه که عمل می‌کنید خدا بهش آگاهه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 696.18,
   "end": 697.74,
   "text": "یه روزی هم به روختون می‌کشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 697.74,
   "end": 702.86,
   "text": "ان‌شاءالله که عاقبتمون ختم بخیر بشه به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 702.86,
   "end": 705.22,
   "text": "اللهم صل على",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 705.22,
   "end": 714.34,
   "text": "محمد وآل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}