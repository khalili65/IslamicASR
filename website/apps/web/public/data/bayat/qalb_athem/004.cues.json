 "chapters": [
  {
   "index": 0,
   "title": "## ادامهٔ پیوند علم و قلب آثم",
   "start": 78.84,
   "end": 143.92
  },
  {
   "index": 1,
   "title": "## از علم فکری تا شهود قلبی",
   "start": 143.92,
   "end": 256.98
  },
  {
   "index": 2,
   "title": "## شیطان تا عقل نمی‌رسد",
   "start": 256.98,
   "end": 313.06
  },
  {
   "index": 3,
   "title": "## نمونهٔ امام هادی و اعتراض عموزادگان",
   "start": 313.06,
   "end": 363.04
  },
  {
   "index": 4,
   "title": "## رفتار پیامبر با اهل بدر",
   "start": 363.04,
   "end": 680.62
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.28,
   "end": 3.56,
   "text": "کسانی که روزه‌ای گردنشون بوده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 3.56,
   "end": 10.22,
   "text": "از سال قبل، یک سال یعنی روزه قضا گردن داشتن، یک سال فرصت داشتن که این روزه رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 10.22,
   "end": 15.16,
   "text": "بگیرن و اگر عذر باقی مونده براشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 15.16,
   "end": 18.26,
   "text": "تا این ماه مبارک رمضان که امسال رسید،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 18.26,
   "end": 21.92,
   "text": "مریضی اینا براشون باقی موند نتونستن بگیرن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 21.92,
   "end": 24.86,
   "text": "الان باید کفاره‌ش رو بدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 24.86,
   "end": 28.08,
   "text": "بعضیا میگن چیکار می‌کنن؟ جلوتر میخوان کفاره رو بدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 28.08,
   "end": 31.44,
   "text": "این اشکال داره. مثلا الان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 31.44,
   "end": 35.02,
   "text": "این چند روزو نتونسته روزه بگیره به جهت مریضی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 35.02,
   "end": 38.58,
   "text": "میخواد همین الان کفاره روزه نگرفتنشو بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 38.58,
   "end": 40.4,
   "text": "این که طور که نمیشه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 40.4,
   "end": 48.38,
   "text": "شما الان روزه نگرفتی به جهت مریضی این گردنته تا ماه مبارک رمضان سال بعد وقت داری که چیکار کنی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 48.38,
   "end": 52.24,
   "text": "قضاشو بگیری. اگر عذر بر تو باقی ماند،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 52.24,
   "end": 54.76,
   "text": "مریضیت انشاالله خدا شفا بده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 54.76,
   "end": 59.86,
   "text": "برطرف نشد تا ماه بعد، تا سال بعد، ماه رمضان سال بعد دیگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 59.86,
   "end": 62.0,
   "text": "قضا از گردنت ساقط میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 62.0,
   "end": 64.32,
   "text": "دیگه حکم قضا نداری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 64.32,
   "end": 66.42,
   "text": "صرفا باید چیکار کنی؟ کفاره بدی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 66.42,
   "end": 69.56,
   "text": "اون موقع، اون نیست. یعنی سال بعد باید بدی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 69.56,
   "end": 73.7,
   "text": "اونم به نرخ اون روز بدی، نه امروز.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 73.7,
   "end": 78.84,
   "text": "اینو توجه داشته باشید. نکته‌ای هم عرض کنم پیرامون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 78.84,
   "end": 83.18,
   "text": "ادامه بحث جلسه پیشمون که نیمه کار مونده بود در خصوص",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 83.18,
   "end": 88.64,
   "text": "ارتباط علم با مسئله قلب که ما اهمیت علم رو عرض کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 88.64,
   "end": 95.02,
   "text": "اگر کسی میخواد از گناه قلبی نجات پیدا کنه چون ما بحثمون تو قلب عاصمه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 95.02,
   "end": 98.58,
   "text": "فإنه عاصم قلب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 98.58,
   "end": 101.74,
   "text": "اینا گرفتار قلب گناهکار میشن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 101.74,
   "end": 106.28,
   "text": "که عمداً گناه میکنه. علت اینکه قلب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 106.28,
   "end": 111.72,
   "text": "از روی نیت گناه میکنه نداشتن معرفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 111.72,
   "end": 115.02,
   "text": "البته نداشتن معرفت شهودی قصداً.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 115.02,
   "end": 119.8,
   "text": "معرفت شهودی یعنی قلبی چون جایگاه شهود تو قلبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 119.8,
   "end": 124.58,
   "text": "اما کسی که معرفت شهودی ندارد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 124.58,
   "end": 128.54,
   "text": "چنین کسی یه ضعف دیگه‌ای باعث شده که گر--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 128.54,
   "end": 130.32,
   "text": "به معرفت شهودی نرسیده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 130.32,
   "end": 133.18,
   "text": "اونم معرفت فکری‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 133.18,
   "end": 136.24,
   "text": "یعنی اون علت مؤده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 136.24,
   "end": 140.38,
   "text": "نه تامه. علت کمک کننده به رسیدن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 140.38,
   "end": 142.7,
   "text": "مع-- به معارف شهودی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 142.7,
   "end": 148.22,
   "text": "علم فکریه. کارهایی که ما داریم میکنیم از جهت حالا مطالعاتی، بحث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 148.22,
   "end": 151.8,
   "text": "خ-- نه این منبرهای متعارف خطابی اقناعی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 151.8,
   "end": 156.74,
   "text": "که میریم واسه یه داستان میگیم، میگیم گناه نکن بر اساس این داستان، اینطوری نه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 156.74,
   "end": 160.78,
   "text": "سلسله درس، بحث معرفتی، حکمت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 160.78,
   "end": 162.92,
   "text": "عرفان، این‌ها منتج میشه به چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 162.92,
   "end": 165.62,
   "text": "این علم فکری منتج میشه به علم شهودی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 165.62,
   "end": 170.48,
   "text": "قبلاً این سیر رو گفتیم که اینو دقت کنید این فرمول رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 170.48,
   "end": 175.16,
   "text": "ما قبلاً گفتیم در سیر معرفت نفس ما لایه به لایه‌ایم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 175.16,
   "end": 177.92,
   "text": "در درون خودمون عوالم داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 177.92,
   "end": 184.52,
   "text": "از اون پنج حس ظاهری بگیر برو به حس مشترک و داخل باطن وجودیتو بررسی کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 184.52,
   "end": 187.36,
   "text": "وقتی شما علمی رو یاد میگیری،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 187.36,
   "end": 189.48,
   "text": "علم رو اخذ می‌کنی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 189.48,
   "end": 196.06,
   "text": "اول از همه قوه خیالت بررسی می‌کنه حقیقت این علم رو که شما اخذ کردی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 196.06,
   "end": 197.94,
   "text": "بعد از قوه خیالت، قوه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 197.94,
   "end": 201.82,
   "text": "وهم این رو می‌گیره. حالا پردازش این‌ها چگونه است؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 201.82,
   "end": 205.46,
   "text": "قبلاً توضیح دادیم. می‌تونید رجوع کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 205.46,
   "end": 208.68,
   "text": "بعد از قوه وهم، قوه عقله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 208.68,
   "end": 212.78,
   "text": "اگر کسی تونست دقت کنید اون فهمش رو،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 212.78,
   "end": 216.82,
   "text": "علم فکریش رو برسونه به حوزه عقل،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 216.82,
   "end": 222.2,
   "text": "البته عقل خالص، عقلی که مشوبه به وهم نشده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 222.2,
   "end": 224.6,
   "text": "اگر کسی تا اینجا اومد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 224.6,
   "end": 227.04,
   "text": "چنین کسی سیر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 227.04,
   "end": 231.8,
   "text": "علم نظری، عرفان نظری، حکمت نظری که از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 231.8,
   "end": 239.54,
   "text": "میشه گفت واجبات سیر و سلوک ماست و بدون اون ما نمی‌تونیم به سیر و سلوک واقعی برسیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 239.54,
   "end": 246.06,
   "text": "حالا میگن العلم هو الحجاب الاكبر حدیث داریم حضرت امام فرمودن چاره‌ای از رفتن در این حجاب نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 246.06,
   "end": 250.5,
   "text": "اینایی که پس می‌زنن علمو از جهت اینکه میگن بابا حجابه یا نمی‌فهمین،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 250.5,
   "end": 253.42,
   "text": "اینا دارن به خودشون اهانت می‌کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 253.42,
   "end": 255.9,
   "text": "اگر کسی توانست اینو به لایه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 255.9,
   "end": 259.62,
   "text": "عقل رسوند دیگه شیطان تا ناحیه عقل نمی‌تونه بیاد بالا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 259.62,
   "end": 261.82,
   "text": "قبلاً بحث شده تا وهم میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 261.82,
   "end": 266.94,
   "text": "چنین کسی علم فکریش، در جهت علم فکریش موفق شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 266.94,
   "end": 269.7,
   "text": "اما باز احتمال خطا ازش هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 269.7,
   "end": 272.8,
   "text": "چرا؟ به جهت اینکه یه لایه پایین،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 272.8,
   "end": 275.5,
   "text": "اِاِاِ میشه گفت باطن‌تر یا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 275.5,
   "end": 279.5,
   "text": "از جهت رتبه‌ای بالاتر از عقل، قلب ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 279.5,
   "end": 281.88,
   "text": "اون سر ماست. حالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 281.88,
   "end": 285.84,
   "text": "از جهت عرفانی. ضمیر ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 285.84,
   "end": 288.32,
   "text": "قلب جایگاه شهوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 288.32,
   "end": 290.9,
   "text": "اونچه که فکر، عقل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 290.9,
   "end": 293.68,
   "text": "فهمید رو اگر داد به قلب،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 293.68,
   "end": 298.0,
   "text": "نکته اینجاست، انتقالش داد به حوزه قلب،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 298.0,
   "end": 301.82,
   "text": "ادراک، شهود، اونموقع اونچه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 301.82,
   "end": 307.0,
   "text": "فهمیده حالا یا به عبارتی از جهت علم فکری بهش رسیده رو می‌چشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 307.0,
   "end": 310.5,
   "text": "مزش رو می‌چشه. حالا تو هزار بار بیا برای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 310.5,
   "end": 315.46,
   "text": "یه کسی بحث فکری انجام بده در خصوص جایگاه امام حسین،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 315.46,
   "end": 320.62,
   "text": "تا ارتباط قلبی برقرار نشه، نمی‌چشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 320.62,
   "end": 327.72,
   "text": "هنر اینجور مباحث اینه که انسان سعی کنه با تمرین و ممارست اینو برسونه به حوزه قلب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 327.72,
   "end": 331.3,
   "text": "از عقل بکشونه ببره به حوزه قلب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 331.3,
   "end": 335.52,
   "text": "اینجا هم خدا میگه قلب گناهکار شد گرفتار میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 335.52,
   "end": 340.92,
   "text": "قلب، قلب اگر گناهکار شد گرفتار-- میشه ق-- میگه فإنه عاصم قلب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 340.92,
   "end": 345.42,
   "text": "قلب گرفتار شده. اگر می‌خوایم حالا یه نتیجه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 345.42,
   "end": 351.58,
   "text": "یه روایت هم شیرین به عنوان چاشنی بحث عرض کنم از احتجاج طبرسی رحمة الله علیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 351.58,
   "end": 354.3,
   "text": "اگر کسی نتیجه تا اینجا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 354.3,
   "end": 356.38,
   "text": "معارف فکریش رو،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 356.38,
   "end": 359.26,
   "text": "علوم نظریش رو توانست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 359.26,
   "end": 363.04,
   "text": "بکشونه به حوزه قلب با تمرین و ممارست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 363.04,
   "end": 367.86,
   "text": "با حرف شنیدن که از تعالمه از سنین زوده بارها و بارها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 367.86,
   "end": 370.02,
   "text": "فرمودن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 370.02,
   "end": 378.18,
   "text": "ما هم اینجا بارها گفتیم که نباتات با هرس مؤدب میشن، حیوانات با شلاق، انسان با حرف شنیدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 378.18,
   "end": 380.62,
   "text": "چرا ما فراری‌ایم از حرف شنیدن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 380.62,
   "end": 385.02,
   "text": "اونم از حکمت که \"ادع إلى سبيل ربك بالحكمة",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 385.02,
   "end": 387.8,
   "text": "والبدلة الحسنة\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 387.8,
   "end": 394.38,
   "text": "اگر کسی با تمرین و مبارزه این علوم فکری رو وارد حوزه قلبش کرد این مصون می‌مونه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 394.38,
   "end": 397.56,
   "text": "یعنی می‌تونه خودش رو از گناهان حفظ کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 397.56,
   "end": 399.68,
   "text": "لذا بالاترین کاری هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 399.68,
   "end": 406.74,
   "text": "که تو این ماه مبارک رمضان پیغمبر توصیه کرده به امیرالمؤمنین شنیدید دیگه تو مفاتیح شب‌باز رحمت‌الله‌علیه آورده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 406.74,
   "end": 409.44,
   "text": "\"الورع عن محارم الله\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 409.44,
   "end": 412.54,
   "text": "اونم نه تقوا بلکه ورع یعنی شدت تقوا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 412.54,
   "end": 416.14,
   "text": "بهترین کار اینجاست. اما تقوا، رفقا، عزیزان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 416.14,
   "end": 422.52,
   "text": "تقوا از انسان سر نمی‌زنه مگر اینکه علم فکری واهر-- وارد بر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 422.52,
   "end": 433.2,
   "text": "قلب انسان بشود و انسان از سرگشتگی و حیرت نجات پیدا بکنه و هیچ چاره‌ای هم از علم فکری و عقلی نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 433.2,
   "end": 438.66,
   "text": "یعنی اگر کسی از تدبر، از تأمل، از تعقل فاصله بگیره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 438.66,
   "end": 445.62,
   "text": "بشینه تا صبح دولتش بده بگه یه شب راه صد ساله میرم و قلبم روش-- این حرفا نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 445.62,
   "end": 447.8,
   "text": "این حرفا نیست. باید با علم فکری رفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 447.8,
   "end": 452.96,
   "text": "کسی که صرفاً با ذوق و قلب میره جلو یه روزی کله پا میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 452.96,
   "end": 456.64,
   "text": "مگر استثناء که حالا اونم روش بحث داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 456.64,
   "end": 460.92,
   "text": "در-- این حالا می‌خوام در جایگاه عظمت و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 460.92,
   "end": 468.24,
   "text": "ج-- عرض کنم اهمیت این علم فکری و کار فکری کردن تا رسیدن به قلب،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 468.24,
   "end": 475.32,
   "text": "به عنوان یه نمونه رفتار امام هادی صلوات الله علیه رو براتون با یکی از دوستانش بگم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 475.32,
   "end": 478.98,
   "text": "روایت رو خودم اخیراً دیدم در کتاب احتجاج مرحوم طبرسی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 478.98,
   "end": 484.7,
   "text": "خیلی شیرین. امام هادی نشسته بود، علویون، هاشمیان، اینا همه جمع.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 484.7,
   "end": 486.86,
   "text": "بنی‌هاشم فامیلای حضرت دورش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 486.86,
   "end": 491.24,
   "text": "یه آقایی وارد شد که شاگردان حضرت بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 491.24,
   "end": 494.02,
   "text": "کار فکری و خلاصه می‌کرد، اهل علم بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 494.02,
   "end": 496.24,
   "text": "وقتی حضرت چیزی می‌گفت این سریع می‌نوشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 496.24,
   "end": 498.64,
   "text": "دنباله، دنباله بحث رو می‌گرفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 498.64,
   "end": 502.16,
   "text": "همین‌جوری نبود از این گوش بشنوه از اون گوش در کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 502.16,
   "end": 505.92,
   "text": "تا این وارد شد حضرت دقت بفرمایید آورد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 505.92,
   "end": 512.36,
   "text": "تو بهترین جا بغل خودش، جای بهتر از اون جایی که فامیلای خودش نشسته بودن حضرت جا داد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 512.36,
   "end": 514.58,
   "text": "مثلاً پسرعموش کجا نشسته بود،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 514.58,
   "end": 517.94,
   "text": "پسرخاله‌اش فلان، اینا نه. آورد بهترین جا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 517.94,
   "end": 521.52,
   "text": "جالبه که علویون، فامیلای حضرت اعتراض کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 521.52,
   "end": 525.66,
   "text": "گفتن آقا چرا این کارو کردی؟ مگه ایشون کیه که بر ما ترجیحش دادی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 525.66,
   "end": 527.78,
   "text": "ببینید حضرت اشاره به چه آیه‌ای می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 527.78,
   "end": 532.26,
   "text": "آیه سوره مجادله. جواب اینا رو می‌گه من با قرآن بهتون جواب میدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 532.26,
   "end": 535.26,
   "text": "\"يرفع الله الذين آمنوا منكم\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 535.26,
   "end": 539.86,
   "text": "خدا رفعت می‌ده، بالا می‌بره از شما اوناییو که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 539.86,
   "end": 543.56,
   "text": "اهل ایمانن. اما \"والذين أوتوا العلم درجات\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 543.56,
   "end": 547.06,
   "text": "اونایی که داده شده بهشون علم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 547.06,
   "end": 550.1,
   "text": "أوتوا، خدا علم رو بهشون می‌ده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 550.1,
   "end": 553.38,
   "text": "درجات. درجات مال اوناست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 553.38,
   "end": 556.36,
   "text": "جالبه که پیغمبر هم یه همچین کاری می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 556.36,
   "end": 560.1,
   "text": "قربونش بریم. اینو تو تفسیر نور آقای قرائتی هست اونم بگم و دیگه تمام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 560.1,
   "end": 565.0,
   "text": "خسته نشید. پیغمبر هم یه روز نشسته بودن در میان اصحابشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 565.0,
   "end": 569.46,
   "text": "حالا هم مهاجرین بودن هم انصار بودن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 569.46,
   "end": 572.26,
   "text": "بعد یه کسی میگن که از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 572.26,
   "end": 575.26,
   "text": "یه جمعیتی از بدریون اومدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 575.26,
   "end": 577.84,
   "text": "این بدریون رو پیغمبر خیلی بهشون علاقه داشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 577.84,
   "end": 580.36,
   "text": "اولین کسایی که جنگیده بودن و خلاصه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 580.36,
   "end": 584.62,
   "text": "در میان این‌ها اهل علم زیاد بودن، در میان بدریون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 584.62,
   "end": 587.18,
   "text": "از همون اول پیغمبر گوش پیچونده بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 587.18,
   "end": 589.98,
   "text": "گفته بود می‌خوای اهل عبادت باشی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 589.98,
   "end": 594.98,
   "text": "\"وما خلقت الجنّ– جنّ والانس الا ليعرفون ألي عب–",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 594.98,
   "end": 598.64,
   "text": "ليعبدون ألي يعرفون\". اون عبادت عین معرفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 598.64,
   "end": 601.34,
   "text": "هرکس به سمت معرفت رفت عبادتش هم قبوله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 601.34,
   "end": 605.1,
   "text": "از همون موقع بدریون دنبال علم هم رفتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 605.1,
   "end": 611.0,
   "text": "اشتباهی که بعضی بچه رزمنده‌های ما کردن صرفاً جنگ و جهاد، از درس غافل شدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 611.0,
   "end": 617.02,
   "text": "بعد تا اینا وارد شدن جالبه پیغمبر حتی چند نفر رو روایت می‌گه بلند کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 617.02,
   "end": 619.8,
   "text": "از بین کیا؟ مهاجرین و انصار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 619.8,
   "end": 622.0,
   "text": "گفت شما بشینید اینجا، شما بشینید اینجا، شما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 622.0,
   "end": 624.08,
   "text": "اینا رو بلند کرد، اونا رو. اگه یکی از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 624.08,
   "end": 626.42,
   "text": "شما رو یه همچین کاری بکنه چه برخوردی می‌کنید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 626.42,
   "end": 628.98,
   "text": "چقدر به هم می‌ریزیم؟ اونا هم شاکی شدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 628.98,
   "end": 631.92,
   "text": "ناراحت شدن. پیغمبر فرمود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 631.92,
   "end": 637.28,
   "text": "اشاره به همین آیه کرد. همین آیه‌ای که الان خوندیم \"والذين أوتوا العلم درجات\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 637.28,
   "end": 641.66,
   "text": "اینا اهل علمن و اشکال اونا رو جواب داد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 641.66,
   "end": 647.04,
   "text": "پس خلاصه اگر می‌خوایم این دو تا جلسه هفته پیش منقطع شد، الان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 647.04,
   "end": 650.28,
   "text": "مخصوصاً ادامه‌ش رو رفتم. اگر می‌خوایم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 650.28,
   "end": 659.46,
   "text": "ما هم برسیم به اونجایی که قلبمون نه گناهکار باشه بلکه قلب ذاکر باشه، به حقیقت برسه، چاره‌ای نداریم عزیزان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 659.46,
   "end": 662.68,
   "text": "مگر اینکه علم فکری‌مون رو برسونیم به حوزه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 662.68,
   "end": 665.86,
   "text": "عقل و از عقل بکشونیمش به حوزه قلب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 665.86,
   "end": 671.34,
   "text": "یعنی اهل شهود بشیم. و الا موقع گناه لیز می‌خوریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 671.34,
   "end": 676.02,
   "text": "ایشالله عاقبتمون ختم به خیر بشه به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 676.02,
   "end": 680.62,
   "text": "اللهم صل على محمد وآل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}