 },
 "chapters": [
  {
   "index": 0,
   "title": "## استفتای تزریق و قرقره در روزه",
   "start": 14.88,
   "end": 162.26
  },
  {
   "index": 1,
   "title": "## قلب آثم و تمثیل مطبعه",
   "start": 162.26,
   "end": 380.36
  },
  {
   "index": 2,
   "title": "## چاپخانهٔ وجود و عناصر",
   "start": 380.36,
   "end": 608.4
  },
  {
   "index": 3,
   "title": "قرآن می‌فرماید:",
   "start": 608.4,
   "end": 701.62
  },
  {
   "index": 4,
   "title": "## برداشت به عدد نفوس",
   "start": 701.62,
   "end": 979.56
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.24,
   "end": 4.28,
   "text": "لا حول ولا قوه الا بالله العلی العظیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 4.28,
   "end": 9.0,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 9.0,
   "end": 13.92,
   "text": "آیاته. السلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 13.92,
   "end": 18.46,
   "text": "می‌دانید که نظر رهبر عزیزمون پیرامون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 18.46,
   "end": 25.56,
   "text": "استفاده از تزریقات و آمپول و این‌ها در حین روزه‌داری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 25.56,
   "end": 32.92,
   "text": "احتیاط واجبه. آقا اینجا فتوای صریحی ندادن و احتیاط واجب که احتیاط واجب هم که می‌دونید یا باید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 32.92,
   "end": 38.32,
   "text": "چون آقا فتوا ندادن یا باید همین احتیاط واجب را انجام بدید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 38.32,
   "end": 40.3,
   "text": "یا اینکه رجوع کنید به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 40.3,
   "end": 45.42,
   "text": "فتوای مجتهدی که بعد از آقا اعلم باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 45.42,
   "end": 49.06,
   "text": "حالا احتیاط واجب آقا پیرامون استعمال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 49.06,
   "end": 52.58,
   "text": "آمپول و تزریقات و این‌ها چگونه است؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 52.58,
   "end": 59.2,
   "text": "آقا فرمودن که استفاده از آمپول‌های مقوی و مغذی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 59.2,
   "end": 62.4,
   "text": "اشکال داره. باید اجتناب کرد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 62.4,
   "end": 68.72,
   "text": "و حتی آمپول‌هایی که ه-- به هر نحوی که باشه در خون تزریق میشه در رگ،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 68.72,
   "end": 72.32,
   "text": "نباید تزریق در رگ صورت بگیره مطلقا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 72.32,
   "end": 75.4,
   "text": "و به غیر از رگ و در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 75.4,
   "end": 80.96,
   "text": "حالا عضله هم نباید آمپول مغذی و مقوی باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 80.96,
   "end": 86.06,
   "text": "اما اگر آمپول دارویی باشه مثلا بی‌حسی باشه یا آمپول",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 86.06,
   "end": 93.64,
   "text": "مثلا تسکینی باشه، مسکن باشه این‌ها اگر عض-- در عضله تزریق بشه بی‌اشکاله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 93.64,
   "end": 99.2,
   "text": "اینو توجه داشته باشیم البته در ایام روزه‌داری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 99.2,
   "end": 105.32,
   "text": "آب نمک چی؟ برای گلو درد حلق نمی‌کن-- کلاً مطلق قرقره به هر،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 105.32,
   "end": 107.92,
   "text": "با هر حالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 107.92,
   "end": 113.86,
   "text": "چیزی که باشه با هر مایعی که باشه، آب نمک توش باشه هر چیز دیگه باشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 113.86,
   "end": 120.24,
   "text": "این در صورتی که فتوای صریح آقا و همه مراجعین در صورتی که وارد بر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 120.24,
   "end": 122.64,
   "text": "محفظه حلق نشه اشکال نداره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 122.64,
   "end": 126.82,
   "text": "این قرقره کردن. یعنی شما باید به گونه‌ای این‌ها رو بعداً پاکسازی کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 126.82,
   "end": 129.12,
   "text": "وقتی قرقره کردید دوباره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 129.12,
   "end": 132.94,
   "text": "آب‌شویه کنید. دهان را چه-- یه طوری با آب بشویید که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 132.94,
   "end": 140.64,
   "text": "آثار اون مثلاً نمک‌ها این‌ها روی سوات اضلال دندان‌ها و فضای دهان از بین بره که وارد حلق نشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 140.64,
   "end": 144.74,
   "text": "اگر وارد حلق نشه اشکال نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 144.74,
   "end": 147.0,
   "text": "حتی مزه مزه کردن غذا هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 147.0,
   "end": 151.18,
   "text": "آقا می‌فرمایند که مثلاً خانم می‌خواد ببینه غذاش شوره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 151.18,
   "end": 154.46,
   "text": "کم نمکه چیه؟ می‌خواد غذا درست کنه اما روزه هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 154.46,
   "end": 156.62,
   "text": "اشکال نداره مزه مزه کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 156.62,
   "end": 161.42,
   "text": "در صورتی که قورت نده یعنی وارد فضای حلق نشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 161.42,
   "end": 169.18,
   "text": "خب نکته بسیار مهمی رو به فضل الهی امروز عارض بشیم خدمت شما خوبان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 169.18,
   "end": 175.88,
   "text": "و من خیلی الحمد لله شاکر هستم از این جهت که بعضیا پیغام میدن یا خبر میدن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 175.88,
   "end": 178.8,
   "text": "این مطالب رو برن حتی با همسرشون یا با",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 178.8,
   "end": 184.92,
   "text": "بعضیا با خواهرشون، با رفیقشون مباحثه می‌کنند، می‌نویسن، جزوه برداری می‌کنند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 184.92,
   "end": 188.04,
   "text": "چون نکات بسیار مهم و کلیدی‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 188.04,
   "end": 191.36,
   "text": "ما رسیدیم به بحث قلب آثم با",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 191.36,
   "end": 194.98,
   "text": "ث سه نقطه. بعضیا رو من دیدم نوشتن عاصم با ع و ص.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 194.98,
   "end": 199.66,
   "text": "نه. قلب، قلب آثم با الف و ث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 199.66,
   "end": 204.72,
   "text": "سه نقطه. قلبی که دچار آلودگی شده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 204.72,
   "end": 210.48,
   "text": "که این معناش رو ما قبلاً فرق کردیم با اون عاص-- عرض کردیم که عاصم با صاد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 210.48,
   "end": 213.32,
   "text": "معناش با آثم با ث سه نقطه چه فرقی دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 213.32,
   "end": 214.92,
   "text": "حالا در هر حال.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 214.92,
   "end": 218.1,
   "text": "ببینید به قول حضرت آیت الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 218.1,
   "end": 223.26,
   "text": "عزیز دلمون استاد آقای صمدی آملی، ایشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 223.26,
   "end": 229.44,
   "text": "تعبیری دارن که در کنار تعبیر حضرت علامه حسن زاده پیرامون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 229.44,
   "end": 234.34,
   "text": "تمام نظام وجود که ما هم یکی از این اعضا و یکی از این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 234.34,
   "end": 238.04,
   "text": "در حقیقت افراد و اشخاص هستیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 238.04,
   "end": 240.32,
   "text": "می‌فرمایند که همه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 240.32,
   "end": 244.0,
   "text": "نظامات هستی، موجودات که ما یکیش هستیم مت--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 244.0,
   "end": 246.7,
   "text": "در حقیقت یک نوع مطبعه هستند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 246.7,
   "end": 250.34,
   "text": "مطبعه. مطبعه با ط دست دار و ع.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 250.34,
   "end": 255.74,
   "text": "میگن فلان کتاب به زیور طبع آراسته شد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 255.74,
   "end": 260.4,
   "text": "یعنی چاپخانه. این رو حالا در کنار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 260.4,
   "end": 267.76,
   "text": "فرمایش حضرت علامه بگذارید همان معنای جدول وجودی یا دفتر وجودی‌ست یا مظهر خ--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 267.76,
   "end": 270.68,
   "text": "وجودی‌ست که یه شعر هم علامه دارن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 270.68,
   "end": 274.06,
   "text": "\"ما جدولی از بحر وجودیم همه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 274.06,
   "end": 280.46,
   "text": "جدول. ما دفتری از غیب و شهودیم همه، دفتر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 280.46,
   "end": 285.94,
   "text": "ما مظهری از وا-- مظهر واجب الوجودیم همه، مظهر.\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 285.94,
   "end": 290.5,
   "text": "همه به یک معناست. حالا شما هر کدوم رو بگیری مطبعه یعنی چاپخانه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 290.5,
   "end": 292.86,
   "text": "یعنی چی؟ اینو خوب دقت کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 292.86,
   "end": 298.0,
   "text": "فیض، فیضی که از نظام اقدس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 298.0,
   "end": 304.86,
   "text": "حضرت حق از حالا از جهت رتبه‌ای از بالا تنزل پیدا می‌کند، فیض.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 304.86,
   "end": 307.26,
   "text": "اون فیض یک حقیقت بیش نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 307.26,
   "end": 312.72,
   "text": "قبلاً این رو بحث کردیم. حالا تو توحید صمدی اگر مراجعه کنید متوجه میشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 312.72,
   "end": 318.44,
   "text": "یک، یک فیض بیش نیست حتی عرفا فرمودن تجلی خدای منان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 318.44,
   "end": 320.84,
   "text": "یک معنا بیش نه-- یک حقیقت بیش نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 320.84,
   "end": 325.64,
   "text": "اونم قرآنه. منتها قرآن به سه شکل جلوه کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 325.64,
   "end": 328.64,
   "text": "یک قرآن کتبیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 328.64,
   "end": 333.82,
   "text": "که همین قرآن تدوینیه که دست من و شما الان بعضیاتون هم دارید می‌خونید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 333.82,
   "end": 337.86,
   "text": "یک قرآن هستیه که نظام آفاقیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 337.86,
   "end": 341.5,
   "text": "نظام آفاقی. همه آنچه که در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 341.5,
   "end": 344.64,
   "text": "عرض شود آسمانها و زمین موجود است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 344.64,
   "end": 346.28,
   "text": "این هم قرآن هستیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 346.28,
   "end": 348.6,
   "text": "قرآنه. آیه به آیه است. قرآن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 348.6,
   "end": 353.34,
   "text": "خودش میگه إن في خلق السماوات والأرض واختلاف الليل والنهار لآيات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 353.34,
   "end": 355.88,
   "text": "دیگه اینام آیه‌های الهی هستند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 355.88,
   "end": 359.6,
   "text": "قرآن است همه یک پارچه اینام آیه هاشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 359.6,
   "end": 363.56,
   "text": "یک آیه قرآن دیگه هم قرآن انفس یا نفسیس؛",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 363.56,
   "end": 367.48,
   "text": "یعنی جان انسان. این هم یک پارچه قرآن است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 367.48,
   "end": 369.88,
   "text": "که ما شب قدر قرآن رو سر می‌گیریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 369.88,
   "end": 375.12,
   "text": "در حقیقت دنبال، در پی قرآن وجودی خودمون می‌گردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 375.12,
   "end": 380.36,
   "text": "نسخه رو میذاریم برابر اصل کنیم ببینیم خدایی نکرده انحرافی ایجاد نشده باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 380.36,
   "end": 384.18,
   "text": "این فیض وقتی وارد وجود هر کسی شد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 384.18,
   "end": 388.5,
   "text": "اگر مطبع بگیریم وارد چاپخانه هر کسی شد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 388.5,
   "end": 392.9,
   "text": "به نحو اون چاپخانه چاپ میشه میاد بیرون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 392.9,
   "end": 399.18,
   "text": "قلم و حالا اون مرکب و اون دفتر خامه داده میشه به چاپخونه نسبت به اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 399.18,
   "end": 403.6,
   "text": "دستوری که به چاپخونه و اون مطبعه داده شده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 403.6,
   "end": 408.06,
   "text": "تنظیم شده نسبت به تنظیماتش چاپ میشه میاد بیرون هر چاپخانه‌ای.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 408.06,
   "end": 411.1,
   "text": "حالا نظام هستی رو شما در نظر بگیرید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 411.1,
   "end": 413.26,
   "text": "همه یک در حقیقت جدول‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 413.26,
   "end": 418.82,
   "text": "البته الان هم فرمود انسان جامع‌ترین جدول وجود است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 418.82,
   "end": 423.58,
   "text": "جدول بحر وجود است که اون آب حیات در او جاری شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 423.58,
   "end": 426.04,
   "text": "اون آب حیات هم همون وجوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 426.04,
   "end": 428.86,
   "text": "همه موجودات وجود دارن دیگه ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 428.86,
   "end": 431.32,
   "text": "این درخت وجود داره دیگه، وجوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 431.32,
   "end": 436.76,
   "text": "عدم که نیست. شما وجود داری، زمین وجود داره، آسمان وجود داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 436.76,
   "end": 442.3,
   "text": "همه وجودند. در حقیقت از اون بحر وجود، اون دریای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 442.3,
   "end": 444.96,
   "text": "متلاطم وجود هر یک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 444.96,
   "end": 449.76,
   "text": "از اون آبش خور به نسبت جدول وجودی و کانال وجودیشون،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 449.76,
   "end": 454.06,
   "text": "اون فیض رو که همون وجوده گرفتن و الا وجود نداشتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 454.06,
   "end": 458.76,
   "text": "حالا اینو شما بیا در نظر بگیرید تو همه موجودات این چنینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 458.76,
   "end": 462.42,
   "text": "اگرچه همه موجودات، شما در همین نباتات دقت کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 462.42,
   "end": 468.96,
   "text": "یه دانه خرما، یه دانه انار، یه دانه سیب، یه دانه انگور، یه دانه برنج، ارزن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 468.96,
   "end": 473.46,
   "text": "همه این‌ها یک به منزله یک مطبعه یک چاپخانه‌اند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 473.46,
   "end": 476.8,
   "text": "که وقتی اون فیض به این‌ها نازل میشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 476.8,
   "end": 480.28,
   "text": "در حقیقت حالا وجود، وجود رو اینجا شما چی می‌تونی بگیری؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 480.28,
   "end": 486.28,
   "text": "اون عناصر اربعه. یک خاکه، یک آبه، یک هواست و یک آفتابه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 486.28,
   "end": 491.8,
   "text": "اما میزنه به دانه، اِاِاِ خرما، نخل خرما ازش بیرون میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 491.8,
   "end": 495.5,
   "text": "میزنه به دانه سیب، سیب میاد، انگور، انگور میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 495.5,
   "end": 497.14,
   "text": "فرق می‌کنند ظاهراً با هم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 497.14,
   "end": 499.76,
   "text": "چرا؟ چون کانال وجودیشون فرق می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 499.76,
   "end": 504.12,
   "text": "چاپخونه و مطبعه، مطبعه وجودیشون فرق می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 504.12,
   "end": 509.2,
   "text": "یا اون دفتر وجودیشون فرق می‌کنه که چگونه این نقوش رو بنویسه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 509.2,
   "end": 514.34,
   "text": "که ام اگر شما درون اینا رو بشکافید باز همون یک حقیقت‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 514.34,
   "end": 519.68,
   "text": "همون وجودند. یعنی همون آب و همون خاک و همون حرارت و همون هوااند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 519.68,
   "end": 521.98,
   "text": "اما به این شکل بروز پیدا کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 521.98,
   "end": 523.78,
   "text": "در وجود ما هم این چنینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 523.78,
   "end": 533.4,
   "text": "وجود ما انسان‌ها، وجود وقتی وارد بر کانال وجودیه، اون فیض، فیض حضرت حق وقتی وارد کانال وجودی ما شده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 533.4,
   "end": 538.74,
   "text": "یه خروجی داره. اون خروجی مطابق با طبع ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 538.74,
   "end": 542.48,
   "text": "مطبعه. مطابق با",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 542.48,
   "end": 548.62,
   "text": "اون چیزی‌ست که ما تنظیم کردیم که اینکه وارد شد حالا چگونه خارج بشود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 548.62,
   "end": 551.26,
   "text": "اگر شما منافذ ورودی رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 551.26,
   "end": 555.7,
   "text": "حواس پنج گانه، قوه خیال، واهمه، این‌ها منافذ ورود، ورودی‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 555.7,
   "end": 560.8,
   "text": "این‌ها رو کنترل کنی که مواد سمی وارد نشه، مواد درست--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 560.8,
   "end": 567.82,
   "text": "کارخانه‌ای که مواد اولیه‌ش، وارداتش بهترین‌ها باشه، صادراتش هم بهترین‌هاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 567.82,
   "end": 574.62,
   "text": "آنچه که از انسان، از وجود انسان، از مطبعه و کانال وجود انسان صادر میشه اونم بهترین‌هاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 574.62,
   "end": 577.64,
   "text": "قرآن می‌فرماید که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 577.64,
   "end": 584.4,
   "text": "آیه هشتاد و دو سوره اسراء می‌فرماید و نُنَزِّلُ مِنَ الْقُرْآن بارها عرض کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 584.4,
   "end": 587.38,
   "text": "آنچه که نازل شده نُنَزِّلُ نازل شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 587.38,
   "end": 591.3,
   "text": "این فیض همون قرآنه دیگه که گفتیم به سه شکله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 591.3,
   "end": 594.22,
   "text": "این فیض نازل شده چگونه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 594.22,
   "end": 599.1,
   "text": "و نُنَزِّلُ مِنَ الْقُرْآن ما هُوَ نیست این فیض، این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 599.1,
   "end": 604.54,
   "text": "نزول مگر الا شِفَاءٌ وَرَحْمَةٌ البته لِلْمُؤْمِنِينَ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 604.54,
   "end": 607.12,
   "text": "وَلَا يَزِيدُ الظَّالِمِينَ إِلَّا خَسَارًا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 607.12,
   "end": 613.18,
   "text": "همین قرآن، همین فیض اقدس نظام هستی، همین تجلی اعظم حضرت حق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 613.18,
   "end": 616.16,
   "text": "برای اهل ایمان شفا و رحمته اما برای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 616.16,
   "end": 618.9,
   "text": "اهل ظلم، ظالمین چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 618.9,
   "end": 621.32,
   "text": "خسارته. ای بابا!",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 621.32,
   "end": 623.22,
   "text": "چگونه قرآن میشه خسارت؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 623.22,
   "end": 625.44,
   "text": "به همین حرف چیزی که عرض کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 625.44,
   "end": 629.2,
   "text": "یعنی بستگی داره که اون فیض، حالا شما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 629.2,
   "end": 632.48,
   "text": "کسی که داره نگاه می‌کنه، عالم خوانی می‌کنه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 632.48,
   "end": 634.86,
   "text": "آسمان و زمین و نگاه می‌کنه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 634.86,
   "end": 639.64,
   "text": "این عالم خوانیش تو دفتر وجودیش چگونه ثبت میشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 639.64,
   "end": 641.7,
   "text": "نسبت به وجود خودش بستگی داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 641.7,
   "end": 643.9,
   "text": "بعضی اینو آیات می‌بینن، آیات الهی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 643.9,
   "end": 648.76,
   "text": "بعضیا یه نشانه ای برای تفریح و خوشگذرونی و گناه و معصیت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 648.76,
   "end": 653.9,
   "text": "قرآن به چه گونه؟ قرآن ی-- برای خیلیا مضحکه دستشون میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 653.9,
   "end": 656.66,
   "text": "عامل دنیاشون میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 656.66,
   "end": 658.9,
   "text": "میشه محل تجارتشون،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 658.9,
   "end": 661.46,
   "text": "کسبشون، اسم و رسمشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 661.46,
   "end": 663.4,
   "text": "اصلاً نیت خدایی وجود نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 663.4,
   "end": 665.88,
   "text": "ولی بعضیا قرآن میشه تعالی، تعالی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 665.88,
   "end": 669.42,
   "text": "هی رتبه به رتبه اقرأ ورقه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 669.42,
   "end": 672.16,
   "text": "حتی اون قرآن نفس و انفسي که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 672.16,
   "end": 678.46,
   "text": "اگه حالا بگیر امام زمان سلام الله عليه، حضرت بقیت الله الاعظم، نبی اکرم اسلام، این‌ها،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 678.46,
   "end": 685.28,
   "text": "انبیا، این‌ها همون قرآن ار-- عرض شود کتبی بگیری یا قرآن نفسي بگیری، اون هم وقتی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 685.28,
   "end": 692.0,
   "text": "برخورد می‌کنه، اون فیض اقدسه دیگه، برخورد می‌کنه با هر کسی به تک تک افراد و اشخاص",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 692.0,
   "end": 697.08,
   "text": "آنچه که بروز می‌کنه ازشون در برخورد با حجت خدا متفاوته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 697.08,
   "end": 700.02,
   "text": "بستگی به درونشون داره. همه این‌ها به درو--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 700.02,
   "end": 707.68,
   "text": "اینکه میگه هر حرف از قرآن، هر حرف از آیات قرآن هفتاد هزار معنا داره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 707.68,
   "end": 710.78,
   "text": "یه معنیش همینه دیگه. اون هفتاد هزار هم کثرته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 710.78,
   "end": 712.8,
   "text": "یعنی بی‌نهایت معنا برای هر حرفه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 712.8,
   "end": 716.26,
   "text": "یعنی چی؟ یعنی این یک حرف که فیضه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 716.26,
   "end": 723.68,
   "text": "به مطبعه وجوده، به کانال وجوده، به دفتر وجوده، به مظهر وجودیه هر کسی برخورد کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 723.68,
   "end": 726.86,
   "text": "مطابق با اون وجود ازش خارج میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 726.86,
   "end": 731.6,
   "text": "یعنی هر کسی مطابق با وجود خودش برداشت از قرآن می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 731.6,
   "end": 733.68,
   "text": "برداشت از فیض حق می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 733.68,
   "end": 736.44,
   "text": "برداشت از ابا عبدالله الحسین می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 736.44,
   "end": 739.22,
   "text": "برداشت از این نظام آفاقی می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 739.22,
   "end": 740.8,
   "text": "فرق می‌کنه، متفاوته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 740.8,
   "end": 744.74,
   "text": "بله. فرق بین تک تک محارز رتبه‌هام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 744.74,
   "end": 746.54,
   "text": "به عدد انفس خلائقه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 746.54,
   "end": 750.9,
   "text": "لذا میگه الطرق الی الله هم به عدد انفس خلائقه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 750.9,
   "end": 754.48,
   "text": "حالا اگر اینو نفس بگیری خیلی ع-عجیب‌تر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 754.48,
   "end": 758.32,
   "text": "اگر نفس‌ها بگیری بازم عجیبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 758.32,
   "end": 763.56,
   "text": "در هر حال خ-خلاصه کلام چه ربطی به قلب عاثم داشت این موضوع؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 763.56,
   "end": 767.42,
   "text": "ما در دو صورت می‌تونیم اونچه که از ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 767.42,
   "end": 770.62,
   "text": "ساطع می‌شه، صادر می‌شه، خارج می‌شه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 770.62,
   "end": 778.8,
   "text": "اعمال ما، نیت ما، آثار وجودی ما در یک صورت فقط در دو صورت با داشتن دو شرط",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 778.8,
   "end": 782.6,
   "text": "می‌تونیم اون رو الهی کنیم و اون فیضی که داره میاد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 782.6,
   "end": 784.98,
   "text": "درست اون فیض خارج بشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 784.98,
   "end": 789.02,
   "text": "خراب نشه، نقوشش بر دفتر وجودی‌مون، کتاب وجودی‌مون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 789.02,
   "end": 791.44,
   "text": "باطل نوشته نشه. اونم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 791.44,
   "end": 799.18,
   "text": "حضرت علامه می‌فرمود جهت‌دهی می‌کنن در اصول امهاتی که حالا بعداً بحث می‌کنیم یعنی چی این اصول امهات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 799.18,
   "end": 805.42,
   "text": "که این اصول امهات همون مواد اولیه‌اند که وارد، وارد مطبعه وجودی تو میشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 805.42,
   "end": 810.68,
   "text": "در ای-- در با داشتن دو شرط این خروجی‌ها سالم‌اند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 810.68,
   "end": 812.46,
   "text": "و می‌شه بهش اعتماد کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 812.46,
   "end": 816.48,
   "text": "هم شما به خودت اعتماد کنی هم من به شما اعتماد کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 816.48,
   "end": 821.44,
   "text": "اون دو شرط چیه؟ یک، سیر حکمت نظری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 821.44,
   "end": 827.86,
   "text": "و عرفان نظری و حکمت عملی و عرفان عملی این‌ها درست طی بشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 827.86,
   "end": 830.38,
   "text": "یعنی انسان این سی رو، سیر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 830.38,
   "end": 834.88,
   "text": "در حقیقت عرفان و حکمت رو از جهت نظری، علم فکری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 834.88,
   "end": 839.66,
   "text": "درست بره تا علم شهودیش و ذوقی و عرفانی‌شم درست باشه این یک.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 839.66,
   "end": 841.6,
   "text": "یعنی یه سیر بحث داشته باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 841.6,
   "end": 844.96,
   "text": "همینطوری این حدیث و این آیه و این حرفو امروز پا منبر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 844.96,
   "end": 849.5,
   "text": "ایشون فردا پا منبر ایشون همینطور اینطوری فایده نداره هر جایی بار بیاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 849.5,
   "end": 853.54,
   "text": "بر اساس اون اصول امهات که انشاالله فردا عرض می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 853.54,
   "end": 856.46,
   "text": "این یک. دومین شرط لازم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 856.46,
   "end": 862.78,
   "text": "اینه که جدول وجودیش به قول علامه لای‌روبی شده باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 862.78,
   "end": 868.14,
   "text": "عزیز دلم یعنی اون دستگاه چاپخانه وجودش تنظیم درست شده باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 868.14,
   "end": 870.5,
   "text": "گناه تنظیم انسان رو می‌ریزه به هم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 870.5,
   "end": 874.3,
   "text": "انسان رو نامیزون می‌کنه، آلوده می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 874.3,
   "end": 878.54,
   "text": "لا-- در حقیقت پر از لجن می‌شه کانال وجودی انسان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 878.54,
   "end": 881.9,
   "text": "دفتر وجودی انسان پر از نقش و نگار باطل می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 881.9,
   "end": 883.46,
   "text": "خودش از خودش وحشت می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 883.46,
   "end": 885.68,
   "text": "هر کی نگاش کنه وحشت می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 885.68,
   "end": 888.82,
   "text": "لذا میگه \"لا یمسه إلا المتحرون\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 888.82,
   "end": 894.38,
   "text": "هر چقدر طهارت داری همون مقدار حقایق نظام هستی رو مس می‌کنی عزیزم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 214,
   "start": 894.38,
   "end": 897.44,
   "text": "با این دو شرط خروجی‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 215,
   "start": 897.44,
   "end": 901.78,
   "text": "مثل اون مواد اولیه که فیض اقدسن تطابق با اون‌ها دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 216,
   "start": 901.78,
   "end": 904.3,
   "text": "اون هم مقدسه بلکه اقدس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 217,
   "start": 904.3,
   "end": 908.98,
   "text": "لذا نیتت، فعلت، نفست، ذکرت، نشست و برخاستت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 218,
   "start": 908.98,
   "end": 912.24,
   "text": "همه چیت می‌شه ذکر. لذا تو زیارت آل یاسین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 219,
   "start": 912.24,
   "end": 915.9,
   "text": "به تمام شعونات حجت خدا به همین دلیل شما چیکار می‌کنی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 220,
   "start": 915.9,
   "end": 918.96,
   "text": "سلام میدی. \"السلام علیک حین تقعد و تب\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 221,
   "start": 918.96,
   "end": 922.26,
   "text": "\"السلام علیک حین تقوم و تب\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 222,
   "start": 922.26,
   "end": 924.84,
   "text": "ایستادنتو سلام میدم. نشستنتو سلام میدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 223,
   "start": 924.84,
   "end": 927.48,
   "text": "رکوعتو، سجودتو، قنوتتو،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 224,
   "start": 927.48,
   "end": 930.98,
   "text": "صبح و شبتو، هر آن به آن لحظاتتو من سلام میدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 225,
   "start": 930.98,
   "end": 935.7,
   "text": "چرا؟ چون عین فیض حق و چون جامع‌ترین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 226,
   "start": 935.7,
   "end": 944.44,
   "text": "جدول وجودی نظام هستی و پاک‌ترین \"إنما يريد الله ليذهب عنكم الرجس أهل البيت ويطهركم تطهيرا\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 227,
   "start": 944.44,
   "end": 947.7,
   "text": "هر دو رو به نحو اتم و اکمل دارد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 228,
   "start": 947.7,
   "end": 954.16,
   "text": "هم کل علم ذات حضرت حق رو اخذ کرده و هم کل طهارت رو حفظ کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 229,
   "start": 954.16,
   "end": 957.5,
   "text": "خروجی‌ها دقیقاً مطابق با ورودی‌هاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 230,
   "start": 957.5,
   "end": 961.6,
   "text": "تو می‌تونی با اطمینان کامل پشت سر حجت خدا حرکت کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 231,
   "start": 961.6,
   "end": 966.76,
   "text": "انشاالله عاقبتمون ختم به خیر بشه به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 232,
   "start": 966.76,
   "end": 972.34,
   "text": "اللهم صل على",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 233,
   "start": 972.34,
   "end": 979.56,
   "text": "محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}