   "start": 14.88,
   "end": 112.14
  },
  {
   "index": 1,
   "title": "## اصول و امهات حکمت و عرفان نظری",
   "start": 112.14,
   "end": 331.74
  },
  {
   "index": 2,
   "title": "## قرآن و اصول؛ تمثیل کارگاهی آیهٔ زمر",
   "start": 331.74,
   "end": 351.86
  },
  {
   "index": 3,
   "title": "## قرآن انفسی و خواب برادر مرگ",
   "start": 351.86,
   "end": 643.54
  },
  {
   "index": 4,
   "title": "## انشائات نفس در خواب و سنجش حال",
   "start": 643.54,
   "end": 948.5
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.26,
   "end": 3.46,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 3.46,
   "end": 8.7,
   "text": "السلام علیک یا داعی الله و ربانی آیاته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 8.7,
   "end": 14.88,
   "text": "سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 14.88,
   "end": 19.38,
   "text": "استفتایی از رهبر عزیزمون پیرامون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 19.38,
   "end": 22.5,
   "text": "جنب شدن در حالت روزه‌داری شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 22.5,
   "end": 27.02,
   "text": "البته چند تا استفتای من همه رو با هم جمع می‌کنم عرض می‌کنم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 27.02,
   "end": 29.7,
   "text": "که کلاً در خصوص",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 29.7,
   "end": 34.32,
   "text": "اینکه اگر کسی بخواد با همسرش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 34.32,
   "end": 37.08,
   "text": "حالت ملاعبه داشته باشه یعنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 37.08,
   "end": 39.74,
   "text": "لذت جنسی ببره اما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 39.74,
   "end": 43.76,
   "text": "این منجر به انزال منی نشه یعنی جنب نشه اشکال داره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 43.76,
   "end": 46.4,
   "text": "آقا می‌فرمایند نخیر اشکال نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 46.4,
   "end": 50.44,
   "text": "اما اگر چنانچه در حین ملاعبه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 50.44,
   "end": 54.98,
   "text": "اتفاقاً یه دفعه انزال صورت گرفت، منی از بدن خارج شد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 54.98,
   "end": 60.8,
   "text": "اون موقع تکلیف چیه؟ اگر اینو خوب دقت کنید که من برای اطمینان حتی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 60.8,
   "end": 64.52,
   "text": "زنگ زدم دفتر آقام پرسیدم، اطمینان حاصل کردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 64.52,
   "end": 67.38,
   "text": "اگر چنانچه طرف می‌دونسته که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 67.38,
   "end": 70.88,
   "text": "ملاعبش باعث می‌شه که این بشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 70.88,
   "end": 74.96,
   "text": "یعنی انزال منی صورت بگیره، نمی‌تونه خودشو کنترل کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 74.96,
   "end": 78.44,
   "text": "و با این علم این کارو انجام داده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 78.44,
   "end": 82.6,
   "text": "باز می‌شه همون حالت باطل کردن روزه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 82.6,
   "end": 85.84,
   "text": "و کفاره هم کفاره جمع تعلق می‌گیره به طرف.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 85.84,
   "end": 89.72,
   "text": "هم باید قضا بگیره هم کفاره جمع اونم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 89.72,
   "end": 96.4,
   "text": "اما نه، اگر می‌دونسته که نه، این باعث انزال منی نمی‌شه، خودشو کنترل می‌کنه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 96.4,
   "end": 99.66,
   "text": "استثنائاً حالا یک بار یه دفعه این اتفاق افتاد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 99.66,
   "end": 102.24,
   "text": "نتونست خودشو کنترل کنه و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 102.24,
   "end": 105.86,
   "text": "جنب شد. اینجا صرفاً همون قضا به گردنش میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 105.86,
   "end": 109.82,
   "text": "دیگه کفاره نداره. این رو حواسمون باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 109.82,
   "end": 114.08,
   "text": "خب. وعده داده بودیم که امروز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 114.08,
   "end": 118.6,
   "text": "نکته‌ای رو پیرامون اصول و امهات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 118.6,
   "end": 123.84,
   "text": "حکمت نظری و عرفان نظری عرض کنیم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 123.84,
   "end": 126.72,
   "text": "چقدر جایگاه اینا مهمه عزیزان دلم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 126.72,
   "end": 128.66,
   "text": "خیلی، خیلی، خیلی مهمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 128.66,
   "end": 131.88,
   "text": "اساساً ما از این جهت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 131.88,
   "end": 135.46,
   "text": "به امثال حضرت علامه حسن زاده‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 135.46,
   "end": 139.62,
   "text": "در حقیقت تمسک می‌کنیم، دنبال سرشون راه میفتیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 139.62,
   "end": 148.24,
   "text": "دمنشونو می‌گیریم. حالا وج-وج-- اون وجاهت‌های علمی، معرفتی، معنوی همه به جای خودش طهارت و پاکی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 148.24,
   "end": 153.12,
   "text": "اما یکی از اختصاصات آثار حضرت علامه گفتن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 153.12,
   "end": 160.46,
   "text": "اون اصوله. بسیاری از ما مذهبی‌ها اگرچه اطلاعات در ذهنمون فوران،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 160.46,
   "end": 163.22,
   "text": "متأسفانه بسیاری‌شم ضد و نویز هم‌ند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 163.22,
   "end": 165.46,
   "text": "در مفروضات وجودیمون غرق شدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 165.46,
   "end": 168.74,
   "text": "نمی‌دونیم از کجا شروع کنیم. کتاب‌های ضد و نویز،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 168.74,
   "end": 172.22,
   "text": "منبرها و تریبون‌های ضد و نویز.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 172.22,
   "end": 175.18,
   "text": "اصلاً یک سیر مطالعاتی نداشتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 175.18,
   "end": 177.92,
   "text": "غالباً اکثراً اینچنین هستیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 177.92,
   "end": 182.62,
   "text": "اصلاً اصول رو توجه-- بلا-- لذا اصولی بار نیومدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 182.62,
   "end": 187.72,
   "text": "ذهنمون، فکرمون، در نتیجه قلبمون اصولی نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 187.72,
   "end": 191.86,
   "text": "با هر بادی یه طرف، با هر نظریه‌ای، با هر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 191.86,
   "end": 194.64,
   "text": "جنبش سیاسی یه طرف.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 194.64,
   "end": 197.86,
   "text": "حضرت علامه کار قشنگی که کردن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 197.86,
   "end": 200.2,
   "text": "ضمن اینکه اومدن تفسیر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 200.2,
   "end": 204.02,
   "text": "آفاقی که بسیار نوشته شده، تفسیر انسی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 204.02,
   "end": 211.12,
   "text": "و سیر انسی در قرآن رو بر اساس سیر معرفت نفس قلم زدن و نوشتن تو کتاب‌هاشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 211.12,
   "end": 217.76,
   "text": "و این اصول رو در کتاب‌های متعدد بیان کردن، این‌ها رو، این مطالب و این حقایق نظام هستی رو که همش در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 217.76,
   "end": 222.54,
   "text": "جان تو باید پیاده شود رو اصل، اصل کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 222.54,
   "end": 230.5,
   "text": "شما همین دروس سه جلدی صد و پنجاه و سه درس معرفت علامه رو که به نظرم از مهم‌ترین اطعمه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 230.5,
   "end": 235.56,
   "text": "شماست برای خوراک وجودیتون و از مهم‌ترین ورودی‌های به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 235.56,
   "end": 243.2,
   "text": "مطبعه وجودتون به عنوان اون چاپخونه‌ای که دیروز عرض کردیم که خروجی درست داشته باشه، دفتر وجودیتون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 243.2,
   "end": 246.08,
   "text": "نقش و نگار درستی درش ثبت بشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 246.08,
   "end": 251.6,
   "text": "که قیامت گفتن اقرأ كتابك حالا بخوان دفتر و کتاب وجودی تو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 251.6,
   "end": 255.04,
   "text": "كفا بنفسك اليوم عليك حسيب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 255.04,
   "end": 257.6,
   "text": "خودت دلت بیاد بخوانی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 257.6,
   "end": 262.94,
   "text": "این همین سیر معرفت نفس علامه اصولی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 262.94,
   "end": 267.88,
   "text": "درش بیان کرده، همین کتابه، همین کتاب سیر معرفت نفس که ابتداییه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 267.88,
   "end": 270.84,
   "text": "یعنی من به هرکی گفتم حاجی آقا ما نه-- ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 270.84,
   "end": 275.14,
   "text": "مثلاً علممون اون حد نیست، ما که طلبه نیستیم، ما که دانشجو نیستیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 275.14,
   "end": 277.68,
   "text": "باور کنید بی‌سوادشم بخونه متوجه می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 277.68,
   "end": 281.3,
   "text": "من به شما قول میدم. البته نه همه عین ما موضوع رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 281.3,
   "end": 285.16,
   "text": "نه، باید زحمت کشید، ریاضت علمی باید کشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 285.16,
   "end": 287.98,
   "text": "اما بالاخره از هر درسی یه چیزکی گیرش میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 287.98,
   "end": 290.56,
   "text": "چه بهتر که با مباحثه با استاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 290.56,
   "end": 293.36,
   "text": "من عرض می‌کنم دست رو قرآن می‌گذارم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 293.36,
   "end": 297.08,
   "text": "گم شده من و شما همین کتاب معرفت نفس علامه‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 297.08,
   "end": 299.48,
   "text": "خواهش می‌کنم دو ساله دارم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 299.48,
   "end": 302.52,
   "text": "تو جمع شما التماس می‌کنم اینو پی بگیرید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 302.52,
   "end": 305.64,
   "text": "حالا پس بزنید خودتون ضررش رو می‌کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 305.64,
   "end": 308.56,
   "text": "برید ببینید چه غوغاییه توش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 308.56,
   "end": 311.74,
   "text": "اصول، اصولی که علامه این تو آورده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 311.74,
   "end": 315.86,
   "text": "بر اساس بحث دی-دیگرمون که دیروزمون که داشتیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 315.86,
   "end": 319.2,
   "text": "شما این اصول رو وقتی متوجه شدی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 319.2,
   "end": 326.5,
   "text": "به اون مطبعه وجودت دادی، به جدول وجودیت دادی، اون موقع خروجی‌هات درست در میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 326.5,
   "end": 330.36,
   "text": "خروجی‌هات می‌شه اعمالت، کردارت، رفتارت، نیاتت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 330.36,
   "end": 336.72,
   "text": "اما بر اساس اصول. اساساً قرآن هم اومده کلیه اصول‌ها، اصول رو به ما داده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 336.72,
   "end": 339.02,
   "text": "اصل، اصل خود قرآن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 339.02,
   "end": 343.34,
   "text": "اگرچه تمام جزئیات هم به تفصیل در قرآن اومده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 343.34,
   "end": 347.48,
   "text": "من اراد علم الاولین والاخرین فليفورء القرآن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 347.48,
   "end": 349.84,
   "text": "علم اول و آخر نظام هستی در قرآن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 349.84,
   "end": 355.88,
   "text": "اساساً قرآن علم ذاتی حضرت حقه که تنزل پیدا کرده به این شکل به دست ما رسیده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 355.88,
   "end": 359.62,
   "text": "که بحثش قبلاً در نزول قرآن رسید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 359.62,
   "end": 365.08,
   "text": "تو این مد-- تو همین جلسه مطرح شد تا حدودی البته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 365.08,
   "end": 368.26,
   "text": "اما همین قرآن اصول رو هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 368.26,
   "end": 373.56,
   "text": "به بهترین وجه حتی با تمثیلات، با مثال‌های فراوان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 373.56,
   "end": 378.92,
   "text": "بیان کرده. که این اصول رو شما باید داشته باشید و با اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 378.92,
   "end": 383.72,
   "text": "دو تا اتفاق میفته. یک، اصولی بار میای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 383.72,
   "end": 387.44,
   "text": "و مطبع وجود دفتر وجودیت رو درست چاپ میکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 387.44,
   "end": 394.9,
   "text": "دو، به جنگ هر تفکر و هر تریبون و هر کتاب و هر صاحب فکر و اندیشه‌ای می‌تونی بری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 394.9,
   "end": 397.5,
   "text": "نه که جنگ به اون معنا، یعنی بری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 397.5,
   "end": 400.76,
   "text": "تضارب آرا کنی. چون اصول رو داری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 400.76,
   "end": 402.74,
   "text": "متوجه می‌شی کجا طرفدار اشته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 402.74,
   "end": 405.16,
   "text": "تو دیگه به بیراهه نمی‌ری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 405.16,
   "end": 413.02,
   "text": "حالا اجازه بدید من دست بگذارم به عنوان نمونه کارگاهی دیگه ها، بگذاریم رو میز یکی از آیات قرآن رو که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 413.02,
   "end": 420.48,
   "text": "من به شما بگم من وقتی متوجه این اصل از البته علامه در کتاب رساله شریف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 420.48,
   "end": 425.6,
   "text": "انسان در عرف عرفانش کولاک کرده پیرامون این آیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 425.6,
   "end": 432.14,
   "text": "من وقتی که متوجه اون مطالب و اون اصولی که علامه ذیل این آیه آوردن در اون رساله، اون کتاب شدم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 432.14,
   "end": 436.58,
   "text": "واقعاً می‌خواستم سر به بیابان بگذارم انقدر برام شیرین بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 436.58,
   "end": 439.96,
   "text": "حالا بعضیا پس می‌زنن حاج آقا این حرفا چیه تو می‌زنی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 439.96,
   "end": 445.96,
   "text": "خب چه کنم؟ چشیدم شیرین بوده دوست دارم توام بچشی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 445.96,
   "end": 448.08,
   "text": "اینا صرفاً علم فکری که نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 448.08,
   "end": 455.96,
   "text": "آیه چهل و دو سوره زمر برید ببینید تو خلوتتون \"الله يتوفى الأنفس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 455.96,
   "end": 460.52,
   "text": "حين موتها\". می‌فرماید الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 460.52,
   "end": 463.56,
   "text": "توفی می‌کنه جان رو نفس رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 463.56,
   "end": 466.88,
   "text": "\"الأنفس حين موتها\" وقتی کسی رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 466.88,
   "end": 469.84,
   "text": "می‌میراند. کسی اصطلاحاً می‌گیم مرد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 469.84,
   "end": 474.52,
   "text": "چه اتفاقی افتاده؟ نفسش توسط حضرت حق به تمام،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 474.52,
   "end": 478.12,
   "text": "به تمام و کمال توفی شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 478.12,
   "end": 482.38,
   "text": "جانش. که وفات درسته، فوت غلطه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 482.38,
   "end": 485.7,
   "text": "توفی گرفتن. ادامه رو داشته باشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 485.7,
   "end": 488.68,
   "text": "\"والتي لم تمت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 488.68,
   "end": 491.44,
   "text": "في منامها\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 491.44,
   "end": 494.36,
   "text": "حتی کسی رو که \"لم تمت\" هنوز نمرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 494.36,
   "end": 496.66,
   "text": "یعنی چی نمرده باز توفی می‌شه نفسش؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 496.66,
   "end": 500.28,
   "text": "\"في منامها\" تو خوابه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 500.28,
   "end": 505.52,
   "text": "یعنی حتی در خواب هم عزیز دلم جان تو توسط الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 505.52,
   "end": 509.86,
   "text": "توفی می‌شود. \"فيمس كلتي قضى عليه الموت\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 509.86,
   "end": 514.02,
   "text": "کسی که دیگه قضای، قضای خدا بر اون تحقق گرفته که بمیره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 514.02,
   "end": 521.14,
   "text": "دیگه این نفس برنمی‌گرده. اما \"ويرسل الأخرى إلى أجل مسمى\" اونایی که هنوز خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 521.14,
   "end": 526.36,
   "text": "قضاش بر این تحقق گرفته که هنوز تو این دنیا باشن، هنوز امتحان پس بدن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 526.36,
   "end": 530.82,
   "text": "تا یه، \" 到 أجل مسمى\" تا اون موقع این نفس دوباره برمی‌گرده به بدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 530.82,
   "end": 533.32,
   "text": "\"إن في ذلك",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 533.32,
   "end": 536.26,
   "text": "لآيات\". آیات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 536.26,
   "end": 538.78,
   "text": "\"لقوم يتفكرون\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 538.78,
   "end": 540.92,
   "text": "البته برای اهل فکر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 540.92,
   "end": 550.84,
   "text": "که ما دیروز گفتیم که یه دسته از اون سه دسته قرآن‌ها، قرآن هستی و قرآن کتبی، یه دسته‌اش قرآن نفس یا انفسی بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 550.84,
   "end": 554.36,
   "text": "الان میگه همین سیر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 554.36,
   "end": 556.94,
   "text": "عرض شود تطور وجودی تو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 556.94,
   "end": 562.14,
   "text": "حالا چه مرگ باشه، چه طورת عوض بشه خواب باشه دوباره بیدار شی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 562.14,
   "end": 563.96,
   "text": "این هم آیه الهیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 563.96,
   "end": 566.58,
   "text": "آیه است یعنی قرآن تو وجود توئه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 566.58,
   "end": 574.28,
   "text": "قرآن فکر می‌کنم سوره ذاریات باشه می‌فرماید \"وفى الأَرْضِ آياتٌ للموقنين.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 574.28,
   "end": 576.28,
   "text": "وَفِي أَنفُسِكُمْ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 576.28,
   "end": 581.4,
   "text": "أَفَلَا تُبْصِرُونَ\". تو جان شما هم آیه است یعنی قرآن تو وجود شماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 581.4,
   "end": 584.4,
   "text": "خب چه ربطی به بحث ما داشت؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 584.4,
   "end": 587.3,
   "text": "که البته ما بحثمون قلب عاصم بود ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 587.3,
   "end": 590.28,
   "text": "مرتب این ربط رو داشته باشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 590.28,
   "end": 593.28,
   "text": "اینجا داره قرآن به زیبایی تمام بیان می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 593.28,
   "end": 601.92,
   "text": "در حقیقت اون حدیث که پیامبر فرمودن شرح همین آیه است که فرمود \"النوم أخ الموت\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 601.92,
   "end": 604.9,
   "text": "خواب برادر مرگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 604.9,
   "end": 606.8,
   "text": "دو تاش اینجا داره میگه عین همن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 606.8,
   "end": 610.82,
   "text": "هیچ فرقی نمی‌کنه. چه در خواب، چه در بیداری، چه در وقت مرگ.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 610.82,
   "end": 612.86,
   "text": "خدا توفی می‌کنه جانت رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 612.86,
   "end": 618.88,
   "text": "این جانت رفت. خب \"إنا لله\" ما در قوس نزول از خدا آمدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 618.88,
   "end": 621.39,
   "text": "حالا در خواب چه اتفاقی میفته؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 621.39,
   "end": 624.15,
   "text": "شما بفرمایید. \"إنا إليه راجعون\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 624.15,
   "end": 628.06,
   "text": "به سمت خدا رجعت کردیم. خب وقت مرگ رو علامه‌ها چی می‌نویسن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 628.06,
   "end": 630.04,
   "text": "\"إنا إليه راجعون\". همونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 630.04,
   "end": 633.38,
   "text": "هیچ فرقی نمی‌کنه. خب دقت بفرمایید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 633.38,
   "end": 636.32,
   "text": "پس انسان وقتی می‌میره کجا میره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 636.32,
   "end": 639.66,
   "text": "وقتی می‌خوابه کجا میره؟ هر دوتاش برگشتش به یک جاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 639.66,
   "end": 641.78,
   "text": "عالم برزخ. تمام شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 641.78,
   "end": 646.66,
   "text": "این یه اصله. حالا چگونه خودمون رو با این اصل تطبیق بدیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 646.66,
   "end": 650.76,
   "text": "اینکه آقا می‌فرمایند، علامه می‌فرمایند تو در خواب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 650.76,
   "end": 655.86,
   "text": "مطلقاً آنچه که در خواب می‌بینی انشائات نفس ناطقه خودته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 655.86,
   "end": 658.98,
   "text": "یعنی نفست داره این صور و اشکال رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 658.98,
   "end": 661.08,
   "text": "صورت‌گری می‌کنه و به تو نشون میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 661.08,
   "end": 668.0,
   "text": "تو حال و روز خودت رو در خواب می‌تونی از اون صور و اشکالی که می‌بینی بسنجی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 668.0,
   "end": 670.92,
   "text": "قبل از اینکه بمیری برای همیشه بسنجی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 670.92,
   "end": 673.7,
   "text": "وقتی می‌میری باز همون صورت و اشکال رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 673.7,
   "end": 677.58,
   "text": "اونجا بهت نشون میدن وقتی می‌میری اما دیگه برگشتی نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 677.58,
   "end": 682.16,
   "text": "حالا می‌تونه ملذّه باشه، می‌تونه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 682.16,
   "end": 684.52,
   "text": "وحشتناک باشه. ها؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 684.52,
   "end": 690.6,
   "text": "اما در خواب لطفش اینه که می‌بینی متوجه حال و روزت می‌شی انگار قیامتت به پا کرده دیگه قیامت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 690.6,
   "end": 693.06,
   "text": "صغری البته بعد برت می‌گردونن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 693.06,
   "end": 694.78,
   "text": "از اینجا باید متوجه بشی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 694.78,
   "end": 699.62,
   "text": "این یه اصله. که علامه میاد کمک فکری میده به ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 699.62,
   "end": 703.34,
   "text": "می‌گه خب اونجا وقتی رجعت کردی به سمت حضرت حق،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 703.34,
   "end": 710.44,
   "text": "آنچه که برات پیش میاد خدا اونجا چاله نکنده توش و هیزم بریزه به نام جهنم تو بری اونجا تو جهنم بندازد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 710.44,
   "end": 713.62,
   "text": "خودت جهنم شدی که این بحث‌ها قبلاً گذشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 713.62,
   "end": 715.82,
   "text": "بهشت هم خودت بهشت می‌شی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 715.82,
   "end": 719.82,
   "text": "آنچه که می‌بینی-- اساساً ما در خواب چرا اینا رو می‌بینیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 719.82,
   "end": 721.86,
   "text": "چرا آسمون و زمین می‌بینیم؟ چرا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 721.86,
   "end": 724.06,
   "text": "انسان و حیوان و نبات و جماد می‌بینیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 724.06,
   "end": 728.6,
   "text": "چون تو این نشئه طبیعت با این صور و اشکال محشوریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 728.6,
   "end": 732.14,
   "text": "چون با اینا محشوریم تو خوابم همینا رو می‌بینیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 732.14,
   "end": 737.26,
   "text": "در حقیقت اونا مثال‌هایی هستن از این چیزی که تو این دنیا داریم می-می‌بینیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 737.26,
   "end": 741.56,
   "text": "تو این دنیا محشوریم باهاش. حالا علامه باز تو یه اصل دیگه‌ای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 741.56,
   "end": 745.2,
   "text": "میاد می‌فرماید اگر کسی مگه \"إِنَّا لِلَّهِ وَرَجَعُونَ\" رخ نداد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 745.2,
   "end": 750.32,
   "text": "شما بگید مگه تو خواب نمیری به سمت-- مگه خدا توفیه کامل کرد-- نکرد نفست رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 750.32,
   "end": 756.42,
   "text": "به محضر خدا برمی‌گردی. پس یقیناً از حضرت حق به تو القاءاتی رخ می‌ده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 756.42,
   "end": 759.56,
   "text": "القاءات صبوهی، الهامات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 759.56,
   "end": 762.26,
   "text": "حالا اینجا خیلی نبض قصه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 762.26,
   "end": 765.78,
   "text": "خوب گوش بدید. علامه یه اصل رو اونجا میان معرفی می‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 765.78,
   "end": 770.06,
   "text": "می‌گن اگر تو با واسطه اون القاءات رو بگیری یعنی با وجود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 770.06,
   "end": 773.22,
   "text": "موجود مجرد عقلی یعنی ملک یعنی فرشته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 773.22,
   "end": 776.44,
   "text": "فرشته تو خواب ببینی چون تو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 776.44,
   "end": 780.36,
   "text": "محشور نبودی تو این نشئه طبیعت فرشته رو نمی‌شناسی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 780.36,
   "end": 783.98,
   "text": "تو خواب اون القاءات فرشته رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 783.98,
   "end": 789.26,
   "text": "به صورت اشخاص و افراد انسان می‌بینی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 789.26,
   "end": 793.42,
   "text": "شبیه انسان می‌بینی. ولی القاءات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 793.42,
   "end": 796.04,
   "text": "به وسیله فرشته از طرف خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 796.04,
   "end": 797.8,
   "text": "حالا چرا منو دیدی؟ چرا اونو دیدی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 797.8,
   "end": 799.58,
   "text": "چرا این شکلی دیدی؟ چرا مریض دیدی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 799.58,
   "end": 801.66,
   "text": "چرا خندان دیدی؟ چرا گریان دیدی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 801.66,
   "end": 803.48,
   "text": "همه اینا تعبیر داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 803.48,
   "end": 807.64,
   "text": "باید عبور کنی. تعبیر یعنی عبور از ظاهر به باطن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 807.64,
   "end": 809.84,
   "text": "اگر بدون واسطه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 809.84,
   "end": 813.22,
   "text": "القاءات صبوهی حضرت حق به تو رخ بده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 813.22,
   "end": 818.96,
   "text": "اونچه که در خواب می‌بینی معمولاً به صورت صوت یا کلمه و نوشته می‌بینی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 818.96,
   "end": 821.54,
   "text": "یعنی مستقیم خدا یه چیزی رو به تو القا کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 821.54,
   "end": 825.8,
   "text": "خب حالا اگر اونچه که دیدی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 825.8,
   "end": 827.86,
   "text": "تعبیر خوبی داشت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 827.86,
   "end": 831.04,
   "text": "نفست پاکه، قلبت پاکه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 831.04,
   "end": 832.86,
   "text": "حالا باید تعبیرش رو رفت دنبالش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 832.86,
   "end": 835.02,
   "text": "مثلاً کتاب‌هایی مثل کتاب ابن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 835.02,
   "end": 837.56,
   "text": "سیرین کتاب خوبیه. من توصیه می‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 214,
   "start": 837.56,
   "end": 842.12,
   "text": "حضرت آیت الله صمدی آملی شاگرد برجسته علامه هم به این کتاب توصیه می‌کردند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 215,
   "start": 842.12,
   "end": 845.12,
   "text": "البته این کتاب درستش ابن شیرینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 216,
   "start": 845.12,
   "end": 852.0,
   "text": "مادر ایشون شیرین بوده اسمش بعداً کثرت تلفظ و اینا شد ابن سیرین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 217,
   "start": 852.0,
   "end": 855.66,
   "text": "پسر شیرین. اما در اصل شیرین بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 218,
   "start": 855.66,
   "end": 858.16,
   "text": "عبورها رو خوب داده اون کتاب برید بخونید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 219,
   "start": 858.16,
   "end": 861.2,
   "text": "اما اگر آنچه تمثل و صور",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 220,
   "start": 861.2,
   "end": 864.28,
   "text": "برزخی در خوابت رخ داد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 221,
   "start": 864.28,
   "end": 867.2,
   "text": "م-موجبات وحشت تو شد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 222,
   "start": 867.2,
   "end": 871.86,
   "text": "دهشتناک بود، عذاب‌آور بود، تلخ و صعب بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 223,
   "start": 871.86,
   "end": 873.8,
   "text": "اون‌ها نشان دهنده چیه عزیزم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 224,
   "start": 873.8,
   "end": 876.72,
   "text": "شما بفرمایید. قلب آثم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 225,
   "start": 876.72,
   "end": 880.12,
   "text": "قلب. اون باطنه. چون برزخ یه لایه پایینه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 226,
   "start": 880.12,
   "end": 883.38,
   "text": "پا-- پنهان وجود ماست. ملکوت وجود ماست برزخ.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 227,
   "start": 883.38,
   "end": 885.1,
   "text": "تو خواب میری به ملکوت وجودت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 228,
   "start": 885.1,
   "end": 887.2,
   "text": "اونجا دیگه قلبت حرف می‌زنه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 229,
   "start": 887.2,
   "end": 889.86,
   "text": "باطنت حرف می‌زنه با تو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 230,
   "start": 889.86,
   "end": 894.68,
   "text": "اگر اونجا خطرناک، زشت، کریه، بد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 231,
   "start": 894.68,
   "end": 897.62,
   "text": "تلخ، عقاب، عذاب،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 232,
   "start": 897.62,
   "end": 900.46,
   "text": "حیوانات درنده، گرگ و پلنگ،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 233,
   "start": 900.46,
   "end": 902.9,
   "text": "آتش این چیزا دیدی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 234,
   "start": 902.9,
   "end": 906.18,
   "text": "دیگه شرمنده‌م قلب دچار گناه شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 235,
   "start": 906.18,
   "end": 910.0,
   "text": "قلب آثم باید به دادش رسید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 236,
   "start": 910.0,
   "end": 911.68,
   "text": "اینو باید فر-- این یه اصله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 237,
   "start": 911.68,
   "end": 915.84,
   "text": "ببینید خودتو می‌شناسی، خوابتو می‌شناسی، نفستو می‌شناسی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 238,
   "start": 915.84,
   "end": 921.58,
   "text": "الانتو رسیدگی می‌کنی، می‌فهمی وقتی مردی چه خواهد شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 239,
   "start": 921.58,
   "end": 924.3,
   "text": "از الان هر شب خدا داره آلارم می‌ده به ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 240,
   "start": 924.3,
   "end": 927.9,
   "text": "آلارم، آلارم، آلارم. هی داره میگه که حواست باشه همینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 241,
   "start": 927.9,
   "end": 930.52,
   "text": "مرگ تو همینه. ببین چی می‌بینی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 242,
   "start": 930.52,
   "end": 933.08,
   "text": "از این صور و اشکال باید عبور کنی بری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 243,
   "start": 933.08,
   "end": 934.94,
   "text": "به اونجا. حالا بعد یه بحث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 244,
   "start": 934.94,
   "end": 941.14,
   "text": "تفصیلی خیلی سنگینی پیش میاد که حالا این صورت‌ها چی دارن به ما می‌گن، این اشکال چی میخوان به ما بگن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 245,
   "start": 941.14,
   "end": 945.24,
   "text": "که دیگه جاش اینجا نیست. انشاالله که عاقبتمون ختم به خیر بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 246,
   "start": 945.24,
   "end": 948.5,
   "text": "به برکت صلوات بر محمد و آل محمد. الله-",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}