 },
 "chapters": [
  {
   "index": 0,
   "title": "## پذیرش امام و رد نایب؛ ولایت ناقص",
   "start": 11.94,
   "end": 97.86
  },
  {
   "index": 1,
   "title": "## حدیث جعلی رفع قلم در نهم ربیع",
   "start": 97.86,
   "end": 214.02
  },
  {
   "index": 2,
   "title": "## دلتنگی ناقص؛ توحید قلبی ناتمام",
   "start": 214.02,
   "end": 251.64
  },
  {
   "index": 3,
   "title": "## روز ازدواج پیامبر و حضرت خدیجه؛ الگوی تفویض کامل",
   "start": 251.64,
   "end": 389.64
  },
  {
   "index": 4,
   "title": "## قلب مطمئن و مظروف قلب",
   "start": 389.64,
   "end": 535.58
  },
  {
   "index": 5,
   "title": "## روایت درندگان و امام عسکری",
   "start": 535.58,
   "end": 628.58
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 1.1,
   "end": 4.46,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 4.46,
   "end": 7.76,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 7.76,
   "end": 11.94,
   "text": "آیاته. سلام علیکم و رحمه الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 11.94,
   "end": 18.48,
   "text": "اگر کسی امام زمان رو بپذیره قبول کنه اما نائبش رو نپذیره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 18.48,
   "end": 22.08,
   "text": "چنین کسی ولایتش کامل نیست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 22.08,
   "end": 29.0,
   "text": "و اصلاً از جهت شرعی و فقهی اگر کسی مرجع تقلید نداشته باشه یعنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 29.0,
   "end": 34.66,
   "text": "توجه به فرامین ولی فقیهش حتی در شرع نکنه و در--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 34.66,
   "end": 40.12,
   "text": "به مجتهدش که همون نماینده عام امام عصر نکنه اصلاً نمازاش باطله شرعاً.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 40.12,
   "end": 42.18,
   "text": "واجباتش ازش قبول نمیشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 42.18,
   "end": 45.12,
   "text": "شما تصور کنید کسایی که مسلم رفته بود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 45.12,
   "end": 51.16,
   "text": "کوفه براشون بیعت بگیره برای ابی عبدالله بگن آقا ما امام حسین رو میخوایم کاری با شما نداریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 51.16,
   "end": 53.9,
   "text": "امام حسین رو دوست داریم اونو میخوایم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 53.9,
   "end": 56.58,
   "text": "تا وقتی امام حسین نیومد ما اصلاً کاری با شما نداریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 56.58,
   "end": 59.6,
   "text": "آیا این کار معقولانه است؟ این کار درسته از جهت دینی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 59.6,
   "end": 63.4,
   "text": "اصلاً غلطه دیگه. همین کار یکی از وجوه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 63.4,
   "end": 67.3,
   "text": "این که مسلم کشته شد و کربلا به پا شد همین شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 67.3,
   "end": 71.96,
   "text": "بعضیا اونجا گفتن، گفتن آقا ما تا حسینه نه علی نیاد کاری با نائبش نداریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 71.96,
   "end": 75.26,
   "text": "این یعنی دقیقاً مخالفته با امامه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 75.26,
   "end": 79.82,
   "text": "یعنی نمیشه انسان یک جزئی از دین رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 79.82,
   "end": 84.24,
   "text": "کاری که یهودیا کردن پاره‌ای از آیات رو پذیرفتن پاره‌ای رو نف--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 84.24,
   "end": 91.5,
   "text": "نپذیرفتن. دین یک بسته کامله نمیشه یک جزئیش رو بپذیره و یک جزء دیگه رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 91.5,
   "end": 95.74,
   "text": "نپذیری. باید همه رو با هم پذیرا باشی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 95.74,
   "end": 101.26,
   "text": "حالا این حدیثی که متأسفانه جعل شده به عنوان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 101.26,
   "end": 107.14,
   "text": "رفع القلم یا رفع قلم یا برت-- برداشت شدن قلم در نهم ربیع",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 107.14,
   "end": 110.66,
   "text": "الاول و هوشه که بعضیا امروز رو هم می‌گیرن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 110.66,
   "end": 114.68,
   "text": "این کاملاً حدیث جعلی‌ست و یک نوع بدعته در اسلام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 114.68,
   "end": 118.78,
   "text": "اصلاً اضافه کردن چیزیه که در اسلام نیست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 118.78,
   "end": 122.14,
   "text": "و اگر کسی اینجا بیاد بگه آقا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 122.14,
   "end": 126.54,
   "text": "فلان عالم یا فلان آخوند یا فلان آدم محقق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 126.54,
   "end": 129.58,
   "text": "همیشه حدیث رو بیان کرده و گفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 129.58,
   "end": 132.84,
   "text": "ما میگیم آقا باید پشت سر نایب امام عصر حرکت کنیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 132.84,
   "end": 136.04,
   "text": "و همون نقاب عام حضرات مراجع.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 136.04,
   "end": 138.66,
   "text": "مراجع چی میگن اونجا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 138.66,
   "end": 142.34,
   "text": "من امروز بررسی کردم نظرات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 142.34,
   "end": 148.5,
   "text": "مراجع رو هیچ کدومشون از مراجع و فقهای امامی ما همچین چیزی رو قبول ندارن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 148.5,
   "end": 155.22,
   "text": "و همشون صراحتاً رهبر عزیز، آقای مکارم، آقای سیستانی، آقای نوری همدانی همشون رد کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 155.22,
   "end": 159.0,
   "text": "اصلاً همچین حدیثی وجود نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 159.0,
   "end": 164.44,
   "text": "اگر هم-- حتی آقای نوری همدانی میگه اگر بر فرض بگیریم همچین حدیثی وجود داره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 164.44,
   "end": 167.54,
   "text": "میدونید رفع القلم بیا چ-- یعنی منظورش چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 167.54,
   "end": 172.84,
   "text": "یعنی امروز اگر کسی گناه کنه براش نمینویسن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 172.84,
   "end": 174.92,
   "text": "یعنی هر کاری دوست داری بکن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 174.92,
   "end": 182.92,
   "text": "بذار دیگه طرف وقاحت رو به تمام معنا میرسونه میگه آقا نوشته نمیشه هر غلطی می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 182.92,
   "end": 186.34,
   "text": "اصلاً ما همچین چیزی نداریم. تو اسلام وجود نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 186.34,
   "end": 190.84,
   "text": "یه همچین حدیثی جعل شده و متأسفانه بچه هیئتی‌های ما،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 190.84,
   "end": 198.88,
   "text": "بچه مذهبی‌های ما و بعضاً با تأسف بیشتر بچه انقلابی‌های ما این-- و هرچی هم بهشون میگی قبول نمی‌کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 198.88,
   "end": 201.08,
   "text": "باهاشون بحث علمی می‌کنی قبول نمی‌کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 201.08,
   "end": 203.16,
   "text": "بحث تخصصی کن قبول نمی‌کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 203.16,
   "end": 210.22,
   "text": "بحث اعتقادی می‌کنی مثل الان بحث اعتقادیه دیگه میگه ما ولی فقیه مرتبط با امام عصر نمیشه یکیشو بپذیر-- قبول کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 210.22,
   "end": 213.42,
   "text": "نمیشه شما امام عسکری رو بپذیری پسرشو نپذیری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 213.42,
   "end": 215.84,
   "text": "نمیشه. یکی از اشکالات کار اصلاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 215.84,
   "end": 221.3,
   "text": "حتی از بحث عرفانی بخوایم بحث کنیم، یکی از اشکالات کار اساسی قلب ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 221.3,
   "end": 227.16,
   "text": "اینه که دلتنگ امام زمان میشیم، دلتنگ امام عسکری نمیشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 227.16,
   "end": 229.02,
   "text": "اصلاً عرفا اینو اشکال کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 229.02,
   "end": 233.42,
   "text": "گفتن تو توهیدت وقتی کامله که دلتنگ همشون بشی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 233.42,
   "end": 237.06,
   "text": "نمیشه کسی دلتنگ رسول الله بشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 237.06,
   "end": 239.54,
   "text": "دلتنگ حضرت زهرا نشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 239.54,
   "end": 242.28,
   "text": "این مشکل داره یعنی معلومه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 242.28,
   "end": 245.5,
   "text": "اون توحیدش تو قلبش کاملاً تثبیت نشده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 245.5,
   "end": 250.42,
   "text": "اینم نگران‌کننده‌ست. ما باید پشت سر کار، کارشناس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 250.42,
   "end": 253.18,
   "text": "دینیمون حرکت کنیم. امروز روز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 253.18,
   "end": 256.58,
   "text": "تزویج پیغمبر و حضرت خدیجه سلام الله علیهماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 256.58,
   "end": 260.88,
   "text": "چه مناسبتی بهتر از این برای جشن گرفتن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 260.88,
   "end": 267.22,
   "text": ". بعد شما حضرت خدیجه رو ببینید تمام وجودش و تمام قلبش رو بهتره بگیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 267.22,
   "end": 270.16,
   "text": "تفویض پی-- به پیغمبر کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 270.16,
   "end": 273.98,
   "text": "در چه شرایطی؟ دیگه میدونید اهل مطالعه و تحقیقید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 273.98,
   "end": 277.76,
   "text": "که ایشون یعنی نفر اول بود تو تجارت، تو پول،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 277.76,
   "end": 279.56,
   "text": "داشتن سرمایه نفر اول بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 279.56,
   "end": 285.84,
   "text": "البته سرمایه پاک. من پارسال یادمه در خصوص شخصیت ایشون حرف زدم، صحبت کردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 285.84,
   "end": 288.78,
   "text": "سرمایه پاک و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 288.78,
   "end": 291.68,
   "text": "جالبه که با همون وضعیت میره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 291.68,
   "end": 296.16,
   "text": "خودش پیشنهاد ازدواج با پیغمبر رو مطرح می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 296.16,
   "end": 299.26,
   "text": "و اینم که متأسفانه تو تاریخ توسط",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 299.26,
   "end": 302.92,
   "text": "یکی از همسران پیغمبر شایع شده که ایشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 302.92,
   "end": 307.88,
   "text": "ااا من می‌دونم قبلاً یکی دو تا همسر داشته، باکره نبوده، سنش زیاد بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 307.88,
   "end": 310.24,
   "text": "اینا همش دروغه، اباطیله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 310.24,
   "end": 313.96,
   "text": "اتفاقاً مجرد بود، باکره بوده حضرت خدیجه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 313.96,
   "end": 316.26,
   "text": "جوون بوده، زیبارو بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 316.26,
   "end": 321.9,
   "text": "اما این-- خیلی هم خواستگار داشته، مخصوصاً از بزرگان عرب،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 321.9,
   "end": 330.44,
   "text": "از قریش انقدر خواستگار داشت ولی اومد همسر یک یتیم پابرهنه‌ای شد که همه بایکوتش کرده بودند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 330.44,
   "end": 337.24,
   "text": "و وقتی پیغمبر درسته بگید آقا شخصیت محبوبی داشت، پیغمبر امین بود، همه دوسش داشتن تا وقتی که کار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 337.24,
   "end": 339.0,
   "text": "سیاسی شروع نشده بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 339.0,
   "end": 344.3,
   "text": "به محض اینکه ااا موضوع بعثتش رو بیان کرد تموم شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 344.3,
   "end": 347.2,
   "text": "همه بر علیهش جبهه‌بندی کردن، صف‌آرایی کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 347.2,
   "end": 352.56,
   "text": "مثل یه عالمی که بشینه کار مقدسی انجام بده، شریعتو بگه همه دوسش دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 352.56,
   "end": 356.18,
   "text": "به محض اینکه میاد چهارتا حرف سیاسی و اجتماعی می‌زنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 356.18,
   "end": 360.04,
   "text": "انقلت‌ها شروع میشه پیغمبرم همه عموهاش رهاش کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 360.04,
   "end": 362.64,
   "text": "بدترین کارها رو با پیغمبر کردند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 362.64,
   "end": 366.78,
   "text": "توی همچین حالتی حضرت خدیجه ثروتشو ریخت پاش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 366.78,
   "end": 369.06,
   "text": "یه عمویی داشت. دلیلش فکر می‌کنید چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 369.06,
   "end": 376.64,
   "text": "حضرت خدیجه چرا تمام قلبش رو در اختیار پیغمبر گذاشت نه بخشی از قلبش رو؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 376.64,
   "end": 380.56,
   "text": "علت اصلیش این بود، یکی از علت‌هاش من بررسی تاریخی کردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 380.56,
   "end": 383.28,
   "text": "یه عمویی ایشون داشته خیلی اهل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 383.28,
   "end": 386.12,
   "text": "معنویت بوده، خیلی آدم موحدی بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 386.12,
   "end": 391.22,
   "text": "این عموش نشانه‌های پیغمبر رو در رسول خدا دید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 391.22,
   "end": 393.78,
   "text": "و به حضرت خدیجه فرمود که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 393.78,
   "end": 396.32,
   "text": "این همون پیغمبر و منجی آخره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 396.32,
   "end": 403.26,
   "text": "این همونه. وقتی حضرت خدیجه اعتقادش محکم شد به پیغمبر دیگه ریخت زندگیشو پاش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 403.26,
   "end": 409.5,
   "text": "می‌خوام بگم آقا ما یا نباید انتخاب کنیم یا وقتی انتخاب کردیم بریزیم خودمون رو پای دین بریزیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 409.5,
   "end": 413.24,
   "text": "معniیت دیگه نباید داشته باشیم. نه من این بخش از دین رو می‌پذیرم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 413.24,
   "end": 414.92,
   "text": "حالا دیگه می‌خوام عشق و حال کنم دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 414.92,
   "end": 416.76,
   "text": "انشاالله که رفع الغلم درسته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 416.76,
   "end": 421.6,
   "text": "اینطوری نمی‌شه که. قلب ما باید کاملاً در اختیار اون‌ها باشه و الا به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 421.6,
   "end": 424.54,
   "text": "اطمینان به مقام آرامش و اطمینان نمی‌رسیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 424.54,
   "end": 426.62,
   "text": "بحث ما قلب اطمینان بود دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 426.62,
   "end": 429.56,
   "text": "که امروز دیگه آخرین جلسه‌ش باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 429.56,
   "end": 432.88,
   "text": "که واقعاً یکی از دلایل تزلزل ما، ریب و شک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 432.88,
   "end": 440.52,
   "text": "ما، اینکه ما ثبات اندیشه و قدم نداریم، متزلزلیم اینه که تمام قلبمون در اختیار دین قرار نگرفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 440.52,
   "end": 442.78,
   "text": "دو تا چهار تایی هم برای خودمون کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 442.78,
   "end": 447.58,
   "text": "شما به قول حضرت آیت‌الله هایری یه مثال قشنگی می‌زدن خدا حفظشون کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 447.58,
   "end": 453.48,
   "text": "می‌فرمودن دو تا کاغذ رو بردارید رو یکیش عکس حضرت امام رو بکشید رو یکیش عکس شاه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 453.48,
   "end": 456.34,
   "text": "شاه ملعون رو بکشید. هر دو یک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 456.34,
   "end": 458.74,
   "text": "جنسن. هر دو کاغذن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 458.74,
   "end": 460.68,
   "text": "اما اون کاغذی که روش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 460.68,
   "end": 463.86,
   "text": "اس-- عکس حضرت امامه رو چشت می‌ذاری،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 463.86,
   "end": 466.6,
   "text": "احترام می‌ذاری، بالا طاقچه می‌ذاری،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 466.6,
   "end": 472.36,
   "text": "تابلوش می‌کنی. اون کاغذی که عکس شاه روشه پاره می‌کنی می‌ریزی تو مستراح.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 472.36,
   "end": 474.12,
   "text": "مگر یک جنس نبود هر دو؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 474.12,
   "end": 479.3,
   "text": "چرا این اتفاق افتاد؟ به جهت اون مفروز نه ظرف.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 479.3,
   "end": 481.88,
   "text": "ظرف یه چیزه. قلب انسان یک ظرفه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 481.88,
   "end": 488.04,
   "text": "همه هم یک جنسه. لکن اون چیزی که درش قرار گرفته، عکسی که توش افتاده، اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 488.04,
   "end": 491.58,
   "text": "مظروف، اون ارزش قلب ما رو می‌رسونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 491.58,
   "end": 494.36,
   "text": "پیغمبر در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 494.36,
   "end": 499.36,
   "text": "به عنوان انسان کامل در قلب حضرت خدیجه به تمام معنا تجلی کرده و جای گرفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 499.36,
   "end": 502.0,
   "text": "حضرت خدیجه وجودش رو پاش ریخت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 502.0,
   "end": 505.88,
   "text": "خدا هم به قول علامه حسن‌زاده یک جایزه به حضرت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 505.88,
   "end": 511.1,
   "text": "خدیجه داد به نام حضرت صدیقه طاهره حضرت زهرا که یه دونه‌ست نمونه نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 511.1,
   "end": 514.38,
   "text": "و الا یه همچین مجاهدتی همچین جایزه‌ای هم داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 514.38,
   "end": 516.16,
   "text": "اما من اینطوری نیستم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 516.16,
   "end": 523.26,
   "text": "من بخشی از دین رو قلباً پذیرفتم، بخشیش رو که مطابق با سلیقه‌های شخصی و غرض هم نیست نمی‌پذیرم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 523.26,
   "end": 525.68,
   "text": "اگر اینطوری باشه هیچوقت ما به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 525.68,
   "end": 529.5,
   "text": "ثبات رأی یا اندیشه و ثبات اعتقادی دست پیدا نمی‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 529.5,
   "end": 532.56,
   "text": "باید تمام قلبمون یکپارچه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 532.56,
   "end": 539.24,
   "text": "خرج اونا بشه. من از شما سؤال می‌کنم چطور روایت داریم امام عسکری رو شخصی به نام نُهیر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 539.24,
   "end": 542.28,
   "text": "که حالا من روایتش هم اینجا سطرش رو نوشتم خواستید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 542.28,
   "end": 544.92,
   "text": "میره، می‌بره میندازه جلوی حیوانات درنده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 544.92,
   "end": 548.36,
   "text": "یکی از راه‌های ادامه‌قدیم این بود که بخورن حضرت رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 548.36,
   "end": 552.12,
   "text": "میره برمی‌گرده خیالش اینه که الان خوردن حضرت رو استخوناش مونده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 552.12,
   "end": 556.08,
   "text": "میاد می‌بینه حضرت امام عسکری داره نماز می‌خونه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 556.08,
   "end": 558.32,
   "text": "و عده‌ای برای امام هادی هم البته اینو گفتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 558.32,
   "end": 560.74,
   "text": "ولی این روایتی که من میگم مال امام عسکریه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 560.74,
   "end": 567.58,
   "text": "عده‌ای دارن-- حیوانات درنده دورش نشستن ههمه می‌کنن حضرت داره نماز می‌خونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 567.58,
   "end": 572.54,
   "text": "چرا؟ چرا دل من پر از حیوانات درنده می‌شه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 572.54,
   "end": 575.6,
   "text": "چرا حیواناتی که منشاء غضبیّتن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 575.6,
   "end": 578.26,
   "text": "یا عرض کنم جلوه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 578.26,
   "end": 581.2,
   "text": "شهویّت این‌ها در قلب من هجوم میارن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 581.2,
   "end": 583.42,
   "text": "چون امام عسکری تو قلب من نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 583.42,
   "end": 586.8,
   "text": "اگر باشه اونا نمیان. اصلاً کاری ندارن به قلب من.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 586.8,
   "end": 589.5,
   "text": "از همین روایت انسان می‌تونه این برداشت رو بکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 589.5,
   "end": 594.46,
   "text": "پس وقتی ما می‌تونیم قلبمون به مقام اطمینان برسه و وقتی می‌تونیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 594.46,
   "end": 599.16,
   "text": "آرامش کامل داشته باشیم که همشون تو قلب ما جای بگیرن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 599.16,
   "end": 602.6,
   "text": "دستورات همه‌شون تو قلب ما جای بگیرن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 602.6,
   "end": 605.14,
   "text": "نائبش هم تو قلب ما جای بگیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 605.14,
   "end": 608.78,
   "text": "هر کسی که امام عسکری دست تأیید رو اون گذاشته، هر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
