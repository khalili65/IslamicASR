 "chapters": [
  {
   "index": 0,
   "title": "## عدول از نیت در نماز",
   "start": 14.74,
   "end": 69.78
  },
  {
   "index": 1,
   "title": "## جایگاه قلب؛ سمع و بصر و فؤاد",
   "start": 69.78,
   "end": 128.14
  },
  {
   "index": 2,
   "title": "## سنگدلی در برابر محبت پیامبر",
   "start": 128.14,
   "end": 149.42
  },
  {
   "index": 3,
   "title": "## عناوین قلب در قرآن",
   "start": 149.42,
   "end": 553.55
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 2.26,
   "end": 5.5,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 5.5,
   "end": 9.06,
   "text": "السلام علیک ای داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 9.06,
   "end": 13.56,
   "text": "آیاته. سلام علیکم و رحمه الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 13.56,
   "end": 16.58,
   "text": "یه بابی هست در فقه پیرامون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 16.58,
   "end": 20.22,
   "text": "بحث نیت که این خیلی هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 20.22,
   "end": 22.72,
   "text": "حاشیه داره و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 22.72,
   "end": 31.16,
   "text": "تبصره. یکی از موارزش عدول از نیت در نماز هست که این رو فعلاً به صورت کلی بدونیم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 31.16,
   "end": 34.58,
   "text": "مقام معظم رهبری استفتایی که ازشون شده ایشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 34.58,
   "end": 39.44,
   "text": "اجازه دادن که از اه نماز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 39.44,
   "end": 43.88,
   "text": "واجب به نماز مستحبی نیت برگرده و عدول کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 43.88,
   "end": 46.44,
   "text": "مثلا داری نماز واجب می‌خونی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 46.44,
   "end": 48.98,
   "text": "بخوای نه-- اه استحبابیش کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 48.98,
   "end": 53.2,
   "text": "نماز نیتو برگردونی وسط نماز و مستحبیش کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 53.2,
   "end": 56.1,
   "text": "اما بلعکسشو جایز نمی‌دونه رهبری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 56.1,
   "end": 58.78,
   "text": "اینکه در نماز مستحبی هستی بعد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 58.78,
   "end": 60.6,
   "text": "نیتت رو به واجب تغییر بدی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 60.6,
   "end": 62.9,
   "text": "حالا موارد متعددی داره که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 62.9,
   "end": 69.08,
   "text": "باید تو بحث نیت رساله عملیه ایشون رو ببینید انشاالله ما بالا رو عرض می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 69.08,
   "end": 73.54,
   "text": "ما رسیدیم به موضوع بسیار مهم قلب و جایگاه قلب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 73.54,
   "end": 77.44,
   "text": "امشب، امروز به فضل الهی یک معرفی کلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 77.44,
   "end": 83.44,
   "text": "پیرامون عناوین قلب رو داشته باشیم که می‌دونید جایگاه بسیار مهمی قلب داره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 83.44,
   "end": 85.66,
   "text": "همونطور که قبلاً عرض کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 85.66,
   "end": 89.34,
   "text": "بر اساس آیه \"إن السمع والبصر والفؤاد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 89.34,
   "end": 92.84,
   "text": "كل أولئك كان عنه مسؤولا\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 92.84,
   "end": 96.78,
   "text": "جالبه که خب سمع و بصر رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 96.78,
   "end": 102.48,
   "text": "چشم و گوش رو میاره مقدمه فؤاد که قلب‌ست قرار میده در این آیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 102.48,
   "end": 104.64,
   "text": "بعد می‌فرماید اینا همه مسئولن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 104.64,
   "end": 107.98,
   "text": "یعنی مورد سؤال واقع میشن و باید جواب بدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 107.98,
   "end": 112.8,
   "text": "لکن همه علمای اخلاقی فرمودن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 112.8,
   "end": 117.66,
   "text": "چشم و گوش و بقیه اعضا به منزله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 117.66,
   "end": 120.82,
   "text": "جواره و اه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 120.82,
   "end": 125.96,
   "text": "ابزار قلب‌اند. همینطور که اینجا می‌فرماید \"إن السمع والبصر\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 125.96,
   "end": 128.14,
   "text": "یعنی مقدم قرار میده این‌ها رو بر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 128.14,
   "end": 134.44,
   "text": "قلب یا فؤاد. یعنی اینکه آنچه که به قلب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 134.44,
   "end": 141.78,
   "text": "خطور پیدا می‌کنه اعم از مثبت و منفی از جواره خاص چشم و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 141.78,
   "end": 145.56,
   "text": "گوش که حالا اینو باید بعداً انشاالله بحث بشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 145.56,
   "end": 149.42,
   "text": "خصوصاً گوش که ما ازش غافل هستیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 149.42,
   "end": 155.42,
   "text": "اه یکی از مهم‌ترین دریچه‌های قلب هست و منافذ قلب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 155.42,
   "end": 158.36,
   "text": "از این طریق خطورات به قلب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 158.36,
   "end": 162.0,
   "text": "منتقل می‌شه و اگر کسی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 162.0,
   "end": 164.66,
   "text": "میگیم قلبش سالم موند،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 164.66,
   "end": 170.5,
   "text": "اعضا سالم می‌مونن یا قلبش فاسد شد اعضا فاسد می‌شن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 170.5,
   "end": 175.66,
   "text": "در حقیقت خروجی‌های این منافذ به قلب‌اند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 175.66,
   "end": 179.22,
   "text": "که قلب رو فاسد یا سالم نگه می‌دارند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 179.22,
   "end": 183.56,
   "text": "و این خروجی‌ها تحت امر قلب البته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 183.56,
   "end": 192.16,
   "text": "این ورودی‌ها ببخشید. آنچه که وارد می‌شه از این منافذ به قل-- به وجود انسان، به قلب انسان تحت امر قلب از ابتدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 192.16,
   "end": 196.92,
   "text": "قلبه که به انسان میگه اجازه بده ورودی وجودت چی باشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 196.92,
   "end": 200.66,
   "text": "یا جلوی ورودی رو می‌گیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 200.66,
   "end": 203.0,
   "text": "پس باز بر می‌گردیم به قلب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 203.0,
   "end": 206.56,
   "text": "از-- اصلاً حرف اول رو قلبه می‌زنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 206.56,
   "end": 209.0,
   "text": "و مورد سؤال هم واقع می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 209.0,
   "end": 213.58,
   "text": "اینکه ابا عبدالله در کربلا کارهای بسیار عجیبی کردن، یکی از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 213.58,
   "end": 219.96,
   "text": "عجیب‌ترین کارهایی که ابا عبدالله سلام الله علیه در کربلا کرده و ما خیلی راحت از کنارش می‌گذریم، همین قصه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 219.96,
   "end": 222.86,
   "text": "آقا حضرت علی اصغر علیه الصلاة والسلام‌ هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 222.86,
   "end": 226.94,
   "text": "کار بسیار عجیبیه که آقایی مثلاً قنداق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 226.94,
   "end": 233.22,
   "text": "شش ماهه رو بلند کنن رو دست و عمامه پیغمبر به سر بگذارن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 233.22,
   "end": 240.56,
   "text": "و بیان وسط میدان شروع کنن خطبه خوندن این بچه رو بلند کنن و بگن ببرید خودتون سیرابش کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 240.56,
   "end": 243.04,
   "text": "من نه برای خودش آب خواسته که برای بچه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 243.04,
   "end": 245.58,
   "text": "این نشون میده که می‌خواد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 245.58,
   "end": 252.84,
   "text": "یعنی هدف یکی از مهم‌ترین اهداف سید الشهدا شاید بهش-بهتر باشه گفت مهم‌ترینش اصلاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 252.84,
   "end": 257.32,
   "text": "همین تأثیر در قلوب هست، قلب‌ها رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 257.32,
   "end": 262.14,
   "text": "اگر کسی یه رگه‌ای از رقت هنوز در قلبش مونده باشه اینجا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 262.14,
   "end": 265.22,
   "text": "متأثر بشه و کما اینکه شدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 265.22,
   "end": 269.96,
   "text": "اصلاً لشکر یه ذره به هم ریخت و از اونجا به بعد ملتهب شد لشکر عمر سعد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 269.96,
   "end": 275.34,
   "text": "اینکه ابا عبدالله شب عاشورا با دلا بازی می‌کنه می‌فرماید پاشید برید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 275.34,
   "end": 278.54,
   "text": "این نورها رو کم می‌کنه یا خاموش می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 278.54,
   "end": 281.18,
   "text": "چرا آقا فرمود پاشید برید؟ می‌خواد تصفیه کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 281.18,
   "end": 284.64,
   "text": "نمی‌خواد کسی که یه رگه‌ای از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 284.64,
   "end": 286.82,
   "text": "سختی و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 286.82,
   "end": 290.24,
   "text": "پستی در قلبش وجود داره پاشه بره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 290.24,
   "end": 291.9,
   "text": "کما اینکه شد که خیلیا رفتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 291.9,
   "end": 297.84,
   "text": "اما اینکه روز عاشورا بلعکس شب عاشورا یار طلب می‌کنه و کارهای عجیبی مثل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 297.84,
   "end": 302.02,
   "text": "جریان حضرت علی اصغر علیه الصلاة والسلام رو انجام میده، می‌خواد اون ر-- اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 302.02,
   "end": 305.98,
   "text": "قلوبی که هنوز یه خلوصی یک خ-- اه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 305.98,
   "end": 308.74,
   "text": "عرض کنم رگه‌هایی از اخلاص و ایمان تو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 308.74,
   "end": 311.64,
   "text": "قلبشون وجود داره رو تکون بده و اون‌ها رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 311.64,
   "end": 315.92,
   "text": "یعنی یه نفرم باقی نمونه. شب عاشورا اگر یه ناخالص هست بره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 315.92,
   "end": 319.56,
   "text": "روز عاشورا اگر یه خالص مونده تو صف دشمن بیاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 319.56,
   "end": 322.54,
   "text": "این کار سید الشهداست. اما با چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 322.54,
   "end": 326.88,
   "text": "با دستاویز قرار دادن کارهایی که قلب طرف رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 326.88,
   "end": 329.3,
   "text": "منقلب کنه، تحت تأثیر قرار بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 329.3,
   "end": 332.06,
   "text": "قلب خیلی ح-- خیلی مهمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 332.06,
   "end": 334.3,
   "text": "یعنی پیغمبر یه روز نشسته بودن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 334.3,
   "end": 336.8,
   "text": "در مسجد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 336.8,
   "end": 340.78,
   "text": "یکی اومد نمی‌دونم نه تا چقدر بچه داشت، زیاد بچه داشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 340.78,
   "end": 344.54,
   "text": "بعد به پیغمبر گفت يا رسول الله من یه بارم بچه‌هامو نبوسیدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 344.54,
   "end": 347.36,
   "text": "اینقدر شما نواهاتو می‌بوسی، حسن رو می‌بوسی، حسین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 347.36,
   "end": 350.58,
   "text": "من یه بارم اینا رو نبوسیدم. پیغمبر گریه‌ش گرفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 350.58,
   "end": 354.94,
   "text": "از حرف این شخص سنگدل گریه‌ش گرفت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 354.94,
   "end": 359.66,
   "text": "و وقتی پاشد رفت طرف پیغمبر همینطور گریه می‌کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 359.66,
   "end": 364.93,
   "text": "همان از این سختی قلب که این‌ها از رحمت خدا به دورن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 364.93,
   "end": 366.59,
   "text": "پس قلب خیلی مهمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 366.59,
   "end": 369.59,
   "text": "ما نباید از قلبمون غافل بشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 369.59,
   "end": 373.21,
   "text": "حالا این بحثی‌ست که انشاالله به فضل الهی باید با هم داشته باشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 373.21,
   "end": 376.61,
   "text": "شاید، شاید حدود صد جلسه طول بکشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 376.61,
   "end": 379.37,
   "text": "اگه ما زنده باشیم و شما هم باشید و.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 379.37,
   "end": 383.97,
   "text": "لکن حالا من عناوین کلی‌ش رو بر اساس آیات قرآن به شما بگم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 383.97,
   "end": 386.89,
   "text": "تند و تند و هم تبرکاً.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 386.89,
   "end": 389.13,
   "text": "هر کدوم از این عناوینی که میگم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 389.13,
   "end": 395.75,
   "text": "یا یک آیه در قرآن یا مثلاً هفت هشت تا ده تا آیه پیرامونش اومده که این‌ها رو انشاالله باید به مرور",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 395.75,
   "end": 401.37,
   "text": "در هر جلسه بحث کنیم؛ شاید بعضی‌هاشو تو دو سه جلسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 401.37,
   "end": 404.91,
   "text": "بعضی از این‌ها قلب‌های خوب هستن بعضیاشون قلب‌های بد هستن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 404.91,
   "end": 410.63,
   "text": "دیگه حالا توضیحاتش رو باید برای بعد-- من فقط عناوینو میگم و السلام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 410.63,
   "end": 413.89,
   "text": "قلب مهر خورده، قلب زایغ،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 413.89,
   "end": 419.33,
   "text": "قلب مطمئن، قلب مختوم، قلب مریض، قلب مرعوب،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 419.33,
   "end": 423.43,
   "text": "قلب خاشع، قلب قسی، قلب منافق،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 423.43,
   "end": 426.93,
   "text": "قلب وجل یعنی ترسان از یاد خدا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 426.93,
   "end": 429.83,
   "text": "قلب مکنون یعنی نفهم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 429.83,
   "end": 432.53,
   "text": "قلب غیر متفقه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 432.53,
   "end": 437.35,
   "text": "نمی‌فهمه حقیقت رو، عمق حقیقت رو، قلب قلف،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 437.35,
   "end": 441.75,
   "text": "قلب قفل، این قلف بود این قفل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 441.75,
   "end": 446.51,
   "text": "قلب متشابه، قلب آثم با سه تا نقطه یعنی گناهکار،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 446.51,
   "end": 450.47,
   "text": "قلب مشروب یعنی آمیخته شده به غیر خدا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 450.47,
   "end": 454.33,
   "text": "قلب منغمر یعنی بی‌خبر، قلب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 454.33,
   "end": 457.01,
   "text": "صغو یعنی منحرف،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 457.01,
   "end": 459.63,
   "text": "قلب مشمئز، قلب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 459.63,
   "end": 463.73,
   "text": "فرودگاه وه یا جایگاه وه، قلب کاسب،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 463.73,
   "end": 467.53,
   "text": "قلب منقلب یا همون دگرگون، قلب معلوف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 467.53,
   "end": 472.29,
   "text": "یعنی با محبت، قلب ممحوص یا خالص،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 472.29,
   "end": 475.43,
   "text": "قلب حسرت‌دار،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 475.43,
   "end": 481.11,
   "text": "قلب غلیظ، قلب متحر، قلب غیر متحر، قلب ممتحن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 481.11,
   "end": 485.95,
   "text": "قلب آرام شده، قلب مهدی یا هدایت یافته،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 485.95,
   "end": 488.11,
   "text": "قلب سلیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 488.11,
   "end": 491.59,
   "text": "قلب رئوف، قلب بی‌غل و غش،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 491.59,
   "end": 499.11,
   "text": "قلب سرکش، قلب خشمگین، قلب بدخواه، قلب مضطرب، قلب شکاک، قلب تائب،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 499.11,
   "end": 502.67,
   "text": "قلب مشدود یا سخت شده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 502.67,
   "end": 512.57,
   "text": "قلب مقطع یعنی قطعه، قطعه شده، قلب مقلوب یا وارونه، قلب عاقل، قلب مؤمن، قلب کور، قلب ثابت، قلب مصروف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 512.57,
   "end": 514.55,
   "text": "که از یاد خدا منصرف شده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 514.55,
   "end": 519.25,
   "text": "قلب مغفول، قلب مسلوک یعنی مورد نفوذ واقع شده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 519.25,
   "end": 526.21,
   "text": "قلب منکر یا انکار کننده، قلب زنگار گرفته، قلب متقی، قلب جان‌به‌لب،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 526.21,
   "end": 530.63,
   "text": "قلب مزین، قلب لاهی که مشغول لهو و لهو و لعبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 530.63,
   "end": 533.31,
   "text": "حدود شصت عنوان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 533.31,
   "end": 536.73,
   "text": "تقریباً حدود شصت عنوان از قلب هست که در قرآن aboutش بحث شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 536.73,
   "end": 540.19,
   "text": "حالا این فارغ از بحث فؤاد و سدر است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 540.19,
   "end": 542.61,
   "text": "اونا رو هم بخوایم بگیم که خیلی می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 542.61,
   "end": 549.23,
   "text": "فقط بحث قلب. انشاالله که عاقبتمون ختم به خیر بشه به ذکر صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 549.23,
   "end": 553.55,
   "text": "اللهم صل على محمد و آل محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}