 "chapters": [
  {
   "index": 0,
   "title": "## خانوادهٔ مرحومه؛ شرط اطمینان قلبی",
   "start": 11.38,
   "end": 31.68
  },
  {
   "index": 1,
   "title": "## انما العلم ثلاثة؛ علم و فضل",
   "start": 31.68,
   "end": 291.18
  },
  {
   "index": 2,
   "title": "امام رضا علیه‌السلام — به نقل میزان‌الحکمه، جلد هشت، حدیث سیزده‌هزار و هفتصد و نود و هفت — فرمود:",
   "start": 291.18,
   "end": 370.03
  },
  {
   "index": 3,
   "title": "## داستان علامه حسن‌زاده و دل شکستهٔ فرزندان",
   "start": 370.03,
   "end": 390.19
  },
  {
   "index": 4,
   "title": "## فرزند نه‌ساله و آگهی تلویزیون",
   "start": 390.19,
   "end": 592.09
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.7,
   "end": 4.36,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 4.36,
   "end": 8.36,
   "text": "السلام علیک یا داعی الله و ربانی آیات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 8.36,
   "end": 11.38,
   "text": "السلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 11.38,
   "end": 15.78,
   "text": "موضوع ما بحث قلب بود و رسیدیم به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 15.78,
   "end": 21.66,
   "text": "اطمینان قلبی. عرض کردیم حدود شصت نوع قلب در قرآن وجود داره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 21.66,
   "end": 25.88,
   "text": "که ما نیت کردیم به فضل الهی اینا رو مختصراً البته توضیح بدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 25.88,
   "end": 33.72,
   "text": "متوجه بشیم حداقل یه موضوع در قرآن به چه صورت که اونم موضوع بسیار مهمی است که ما هر روز بهش در باهاش درگیریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 33.72,
   "end": 36.44,
   "text": "اولیش رو قلب اطمینان انتخاب کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 36.44,
   "end": 38.86,
   "text": "نکته خیلی مهمی رو امروز عرض می‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 38.86,
   "end": 46.52,
   "text": "خیلی هم سهل الوصول فهمش منتها عملیاتش یه ذره دشوار و کاربلدی می‌خواد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 46.52,
   "end": 48.88,
   "text": "اونم من خودم اسمش رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 48.88,
   "end": 54.18,
   "text": "خدا هم چنین به ذهن ما عنایت کرد و اینا اسمش رو گذاشتم خانواده مرحومه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 54.18,
   "end": 57.92,
   "text": "ما اگر چنانچه بخواهیم به اطمینان قلبی برسیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 57.92,
   "end": 60.38,
   "text": "لاجرم باید دین رو خوب بشناسیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 60.38,
   "end": 67.66,
   "text": "باید بدانیم دین ما، این مکتب و این مذهب و این آیین برای جمیع شئونات بشری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 67.66,
   "end": 70.56,
   "text": "از هنگام تولد تا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 70.56,
   "end": 75.46,
   "text": "مرگ و بعد از اون دستورالعمل داره و پاسخگو نیازهاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 75.46,
   "end": 78.58,
   "text": "این رو ما باید بدونیم و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 78.58,
   "end": 83.96,
   "text": "عملیاتی رو اختصاص بدیم، وقتی رو به این قضیه اختصاص بدیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 83.96,
   "end": 87.54,
   "text": "و این رو حداقل از خودمون و خونواده‌مون شروع کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 87.54,
   "end": 92.12,
   "text": "تا ما و خونواده‌مون، زن و بچه‌هامون متوجه این قضیه نشیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 92.12,
   "end": 96.36,
   "text": "که دین ما یک بسته کاملی‌ست که برای جمیع",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 96.36,
   "end": 102.14,
   "text": "شئونات ما جوابگو و پاسخگوست، هیچ‌وقت به اطمینان قلبی نخواهیم رسید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 102.14,
   "end": 104.64,
   "text": "اون موقع است که نمیشه توقع",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 104.64,
   "end": 110.96,
   "text": "داشته باشیم که بعداً پسفردا بچه‌هایمون تو این جامعه دچار مذهب‌ها و مکاتب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 110.96,
   "end": 115.28,
   "text": "انحرافی و حلقه‌های عرفان کاذب و چه وچه نشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 115.28,
   "end": 120.24,
   "text": "ما باید این رو برای خودمون اول تو زندگیمون جا بندازیم که دین یعنی چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 120.24,
   "end": 126.7,
   "text": "یه حدیثی من به شما مب-- بحث عرض می‌کنم در کتاب کافی جلد یک صفحه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 126.7,
   "end": 134.92,
   "text": "سی و دو که یک توضیح بسیار خوب و شاید بهترین توضیح رو پیرامون ذیل این حدیث حضرت علامه جوادی آملی کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 134.92,
   "end": 141.64,
   "text": "من توصیه می‌کنم برید سرچ کنید و توضیح علامه رو پیرامون این حدیث گوش بدید، بخونید خیلی زیباست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 141.64,
   "end": 144.58,
   "text": "که حضرت فرمودند که انما العلم ثلاثة.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 144.58,
   "end": 147.58,
   "text": "پیغمبر فرمودند علم سه دسته است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 147.58,
   "end": 150.94,
   "text": "آیه محکمه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 150.94,
   "end": 155.7,
   "text": "این آیه محکمه به قول آقای جوادی آملی بسیاری از علمای پیشین اینو ف--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 155.7,
   "end": 160.44,
   "text": "فقه و اصول می‌دونستن اما آقای جوادی می‌فرمود نه خیر این اعتقاداته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 160.44,
   "end": 164.84,
   "text": "او فریضه عادله این باید و نباید های شرعی است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 164.84,
   "end": 166.76,
   "text": "او سنت قائم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 166.76,
   "end": 169.12,
   "text": "و باید و نباید های اخلاقی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 169.12,
   "end": 171.54,
   "text": "این سه دسته علمن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 171.54,
   "end": 176.14,
   "text": "اعتقادات، شریعات، اخلاقیات، بایدها و نبایدهاشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 176.14,
   "end": 179.76,
   "text": "که اینا علمن. بعد حضرت فرمود و ما خلاه نفه و فضل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 179.76,
   "end": 182.96,
   "text": "هرچی به غیر از ایناست این فضله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 182.96,
   "end": 189.38,
   "text": "ما باید جایگاه علم و فضل رو از قرآن دربیاریم خودمون و به خونواده‌مون تبیین کنیم که تو دنبال چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 189.38,
   "end": 193.22,
   "text": "دنبال خودبرتری‌ای که فضیلت تو جامعه داشته باشی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 193.22,
   "end": 196.74,
   "text": "مثلاً مدرک تحصیلیه فلان جسم قوی یا نه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 196.74,
   "end": 200.08,
   "text": "دنبال علم و حقیقت و عرفان و شناختی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 200.08,
   "end": 204.38,
   "text": "وقتی علمش بالا رفت بعداً به فضیلت هم کشیده میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 204.38,
   "end": 207.8,
   "text": "ما باید توی این س-- م-- چه اشکالی داره تو زندگیمون ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 207.8,
   "end": 211.0,
   "text": "برای خودمون و اگر تو اجتماع",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 211.0,
   "end": 216.78,
   "text": "اشکال وارد می‌کنیم که دانشگاه‌های ما مثلاً اسلامی نیست، ادارجات ما اسلامی نیست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 216.78,
   "end": 221.58,
   "text": "بعضاً حتی متأسفانه امام حسن منو ببخشه بعضی حوزه‌های علمیه ما اسلامی نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 221.58,
   "end": 224.84,
   "text": "خیلی جالبه. بعضی از نهادهای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 224.84,
   "end": 228.1,
   "text": "به ظاهر دینی ما ضد دین عمل می‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 228.1,
   "end": 230.94,
   "text": "اگر اجتماع ما منکوس شده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 230.94,
   "end": 237.32,
   "text": "خب همش هم ما اشکال وارد می‌کنیم به مدیران، به مسئولین، به اون‌هایی که تراز بالان چه وچه و این‌ها خودمون چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 237.32,
   "end": 239.26,
   "text": "خودمم چی؟ خونوادم چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 239.26,
   "end": 242.48,
   "text": "مگر پیغمبر دعوت عشیرت اقربین نداشت؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 242.48,
   "end": 245.12,
   "text": "مگر با خونوادش و فامیل‌ها شروع نکرد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 245.12,
   "end": 248.26,
   "text": "مگر حضرت امام از خودش و بچه‌هاش شروع نکرد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 248.26,
   "end": 254.0,
   "text": "خودمون و بچه‌هامون، زندگیمون یک برنامه‌ای بریزیم اسمش هم بذاریم مثلاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 254.0,
   "end": 256.82,
   "text": "خانواده مرحومه. چرا میگم خانواده مرحومه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 256.82,
   "end": 259.18,
   "text": "این حدیث رو دقت کنید امام رضا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 259.18,
   "end": 261.92,
   "text": "سلام الله علیه فرمودن خیلی این حدیث زیباست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 261.92,
   "end": 264.2,
   "text": "خیلی قشنگه. واقعاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 264.2,
   "end": 267.86,
   "text": "جا داره که اصلاً این حدیثو ما برای بچه‌هامون بگیم، توضیح بدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 267.86,
   "end": 275.02,
   "text": "میزان الحکمة جلد هشت مخصوصاً میگم عدد حدیث رو سیزده هزار و هفتصد و نود و هفت عدد حدیثشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 275.02,
   "end": 281.76,
   "text": "خب این کتاب رو که آقای ری‌شهری جمع‌آوری کردن احادیثو چند تا حدیث ما از این تو خوندیم خودم رو عرض می‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 281.76,
   "end": 287.02,
   "text": "حضرت رضا قربونش بریم فرمودن رحم الله عبدا احیا امرنا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 287.02,
   "end": 290.78,
   "text": "خدا رحمت کنه بنده‌ای که امر ما را احیا کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 290.78,
   "end": 294.9,
   "text": "قال راوی قلت له فکیف یحیی امرکم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 294.9,
   "end": 297.48,
   "text": "يا ابن رسول الله چگونه امر شما احیا میشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 297.48,
   "end": 303.18,
   "text": "قال يتعلم علومنا و یعلمها الناس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 303.18,
   "end": 307.46,
   "text": "به اینکه یاد بگیرن علوم ما رو و به مردم یاد بدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 307.46,
   "end": 311.06,
   "text": "این مردم همون خونواده کوچک خودمون می‌تونه باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 311.06,
   "end": 315.12,
   "text": "بعد فرمود لو علم محاسن کلامنا لتبعونا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 315.12,
   "end": 322.26,
   "text": "قطعاً اگر کسی لام تأکید هم میاره لتبعونا قطعاً اگر کسی زیبایی کلام ما را بشنوه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 322.26,
   "end": 326.62,
   "text": "بدانه قطعاً لتبعونا از ما تبعیت می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 326.62,
   "end": 335.46,
   "text": "انقدر دین ما زیباست. اگر بچه‌های ما به انحراف میرن به خاطر اینکه شیرینی دین رو در زندگی شخصی خودشون ندیدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 335.46,
   "end": 338.76,
   "text": "تو زندگی شخصی همش درد و مرض و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 338.76,
   "end": 346.14,
   "text": "فریاد و نمی‌دونم لجاجت و دعوای زن و شوهر، پدر و مادر دیدن و عدم اخلاق، عدم رعایت شئونات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 346.14,
   "end": 348.48,
   "text": "پدر نماز نمی‌خونه به بچه میگه چرا نمی‌خونی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 348.48,
   "end": 356.96,
   "text": "مادر لحاظ نمی‌کنه رعایت شریعت و حیا رو و زیربنای حیا و ارتباط با نامحرم و راحت با نامحرم میگه می‌خنده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 356.96,
   "end": 359.36,
   "text": "بعد توقع داره دخترش با حجاب باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 359.36,
   "end": 361.99,
   "text": "نمیشه باید این‌ها در زندگی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 361.99,
   "end": 365.89,
   "text": "رخ نشون بده. علامه حسن زاده در زندگی در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 365.89,
   "end": 368.57,
   "text": "خودش می‌فرمود که وقتی اومد تو خونه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 368.57,
   "end": 375.67,
   "text": "از بعد از یه نمازی خسته می‌خواست استراحت کنه بچه‌ها داد و فریاد کردن سر و صدای بچه‌ها تو خونه هممون هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 375.67,
   "end": 381.77,
   "text": "علامه حسن زاده، علامه حسن زاده، علامه حسن زاده، ابوعلی سینای عصر حاضر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 381.77,
   "end": 384.31,
   "text": "ایشون می‌فرمایند داد زدم سر بچه‌هام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 384.31,
   "end": 387.25,
   "text": "حالت بعد یه مدت قبض برام پیش اومد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 387.25,
   "end": 391.09,
   "text": "یعنی دیگه دلم از اون حالت اطمینان و اون آرامش خارج شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 391.09,
   "end": 394.21,
   "text": "حالت بدی قلب، سنگی قلب،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 394.21,
   "end": 396.91,
   "text": "سختی قلب. خودم متوجه شدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 396.91,
   "end": 398.99,
   "text": "ببینید مراقب خودش و خونواده‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 398.99,
   "end": 401.25,
   "text": "میگه رفتم بیرون یه سری معکولات برای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 401.25,
   "end": 403.91,
   "text": "بچه‌ها خریدم. اومدم دلجویی کردم درست نشد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 403.91,
   "end": 406.35,
   "text": "هرچی کردم درست نشد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 406.35,
   "end": 410.45,
   "text": "چه‌طور او به فکره که از تو خونواده شروع کنه اما نه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 410.45,
   "end": 413.49,
   "text": "میگه پاشدم رفتم تبریز برای یک حالت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 413.49,
   "end": 418.95,
   "text": "ا– عدم اطمینان قلبی و خروج از اون اعتدال قلبی برنامه داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 418.95,
   "end": 421.11,
   "text": "پاشد رفت تبریز محضر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 421.11,
   "end": 424.21,
   "text": "محمد-- حضرت آیت الله محمد حسن الهی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 424.21,
   "end": 430.71,
   "text": "تا بهش رسید هنوز حرف نزده گفت آقای، آقای آملی کجا بودی که کارت داشتم می‌خواستم برات نامه بنویسم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 430.71,
   "end": 433.81,
   "text": "نمی‌دونستم قومی نمی‌دونم آملی کجایی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 433.81,
   "end": 435.83,
   "text": "چی شده؟ پیش آقای قاضی بودم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 435.83,
   "end": 438.65,
   "text": "ناراحت شما بود. حرف شما به میون اومد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 438.65,
   "end": 441.19,
   "text": "سفارش شما رو بهش کردم. فرمود این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 441.19,
   "end": 445.41,
   "text": "حسن زاده چگونه هوس این راه رو داره در حالی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 445.41,
   "end": 447.51,
   "text": "دل بچه‌هاشو شکسته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 447.51,
   "end": 450.59,
   "text": "اونجا بود که علامه میگه من اشکم جاری شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 450.59,
   "end": 454.03,
   "text": "ببین حضرت آیت الله فاطمی نیا می‌فرمود زندگی که توش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 454.03,
   "end": 457.73,
   "text": "دعوای بین زن و شوهر و عصبیت باشه برکت از اون زندگی میره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 457.73,
   "end": 459.73,
   "text": "ما برا-- چه اشکالی داره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 459.73,
   "end": 466.01,
   "text": "اصلاً همین مبنی-- مبانی شرعی، اخلاقی، اعتقادی رو از خودمون تو زندگیمون شروع کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 466.01,
   "end": 468.51,
   "text": "همین دیروز پسر نه ساله من",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 468.51,
   "end": 475.05,
   "text": "به من گفت بابا اگه من چهل میلیون داشتم مثلا این قرعه کشی‌ها تلویزیون دید سریع عکس العملش چی بود؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 475.05,
   "end": 480.41,
   "text": "بابا اینجا داره برای نمیدونم بایودنت چی چی صد میلیون میده بریم بادامس بخریم صد میلیون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 480.41,
   "end": 482.87,
   "text": "گفتم خب صد میلیون درآوردی میخوای چیکار کنی بابا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 482.87,
   "end": 486.45,
   "text": "گفت برم یک N90 خوشگل برات بخرم بقیشم فلان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 486.45,
   "end": 489.29,
   "text": "گفتم خب خوبه پسرم عمو دست نگه دار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 489.29,
   "end": 492.43,
   "text": "آخر کار ما چیه؟ بچه‌ست ولی می‌فهمه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 492.43,
   "end": 498.79,
   "text": "ما چطور اینطوری رفتار نمی‌کنیم بعد توقع داریم بچه ما عالم بیرون بیاد، دین‌پرور بیرون بیاد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 498.79,
   "end": 502.45,
   "text": "جهت‌گیری‌هاشو از اول ابتدای بچگی درست نمی‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 502.45,
   "end": 506.35,
   "text": "گفتم پسرم خب به من بگو آخر کار ما تو این دنیا چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 506.35,
   "end": 508.93,
   "text": "گفت همه می‌میریم. نه سالش هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 508.93,
   "end": 511.65,
   "text": "گفتم خب رفتیم چی با خودمون می‌بریم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 511.65,
   "end": 513.79,
   "text": "گفت هیچی. گفتم هیچی که نمی‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 513.79,
   "end": 515.95,
   "text": "چی می-- خونه میبریم؟ گفت نه. ماشین میبریم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 515.95,
   "end": 518.29,
   "text": "نه. مدرک میبریم؟ نه. اینو گفت نه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 518.29,
   "end": 521.79,
   "text": "گفتم خب چی میبریم؟ گفت اعمالمون و می‌بریم پس-- پدر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 521.79,
   "end": 524.21,
   "text": "بابا. گفتم خب تمام. بیا ع--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 524.21,
   "end": 528.67,
   "text": "اگر قراره همه چی رو بذاریم و بریم اول اونورو درست کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 528.67,
   "end": 530.57,
   "text": "بعداً اگه وقت کردیم اینورم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 530.57,
   "end": 532.35,
   "text": "درست می‌کنیم. به فکر اینورم باشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 532.35,
   "end": 534.51,
   "text": "رفت تو فکر. وقتی ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 534.51,
   "end": 543.73,
   "text": "در قبال یک جهت‌گیری بچمون از آگهی، آگهی تلویزیون نمی‌تونیم خط دیواره درست بکنیم، چطور توقع داریم بچه بعداً بشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 543.73,
   "end": 546.01,
   "text": "پسر پیغمبر خلاف--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 546.01,
   "end": 551.17,
   "text": "یعنی ما باید بدونیم که برای جمیع شؤونات و نیازهای بشری، اعم از اد--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 551.17,
   "end": 558.73,
   "text": "حواس ادراکی و غیر ادراکی ما، دین ما جهت‌گیری داره، خط و مشی داره، برنامه داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 558.73,
   "end": 561.61,
   "text": "بیایید از خودمون داخل زندگیمون شروع کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 561.61,
   "end": 563.81,
   "text": "خانواده مرحوم و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 563.81,
   "end": 566.49,
   "text": "این روایت امام رضا که رحم الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 566.49,
   "end": 569.05,
   "text": "عبدا ام احیا امرا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 569.05,
   "end": 572.85,
   "text": "کسی خدا رحمت کنه اون اصلا خونواده‌ای که امر ما را احیا کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 572.85,
   "end": 576.01,
   "text": "ببخشید یه ذره طول کشید. انشالله که عاقبتمون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 576.01,
   "end": 578.61,
   "text": "خیر بشه. خانواده‌ای داشته باشیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 578.61,
   "end": 582.41,
   "text": "خانواده‌ای که به اطمینان قلبی برسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 582.41,
   "end": 592.09,
   "text": "به ذکر صلوات بر محمد و آل محمد الله- اللهم صل علی محمد و آل محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}