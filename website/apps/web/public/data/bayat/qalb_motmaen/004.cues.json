 "chapters": [
  {
   "index": 0,
   "title": "## تکمیل بحث عدول از نیت در نماز",
   "start": 15.22,
   "end": 35.94
  },
  {
   "index": 1,
   "title": "## اطمینان قلب فقط با ذکر خدا",
   "start": 35.94,
   "end": 296.42
  },
  {
   "index": 2,
   "title": "## ملائکه سبب اطمینان قلب",
   "start": 296.42,
   "end": 428.31
  },
  {
   "index": 3,
   "title": "## مائدهٔ آسمانی و اطمینان قلب",
   "start": 428.31,
   "end": 547.77
  },
  {
   "index": 4,
   "title": "## ایمان و قلب مطمئن؛ فرمول فکر تا شخصیت",
   "start": 547.77,
   "end": 657.01
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 2.96,
   "end": 5.16,
   "text": "بسم الله الرحمن الرحیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 5.16,
   "end": 10.34,
   "text": "و به نستعین. السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 10.34,
   "end": 14.7,
   "text": "آیاته. سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 14.7,
   "end": 18.7,
   "text": "ما موضوع عدول از نیت رو داشتیم می‌گفتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 18.7,
   "end": 23.08,
   "text": "دیروز عرض کردیم که در صورتی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 23.08,
   "end": 31.38,
   "text": "ما به محل، از محل عدول نیت نگذشته باشیم می‌تونیم نیت رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 31.38,
   "end": 34.54,
   "text": "برگردونیم. مثلا عرض کردیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 34.54,
   "end": 38.5,
   "text": "اینکه اه وقتی که در نماز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 38.5,
   "end": 43.28,
   "text": "دوم اشتباها نماز اول رو نخوندیم در نماز دوم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 43.28,
   "end": 47.62,
   "text": "یادمون میاد که چی شده نماز اول رو نخوندیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 47.62,
   "end": 49.7,
   "text": "حالا یا عشا هستیم یا عصر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 49.7,
   "end": 51.66,
   "text": "یادمون رفته نماز قبلی رو نخوندیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 51.66,
   "end": 54.78,
   "text": "قبل از اینکه مثلا در نماز عشا باشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 54.78,
   "end": 58.06,
   "text": "عرض کردیم قبل از اینکه به رکوع",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 58.06,
   "end": 61.7,
   "text": "رکعت چهارم بریم باید یادت بیاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 61.7,
   "end": 63.38,
   "text": "حالا اگر یادت نیومد چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 63.38,
   "end": 65.9,
   "text": "بعد از رکوع یادت اومد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 65.9,
   "end": 75.4,
   "text": "اینو دیروز نگفتیم. اینکه قبل از رکوع رکعت چهارم نماز عشا یادت بیاد مغربت رو نخوندی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 75.4,
   "end": 77.7,
   "text": "یا اصلا تو خود نماز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 77.7,
   "end": 80.22,
   "text": "مثلا نماز عصر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 80.22,
   "end": 83.9,
   "text": "چون قبلیش هم چهار رکعته این هم چهار رکعته، هر کجاش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 83.9,
   "end": 86.8,
   "text": "یادت بیاد میتونی عدول کنی به نیت نماز ظهر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 86.8,
   "end": 91.54,
   "text": "اما اصلا یادت نیومد نمازم تموم شد یادت اومد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 91.54,
   "end": 99.68,
   "text": "در صورتی که نماز اصلا تموم شد و شما نماز دومتو خوندی و یادش اومد که نماز اولو نخوندی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 99.68,
   "end": 108.26,
   "text": "فتوای مقام معظم رهبری حفظه الله تعالی اینه که اشکالی نداره شما نماز اولو حالا بخون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 108.26,
   "end": 112.64,
   "text": "یعنی اینجا شاید تنها جایی باشه که میشه جابجا خوند نمازها رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 112.64,
   "end": 116.14,
   "text": "در صورتی که چیزی یادت رفته باشه‌ها، نه از عمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 116.14,
   "end": 118.96,
   "text": "مثلا نماز عصر رو خوندی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 118.96,
   "end": 121.06,
   "text": "تموم شد یادت افتاد که اع",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 121.06,
   "end": 124.4,
   "text": "نماز ظهر رو نخونده بودی عصر رو خوندی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 124.4,
   "end": 127.64,
   "text": "اینجا نماز ظهر رو می‌خونی درستم هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 127.64,
   "end": 131.34,
   "text": "نماز عشا رو خوندی تموم شد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 131.34,
   "end": 136.36,
   "text": "یادت افتاد که نماز مغرب نخونده بودی پا میشی مغربت رو می‌خونی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 136.36,
   "end": 141.12,
   "text": "درسته نیازی نداره دوباره مغرب و بعدش عشا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 141.12,
   "end": 145.0,
   "text": "اما اینکه در رکعت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 145.0,
   "end": 153.44,
   "text": "در بعد از رکوع رکعت چهارم یادت بیفته که مغربت رو نخوندی یعنی از محل عدول گذشته باشی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 153.44,
   "end": 157.18,
   "text": "اینجا هم گفتن که رهبر عزیزمون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 157.18,
   "end": 162.14,
   "text": "فرمودن که شما می‌تونید نماز تموم شد نماز اولت رو دوباره بخونی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 162.14,
   "end": 168.12,
   "text": "یعنی نماز دوم رو درسته نماز اول رو بخونی، مغرب رو بخونی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 168.12,
   "end": 172.54,
   "text": "اما احت-- نزدیک‌تر به احتیاط فرمودن اینه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 172.54,
   "end": 176.96,
   "text": "بعد از اینکه نماز تموم شد مثلا عشاتو خوندی تموم شد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 176.96,
   "end": 179.18,
   "text": "یه مغرب عشا با هم بخونی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 179.18,
   "end": 181.98,
   "text": "این نزدیک‌تر به احتیاطه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 181.98,
   "end": 186.98,
   "text": "و الا همینطوری مثلا عشاتو تموم شد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 186.98,
   "end": 195.9,
   "text": "بعد مغرب رو بخونی نیازی نیست از جهت فتوا نیازی نیست که شما حتما دوباره عشا رو بعد از مغربت بخونی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 195.9,
   "end": 199.18,
   "text": "نزدیک‌تر به احتیاط اینه که بخونی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 199.18,
   "end": 202.28,
   "text": "یعنی هر دو تاشو میتونی انجام بدی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 202.28,
   "end": 205.46,
   "text": "اما بحث ما پیرامون قلب بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 205.46,
   "end": 209.26,
   "text": "یه نکته‌ای که خیلی مهمه در خصوص همین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 209.26,
   "end": 213.94,
   "text": "قلب مطمئن با توجه به آیاتی که عرض کردیم تو این چند روز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 213.94,
   "end": 216.66,
   "text": "از همین آیات استخراج کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 216.66,
   "end": 223.12,
   "text": "ما گفتیم که صریح آیه قرآن که می‌فرمود \"الا بذكر الله تطمئن القلوب\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 223.12,
   "end": 225.5,
   "text": "در ااا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 225.5,
   "end": 228.72,
   "text": "آیه بیست و هشت سوره رعد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 228.72,
   "end": 231.08,
   "text": "این می‌فرمود که خب فقط،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 231.08,
   "end": 236.66,
   "text": "فقط با ذکر انسان به اطمینان می‌رسه \"بذكر الله تطمئن القلوب\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 236.66,
   "end": 239.42,
   "text": "گفتیم مفسرین فرمودن فقط با ذکر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 239.42,
   "end": 245.32,
   "text": "اگر فقط با ذکر قلب انسان به مقام اطمینان و آرامش می‌رسه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 245.32,
   "end": 250.06,
   "text": "توی این آیات دیگه‌ای که پیرامون اطمینان قلبی هست چند تا مورد دیگرم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 250.06,
   "end": 253.78,
   "text": "بیان کرده که سبب اطمینان قلب میشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 253.78,
   "end": 256.02,
   "text": "پس اون‌ها هم باید چی باشن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 256.02,
   "end": 259.82,
   "text": "ذکر باشن یا اون‌ها ما رو به ذکر بکشونن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 259.82,
   "end": 264.24,
   "text": "اگر یادتون باشه یکیش خود وجود ملائکه بود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 264.24,
   "end": 268.88,
   "text": "که می‌فرماید مثلا در آیه صد و بیست و شش آل عمران",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 268.88,
   "end": 271.76,
   "text": "و همچنین در آیه ده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 271.76,
   "end": 276.48,
   "text": "انفال می‌فرمود که این‌ها یعنی ملائکه سبب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 276.48,
   "end": 282.8,
   "text": "اطمینان قلبی‌اند. مثلا \"وما جعله الله الا بشرا لکم ولیطمئن قلوبکم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 282.8,
   "end": 287.14,
   "text": "به\". این فرشته‌ها سبب اطمینان قلب شمااند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 287.14,
   "end": 292.18,
   "text": "اگر دقت کنید اینو اگر فقط ذکر سبب اطمینانه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 292.18,
   "end": 294.5,
   "text": "اینجا میگه ملائکه هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 294.5,
   "end": 296.42,
   "text": "سبب اطمینان قلبی شمااند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 296.42,
   "end": 298.76,
   "text": "پس ملائکه هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 298.76,
   "end": 302.74,
   "text": "یا خود ذکر‌اند یا یادآور ذکر‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 302.74,
   "end": 306.74,
   "text": "این یک نکته که البته اگه کسی بخواد پیرامون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 306.74,
   "end": 314.68,
   "text": "ملائکه بررسی کنه یکی از بهترین توصیفات که داریم در خطبه اول نهج البلاغه امیرالمؤمنین علیه‌سلام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 314.68,
   "end": 318.94,
   "text": "ملائکه رو دسته‌بندی کرده که عده‌ایشون فقط در قیام‌اند،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 318.94,
   "end": 322.36,
   "text": "کار دیگه‌ای نمی‌کنن. عده‌ایشون فقط در سجده‌اند،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 322.36,
   "end": 325.38,
   "text": "رکوع نمی‌کنن، قیام نمی‌کنن، عده-- همش در سجده‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 325.38,
   "end": 327.84,
   "text": "عده‌ایشون در رکوع‌اند کار دیگه‌ای نمی‌کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 327.84,
   "end": 332.42,
   "text": "دائما در رکوع‌اند یعنی از اول تا آخر خلقت اینا تو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 332.42,
   "end": 335.92,
   "text": "عده‌ای دائما مسبهن، در حال تسبیح‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 335.92,
   "end": 338.24,
   "text": "بعد عده‌ایشون که فقط مشغول عبادتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 338.24,
   "end": 341.44,
   "text": "عده‌ایشون کارگزار عالمان کار‌های انسان‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 341.44,
   "end": 344.32,
   "text": "در هر حال وجود ملائکه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 344.32,
   "end": 347.58,
   "text": "هم اطمینان قلبی میاره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 347.58,
   "end": 352.24,
   "text": "هم متوجه میشیم که سبب ذکر است یا خودش یادآوری‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 352.24,
   "end": 356.02,
   "text": "یعنی اگه کسی حضور ملائکه رو بتونه حس کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 356.02,
   "end": 358.0,
   "text": "اطمینان قلبی پیدا می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 358.0,
   "end": 359.98,
   "text": "مثلا آقای بهجت می‌فرمود که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 359.98,
   "end": 361.74,
   "text": "در خصوص حضرت شاه عبدالعظیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 361.74,
   "end": 367.81,
   "text": "حسنی هم داره آقای بهجت فرموده اینجا ملائکه تردد می‌کنن چه برسه به حضرت معصومه و مشهد و رضا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 367.81,
   "end": 370.55,
   "text": "یکی از خوانوم‌های خیلی خوب سادات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 370.55,
   "end": 373.35,
   "text": "حرم حضرت عبدالعظیم علیه‌السلام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 373.35,
   "end": 376.65,
   "text": "ما رو دید و ما رو کشید کنار تو حرم چند تا جمله گفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 376.65,
   "end": 378.77,
   "text": "رفته بودیم دیدار آقای بهجت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 378.77,
   "end": 385.19,
   "text": "یه جمله‌شو ایش، ایشون فرموده بودند که همین که مراقب باشید تو این حرم با ادب حرکت کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 385.19,
   "end": 392.19,
   "text": "پر ملائکت اللهه. چرا میری تو حرم یه حال ذکر بهتری پیدا می‌کنی، آرامش بهتری، اطمینان قلبی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 392.19,
   "end": 394.31,
   "text": "همون وجود ملائکه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 394.31,
   "end": 397.95,
   "text": "البته فرموده بودند امام عصر همین جا تردد دارن، آقای بهجت فرمودن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 397.95,
   "end": 400.43,
   "text": "همین شاه عبدالعظیم مثلا بغل گوشمونه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 400.43,
   "end": 403.25,
   "text": "و کسایی مثل ما که از اربعین جا موندیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 403.25,
   "end": 409.15,
   "text": "یادمون نره انشاالله بریم تو همین ایام بریم زیارت ایشون که مساوی است با زیارت سید الشهدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 409.15,
   "end": 416.25,
   "text": "پس خود ملائکه، ارتباط با اون‌ها، توجه به اون‌ها، هدیه کردن اعمال به اون‌ها قطعا سبب ذکر میشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 416.25,
   "end": 418.75,
   "text": "و ذکر هم که گفتیم اطمینان قلبی میاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 418.75,
   "end": 423.33,
   "text": "نکته بعدی که در آیه صد و سیزده مائده آورده جالبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 423.33,
   "end": 426.05,
   "text": "می‌فرماید قالوا نريد ان اکل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 426.05,
   "end": 428.19,
   "text": "منها و تطمئن قلوبنا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 428.19,
   "end": 431.47,
   "text": "که وقتی از خدا مائده آسمانی خواستند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 431.47,
   "end": 434.89,
   "text": "گفتند لا اکل منها ما از این بخوریم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 434.89,
   "end": 437.99,
   "text": "برای چی؟ تطمئن قلوبنا که این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 437.99,
   "end": 442.15,
   "text": "خوردن ما از این مائده آسمانی، از این رزق آسمانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 442.15,
   "end": 446.27,
   "text": "اطمینان قلبی برای ما بیاره. ما در احادیث داریم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 446.27,
   "end": 449.59,
   "text": "سفره‌های امام حسین رزق آسمانین،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 449.59,
   "end": 454.03,
   "text": "مائده‌ی آسمانین. یعنی شبیه به این رو در احادیث داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 454.03,
   "end": 457.25,
   "text": "اطعامی که برای امام حسین میشه که هر پولی هم لیاقت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 457.25,
   "end": 462.67,
   "text": "این کار رو نداره حواسمون باشه هر پولی لیاقت نداره خرج سفره‌ی امام حسین باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 462.67,
   "end": 467.15,
   "text": "این سبب-- این رزق آسمانی‌ست، مائده آسمانی‌ست و سبب چی میشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 467.15,
   "end": 473.11,
   "text": "اطمینان قلبی میشه. بعضیا هستن وضع مالیشون خیلی خوبه اما میان تو صف طویل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 473.11,
   "end": 474.97,
   "text": "هیئتها وایمیسن که این رزق رو بخورن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 474.97,
   "end": 477.45,
   "text": "به همین خاطره. اینا چیز فهم‌اند، نکته سنج‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 477.45,
   "end": 481.03,
   "text": "آقای قرائتی می‌گفت توی صف دیدی شبای ماه رمضون مخصوصا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 481.03,
   "end": 486.67,
   "text": "نیمه که میشه بعضیا میان به عشق امام حسن پول میدن یه نونوایی رو می‌خرن نذر می‌کنن که هر کی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 486.67,
   "end": 488.95,
   "text": "پول گرفت به عشق امام حسن چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 488.95,
   "end": 493.59,
   "text": "نون رایگان ببره. آقای قرائتی می‌فرمود من شنیدم از ایشون که یه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 493.59,
   "end": 501.61,
   "text": "زن بدحجابی میاد تو صف وایمیسته نوبتش که می‌رسه بهش میگن، پول نمی‌گیرن ازش میگن که برو مهمون امام حسنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 501.61,
   "end": 506.33,
   "text": "تا بهش میگن ببیند اسم امام حسن میاد تا هنوز که اصلا نخورده نونو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 506.33,
   "end": 511.07,
   "text": "همین می‌فهمه که مهمون امام حسنیه او آقای قرائتی می‌گفت بغضش می‌ترکه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 511.07,
   "end": 516.77,
   "text": "زار زار گریه می‌کنه. حجابشو همونجا جلوی مردم درست می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 516.77,
   "end": 518.93,
   "text": "رو سرشو می‌کشه جلو درست می‌کنه. بعد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 518.93,
   "end": 521.39,
   "text": "هج-- میره به حساب حجابش رسیدگی می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 521.39,
   "end": 524.39,
   "text": "یک تذکر فقط پیرامون که تو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 524.39,
   "end": 527.43,
   "text": "سر سفره‌ی امام حسنی. حالا ببین بخوره چی میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 527.43,
   "end": 530.39,
   "text": "اصلا چیزی که منسوب به اون‌ها باشه نور داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 530.39,
   "end": 533.65,
   "text": "حدیث داریم سفره اطعام امام حسین نور داره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 533.65,
   "end": 536.31,
   "text": "و همچین سفره‌ای سبب ز--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 536.31,
   "end": 540.21,
   "text": "با توجه به این آیات قطعا سبب اطمینان قلبی میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 540.21,
   "end": 547.55,
   "text": "نکته آخر هم جالبه در آیه صد و شش نحل می‌فرماید الا من اكره وقلبه مطمئن بالایمان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 547.55,
   "end": 551.41,
   "text": "میگه با ایمان قلب شما به اطمینان می‌رسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 551.41,
   "end": 553.45,
   "text": "ایمان یعنی همون دلدادگی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 553.45,
   "end": 559.51,
   "text": "حواسمون جمع باشه یعنی چیزی که بهش اعتماد و اطمینان، چیزی که بهش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 559.51,
   "end": 563.61,
   "text": "عرض کنم ایمان باور قلبی داری نه چیزی که فقط",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 563.61,
   "end": 565.99,
   "text": "می‌دانی. دان-- اینو قبلا بحث کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 565.99,
   "end": 569.65,
   "text": "دانسته نیست، ایمان یافته‌ست یعنی بهش رسیدی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 569.65,
   "end": 573.49,
   "text": "که البته امیرالمؤمنین در یک فرمایشی می‌فرمود که خیلی جالبه این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 573.49,
   "end": 579.87,
   "text": "اصلا روانشناسا باید همشون بکشن کنار بغل این جمله‌ی امیرالمؤمنین که فرمودند مراقب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 579.87,
   "end": 582.53,
   "text": "افکارتون باشید که گفتارتونو می‌سازه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 582.53,
   "end": 585.07,
   "text": "افکار، گفتار رو می‌سازه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 585.07,
   "end": 588.39,
   "text": "مراقب گفتار باشید که رفتار رو می‌سازه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 588.39,
   "end": 597.49,
   "text": "مراقب رفتار باشید که عادت میشه براتون، عادتون رو می‌سازه و مراقب عادتون باشید که شخصیتون رو درست می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 597.49,
   "end": 603.59,
   "text": "حالا آخری رو بذارید جلوی اولی میشه مراقب افکارت باش که شخصیتت همون میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 603.59,
   "end": 607.99,
   "text": "اگر کسی افکارش براساس ایمان باشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 607.99,
   "end": 611.11,
   "text": "شخصیتش انسان با ایمانی میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 611.11,
   "end": 613.47,
   "text": "در چنین کسی میگه مطمئن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 613.47,
   "end": 615.69,
   "text": "بالایمان آیه قرآنه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 615.69,
   "end": 623.09,
   "text": "یعنی اگر کسی تونست این فرمولوگ با دقت رعایت کنه در مسیر معنویت به اطمینان قلبی می‌رسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 623.09,
   "end": 627.83,
   "text": "این میشه که مثل حضرت امام کوه تکون بخورده، دنیا تکون بخوره، او",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 627.83,
   "end": 630.71,
   "text": "تکون نمی‌خوره که به قول حضرت عمه الله شهید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 630.71,
   "end": 637.45,
   "text": "اشرافی اصفهانی از معجزات حضرت امام این بود که فرمود والله قسم یک بار تو عمرم نترسیدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 637.45,
   "end": 641.99,
   "text": "این یعنی قلب مطمئن. وقتی هم که می‌رفت فرمود با قلبی مطمئن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 641.99,
   "end": 644.25,
   "text": "و زمینی امیدوار به پروردگار دارم میرم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 644.25,
   "end": 646.35,
   "text": "یادتونه؟ روحش شاد باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 646.35,
   "end": 651.15,
   "text": "انشاالله عاقبتmon ختم به خیر بشه به ذکر صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 651.15,
   "end": 657.01,
   "text": "اللهم صل على محمد و آل محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}