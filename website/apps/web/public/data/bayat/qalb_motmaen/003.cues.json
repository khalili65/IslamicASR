 "chapters": [
  {
   "index": 0,
   "title": "## عدول از نیت در نمازهای پی‌درپی",
   "start": 4.84,
   "end": 129.68
  },
  {
   "index": 1,
   "title": "## مرور آیات قلب مطمئن و جایگاه ذکر",
   "start": 129.68,
   "end": 164.58
  },
  {
   "index": 2,
   "title": "## سرّ نماز؛ اقامه برای ذکر",
   "start": 164.58,
   "end": 283.12
  },
  {
   "index": 3,
   "title": "## بسم‌الله بر سردر قصر فرعون",
   "start": 283.12,
   "end": 423.94
  },
  {
   "index": 4,
   "title": "## پرندهٔ کعبه و گفتگو با خدا",
   "start": 423.94,
   "end": 595.46
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 4.84,
   "end": 8.76,
   "text": "بسم الله الرحمن الرحیم و بهین استعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 8.76,
   "end": 12.42,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 12.42,
   "end": 16.0,
   "text": "آیاته. سلامٌ علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 16.0,
   "end": 18.34,
   "text": "یکی از موارد دیگه‌ای که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 18.34,
   "end": 25.14,
   "text": "بنا به فتوای رهبر عزیزمون جایز هست ما عدول کنیم از نیت در نماز،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 25.14,
   "end": 28.24,
   "text": "در نمازهای پشت سر هم مثل نماز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 28.24,
   "end": 33.26,
   "text": "ظهر و عصر یا مغرب و عشا در صورتی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 33.26,
   "end": 35.6,
   "text": "شخص مکلف اه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 35.6,
   "end": 41.56,
   "text": "نماز رو در صورتی که یادش رفته باشه مثلاً نماز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 41.56,
   "end": 46.08,
   "text": "مغرب رو نخونده نیت عشا کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 46.08,
   "end": 51.34,
   "text": "یا یادش رفته نماز ظهر رو نخونده، حالا به هر دلیلی اصلاً یادش رفته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 51.34,
   "end": 55.78,
   "text": "اشتباهاً نماز عصر رو هنوز ظهر رو نخونده عصر رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 55.78,
   "end": 61.74,
   "text": "اقامه میکنه. هنوز مغرب رو نخونده عشا رو اقامه میکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 61.74,
   "end": 65.46,
   "text": "وسط نماز یادش میفته که عجب!",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 65.46,
   "end": 70.24,
   "text": "اشتباه کرده. هنوز نماز اول رو نخونده نیت نماز دوم کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 70.24,
   "end": 75.68,
   "text": "در صورتی که از محل عدول نگذشته باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 75.68,
   "end": 78.4,
   "text": "مثلاً نماز عشا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 78.4,
   "end": 83.54,
   "text": "خب داره میخونه، نماز قبلش سه رکعته این نماز چهار رکعته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 83.54,
   "end": 86.5,
   "text": "اگر قبل از اینکه بره به رکوع",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 86.5,
   "end": 90.52,
   "text": "رکعت چهارم یادش بیاد میتونه نیت رو برگردونه؛",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 90.52,
   "end": 92.68,
   "text": "چون نماز قبلی سه رکعت دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 92.68,
   "end": 96.16,
   "text": "اگه بره به رکوع رکعت چهارم دیگه نمیتونه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 96.16,
   "end": 100.88,
   "text": "نیت رو برگردونه. حالا این خودش یه حکمی داره که اگر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 100.88,
   "end": 103.4,
   "text": "بره به رکوع که بعداً میگیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 103.4,
   "end": 107.72,
   "text": "اما در این حالت اگر قبل از اینکه به محل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 107.72,
   "end": 113.0,
   "text": "از محل عدول بگذره، مثالی که الان زدم یادش بیفته که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 113.0,
   "end": 117.44,
   "text": "نماز قبلیشو نخونده، اینجا واجبه که سریع نیتو برگردونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 117.44,
   "end": 119.8,
   "text": "برگردونه اگر تو نماز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 119.8,
   "end": 127.22,
   "text": "مغرب نماز عشا است برگردونه به نیت مغرب اگر تو نماز عصره برگردونه به نماز ظهر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 127.22,
   "end": 132.36,
   "text": "و ادامه بده. اما موضوع ما بحث قلب بود و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 132.36,
   "end": 135.34,
   "text": "نکته‌ای رو جلسه پیش پیرامون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 135.34,
   "end": 137.18,
   "text": "قلب مطمئن گفتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 137.18,
   "end": 142.84,
   "text": "آیاتی رو که ما با همدیگه مرور کردیم من فقط سریع دوباره شماره‌هاشون رو بگم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 142.84,
   "end": 146.82,
   "text": "که اگر کسی مج-- جدید به بحث پیوست آیات رو داشته باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 146.82,
   "end": 153.72,
   "text": "بقره دویست و شصت، آل عمران صد و بیست و شش، مائده صد و سیزده، انفال ده، رعد بیست و هشت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 153.72,
   "end": 157.48,
   "text": "نحل صد و شش. در این آیات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 157.48,
   "end": 160.26,
   "text": "موضوع قلب مطمئن بیان شده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 160.26,
   "end": 166.44,
   "text": "و مهم‌ترین نکته‌ای که از این آیات ما استخراج کردیم اهمیت و جایگاه ذکر بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 166.44,
   "end": 171.56,
   "text": "گفتیم بر اساس آیه «الا بذكر الله تطمئن القلوب»",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 171.56,
   "end": 178.9,
   "text": "مفسرین فرمودن فقط و فقط با ذکر خداست که دل به مقام اطمینان و آرامش میرسه، نه هیچ چیز دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 178.9,
   "end": 183.74,
   "text": "بعضیا گمان می‌کنند مثلاً داشته‌های مادی و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 183.74,
   "end": 191.56,
   "text": "دنیوی و وضع مالی خوب و نمی‌دونم ماشین و خونه و شغل مناسب و اینا آرامش در زندگی میاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 191.56,
   "end": 199.04,
   "text": "در صورتی که به قول آقای بهجت خیلی موقع‌ها این داشته‌ها بدتر اضطراب به زندگی انسان وارد میکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 199.04,
   "end": 203.4,
   "text": "مخصوصاً اگر بیش از نیاز و کفایت باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 203.4,
   "end": 205.14,
   "text": "در بیش از کفاف باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 205.14,
   "end": 214.24,
   "text": "اما اونچه که بنا به وعده قرآن آرامش به انسان میده یاد خداست، ذکر خداست و البته گفتیم ذکر،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 214.24,
   "end": 216.92,
   "text": "ذکر قلبی هست و لسانی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 216.92,
   "end": 222.06,
   "text": "خود ذکر اصلاً بحث قلبی و لسانیشم بذاریم کنار، اصلاً خود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 222.06,
   "end": 225.48,
   "text": "جایگاه ذکر یک جایگاه ویژه‌ایست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 225.48,
   "end": 228.94,
   "text": "تا جایی که خدای منان در آیه‌ی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 228.94,
   "end": 230.84,
   "text": "چهارده سوره طه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 230.84,
   "end": 234.66,
   "text": "خیلی زیبا نکته‌ای رو اینجا خدا بیان میکنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 234.66,
   "end": 240.78,
   "text": "و به نظر حقیر یکی از اسرار الهی‌ست که می‌فرماید \"إنني أن الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 240.78,
   "end": 242.88,
   "text": "لا إله إلا أنا\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 242.88,
   "end": 246.82,
   "text": "من اون خدام. خیلی زیبا خودشو اینجا معرفی کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 246.82,
   "end": 248.98,
   "text": "\"فاعبدني\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 248.98,
   "end": 253.42,
   "text": "منو عبادت کنید \"وأقم الصلاة\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 253.42,
   "end": 258.6,
   "text": "و نماز با این جایگاهش که عمود دین ما شناخته میشه میگه بخوانید و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 258.6,
   "end": 260.96,
   "text": "پایداری نماز رو برای چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 260.96,
   "end": 264.2,
   "text": "\"لذكري\" برای یاد من.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 264.2,
   "end": 267.94,
   "text": "یعنی نماز با این جایگاه عظیمش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 267.94,
   "end": 272.56,
   "text": "به خاطر این باید خونده بشه که یاد خدا درش صورت میگیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 272.56,
   "end": 281.88,
   "text": "این سر یاد خداست. حالا گذشته از این بحث یاد خدا چه قلبی، چه لسانی، خود ذکر هم اهمیت فوق‌العاده‌ای داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 281.88,
   "end": 285.08,
   "text": "مثلاً یه روایت دیدم در کتاب شریف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 285.08,
   "end": 288.04,
   "text": "منهج الصادقین صفحه سی و سه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 288.04,
   "end": 290.32,
   "text": "که خیلی جالبه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 290.32,
   "end": 294.56,
   "text": "می‌فرماید که چرا اهل بیت فرمودن می‌دونید چرا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 294.56,
   "end": 299.92,
   "text": "اه فرعون تا آخرین لحظات زندگیش قصرش ویران نشد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 299.92,
   "end": 301.72,
   "text": "چون موسی به خدا گله کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 301.72,
   "end": 304.28,
   "text": "گفت خدایا تو چرا این فرعون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 304.28,
   "end": 309.16,
   "text": "دیگه کارش به جایی رسیده صراحتاً قرآن می‌فرماید می‌گفت \"أنا ربكم الأعلى\" دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 309.16,
   "end": 311.2,
   "text": "من اون پروردگار اعلی شماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 311.2,
   "end": 313.74,
   "text": "استغفرالله. آخه تو چرا اینو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 313.74,
   "end": 317.66,
   "text": "سر جاش نمی‌شونی؟ خدایا صدای موسی دیگه دراومد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 317.66,
   "end": 321.44,
   "text": "ببینید جایگاه ذکر اینجا تو این روایت قشنگ مشخص شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 321.44,
   "end": 326.48,
   "text": "خدا فرمود موسی برو نگاه کن بالا سر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 326.48,
   "end": 330.84,
   "text": "قصرش سردر ورود-- قبل از اینکه این مدعی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 330.84,
   "end": 334.62,
   "text": "الهی بشه، مدعی پروردگاری بشه، مدعی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 334.62,
   "end": 336.88,
   "text": "\"أنا ربكم الأعلى\" بشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 336.88,
   "end": 343.64,
   "text": "قبلاً که به قول ما آدم سر به زیری بود این قصرشو که ساخت برو ببین بالا سردرش چی نوشته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 343.64,
   "end": 347.22,
   "text": "بالا سردرش نوشته بسم الله الرحمن الرحیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 347.22,
   "end": 351.9,
   "text": "اصلاً جایگاه این بسم الله الرحمن الرحیم جایگاه خاصیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 351.9,
   "end": 359.14,
   "text": "اون به قول ما دست بال ملائکه ما رو بسته که بخوان بزنن این قصر رو خراب کنن، مثلاً تخریب کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 359.14,
   "end": 361.96,
   "text": "نمی‌دونم مثلاً بلایی نازل بشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 361.96,
   "end": 366.46,
   "text": "تا وقتی که اون بسم الله الرحمن الرحیم که ذکر اعظم است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 366.46,
   "end": 369.52,
   "text": "اونجاست دست و پامون، ملائکه بسته‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 369.52,
   "end": 376.16,
   "text": "جالبه که وقتی هم که دیگه خدا اراده قصبی کرد که فرعون رو از رو زمین برداره و بلا نازل کنه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 376.16,
   "end": 382.54,
   "text": "دستور داد به ملائکه تو همین روایت هست که برین اون ذکر رو محو کنید که بی‌حرمتی به اون ذکر نشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 382.54,
   "end": 385.98,
   "text": "ببینید می‌خوام بگم خود جایگاه ذکر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 385.98,
   "end": 390.44,
   "text": "بعضی از بزرگان حتی تو-- روی روزنامه نمی‌نشستن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 390.44,
   "end": 392.74,
   "text": "حروف، برای حروف احترام قائل بودن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 392.74,
   "end": 394.8,
   "text": "من بررسی کردم دلیلشو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 394.8,
   "end": 401.72,
   "text": "دیدم از این جهت معنویه که میگن چون اسماء الهی از حروف تشکیل شده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 401.72,
   "end": 405.68,
   "text": "و همون حروف هم احترام دارن چون با اونا اسم تشکیل شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 405.68,
   "end": 409.54,
   "text": "اسم الله. و فعاله این عالم اسم الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 409.54,
   "end": 413.58,
   "text": "با-- حالا با همون حروف یه چیزای دیگه‌ای نوشتن مثلا تو روزنامه مثلا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 413.58,
   "end": 415.32,
   "text": "همونا هم حرمت پیدا می‌کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 415.32,
   "end": 418.5,
   "text": "یه همچین نگاهی داشتن که حتی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 418.5,
   "end": 420.94,
   "text": "روزنامه هم مثلا زیر پاشون نمی‌ذاشتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 420.94,
   "end": 423.82,
   "text": "در هر حال می‌خوام بگم خود ذکر جایگاه داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 423.82,
   "end": 428.0,
   "text": "یه روایتی دیدم از امام سجاد علیه الصلاة والسلام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 428.0,
   "end": 431.6,
   "text": "نمی‌دونم اینایی که کرما که توفیق نداشتیم متاسفانه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 431.6,
   "end": 435.76,
   "text": "عزیزانی که از اینجا هم رفتن مکه حالا همه کربلا هستن بچه‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 435.76,
   "end": 438.12,
   "text": "حالا یه روزی انشاالله همینطوری بشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 438.12,
   "end": 441.3,
   "text": "همه بریم مکه با درک واصل شدن آقا علی صلوات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 441.3,
   "end": 443.88,
   "text": "چه قشنگ میشه اونجا بیفته دست شیعه‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 443.88,
   "end": 449.62,
   "text": "من بچه‌هایی که رفتن میگن یه پرنده‌های خاصی تو خونه خدا لونه کردن فقط هم همون یه نوع هستن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 449.62,
   "end": 452.64,
   "text": "اسمشو من نمی‌دونم. تو روایت چیزی دیدم خیلی جالب بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 452.64,
   "end": 454.92,
   "text": "امام سجاد سلام الله علیه پرده‌برداری کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 454.92,
   "end": 456.78,
   "text": "چرا اون یه نوع پرنده خاص اونجاست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 456.78,
   "end": 462.68,
   "text": "اینم بحث ذکره. خیلی جالبه روایتش که حضرت فرمودن این پرنده، این نوع پرنده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 462.68,
   "end": 466.72,
   "text": "توی خونه‌ای زندگی می‌کرد که درختی وسط خونه‌ی بنده خدایی بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 466.72,
   "end": 468.84,
   "text": "این پرنده تو اون خونه زندگی می‌کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 468.84,
   "end": 471.7,
   "text": "کمیاب هم بودن. خیلی نوع کمی بودن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 471.7,
   "end": 473.9,
   "text": "بعد این صاحب خونه وقتی که این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 473.9,
   "end": 482.06,
   "text": "لونه-- توی اون ااا درخت لای درز شکاف این درخت بچه می‌ذاشت، این صاحب خونه میومد بچه‌هاشو می‌کشت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 482.06,
   "end": 485.2,
   "text": "یا تخم‌هاشو می‌برد. این یه روز گله کرد به خدا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 485.2,
   "end": 488.14,
   "text": "همین پرنده. گفت، \"ای خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 488.14,
   "end": 490.56,
   "text": "حق منو از این بندهت بسطان.\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 490.56,
   "end": 492.78,
   "text": "این بعد خدا وحی کرد بهش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 492.78,
   "end": 495.2,
   "text": "قرآن هم میگه ما به مو-- ما به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 495.2,
   "end": 497.74,
   "text": "زنبور عسل وحی می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 497.74,
   "end": 501.9,
   "text": "وحی می‌کنه به حیوان. ما-- خدا وحی کرد بهش که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 501.9,
   "end": 509.28,
   "text": "فردا که اومد، دفعه بعد که اومد تو تخم گذاشتی بچه ات به دنیا اومد، این میاد از درخت بره بالا میفته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 509.28,
   "end": 511.4,
   "text": "و می‌میره. این اتفاق افتاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 511.4,
   "end": 513.54,
   "text": "این اومد از درخت بره بالا، یه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 513.54,
   "end": 516.24,
   "text": "سائلی در زد. این هم رفت در خونه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 516.24,
   "end": 519.2,
   "text": "به اون سائل کمک کرد بعد رفت بالای درخت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 519.2,
   "end": 521.28,
   "text": "صدقه باعث شد این نمیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 521.28,
   "end": 524.12,
   "text": "دفع بلا ازش بشه. دو مرتبه این گله کرد به خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 524.12,
   "end": 527.98,
   "text": "خدایا این دفعه هم که نشد گفت آخه بخشید به فقیر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 527.98,
   "end": 530.84,
   "text": "خدا وحی کرد بهش که به فقیر بخشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 530.84,
   "end": 535.74,
   "text": "ما دفع بلا کردیم ولی به جاش من در نسل تو برکت قرار میدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 535.74,
   "end": 539.5,
   "text": "تنها پرنده‌ای که خدا بهش اجازه داد بره تو خونه خدا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 539.5,
   "end": 542.46,
   "text": "اونجا امنه دیگه هیچکس کاری به کارش نداره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 542.46,
   "end": 544.2,
   "text": "لونه درست کنه، این پرنده بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 544.2,
   "end": 551.76,
   "text": "لذا نسلش ماشاالله دیگه گسترده شده تا جایی که تنها پرنده‌ای که تو خونه خدا زندگی می‌کنه و اونجا پره همین پرندس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 551.76,
   "end": 554.1,
   "text": "چرا؟ با خدا گفتگو کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 554.1,
   "end": 557.48,
   "text": "دو کلام با خدا حرف زد. روایت داریم هیچ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 557.48,
   "end": 559.62,
   "text": "پرنده‌ای و هیچ حیوانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 559.62,
   "end": 563.82,
   "text": "صید نمیشه مگر اینکه اون روز از ذکر خدا غافل بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 563.82,
   "end": 570.38,
   "text": "وقتی ما میریم با بچه‌هامون یه وقت در مغازه مثلا ماهی زنده بعضی موقع‌ها می‌خریم از این مغازه‌ها زنده می‌فروشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 570.38,
   "end": 575.12,
   "text": "میگم بچه‌ها این ماهی که الان دارن خرید-- داریم می‌خریم امروز از یاد خدا طبق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 575.12,
   "end": 577.38,
   "text": "حدیث غافل بوده و الا صید نمیشد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 577.38,
   "end": 581.44,
   "text": "بگیریدش. همین دیدید این حتی بچه‌ها رو اینطوری آموزش میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 581.44,
   "end": 584.1,
   "text": "پس یاد بردن خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 584.1,
   "end": 586.54,
   "text": "سبب میشه که انسان به بلا گرفتار بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 586.54,
   "end": 591.4,
   "text": "انشاالله عاقبتمون ختم به خیر بشه و ذکر صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 591.4,
   "end": 595.46,
   "text": "الله- صلوات بر محمد و آل محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}