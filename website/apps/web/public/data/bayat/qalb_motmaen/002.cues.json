 "chapters": [
  {
   "index": 0,
   "title": "## عدول نیت؛ یاد آمدن قضای نماز قبلی",
   "start": 15.8,
   "end": 80.44
  },
  {
   "index": 1,
   "title": "## آیات قلب مطمئن",
   "start": 80.44,
   "end": 100.44
  },
  {
   "index": 2,
   "title": "برمی‌گردد به قضیهٔ ملائکه؛ خدا می‌گوید فرشته‌ها سبب اطمینان قلبی شمایند. جای دیگر در مائده:",
   "start": 100.44,
   "end": 360.6
  },
  {
   "index": 3,
   "title": "## ذکر اکبر نماز؛ روایت سلمان و برگ‌ها",
   "start": 360.6,
   "end": 497.58
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 4.02,
   "end": 8.06,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 8.06,
   "end": 10.78,
   "text": "السلام علیک یا داعی الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 10.78,
   "end": 12.9,
   "text": "و ربانی آیا سه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 12.9,
   "end": 15.8,
   "text": "سلام علیکم و رحمت الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 15.8,
   "end": 18.22,
   "text": "بحث عدول از نیت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 18.22,
   "end": 21.04,
   "text": "در نماز رو عرض کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 21.04,
   "end": 23.58,
   "text": "یکی از جاهای حالا موارزشو بگیم یکی یکی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 23.58,
   "end": 25.8,
   "text": "یکی از مواردی که میشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 25.8,
   "end": 30.72,
   "text": "عدول کرد از نماز از نیت نماز اینه که مثلا شما در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 30.72,
   "end": 34.14,
   "text": "نماز ایستادی، حالا هر نمازی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 34.14,
   "end": 38.22,
   "text": "یه دفعه یادت می‌افته که نماز قبلی رو قضاشو نخوندی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 38.22,
   "end": 40.32,
   "text": "مثلا نماز ظهر رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 40.32,
   "end": 46.94,
   "text": "الله اکبر میگی یادت می‌افته که نماز صبحت رو قضا شده و قضاشو نخوندی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 46.94,
   "end": 50.08,
   "text": "اینجا فرمودن آقا رهبر عزیرمون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 50.08,
   "end": 56.1,
   "text": "فرمودن که اجازه داری نیت کنی نیتو برگردونی به نماز صبح در صورتی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 56.1,
   "end": 62.6,
   "text": "هنوز رکعت دوم رو تموم نکرده باشی بخوای بری به رکعت سوم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 62.6,
   "end": 65.98,
   "text": "و ر-- به رکوع رکعت سوم رسیده باشی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 65.98,
   "end": 69.38,
   "text": "یعنی باید دو رکعت نماز رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 69.38,
   "end": 71.92,
   "text": "بالاخره نماز صبح دو رکعتیه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 71.92,
   "end": 78.22,
   "text": "تو اون حالت اگر یادت اومد می‌تونی نیت کنی نماز قضای صبحت رو می‌خونی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 78.22,
   "end": 81.78,
   "text": "و باید دو رکعتی تموم کنی. موضوع ما قلب بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 81.78,
   "end": 85.46,
   "text": "حالا به فضل الهی یک یک این‌ها رو توضیح بدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 85.46,
   "end": 91.92,
   "text": "امروز مختصراً و به یاد همه بر و بچه‌هایی که بسیاری از جمع ما رفتن به سمت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 91.92,
   "end": 99.06,
   "text": "حرم ارباب ان شا الله اونجا گوش بدن تو مرام که میرن تو تلگرام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 99.06,
   "end": 101.74,
   "text": "یاد ما بکنن. ما از همین جا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 101.74,
   "end": 104.66,
   "text": "یاد می‌کنیم اون‌ها رو اونا هم اونجا یاد ما کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 104.66,
   "end": 109.14,
   "text": "امروز قلب مطمئن رو چند تا آیه‌ای که پیرامون این قلب،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 109.14,
   "end": 113.68,
   "text": "این نوع قلب اومده رو بگم و یه نکته‌ای و السلام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 113.68,
   "end": 117.42,
   "text": "اولا آیه دویست و شصت سوره بقره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 117.42,
   "end": 124.9,
   "text": "در خصوص حضرت ابراهیمه که می‌فرماید \"و لک لیطمئن قلبی\" حالا من بخشی از آیه رو می‌خونم همشو نمی‌خونم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 124.9,
   "end": 128.76,
   "text": "که همون برمی‌گرده به جریان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 128.76,
   "end": 130.74,
   "text": "اینکه اون چهار تا پرنده رو حضرت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 130.74,
   "end": 137.68,
   "text": "ابراهیم دستور گرفت از خدا که بکوبه و اینا رو بکشه و بکوبه و در هم مخلوط کنه و بعد خدا زنده شون کنه که \"ولک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 137.68,
   "end": 140.86,
   "text": "لیطمئن قلبی\" برای اینکه سبب اطمینان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 140.86,
   "end": 145.82,
   "text": "قلبی حضرت بشه. جای دیگه تو قرآن این بحث قلب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 145.82,
   "end": 148.44,
   "text": "مطمئن اومده صد و بیست و شش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 148.44,
   "end": 150.98,
   "text": "آل عمران \"وما جعله الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 150.98,
   "end": 154.56,
   "text": "الا بشری لکم لیطمئن قلوبکم\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 154.56,
   "end": 159.18,
   "text": "برمی‌گرده به قضیه ملائکه الله که خدا میگه فرشته‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 159.18,
   "end": 163.44,
   "text": "سبب اطمینان قلبی شمااند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 163.44,
   "end": 172.38,
   "text": "جای دیگه در سوره مائده آیه صد و سیزده‌ست می‌فرماید \"قالوا نريد ان نأکل منها وتطمئن قلوبنا\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 172.38,
   "end": 176.9,
   "text": "این هم برمی‌گرده به اون مائده آسمانی که حواریون به حضرت عیسی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 176.9,
   "end": 181.7,
   "text": "گفتن از خدا بخواه یه مائده آسمونی برای ما بفرسته که ما از این بخوریم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 181.7,
   "end": 189.36,
   "text": "سبب اطمینان قلبی مون بشه که ما گفتیم این رزق آسمانی اطمینان قلبی میاره که چه رزقی بالاتر از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 189.36,
   "end": 194.38,
   "text": "زیارت امام حسین، اشک برای امام حسین که اون هم اطمینان قلبی میاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 194.38,
   "end": 199.76,
   "text": "آیه ده سوره انفال هم همین هست \"وما جعله الله الا بشری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 199.76,
   "end": 201.86,
   "text": "لتطمئن به قلوبکم\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 201.86,
   "end": 208.4,
   "text": "این هم در خصوص ملائکه است که میگه اینا بشارت‌اند و سبب اطمینان قلبی شما میشن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 208.4,
   "end": 215.68,
   "text": "و آیه بیست و هشت سوره رعد که \"الذین آمنوا وطمئن قلوبهم بذكر الله الا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 215.68,
   "end": 222.24,
   "text": "بذكر الله تطمئن القلوب\" یکی از بهترین و مهم‌ترین آیات قرآن در این خصوص هست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 222.24,
   "end": 225.38,
   "text": "و آیه صد و شش سوره نحل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 225.38,
   "end": 234.8,
   "text": "که می‌فرماید ال-- \"الا من اكره وقلبه مطمئن بالايمان\" که بعضیا فرمودن در خصوص حضرت عمار یاسر اومده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 234.8,
   "end": 237.32,
   "text": "که بر زبانش یک کراهتی جاری شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 237.32,
   "end": 239.24,
   "text": "یه کفری چیزی گفت ولی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 239.24,
   "end": 246.28,
   "text": "قلبش ایمان داشت زیر شکنجه و بعد پشیمون شد از پیغمبر خواست که خدا ببخشش و این آیه نازل شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 246.28,
   "end": 251.68,
   "text": "در هر حال این آیاتی‌ست که پیرامون اطمینان قلبی یعنی قلب مطمئن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 251.68,
   "end": 256.24,
   "text": "وارد شده. یه نکته‌ای رو من فقط اینجا بگم اگر دقت کنید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 256.24,
   "end": 264.36,
   "text": "وقتی در مجموعه این آیات بررسی می‌کنید صراحتا خصوصا در آیه بیست و هشت رعد می‌فرماید الا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 264.36,
   "end": 267.8,
   "text": "بدونید همه بدونید \"الا بذكر الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 267.8,
   "end": 274.46,
   "text": "تطمئن القلوب\". اگر کسی می‌خواد برسه به اطمینان قلبی، آرامش قلبی فقط",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 274.46,
   "end": 275.96,
   "text": "و مفسرین اینجا گفتن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 275.96,
   "end": 284.3,
   "text": "فقط یعنی اگه کسی بگه یکی از راه‌های رسیدن به مثلا آرامش قلبی و اطمینان ذکر خداست غلط ترجمه کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 284.3,
   "end": 286.7,
   "text": "علامه طباطبایی فرمود نخیر باید بگید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 286.7,
   "end": 289.04,
   "text": "فقط تنها راه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 289.04,
   "end": 291.44,
   "text": "اطمینان قلبی ذکر خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 291.44,
   "end": 293.86,
   "text": "حالا ذکر هم دو جوره. می‌دونید دیگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 293.86,
   "end": 295.64,
   "text": "ذکر لسانی، ذکر قلبی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 295.64,
   "end": 299.34,
   "text": "لک-- ذکر لسانی مقدمه ذکر قلبی‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 299.34,
   "end": 301.16,
   "text": "مطلوب ذکر قلبی‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 301.16,
   "end": 304.28,
   "text": "انسان قلبش به یاد خدا باشه دائما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 304.28,
   "end": 307.3,
   "text": "لکن ذکر لسانی مقدمه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 307.3,
   "end": 309.24,
   "text": "یعنی اون هم باید باشه و کمک کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 309.24,
   "end": 313.34,
   "text": "روایات بسیاری داریم که آقا تو این مشکل افتادی این ذکرو بگو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 313.34,
   "end": 316.26,
   "text": "این راه-- خواستی به اینجا برسی اون ذکرو بگو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 316.26,
   "end": 318.96,
   "text": "نمی‌دونم حاجت از خدا خواستی اون ذکرو بگو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 318.96,
   "end": 325.12,
   "text": "بسیار داریم و همین ذکر یونسیه تو خود قرآن می‌فرماید \"لا اله الا انت سبحانک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 325.12,
   "end": 329.24,
   "text": "انی کنت من الظالمین\" وقتی حضرت یونس تو دل ماهی اینو گفت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 329.24,
   "end": 336.26,
   "text": "\"فا استجبنا له\" قرآن میگه دیگه ما دعاشو مستجاب کردیم \"ونجیناه من الغم\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 336.26,
   "end": 341.88,
   "text": "و او رو از غم نجات دادیم \"وكذلك ننجي المؤمنین\" فعل مضارعه میاره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 341.88,
   "end": 349.02,
   "text": "و الف و لام سر المؤمنون یعنی برای همه اهل ایمان این تا ابد جاریه این سنت خدا که اگه کسی بخواد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 349.02,
   "end": 352.84,
   "text": "از غم نجات پیدا کنه باید این مناجات رو بکنه با خدا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 352.84,
   "end": 357.44,
   "text": "این ذکرو با خدا. پس ذکر لسانی هم مهمه لکن مهم‌تر از اون اینه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 357.44,
   "end": 360.14,
   "text": "این بدل به قلب بشه در...",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 360.14,
   "end": 366.18,
   "text": "اما خب در خصوص خود ذکر که تنها ذکر رو فرمودن سبب اطمینان قلبی بشن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 366.18,
   "end": 369.22,
   "text": "یه روایتی بگم که خلاصه این ذکر،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 369.22,
   "end": 372.02,
   "text": "اصل این ذکر یا بهترین ذکر چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 372.02,
   "end": 378.6,
   "text": "\"ولذكر الله الاكبر\" که قرآن میگه بالاترین ذکرها از همه اذکار بالاتره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 378.6,
   "end": 382.16,
   "text": "که وقتی اون بالاترین قلباً، قطعاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 382.16,
   "end": 383.76,
   "text": "دل رو محکم‌تر می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 383.76,
   "end": 385.88,
   "text": "اون چیه؟ فرمودن نماز.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 385.88,
   "end": 389.62,
   "text": "اهل بیت ذیل این آیه شریفه فرمودن صلاة است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 389.62,
   "end": 392.18,
   "text": "یک مجموعه‌ایست از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 392.18,
   "end": 397.36,
   "text": "جمیع وجوه معرفتی و عرفانی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 397.36,
   "end": 399.66,
   "text": "خود نماز رو نباید دست کم گرفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 399.66,
   "end": 404.92,
   "text": "نماز سبب همون بالاترین ذکر است که سبب اطمینان می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 404.92,
   "end": 409.6,
   "text": "یه روایت دیدم اینم ضمیمه کنیم خوبه که جهت تسهیل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 409.6,
   "end": 414.3,
   "text": "فهم که سلمان نشسته بود با ابو عثمان زیر سایه درختی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 414.3,
   "end": 418.44,
   "text": "بعد یه شاخه درختی که زرد شده بود برگ‌هاشو گرفت تکون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 418.44,
   "end": 420.72,
   "text": "داد تا ریخت، همه برگ‌هاش ریخت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 420.72,
   "end": 425.94,
   "text": "به این رفیقش ابو عثمان گفت چرا از من سؤال نکردی چرا این شاخه رو تکون دادی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 425.94,
   "end": 430.78,
   "text": "گفت خب چرا تکون دادی؟ گفت اتفاقاً همین اتفاق برای من و پیغمبر افتاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 430.78,
   "end": 437.5,
   "text": "زیر سایه درختی که زرد شده بود دم پاییز بود یه همچین فصلی بود نشسته بودیم پیغمبر یه شاخه برداشت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 437.5,
   "end": 439.5,
   "text": "تکون داد تا همه شاخه‌هاش ری--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 439.5,
   "end": 443.9,
   "text": "برگ‌هاش ریخت. به من گفت سلمان چرا نپرسیدی که چرا این کارو کردم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 443.9,
   "end": 447.62,
   "text": "منم گفتم یا رسول الله چرا؟ پیغمبر این جوابو دادن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 447.62,
   "end": 450.58,
   "text": "فرمودن که همین طور که این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 450.58,
   "end": 456.2,
   "text": "برگ با این تکون برگ‌ها همه از این شاخه ریختن، اگر کسی اونطور که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 456.2,
   "end": 458.86,
   "text": "وجهی-- به همون وجهی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 458.86,
   "end": 467.62,
   "text": "خدا دستور داده مطلوب یعنی خوب وضو بگیره، یعنی وقتی وضو می‌گیره یاد خدا باشه در حین وضو گرفتن؛",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 467.62,
   "end": 475.46,
   "text": "وضو بگیره و نماز پنج گانه‌شو بگی-- بخونه همین‌طور با اون نماز پنج گانه همین‌طور گناهاش می‌ریزه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 475.46,
   "end": 478.16,
   "text": "ببین این شاخه هیچ برگی دیگه بهش نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 478.16,
   "end": 484.64,
   "text": "یه نماز پنج گانه با وضو خوب یعنی یاد خدا باشه بدون اینکه داره نماز می‌خونه یه همچین اثری داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 484.64,
   "end": 486.36,
   "text": "این نماز رو نباید دست کم گرفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 486.36,
   "end": 489.58,
   "text": "همه رو میشوره می‌بره و سبب اطمینان قلبی می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 489.58,
   "end": 494.75,
   "text": "انشاالله که عاقبتمون всех بخير باشه به ذکر صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 494.75,
   "end": 497.58,
   "text": "اللهم صل على محمد و آل محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}