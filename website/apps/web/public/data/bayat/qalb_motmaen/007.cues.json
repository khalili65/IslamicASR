 "chapters": [
  {
   "index": 0,
   "title": "## قلب مطمئن و آیهٔ دویست و شصت بقره",
   "start": 30.36,
   "end": 126.24
  },
  {
   "index": 1,
   "title": "### خواب؛ برادر مرگ",
   "start": 126.24,
   "end": 160.78
  },
  {
   "index": 2,
   "title": "### لیطمئن قلبی؛ رؤیت راه اطمینان",
   "start": 160.78,
   "end": 389.3
  },
  {
   "index": 3,
   "title": "## برتری یقین علی بر طلبِ اطمینان ابراهیم",
   "start": 389.3,
   "end": 449.9
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.84,
   "end": 4.84,
   "text": "بسم الله الرحمن الرحیم و بهی نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 4.84,
   "end": 9.92,
   "text": "السلام علیک یا داعی الله و ربانی ایات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 9.92,
   "end": 12.38,
   "text": "سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 12.38,
   "end": 18.02,
   "text": "سؤال شده که آیا نمازهای قضا رو میشه نشسته خوند؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 18.02,
   "end": 20.54,
   "text": "جواب این هستش که به فتوای همه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 20.54,
   "end": 30.36,
   "text": "مراجع که نخیر چون نمازهای مستحبی رو فقط میشه نشسته خوند و نماز قضای واجب هم باید همونطور ایستاده خونده بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 30.36,
   "end": 38.12,
   "text": "موضوع بحث ما پیرامون حدود شصت نوع قلبی بود که در قرآن برشمردیم و ابتداً شروع کردیم به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 38.12,
   "end": 42.48,
   "text": "توضیح قلب مطمئن به خاطر البته اهمیت اون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 42.48,
   "end": 51.14,
   "text": "اشارتاً به آیه دویست و شصت سوره بقره وقتی دقت میکنین برمیگرده به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 51.14,
   "end": 54.5,
   "text": "داستاني که اصل ماجرا رو در کتاب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 54.5,
   "end": 59.82,
   "text": "کافی شریف مرحوم کلینی اعلا الله مقامه الشریف جVIII",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 59.82,
   "end": 64.36,
   "text": "صفحه سیصد و پنج بیان کرده که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 64.36,
   "end": 69.02,
   "text": "وقتی حضرت ابراهیم علیه النبيین و آله و عليه الصلاة والسلام گذر میکرد از کنار یه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 69.02,
   "end": 75.12,
   "text": "دریا یا دریاچه‌ای دیدن که یک مرداری از حیوان افتاده نیمیش در آبه نیمیش در خشکیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 75.12,
   "end": 80.72,
   "text": "و حیوانات خشکی و آبزی از اون دارن تغذیه میکنن و تجزیه میشه و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 80.72,
   "end": 83.0,
   "text": "به فکر فرو رفت حضرت که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 83.0,
   "end": 90.22,
   "text": "چگونه وقتی که حالا اگر این مردار، مردار انسان باشه و به این شکل تجزیه بشه در بدن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 90.22,
   "end": 93.3,
   "text": "حیوانات مختلف چگونه خدای منان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 93.3,
   "end": 98.28,
   "text": "قیامت در حشر کبرا، قیامت کبرا این بدن رو برمی‌گردونه؛",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 98.28,
   "end": 102.38,
   "text": "تا ما معتقد هستیم که بر اساس آموزه های قرآن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 102.38,
   "end": 106.5,
   "text": "در قیامت کبرا همین جسم به مرتبه شکل خودشو میره و برمی‌گرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 106.5,
   "end": 110.12,
   "text": "اون در قیامت صغری یا برزخ است که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 110.12,
   "end": 113.94,
   "text": "این جسم دیگه کارایی نداره و در قبر میپوسه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 113.94,
   "end": 117.5,
   "text": "پوسیده میشه لکن این روح",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 117.5,
   "end": 122.42,
   "text": "از این جسم که خارج میشه وارد در قالب مثالی اصطلاحاً میشه همون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 122.42,
   "end": 126.24,
   "text": "قالبی که در عالم خواب ما باهاش این ور اون ور میریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 126.24,
   "end": 130.52,
   "text": "در روایت هم داریم که وقتی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 130.52,
   "end": 133.06,
   "text": "اولین انبیاء الهی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 133.06,
   "end": 138.58,
   "text": "دیدن که هرچه از معاد برای پیروانشون بیان میکنن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 138.58,
   "end": 145.64,
   "text": "اونها قبول نمیکنن و اینها هرچه سعی میکنن راهی برای تفهیمش پیدا نمیکنن از خدای منان کمک خواستن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 145.64,
   "end": 152.48,
   "text": "خدای متعال خواب رو ایجاد کرد در وجود انسان به منزله برادر مرگ که میگن یعنی همین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 152.48,
   "end": 157.82,
   "text": "به منزله اینکه زنده شدن پس از مرگ رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 157.82,
   "end": 160.78,
   "text": "به نوعی انسان درک کنه. به هر حال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 160.78,
   "end": 168.78,
   "text": "وقتی حضرت ابراهیم علیه الصلاة والسلام و علیه النبيین و آله این منظره رو دید از خدا خواست که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 168.78,
   "end": 173.64,
   "text": "به او متوجه کنه و نشون بده که چگونه بدن انسان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 173.64,
   "end": 178.54,
   "text": "بعد از این تجزیه دو مرتبه به حالت اولش برمی‌گرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 178.54,
   "end": 182.48,
   "text": "اگر، اگر دقت کنید وقتی این سؤال رو از خدا میپرسه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 182.48,
   "end": 184.94,
   "text": "خدای منان سؤال میکنه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 184.94,
   "end": 187.28,
   "text": "یا ابراهیم آیا تو اینو قبول نداری؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 187.28,
   "end": 194.06,
   "text": "حضرت میفرماین که این تیکه رو دقت کنید میفرماین که عرض میکنن که خدایا ولکن لیطمئن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 194.06,
   "end": 198.38,
   "text": "قلبی قبول دارم لکن میخوام که قلبم مطمئن بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 198.38,
   "end": 205.32,
   "text": "پس یکی از راه‌های یا یکی از بهترین راه‌های رسیدن به اطمینان قلبی دیدن است، رؤیت است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 205.32,
   "end": 207.76,
   "text": "حالا شهود است. میشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 207.76,
   "end": 211.22,
   "text": "هم به شهود باطنی هم ظاهری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 211.22,
   "end": 213.56,
   "text": "اختصاص پیدا کنه. میتونه تعمیم داده بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 213.56,
   "end": 217.84,
   "text": "میتونه هم دیدن در عالم رؤیای صادقه باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 217.84,
   "end": 220.46,
   "text": "میتونه در بیداری باشه، توجه به حقایق باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 220.46,
   "end": 222.28,
   "text": "میشه پرده‌ها برای انسان کنار بره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 222.28,
   "end": 224.6,
   "text": "خوبه انسان از خدا بخواد بعضاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 224.6,
   "end": 228.36,
   "text": "پرده‌ای براش کنار بره، معرفتی کسب کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 228.36,
   "end": 232.52,
   "text": "که البته همونطور که عرض کردیم قبلاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 232.52,
   "end": 236.48,
   "text": "معمولاً این چنین هست که خدای منان آینده و افق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 236.48,
   "end": 239.88,
   "text": "حرکتی بزرگان رو در عالم خواب یا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 239.88,
   "end": 246.4,
   "text": "حتی در بیداری چون فقط عرض کردیم خواب تعبیر نداره، بیداری هم اتفاقات پیرامون انسان هم تعبیر داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 246.4,
   "end": 248.02,
   "text": "بر اساس اون‌ها آینده‌شون رو نشون میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 248.02,
   "end": 252.28,
   "text": "به هر حال خوبه که انسان یه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 252.28,
   "end": 258.94,
   "text": "ذره چشمش رو باز کنه و از خدا بخواد چیزهایی رو بهش نشون بده که به اطمینان قلبی برسه و فقط به یافته‌هاش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 258.94,
   "end": 262.04,
   "text": "اکتفا نکنه. اینجا این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 262.04,
   "end": 265.3,
   "text": "داستان که در این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 265.3,
   "end": 271.26,
   "text": "کتاب شریف مرحوم کلینی اعلا الله مقاش، مقامش شریف وارد شده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 271.26,
   "end": 273.36,
   "text": "به همین اکتفا کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 273.36,
   "end": 277.3,
   "text": "لکن در تفاسیر مخصوصاً تفسیر عیاشی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 277.3,
   "end": 284.62,
   "text": "جلد یک صفحه صد و چهل و دو اشاره کرده از امام صادق صلوة الله علیه روایتی پیرامون همین در،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 284.62,
   "end": 287.36,
   "text": "در حقیقت ذیل این آیه آورده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 287.36,
   "end": 292.14,
   "text": "که حضرت میفرمود اون چهار پرنده‌ای که خدای متعال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 292.14,
   "end": 296.06,
   "text": "به حضرت ابراهیم دستور داد اینا رو بگیر بکش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 296.06,
   "end": 300.68,
   "text": "قطعه قطعه‌شون کن در هم بیامیز و بر چهار تپه یا کوه قرار بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 300.68,
   "end": 303.32,
   "text": "اونها رو بخون به سمت میان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 303.32,
   "end": 306.18,
   "text": "این چهار تا پرنده بودند که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 306.18,
   "end": 310.14,
   "text": "طاووس بود و خروس و کبوتر و کلاغ.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 310.14,
   "end": 314.14,
   "text": "البته در طاووس روایات همه متفق القول هستند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 314.14,
   "end": 318.66,
   "text": "اما روایات دیگه‌ای که ما داریم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 318.66,
   "end": 322.74,
   "text": "خروس و کبوتر و کلاغ رو پرنده های دیگه ای هم گفتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 322.74,
   "end": 326.94,
   "text": "به هر حال علمای اخلاقی و عرفانی ما هم اینجا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 326.94,
   "end": 329.46,
   "text": "نکات اخلاقی و عرفانی رو بیان کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 329.46,
   "end": 333.4,
   "text": "به عنوان نمونه گفتن هر کدوم از این چهار پرنده نمادی از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 333.4,
   "end": 336.26,
   "text": "ریشه‌های گناهانن، گناهان کبیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 336.26,
   "end": 340.76,
   "text": "مثلاً طاووس رو گفتن نماد تکبر و خودشیفتگی‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 340.76,
   "end": 344.58,
   "text": "خروس نماد شهوت و شهوت‌رانی‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 344.58,
   "end": 348.82,
   "text": "کبوتر نماد بازیگری و حب دنیاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 348.82,
   "end": 353.5,
   "text": "کلاغ نماد طول عمل، آرزوهای طولانی و حرص و آز است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 353.5,
   "end": 359.16,
   "text": "شاید به گونه‌ای بشه گفت با یک نگاه، به نگاه اخلاقی و عرفانی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 359.16,
   "end": 363.06,
   "text": "مراقبت بر این گناهان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 363.06,
   "end": 366.58,
   "text": "خودش راهی‌ست برای رسیدن به اطمینان قلبی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 366.58,
   "end": 371.58,
   "text": "و اگر قلبی پاک مونده از این گناهان او به اطمینان خواهد رسید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 371.58,
   "end": 376.64,
   "text": "به هر حال این داستانی که عرض کردیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 376.64,
   "end": 382.04,
   "text": "من حيثالمجموع نشون میده که برای رسیدن به اطمینان قلبی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 382.04,
   "end": 388.88,
   "text": "انسان باید از طریق قرآن رمز و رمزهاش رو کشف کنه و به اون سمت حرکت کنه، از خدا تقاضا کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 388.88,
   "end": 392.02,
   "text": "اگرچه مولای ما علی علیه الصلاة والسلام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 392.02,
   "end": 394.64,
   "text": "باعث افتخار ماست فرمودن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 394.64,
   "end": 398.84,
   "text": "وقتی که از ایشون سؤال کردن که شما برتری یا ابراهیم خلیل الله؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 398.84,
   "end": 403.38,
   "text": "اشاره به همین آیه کردن، آیه دویست و شصت سوره بقره به همین موضوع.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 403.38,
   "end": 405.8,
   "text": "خیلی جالبه که فرمود جان عالم به فداش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 405.8,
   "end": 411.54,
   "text": "فرمودن که من از ابراهیم برترم از این جهت که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 411.54,
   "end": 414.9,
   "text": "ابراهیم از خدا خواست نشون بده بهش چگونه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 414.9,
   "end": 418.88,
   "text": "اجساد برمی‌گردن در قیامت تا به اطمینان قلبی برسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 418.88,
   "end": 422.58,
   "text": "ولی من علی لو كشف الغطاء",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 422.58,
   "end": 424.88,
   "text": "ما زدت يقينا اگر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 424.88,
   "end": 428.3,
   "text": "پرده‌ها کنار بره سر سوزنی به یقین هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 428.3,
   "end": 431.72,
   "text": "اضافه نمیشه. خدا به آبروی مولای متقیان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 431.72,
   "end": 436.18,
   "text": "و امیر المؤمنان ان شاء الله که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 436.18,
   "end": 439.26,
   "text": "همه ما رو به اون یقین کامل و اطمینان قلبی برسونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 439.26,
   "end": 443.76,
   "text": "مثل رهبر عزیزمون که با اطمینان گفتن من از این دنیا میرم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 443.76,
   "end": 446.2,
   "text": "ما هم همینطور با اطمینان از این دنیا بریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 446.2,
   "end": 449.9,
   "text": "عاقبتمون ختم به خیر بشه به ذکر صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}