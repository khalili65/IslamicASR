 },
 "chapters": [
  {
   "index": 0,
   "title": "## کافر اعتقادی و روز سپردن عالم",
   "start": 12.66,
   "end": 33.04
  },
  {
   "index": 1,
   "title": "## صدق و طمأنینه؛ راه امام عصر",
   "start": 33.04,
   "end": 249.9
  },
  {
   "index": 2,
   "title": "## منتظر یعنی مترصد؛ قلب حق‌گرا",
   "start": 249.9,
   "end": 470.83
  },
  {
   "index": 3,
   "title": "## ابراهیم و یقین؛ شک و بی‌خیری",
   "start": 470.83,
   "end": 536.15
  },
  {
   "index": 4,
   "title": "## القلب حرم الله و تثبیت در دل",
   "start": 536.15,
   "end": 772.23
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 1.04,
   "end": 5.06,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 5.06,
   "end": 9.26,
   "text": "السلام علیک یا داعی الله و ربانی ایات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 9.26,
   "end": 12.66,
   "text": "سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 12.66,
   "end": 16.52,
   "text": "اگر کسی یکی از ضروریات دین رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 16.52,
   "end": 20.0,
   "text": "انکار کنه او هم کافر هست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 20.0,
   "end": 24.02,
   "text": "و بهش میگن کافر اعتقادی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 24.02,
   "end": 29.88,
   "text": "بعضی از ضروریات دین رو مثلا بگه آقا من همه ابعاد دین رو قبول دارم، نماز می‌خونم، روزه می‌گیرم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 29.88,
   "end": 33.04,
   "text": "حج میرم، خمس میدم اما وجود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 33.04,
   "end": 35.22,
   "text": "و غیبت امام زمان رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 35.22,
   "end": 39.74,
   "text": "قبول ندارم، نمی‌پذیرم. این بهش میگ-- به اینم میگن کافر،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 39.74,
   "end": 45.98,
   "text": "کافر قلبی‌ست. اما در خصوص خب این روز بسیار با عظمت که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 45.98,
   "end": 52.9,
   "text": "واقعا باید شیعه امروز به خودش بباله و امروز رو جشن بگیره با لباس خوب پوشیدن، عطر زدن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 52.9,
   "end": 55.14,
   "text": "شیرینی دادن، خوش برخوردی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 55.14,
   "end": 59.58,
   "text": "شده حتی تو خونه‌مون یه جشن کوچولو امروز بگیریم با خونواده‌مون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 59.58,
   "end": 64.68,
   "text": "در حد توانمون. یعنی خونواده متوجه بشن که امروز با روزهای دیگه ما فرق می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 64.68,
   "end": 68.62,
   "text": "سرنوشت عالم ناسوت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 68.62,
   "end": 74.84,
   "text": "برای ما، حالا عوالم دیگه که هست ولی حالا برای ما در حد خودمون حرف بزنیم، این دنیا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 74.84,
   "end": 77.52,
   "text": "امروز به دست حضرت ابا الحسن سپرده شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 77.52,
   "end": 84.16,
   "text": "چیز کمی نیست. ما بحثمون قلب مطمئن بود برای اینکه بحث گیره بخوره به قلب مطمئن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 84.16,
   "end": 94.54,
   "text": "عرض می‌کنم که ابتدای حدیث رو براتون بگم که خیلی قابل توجه است از کتاب نهج الفساحه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 94.54,
   "end": 98.24,
   "text": "الصدق طمأنينة و الكذب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 98.24,
   "end": 102.56,
   "text": "ريبة. چهار کلمه است اما غوغاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 102.56,
   "end": 105.32,
   "text": "پیغمبر فرمودند که صداقت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 105.32,
   "end": 107.78,
   "text": "مایه آرامش قلبی میشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 107.78,
   "end": 111.38,
   "text": "اطمینان قلبی میاره طمأنينة",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 111.38,
   "end": 117.94,
   "text": "و الكذب ريبة. دروغگویی و دروغ پروا-- پردازی و شخصیت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 117.94,
   "end": 124.12,
   "text": "دروغ از خودت ایجاد کردن و چه و چه هر مصادیقش اینا همه سبب شک و تردید میشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 124.12,
   "end": 129.78,
   "text": "حالا شما اینو بذارید کنار رب ادخلني مدخل صدق واخرجني مخرج صدق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 129.78,
   "end": 133.96,
   "text": "که غالب بزرگان مثل آقای کشمیری یا حتی عرفا مثل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 133.96,
   "end": 141.9,
   "text": "شیخ رجب علی خیاط‌ها برای ارتباط با امام عصر و دیدن ایشون سفارش به روزی صد بار قرائت این آیه می‌کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 141.9,
   "end": 146.84,
   "text": "چرا؟ چون ق-قبلا عرض کردم در تفاسیر ذیل این آیه اومده که اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 146.84,
   "end": 153.36,
   "text": "انتهای آیه که می‌فرماید و اجعل لي من لدنك سلطانا نصيرا اون سلطان نصير امام عصر است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 153.36,
   "end": 156.38,
   "text": "لازمه رسیدن به امام عصر چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 156.38,
   "end": 159.82,
   "text": "می‌گه رب ادخلني مدخل صدق واخرجني مخرج صدق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 159.82,
   "end": 166.86,
   "text": "صداقت، راستگویی، انسان راست با خودش راست کردار و راستگو و را--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 166.86,
   "end": 168.88,
   "text": "سعی کنه همه در همه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 168.88,
   "end": 171.28,
   "text": "امورات زندگی و شؤونات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 171.28,
   "end": 174.66,
   "text": "راستگو باشه و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 174.66,
   "end": 181.3,
   "text": "کذب و دروغ و این‌ها از وجودش ریخ-- ریشه‌کن بشه و الا به این اطمینان خاطر نمی‌رسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 181.3,
   "end": 188.08,
   "text": "خصوصا کسایی که میخوان منتظر ظهور حضرت باشن و با حضرت مرتبط باشن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 188.08,
   "end": 192.12,
   "text": "شاید بشه گفت تنها شاهراه صداقته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 192.12,
   "end": 197.76,
   "text": "این صداقت باید هم در اعتقادات انسان لحاظ بشه هم در عملیات بندگی التزام عملیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 197.76,
   "end": 204.12,
   "text": "یعنی کسی بیاد بگه آقا قربونت برم نوکرتم فدات بشم و ام-- در عمل منتظر واقعی نباشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 204.12,
   "end": 207.02,
   "text": "خب این صداقت، صداقتش ضعیفه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 207.02,
   "end": 211.34,
   "text": "چون در لسان مثل من حرف می‌زنه اما در عمل منتظر نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 211.34,
   "end": 213.9,
   "text": "منتظر منتظرش نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 213.9,
   "end": 218.08,
   "text": "تا حالا شده منتظر یه آدم مهمی باشی شب تا صبح خوابت نمی‌بره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 218.08,
   "end": 222.86,
   "text": "علت اینکه ما نوبت‌هامون بعضا لب طلایی میشه یا می‌پره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 222.86,
   "end": 227.0,
   "text": "همینه که استغفرالله خدا برامون خیلی مهم نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 227.0,
   "end": 231.7,
   "text": "اگه با آدم مهمی قرار داشته باشی زودتر-- من دیروز یه جای خیلی مهمی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 231.7,
   "end": 236.22,
   "text": "خیلی مهمی قرار داشتم، یک ساعت و نیم زودتر از قرار رسیدم اونجا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 236.22,
   "end": 239.2,
   "text": "انقدر که برام مهم بود. بعد به خودم نهیب زدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 239.2,
   "end": 245.44,
   "text": "گفتم اگر تو اینطور منتظر امام زمانت بودی کار-- یعنی مشکل حل بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 245.44,
   "end": 253.1,
   "text": "واقعا صداقت نسبت به حضرت اینکه انسان چون یه فرمایشی رهبر اخیرا داشتن چند تا نکته رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 253.1,
   "end": 257.44,
   "text": "در حسانی که از نیروهای مسلح داشتن پیراهون امام عصر گفتن خیلی کلیدی بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 257.44,
   "end": 261.1,
   "text": "یکی اشاره کردن به همین السلام علیک یا داعی الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 261.1,
   "end": 263.64,
   "text": "و ربانی ایاتک که امام عصر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 263.64,
   "end": 269.08,
   "text": "داعی الی الله. اگه شما دنبال خدایید باید پشت سر امام عصرتون باشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 269.08,
   "end": 271.92,
   "text": "این خیلی مهمه که ما برای چی مهدوی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 271.92,
   "end": 274.0,
   "text": "فرهنگ مهدویت رو میاریم تو زندگیمون؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 274.0,
   "end": 279.32,
   "text": "چون اون داعی الی الله. اگر تو توحید رو داری تو زندگیت، اگر من",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 279.32,
   "end": 283.2,
   "text": "انسان موحدی می‌خوام بشم راه امام عصره، راه دیگه‌ای نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 283.2,
   "end": 286.86,
   "text": "بعد فرمودن که همین که اینا خیلی نکات کلیدیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 286.86,
   "end": 289.18,
   "text": "همین که انسان بدونه در پس این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 289.18,
   "end": 295.76,
   "text": "شب ظلمانی قرار است طلوعی صورت بگیره، شب ظلمانی رو تا صبح",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 295.76,
   "end": 297.98,
   "text": "منتظر می‌مونه و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 297.98,
   "end": 301.94,
   "text": "صبوری می‌کنه، مشکلاتو تحمل می‌کنه و با امید حرکت می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 301.94,
   "end": 308.88,
   "text": "نکته سوم که مورد بحث ماست فرمودند که مت-- منتظر یعنی مترصد رهبر فرمودن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 308.88,
   "end": 312.4,
   "text": "یعنی آماده باش یعنی آماده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 312.4,
   "end": 321.06,
   "text": "معنای آماده هم اگر واقعا قرار باشه امام عصر سلام-- چون یه روایت هم داریم ظهور اتفاق-- یعنی ناگهانی رخ میده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 321.06,
   "end": 324.18,
   "text": "اتفاق میفته در حالی که همه متعجب میشن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 324.18,
   "end": 332.88,
   "text": "آمادگی ندارن و بعضی روایات هم قبلا گفتم میگه باب توبه بسته میشه آقا بیاد هرکی هرچی کرده تا اون لحظه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 332.88,
   "end": 336.16,
   "text": "خب برای اینکه ما بتونیم منتظر باشیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 336.16,
   "end": 338.9,
   "text": "راهش رو اینجا این حدیث کوتاه گفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 338.9,
   "end": 343.34,
   "text": "منتظر یعنی مترصد به قول رهبر عزیزمون جانم به فداش یعنی آماده باش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 343.34,
   "end": 345.16,
   "text": "آماده باش چه کسی می‌تونه آماده باشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 345.16,
   "end": 347.04,
   "text": "آقا بفرمایید مین الان بخوابید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 347.04,
   "end": 352.96,
   "text": "همین الان کی حاضره؟ کسی که صداقت داشته می‌دونسته برای کی داره بندگی می‌کنه، نوکری می‌کنه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 352.96,
   "end": 356.12,
   "text": "بنده دنیاش نبوده .",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 356.12,
   "end": 357.3,
   "text": "در ک-- اون کتاب،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 357.3,
   "end": 364.83,
   "text": "اون حدیث که گفتم نهج الفصاحه بود این حدیث، کتاب اصول کافی مرحوم کلینی اعلا مقامه الشریف ان القلب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 364.83,
   "end": 370.79,
   "text": "این چقدر قشنگه این حدیث. إن القلب قسماً همانا دل که ما بحثش رو داریم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 370.79,
   "end": 375.17,
   "text": "لیتجلجف في الجوف بی‌قراره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 375.17,
   "end": 377.89,
   "text": "بی‌قرار شدی؟ دلت هی این ور اون ور می‌زنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 377.89,
   "end": 380.87,
   "text": "نمی‌دونی چشه. چرا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 380.87,
   "end": 384.67,
   "text": "خیلی زیباست حدیث. فرمود یطلب الحق چون حق گراست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 384.67,
   "end": 388.27,
   "text": "قلب انسان حق گر دنبال حق می‌گرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 388.27,
   "end": 392.05,
   "text": "اوکی آروم می‌شه. فرمود فإذا أصابه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 392.05,
   "end": 394.81,
   "text": "این های ضمیر برمی‌گرده به اون حق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 394.81,
   "end": 396.83,
   "text": "یعنی وقتی حق بهش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 396.83,
   "end": 400.31,
   "text": "اصابت کرد، حالا خیلی جالبه که بحث اصابت رو میاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 400.31,
   "end": 406.87,
   "text": "نمیگه خودش رسید. یعنی او العلم نور ینزل على قلب من اراد ان يهدیه اینو تو قلبش--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 406.87,
   "end": 408.69,
   "text": "چون امر ولایت امر قلبیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 408.69,
   "end": 411.05,
   "text": "خیلی هم بحث نکنید با این کسایی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 411.05,
   "end": 413.59,
   "text": "ولایت رو نپذیرفتن. دلیل و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 413.59,
   "end": 416.63,
   "text": "محاجه بکنید اما بسپارید به خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 416.63,
   "end": 418.79,
   "text": "خیلی به خودتون فشار ن-- قلب اصلاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 418.79,
   "end": 421.03,
   "text": "امر ولایت امر قلبی است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 421.03,
   "end": 423.87,
   "text": "باید قلب طرف سالم مونده باشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 423.87,
   "end": 428.85,
   "text": "تا بتونه به اطمینان برسه. بعد می‌فرماید وقتی فإذا أصابه وقتی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 428.85,
   "end": 433.53,
   "text": "رس-- اصابت کرد حق به این قلب، ببینید چقدر زیبا می‌فرماید اطمئن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 433.53,
   "end": 436.89,
   "text": "مطمئن می‌شه و قر قرار می‌گیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 436.89,
   "end": 442.61,
   "text": "هر وقت احساس کردی دلت بی‌قراره، اصلاً آشفته‌ست، معلوم نیست چشه، این چی شده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 442.61,
   "end": 445.61,
   "text": "از حق فاصله گرفتی. جا الحق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 445.61,
   "end": 449.67,
   "text": "از حق الباطل قرار امام عصر که همون حق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 449.67,
   "end": 454.41,
   "text": "مطمئن بیاد دیگه. هر چقدر که به امام عصر ما نزدیک‌تر باشیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 454.41,
   "end": 459.23,
   "text": "اون موقع است که به حق نزدیک‌تریم و آرامش بیشتر-- مثل حضرت امام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 459.23,
   "end": 462.41,
   "text": "موقع‌ست که آدم الان می‌فهمه چرا امام،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 462.41,
   "end": 465.45,
   "text": "بهتر متوجه می‌شیم چرا امام میگه اگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 465.45,
   "end": 468.17,
   "text": "مثلا من تو یک بار تو عمرم نترسیدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 468.17,
   "end": 473.19,
   "text": "چون به اطمینان رسیده دیگه. ما ق-- بحث حضرت ابراهیم رو که گفتیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 473.19,
   "end": 477.55,
   "text": "گمان نکنیم که حضرت ابراهیم هم مثلا استغفرالله به شک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 477.55,
   "end": 479.85,
   "text": "افتاده بوده، مردد بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 479.85,
   "end": 482.33,
   "text": "اومد گفت و لکن لیطمئن قلبی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 482.33,
   "end": 484.79,
   "text": "خدایا به من نشون بده چجوری مرده‌ها رو زنده می‌کنی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 484.79,
   "end": 490.67,
   "text": "داستانشو گفتیم. دو تا روایت براتون پیدا کردم برای خودم البته، برای شما می‌خونم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 490.67,
   "end": 493.15,
   "text": "از امام هشتم یکی سؤال کرد که آقا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 493.15,
   "end": 495.87,
   "text": "آیا حضرت ابراهیم مشکوک بود؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 495.87,
   "end": 502.09,
   "text": "قبول نداشت؟ حضرت رضا صراحتا فرمود نه خیر، اتفاقا حضرت کاملا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 502.09,
   "end": 504.57,
   "text": "یقین داشت به مرده زنده شدن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 504.57,
   "end": 508.01,
   "text": "مرده‌ها. منتها از خدا می‌خواست که یقینش بیشتر بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 508.01,
   "end": 511.51,
   "text": "این فرق می‌کنه. من حالا خودمو مقایسه کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 511.51,
   "end": 516.93,
   "text": "یا یه روایت دیگه از امام کاظم یکی نوشت برای حضرت که آقا من تو شکم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 516.93,
   "end": 520.95,
   "text": "خیلی از ما مشکوکیم نسبت به امام عصر علیه-- از کجا بفهمیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 520.95,
   "end": 524.01,
   "text": "از اینکه مترصد نیستیم، آماده نیستیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 524.01,
   "end": 526.51,
   "text": "آماده‌ی ظهور حضرت نیستم من.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 526.51,
   "end": 528.87,
   "text": "لذا معلومه که مشکوکم. ببخشید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 528.87,
   "end": 531.47,
   "text": "خودم رو میگم به شما جسارت نشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 531.47,
   "end": 537.25,
   "text": "بعد جالبه که گفت یابن رسول الله نامه نوشت به مسلم بن عفعر که من مشکوکم ش-- در حالت شکم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 537.25,
   "end": 541.77,
   "text": "همونطور که ابراهیم از خدا خواست از شک بیرونش ببره گفت به من نشون بده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 541.77,
   "end": 543.65,
   "text": "خب به منم یه چیزی نشون بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 543.65,
   "end": 546.99,
   "text": "پررو شده بود طرف. حضرت فرمود چه حرفی تو می‌زنی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 546.99,
   "end": 550.09,
   "text": "ابراهیم مؤمن بود از خدا خواست یقینش رو بیشتر کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 550.09,
   "end": 553.57,
   "text": "اما تو در ش-- حالت شکی و این خیلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 553.57,
   "end": 556.91,
   "text": "نگران‌کننده‌ست این جمله‌ی پایانی مسلم بن جعفر در این نامه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 556.91,
   "end": 561.93,
   "text": "فرمود در-- کسی که در شک است هیچ خیری در او نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 561.93,
   "end": 564.51,
   "text": "می‌دونید چرا خیرات ما کمه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 564.51,
   "end": 567.23,
   "text": "چرا خیری از من سر نمی‌زنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 567.23,
   "end": 574.85,
   "text": "من خودم خدا می‌دونه بزرگ‌ترین دردم رو اگه بخوام به امام عصر تو یه جمله بگم، میگم آقا خ-- من بی خیر شدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 574.85,
   "end": 577.09,
   "text": "الان متوجه می‌شم که چرا بی خیرم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 577.09,
   "end": 580.59,
   "text": "چون در شکم، مطمئن نیستم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 580.59,
   "end": 582.65,
   "text": "ببین تو قلبمون چی تثبیت شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 582.65,
   "end": 586.25,
   "text": "اگر علامه حسن زاده نوشت القلب حرم--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 586.25,
   "end": 591.67,
   "text": "بهتون گفتم یه بار خدمتش رسیدم گفتم یه چیز بنویس برای آخر عمرم بس باشه همین، اینو نوشت داد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 591.67,
   "end": 595.15,
   "text": "القلب حرم الله و لا تسکن حرم الله غیر الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 595.15,
   "end": 599.41,
   "text": "حرم خدا قلب ماست که جایگاه مهدی و فاطمه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 599.41,
   "end": 602.03,
   "text": "اگر آقا رو راه دادی با صداقت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 602.03,
   "end": 605.49,
   "text": "رب أدخلنی مدخل صت وأخرجنی مخرجصت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 605.49,
   "end": 611.05,
   "text": "اون موقع سلطان دیاریگر که امام عصره تو قلبت می‌شینه و تو مطمئن میشی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 611.05,
   "end": 616.75,
   "text": "و این قلب ت-- حقیقتش در برزخ و قیامت جلوه‌گر می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 616.75,
   "end": 621.29,
   "text": "یعنی اونچه که در نشئه صغرا که برزخ است و نشئه کبرا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 621.29,
   "end": 625.17,
   "text": "که قیامت است رخ میده حقیقت قلب ماست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 625.17,
   "end": 627.71,
   "text": "نه بازی‌هایی که از خودم درآوردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 627.71,
   "end": 630.95,
   "text": "آنچه در وجودم تثبیت شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 630.95,
   "end": 637.05,
   "text": "حالا چون جشنم هست یه ذره این مثال شاید خنده‌دار باشه اما با این مثال بحثو جمع کنم که خدا رحمت کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 637.05,
   "end": 640.11,
   "text": "حضرت آیت الله استاد کل آقای حق شناس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 640.11,
   "end": 642.93,
   "text": "یه شاگردی داشتن. یه روز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 642.93,
   "end": 646.63,
   "text": "برزخ شاگردشونو دیدن و اومدن به خ-- گوششونم پیچوندن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 646.63,
   "end": 649.29,
   "text": "گفتن تو خیلی شوخی، خیلی مزاحی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 649.29,
   "end": 652.89,
   "text": "گفت بله استاد خیلی دیدی بعضی از شما هم اینطوری هستید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 652.89,
   "end": 654.51,
   "text": "خیلی مزاحید. خوبم هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 654.51,
   "end": 656.99,
   "text": "امیرالمؤمنین هم مزاح بوده اما نه به هر قیمتی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 656.99,
   "end": 658.91,
   "text": "به هر حال. خیلی مزاح بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 658.91,
   "end": 661.59,
   "text": "همه رو می‌خندوند به هر طریقی. حالا امروز هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 661.59,
   "end": 668.43,
   "text": "بعضیا جلو ما نشستنو خلاصه مصداق اتم شاید نشه گفت ولی مصداق خوبی هستن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 668.43,
   "end": 672.57,
   "text": ". بعد حالا به مانند از اسرار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 672.57,
   "end": 676.61,
   "text": "بله. ایشون فرمودن که گوش-- حالا گوش شاگردش رو چرا پیچونده بود؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 676.61,
   "end": 680.85,
   "text": "گفت من تو عالم برزخ دیدم که تو رو کت بسته با دو تا از این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 680.85,
   "end": 688.49,
   "text": "حالا ملایک جهنم بگیم و این ملائکه غلاظ و شداد گرفتن دارن می‌برن محضر میزان اون انوار که امیرالمؤمنینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 688.49,
   "end": 691.27,
   "text": "محضر علی علیه الصلاة والسلام که رسیدی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 691.27,
   "end": 694.71,
   "text": "گفتن یا علی این خیلی شوخی می‌کنه، خیلی جوک میگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 694.71,
   "end": 702.15,
   "text": "همش همه رو می‌خندونه. تو هم تو اون لحظه دیگه دیدی کار تمام شده‌ست دیگه محضر میزان رسیدی و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 702.15,
   "end": 704.07,
   "text": "کارتو توجیه کردی برای مولا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 704.07,
   "end": 709.81,
   "text": "خندیدی تو خواب به مولا گفتی یا علی من این کارا رو کردم مگه ادخال السرور در قلب مؤمن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 709.81,
   "end": 714.45,
   "text": "خودش ثواب نداره؟ ادخال السرور در قلب مؤمن می‌کردم، می‌خندیدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 714.45,
   "end": 718.21,
   "text": "امیرالمؤمنین سرشو تکون داد گفت خب حالا اگه اینه اشکال نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 718.21,
   "end": 721.85,
   "text": "بعد برگشت-- نکته اینجاست خنده‌داره اما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 721.85,
   "end": 724.93,
   "text": "خیلی مهمه. برگشت رو به اون دو تا ملک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 724.93,
   "end": 728.29,
   "text": "غلاظ و شداد شستشو نشون داد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 728.29,
   "end": 733.47,
   "text": "یعنی بعد میگه این رو آقای حق شناس بهش گفت که یعنی این تو وجودتو تثبیت شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 733.47,
   "end": 736.81,
   "text": "اون دنیام باز از این کار دست برنداشتی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 736.81,
   "end": 743.59,
   "text": "به ملائکه الله. اینکه بعضیا اگه میگن چشاتو کنترل نکنی یهو میری اون دنیا هم خلاصه با حوریای بهشتی هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 743.59,
   "end": 748.13,
   "text": "کار دستت میده. حواست باید باشه اونجا چشمک به اونام نزنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 748.13,
   "end": 751.53,
   "text": "این تثبیت شدن تو دل خیلی مهمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 751.53,
   "end": 753.41,
   "text": "چی تو قلب ما تثبیت شده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 753.41,
   "end": 756.61,
   "text": "همونه. اصلاً نیت ما همینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 756.61,
   "end": 760.33,
   "text": "صریرت ما همینه. حقیقت ما همینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 760.33,
   "end": 762.67,
   "text": "عاقبت هممون انشاالله ختم به خیر بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 762.67,
   "end": 765.53,
   "text": "به ذکر صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 765.53,
   "end": 772.23,
   "text": "اللهم صل على محمد و آل محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}