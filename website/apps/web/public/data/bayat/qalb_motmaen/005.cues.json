 },
 "chapters": [
  {
   "index": 0,
   "title": "## سنت خدا؛ نشان دادن افق پیش از سیر",
   "start": 12.34,
   "end": 53.7
  },
  {
   "index": 1,
   "title": "## یوسف؛ احسن القصص با خواب آغاز می‌شود",
   "start": 53.7,
   "end": 297.82
  },
  {
   "index": 2,
   "title": "## خواب امام در نجف و تعبیر کشمیری",
   "start": 297.82,
   "end": 443.04
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 1.1,
   "end": 4.88,
   "text": "بسم الله الرحمن الرحیم و به این استعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 4.88,
   "end": 8.5,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 8.5,
   "end": 12.34,
   "text": "آیه. سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 12.34,
   "end": 16.24,
   "text": "موضوع ما که قبل از اربعین دست گرفته بودیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 16.24,
   "end": 21.22,
   "text": "آیاتی بود و موضوعی بود پیرامون قلب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 21.22,
   "end": 24.8,
   "text": "حدود شصت نوع قلب رو گفتیم در قرآن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 24.8,
   "end": 31.22,
   "text": "خدای متعال ذکر کرده و اون‌ها رو ما شمردیم براتون و شروع کردیم توضیح این قلوب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 31.22,
   "end": 37.94,
   "text": "اول قلب مطمئن رو توضیح دادیم که یه چند موضوع در خصوص قلب مطمئن موند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 37.94,
   "end": 43.86,
   "text": "این رو من عرض کنم سنت خدای متعال این هست که برای اینکه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 43.86,
   "end": 46.26,
   "text": "دوستانش و اولیاش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 46.26,
   "end": 49.62,
   "text": "و رهروانش و عبادش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 49.62,
   "end": 53.7,
   "text": "به اطمینان قلبی راه خدا رو طی کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 53.7,
   "end": 60.82,
   "text": "بسیاری از بزرگان این رو گفتن که من خدمت شما عرض می‌کنم و نکته بسیار مهم کلیدی‌ای هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 60.82,
   "end": 65.5,
   "text": "سنت خدا این هست که معمولا قبل از اینکه اون شخص",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 65.5,
   "end": 71.52,
   "text": "سیر خودش رو شروع کنه یا همون ابتدا که شروع کرده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 71.52,
   "end": 76.64,
   "text": "افق انتهایی کارش رو بهش نشون میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 76.64,
   "end": 80.02,
   "text": "هم در خواب هم در بیداری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 80.02,
   "end": 83.58,
   "text": "خب فقط خواب نیست که تعویل و تدبی--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 83.58,
   "end": 86.7,
   "text": "تعویل داره یا تعبیر داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 86.7,
   "end": 92.0,
   "text": "بیداری هم بزرگان گفتن هر آنچه که اتفاق حول و حوش انسان می‌افته این هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 92.0,
   "end": 99.22,
   "text": "تعبیر داره. مثلا اگر کسی زیاد در معرض سختی قرار می‌گیره و مثلا مریض زیاد میشه و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 99.22,
   "end": 101.94,
   "text": "مشکلات زیاد می‌بینه، این قطعاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 101.94,
   "end": 106.06,
   "text": "خدایه کاری باهاش داره. خدا می‌خواد او رو به یک درجهاتی برسونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 106.06,
   "end": 111.64,
   "text": "برعکس نگاه مردم که یکی مریض زیاد میشه یا مشکلی براش پیش میاد میگه از چشم خدا افتاده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 111.64,
   "end": 116.16,
   "text": "اینطوری نیست. اتفاقا حدیث داریم کسی که مریض میشه بهش بگو دعا ت کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 116.16,
   "end": 119.34,
   "text": "او باید تو رو دعا کنه. او به خدا نزدیک‌تره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 119.34,
   "end": 122.88,
   "text": "مثلا شخصی پیش امام سجاد علیه السلام اومد گفت آقا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 122.88,
   "end": 125.06,
   "text": "من هیچ اتفاقی برام نمی‌افته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 125.06,
   "end": 128.3,
   "text": "گفت حتی یه خشی رو دستت نمی‌افته؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 128.3,
   "end": 131.52,
   "text": "مثلا دستت خراشی برداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 131.52,
   "end": 133.18,
   "text": "گفت نه اصلا هیچ بلایی، هیچی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 133.18,
   "end": 136.74,
   "text": "حضرت فرمود برو، برو میخوام-- اصلا نمی‌خوام اینجا باشی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 136.74,
   "end": 138.62,
   "text": "می‌ترسم بلا بر من نازل بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 138.62,
   "end": 141.1,
   "text": "تو از چشم خدا افتادی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 141.1,
   "end": 146.28,
   "text": "یعنی این سنت خداست که حالا هم با اتفاقاتی که در روز می‌افته،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 146.28,
   "end": 150.94,
   "text": "در طی زندگی بیرون از خواب می‌افته، این چشم حق‌بین می‌خواد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 150.94,
   "end": 154.28,
   "text": "متوجه بشه که خدا باهاش چیکار داره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 154.28,
   "end": 158.92,
   "text": "یا در خواب. غالب بزرگان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 158.92,
   "end": 161.42,
   "text": "انتهای کارشون رو در خواب دیدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 161.42,
   "end": 165.1,
   "text": "یک جرقه‌ای خورده و بهشون افق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 165.1,
   "end": 168.22,
   "text": "نگاهشون و دیدشون و طریقشون رو نشون دادن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 168.22,
   "end": 173.56,
   "text": "یکی از مهم‌ترین شاخصه‌ها و مصداق در همین موضوع حضرت یوسف هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 173.56,
   "end": 179.9,
   "text": "شما اگر سوره حضرت یوسف رو دقت کنید که به عنوان احسن القصص",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 179.9,
   "end": 183.26,
   "text": "قرآن از او یاد می‌کنه، آیه چهارش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 183.26,
   "end": 188.46,
   "text": "به همین جریان خواب حضرت یوسف این احسن القصص",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 188.46,
   "end": 200.4,
   "text": "با یک خواب شروع میشه که حضرت \"وقال یوسف لأبيه یا أبت إنی رأيت أحد عشر كوكبا والشمس والقمر رأيتهم لي ساجدين\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 200.4,
   "end": 202.96,
   "text": "دو تا دیدن توش اومده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 202.96,
   "end": 206.6,
   "text": "یکی اون اول آیه که میگه \"إنی رأيت\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 206.6,
   "end": 212.1,
   "text": "پدر من دیدم و همچنین آخرش که باز می‌فرماید \"رأيتهم لي ساجدين\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 212.1,
   "end": 216.5,
   "text": "من دیدم این‌ها رو که سجده کردن برای من.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 216.5,
   "end": 221.18,
   "text": "خب حضرت یوسف وقتی این خوابش رو برای سی یعقوب بیان کرد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 221.18,
   "end": 222.88,
   "text": "حضرت یعقوب تعبیرش رو گفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 222.88,
   "end": 224.78,
   "text": "این انتهای کارش خودشو دید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 224.78,
   "end": 229.4,
   "text": "برای چی؟ یه دلیلش اینه که به اطمینان قلبی برسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 229.4,
   "end": 232.78,
   "text": "قلبش مطمئن بشه، به یقین کامل برسه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 232.78,
   "end": 237.24,
   "text": "بلکه به سختی‌های این سفر و این طریق و این راه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 237.24,
   "end": 244.6,
   "text": "صبر کنه. خب هیچ پیغمبری شما می‌دونید مثل-- اصلا هیچ پیغمبری رو ما نداریم تو تاریخ که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 244.6,
   "end": 248.8,
   "text": "برده شده باشه، خرید و فروش شده باشه، تو چاه افتاده باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 248.8,
   "end": 252.12,
   "text": "ما نداریم. حضرت یوسف تنها پیغمبری‌ست که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 252.12,
   "end": 255.92,
   "text": "قرآن می‌فرماید که او برده شد، خرید و فروش شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 255.92,
   "end": 259.76,
   "text": "خیلی سخته یه آدم عزیز اینطوری ذلیل بشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 259.76,
   "end": 262.74,
   "text": "یا تو چاه بیفته. وقتی هم داشت تو چاه می‌افتاد خندید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 262.74,
   "end": 265.86,
   "text": "برادراش گفتن چرا می‌خندی؟ داشتن مینداختنش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 265.86,
   "end": 270.68,
   "text": "گفت من تا پیش از این گمان می‌کردم یازده تا برادر دارم خوشبخت‌ترین آدم رو زمینم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 270.68,
   "end": 274.42,
   "text": "الان می‌فهمم به دست همون برادرهام دارم کشته میشم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 274.42,
   "end": 278.44,
   "text": "و این سختی‌های طی طریق رو که فروختنش و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 278.44,
   "end": 280.58,
   "text": "و خادم شد توی درباری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 280.58,
   "end": 283.08,
   "text": "این همه سختی‌های دوری از وطن و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 283.08,
   "end": 289.08,
   "text": "و جزو وکارون هم هست که می‌دونید دیگه حضرت یوسف جزو اون پنج نفر هست که خیلی گریه کرده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 289.08,
   "end": 293.14,
   "text": "اما همه رو صبر کرد. چرا؟ افق دیدش رو می‌دونست کجاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 293.14,
   "end": 297.56,
   "text": "دیده بود. مطمئن بود. قلبش مطمئن بود که قراره اتفاقی بیو--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 297.56,
   "end": 301.28,
   "text": "حتی حضرت امام رحمت الله علیه در نجف که بود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 301.28,
   "end": 306.52,
   "text": "یه خوابی دیده بود که ایشون می‌فرمودن که آستاد احمد خدا رحمتش کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 306.52,
   "end": 309.26,
   "text": "می‌فرمودند امام یه خوابی دید تو نجف که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 309.26,
   "end": 317.52,
   "text": "در نجف از دنیا رفته و ایشون رو امیرالمؤمنین علیه الصلاة والسلام به دست خودش دفن کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 317.52,
   "end": 322.06,
   "text": "بعد حتی یه چیزی پشت کمر امام تو قبر اذیتش می‌کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 322.06,
   "end": 325.6,
   "text": "امیرالمؤمنین اونو برمی‌داره که امام راحت باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 325.6,
   "end": 327.66,
   "text": "بهش میگه راحت باش. خب امیر--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 327.66,
   "end": 335.72,
   "text": "حضرت امام گمانش از این خواب به هر حال خواب اون‌ها مثل خواب ما نبوده که رویا صادقه‌ست دیگه اولیای خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 335.72,
   "end": 343.68,
   "text": "گمانش این بوده که اونجا همونجا تو نجف از دنیا میره و این‌ها تموم میشه و انقلاب ایران همینطور نصفه کاره می‌مونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 343.68,
   "end": 349.52,
   "text": "اما آستاد احمد بهش میگه بابا یه آقایی هست، یه عالمی هست تو نجف خیلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 349.52,
   "end": 351.88,
   "text": "تعبیر خوابش خوبه و خیلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 351.88,
   "end": 353.94,
   "text": "آدم بزرگی‌ست. کیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 353.94,
   "end": 360.3,
   "text": "آستاد عبد الکریم کشمیری رضوی رحمت الله علیه که ایشون یه آدم-- عالم عجیبی بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 360.3,
   "end": 365.52,
   "text": "شاگرد آیه قاضی بود. بسیار عجیب حالات عجیبی از ایشون گفتن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 365.52,
   "end": 367.9,
   "text": "مثلا شش ساعت، هشت ساعت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 367.9,
   "end": 370.58,
   "text": "عبا رو سرش جلو ضریح می‌نشست هر روز ذکر می‌گفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 370.58,
   "end": 375.26,
   "text": "کارهای عجیبی داشت. ایشون گفته بود که خب برید ازش بپرسید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 375.26,
   "end": 377.48,
   "text": "امام گفته بود برید. دو بار رفته بودن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 377.48,
   "end": 380.74,
   "text": "ایشون جواب نداده بود. بعد در ف-- در سوم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 380.74,
   "end": 387.94,
   "text": "جواب داده بود که نه این خواب شما اتفاقا یعنی اینکه شما به ایران میری، انقلاب پیروز میشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 387.94,
   "end": 390.66,
   "text": "و شما در ایران از دنیا میری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 390.66,
   "end": 393.7,
   "text": "و اونجا هم دفن میشی. و حضرت امام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 393.7,
   "end": 395.9,
   "text": "این باعث شد که نه فقط این آ--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 395.9,
   "end": 398.4,
   "text": "این خواب بگیم حالا مثلا امام رو محکم کرد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 398.4,
   "end": 403.94,
   "text": "اما اینم یک دلیلی بود برای اینکه امام افقش رو ببینه، مطمئن‌تر حرکت کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 403.94,
   "end": 407.94,
   "text": "بسیاری از ما از خواب‌هامون، از اتفاقات دور و برمون غافلیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 407.94,
   "end": 411.62,
   "text": "چشم بندازیم ببینیم خدا برای ما چی در نظر گرفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 411.62,
   "end": 416.52,
   "text": "از خواب‌هامون، از اتفاقات دور و برمون خیلی راحت می‌تونیم آینده‌مون رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 416.52,
   "end": 424.1,
   "text": "پیدا کنیم. این نکته بسیار کلیدی‌ایه که بزرگان فرمودن و به خاطر اینکه خدا اطمینان قلبی به ما بده در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 424.1,
   "end": 427.36,
   "text": "مسیر صبور باشیم و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 427.36,
   "end": 429.66,
   "text": "زود از کوره به در نریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 429.66,
   "end": 434.62,
   "text": "ان شا الله که عاقتمون ختم بخیر بشه به ذکر صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 434.62,
   "end": 439.2,
   "text": "اللهم صل على محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 439.2,
   "end": 443.04,
   "text": "و آل محمد و عجل فرجهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}