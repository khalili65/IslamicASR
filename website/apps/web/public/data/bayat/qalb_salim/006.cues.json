 ],
 "cues": [
  {
   "i": 0,
   "start": 0.54,
   "end": 4.0,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 4.0,
   "end": 8.34,
   "text": "السلام علیک یا داعی الله و ربانی آیاته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 8.34,
   "end": 11.78,
   "text": "سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 11.78,
   "end": 15.78,
   "text": "از رهبر عزیز استفتاء شده که آیا این پول‌هایی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 15.78,
   "end": 23.88,
   "text": "به صورت وام از بانک‌ها برای حالا مثلاً ساخت مسکن یا خرید مسکن یا امثالهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 23.88,
   "end": 25.88,
   "text": "گرفته می‌شه یا برای مثلاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 25.88,
   "end": 30.22,
   "text": "راه انداختن یه کار یا زمین کشاورزی و این‌ها بعد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 30.22,
   "end": 34.54,
   "text": "بابتش سود تسهیلات می‌گیرن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 34.54,
   "end": 37.06,
   "text": "آیا این اشکال داره؟ البته تو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 37.06,
   "end": 41.88,
   "text": "سؤال من دیدم که گفتن که این پول‌ها رو قرض میدن بعد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 41.88,
   "end": 49.0,
   "text": "سود می‌گیرن. رهبری بلافاصله فرمودن که اگر در قالب قرض این پول داده می‌شه یعنی قرضی‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 49.0,
   "end": 50.84,
   "text": "ما قرض ربوی که نداریم که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 50.84,
   "end": 55.34,
   "text": "اگر در قالب قرض داده می‌شه هر گونه سودی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 55.34,
   "end": 59.6,
   "text": "حرام است و اشکال دارد. اما نه معمولاً غالباً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 59.6,
   "end": 61.7,
   "text": "این‌ها رو بانک‌ها به صورت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 61.7,
   "end": 70.48,
   "text": "تسهیلات حالا در بر اساس اون عقود اسلامی که بارها عرض کردیم مثل مشارکت و مضاربه و جعاله و این‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 70.48,
   "end": 73.3,
   "text": "میدن بر اساس اونه مثلاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 73.3,
   "end": 76.6,
   "text": "ااا بانک میاد، بانک مسکن میاد یه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 76.6,
   "end": 80.78,
   "text": "ااا بخشی از هزینه ساخت مسکن شما رو میده و در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 80.78,
   "end": 84.28,
   "text": "ا یه دونگ دو دونگ حالا به میزان پولی که میده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 84.28,
   "end": 87.24,
   "text": "در ملک شما سهیم می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 87.24,
   "end": 92.56,
   "text": "بعد میاد این سهم خودشو به شما بیست ماهه مثلاً چهل ماهه می‌فروشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 92.56,
   "end": 96.02,
   "text": "این دیگه قصه‌ش فرق می‌کنه با قرض.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 96.02,
   "end": 102.3,
   "text": "این می‌شه فروش سهم خودش به شما به صورت اخصاصی و در قبالش می‌تونه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 102.3,
   "end": 104.56,
   "text": "سود دریافت کنه از جهت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 104.56,
   "end": 109.1,
   "text": "یعنی می‌شه یه نوع مشارکت کردن که اشکالی هم نداره از جهت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 109.1,
   "end": 113.48,
   "text": "حالا عقود اسلامی. اینو باید دقت داشته باشیم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 113.48,
   "end": 118.9,
   "text": "خلط بحث نشه بین قرض یا تسهیلات و این‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 118.9,
   "end": 127.78,
   "text": "نکته‌ای که باید عرض کنیم و معمولاً خود ماها ازش غفلت کردیم، در حالی که مثل ماهی تو آب الان درش هستیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 127.78,
   "end": 132.02,
   "text": "تو مبحث قلب سلیم یه سلامت قلبی عموم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 132.02,
   "end": 138.22,
   "text": "جامعه اسلامی رو فرا گرفته که ما هم یک بخشی از یک جزئی از اون جامعه هستیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 138.22,
   "end": 140.6,
   "text": "اونم حواسمون گاهی اوقات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 140.6,
   "end": 143.6,
   "text": "شاید خیلی موقع‌ها شاید همیشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 143.6,
   "end": 146.72,
   "text": "حرص از اینکه ما در دوران غیبت هستیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 146.72,
   "end": 152.32,
   "text": "و ما دائماً آن به آن در حال امتحان پس دادن به غیبت اماممونیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 152.32,
   "end": 158.78,
   "text": "این چیز کمی نیست. فقط یه قلب سلیم و تسلیم امام عصر می‌تونه این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 158.78,
   "end": 162.28,
   "text": "ولایت پذیری رو به جان بخره بپذیره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 162.28,
   "end": 164.68,
   "text": "و در مسیر حضرت حرکت کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 164.68,
   "end": 167.94,
   "text": "شما ببینید در دوران اهل بیت علیهم الصلاة والسلام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 167.94,
   "end": 170.24,
   "text": "دوره‌های متعددی رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 170.24,
   "end": 173.72,
   "text": "در اون حدود دویست و پنجاه سال طی کردن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 173.72,
   "end": 175.48,
   "text": "که این دوره‌ها خیلی عجیب بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 175.48,
   "end": 183.1,
   "text": "مثلاً امام سجاد سلام الله عليه می‌فرمایند که در کل جزیرة العرب و این‌ها بیست نفر یا شامات و اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 183.1,
   "end": 187.38,
   "text": "ممالک اسلامی بیست نفرم ما رو قبول نداشتن، دوست نداشتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 187.38,
   "end": 192.32,
   "text": "ببینید چه دوره‌ای و حتی قبل از امام سجاد یا در زمان امام سجاد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 192.32,
   "end": 197.06,
   "text": "شیعیان می‌رفتن سؤالات شرعی‌شون رو از علمای اهل تسنن می‌پرسیدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 197.06,
   "end": 203.28,
   "text": "از امام نمی‌پرسیدن. یه دوران عجیبی بود که در زمان امام باقر و امام صادق صلوات الله عليهما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 203.28,
   "end": 210.38,
   "text": "یه نهضتی شکل گرفت. الحمد لله به جهت دعوای بین بنی العباس و بنی امیه و این‌ها مکتب سازی کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 210.38,
   "end": 213.94,
   "text": "یه جریانی به فضل الهی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 213.94,
   "end": 216.44,
   "text": "شکل گرفت و مکتب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 216.44,
   "end": 219.84,
   "text": "و اینکه می‌گیم مثلاً ااا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 219.84,
   "end": 221.8,
   "text": "رئیس مکتب یا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 221.8,
   "end": 227.32,
   "text": "رئیس مثلاً مکتب ما امام صادق یا امام باقر هست هر کدوم فرق نمی‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 227.32,
   "end": 232.24,
   "text": "اون دوره واقعاً این مکتب شکل گرفت و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 232.24,
   "end": 236.78,
   "text": "همه حول و حوش امام حلقه امام تجمع کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 236.78,
   "end": 242.44,
   "text": "در زمان این ااا عرض کنم امتحان الهی پیش رفت تا زمان امام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 242.44,
   "end": 244.92,
   "text": "کاظم و امام رضا به قدری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 244.92,
   "end": 247.92,
   "text": "تبیین شد مسئله امامت که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 247.92,
   "end": 250.9,
   "text": "به قول بزرگان جامعه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 250.9,
   "end": 253.7,
   "text": "شیعی در خصوص",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 253.7,
   "end": 256.86,
   "text": "خردسال بودن امام امتحان شد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 256.86,
   "end": 259.6,
   "text": "و الحمد لله پیروز بیرون اومد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 259.6,
   "end": 263.96,
   "text": "یعنی یه کسی مثل امام جواد صلوات الله عليه در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 263.96,
   "end": 268.66,
   "text": "خیلی خردسالی مثلاً هشت سالگی، نه سالگی این‌ها امام شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 268.66,
   "end": 271.08,
   "text": "این حدود سنی و جامعه پذیرفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 271.08,
   "end": 274.72,
   "text": "حتی من تو یه روایتی دیدم خیلی جالب بود برام که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 274.72,
   "end": 277.66,
   "text": "علی بن جعفر عموی امام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 277.66,
   "end": 286.18,
   "text": "رضا و فرزند امام صادق صلوات الله عليه که از فضلا و فقها و علمای زمان خودش بود و کتاب‌ها در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 286.18,
   "end": 292.24,
   "text": "ابواب مختلف علمی داشت، ریش سفید بود، پیرمرد نورانی و معنوی خیلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 292.24,
   "end": 294.52,
   "text": "فکر کنید یه مرجع تقلید. ایشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 294.52,
   "end": 297.38,
   "text": "تو مسجد النبی داشتن درس می‌دادن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 297.38,
   "end": 299.7,
   "text": "امام جواد خردسال وارد شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 299.7,
   "end": 302.38,
   "text": "علی بن جعفر بلند شد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 302.38,
   "end": 305.4,
   "text": "جلوی همه شاگرداش، به خدا کسی این کارو نمی‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 305.4,
   "end": 309.44,
   "text": "جلوی همه شاگرداش رفت تحت Henk اینکه الان من باز کردم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 309.44,
   "end": 313.94,
   "text": "به این میگن تحت Henk گوشه عمامه رو باز کرد باهاش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 313.94,
   "end": 317.5,
   "text": "نعلین امام جواد سلام الله عليه رو پاک کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 317.5,
   "end": 320.98,
   "text": "همه شاگردا اعتراض کردن این چه کاریه شما می‌کنی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 320.98,
   "end": 323.32,
   "text": "شمای ریش سفید یه بچه فرمود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 323.32,
   "end": 327.44,
   "text": "خدای مننان ریش سفید منو قابل امامت ندونست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 327.44,
   "end": 329.32,
   "text": "ولی ایشون رو امام من قرار داد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 329.32,
   "end": 331.98,
   "text": "ببینید این یک و همه هم تبعیت کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 331.98,
   "end": 334.06,
   "text": "این یک امتحان بزرگی بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 334.06,
   "end": 337.22,
   "text": "منتها از این قصه ما غافلیم که بعدش که به امام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 337.22,
   "end": 343.82,
   "text": "عصر به امام زمان ما سلام الله عليه می‌رسه دوباره این تکرار می‌شه و ما الان در همون تکرار تاریخی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 343.82,
   "end": 346.68,
   "text": "قرار داریم. یا اون پیچ طویل تاریخی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 346.68,
   "end": 349.46,
   "text": "چند تا پیچ داشته تاریخ دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 349.46,
   "end": 352.64,
   "text": "همه پیچ‌ها که سریع ازش نمی‌گذرن که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 352.64,
   "end": 354.8,
   "text": "یه گذر بعضی موقع‌ها خیلی طول می‌کشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 354.8,
   "end": 356.88,
   "text": "همین غیبت. حالا در،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 356.88,
   "end": 363.34,
   "text": "در زمان امام هادی و امام عسکری یواش‌یواش این شکل گرفت که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 363.34,
   "end": 366.55,
   "text": "حالا قبلش بر بحث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 366.55,
   "end": 372.73,
   "text": "امامت امام خرسان که خود امام عصر هم دوباره این امتحان رو پس گرفت یعنی گرفت از مردم دوباره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 372.73,
   "end": 376.13,
   "text": "خود آقا هم حدود پنج شش سال بود که امامت گرفت دیگه امام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 376.13,
   "end": 381.05,
   "text": "زمان ما. که این تکرار شده بود اما قصه غیبت تکرار نشده بود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 381.05,
   "end": 383.83,
   "text": "و الانم تو همون دورانیم حواسمون نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 383.83,
   "end": 390.01,
   "text": "یه امتحان بسیار بزرگیه. ببینید بعد از امام رضا دیگه جامعه شیعه انشقاق نداشتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 390.01,
   "end": 391.67,
   "text": "ما هفت امامی داریم حتی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 391.67,
   "end": 394.23,
   "text": "شیعه هفت امامی داریم تا موسی بن جعفر،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 394.23,
   "end": 396.33,
   "text": "واقفیه مثلا. تمام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 396.33,
   "end": 401.13,
   "text": "دیگه امام رضا رو قبول ندارن. اما امام رضا رو هرکس قبول کرده تا یکی از دلایلی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 401.13,
   "end": 404.33,
   "text": "زیارت ایشون افضل از همه‌ی زیارات اینه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 404.33,
   "end": 410.99,
   "text": "همه دور امام رضا جمع می‌شن و جامعه شیعه اثنی عشری شکل می‌گیره که شکل گرفته و انشاالله منتج به ظهور می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 410.99,
   "end": 414.51,
   "text": "اما در هر حال از امام رضا به بعد دیگه این انشقاق وجود نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 414.51,
   "end": 417.07,
   "text": "شیعیان خوب پذیرفتن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 417.07,
   "end": 419.91,
   "text": "که حتی امامت نه سلطنت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 419.91,
   "end": 422.73,
   "text": "پادشاهی، امامت که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 422.73,
   "end": 430.61,
   "text": "و آتیناه الحکم الصبیان در بچگی حکم و نبوت و امامت به اون‌ها داده بشه پذیرفتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 430.61,
   "end": 436.45,
   "text": "این رو خب امام عسکری سلام الله علیه هم داشتن اما قصه غیبت خیلی پیچیده‌تر از این‌ها بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 436.45,
   "end": 441.07,
   "text": "امام سه تا غیبت کردن و ما الان در دوران سه غیبت هستیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 441.07,
   "end": 446.11,
   "text": "غیبت باید به خوبی تبیین بشه و جز قلب سلیم نمی‌پذیره این‌ها رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 446.11,
   "end": 450.47,
   "text": "و شما باید از یک جهت البته وجوهی دارد، از یک جهت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 450.47,
   "end": 453.81,
   "text": "ماها باید شاکر باشیم، سر به سجده بگذاریم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 453.81,
   "end": 456.13,
   "text": "که خدا این امتحان را از ما گرفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 456.13,
   "end": 460.29,
   "text": "ما الحمد لله حداقل تو بعضی از وجوهش پیروز بیرون اومدیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 460.29,
   "end": 462.79,
   "text": "و این سلامت قلب ماها رو می‌رسونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 462.79,
   "end": 471.67,
   "text": "چرا شاکر نباشیم؟ اینکه حضرت امام می‌فرمود شما قسم یاد می‌کنم که از مردم حجاز و حتی زمان امام حسن و امام حسین،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 471.67,
   "end": 474.49,
   "text": "حضرت امام می‌فرمود شما مردم بهترید همینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 474.49,
   "end": 478.93,
   "text": "این سلامت قلب اینجا خودش رو نشون داده که سه تا غیبت، یکی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 478.93,
   "end": 484.99,
   "text": "جسم امام غایب شده، یکی کلمة الغیب یعنی اون معارف، اون حقایقی که غائب‌اند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 484.99,
   "end": 487.97,
   "text": "از فهم و از درک و از آگاهی ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 487.97,
   "end": 491.97,
   "text": "بسیاری از معارف دین. أینهم هی معالم الدين.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 491.97,
   "end": 496.37,
   "text": "این کلمه‌ی غیب یعنی ح-حقیقت اون معارف.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 496.37,
   "end": 499.55,
   "text": "شما تو آ-آیات اولیه سوره بقره هم می‌خونید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 499.55,
   "end": 502.03,
   "text": "الذين يؤمنون بالغيب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 502.03,
   "end": 505.27,
   "text": "این دل میدن به غیب، به غیب، به اون معارف.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 505.27,
   "end": 508.01,
   "text": "غیب همون معارفیه که تو سینه آقاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 508.01,
   "end": 512.11,
   "text": "جسم حضرت غائبه، معارف از دست ما به دوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 512.11,
   "end": 516.69,
   "text": "سه، غیبت خود اصل ولایت که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 516.69,
   "end": 521.61,
   "text": "پرده و ليلة اذا یغشى یک پرده و غشایی از ظلمت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 521.61,
   "end": 525.11,
   "text": "سرتاسر دنیا روی ولایت رو گرفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 525.11,
   "end": 529.69,
   "text": "ولایت اهل بیت بسیار، بسیار غریب واقع شده است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 529.69,
   "end": 533.11,
   "text": "طرد و شرید و فرید و وحید که خود حضرت هست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 533.11,
   "end": 536.63,
   "text": "طرد شده است، آواره است. اما شیعیان پذیرفتن اینو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 536.63,
   "end": 543.81,
   "text": "این خیلی مهمه. تا قلبی تسلیم امامت و ولایت اون‌ها نباشه نمی‌تونه به این جایگاه برسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 543.81,
   "end": 547.39,
   "text": "این رو باید شکرگزار بود. باید شاکر باشیم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 547.39,
   "end": 550.57,
   "text": "تونستیم حداقل توی این امتحانات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 550.57,
   "end": 552.15,
   "text": "خداروشکر خودمون رو حفظ کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 552.15,
   "end": 556.83,
   "text": "حالا امتحانات بعدی باید مراقب باشیم که به کجا میریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 556.83,
   "end": 560.49,
   "text": "پس وقتی امام عسک-- در زمان امام هادی و امام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 560.49,
   "end": 563.71,
   "text": "عسکری ارتباطات بین امام و شیعیان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 563.71,
   "end": 572.69,
   "text": "غالباً از طریق وکلا و نواب اتفاق می‌افتاد و امام عصر هم وقتی به محض اینکه امام عسکری سلام الله علیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 572.69,
   "end": 578.25,
   "text": "به شهادت رسید، قصه غیبت شروع شد و اون امتحان عظیم الهی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 578.25,
   "end": 585.51,
   "text": "در کنار اینکه یک بچه‌ی پنج شش ساله امام می‌شه که قبلاً هم امتحان پس داده بودن اما شروع غیبت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 585.51,
   "end": 589.85,
   "text": "خب این کار هر کسی نیست. پذیرفتن امام غایب از نظر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 589.85,
   "end": 594.23,
   "text": "امامی که ما از دست اینکه الان بعضی‌ها توی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 594.23,
   "end": 596.69,
   "text": "همین انقلاب ما،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 596.69,
   "end": 605.13,
   "text": "اینا رو دقت داشته باشید ظرائف رو، یه دفعه از قطار انقلاب پیاده می‌شن به جهت کهولت سنشون نمی‌تونن بپذیرن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 605.13,
   "end": 610.19,
   "text": "از اینکه یکی مثلاً رهبر انقلاب از اینا بچه‌تره، سنش کمتر بوده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 610.19,
   "end": 615.87,
   "text": "ولی به مقامات عالی معرفتی و معنوی رسیده، شده ولی‌امر Muslims نمی‌تونه برتابه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 615.87,
   "end": 618.15,
   "text": "نمی‌تونه. این کار هر کسی نیست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 618.15,
   "end": 621.95,
   "text": "و معمولاً تو سن بالا این خودش رو نشون می‌ده، این تسلیم بودن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 621.95,
   "end": 623.67,
   "text": "جوون‌ها زود تسلیم می‌شن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 623.67,
   "end": 625.73,
   "text": "سلیم القلب‌اند زود تسلیم می‌شن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 625.73,
   "end": 629.67,
   "text": "اما یه ذره سن میره بالا، اِ من بیام از یه بچه تبعیت کنم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 629.67,
   "end": 632.97,
   "text": "سر می‌خوره. یا بعضیا دیگه به جایی می‌رسن که کو؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 632.97,
   "end": 634.95,
   "text": "اگه واقعاً آقا بود اومده بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 634.95,
   "end": 639.17,
   "text": "این همه ظلم، این همه خیانت، این همه فلان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 639.17,
   "end": 643.65,
   "text": "این پیداست که امتحان، امتحان بسیار سنگینیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 643.65,
   "end": 648.11,
   "text": "شاید ما تو دوره‌ی توقر الون قرار گرفتیم و باید مراقب باشیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 648.11,
   "end": 653.63,
   "text": "که بعد وقتی حضرت سلام الله علیه غیبت می‌کنند بلافاصله بعد شهادت امام عسکری،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 653.63,
   "end": 655.81,
   "text": "اولین نائب ایشون هم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 655.81,
   "end": 660.31,
   "text": "عثمان بن سعید ثمان معروفه به روغن فروش از طریق روغن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 660.31,
   "end": 662.45,
   "text": "اینور اونور کردن نامه‌ها و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 662.45,
   "end": 665.35,
   "text": "این‌ها رو از جهت اقتصادی، سیاسی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 665.35,
   "end": 670.35,
   "text": "حتی اعتقادی اِاِ ارتباط بین حضرت و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 670.35,
   "end": 676.97,
   "text": "دیگران رو برگ-برقرار کرده بود تا هفتاد سال تقریباً غیبت کبرا چهار تا نائب و دیگه تمام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 676.97,
   "end": 681.61,
   "text": "امام نامه زد که دیگه سلسله نیابت خاص تمام شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 681.61,
   "end": 688.41,
   "text": "دیگه بعد از اون ورود به اون قسمت ظلمت سرای تاریخ که غیبت کلیه است،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 688.41,
   "end": 691.97,
   "text": "این ما توی اون دالون تاریخ قرار گرفتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 691.97,
   "end": 695.23,
   "text": "در عین حال از نور ولایت داریم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 695.23,
   "end": 698.03,
   "text": "ارتزاق می‌کنیم. این خیلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 698.03,
   "end": 703.95,
   "text": "لطف بزرگیست و امتحان بزرگیست که از ما گرفته شده و هر روز ما صبح که از خواب پا می‌شیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 703.95,
   "end": 708.81,
   "text": "شب که سر به زمین و بستر خواب می‌گذاریم در این امتحان قرار گرفتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 708.81,
   "end": 711.23,
   "text": "اگر صبح پا می‌شیم حواسمون به امام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 711.23,
   "end": 720.51,
   "text": "زمان هست و شب که می‌خوابیم توس-توجهمون به امام عصر هست، یعنی تسلیم امام بودن و قبول شدن تو این امتحان بزرگ.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 720.51,
   "end": 723.45,
   "text": "خیلی باید شاکر باشیم. همین رو خواستم عرض کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 723.45,
   "end": 728.25,
   "text": "انشاالله که عاقبتمون ختم بخیر بشه به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 728.25,
   "end": 735.77,
   "text": "اللهم صل على محمد و آل محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}