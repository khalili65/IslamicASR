 "chapters": [
  {
   "index": 0,
   "title": "## وام بانکی و تصرف پس از قرض ربوی",
   "start": 1.36,
   "end": 22.04
  },
  {
   "index": 1,
   "title": "## ابراهیم از شیعهٔ نوح؛ قلب سلیم",
   "start": 22.04,
   "end": 77.56
  },
  {
   "index": 2,
   "title": "## عهدنامهٔ زیارت اربعین",
   "start": 77.56,
   "end": 467.53
  },
  {
   "index": 3,
   "title": "## قلب؛ محیط تعلقات",
   "start": 467.53,
   "end": 581.07
  },
  {
   "index": 4,
   "title": "## ضحاک مشرقی و طرماح",
   "start": 581.07,
   "end": 624.09
  },
  {
   "index": 5,
   "title": "## ضحاک و طرماح؛ اسب روز مبادا",
   "start": 624.09,
   "end": 805.67
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 1.36,
   "end": 5.86,
   "text": "بسم الله الرحمن الرحیم و بهی نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 5.86,
   "end": 9.36,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 9.36,
   "end": 13.76,
   "text": "آیاته سلامٌ علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 13.76,
   "end": 17.06,
   "text": "استفتاء شده از رهبر عزیزمون که خب حالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 17.06,
   "end": 19.88,
   "text": "وام یا قرضی که شما فرمودید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 19.88,
   "end": 27.08,
   "text": "تمام بانک‌ها بهشون ابلاغ شده از بانک مرکزی دستورالعملی که زیر نظر شورای نگهبان هست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 27.08,
   "end": 29.72,
   "text": "و همه موظف‌اند به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 29.72,
   "end": 31.94,
   "text": "دادن وام و قرض",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 31.94,
   "end": 36.72,
   "text": "غیر ربوی و یعنی اسلامی بر اساس عقود اسلامی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 36.72,
   "end": 39.42,
   "text": "خب این اصل گرفتن وام که اشکالی نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 39.42,
   "end": 46.06,
   "text": "اما حالا اومدیم و یه بانکی تخطی کرد و قرض ربوی داد، وام ربوی، ربوی داد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 46.06,
   "end": 49.0,
   "text": "اون کسی هم که گرفت این وام رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 49.0,
   "end": 53.4,
   "text": "متوجه شد یا از اول یا بعداً متوجه شد که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 53.4,
   "end": 55.78,
   "text": "این بر اساس عقود اسلامی نبوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 55.78,
   "end": 58.92,
   "text": "حالا این قرض ربویه. چه کنه با این پول؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 58.92,
   "end": 62.84,
   "text": "آیا این پولو می‌تونه درش تصرف کنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 62.84,
   "end": 69.04,
   "text": "می‌تونه از، از مثلاً باهاش خونه خرید، می‌تونه تو اون خونه نماز بخونه، وضو بگیره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 69.04,
   "end": 72.32,
   "text": "رهبری فرمودن بله، اگرچه اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 72.32,
   "end": 75.12,
   "text": "گرفتن اصل اون وام مثلاً حرام بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 75.12,
   "end": 77.56,
   "text": "گرفتن اون وام حرام بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 77.56,
   "end": 85.34,
   "text": "اگر بر اساس عقود اسلامی نبوده و قرض ربوی حساب می‌شده، گرفتن اون وام حرام بوده، این فعل حرام بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 85.34,
   "end": 91.06,
   "text": "اما حالا که گرفته این پول رو می‌تونه مالکش بشه و درش تصرف کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 91.06,
   "end": 95.22,
   "text": "و باهاش هر کاری می‌کنه حتی خونه هم بخره و این‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 95.22,
   "end": 100.44,
   "text": "و در اون خونه می‌تونه تصرف کنه، توش می‌تونه نماز بخونه، اشکالی هم نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 100.44,
   "end": 104.8,
   "text": "اما در خصوص قلب سلیم یکی دیگه از آیاتی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 104.8,
   "end": 112.04,
   "text": "پیرو قلب سلیم هست، آیات هشتاد و سه و هشتاد و چهار سوره صافات رو اگر دقت بفرمایید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 112.04,
   "end": 117.04,
   "text": "می‌فرماید که و ان من شیئته لإبراهیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 117.04,
   "end": 119.58,
   "text": "یکی از شیعیان او",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 119.58,
   "end": 123.9,
   "text": "قطعاً حضرت ابراهیم بوده علیه الصلاة والسلام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 123.9,
   "end": 126.26,
   "text": "ارجا رب بهو بقلب سلیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 126.26,
   "end": 128.94,
   "text": "وقتی که وارد شد به پروردگارش، کی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 128.94,
   "end": 132.2,
   "text": "حضرت ابراهیم با قلب سلیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 132.2,
   "end": 137.82,
   "text": "اینجا حالا نکات بسیار زیادی رو مفسرین من بررسی کردم آوردن که حالا تا اونجایی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 137.82,
   "end": 141.98,
   "text": "حوصله داشته باشیم و بعضاً به بحثمون بر بخوره عرض می‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 141.98,
   "end": 150.2,
   "text": "اولاً این شیئته این های ضمیر شیئته بر می‌گرده ظاهراً به حضرت نوح",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 150.2,
   "end": 154.42,
   "text": "که چون قبلش داستان حضرت نوح رو می‌گه بعد می‌گه ابراهیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 154.42,
   "end": 156.88,
   "text": "علیهم الصلاة والسلام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 156.88,
   "end": 159.22,
   "text": "شیعه او بود، یعنی پیرو او بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 159.22,
   "end": 161.98,
   "text": "دینش بعد از دین او بود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 161.98,
   "end": 166.94,
   "text": "و این نشون می‌ده که بعد منزل نباید، نباید در سفر روحانی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 166.94,
   "end": 171.44,
   "text": "درسته هزاران سال بین ابراهیم و نوح علیهم السلام فاصله بود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 171.44,
   "end": 173.58,
   "text": "اما پیرو هم-- یعنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 173.58,
   "end": 176.74,
   "text": "د-دین همدیگه رو کامل کردن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 176.74,
   "end": 179.16,
   "text": "و همچنین الان کسی نمی‌تونه بگه آقا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 179.16,
   "end": 184.06,
   "text": "ما دستمون از امام کوتاهه، مثلاً امام ما از امام دوریم و پس فلان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 184.06,
   "end": 188.0,
   "text": "نخیر، بعد منزل نباید در سفر روحانی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 188.0,
   "end": 192.04,
   "text": "قواعد و دستورات کاملاً مشخصه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 192.04,
   "end": 194.7,
   "text": "اما در تفاسیر و تعاویل ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 194.7,
   "end": 201.42,
   "text": "که اهل بیت علیهم الصلاة والسلام مشخص کردن فرمودن این شیعه باطن این آیه بر می‌گرده به امیرالمؤمنین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 201.42,
   "end": 204.54,
   "text": "علیه الصلاة والسلام و در حقیقت ابراهیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 204.54,
   "end": 210.62,
   "text": "حضرت ابراهیم هم شیعه امیرالمؤمنین علیه الصلاة والسلام حساب می‌شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 210.62,
   "end": 217.66,
   "text": "و حالا اینکه کلمه شیعه هم اینجا به کار برده شده جواب اون‌هاییه که می‌گن شیعه رو خود شیعه‌ها ساختن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 217.66,
   "end": 220.5,
   "text": "اصلاً کلمه شیعه وجود نداشته و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 220.5,
   "end": 224.88,
   "text": "در حالی که می‌بینید تو قرآن به راحتی اومده و شیعه یعنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 224.88,
   "end": 227.46,
   "text": "تو تفسیر نور آقای قرائتی می‌فرماید یعنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 227.46,
   "end": 230.22,
   "text": "جمعی که پیرو رئیسشون باشن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 230.22,
   "end": 236.48,
   "text": "تابع رئیسشون باشن، دنبال راه رئیسشون باشن به این می‌گن، می‌گن شیعه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 236.48,
   "end": 239.0,
   "text": "در حقیقت شاع",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 239.0,
   "end": 242.12,
   "text": "یعنی شیعه، حالا یه معناش پرتو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 242.12,
   "end": 245.94,
   "text": "نور خورشید و شمس وجود اهل بیته، شعاع نور اون‌هاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 245.94,
   "end": 252.56,
   "text": "تو یه روایت اومده. یه معناش مشایعت کردن یعنی پشت سر و دنبال رو امام حرکت کردنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 252.56,
   "end": 254.88,
   "text": "واللازم لكم لاحق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 254.88,
   "end": 261.7,
   "text": "حالا کاری به این معنا نداریم. در هر حال اینجا نشون می‌ده وظیفه شیعه اینه که پشت سر امامش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 261.7,
   "end": 265.66,
   "text": "با قلب سلیم حرکت کنه و به خدا وارد بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 265.66,
   "end": 267.98,
   "text": "توجه کردید این‌ها با، اینجا با",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 267.98,
   "end": 270.26,
   "text": "یه لطایف الال خاصی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 270.26,
   "end": 274.56,
   "text": "خدا داره وظیفه شیعه رو در عمی-عملیات بندگی‌ش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 274.56,
   "end": 279.78,
   "text": "و بازگشتش به سوی خدا معرفی می‌کنه که اولاً پیرو امامش باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 279.78,
   "end": 284.8,
   "text": "ثانیاً ارجا رب بهو بقلب سلیم وارد بشه به خداش با قلب سلیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 284.8,
   "end": 290.94,
   "text": "و این می‌شه گفت نهایت عملیات بندگی یک بچه شیعه است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 290.94,
   "end": 297.68,
   "text": "که اگر شما به هر حال غالبتون از زیارت اربعین برگشتید دقت داشته باشید به زیارت اربعین،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 297.68,
   "end": 301.96,
   "text": "اون انتهای زیارت که فرودگاه زیارت هم حساب می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 301.96,
   "end": 306.04,
   "text": "بعد از اینکه معاهده ابا عبدالله الحسین سلام الله علیه با",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 306.04,
   "end": 311.4,
   "text": "خدا رو بررسی می‌کنی که همه رو اهلی ب-ابی عبدالله الحسین جامع عمل پوشوند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 311.4,
   "end": 316.92,
   "text": "و به عهدنامه‌ش وفای کامل کرد که بحث مفصلی داره خودش که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 316.92,
   "end": 321.84,
   "text": "و بدل محجته فیک لیستن و عبادک من الجهاله و حیره و ضلاله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 321.84,
   "end": 325.08,
   "text": "اینو ابی عبدالله به منس زووکشون به تمام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 325.08,
   "end": 327.52,
   "text": "وجه. بعد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 327.52,
   "end": 331.62,
   "text": "وظایف خودمون و عهدنامه خودمون رو بررسی می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 331.62,
   "end": 337.3,
   "text": "از اونجایی که عرض می‌کنیم و اشهد انی از اینجا شروع می‌شه عهدنامه ما نسبت به اماممون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 337.3,
   "end": 340.42,
   "text": "کسایی که اربعین رفتن، اومدن این عهدنامه رو باید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 340.42,
   "end": 344.18,
   "text": "روز اربعین چیکار می‌کردن؟ مهر می‌زدن و برمی‌گشتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 344.18,
   "end": 346.8,
   "text": "و اشهد انی بکن مؤمن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 346.8,
   "end": 349.28,
   "text": "من دل به شما دادم. همین‌طوری نیومدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 349.28,
   "end": 352.02,
   "text": "دلدادگی منو کشونده اینجا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 352.02,
   "end": 354.32,
   "text": "و بهیا بکن موقن. من",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 354.32,
   "end": 360.28,
   "text": "یقین کامل دارم که این قصه تمام نشده بلکه ادامه داره و شما بر خواهید گشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 360.28,
   "end": 364.46,
   "text": "جالبه بش- بلافاصله می‌گیم به شرایع دینی و خواتیم عملی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 364.46,
   "end": 367.39,
   "text": "اصلاً این قصه برگشتن شما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 367.39,
   "end": 372.57,
   "text": "انتظار ظهور و رجعت شما تو تمام شرائط دینی ما کشیده شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 372.57,
   "end": 375.09,
   "text": "یعنی من اصلا نمازو می‌خونم به این امید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 375.09,
   "end": 379.37,
   "text": "که اقامه نماز تو یه روزی در این زمین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 379.37,
   "end": 382.91,
   "text": "پیدا بشه یعنی اقامه بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 382.91,
   "end": 385.35,
   "text": "ظهور تو یعنی ظهور نماز کامل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 385.35,
   "end": 387.21,
   "text": "ظهور حج کامل. حج",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 387.21,
   "end": 394.33,
   "text": "و من این شرائط رو به همین امید ببینید بلافاصله بعد و \"بِإِيَابِكُمْ مُوقِنٌ\" میگه به شرائط دینی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 394.33,
   "end": 397.57,
   "text": "من با همه شریعت، شریعت دینم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 397.57,
   "end": 400.67,
   "text": "من یقین کامل دارم به رجعت تو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 400.67,
   "end": 404.47,
   "text": "بعد تازه همینجا تمومش نمی‌کنی و خواصم عملی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 404.47,
   "end": 408.93,
   "text": "یعنی من امید دارم که ختم همه اعمال من",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 408.93,
   "end": 412.69,
   "text": "به رجعت و برگشتن و ظهور شما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 412.69,
   "end": 414.89,
   "text": "منتج بشه. ببینید چقدر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 414.89,
   "end": 416.67,
   "text": "دقت میخواد این عبارات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 416.67,
   "end": 418.45,
   "text": "حالا من اینا رو نمی‌خوام توضیح بدم ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 418.45,
   "end": 421.81,
   "text": "بلافاصله اینجا رو میخوام توقف کنیم \"وَقَلْبِي",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 421.81,
   "end": 425.01,
   "text": "لِقَلْبِكُمْ سَلْمٌ\". این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 425.01,
   "end": 427.63,
   "text": "همونجاست که ما نقطه‌ایست که داریم می‌زنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 427.63,
   "end": 431.17,
   "text": "میگه قلب من یکی از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 431.17,
   "end": 434.85,
   "text": "معاهده‌ای که اونجا ما امضا زدیم برگشتیم اینه که قلب من",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 434.85,
   "end": 439.57,
   "text": "پشت سر قلب شما باشه و به سلامت کامل همون قلب سلیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 439.57,
   "end": 443.37,
   "text": "و تسلیم امر شد. جالبه که میگه قلب من تسلیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 443.37,
   "end": 446.51,
   "text": "قلب شما باشه. ببینید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 446.51,
   "end": 452.31,
   "text": "این نکته رو توجه بکنید. حالا بقیش بماند بعدها که حالا امری بقیه این معاهده زیاده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 452.31,
   "end": 457.01,
   "text": "\"أَمْرِي لِأَمْرِكُمْ مُتَّبَعٌ وَنُصْرَتِي لَكُمْ مُعَدَّةٌ حَتَّىٰ يَعْذَرَ اللَّهُ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 457.01,
   "end": 461.41,
   "text": "لَكُمْ فَمَعَكُمْ مَعَكُمْ لا مَعَ عَدُوِّكُمْ\" اینا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 461.41,
   "end": 463.99,
   "text": "برید ببینید. منتها این تیکه رو دقت کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 463.99,
   "end": 467.53,
   "text": "یه نکته خیلی ظریفی رو من عرض کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 467.53,
   "end": 470.17,
   "text": "قلب محیط",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 470.17,
   "end": 480.43,
   "text": "تعلقات انسانه و معمولا کارهایی که ما می‌کنیم بر اساس تعلقات و القه‌ها و علاقه‌هامونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 480.43,
   "end": 483.69,
   "text": "که معمولا کار قلب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 483.69,
   "end": 485.43,
   "text": "بر محور تعلقاته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 485.43,
   "end": 490.69,
   "text": "یعنی انسان کاری رو می‌کنه که تو دلش به اون علاقه‌منده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 490.69,
   "end": 496.23,
   "text": "معمولا اینطوریه. یعنی غالبا به این شکله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 496.23,
   "end": 499.27,
   "text": "وقتی میگه \"قَلْبِكُمْ لِقَلْبِكُمْ سَلْمٌ\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 499.27,
   "end": 504.15,
   "text": "یعنی تمام تعلقات درونی و قلبی من",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 504.15,
   "end": 510.35,
   "text": "بر اساس تعلقات و القه و علاقه‌ها و عقدها و گره‌های شماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 510.35,
   "end": 514.77,
   "text": "یعنی هرجا، هرجا که دل شما گره خورده، عقد از گره میاد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 514.77,
   "end": 517.83,
   "text": "همونجا هم دل من گره خورده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 517.83,
   "end": 521.63,
   "text": "یعنی اینطور نیست که من یه گناهو دوست داشته باشم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 521.63,
   "end": 524.79,
   "text": "اما چون تو بدت میاد ترکش کنم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 524.79,
   "end": 531.61,
   "text": "حوزه تعلقاته. یعنی اگر تو تعلقی به اون نداری، القه و علاقه‌ای به اون نداری، منم ندارم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 531.61,
   "end": 534.71,
   "text": "منم علاقه ندارم. منم بدم میاد اصلا از گناهم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 534.71,
   "end": 538.05,
   "text": "نه اینکه خوشم میادا به خاطر تو ترک می‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 538.05,
   "end": 542.11,
   "text": "این اصلا شیعیگی نیست که. ببینید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 542.11,
   "end": 545.91,
   "text": "توجه داشته باشید. ببینید چه نکاتی داخل این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 545.91,
   "end": 549.81,
   "text": "همین زیارت‌نامه که راحت ما خوندیم و اومدیم هست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 549.81,
   "end": 553.19,
   "text": "که به نظر حقیر رمز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 553.19,
   "end": 555.31,
   "text": "یعنی میشه گفت کلیدواژه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 555.31,
   "end": 557.95,
   "text": "الحاق و ملحق شدن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 557.95,
   "end": 565.01,
   "text": "اون‌هایی که حتی یه زمانی آدمای خوبی نبودن اما ملحق به ابی عبدالله شدن مثل حر مثل زهیر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 565.01,
   "end": 569.53,
   "text": "همینه که یک آن تعلقاتشون رو برگردوندن به تعلقات امامشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 569.53,
   "end": 574.03,
   "text": "حاضر نشدن چیزی رو در دلشون نگه دارن که امام دوست نداره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 574.03,
   "end": 578.81,
   "text": "کندن. ولی حبیب‌ها از اول این کارو کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 578.81,
   "end": 585.53,
   "text": "حبیب و مسلم نو-- ابی عبدالله بچه بود تو کوچه راه میرفت حبیب و مسلم صورت میذاشتن رو خاک پای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 585.53,
   "end": 587.75,
   "text": "ابی عبدالله پنج شش ساله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 587.75,
   "end": 592.29,
   "text": "تو روایات اومده که پیغمبر گریه می‌کرد می‌گفت این‌ها یه روزی جون میدن در راه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 592.29,
   "end": 595.93,
   "text": "حسین من که از الان اینطور حسین سلام الله علیه رو دوست دارن از بچگی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 595.93,
   "end": 599.71,
   "text": "ولی بعضیا هم یه دفعه کندن و رمز و کلیدواژه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 599.71,
   "end": 605.43,
   "text": "کنده شدن از امام و جدا شدن از امام هم همین تعلقاته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 605.43,
   "end": 609.89,
   "text": "ببینید ما دائما با تعلقاتمون انتخابات زندگیمون رو انجام میدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 609.89,
   "end": 613.69,
   "text": "این حرفو بزنم یا نه؟ می‌بینم قلبم با اون همراهه یا نه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 613.69,
   "end": 616.47,
   "text": "اصلا برای من این چیز مهم هست یا نه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 616.47,
   "end": 618.49,
   "text": "جزو القه‌های وجودیم هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 618.49,
   "end": 623.07,
   "text": "منو دعوت می‌کنن یه جا. اول چیزی که بهش فکر می‌کنم چیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 623.07,
   "end": 624.71,
   "text": "که قبول می‌کنم یا رد می‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 624.71,
   "end": 628.31,
   "text": "اگه معروفیت برام مهم باشه، می‌پرسم چند نفرید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 628.31,
   "end": 631.55,
   "text": "هیئتتون معروفه یا نه؟ پاکتش چاق و چله‌ست یا نه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 631.55,
   "end": 637.43,
   "text": "چه می‌دونم این چیزا. اگر ببینم منافات داره با القه‌های وجودی من رد می‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 637.43,
   "end": 640.53,
   "text": "اما نه اگر هدفم چیز دیگه‌ایه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 640.53,
   "end": 644.47,
   "text": "قبول می‌کنم. ببینین این‌ها اینکه یکی مثل زهاک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 644.47,
   "end": 648.03,
   "text": "همین زهاک مشرقی درستش که میگن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 648.03,
   "end": 650.79,
   "text": "غروب عصر عاشورا امام حسین رو ول کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 650.79,
   "end": 653.71,
   "text": "اینو دیگه همه شنیدید. خدایی چرا ول کرد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 653.71,
   "end": 660.37,
   "text": "مگه نبود تا عصر عاشورا؟ به امام حسین گفت من گمانم این بود که شما پیروز میشی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 660.37,
   "end": 662.17,
   "text": "و ما به نون نوایی می‌رسیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 662.17,
   "end": 664.47,
   "text": "دیدم نه قصه عوض شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 664.47,
   "end": 668.89,
   "text": "حضرت فرمود من که گفتم آخر کاروان به شهادته پاشو برو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 668.89,
   "end": 673.57,
   "text": "گفت بعد ابی عبدالله اومد اسبش بده گفت نمی‌خوام من از قبل برای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 673.57,
   "end": 678.57,
   "text": "مبادا اسبی رو پشت خیمه‌ها به یه نخلی بستم از قبل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 678.57,
   "end": 683.73,
   "text": "که این اسب‌ها تو قلب امثال من از قبل بسته شده برای روز مبادا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 683.73,
   "end": 689.49,
   "text": "همون القه‌هاست که تعارض می‌کنه با القه‌های امام ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 689.49,
   "end": 692.03,
   "text": "امام خواست بشه. رفت اسب رو سوار شده رفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 692.03,
   "end": 695.93,
   "text": "امام حسین رو ول کرد. بعدم توب--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 695.93,
   "end": 698.55,
   "text": "فهمید که غلط کرده‌ها. میگن خیلی هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 698.55,
   "end": 703.71,
   "text": "گریه می‌کرد. چه فایده؟ یا طرماح که از شاعر خوب علوی بود اونم همینطور.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 703.71,
   "end": 707.15,
   "text": "بار و بنه شو گ-- اون موقع آذوقه یه ساله تهیه می‌کردن دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 707.15,
   "end": 709.47,
   "text": "آذوقه یه سالشو تهیه کرده بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 709.47,
   "end": 712.87,
   "text": "داشت می‌رفت تو راه برخورد به امام حسین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 712.87,
   "end": 718.25,
   "text": "گفت آقا من می‌خوام همراه شما-- بیا اول پیشنهاد داد بیا بریم یمن ده هزار مرد جنگی برات به صف کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 718.25,
   "end": 720.61,
   "text": "حضرت فرمودن میرم به سمت رضای خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 720.61,
   "end": 723.25,
   "text": "تو میای با ما یا نه؟ گفت اجازه میدید برم این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 723.25,
   "end": 726.43,
   "text": "بار و بنه رو آذوقه خ-- زن و بچه‌ام رو برسونم بیام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 726.43,
   "end": 728.67,
   "text": "بیا وداع با زن و بچه‌ام بکنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 728.67,
   "end": 731.93,
   "text": "حضرت فرمود خود دانی. نه گفت برو، نه گفت بیا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 731.93,
   "end": 735.21,
   "text": "ببینید این القه‌ایه که تعارض می‌کنه با علاقه امام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 735.21,
   "end": 737.83,
   "text": "القه چی؟ زن و بچه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 737.83,
   "end": 740.11,
   "text": "تمام. تعارض کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 740.11,
   "end": 743.19,
   "text": "ول کرد رفت. برگشت اما تمام شده بود قصه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 743.19,
   "end": 746.81,
   "text": "سرها رو نیزه بود. مثلا جنگید، مجروح شد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 746.81,
   "end": 750.81,
   "text": "بی‌هوش افتاد بین شهدا نصف شب بیدار شد دید بغل جون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 750.81,
   "end": 753.55,
   "text": "بی‌سر نور از بدن جون زده بالا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 753.55,
   "end": 756.63,
   "text": "داستانی داره. تا آخر عمرش گریه می‌کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 756.63,
   "end": 759.61,
   "text": "از شعرای امام حسینه. اما چه فایده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 759.61,
   "end": 764.65,
   "text": "ببین یک آن اگر تعلقات ما \"قَلْبِي لِقَلْبِكُمْ سَلْمٌ\" یعنی این.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 764.65,
   "end": 766.59,
   "text": "من در تسلیم کامل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 766.59,
   "end": 769.43,
   "text": "قلب شمام. اگر تعلق ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 769.43,
   "end": 772.89,
   "text": "تعارض کنه، این وزن‌کشی‌های قلبی من",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 772.89,
   "end": 775.15,
   "text": "که وزن می‌کنم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 775.15,
   "end": 780.11,
   "text": "میزان می‌کنم این کارو که آیا با القه من سازگاری داره یا نه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 780.11,
   "end": 784.73,
   "text": "اگر تشخیص بدم که سر سوزنی با القه امام عصر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 784.73,
   "end": 786.43,
   "text": "سازگاری نداره باید رها کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 786.43,
   "end": 789.47,
   "text": "به این میگن تسلیم. اگر رها نکنی یعنی چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 789.47,
   "end": 791.09,
   "text": "جدا شدن از، از امام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 791.09,
   "end": 794.09,
   "text": "حالا امروز نه فردا. نه لب مرگ.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 794.09,
   "end": 805.67,
   "text": "ان‌شاءالله عاقبتمون ختم بخیر بشه به برکت صلوات بر محمد و آل محمد. یا مصطفى محمد آله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}