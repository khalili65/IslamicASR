 "chapters": [
  {
   "index": 0,
   "title": "## وام مسکن و قرض موقت به دیگری",
   "start": 12.8,
   "end": 217.56
  },
  {
   "index": 1,
   "title": "## وای بر آنکه پیش از خودسازی محل رجوع شود",
   "start": 217.56,
   "end": 253.48
  },
  {
   "index": 2,
   "title": "## توحید ابراهیم در شعراء؛ پرچم هدایت پس از سلامت دل",
   "start": 253.48,
   "end": 595.22
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 1.76,
   "end": 5.86,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 5.86,
   "end": 10.16,
   "text": "السلام علیک یا داعی الله و ربانی آیاته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 10.16,
   "end": 12.8,
   "text": "السلام علیکم و رحمه الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 12.8,
   "end": 20.78,
   "text": "از رهبر عزیزمون سؤال شده که اگر خب حالا این حکم کلیه که اگر هر وامی رو به هر منظوری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 20.78,
   "end": 24.78,
   "text": "از هر بانک و مؤسسه‌ای بگیری باید تو همون هزینه بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 24.78,
   "end": 28.86,
   "text": "تو همون موضوع خاص مثلا برای مسکن اگه وام می‌گیری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 28.86,
   "end": 33.78,
   "text": "باید حتما اون وامی که گرفتی تو مسکن هزینه بشه، نه جا دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 33.78,
   "end": 38.14,
   "text": "شرعا اشکال داره. حالا سؤال اینه که اگر ما این وام رو گرفتیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 38.14,
   "end": 41.02,
   "text": "یه کسی گفت به ما قرض بده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 41.02,
   "end": 47.06,
   "text": "ما می‌تونیم این پول رو فعلاً به اون قرض بدیم بعد برگردونیم تو اون مورد خاص هزینه‌ش کنیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 47.06,
   "end": 51.0,
   "text": "رهبر فرمودن اشکال نداره به شرط اینکه پول برگشت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 51.0,
   "end": 54.44,
   "text": "پول رو پس گرفتی تو همون مورد خاص که براش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 54.44,
   "end": 57.9,
   "text": "وام گرفتی حتما هزینه بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 57.9,
   "end": 65.76,
   "text": "در خصوص قلب سلیم نکته‌ی دیگه‌ای که به‌هرحال جا مونده این رو هم عرض کنیم به موقع خودش خیلی مهمه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 65.76,
   "end": 68.98,
   "text": "و دیگه بحثش رو جمع کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 68.98,
   "end": 71.06,
   "text": "اگر دقت کرده باشین عزیزان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 71.06,
   "end": 77.78,
   "text": "توی ای-آیاتی که در مورد حضرت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 77.78,
   "end": 84.06,
   "text": "ابراهیم علی نبینا و آله و علیه الصلاة والسلام وقتی صحبت به میان میاد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 84.06,
   "end": 87.68,
   "text": "و معمولا تو قرآن قلب سلیم رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 87.68,
   "end": 89.6,
   "text": "در مورد حضرت ابراهیم بیان کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 89.6,
   "end": 95.46,
   "text": "دو جا که حالا یکی سوره صافات هست و یکی سوره شعراء که ما قبلاً آیاتشو برام کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 95.46,
   "end": 98.54,
   "text": "اگر به آیات قبل و بعدش دقت کنید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 98.54,
   "end": 101.42,
   "text": "مثلا در سوره صافات،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 101.42,
   "end": 109.34,
   "text": "آیه‌ی هشتاد و سه و هشتاد و چهار که صراحتا می‌فرماید \"وإن من شيعته لإبراهيم\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 109.34,
   "end": 114.26,
   "text": "شیعه نوح تو قرآن که البته تأویلش بر می‌گرده به امیرالمؤمنین عرض کردیم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 114.26,
   "end": 117.42,
   "text": "شیعه امیرالمؤمنین یکیش حضرت ابراهیم هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 117.42,
   "end": 120.14,
   "text": "\"إذ جاء ربه بقلب سليم\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 120.14,
   "end": 123.16,
   "text": "وقتی که به سمت پروردگارش اومد با قلب سلیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 123.16,
   "end": 128.96,
   "text": "اینجا یه نکته‌ای هست که بلافاصله می‌فرماید \"إذ قال\" هنگامی که گفت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 128.96,
   "end": 131.2,
   "text": "کی؟ حضرت ابراهیم. به کی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 131.2,
   "end": 134.78,
   "text": "لأبيه. این لأبيه قرآن که آورده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 134.78,
   "end": 137.8,
   "text": "منظورش عموی حضرت ابراهیم است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 137.8,
   "end": 140.56,
   "text": "آذر نامی بوده، عموی ایشون بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 140.56,
   "end": 143.78,
   "text": "ایشون به احترام پدر صداش می‌کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 143.78,
   "end": 149.28,
   "text": "لکن اینجا می‌فرماید \"إذ قال لأبيه وقومه ما هذا تعبدون\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 149.28,
   "end": 158.18,
   "text": "حضرت ابراهیم رو می‌کنه به عموشون که اینجا پدر نامبرده شده ازش و قومش که چرا شما بت می‌پرستید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 158.18,
   "end": 163.66,
   "text": "نکته‌ی ظریفی اینجا هست اونم این که میگه ابراهیمی که میره تو دل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 163.66,
   "end": 167.98,
   "text": "دشمن، میره برای وعظ و خطابه، میره برای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 167.98,
   "end": 174.56,
   "text": "هدایت و ارشاد مردم، قلبش با قبل از این با چه وضعیتی در خونه خدا اومده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 174.56,
   "end": 176.66,
   "text": "\"إذ جاء",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 176.66,
   "end": 179.4,
   "text": "ربه بقلب سليم\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 179.4,
   "end": 181.82,
   "text": "میگه این اول خودشو ساخت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 181.82,
   "end": 185.12,
   "text": "به سلامت قلب و درون رسید،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 185.12,
   "end": 189.1,
   "text": "بعد رفت جلودار شد و پرچم دستش گرفت و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 189.1,
   "end": 192.34,
   "text": "داعی هدایت بشر داشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 192.34,
   "end": 197.08,
   "text": "بلافاصله بعد از اینکه به سمت خدا با قلب سلیم میره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 197.08,
   "end": 201.0,
   "text": "بعد می‌فرماید \"إذ قال لأبيه وقومه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 201.0,
   "end": 204.3,
   "text": "ما هذا تعبدون\". این نکته خیلی ظریفیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 204.3,
   "end": 208.42,
   "text": "یعنی اینطور نیست که آدم همینجوری ظاهرسازی کنه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 208.42,
   "end": 212.66,
   "text": "یه لباسی از پیغمبر تنش کنه، چهار تا حرف حفظ کنه و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 212.66,
   "end": 215.64,
   "text": "بزنه و بعدم مثلا بتونه اصلاحی ایجاد کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 215.64,
   "end": 217.3,
   "text": "اتفاقا بدتر خراب می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 217.3,
   "end": 220.5,
   "text": "از ته امام رحمت الله علیه یه جمله‌ی عجیبی دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 220.5,
   "end": 226.6,
   "text": "می‌فرماید وای بر اون کسی که قبل از اینکه خودش رو بسازه محل رجوع مردم بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 226.6,
   "end": 228.8,
   "text": "حالا فرق نمی‌کنه تو هر وا--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 228.8,
   "end": 232.98,
   "text": "حالا لاجرم هم حتما نمی‌تونه لباس پیغمبر باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 232.98,
   "end": 235.42,
   "text": "چهره مذهبی پیدا کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 235.42,
   "end": 240.0,
   "text": "نمی‌دونم مدیر جای مهمی بشه، محل رجوع مردم بشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 240.0,
   "end": 242.56,
   "text": "و او رو نماد دین و اسلام و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 242.56,
   "end": 248.82,
   "text": "این‌ها بشناسن. بعد اگر خودش رو اصلاح نکرده باشه بدتر میزنه خرابکاری می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 248.82,
   "end": 251.38,
   "text": "بسیاری از خرابی‌هایی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 251.38,
   "end": 259.42,
   "text": "تو همین انقلاب خود ما و در مسیر دین ما پیش اومد به جهت آدم‌هایی بود که خودساخته نبودن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 259.42,
   "end": 265.62,
   "text": "و اومدن جلودار شدن. بسیاری از انحرافاتی که الان تو انقلاب خود ما پیش اومده همینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 265.62,
   "end": 271.3,
   "text": "آدمای نالایق اومدن جایی نشستن که حدش نبوده، در حد اونجا نبودن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 271.3,
   "end": 273.64,
   "text": "حد و اندازه‌ی اونجا نبودن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 273.64,
   "end": 275.6,
   "text": "پرچمی رو دست گرفته بودن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 275.6,
   "end": 278.22,
   "text": "گرفتن که در حد اندازه‌ی اون نبودن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 278.22,
   "end": 281.04,
   "text": "خودشون رو آماده‌ی برای اون جا-- داستان نکردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 281.04,
   "end": 284.8,
   "text": "همینطوری یهو مردم هجوم آوردن و به به و چه چه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 284.8,
   "end": 286.86,
   "text": "چهار تا تعریف و طرف خودشو گم کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 286.86,
   "end": 290.42,
   "text": "فکر کرد خبریه. یه حکمی انتصابی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 290.42,
   "end": 293.7,
   "text": "چیزی بهش دادن و گمان کرد حالا به همین حکم دیگه پسر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 293.7,
   "end": 298.02,
   "text": "پیغمبر شد و دیگه می‌تونه رو گرده‌ی مردم سوار شه و اینطوری نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 298.02,
   "end": 300.42,
   "text": "همه‌ی این عالم حساب و کتاب داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 300.42,
   "end": 302.8,
   "text": "چنان زیر پاش یه روزی خالی می‌شه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 302.8,
   "end": 308.1,
   "text": "مثل فرعون، میره با-- در قعر زمین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 308.1,
   "end": 313.7,
   "text": "توجه کردین مثل قارون میره در قعر زمین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 313.7,
   "end": 318.1,
   "text": "اینطور نیستش که هر کس داعی صلح سر داد بتونه سر--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 318.1,
   "end": 322.1,
   "text": "او أبا صالح المهدی‌ست که می‌خواست-- می‌خواد بیاد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 322.1,
   "end": 328.94,
   "text": "صلح و سلامت و صلاح و فلاح برقرار کنه در کل عالم خودش أبا صالح هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 328.94,
   "end": 332.54,
   "text": "پدر همه‌ی صلح‌هاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 332.54,
   "end": 336.38,
   "text": "امام رحمت الله علیه در سن چند سالگی حکومت تشکیل داد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 336.38,
   "end": 339.44,
   "text": "هفتاد سالگی. شوخی نیست‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 339.44,
   "end": 342.14,
   "text": "یعنی هفتاد سال خودسازی کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 342.14,
   "end": 347.04,
   "text": "بعد حالا بعضیا مثل من چهار تا ضرب و ضربا می‌خونن و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 347.04,
   "end": 351.74,
   "text": "لباس پیغمبر و دو نفرم تعریفشونو می‌کنن، سریع گم می‌کنه خودشو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 351.74,
   "end": 354.8,
   "text": "سریع جلودار می‌شه و بعد خراب می‌کنه یه عده رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 354.8,
   "end": 357.18,
   "text": "خیلی باید مراقب بود. شما حتی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 357.18,
   "end": 361.12,
   "text": "برای اینکه به جلسه بعدم کشیده نشه بحث،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 361.12,
   "end": 366.26,
   "text": "شما به آیات حتی سوره شعراء هم که این سوره صافات بود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 366.26,
   "end": 369.06,
   "text": "شوره، سوره شعرا هم شما دقت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 369.06,
   "end": 372.96,
   "text": "داشته باشید اگر یادتون باشه حالا اینجا بلد آیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 372.96,
   "end": 376.04,
   "text": "هشتاد و هشت تا هشتاد و نه سوره شعراست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 376.04,
   "end": 379.9,
   "text": "که باز اینجا همین مطلب رو می‌فرماید \"یوم لا ینفع مال و لا بنون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 379.9,
   "end": 382.02,
   "text": "الا من أتى الله بقلب سلیم\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 382.02,
   "end": 385.82,
   "text": "قبلش رو شما بخونید داستان حضرت ابراهیم رو بیان می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 385.82,
   "end": 388.22,
   "text": "ببینید جملات حضرت ابراهیم رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 388.22,
   "end": 389.94,
   "text": "چند تاشو من برای شما بخونم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 389.94,
   "end": 395.26,
   "text": "ببینید جهان‌بینی و نگاه توحیدی حضرت ابراهیم رو ببینید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 395.26,
   "end": 397.94,
   "text": "چه کسی می‌خواد بره بت بشکونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 397.94,
   "end": 402.02,
   "text": "وقتی حرف خدا رو می‌زنه \"فإنهم أعداء لي إلا رب العالمين\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 402.02,
   "end": 407.66,
   "text": "بعد میگه الذي وقتی حرف خدا رو می‌زنه ابراهیم این چند تا آیه رو دقت کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 407.66,
   "end": 411.12,
   "text": "الذي حضرت ابراهیم داره خداشو معرفی می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 411.12,
   "end": 414.14,
   "text": "\"الذي خلقني فهو يهدين\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 414.14,
   "end": 416.32,
   "text": "او منو خلق کرد و او هدایتم کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 416.32,
   "end": 419.76,
   "text": "\"والذي هو يطعمني ويسقين\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 419.76,
   "end": 427.3,
   "text": "عجب خداست که لقمه لقمه به من طعام می‌خوراند و جرعه جرعه به من آب می‌نوشاند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 427.3,
   "end": 432.4,
   "text": "ببینید نگاه توحیدی رو. \"وإذا مرضت فهو يشفين\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 432.4,
   "end": 435.98,
   "text": "کدوم یکی از ما وقتی نسخه رو از دست دکتر می‌گیریم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 435.98,
   "end": 441.32,
   "text": "میگیم که خدا اراده شفای من کرده به دست این دکتر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 441.32,
   "end": 443.56,
   "text": "این نگاه خیلی ظرافت می‌خواد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 443.56,
   "end": 449.62,
   "text": "\"وإذا مرضت\" وقتی من مریض میشم \"فهو يشفين\" خدا منو شفا می‌ده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 449.62,
   "end": 454.28,
   "text": "آقا اول خدا، بعدا دوم خدا، سوم خدا، چهارم شما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 454.28,
   "end": 457.8,
   "text": "اینا رو مثلا خدا تا سوم بیشتر حد نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 457.8,
   "end": 459.86,
   "text": "چهارم دیگه حد شماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 459.86,
   "end": 463.98,
   "text": "اینا واقعا شرکه. اینا اصلا با نگاه توحیدی، توحیدی سازگار نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 463.98,
   "end": 467.42,
   "text": "اول خدا دو آخر هم خدا \"هو الأول والآخر\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 467.42,
   "end": 470.02,
   "text": "\"والذي يميتني",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 470.02,
   "end": 473.16,
   "text": "يميتني ثم يحيين\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 473.16,
   "end": 477.5,
   "text": "همون کسی که ما رو می‌میرانه بعد زنده می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 477.5,
   "end": 480.72,
   "text": "مثلا همه چی دست خداست. \"والذي أطعم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 480.72,
   "end": 485.64,
   "text": "أطعم أن يغفر لي خطيئتي يوم الدين\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 485.64,
   "end": 488.06,
   "text": "همون خدایی که یه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 488.06,
   "end": 493.42,
   "text": "طوری رفتار کرده من بهش طمع دارم که منو تو روز قیامت ببخشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 493.42,
   "end": 498.4,
   "text": "اون خدا رو دارم میگم. \"رب هب لي حكما وألحقني بالصالحين\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 498.4,
   "end": 500.38,
   "text": "بعد دعا می‌کنه خدا به من حکم بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 500.38,
   "end": 504.88,
   "text": "منو \"ألحقني بالصالحين\". \"واجعل لي لسان صدق في الآخرين\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 504.88,
   "end": 509.04,
   "text": "توی ذریه من آینده من که همون پیغمبر و اهل بیت‌ن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 509.04,
   "end": 511.54,
   "text": "تو ذریه من در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 511.54,
   "end": 515.8,
   "text": "آخرالزمان لسان صدق قرار بده که اون‌ها صادقین هستند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 515.8,
   "end": 519.02,
   "text": "\"كونوا مع الصادقین\" یعنی با همراه اهل بیت باشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 519.02,
   "end": 522.2,
   "text": "\"واجعلني من ورثة جنت النعيم\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 522.2,
   "end": 526.22,
   "text": "منو از اون‌هایی قرار بده که ارث می‌برن از بهشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 526.22,
   "end": 529.22,
   "text": "\"واغفر لأبي واغفر لأبي\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 529.22,
   "end": 531.58,
   "text": "تو ببخش پدرمو همون آزر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 531.58,
   "end": 534.6,
   "text": "همون عموش. \"إنه كان من الظالمين\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 534.6,
   "end": 537.58,
   "text": "او گمراه شده \"ولا تخزن يوم يفترون\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 537.58,
   "end": 540.98,
   "text": "بعد از اینکه ببینید همش نگاه، نگاه توحیدیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 540.98,
   "end": 545.26,
   "text": "می‌خواد آب بخوره، غذا بخوره، می‌خواد دارو بخوره، شفا بگیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 545.26,
   "end": 547.58,
   "text": "همش میگه خدا، خدا، خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 547.58,
   "end": 554.0,
   "text": "چنین کسی اگر به قلب سلیم دست پیدا کرده می‌تونه پرچم‌دار هدایت بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 554.0,
   "end": 559.02,
   "text": "همین مرحوم شهید مدرس که امروز سالگرد شهادتشونه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 559.02,
   "end": 563.14,
   "text": "خودسازی کرد که تونست جلوی پادشاهی زمان بایسته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 563.14,
   "end": 565.92,
   "text": "اونطوری در آخ-- آخر هم تو نماز شهیدش کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 565.92,
   "end": 571.3,
   "text": "چون دیدن نمی‌تونن اگر بخوان به مطامع خودشون برسن باید از رو سد و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 571.3,
   "end": 573.68,
   "text": "مانع شهید مدرس رد شن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 573.68,
   "end": 575.74,
   "text": "لذا تو نماز شهیدش کردن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 575.74,
   "end": 578.56,
   "text": "و نمی‌ذارن هم عمدتا این‌ها بمونن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 578.56,
   "end": 581.46,
   "text": "چون این‌ها مانع اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 581.46,
   "end": 583.42,
   "text": "خودخواهی‌ها و طمع‌کاری‌های اونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 583.42,
   "end": 585.34,
   "text": "انشاالله که عاقبتمون ختم به خیر بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 585.34,
   "end": 588.54,
   "text": "به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 588.54,
   "end": 590.82,
   "text": "اللهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 590.82,
   "end": 595.22,
   "text": "صل على محمد. وعجل فرجه. آمين",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}