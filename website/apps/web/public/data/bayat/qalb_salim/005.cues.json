 "chapters": [
  {
   "index": 0,
   "title": "## استفتاءِ بانک‌های غیراسلامی",
   "start": 13.04,
   "end": 81.62
  },
  {
   "index": 1,
   "title": "نکتهٔ فشرده دربارهٔ قلبِ سلیم از آیه‌ای آغاز می‌شود:",
   "start": 81.62,
   "end": 101.94
  },
  {
   "index": 2,
   "title": "## عبرت و عبره در قیامِ عاشورا",
   "start": 101.94,
   "end": 122.06
  },
  {
   "index": 3,
   "title": "## روایتِ سفره و حیوانات؛ ابوالأئمه و حیواناتِ ازکارافتاده",
   "start": 122.06,
   "end": 661.34
  },
  {
   "index": 4,
   "title": "## سکینه و بقای نامِ حسین",
   "start": 661.34,
   "end": 760.78
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.36,
   "end": 4.5,
   "text": "بسم الله الرحمن الرحیم و به این استعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 4.5,
   "end": 8.3,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 8.3,
   "end": 12.52,
   "text": "آیات. سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 12.52,
   "end": 22.56,
   "text": "یکی دیگه از استفتائات مقام معظم رهبری پیرامون وام و خمس و چه عرض کنم قرض و تسهیلات بانک و این‌ها اینه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 22.56,
   "end": 25.08,
   "text": "از حضرت سؤال کردن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 25.08,
   "end": 30.76,
   "text": "آیا سپرده‌گذاری در بانک‌های غیر اسلامی جایزه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 30.76,
   "end": 35.7,
   "text": "و گرفتن سود از بانک‌هایی که تو کشورهای غیر اسلامی دارن مشغولن و کار می‌کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 35.7,
   "end": 38.2,
   "text": "البته می‌دونید معمولا بانک‌های",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 38.2,
   "end": 41.92,
   "text": "متأسفانه البته بیرون کشور و نظام ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 41.92,
   "end": 48.18,
   "text": "اونا همشون کار می‌کنن یعنی پولو که می‌گیرن مثل بعضی از بانک‌های داخلی ما نیست که باهاش برن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 48.18,
   "end": 52.22,
   "text": "ملک بخرن و ارز و سکه بگیرن نگه دارن گرون شه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 52.22,
   "end": 56.34,
   "text": "که عین کار حرامه. نه اتفاقا اونا کار می‌کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 56.34,
   "end": 58.88,
   "text": "حالا ما از این حرفا خیلی نزنیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 58.88,
   "end": 67.8,
   "text": "بو بدی داره. لذا حالا سؤال اینه آقا اشکالی داره توی بانک‌های غیر اسلامی تسهیلات بذاریم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 67.8,
   "end": 77.12,
   "text": "و حتی سود بگیریم؟ آقا فرمودن نه هیچ اشکالی نداره در بانک‌های غیر اسلامی هم در کشورهای غیر اسلامی بانک‌هاشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 77.12,
   "end": 81.62,
   "text": "تسهیلات بگذاری حتی سودش هم بگیری فقط یه نکته رو باید لحاظ کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 81.62,
   "end": 85.44,
   "text": "اگر اون کشور، کشوری‌ست که بر--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 85.44,
   "end": 89.12,
   "text": "با اسلام عناد داره، دشمنی با اسلام می‌کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 89.12,
   "end": 94.42,
   "text": "و این کارت و باعث بشه پایه‌های اقتصادی و سیاسی اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 94.42,
   "end": 97.96,
   "text": "دشمن اسلام تقویت بشه، اینجا جایز نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 97.96,
   "end": 100.36,
   "text": "یعنی بحث سیاسی قصه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 100.36,
   "end": 104.98,
   "text": "و الا از نظر مثلا شرعی، اقتصادی و اینا اشکال نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 104.98,
   "end": 110.62,
   "text": "نکته خیلی خیلی خیلی مهمی رو عرض کنم پیرامون همین قصه قلب سلیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 110.62,
   "end": 112.64,
   "text": "که خدا کمکم کنه بتونم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 112.64,
   "end": 116.14,
   "text": "فشرده سازیش کنم و ام پی تریش کنم خیلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 116.14,
   "end": 118.76,
   "text": "این نکته بحث گسترده‌ای می‌طلبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 118.76,
   "end": 122.06,
   "text": "ببینید، اه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 122.06,
   "end": 127.56,
   "text": "یه آیه از قرآن هست که می‌فرماید انا خلقنا السماوات والارض بالحق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 127.56,
   "end": 130.1,
   "text": "ما آسمان‌ها و زمین رو با حق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 130.1,
   "end": 132.92,
   "text": "به حق آفریدیم. از شما مثلا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 132.92,
   "end": 136.62,
   "text": "سؤال می‌کنم آقا فلان خونه رو تو ساختی با چه مصالحی ساختی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 136.62,
   "end": 139.6,
   "text": "سنگ روش رو چه کار کردی؟ گچ و سیمانش از چه جنس بود؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 139.6,
   "end": 142.56,
   "text": "چی بود؟ تو توضیح میدی مثلا میگی قالبش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 142.56,
   "end": 145.36,
   "text": "مثلا از این جنس بود از این سنگ بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 145.36,
   "end": 149.16,
   "text": "خدا می‌فرماید اساس این خلقت رو با حق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 149.16,
   "end": 152.02,
   "text": "من بنا کردم. اصلا باطل وجود نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 152.02,
   "end": 155.1,
   "text": "باطل کف رو آبه. جاء الحق وزهق الباطل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 155.1,
   "end": 160.08,
   "text": "بعضی اینطوری فرمودن که اصلا حق اومده، اصلا باطل وجود نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 160.08,
   "end": 163.66,
   "text": "نه اینکه باطل وجود داشته و رفته، اصلا باطلی نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 163.66,
   "end": 168.08,
   "text": "همه چی حقه. اون جولانیه یا کف رو آبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 168.08,
   "end": 170.74,
   "text": "اون آب که به خودش به حقه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 170.74,
   "end": 173.38,
   "text": "تلاطم‌هایی به این آب داده شده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 173.38,
   "end": 179.32,
   "text": "شیطنت‌هایی کردن اون کف رو آبه همون باطل است که اصلا وجود، وجود خارجی نداره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 179.32,
   "end": 183.64,
   "text": "و از بین رفته اصلاً چیزی نیست، قابل احساس نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 183.64,
   "end": 185.34,
   "text": "و پس همه چی بر حقه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 185.34,
   "end": 191.62,
   "text": "اون سفیران حق هم پیامبران و امامان معصوم علیهم الصلاة والسلام هستن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 191.62,
   "end": 196.96,
   "text": "و اون کسی که به قله خود رسوند این سفارت، این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 196.96,
   "end": 203.44,
   "text": "عرض کنم رسالت سفیران الهی رو، اون که به قله رسوند ابی عبدالله سلام الله عليه بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 203.44,
   "end": 206.42,
   "text": "اون که حق رو، حاکمیت حق رو،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 206.42,
   "end": 209.72,
   "text": "حقانیت حق رو و بطلان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 209.72,
   "end": 213.36,
   "text": "باطل رو به قله رسوند و به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 213.36,
   "end": 215.42,
   "text": "میشه گفت سمع و نظر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 215.42,
   "end": 221.22,
   "text": "آل-- همه عالم هستی به ظهور و بروز کشوند ابی عبدالله سلام الله عليه بود رضا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 221.22,
   "end": 224.14,
   "text": "شاید از این حیث وقتی نگاه کنیم یکی از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 224.14,
   "end": 230.82,
   "text": "شاید بشه گفت بعد از البته زیارت آل یاسین بهترین زیارت‌نامه زیارت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 230.82,
   "end": 233.66,
   "text": "عاشورا است که درش این قصه به خوبی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 233.66,
   "end": 239.86,
   "text": "بیان شده. شما ببینید میگه اللهم اجعل محیای محیا محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 239.86,
   "end": 246.88,
   "text": "اللهم صلي على محمد و مماتي ممات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 246.88,
   "end": 248.52,
   "text": "محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 248.52,
   "end": 251.8,
   "text": "مگ و حیات عین مرگ و حیات شما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 251.8,
   "end": 254.8,
   "text": "هیچ فرقی نکنه. بعد میگه انی سلم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 254.8,
   "end": 258.46,
   "text": "لمن-- بحث قصد قلب سلیم بود یه وقت بحث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 258.46,
   "end": 263.76,
   "text": "فراموش نشه. انی سلم لمن سالمکم و حرب لمن حاربکم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 263.76,
   "end": 269.82,
   "text": "دو تاش کنار هم میاد. مرگ و حیات من copy paste مرگ و حیات شما باشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 269.82,
   "end": 272.2,
   "text": "و من با خوبان شما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 272.2,
   "end": 279.6,
   "text": "در سلامتم، با تسلیم به حق و راه شما و البته و حرب لمن حاربکم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 279.6,
   "end": 282.06,
   "text": "ولی للموالاکم عدو لمن عاداکم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 282.06,
   "end": 289.2,
   "text": "اینا کنار هم اومده. در حقیقت همون اشدا علی الكفار رحماء بينهم دو لبه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 289.2,
   "end": 294.04,
   "text": "قیچی باید با هم باشن. نمیشه یکیش باشه یکیش نباشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 294.04,
   "end": 300.14,
   "text": "اگر یکیشو بعضیا میگن ابا عبدالله سلام الله عليه صرفا به جهت عب-عبرت قیام کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 300.14,
   "end": 302.14,
   "text": "عبرت عالم شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 302.14,
   "end": 307.06,
   "text": "قیام عاشورا واقعا عبرت بزرگ، بزرگ‌ترین عبرت تاریخه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 307.06,
   "end": 311.12,
   "text": "خیلی قیام‌ها صورت گرفته هیچ اثری ازشون نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 311.12,
   "end": 315.06,
   "text": "شما ببینید ساسانیان، نمی‌دونم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 315.06,
   "end": 318.5,
   "text": "اه خود بن العباس،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 318.5,
   "end": 322.84,
   "text": "سلجوقیان اینا بن العباس که حدود پونصد سال حکومت کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 322.84,
   "end": 327.36,
   "text": "چقدر اماما رو کشتن. آل مروان، بنی امیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 327.36,
   "end": 332.14,
   "text": "بعضی از پادشاهان حکومتشون حدود هزار سال طول کشیده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 332.14,
   "end": 333.82,
   "text": "اما اینا چی مونده ازشون؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 333.82,
   "end": 336.8,
   "text": "نه هیچ اثری، نه هیچ قبری، نه هیچ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 336.8,
   "end": 339.54,
   "text": "آثاری جز لعن و نفرین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 339.54,
   "end": 342.32,
   "text": "بازماندگان. اما از این آقا ببینید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 342.32,
   "end": 346.38,
   "text": "اصلاً ت-تمام تحولات تاریخی در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 346.38,
   "end": 348.96,
   "text": "پشت سر جریان عاشورا قرار گرفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 348.96,
   "end": 352.34,
   "text": "بله البته عبرت بوده و هست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 352.34,
   "end": 354.68,
   "text": "و زنده ست چون به حق است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 354.68,
   "end": 359.52,
   "text": "لکن ابا عبدالله برای دو چیز قیام کرد عبرت و ابره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 359.52,
   "end": 362.28,
   "text": "این ابره نباید فراموش بشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 362.28,
   "end": 366.0,
   "text": "مگر خودشون نفهمیدن أنا قتيل العبرات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 366.0,
   "end": 368.18,
   "text": "من کشته‌ی اشک‌هام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 368.18,
   "end": 373.22,
   "text": "اگر أشد على الكفار هست رحماء بينهم هم باید باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 373.22,
   "end": 378.16,
   "text": "نمیشه ما خوش زندگی کنیم، خوب و قشنگ زندگی کنیم، مرگمون هرچی شد شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 378.16,
   "end": 381.02,
   "text": "نه. میگه مرگتم مثل مرگ اونا باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 381.02,
   "end": 385.9,
   "text": "مگه شما به من بگید اهل بیت کدومشون به جز شهادت از دنیا رفتن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 385.9,
   "end": 388.86,
   "text": "اصلاً یعنی این یعنی غیرمستقیم داری میگی من",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 388.86,
   "end": 392.5,
   "text": "در مبا-- أشد على الكفار را داشته باشم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 392.5,
   "end": 394.62,
   "text": "البته محیا یا محیا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 394.62,
   "end": 396.78,
   "text": "یا إني سلم لمن سالمكم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 396.78,
   "end": 401.82,
   "text": "یعنی زندگیم هم اون رحماء بينهم رو هم در زندگیم رعایت کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 401.82,
   "end": 409.78,
   "text": "اینکه ما مثلاً جریان عمل حسین رو گفتیم یا خیلی از بچه‌های یمنه که دارن اینطوری کشته میشن از گرسنگی نمیرن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 409.78,
   "end": 413.62,
   "text": "تو بحرین، تو عراق، تو سوریه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 413.62,
   "end": 418.32,
   "text": "و واقعاً افتخار آخ-- آفرینی مدافعین حرم اینجا داره خودش رو نشون میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 418.32,
   "end": 421.66,
   "text": "این دقیقاً ریشه داره در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 421.66,
   "end": 424.02,
   "text": "مضامین ااا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 424.02,
   "end": 426.06,
   "text": "عرض کنم معارفی ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 426.06,
   "end": 427.82,
   "text": "در معارف ما ریشه داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 427.82,
   "end": 431.32,
   "text": "اینا رو ما نساختیم. خودش فرمود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 431.32,
   "end": 435.0,
   "text": "أنا قتيل العبرات. بعد میگه ما دوست داریم شما چی-- یه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 435.0,
   "end": 440.24,
   "text": "طوری برای ما گریه کنید که اشک صورت پهنای صورتتون رو بگیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 440.24,
   "end": 442.76,
   "text": "حالا برای اینکه یه سری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 442.76,
   "end": 450.3,
   "text": "شوق پیدا کنن، انگیزه پیدا کنن میگه اگر این اتفاق افتاد همه‌ی گناهاتون حد میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 450.3,
   "end": 453.24,
   "text": "خب این برای شوقه، برای شوق آفرینیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 453.24,
   "end": 457.14,
   "text": "ولی این وجه وظیفه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 457.14,
   "end": 461.32,
   "text": "وظیفه‌ی نه فقط ااا عرض کنم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 461.32,
   "end": 464.58,
   "text": "حقیقی بلکه حقوقی. پدر ما رو کشتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 464.58,
   "end": 468.5,
   "text": "أبا عبدالله او پدر همه‌ی بندگان خدا بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 468.5,
   "end": 471.44,
   "text": "پدر ما رو کشتن. او شخصیت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 471.44,
   "end": 473.6,
   "text": "حقوقی داشته، نه صرفاً حقیقی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 473.6,
   "end": 476.66,
   "text": "یه آقایی رو کشتن. یه کسی رو بنی‌ هاشم برن خونبه‌‌ها بدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 476.66,
   "end": 481.9,
   "text": "نه. لذا ما تو عاشورا می‌خوایم میگیم طلب ثأریك مع امام منصور.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 481.9,
   "end": 484.78,
   "text": "ما خونبه‌های تو رو بگیریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 484.78,
   "end": 487.88,
   "text": "این یعنی یک جریان تاریخی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 487.88,
   "end": 490.22,
   "text": "که در دلش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 490.22,
   "end": 492.4,
   "text": "تسلیم در برابر،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 492.4,
   "end": 495.46,
   "text": "در برابر امام و حق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 495.46,
   "end": 502.62,
   "text": "و تسلیم در برابر همون رحماء بينهم دوستان شما، هر کسی که در وادی شماست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 502.62,
   "end": 506.08,
   "text": "و سلم و سلامت رفتاری و گفتاری و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 506.08,
   "end": 507.84,
   "text": "قلبی با اون‌ها تو دلشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 507.84,
   "end": 511.22,
   "text": "یعنی نمیشه این دو تا رو از هم تفکیک کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 511.22,
   "end": 517.36,
   "text": "اگر ما رحماء بينهم رو نداشته باشیم، اگر فقط عبرت باشه و ابره نباشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 517.36,
   "end": 523.16,
   "text": "اگر این اشک و سوز و گداز و رحم و مروت و رسیدگی به هم و این‌ها نباشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 523.16,
   "end": 526.22,
   "text": "این کجاش تسلیمه؟ این کجاش تسلیم امام بودنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 526.22,
   "end": 529.14,
   "text": "این کجاش سلم لمن سالمکم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 529.14,
   "end": 532.28,
   "text": "خودم زندگیم خوب باشه خوش باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 532.28,
   "end": 534.58,
   "text": "استغفرالله فلان، فلان همه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 534.58,
   "end": 538.74,
   "text": "این چه دینیه؟ این، این خودخواهی محضه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 538.74,
   "end": 541.14,
   "text": "اصلاً این بی‌دینیه. امام صادق داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 541.14,
   "end": 543.76,
   "text": "امام جواد داره قربونشون بریم که تو--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 543.76,
   "end": 549.22,
   "text": "من اینو در هم روایتش رو دیدم هم چندین بار تو درس اخلاق حضرت آ--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 549.22,
   "end": 551.9,
   "text": "علامه آقای جوادی آملی شنیدم از ایشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 551.9,
   "end": 555.4,
   "text": "یه بار حتی گریه کرد این روایت رو گفت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 555.4,
   "end": 558.14,
   "text": "که من البته از امام صادق فقط روایت رو دیدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 558.14,
   "end": 564.84,
   "text": "اول ایشون فرمودن امام جواد هم دارن همچین قصه‌ای رو که دید یکی تو بیابون سفره پهن کرده داره غذا میخوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 564.84,
   "end": 569.72,
   "text": "حضرت بهش تذکر داد فرمود چطور داری غذا میخوری در حالی که این پرنده‌ها، این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 569.72,
   "end": 572.34,
   "text": "حیوانات گرسنه اند و دارن نگاه می کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 572.34,
   "end": 576.38,
   "text": "دید غذاشو تموم کرده سفره رو داره جمع میکنه میره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 576.38,
   "end": 581.74,
   "text": "بهش تذکر داد گفت اینا این همه حیوانات گرسنه ان دیدن سهم اینا رو بذار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 581.74,
   "end": 589.28,
   "text": "نفهمیدی یعنی چی؟ حضرت فرمود این خورده نونا، این ته سفره تو جمع نکن ببر بریز اینجا این گرسنه‌ها،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 589.28,
   "end": 597.88,
   "text": "این حیوانات دیدن تو خوردی چطور تونستی فقط خودت سیر باشی و به فکر گرسنه‌های حیوانات نباشی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 597.88,
   "end": 599.96,
   "text": "ببینید تو رو خدا دین ما چه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 599.96,
   "end": 603.7,
   "text": "چگونه است. یعنی اگر کسی اینطوری رفتار کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 603.7,
   "end": 606.4,
   "text": "دلش نسبت به حیوانات وقتی--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 606.4,
   "end": 609.34,
   "text": "أبو الأئمة أمير المؤمنين بیرون شهر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 609.34,
   "end": 614.88,
   "text": "یه حصاری زده بوده، حیواناتی که از کار افتاده بودن کسی به قول ما آدم حسابشون نمی‌کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 614.88,
   "end": 618.64,
   "text": "اینا رو جمع کرده بود اونا-- اونجا بهشون رسیدگی می‌کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 618.64,
   "end": 622.6,
   "text": "از حیوان وقتی غافل نیست چطور ما از انسان نباشیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 622.6,
   "end": 627.26,
   "text": "یا همه، همه که خب همه شاید عمر صد بشن ما هم باید بشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 627.26,
   "end": 633.82,
   "text": "در حد خودمون این رحماء بينهم این ابره، اشک و ناله و دلسوزی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 633.82,
   "end": 638.12,
   "text": "این سلم لمن سالمكم اگر نباشد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 638.12,
   "end": 643.16,
   "text": "قطعاً ما به اون مقام تسلیم و قلبی لقلبکم سلم نخواهیم رسید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 643.16,
   "end": 647.8,
   "text": "و این ادجاء ربّه بقلب سلیم رخ نخواهد داد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 647.8,
   "end": 651.72,
   "text": "قلب سلیم قلبی‌ست که دو بال داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 651.72,
   "end": 655.16,
   "text": "أشد على الكفار رحماء بينهم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 655.16,
   "end": 660.12,
   "text": "اگر غیر از این باشه این به سلامت قلبی نرسیده و به قصه‌ی عاشورا--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 660.12,
   "end": 662.62,
   "text": "شما ببینید ایام شهادت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 662.62,
   "end": 667.76,
   "text": "واقعاً شهادت، وفات شهادت گونه حضرت سكینه سلام الله علیها هم هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 667.76,
   "end": 672.28,
   "text": "ایشون هم مثل حضرت زینب سلام الله علیها چندین بار خطبه‌خوانی داشته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 672.28,
   "end": 675.7,
   "text": "یعنی صحبت کرده. افشاگری کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 675.7,
   "end": 680.02,
   "text": "جالبه که ایشون هم عین حضرت زینب سلام الله علیها فرمودن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 680.02,
   "end": 683.68,
   "text": "که اگر شما ظاهراً حسین رو گرفتید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 683.68,
   "end": 688.1,
   "text": "اما تا قیام قیامت نمی‌تونید نام حسین رو محو کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 688.1,
   "end": 691.6,
   "text": "الان ما داریم اینو می‌فهمیم. اون موقع می‌گفتن قصه داره میگه استغفرالله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 691.6,
   "end": 697.26,
   "text": "داره شعر می‌خونه. لذا امام سجاد سلام الله علیه فرمود تو کل جزیرة العرب و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 697.26,
   "end": 700.52,
   "text": "عرض کنم شام و اینا بیست نفر بیشتر ما رو دوست نداشتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 700.52,
   "end": 703.28,
   "text": "الله اکبر. بعد قصه عاشوراها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 703.28,
   "end": 704.96,
   "text": "فکر نکنین ورق برگشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 704.96,
   "end": 711.18,
   "text": "حتی بدتر شد. اما الان ببینید چه جریانی از سید و شهدا راه افتاده که دارن فکر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 711.18,
   "end": 713.94,
   "text": "اربعین ششصد میلیونی رو می‌کنن از الان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 713.94,
   "end": 716.72,
   "text": "دارن برنامه‌ریزی می‌کنن کارگزارها،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 716.72,
   "end": 722.14,
   "text": "کشورهای اسلامی دارن دست به دست هم میدن یه کنگره‌ای راه بندازن فکر ششصد میلیون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 722.14,
   "end": 724.2,
   "text": "زائر ابا عبدالله رو از الان دارن می‌کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 724.2,
   "end": 727.16,
   "text": "آقای سیستانی دستور تخریب داره خرد خرد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 727.16,
   "end": 732.54,
   "text": "همه‌ی این بازارها، بازارچه ها، امکنه اینا تخریب شه حرم وسعت بگیره مثل مشهد بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 732.54,
   "end": 735.84,
   "text": "غوغا میشه ان‌شاءالله. هم که الان شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 735.84,
   "end": 740.24,
   "text": "این دین به حقّه. مصالح ساختمانی این عالم به حقّه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 740.24,
   "end": 743.12,
   "text": "اگر کسی این طریق رو نرفت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 743.12,
   "end": 745.8,
   "text": "به اون حقیقت قلب سلیم نرسیده و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 745.8,
   "end": 749.42,
   "text": "پسش می‌زنن. رفته تو جبهه‌ی باطل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 749.42,
   "end": 754.36,
   "text": "ان‌شاءالله عاقبتمون ختم به خیر بشه و برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 754.36,
   "end": 760.78,
   "text": "اللهم صل على محمد و آل محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}