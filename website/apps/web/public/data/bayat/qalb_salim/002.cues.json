 },
 "chapters": [
  {
   "index": 0,
   "title": "## تسهیلات بانکی و شرط خواباندن پول",
   "start": 16.14,
   "end": 60.0
  },
  {
   "index": 1,
   "title": "## قلب سلیم به مثابهٔ نیت صادق",
   "start": 60.0,
   "end": 579.0
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 5.02,
   "end": 8.62,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 8.62,
   "end": 16.14,
   "text": "السلام علیک یا داعی الله و ربانی آیاته سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 16.14,
   "end": 18.74,
   "text": "از رهبر عزیز استفسار شده که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 18.74,
   "end": 22.22,
   "text": "این بانک‌هایی که تسهیلات میدن اگر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 22.22,
   "end": 30.6,
   "text": "برای تشویق مردم یه شرایطی رو بگذارن مثلا بگن آقا شما بیا شش ماه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 30.6,
   "end": 32.82,
   "text": "پولتو بخوابون تا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 32.82,
   "end": 35.38,
   "text": "این تسهیلاتو به شما بدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 35.38,
   "end": 39.46,
   "text": "آیا این کار اشکال نداره که مثلا ما اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 39.46,
   "end": 44.92,
   "text": "کار تشویقی که بانک داره انجام میده ما به خاطر اون بریم مثلا پول بخوابونیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 44.92,
   "end": 48.1,
   "text": "اون تسهیلات تشویقی رو دریافت کنیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 48.1,
   "end": 51.24,
   "text": "آقا فرمودن خیر هیچ ایرادی نداره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 51.24,
   "end": 57.62,
   "text": "که چه اون بانک داره کار تشویقی انجام میده، شرایطو می‌شینه چه، چه گرفتن شما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 57.62,
   "end": 62.16,
   "text": "هر دو بی‌اشکال است. در خصوص قلب سلیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 62.16,
   "end": 65.58,
   "text": "یه روایت خیلی ناب و زیبایی دیدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 65.58,
   "end": 69.1,
   "text": "البته در کتاب میزان الحکمه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 69.1,
   "end": 71.88,
   "text": "آقای ریشهری دیدم در باب،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 71.88,
   "end": 79.66,
   "text": "باب القلب ایشون. لکن اونجا سند زده بود تفسیر نور الثقلین، جلد چهار، صفحه پنجاه و هشت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 79.66,
   "end": 85.02,
   "text": "که امام صادق صلوات الله علیه فرمودن \"صاحب النیه الصادقه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 85.02,
   "end": 87.52,
   "text": "صاحب القلب السلیم\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 87.52,
   "end": 95.02,
   "text": "در حقیقت امام صادق صلوات الله علیه یکی از ترجمه‌های قلب سلیم رو به نیت سالم برگردوندن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 95.02,
   "end": 101.1,
   "text": "فرمودن که منظور از قلب سلیم که در قرآن وارد شده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 101.1,
   "end": 103.44,
   "text": "همون نیت سالم است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 103.44,
   "end": 110.2,
   "text": "بعد توضیح میدن که \"لأن سلامت القلب من حواجز المذكورات\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 110.2,
   "end": 114.46,
   "text": "یعنی چون که پاک و سالم بودن دل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 114.46,
   "end": 117.34,
   "text": "از حواجز نفسانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 117.34,
   "end": 121.28,
   "text": "\"تخلص النیه لله في الأمور كلها\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 121.28,
   "end": 124.84,
   "text": "نیت رو در همه کارها خالص می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 124.84,
   "end": 127.44,
   "text": "یعنی وقتی که انسان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 127.44,
   "end": 130.36,
   "text": "از خطورات نفسانی حفظ شد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 130.36,
   "end": 137.34,
   "text": "نیتش پاک می‌شه. بعد فرمودن، اشاره کردن به این آیه امام صادق صلوات الله علیه که \"قال الله تعالی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 137.34,
   "end": 142.86,
   "text": "يوم لا ينفع مال ولا بنون إلا من أتى الله بقلب سلیم\" که مورد بحث ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 142.86,
   "end": 146.64,
   "text": "پس امام صادق صلوات الله علیه اینجا قلب سلیم رو نیت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 146.64,
   "end": 150.76,
   "text": "خالص گرفتن، نیت صادق گرفتن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 150.76,
   "end": 158.02,
   "text": "که برگرفته از قلبی‌ست که خالی باشه از خطورات نفسانی و هواها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 158.02,
   "end": 162.36,
   "text": "و خواهش‌های دل. اگر دقت کردید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 162.36,
   "end": 165.46,
   "text": "رهبر عزیزمون توی تشییع",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 165.46,
   "end": 169.82,
   "text": "شهید حججی یه نکته‌ای رو گفتن که فرمودن ما خیلی شهید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 169.82,
   "end": 173.62,
   "text": "دادیم، شهید مدافع حرم همه‌شونم عزیزن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 173.62,
   "end": 176.62,
   "text": "اما این شهید خدا عزیش کرد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 176.62,
   "end": 183.68,
   "text": "حتما یه حکمتی داشته و اشاره کردن به خلوص نیت شهید و نیت پاکش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 183.68,
   "end": 187.08,
   "text": "اگه یادتون باشه بالا سر بدن پاک شهید حججی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 187.08,
   "end": 188.68,
   "text": "رهبری این نکته رو اشاره کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 188.68,
   "end": 194.36,
   "text": "فرمودن قطعاً برمی‌گرده به نیت خالص و نیت پاکش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 194.36,
   "end": 196.96,
   "text": "این در حقیقت همون قصه‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 196.96,
   "end": 202.88,
   "text": "یعنی با توجه به همین نکته‌ای که رهبری فرمودن، می‌شه گفت که این شهید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 202.88,
   "end": 206.32,
   "text": "به یک درجه بالاتری از قلب سلیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 206.32,
   "end": 211.68,
   "text": "قطعاً رسیده. خود سلامت قلب هم درجاتی دارد دیگه، مقاماتی دارد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 211.68,
   "end": 218.64,
   "text": "که البته بعد از درجات، غرفات است که هر کدوم اینا باید معنی بشه و بعد از غرفات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 218.64,
   "end": 221.34,
   "text": "حالا انواری‌ست، درجاتی‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 221.34,
   "end": 225.4,
   "text": "یه حدیث دیگه در همین خصوص دیدم خیلی جالب بود در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 225.4,
   "end": 227.84,
   "text": "کتاب کافی صف--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 227.84,
   "end": 229.4,
   "text": "جلد دو، صفحه هشتاد و پنج.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 229.4,
   "end": 231.98,
   "text": "امام صادق صلوات الله علیه فرمودن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 231.98,
   "end": 236.3,
   "text": "\"إنما خلد، خلد أهل النار في النار\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 236.3,
   "end": 238.68,
   "text": "می‌خواد بفرماد که چرا اهل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 238.68,
   "end": 242.94,
   "text": "جهنم همیشه تو جهنم‌ن و اهل بهشت همیشه تو بهشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 242.94,
   "end": 247.54,
   "text": "می‌فرماید \"إنما خلد أهل النار في النار لأن نياتهم\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 247.54,
   "end": 256.74,
   "text": "برمی‌گرده به نیتشون. \"لأن نياتهم كانت في الدنيا أولى لو خلدوا فيها أن يسعى الله تعالى أبدا\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 256.74,
   "end": 261.36,
   "text": "اینایی که همیشه تو جهنم‌ن به جهت اینه که نیتشون این بوده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 261.36,
   "end": 263.9,
   "text": "نیتشون این بوده که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 263.9,
   "end": 266.26,
   "text": "تا وقتی که اینا زنده‌ن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 266.26,
   "end": 270.44,
   "text": "معصیت خدا رو بکنن، تا هر وقت که هستن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 270.44,
   "end": 274.98,
   "text": "همچنین فرمود \"و إنما خلد أهل الجنة\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 274.98,
   "end": 279.82,
   "text": "اینکه مخلدند اهل بهشت در بهشت باز \"لأن نياتهم\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 279.82,
   "end": 281.4,
   "text": "به خاطر اینکه نیتشون چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 281.4,
   "end": 284.5,
   "text": "\"كانت في الدنيا لو ألا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 284.5,
   "end": 288.38,
   "text": "لو بقوا فيها\" تا وقتی که باقی هستن در دنیا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 288.38,
   "end": 290.78,
   "text": "\"أن يطيع الله أبدا\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 290.78,
   "end": 293.6,
   "text": "تا اونجایی که هستن در اطاعت خدا باشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 293.6,
   "end": 295.8,
   "text": "نیت اینا بهشتی‌ها این بوده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 295.8,
   "end": 301.16,
   "text": "حتی اگر یه وقت شیطان گولشون بزنه و آلوده به معاصی بشن، سریع توبه می‌کنن برمی‌گردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 301.16,
   "end": 304.32,
   "text": "نیت بر ماندن در معصیت ندارن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 304.32,
   "end": 307.2,
   "text": "اهل ایمان. سریع برمی‌گردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 307.2,
   "end": 310.46,
   "text": "بعد فرمودن \"فبنيات خلد هؤلاء\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 310.46,
   "end": 313.3,
   "text": "و پس به نیت‌هاشونه که این‌ها مخلدند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 313.3,
   "end": 315.5,
   "text": "چه در جهنم، چه در بهشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 315.5,
   "end": 320.06,
   "text": "جالبه که حضرت انتهای روایت رو اینچنین جمع می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 320.06,
   "end": 327.7,
   "text": "ااا، اش-- یه آیه‌ای رو از قرآن تلاوت می‌کنه که \"تلا قوله، ثم تلا قوله تعالى\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 327.7,
   "end": 330.08,
   "text": "سپس حضرت تلاوت کرد این آیه رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 330.08,
   "end": 334.28,
   "text": "\"قل كل يعمل على شاكلته\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 334.28,
   "end": 339.28,
   "text": "که قبلاً رو این آیه ما خیلی بحث کردیم تو قاعده شاکله در قرآن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 339.28,
   "end": 342.32,
   "text": "بعد حضرت اینطوری این آیه هشتاد و چهار سوره اسرا عه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 342.32,
   "end": 344.74,
   "text": "بعد حضرت اینطوری تموم می‌کنه که \"قال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 344.74,
   "end": 347.36,
   "text": "یعنی على نيته\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 347.36,
   "end": 350.94,
   "text": "یعنی چی؟ حضرت می‌فرماید \"قل كل يعمل،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 350.94,
   "end": 356.54,
   "text": "يعمل على شاكلته\" اینکه قرآن می‌فرماید همه عمل می‌کنند بر اساس شاکله‌شون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 356.54,
   "end": 360.34,
   "text": "یعنی همون درون و ذات و شخصیت و سجیه‌شون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 360.34,
   "end": 364.12,
   "text": "امام صادق یعنی فرمودن یعنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 364.12,
   "end": 369.44,
   "text": "علی نیته. یعنی اون درون هر کسی نیت اوست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 369.44,
   "end": 372.6,
   "text": "شخصیت هر کسی نیت اوست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 372.6,
   "end": 376.14,
   "text": "شخصیت هر کسی رو میشه از نیاتش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 376.14,
   "end": 380.68,
   "text": "پیدا کرد. یه کسی شاید به سمت عبادیات هم بره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 380.68,
   "end": 383.52,
   "text": "به سمت معارف الهی هم بره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 383.52,
   "end": 386.82,
   "text": "و حتی بعضا خط مقدم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 386.82,
   "end": 394.44,
   "text": "کارهای جهادی هم باشه. اما می‌بینی در نهایت اونچه که براش مهمه و نیت کرده مشهوریت باشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 394.44,
   "end": 397.0,
   "text": "معروفیت باشه، می‌خواد چهره‌ی شاخصی باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 397.0,
   "end": 401.42,
   "text": "حدیث عجیبی در کتاب اصول کافی مرحوم کلینی اعلی الله مقامه الشریف دیدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 401.42,
   "end": 405.38,
   "text": "خیلی عجیب بود برام که خیلی سال پیش براتون هم فکر کنم گفتم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 405.38,
   "end": 407.3,
   "text": "که شهیدی رو می‌برن به جهنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 407.3,
   "end": 410.28,
   "text": "شهید در راه خدا. میگن ببرنش به جهنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 410.28,
   "end": 412.0,
   "text": "خدایا من در راه تو کشته شدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 412.0,
   "end": 414.26,
   "text": "میگه تو به این خاطر رفتی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 414.26,
   "end": 416.82,
   "text": "کشته شی که اسمت رو زبان‌ها مطرح بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 416.82,
   "end": 420.18,
   "text": "ببینید قصه تا کجا پیش می‌ره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 420.18,
   "end": 423.36,
   "text": "تو نیتت این بوده که معروفیت رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 423.36,
   "end": 426.94,
   "text": "تو همین خاطر رفتی که به شهادت برسی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 426.94,
   "end": 432.0,
   "text": "انقدر قضیه نیت مهمه یا کسی که مال براش مهمه حتی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 432.0,
   "end": 434.94,
   "text": "مسیر عباداتش رو به سمتی میره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 434.94,
   "end": 437.38,
   "text": "که پول بیشتری درش هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 437.38,
   "end": 442.5,
   "text": "حالا این پول می‌تونه تو لباس پیغمبر باشه، می‌تونه تو مداحی باشه، می‌تونه تو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 442.5,
   "end": 444.58,
   "text": "هیئت‌داری باشه، می‌تونه تو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 444.58,
   "end": 447.6,
   "text": "مدیریت باشه، می‌تونه تو خیلی چیزا باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 447.6,
   "end": 453.26,
   "text": "تو چهره‌ها اون چهره‌ای که درش پول بیشتری هست میره اون چهره رو انتخاب می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 453.26,
   "end": 455.22,
   "text": "می‌خواد ضد دین باشه یا دین باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 455.22,
   "end": 457.68,
   "text": "اصلا اون براش مهم نیست. ملاک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 457.68,
   "end": 466.42,
   "text": "باز در، در حقیقت ختم که الان بر می‌گردیم به قصه‌ای که دیروز عرض کردیم تعلقات قلبی طرفه و قلبی لقلبکم سلم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 466.42,
   "end": 470.64,
   "text": "که در زیارت اربعین عرض کردیم از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 470.64,
   "end": 474.1,
   "text": "مفاد عهدنامه ما با اباعبدالله روز اربعین بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 474.1,
   "end": 477.76,
   "text": "یعنی قلب من با قلب شما تسلیم قلب شماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 477.76,
   "end": 481.32,
   "text": "یعنی حوزه تعلقات من",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 481.32,
   "end": 483.92,
   "text": "کاملا تسلیم تعلقات شماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 483.92,
   "end": 488.4,
   "text": "هرچی که شما بهش علقه و علاقه داری منم به همون علقه و علاقه دارم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 488.4,
   "end": 491.1,
   "text": "اگر شما از معروفیت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 491.1,
   "end": 496.88,
   "text": "بدت میاد، حدیث داریم هر نوع مشهوریت و معروفیت از شیطانه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 496.88,
   "end": 501.46,
   "text": "و نمی‌دونم بعضیا چطور حتی از وادی دین میخوان برن به سمت معروفیت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 501.46,
   "end": 505.2,
   "text": "حدیث امیرالمؤمنین که می‌فرماید هر نوعش آ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 505.2,
   "end": 507.26,
   "text": "دام شیطانه. گول نخورید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 507.26,
   "end": 512.8,
   "text": "اینکه حالا بره لباس پیغمبر هم بخواد معروف شه بعدم توجیه کنه میخوام معارف رو انتقال بدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 512.8,
   "end": 517.34,
   "text": "این حرفا چیه؟ بشین سر جات. خیلیا از تو گنده‌تر رفتن چپه شدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 517.34,
   "end": 521.36,
   "text": "آره یه وقت هست خدا کسی رو معروف می‌کنه، اون دیگه به ما ربطی نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 521.36,
   "end": 524.18,
   "text": "تو نباید به سمت معروفیت خودت بری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 524.18,
   "end": 527.56,
   "text": "که بارها عرض کردیم آقای جوادی آملی در کتاب اسرار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 527.56,
   "end": 532.68,
   "text": "یا حکمت عباداتش می‌فرماید بعضیا رو اصلا خدا خواسته که اینا معروف بشن یه زمانی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 532.68,
   "end": 535.36,
   "text": "خودشون عجله می‌کنن خراب می‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 535.36,
   "end": 541.5,
   "text": "اینکه یهو با سر می‌خوره زمین طرف میره به اوج با سر می‌خوره خودش دخالت کرده تو کار خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 541.5,
   "end": 546.66,
   "text": "بسپر به خدا. تو برای معروفیت نرو، برای پول نرو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 546.66,
   "end": 551.3,
   "text": "تو برای خاطر خدا برو. بقیه‌ش رو خدا اگر صلاحت باشه میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 551.3,
   "end": 554.58,
   "text": "این نیت صالح و سی-- نیت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 554.58,
   "end": 558.78,
   "text": "سالمه که صالح‌سازی اعمال بعد از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 558.78,
   "end": 565.34,
   "text": "نیت خالص رخ میده و این می‌شه همون قلب سلیم که شاید من خیلی باهاش فاصله دارم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 565.34,
   "end": 568.04,
   "text": "و شاید بشه گفت خیلی با شهادت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 568.04,
   "end": 572.5,
   "text": "فاصله دارم. خدا انشاالله ما رو برسونه به اون مقامات و درجات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 572.5,
   "end": 579.0,
   "text": "عاقبتمون انشاالله ختم به خیر بشه به برکت صلوات بر محمد و آل محمد. سلام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}