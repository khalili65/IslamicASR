 },
 "chapters": [
  {
   "index": 0,
   "title": "## إن کلامنا یحیی القلوب",
   "start": 88.34,
   "end": 122.58
  },
  {
   "index": 1,
   "title": "نخست از کتاب بحار جلد هفتادوهشت صفحهٔ صدوشصت‌وچهار، مولا امام باقر صلوات‌الله‌علیه:",
   "start": 122.58,
   "end": 146.8
  },
  {
   "index": 2,
   "title": "## حدیث دوم؛ از قلب سلیم جز معنای مستقیم نیاید",
   "start": 146.8,
   "end": 229.1
  },
  {
   "index": 3,
   "title": "حدیث سوم و آخر، از میزان الحکمه جلد ده صفحهٔ چهارهزارونهصدوهشتادوشش. امیرالمؤمنین علیه‌الصلوة‌والسلام:",
   "start": 229.1,
   "end": 340.94
  },
  {
   "index": 4,
   "title": "## امل حسین و دردمندی نسبت به جهان اسلام",
   "start": 340.94,
   "end": 515.58
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.74,
   "end": 3.74,
   "text": "بسم الله الرحمن الرحیم و به او نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 3.74,
   "end": 7.28,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 7.28,
   "end": 12.12,
   "text": "آیاته. السلام علیکم و رحمه الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 12.12,
   "end": 15.78,
   "text": "استفتاء شده از رهبر عزیز که اگر کسی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 15.78,
   "end": 18.8,
   "text": "قرض یا وامی به کسی بده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 18.8,
   "end": 24.0,
   "text": "و اون بدهکار تعلل کنه در پرداخت اقساط‌شو،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 24.0,
   "end": 26.54,
   "text": "برگرداندن اون اصل مال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 26.54,
   "end": 30.84,
   "text": "تعلل کنه، کوتاهی کنه به هر دلیلی نده پولشو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 30.84,
   "end": 33.68,
   "text": "حالا طلبکار میره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 33.68,
   "end": 37.96,
   "text": "اون وثیقه‌ای که داره، اون حالا سفته یا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 37.96,
   "end": 45.28,
   "text": "چک هرچی هست به اجرا میذاره و کار به دادگاهی کشیده می‌شه و مالیات می‌پردازه و پول دادگاهی و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 45.28,
   "end": 51.14,
   "text": "قضاوت و این‌ها. سؤال اینه اون پولی که بدهکار بابت دادگاهی و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 51.14,
   "end": 60.58,
   "text": "این خرج‌هایی که باید بکنه تا اون رو به محاکمه بکشونه تا پولو ازش پس بگیره، این خرجه‌ها هم به گردن بدهکاره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 60.58,
   "end": 63.08,
   "text": "شرعاً یا نه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 63.08,
   "end": 65.72,
   "text": "آقا فرمودن از جهت شرعی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 65.72,
   "end": 70.78,
   "text": "این خرج‌هایی که بابت تشکیل دادگاه و اینا می‌شه گردن بدهکار نیست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 70.78,
   "end": 75.34,
   "text": "از جهت شرعی. اما اگر در قانون جمهوری اسلامی ایران",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 75.34,
   "end": 78.3,
   "text": "چیزی تو این قصه هست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 78.3,
   "end": 81.2,
   "text": "لازم الاجراست که همون قانون رعایت بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 81.2,
   "end": 84.1,
   "text": "اما از جهت شرعی نه، گردن بدهکار نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 84.1,
   "end": 88.04,
   "text": "خود طلبکار باید این‌ها رو هزینه کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 88.04,
   "end": 92.96,
   "text": "دوستا حدیث زیبا بخونیم یه نفسی بگیریم که امام باقر صلوات الله علیه فرمود: \"إن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 92.96,
   "end": 95.72,
   "text": "كلامنا یحیی القلوب\" دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 95.72,
   "end": 102.2,
   "text": "برای اینکه دل‌هامون زنده بشه، پیرامون قلب سلیم، دوستا حدیث بسیار زیبا بخونیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 102.2,
   "end": 107.36,
   "text": "اولیش از کتاب بحار جلد هفتاد و هشت صفحه صد و شصت و چهار هست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 107.36,
   "end": 115.12,
   "text": "که مولامون امام باقر صلوات الله علیه فرمودن: \"لا علم کطلب– کطلب السلامه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 115.12,
   "end": 118.46,
   "text": "و لا سلامت ک– سلامت القلب\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 118.46,
   "end": 122.58,
   "text": "هیچ دانشی مثل سلامت‌جویی نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 122.58,
   "end": 128.12,
   "text": "هیچ علم و دانشی مثل این نیست که تو طلب سلامتی کنی با اون علم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 128.12,
   "end": 135.36,
   "text": "و البته \"و لا سلامت کسلامة القلب\" هیچ سلامتی هم مثل سلامت قلب نمی‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 135.36,
   "end": 138.0,
   "text": "یعنی بالاترین سلامت‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 138.0,
   "end": 144.68,
   "text": "سلامت قلبه. چون همه‌ی اعضا و جوارح انسان چه از جهت ظاهری، چه باطنی در گرو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 144.68,
   "end": 149.82,
   "text": "عملکرد قلبن. حدیث بعدی در کتاب قرر الحکم هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 149.82,
   "end": 155.86,
   "text": "البته من اینو در میزان الحکمه جلد ده صفحه چهار هزار و نهصد و هشتاد و چهار دیدم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 155.86,
   "end": 158.22,
   "text": "که اونجا سند زده بود قرر الحکم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 158.22,
   "end": 166.72,
   "text": "مولامون امیرالمؤمنین علیه الصلاة والسلام فرمودن: \"لا یستر عن القلب السلیم إلا المعنی المستقيم\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 166.72,
   "end": 172.7,
   "text": "از یه دل سالم به جز معانی راست و درست سر نمیزنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 172.7,
   "end": 175.22,
   "text": "پس دو نکته؛",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 175.22,
   "end": 180.14,
   "text": "اگر کسی اعمالش سالم بود،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 180.14,
   "end": 190.26,
   "text": "خروجی وجودش، صادرات کارخانه وجودش سالم بود، این برمی‌گرده، برگشت داره به قلبش، قلبش سالم بوده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 190.26,
   "end": 199.18,
   "text": "و بالعکس اگر کسی اعمال ناپاکی داره، خروجی یا معانی وجودش معانی درست و سالمی نیست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 199.18,
   "end": 204.62,
   "text": "و اون صادرات‌ش رو تشکیل میده، اعمالش رو تشکیل میده، این قطعاً قلبش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 204.62,
   "end": 206.46,
   "text": "سالم نیست. باید به داد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 206.46,
   "end": 209.9,
   "text": "قلبش برسه و قلبش رو مداوا کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 209.9,
   "end": 214.94,
   "text": "در حدیث سوم و آخریش را هم اینو یه نکته‌ای در خصوصش عرض کنم و السلام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 214.94,
   "end": 219.6,
   "text": "باز از میزان الحکمه جلد ده صفحه چهار هزار و نهصد و هشتاد و شش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 219.6,
   "end": 222.74,
   "text": "امیرالمؤمنین علیه الصلاة والسلام فرمودن: \"لا–",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 222.74,
   "end": 226.54,
   "text": "لا يسلم لک قلبک\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 226.54,
   "end": 229.1,
   "text": "قلب تو سالم نمی‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 229.1,
   "end": 235.54,
   "text": "به سلامت قلب دست پیدا نمی‌کنی مگر \"حتی تفبل المؤمنین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 235.54,
   "end": 237.6,
   "text": "ما تفبل نفسک\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 237.6,
   "end": 240.12,
   "text": "تا جایی که به، به جایی برسی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 240.12,
   "end": 244.2,
   "text": "که اونچه که برای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 244.2,
   "end": 247.96,
   "text": "خودت می‌پسندی برای دیگران هم بپسندی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 247.96,
   "end": 255.32,
   "text": "که البته این در دلش این رو هم داره که چیزی که برای خودت نمی‌پسندی برای دیگران هم نپسندی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 255.32,
   "end": 257.7,
   "text": "این حب و بغض با هم جمع می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 257.7,
   "end": 261.12,
   "text": "در هر حال این نکته بسیار مهمیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 261.12,
   "end": 264.6,
   "text": "اینکه انسان در مورد دیگران",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 264.6,
   "end": 271.26,
   "text": "چگونه قضاوت می‌کنه. یه روایت دیدم که پیامبر عظیم الشأن اسلام در مسجد بودن فرمودن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 271.26,
   "end": 276.22,
   "text": "اگر کسی می‌خواد چهره‌ی یک مرد بهشتی رو نگاه کنه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 276.22,
   "end": 278.92,
   "text": "به این پیرمرد نگاه کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 278.92,
   "end": 282.72,
   "text": "همه نگاه کردن، اشاره کرد. یه پیرمرد خیلی نورانی تو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 282.72,
   "end": 286.48,
   "text": "مسجد بود. پیغمبر مژده بهشتی بودن ایشون رو داد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 286.48,
   "end": 288.6,
   "text": "همه ریختن سرش. خوش به حالت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 288.6,
   "end": 292.34,
   "text": "تو چیکار کردی که پیغمبر همچین مژده‌ای بهت داده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 292.34,
   "end": 293.98,
   "text": "یه بررسی ای تو وجودش کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 293.98,
   "end": 300.3,
   "text": "گفت من یه صفت نابی تو وجودم هست شاید به خاطر اونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 300.3,
   "end": 306.2,
   "text": "گفتن که من هر چیزی رو که برای خودم می‌پسندم برای دیگران می‌پسندم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 306.2,
   "end": 311.6,
   "text": "و وقتی که کسی خیری، خوشی، سروری براش ایجاد می‌شه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 311.6,
   "end": 314.56,
   "text": "منم شاد می‌شم و قلبم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 314.56,
   "end": 320.28,
   "text": "غمگین می‌شه، دردمند می‌شه از اینکه ظلمی به کسی برسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 320.28,
   "end": 325.78,
   "text": "عینا این رو گفتن. خب اگر کسی این حالت رو نداره باز چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 325.78,
   "end": 327.48,
   "text": "قطعاً قلبش مریضه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 327.48,
   "end": 329.86,
   "text": "اینایی که می‌گن چرا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 329.86,
   "end": 334.16,
   "text": "مثلا انقدر به سوریه و عراق و یمن و بحرین و اینا شما می‌پردازید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 334.16,
   "end": 338.68,
   "text": "خب اینا معلومه دلش-- اینا کاملاً مشخصه دل مریض‌ان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 338.68,
   "end": 340.8,
   "text": "اگر دل سالم باشه نمی‌تونه ببینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 340.8,
   "end": 344.6,
   "text": "یه کودکی که به نام مثلا امل حسین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 344.6,
   "end": 348.68,
   "text": "اخیراً دیدید که فکر می‌کنم پنج شش سالش بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 348.68,
   "end": 352.82,
   "text": "دختر بچه. امل حسین، امل از آرزو میاد دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 352.82,
   "end": 355.48,
   "text": "یعنی آرزوش حسین علیه السلامه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 355.48,
   "end": 359.18,
   "text": "این بچه شیعه که باباش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 359.18,
   "end": 362.04,
   "text": "دو سال پیش براش یه گوشواره می‌خره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 362.04,
   "end": 364.56,
   "text": "می‌گه شاید من زنده نباشم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 364.56,
   "end": 368.8,
   "text": "به گوشت کن به گوشش می‌کنه و اخیراً این بچه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 368.8,
   "end": 373.46,
   "text": "از شدت گرسنگی و نبودن آب سالم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 373.46,
   "end": 378.12,
   "text": "انقدر لاغر میشه عکسش رو حتما دیدید دیگه قبل اینکه از دنیا بره و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 378.12,
   "end": 383.3,
   "text": "و بعضی وقتی که از دنیا میره. ده کیلو وقت از دنیا رفتنش ده کیلو وزن داشته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 383.3,
   "end": 385.6,
   "text": "یه پوست استخون ازش مونده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 385.6,
   "end": 387.9,
   "text": "چرا؟ چون تحت محاصره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 387.9,
   "end": 390.84,
   "text": "آل سعود و دشمنانن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 390.84,
   "end": 398.48,
   "text": "با این همه دب دبه و کبکبه و دم زدنشون از حقوق بشر و چه و چه اینطوری ظلم دارن می‌کنن به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 398.48,
   "end": 402.1,
   "text": "ملت مسلمان. بعد حالا آدم بی‌خیال باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 402.1,
   "end": 406.62,
   "text": "من یه شب مخصوصاً بچه‌هام گذاشتم شامشونو بخورن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 406.62,
   "end": 409.02,
   "text": "بعد از شام بلافاصله اینو بهشون نشون دادم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 409.02,
   "end": 411.68,
   "text": "گفتم ببینید این بچه‌ایه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 411.68,
   "end": 420.08,
   "text": "هم‌سن تقریباً شماهاست، غذا بهش نرسیده، بچه شیعه هم هست، از گرسنگی تلف شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 420.08,
   "end": 424.06,
   "text": "و بهشون یاد دادم که باید دردمندانه نسبت به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 424.06,
   "end": 426.46,
   "text": "مسلمونای جهان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 426.46,
   "end": 431.86,
   "text": "به فکر باشید. یعنی اینطوری نباشه که ما حالا ما شکممون سیر باشه جهنم هرکی هرچی شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 431.86,
   "end": 438.28,
   "text": "این معلومه که دل مریضه. اگر دلی مریض شد بی‌تفاوت نسبت به جهان اسلام میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 438.28,
   "end": 441.9,
   "text": "همینطور هر خیر و سروری به دیگران رسید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 441.9,
   "end": 446.76,
   "text": "نباید آدم حسرت ببرزه، ناراحت بشه، باید کیف کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 446.76,
   "end": 449.34,
   "text": "بر چی حسرت ببرزه نسبت به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 449.34,
   "end": 455.86,
   "text": "درجات علمی، معنوی، جسمی، نمی‌دونم رشد‌های اجتماعی، مالی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 455.86,
   "end": 458.9,
   "text": "همه اینکه انسانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 458.9,
   "end": 461.92,
   "text": "به جایی به رشدی چیزی برسه اگر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 461.92,
   "end": 466.66,
   "text": "دل در سلامت کامل باشه کیف می‌کنه انگار خودش رسیده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 466.66,
   "end": 470.16,
   "text": "امروز تو یه برنامه دیدم یه نفر پیامک زده بود که ما،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 470.16,
   "end": 474.02,
   "text": "من و شوهرم هم، زنه پیامک زده بود که من و شوهرم کیف کردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 474.02,
   "end": 482.4,
   "text": "من و شوهرم یک سوم درآمدمونو همون اول حقوقمونو می‌گیریم، همون اول یک سومشو می‌ذاریم کنار برای کمک به دیگران.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 482.4,
   "end": 488.36,
   "text": "توی این فشار اقتصادی تو، در جایی که بعضیا بی‌رحمی می‌کنن، احتکار می‌کنن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 488.36,
   "end": 492.32,
   "text": "و فقط به فکر خودشونن، این‌ها اینچنین به فکر مردمن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 492.32,
   "end": 495.38,
   "text": "خب خدا هم به اینا رحم می‌کنه. خدا هم به اینا قلب سلیم میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 495.38,
   "end": 501.64,
   "text": "چرا نده؟ انشاالله خدا هممون رو آگاه و بیدار کنه و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 501.64,
   "end": 503.44,
   "text": "به وظایفمون توفیق عمل بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 503.44,
   "end": 505.26,
   "text": "عاقبتمون ختم بخیر بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 505.26,
   "end": 508.36,
   "text": "به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 508.36,
   "end": 515.58,
   "text": "اللهم صل على محمد و آل محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}