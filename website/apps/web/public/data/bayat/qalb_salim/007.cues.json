 ],
 "cues": [
  {
   "i": 0,
   "start": 0.34,
   "end": 3.64,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 3.64,
   "end": 8.4,
   "text": "السلام علیک یا داعی الله و ربانی ایه آیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 8.4,
   "end": 12.36,
   "text": "سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 12.36,
   "end": 17.82,
   "text": "یکی دیگه از استفتائاتی که از رهبر عزیز شده اینه که آیا گرفتن این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 17.82,
   "end": 20.72,
   "text": "جوایزی که بر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 20.72,
   "end": 27.02,
   "text": "بعضی از وام‌ها یا مثلاً قرض‌الحسنه تو بانک میگن این مقدار بذار بعد این جایزه ها رو داره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 27.02,
   "end": 29.7,
   "text": "آیا گرفتن این جایزه‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 29.7,
   "end": 36.6,
   "text": "اشکالی داره؟ یا اگر هم می‌گیریم خمس بهش تعلق می‌گیره یا نه به این جایزه‌ها؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 36.6,
   "end": 38.66,
   "text": "حالا یا به قرض‌الحسنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 38.66,
   "end": 43.74,
   "text": "یا به هر تسهیلاتی یا سپرده‌گذاری کوتاه مدت و بلندمدت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 43.74,
   "end": 46.38,
   "text": "در هر حال جایزه ای که بانک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 46.38,
   "end": 52.18,
   "text": "در پس این‌ها می‌ده. آقا فرمودن نخیر بی‌اشکال است گرفتن این جوایز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 52.18,
   "end": 56.34,
   "text": "و این جایزه‌ها خمس هم ندارد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 56.34,
   "end": 60.4,
   "text": "بحث ما قلب سلیم بود و دیروز عرض کردیم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 60.4,
   "end": 68.8,
   "text": "یکی از بزرگ‌ترین ابتلاءات و امتحانات بزرگی که خدای منان از ما گرفته در ایام غیبت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 68.8,
   "end": 72.56,
   "text": "در اونم سه وجه غیبت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 72.56,
   "end": 74.66,
   "text": "غیبت در وجه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 74.66,
   "end": 79.86,
   "text": "جسم امام، غیبت در کلمه، غیبت کلمه الغیب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 79.86,
   "end": 87.86,
   "text": "و بحث در پس پرده ظلمت ولایت طاغوت قرار گرفتن ولایت امام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 87.86,
   "end": 93.3,
   "text": "این امتحان بزرگی بوده که از شیعه پس گرفته شده و تنها کسی تونسته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 93.3,
   "end": 97.3,
   "text": "بر این در زمان غیبت بر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 97.3,
   "end": 101.6,
   "text": "امامت امام و ولایت امام باقی بمونه که قلب سلیم داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 101.6,
   "end": 105.42,
   "text": "یعنی تسلیم امام و اوامر اوست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 105.42,
   "end": 107.9,
   "text": "به غیر از این نمی‌شه. حالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 107.9,
   "end": 110.66,
   "text": "امروز عرض کنیم دلیل عمده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 110.66,
   "end": 113.24,
   "text": "جدا شدن از صف امام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 113.24,
   "end": 118.6,
   "text": "چیه؟ کسانی که در زمان غیبت از امام فارغ می‌شن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 118.6,
   "end": 122.48,
   "text": "مشکل اصلیشون چیه؟ باز هم بر می‌گرده به همون بحث قلب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 122.48,
   "end": 125.72,
   "text": "مثال غیبت زمان موسی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 125.72,
   "end": 129.58,
   "text": "خیلی مثال قشنگ و خوب و قرآنی و شسته رفته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 129.58,
   "end": 132.64,
   "text": "که من آیه شو براتون می‌خونم. ببینید چقدر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 132.64,
   "end": 141.46,
   "text": "عجیبه این قصه. وقتی حضرت موسی علی نبینا و آله و علیه الصلاة والسلام رفت به کوه طور،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 141.46,
   "end": 146.78,
   "text": "اینجا خدای منان می‌فرماید که \"و اذ اخذنا\" آیه نود و سه سوره بقره است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 146.78,
   "end": 150.12,
   "text": "\"و اذ اخذنا ميثاقكم\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 150.12,
   "end": 153.28,
   "text": "یاد بیارید اون وقتی که ما از شما میثاقی گرفتیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 153.28,
   "end": 156.7,
   "text": "\"و رفعنا فوقكم الطور\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 156.7,
   "end": 159.32,
   "text": "کوه طور رو بالا سر شما قرار دادیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 159.32,
   "end": 162.04,
   "text": "\"خذوا ما آتيناكم بقوة\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 162.04,
   "end": 167.0,
   "text": "گفتیم بگیرید اونچه که بر شما وارد شده با قدرت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 167.0,
   "end": 169.42,
   "text": "اونم نمیگه مثلاً آتيناكم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 169.42,
   "end": 172.08,
   "text": "مثلاً تورات. اینطوری نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 172.08,
   "end": 177.12,
   "text": "میگه هرچی که اومده، هرچی بر شما وارد شده رو به قوت بگیرید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 177.12,
   "end": 180.0,
   "text": "حالا اینا چی گفته-- بعد می‌فرماید \"و اسمعوا\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 180.0,
   "end": 185.06,
   "text": "بشنوید حرف ما رو. حالا اینا چی گفتن در جواب این امر خدا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 185.06,
   "end": 187.88,
   "text": "\"قالوا\" اینا گفتن \"سمعنا\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 187.88,
   "end": 190.58,
   "text": "عجیب اینجاست \"وعصينا\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 190.58,
   "end": 193.22,
   "text": "گفتن باشه ما شنیدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 193.22,
   "end": 195.66,
   "text": "\"وعصينا\" دیگه چیه اینجا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 195.66,
   "end": 201.54,
   "text": "یعنی ما عصیان کردیم. حالا بعضیا گفتن این تو قلبشون پدیدار شد بعضیا گفتن نه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 201.54,
   "end": 203.58,
   "text": "این شیطنت به زبانشون هم جاری شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 203.58,
   "end": 209.2,
   "text": "در هر حال با پررویه تمام گفتن باشه شنیدیم اما ما کار خودمون رو می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 209.2,
   "end": 213.7,
   "text": "\"عصينا\" ما اون راهی که شما بهش می‌گید عصیان رو می‌ریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 213.7,
   "end": 221.42,
   "text": "چرا؟ به چه دلیلی این‌ها صفشون رو در غیبت موسی، چهل روز هم بیشتر غیبت نکرد، جدا کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 221.42,
   "end": 224.62,
   "text": "صراحتاً قرآن می‌فرماید \"وشربوا\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 224.62,
   "end": 228.38,
   "text": "اشراب شد. چی؟ \"في قلوبهم\" تو دل‌هاشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 228.38,
   "end": 230.84,
   "text": "این دل‌های این‌ها بحث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 230.84,
   "end": 234.68,
   "text": "ذات این‌هاست. ذات هر کسی رو دلش تشکیل میده دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 234.68,
   "end": 237.5,
   "text": "سرمایه هر کسی دلشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 237.5,
   "end": 240.44,
   "text": "میگه \"وشربوا في قلوبهم\" چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 240.44,
   "end": 243.72,
   "text": "\"العجل\". عجل حالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 243.72,
   "end": 245.92,
   "text": "گوساله است. اون گوساله ای است که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 245.92,
   "end": 248.04,
   "text": "اون‌ها حالا توضیح میدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 248.04,
   "end": 250.62,
   "text": "\"بكفرهم\" این‌ها البته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 250.62,
   "end": 253.52,
   "text": "به کفر و پوشوندن رو حق این کار رو کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 253.52,
   "end": 256.76,
   "text": "\"قل بعث الله امرا بكم به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 256.76,
   "end": 258.88,
   "text": "ايمانكم ان كنتم مؤمنين\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 258.88,
   "end": 260.52,
   "text": "چه بسیار کار زشتی کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 260.52,
   "end": 264.9,
   "text": "حالا جالبه اینجا نمی‌فرماید \"وشربوا في قلوبهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 264.9,
   "end": 269.26,
   "text": "حب العجل\". میگه \"وشربوا في قلوبهم العجل\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 269.26,
   "end": 273.54,
   "text": "اون گوساله در دلشون پر شده بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 273.54,
   "end": 280.12,
   "text": "یعنی دل این‌ها \"اشربوا\" اشراب شده بود قلبشون از گوساله، پر شده بود از گوساله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 280.12,
   "end": 283.9,
   "text": "یعنی چی؟ حتی نمیگه حب گوساله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 283.9,
   "end": 286.16,
   "text": "حالا قصه گوساله چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 286.16,
   "end": 288.74,
   "text": "قصه‌ش خلاصه‌ش اینه که وقتی این‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 288.74,
   "end": 292.36,
   "text": "خدا دستور داد به بنی اسرائیل که شبانه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 292.36,
   "end": 295.74,
   "text": "طرفدارای خود حضرت موسی سلام الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 295.74,
   "end": 300.54,
   "text": "علیه راه بیفتید برید که فرعون دنبال سر شماست ما شما رو نجات میدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 300.54,
   "end": 308.06,
   "text": "اینا تو روایت داره که شروع کردن هرچی می‌تونستن طلا و سکه و اینا با خودشون برداشتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 308.06,
   "end": 310.24,
   "text": "هرچی می‌تونستن طلا، چیز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 310.24,
   "end": 313.72,
   "text": "دیگه‌ای برنداشتن. طلاجاتشونو برداشتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 313.72,
   "end": 317.12,
   "text": "به پیداست که این‌ها به طلا خیلی علاقه‌مند بودن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 317.12,
   "end": 323.2,
   "text": "یعنی حب به این طلا یا که نماد دنیاست تو دلشون افتاده بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 323.2,
   "end": 326.04,
   "text": "آ این تب-- بعد سامری اینو متوجه بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 326.04,
   "end": 331.5,
   "text": "آدم زیرکی بوده. فهمید که این‌ها با خودشون طلا زیاد برداشتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 331.5,
   "end": 336.84,
   "text": "وقتی که رسیدن به اون محلی که مستقر شدن گفت خب این طلا و موسی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 336.84,
   "end": 339.14,
   "text": "رفت به میقات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 339.14,
   "end": 343.6,
   "text": "گفت این طلاهاتونو بدید من با براتون یه چیزی از همین طلای خودتون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 343.6,
   "end": 347.96,
   "text": "یه چیزی، یه نمادی چیزی درست کنم که هر روز می‌بینیدش کیف کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 347.96,
   "end": 350.54,
   "text": "با طلاهای خود این‌ها،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 350.54,
   "end": 352.72,
   "text": "این طلاها رو گرفت ذوب کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 352.72,
   "end": 355.96,
   "text": "یه گوساله به جنس طلا ساخت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 355.96,
   "end": 359.68,
   "text": "بعد جالبه که خب معلومه آدم زیرکی بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 359.68,
   "end": 365.1,
   "text": "در یه روایت میگه از اثر پای جبرائیل دیده بود که جبرائیل نازل شده بر موسی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 365.1,
   "end": 373.7,
   "text": "بعضیا میگن نه از اثر پای خود حضرت موسی روی زمین که متبرک بود این خاک زیر پای رسول خدا رو برداشت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 373.7,
   "end": 375.84,
   "text": "ریخت تو دهان این گوساله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 375.84,
   "end": 378.0,
   "text": "و صدا می‌کرد این گوساله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 378.0,
   "end": 382.72,
   "text": "این‌ها خیلی خوششون اومد و استغفرالله اینو خدا پنداشتن دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 382.72,
   "end": 389.58,
   "text": "که صدا می‌کنه و بعد حالا ا-علت اصلی که این‌ها در برابر این گوساله سجده کردن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 389.58,
   "end": 392.76,
   "text": "و به قول ما عشقشون شد این گوساله چی بود؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 392.76,
   "end": 395.94,
   "text": "صراحتا میگه \"عشرة في قلوبهم العجل\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 395.94,
   "end": 397.76,
   "text": "جنس این گوساله از چی بود؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 397.76,
   "end": 399.84,
   "text": "طلا. از چه طلاهایی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 399.84,
   "end": 402.76,
   "text": "طلاهایی که خود اینا، مال خود اینا بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 402.76,
   "end": 407.64,
   "text": "اگر از طلاهای خود سامری بود اینا اینطور علاقه نشون نمی‌دادن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 407.64,
   "end": 410.34,
   "text": "چون از طلاهای خود این‌ها بود یک.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 410.34,
   "end": 412.88,
   "text": "دو، جنسش نماد دنیا بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 412.88,
   "end": 414.96,
   "text": "چیزی بود که اینا خوششون میاد ازش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 414.96,
   "end": 418.28,
   "text": "همه‌ی وجودشون اشباع شده بود، قلبشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 418.28,
   "end": 422.1,
   "text": "از این گوساله پر شده بود در دلشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 422.1,
   "end": 424.48,
   "text": "خود گوساله یعنی خود اون طلاها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 424.48,
   "end": 428.48,
   "text": "نه تازه حبش. اصلا به عشق اون نفس می‌کشیدند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 428.48,
   "end": 431.66,
   "text": "لذا این به این انحراف یعنی تو، به انحراف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 431.66,
   "end": 439.92,
   "text": "کفر و شرک و عرض کنم بت‌پرستی رفتن که هیچی دست از موسی هم کشیدند و اون انحراف ششصد هزار نفری رخ داد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 439.92,
   "end": 444.7,
   "text": "که از عجائبه که به این سرعت ششصد هزار نفر بت‌پرست بشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 444.7,
   "end": 446.98,
   "text": "این چیزی نیست جز حب دنیا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 446.98,
   "end": 453.62,
   "text": "حالا من فکر می‌کردم این مثلا ضریح سیدالشهدای که رو به روی شما قرار گرفته اینجا این نمادش برای چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 453.62,
   "end": 455.42,
   "text": "جز حب قلبی این‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 455.42,
   "end": 457.94,
   "text": "حالا یکی حب امام حسین تو دلشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 457.94,
   "end": 461.28,
   "text": "یکی خود آقا تو دلشه. اصلا با آقا نفس می‌کشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 461.28,
   "end": 464.18,
   "text": "این‌ها هم باز درجاتش فرق می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 464.18,
   "end": 466.68,
   "text": "ببین این چرا اینجا گذاشته شده؟ نماده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 466.68,
   "end": 470.78,
   "text": "اگر کسی که نماد دنیا تو دلشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 470.78,
   "end": 472.44,
   "text": "اصلاً توجه به این نمی‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 472.44,
   "end": 477.14,
   "text": "اینم شاید می‌بینه اما اصلاً چشمش به این نیست، چیز دیگه‌ای می‌بینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 477.14,
   "end": 482.74,
   "text": "ببینید شما تو خونه‌هامون اگر برید پیشانی خونه‌ی ما نشون میده دل ما به چه سمتیه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 482.74,
   "end": 487.2,
   "text": "چی رو پیشانی خانه قرار بدیم، چه عکسی رو، چه نمادی رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 487.2,
   "end": 491.16,
   "text": "حتی من بعضیا رو دیدم، یه کپی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 491.16,
   "end": 495.22,
   "text": "رنگی از یه سکه گرفتن، یه سکه به هر حال از طلا، طلا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 495.22,
   "end": 498.02,
   "text": "اونو تابلو کردن بزرگ تو خونه‌شون زدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 498.02,
   "end": 504.46,
   "text": "دیدما. یا مثلاً اسکناس‌های زمان قدیم شاهو با همون عکس شاه بزرگ کردن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 504.46,
   "end": 509.4,
   "text": "زدن تو خونه‌شون. خب این مشخصه که دلش به چه سمتی متمایله دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 509.4,
   "end": 512.62,
   "text": "تا کسی که مثلاً بیاد عکس رهبری، عکس شهدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 512.62,
   "end": 517.64,
   "text": "تازه بعضیا اینم می‌زنن که دیگه اصلاً توجه به این ندارن که اون اصلاً--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 517.64,
   "end": 521.48,
   "text": "بعضی مخصوصا این مدیرایی که تو دفتراشون عکس امام و رهبر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 521.48,
   "end": 524.6,
   "text": "بزرگ زده شده باور کن اگه ازش بری بپرسی یا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 524.6,
   "end": 528.72,
   "text": "یه حدیثیه بخشی از نهج‌البلاغه بغل عکس آقا من دیدم خورده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 528.72,
   "end": 532.0,
   "text": "ازش بپرسی بالا سرت، دفتر تو، تو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 532.0,
   "end": 534.34,
   "text": "محیط کارت، اونجایی که می‌شینی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 534.34,
   "end": 537.5,
   "text": "میزت چی زده؟ هرچی فکر کنه یادش نمیاد چی زده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 537.5,
   "end": 539.26,
   "text": "اصلا توجه نداره اونجا چی خورده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 539.26,
   "end": 542.34,
   "text": "چرا؟ چون عکس اون رو داره عمل می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 542.34,
   "end": 544.64,
   "text": "بسیاری از مدیران ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 544.64,
   "end": 548.12,
   "text": "عکس اون چیزی که واقعا رهبر می‌فرماید،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 548.12,
   "end": 552.72,
   "text": "انقلاب ما می‌فرماید، امیرالمؤمنین تو نهج‌البلاغه می‌فرماید، دارن عمل می‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 552.72,
   "end": 558.9,
   "text": "بسیاری از مشکلات اقتصادی، فرهنگی و حتی سیاسی ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 558.9,
   "end": 562.34,
   "text": "به جهت بی‌تدبیری بعضی از مدیران کلان ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 562.34,
   "end": 564.14,
   "text": "این دیگه برای همه ما مسجل شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 564.14,
   "end": 566.96,
   "text": "رهبری هم فرمودن چیز عجیبی نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 566.96,
   "end": 569.26,
   "text": "در هر حال اون نماده مهمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 569.26,
   "end": 572.12,
   "text": "ببینید اینجا داره میگه نماد دنیاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 572.12,
   "end": 580.72,
   "text": "این \"عشرة في قلوبهم العجل\" باعث شد در زمان غیبت پیغمبر این‌ها فاصله بگیرن برن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 580.72,
   "end": 583.88,
   "text": "به سمت ناکجا آباد و شرک و بت‌پرستی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 583.88,
   "end": 588.82,
   "text": "ما هم اگر خدایی نکرده دلمون اشباع بشه از نماد دنیا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 588.82,
   "end": 591.2,
   "text": "یعنی به سمت ولایت طاغوت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 591.2,
   "end": 594.98,
   "text": "که همون نماد اصلی دنیاست، حقیقت دنیاست اصلاً.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 594.98,
   "end": 600.06,
   "text": "قطعا از امام جدا خواهیم شد و در زمان غیبت خودمون رو می‌بازیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 600.06,
   "end": 602.54,
   "text": "اون عجل میشه گفت همون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 602.54,
   "end": 607.82,
   "text": "یک نمادی بوده از همون ولایت طاغوت که بعضی از مفسرین هم این چنین فرمودن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 607.82,
   "end": 610.76,
   "text": "ولایت ائمه کفر که الان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 610.76,
   "end": 615.24,
   "text": "دیگه آخر دنیا به قول خودشون همین لیبرال دموکراسیه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 615.24,
   "end": 619.72,
   "text": "همین آزادی بی‌بند و باری شهوت‌رانی و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 619.72,
   "end": 623.5,
   "text": "این چیزاست که یعنی دیگه جوون تا آخر خطش رفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 623.5,
   "end": 626.12,
   "text": "دیگه حرفی برای گفتن ندارن امروز.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 626.12,
   "end": 628.82,
   "text": "تمام. ولی ما تازه اول قصه‌مونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 628.82,
   "end": 631.14,
   "text": "وقتی انشاالله حضرت ظهور کنن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 631.14,
   "end": 633.48,
   "text": "وقتی این سه تا پرده از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 633.48,
   "end": 635.58,
   "text": "جسم حضرت از کلمه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 635.58,
   "end": 637.78,
   "text": "غیب که معارف حضرت هست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 637.78,
   "end": 641.46,
   "text": "و اون پرده ظلمتی که روی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 641.46,
   "end": 647.2,
   "text": "خود ولایت حضرت هست برداشته بشه که کل دنیا رو ملء از ظلمة وجوه را گرفته،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 647.2,
   "end": 649.72,
   "text": "اون موقع تازه سیرابی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 649.72,
   "end": 652.22,
   "text": "تشنه‌گان معرفت و ولایت شروع می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 652.22,
   "end": 654.58,
   "text": "تازه اول کاره. ولی اینا آخر کارشونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 654.58,
   "end": 657.16,
   "text": "دیگه حرفی برای گفتن ندارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 657.16,
   "end": 659.22,
   "text": "انشاالله که عاقبتمون ختم به خیر بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 659.22,
   "end": 662.52,
   "text": "به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 662.52,
   "end": 666.02,
   "text": "اللهم صل على",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 666.02,
   "end": 670.44,
   "text": "محمد و آل محمد و عجل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}