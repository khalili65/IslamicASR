 },
 "chapters": [
  {
   "index": 0,
   "title": "## خرید قسطی از بانک مسکن؛ فتوای رهبری",
   "start": 1.46,
   "end": 51.08
  },
  {
   "index": 1,
   "title": "## قلب سلیم؛ تمییز و غربال روزگار",
   "start": 51.08,
   "end": 102.24
  },
  {
   "index": 2,
   "title": "## قلبی لقلبکم سلم؛ تعلقات همسو با امام",
   "start": 102.24,
   "end": 151.26
  },
  {
   "index": 3,
   "title": "## راحل الی الله نه مسافر؛ آداب زیارت مجلسی",
   "start": 151.26,
   "end": 602.14
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 1.46,
   "end": 5.1,
   "text": "بسم الله الرحمن الرحیم و بهی نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 5.1,
   "end": 8.88,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 8.88,
   "end": 13.52,
   "text": "آیاته. سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 13.52,
   "end": 16.98,
   "text": "استفتاء شده از رهبر عزیزمون که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 16.98,
   "end": 19.44,
   "text": "بانک مسکن برای ما منزلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 19.44,
   "end": 22.92,
   "text": "می‌خره و به صورت قسطی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 22.92,
   "end": 26.56,
   "text": "ما موظف می‌شیم پول این خونه رو برگردونیم به بانک.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 26.56,
   "end": 31.52,
   "text": "آیا ما مالک این منزل حساب می‌شیم و اصلاً این معامله شرعیه یا نه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 31.52,
   "end": 36.6,
   "text": "آقا فرمودن اگر بانک مسکن ابتدا به ساکن این مس-- این خونه رو برای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 36.6,
   "end": 41.4,
   "text": "خودش بخره بعد به شما قسطی بفروشه اشکال نداره و شما مالک حساب می‌شید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 41.4,
   "end": 47.78,
   "text": "پس بانک باید اول اون ملک رو، اون مغازه رو هرچی که هست بخره برای خودش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 47.78,
   "end": 51.08,
   "text": "بعد قسطی به شما بفروشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 51.08,
   "end": 53.68,
   "text": "در خصوص قلب سلیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 53.68,
   "end": 56.9,
   "text": "نکته‌ی دیگه‌ای رو هم به فضل الهی عرض کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 56.9,
   "end": 60.84,
   "text": "اونم اینکه در بحث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 60.84,
   "end": 64.76,
   "text": "تَمَيَّزُونَ لَيَمِيزَ اللَّهُ خَبِيثَ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 64.76,
   "end": 72.34,
   "text": "لَيَمِيزَ اللَّهُ الْخَبِيثَ مِنَ الطَّيِّبِ که در قرآن می‌فرماید بالاخره باید خبیث و طیب از هم جدا شن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 72.34,
   "end": 74.58,
   "text": "و بعد تَمَحَّزُونَ که این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 74.58,
   "end": 79.28,
   "text": "شرک‌های درون انسان باید بالاخره پاک شه و تَغَرْبَلُونَ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 79.28,
   "end": 84.86,
   "text": "که امام صادق سلام الله عليه سه بار این جمله رو آوردن البته ما قبلاً عرض کردیم دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 84.86,
   "end": 91.58,
   "text": "توی غربال روزگار تنها کسی می‌تونه پشت سر امامش حرکت کنه و با امامش باشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 91.58,
   "end": 93.7,
   "text": "که صاحب قلب سلیم باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 93.7,
   "end": 96.28,
   "text": "یعنی قلبش تسلیمه به امامش باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 96.28,
   "end": 102.94,
   "text": "برای همین ما در زیارت اربعین یکی از عهدنامه‌ای که امضا می‌زنیم دو مرتبه در زیارت قلبی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 102.94,
   "end": 105.12,
   "text": "لقلبکم سلم هست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 105.12,
   "end": 114.24,
   "text": "که توضیحش رو دادیم و این قصه به قدری حساس هست که کسی مثل سلمان با اون عظمت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 114.24,
   "end": 117.94,
   "text": "که يعلمنه من",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 117.94,
   "end": 122.52,
   "text": "سر المکنون دیگه. در حقیقت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 122.52,
   "end": 125.26,
   "text": "یا من مکنون سره اینو،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 125.26,
   "end": 128.04,
   "text": "اینو هم داریم که فرمودن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 128.04,
   "end": 131.26,
   "text": "این يعلمنه برمی‌گرده به پیغمبر و امیرالمؤمنین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 131.26,
   "end": 137.74,
   "text": "یعنی سلمان به مقامی رسیده بود که پیغمبر و امیرالمؤمنین دائماً بهش از اسرار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 137.74,
   "end": 140.66,
   "text": "تعلیم می‌دادن. ش--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 140.66,
   "end": 143.6,
   "text": "اسم اعظم بلد بوده سلمان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 143.6,
   "end": 146.3,
   "text": "بسیار شخصیت والا و وارسته‌ای داشته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 146.3,
   "end": 147.92,
   "text": "اونم از کی تعلیم ببینه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 147.92,
   "end": 155.68,
   "text": "از امیرالمؤمنین که خود مولا در خطبه‌شون فرمودن سن-- سينهدر یا ينهدر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 155.68,
   "end": 159.3,
   "text": "ان السيل از من این سیل معارف و خ--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 159.3,
   "end": 162.4,
   "text": "سیل خروشان معارف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 162.4,
   "end": 164.74,
   "text": "در جریان است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 164.74,
   "end": 169.08,
   "text": "و هرکی می‌تونه از اون اس-- و البته فرمودن لا یلقى علیه ط--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 169.08,
   "end": 176.06,
   "text": "پرنده نمی‌تونه هیچ عقلی، هیچ ش-- هیچ کسی، پرنده‌ی وجود هیچ کسی نمی‌تونه به قله من دست پیدا کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 176.06,
   "end": 179.1,
   "text": "یه همچین کسی معلم سلمان می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 179.1,
   "end": 181.46,
   "text": "با این حال سلمان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 181.46,
   "end": 185.68,
   "text": "وقت غربال روزگار روایت عجیبی داریم که یک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 185.68,
   "end": 189.0,
   "text": "آن نه اینکه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 189.0,
   "end": 192.36,
   "text": "استغفرالله برگرده مثلاً اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 192.36,
   "end": 195.14,
   "text": "از قلب سلیم فارغ بشه اما یک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 195.14,
   "end": 200.94,
   "text": "آن میگن یه نقطه تو قلبش یه خلجانی چی بگم ایجاد می‌شه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 200.94,
   "end": 206.1,
   "text": "نسبت به امیرالمؤمنین. متعجب می‌شه در حقیقت که مولا این تا--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 206.1,
   "end": 207.92,
   "text": "این توقع رو نداشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 207.92,
   "end": 212.42,
   "text": "اونم وقتی که قصه‌ی کوچه پیش میاد سلمان حاضر بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 212.42,
   "end": 219.56,
   "text": "خب می‌گه مولا امیرالمؤمنین با این عظمت که خود ایشون حقیقت اسم اعظم عالمان، خب جسارت به حضرت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 219.56,
   "end": 221.96,
   "text": "صدیقه طاهره سلام الله علیها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 221.96,
   "end": 226.66,
   "text": "چیز کمی نیست. خب مقام شامخ حضرت زهرا رو سلمان می‌شناخت دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 226.66,
   "end": 228.56,
   "text": "ولی دید امیرالمؤمنین سکوت کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 228.56,
   "end": 233.1,
   "text": "اینجا یک لحظه سلمان میگن تو ذهنش خلجانی تو قلبش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 233.1,
   "end": 237.1,
   "text": "یه به قول ما استپی پیش اومده و یه نقطه‌ای ایجاد شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 237.1,
   "end": 242.26,
   "text": "همونجا امیرالمؤمنین در حالی که می‌بردن مولا رو برگشت نگاه به سلمان کرد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 242.26,
   "end": 246.54,
   "text": "و فرمود سلمان به عهدی که با من داشتی تجدید کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 246.54,
   "end": 251.04,
   "text": "تجدید عهد کن. دو مرتبه عهدت رو تجدید کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 251.04,
   "end": 254.12,
   "text": "یه خلجانی در بحث ولایت ایجاد-- ببینید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 254.12,
   "end": 259.02,
   "text": "یک آنه. اگر کسی قلب سلیم نداشته باشه می‌بره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 259.02,
   "end": 263.5,
   "text": "می‌بره میره. نه اینکه مکی-- مثل یک، مثلاً سلمان یک آنی یه لحظه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 263.5,
   "end": 265.74,
   "text": "متوقف بشه یا متعجب بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 265.74,
   "end": 270.28,
   "text": "نه، اصلاً ول می‌کنه میره. جریان روزگار این چنینه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 270.28,
   "end": 274.26,
   "text": "و ما عرض کردیم قلبی لقلبکم سلم برمی‌گرده به تعلقات قلبی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 274.26,
   "end": 277.24,
   "text": "اگر کسی نسبت به امامش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 277.24,
   "end": 282.52,
   "text": "یا به امام معصوم و امام عصرش یا حتی ابا عبدالله سلام الله عليه که رفته زیارتش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 282.52,
   "end": 287.9,
   "text": "تعلقاتش با او همسو نباشه، یک روزی سر یه قصه‌ای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 287.9,
   "end": 294.6,
   "text": "وقتی دید تعارض پیدا شد بین تعلقات قلبی خودش و امامش صفش رو جدا می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 294.6,
   "end": 298.44,
   "text": "اونم تو غربالگری روزگار این رخ می‌ده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 298.44,
   "end": 303.72,
   "text": "شما تو بحث آداب زیارت مرحوم مجلسی اگر دقت کرده باشید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 303.72,
   "end": 306.16,
   "text": "تا جایی ایشون پیش میره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 306.16,
   "end": 312.02,
   "text": "که می‌گه وقتی شما داری میری به سمت ابا عبدالله الحسین برای زیارت باید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 312.02,
   "end": 314.9,
   "text": "راحل الی الله باشی، نه مسافر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 314.9,
   "end": 317.62,
   "text": "مسافر وطن پشت سرشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 317.62,
   "end": 320.72,
   "text": "جایی که میره قصد توتون نمی‌کنه که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 320.72,
   "end": 324.86,
   "text": "وطنش رو پشت سرش می‌ذاره. لذا برنامه‌ریزی می‌کنه برای برگشتش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 324.86,
   "end": 329.04,
   "text": "اما راحل الی الله در حال کوچ الی الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 329.04,
   "end": 333.82,
   "text": "اصلاً وطن روبه‌روشه. لذا در حرم ابی عبدالله نماز رو کامل می‌خونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 333.82,
   "end": 337.04,
   "text": "می‌ره اونجا توتون کنه، قصد توتون کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 337.04,
   "end": 342.08,
   "text": "میره که برنگرده و اگر مجبوره به برگشت شد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 342.08,
   "end": 346.5,
   "text": "برنامه‌ریزی می‌کنه برای اینکه دو مرتبه به اربابش برگشت کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 346.5,
   "end": 351.22,
   "text": "این سر زیارت که من-- مرحوم مجلسی می‌فرماید این وقتی حاصل می‌شه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 351.22,
   "end": 355.32,
   "text": "که تو از تمام تعلقاتت بکنی، تعلقات قلبی‌ت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 355.32,
   "end": 359.16,
   "text": "بعد اشاره می‌کنه به آیه جریان حضرت موسی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 359.16,
   "end": 366.86,
   "text": "که وقتی به سمت مصر حرکت می‌کرد با همسرشون، خب همسرشون تو راه درد مخاض گرفت، باردار بود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 366.86,
   "end": 370.16,
   "text": "هوا هم سرد بود شب زمستان و تاریک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 370.16,
   "end": 373.46,
   "text": "به سمت مصر و فرعون هم در حرکت بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 373.46,
   "end": 374.96,
   "text": "اون آتیش رو وقتی از راه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 374.96,
   "end": 377.96,
   "text": "دور دید گفت بذارید برم ببینم یا کسی رو می‌بینم راه رو گم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 377.96,
   "end": 382.62,
   "text": "کرده بودن یا حداقل یه آتیش برای شما تهیه می‌کنم تو این سرما رفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 382.62,
   "end": 386.8,
   "text": "اونجا تو روایت داریم زیر این آیه \"فخلع نعليك",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 386.8,
   "end": 390.0,
   "text": "إنك بالواد المقدس طوى\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 390.0,
   "end": 393.32,
   "text": "این مق-- وادی مقدس کربلا بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 393.32,
   "end": 397.06,
   "text": "اون شجره ابی عبدالله الحسین سلام الله عليه بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 397.06,
   "end": 401.9,
   "text": "این خلع نعال یعنی بکن کفشاتو دو تا نعلین،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 401.9,
   "end": 406.9,
   "text": "دو تا نعل در پای ایشون بوده اشاره به اون دو تا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 406.9,
   "end": 409.9,
   "text": "دل-- حالا میشه گفت تعلق قلبی‌ش بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 409.9,
   "end": 412.34,
   "text": "یکی از پیش، یکی از پس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 412.34,
   "end": 417.34,
   "text": "از پیش به زن و بچه‌ش تعلق خاطر داشت، نگران حال اونا بود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 417.34,
   "end": 419.96,
   "text": "که وضع خانمم چی می‌شه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 419.96,
   "end": 422.76,
   "text": "و روبرو نگران قصه فرعون بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 422.76,
   "end": 426.4,
   "text": "\"اذهب الی فرعون فإنه طغى\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 426.4,
   "end": 429.24,
   "text": "نگران این دو تا بود. اینجا بهش گفتن بکن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 429.24,
   "end": 432.22,
   "text": "تو اومدی وادی کربلا نگران چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 432.22,
   "end": 436.12,
   "text": "این تعلقاتو تا نکنی تو زائر حساب نمی‌شی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 436.12,
   "end": 438.46,
   "text": "بعد اونجا فرمود \"إنني أنا الله\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 438.46,
   "end": 441.66,
   "text": "من خدای توام. اس-- و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 441.66,
   "end": 444.76,
   "text": "\"و استنعتك لنفسي\" اونجاست اتفاق افتاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 444.76,
   "end": 446.5,
   "text": "خدا او را برگزید. کی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 446.5,
   "end": 450.18,
   "text": "وقتی که خلع نعال صورت گرفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 450.18,
   "end": 452.82,
   "text": "یعنی کفش‌هاشو کند. در حقیقت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 452.82,
   "end": 456.46,
   "text": "باطن این آیه برمی‌گرده به کندن تعلقات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 456.46,
   "end": 463.52,
   "text": "چون موسی اق-- پیش خدا اعلان کرد که من تمام وجودم غرق محبت توئه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 463.52,
   "end": 466.34,
   "text": "من خالص کردم خودم رو برای تو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 466.34,
   "end": 470.98,
   "text": "می‌خوام در خدمت تو باشم. خدا اینجا بهش ثابت کرد این دو تا تعلق هنوز تو قلبت مونده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 470.98,
   "end": 477.74,
   "text": "اینا رو بکن. اونم اینجا تو شج-- توی وادی ایمن کربلا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 477.74,
   "end": 486.06,
   "text": "می‌خوام عرض کنم که حتی حالا مرحوم مجلسی اشاره به این می‌کنه می‌گه کسی راحل الی الله و کسی زائر واقعیه و کسی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 486.06,
   "end": 491.5,
   "text": "اون شصت هزار قدم از فرات تا حرم اباعبدالله که قص می‌کنه میره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 491.5,
   "end": 497.4,
   "text": "خود مرحوم مجلسی میگه شمردیم شصت هزار قدم بود و هر قدم یک حج یعنی شصت هزار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 497.4,
   "end": 502.94,
   "text": "حج مقبول. کسی اینا براش اتفاق میفته که خلع نعال کرده باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 502.94,
   "end": 507.08,
   "text": "کسی که از تعلقاتش کنده باشه، صاحب قلب تسلیم باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 507.08,
   "end": 512.38,
   "text": "یعنی قلبش و حوزه تعلقاتش تسلیم محض امامش باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 512.38,
   "end": 515.5,
   "text": "چون و چرا نداره. نگران هیچ چیزی نباشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 515.5,
   "end": 518.06,
   "text": "خودش رو کاملاً سپرده باشه به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 518.06,
   "end": 524.76,
   "text": "حضرت. حالا این برای کسی که درک و شعورش و ظرفیتش بالاست از اول سفر اتفاق میفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 524.76,
   "end": 531.8,
   "text": "خودشو و اباعبدالله. دل کنده از همه تعلقات به سمت اباعبدالله از همون آغاز این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 531.8,
   "end": 534.8,
   "text": "حرکتش این اتفاق در وجودش افتاده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 534.8,
   "end": 537.5,
   "text": "به سمت آقا در حرکته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 537.5,
   "end": 541.24,
   "text": "و راحل الی الله امام سجاد سلام الله عليه هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 541.24,
   "end": 543.36,
   "text": "توی مناجاتشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 543.36,
   "end": 546.3,
   "text": "به خدا عرض می‌کنن چی؟ \"و ان الراحل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 546.3,
   "end": 548.62,
   "text": "الیک قريب المسافة\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 548.62,
   "end": 552.24,
   "text": "کسی که راحل به سمت توست راه براش کوتاهه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 552.24,
   "end": 554.98,
   "text": "یکی اینطوریه یکی هم نه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 554.98,
   "end": 558.72,
   "text": "یک آن میره حالا با این و اونه، خشکه، خیلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 558.72,
   "end": 563.54,
   "text": "تعلقاتش هست. یک آن به عنایت سید الشهدا تو حرم ارباب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 563.54,
   "end": 566.6,
   "text": "مثلاً یه دفعه می‌کنه از تعلقات یک آن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 566.6,
   "end": 569.66,
   "text": "لحظاتی با اباعبدالله سیر می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 569.66,
   "end": 574.14,
   "text": "یکی هم از اول سیر می‌کنه. اینا با هم فرق می‌کنه زیارتشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 574.14,
   "end": 576.4,
   "text": "همش برمی‌گرده به وضعیت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 576.4,
   "end": 581.04,
   "text": "سلامت قلب که به حوزه تسلیم رسیده یا نه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 581.04,
   "end": 584.22,
   "text": "این قلب سلیم این خیلی حوزه گسترده‌ای داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 584.22,
   "end": 587.6,
   "text": "خیلی دامنه داره و خیلی بحثش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 587.6,
   "end": 590.4,
   "text": "مفصل و مبسوطه و ما متبرکاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 590.4,
   "end": 592.2,
   "text": "نکاتی رو عرض می‌کنیم و رد می‌شیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 592.2,
   "end": 597.32,
   "text": "ان شا الله که عاقبتمون ختم به خیر بشه به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 597.32,
   "end": 602.14,
   "text": "اللهم صل علی محمد و آل محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}