 "chapters": [
  {
   "index": 0,
   "title": "## حکم حرکت دست در تکبیرة‌الاحرام",
   "start": 0.12,
   "end": 87.1
  },
  {
   "index": 1,
   "title": "## قلب مختوم و ارائهٔ طریق بزرگان",
   "start": 87.1,
   "end": 131.32
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.12,
   "end": 3.0,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 3.0,
   "end": 6.38,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 6.38,
   "end": 10.34,
   "text": "آیاته. سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 10.34,
   "end": 15.66,
   "text": "ما موضوع تکبیرة الاحرام رو که بیان کردیم حکمشو که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 15.66,
   "end": 18.98,
   "text": "می‌تونه انسان تکبیرة الاحرام رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 18.98,
   "end": 26.1,
   "text": "همینطوری که دست داره حرکت می‌کنه الله اکبر بگه و اگرچه بالا آوردن دست مستحبه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 26.1,
   "end": 28.92,
   "text": "واجب نیست الله اکبر واجبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 28.92,
   "end": 31.6,
   "text": "یکی از دوستان خوب ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 31.6,
   "end": 38.6,
   "text": "شنید بعد به ما گفتش که آقا اینطوری نیست با ما محاجه کرد که ما چندین ساله من سی ساله، چهل ساله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 38.6,
   "end": 44.82,
   "text": "می‌دونیم مطمئنیم که حکم اینطوری نیست از مثلاً تکبیرة الاحرام الله اکبر می‌خوای بگی باید نما--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 44.82,
   "end": 46.28,
   "text": "بعد بدن سکون داشته باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 46.28,
   "end": 48.6,
   "text": "گفتم بله سکون که واجبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 48.6,
   "end": 51.68,
   "text": "گفت خب این دست که تکون می‌خوره سکون رو از بین می‌بره دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 51.68,
   "end": 53.94,
   "text": "من مطمئنم شما اشتباه می‌کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 53.94,
   "end": 60.82,
   "text": "برای اطمینان ززز زنگ زده من دیگه خودم مطمئن بودم ولی دیگه انقدر ایشون پا فشاری کرد که نه اینطوری نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 60.82,
   "end": 63.48,
   "text": "ما هم باز زنگ زدیم دفتر آقا گفتیم آقا اشکالی داره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 63.48,
   "end": 68.82,
   "text": "گفتن نه، چه کسی گفته؟ حرکت دست سکون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 68.82,
   "end": 71.84,
   "text": "بدن رو هنگام تکبیرة الاحرام از بین نمی‌بره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 71.84,
   "end": 77.94,
   "text": "اشکالی نداره. اینم گفتم یه وقت اگه پیچیده باشه تو جمزمزمش حکمشو بدونید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 77.94,
   "end": 87.1,
   "text": "بله سکون بدن هنگام تکبیرة الاحرام واجب است اما حرکت دست این سکون رو از بین نمی‌بره و مستثناست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 87.1,
   "end": 90.28,
   "text": "در خصوص قلب مختوم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 90.28,
   "end": 97.76,
   "text": "ما دیروز عرض کردیم. ما ببینید اگر بخواهیم تا وقتی که با هم هستیم اینجا سر این سفره ارضاق می‌کنیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 97.76,
   "end": 101.12,
   "text": "همین یک نکته رو بخواهیم ادامه بدیم توش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 101.12,
   "end": 103.28,
   "text": "هم نیازه هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 103.28,
   "end": 106.66,
   "text": "مطلب هست و محتوا داره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 106.66,
   "end": 116.52,
   "text": "و واقعاً ارائه طریق کردن بزرگان ما هم در آیات قرآن هم احادیث هم بزرگان ما، علمای ما ارائه طریق کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 116.52,
   "end": 122.82,
   "text": "منتها حالا ما تبرکاً میگیم اونایی که به هر حال دوست دارن تشنه بشن برن دنبالش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 122.82,
   "end": 127.1,
   "text": "ما گفتیم که طبق آیه قرآن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 127.1,
   "end": 131.32,
   "text": "بدترین و بزرگترین خطری که انسان رو به جایی می‌رسونه که قلبش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}