 ],
 "cues": [
  {
   "i": 0,
   "start": 0.28,
   "end": 6.88,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 6.88,
   "end": 10.38,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 10.38,
   "end": 14.28,
   "text": "آیات. سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 14.28,
   "end": 21.14,
   "text": "از رهبر عزیزمون استفتاء شده که آیا میشه به امام جماعتی اقتدا کرد که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 21.14,
   "end": 24.46,
   "text": "مشغول نماز قضاست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 24.46,
   "end": 28.9,
   "text": "ما حالا هر نمازی می‌خوایم بخونیم او مشغول نماز قضاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 28.9,
   "end": 37.04,
   "text": "آقا فرمودن اشکالی نداره در صورتی که او نماز قضای حتمی بخواند نه نماز قضای احتیاطی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 37.04,
   "end": 39.4,
   "text": "این نکته مهمیه. پس ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 39.4,
   "end": 44.4,
   "text": "حق نداریم تا دیدیم یکی وایساده جلو داره نماز می‌خونه بهش اقتدا کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 44.4,
   "end": 47.04,
   "text": "باید بدونیم چه نمازی داره می‌خونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 47.04,
   "end": 52.46,
   "text": "همینطوری که من بارها شده تو نماز مستحبی بودم بهم اقتدا کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 52.46,
   "end": 56.16,
   "text": "خب این اشکاله، نمازش باطل می‌شه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 56.16,
   "end": 62.86,
   "text": "اینجا هم در صورتی شما می‌تونید اقتدا کنید که بدونید نماز قضای حتمی داره می‌خونه، نه احتیاطی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 62.86,
   "end": 67.52,
   "text": "یعنی مثلا احتیاط کرده میگه شاید نماز قضای گردنم باشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 67.52,
   "end": 70.76,
   "text": "حالا یه نماز قضا بخونم. پس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 70.76,
   "end": 74.66,
   "text": "اگر امام جماعت نماز قضا ندارد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 74.66,
   "end": 77.66,
   "text": "حق نداره وایسته جلو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 77.66,
   "end": 81.38,
   "text": "اینو باید بدونه. چون می‌خواد احتیاطی بخونه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 81.38,
   "end": 84.8,
   "text": "می‌دونه نماز قضا نداره، نمی‌تونه جماعت وایسته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 84.8,
   "end": 88.46,
   "text": "اینم از جهت جما-- خود امام جماعت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 88.46,
   "end": 91.64,
   "text": "اما در خصوص قلب مختوم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 91.64,
   "end": 93.52,
   "text": "توجه به این نکته خیلی مهمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 93.52,
   "end": 100.7,
   "text": "ما هی داریم میگیم که آقا بالاخره قلبی که توسط خدا مهر خورده و مهر خورده و فلان و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 100.7,
   "end": 106.44,
   "text": "تا آخر کار رفته. شاید این شائبه پیش بیاد تو ذهن که خدا داره این کارو می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 106.44,
   "end": 109.16,
   "text": "مثلا ما تا یه مسی-مسیری میریم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 109.16,
   "end": 114.86,
   "text": "بعد خدا از اونجا به بعد یه مهر می‌زنه دیگه جلوتر از این میگه نره دیگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 114.86,
   "end": 117.82,
   "text": "برش گردون. نه اینجوری نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 117.82,
   "end": 125.04,
   "text": "دقیقاً مثالش مثل یک پزشک طبیبیه که میاد مرگ یه نفر رو تذکر--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 125.04,
   "end": 130.08,
   "text": "چرا الان پزشکی قانونی میگه آقا می‌خوای دفنش کنی یه پزشک بیاد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 130.08,
   "end": 134.04,
   "text": "مرگ این آقا رو تأیید کنه که آقا این قطعاً دیگه مرده کارش تمومه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 134.04,
   "end": 139.94,
   "text": "مهر می‌زنن، یه نامه‌ای رو مهر می‌زنن که بله ما تأیید می‌کنیم ایشون مرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 139.94,
   "end": 144.76,
   "text": "در خصوص معنویت و وجود قلب انسان هم همینطور هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 144.76,
   "end": 148.86,
   "text": "تا یه حدی که میری خدا مهر می‌زنه که این دیگه کارش تموم شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 148.86,
   "end": 152.62,
   "text": "یعنی این دیگه مرگ معنوی‌ش امضا شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 152.62,
   "end": 155.0,
   "text": "حالا این مرگ معنوی دو قسم هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 155.0,
   "end": 158.08,
   "text": "یکیش که قبلاً گفتیم قلب مطبوع",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 158.08,
   "end": 161.34,
   "text": "که اصلاً دیگه برگشت پذیر نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 161.34,
   "end": 164.74,
   "text": "مثل کسی که دیگه هیچ علائم حیاتی درش نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 164.74,
   "end": 171.0,
   "text": "اما قلب مختوم هم تا آخرش رفته تا لب مرگ رفته ولی حالت مثلا کما داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 171.0,
   "end": 175.12,
   "text": "یه علائم حیاتی هنوز تو وجودش هست مثلا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 175.12,
   "end": 178.14,
   "text": "شاید مثلا هنوز نبضش می‌زنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 178.14,
   "end": 183.12,
   "text": "ولی مغزش از کار افتاده. این هم چرا اینطور میشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 183.12,
   "end": 187.42,
   "text": "چرا مهر می‌زنه خدا؟ یه سری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 187.42,
   "end": 189.28,
   "text": "جهازات رو ایشون رد کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 189.28,
   "end": 193.58,
   "text": "یعنی یه سری راه‌ها رو رفته طی کرده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 193.58,
   "end": 195.58,
   "text": "علائم رو دیده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 195.58,
   "end": 200.02,
   "text": "علائم هشدار و خطر رو دیده بارها و بارها توجه نکرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 200.02,
   "end": 205.5,
   "text": "یکی از علائم هشدار و خطر رو امیرالمؤمنین علیه الصلاة والسلام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 205.5,
   "end": 209.3,
   "text": "در نهج البلاغه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 209.3,
   "end": 213.0,
   "text": "خطبه نود برید بخونید، یه بخشیشو من می‌خونم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 213.0,
   "end": 216.0,
   "text": "یکی از این هشدارها رو که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 216.0,
   "end": 221.6,
   "text": "توجه آلارم‌هایی که در وجود انسان هست و این آقا رد کرده بارها و بارها اینجا حضرت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 221.6,
   "end": 231.28,
   "text": "خیلی زیبا فرمودن. فرمودن \"واعلموا انه من لم يعن على نفسه حتى يكون له منها واعظ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 231.28,
   "end": 237.0,
   "text": "وزاجر لم يكن له من غيرها لا زاجر ولا واعظ\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 237.0,
   "end": 239.38,
   "text": "خلاصه‌ش اینه اگه کسی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 239.38,
   "end": 247.34,
   "text": "اون واعظ و زاجر درون خودش رو توجه نکنه هیچ واعظی به دردش نمی‌خوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 247.34,
   "end": 252.32,
   "text": "یعنی شما هزار تا منبر آیت الله العظما برو بشین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 252.32,
   "end": 254.98,
   "text": "تا وقتی که در درون خودم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 254.98,
   "end": 262.78,
   "text": "این واعظی که آن به آن داره منو موعظه می‌کنه، همون nefsi که در درون هست مثلا نفس لوامه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 262.78,
   "end": 266.5,
   "text": "دائما ما رو سرزنش می‌کنه، بهش میگن وجدان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 266.5,
   "end": 269.5,
   "text": "این وجدان کار زشت می‌کنی سریع بیدار میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 269.5,
   "end": 273.56,
   "text": "اگر توجه به این نکنه انسان این آلارم‌هاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 273.56,
   "end": 275.7,
   "text": "رد کنه اینا رو، هی این علائم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 275.7,
   "end": 278.22,
   "text": "و تابلوهای خطر را رد کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 278.22,
   "end": 280.78,
   "text": "کار به جایی می‌رسه که سقوط می‌کنه تو دره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 280.78,
   "end": 284.02,
   "text": "تابلوهای خطر رو داره می‌بینه، پیچ تند، فلان، شیب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 284.02,
   "end": 288.0,
   "text": "توجه نمی‌کنه، تخت گاز داره میره آخر می‌افته تو دره دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 288.0,
   "end": 295.5,
   "text": "این آلارم‌ها یکیش اینه. یعنی اینطور نیست که بگه خب خدا رهاش کرد آخر هم سرش به سنگ خورد و مرگ معنوی، نه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 295.5,
   "end": 298.06,
   "text": "انقدر آلارم خدا گذاشته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 298.06,
   "end": 301.1,
   "text": "یکیش اینه تازه. یکیش،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 301.1,
   "end": 303.54,
   "text": "یکی دیگه‌ش همین توجه به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 303.54,
   "end": 309.1,
   "text": "حالا این خود وا-واعظ درون خودش یک بحث مبسوطی‌ست ها، خیلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 309.1,
   "end": 314.36,
   "text": "مفصله و این خود-- کسی اگر اینو درک کنه یکی از بزرگ‌ترین محا--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 314.36,
   "end": 317.98,
   "text": "محا عرض کنم الطاف خدا بهش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 317.98,
   "end": 321.16,
   "text": "صورت گرفته. یکی از بزرگ‌ترین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 321.16,
   "end": 324.94,
   "text": "عنایات الهی به بنده‌ش اینه که این متوجه این نفس درون باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 324.94,
   "end": 331.98,
   "text": "مثلا پیغمبر فکر می‌کنم تو усول کافی باشه به کسی، به یه جوونی دید حال خوشی داره گفت ما علامة الإيمان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 331.98,
   "end": 334.72,
   "text": "علامة إما-- ما علامة إيمانک؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 334.72,
   "end": 339.58,
   "text": "علامت ایمان تو چیه؟ گفت آقا یه چیزی تو درونم هی منو موعظه می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 339.58,
   "end": 342.58,
   "text": "امروز یکی از بچه‌هاتونم غسل می‌گیریم گفت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 342.58,
   "end": 346.2,
   "text": "چند وقته هی یکی بهم میگه آماده باش داری می‌میری، داری می‌میری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 346.2,
   "end": 349.92,
   "text": "همونه دیگه. پیغمبر تحسینش کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 349.92,
   "end": 355.9,
   "text": "گفت آفرین. اینکه در درونت یکی درگیرت کرده اون وجدان یعنی بیداری هنوز.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 355.9,
   "end": 358.44,
   "text": "قلبت نمرده آفرین. تحسینش کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 358.44,
   "end": 361.28,
   "text": "و مثلا در یه جای دیگه امیرالمؤمنین سلام الله عليه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 361.28,
   "end": 365.59,
   "text": "باز در خج-خطبه هشتاد و هفت هست، یه بخشیش هست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 365.59,
   "end": 370.17,
   "text": "حضرت فرمود انّ. حالا به نظر شما محبوب‌ترین بنده نزد خدا کیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 370.17,
   "end": 374.09,
   "text": "کسی که وضع مالیش توپه، عالمه، مشهوره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 374.09,
   "end": 377.35,
   "text": "مثلا همه چیش ق-- ردیفه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 377.35,
   "end": 380.57,
   "text": "نه اصلا قاعده فرق می‌کنه در درگاه خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 380.57,
   "end": 384.49,
   "text": "مولا می‌فرماید انّه من احب عباد الله الیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 384.49,
   "end": 387.83,
   "text": "بهترین و محبوب‌ترین بندگان نزد خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 387.83,
   "end": 390.55,
   "text": "عبدا اعانه الله على نفسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 390.55,
   "end": 393.71,
   "text": "اصلا کی توجه به این می‌کنه تو بازار امروز؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 393.71,
   "end": 396.15,
   "text": "بنده‌ای که خدا او رو بر نفسش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 396.15,
   "end": 399.47,
   "text": "کمک کرده یعنی تونسته نفسش رو،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 399.47,
   "end": 402.41,
   "text": "نفس بدش رو به مهار بکشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 402.41,
   "end": 407.99,
   "text": "زمامش رو دست بگیره. از اون طرفم یه سری چیزای دیگه هست که برمی‌گرده به معارف.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 407.99,
   "end": 413.25,
   "text": "گذشته از این موعظه درون که این آلارم‌ها رو این رد کرده به آخر کار رسیده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 413.25,
   "end": 416.95,
   "text": "یه سری حقایق و معارف وجود داره اونا رو چه کنیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 416.95,
   "end": 421.27,
   "text": "مثلا اینا دیگه قطعیه. من مثال خودش یه بحث مبسوطیه آها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 421.27,
   "end": 423.71,
   "text": "من اشارتا عرض می‌کنم تبرّکا میرم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 423.71,
   "end": 426.47,
   "text": "تو خود بخوان حدیث مفصل از این مجمل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 426.47,
   "end": 430.21,
   "text": "مثلا کسی که در رحم چشم نداره، یعنی تو رحم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 430.21,
   "end": 433.23,
   "text": "مادرش به گونه‌ای پرورش پیدا کرده که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 433.23,
   "end": 437.75,
   "text": "سوء تغذیه داشته مادرش یا هر چیزی رعایت یه سری چیزا رو نکرده این نابینا بیرون میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 437.75,
   "end": 442.45,
   "text": "چه کنه مادر با این؟ ببین این بچه چه کنه دیگه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 442.45,
   "end": 449.25,
   "text": "آها. مادرت ما الان بز-- تمام بزرگان احادیث ما فرمودن ما در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 449.25,
   "end": 454.85,
   "text": "رحم مادر طبیعت قرار گرفتیم و قراره در آخرت متولد بشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 454.85,
   "end": 459.45,
   "text": "تولد ما قیامته. لذا میگه وقتی می‌میری تازه زنده شدی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 459.45,
   "end": 461.75,
   "text": "اینجا ما در رحم مادریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 461.75,
   "end": 465.21,
   "text": "قراره اینجا شکل بگیره نیاز‌هامون در آخرت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 465.21,
   "end": 468.93,
   "text": "ما شاید اینجا نفهمیم نماز به چه درد اونور می‌خوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 468.93,
   "end": 470.59,
   "text": "حتی اینجا میگه آقا به چه درد می‌خوره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 470.59,
   "end": 473.17,
   "text": "خیلیا نماز نمی‌خونن وضعیتشون هم خوبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 473.17,
   "end": 475.05,
   "text": "خیلیا زکات نمیدن وضعیتشون هم خوبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 475.05,
   "end": 478.53,
   "text": "خیلیا، خیلیا، خیلی. نمی‌فهمیم چون الان تو رحمیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 478.53,
   "end": 481.15,
   "text": "بچه تو رحم چشم میخواد چه کنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 481.15,
   "end": 485.65,
   "text": "پیغمبر فرمود قرة عینی في الصلاة.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 485.65,
   "end": 488.63,
   "text": "نور چشم من در نماز است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 488.63,
   "end": 491.89,
   "text": "یعنی چی؟ خب الان کسی نماز نمی‌خونه نور چشم نداره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 491.89,
   "end": 499.83,
   "text": "شاید، شاید خیلی هم نور چشم داشته باشه اما اونور وقتی متولد شد چشم نداره مثل یه بچه که یه عمر نابیناست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 499.83,
   "end": 503.37,
   "text": "اینا چیزهای حقایقیه که خب اینو چه کنه خدا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 503.37,
   "end": 506.51,
   "text": "تو خودت یه کاری کردی که اونور نابینا باشی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 506.51,
   "end": 511.65,
   "text": "خب الان داره مهرش رو به دلت می‌زنه که آماده باشی این، این براییه که خودت سر خودت آوردی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 511.65,
   "end": 514.97,
   "text": "توجه داشته باش. یا فرمود صوم و تصح.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 514.97,
   "end": 518.23,
   "text": "دو کلمه است. روزه بگیر سالم بمونی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 518.23,
   "end": 522.35,
   "text": "یعنی چ-- برای اونور دست و پا داشته باشی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 522.35,
   "end": 524.33,
   "text": "یا خود معنای زکات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 524.33,
   "end": 527.41,
   "text": "قبلا اینجا بحث زکات رو داشتیم، یکی از معانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 527.41,
   "end": 531.65,
   "text": "زکات یعنی رشد و نمو. کسی که زکات نمیده رشد و نمو نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 531.65,
   "end": 534.75,
   "text": "بچه‌ای که در رحم رشد و نمو نداره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 534.75,
   "end": 543.29,
   "text": "کوتاه و نمی‌دونم ناقص الخلقه و اینا به دنیا میاد دیگه یک عمر تو این دنیا زجر می‌کشه، اونم اونور اینطوریه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 543.29,
   "end": 545.79,
   "text": "رسیده به آخر کار. خودش هم این کارو کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 545.79,
   "end": 552.85,
   "text": "یا نکته مهمی که این‌ها رو باید بهش توجه کنیم تا برسیم بعضیاش رو حتی پش-- تو کتابا اینا ما نمی‌بینیم‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 552.85,
   "end": 558.81,
   "text": "شما ببین تو علم پزشکی الان ثابت کردن دلیل اضطراب بچه‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 558.81,
   "end": 562.49,
   "text": "عدم آرامش مادر هنگام بارداریه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 562.49,
   "end": 568.15,
   "text": "ببین ارتباط علم پزشکی با معارف.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 568.15,
   "end": 573.51,
   "text": "یعنی مادر اگر در زمان بارداری آرامش نداشته باشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 573.51,
   "end": 576.35,
   "text": "قطعا بچه‌اش مضطرب میشه وقتی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 576.35,
   "end": 581.51,
   "text": "به دنیا میاد صبور نیست، حلیم نیست، بیش فعاله، اضطراب داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 581.51,
   "end": 587.89,
   "text": "چرا؟ مادر آرامش نداشته. حالا یا یه جا، یه جوری زندگی می‌کردن همش دعوا بوده بذار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 587.89,
   "end": 590.37,
   "text": "ختم کلام اینکه آرامش در کجاست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 590.37,
   "end": 592.63,
   "text": "الا بذكر الله تطمئن القلوب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 592.63,
   "end": 595.23,
   "text": "در ذکر. اگر کسی این دنیا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 595.23,
   "end": 598.51,
   "text": "ذاکر خدا نباشه یعنی آرامش نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 598.51,
   "end": 601.39,
   "text": "چون صراحتا قرآن میگه فقط",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 601.39,
   "end": 603.43,
   "text": "آرامش در گرو ذکر و یاد خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 603.43,
   "end": 607.63,
   "text": "کسی قلبش یاد خدا نیست تو این دنیا آرامش ازش سلب شده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 607.63,
   "end": 611.79,
   "text": "یعنی در رحم مادر، در رحم طبیعت آرامش نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 611.79,
   "end": 613.61,
   "text": "چنین کسی در قیامت چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 613.61,
   "end": 616.91,
   "text": "مضطربه. دو دو تا چهار تا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 616.91,
   "end": 620.99,
   "text": "اضطراب داره، تشویش داره، آرامش نداره، بیچاره‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 620.99,
   "end": 625.77,
   "text": "خب ببین می‌خوام به شما بگم اینا همش داره به ما هی دائما تذکر میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 625.77,
   "end": 628.11,
   "text": "این معارف پیش روی ما،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 628.11,
   "end": 633.23,
   "text": "ما یه کاری می‌کنیم تا آخر کارش بریم و خدا بگه آقا تایید می‌کنم این دیگه قلب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 633.23,
   "end": 637.55,
   "text": "مرده‌ دیگه داره یعنی مرگ معنوی، مرگ قلبی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 637.55,
   "end": 642.39,
   "text": "ان‌شاءالله که عاقبتمون ختم به خیر بشه به ذکر صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 642.39,
   "end": 650.09,
   "text": "اللهم صل على محمد و آل محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
