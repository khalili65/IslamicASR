 },
 "chapters": [
  {
   "index": 0,
   "title": "## نماز صبح در افق‌های مختلف هواپیما",
   "start": 13.38,
   "end": 88.54
  },
  {
   "index": 1,
   "title": "## قلب مختوم؛ ختم کار و تهدید بزرگ",
   "start": 88.54,
   "end": 158.64
  },
  {
   "index": 2,
   "title": "## حکایت پادشاه و وزیر و جراحت دست",
   "start": 158.64,
   "end": 263.06
  },
  {
   "index": 3,
   "title": "## زنگ خطر ختم؛ نعمت با گناه پیوسته",
   "start": 263.06,
   "end": 500.09
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.14,
   "end": 4.34,
   "text": "آره جان. بسم الله الرحمن الرحیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 4.34,
   "end": 9.34,
   "text": "و به نستعین. السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 9.34,
   "end": 13.38,
   "text": "آیاته. سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 13.38,
   "end": 16.9,
   "text": "از رهبر عزیز سؤال شده که سؤال عجیبی هم هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 16.9,
   "end": 19.98,
   "text": "من خودم این استفتار رو دیدم دیدم جالبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 19.98,
   "end": 25.54,
   "text": "اگه کسی در عرض کنم خدمتتون افق شهری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 25.54,
   "end": 32.62,
   "text": "اذان صبح رو مثلا داد و نماز صبحشو همون دم خوند مثلا می‌خواد سوار هواپیما شه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 32.62,
   "end": 35.02,
   "text": "و باید سریع سوار شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 35.02,
   "end": 36.76,
   "text": "هواپیما در حال پروازه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 36.76,
   "end": 40.78,
   "text": "یه دفعه اذان صبح رو میده. همونجا دم پرواز سریع",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 40.78,
   "end": 43.1,
   "text": "نمازشو می‌خونه، سوار میشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 43.1,
   "end": 48.6,
   "text": "میره می‌رسه به افق شهر بعد-- اذان شهر بعد می‌رسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 48.6,
   "end": 53.18,
   "text": "چیکار باید بکنه؟ یا مثلا شما گمان کن میشه‌ها مثلا از مشهد شما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 53.18,
   "end": 56.44,
   "text": "چون حدود نیم ساعت که فاصله افق داره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 56.44,
   "end": 59.52,
   "text": "یعنی اذان تهران از مشهد نیم ساعت دیرتره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 59.52,
   "end": 63.7,
   "text": "یک ساعتو حدودا به طور متوسط یه ربع بیست دقیقه هم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 63.7,
   "end": 67.42,
   "text": "فرصت نماز صبحه، حدود دو ساعتی میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 67.42,
   "end": 70.24,
   "text": "طرف اذانشو-- نمازشو تو مش--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 70.24,
   "end": 74.16,
   "text": "مشهد اول وقت می‌خونه سوار هواپیما می‌رسه تهران",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 74.16,
   "end": 76.0,
   "text": "نماز صبح تهران رسیدش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 76.0,
   "end": 79.52,
   "text": "چیکار باید بکنه؟ باید نماز صبحو دو بار بخونه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 79.52,
   "end": 82.48,
   "text": "آقا فرمودن که نخیر واجب نیست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 82.48,
   "end": 84.9,
   "text": "همون افق اول کفایت می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 84.9,
   "end": 88.3,
   "text": "سؤالات جالبی می‌پرسن بعضیا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 88.3,
   "end": 94.12,
   "text": "اما در خصوص قلب مختوم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 94.12,
   "end": 99.64,
   "text": "یه نکته‌ای رو من بگم امروز که این نکته هرچی که جلوتر میریم توی یک موضوع",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 99.64,
   "end": 104.24,
   "text": "مثلا قلب مختوم هی حساس‌تر میشه مطلب دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 104.24,
   "end": 107.16,
   "text": "حسش هم رو خودشه دیگه. ختم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 107.16,
   "end": 111.72,
   "text": "کار دیگه. ختم کار وقتی که طرف به قدری گناه کرد دیگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 111.72,
   "end": 116.72,
   "text": "به ختم کار رسید، یه خطر بزرگی قلبشو جدی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 116.72,
   "end": 123.9,
   "text": "تهدید می‌کنه. ببینید برای اینکه خوب این نکته جواب بیفته، اول یه حکایتی رو براتون بگم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 123.9,
   "end": 130.26,
   "text": "که این حکایت نشون میده هر اتفاقی توی این عالم بر اساس حکمت الهی‌ست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 130.26,
   "end": 133.24,
   "text": "و خدا با بنده‌ش حرف می‌زنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 133.24,
   "end": 136.46,
   "text": "خدا با من و شما صحبت می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 136.46,
   "end": 140.4,
   "text": "باید اینو ما بگیریم که این حرف خدا چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 140.4,
   "end": 143.8,
   "text": "یعنی هر اتفاقی می‌افته یه حرفی داره با ما می‌زنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 143.8,
   "end": 147.36,
   "text": "چون خدا هیچ شری ازش به بنده نمی‌رسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 147.36,
   "end": 149.02,
   "text": "هرچی از خدا می‌رسه خیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 149.02,
   "end": 151.7,
   "text": "حتی عذاب جهنمش هم خیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 151.7,
   "end": 154.98,
   "text": "تشرح خدا هم خیره برای اینکه تو رو به خودت بیاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 154.98,
   "end": 158.32,
   "text": "از رو کینه نیست، از رو صلح با بندشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 158.32,
   "end": 161.58,
   "text": "میگن یه پادشاهی-- سریع عرض کنم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 161.58,
   "end": 163.82,
   "text": "یه وزیر دانا و با",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 163.82,
   "end": 168.74,
   "text": "خدایی داشت. یه روزی داشت این پادشاه میوه می‌خورد، دستشو برید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 168.74,
   "end": 171.54,
   "text": "بدجوری هم جراحت وارد شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 171.54,
   "end": 175.84,
   "text": "بعد از اون دور وزیر داد زد که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 175.84,
   "end": 181.18,
   "text": "شما نگران نباشید. هرچی اتفاقی تو این عالم می‌افته یه خیری درشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 181.18,
   "end": 183.64,
   "text": "یه خیری در این بوده که دست شما ببره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 183.64,
   "end": 189.38,
   "text": "چون انقدر بس-- بدجوری مجروح شده بود اینم عصبانی شد گفت این وزیر رو بندازید زندان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 189.38,
   "end": 192.5,
   "text": "خیرشه. این همه خون داره از دست میده، بندازنش زندان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 192.5,
   "end": 195.08,
   "text": "می‌ندازنش زندان و یه چند روزی می‌گذره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 195.08,
   "end": 202.14,
   "text": "این میره برای شکار وارد جنگل میشه و خلاصه سوار بر اسب و راه رو گم می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 202.14,
   "end": 209.52,
   "text": "از اون کسایی هم که ملازمش بودن دور می‌افته و راهو گم می‌کنه و می‌زنه به بیراهه تا راهو پیدا کنه می‌رسه به این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 209.52,
   "end": 213.42,
   "text": "آدمای وحشی که بت‌پرست هم بودن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 213.42,
   "end": 217.96,
   "text": "برای تندیس پ-- بتشون روزی بوده که باید یکیو قربانی می‌کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 217.96,
   "end": 220.48,
   "text": "می‌بستن به تندیس بتشون، یه آدمو قربونی می‌کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 220.48,
   "end": 224.86,
   "text": "می‌بینن به به چه جلالتی، یه پادشاه با این خوشگلی و خوش تیپی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 224.86,
   "end": 229.34,
   "text": "کی بهتر از این؟ میان سر اینو می‌بندن به تندیس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 229.34,
   "end": 235.72,
   "text": "بتشون. میگن چه روز خوش یمنی، یه پادشاه با این هیبتو ما قربونی خدامون بکنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 235.72,
   "end": 241.74,
   "text": "یه آدمی بوده ظاهرا حالا مثلا بزرگی اینا بوده نگاه می‌کنه که دست این پادشاه مجروحه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 241.74,
   "end": 246.52,
   "text": "و بدجوری هم جراحت داره. میگه نه باید قربونیمون کاملا سالم باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 246.52,
   "end": 248.6,
   "text": "اینو نمی‌تونیم قربونی کنیم. ولش کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 248.6,
   "end": 251.62,
   "text": "ولش می‌کنن میره. یاد حرف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 251.62,
   "end": 256.22,
   "text": "وزیر میفته. وقتی برمی‌گرده میاد وزیر رو دستور آزاد‌سازی‌ش بهش میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 256.22,
   "end": 261.02,
   "text": "میگه خب من فهمیدم که تو چی گفتی خیر من شد جراحت دستم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 261.02,
   "end": 263.84,
   "text": "و الا الان کشته شده بودم. اما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 263.84,
   "end": 266.56,
   "text": "خیر اینکه تو تو زندان افتادی چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 266.56,
   "end": 269.64,
   "text": "مگه نمیگی خیره؟ برای تو هم یه خیری بوده دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 269.64,
   "end": 276.12,
   "text": "اونم خندید گفت خیرش هم در اینه که اگر من تو زندان نبودم همراه تو بودم، همیشه ملازم تو بودم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 276.12,
   "end": 281.72,
   "text": "همراه تو بودم و به جای تو که مجروحی منو قربونی می‌کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 281.72,
   "end": 284.42,
   "text": "پس منم نجات پیدا کردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 284.42,
   "end": 289.5,
   "text": "می‌خوام عرض کنم که هر اتفاقی حتی به ظاهر شر با ما حرف می‌زنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 289.5,
   "end": 294.68,
   "text": "این نکته خیلی مهمیه. تو بحث سیر و سلوک یکی از ضرایف خودسازیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 294.68,
   "end": 298.26,
   "text": "خوب دقت کنید حتی در گناه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 298.26,
   "end": 304.02,
   "text": "ببینید شما کمال می‌خونید اللهم اغفر لي الذنوب التي تحت کل اسم تغیر النعم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 304.02,
   "end": 308.18,
   "text": "درسته؟ تنزل البلا، تهبس الدعاء، تغیر النعم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 308.18,
   "end": 315.64,
   "text": "این همه اینا نشون میده خدایا گناهم-- ببخش از من گناهانی رو که تغیر النعم، نعمت‌ها رو تغییر داد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 315.64,
   "end": 319.34,
   "text": "نشون میده که تو از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 319.34,
   "end": 322.22,
   "text": "اتفاقی که تو زندگیت می‌افته در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 322.22,
   "end": 329.44,
   "text": "تغییر نعمت‌هات می‌تونی تشخیص بدی که وضعیتت تو چه حالتیه، چه گناهی رو داری مرتکب میشی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 329.44,
   "end": 333.34,
   "text": "چون ما گاهی اوقات متوجه گناهان نیستیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 333.34,
   "end": 337.64,
   "text": "چطور متوجه میشیم؟ امام صادق و امام باقر اینا دسته‌بندی کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 337.64,
   "end": 340.72,
   "text": "حالا الان فرصت گفتنش نیست ولی یکی یک دسته‌بندی کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 340.72,
   "end": 342.84,
   "text": "چه گناهانی تهبس الدعاء می‌کنه آدمو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 342.84,
   "end": 347.44,
   "text": "هرچی-- بعضیا میگن آقا هرچی دعا می‌کنیم هیچ کدومش مستجاب نمیشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 347.44,
   "end": 352.14,
   "text": "خب این تهبس الدعاءست. اگه هیچ گناه، هیچ دعاش مستجاب نمیشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 352.14,
   "end": 355.92,
   "text": "بعضیا میگن که آقا اصلا نعمت‌ها رو از ما خدا گرفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 355.92,
   "end": 357.82,
   "text": "خب مشخ-- دسته‌بندی شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 357.82,
   "end": 360.93,
   "text": "گناهانی که این اتفاق براش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 360.93,
   "end": 365.65,
   "text": "الزاما میفته. یعنی آدم میتونه از این متوجه بشه تو چه وضعیتی از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 365.65,
   "end": 370.95,
   "text": "بندگی قرار گرفته. اما یک جایی هست که این نقطه زنگ خطری‌ست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 370.95,
   "end": 373.21,
   "text": "که دیگه میگه ختم کاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 373.21,
   "end": 378.65,
   "text": "\"ختمت الله علی قلوبهم\" ما در خصوص قلب مختوم و قلب مهر خورده حرف می‌زنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 378.65,
   "end": 382.17,
   "text": "اون کجاست؟ اونو از کجا تشخیص دادیم که دیگه آخر کاره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 382.17,
   "end": 387.27,
   "text": "یعنی زنگ خطره. این رو امیرالمؤمنین علیه‌الصلاة والسلام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 387.27,
   "end": 390.47,
   "text": "در یکی از حکمت‌هاشون بیان کردن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 390.47,
   "end": 395.61,
   "text": "که خیلی هم این واقعاً عبرت درش هست و باید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 395.61,
   "end": 398.77,
   "text": "نهیب بزرگیه یعنی زنگ خطر بزرگیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 398.77,
   "end": 403.43,
   "text": "حضرت فرمودند: \"بترس از اون جایی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 403.43,
   "end": 408.15,
   "text": "در حین انجام گناهان پیوسته،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 408.15,
   "end": 414.11,
   "text": "نعمت‌ها هنوز بر تو مترتب است و این نعمت‌ها از تو گرفته نمی‌شود.\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 414.11,
   "end": 418.81,
   "text": "یعنی در حالی که تو گناه پشت گناه داری انجام میدی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 418.81,
   "end": 422.65,
   "text": "نعمتی از تو سلب نمی‌شه، از تو گرفته نمی‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 422.65,
   "end": 427.13,
   "text": "همون نعمت‌ها هست، زوال نعمت نیست اما تو داری گناهتو ادامه میدی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 427.13,
   "end": 430.89,
   "text": "حضرت می‌فرماید: \"این آخر کاره‌ی بنده‌ست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 430.89,
   "end": 434.67,
   "text": "و زنگ خطر برای مرگ مفاجاته.\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 434.67,
   "end": 438.95,
   "text": "یعنی مرگ ناگهانی. منتظر باش که ان غریب یه دفعه می‌گیره جونتو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 438.95,
   "end": 443.29,
   "text": "اینطوری نیست که مثلاً حتی تو بستر بیماری بیفتی یه چند وقت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 443.29,
   "end": 446.85,
   "text": "متوجه بشی که مثل اینکه دیگه قراره بریم خودتو آماده کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 446.85,
   "end": 452.11,
   "text": "مرگ مفاجات که در دعاها ائمه به خدا پناه می‌بردن از این مرگ مفاجات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 452.11,
   "end": 456.39,
   "text": "این یکی از ظرافت‌های سیر و سلوکی به سمت خداست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 456.39,
   "end": 459.83,
   "text": "که ما خودمون رو بسنجیم که تو چه وضعیتی هستیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 459.83,
   "end": 465.15,
   "text": "مبادا با وجود گناهان پیوسته حضرت می‌فرماید پشت سر هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 465.15,
   "end": 470.23,
   "text": "حالا یا یک گناه رو پشت سر هم تکرار می‌کنیم، اصرار بر گناه داریم یا نه گناهان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 470.23,
   "end": 473.51,
   "text": "گوناگون. با این حال زوال نعمت وجود نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 473.51,
   "end": 477.93,
   "text": "این خیلی زنگ خطر بزرگی‌ست و باید مراقب باشیم که این یعنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 477.93,
   "end": 481.03,
   "text": "ور-ورود به حدود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 481.03,
   "end": 486.01,
   "text": "ختم کار در وادی قلوبی که مختوم شدن و مهر خوردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 486.01,
   "end": 490.97,
   "text": "ان‌شاءالله که عاقبتمون ختم به خیر بشه به ذکر صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 490.97,
   "end": 493.59,
   "text": "اللهم صل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 493.59,
   "end": 495.87,
   "text": "على محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 495.87,
   "end": 500.09,
   "text": "آل محمد و عجل فرجهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}