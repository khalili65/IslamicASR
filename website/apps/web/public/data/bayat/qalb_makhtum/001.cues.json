 ],
 "cues": [
  {
   "i": 0,
   "start": 1.32,
   "end": 4.74,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 4.74,
   "end": 8.92,
   "text": "السلام علیک یا داعی الله و ربانی ایات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 8.92,
   "end": 11.28,
   "text": "سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 11.28,
   "end": 14.84,
   "text": "استفتا شده از رهبر عزیزمون که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 14.84,
   "end": 16.86,
   "text": "اگر انسان نمازش رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 16.86,
   "end": 20.74,
   "text": "غالبا دیر بخونه، اول وقت نخونه، آیا این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 20.74,
   "end": 22.66,
   "text": "گناهه؟ معصیته؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 22.66,
   "end": 24.9,
   "text": "حرامه اصلا همچین کاری؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 24.9,
   "end": 29.12,
   "text": "یا نه حرام نیست، بهتره اول وقت خونده بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 29.12,
   "end": 31.52,
   "text": "سؤال قشنگیه و آقا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 31.52,
   "end": 34.26,
   "text": "خیلی قشنگ جواب دادن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 34.26,
   "end": 40.14,
   "text": "اگر این کار شما، این کاری که انجام میدی حالا دیر میخونی، یه بار، دو بار یا هر وقت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 40.14,
   "end": 44.0,
   "text": "این به جهت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 44.0,
   "end": 46.46,
   "text": "کوچک شمردن نمازه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 46.46,
   "end": 49.6,
   "text": "یعنی چون نماز کوچیکه تو ذهنه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 49.6,
   "end": 52.46,
   "text": "یعنی این. اگر به جهت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 52.46,
   "end": 57.76,
   "text": "استخفاف نماز این کارو انجام میدی این حرام است و معصیت حساب میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 57.76,
   "end": 60.16,
   "text": "اما نه، اگر به جهت استخفاف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 60.16,
   "end": 67.4,
   "text": "نماز نیست، نماز تو ذهنت کوچیک نشده، یه گرفتاری داشتی، یه مشکلی داشتی حالا امروز دو روز اینا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 67.4,
   "end": 72.98,
   "text": "دیر خوندی. نه این معصیت نیست فقط یه فضیلتی رو از دست دادی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 72.98,
   "end": 75.56,
   "text": "این تمیزش خیلی مهمه ها. اینو انسان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 75.56,
   "end": 82.84,
   "text": "تفکیک کنه از هم. چهارمین نوع قلبی که ما به فضل الهی قراره بحثش رو بکنیم، دیگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 82.84,
   "end": 87.64,
   "text": "قلب خاشع رو سفره‌شو جمع کردیم اگرچه خیلی نکات مون--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 87.64,
   "end": 91.58,
   "text": "قلب مختوم هست در قرآن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 91.58,
   "end": 97.52,
   "text": "ما قلب مت-- قلب تبع شده یا مهر خورده رو،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 97.52,
   "end": 99.7,
   "text": "مطبوع رو با تای دسته دار رو گفتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 99.7,
   "end": 103.04,
   "text": "حالا مختوم هم ظاهرا همون قلب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 103.04,
   "end": 107.42,
   "text": "مهر خورده‌ست. اما یه فرقی با قلب مطبوع داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 107.42,
   "end": 110.8,
   "text": "قلب مختوم. اولا بگم تو چه آیاتی هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 110.8,
   "end": 114.78,
   "text": "هفت تا آیه تو قرآن هست که اینها اشاره به قلب مختوم کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 114.78,
   "end": 119.22,
   "text": "یعنی قلبی که میگه مثلا \"ختم الله علی قلوبهم\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 119.22,
   "end": 121.54,
   "text": "قلبی که ختم شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 121.54,
   "end": 123.68,
   "text": "حالا معناشو عرض می‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 123.68,
   "end": 127.62,
   "text": "یکی آیه هفت سوره بقره است عزیزانی که می‌نویسن یا می‌خوان برن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 127.62,
   "end": 132.46,
   "text": "پژوهش بکنن. آیه چهل و شش سوره انعام،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 132.46,
   "end": 135.34,
   "text": "آیه بیست و سه سوره جاسیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 135.34,
   "end": 137.36,
   "text": "و آیه بیست و چهار سوره شورا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 137.36,
   "end": 140.38,
   "text": "برید بخونید چیزای خوبی گیرتون میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 140.38,
   "end": 144.14,
   "text": "اولا فرق بین ختم و تبع چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 144.14,
   "end": 146.68,
   "text": "اونم مهر خورده، اینم مهر خورده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 146.68,
   "end": 149.64,
   "text": "تبع مثل تبع انسان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 149.64,
   "end": 152.56,
   "text": "با تای دسته دار یا تبع",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 152.56,
   "end": 159.06,
   "text": "درهم. این یعنی مهر خوردنی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 159.06,
   "end": 162.1,
   "text": "اثرش برای همیشه باقی می مونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 162.1,
   "end": 166.56,
   "text": "قدیما اون شکلی که میگفتن ضرب سکه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 166.56,
   "end": 169.44,
   "text": "اون شکلی که رو سکه باقی می موند،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 169.44,
   "end": 174.48,
   "text": "تو قالب می‌گرفتن باقی می موند، اونو می‌گفتن مهر زدن، تبع",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 174.48,
   "end": 178.12,
   "text": "سکه. یا میگن فلانی تبعش اینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 178.12,
   "end": 182.22,
   "text": "تبع انسانیت داره. فلانی تبعش حیوانیه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 182.22,
   "end": 184.32,
   "text": "شهوانیه، حب ریاست داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 184.32,
   "end": 187.82,
   "text": "این تبع یعنی دیگه همیشگی شده، تو وجودش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 187.82,
   "end": 191.14,
   "text": "جا انداخته اصطلاحا، جا وا کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 191.14,
   "end": 195.56,
   "text": "اما ختم اینطوری نیست. حالا اینی که من دارم به شما میگم ماحصل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 195.56,
   "end": 199.28,
   "text": "امروز یه پژوهش مختصری پیرامون لغت شناسان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 199.28,
   "end": 204.56,
   "text": "مختلف کردم و نظراتشون رو بررسی کردم به این نتیجه رسیدم که مهم‌ترینشون همینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 204.56,
   "end": 206.96,
   "text": "اختلاف نظر هم درشون هست البته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 206.96,
   "end": 210.24,
   "text": "که ختم یعنی ختم کار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 210.24,
   "end": 216.84,
   "text": "مهر زدن هم درش هست. مثلا قدیما می‌خواستن یه نامه رو کسی نگاه نکنه روش مهر می‌زدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 216.84,
   "end": 220.92,
   "text": "اما این مهر یه جوهری بود،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 220.92,
   "end": 225.26,
   "text": "حالت مثلا با آب شسته میشد، از بین می‌رفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 225.26,
   "end": 230.22,
   "text": "یه جوهری بود برای اینکه جلوگیری کنه از دسترسی به محتوای نامه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 230.22,
   "end": 233.72,
   "text": "مثل ضرب سکه نبود که اثر بندازه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 233.72,
   "end": 237.48,
   "text": "جا وا کنه. متوجه شدید خ-تفاوت رو؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 237.48,
   "end": 241.28,
   "text": "ختم هم یعنی مهر زدن اما یعنی یک پوشش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 241.28,
   "end": 243.78,
   "text": "بعضیا پوشش نام بهش دادن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 243.78,
   "end": 249.42,
   "text": "یعنی پوششی که حالا مثلا ختم البذر من دیدم توی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 249.42,
   "end": 252.72,
   "text": "حالا اون پژوهش ختم البذر رو مثلا بیان کرده بودند، یعنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 252.72,
   "end": 257.3,
   "text": "پوشاندن بذر زیر خاک بهش میگن ختم البذر یا خاتم النبیین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 257.3,
   "end": 259.6,
   "text": "انته-- آخرین پیغمبر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 259.6,
   "end": 262.94,
   "text": "یا کسی قرآن میخونه تموم میشه میگن چیکار کرد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 262.94,
   "end": 266.28,
   "text": "ختم قرآن کرد. درسته؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 266.28,
   "end": 270.04,
   "text": "اینها یا مثلا ختمه فلان،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 270.04,
   "end": 272.28,
   "text": "فلان، فلان للقرآن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 272.28,
   "end": 276.54,
   "text": "فلانی قرآن رو ختم کرد. این یعنی اینکه تا آخرش رفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 276.54,
   "end": 280.12,
   "text": "ختم یعنی تا آخر یه کاری رو رفتن، تا آخر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 280.12,
   "end": 283.5,
   "text": "هوای نفس رو رفتن، تا آخر راه شقاوت رفتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 283.5,
   "end": 288.58,
   "text": "اما فرقش با تبع یا قلب مطبوع اینه که اون دیگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 288.58,
   "end": 293.04,
   "text": "چنان تا آخر کار رفته که دیگه اثر گذاشته رو قلبش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 293.04,
   "end": 296.38,
   "text": "اصلا دیگه نمیشه هیچ راهی نداره برای برگشتش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 296.38,
   "end": 300.1,
   "text": "اما اینطور که بنده حقیر تو این پژوهش مختصر متوجه شدم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 300.1,
   "end": 303.64,
   "text": "در ختم یه روزنه‌ای هست هنوز.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 303.64,
   "end": 306.08,
   "text": "یعنی اگرچه مهر خورده اما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 306.08,
   "end": 311.76,
   "text": "اثر ننداخته به اون معنا که دیگه هیچ راهی برای رسیدن به راه معنویت نباشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 311.76,
   "end": 314.0,
   "text": "یعنی یه پله پایین‌تر از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 314.0,
   "end": 316.48,
   "text": "تبع یا قلب مطبوع.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 316.48,
   "end": 323.92,
   "text": "که حالا وقتی شما این آیه، چهار تا آیه رو بررسی کنید، می‌بینید مهم‌ترین چیزی که باعث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 323.92,
   "end": 329.24,
   "text": "مختوم شدن قلب و اینکه انسان راه شقاوت رو تا آخرش بره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 329.24,
   "end": 331.64,
   "text": "و خدا یه پرده‌ای بندازه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 331.64,
   "end": 336.5,
   "text": "بین قلب او و حقایق و نفهمه حقایق رو هوای نفسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 336.5,
   "end": 341.88,
   "text": "و أدله الهوی. هوای نفس اینا رو گمراه می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 341.88,
   "end": 346.94,
   "text": "در کتاب شریف غرر الحکم صفحه دویست و چهل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 346.94,
   "end": 350.86,
   "text": "یه فرمایشی از امیرالمؤمنین علیه الصلاة والسلام هست خیلی زیباست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 350.86,
   "end": 357.74,
   "text": "بالاخره همه ماها بعد یه عمری سر سفره اهل بیت و توحید بودن دوست داریم به درجات عالیه برسیم دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 357.74,
   "end": 360.67,
   "text": "نمی‌خوایم توقف کنیم همیشه پیش دبستانی باشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 360.67,
   "end": 368.99,
   "text": "می‌خوایم رشد کنیم. رمز و سر رشد رو و رسیدن به درجات عالیه رو مولا تو این چند جمله همین حدیث کوتاه بیان کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 368.99,
   "end": 374.57,
   "text": "فرموده \"طهروا انفسکم من دنس الشهوات\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 374.57,
   "end": 377.59,
   "text": "وجودتون رو پاک کنید از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 377.59,
   "end": 379.95,
   "text": "خواهش‌های شهوانی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 379.95,
   "end": 383.73,
   "text": "خود انسان تشخیص میده این هوای نفسشه یا نه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 383.73,
   "end": 389.23,
   "text": "بعد اگر این کارو کردید، ح-- مولا می‌فرماید \"تدرکوا رفيع الدرجات\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 389.23,
   "end": 393.11,
   "text": "اون موقع است که رفيع الدرجات، رفعت درجه پیدا می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 393.11,
   "end": 396.19,
   "text": "بالاترین درجات رو به شما میدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 396.19,
   "end": 401.51,
   "text": "با همین. یعنی شما ببینید کسانی که بالاترین درجات رو پیدا کردن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 401.51,
   "end": 406.73,
   "text": "قطعاً بدون برو برگرد با نفسشون مخالفت کردن، شهوات رو مُ--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 406.73,
   "end": 413.59,
   "text": "کشتن در وجودشون. تا جایی که از امام هندونه می‌خواست بخوره نمک می‌زد مزشو نفهمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 413.59,
   "end": 422.25,
   "text": "و اون‌هایی هم که به درجات بسی-- از اون سمت به عمق ذلت و پستی رسیدن تا نهایتش رفتن هوای نفسشون رو رها کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 422.25,
   "end": 425.83,
   "text": "هوای نفس هم یعنی هر چیزی که مغایر با دستور خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 425.83,
   "end": 429.79,
   "text": "میگه من دوست دارم اینجوری باشم حالا خدا می‌خواد بعدش بیاد یا بعدش نیاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 429.79,
   "end": 431.87,
   "text": "خوشش بیاد. من کاری-- من اینو می‌خوام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 431.87,
   "end": 437.17,
   "text": "این خواهش نفس. ببینید شما تمام بزرگان بدون استثناء",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 437.17,
   "end": 442.07,
   "text": "حتی کسانی که عالم نبودن، مرجع نبودن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 442.07,
   "end": 444.87,
   "text": "صرفا عابد بودن یا عارف بودن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 444.87,
   "end": 448.03,
   "text": "این‌ها قطعاً با مخالفت با نفس به جاهایی رسیدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 448.03,
   "end": 450.77,
   "text": "هر کدوم چیزی بهشون دادن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 450.77,
   "end": 454.25,
   "text": "همین ابن سیرین رو که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 454.25,
   "end": 457.29,
   "text": "خیلی ازش حرف هست، کتاب در رابطه مثلاً تعبیر خوابش میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 457.29,
   "end": 462.19,
   "text": "البته اون اح-- روایاتی که از ابن سیرین در تعبیر خواب اومده اونا معلوم نیست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 462.19,
   "end": 465.17,
   "text": "واقعاً روایاتی باشه که ایشون گفته‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 465.17,
   "end": 467.77,
   "text": "اینو بگم باید روش کار رجالی انجام شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 467.77,
   "end": 472.99,
   "text": "آیت‌الله فاطمی‌ها رد کردن. اما خود ابن سیرین مگه کی بوده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 472.99,
   "end": 476.17,
   "text": "این که قطعیه دیگه. همه می‌دونید قطعاً تمام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 476.17,
   "end": 478.37,
   "text": "تاریخ اینو ثبت کرده که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 478.37,
   "end": 480.45,
   "text": "به ایشون علم تعبیر خواب عطا شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 480.45,
   "end": 487.67,
   "text": "چطور شد که عطا شد؟ مثلاً ایشون عالم بود، مرجع بود، حافظ قرآن بود، یه آدم معمولی بود، بزاز بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 487.67,
   "end": 490.03,
   "text": "تازه مغازه هم نداشت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 490.03,
   "end": 496.29,
   "text": ". یه مغازه دو بر تو بهترین جای بازار هم نداشت، اینطوری هم نبود، خیلی هم علیه السلام مقدس نبود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 496.29,
   "end": 501.63,
   "text": "می‌دونید چی کار بود؟ یه سب-- زنبیل یا سبد میذاشت رو دوشش پارچه می‌فروخت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 501.63,
   "end": 504.75,
   "text": "تو کوچه پس کوچه بعضی موقع‌ها خسته میشد یه گوشه می‌نشست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 504.75,
   "end": 506.67,
   "text": "منتها جوون زیبارویی بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 506.67,
   "end": 509.39,
   "text": "خوشگل بود. به قول ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 509.39,
   "end": 513.15,
   "text": "خوشگل بود. یه زن، یه زن جوونی از این خوشش اومد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 513.15,
   "end": 515.39,
   "text": "به هر حال عاشق شد و گفت باید دام بندازه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 515.39,
   "end": 521.45,
   "text": "اومد بهش-- خلاصه‌ش اینه اومد بهش یه روز یه جا نشسته داره استراحت می‌کنه بهش گفت من شوهرم تو خونه مریضه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 521.45,
   "end": 523.91,
   "text": "بیا بریم می‌خوام براش خ-- لباسی تهیه کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 523.91,
   "end": 526.45,
   "text": "نمی‌تونه از خونه بیاد بیرون. بیا بریم تو باهاش صحبت کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 526.45,
   "end": 528.39,
   "text": "من می‌خوام طبق سلیقه‌ش باشه. از این حرفا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 528.39,
   "end": 531.67,
   "text": "راضیش کرد. رفتن گفت باشه بریم کمکی به تو بکنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 531.67,
   "end": 535.49,
   "text": "رفتن وارد خونه شدن و یا الله، یا الله می‌گفت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 535.49,
   "end": 539.65,
   "text": "ابن سیرین. رفت اتاق اول، حجره دوم، حجره سوم دید خبری نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 539.65,
   "end": 544.03,
   "text": "گفت شوهرت کجاست؟ گفت هیچ-- درو بست گفت اینجا هیچکس جز من و تو نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 544.03,
   "end": 550.71,
   "text": "یا آماده شو یا اینکه داد می‌زنم میگم فلانی به من قصد سوء داشته آبروتو می‌برم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 550.71,
   "end": 558.45,
   "text": "این دید هیچ کاری نمی‌تونه بکنه. گفت باشه فقط اجازه بده من برم مستراح کجاست اینجا برم دستی به سرم بکشم و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 558.45,
   "end": 562.93,
   "text": "آماده شم. گفت فلان جاست. رفت و اون زنه هم به خیال خودش رفت آماده شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 562.93,
   "end": 570.23,
   "text": "این رفت اون تو. معذرت می‌خوام این نجاست‌ها چیزی که ما بهش می-می‌گیم مدفوع.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 570.23,
   "end": 572.73,
   "text": "دفعش می‌کنیم. پلیدترین چیزهاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 572.73,
   "end": 576.81,
   "text": "نجسه. چیزی که عرب بهش میگه قاعد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 576.81,
   "end": 582.21,
   "text": "افتاده. اینو ورداشت مالید به سر و صورت خودش تمام و...",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 582.21,
   "end": 585.09,
   "text": "بعد از اونجا اومد. کی حاضر میشه خداوکیلی این کارو بکنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 585.09,
   "end": 587.29,
   "text": "من باشم میگم ببین hah خانم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 587.29,
   "end": 591.37,
   "text": "اجازه بدین من شما یه نصیحتی بفرم-- اگر سوء نکرده‌م.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 591.37,
   "end": 596.53,
   "text": "این کارو نمیام بکنم. این یعنی اراده قطعی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 596.53,
   "end": 599.45,
   "text": "یا مثلاً میگم حالا بیا شرعی‌ش کنیم اگر فلان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 599.45,
   "end": 601.75,
   "text": "بالاخره یه راهی پیداش می‌کنیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 601.75,
   "end": 604.39,
   "text": ". نمیایم اینطوری-- این هر-- شما بهش فکر کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 604.39,
   "end": 609.41,
   "text": "من اینطوری دارم به شما میگم برای اینکه روش فکر کنین که واقعاً دیگه آخر مخالفت با نفس بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 609.41,
   "end": 613.29,
   "text": "کی میاد این کارو بکنه؟ خبیثه، بدبوعه، زشته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 613.29,
   "end": 616.09,
   "text": "آقا ورداشت مالید به صورتش اومد بیرون تو اتاق نشسته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 616.09,
   "end": 617.65,
   "text": "زنه تا اومد دید جیغ زد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 617.65,
   "end": 621.51,
   "text": "گفت این چه وضعشه؟ گفت حرفو ببینید،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 621.51,
   "end": 626.95,
   "text": "گفت این چی کاریه که الان چیزی که از من داری می‌بینی حقیقت درخواستی‌ه که از من کردی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 626.95,
   "end": 632.95,
   "text": "حقیقتش اینه. اونم جیغ زد گفت برو گمشو از خونه من بیرون و بیرونش کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 632.95,
   "end": 637.01,
   "text": "جالبه میگن خب این آبرو داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 637.01,
   "end": 639.01,
   "text": "تو همین کوچه پس کوچه ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 639.01,
   "end": 643.09,
   "text": "فروشندگی می‌کرد. نگران آبروش هم اگه بود این کارو نمی‌کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 643.09,
   "end": 645.67,
   "text": "ولی اومد بیرون به خدا معامله کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 645.67,
   "end": 649.03,
   "text": "یه نفر تو این وضعیت ندیدش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 649.03,
   "end": 652.11,
   "text": "هرکی می‌رفت سرش پایین بود. این تو تاریخ نوشته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 652.11,
   "end": 655.47,
   "text": "خلاصه این کارش همانا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 655.47,
   "end": 661.73,
   "text": "و از فردا که می‌اومد رد میشد خودش رو شستشو داد، همه یه بوی خوشی از این استشمام می‌کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 661.73,
   "end": 665.07,
   "text": "می‌گفتن یه بوی عجیبی داری. هیچ عطری این بو رو نداره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 665.07,
   "end": 668.31,
   "text": "و خدا همون در دم علم تعبیر خواب رو بهش داد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 668.31,
   "end": 671.43,
   "text": "معروف شد به ابن سیرین، تو کتاب‌ها هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 671.43,
   "end": 674.91,
   "text": "با چی؟ یه مخالفت با نفس، یه پا گذاشتن رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 674.91,
   "end": 680.73,
   "text": "دل، رو خواهش نفس. حالا این حرفایی که من می‌زنم از دهنم گنده‌تره چون خودم ولم و رها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 680.73,
   "end": 684.09,
   "text": "میگم انشاالله بلکه شماها برسید یه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 684.09,
   "end": 687.37,
   "text": "عنایتی هم به شما بشه و دست ما رو هم شما بگیرید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 687.37,
   "end": 691.89,
   "text": "عاقبتمون انشاالله ختم به خیر بشه به ذکر صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 691.89,
   "end": 697.95,
   "text": "اللهم صل علی محمد و آل محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}