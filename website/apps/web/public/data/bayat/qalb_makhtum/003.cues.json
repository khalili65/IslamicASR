 "chapters": [
  {
   "index": 0,
   "title": "## وقت نماز عصر تا غروب آفتاب",
   "start": 14.56,
   "end": 58.82
  },
  {
   "index": 1,
   "title": "## هوای نفس؛ خطرناک‌ترین عاملِ مهر خوردنِ قلب",
   "start": 58.82,
   "end": 141.34
  },
  {
   "index": 2,
   "title": "## مکاشفهٔ استاد حق‌شناس؛ ریسمان‌های نورانی",
   "start": 141.34,
   "end": 161.36
  },
  {
   "index": 3,
   "title": "## حدیث امام صادق؛ تشخیص الهام رحمانی از شیطانی",
   "start": 161.36,
   "end": 303.98
  },
  {
   "index": 4,
   "title": "### دوام المراقبة",
   "start": 303.98,
   "end": 324.82
  },
  {
   "index": 5,
   "title": "### والاستقامة علی بساط الخدمة",
   "start": 324.82,
   "end": 400.04
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 2.4,
   "end": 5.84,
   "text": "بسم الله الرحمن الرحیم و به این استعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 5.84,
   "end": 9.12,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 9.12,
   "end": 14.56,
   "text": "آیاته. السلام علیکم و رحمه الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 14.56,
   "end": 18.02,
   "text": "از رهبر عزیز استفتاء شده که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 18.02,
   "end": 20.16,
   "text": "وقت نماز عصر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 20.16,
   "end": 24.5,
   "text": "تا کیه؟ ایشون فرمودن تا غروب آفتاب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 24.5,
   "end": 29.22,
   "text": "خب مردم، عامه مردم متاسفانه غروب آفتاب رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 29.22,
   "end": 32.46,
   "text": "اذان فرض می‌کنند و این غلطه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 32.46,
   "end": 35.02,
   "text": "غروب آفتاب البته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 35.02,
   "end": 38.04,
   "text": "بنا به فصل‌ها، روزها فرق می‌کنه ولی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 38.04,
   "end": 41.62,
   "text": "معمولا بین هجده تا بیست دقیقه قبل از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 41.62,
   "end": 47.88,
   "text": "اذان مغربه. یعنی مثلا حدود بیست دقیقه مونده به اذان مغرب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 47.88,
   "end": 49.78,
   "text": "دیگه نماز عصر قضاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 49.78,
   "end": 52.92,
   "text": "اگه کسی بخونه اون موقع قضاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 52.92,
   "end": 58.82,
   "text": "حالا برای اینکه من امروز صبح از دفتر سؤال کردم حکم اون‌هایی که تو اون فاصله خوندن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 58.82,
   "end": 61.74,
   "text": "در حالی که فکر می‌کردن ادایی چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 61.74,
   "end": 65.84,
   "text": "عده‌ای از مردم گمانشون اینه، این بوده فکر می‌کردن که آقا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 65.84,
   "end": 68.88,
   "text": "وقت نماز عصر تا اذان مغربه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 68.88,
   "end": 71.7,
   "text": "تو یعنی بعد از غروب آفتاب خوندن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 71.7,
   "end": 76.92,
   "text": "دفتر فرمودن که چون گمان می‌کرده اداست نمازهایی که تا حالا اون موقع",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 76.92,
   "end": 80.82,
   "text": "خونده درسته نیاز به قضا کردن نداره اما از الان به بعد که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 80.82,
   "end": 84.16,
   "text": "حکمو فهمیده باید اینو لحاظ کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 84.16,
   "end": 90.64,
   "text": "پس وقت مخصوص نماز عصر میشه چهار رکعت مونده به غروب آفتاب، نه اذان مغرب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 90.64,
   "end": 93.16,
   "text": "اینو یادمون باشه. در خصوص",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 93.16,
   "end": 97.48,
   "text": "قلب مختوم ما داشتیم صحبت می‌کردیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 97.48,
   "end": 101.08,
   "text": "و آیاتی رو عرض کردیم و روایاتی پیرامونش و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 101.08,
   "end": 104.24,
   "text": "صحبت کردیم که بدترین عاملی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 104.24,
   "end": 107.46,
   "text": "خطرناک‌ترین عاملی که باعث میشه ما به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 107.46,
   "end": 110.76,
   "text": "جایی برسیم که قلبمون مهر بخوره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 110.76,
   "end": 115.08,
   "text": "و از درک حقایق عاجز بشه، هوای نفس است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 115.08,
   "end": 119.48,
   "text": "که همین هوای نفسه که انسان را به کفر و شرک و گناهان دیگه می‌کشونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 119.48,
   "end": 124.18,
   "text": "بعدم شیطان یه دفعه یه روزه و دو روزه نمیاد برنامه ش یه هفته و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 124.18,
   "end": 126.78,
   "text": "یه ماهه نیست. یه ساله حتی نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 126.78,
   "end": 129.84,
   "text": "یهو یه برنامه بیست ساله، سی ساله، چهل ساله برای ما داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 129.84,
   "end": 135.62,
   "text": "خطوط وات شیطان پله پله، قدم به قدم ما رو جلو می‌بره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 135.62,
   "end": 140.04,
   "text": "اینجوری نیست که یه دفعه همه چی رو از ما بگیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 140.04,
   "end": 143.28,
   "text": "و مثلا مرحو-- خدا رحمت کنه از استاد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 143.28,
   "end": 146.98,
   "text": "حق شناس رو در سخنرانیشون می‌فرمودن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 146.98,
   "end": 149.02,
   "text": "اِاِاِ من در حالت مکاشفه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 149.02,
   "end": 156.62,
   "text": "چون یه جلسه ایشون داشتن تقریبا حالت خصوصی داشت با طلاب به جز اون جلسه‌ای که تو مسجد ارمین و دوله داشتن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 156.62,
   "end": 161.36,
   "text": "اونجا تو جلسه خصوصیشون بعضی از مکاشفاتشون رو می‌گفتن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 161.36,
   "end": 164.38,
   "text": "و بعضا ما خدمتشون می‌رسیدیم اونجا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 164.38,
   "end": 169.8,
   "text": "یکی از مکاشفاتی که ایشون می‌فرمودن تو این کتاب مواعظشون هم هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 169.8,
   "end": 173.48,
   "text": "می‌فرمودن که من دیدم ریسمان‌هایی از آسمان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 173.48,
   "end": 175.18,
   "text": "به پایین آویخته شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 175.18,
   "end": 177.24,
   "text": "این ریسمان‌ها نورانی‌ان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 177.24,
   "end": 183.36,
   "text": "و انتهاش تا بی‌نهایت رفته و اصلا مشخص نیست دیگه در آسمان‌ها محو شده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 183.36,
   "end": 186.34,
   "text": "و این‌ها در دسترس عموم مردمن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 186.34,
   "end": 191.6,
   "text": "متوجه شدم در خواب از نورانیت این ریسمان‌ها که این‌ها همون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 191.6,
   "end": 196.32,
   "text": "اِاِاِ اعتصام به خدا هستن، حبل الله‌ان،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 196.32,
   "end": 198.38,
   "text": "جلوه‌های اعتصام با خدا هستن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 198.38,
   "end": 202.32,
   "text": "حالا دامان اهل بیت‌ان، به هر طریقی یک جلوه‌هایی از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 202.32,
   "end": 208.6,
   "text": "ریسمان الهی‌ان. بعد می‌دیدم که مردم دسته دسته میان که به این ریسمان‌ها چنگ بزنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 208.6,
   "end": 214.28,
   "text": "عده‌ای موفق میشن، عده‌ای تا دست میارن که ریسمانو بگیرن، ریسمان محو میشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 214.28,
   "end": 219.48,
   "text": "و دست خالی بر می‌گردن. اونجا میگه متوجه شدم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 219.48,
   "end": 222.92,
   "text": "بسیاری از همینایی که حتی مذهبی هستن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 222.92,
   "end": 229.16,
   "text": "گمانم می‌کنن دارن چنگ به ریسمان الهی می‌زنن، دستشون نرسیده، فکر می‌کنن رسیده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 229.16,
   "end": 232.38,
   "text": "چرا؟ لا یمسه إلا المتحرون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 232.38,
   "end": 238.98,
   "text": "اصلا نمیشه مس کرد قرآن و عترت رو مگر به حالت پاکیزگی، دوری از هوای نفس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 238.98,
   "end": 242.62,
   "text": "و حالا ما دیروز یه حدیث رو می‌خواستیم بگیم نشد، اونو بگم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 242.62,
   "end": 245.76,
   "text": "که این حدیث مبنای بسیاری از بحث‌ها میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 245.76,
   "end": 248.18,
   "text": "تا حالا ما تبرکا عرض می‌کنیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 248.18,
   "end": 253.36,
   "text": "که در کتاب شریف بحارالانوار جلد شصت و نه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 253.36,
   "end": 256.52,
   "text": "صفحه صد و بیست و پن-- صد و بیست و چهار و صد و بیست و پنج",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 256.52,
   "end": 258.84,
   "text": "مرحوم مجلسی این روایت رو آورده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 258.84,
   "end": 261.32,
   "text": "روایت مبسوطی‌ست. مختصرش اینه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 261.32,
   "end": 267.5,
   "text": "لب مطلب که کسی به امام صادق سلام الله علیه عرض کرد آقا شما گفتید وقتی شیطان اومد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 267.5,
   "end": 270.78,
   "text": "فاستعذ بالله به خدا پناه ببرید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 270.78,
   "end": 274.26,
   "text": "آیا میشه تشخیص داد که شیطان کی میاد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 274.26,
   "end": 276.7,
   "text": "حضرت اینچنین فرمودن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 276.7,
   "end": 281.6,
   "text": "ولن تقدر على هذا نه شما قدرت پیدا نمی‌کنید که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 281.6,
   "end": 283.68,
   "text": "درک کنید شیطان کی میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 283.68,
   "end": 288.82,
   "text": "ولی یه راهکاری حضرت میده که می‌فرماید می‌تونید تشخیص بدید این الهامی که به قلب شما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 288.82,
   "end": 294.74,
   "text": "شد این کارو بکن، اون کارو نکن، این حرفو بزن، اون حرفو نزن، اینجا رو نگاه کن، اینجا رو نگاه نکن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 294.74,
   "end": 297.32,
   "text": "این الهام رحمانیه یا شیطانیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 297.32,
   "end": 303.98,
   "text": "چهار تا راهکار حضرت داده که این‌ها باید با هم و با دوام باشه چون قید اولش میگه به دوام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 303.98,
   "end": 307.06,
   "text": "حضرت می‌فرماید إلا یعنی شما نمی‌تونید مگر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 307.06,
   "end": 310.64,
   "text": "إلا به دوام المراقبة.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 310.64,
   "end": 316.88,
   "text": "به دوام مراقبه. بعضیا مراقبه دارن یه روز، دو روز، یه ماه، یه سال ولی یه دفعه ولش می‌کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 316.88,
   "end": 319.6,
   "text": "دوام مهمه اینجا. به دوام المراقبة.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 319.6,
   "end": 324.82,
   "text": "حالا خدا رحمت کنه علامه طباطبایی می‌فرمود اول مراقبه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 324.82,
   "end": 327.1,
   "text": "وسط مراقبه، آخر مراقبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 327.1,
   "end": 331.64,
   "text": "اصلا بدون مراقبه نمیشه. یعنی پلیس نفس شدن، کشیک نفس کشیدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 331.64,
   "end": 336.08,
   "text": "مثل یه منطقه حساس نظامی که دست شما میدن میگن شما حراستش کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 336.08,
   "end": 341.18,
   "text": "اسلحه هم دستت میدن. دستت رو ماشه آماده‌ست، دشمن اومد سریع بزنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 341.18,
   "end": 343.54,
   "text": "یه همچین حالتی انسان برای خودش باید داشته باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 343.54,
   "end": 347.02,
   "text": "آن به آن فرق می‌کنه با اون محاسبه قبل خواب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 347.02,
   "end": 350.3,
   "text": "اون یه چیزه، این یه چیز دیگه است. آن به آن باید مراقب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 350.3,
   "end": 353.04,
   "text": "و-واردات و صادرات وجودش باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 353.04,
   "end": 358.08,
   "text": "اینا فرمایشات حضرته برای کسی که بتونه تشخیص بده این الهام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 358.08,
   "end": 361.4,
   "text": "الهیه یا شیطانیه که خودشو حفظ کنه و الا می‌بازه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 361.4,
   "end": 365.54,
   "text": "دو والاستقامة علی بساط الخدمة",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 365.54,
   "end": 369.64,
   "text": "یعنی تو این راه خدمتی که پیش گرفته از هر حیث،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 369.64,
   "end": 373.04,
   "text": "چه خدمت به دینه، خدمت به امامه است، چه خدمت به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 373.04,
   "end": 378.42,
   "text": "جامعه‌ست، به مسلمینه، به مردمه، به ذوعفاس، به فقرا یا خدمت به نفس خودشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 378.42,
   "end": 381.16,
   "text": "به نه-- بخواد به خودش داره خدمت می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 381.16,
   "end": 382.92,
   "text": "میگه اینجا استقامت به ورزه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 382.92,
   "end": 386.04,
   "text": "مستقیم بودن، ثابت قدم بودن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 386.04,
   "end": 391.76,
   "text": "اهدنا الصراط المستقيم نه یعنی یک راهی که صافه و مثلا همواره و فقط همین و بسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 391.76,
   "end": 400.04,
   "text": "یعنی راه کسایی که اونجا مستقیمن، ثابت قدمن، تا یه تقی به توق بخوره ایمانشونو از دست نمیدن، محکم‌ان، استوارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}