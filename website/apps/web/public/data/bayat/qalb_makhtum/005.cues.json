 ],
 "cues": [
  {
   "i": 0,
   "start": 2.08,
   "end": 5.38,
   "text": "بسم الله الرحمن الرحیم و به نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 5.38,
   "end": 10.24,
   "text": "السلام علیک یا داعی الله و ربانی آیات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 10.24,
   "end": 13.14,
   "text": "سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 13.14,
   "end": 17.9,
   "text": "خب با توجه به پیشرفت تکنولوژی و اینا سوالات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 17.9,
   "end": 19.72,
   "text": "فقهی هم بعضا دقیق‌تر میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 19.72,
   "end": 24.06,
   "text": "مثلا استفتا کردن از حضرت آقا که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 24.06,
   "end": 28.82,
   "text": "فاصله این زمانی که طول میکشه نور خورشید برسه به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 28.82,
   "end": 32.3,
   "text": "زمین هفت دقیقه است حدودا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 32.3,
   "end": 38.36,
   "text": "خب وقت طلوع آفتاب یا اذان صبح یا مثلا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 38.36,
   "end": 42.38,
   "text": "آ-- طلوع آفتاب وقتی که آفتاب میرسه به ما،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 42.38,
   "end": 44.08,
   "text": "ما کدومش رو باید در نظر بگیریم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 44.08,
   "end": 51.22,
   "text": "وقتی که آفتاب رها شد مانع بین زمین و خورشید از بین رفت و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 51.22,
   "end": 57.1,
   "text": "نور از سمت خورشید به سمت ما حرکت کرد، اون حسابه که حدود هفت دقیقه است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 57.1,
   "end": 64.24,
   "text": "طلوع آفتاب یا نه وقتی که آفتاب به ما جایی که قرار گرفتیم به افق ما رسید،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 64.24,
   "end": 67.02,
   "text": "کدومشه؟ سؤال خیلی علمیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 67.02,
   "end": 74.72,
   "text": "آقا فرمودن نخیر ملاک تابش خورشید نیست، رسیدن نور به محلی که شما در افقش قرار گرفتی مهمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 74.72,
   "end": 79.0,
   "text": "یعنی نور به تو برسه. اما در خصوص",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 79.0,
   "end": 82.28,
   "text": "موضوعی که امروز عرض می‌کنم خیلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 82.28,
   "end": 86.42,
   "text": "مزه مزه کردم. اصلا امروز صحبت بکنم یا نه چون نکته‌ای که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 86.42,
   "end": 93.9,
   "text": "خب مطالعه کردم که امروز بگم خیلی برام سنگینه و میگم ای کاش اصلا کس دیگه‌ای این رو می‌گفت برای شما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 93.9,
   "end": 97.14,
   "text": "خیلی سنگینه و مطلب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 97.14,
   "end": 101.7,
   "text": "یعنی میشه گفت هرکس نباید این حرفو بزنه از دهن منم گنده تره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 101.7,
   "end": 105.28,
   "text": "لکن خب به جهت اهمیت موضوع و خوب بودن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 105.28,
   "end": 110.36,
   "text": "شما و امیدی که به عمل شما داریم ما عرض می‌کنیم ان‌شاءالله خدا مارو هم ببخشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 110.36,
   "end": 114.6,
   "text": "در ادامه بحث قلب مختوم و قلب مه خورده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 114.6,
   "end": 117.52,
   "text": "عرض می‌کنیم که خب چرا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 117.52,
   "end": 120.88,
   "text": "انسان با یه سری گناهان خیلی زود به آخر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 120.88,
   "end": 127.5,
   "text": "کار میرسه تا جایی که مثلا برزخستای عابد طی عمر به قول بعضیا عبادت کرد اما با یک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 127.5,
   "end": 130.62,
   "text": "خطا برای همیشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 130.62,
   "end": 134.46,
   "text": "سرنگون شد و همه سرمایه‌شو از دست داد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 134.46,
   "end": 138.7,
   "text": "و چند تا سؤال ضمنش عرض کنم که این سؤال‌ها جواب‌های",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 138.7,
   "end": 142.92,
   "text": "سختی داره یعنی جوابش سخت نه اینکه پیچیده باشه‌ها،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 142.92,
   "end": 145.8,
   "text": "خیلی سنگینه. به نظر شما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 145.8,
   "end": 149.28,
   "text": "وقتی که شما-- کسی داره شما رو می‌بینه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 149.28,
   "end": 155.14,
   "text": "شما خطا کنی و اون بدونه شما داری نگاش می‌کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 155.14,
   "end": 158.72,
   "text": "اِاِاِ مثلا کسی داره شما رو نگاه می‌کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 158.72,
   "end": 163.86,
   "text": "و زور زده به شما، شما هم می‌دونی که اون داره نگاحت می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 163.86,
   "end": 166.98,
   "text": "اون موقع خطا کنی گناهش بیشتره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 166.98,
   "end": 171.62,
   "text": "یا چشمشو بسته باشه یا اصلا ندونی داره نگاحت می‌کنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 171.62,
   "end": 175.0,
   "text": "وقتی داره شما رو نگاه می‌کنه گناه کنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 175.0,
   "end": 176.6,
   "text": "یه نوع بی‌حرمتی به اونه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 176.6,
   "end": 182.34,
   "text": "چون شما معتقدی او داره نگاحت می‌کنه یعنی نگاه اونو استخفاف کردی، کوچیک شمردی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 182.34,
   "end": 189.44,
   "text": "سؤال دوم: کسی بیرون از خونه شما خطا کنه بیشتر ناراحت میشی یا داخل خونه شما؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 189.44,
   "end": 194.46,
   "text": "خب مت-مطمئنا تو خونه‌ت بیاد خطا کنه خیلی بدجوری باهاش رفتار می‌کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 194.46,
   "end": 198.8,
   "text": "سؤال سوم: کسی نون نمک تو رو بخوره و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 198.8,
   "end": 201.16,
   "text": "نمک خونه تو رو بشکنه سخت‌تره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 201.16,
   "end": 203.54,
   "text": "یا نه نمک تو هم نخورده باشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 203.54,
   "end": 208.88,
   "text": "فقط به تو بی‌حرمتی بکنه؟ خب قطعا نمک تو خورده باشه سر سفره‌ت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 208.88,
   "end": 211.08,
   "text": "سؤال چهارم: کسی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 211.08,
   "end": 214.8,
   "text": "وعده از تو گرفته باشه و خلف وعده کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 214.8,
   "end": 218.08,
   "text": "این سخت‌تره یا نه اصلا کاری به کار تو نداشته باشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 218.08,
   "end": 221.48,
   "text": "یعنی وعده بهش دادی و او خلف وعده می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 221.48,
   "end": 228.96,
   "text": "آمادگی برای انجام و... حالا سؤال‌های اینطوری بخوایم بررسی کنیم خیلی سنگین‌تر میشه جواباش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 228.96,
   "end": 232.96,
   "text": "یکی از دلایلی که اتفاقا این نکته اینجاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 232.96,
   "end": 241.94,
   "text": "یه پرانتز باز کنم ما کسایی که علم داریم و اعتقاد داریم با ما بیشتر سخت‌تر برخورد میشه و زودتر می‌بازیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 241.94,
   "end": 247.36,
   "text": "تا جایی که حدیث عجیبی داریم که هفتاد گناه از جاهل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 247.36,
   "end": 252.56,
   "text": "بخشیده میشه در حالی که یک گناه از عالم بخشیده نشده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 252.56,
   "end": 259.98,
   "text": "این حدیث عجیبیه. امام باقر، امام صادق علیهم الصلاة والسلام دارن این حدیث خیلی عجیبیه واقعا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 259.98,
   "end": 264.88,
   "text": "هفتاد گناه از جاهل بخشیده میشه در حالی که یه دونه از عالم بخشیده نشده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 264.88,
   "end": 272.84,
   "text": "سرش تو همینه. یکی از دلایلی که ما زود می‌بازیم اینه که ما اعتقاد داریم و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 272.84,
   "end": 275.38,
   "text": "باز خلف وعده می‌کنیم باز.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 275.38,
   "end": 284.28,
   "text": "به چی اعتقاد داریم؟ بذارید تو یک روایتی که در کتاب جامع الأخبار صفحه صد و سی بیان شده جواب رو بگم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 284.28,
   "end": 292.24,
   "text": "که هم این روایت هم از نقل به نوعی به همین مضمون با یه ذره تغییر از امام حسین علیه السلام اومده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 292.24,
   "end": 294.76,
   "text": "این سندی که عرض کردم از امام سجاد سلام الله عليه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 294.76,
   "end": 297.3,
   "text": "یکی اومد گفت آقا من می‌خوام گناه کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 297.3,
   "end": 301.84,
   "text": "امام سجاد سلام الله عليه گفت باشه برو گناه کن اما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 301.84,
   "end": 303.98,
   "text": "جایی برو گناه کن که خدا نبیند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 303.98,
   "end": 307.58,
   "text": "گفت عه نمیشه که هرجا برم خدا می‌بینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 307.58,
   "end": 310.98,
   "text": "خب \"و ما koma ای نما کنتوم\" هر کجا باشید خدا با شماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 310.98,
   "end": 314.88,
   "text": "آیه‌شه. گفت خب پس گناه نکن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 314.88,
   "end": 319.74,
   "text": "دید خیلی مصره گفت خب حالا برو یه جایی گناه کن که اونجا ملک خدا نباشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 319.74,
   "end": 323.82,
   "text": "ملک خدا نباشه. \"قل الله ما ملک الارض و من عليها و من الیه تجبون\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 323.82,
   "end": 329.76,
   "text": "این آیه‌شه. گفت بابا نمیشه که هرجا من برم ملک خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 329.76,
   "end": 333.84,
   "text": "باز دید مصر-- حضرت فرمود خب روزی خدا رو نخور.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 333.84,
   "end": 336.04,
   "text": "هر کاری می‌خوای بکن فقط روزی خدا رو نخور.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 336.04,
   "end": 340.2,
   "text": "\"نعمت الله لا تحصى\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 340.2,
   "end": 341.86,
   "text": "اصلا نعمت خدا رو نمیشه شمرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 341.86,
   "end": 347.7,
   "text": "همه چی نعمت خداست. آنچه که در آسمان‌ها و زمین است مال خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 347.7,
   "end": 350.3,
   "text": "باز دید نمیشه اصرار د-- حضرت فرمود خب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 350.3,
   "end": 358.22,
   "text": "یه وعده‌ای خدا داده \"الله يتوفى الأنفس حين موتها\" این آیاتشو من دارم میگما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 358.22,
   "end": 363.66,
   "text": "که خدا خودش قبر روح می‌کنه یه ملکی هم گذاشته که اون ظاهرا وسیله‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 363.66,
   "end": 367.14,
   "text": "وقتی که اومد جونتو بگیره یه وعده‌ای بین تو و خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 367.14,
   "end": 372.8,
   "text": "جونتو بگیره تو جون نده گفت ای بابا نمیشه که چجوری ندم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 372.8,
   "end": 382.38,
   "text": "ببینید وعده ها رو قبول داره. بعد آخر گفت خب اگر می‌تونی وقتی خازن جهنم آمد ببرد جهنم نرو باهاش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 382.38,
   "end": 385.2,
   "text": "پافشاری کن. گفت بابا من نمی‌رم جهنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 385.2,
   "end": 388.66,
   "text": "گفت آقا اونم که نمیشه قرار باشه ببره خدا که زورش به من می‌رسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 388.66,
   "end": 390.48,
   "text": "گفت پس می‌تونی گناه کنی با این‌ها؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 390.48,
   "end": 393.18,
   "text": "گفت نه اصلاً ولش کن. گناه نمی‌خوایم بکنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 393.18,
   "end": 399.54,
   "text": "گناه چیه وقتی نمیشه؟ ببینید یه-- معلومه که آدمی که اعتقادش ضعیف بوده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 399.54,
   "end": 403.54,
   "text": "ولی وقتی فهمید یه چیزی رو عمل کرد گفت من نمی‌خوام گناه کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 403.54,
   "end": 409.7,
   "text": "اما من چی؟ یه حدیث بگم اینا از این جهت میگم کاش من نمی‌گفتم این حرفا رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 409.7,
   "end": 413.28,
   "text": "اینا مسئولیت آوره. خودم واقعاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 413.28,
   "end": 415.38,
   "text": "س-- عمل نکردم رک بگم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 415.38,
   "end": 419.02,
   "text": "انشاالله شما عمل کنید. یه حدیث خیلی سخته این حدیث.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 419.02,
   "end": 421.56,
   "text": "من خیلی با این حدیث گریه‌ها کردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 421.56,
   "end": 423.74,
   "text": "که خدا فرموده که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 423.74,
   "end": 426.96,
   "text": "از اهل بیت علیهم السلام نقل هست که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 426.96,
   "end": 429.58,
   "text": "حدیث قدسی به این مضمون هم داریم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 429.58,
   "end": 435.0,
   "text": "که اگر کسی در حالی که می‌داند خدا او را می‌بیند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 435.0,
   "end": 438.38,
   "text": "گناه کند، هر آینه خدا را",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 438.38,
   "end": 442.18,
   "text": "از یک بچه غیر ممیز هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 442.18,
   "end": 444.42,
   "text": "کوچک‌تر شمرده است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 444.42,
   "end": 447.08,
   "text": "استغفرالله. چرا؟ چرا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 447.08,
   "end": 450.26,
   "text": "چون ما اگه بچه نگاهمون می‌کنه گناه نمی‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 450.26,
   "end": 453.56,
   "text": "می‌دونیم داره نگاهمون می‌کنه. اما خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 453.56,
   "end": 459.44,
   "text": "ختم کلام دلیل حالا همه اینا رو شما بذارید کنار هم برسید به اصل موضوع.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 459.44,
   "end": 461.84,
   "text": "اینا رو ما همه رو مقدمه گفتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 461.84,
   "end": 466.72,
   "text": "حالا می‌فهمین چرا اگر ما خطا کنیم زودتر می‌بازیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 466.72,
   "end": 468.76,
   "text": "و اصلاً مهر زودتر می‌خوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 468.76,
   "end": 471.52,
   "text": "چون ما معتقدیم و گناه می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 471.52,
   "end": 476.76,
   "text": "در حقیقت میشه گفت ما علمشو داریم، عالمیم، جاهل نیستیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 476.76,
   "end": 478.76,
   "text": "اما جاهل خدا می‌بخشه. نمی‌دونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 478.76,
   "end": 482.92,
   "text": "مثل اون گناه کارا اومد اینجوری صادقانه مصرح کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 482.92,
   "end": 485.68,
   "text": "برای همین هم زود مهر می‌خوره دلمون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 485.68,
   "end": 488.52,
   "text": "اگر قرار باشه ما ببازیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 488.52,
   "end": 497.8,
   "text": "پس کسی که یه عمر نه-- اصلاً مسلمون نبوده یهو بیاد مسلمون بشه به نظر شما حتی از جهت شرعی باید نمازاشو قضا کنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 497.8,
   "end": 500.32,
   "text": "نه اصلاً که شرعی، شرع دین میگه‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 500.32,
   "end": 503.38,
   "text": "کسی تازه مسلمون شد اصلاً نیاز نداره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 503.38,
   "end": 506.3,
   "text": "هفتاد سال کافر بوده الان مسلمون شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 506.3,
   "end": 509.08,
   "text": "اصلاً نیازی نداره قضا کنه چون جاهل بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 509.08,
   "end": 515.46,
   "text": "اما برعکس کسی که عالم بوده می‌دونسته نمازی هست، دینی هست مثل مسلمونای شناسنامه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 515.46,
   "end": 522.46,
   "text": "اما هفتاد سال نماز نخوانده. بمیره تا نمازاشو تا رکعت آخرش براش نخونن تو عذابه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 522.46,
   "end": 524.56,
   "text": "این خیلی نهیب بزرگیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 524.56,
   "end": 529.94,
   "text": "\"ختم الله علی قلوبهم\" اتفاقاً دامن ماها رو که عالم هستیم بیشتر می‌گیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 529.94,
   "end": 531.64,
   "text": "خطرش جدی‌تره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 531.64,
   "end": 536.44,
   "text": "انشاالله عاقبتmon ختم به خیر بشه به ذکر صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 536.44,
   "end": 539.98,
   "text": "اللهم صل على",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 539.98,
   "end": 544.9,
   "text": "محمد و آل محمد و عجل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}