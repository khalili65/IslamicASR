 "chapters": [
  {
   "index": 0,
   "title": "## احتیاط فجر صادق در همهٔ شب‌ها",
   "start": 14.28,
   "end": 34.62
  },
  {
   "index": 1,
   "title": "## قلب مختوم؛ پایان راه هوای نفس",
   "start": 34.62,
   "end": 202.58
  },
  {
   "index": 2,
   "title": "## وزن‌کشی معنوی در مجالس",
   "start": 202.58,
   "end": 252.38
  },
  {
   "index": 3,
   "title": "## حکایت حرم رضوی",
   "start": 252.38,
   "end": 333.34
  },
  {
   "index": 4,
   "title": "## داستان مؤذن و نقد یک‌نگاه‌انگاری",
   "start": 333.34,
   "end": 515.37
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 1.96,
   "end": 5.98,
   "text": "بسم الله الرحمن الرحیم و بهی نستعین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 5.98,
   "end": 9.84,
   "text": "السلام علیک یا داعی الله و ربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 9.84,
   "end": 14.28,
   "text": "آیا ص. سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 14.28,
   "end": 18.9,
   "text": "از رهبر عزیزمون استفتاء شده که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 18.9,
   "end": 22.48,
   "text": "این فجر صادق برای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 22.48,
   "end": 26.28,
   "text": "زمان نماز صبح که آغاز میشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 26.28,
   "end": 30.64,
   "text": "آیا این که میگن احتیاطاً شما فرمودید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 30.64,
   "end": 39.08,
   "text": "چند دقیقه‌ای صبر کنید بعد از اذان صبح احتیاطاً بعد نماز صبح رو بخونید که متوجه بشید فجر صادق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 39.08,
   "end": 44.26,
   "text": "اتفاق افتاده مربوط به شب‌های مهتابیه یا غیر مهتابی هم طور هست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 44.26,
   "end": 48.12,
   "text": "آقا فرمودن نه خوا-- اختصاص به شب‌های مهتابی نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 48.12,
   "end": 54.38,
   "text": "همه شب‌ها این اتفاق رو آقا احتیاط کردن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 54.38,
   "end": 57.72,
   "text": "بعد از اذان صبح یه چند دقیقه‌ای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 57.72,
   "end": 61.22,
   "text": "بعضیا تا یک ربع تا بیست دقیقه هم حتی صبر می‌کنن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 61.22,
   "end": 66.76,
   "text": "برای اینکه مطمئن شن دیگه طول فجر صادق اتفاق افتاده بعد نماز صبح رو می‌خونن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 66.76,
   "end": 68.56,
   "text": "یعنی هر شب، هر شب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 68.56,
   "end": 71.96,
   "text": "البته این احتیاطه، واجب نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 71.96,
   "end": 79.12,
   "text": "اما در خصوص قلب مختوم عرض کنم یه تشکر از عزیزانی بکنم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 79.12,
   "end": 85.72,
   "text": "به هر حال ااا تشنه‌ان نسبت به این معارف و وظیفه بنده رو هم سنگین‌تر می‌کنن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 85.72,
   "end": 88.06,
   "text": "و ما اون روزی که این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 88.06,
   "end": 94.2,
   "text": "صحبت‌هامون رو انداختیم بعد از نماز عصر دیگه بین دو نماز صحبت نکردیم بعضیا گفتن حاجی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 94.2,
   "end": 96.56,
   "text": "خیلی ب-- میرن عده‌ای نمی‌شینن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 96.56,
   "end": 98.16,
   "text": "گفتم هرکی تشنه‌ست بشینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 98.16,
   "end": 104.9,
   "text": "ولی الحمدلله می‌بینیم که اکثراً می‌شینن و این تشنگی شما هم می‌رسونه به وسی-- وظیفه منم سنگین‌تر میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 104.9,
   "end": 110.02,
   "text": "در هر حال امیدوارم که این قافله در عمل به سرمنزل مقصود برسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 110.02,
   "end": 114.9,
   "text": "بحث ما قلب مختوم بود، آیاتش رو ارائه کردیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 114.9,
   "end": 118.26,
   "text": "و عرض کردیم که از خطرناک‌ترین چیزها که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 118.26,
   "end": 121.58,
   "text": "ما رو به جایی می‌رسونه که ختم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 121.58,
   "end": 125.04,
   "text": "متاسفانه قلبمون اعلام بشه در درگاه الهی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 125.04,
   "end": 128.32,
   "text": "یعنی تا آخر کار بریم و دیگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 128.32,
   "end": 130.96,
   "text": "تا آخر هوای نفس رو پیش بریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 130.96,
   "end": 135.86,
   "text": "همون تبعیت از خواهش دل هست که مغایر است به،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 135.86,
   "end": 139.46,
   "text": "مغایر است با دستورات الهی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 139.46,
   "end": 143.28,
   "text": "نکته بسیار مهمی که اینجا قابل توجه هست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 143.28,
   "end": 146.7,
   "text": "اونم اینه که حواسمون باید جمع باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 146.7,
   "end": 151.02,
   "text": "همونطور که قبلاً عرض کردیم چه در مسیر خودسازی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 151.02,
   "end": 154.46,
   "text": "و چه در مسیر خدای نکرده انحطاط",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 154.46,
   "end": 159.76,
   "text": "یعنی تبعیت از هوای نفس، هر دو انسان قدم‌به‌قدم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 159.76,
   "end": 162.74,
   "text": "چه رشد می‌کنه، چه پسرفت می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 162.74,
   "end": 165.64,
   "text": "در هر دو قدم‌به‌قدم هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 165.64,
   "end": 171.42,
   "text": "یعنی چه در خصوص انحرافات شیطانی، چه رشد رحمانی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 171.42,
   "end": 176.96,
   "text": "از، از حیث مخالفت با نفس انسان باید قدم‌به‌قدم پیش بره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 176.96,
   "end": 181.9,
   "text": "یه دفعه ما الان که مثلاً نماز صبحمون یه رو، یه روز قضا میشه بیاییم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 181.9,
   "end": 187.2,
   "text": "نمک بزنیم به مثلاً هندوانه‌مون ادای عرفا رو دربیاریم هندوانه رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 187.2,
   "end": 192.74,
   "text": "یه جوری بخوریم مزه‌ش رو نفهمیم بعد از اون طرف نماز صبح‌مون قضا میشه این فایده‌ای نداره که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 192.74,
   "end": 195.52,
   "text": "میگه پله‌پله قدم‌به‌قدم برو جلو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 195.52,
   "end": 200.24,
   "text": "اول واجب‌هاتو درست کن، محرمات مسلم‌تو ترک کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 200.24,
   "end": 207.5,
   "text": "تو این مجالس که می‌نشینیم حضرت استاد آقای حق شناس فرمودن حضرت امام رحمة الله علیه به ما فرموده بودند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 207.5,
   "end": 214.08,
   "text": "که یکی از اسرار نشست و برخاست در این جلسات و با منبرها وزن‌کشی معنوی است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 214.08,
   "end": 221.68,
   "text": "وزن‌کشی یعنی همینطور که ورزشکار هی هر روز خودشو وزن می‌کنه ببینه چه مقدار شده هی خودشو رشد میده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 221.68,
   "end": 225.62,
   "text": "ما هم در این جلسات می‌نشینیم خودمون و وزن کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 225.62,
   "end": 230.16,
   "text": "ببینیم تو چه وضعیتی هستیم. تطبیق میدیم خودمون رو با دستورات الهی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 230.16,
   "end": 232.34,
   "text": "اعم از آیات و روایات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 232.34,
   "end": 237.34,
   "text": "که ببینیم وزن‌مون تا چه عهده. از اون طرف هم تو وادی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 237.34,
   "end": 240.38,
   "text": "هوای نفس این خیلی باید حواسمون جمع باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 240.38,
   "end": 244.86,
   "text": "شیطان برنامه‌ش قبلاً عرض کردیم چندین ساله است، چهل ساله است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 244.86,
   "end": 247.42,
   "text": "یه دفعه نمیاد یه ساله ایمان ما رو بگیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 247.42,
   "end": 250.62,
   "text": "خورد خورد، خطوه خطوه، قدم‌به‌قدم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 250.62,
   "end": 253.86,
   "text": "انسان رو میبره جلو. یکی از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 253.86,
   "end": 257.16,
   "text": "ااا فضلا اومد پیش استادش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 257.16,
   "end": 259.98,
   "text": "حالا هیچ اسم هر دوتاش هم من",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 259.98,
   "end": 262.52,
   "text": "نمیگم معذور دارم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 262.52,
   "end": 266.0,
   "text": "اومد داد زد شروع کرد گریه افتاد به پای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 266.0,
   "end": 268.16,
   "text": "استادش که آقا به دادم برس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 268.16,
   "end": 271.5,
   "text": "چی شده؟ گفت من تازه فهمیدم چه بلایی سرم اومده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 271.5,
   "end": 274.52,
   "text": "چطور؟ گفت رفته بودم حرم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 274.52,
   "end": 277.14,
   "text": "آقا علی ابن موسی الرضا علیهم الصلاة والسلام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 277.14,
   "end": 284.44,
   "text": "یه لحظه به خودم اومدم دیدم دارم از لای شبکه‌های زریح قسمت خانوما رو نگاه می‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 284.44,
   "end": 291.82,
   "text": "زریح تو بغلمه اما حواسم پرت شده به خانم‌هایی که اون ور زریح رو بغل کردن دارم توجه به اونا می‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 291.82,
   "end": 294.76,
   "text": "تازه فهمیدم که شیطان تا کجا اومده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 294.76,
   "end": 296.52,
   "text": "خب روز اول که اینطوری نبود که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 296.52,
   "end": 302.06,
   "text": "روز اول که زریح رو بغل می‌کرد چنان می‌ترکید که می‌خواستن به زور از زریح جداش کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 302.06,
   "end": 308.16,
   "text": "اما خورد خورد ما خودمون باید برسیم به اینجا که کجای کاریم، وزن‌کشی کنیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 308.16,
   "end": 312.64,
   "text": "حالات الانمون رو با سال‌های قبلمون، نمازهامون رو، اشک‌مون رو،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 312.64,
   "end": 315.4,
   "text": "عبادیاتمون رو، برنامه‌مون همه رو تطبیق بدیم با",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 315.4,
   "end": 322.58,
   "text": "سال‌های قبل ببینیم خود انسان متوجه میشه تو این بیست ساله، سی ساله، چهل ساله رو به رشد رفته یا پسرفت رفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 322.58,
   "end": 327.52,
   "text": "این خطره اگر کسی رشد نداشته و حالش بدتر شده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 327.52,
   "end": 330.94,
   "text": "ااا عرض کنم توفیقاتش کم شده، این خیلی خطره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 330.94,
   "end": 335.52,
   "text": "یه داستانی هست طرح می‌کنم و این رو این داستان نقدی وارد کنم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 335.52,
   "end": 339.64,
   "text": "که بسیار شاید شنیده باشین تو منبرها که یه مؤذنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 339.64,
   "end": 344.0,
   "text": "رفت بالای م-- مع-معذنه مسجد اذان بده در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 344.0,
   "end": 347.2,
   "text": "حین اذان چشمش افتاد به حیاط",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 347.2,
   "end": 351.12,
   "text": "خونه مقابل دید یک دختر خیلی خوش سیمایی و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 351.12,
   "end": 357.94,
   "text": "سر و رو بازه داره مثلاً لباس پهن می‌کنه و این در حین اذان توجه کرد، نگاهش رو ادامه داد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 357.94,
   "end": 362.79,
   "text": "عاشق شد. خلاصه رد خونه رو گرفت و رفت و بعد از اذان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 362.79,
   "end": 364.89,
   "text": "رفت و خواستگاری کرد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 364.89,
   "end": 370.95,
   "text": "دید مسیحی‌ان. پدر این خانواده گفتش که خب میدونی ما مسیحی‌ایم اگه بخوای داماد ما بشی باید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 370.95,
   "end": 373.39,
   "text": "دست از اسلام بکشی مسیحی بشی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 373.39,
   "end": 377.63,
   "text": "اینم قبول کرد. اسلام رو گذاشت کنار مسیحی شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 377.63,
   "end": 382.57,
   "text": "مؤذن مسجد. یه داستانی که خیلی از بزرگان هم میان بالا منبر میگن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 382.57,
   "end": 384.43,
   "text": "منتها این توضیح قیدش نمیشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 384.43,
   "end": 386.71,
   "text": "این توضیحی که من الان دارم عرض می‌کنم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 386.71,
   "end": 390.43,
   "text": "که مقدمه قرار دادم. خلاصه هیچی میره و خلاصه مسیحی میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 390.43,
   "end": 392.95,
   "text": "روزی که میخوان برن مثلاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 392.95,
   "end": 396.01,
   "text": "خطبه رو جاری کنن میخوان برن تو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 396.01,
   "end": 399.47,
   "text": "حجله به قول ماها، این پله پله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 399.47,
   "end": 405.33,
   "text": "داشت از این خونه‌های قدیمی می‌رفت بالا پاش سر خورد آقا داماد بعد از اینکه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 405.33,
   "end": 408.99,
   "text": "اههе اسم-- مسیحیت رو اختیار کرد با مخ خورد زمین و جون داد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 408.99,
   "end": 410.71,
   "text": "اصلاً به اون زن هم نرسید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 410.71,
   "end": 417.23,
   "text": "میگن یه نگاه، رها کردن یه نگاه او را از اسلام بیرون کرد و به این حالت کشیدش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 417.23,
   "end": 421.71,
   "text": "من حرفم این است که اصلاً محاله ما بالاخره هممون تو مساجد بزرگ شدیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 421.71,
   "end": 423.41,
   "text": "و بسیاری از ما مؤذنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 423.41,
   "end": 427.41,
   "text": "محاله انسان با یک نگاه اینطوری بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 427.41,
   "end": 433.83,
   "text": "نمیشه کسی که یه-- اون مؤذن نماز مسجد بوده یه دفعه با یه نگاه بیاد اسلامو کنار بذاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 433.83,
   "end": 436.49,
   "text": "میشه همچین چیزی؟ نمیشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 436.49,
   "end": 439.73,
   "text": "این به نظر من این حرف یه جاش ایراد داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 439.73,
   "end": 441.67,
   "text": "ایرادش اینجاست که توجه نکردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 441.67,
   "end": 447.25,
   "text": "این آقا قطعاً سالیان سال بوده گرفتار نگاه آلوده بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 447.25,
   "end": 451.05,
   "text": "یعنی آلود-- نگاهش رها بوده و الا کسی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 451.05,
   "end": 456.31,
   "text": "اینطور نبوده خودنگهداری داشته یه دفعه با یه نگاه به جایی نمی‌رسه که بخواد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 456.31,
   "end": 459.27,
   "text": "از نماز دست بکشه. بعد بره اسلامو بذاره کنار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 459.27,
   "end": 462.61,
   "text": "نمیشه. این به نظر من تخفیف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 462.61,
   "end": 465.47,
   "text": "و میشه گفت خفیف شمردن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 465.47,
   "end": 469.59,
   "text": "جایگاه نماز و جایگاه مؤذنه و اذان و ایناست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 469.59,
   "end": 474.81,
   "text": "اینطوری نیست. نه، این آقا هرکی بوده و تاریخ نقل کرده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 474.81,
   "end": 479.43,
   "text": "خطبه خطبه، قدم به قدم شیطان باهاش راه رفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 479.43,
   "end": 484.61,
   "text": "یواش یواش دعوتش کرده کشوندش به جایی که دیگه خودنگهداریش در خصوص",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 484.61,
   "end": 487.41,
   "text": "چشمش رها بوده. نگاه می‌کرده راحت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 487.41,
   "end": 492.83,
   "text": "حالا نمازشم می‌خوندن از اون طرف خرد خرد به جایی رسیده که این، این بلا سرش اومده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 492.83,
   "end": 498.87,
   "text": "می‌خوام بگم بترسیم از اینکه خدای نکرده ما قدم به قدم به سمتی بریم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 498.87,
   "end": 500.97,
   "text": "آخرش ختم الله علی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 500.97,
   "end": 507.29,
   "text": "قلوبهم اتفاق بیفته. عاقبتمون ان شا الله ختم به خیر بشه به ذکر صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 507.29,
   "end": 513.27,
   "text": "اللهم صل علی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 513.27,
   "end": 515.37,
   "text": "محمد و آل محمد و عجل فرجهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}