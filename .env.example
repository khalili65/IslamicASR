# Copy this file to .env and fill in the keys you want to test.
# .env is git-ignored. You only need keys for the providers you actually run;
# `python compare_asr.py --list` shows which ones are configured.

# --- Fish Audio (the original backend) -------------------------------------
# https://fish.audio/go-api/
FISH_API_KEY=00b9ae79a4c64f64b81c601d0f171af2

# --- ElevenLabs Scribe ------------------------------------------------------
# https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=

# --- OpenAI (gpt-4o-transcribe / whisper-1) ---------------------------------
# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# --- Groq (hosted Whisper large-v3) -----------------------------------------
# https://console.groq.com/keys
GROQ_API_KEY=

# --- AssemblyAI -------------------------------------------------------------
# https://www.assemblyai.com/dashboard/signup
ASSEMBLYAI_API_KEY=

# --- Microsoft Azure AI Speech ----------------------------------------------
# https://portal.azure.com  (Speech resource -> Keys and Endpoint)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=westeurope

# --- Google Cloud Speech-to-Text v2 (Chirp) ---------------------------------
# Token expires hourly: GOOGLE_ACCESS_TOKEN=$(gcloud auth print-access-token)
GOOGLE_ACCESS_TOKEN=
GOOGLE_PROJECT_ID=
GOOGLE_STT_LOCATION=us-central1

# --- Speechmatics -----------------------------------------------------------
# https://portal.speechmatics.com/signup
SPEECHMATICS_API_KEY=

# --- Deepgram (does not support Persian; here for completeness) -------------
# https://console.deepgram.com/signup
DEEPGRAM_API_KEY=
