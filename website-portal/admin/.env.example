# Copy to .env.local (never commit)

# Required — shared password for all editors (change this!)
ADMIN_PASSWORD=choose-a-strong-password

# Optional — defaults work when repo is cloned at IslamASR
# REPO_ROOT=/path/to/IslamASR

# Which public site this admin manages (pick one):
# Bayat (single lecturer):
SITE_ROOT=/path/to/IslamASR/website
SITE_LABEL=درس‌گفتارهای استاد بیات
# Portal (multi lecturer):
# SITE_ROOT=/path/to/IslamASR/website-portal
# SITE_LABEL=پورتال درس‌گفتارها

# Publish → Arvan (only if "آپلود Arvan" is checked)
# Keys can also be read from repo-root .env.arvan
# ARVAN_ACCESS_KEY=
# ARVAN_SECRET_KEY=
# Bayat buckets (auto when SITE_ROOT=website):
# ARVAN_WEB_BUCKET=islamic-asr-web
# NEXT_PUBLIC_MEDIA_BASE=https://islamic-asr-media.s3.ir-thr-at1.arvanstorage.ir
# Portal buckets (auto when SITE_ROOT=website-portal):
# ARVAN_WEB_BUCKET=islamic-asr-portal-web
# NEXT_PUBLIC_MEDIA_BASE=https://islamic-asr-portal-media.s3.ir-thr-at1.arvanstorage.ir
# ARVAN_ENDPOINT=https://s3.ir-thr-at1.arvanstorage.ir
# ARVAN_REGION=ir-thr-at1

# Optional session hardening
# ADMIN_SESSION_SECRET=random-long-string
