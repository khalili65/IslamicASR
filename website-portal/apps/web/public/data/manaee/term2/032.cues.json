   "title": "## تناسبِ قسم و جواب؛ دو جوابِ اصلی",
   "start": 10.42,
   "end": 55.46
  },
  {
   "index": 1,
   "title": "## بیانِ اول؛ تشبیهِ ظهورِ جبرئیل به ستارگان",
   "start": 55.46,
   "end": 161.74
  },
  {
   "index": 2,
   "title": "## بیانِ دوم؛ شهاب‌سنگ‌ها و حراستِ مسیرِ تنزّلِ وحی",
   "start": 161.74,
   "end": 385.46
  },
  {
   "index": 3,
   "title": "## پیوندِ دو سیاق؛ ضمیرِ «إنّه» و پیامِ اصلیِ سوره",
   "start": 385.46,
   "end": 407.1
  },
  {
   "index": 4,
   "title": "## یادآوریِ مراحلِ آسمان؛ انفطار تا کشف",
   "start": 407.1,
   "end": 480.66
  },
  {
   "index": 5,
   "title": "## واوِ «واللیل» و «والصبح»؛ ترجیحِ واوِ قسم",
   "start": 480.66,
   "end": 868.8
  },
  {
   "index": 6,
   "title": "## ختمِ جلسه؛ قرائتِ سورهٔ تکویر",
   "start": 868.8,
   "end": 1027.73
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 10.42,
   "end": 13.86,
   "text": "اعوذ بالله من الشيطان الرجيم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 13.86,
   "end": 18.48,
   "text": "بسم الله الرحمن الرحيم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 18.48,
   "end": 21.68,
   "text": "خب ببینید یک بحثی که میخواستم مطرح کنم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 21.68,
   "end": 26.24,
   "text": "مسئله ارتباط قسم و جوابه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 26.24,
   "end": 29.08,
   "text": "همونطور که میبینید بعد از قسم های آیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 29.08,
   "end": 38.3,
   "text": "پونزده تا هجده \"فلا اقسم بالخنّس الجوار الكنّس والليل إذا عسعس والصبح إذا تنفس\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 38.3,
   "end": 45.8,
   "text": "دو تا جواب قسم اصلی شما دارید یکی \"إنه لقول رسول كريم\" یکی \"وما هو بقول شيطان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 45.8,
   "end": 53.74,
   "text": "رجيم\". بعضی تناسب قسم و جواب رو به این بیان مطرح کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 53.74,
   "end": 57.44,
   "text": "فرمودن که در حقیقت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 57.44,
   "end": 64.38,
   "text": "این رسول کریم که در این آیات آمده یعنی حضرت جبرائیل علیه السلام،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 64.38,
   "end": 73.22,
   "text": "این حضرت برای دقایقی یا ساعاتی یا لحظاتی هرچه در افق مبین توسط پیامبر چه شد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 73.22,
   "end": 80.12,
   "text": "مشاهده شد. خواستن بگن که اون بحث اول که می فرماید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 80.12,
   "end": 84.66,
   "text": "\"فلا اقسم بالخنّس الجوار الكنّس\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 84.66,
   "end": 92.08,
   "text": "اون یادآور، میخواد با تشبیه با یادآوری ستارگان که اول مخفی‌اند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 92.08,
   "end": 101.2,
   "text": "بعد یه جلوه گری می‌کنند، یه حرکتی دارند بعد دو مرتبه در گویا لانه خود مستقر میشن، در جایگاه خود مستقر میشن؛",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 101.2,
   "end": 103.98,
   "text": "میخواد زمینه ساز باشه یادآور",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 103.98,
   "end": 105.88,
   "text": "این ظهور و این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 105.88,
   "end": 114.78,
   "text": "جلوه گری حضرت جبرائیل علیه السلام باشه که ایشون اولاً مخفیست سپس یه جلوه‌ای کرده رؤیت شده دو مرتبه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 114.78,
   "end": 117.64,
   "text": "چه شده؟ دو مرتبه پنهان شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 117.64,
   "end": 119.96,
   "text": "دو مرتبه از رؤیت حضرت مخفی شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 119.96,
   "end": 123.92,
   "text": "این جور تعبیری مطرحه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 123.92,
   "end": 131.34,
   "text": "بعد \"والليل إذا عسعس والصبح إذا تنفس\" رو هم یک عبارت بشارت آمیزی میدونن دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 131.34,
   "end": 135.7,
   "text": "عبارت بشارت آمیزی که از پشت کردن شب و روی کردن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 135.7,
   "end": 143.3,
   "text": "صبح خبر میده و در حقیقت میخواد بگه با سخن جبرائیل علیه السلام صبح هدایت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 143.3,
   "end": 147.22,
   "text": "دمید و امید است که شب ظلمانی جهالت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 147.22,
   "end": 153.88,
   "text": "پشت کند. خب. این مطلب درسته به نظرم تناسب موجهیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 153.88,
   "end": 159.48,
   "text": "ولی یه تناسب دیگر رو هم میخوام عرض کنم که شاید شاهد قرآنی‌ش قوی‌تر باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 159.48,
   "end": 168.2,
   "text": "اونم این است که خب اگر ما بپذیریم که \"الخنّس الجوار الكنّس\" شهاب سنگ‌ها باشند،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 168.2,
   "end": 172.48,
   "text": "که این‌ها وقتی مشتعل میشن رؤیت میشن، قبلش مخفی‌اند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 172.48,
   "end": 175.96,
   "text": "بعد رؤیت میشن، بعد دو مرتبه چه میشن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 175.96,
   "end": 180.52,
   "text": "در جایگاهی مستقر می‌شن و خاموش می‌شن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 180.52,
   "end": 186.04,
   "text": "در قرآن کریم شهاب سنگ‌ها کارکردشون چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 186.04,
   "end": 192.28,
   "text": "دفع شیاطینه. دفع شیاطین، رجم شیاطین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 192.28,
   "end": 195.34,
   "text": "شیاطین برای چی باید رجم بشن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 195.34,
   "end": 203.92,
   "text": "برای چی باید دفع بشن؟ برای حراست از مسیر تنزل وحیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 203.92,
   "end": 207.02,
   "text": "اگر به سوره جن مراجعه بکنید،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 207.02,
   "end": 213.04,
   "text": "در سوره جن می بینید که جنیانی که رسیدن به قرآن کریم و قرآن کریم رو شنیدن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 213.04,
   "end": 215.48,
   "text": "اونا دارن یه نقل قولی می‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 215.48,
   "end": 218.64,
   "text": "میگن ما رفتیم به آسمان \"أنا لمسنا السماء\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 218.64,
   "end": 222.79,
   "text": "آسمان را رفتیم مثل همیشه مورد جستجو قرار بدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 222.79,
   "end": 228.74,
   "text": "\"فوجدناها ملأت حرسا شديدا وشهبا\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 228.74,
   "end": 233.26,
   "text": "دیدیم آسمان پر از نگهبان و شهاب سنگ شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 233.26,
   "end": 237.41,
   "text": "نگهبانانی و شهاب سنگ‌هایی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 237.41,
   "end": 246.1,
   "text": "\"أنا كنا نقعد منها مقاعد للسمع\" ما قبلاً یه جاهایی تو آسمان می‌نشستیم استراق سمع می‌کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 246.1,
   "end": 253.07,
   "text": "یه چیزایی رو دزدکی از اخبار غیبی ما هم استفاده می‌کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 253.07,
   "end": 259.52,
   "text": "\"فمن يستمع الآن\" اما الان هرکس که بخواد استماع بکنه چیزی از اخبار غیبی را",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 259.52,
   "end": 263.14,
   "text": "\"يجد له شهابا رصدا\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 263.14,
   "end": 269.82,
   "text": "فوری یک شهاب سنگی که او را داره رصد میکنه به او اصابت میکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 269.82,
   "end": 274.06,
   "text": "یا در جاهای دیگری از قرآن هم فرموده \"فأتبعه شهاب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 274.06,
   "end": 279.74,
   "text": "ثاقب\" یعنی شهاب ثاقب دنبال میکنه شیاطین رو در آسمان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 279.74,
   "end": 290.22,
   "text": "و اونها رو دفع میکنه که اونها در مسیر تنزل قرآن دخالت، افساد، اخلال نکنند و استراق سمع، قاچاق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 290.22,
   "end": 296.66,
   "text": "نکنند. حفظ و حراست مسیر تنزل وحی که همون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 296.66,
   "end": 299.95,
   "text": "آسمان باشه، خدا وحی رو در آسمان تنزل میده دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 299.95,
   "end": 305.0,
   "text": "\"يتنزل الأمر بينهن\" خدا وحی رو در آسمان تنزل میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 305.0,
   "end": 307.66,
   "text": "آسمان طریقه، راهه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 307.66,
   "end": 313.82,
   "text": "راهی‌ست که از عالم ملکوت خدا پیامش را از طریق آسمان می‌رساند به عالم ملک.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 313.82,
   "end": 319.9,
   "text": "خب. این راه از نفوذ و دخالت شیاطین محفوظ میمونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 319.9,
   "end": 326.04,
   "text": "لذا کسی نمی‌تواند بگوید که \"هو قول شيطان رجيم\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 326.04,
   "end": 328.64,
   "text": "\"إنه لقول رسول",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 328.64,
   "end": 332.26,
   "text": "كريم وما هو بقول شيطان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 332.26,
   "end": 334.38,
   "text": "رجيم\". یعنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 334.38,
   "end": 336.76,
   "text": "اشاره به اون قسم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 336.76,
   "end": 343.34,
   "text": "اون قسمه برای یادآوری این مسئله است که بابا آسمان از نفوذ شیاطین چه می‌شود؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 343.34,
   "end": 344.98,
   "text": "حفاظت و حراست می‌شود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 344.98,
   "end": 349.58,
   "text": "پس دیگه شما نمی‌تونید بگید این سخن، سخن شیطانه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 349.58,
   "end": 354.04,
   "text": "این باز تناسبش بیشتره با جواب قسم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 354.04,
   "end": 359.84,
   "text": "بعد اون تکه \"والليل إذا عسعس والصبح إذا تنفس\" بله همون حرفو میشه اینجا زد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 359.84,
   "end": 363.44,
   "text": "حالا که قول رسول کریم است نه قول شيطان رجيم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 363.44,
   "end": 365.98,
   "text": "پس این سخن وعده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 365.98,
   "end": 369.52,
   "text": "دمیده شدن صبح هدایت را می‌دهد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 369.52,
   "end": 374.14,
   "text": "و ما منتظر پشت کردن شب ظلمت و جهالت بگید،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 374.14,
   "end": 378.46,
   "text": "هستیم. \"والليل اذا عسعس والصبح اذا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 378.46,
   "end": 384.16,
   "text": "تنفس\". این یه توضیحی بود که باید درباره تناسب قسم و جواب می‌دادیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 384.16,
   "end": 389.57,
   "text": "و اما مطلب بعدی که به ارتباط دو سیاق و نتیجه‌گیری از کل سوره مربوطه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 389.57,
   "end": 395.36,
   "text": "همونطور که عرض کردم سیاق دوم وقتی میگه \"انه\" این \"ه\" به کی خورد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 395.36,
   "end": 398.16,
   "text": "به چی خورد؟ به سیاق اول خورد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 398.16,
   "end": 402.32,
   "text": "پس ارتباط سیاق دو با سیاق یک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 402.32,
   "end": 405.66,
   "text": "از طریق برگشت ضمیر \"انه\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 405.66,
   "end": 409.69,
   "text": "و همینطور ضمیر \"ه\" در \"ما هو بقول الشيطان\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 409.69,
   "end": 413.72,
   "text": "\"انه لقول رسول ما هو بقول الشيطان\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 413.72,
   "end": 419.12,
   "text": "اون \"ه\"، این \"ه\" هر دو داره به سیاق یک برمی‌گرده، به آیه یک تا چهارده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 419.12,
   "end": 424.1,
   "text": "این اتصال رو برقرار کرد. اما سوالی که میخوام جواب بدیم اینه:",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 424.1,
   "end": 426.8,
   "text": "یه سیاق درباره معاد بوده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 426.8,
   "end": 429.48,
   "text": "یه سیاق در دفاع از قرآن بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 429.48,
   "end": 437.18,
   "text": "اگر ما بخوایم سوره را جمع‌بندی کنیم بگیم بالاخره سوره معادیه یا قرآنیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 437.18,
   "end": 441.88,
   "text": "اون اصل در سوره، اون پیام اصلی سوره معاده یا قرآنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 441.88,
   "end": 445.0,
   "text": "نظر شما چیه و چرا؟ معاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 445.0,
   "end": 447.24,
   "text": "چرا؟ احسنت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 447.24,
   "end": 450.52,
   "text": "احسنت. سوره، سوره معادیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 450.52,
   "end": 458.6,
   "text": "اون قسمتی که مربوط به قرآنه، اون قسمت در راستای دفاع از حقانیت همون قسمت اول آمده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 458.6,
   "end": 463.8,
   "text": "پس نباید باعث بشه ما فکر کنیم سوره، سوره-- بله قرآن رو هم داره دفاع میکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 463.8,
   "end": 469.0,
   "text": "اما در راستای دفاع از پیام معاده که داره از قرآن دفاع میکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 469.0,
   "end": 471.28,
   "text": "دفاع مستقل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 471.28,
   "end": 473.2,
   "text": "نیست. یه دفاع ارتباطیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 473.2,
   "end": 476.42,
   "text": "در ارتباط با بحث معاد داره از قرآن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 476.42,
   "end": 482.64,
   "text": "دفاع میکنه. اینم در واقع مطلب دومی بود که ذیل ارتباط دو سیاق سوره باید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 482.64,
   "end": 486.6,
   "text": "گفته میشد. بله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 486.6,
   "end": 489.32,
   "text": "انفطار یعنی چی؟ انفطار، انشقاق،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 489.32,
   "end": 493.2,
   "text": "جمع کردن، \"نقع السماء کطي السجل\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 493.2,
   "end": 495.42,
   "text": "بعد کشفت، کنده شدن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 495.42,
   "end": 498.3,
   "text": "به طور کامل برکنده شدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 498.3,
   "end": 502.8,
   "text": "حالا اینا چیزیه که با توجه به چند تا آیه‌ای که تو ذهن دارم ترتیبشو عرض کردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 502.8,
   "end": 507.9,
   "text": "ممکنه مطالعه بیشتر بکنیم آیات دیگر بیاد مراحل دیگری بین این‌ها،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 507.9,
   "end": 515.32,
   "text": "لابه‌لای این‌ها بگنجد. اما این چهار تا آیه‌ای که عرض کردم ترتیبش اینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 515.32,
   "end": 519.54,
   "text": "مطلبی هست؟ کنده شدن کنده شدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 519.54,
   "end": 523.02,
   "text": "کشفت، کشفت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 523.02,
   "end": 526.18,
   "text": "جمع شدن، نقع السماء،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 526.18,
   "end": 530.92,
   "text": "انشقاق، \"اذا السماء انشقت\"، انفطار، \"اذا السماء انفطرت\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 530.92,
   "end": 535.18,
   "text": "بله؟ آیه بیست و پنجو که ما در عرض بیست و دو ننوشتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 535.18,
   "end": 538.92,
   "text": "بیست و پنجو ذیل، در عرض نوزده نوشتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 538.92,
   "end": 543.14,
   "text": "یعنی یه حرف اینه که \"انه لقول رسول کریم\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 543.14,
   "end": 546.86,
   "text": "یه حرف اینه که \"ما هو بقول الشيطان الرجيم\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 546.86,
   "end": 551.14,
   "text": "حالا اونجایی که فرموده \"انه لقول رسول کریم\"،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 551.14,
   "end": 555.35,
   "text": "ذیل اون گفته \"لقد رآه بالافق المبين\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 555.35,
   "end": 560.62,
   "text": "\"ما هو بصاحبكم بمجنون ولقد رآه بالافق المبين\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 560.62,
   "end": 567.56,
   "text": "یعنی اونجا به شکل ضمنی گفته که ایشون جن زده نشده بلکه چی دیده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 567.56,
   "end": 570.74,
   "text": "چی دیده؟ فرشته وحی را دیده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 570.74,
   "end": 575.68,
   "text": "حالا اگه کسی بخواد سؤال کنه مگر گفته بودن ایشون جن زده شده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 575.68,
   "end": 578.58,
   "text": "اون آیه بیست و پنج مشخص میکنه بله،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 578.58,
   "end": 584.04,
   "text": "اینا میخواستن بگن این سخنانی که او میگه سخنان شیطانه که جنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 584.04,
   "end": 588.6,
   "text": "و اون مجنون و تحت سلطه شیطانه داره این حرفا رو میزنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 588.6,
   "end": 592.38,
   "text": "حالا اینکه اونا چه توجیهی برای حرف خودشون داشتن، هیچی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 592.38,
   "end": 596.92,
   "text": "اتهام که خرج نداره. آیات شیطانیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 596.92,
   "end": 602.88,
   "text": "خدا جواب داره میده. خدا میگه بابا \"ذکر للعالمین\" یعنی اگه به درونت مراجعه کنی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 602.88,
   "end": 605.44,
   "text": "میفهمی که این آیات شیطان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 605.44,
   "end": 614.02,
   "text": "نیست. شیطان برای چی باید بیاد از پایان دنیا و از عمل کرد و اینکه باید مراقب اعمالتون باشید با شما حرف بزنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 614.02,
   "end": 619.34,
   "text": "شما هم در درونتون میدونید معاد وجود داره هم میدونید این حرفا حرف شیطان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 619.34,
   "end": 626.68,
   "text": "نیست. پس دارید یه فرار غیر موجهی دارید \"فأين تذهبون\" و کجا در میرید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 626.68,
   "end": 629.0,
   "text": "این فرار موجهی نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 629.0,
   "end": 631.68,
   "text": "اگه توجیهی داشتید راست راستی میشد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 631.68,
   "end": 633.84,
   "text": "بنا به یه حجتی، بنا به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 633.84,
   "end": 637.58,
   "text": "یه اشاره‌ای، یه نشانه‌ای، یه چیزی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 637.58,
   "end": 641.04,
   "text": "میخواستید در برید، می‌گفتیم یه توجیهی داره، هیچ توجیهی ولی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 641.04,
   "end": 644.4,
   "text": "نداره. بله بفرمایید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 644.4,
   "end": 648.9,
   "text": "از جنس ماده هستن شیاطین، چرا نیستن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 648.9,
   "end": 651.21,
   "text": "شیاطین از جنس ماده‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 651.21,
   "end": 654.96,
   "text": "از آتش خلق شدن. آتش مادی‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 654.96,
   "end": 658.8,
   "text": "درسته جرم نداره ولی از آثار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 658.8,
   "end": 661.72,
   "text": "جرمه. انرژیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 661.72,
   "end": 664.48,
   "text": "انرژی از آثار ماده‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 664.48,
   "end": 668.42,
   "text": "لذا شیاطین ماده نیستند ولی مادی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 668.42,
   "end": 675.32,
   "text": "هستند. و اینکه چطور میشه شهاب سنگ شیاطین را میتونه دفع بکنه، این فرایندش چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 675.32,
   "end": 679.38,
   "text": "این قابل تشخیص در هیچ آزمایشگاه تجربی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 679.38,
   "end": 682.5,
   "text": "نیست. به خاطر اینکه تجربه ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 682.5,
   "end": 689.22,
   "text": "یعنی حواس پنج گانه ما دسترسی به تحلیل و بررسی چیستی شیاطین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 689.22,
   "end": 696.44,
   "text": "و در نتیجه چگونگی تاثیر کردن شهاب بر دخالت شیاطین نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 696.44,
   "end": 702.83,
   "text": "این یه پیام غیبیه. آیا عقل با این پیام در مقابل این پیام گارد داره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 702.83,
   "end": 709.84,
   "text": "نه. بله عقل میتونه بگه آقا شهاب سنگ تکه سنگی است که از یه ستاره‌ای، سیاره‌ای جدا میشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 709.84,
   "end": 712.88,
   "text": "و تو فضا پرتاب میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 712.88,
   "end": 718.12,
   "text": "اما اینکه چرا جدا شد، پرتاب شد، به کدام سمت پرتاب شد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 718.12,
   "end": 721.58,
   "text": "وقتی پرتاب شد به کی خورد و چی شد، دیگه اینجا عقل حرفی نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 721.58,
   "end": 723.66,
   "text": "نه عقل، نه تجربه. ساکته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 723.66,
   "end": 727.18,
   "text": "حرفی نداره چون دیگه در دسترس عقل و تجربه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 727.18,
   "end": 733.1,
   "text": "نیست. وحی داره خبر میده که این شهاب سنگ‌ها یکی از کارکردهاشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 733.1,
   "end": 737.58,
   "text": "مورد اصابت قرار دادن شیاطینی‌ست که میخوان دخالت کنن در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 737.58,
   "end": 743.44,
   "text": "نظام عالم، در تنزل وحی، در استراق سمع و بحثای دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 743.44,
   "end": 749.36,
   "text": "آخرین سوالم شما بپرسید. دو تا گزینه درباره والليل و الصبح وجود داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 749.36,
   "end": 754.84,
   "text": "دقت کنن. یه گزینه این که والليل و الصبح واوش عطف باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 754.84,
   "end": 758.48,
   "text": "اگر واوشون عطف باشه اینام به خنّس عطف میشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 758.48,
   "end": 764.96,
   "text": "یعنی لا أقسم بالخنّس، لا أقسم بالليل إذا عسعس، لا أقسم بالصبح إذا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 764.96,
   "end": 771.72,
   "text": "تنفس. یه گزینه اینه که واو والليل و الصبح، واو قسم باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 771.72,
   "end": 773.61,
   "text": "یعنی لا أقسم، لا أقسم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 773.61,
   "end": 777.72,
   "text": "اما والليل دیگه واوش، واو قسم و الصبح، واو قسم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 777.72,
   "end": 780.16,
   "text": "گزینه دوم ترجیح داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 780.16,
   "end": 786.96,
   "text": "چون در جایی که قرآن کریم به طور کلی قسم را نفی می‌کند، دیگه جواب قسم لازم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 786.96,
   "end": 793.68,
   "text": "نیست. وقتی جواب قسم بعدش آورده \"إنه لقول رسول\" تو مرتبه میرسه به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 793.68,
   "end": 796.1,
   "text": "\"وما هو بقول الشيطان\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 796.1,
   "end": 801.48,
   "text": "این نشون میده که ترجیحاً بهتر است واو والليل و الصبح را چی بگیریم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 801.48,
   "end": 808.72,
   "text": "واو قسم. حالا اگر واو عطف گرفتیم و اینا رو به خنّس عطف کردیم، غلط در میاد بگیم اونا جواب قسمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 808.72,
   "end": 811.6,
   "text": "نه غلط در نمیاد. صحبت از ترجیحه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 811.6,
   "end": 815.58,
   "text": "یعنی ترجیح با اینه که والليل و الصبح واوش، واو قسم باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 815.58,
   "end": 817.8,
   "text": "نه. یه دلیل، سوالتون خوبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 817.8,
   "end": 822.58,
   "text": "قسم نخوردن، اونجا من به ذهنم اومد که حرفم رو تکمیل و اصلاح بکنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 822.58,
   "end": 826.32,
   "text": "منتها دیگه نخواستم رشته کلام خیلی منقطع بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 826.32,
   "end": 832.24,
   "text": "قسم نخوردن همیشه برای این نیستش که مطلب واضحه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 832.24,
   "end": 835.26,
   "text": "گاهی برای بیان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 835.26,
   "end": 837.56,
   "text": "عظمت اون چیزی‌ست که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 837.56,
   "end": 840.02,
   "text": "بهش قسم یاد میشه. مثل چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 840.02,
   "end": 845.1,
   "text": "مثل \"فلا أقسم بمواقع النجوم\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 845.1,
   "end": 847.62,
   "text": "چرا؟ \"وإنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 847.62,
   "end": 850.34,
   "text": "لقسم لو تعلمون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 850.34,
   "end": 856.08,
   "text": "عظيم\". میگه من به جایگاه‌های ستارگان قسم یاد نمی‌کنم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 856.08,
   "end": 861.96,
   "text": "چون شماها که نمی‌فهمید. ولی اگه می‌فهمیدید، می‌دانستید که چقدر این قسم چیست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 861.96,
   "end": 866.28,
   "text": "قسم بزرگیه. یاد کردن این قسم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 866.28,
   "end": 868.8,
   "text": "آسون نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 868.8,
   "end": 875.48,
   "text": "اللهم صل على محمد و آل محمد و عجل فرجهم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 875.48,
   "end": 879.86,
   "text": "أعوذ بالله من الشيطان الرجيم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 879.86,
   "end": 884.28,
   "text": "بسم الله الرحمن الرحيم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 884.28,
   "end": 887.2,
   "text": "إذا الشمس كورت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 887.2,
   "end": 890.54,
   "text": "وإذا النجوم انكدرت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 890.54,
   "end": 893.88,
   "text": "وإذا الجبال سيرت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 893.88,
   "end": 897.08,
   "text": "وإذا العشار عطلت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 897.08,
   "end": 900.17,
   "text": "وإذا الوحوش حشرت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 900.17,
   "end": 902.42,
   "text": "وإذا البحار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 902.42,
   "end": 907.86,
   "text": "سجرت. وإذا النفوس زوجت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 907.86,
   "end": 909.94,
   "text": "وإذا الموءودة",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 909.94,
   "end": 912.86,
   "text": "سئلت. بأي ذنب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 912.86,
   "end": 915.94,
   "text": "قتلت. وإذا الصحف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 915.94,
   "end": 919.92,
   "text": "نشرت. وإذا السماء",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 919.92,
   "end": 923.3,
   "text": "كشطت. وإذا الجحيم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 923.3,
   "end": 928.16,
   "text": "سعرت. وإذا الجنة أزلفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 928.16,
   "end": 933.14,
   "text": "علمت نفس ما أحضرت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 933.14,
   "end": 937.12,
   "text": "علمت نفس ما أحضرت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 937.12,
   "end": 941.42,
   "text": "علمت نفس ما أحضرت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 941.42,
   "end": 946.4,
   "text": "فلا أقسم بالخنّس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 946.4,
   "end": 949.34,
   "text": "الجوار الكنّس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 949.34,
   "end": 952.1,
   "text": "والليل إذا عسعس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 952.1,
   "end": 955.18,
   "text": "والصبح إذا تنفس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 955.18,
   "end": 960.04,
   "text": "إنه لقول رسول كريم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 960.04,
   "end": 964.3,
   "text": "ذي قوة عند ذي العرش مكين.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 964.3,
   "end": 967.6,
   "text": "مطاع ثم أمين.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 967.6,
   "end": 970.46,
   "text": "وما صاحبكم بمجنون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 970.46,
   "end": 974.6,
   "text": "ولقد رآه بالأفق المبين.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 974.6,
   "end": 978.58,
   "text": "وما هو على الغيب بظنين.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 214,
   "start": 978.58,
   "end": 983.4,
   "text": "وما هو بقول الشيطان الرجيم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 215,
   "start": 983.4,
   "end": 985.94,
   "text": "فأين تذهبون؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 216,
   "start": 985.94,
   "end": 988.34,
   "text": "فأين تذهبون؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 217,
   "start": 988.34,
   "end": 992.12,
   "text": "إن هو إلا ذكر للعالمين.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 218,
   "start": 992.12,
   "end": 997.0,
   "text": "لمن شاء منكم أن يستقيم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 219,
   "start": 997.0,
   "end": 1003.84,
   "text": "وما تشاءون إلا أن يشاء الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 220,
   "start": 1003.84,
   "end": 1007.22,
   "text": "رب العالمين.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 221,
   "start": 1007.22,
   "end": 1010.88,
   "text": "صدق الله العلي العظيم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 222,
   "start": 1010.88,
   "end": 1014.94,
   "text": "اللهم صل على محمد وآل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 223,
   "start": 1014.94,
   "end": 1017.08,
   "text": "محمد. اللهم صل على محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 224,
   "start": 1017.08,
   "end": 1027.73,
   "text": "وآل محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}