 },
 "chapters": [
  {
   "index": 0,
   "title": "## آموزش تدبر در سورهٔ مزّمّل — بخش چهارم",
   "start": 10.52,
   "end": 136.78
  },
  {
   "index": 1,
   "title": "## وجوبِ نماز شب؛ برای پیامبر واجب، برای دیگران مستحب",
   "start": 136.78,
   "end": 167.2
  },
  {
   "index": 2,
   "title": "## «والله یقدّر اللیل والنهار»؛ قدرت‌راندن، نه صرفاً اندازه‌گیری",
   "start": 167.2,
   "end": 260.94
  },
  {
   "index": 3,
   "title": "## نماز و اقامهٔ صلاة؛ ستون و خیمه؛ فرهنگِ نماز",
   "start": 260.94,
   "end": 756.68
  },
  {
   "index": 4,
   "title": "## سوره‌های دیگر را به نماز باز کنیم؛ از رویِ مصحف نیز رواست",
   "start": 756.68,
   "end": 981.04
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 10.52,
   "end": 15.76,
   "text": "خب سوره مزمل سوالی دارین بازم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 15.76,
   "end": 22.44,
   "text": "بفرمایید. مهلت بده یعنی من یه چند سباحی که تو دنیا هستن دارم مدارا می‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 22.44,
   "end": 25.04,
   "text": "یعنی خداوند می‌خواد چیکار کنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 25.04,
   "end": 28.6,
   "text": "هم بیصبری نکنن. خدا می‌خاد بیصبری نکنه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 28.6,
   "end": 36.94,
   "text": "عجله نکنه در تقاضای عذاب بر اون‌ها یا در مثلاً برخورد فیزیکی با اون‌ها یا ترک کردن اون‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 36.94,
   "end": 43.42,
   "text": "مثلاً ما داریم در قرآن کریم جاهایی که خدا به پیامبر گرامی اسلام می‌فرماید \"ولا تكن كصاحب الحوت\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 43.42,
   "end": 48.02,
   "text": "نکنه مثل یونس علیه السلام یه وقت اینجوری بکنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 48.02,
   "end": 54.1,
   "text": "یونس چیکار کرد؟ ایشون این بود که قبل از اینکه خدا اجازه بده قومشو ترک کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 54.1,
   "end": 57.24,
   "text": "دیگه انقدر بهش فشار اومد گذاشت رفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 57.24,
   "end": 60.0,
   "text": "که بعد خدا با همین کار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 60.0,
   "end": 63.58,
   "text": "خب یونس علیه السلام رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 63.58,
   "end": 70.08,
   "text": "در واقع خدا مقدر کرد که به د-دریا افتاد ماهی او رو بلعید و آن شد که میدونید دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 70.08,
   "end": 74.58,
   "text": "سؤال کردن امر به رسول در سیاق اول سوره مربوط به مؤمنین می‌شود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 74.58,
   "end": 77.52,
   "text": "امر به مؤمنین است؟ خیر،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 77.52,
   "end": 83.98,
   "text": "امر به رسول است. آیا تخفیف در سیاق سوم مربوط به زمان نیست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 83.98,
   "end": 87.04,
   "text": "تهسوها مربوط به زمان است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 87.04,
   "end": 94.55,
   "text": "که در جلسه قبلی اینو توضیح داده بودم که نه، اصلاً تهسوح به زمان نمی‌تونه مربوط باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 94.55,
   "end": 97.24,
   "text": "\"أَلَمْ أَلَنْ تَهْسُوهُ\". چرا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 97.24,
   "end": 102.42,
   "text": "چون اصلاً زمان اونجا خودش متغیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 102.42,
   "end": 105.64,
   "text": "مثلاً خدا نگفته بود دقیقاً نصف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 105.64,
   "end": 109.86,
   "text": "که این نفر بگه خب من نمی‌دونم دقیق نصف شد یا نه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 109.86,
   "end": 114.7,
   "text": "چند ثانیه کمتر شد یا بیشتر شد، چند دقیقه کمتر شد یا بیشتر شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 114.7,
   "end": 119.92,
   "text": "از همون اول که خدا دستور داده بود فرموده بود \"قُمِ اللَّيْلَ إِلَّا قَلِيلًا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 119.92,
   "end": 122.86,
   "text": "أَوِ انْقُصْ مِنْهُ قَلِيلًا أَوْ زِدْ عَلَيْهِ\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 122.86,
   "end": 125.84,
   "text": "یعنی اصلاً خود دستور",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 125.84,
   "end": 129.24,
   "text": "در واقع یک حد اقل و حد اکثری داشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 129.24,
   "end": 132.88,
   "text": "خودش از نظر زمانی دقت خاصی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 132.88,
   "end": 136.78,
   "text": "لحاظ دقت خاصی در اون دستور نشده بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 136.78,
   "end": 140.14,
   "text": "در برخی موارد از این سوره وجوب نماز شب مطرح شده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 140.14,
   "end": 142.38,
   "text": "چگونه است؟ وجوب که نه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 142.38,
   "end": 151.4,
   "text": "بله برای پیامبر وجوب اما برای دیگران استحباب نماز شب رو هم میشه از این سوره فهمید با این توضیح که نماز شب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 151.4,
   "end": 155.02,
   "text": "ظرف ترتیل قرآن در دل شبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 155.02,
   "end": 160.52,
   "text": "که البته من توصیه می‌کنم بخشی از سؤالاتی که پرسیدید ناظر به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 160.52,
   "end": 166.62,
   "text": "در واقع جلسه قبله که ما در جلسه قبل اینا رو تقریباً مفصل توضیح دادیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 166.62,
   "end": 167.68,
   "text": "سؤال بعدی در آیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 167.68,
   "end": 173.62,
   "text": "بیست \"وَاللَّهُ يُقَدِّرُ اللَّيْلَ وَالنَّهَارَ أَلَمْ أَلَنْ تَهْسُوهُ\" چرا گفته نشد \"وَاللَّهُ يُقَدِّرُ\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 173.62,
   "end": 177.78,
   "text": "ببینید خداوند \"يُقَدِّرُ اللَّيْلَ وَالنَّهَارَ\" اولاً \"يُقَدِّرُ\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 177.78,
   "end": 183.56,
   "text": "به نظر حقیر به معنی اندازه‌گیری نیست با اینکه در بعضی از ترجمه‌ها همین معنی نوشته شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 183.56,
   "end": 188.06,
   "text": "ولی آنچه که حقیر می‌فهمم اینه که \"يُقَدِّرُ\" یعنی قدرت خود را",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 188.06,
   "end": 193.11,
   "text": "به جریان در می‌آورد. یعنی خدا با قدرت خود شب و روز را به جریان در می‌آورد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 193.11,
   "end": 196.54,
   "text": "\"وَاللَّهُ يُقَدِّرُ اللَّيْلَ وَالنَّهَارَ\" یعنی این.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 196.54,
   "end": 202.16,
   "text": "وقتی میگه \"أَلَمْ أَلَنْ تَهْسُوهُ\" یعنی خدا می‌خواد بگه من اقتضائات شب را",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 202.16,
   "end": 209.54,
   "text": "می‌دانم. من می‌دونم یه آدمی که بیماره تو دل شب نمی‌تونه این دستور را",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 209.54,
   "end": 212.52,
   "text": "پا به پای پیغمبر انجام بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 212.52,
   "end": 218.06,
   "text": "دو سوم شب بیدار بمونه، نصف شب یا یک سوم شب بیدار بمونه و عبادت کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 218.06,
   "end": 222.54,
   "text": "چون منم که دارم شب و روز را با قدرت خودم به جریان در میارم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 222.54,
   "end": 227.54,
   "text": "پس علم کاملی به اقتضائات شب و روز دارم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 227.54,
   "end": 232.7,
   "text": "پس من خدا می‌دانم که از عهده‌ی شما بر نمی‌آد همیشه هر شب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 232.7,
   "end": 236.18,
   "text": "به این دستور پا به پای پیغمبر بخواید عمل کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 236.18,
   "end": 241.16,
   "text": "مریض که باشید نمیشه، سفر که باشید نمیشه، تو قتال که باشید نمیشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 241.16,
   "end": 244.56,
   "text": "بله برای پیامبرم همینه ولی با یه تفاوتی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 244.56,
   "end": 253.12,
   "text": "پیامبر از عظمت روحی برخوردار است و پیامبر مکلف به دریافت وحی است که هیچ‌کدومو شما ندارید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 253.12,
   "end": 256.26,
   "text": "نه اون عظمت روحی برای شما ثابته،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 256.26,
   "end": 259.82,
   "text": "نه تکلیف دریافت وحی متوجه شماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 259.82,
   "end": 261.62,
   "text": "اون حضرت بحثش فرق می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 261.62,
   "end": 265.0,
   "text": "ما ایشون رو مکلف کردیم این کار رو انجام بده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 265.0,
   "end": 268.56,
   "text": "با اینکه یه مقدار ممکنه برای ایشون سخت باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 268.56,
   "end": 271.88,
   "text": "اما چون سختی بزرگتری را",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 271.88,
   "end": 275.38,
   "text": "باهاش مواجه میشه اگر این کارو نکنه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 275.38,
   "end": 282.48,
   "text": "اگه قرار باشه مثلاً این سختی شب بیدار موندن و عبادت کردن به این اندازه را تحمل نکنه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 282.48,
   "end": 288.82,
   "text": "اونوقت دیگه توان مقاومت در برابر نزول وحی را بگید نخواهد داشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 288.82,
   "end": 294.38,
   "text": "خودبه‌خود انگیزه‌ی او برای انجام این کار یه انگیزه‌ی فوق‌العاده بالاتری‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 294.38,
   "end": 296.94,
   "text": "چون او اگر این کارو نکنه نمیشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 296.94,
   "end": 300.14,
   "text": "اما من و شما این کارو نکنیم نمیشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 300.14,
   "end": 304.8,
   "text": "پس ما طبیعتاً اندازه‌ی اون حضرت ظرفیت و انگیزه برای این کار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 304.8,
   "end": 308.16,
   "text": "نداریم. اون تکلیف متوجه ما هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 308.16,
   "end": 311.86,
   "text": "نیست. اقامه صلاة",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 311.86,
   "end": 313.96,
   "text": "فرقش با خود نماز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 313.96,
   "end": 316.88,
   "text": "در چیه؟ نماز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 316.88,
   "end": 319.88,
   "text": "همین حرکات پنج گانه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 319.88,
   "end": 322.14,
   "text": "حالا تو یه نگاه عرض می‌کنم ها، تو یه نگاه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 322.14,
   "end": 325.68,
   "text": "من می‌خوام یک، یکی از فرق‌ها رو یه توضیحی بدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 325.68,
   "end": 331.7,
   "text": "همین نه- اوقات پنج گانه‌ای که ما نماز می‌خونیم، هفده رکعت نماز می‌خونیم، قيامی داره، رکوعی داره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 331.7,
   "end": 334.5,
   "text": "سجودی داره، این نمازه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 334.5,
   "end": 338.08,
   "text": "اقامه نماز برپا داشتنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 338.08,
   "end": 342.02,
   "text": "برپا داشتن مثل اینکه شما یه خیمه می‌خوای بلند کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 342.02,
   "end": 348.0,
   "text": "یعنی یه بار نماز عمود الدین، یه بار نماز چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 348.0,
   "end": 352.26,
   "text": "خیمه است. نماز می‌خونی مثل ستون می‌مونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 352.26,
   "end": 356.34,
   "text": "اما نماز را می‌خوای برپاداری، نماز تنها نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 356.34,
   "end": 360.1,
   "text": "نماز وقتی نمازه که بغلش چی هست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 360.1,
   "end": 365.64,
   "text": "انفاق هست. وقتی این دو تا کامله که تصدیق روز جزا هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 365.64,
   "end": 369.17,
   "text": "وقتی این سه تا کامله که ترسه از عذاب هست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 369.17,
   "end": 372.55,
   "text": "وقتی این چهار تا کامله که پاکدامنی هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 372.55,
   "end": 376.79,
   "text": "وقتی این پنج تا کامله که تعهد و امانت‌داری هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 376.79,
   "end": 381.51,
   "text": "وقتی این شش تا کامله که مسئولیت‌پذیری اجتماعی هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 381.51,
   "end": 386.35,
   "text": "وقتی این هفت تا کامله که همواره مراقبت کنی هیچ کدوم از قلم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 386.35,
   "end": 394.07,
   "text": "نیفته. سوره مبارکه مآراج این هشت تا رو که الان من شمردم به عنوان فرهنگ نماز میشماره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 394.07,
   "end": 401.75,
   "text": "اینا همه نمازه. درسته نماز یکیشه ولی به یه معنای دیگر نماز همه شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 401.75,
   "end": 403.87,
   "text": "خب یه بار نماز میخوانم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 403.87,
   "end": 406.63,
   "text": "این اون نمازیه که ستونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 406.63,
   "end": 410.25,
   "text": "یه بار فرهنگ نماز را میخوام پیاده کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 410.25,
   "end": 413.99,
   "text": "پیاده کردن فرهنگ نماز فقط با نماز خوندن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 413.99,
   "end": 422.23,
   "text": "نیست. زکات داره، تصدیق جزا داره، ترس از عذاب داره، پاکدامنی داره، تعهد و امانت‌داری داره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 422.23,
   "end": 425.05,
   "text": "مسئولیت‌پذیری اجتماعی داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 425.05,
   "end": 427.35,
   "text": "اینا همه با هم میشه فرهنگ نماز.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 427.35,
   "end": 436.67,
   "text": "اق-اقامه نماز یعنی اینکه به نماز به مثابه یک خیمه‌ای که شریعت را داره می‌پوشانه نگاه کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 436.67,
   "end": 439.09,
   "text": "این میشه اون نمازی که ما می‌خوایم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 439.09,
   "end": 441.01,
   "text": "یه جور دیگه هم بعضیا تفاوت گفتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 441.01,
   "end": 444.97,
   "text": "گفتن نماز خوندن فردیه، اقامه نماز چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 444.97,
   "end": 454.25,
   "text": "اجتماعیه. یعنی فردی اینه که شما نماز می‌خونی اما یه بار دغدغه اینو داری که جامعه‌ت نمازگزار باشد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 454.25,
   "end": 456.15,
   "text": "نه فقط من نماز بخونم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 456.15,
   "end": 459.43,
   "text": "وامر اهلک بصلاه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 459.43,
   "end": 465.29,
   "text": "اهلت را نمازگزار کنی، بچه‌هاتو نمازگزار کنی، جامعه‌تو نمازگزار کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 465.29,
   "end": 466.95,
   "text": "این اقامه نمازه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 466.95,
   "end": 470.27,
   "text": "یعنی تلاش برای برپا کردن نمازه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 470.27,
   "end": 473.93,
   "text": "اینم یکی از تفاوت‌هاست که هر دوتاش به نظر حقیر می‌تونه درست باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 473.93,
   "end": 479.37,
   "text": "آخرین سوالی که جواب میدم، آیا خواندن قرآن در شب همان نماز شب را،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 479.37,
   "end": 481.03,
   "text": "کار نماز شب را انجام می‌دهد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 481.03,
   "end": 485.61,
   "text": "یعنی می‌شود دیگر نماز شب را نخوانیم و به جای آن قرآن بخوانیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 485.61,
   "end": 489.65,
   "text": "ما در سوره مبارکه علق توضیح دادیم این مطلب رو گفتیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 489.65,
   "end": 494.45,
   "text": "انشاالله در سطح یک هست عزیزانی که نبودن انشاالله استفاده خواهند کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 494.45,
   "end": 502.47,
   "text": "اونجا توضیح دادیم اصلاً در فرهنگ قرآن ظرف قرآن خوندن نمازه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 502.47,
   "end": 506.43,
   "text": "یعنی بهترین حالت برای قرآن خوندن ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 506.43,
   "end": 509.39,
   "text": "چیه؟ نمازه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 509.39,
   "end": 512.61,
   "text": "در خود قرآن شاهد داریم از سوره علق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 512.61,
   "end": 515.73,
   "text": "خدا در سوره علق به پیغمبر فرمود اقرأ.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 515.73,
   "end": 520.03,
   "text": "درسته؟ بخون. چیو قرار بود بخونه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 520.03,
   "end": 522.65,
   "text": "قرآن را بخونه. درسته یا نه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 522.65,
   "end": 526.11,
   "text": "خب پیغمبر چه کار کرد در عمل به دستور خدا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 526.11,
   "end": 530.95,
   "text": "اریت الذي ینهی عبدا اذا صلی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 530.95,
   "end": 536.65,
   "text": "یعنی پیغمبر در عمل به دستور اقرأ نماز برپا کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 536.65,
   "end": 542.59,
   "text": "نماز خوند. یعنی حضرت قرآن را در دل نماز تلاوت کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 542.59,
   "end": 547.39,
   "text": "همین خودش نشون میده که نماز ظرف قرآن خوندن است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 547.39,
   "end": 552.87,
   "text": "این یک. دو، واقعاً تو نماز مگه ما چکار می‌کنیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 552.87,
   "end": 556.11,
   "text": "قرآن می‌خونیم دیگه. الله اکبر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 556.11,
   "end": 558.77,
   "text": "سوره حمد رو می‌خونیم. بعد یه سوره قرآن رو می‌خونیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 558.77,
   "end": 561.31,
   "text": "یه رکوعی، سجده‌ای دوباره قیام می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 561.31,
   "end": 564.99,
   "text": "دو مرتبه سوره حمد می‌خونیم. باز یه سوره دیگر قرآن می‌خونیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 564.99,
   "end": 567.39,
   "text": "یعنی عمده نماز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 567.39,
   "end": 569.95,
   "text": "چیست؟ قرآن خوندنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 569.95,
   "end": 575.93,
   "text": "فقط فرقش با قرآن خوندن بیرون نماز اینه که بیرون نماز بدون احرام قرآن می‌خونیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 575.93,
   "end": 578.51,
   "text": "احرام نبسته قرآن می‌خونیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 578.51,
   "end": 581.13,
   "text": "تو نماز احرام بسته قرآن می‌خونیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 581.13,
   "end": 584.79,
   "text": "تکبیره الاحرام. احرام بسته یعنی چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 584.79,
   "end": 587.57,
   "text": "یعنی یه چیزایی رو بر خودمون حرام می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 587.57,
   "end": 595.29,
   "text": "الله اکبر که میگیم خوردن و نوشیدن و خوابیدن و حرف زدن و راست و چپ شدن و اینا رو بر خودمون حرام می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 595.29,
   "end": 597.43,
   "text": "میشه تکبیره الاحرام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 597.43,
   "end": 599.35,
   "text": "بعد شروع می‌کنیم قرآن خوندن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 599.35,
   "end": 604.39,
   "text": "یعنی مثل اینکه می‌خوایم حرمت قرآن خوندن را بیشتر رعایت کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 604.39,
   "end": 607.97,
   "text": "اصلاً نماز ظرف قرائت قرآنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 607.97,
   "end": 616.33,
   "text": "سه، اگر به روایات‌مون مراجعه بکنیم تو روایات‌مون هم تصریح شده به اینکه این قیام شبانه برای ترتیل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 616.33,
   "end": 618.89,
   "text": "قرآن، نماز شب است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 618.89,
   "end": 621.93,
   "text": "و حتی در بعضی از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 621.93,
   "end": 624.33,
   "text": "روایات که فراوان هم هستند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 624.33,
   "end": 630.69,
   "text": "فرموده اگر کسی قرآن بخواند، قرآن را تو نماز واجب بخواند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 630.69,
   "end": 636.93,
   "text": "صد امتیاز می‌گیره. من دارم این اعدادو میگم اعداد چیزی که روایت ذکر کرده صد امتیاز می‌گیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 636.93,
   "end": 642.25,
   "text": "این قرآن را تو نماز مستحب بخواند ده امتیاز می‌گیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 642.25,
   "end": 647.37,
   "text": "این قرآن را خارج از نماز بخواند یک امتیاز.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 647.37,
   "end": 650.89,
   "text": "یعنی شما اگر قرآن رو ببری تو نماز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 650.89,
   "end": 654.63,
   "text": "واجب باشه ده، صد برابر اجر داره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 654.63,
   "end": 658.31,
   "text": "مستحب باشه ده برابر اجر داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 658.31,
   "end": 661.97,
   "text": "شما می‌خوای قرآن بخونی روشت این باشه، نشستی تو خونه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 661.97,
   "end": 668.95,
   "text": "شبه، روزه، هر وقتی می‌خوای قرآن بخونی یا سر کاری یا نمی‌دونم سر کار که البته باید کار کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 668.95,
   "end": 673.51,
   "text": "مثلا داری فرض بفرمایید مسیری رو میری نمی‌دونم تو اتوبوس نشستی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 673.51,
   "end": 679.71,
   "text": "حالا وضوئی داری، خوبه که مؤمن دائم الوضو باشه دیگه تا جایی که می‌تونه با وضو باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 679.71,
   "end": 682.59,
   "text": "خب همینجوری که مشغول کارت هستی یا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 682.59,
   "end": 689.11,
   "text": "داری مثلا مسیرتو میری یا مثلا فرض بفرمایید می‌خوای بخوابی یه دو دقیقه تو رخت خوابت هستی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 689.11,
   "end": 694.21,
   "text": "همونجا نشسته، ایستاده، هر جور مقدورته ایستاده اجرش بیشتره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 694.21,
   "end": 699.67,
   "text": "می‌تونی برای قرآن خوندن الله اکبر یه سوره حمد بخونی، هر چقدر خواستی قرآن بخونی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 699.67,
   "end": 703.67,
   "text": "بعد یه سج-یه رکوع دو تا سجده دو مرتبه رکعت بعدی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 703.67,
   "end": 706.23,
   "text": "ببرش تو قالب نماز.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 706.23,
   "end": 709.63,
   "text": "یه دور قرآن تو نماز ختم کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 709.63,
   "end": 713.41,
   "text": "نشسته، ایستاده، هر جور مقدورته، هر جور راحتی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 713.41,
   "end": 717.37,
   "text": "ایستاده بیشتر اجر داره. واجب بیشتر اجر داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 717.37,
   "end": 721.21,
   "text": "اینا همه طبقه‌بندی شدن، تو روایات دسته‌بندی شدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 721.21,
   "end": 728.11,
   "text": "قرآن تو نماز مستحب نشسته، قرآن تو نماز مستحب ایستاده، قرآن تو نماز واجب، قرآن خارج از نماز.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 728.11,
   "end": 733.58,
   "text": "اینا همه طبقه‌بندی شده‌ست از نظر اجر و اثر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 733.58,
   "end": 737.5,
   "text": "نماز مستحب هم میدونید نماز مستحب موانعی نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 737.5,
   "end": 741.62,
   "text": "خیلیا همینطور که مثلا تو اتوبوس نشستن دارن میرن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 741.62,
   "end": 743.88,
   "text": "تو مترو هستن، نمازشونم میخونن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 743.88,
   "end": 751.64,
   "text": "تو نماز مستحب حتما باید رو به قبله باشم، الان مترو چرخید من کدوم ور بچرخم، الان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 751.64,
   "end": 754.3,
   "text": "رکوع شد من چیکار کنم، اینا نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 754.3,
   "end": 757.6,
   "text": "تو نماز مستحب همینجوری که نشستی لازم هم نیست خیلی تابلو باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 757.6,
   "end": 760.16,
   "text": "الله اکبر بسم الله الرحمن الرحیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 760.16,
   "end": 762.12,
   "text": "وضو داری نمازتو میخونی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 762.12,
   "end": 767.72,
   "text": "یه حمدی میخونی بعد یه چند تا سوره قرآنی میخونی بعد با اشاره رکوع و سجده تو انجام میدی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 767.72,
   "end": 771.22,
   "text": "اینام نماز مستحبه. سوار بر مرکب میشه نماز مستحب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 771.22,
   "end": 776.22,
   "text": "حالا راننده بودید لطفا نماز نخونید یه وقت سبحان الله تخ.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 776.22,
   "end": 780.2,
   "text": "اِ بابا چی شد آخه حاج آقا تو نماز مستحب موقع رانندگی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 780.2,
   "end": 784.58,
   "text": "نه من رانندگی رو نمیگم. یه بار یه جایی گفتم یه نفر تذکر داد پلیس بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 784.58,
   "end": 787.42,
   "text": "گفت تو رانندگی لطفا نماز مستحب نخونید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 787.42,
   "end": 790.96,
   "text": "دیدم راست میگه. آدم یه وقت می‌بینه حواسش پرت میشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 790.96,
   "end": 793.94,
   "text": "به جای اینکه مثلا دور بزنه رکوع میره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 793.94,
   "end": 801.64,
   "text": "بعد تمام شد. بله خلاصه‌ش اینکه بله نماز شب همان قرآن خوندن ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 801.64,
   "end": 805.76,
   "text": "فقط یه خواهشی دارم. ما یه عادتی کردیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 805.76,
   "end": 809.96,
   "text": "تو نمازامون غیر از این خدا حفظ کنه سوره کوثر و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 809.96,
   "end": 812.34,
   "text": "سوره توحید و سوره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 812.34,
   "end": 815.38,
   "text": "قدر و اینا چیز دیگه‌ای نمی‌خونیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 815.38,
   "end": 821.34,
   "text": "یعنی مراقب هستیم خدایی نکرده سوره‌های دیگر قرآن رو یه وقت نیاریم تو نمازمون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 821.34,
   "end": 826.48,
   "text": "بابا این سوره‌ها اکثرشون توصیه شده که تو نماز خونده بشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 826.48,
   "end": 828.76,
   "text": "براش اجره‌ها شمرده شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 828.76,
   "end": 830.42,
   "text": "چرا قارعه رو نمی‌خونی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 830.42,
   "end": 833.58,
   "text": "چرا عادیات رو نمی‌خونی؟ چرا تکاثر رو نمی‌خونی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 833.58,
   "end": 835.26,
   "text": "چرا نمی‌دونم عبس رو نمی‌خونی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 835.26,
   "end": 836.94,
   "text": "نازعات رو نمی‌خونی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 836.94,
   "end": 842.78,
   "text": "چرا سوره حالا بقره که ما توانشو نداریم حالا اگر کسی می‌خواد از اون نماز شبای پیامبری بخونه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 842.78,
   "end": 846.76,
   "text": "بقره رو هم میتونه بخونه آل عمران هم میتونه بخونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 846.76,
   "end": 852.62,
   "text": "دقت کنید. البته تو نماز مستحبی شما می‌تونید بخشی از یه سوره رو بخونید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 852.62,
   "end": 854.86,
   "text": "لازم نیست کل سوره تمام بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 854.86,
   "end": 858.62,
   "text": "شما یه حمدو میخونی، یه چند صفحه از سوره بقره رو میخونی، تمام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 858.62,
   "end": 864.4,
   "text": "مشکل نداره. میتونی سوره بقره رو تقسیم کنی، یه ماه تو نماز شبت سوره بقره رو تموم کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 864.4,
   "end": 867.56,
   "text": "هیچ مشکلی نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 867.56,
   "end": 872.8,
   "text": "بله البته میخوام بگم اونش که ویژه‌ست اما میخوام بگم کلشم میشه خوند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 872.8,
   "end": 878.2,
   "text": "خواهشم اینه سوره‌های دیگر رو پاشو به نمازامون باز کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 878.2,
   "end": 883.4,
   "text": "هر سوره‌ای رو که تدبر می‌کنیم می‌فهمیم بیاریم تو لیست نمازامون اون سوره رو بخونیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 883.4,
   "end": 886.68,
   "text": "حفظ نیستم، خب از رو بخون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 886.68,
   "end": 890.36,
   "text": "بعضیا فکر می‌کنن موقع نماز خوندن دیگه نمیشه به قرآن نگاه کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 890.36,
   "end": 895.64,
   "text": "چرا؟ اونی که نمیشه نگاه کرد تلویزیونه که نگاه می‌کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 895.64,
   "end": 899.3,
   "text": "موقع نماز خوندن فوتبال رو نمیشه نگاه کرد که نگاه می‌کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 899.3,
   "end": 901.98,
   "text": "کانال رو نمیشه عوض کرد که عوض می‌کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 901.98,
   "end": 905.24,
   "text": "زیر گاز رو نمیشه خاموش کرد که خاموش می‌کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 905.24,
   "end": 907.22,
   "text": "موقع نماز خوندن قرآن میشه خوند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 907.22,
   "end": 909.42,
   "text": "آقا قرآن رو بگیر جلوت بخون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 909.42,
   "end": 912.86,
   "text": "سوره رو خوندی، آقا من امروز میخوام با سوره قیامت نماز بخونم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 214,
   "start": 912.86,
   "end": 917.02,
   "text": "سوره قیامت حفظ نیستم، می‌گیرم جلوم می‌خونم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 215,
   "start": 917.02,
   "end": 919.34,
   "text": "هیچ مشکل نداره واجب باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 216,
   "start": 919.34,
   "end": 922.12,
   "text": "در نماز واجب قرآن از رو خوندن اِ--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 217,
   "start": 922.12,
   "end": 925.72,
   "text": "اشکال ایجاد نمی‌کنه. اشکال ایجاد نمی‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 218,
   "start": 925.72,
   "end": 929.82,
   "text": "من دارم قرآن می‌خونم. حفظ نیستم از رو می‌خونم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 219,
   "start": 929.82,
   "end": 935.8,
   "text": "حفظم از حفظ می‌خونم. خود قرآن خوندن از رو به خودی خود اشکال ایجاد نمی‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 220,
   "start": 935.8,
   "end": 942.46,
   "text": "مگر یه وقت کسی میگه من قرآن رو دست می‌گیرم حواسم پرت میشه رکاتامو گم می‌کنم، شک می‌کنم، چه می‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 221,
   "start": 942.46,
   "end": 946.46,
   "text": "مجبورم هی گوشه‌های صفحه قرآن رو تا کنم ببینم چند رکعت خوندم و اینا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 222,
   "start": 946.46,
   "end": 950.82,
   "text": "اون بحث دیگه‌ست. ما میگیم حالا به خودت خیلی زحمت نده، اونایی که حفظی بخون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 223,
   "start": 950.82,
   "end": 953.1,
   "text": "ولی اشکالی نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 224,
   "start": 953.1,
   "end": 956.22,
   "text": "الا سوره‌های سجده‌دار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 225,
   "start": 956.22,
   "end": 962.32,
   "text": "که سوره‌های سجده‌دار رو به-- تو فقه شیعه نمیشه بعد حمد در نماز بخونی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 226,
   "start": 962.32,
   "end": 968.96,
   "text": "تو نماز واجب که حتما نمیشه بخونی، تو نماز مستحب دقیقا حضور ذهن ندارم مانعی داره یا نه، شاید اونجام نشه بخونی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 227,
   "start": 968.96,
   "end": 974.64,
   "text": "حالا اون نگاه کنید. اول النعمه، نعمه یعنی پیغمبر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 228,
   "start": 974.64,
   "end": 981.04,
   "text": "اول النعمه یعنی ثروتمند، قدرتمند، دارای زر و زور. بیشتر این م-مراده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}