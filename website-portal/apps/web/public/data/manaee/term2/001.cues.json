   "start": 10.68,
   "end": 172.16
  },
  {
   "index": 1,
   "title": "## سطح مخاطب، تعیین‌کنندهٔ سطح مطالبه",
   "start": 172.16,
   "end": 213.5
  },
  {
   "index": 2,
   "title": "## ساختار معرفتی یک و دو؛ جایگاه این ترم",
   "start": 213.5,
   "end": 472.04
  },
  {
   "index": 3,
   "title": "## مراحل تدبر و انتظار این ترم",
   "start": 472.04,
   "end": 673.94
  },
  {
   "index": 4,
   "title": "## فنی‌تر شدن مسیر و کوچک‌تر شدن جمع",
   "start": 673.94,
   "end": 713.46
  },
  {
   "index": 5,
   "title": "## نظم جلسه: پرسش ضروری و یادداشت اشکال",
   "start": 713.46,
   "end": 777.96
  },
  {
   "index": 6,
   "title": "## آیین‌نامهٔ امتیاز: حضور و آزمون",
   "start": 777.96,
   "end": 820.64
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 10.68,
   "end": 12.96,
   "text": "اعوذ بالله من الشيطان الرجيم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 12.96,
   "end": 18.6,
   "text": "بسم الله الرحمن الرحيم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 18.6,
   "end": 28.16,
   "text": "الحمد لله رب العالمين وصلى الله على سيدنا ونبينا حبيب اله العالمين ابى القاسم المصطفى محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 28.16,
   "end": 33.04,
   "text": "اللهم صل على محمد وآل محمد وعجل فرجه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 33.04,
   "end": 43.16,
   "text": "وعلى آله الطيبين الطاهرين ولعنة الله على اعدائهم اجمعين من الان الى قيام يوم الدين.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 43.16,
   "end": 49.66,
   "text": "عرض سلام و ادب و احترام محضر خواهران و برادران گرامی حاضر در جلسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 49.66,
   "end": 54.74,
   "text": "خدا رو شکر میکنیم که توفیق عطا فرمود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 54.74,
   "end": 59.38,
   "text": "بعد از اینکه سطح یک تمام شد فاصله‌ای افتاد ولی باز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 59.38,
   "end": 69.24,
   "text": "هم خداوند توفیق عطا فرمود و در محضر نورانی قرآن کنار هم قرار گرفتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 69.24,
   "end": 75.16,
   "text": "ان شاء الله به یاری خدا سطح دو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 75.16,
   "end": 81.66,
   "text": "دوره معرفتی تدبر در قرآن کریم رو میخوایم شروع بکنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 81.66,
   "end": 85.78,
   "text": "فقط برای یادآوری عرض می‌کنم خدمتتون،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 85.78,
   "end": 93.78,
   "text": "دوره معرفتی که گفته میشه یه فرقی با دوره مهارتی داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 93.78,
   "end": 99.62,
   "text": "اون فرق در این نیست که در دوره معرفتی ما استدلال و استناد و این حرفا نداریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 99.62,
   "end": 109.38,
   "text": "همه رو داریم. هر بحثی که مطرح می‌کنیم سعی می‌کنیم با دلیل، با سند بحثا محکم باشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 109.38,
   "end": 112.46,
   "text": "و باز اینم نیست که ما روش تدبر رو تمرین نمی‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 112.46,
   "end": 117.28,
   "text": "در دوره معرفتی روش تدبر رو هم تمرین می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 117.28,
   "end": 122.18,
   "text": "اما دوره‌های مهارتی که اصلاً ورود به دوره‌های مهارتی بعد از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 122.18,
   "end": 128.06,
   "text": "سطح سه تدبر ممکنه و برای افرادی که شرایط خاص داشته باشن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 128.06,
   "end": 134.44,
   "text": "در اون دوره‌ها اساساً مراحل و قواعد آموزش داده میشه نه سوره ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 134.44,
   "end": 138.36,
   "text": "ما در دوره‌های معرفتی سوره ها رو آموزش میدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 138.36,
   "end": 142.88,
   "text": "ضمن سوره ها به مراحل و قواعد و اینا هم اشاره می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 142.88,
   "end": 148.66,
   "text": "اتفاقاً اونی که کاربردی‌تره برای اکثر افراد همین دوره‌های معرفتیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 148.66,
   "end": 154.7,
   "text": "دوره‌های مهارتی حالا مثلاً کسانی میخوان وارد حوزه پژوهش بشن، کارهای پژوهشی بیشتری انجام بدن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 154.7,
   "end": 158.24,
   "text": "رشته‌های علوم قرآنی تفسیر خوندن یا حوزوی بودن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 158.24,
   "end": 162.24,
   "text": "مایلن که تحقیقی و پژوهشی‌تر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 162.24,
   "end": 167.52,
   "text": "کار بکنن. خب در اون دوره‌ها یه سری مطالبی رو با اون‌ها در میان می‌گذاریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 167.52,
   "end": 172.16,
   "text": "این نکته اول که دوره ما معرفتی‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 172.16,
   "end": 176.94,
   "text": "در دوره معرفتی سطح مخاطب تعیین کننده سطح مطالبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 176.94,
   "end": 181.04,
   "text": "هر چقدر شما بیشتر وقت بگذارید زحمت بکشید کار بکنید همونقدر ان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 181.04,
   "end": 185.2,
   "text": "شاء الله ما تلاش خواهیم کرد که سطح مطالب ارتقا پیدا بکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 185.2,
   "end": 193.96,
   "text": "در گذشته ما می‌گفتیم عمومی تخصصی یعنی دوره‌های معرفتی رو بعضاً عمومی برگزار می‌کردیم بعضاً تخصصی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 193.96,
   "end": 198.36,
   "text": "بعد دیگه این قیدو برداشتیم گفتیم به تناسب سطح مخاطب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 198.36,
   "end": 202.26,
   "text": "مخاطب هر قدر بیشتر از خودش ظرفیت علمی، مطالعه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 202.26,
   "end": 204.44,
   "text": "نشون بده، خوب شد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 204.44,
   "end": 211.28,
   "text": ". ان شاء الله. به همون میزان ان شاء الله ما هم بیشتر تلاش خواهیم کرد سطح دوره بالاتر بره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 211.28,
   "end": 213.5,
   "text": "اینم یک مطلب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 213.5,
   "end": 217.08,
   "text": "دوره معرفتی ما مجموعاً دو تاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 217.08,
   "end": 221.06,
   "text": "معرفتی یک و دو. هر کدوم سه ترمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 221.06,
   "end": 223.68,
   "text": "الان میشه ترم دو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 223.68,
   "end": 229.2,
   "text": "معرفتی یک. یکش رو برگزار کردیم سوره مبارکه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 229.2,
   "end": 237.1,
   "text": "انشقاق تا ناس و دویش هم از مزمل تا متفfin.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 237.1,
   "end": 239.5,
   "text": "معمولاً ما اینطوری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 239.5,
   "end": 243.56,
   "text": "برنامه می‌ریزیم در دوره اول،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 243.56,
   "end": 247.72,
   "text": "اون ترم اول بیشتر دنبال آشنایی هستیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 247.72,
   "end": 255.62,
   "text": "اصلاً تدبر چیه؟ تدبر رو بچشیم، یه مقدار باهاش انس بگیریم، یه مقدار ارتباط برقرار بکنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 255.62,
   "end": 257.94,
   "text": "یه دستگرمی اصطلاحاً.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 257.94,
   "end": 261.58,
   "text": "با اینکه سی و یک سوره قرآن بحث شد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 261.58,
   "end": 269.02,
   "text": "ولی خیلی هنوز وارد بحثای فنی‌تر سعی نکردیم بشیم در دوره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 269.02,
   "end": 274.16,
   "text": "یک. در دوره دو یه مقدار بیشتر میشه ان شاء الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 274.16,
   "end": 279.54,
   "text": "یعنی تلاش می‌کنیم که یه مقدار فاز فنی بحثا تقویت بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 279.54,
   "end": 282.42,
   "text": "منتها بازم از شما باید بازخورد بگیریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 282.42,
   "end": 285.92,
   "text": "یعنی باید احساس بکنیم که جمعیت همراهه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 285.92,
   "end": 289.26,
   "text": "اکثر افراد دارن کار می‌کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 289.26,
   "end": 292.76,
   "text": "حالا بنده به حسب تجربه‌ای که خدا عطا کرده بیش از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 292.76,
   "end": 296.2,
   "text": "هفده هجده سال کارم تدریس تدبره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 296.2,
   "end": 300.96,
   "text": "لازم نیست شما حرفی بزنید. همین شما بشینید تو جلسه و من سوره ای رو بگم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 300.96,
   "end": 304.76,
   "text": "میفهمم کار کردید یا کار نکردید اکثرتون رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 304.76,
   "end": 307.44,
   "text": "ادعا نیست‌ها. جداً راست میگم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 307.44,
   "end": 311.48,
   "text": "میفهمم از نگاهتون، از حستون، از بازخوردتون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 311.48,
   "end": 316.9,
   "text": "متوجه میشم که خب این جمعیت در حال استفاده از یک منبرن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 316.9,
   "end": 319.94,
   "text": "یا در حال تعلمن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 319.94,
   "end": 327.06,
   "text": "دارن یاد میگیرن. البته هر دو تعلمه ولی یه مقدار تفاوت‌هایی توش هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 327.06,
   "end": 330.4,
   "text": "لذا توقع داریم بیشتر ان شاء الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 330.4,
   "end": 334.2,
   "text": "وقت بگذارید. مراحل تدبر یادتون هست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 334.2,
   "end": 337.88,
   "text": "چیا بوده؟ یک-",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 337.88,
   "end": 346.46,
   "text": "فهم آیات. فهم آیات. ما دیگه توقع داریم در فهم آیات توی این دوره کسی مشکلی براش باقی نمونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 346.46,
   "end": 355.08,
   "text": "یعنی هرکس تو فهم آیات احیانا گیر داره، مشکل داره باید برطرف کنه در طول این ترم دیگه نباید باقی بمونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 355.08,
   "end": 359.98,
   "text": "مشکلی نباد باقی بمونه. صرف و نحو لازمه یاد بگیرید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 359.98,
   "end": 361.86,
   "text": "یه مختصری یاد بگیرید دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 361.86,
   "end": 368.46,
   "text": "دیگه دیر نکنید. لازم نیست برید صرف و نحو نمیدونم بسیار مفصل عربی رو ما کن-- نه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 368.46,
   "end": 373.48,
   "text": "یه آشنایی با صرف و نحو عربی پیدا کنید و تو سوره‌های قرآن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 373.48,
   "end": 377.14,
   "text": "دنبال کنید مباحثش. همون surه ای رو که میخوایم کار کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 377.14,
   "end": 382.16,
   "text": "مثلا surه مزمل رو داریم کار میکنیم شما صرف و نحوش هم کار کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 382.16,
   "end": 383.82,
   "text": "يا أَيُّهَا الْمُزَّمِّلُ.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 383.82,
   "end": 385.72,
   "text": "مثلا يا، يا چیه؟ أَيُّهَا چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 385.72,
   "end": 388.36,
   "text": "الْمُزَّمِّلُ چه جور کلمه ایه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 388.36,
   "end": 390.8,
   "text": "معنی این چی میشه؟ اینا رو کار کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 390.8,
   "end": 394.94,
   "text": "یه مقدار بیش از دوره یک براش سرمایه‌گذاری کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 394.94,
   "end": 400.44,
   "text": "به خصوص اونایی که تا حالا کار نکردید، سرمایه‌گذاری نکردید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 400.44,
   "end": 402.46,
   "text": "یعنی ما توقع داریم در پایان ترم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 402.46,
   "end": 410.94,
   "text": "دو دیگه همه افراد در حاشیه دوره اگرم تو صرف و نحو و مفاهیم آیات اشکالی مشکلی بوده برطرف شده باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 410.94,
   "end": 414.88,
   "text": "براش برنامه بریزید لطفا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 414.88,
   "end": 419.64,
   "text": "قسمت دوم، مرحله دوم چیه در تدبر؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 419.64,
   "end": 422.81,
   "text": "تشخیص سیاق‌هاست. سیاق‌ها رو بشناسیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 422.81,
   "end": 426.22,
   "text": "این surه چند سیاق دارد، از کجا تا کجا، کجا تا کجا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 426.22,
   "end": 430.84,
   "text": "لازمه‌ش اینه که آیات رو به لحاظ مفهومی، لفظی، ادبی با هم مقایسه کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 430.84,
   "end": 435.02,
   "text": "بفهمیم این آیه به قبل متصل است یا از قبل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 435.02,
   "end": 438.52,
   "text": "منفصل است. اگر منفصل بود یعنی شروع",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 438.52,
   "end": 441.66,
   "text": "سیاق جدید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 441.66,
   "end": 446.14,
   "text": "این مهارت هم انشاالله ما توقع داریم دیگه توی این ترم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 446.14,
   "end": 451.42,
   "text": "این مهارت هم دیگه انشاالله به کمال خودش برسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 451.42,
   "end": 455.34,
   "text": "لذا جایی براتون سؤال پیش اومد، ابهام پیش اومد بپرسید،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 455.34,
   "end": 460.3,
   "text": "بگذارید برطرف بشه. چطور شد اینجا رو ما سیاق رو جدا کردیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 460.3,
   "end": 462.56,
   "text": "اگر متوجه نشدید. چطور شد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 462.56,
   "end": 468.62,
   "text": "متصل دانستیم؟ اگر متوجه نشدید سؤال کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 468.62,
   "end": 471.76,
   "text": "اگر ابهام داشت بپرسید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 471.76,
   "end": 474.0,
   "text": "حالا مراحل بعدی که جمع‌بندی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 474.0,
   "end": 481.57,
   "text": "سیاق‌ها باشد و ارتباط سیاق‌ها با هم باشه، خب ما برای این دوره هدف‌گذاری خاصی روی مراحل بعدی نمیکنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 481.57,
   "end": 488.08,
   "text": "البته بنده همه رو آموزشی ارائه میدم اما از شما دیگه توقعمو سنگین نمیکنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 488.08,
   "end": 494.48,
   "text": "توقع من اینه که این دو مرحله اول تدبر یعنی فهم آیات، دسته‌بندی surه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 494.48,
   "end": 499.38,
   "text": "این دو مرحله دیگه انشاالله در این دوره کامل بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 499.38,
   "end": 501.92,
   "text": "به خصوص مرحله اول",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 501.92,
   "end": 505.26,
   "text": "و تا حد امکان مرحله دوم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 505.26,
   "end": 508.36,
   "text": "که همین مسئله دسته‌بندی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 508.36,
   "end": 515.58,
   "text": "surه هاست. لذا سعی کنید قبل از اینکه حالا کتاب رو انشاالله تهیه خواهید فرمود،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 515.58,
   "end": 522.9,
   "text": "سعی کنید قبل از اینکه کتاب رو بهش مراجعه بکنید، قبل از اینکه بنده در کلاس تدریس بکنم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 522.9,
   "end": 529.24,
   "text": "شما خودتون مفاهیم و دسته‌بندی رو کار کرده باشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 529.24,
   "end": 534.58,
   "text": "درست شد؟ ما در ترم قبلی می‌گفتیم تکلیف همین که شما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 534.58,
   "end": 538.22,
   "text": "surه رو به شکل کلی کار کنی، یه گزارشی بدی تکلیفه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 538.22,
   "end": 541.08,
   "text": "تو این سطح، تو این ترم یه مقدار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 541.08,
   "end": 545.06,
   "text": "اگر اجازه بدید جدی‌تر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 545.06,
   "end": 548.1,
   "text": "تکلیف یعنی اینکه حالا مفاهیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 548.1,
   "end": 555.88,
   "text": "با خودتون لااقل تو تشخیص ساختار surه قشنگ یه بحثی رو برای ما ارائه بدید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 555.88,
   "end": 558.64,
   "text": "تو نصف صفحه، تو یه صفحه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 558.64,
   "end": 561.08,
   "text": "که من با توجه به این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 561.08,
   "end": 566.68,
   "text": "مثلا مطالب تشخیص دادم این surه سه تا سیاق داره، دو تا سیاق داره، یه سیاق داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 566.68,
   "end": 569.84,
   "text": "با کتاب مخالفم، موافقم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 569.84,
   "end": 573.92,
   "text": "فکر نکنید هر کس موافق کتاب به نظر میرسه من خیلی خوشحال میشم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 573.92,
   "end": 576.12,
   "text": "اگه مخالف برسه من نه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 576.12,
   "end": 582.02,
   "text": "من میخوام شما یاد بگیرید. شما اونچه که واقعا متوجه میشید رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 582.02,
   "end": 586.2,
   "text": "روش تمرکز کنید تا نکات آموزشی تقویت بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 586.2,
   "end": 593.5,
   "text": "اگر شما مثلا سه تسلیم باشه دیگه حالا هرچی کتاب بگه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 593.5,
   "end": 596.34,
   "text": "آخرش هم که این حرف خودشو ثابت میکنه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 596.34,
   "end": 598.72,
   "text": "پس ما از همون اول میگیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 598.72,
   "end": 600.37,
   "text": "این surه مثلا دو تا سیاق دارد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 600.37,
   "end": 604.74,
   "text": "دیگه چه کاریه من بگم سه تا سیاق دارد بعد ایشون بیاد بگه نه دو تا سیاق دارد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 604.74,
   "end": 606.96,
   "text": "همون اول میرم کتابو باز می‌کنم کار تمام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 606.96,
   "end": 610.78,
   "text": "خب یاد نمی‌گیرید. کمتر یاد می‌گیرید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 610.78,
   "end": 613.52,
   "text": "نمیگم هیچی یاد نمی-- کمتر یاد می‌گیرید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 613.52,
   "end": 616.14,
   "text": "لذا پیش مطالعه میخوایم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 616.14,
   "end": 623.55,
   "text": "قبل از کلاس، قبل از کتاب خودتون مفاهیم آیات و ساختار surه را کار کنید،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 623.55,
   "end": 626.78,
   "text": "ساختار surه رو برای ما گزارش بدید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 626.78,
   "end": 631.16,
   "text": "تکلیفی که من تو این دوره میخوام کلا یازده تا surه ما میخوایم کار کنیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 631.16,
   "end": 633.46,
   "text": "یازده تا گزارش ساختارشناسانه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 633.46,
   "end": 636.86,
   "text": "یکیش که هیچ surه مزمل که surه اوله،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 636.86,
   "end": 639.64,
   "text": "خب ازش گذشتیم. ده تا surه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 639.64,
   "end": 645.82,
   "text": "ده تا انشاالله گزارش ساختارشناسی surه ها رو به ما بدید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 645.82,
   "end": 650.08,
   "text": "هرکس تو ده صفحه تکلیف قراره به ما بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 650.08,
   "end": 656.3,
   "text": "این کل تکلیف. ولی میخوایم سیر رشد رو ببینیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 656.3,
   "end": 660.08,
   "text": "و چقدر جالبه که مثلا ببینیم بله توی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 660.08,
   "end": 666.06,
   "text": "تکلیف‌ها افراد واقعا دیدگاه خودشون، تشخیص خودشونو منعکس کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 666.06,
   "end": 673.62,
   "text": "این به ما کمک میکنه. در تعلم شما و در بهتر شدن تعلیم ما انشاالله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 673.62,
   "end": 676.28,
   "text": "ما کلاسی که نشانه گرفتیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 676.28,
   "end": 680.9,
   "text": "دیگه برای سطح سه به بعد سی چهل نفره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 680.9,
   "end": 683.78,
   "text": "مگر دیگه شماها خودتونو برسونید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 683.78,
   "end": 689.68,
   "text": "اینکه ما وایسیم جان من تو رو خدا همتون بیاید هر طور شده دویست نفر جمع بشید، اینطوری نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 689.68,
   "end": 691.7,
   "text": "داریم میریم به سمت فنی‌تر شدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 691.7,
   "end": 695.9,
   "text": "ترم بعدمون فنی‌تره، ترم بعدمون همینطوره، ترم بعدمون همینطوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 695.9,
   "end": 700.84,
   "text": "ممکنه سطح شش مثلا بنده باشم اون شش نفر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 700.84,
   "end": 703.24,
   "text": "دیگه ترم آخره. خب طبیعیه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 703.24,
   "end": 709.46,
   "text": "یه مقدار افراد مثلا میگه آقا من سی تا surه یاد گرفتم حالا تا برم به اینا عمل کنم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 709.46,
   "end": 711.94,
   "text": "سی سال؟ بگید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 711.94,
   "end": 715.36,
   "text": "طول میکشه. حالا سی سال بعد میام سطح دوشو می‌گذرونم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 715.36,
   "end": 720.08,
   "text": "حالا ممکنه یه نفرم بگه نه من سی روزه رفتم عمل کردم به اینا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 720.08,
   "end": 724.2,
   "text": "حالا دیگه انشاالله خدا به همه ما توفیق بده هرچی از قرآن می‌آموزیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 724.2,
   "end": 726.94,
   "text": "سعی کنیم تو زندگیمون به اون جامعه عمل بپوشانیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 726.94,
   "end": 729.47,
   "text": "به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 729.47,
   "end": 731.5,
   "text": "بعد دیگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 731.5,
   "end": 734.18,
   "text": "در اثناء جلسه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 734.18,
   "end": 739.0,
   "text": "بنا رو بگذارید بر اینکه جز به ضرورت سؤال نکنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 739.0,
   "end": 743.04,
   "text": "اشکالی به مطلبی داشتید و اینا یادداشت کنید بدید به من.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 743.04,
   "end": 747.02,
   "text": "چون جمعیت زیاده اگه یادداشت بشه من راحت‌تر مدیریت می‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 747.02,
   "end": 750.4,
   "text": "اثناء جلسه تا جایی که ممکنه سؤال نکنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 750.4,
   "end": 754.54,
   "text": "الا اینکه یه وقت من یه چیزی گفتم شما متوجه نشدید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 754.54,
   "end": 759.64,
   "text": "منظور رو نفهمیدید. اگر الان سؤال نکنی دیگه از ج- بحث عقب می‌افتی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 759.64,
   "end": 762.76,
   "text": "خب سؤال کنید چی شدین، من یه بار دیگه تکرارش کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 762.76,
   "end": 768.42,
   "text": "اشکال نداره اون. اما سؤال و جوابی که نه نظر من اینه، نظر شما اینه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 768.42,
   "end": 771.52,
   "text": "این مباحثه‌ای اتفاق نیفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 771.52,
   "end": 777.1,
   "text": "چرا بالاخره بقیه بتونن استفاده کنن از جلسه بیشتر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 777.1,
   "end": 782.48,
   "text": "و به لحاظ آیین‌نامه هم این دوره، دوره‌ایه که بخشی از امتیازش حضورشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 782.48,
   "end": 787.42,
   "text": "ما دیگه مثل دوره سطح یک آخر سر نمیگیم حضوری یا غیرحضوری چی دوست داری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 787.42,
   "end": 791.06,
   "text": "اینجوری نیست. هشتاد امتیاز حضورشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 791.06,
   "end": 794.68,
   "text": "برای کسایی که حضوری اومدن هشتاد امتیاز حضوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 794.68,
   "end": 798.98,
   "text": "بقیشم میشه در واقع آزمون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 798.98,
   "end": 804.56,
   "text": "و آزمون هم انشاالله مثل سطح یک آسون خواهد بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 804.56,
   "end": 806.52,
   "text": "خیلی آسون بود. خب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 806.52,
   "end": 810.88,
   "text": "نه این دفعه انشاالله واقعا آسون خواهد-- من همون سطح یکم واقعا آسونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 810.88,
   "end": 813.94,
   "text": "من خیللیی خوشحال بودم بعد جور خود تو ذوقم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 813.94,
   "end": 816.16,
   "text": "خوشحال بودم که برای اولین بار امتحان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 816.16,
   "end": 820.64,
   "text": "آص- آسون گرفتم. ولی خب مثل اینکه خیلی هم آسون نبوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}