 },
 "chapters": [
  {
   "index": 0,
   "title": "## تکلیف سورهٔ ضحی و انتخاب سبک زندگی",
   "start": 10.36,
   "end": 30.38
  },
  {
   "index": 1,
   "title": "## داستان پیانو و حدّ عالیِ کار",
   "start": 30.38,
   "end": 199.16
  },
  {
   "index": 2,
   "title": "## مسیر سطوح تا مربی‌گری",
   "start": 199.16,
   "end": 219.48
  },
  {
   "index": 3,
   "title": "## تفسیر تخصصی در برابر تدبر برای همه",
   "start": 219.48,
   "end": 452.29
  },
  {
   "index": 4,
   "title": "## سورهٔ ضحی یک سیاق است",
   "start": 452.29,
   "end": 497.67
  },
  {
   "index": 5,
   "title": "کلش مثلاً این‌طور خوانده می‌شود:",
   "start": 497.67,
   "end": 534.33
  },
  {
   "index": 6,
   "title": "تازه غیر از این:",
   "start": 534.33,
   "end": 564.98
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 10.36,
   "end": 12.56,
   "text": "سوره مبارکه زها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 12.56,
   "end": 14.78,
   "text": "خب کیا کار کردن سوره زها؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 14.78,
   "end": 18.4,
   "text": "به تکالیف عمل نمی‌کنید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 18.4,
   "end": 24.48,
   "text": "چرا؟ دیگه خب حاج آقا میاد اینجا میگه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 24.48,
   "end": 26.36,
   "text": "ما برای چی خودمون رو زحمت بدیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 26.36,
   "end": 29.76,
   "text": "یه هفته برو مطالعه کن یا تو کتابم هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 29.76,
   "end": 35.44,
   "text": "چه کاریه که ما بریم این سلول‌های خاکستری عزیز رو که استراحت می‌کنن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 35.44,
   "end": 37.44,
   "text": "اینا رو از خواب بیدار کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 37.44,
   "end": 44.0,
   "text": "کیا اینجا تصمیم دارن راه رو ادامه بدن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 44.0,
   "end": 48.04,
   "text": "\"إن علينا للهدى\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 48.04,
   "end": 51.34,
   "text": "و \"إن لنا للآخرة والأولى\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 51.34,
   "end": 54.92,
   "text": "سبک زندگی با شماست، نتیجه با کیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 54.92,
   "end": 64.06,
   "text": "سبک زندگی عدم مطالعه و عدم تلاش و منتظر موندن برای آخر هفته که بیایم اینجا بشنویم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 64.06,
   "end": 68.96,
   "text": "اون سبک زندگی \"فسنيسر هول ال\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 68.96,
   "end": 77.24,
   "text": "دیگه حالا. اما سبک زندگی که می‌خواد برسد به ادامه راه، بره جلو بشه معلم قرآن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 77.24,
   "end": 79.1,
   "text": "بشه مروج قرآن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 79.1,
   "end": 81.92,
   "text": "بشه مبلغ قرآن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 81.92,
   "end": 88.82,
   "text": "می‌خواد قرآن را به هر حال تو زندگی خودش و تو جامعه خودش جلو ببره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 88.82,
   "end": 94.9,
   "text": "اون دیگه با مطالعه نکردن و کار رو به کلاس واگذار کردن و اینا جور در...",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 94.9,
   "end": 100.06,
   "text": "انتخاب با شماست اما نتیجه دیگه با شما نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 100.06,
   "end": 103.24,
   "text": "بله، شما می‌تونید که مطالعه نکنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 103.24,
   "end": 110.3,
   "text": "هیچ مشکلی نیست اما دیگه نمی‌تونید توقع داشته باشید فردا معلم قرآن بشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 110.3,
   "end": 115.0,
   "text": "دیگه نمی‌تونید توقع داشته باشید فردا مروج و مبلغ قرآن باشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 115.0,
   "end": 120.64,
   "text": "نمیشه. میگه یه بنده خدایی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 120.64,
   "end": 124.98,
   "text": "استاد خیلی قوی و قدر پیانو بود داشت پیانو می‌زد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 124.98,
   "end": 128.12,
   "text": "خیلی عالی و زیبا هم داشت پیانو می‌زد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 128.12,
   "end": 133.84,
   "text": "بعد یه نفر از این مخاطبین بعد از اینکه پیانو او رو می‌شنوه و اینا خیلی خوشش میاد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 133.84,
   "end": 139.0,
   "text": "میاد جلو میگه که استاد من حاضر بودم همه زندگیمو بدم یه بار مثل شما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 139.0,
   "end": 144.64,
   "text": "پیانو بزنم. اینم میگه اتفاقا منم همه زندگیمو دادم دارم این پیانو رو می‌زنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 144.64,
   "end": 149.96,
   "text": "شما خیال کردی اینجور پیانو زدن با یک ساعت دو ساعت تمرین به دست اومده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 149.96,
   "end": 159.8,
   "text": "همه زندگیم خرجش شده. اگر کسی می‌خواد تو راهی که میره اون حد عالی را بزنه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 159.8,
   "end": 164.42,
   "text": "تدریس عالی قرآن داشته باشه، تبلیغ عالی قرآن داشته باشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 164.42,
   "end": 170.92,
   "text": "جای، جای قرآن رو بفهمه، بتونه شرح کنه، بتونه جلو ببره بحث رو باید کار کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 170.92,
   "end": 173.66,
   "text": "حالا من مگه چقدر در هفته تکلیف کردم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 173.66,
   "end": 177.36,
   "text": "برای دو ساعت چقدر؟ چقدر برای دو ساعت؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 177.36,
   "end": 182.22,
   "text": "دو ساعت. یعنی گفتم برای این دو ساعت، دو ساعتم شما کار کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 182.22,
   "end": 187.1,
   "text": "این دو ساعتی که ما گفتیم، این دو ساعت فقط برای اینه که همین کلاسه به دردتون بخوره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 187.1,
   "end": 191.74,
   "text": "و الا اگر کسی راه مربی‌گری رو بخواد دنبال بکنه دیگه دو ساعت نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 191.74,
   "end": 195.32,
   "text": "هر روز دو ساعت کار کنه، اقلش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 195.32,
   "end": 199.16,
   "text": "اقلش هر روز دو ساعت باید مطالعه کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 199.16,
   "end": 205.14,
   "text": "به هر حال خواهش می‌کنم از اون خواهران و برادرانی که واقعا مایلن راه رو ادامه بدن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 205.14,
   "end": 208.26,
   "text": "ما تو سط-- پایان سطح یک آزمون می‌گیریم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 208.26,
   "end": 212.22,
   "text": "ان‌شاءالله آزمون موفقینش میان سطح دوها،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 212.22,
   "end": 215.74,
   "text": "موفقینش میرن سطح سه، موفقینش میرن سطح چهار،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 215.74,
   "end": 219.48,
   "text": "موفقینش میرن سطح پنج، موفقینش میرن سطح شش،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 219.48,
   "end": 222.2,
   "text": "موفقینش میان مربی‌گری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 222.2,
   "end": 228.08,
   "text": "مسیر، یه مسیر طولانیه دویست و چهل ساعت اقلا آموزش و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 228.08,
   "end": 233.46,
   "text": "عرضم به خدمتتون چهل ساعتم دوره مربی‌گری و در خودتون ببینید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 233.46,
   "end": 237.34,
   "text": "ممکنه الان یه نفر بگه من رشته‌م فرض بفرمایید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 237.34,
   "end": 239.86,
   "text": "حوزوی نیست. خب حوزوی نباشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 239.86,
   "end": 243.02,
   "text": "مگه قرآن مال حوزوی‌هاست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 243.02,
   "end": 246.75,
   "text": "یا قرآن درس دادن مگه مخصوص حوزوی‌هاست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 246.75,
   "end": 249.34,
   "text": "\"خيركم من تعلم القرآن وعلمه\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 249.34,
   "end": 253.9,
   "text": "بهترینتون کسانی‌اند که قرآن رو یاد بگیرن و یاد بدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 253.9,
   "end": 256.88,
   "text": "پزشکی، پزشک باش. مهندسی، مهندس باش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 256.88,
   "end": 259.28,
   "text": "بازاری هستی بازاری باش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 259.28,
   "end": 262.38,
   "text": "خانه‌داری، خانه‌دار باش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 262.38,
   "end": 264.92,
   "text": "خانه‌دار می‌تونه تو خونه خودش یه جلسه تشکیل بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 264.92,
   "end": 267.8,
   "text": "پزشک می‌تونه تو مطب خودش یه آیه‌ای هم برای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 267.8,
   "end": 272.22,
   "text": "مریزش بگه یا برای همکارانش می‌تونه جلسه بذاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 272.22,
   "end": 273.88,
   "text": "مهندس هم می‌تونه همین کار رو انجام بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 273.88,
   "end": 277.36,
   "text": "همه ما باید زبان قرآن باشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 277.36,
   "end": 280.32,
   "text": "همه ما. خیلی کار سختی نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 280.32,
   "end": 283.26,
   "text": "یه بار تفسیر قرآن می‌خوایم بکنیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 283.26,
   "end": 286.86,
   "text": "تفسیر کردن قرآن، درس دادن تفسیر قرآن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 286.86,
   "end": 294.44,
   "text": "این یه حوزه تخصصیه باید به خاطرش دیگه رشتت رو تو عوض کنی بیای تو حوزه کلا دیگه باید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 294.44,
   "end": 303.7,
   "text": "راه مثلا تحصیلات علوم دینی را بری تا به تخصص تفسیری برسی و بتونی تفسیر بگی، تفسیر کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 303.7,
   "end": 306.9,
   "text": "اون یه راهه بله، جدی و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 306.9,
   "end": 310.3,
   "text": "پیچیده و تخصصی و این‌هاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 310.3,
   "end": 314.02,
   "text": "اما تدبر کردن و تدبر گفتن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 314.02,
   "end": 321.7,
   "text": "راهش برای همه بازه. یه مقدار باید ادبیاتمون رو تقویت کنیم، خب تقویت می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 321.7,
   "end": 328.76,
   "text": "مثلا تو این کلاس طرف اومده میگه من بعضی از بحث‌های ادبی رو تازه می‌فهمم که خوب ادبیاتم خوب نیست، بسم الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 328.76,
   "end": 332.12,
   "text": "دو تا کتاب ادبیات ساده، صاف و ساده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 332.12,
   "end": 335.1,
   "text": "صرف ساده، مثلا نحو مقدماتی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 335.1,
   "end": 340.82,
   "text": "صرف مقدماتی، نحو مقدماتی یا صرف ساده، کتاب هدایه یا صمدیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 340.82,
   "end": 343.24,
   "text": "یه دونه استاد، یه طلبه‌ای، یه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 343.24,
   "end": 346.98,
   "text": "دوستی که آشنا باشه با ادبیات عرب ببینیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 346.98,
   "end": 351.66,
   "text": "لازمه یه حق الزحمه‌ای هم بهش بدیم بگیم فلانی بیا با ما بحث کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 351.66,
   "end": 353.92,
   "text": "هفته‌ای یه، یه ساعت با هم بحث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 353.92,
   "end": 357.0,
   "text": "ادبیات داشته باشیم، سوره‌ها رو تجزیه و ترکیب کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 357.0,
   "end": 360.54,
   "text": "راه می‌افته دیگه. ادبیات مگه چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 360.54,
   "end": 364.01,
   "text": "ادبیات با تمرین حاصل میشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 364.01,
   "end": 366.49,
   "text": "شما تو متن قرآن کار کنید و یه مباحثه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 366.49,
   "end": 372.61,
   "text": "کوچیکم بگذارید ادبیات تون به اندازه ای که لازم باشه قرآن را بگید و بفهمید رشد میکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 372.61,
   "end": 383.85,
   "text": "دیگه از شما نمیخوان که آقا مثل مثلا مجتهدان زبان عربی که بتونید اقوال را در تمام نمیدونم کلمات وجوه مختلف چرا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 383.85,
   "end": 388.05,
   "text": "یه عربی ساده‌ای که قرآن رو بفهمم و بفهمونم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 388.05,
   "end": 396.21,
   "text": "به دست میاد. من تو این کلاس‌ها فهمیدم اگر فرض بفرمایید یه مقدار مطالعات کلامی‌م بیشتر باشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 396.21,
   "end": 398.83,
   "text": "قوی‌تر میتونم از عهده کار بربیام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 398.83,
   "end": 404.69,
   "text": "همچین تشخیصی دادی با یه استادی مشورت کن، یه کتاب کلامی ساده رو بگیر بخون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 404.69,
   "end": 410.97,
   "text": "خودتون قشنگ میتونید با یک هوشمندی در کنار این کلاس‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 410.97,
   "end": 417.25,
   "text": "خودتون رو آماده کنید برای یک مربی قدر بودن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 417.25,
   "end": 420.49,
   "text": "من تو این کلاس‌ها فهمیدم خوبه قرآن رو لااقل بتونم خوب بخونم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 420.49,
   "end": 423.23,
   "text": "صحیح بخونم. قرآن خوانیم صحیح نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 423.23,
   "end": 427.53,
   "text": "بسم الله یه تمرین، یه کلاس کوچیک میری صحیح خوانی قرآن رو یاد میگیری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 427.53,
   "end": 431.67,
   "text": "عزم تون جزم باشه انشاالله برای مربی شدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 431.67,
   "end": 433.71,
   "text": "این خواهش من از جمع حاضر هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 433.71,
   "end": 437.57,
   "text": "کسی نگه در من نیست در توآ، در توان هممون هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 437.57,
   "end": 439.77,
   "text": "حالا یکی کلاس ممکنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 439.77,
   "end": 443.53,
   "text": "ده نفره یک کسی ممکنه کلاس صد نفره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 443.53,
   "end": 452.29,
   "text": "ولی همه ما انشاالله میتونیم بالاخره قرآن رو حداقل به بچه هامون یاد بدیم، به همسرمون یاد بدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 452.29,
   "end": 458.05,
   "text": "سوره مبارکه ضحی اونطور که شما خوندید چند دسته دارد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 458.05,
   "end": 461.29,
   "text": "دو تا، سه تا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 461.29,
   "end": 466.19,
   "text": "یکی، یکی، سه تا، دو تا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 466.19,
   "end": 468.67,
   "text": "یک دسته بیشتر نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 468.67,
   "end": 472.29,
   "text": "یعنی به لحاظ سیاق بندی یه دسته است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 472.29,
   "end": 476.67,
   "text": "دو تا سیاق نیست. کلش مثلا اعوذ بالله من الشيطان الرجيم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 476.67,
   "end": 478.99,
   "text": "بسم الله الرحمن الرحيم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 478.99,
   "end": 483.55,
   "text": "والضحى. والليل إذا سجا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 483.55,
   "end": 487.57,
   "text": "ما ودعك ربك وما قلى.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 487.57,
   "end": 490.95,
   "text": "وللآخرة خير لك من الأولى.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 490.95,
   "end": 495.57,
   "text": "ولسوف يعطيك ربك فترضى.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 495.57,
   "end": 497.67,
   "text": "ألم يجدك يتيما فآوى.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 497.67,
   "end": 501.49,
   "text": "خب اینجا درسته دیگه جواب قسم تمام شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 501.49,
   "end": 506.11,
   "text": "اما اینکه میگه ألم يجدك به همون کسی که خدا گفته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 506.11,
   "end": 508.45,
   "text": "ما ودعك ربك",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 508.45,
   "end": 510.99,
   "text": "به همون کسی که گفته ولسوف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 510.99,
   "end": 513.03,
   "text": "يعطيك ربك فترضى",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 513.03,
   "end": 520.95,
   "text": "به همون فرد خدا میخواد شاهد بیاره میگه بابا مگه من قبلاً تو یتیم نبودی تو رو پناهت دادم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 520.95,
   "end": 523.39,
   "text": "ألم يجدك يتيما فآوى.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 523.39,
   "end": 527.41,
   "text": "تازه غیر از این ووجدك ضالا فهدى.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 527.41,
   "end": 530.79,
   "text": "ووجدك عائلا فأغنى.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 530.79,
   "end": 534.33,
   "text": "فأما اليتيم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 534.33,
   "end": 536.73,
   "text": "خب این وصله یا وصل نیست؟ وصله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 536.73,
   "end": 542.59,
   "text": "ألم يجدك يتيما فآوى فأما اليتيم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 542.59,
   "end": 546.19,
   "text": "فلا تقهر. وأما السائل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 546.19,
   "end": 548.63,
   "text": "فلا تنهر. ووجدك عائلا فأغنى.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 548.63,
   "end": 551.39,
   "text": "وأما بنعمة ربك فحدث.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 551.39,
   "end": 556.77,
   "text": "پس از نظر سیر مفهومی کل سوره یک سیر مفهومی بیشتر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 556.77,
   "end": 559.23,
   "text": "نداره. یک سیاقه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 559.23,
   "end": 562.27,
   "text": "این سیاق رو باید ما فقط جمع بندیش بکنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 562.27,
   "end": 564.98,
   "text": "انشاالله برای ساعت بعدی. بفرمایید برای استراحت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}