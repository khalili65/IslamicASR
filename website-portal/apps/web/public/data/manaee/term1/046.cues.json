 "chapters": [
  {
   "index": 0,
   "title": "## آیات مورد بحث در این جلسه",
   "start": 175.84,
   "end": 380.9
  },
  {
   "index": 1,
   "title": "اینکه در روایات‌مان داریم:",
   "start": 380.9,
   "end": 499.6
  },
  {
   "index": 2,
   "title": "## قرائت سورهٔ عصر",
   "start": 499.6,
   "end": 520.58
  },
  {
   "index": 3,
   "title": "## تکلیف هفتهٔ آینده و پایان جلسه",
   "start": 520.58,
   "end": 589.78
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 10.88,
   "end": 14.78,
   "text": "سوره مبارکه عصر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 14.78,
   "end": 17.54,
   "text": "بسم الله الرحمن الرحیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 17.54,
   "end": 23.08,
   "text": "والعصر إن الإنسان لفي خسر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 23.08,
   "end": 26.78,
   "text": "قسم به عصر یعنی چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 26.78,
   "end": 31.0,
   "text": "زمان که انسان در خسره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 31.0,
   "end": 33.72,
   "text": "خسر یعنی چی؟ زیان زیان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 33.72,
   "end": 37.93,
   "text": "چه جور زیانی؟ زیان سرمایه زیان در سرمایه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 37.93,
   "end": 39.72,
   "text": "زیان در سود نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 39.72,
   "end": 41.44,
   "text": "زیان در سرمایه‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 41.44,
   "end": 44.94,
   "text": "اصل سرمایه که از بین میره میشه خسر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 44.94,
   "end": 48.7,
   "text": "چه ربطی بین این سوگند و جوابشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 48.7,
   "end": 52.74,
   "text": "زمان سرمایه زمانه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 52.74,
   "end": 59.38,
   "text": "سرمایه ما عمر ماست. قسم به زمان که انسان در خسرانه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 59.38,
   "end": 64.42,
   "text": "یعنی همینطور که داره ثانیه‌ها می‌گذره شما داری چی از دست میدی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 64.42,
   "end": 66.5,
   "text": "عمر و زمانو داری از دست میدی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 66.5,
   "end": 69.36,
   "text": "عمر و زمان چیه؟ سرمایته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 69.36,
   "end": 72.6,
   "text": "تمام دارایی یک انسان همین زمانیست که داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 72.6,
   "end": 75.8,
   "text": "همین فرصتی‌ست که به او دادن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 75.8,
   "end": 77.64,
   "text": "حالا ببین ثانیه‌ها چقد ارزش داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 77.64,
   "end": 82.34,
   "text": "دقیقه‌ها چقد ارزش داره. والعصر إن الإنسان لفي خسر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 82.34,
   "end": 84.86,
   "text": "اصلاً این یه قاعده گریزناپذیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 84.86,
   "end": 87.68,
   "text": "الا یه راهی. یعنی زمان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 87.68,
   "end": 95.88,
   "text": "مگر زمان وایسه تا وقتی زمان در حرکت است سرمایه در حال بگید از بین رفتن است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 95.88,
   "end": 97.7,
   "text": "این یه چیزی نیست که شما بتونی جلوشو بگیری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 97.7,
   "end": 102.62,
   "text": "نه میشه زمانو وایسوند، نه میشه که زمان بگذره فرصت تو کم نشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 102.62,
   "end": 105.32,
   "text": "زمان می‌گذره، فرصت تو هم کم میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 105.32,
   "end": 107.84,
   "text": "این یک مسئله قهریه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 107.84,
   "end": 111.53,
   "text": "هرکی همین الان با خودش حساب کنه چند سالشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 111.53,
   "end": 114.04,
   "text": ". من همین الان با خودم حساب می‌کنم چهل سالمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 114.04,
   "end": 117.5,
   "text": "یعنی چهل سال گذشت .",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 117.5,
   "end": 120.08,
   "text": "چهل سال رفت. چقد مونده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 120.08,
   "end": 123.28,
   "text": "نمی‌دونم. مونده ده سال.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 123.28,
   "end": 125.52,
   "text": "مونده بیست سال. مونده یه سال.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 125.52,
   "end": 127.18,
   "text": "مونده یه ماه، یه روز، یه ساعت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 127.18,
   "end": 129.58,
   "text": "نمی‌دونم .",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 129.58,
   "end": 132.78,
   "text": "خیلی رفت. والعصر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 132.78,
   "end": 136.2,
   "text": "إن الإنسان لفي خسر انسان تو خسرانه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 136.2,
   "end": 138.78,
   "text": "بخواد نخواد همینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 138.78,
   "end": 140.76,
   "text": "فقط یه راه نجات وجود داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 140.76,
   "end": 143.94,
   "text": "الا. این الا راه نجاته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 143.94,
   "end": 146.44,
   "text": "إلا الذين آمنوا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 146.44,
   "end": 150.16,
   "text": "وعملوا الصالحات. اونی که ایمان آورد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 150.16,
   "end": 154.02,
   "text": "و به برنامه‌های شایسته عمل کرد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 154.02,
   "end": 157.28,
   "text": "که قبلاً گفتم در سوره قاشیه برنامه شایسته یعنی چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 157.28,
   "end": 162.54,
   "text": "ایمان آورد و به برنامه‌های شایسته عمل کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 162.54,
   "end": 165.54,
   "text": "این خسارت نمی‌کنه. می‌دونید چرا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 165.54,
   "end": 173.08,
   "text": "چون عمره، عمری که از او رفته در راه ایمان و عمل صالح چیزی بهتر از اون به جاش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 173.08,
   "end": 175.14,
   "text": "بگید قرار گرفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 175.14,
   "end": 180.54,
   "text": "اون چیه؟ اون رضای پروردگاره که زندگی ابدی توام با سعادت رو به دنبال داشته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 180.54,
   "end": 188.63,
   "text": "پس این خسارت نشد. اگر با ایمان رفت، اگر با عمل صالح رفت خسارت نیست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 188.63,
   "end": 193.02,
   "text": ". بلکه اتفاقاً نهایت انتفاع و سوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 193.02,
   "end": 195.3,
   "text": "چون یه عمری میره که مربوط به این دنیاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 195.3,
   "end": 198.88,
   "text": "به جاش یک ابدیت سعادت و نجات در انتظار انسانه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 198.88,
   "end": 201.92,
   "text": "خب چی خ-چی بهتر از این؟ عالیه که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 201.92,
   "end": 205.04,
   "text": "این که خسارت نیست .",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 205.04,
   "end": 208.08,
   "text": "بعد یه چیزی رو به این عمل صالحات عطف می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 208.08,
   "end": 212.06,
   "text": "یعنی گویا تو عمل به برنامه‌های شایسته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 212.06,
   "end": 217.32,
   "text": "دو تا عمل به طور ویژه جایگاه داره برای مقابله با خسر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 217.32,
   "end": 220.96,
   "text": "تواصوا بالحق تواصوا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 220.96,
   "end": 223.86,
   "text": "بالصبر. تواصوا مصدرش میشه چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 223.86,
   "end": 227.68,
   "text": "شما بگید. تواصی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 227.68,
   "end": 231.5,
   "text": "تواصی. تواصی کدوم بابه؟ تفاعل تفاعل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 231.5,
   "end": 234.76,
   "text": "باب تفاعل اشتراک، مشارکته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 234.76,
   "end": 237.8,
   "text": "همونطور که مفاعله هم چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 237.8,
   "end": 241.62,
   "text": "اشتراکه. ما میگیم مکاتبه، تکاتب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 241.62,
   "end": 244.9,
   "text": "مکاتبه یعنی نامه‌نگاری. تکاتب هم یعنی نامه‌نگاری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 244.9,
   "end": 248.9,
   "text": "ولی کی میگیم مکاتبه، کی تکاتب؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 248.9,
   "end": 253.66,
   "text": "مکاتبه وقتیه که شما داری نامه میدی به کسی و او می‌گیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 253.66,
   "end": 257.44,
   "text": "تکاتب اینه که نامه می‌گیری از کسی و او نامه میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 257.44,
   "end": 262.12,
   "text": "یعنی مکاتبه و تکاتب هر دو اشتراکه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 262.12,
   "end": 269.4,
   "text": "ولی با این فرق اگر بنده به شما نامه دادم، من با شما چه کردم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 269.4,
   "end": 273.46,
   "text": "مکاتبه کردم. شما چکار کردی نامه رو گرفتی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 273.46,
   "end": 280.18,
   "text": "تکاتب کردی. اگر من به شما وصیتی کردم، چه کردم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 280.18,
   "end": 283.32,
   "text": "مواسات، مواسات کردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 283.32,
   "end": 286.52,
   "text": "شما که وصیت منو قبول کردی چکار کردی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 286.52,
   "end": 295.02,
   "text": "تواصی کردی. یعنی خدا وقتی میگه تواصی منظورش این نیست که وصیت کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 295.02,
   "end": 297.52,
   "text": "منظور اینه که وصیت را بگید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 297.52,
   "end": 309.5,
   "text": "بپذیرید. اون کسی که میخواد از خسران نجات پیدا کنه باید مواظب باشه که از مسیر ایمان و عمل صالح خارج بگید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 309.5,
   "end": 315.54,
   "text": "نشه. خب چه چیزایی میتونه باعث بشه من از ایمان و عمل صالح خارج بشم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 315.54,
   "end": 318.78,
   "text": "یه وقتایی غفلت از حق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 318.78,
   "end": 322.94,
   "text": ". پس من باید یه تواصیه به حقی هم داشته باشم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 322.94,
   "end": 325.96,
   "text": "اگر من میخوام هیچی خسارت نکنم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 325.96,
   "end": 328.94,
   "text": "پس هیچی نباید از حق بگید،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 328.94,
   "end": 331.24,
   "text": "از حق غافل بشم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 331.24,
   "end": 335.46,
   "text": "پس باید اگر کسی مرا توصیه به حق می‌کند،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 335.46,
   "end": 338.26,
   "text": "من به گوش جان بپذیرم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 338.26,
   "end": 341.18,
   "text": "باید دنبال توصیه به حق باشم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 341.18,
   "end": 346.86,
   "text": "انسانی که میخواد از خسران نجات پیدا کنه نصیحت‌پذیر میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 346.86,
   "end": 349.1,
   "text": "انتقادپذیر میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 349.1,
   "end": 350.96,
   "text": "توصیه‌پذیر میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 350.96,
   "end": 354.66,
   "text": "این توصیه‌پذیری مسئله اول ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 354.66,
   "end": 359.52,
   "text": "هرکی می‌خواد ما رو به حق دعوت کنه ما ازش بدمون میاد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 359.52,
   "end": 363.2,
   "text": ". خوشمون نمیاد کسی به ما بگه آقا این حقه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 363.2,
   "end": 365.92,
   "text": "این راهی که میری باطله این خسارته‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 365.92,
   "end": 369.9,
   "text": "مگر نفهمیدی که تا انسان ایمان و عمل صالح نداشته باشد خسارته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 369.9,
   "end": 373.86,
   "text": "میگه چرا فهمیدم؟ خب برگرد حق اینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 373.86,
   "end": 376.68,
   "text": "تشنه. اینکه در روایات‌مون داریم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 376.68,
   "end": 380.9,
   "text": "\"أحب الإخوان إلي من أهدى عيوبي إلي\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 380.9,
   "end": 383.82,
   "text": "بهترین برادران من اونیه که عیبای منو به من میگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 383.82,
   "end": 387.22,
   "text": "چرا؟ چون من از خسارت چیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 387.22,
   "end": 389.52,
   "text": "گریزانم. نمیخوام خسارت کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 389.52,
   "end": 393.58,
   "text": "چون نمیخوام خسارت کنم حتی هیچی حتی یه ثانیه هم نمیخوام هدر بره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 393.58,
   "end": 396.06,
   "text": "پس باید تواصی به حق داشته باشم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 396.06,
   "end": 399.9,
   "text": "یه وقتایی هم میدونید چرا ما از ایمان و عمل صالح خارج میشیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 399.9,
   "end": 403.18,
   "text": "مشکلمون چیه؟ صبره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 403.18,
   "end": 407.62,
   "text": "یعنی یه وقتایی حقو میدونیم توانشو نداریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 407.62,
   "end": 412.16,
   "text": "میدونیم این گناهه اما دیگه این شوق گناه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 412.16,
   "end": 414.9,
   "text": "داره میبره. میدونیم این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 414.9,
   "end": 418.24,
   "text": "کار نباید-- میریم اما یعنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 418.24,
   "end": 421.16,
   "text": "میگه هم طاعت صبر میخواد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 421.16,
   "end": 425.66,
   "text": "هم ترک معصیت صبر میخواد هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 425.66,
   "end": 428.54,
   "text": "مصیبت صبر میخواد. صبر سه شاخه داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 428.54,
   "end": 432.6,
   "text": "صبر بر طاعت، صبر بر ترک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 432.6,
   "end": 435.28,
   "text": "معصیت، صبر بر مصیبت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 435.28,
   "end": 439.9,
   "text": "یه وقتایی بندگی سخته، صبرمون کم میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 439.9,
   "end": 442.28,
   "text": "یه وقتایی ترک معصیت سخته،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 442.28,
   "end": 447.22,
   "text": "صبرمون کمه. یه وقتایی مصیبت سخته، صبرمون کمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 447.22,
   "end": 454.78,
   "text": "کسی اگر میخواد از خسارت نجات پیدا کنه باید تو جاده ایمان و عمل صالح همیشه باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 454.78,
   "end": 460.38,
   "text": "کسی میخواد همیشه تو این جاده بمونه باید توصیه پذیری به صبرم داشته باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 460.38,
   "end": 464.48,
   "text": "فلانی صبر کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 464.48,
   "end": 467.62,
   "text": "صبر کن. میدونم تو فشاری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 467.62,
   "end": 470.5,
   "text": "میدونم سخته. صبر کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 470.5,
   "end": 475.96,
   "text": "اینم بگه چشم. خیلی ازت ممنونم که منو به صبر دعوت کردی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 475.96,
   "end": 479.98,
   "text": "یکدیگر را باید دعوت کنیم به حق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 479.98,
   "end": 487.47,
   "text": "و دعوت کنیم به صبر و از همدیگه باید دعوت به حق و صبر را بپذیریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 487.47,
   "end": 491.72,
   "text": "اون وقت میتونیم تو راه ایمان و عمل صالح بمانیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 491.72,
   "end": 494.06,
   "text": "در اون صورت از خسارت نجات پیدا می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 494.06,
   "end": 499.6,
   "text": "در غیر این صورت محکوم به خسارتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 499.6,
   "end": 502.4,
   "text": "خب یه بار سوره رو بخونم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 502.4,
   "end": 505.54,
   "text": "أعوذ بالله من الشيطان الرجيم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 505.54,
   "end": 509.18,
   "text": "بسم الله الرحمن الرحيم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 509.18,
   "end": 513.56,
   "text": "والعصر. إن الإنسان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 513.56,
   "end": 520.58,
   "text": "لفي خسر. إلا الذين آمنوا وعملوا الصالحات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 520.58,
   "end": 522.78,
   "text": "وتواصوا بالحق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 522.78,
   "end": 525.24,
   "text": "وتواصوا بالصبر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 525.24,
   "end": 529.6,
   "text": "صدق الله العلي العظيم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 529.6,
   "end": 533.36,
   "text": "اللهم صل على محمد وآل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 533.36,
   "end": 535.82,
   "text": "ان شاء الله برای هفته آینده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 535.82,
   "end": 539.2,
   "text": "یک، سوره مبارکه همزه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 539.2,
   "end": 541.06,
   "text": "دو، فيل. سه، قرش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 541.06,
   "end": 546.5,
   "text": "چهار، ماعون. اقلاً چهار تا سوره برای هفته آینده آماده باشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 546.5,
   "end": 553.2,
   "text": "فردا عاشورا هم هست و خیلی جلسه ویژه ایه ان شاء الله در محضر قرآن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 553.2,
   "end": 558.16,
   "text": "یک روز بعد از عاشورا. خواهشم اینه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 558.16,
   "end": 560.46,
   "text": "مفاهیم آیات کامل،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 560.46,
   "end": 566.54,
   "text": "جمع‌بندی کامل تو همه این چهار تا سوره حداقل تکلیفیه که ما داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 566.54,
   "end": 569.66,
   "text": "حالا اونایی که بیشتر میتونن وقت کنن میتونن یه دو تا سوره هم پیش برن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 569.66,
   "end": 572.54,
   "text": "چون من احتمال میدم دو تا سوره بعد از اون هم بتونیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 572.54,
   "end": 581.52,
   "text": "بریم جلو. تا هفته آینده شما رو به خدا میسپارم و آرزو می‌کنم در مجالس سید و شهدا علیه السلام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 581.52,
   "end": 587.36,
   "text": "ساعات و لحظاتی نورانی همراه با قرب هرچه بیشتر به پروردگار داشته باشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 587.36,
   "end": 589.78,
   "text": "به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}