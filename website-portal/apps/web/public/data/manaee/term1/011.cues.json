 ],
 "cues": [
  {
   "i": 0,
   "start": 11.76,
   "end": 14.56,
   "text": "اعوذ بالله من الشيطان الرجيم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 14.56,
   "end": 17.88,
   "text": "بسم الله الرحمن الرحيم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 17.88,
   "end": 23.76,
   "text": "الحمد لله رب العالمين وصلى الله على سيدنا ونبينا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 23.76,
   "end": 28.38,
   "text": "حبيب اله العالمين ابا القاسم المصطفى محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 28.38,
   "end": 31.08,
   "text": "اللهم صل على محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 31.08,
   "end": 42.48,
   "text": "وال محمد وعجل فرجه وعلى آله الطيبين الطاهرين ولعنة الله على أعدائهم أجمعين من الآن إلى قيام يوم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 42.48,
   "end": 47.0,
   "text": "الدين. عرضم به خدمت شما در فضای کلاس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 47.0,
   "end": 56.36,
   "text": "اگر سوالی براتون پیش میاد مثلاً می‌بینید بنده بحثی رو مطرح می‌کنم شما متوجه منظور من نشدید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 56.36,
   "end": 62.6,
   "text": "و وقتی متوجه منظور نمیشه آدم ادامه بحث ممکنه دیگه دریافت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 62.6,
   "end": 65.82,
   "text": "نداشته باشه. گویا یه خلایی پیش میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 65.82,
   "end": 69.16,
   "text": "این خلاء تا آخر کلاس اثر خودشو میگذاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 69.16,
   "end": 73.88,
   "text": "ما این حقو برای شما قائلیم. همونجا دست بلند کنید بنده فرصتی باز می‌کنم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 73.88,
   "end": 79.88,
   "text": "سؤال کنید بنده توضیح بدم تا ابهام برطرف بشه راجع به عرض خودم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 79.88,
   "end": 83.32,
   "text": "اما یه وقت نظری دارید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 83.32,
   "end": 87.72,
   "text": "یعنی نظری دارید غیر از نظری که ما تو کلاس مطرح کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 87.72,
   "end": 94.3,
   "text": "حالا یا در تفسیر مطالعه کردید، در ترجمه مطالعه کردید یا به ذهن خودتون مطلبی رسیده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 94.3,
   "end": 95.96,
   "text": "اینا هم ارزشمنده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 95.96,
   "end": 102.5,
   "text": "در جلسه قبلی خواستم که برای مطالبی که به نظرتون میرسه یه فرصتی به خودتون بدید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 102.5,
   "end": 106.46,
   "text": "یعنی لازم نیست تو کلاس همون لحظه نظرتون رو بیان کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 106.46,
   "end": 112.2,
   "text": "یه فرصت به خودتون بدید برید تو خونه یه بار دیگه مطالعه بکنید، بررسی بکنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 112.2,
   "end": 118.44,
   "text": "اگر تشخیص دادید که باید من در جریان قرار بگیرم لازمه که بدونم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 118.44,
   "end": 122.58,
   "text": "اونوقت به شکل حالا فایلی که دوستان سؤالاتی که در اختیار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 122.58,
   "end": 128.12,
   "text": "ما قرار میدن یا کتبی به من میرسونید و منم انشاالله به اندازه بضاعتم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 128.12,
   "end": 133.02,
   "text": "جوابگو هستم. اگر یه وقت شما مطلبی رو بگید که من ببینم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 133.02,
   "end": 135.58,
   "text": "من می‌تونم ردش کنم، نمی‌تونم قبولش کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 135.58,
   "end": 137.66,
   "text": "صادقانه همین حرفو بهتون می‌زنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 137.66,
   "end": 140.56,
   "text": "میگم شما مطلبی رو فرمودید تشکر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 140.56,
   "end": 142.68,
   "text": "من فعلاً نه ردش می‌کنم نه قبول.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 142.68,
   "end": 144.86,
   "text": "اگر ببینم مطلب درسته قبول می‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 144.86,
   "end": 146.8,
   "text": "ببینم مطلب اشکال داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 146.8,
   "end": 149.22,
   "text": "اشکالی را که به ذهنم میرسه عرض خواهم کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 149.22,
   "end": 153.08,
   "text": "خیلی شفاف و خلاصه رو راست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 153.08,
   "end": 155.52,
   "text": "به این شکل انشاالله برنامه جلو میره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 155.52,
   "end": 157.5,
   "text": "پس بنابراین از این به بعد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 157.5,
   "end": 160.0,
   "text": "تو کلاس فقط در صورتی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 160.0,
   "end": 163.22,
   "text": "ابهامی براتون پیش بیاد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 163.22,
   "end": 166.88,
   "text": "چی بود این مطلب؟ متوجه نشدیم شما چی گفتی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 166.88,
   "end": 169.08,
   "text": "مثلاً گفتی الف لام جنس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 169.08,
   "end": 174.52,
   "text": "جنس یعنی چی؟ مثلاً گفتی فلان آیه معنیش این میشه، من نفهمیدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 174.52,
   "end": 176.76,
   "text": "یه بار دیگه میشه توضیح بدید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 176.76,
   "end": 179.68,
   "text": "این جور سؤالات. راجع به معنی کلمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 179.68,
   "end": 183.12,
   "text": "راجع به نمی‌دونم معنی آیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 183.12,
   "end": 185.68,
   "text": "و انشاالله به تدریج اینا رم کم می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 185.68,
   "end": 188.5,
   "text": "یعنی ما باید بریم به سمتی که شماها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 188.5,
   "end": 193.62,
   "text": "خودتون با مطالعه کافی خیلی از این مسائل رو حل بکنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 193.62,
   "end": 199.48,
   "text": "و این مسائل خیلی از سؤالاتی که تا به حال من تو این دوره جواب دادم سؤالاتی که با یک مراجعه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 199.48,
   "end": 202.52,
   "text": "ساده مثلاً می‌بینید بعضاً قابل حله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 202.52,
   "end": 205.18,
   "text": "آدم می‌تونه به جوابش دست پیدا بکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 205.18,
   "end": 211.86,
   "text": "خب قبل از اینکه سوره اعلا رو شروع بکنیم بگذارید در سوره مبارکه طارق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 211.86,
   "end": 217.84,
   "text": "جمع‌بندی سیاق دومو که گفتیم ارتباط دو سیاق درسته؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 217.84,
   "end": 227.18,
   "text": "ارتباط دو سیاق رو در سوره مبارکه طارق با هم بحث کنیم و بعد انشاالله سوره اعلا رو آغاز بکنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 227.18,
   "end": 231.06,
   "text": "سوره مبارکه طارق همونطور که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 231.06,
   "end": 235.58,
   "text": "حضور ذهن دارید یک سیاقش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 235.58,
   "end": 239.67,
   "text": "متشکل از دو مطلب بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 239.67,
   "end": 242.64,
   "text": "دو تا فراز اصلی داشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 242.64,
   "end": 245.36,
   "text": "فراز اول در سیاق یک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 245.36,
   "end": 248.92,
   "text": "مسئله حفظ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 248.92,
   "end": 253.76,
   "text": "نفس بود. حفظ نفس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 253.76,
   "end": 256.84,
   "text": "\"إن كل نفس لما عليها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 256.84,
   "end": 259.78,
   "text": "حافظ\" که توضیح دادیم منظور",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 259.78,
   "end": 264.8,
   "text": "نگه داشتن روح انسانه بعد از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 264.8,
   "end": 268.88,
   "text": "مرگش. از کجا مرگ رو آوردیم اینجا وسط؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 268.88,
   "end": 271.98,
   "text": "با توجه به آیات بعدی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 271.98,
   "end": 277.54,
   "text": "تو آیات بعدی که خدا فرمود \"إنه على رجعه لقادر\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 277.54,
   "end": 280.46,
   "text": "مشخص کرد که فضای بحث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 280.46,
   "end": 284.08,
   "text": "فضای پس از مرگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 284.08,
   "end": 287.22,
   "text": "پس این \"إن كل نفس لما عليها حافظ\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 287.22,
   "end": 290.49,
   "text": "درسته همیشه خدا نفس رو حفظ میکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 290.49,
   "end": 293.6,
   "text": "ولی این تأکید برای اینه که بدانید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 293.6,
   "end": 297.2,
   "text": "حتی اگر بمیرید بازم نفس شما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 297.2,
   "end": 300.18,
   "text": "حفظ می‌شود. روح شما از بین نمیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 300.18,
   "end": 304.18,
   "text": "حفظ نفس با اون رویکرد بعد از مرگش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 304.18,
   "end": 307.56,
   "text": "خب. مطلب دومش درباره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 307.56,
   "end": 312.14,
   "text": "قدرت خدا، قدرت خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 312.14,
   "end": 315.56,
   "text": "بر بازگرداندن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 315.56,
   "end": 322.18,
   "text": "جسم انسانه. یعنی اینکه بعد از مرگ وقتی جسم انسان دفن میشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 322.18,
   "end": 324.38,
   "text": "و به خاک تبدیل میشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 324.38,
   "end": 327.1,
   "text": "خدا قدرت برگردوندن اون را",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 327.1,
   "end": 330.34,
   "text": "دارد. \"إنه على رجعه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 330.34,
   "end": 336.1,
   "text": "لقادر\" اینجا آیه اصلی \"إن كل نفس لما عليها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 336.1,
   "end": 340.48,
   "text": "حافظ\" اینجا آیه اصلی \"إنه على رجعه لقادر\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 340.48,
   "end": 342.66,
   "text": "گفتیم این دو تا با هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 342.66,
   "end": 348.5,
   "text": "میشه معاد روحانی و جسمانی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 348.5,
   "end": 353.04,
   "text": "یعنی قرآن میخواد بگه مرگ پایان روح",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 353.04,
   "end": 356.2,
   "text": "و فنای مطلق جسم نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 356.2,
   "end": 358.7,
   "text": "روح حفظ می‌شود، جسم برمی‌گردد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 358.7,
   "end": 361.78,
   "text": "پس معاد هم روحانیه هم جسمانی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 361.78,
   "end": 372.15,
   "text": "این سیاق اول. سیاق دوم ابتدا با یه مقدمه‌ای تأکید کرد که \"والسماء ذات الرجع والأرض ذات السد\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 372.15,
   "end": 376.03,
   "text": "این یه قسمی بود، تأکید کرد بر این مطلب که \"إنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 376.03,
   "end": 377.88,
   "text": "لقول فصل\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 377.88,
   "end": 380.53,
   "text": "خب چی \"لقول فصل\"؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 380.53,
   "end": 384.51,
   "text": "همین. اینکه \"إنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 384.51,
   "end": 387.55,
   "text": "لقول فصل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 387.55,
   "end": 391.59,
   "text": "وما هو بالحزل\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 391.59,
   "end": 394.83,
   "text": "همانا آن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 394.83,
   "end": 398.51,
   "text": "قول فصل است که حق و باطل را بگید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 398.51,
   "end": 403.27,
   "text": "جدا می‌کند \"وما هو بالحزل\" و شوخی نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 403.27,
   "end": 406.55,
   "text": "این آن، این هو، این ضمیر \"إنه\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 406.55,
   "end": 409.87,
   "text": "این چیه؟ چی قول فصل است؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 409.87,
   "end": 413.93,
   "text": "خب بعضیا میگن قرآن. قرآن بله قول فصله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 413.93,
   "end": 417.31,
   "text": "اما الان ما داخل یک سوره هستیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 417.31,
   "end": 420.69,
   "text": "دنبال فهم ارتباطی هستیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 420.69,
   "end": 424.53,
   "text": "الان خدا یک چند آیه قبل‌تر یه حرفی زده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 424.53,
   "end": 428.41,
   "text": "گفته آقا معاد هم روحانیه هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 428.41,
   "end": 432.99,
   "text": "جسمانیه. الان که میگه \"إنه لقول فصل\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 432.99,
   "end": 438.03,
   "text": "مصداق بارز قول فصل همون معاد روحانی و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 438.03,
   "end": 441.39,
   "text": "یعنی معاد روحانی و جسمانی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 441.39,
   "end": 447.27,
   "text": "ما در سیاق قبلی ثابتش کردیم \"لقول فصل\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 447.27,
   "end": 453.39,
   "text": "معیاری که حق و باطل را تو مسئله معاد جدا میکنه اینه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 453.39,
   "end": 456.45,
   "text": "\"وما هو بالحزل\" و شوخی هم راجع بهش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 456.45,
   "end": 460.27,
   "text": "نداریم. اتفاقاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 460.27,
   "end": 465.61,
   "text": "چون ضمیر \"إنه\" برمی‌گرده به معاد روحانی و جسمانی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 465.61,
   "end": 472.53,
   "text": "به همین خاطره که ما می‌تونیم درک بکنیم چرا خدا سوگند یاد کرد به \"والسماء\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 472.53,
   "end": 477.37,
   "text": "بگید \"ذات الرجع والأرض",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 477.37,
   "end": 483.89,
   "text": "ذات السد\". ببینید \"والسماء ذات الرجع والأرض ذات السد\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 483.89,
   "end": 486.55,
   "text": "قسم به آسمان که می‌باراند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 486.55,
   "end": 489.05,
   "text": "قسم به زمین که می‌رویاند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 489.05,
   "end": 494.79,
   "text": "این باریدن و این رویاندن یه پدیده‌ایه که دلالت می‌کنه بر چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 494.79,
   "end": 498.23,
   "text": "بگید، معاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 498.23,
   "end": 502.55,
   "text": "چون \"إنه لقول فصل\" این هو معاده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 502.55,
   "end": 506.53,
   "text": "ارتباط قسم و جواب معلوم میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 506.53,
   "end": 509.97,
   "text": "این هو اگر معاد نبود،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 509.97,
   "end": 515.91,
   "text": "اون وقت این قسم هم اینجا تناسبش با جواب قسم چندان معلوم نبود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 515.91,
   "end": 520.61,
   "text": "خب چه ربطی داره که \"والسماء ذات الرجع والأرض ذات السد\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 520.61,
   "end": 523.13,
   "text": "قرآن به طور کلی \"لقول فصل\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 523.13,
   "end": 526.39,
   "text": "بله قرآن به طور کلی \"لقول فصل\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 526.39,
   "end": 530.87,
   "text": "اما تو این آیه با توجه به سیاق قبل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 530.87,
   "end": 535.79,
   "text": "اونی، اون سخنی از قرآن را میخواد بگه قول فصل و حزل نیست که همون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 535.79,
   "end": 540.27,
   "text": "معاد باشه. پس این یک بحث ارتباط دو سیاق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 540.27,
   "end": 546.25,
   "text": "از قبل این ضمیری که از \"إنه\" برمی‌گرده به معاد روحانی و جسمانی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 546.25,
   "end": 549.61,
   "text": "این یک وجه ارتباط دو سیاقه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 549.61,
   "end": 557.5,
   "text": "خب بعد می‌فرماید \"إنهم يكيدون كيدا\" در ادامه این سیاق صحبت از کید مطرح میکنه، کید کافران.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 557.5,
   "end": 562.41,
   "text": "\"إنهم يكيدون كيدا وعكيد كيدا فمهل الكافرين\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 562.41,
   "end": 565.34,
   "text": "جواب به کید کافران هم مهلته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 565.34,
   "end": 569.03,
   "text": "\"فمهل الكافرين أمهلهم رويدا\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 569.03,
   "end": 573.95,
   "text": "این بحث کفری هم که اینجا مطرح میشه خواهد شد کفر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 573.95,
   "end": 577.55,
   "text": "به بگید معاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 577.55,
   "end": 581.17,
   "text": "می‌خواد بگه کافران به معاد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 581.17,
   "end": 583.45,
   "text": "کافران به حقیقت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 583.45,
   "end": 586.27,
   "text": "معاد روحانی و جسمانی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 586.27,
   "end": 590.59,
   "text": "اینا کسانی هستند که از در کید و نقشه وارد میشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 590.59,
   "end": 592.97,
   "text": "خدا هم میگه منم جواب اونا رو با چی میدم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 592.97,
   "end": 597.87,
   "text": "کید و نقشه میدم و کید و نقشه من همون چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 597.87,
   "end": 600.25,
   "text": "همون مهلتی‌ست که به اون‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 600.25,
   "end": 604.91,
   "text": "میدم. پس جمع‌بندی سوره معلومه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 604.91,
   "end": 611.19,
   "text": "سوره محور بحثش معاد روحانی و جسمانی‌ست که در سیاق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 611.19,
   "end": 619.01,
   "text": "اول بر مسئله مهاد، معاد روحانی و جسمانی تأکید میکنه، استدلال میکنه، مسئله را حل میکنه و در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 619.01,
   "end": 625.99,
   "text": "سیاق دوم میاد به یه نحوی از سخنی که در سیاق اول گفته پشتیبانی میکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 625.99,
   "end": 634.58,
   "text": "میگه اگر شما می‌خواید این سخن را ردش کنید، این سخن را دروغ بدونید، این سخن را شوخی بدونید،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 634.58,
   "end": 639.29,
   "text": "بدانید این سخن، سخن فصل است و سخن هزلی نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 639.29,
   "end": 645.97,
   "text": "هر نقشه‌ای هم در مقابلش بکشید با نقشه‌کشیدن خدا طرفید و اونم مهلته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 645.97,
   "end": 649.59,
   "text": "یعنی خدا اصلاً عجله‌ای نداره برای عذاب کردنتون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 649.59,
   "end": 656.67,
   "text": "اتفاقاً بهتون مهلت میده و این مهلت نقشه‌ای‌ست که خدا برای شما داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 656.67,
   "end": 660.29,
   "text": "جمع‌بندی دو تا سیاق رو با توضیحاتی که دادم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 660.29,
   "end": 662.77,
   "text": "گفتم و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 662.77,
   "end": 667.39,
   "text": "اگر ابهامی داریم اینجا یا سوالی داریم من در خدمتم اگر نه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 667.39,
   "end": 674.71,
   "text": "خداوند خیلی روشن میگه در مقابل کسانی که به انکار معاد می‌پردازند از در کید،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 674.71,
   "end": 678.29,
   "text": "از در نقشه، شبهه درست کنیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 678.29,
   "end": 680.27,
   "text": "ذهن‌ها را منصرف کنیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 680.27,
   "end": 682.49,
   "text": "باورها را به هم بزنیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 682.49,
   "end": 686.15,
   "text": "به مردم بگیم با معاد دارن شما را گول می‌زنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 686.15,
   "end": 688.93,
   "text": "مردم را می‌خوایم از معاد منصرف بکنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 688.93,
   "end": 693.27,
   "text": "کسانی که از این در وارد میشن، کید میک، میکنن، نقشه میکشن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 693.27,
   "end": 696.15,
   "text": "منم کید می‌کنم. کید منم مهلته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 696.15,
   "end": 699.63,
   "text": "این خیلی قطعیه. مهلت میدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 699.63,
   "end": 704.89,
   "text": "یعنی این مهلت دادن نفی نمی‌کنه که فردا روزی خدا اینا رو عذاب می‌کند یا نمی‌کند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 704.89,
   "end": 711.47,
   "text": "ممکنه عذابش بکنه. اما هیچ عذابی برای اونا بالاتر از خود این مهلته نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 711.47,
   "end": 713.77,
   "text": "چون این مهلت سبب میشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 713.77,
   "end": 717.85,
   "text": "که بیش از پیش مستحق چی بشن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 717.85,
   "end": 724.97,
   "text": "عذاب بشن دیگه خدا در قرآن فرموده کسی که می‌خواد از در کید و نقشه و عناد با خدا در بیاد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 724.97,
   "end": 730.97,
   "text": "خدا هم بی‌جواب نمیگذاره. فضایی را ایجاد میکنه که او بیش از پیش مستحق عذاب بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}