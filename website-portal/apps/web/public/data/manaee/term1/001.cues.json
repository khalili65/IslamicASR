 ],
 "cues": [
  {
   "i": 0,
   "start": 10.54,
   "end": 13.04,
   "text": "اعوذ بالله من الشيطان الرجيم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 13.04,
   "end": 18.5,
   "text": "بسم الله الرحمن الرحيم و به نستعين.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 18.5,
   "end": 30.24,
   "text": "الحمد لله رب العالمين وصلى الله على سيدنا و نبينا حبيب اله العالمين ابى القاسم المصطفى محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 30.24,
   "end": 35.28,
   "text": "اللهم صل على محمد و آل محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 35.28,
   "end": 40.96,
   "text": "و على آله الطيبين الطاهرين المعصومين",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 40.96,
   "end": 49.2,
   "text": "و لعنة الله على أعدائهم أجمعين من الآن إلى قيام يوم الدين.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 49.2,
   "end": 57.62,
   "text": "عرض سلام و ادب و احترام محضر خواهران و برادران گرامی حاضر در جلسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 57.62,
   "end": 60.18,
   "text": "خدا رو شکر می‌کنیم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 60.18,
   "end": 66.16,
   "text": "توفیق پیدا کردیم باز هم در محضر نورانی کلام او",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 66.16,
   "end": 69.48,
   "text": "شاگردی کنیم، حضور پیدا کنیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 69.48,
   "end": 75.98,
   "text": "و تلاش کنیم برای استفاده هرچه بیشتر از کلام نورانی او.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 75.98,
   "end": 79.9,
   "text": "تلاش کنیم برای یادگیری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 79.9,
   "end": 86.02,
   "text": "تدبر در قرآن کریم و انجام تدبر در قرآن کریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 86.02,
   "end": 91.24,
   "text": "واقعاً شکر این نعمت از توان ما خارجه و از خدا می‌خواهیم که کوتاهی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 91.24,
   "end": 97.04,
   "text": "ما رو در شکر این نعمت بر ما عفو بکنه و ما رو ببخشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 97.04,
   "end": 102.94,
   "text": "و ما را هر روز شایسته‌تر برای شکر این نعمت بزرگ قرار بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 102.94,
   "end": 106.92,
   "text": "به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 106.92,
   "end": 115.8,
   "text": "اللهم صل على محمد و آل محمد و عجل فرجهم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 115.8,
   "end": 121.66,
   "text": "این دوره‌ای که به خواست خدا آغاز می‌کنیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 121.66,
   "end": 125.24,
   "text": "یک دوره معرفتی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 125.24,
   "end": 129.04,
   "text": "در سلسله دوره‌های آموزش تدبر در قرآنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 129.04,
   "end": 132.56,
   "text": "دوره معرفتی وقتی میگیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 132.56,
   "end": 136.12,
   "text": "در مقابل دوره مهارتیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 136.12,
   "end": 139.18,
   "text": "این بحثی که من الان دارم مطرح می‌کنم مقدمه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 139.18,
   "end": 149.86,
   "text": "دوره ما هست. خواهران و برادران باید خوب دقت کنند تا در اثناء برگزاری دوره ذهنتون با سؤال مواجه نشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 149.86,
   "end": 153.06,
   "text": "وقتی ما میگیم دوره معرفتی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 153.06,
   "end": 156.16,
   "text": "در مقابل دوره مهارتیه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 156.16,
   "end": 159.36,
   "text": "فرق دوره معرفتی و مهارتی چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 159.36,
   "end": 163.32,
   "text": "در دوره معرفتی سوره‌های قرآن رو ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 163.32,
   "end": 165.84,
   "text": "محور بحث قرار میدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 165.84,
   "end": 169.52,
   "text": "در سوره‌های قرآن با هم تدبر می‌کنیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 169.52,
   "end": 172.96,
   "text": "و سعی می‌کنیم تدبرمون روش‌مند باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 172.96,
   "end": 178.96,
   "text": "تدبرمون اصولی باشه، قاعده‌مند باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 178.96,
   "end": 181.56,
   "text": "یعنی از روش استفاده می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 181.56,
   "end": 187.18,
   "text": "ولی هدف چیه؟ یادگیری تدبر سوره‌های قرآن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 187.18,
   "end": 192.1,
   "text": "معارف تدبری سوره‌ها در این دوره مطرح میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 192.1,
   "end": 194.72,
   "text": "اما در دوره‌های مهارتی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 194.72,
   "end": 197.7,
   "text": "اونجا سوره محور بحث نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 197.7,
   "end": 200.88,
   "text": "خود روش تدبر محل بحثه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 200.88,
   "end": 207.3,
   "text": "در دوره‌های مهارتی محور بحث روش تدبر در قرآن کریمه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 207.3,
   "end": 210.76,
   "text": "نه ارائه معارف تدبری سوره‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 210.76,
   "end": 213.06,
   "text": "یعنی اونجا فرض فرمایید ما میگیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 213.06,
   "end": 215.4,
   "text": "تدبر در قرآن مراحلی دارد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 215.4,
   "end": 218.44,
   "text": "هر مرحله از تدبر اصولی دارد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 218.44,
   "end": 223.36,
   "text": "قواعدی دارد، اون اصول و قواعد رو کار میکنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 223.36,
   "end": 231.52,
   "text": "در دوره مهارتی ممکنه شما مثلاً فرض کنید یک ترم فقط دارید دسته‌بندی قرآن تمرین میکنید، دسته‌بندی سوره‌ها رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 231.52,
   "end": 237.36,
   "text": "اصلاً یه سوره‌ای تمام بشه ما تو اون سوره نتیجه بگیریم و از این حرفا نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 237.36,
   "end": 239.8,
   "text": "فضای دوره مهارتی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 239.8,
   "end": 243.76,
   "text": "با دوره معرفتی کاملاً متفاوته از این جهت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 243.76,
   "end": 247.18,
   "text": "اما دوره مهارتی برای چه کسانیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 247.18,
   "end": 252.86,
   "text": "برای کسانی که حداقل دوره معرفتی رو سه ترمشو گذرونده باشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 252.86,
   "end": 256.12,
   "text": "یعنی اگر در دوره معرفتی کسی سه ترم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 256.12,
   "end": 264.18,
   "text": "شرکت بکنه و همچنین شرایط دیگری رو هم داشته باشه، مثلاً یه نصاب خاصی از نمره رو بدست بیاره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 264.18,
   "end": 270.0,
   "text": "تحصیلات حوزوی یا تحصیلات دانشگاهی مرتبط داشته باشه، در اون صورت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 270.0,
   "end": 272.58,
   "text": "وارد دوره‌های مهارتي میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 272.58,
   "end": 277.26,
   "text": "پس این دوره ما معرفتی‌ست که داریم شروع می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 277.26,
   "end": 284.48,
   "text": "این مطلب اول. مطلب دوم این است که دوره معرفتی خودش تربیت مربی هم داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 284.48,
   "end": 290.32,
   "text": "یعنی کسانی که در این دوره شرکت می‌کنند در صورتی که نمرات مطلوب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 290.32,
   "end": 294.64,
   "text": "ما را که انشاالله من آیین‌نامه رو تدوین خواهیم کرد، خواهم کرد خدمتتون،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 294.64,
   "end": 297.5,
   "text": "نمره مطلوب رو بدست بیارن و شرایط",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 297.5,
   "end": 301.1,
   "text": "علمی لازم رو داشته باشن؛",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 301.1,
   "end": 307.9,
   "text": "مثلاً رشته‌های مرتبط باشن، حوزوی باشن یا توی بعضی از مصاحبه‌هایی که ما در نظر می‌گیریم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 307.9,
   "end": 310.7,
   "text": "توفیق بدست بیارن، موفق بشن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 310.7,
   "end": 314.16,
   "text": "در اون صورت وارد دوره‌های تربیت مربی هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 314.16,
   "end": 317.16,
   "text": "میشن. یعنی از این دوره می‌شود--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 317.16,
   "end": 321.16,
   "text": "موفقین این دوره می‌تونن وارد دوره‌های تربیت مربی هم بشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 321.16,
   "end": 324.9,
   "text": "پس این دوره ما دوره معرفتی تدبره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 324.9,
   "end": 331.1,
   "text": "نه دوره مهارتي و دوره آموزشیه، نه دوره تربیت مربی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 331.1,
   "end": 335.68,
   "text": "این اولاً. حالا این دوره معرفتی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 335.68,
   "end": 339.22,
   "text": "خودش مجموعاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 339.22,
   "end": 343.8,
   "text": "دو تا بخش داره. ما بهش میگیم معرفتی یک و دو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 343.8,
   "end": 347.94,
   "text": "معرفتی یک، صد و بیست ساعت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 347.94,
   "end": 350.68,
   "text": "معرفتی دو، صد و بیست ساعت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 350.68,
   "end": 354.88,
   "text": "مجموعاً دویست و چهل ساعت دوره است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 354.88,
   "end": 356.88,
   "text": "معرفتی یک، سه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 356.88,
   "end": 359.34,
   "text": "ترم داره، سه سطح داره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 359.34,
   "end": 362.48,
   "text": "هر سطحش چهل ساعت کلاسه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 362.48,
   "end": 367.67,
   "text": "و معرفتی دو هم سه سطح داره، هر سطحش چهل ساعت کلاسه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 367.67,
   "end": 376.27,
   "text": "الان ما آغاز چهل ساعت اول یعنی آغاز ترم اول از معرفتی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 376.27,
   "end": 383.61,
   "text": "یک هستیم. که ترم اول از معرفتی یک از سوره انشقاق شروع میشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 383.61,
   "end": 386.33,
   "text": "تا سوره ناس. سی و یک سوره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 386.33,
   "end": 394.43,
   "text": "آخر قرآن رو ما میخوایم در این دوره با همدیگه تدبر بکنیم و انشاالله ترم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 394.43,
   "end": 397.93,
   "text": "دوم با یه فاصله کوتاهی بین ترم اول و ترم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 397.93,
   "end": 400.33,
   "text": "دوم آزمونی برگزار می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 400.33,
   "end": 406.77,
   "text": "اون آزمون کسانی که درش موفق بشن می‌تونند به ترم دوم راه پیدا کنند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 406.77,
   "end": 412.35,
   "text": "و همینطور تا پایان شش ترم که دوره معرفتی ما تمام میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 412.35,
   "end": 415.85,
   "text": "اینم توضیح دوم. کل سوره هایی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 415.85,
   "end": 426.49,
   "text": "که در دوره معرفتی به شما آموزش داده خواهد شد در کل دوره معرفتی شصت و هشت سوره آخر قرآن کریمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 426.49,
   "end": 433.05,
   "text": "که این شصت و هشت تا سوره معروف به حزب مفصل قرآن کریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 433.05,
   "end": 440.57,
   "text": "پیامبر گرامی اسلام صلی الله علیه و آله و سلم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 440.57,
   "end": 450.25,
   "text": "فرمودند، اون حضرت فرمودند که حزب مفصل قرآن رو جدی بگیرید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 450.25,
   "end": 460.05,
   "text": "ماها رو توصیه کردند به اینکه اگر کسی میخواد قرآن یاد بگیره از حزب مفصل قرآن غافل نشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 460.05,
   "end": 464.81,
   "text": "در حدیثی در کتاب شریف اصول کافی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 464.81,
   "end": 475.59,
   "text": "از پیغمبر گرامی اسلام می‌خونیم که اون حضرت فرمودند خداوند این حزب مفصل قرآن را ویژه به من داده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 475.59,
   "end": 480.85,
   "text": "سوره های طوال قرآن، سوره های معین قرآن، سوره های مثانی قرآن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 480.85,
   "end": 483.33,
   "text": "اونا بخش‌های دیگری از قرآن‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 483.33,
   "end": 488.07,
   "text": "اونا هر کدوم به ازای تورات، به ازای انجیل و به ازای زبوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 488.07,
   "end": 493.99,
   "text": "اما حزب مفصل قرآن ویژه خود من پیغمبر آخرالزمانه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 493.99,
   "end": 504.31,
   "text": "بعد حضرت فرمودند که همین حزب مفصل قرآن کریم مهیمن بر تمام کتب آسمانیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 504.31,
   "end": 510.77,
   "text": "یعنی اگر کسی حزب مفصل قرآن کریم رو درش تدبر بکنه و یاد بگیره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 510.77,
   "end": 522.07,
   "text": "میتونه به شکل نسبی اطمینان داشته باشه که معارف قرآن به شکل جامع و مختصر در اختیار اوست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 522.07,
   "end": 525.97,
   "text": "خودش یه قرآن کوچیک و جمع و جوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 525.97,
   "end": 531.27,
   "text": "با اینکه بقیه قرآن هم واقعاً لطف خودش رو داره و ارزش خودش رو داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 531.27,
   "end": 533.99,
   "text": "اما حزب مفصل قرآن ویژه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 533.99,
   "end": 537.75,
   "text": "به خاطر همین و به دلایل آموزشی دیگری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 537.75,
   "end": 540.35,
   "text": "ما در دوره های تدبر رو حزب مفصل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 540.35,
   "end": 550.05,
   "text": "قرآن تأکید می‌کنیم در دوره های آموزشی مون و سوره های بلند رو در خارج از دوره های آموزشی ما پیگیری می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 550.05,
   "end": 552.69,
   "text": "اما توی حزب مفصل قرآن کریم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 552.69,
   "end": 555.09,
   "text": "ما مانور آموزشی میدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 555.09,
   "end": 558.83,
   "text": "از نظر آموزشی هم اگر حساب بکنید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 558.83,
   "end": 564.25,
   "text": "حزب مفصل خیلی مناسب برای آموزشه چون سوره ها نسبتاً کوتاهن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 564.25,
   "end": 566.33,
   "text": "آیه ها نسبتاً کوتاهن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 566.33,
   "end": 569.33,
   "text": "امکان تمرین، امکان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 569.33,
   "end": 575.89,
   "text": "در واقع کار مشترک گروهی و نتیجه گرفتن آموزشی تو این بخش زیاده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 575.89,
   "end": 582.55,
   "text": "انشاالله کسانی که در این بخش موفق بشن خواهند تونست بیان سوره های بلند دیگر قرآن رو هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 582.55,
   "end": 585.01,
   "text": "خودشون کار کنند یا با هم کار بکنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 585.01,
   "end": 589.01,
   "text": "ما الان در تهران جلساتی داریم مرتب هر هفته برگزار میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 589.01,
   "end": 591.43,
   "text": "سوره های دیگر قرآن رو داریم کار می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 591.43,
   "end": 595.21,
   "text": "همین الان مثلاً در حال تدبر در سوره مبارکه نحلم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 595.21,
   "end": 599.3,
   "text": "به همین ترتیب سوره های بلند قرآن انشاالله کار میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 599.3,
   "end": 603.61,
   "text": "اینم یک مطلب. خیر مقدم عرض بکنم خدمت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 603.61,
   "end": 610.05,
   "text": "مدیریت محترم مؤسسه تدبر در کلام وحی جناب آقای سفرزاده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 610.05,
   "end": 617.91,
   "text": "و امیدوارم که خدای بزرگ به ایشون و به همه ما توفیق عطا بکنه بیش از گذشته در خدمت قرآن کریم باشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 617.91,
   "end": 624.83,
   "text": "به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 624.83,
   "end": 627.91,
   "text": "خب. و اما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 627.91,
   "end": 632.61,
   "text": "اینکه ما این دوره رو به چه شکلی برگزار می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 632.61,
   "end": 635.29,
   "text": "شکل برگزاری دوره ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 635.29,
   "end": 639.83,
   "text": "به این صورته که هر هفته سه ساعت کلاس داریم روزهای چهارشنبه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 639.83,
   "end": 642.41,
   "text": "مثل همین روزی مرتب تا آخر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 642.41,
   "end": 647.63,
   "text": "شهریور هر چهارشنبه سه ساعت کلاس داریم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 647.63,
   "end": 653.31,
   "text": "که در این کلاس‌ها بنده میخوام تدبر سوره ها را ارائه بدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 653.31,
   "end": 661.03,
   "text": "ولی اگر فقط شما بیایید بشینید که بنده تدبر سوره ها را ارائه بدم و فعالیتی خودتون انجام ندید،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 661.03,
   "end": 664.81,
   "text": "این جلسه تبدیل میشه به یک سخنرانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 664.81,
   "end": 667.93,
   "text": "و ما دنبال سخنرانی نیستیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 667.93,
   "end": 673.25,
   "text": "پس لازمه موفقیت بیشتر شما توی این کلاس و در این دوره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 673.25,
   "end": 678.31,
   "text": "اینه که به تکالیفی که خدمت شما تقدیم میشه دقیقاً عمل بکنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 678.31,
   "end": 689.25,
   "text": "به تکالیف دقیقاً عمل بکنید و گزارش تکالیفتون هم داشته باشید چون که ما در پایان یک بخشی از امتیاز دوره مون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 689.25,
   "end": 691.53,
   "text": "عمل شما به تکالیفتون هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 691.53,
   "end": 697.07,
   "text": "کلاس رو تشریف میارید مرتب انشاالله و تکالیفی که تقدیم میشه انجام میدید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 697.07,
   "end": 703.01,
   "text": "همینطور تو کلاس تلاش می‌کنیم با مشارکت کلاس جلو بره و از شما توقع داریم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 703.01,
   "end": 706.35,
   "text": "مشارکت بکنید و کمک ما بکنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 706.35,
   "end": 712.35,
   "text": "کسانی که بیشتر فعالیت می‌کنند انشاالله بهتر می‌تونند دوره رو ادامه بدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 712.35,
   "end": 714.03,
   "text": "تکالیف ما هم چیزای سختی نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 714.03,
   "end": 716.87,
   "text": "در هر جلسه من عرض خواهم کرد که برای جلسه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 716.87,
   "end": 722.93,
   "text": "آینده چه کارهایی رو باید انجام بدید، چه مطالعاتی، چه دقت‌هایی باید داشته باشید و انشاالله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 722.93,
   "end": 729.81,
   "text": "اینو با همدیگه کم‌کم هماهنگ می‌شیم و پیش میره به خواست خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 729.81,
   "end": 732.47,
   "text": "دوره ما یه آیین‌نامه داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 732.47,
   "end": 737.05,
   "text": "آیین‌نامه‌ای که مشخص می‌کنه چه کسانی در این دوره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 737.05,
   "end": 738.81,
   "text": "موفق شدند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 738.81,
   "end": 743.11,
   "text": "این آیین‌نامه رو انشاالله در گروه بارگذاری خواهند کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 743.11,
   "end": 752.35,
   "text": "من خواهش می‌کنم با دقت آیین‌نامه رو ببینید تا بعداً خدای نکرده جای گلایه و اینا پیش نیاد تو امتیازدهی این دوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 752.35,
   "end": 757.57,
   "text": "همه افراد هم ملتزم باشید در گروه این کلاس عضو باشید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 757.57,
   "end": 761.39,
   "text": "یا کانال این کلاس که تش-تشکیل دادن عضو باشید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 761.39,
   "end": 768.55,
   "text": "تا اطلاع‌رسانی‌ها به شما برسه و لطفاً چک بکنید هر روز اگر مطلبی، نکته‌ای،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 768.55,
   "end": 771.13,
   "text": "منبع مطالعاتی لازم باشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 771.13,
   "end": 773.59,
   "text": "ما در کانال بارگذاری می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 773.59,
   "end": 776.51,
   "text": "آیین‌نامه دوره رو در کانال بارگذاری می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 776.51,
   "end": 783.51,
   "text": "همه عضو باشن که از تمام اطلاعات لازم به موقع برخوردار بشید انشاالله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 783.51,
   "end": 789.82,
   "text": "یک بخشی از امتیاز برای حضور در جلساته، در دوره‌های ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 789.82,
   "end": 796.09,
   "text": "اگر اشتباه نکنم از مجموع دویست امتیاز، هشتاد امتیاز حضور در جلساته،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 796.09,
   "end": 799.49,
   "text": "هشتاد امتیاز حضور در جلساته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 799.49,
   "end": 805.45,
   "text": "و یک بیست امتیاز اگر اشتباه نکنم برای تکالیفی‌ست که انجام میدید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 805.45,
   "end": 809.89,
   "text": "این صد امتیاز و صد امتیاز هم برای آزمونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 809.89,
   "end": 817.23,
   "text": "آزمون پایانی. مجموعاً دویست امتیاز که اگر کسی از مجموع دویست امتیاز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 817.23,
   "end": 819.49,
   "text": "صد و بیست امتیاز بیاره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 819.49,
   "end": 824.35,
   "text": "در دوره قبوله و می‌تونه به سطح بعدی منتقل بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 824.35,
   "end": 830.87,
   "text": "اما یادتون باشه کسانی که از الان تربیت مربی را نشانه گرفتید،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 830.87,
   "end": 834.71,
   "text": "تربیت مربی فقط کسانی راه پیدا می‌کنند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 834.71,
   "end": 844.11,
   "text": "که از مجموع دوره‌ها و آزمون دوره‌ها حداقل صد و پنجاه امتیاز از هر دویست تا صد و پنجاه تارو بیارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 844.11,
   "end": 848.67,
   "text": "یعنی برای تربیت مربی شما صد و پنجاه از دویست لازم دارید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 848.67,
   "end": 856.13,
   "text": "هر چند که برای قبولی صد و بیست از دویست کفایت می‌کنه و می‌تونید به سطح بعدی منتقل بشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 856.13,
   "end": 861.57,
   "text": "بنابراین انشاالله خواهران و برادران با جدیت کافی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 861.57,
   "end": 869.71,
   "text": "بنده یک بار دیگه لازم می‌دونم از طرف خودم و از طرف مؤسسه تدبر خدمت شما عرض",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 869.71,
   "end": 872.71,
   "text": "سلام و احترام مجدد و خیر مقدم داشته باشم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 872.71,
   "end": 876.07,
   "text": "بگم به دوره تدبر در قرآن خوش آمدید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 876.07,
   "end": 880.95,
   "text": "و آرزو می‌کنم این دوره برای شما دوره‌ای نورانی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 880.95,
   "end": 885.73,
   "text": "پر از معنویت و سرشار از دانش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 885.73,
   "end": 888.01,
   "text": "و مهارت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 888.01,
   "end": 890.91,
   "text": "در عرصه تدبر در قرآن کریم باشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 890.91,
   "end": 895.39,
   "text": "و آرزو می‌کنیم در پایان این دوره هر یک از شما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 895.39,
   "end": 903.83,
   "text": "در درون خودش این قضاوت را بیابد که در ارتباط با قرآن یک گام روشن به جلو حرکت کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 903.83,
   "end": 908.75,
   "text": "انشاالله. جمعی که من می‌بینم به لطف الهی جمعی فاضل،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 908.75,
   "end": 915.55,
   "text": "فرهیخته، اهل مطالعه هستید و من چهره‌های آشنا هم در جمع می‌بینم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 915.55,
   "end": 920.23,
   "text": "کسانی که قبلاً در دوره‌های دیگر تدبر حضور داشتند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 920.23,
   "end": 924.47,
   "text": "و ما افتخار داریم در این دوره هم در خدمتشون هستیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 924.47,
   "end": 926.91,
   "text": "و کسانی که این آشنایی رو داشتند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 926.91,
   "end": 935.77,
   "text": "ازشون می‌خوام که بیشتر در مباحثات، در گفت‌وگوها بیشتر کمک بکنند، نقش راهنما ایفا کنن‌ها،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 935.77,
   "end": 940.13,
   "text": "نه نقش کسی که می‌خواد جواب سؤالات رو پیشاپیش بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 940.13,
   "end": 942.89,
   "text": "اونایی که آشنا هستید از قبل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 942.89,
   "end": 949.43,
   "text": "نقش راهنما را ایفا بکنید برای دوستانتون، برای سایرینی که در جمع هستند و احیانا دوره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 949.43,
   "end": 954.91,
   "text": "حزب مفصل قرآن کریم رو نگذروندند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 954.91,
   "end": 963.55,
   "text": "اما یک مختصری هم بگم شاید تو ذهن بعضیاتون سؤال باشه مؤسسه تدبر در کلام وحی چه مؤسسه‌ایه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 963.55,
   "end": 966.45,
   "text": "چه کار انجام میده؟ کی تأسیس شده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 966.45,
   "end": 975.55,
   "text": "رسالتش چیه؟ این مؤسسه از سال هزار و سیصد و هشتاد و دو فعالیت خودش رو آغاز کرده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 975.55,
   "end": 977.85,
   "text": "که الان شونزده سال تمامه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 977.85,
   "end": 983.67,
   "text": "نزدیک شونزده سال تمام هست که مؤسسه داره کار می‌کنه و محور",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 983.67,
   "end": 991.41,
   "text": "فعالیت‌های این مؤسسه از روز اول تا الان این بوده که تدبر در قرآن را تعریف بکنه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 991.41,
   "end": 995.65,
   "text": "روش تدبر در قرآن را استخراج بکنه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 995.65,
   "end": 998.81,
   "text": "این روش را تدوین بکنه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 998.81,
   "end": 1002.91,
   "text": "این روش را در سوره‌های قرآن پیاده بکنه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 1002.91,
   "end": 1008.21,
   "text": "دوره‌های آموزشی تدبر را به تناسب مخاطبان مختلف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 1008.21,
   "end": 1013.91,
   "text": "تعریف بکنه و این دوره‌ها رو اجرا بکنه و در عرصه‌های فرهنگی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 1013.91,
   "end": 1020.49,
   "text": "مربوط به تدبر در قرآن فعالیت بکنه که به لطف الهی در تمام این زمینه‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 1020.49,
   "end": 1027.89,
   "text": "به لطف خدا این مؤسسه کار خودش رو انجام داده و توفیقات نسبی به دست آورده و امیدواریم با دعای شما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 1027.89,
   "end": 1034.41,
   "text": "توفیقات بهتری شامل حال دوستان ما و همکاران ما در مجموعه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 1034.41,
   "end": 1038.11,
   "text": "مؤسسه تدبر در کلام وحی و مؤسسات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 1038.11,
   "end": 1041.67,
   "text": "همسوی تدبری باشه انشاالله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 1041.67,
   "end": 1050.23,
   "text": "با دعای شما انشاالله کار بهتر و عالی‌تر پیش خواهد رفت و انشاالله با نظر مولامون و صاحبمون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 1050.23,
   "end": 1053.91,
   "text": "امام عصر عجل الله تعالی فرجه الشریف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 1053.91,
   "end": 1060.45,
   "text": "امیدواریم که بتونیم خدمات بهتر و بیشتری به قرآن و قرآن دوستان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 1060.45,
   "end": 1065.61,
   "text": "و علاقمندان به مکتب نورانی اهل بیت علیهم السلام ارائه بدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 1065.61,
   "end": 1073.05,
   "text": "به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 1073.05,
   "end": 1077.25,
   "text": "اللهم صل على محمد و آل محمد از بزرگوارانی که با کمال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 1077.25,
   "end": 1082.01,
   "text": "لطف و بزرگواری و به هر حال میزبانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 214,
   "start": 1082.01,
   "end": 1091.65,
   "text": "عالی خودشون لطف کردند و فرصت ایجاد کردند تا دوره تدبر در قرآن کریم در مسجد با عظمت و با برکت پیامبر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 215,
   "start": 1091.65,
   "end": 1095.07,
   "text": "اعظم برگزار بشه هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 216,
   "start": 1095.07,
   "end": 1098.03,
   "text": "از طرف خودم و از طرف شما تشکر می‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 217,
   "start": 1098.03,
   "end": 1102.17,
   "text": "الحمد لله سالن خوبیه، هوای خوبی داره، نور خوبی داره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 218,
   "start": 1102.17,
   "end": 1105.75,
   "text": "فضای مناسبی داره. خدا رو شکر می‌کنیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 219,
   "start": 1105.75,
   "end": 1108.93,
   "text": "و امیدواریم که انشاالله یه سری نقایص فنی هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 220,
   "start": 1108.93,
   "end": 1117.09,
   "text": "که وجود داره برطرف بشه تا بتونیم به نحو احسن در خدمت شماها باشیم و دوره انشاالله در شأن قرآن کریم برگزار بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 221,
   "start": 1117.09,
   "end": 1120.03,
   "text": "بفرمایید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 222,
   "start": 1120.03,
   "end": 1123.55,
   "text": "بله اینم عرض می‌کنم. خوب شد یادآوری فرمودید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 223,
   "start": 1123.55,
   "end": 1126.97,
   "text": "و این دوره کتاب میخواد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 224,
   "start": 1126.97,
   "end": 1129.13,
   "text": "کتاب تدبر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 225,
   "start": 1129.13,
   "end": 1132.55,
   "text": "سوره انشقاق تا سوره ناس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 226,
   "start": 1132.55,
   "end": 1135.99,
   "text": "باید تهیه بشه. من یه توضیح بدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 227,
   "start": 1135.99,
   "end": 1140.39,
   "text": "این کتاب دو نسخه داره، یه نسخه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 228,
   "start": 1140.39,
   "end": 1144.53,
   "text": "تخصصی داره، یه نسخه عمومی داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 229,
   "start": 1144.53,
   "end": 1148.49,
   "text": "نسخه تخصصی‌ش جلد گالینگور، جلد سخت داره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 230,
   "start": 1148.49,
   "end": 1151.69,
   "text": "و یه مقدار حجم بیشتری داره کتاب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 231,
   "start": 1151.69,
   "end": 1153.97,
   "text": "و نسخه عمومیش جلد شومیز داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 232,
   "start": 1153.97,
   "end": 1159.85,
   "text": "کتاب قطع رقیه. کسانی که طلبه هستید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 233,
   "start": 1159.85,
   "end": 1166.07,
   "text": "یا دانشجویان و تحصیل کرده‌های رشته‌های مرتبط الهیات و علوم قرآنی هستید،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 234,
   "start": 1166.07,
   "end": 1171.73,
   "text": "توصیه می‌کنم اون نسخه تخصصی رو تهیه بفرمایید اگر ندارید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 235,
   "start": 1171.73,
   "end": 1179.93,
   "text": "و کسانی که طلبه نیستید و در واقع در رشته‌های غیرمرتبط تحصیل می‌کنید یا تحصیل کردید،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 236,
   "start": 1179.93,
   "end": 1182.67,
   "text": "اون نسخه عمومی رو می‌تونید تهیه بکنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 237,
   "start": 1182.67,
   "end": 1192.39,
   "text": "مگر اینکه خودتون نظرتون این باشه که مطالعه‌تون تخصصی باشه یا احساس کنید مطالعه از قبل زیاد دارید در حوزه قرآن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 238,
   "start": 1192.39,
   "end": 1196.47,
   "text": "و فکر کنید که اون کتاب تخصصی براتون مناسب‌تره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 239,
   "start": 1196.47,
   "end": 1203.69,
   "text": "پس کتاب تدبر در سوره انشقاق تا ناس رو باید برای این دوره تهیه بفرمایید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 240,
   "start": 1203.69,
   "end": 1207.51,
   "text": "یا کتاب تخصصی و یا کتاب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 241,
   "start": 1207.51,
   "end": 1213.81,
   "text": "عمومی. ما انشاالله هر دو کتاب رو سعی می‌کنیم برای جلسه‌ی آینده به یه تعدادی بیاریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 242,
   "start": 1213.81,
   "end": 1217.03,
   "text": "اگر از قبل مشخص شد که چند نفر متقاضی داریم که چه بهتر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 243,
   "start": 1217.03,
   "end": 1223.71,
   "text": "اگر نه خودمون یه چند تایی بیاریم تا شماها بتونید تهیه بفرمایید و اونایی که این کتاب‌ها رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 244,
   "start": 1223.71,
   "end": 1226.09,
   "text": "ندارید حتماً لازمه تهیه کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 245,
   "start": 1226.09,
   "end": 1232.49,
   "text": "یعنی کتاب جزئی از تکالیفی که بنده خدمتتون تقدیم خواهم کرد خوندن همین کتابه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 246,
   "start": 1232.49,
   "end": 1236.57,
   "text": "کتاب باید خونده بشه بخاطر اینکه کلاس به هر حال یه ظرفیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 247,
   "start": 1236.57,
   "end": 1240.17,
   "text": "که یه بخشی از مسائل رو میشه در کلاس مطرح کرد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 248,
   "start": 1240.17,
   "end": 1244.99,
   "text": "و بخش دیگری رو باید در کتاب مطالعه بکنید و یا مباحثه داشته باشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 249,
   "start": 1244.99,
   "end": 1247.09,
   "text": "پس مسئله کتاب هم حل شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 250,
   "start": 1247.09,
   "end": 1253.43,
   "text": "مسئله آیین‌نامه انضباطی دوره رو هم بنده مطرح کردم خدمتتون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 251,
   "start": 1253.43,
   "end": 1258.23,
   "text": "و اینم بگما برای حضور در هر جلسه دو امتیازه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 252,
   "start": 1258.23,
   "end": 1261.39,
   "text": "شما به هر دلیلی نباشید این دو امتیاز حذف میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 253,
   "start": 1261.39,
   "end": 1264.83,
   "text": "خب؟ و ما دیگه بحث دیگه‌ای نداریم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 254,
   "start": 1264.83,
   "end": 1269.11,
   "text": "که اگر کسی نبود حالا مثلاً موجه هست موجه نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 255,
   "start": 1269.11,
   "end": 1272.75,
   "text": "اینا نداریم چون می‌دونید دیگه اصلا غیر قابل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 256,
   "start": 1272.75,
   "end": 1280.05,
   "text": "محاسبه‌ست. توی همچین دوره‌هایی هر جلسه دو امتیاز داره و خواهش می‌کنم از خواهران و برادران",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 257,
   "start": 1280.05,
   "end": 1283.25,
   "text": "این مسئولیتو خودتون به عهده بگیرید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 258,
   "start": 1283.25,
   "end": 1292.65,
   "text": "در ورودی جلسه انشاالله فرم‌هایی تهیه شده هرکس که میاد هر چند جلسه‌ای رو که حاضره اونجا علامت بزنه جلوی اسم خودش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 259,
   "start": 1292.65,
   "end": 1297.65,
   "text": "و در صورتی که نبود و علامت نزد ما براش علامت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 260,
   "start": 1297.65,
   "end": 1299.91,
   "text": "غیبت رو می‌زنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 261,
   "start": 1299.91,
   "end": 1303.27,
   "text": "و لطفا دوستا برای همدیگه علامت نزنن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 262,
   "start": 1303.27,
   "end": 1305.69,
   "text": "که مثلا دوست من قراره بیاد حالا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 263,
   "start": 1305.69,
   "end": 1308.65,
   "text": "نه بذارید خودش بیاد خودش علامت بزنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 264,
   "start": 1308.65,
   "end": 1315.91,
   "text": "اینجوری مناسب‌تره. اگر این انتظام و التزام رو داشته باشیم بهتر می‌تونیم به شما خدمت بکنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 265,
   "start": 1315.91,
   "end": 1319.23,
   "text": "هدف از این دوره خدمت بیشتر به شما بزرگوارانه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}