 "chapters": [
  {
   "index": 0,
   "title": "## ادامهٔ بحث مبانی تدبر",
   "start": 11.52,
   "end": 43.62
  },
  {
   "index": 1,
   "title": "## احادیث عرضه از معدود روایات متواتر",
   "start": 43.62,
   "end": 224.8
  },
  {
   "index": 2,
   "title": "و در خطبه‌ای از پیامبر صلی‌الله‌علیه‌وآله‌وسلم آمده است:",
   "start": 224.8,
   "end": 258.01
  },
  {
   "index": 3,
   "title": "اهل‌بیت علیهم‌السلام فرمودند حدیث ما را به قرآن عرضه بدارید.",
   "start": 258.01,
   "end": 550.52
  },
  {
   "index": 4,
   "title": "## زیغ قلب و پیروی از متشابه",
   "start": 550.52,
   "end": 602.82
  },
  {
   "index": 5,
   "title": "## از یک قرآن دو دین می‌توان ساخت",
   "start": 602.82,
   "end": 675.02
  },
  {
   "index": 6,
   "title": "## سایهٔ امام در عصر غیبت",
   "start": 675.02,
   "end": 734.52
  },
  {
   "index": 7,
   "title": "## نمایندهٔ امام حسین علیه‌السلام در کوفه",
   "start": 734.52,
   "end": 863.06
  },
  {
   "index": 8,
   "title": "## قرآن کتاب ولایت است، نه کتاب خطرناک",
   "start": 863.06,
   "end": 923.04
  },
  {
   "index": 9,
   "title": "## پایان مرور مبانی و آغاز سورهٔ انشقاق",
   "start": 923.04,
   "end": 944.69
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 11.52,
   "end": 14.96,
   "text": "این مسئله اینه. ببینید اصلاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 14.96,
   "end": 19.16,
   "text": "یک بحثی ما داریم تو روایات،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 19.16,
   "end": 24.52,
   "text": "احادیثی ما داریم در مجموعه احادیث اهل بیت علیهم السلام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 24.52,
   "end": 28.98,
   "text": "بهش میگن احادیث عرضه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 28.98,
   "end": 31.82,
   "text": "عرضه. عرضه یعنی چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 31.82,
   "end": 43.62,
   "text": "یعنی اونچه را که از اهل بیت برای ما نقل میشه ما مکلفیم اون را عرضه کنیم به قرآن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 43.62,
   "end": 47.14,
   "text": "احادیث عرضه جزء",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 47.14,
   "end": 52.32,
   "text": "مه-- معدود احادیث متواتر ما هستند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 52.32,
   "end": 56.4,
   "text": "فرق حدیث متواتر رو با خبر واحد میدونید دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 56.4,
   "end": 59.14,
   "text": "خبر واحد به حدیثی میگن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 59.14,
   "end": 62.42,
   "text": "که یک سند منفردی داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 62.42,
   "end": 70.04,
   "text": "میگیم فلانی از فلانی، از فلانی، از فلانی، از فلانی، از فلانی تا میرسه به امام معصوم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 70.04,
   "end": 77.42,
   "text": "به این میگن خبر واحد. یعنی یه رشته این خبر را وصل میکنه به امام معصوم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 77.42,
   "end": 81.64,
   "text": "یه رشته واحد وصلش میکنه به امام معصوم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 81.64,
   "end": 91.1,
   "text": "به این میگن خبر واحد. متواتر یعنی خبری که نه یه نفر از یه نفر، از یه نفر، از یه نفر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 91.1,
   "end": 97.74,
   "text": ". صدها نفر، از صدها نفر، از صدها نفر، از صدها نفر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 97.74,
   "end": 104.5,
   "text": "در تمام طبقات نقل این حدیث اونقدر جمعیت وجود داره که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 104.5,
   "end": 111.32,
   "text": "یقین میشود کرد که این جمعیت بر یک سخن دروغ با همدیگه جمع-- بگید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 111.32,
   "end": 113.76,
   "text": "نمیشن، توانایی نمی‌کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 113.76,
   "end": 118.6,
   "text": "یقین حاصل میشه. اینو میگن خبر متواتر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 118.6,
   "end": 122.86,
   "text": "یادم-- ممکنه حدیثی که یه رشته وصلش کرده به امام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 122.86,
   "end": 125.18,
   "text": "شما بالاخره شک کنی یه جاهایی‌ش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 125.18,
   "end": 130.94,
   "text": "اما حدیثی که یک مجموعه صدتا رشته وصلش کرده به امام،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 130.94,
   "end": 137.16,
   "text": "صد و پنجاه تا رشته وصلش کرده به امام， دیگه این حدیث قطعیه که امام گفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 137.16,
   "end": 142.0,
   "text": "ما حدیث متواتر که قطع و یقین میاره خیلی کم داریم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 142.0,
   "end": 144.56,
   "text": "خیلی کم داریم. بقیه احادیث ما خبر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 144.56,
   "end": 152.9,
   "text": "واحدن و در صورتی حجتن که کل اون مسیر درست باشه، همه عادل باشن، همه شناخته شده باشن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 152.9,
   "end": 155.18,
   "text": "میشه حدیث حجت، حدیث صحیح.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 155.18,
   "end": 160.82,
   "text": "اما مثلاً یه جایی از اون رشته قطع شده باشه میگیم حدیث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 160.82,
   "end": 165.28,
   "text": "مرسل. یه جایی از اون رشته ارتباطش به امام قطع شده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 165.28,
   "end": 171.08,
   "text": "ضعیفه. یه جایی از اون رشته آدم‌هایی هستند که اونا رو نمی‌شناسیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 171.08,
   "end": 175.6,
   "text": "حدیث تنزل پیدا میکنه یا اونا رو به بدی می‌شناسیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 175.6,
   "end": 181.28,
   "text": "حدیث ضعیف میشه. یه آدم پیدا بشه تو یه رشته‌ای که این آدم فاسق بوده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 181.28,
   "end": 184.26,
   "text": "کل اون حدیث دیگه اعتبار حجیت نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 184.26,
   "end": 192.06,
   "text": "حدیث ضعیف میشه. ما تو حدیث متواتر که دیگه اصلاً نمیشه درباره سندش هیچ بحثی کرد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 192.06,
   "end": 195.82,
   "text": "قطعیه چند تا دونه بیشتر نداریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 195.82,
   "end": 199.52,
   "text": "یکیش همین احادیث عرضه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 199.52,
   "end": 206.3,
   "text": "که اهل بیت فرمودن حرفای ما را، اونی که از ما به شما نقل می‌کنند را به قرآن عرضه کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 206.3,
   "end": 211.34,
   "text": "اگر موافق قرآن بود بگیرید، ما گفتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 211.34,
   "end": 214.8,
   "text": "اگر مخالف قرآن بود بگید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 214.8,
   "end": 217.72,
   "text": "ما نگفتیم، ما نگفتیم اونو،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 217.72,
   "end": 223.18,
   "text": "اون از ما نیست. حالا بعضی از تعابیر سنگینه که بزنید به دیوار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 223.18,
   "end": 231.14,
   "text": "میگن اصلاً از پیامبر گرامی اسلام هم نقل شده بعد از من افراد زیادی به من دروغ نسبت خواهند داد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 231.14,
   "end": 235.04,
   "text": "هرچی رو از من به شما گفتن شما باور نکن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 235.04,
   "end": 239.32,
   "text": "الان یه نفر از در وارد بشه بگه آقا حضرت آقا فرمودن فلان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 239.32,
   "end": 243.88,
   "text": "شما تحقیق نمیکنی که راست میگه، دروغ میگه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 243.88,
   "end": 252.3,
   "text": "اگه یه خبر مهمی باشه تحقیق میکنی، بررسی میکنی، کی میگه، از کجا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 252.3,
   "end": 256.08,
   "text": "اهل بیت علیهم السلام فرمودن حدیث ما را به قرآن عرضه بدارید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 256.08,
   "end": 261.56,
   "text": "من سوالم اینه اگر ما قرآن را نمی‌فهمیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 261.56,
   "end": 264.02,
   "text": "جز با خود حدیث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 264.02,
   "end": 269.84,
   "text": "چطور می‌تونیم حدیث را به قرآن عرضه کنیم بفهمیم درسته یا غلطه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 269.84,
   "end": 273.84,
   "text": "جواب بدید به این سؤال. چطور ممکنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 273.84,
   "end": 276.7,
   "text": "لذا اخباری‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 276.7,
   "end": 285.98,
   "text": "که قائل به حجیت قرآن نیستند و همیشه می‌ترسند که قرآن انحراف ایجاد بکنه، لذا اخباری‌ها به احادیث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 285.98,
   "end": 289.82,
   "text": "عرضه که میرسند میدونید چی میگن آخر این احادیث؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 289.82,
   "end": 293.72,
   "text": "با اینکه اخباری‌ها حدیث ضعیف رو می‌گیرن بعضی وقت‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 293.72,
   "end": 297.46,
   "text": "اما به این حدیث متواتر که رسیدن میدونید چی میگن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 297.46,
   "end": 300.6,
   "text": "میگن که علمش را به اهلش وا می‌گذاریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 300.6,
   "end": 307.12,
   "text": "ما نمی‌فهمیم یعنی چی. آه این چی شد آخه عزیزم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 307.12,
   "end": 310.02,
   "text": "شما میگی من اخباری‌ام. اینم که اهل بیت خودشون گفتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 310.02,
   "end": 315.32,
   "text": "اینم خبره، اونم متواتر، خبر واحد هم نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 315.32,
   "end": 317.7,
   "text": "خبر متواتر قطعی و یقینیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 317.7,
   "end": 319.7,
   "text": "میگه علمش رو بگو-- میسپاریم به اهلش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 319.7,
   "end": 325.12,
   "text": "ما نمی‌فهمیم. ما نفهمیدیم چی شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 325.12,
   "end": 328.48,
   "text": "یعنی هر طور شده قرآن از گردونه معرفت باید بره بیرون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 328.48,
   "end": 333.32,
   "text": "آخه چرا؟ چرا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 333.32,
   "end": 337.0,
   "text": "اگر قرار بود ما فقط،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 337.0,
   "end": 345.04,
   "text": "فقط با روایت به قرآن راه پیدا کنیم و راه دیگری خود قرآن قابل فهم نباشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 345.04,
   "end": 352.62,
   "text": "پس اصلاً دیگه نیازی نبود مردم را به قرآن بگید ارجاع بدن و دعوت کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 352.62,
   "end": 360.08,
   "text": "همین از اول پیغمبر خدا می‌فرمود آی مردم من بین شما اهل بیتم رو گذاشتم برید سراغ اونا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 360.08,
   "end": 368.22,
   "text": "میگم نمی‌کنن دیگه نمی‌پذیرن دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 368.22,
   "end": 370.34,
   "text": "میگن یعنی ما نمی‌فهمیم هیچ‌کس نمی‌فهمه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 370.34,
   "end": 372.12,
   "text": "اونا خودشون اهل‌شن دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 372.12,
   "end": 375.72,
   "text": "اهلش یعنی اینکه انشاالله امام زمان ظهور کند بگه یعنی چی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 375.72,
   "end": 378.28,
   "text": "یعنی این. یعنی ماها که نفهمیدیم چی شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 378.28,
   "end": 382.02,
   "text": "انشاالله امام زمان علیه‌السلام ظهور کند و بفرماید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 382.02,
   "end": 384.64,
   "text": "ببینید این مسئله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 384.64,
   "end": 387.18,
   "text": "تبدیل به یه چالش شده امروز.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 387.18,
   "end": 392.42,
   "text": "یه چالش. آقا ما قرآن رو می‌فهمیم یا نمی‌فهمیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 392.42,
   "end": 398.6,
   "text": "قرآن کتابی‌ست پر از آیات روشن و قابل فهم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 398.6,
   "end": 401.06,
   "text": "همه قرآن روشن و قابل فهمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 401.06,
   "end": 410.2,
   "text": "اما قرآن، خود قرآن می‌فرماید \"منهُ آياتٌ محكماتٌ هُنَّ أمُّ الكتابِ وآخرُ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 410.2,
   "end": 413.82,
   "text": "متشابهات\". یه سری آیات هم تو قرآن متشابه‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 413.82,
   "end": 416.12,
   "text": "متشابه یعنی نمی‌فهمیم؟ نه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 416.12,
   "end": 423.4,
   "text": "معنیش این نیست که نمی‌فهمیم. یعنی وقتی می‌خوای پیاده‌اش کنی کلی راجع بهش سؤال هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 423.4,
   "end": 426.94,
   "text": "یه من آیه‌ای رو میگم حالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 426.94,
   "end": 429.91,
   "text": "عذر می‌خوام بذارید این آیه رو به این شکل بگم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 429.91,
   "end": 435.98,
   "text": "\"السارق و السارقة فاقطعوا أيديهما\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 435.98,
   "end": 439.36,
   "text": "مرد دزد و زن دزد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 439.36,
   "end": 442.5,
   "text": "دستشونو قطع کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 442.5,
   "end": 446.78,
   "text": "حالا من می‌خوام به این آیه عمل کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 446.78,
   "end": 451.42,
   "text": "من بابام بچه‌م دزدی کرده می‌خوام دستشو قطع کنم، می‌تونم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 451.42,
   "end": 455.12,
   "text": "سؤال. چرا میگی نه، از کجا می‌دونی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 455.12,
   "end": 458.46,
   "text": "مادر می‌تونه دست بچه‌شو برای دزدی قطع کنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 458.46,
   "end": 460.98,
   "text": "پدر می‌تونه دست بچه‌ش رو برای دزدی قطع کنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 460.98,
   "end": 464.28,
   "text": "یا فقط کار حاکمه؟ این یه سؤال.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 464.28,
   "end": 467.54,
   "text": "حالا می‌خواد قطع کنه. از کجا قطع کنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 467.54,
   "end": 469.48,
   "text": "سر انگشتاشو بزنم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 469.48,
   "end": 474.7,
   "text": "بند اول، بند دوم، کل چهار تا انگشت، دست از مچ،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 474.7,
   "end": 476.96,
   "text": "از ساعد، از آرنج،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 476.96,
   "end": 479.84,
   "text": "از بازو، کل کتفو بزن بنداز پایین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 479.84,
   "end": 484.42,
   "text": "از کجا؟ چه دزدی حالا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 484.42,
   "end": 487.5,
   "text": "چجور دزدی؟ چقدر دزدی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 487.5,
   "end": 489.78,
   "text": "طرف گشنه‌اش بوده یه نون کش رفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 489.78,
   "end": 495.7,
   "text": "بگیریم دستشو قطع کنیم یا نه؟ طرف طمع کرده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 495.7,
   "end": 500.24,
   "text": "صندوق ذخیره ارزی یه کشورو خالی کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 500.24,
   "end": 504.52,
   "text": "اینو چی کار کنیم؟ .",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 504.52,
   "end": 507.9,
   "text": "آها همین آقا میگه دست که سهل است دستشو بذاریم بدنشو قطع کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 507.9,
   "end": 511.96,
   "text": "چطوره؟ اینو باید بدنشو قطع کنیم از دستش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 511.96,
   "end": 519.22,
   "text": "ما می‌خوایم بگیم آقا جون وقتی پای اجرا می‌رسد کل این یه مسئله‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 519.22,
   "end": 524.14,
   "text": "مخاطب \"السارق و السارقة فاقطعوا أيديهما\" کیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 524.14,
   "end": 527.74,
   "text": "کدوم دزد؟ قطع دست از کجا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 527.74,
   "end": 531.4,
   "text": "با چی؟ انقدر با این حلبی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 531.4,
   "end": 536.18,
   "text": "این داعشی علیه اللعنه زد رو دست بدبخت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 536.18,
   "end": 540.82,
   "text": "انقدر زد با زجر و شکنجه دستشو از اینجا قطع کرد گرفت دستش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 540.82,
   "end": 546.42,
   "text": "الله اکبر. الله بزند به کمرت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 546.42,
   "end": 550.52,
   "text": "از کجا اینجوری تفسیر کردی تو قرآنو؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 550.52,
   "end": 555.52,
   "text": "می‌فرماید \"وآخرُ متشابهات\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 555.52,
   "end": 560.02,
   "text": "\"فأما الذين في قلوبهم زيغ\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 560.02,
   "end": 563.16,
   "text": "اینایی که مرض دارن، انحراف دارن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 563.16,
   "end": 568.04,
   "text": "تو قلبشون \"فيتبعون ما تشابه منه\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 568.04,
   "end": 573.3,
   "text": "همین دو پهلوهای قرآنو می‌گیرن، همین مسائل تفسیر بردار قرآنو می‌گیرن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 573.3,
   "end": 575.19,
   "text": "تبعیت می‌کنند. چجوری؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 575.19,
   "end": 580.58,
   "text": "\"ابتغاء الفتنة وابتغاء تأويله\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 580.58,
   "end": 582.14,
   "text": "فتنه جویی می‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 582.14,
   "end": 585.52,
   "text": "امت مسلمان را از مسیر امامش جدا می‌کنند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 585.52,
   "end": 587.7,
   "text": "و بعد تأویلشو دنبال می‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 587.7,
   "end": 592.0,
   "text": "یعنی چه تأویل؟ تأویل یعنی همون خروجی مصداقی بیرونی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 592.0,
   "end": 597.08,
   "text": "یعنی می‌خوان یک تحققی به اون مسئله بدهند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 597.08,
   "end": 600.26,
   "text": "غیر از تحققی که مدنظر کیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 600.26,
   "end": 602.82,
   "text": "بگید. خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 602.82,
   "end": 606.64,
   "text": "از همین قرآن می‌شود در خارج",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 606.64,
   "end": 612.46,
   "text": "یه دینی ساخت که هرکس ببیند حالش به هم بخوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 612.46,
   "end": 615.86,
   "text": "مثل دین داعشی‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 615.86,
   "end": 621.78,
   "text": "مثل دین طالبان. مثل دین سلفی‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 621.78,
   "end": 626.08,
   "text": "مثل دین این آل سعود خبیث.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 626.08,
   "end": 629.56,
   "text": "که قرآن بخونه اما از اون طرف بیاد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 629.56,
   "end": 633.18,
   "text": "مردم مظلوم و بی‌پناه یمن رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 633.18,
   "end": 635.0,
   "text": "بکشه به اون وضع.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 635.0,
   "end": 639.54,
   "text": "این همه مدت، این همه ماه و سال رو سرشون بم بریزه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 639.54,
   "end": 644.16,
   "text": "غذا نذاره به اینا برسه، دارو نذاره به اینا برسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 644.16,
   "end": 646.08,
   "text": "به نام اسلام، به نام قرآن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 646.08,
   "end": 651.66,
   "text": "از همین قرآن هم میشه دینی را محقق کرد که زیباترین،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 651.66,
   "end": 655.32,
   "text": "عادلانه‌ترین، حکیمانه‌ترین،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 655.32,
   "end": 659.34,
   "text": "عالی‌ترین، مترقی‌ترین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 659.34,
   "end": 663.66,
   "text": "دین قابل تصور برای بشریته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 663.66,
   "end": 667.78,
   "text": "این دین را کی می‌تونه از قرآن محقق بکنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 667.78,
   "end": 671.7,
   "text": "معصوم. پیغمبر اکرم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 671.7,
   "end": 675.02,
   "text": "امام معصوم جانشین او.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 675.02,
   "end": 677.8,
   "text": "اگر رسیدیم به دوران غیبت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 677.8,
   "end": 684.56,
   "text": "محرومیم. اما می‌تونیم سایه‌اش را، پرتویش را از پشت ابر،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 684.56,
   "end": 688.54,
   "text": "از پشت ابر می‌تونیم پرتویش را داشته باشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 688.54,
   "end": 694.16,
   "text": "از زبان کی؟ فقیه جامع الشرایتی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 694.16,
   "end": 698.86,
   "text": "فقیه جامع الشرایتی که علمش عالی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 698.86,
   "end": 702.44,
   "text": "تقوایش عالی، درایتش عالی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 702.44,
   "end": 708.38,
   "text": "شجاعتش عالی، هوای نفسش مهار شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 708.38,
   "end": 714.22,
   "text": "یه فقیه اینجوری را بگیم شما به ما بگو اگر امام زمان بود چه می‌کرد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 714.22,
   "end": 721.46,
   "text": "اونم برمی‌گرده میگه من که به قطع یقین نمی‌دونم ولی به حسب قواعد، به حسب آیات و روایات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 721.46,
   "end": 728.52,
   "text": "این. و ما حرف او را گوش میدیم تا وقتی که امام زمانمون تشریف بیارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 728.52,
   "end": 731.56,
   "text": "و این کارم فقط مخصوص دوران غیبت نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 731.56,
   "end": 734.52,
   "text": "در دوران حضور معصوم هم این اتفاق افتاده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 734.52,
   "end": 742.26,
   "text": "مگر ابا عبدالله الحسین علیه السلام می‌خواست از مکه بیاد به سمت کوفه مگر نماینده نفرستاد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 742.26,
   "end": 745.94,
   "text": "مگه نماینده حضرت معصوم بود؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 745.94,
   "end": 754.08,
   "text": "حالا این کسانی که از نماینده حضرت تبعیت نکردند و بیعت‌شون را با نماینده اون حضرت شکستند،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 754.08,
   "end": 758.16,
   "text": "به چه حجتی؟ به این حجت که گفتن آقا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 758.16,
   "end": 761.44,
   "text": "الان دیگه جان در خطره، امنیت در خطره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 761.44,
   "end": 763.78,
   "text": "اینم که معصوم نیست شاید داره اشتباه میکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 763.78,
   "end": 766.24,
   "text": "حالا فردا ما رو میده به کشتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 766.24,
   "end": 770.08,
   "text": "پس فعلاً بشینیم تو خونه‌هامون تا خود آقا بگید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 770.08,
   "end": 773.36,
   "text": "تشریف بیارن. نشستن تو خونه‌هاشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 773.36,
   "end": 779.56,
   "text": "نماینده امام را گرفتند سر او را بر آیه دار العماره جلوی چشم مسلمونا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 779.56,
   "end": 783.6,
   "text": "بعد از اینکه هجده هزار نفر باش بیعت کرده بودند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 783.6,
   "end": 786.38,
   "text": "تنها سر او را از بدن جدا کردند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 786.38,
   "end": 793.96,
   "text": "گفتند وصیتت. گفت فقط می‌خوام بگم به حسین بگویید مسلم می‌گوید نیا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 793.96,
   "end": 798.1,
   "text": "چه شد؟ همین مردمی که شیعه هم بودند،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 798.1,
   "end": 803.14,
   "text": "منتظر امام معصوم نشستند و ولی او را و نائب او را تنها گذاشتند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 803.14,
   "end": 809.36,
   "text": "همین مردم دیدند امام آمد به کوفه ولی رو نیزه‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 809.36,
   "end": 813.6,
   "text": ". تا به خودشون بیان سر امام رو تو کوچه‌ها دیدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 813.6,
   "end": 818.1,
   "text": "حالا بگیم چرا .",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 818.1,
   "end": 821.78,
   "text": "چون اینا نتونستن بفهمن که بابا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 821.78,
   "end": 824.56,
   "text": "مسئله پیروی از امام معصوم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 824.56,
   "end": 828.54,
   "text": "مسئله پیروی از امام معصوم تعطیل بردار نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 828.54,
   "end": 832.38,
   "text": "حالا امام معصوم یه وقت خودش مستقیماً دستت بهش می‌رسه، یه وقت غیرمستقیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 832.38,
   "end": 836.32,
   "text": "ولی باید او اسلام را پیاده کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 836.32,
   "end": 839.74,
   "text": "الان دوران غیبت هم همینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 839.74,
   "end": 846.06,
   "text": "اگر ما میریم دنبال ولی فقیه چون می‌خوایم امام ما اسلام را پیاده کند .",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 846.06,
   "end": 853.34,
   "text": "نمی‌خوایم خوانش‌های غلط و قرائت‌های غلط از اسلام بیاد در واقع",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 853.34,
   "end": 855.38,
   "text": "با تفسیر به رأی و با",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 855.38,
   "end": 863.03,
   "text": "کج اندیشی درباره وحی الهی بیاد یک نگاه غلط رو تو جامعه جا بندازه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 863.03,
   "end": 864.74,
   "text": ". حالا بین اون و این موندیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 864.74,
   "end": 868.02,
   "text": "یعنی یا باید کلاً بعضیا اینجوری فکر می‌کنند یا باید قرآن رو ببندیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 868.02,
   "end": 873.6,
   "text": "قرآن نعوذ بالله کتاب خطرناکیه نه قرآن کتاب خطرناکی نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 873.6,
   "end": 875.42,
   "text": "قرآن کتاب ولایته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 875.42,
   "end": 881.96,
   "text": "اگر کسی با قرآن همراه باشه قطعاً امام باقر میگه ها من نمیگم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 881.96,
   "end": 890.92,
   "text": "امام باقر علیه السلام می‌فرماید اگر شیعیان ما در قرآن تدبر کرده بودند در فضیلت ما شک نمی‌کردند،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 890.92,
   "end": 893.78,
   "text": "در برتری ما شک نمی‌کردند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 893.78,
   "end": 899.4,
   "text": ". مسئله اینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 899.4,
   "end": 904.88,
   "text": "تدبر در قرآن. قرآن عهد بین امام و امته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 904.88,
   "end": 912.1,
   "text": "جدی بگیریم قرآن را. فکر نکنیم قرآن نعوذ بالله یک کتاب ظالمه‌ایه که باید ازش ترسید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 912.1,
   "end": 913.86,
   "text": "بله باید از نفس ترسید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 913.86,
   "end": 916.52,
   "text": "باید از تفسیر به رأی ترسید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 916.52,
   "end": 918.36,
   "text": "اما قرآن کتاب هدایته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 918.36,
   "end": 923.04,
   "text": "کتاب نجاته برای کسی که در این کتاب تدبر بکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 923.04,
   "end": 929.2,
   "text": "خیلی خب. مطالب در تمام سرفصل‌هایی که گفتم مطالب نیمه تمام‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 929.2,
   "end": 937.5,
   "text": "یعنی این سرفصل‌ها فقط یک مرور کلی بر مبانی تدبر و نگاه تدبری به قرآن کریمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 937.5,
   "end": 944.69,
   "text": "از اینجا به بعد می‌خوایم وقتمون رو اختصاص بدیم و ان شاءالله سوره انشقاق رو شروع بکنیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}