   "start": 10.28,
   "end": 104.26
  },
  {
   "index": 1,
   "title": "## پیچیدگی نفس: وجدان‌درد را با گناه بزرگ‌تر درمان کردن",
   "start": 104.26,
   "end": 185.04
  },
  {
   "index": 2,
   "title": "## دین آمده انسان را رشد بدهد، نه جایگزین وجدان شود",
   "start": 185.04,
   "end": 250.0
  },
  {
   "index": 3,
   "title": "## مغالطهٔ «دینِ انسانیت»",
   "start": 250.0,
   "end": 270.08
  },
  {
   "index": 4,
   "title": "## وقتی می‌گوید «روی من اثر نمی‌کند»",
   "start": 270.08,
   "end": 513.54
  },
  {
   "index": 5,
   "title": "## مثال قصاب: عادت، دل را سفت می‌کند",
   "start": 513.54,
   "end": 559.98
  },
  {
   "index": 6,
   "title": "## سیاق دوم شمس: انسان‌ها در گرو انتخابشان",
   "start": 559.98,
   "end": 679.86
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 10.28,
   "end": 14.78,
   "text": "اونجا تعبیر ید السهو في التراب داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 14.78,
   "end": 17.6,
   "text": "ید السهو دس، یدس،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 17.6,
   "end": 21.56,
   "text": "دسن یعنی دفن کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 21.56,
   "end": 26.6,
   "text": "یه چیزی را زیر خاک پنهان کردن، دفن کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 26.6,
   "end": 30.08,
   "text": "دست نفس یعنی اینکه این نفس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 30.08,
   "end": 37.82,
   "text": "ملهمه را گویا تشبیه کرده به آینه‌ای که هر بار شما به اون بی‌اعتنایی می‌کنی غبار می‌گیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 37.82,
   "end": 41.5,
   "text": "غبار گناه می‌شینه رو این آینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 41.5,
   "end": 47.24,
   "text": "تکرار این گناه، تکرار غباره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 47.24,
   "end": 53.3,
   "text": "این غبار وقتی متراکم می‌شه مثل خاکی که رو این آینه رو چی کار کرده کامل؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 53.3,
   "end": 57.38,
   "text": "پوشونده. آینه، آینه‌ست ولی دیگه چیزی رو نشون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 57.38,
   "end": 62.3,
   "text": "نمی‌ده. تا پاکش نکنی نشون نمی‌ده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 62.3,
   "end": 64.2,
   "text": "نفس هم همین‌طوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 64.2,
   "end": 70.78,
   "text": "گناه‌هایی که انسان انجام می‌ده بر خلاف نفسش، یعنی اون پا گذاشتن رو وجدان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 70.78,
   "end": 74.94,
   "text": "که انسان تکرار می‌کنه پا گذاشتن رو وجدان رو،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 74.94,
   "end": 78.14,
   "text": "این مثل غبار می‌نشینه رو آینه‌ی نفس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 78.14,
   "end": 80.83,
   "text": "و نفس به تدریج دفن می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 80.83,
   "end": 89.58,
   "text": "این می‌شه دست نفس. نقطه‌ی مقابلش تزکیه‌ی نفسه، زکاها یعنی اینکه دستمال وردار آینه رو چی‌کار کنی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 89.58,
   "end": 95.76,
   "text": "پاکش کنی. مثل اینکه اگر گناه کردی، اگر خلاف وجدانت کار کردی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 95.76,
   "end": 98.08,
   "text": "جبرانش کنی. گناه رو،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 98.08,
   "end": 101.44,
   "text": "اون خطای خلاف وجدان را توبه کنی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 101.44,
   "end": 106.48,
   "text": "جبران کنی. انسان موجود عجیبیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 106.48,
   "end": 117.04,
   "text": "وقتی اشتباه می‌کنه یه وقتایی برای اینکه وجدان‌درد خود را درمان کنه دوباره اشتباه می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 117.04,
   "end": 120.72,
   "text": "یعنی این یک پیچیدگیه در نفس انسانه ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 120.72,
   "end": 127.82,
   "text": "یعنی با تکرار اشتباه می‌خواد به خودش بگه این اشتباه نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 127.82,
   "end": 136.74,
   "text": "فرض کنید آمده یه حرفی رو، نامربوطی رو زده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 136.74,
   "end": 141.0,
   "text": "بعد خودش متوجه شده، وجدانش داره بهش میگه آخه چرا این حرف رو زدی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 141.0,
   "end": 145.08,
   "text": "میگه بازم میگم. یه دونه گنده‌ترشو میگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 145.08,
   "end": 147.68,
   "text": "آقا، خانم، بابا کوتاه بیا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 147.68,
   "end": 150.9,
   "text": "نخیر از اینم، یکی بدترشو میگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 150.9,
   "end": 156.7,
   "text": "نفس پیچیده‌ست. یعنی وجدان‌درد هم می‌خواد با بدتر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 156.7,
   "end": 159.64,
   "text": "خلاف وجدان عمل کردن درمان کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 159.64,
   "end": 165.4,
   "text": "در حالی که فرمول اینه آقا تا نفست داره آلارم میده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 165.4,
   "end": 169.68,
   "text": "وقتی این نفس ملهمه داره آلارم میده میگه اشتباس،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 169.68,
   "end": 171.86,
   "text": "خطاس، نرو،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 171.86,
   "end": 176.52,
   "text": "نگو، همونجا قبول کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 176.52,
   "end": 179.56,
   "text": "همونجا قبول کن. برگرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 179.56,
   "end": 185.04,
   "text": "این سرمایه‌ی توئه. سرمایه‌تو باید محترم بشمری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 185.04,
   "end": 192.88,
   "text": "اساسا دین آمده تا انسان رو رشد بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 192.88,
   "end": 197.0,
   "text": "دین آمده تا انسان رو حرکت بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 197.0,
   "end": 200.4,
   "text": "ما خیلی از بار،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 200.4,
   "end": 205.28,
   "text": "باری را که باید نفس ما به دوش می‌کشیده می‌ندازیم رو دوش کی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 205.28,
   "end": 211.96,
   "text": "دین. یعنی کارکرد دین تازه می‌خواد برای ما بشه جایگزین چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 211.96,
   "end": 214.72,
   "text": "بگید نفس خودمون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 214.72,
   "end": 219.2,
   "text": "بعد عملا در جا می‌زنیم خیلی وقت‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 219.2,
   "end": 224.94,
   "text": "یعنی از دین به جای اینکه استفاده کنیم برای ترقی، تعالی، تکامل،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 224.94,
   "end": 227.76,
   "text": "گویا کارکرد دین اینه که ما فقط",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 227.76,
   "end": 230.14,
   "text": "کارهای غیرانسانی نکنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 230.14,
   "end": 235.9,
   "text": "بابا کار غیرانسانی نکردن که این به انسان بودنه‌ته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 235.9,
   "end": 241.96,
   "text": "خب آدم باشیم دیگه. همون نفس درونی خودمون رو محترم بشماریم می‌شیم آدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 241.96,
   "end": 245.28,
   "text": "آدم که شدیم تازه خوراک خوبی هستیم برای کی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 245.28,
   "end": 250.0,
   "text": "دین. تازه به درد این می‌خوریم که شاگرد دین بشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 250.0,
   "end": 255.08,
   "text": "که امروزه متاسفانه با یه مغالطه‌ای به جامعه‌ی ما القا می‌شه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 255.08,
   "end": 259.02,
   "text": "دین انسانیت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 259.02,
   "end": 262.04,
   "text": "دینی به نام انسانیت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 262.04,
   "end": 266.48,
   "text": "که حالا کسانی که این مغالطه رو القا می‌کنند به جامعه حرفشون اینه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 266.48,
   "end": 270.08,
   "text": "می‌خوان بگن انسان بودن دین،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 270.08,
   "end": 273.74,
   "text": "بگید نمی‌خواهد، پس دین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 273.74,
   "end": 276.64,
   "text": "نمی‌خواهیم. پس دین لازم نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 276.64,
   "end": 279.88,
   "text": "ما می‌خوایم با دین چی باشیم؟ انسان باشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 279.88,
   "end": 282.52,
   "text": "انسان بودن هم که دین نمی‌خواد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 282.52,
   "end": 288.44,
   "text": "آدم می‌تونه انسان باشه. ما خیلی‌ها رو در زمین می‌شناسیم که دین ندارن ولی انسان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 288.44,
   "end": 291.9,
   "text": "هستن. یعنی وجدان‌شون محترمه برای خودشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 291.9,
   "end": 295.6,
   "text": "به وجدان خودشون اقلا احترام می‌گذارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 295.6,
   "end": 298.36,
   "text": "به اون نفس خودش احترام می‌گذاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 298.36,
   "end": 302.3,
   "text": "حتی من دیدم مستندی تهیه کرده بودن رفته بودن در یک کشوری،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 302.3,
   "end": 306.98,
   "text": "کسی که دینی نداشت ولی خب خیلی از چیزای انسانی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 306.98,
   "end": 310.88,
   "text": "راست‌گویی، انصاف، مروت، مهربانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 310.88,
   "end": 313.6,
   "text": "حتی حیا، عفاف،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 313.6,
   "end": 317.36,
   "text": "خودش، خانواده‌ش. ما آدمیم بالاخره آدم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 317.36,
   "end": 319.52,
   "text": "وجدان آدم میگه عفت باید داشته باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 319.52,
   "end": 322.16,
   "text": "وجدان آدم میگه حیا باید داشته باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 322.16,
   "end": 324.36,
   "text": "وجدان آدم میگه غیرت باید داشته باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 324.36,
   "end": 328.62,
   "text": "اینا همه درونیه دیگه. خب، چه نتیجه‌ای می‌خوایم بگیریم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 328.62,
   "end": 332.5,
   "text": "اگه نتیجه بگیریم که پس حالا دیگه ما احتیاجی به دین نداریم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 332.5,
   "end": 338.42,
   "text": "این خطاست. این مثل این می‌مونه که شما کارکرد دین را یه کارکرد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 338.42,
   "end": 343.62,
   "text": "حداقلی تصور می‌کنی و اونم کارکرد رسول باطن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 343.62,
   "end": 346.24,
   "text": "کارکرد دین، رسول باطن نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 346.24,
   "end": 350.2,
   "text": "درسته یکی از فواید دین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 350.2,
   "end": 356.92,
   "text": "احیا و کمک به رسول باطنیه، برگردوندن انسان به انسانیتشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 356.92,
   "end": 361.38,
   "text": "درسته یکیش اینه ولی اصلش بعد این شروع می‌شه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 361.38,
   "end": 365.48,
   "text": "اصلش بعد این شروع می‌شه و اون حرکت دادن انسان،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 365.48,
   "end": 369.54,
   "text": "پیش بردن انسان، به کمال رسوندن انسانه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 369.54,
   "end": 374.16,
   "text": "و اونا چیزایی‌ست که باید کسب کرده، اونا با دین کسب می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 374.16,
   "end": 383.9,
   "text": "ولی دین وقتی رو یک سیستم عامل وجود انسان نصب می‌شه که این سیستم عامل یه سری ویروس‌ها رو خودش دفع کرده باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 383.9,
   "end": 389.48,
   "text": "رسول باطنی کار کنه، رسول ظاهری میاد اونم ادامه راه می‌بره انسان رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 389.48,
   "end": 392.28,
   "text": "طبق قاعده حرکت می‌ده انسان رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 392.28,
   "end": 396.48,
   "text": "لذا اگه وجدان کار نکنه هیچ پیغمبر و امامی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 396.48,
   "end": 399.36,
   "text": "حریف نفس انسان نمی‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 399.36,
   "end": 401.61,
   "text": "این انسان به هیچ صورتی مستقیم نمی‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 401.61,
   "end": 405.53,
   "text": "بله اینا حالت‌هایی رو که باید ایجاد می‌کرده ایجاد کرده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 405.53,
   "end": 407.58,
   "text": ". دیگه رسیده به یه نقطه‌ای که بی‌اثره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 407.58,
   "end": 409.6,
   "text": "راست می‌گه، دروغ نمی‌گه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 409.6,
   "end": 412.58,
   "text": "همین جوری شده که می‌گه. ولی نشانه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 412.58,
   "end": 418.34,
   "text": "سلامتی‌ش نیست. این مثل کسیه که سیگار روش اثر نمی‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 418.34,
   "end": 420.44,
   "text": "ما نمی‌خوایم بگیم موسیقی مطلقا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 420.44,
   "end": 424.26,
   "text": "ولی بالاخره اونی که افتاده به دام موسیقی مبتذل،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 424.26,
   "end": 428.16,
   "text": "افتاده به دام نمی‌دونم فیلم‌های مستهجن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 428.16,
   "end": 429.8,
   "text": "و می‌گه آقا رو من اثر نمی‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 429.8,
   "end": 434.36,
   "text": "خب این دیگه اثراتشو کرده تو رو به اندازه‌ای که باید تنزل می‌داده تنزل داده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 434.36,
   "end": 437.38,
   "text": "الان دیگه تو افتادی در یک مستوی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 437.38,
   "end": 442.48,
   "text": "تو این مسئله در یک مستوی نازل‌تر از انسان قرار گرفتی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 442.48,
   "end": 445.96,
   "text": "حالا دلت خوشه که چیزیم نمی‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 445.96,
   "end": 448.72,
   "text": "نه خب ما می‌گیم نماز می‌خونیم، نمازمون جا هست. باشه اون در جای خودش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 448.72,
   "end": 453.92,
   "text": "نمازش ببینید- موسیقی هم- من که نمی‌خوام الان جوون‌ها رو قضاوت کنم که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 453.92,
   "end": 458.08,
   "text": "من نمی‌خوام بگم اون بهشت میره کجا میره، نمی‌دونم از ما بالاتر هستن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 458.08,
   "end": 466.22,
   "text": "اصلاً بحث اینا نیست. صحبت سر اینه که وقتی او می‌گه برای من اثری ندارد، من می‌گم آره راست می‌گه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 466.22,
   "end": 468.94,
   "text": "ولی نه که از روز اول نداشته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 468.94,
   "end": 472.68,
   "text": "اثراتشو گذاشته هی بی‌اعتنایی کردی ساکتش کردی دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 472.68,
   "end": 478.1,
   "text": "دیگه الان دادی نمی‌زنه. مثل ششی که دیگه سرفه نمی‌کنه در مقابل سیگار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 478.1,
   "end": 483.3,
   "text": "آیا اون کسی که هرچی سیگار می‌کشه سرفه نمی‌کنه می‌تونه بگه برای من دیگه اثر نداره؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 483.3,
   "end": 485.44,
   "text": "بابا این رد کردی تو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 485.44,
   "end": 490.08,
   "text": "تو اون خط قرمز رو رد کردی داری میری صاف.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 490.08,
   "end": 495.6,
   "text": "اگر می‌خوای بدونی که این ضررش چقدره، کجاست، یه مدت باید پاکسازی بشی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 495.6,
   "end": 498.1,
   "text": "یه مدت باید برگردی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 498.1,
   "end": 499.96,
   "text": "با عقلت باید راهو برگردی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 499.96,
   "end": 502.42,
   "text": "چاره‌ای جز این نیست و این توبه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 502.42,
   "end": 508.16,
   "text": "توبه برگشتنه. لذا همه جا برای همه کس نمی‌شه این معیار رو آورد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 508.16,
   "end": 511.1,
   "text": "لذا میگم اگر تا وجدان یک نفر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 511.1,
   "end": 514.92,
   "text": "تو یه زمینه‌ای‌ها... قصاب‌ها،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 514.92,
   "end": 517.16,
   "text": "قصاب‌ها الان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 517.16,
   "end": 521.46,
   "text": "خیلی از جمع افرادی که اینجا هستن من قول میدم یه مرغ نتونن سر ببرن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 521.46,
   "end": 526.58,
   "text": "یه مرغ. می‌تونید سر ببرید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 526.58,
   "end": 530.42,
   "text": "خیلی‌ها میگن نه دیگه. حالا البته بعضیا هم شاید بگن بله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 530.42,
   "end": 534.28,
   "text": "اما قصاب می‌بینی گاوه به اون گندگی رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 534.28,
   "end": 537.28,
   "text": "می‌زنه کله‌شو. عین خیالش هم نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 537.28,
   "end": 540.6,
   "text": "عادت کرده دیگه. ولو حرامم نیست ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 540.6,
   "end": 543.5,
   "text": "عادت کرده یعنی دیگه برای او سخت نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 543.5,
   "end": 545.54,
   "text": "یکی از شغل‌های مکروه همینه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 545.54,
   "end": 550.1,
   "text": "همین سر بریدن حیووناست که یه جورایی دیگه انسان رو،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 550.1,
   "end": 554.7,
   "text": "دل آدمو سفت می‌کنه. رحم آدمو یه کمی تحت تاثیر قرار می‌ده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 554.7,
   "end": 556.86,
   "text": "بله مقدمه کاملاً درسته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 556.86,
   "end": 567.1,
   "text": "مقدمه فرمایششون اینه که به هر حال سیاق دوم سوره شمس مشخص می‌کنه انسان‌ها در گرو انتخابشون هستن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 567.1,
   "end": 573.68,
   "text": "اگر یه مردمی آمدن یک نفر رو به نمایندگی خودشون انتخاب کردن، حالا چه به عنوان وکیل، چه به عنوان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 573.68,
   "end": 577.3,
   "text": "نمی‌دونم رئیس یا هر عنوان دیگری،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 577.3,
   "end": 583.68,
   "text": "خب اینا همه در اعمال او، در رفتار او، در اقدامات او شریک‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 583.68,
   "end": 586.38,
   "text": "به خصوص وقتی این شراکت معنا داره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 586.38,
   "end": 589.14,
   "text": "که اون گفته می‌خواد چی کار کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 589.14,
   "end": 593.2,
   "text": "خیلی روشن آمده گفته آقا من می‌خوام این کارو انجام بدم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 593.2,
   "end": 601.74,
   "text": "و بعد ما گفتیم آره تو بیا. پس اون در راستای این چیزی که ما به خاطرش رای دادیم و اون ادعاشو کرده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 601.74,
   "end": 604.7,
   "text": "هر کار که او می‌کنه برای ما هم هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 604.7,
   "end": 608.62,
   "text": "ما هم اون کارو کردیم. هر چند راه توبه هست ها همیشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 608.62,
   "end": 613.56,
   "text": "ولی خب تا وقتی توبه نکردیم به پای ما هم هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 613.56,
   "end": 617.58,
   "text": "اما یه وقتم هست ممکنه فریب داده باشن کسانی رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 617.58,
   "end": 620.0,
   "text": "اون دیگه قصه‌ی دیگریه. آقا من فریب خوردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 620.0,
   "end": 625.28,
   "text": "خب باید برم حواسمو جمع کنم، بصیرتمو زیاد کنم که دیگه فریب نخورم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 625.28,
   "end": 629.62,
   "text": "اما آیا نتیجه بگیریم که پس کلاً نباید کسی رو انتخاب کرد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 629.62,
   "end": 636.04,
   "text": "نه. باید وقتی می‌خوایم انتخاب بکنیم مسئولانه این کار رو انجام بدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 636.04,
   "end": 640.16,
   "text": "نگاه نکنیم به اینکه خب حالا ما یه نفریو انتخاب می‌کنیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 640.16,
   "end": 642.66,
   "text": "میره دیگه. دیگه بعد به ما چه مربوطه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 642.66,
   "end": 646.24,
   "text": "نه خیر. وقتی شما انتخابش کردی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 646.24,
   "end": 648.64,
   "text": "هر کار او می‌کنه تو داری می‌کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 648.64,
   "end": 651.28,
   "text": "پس حواست باشه کیو داری انتخاب می‌کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 651.28,
   "end": 656.22,
   "text": "کسیو انتخاب کن که راضی هستی به کارش،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 656.22,
   "end": 659.6,
   "text": "کاری که او می‌خواد انجام بده، به شعارش، به هدفش،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 659.6,
   "end": 663.44,
   "text": "به مبانی‌ش، به آرمان‌هایش راضی باشی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 663.44,
   "end": 667.42,
   "text": "خدا راضی باشه. این می‌شه انتخاب شایسته و درست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 667.42,
   "end": 671.46,
   "text": "در غیر این صورت انتخاب غلطه و دیگه این مسئله رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 671.46,
   "end": 677.1,
   "text": "نمی‌شه به طور کلی دلیل بر اشتباه بودن اصل انتخاب یا انتخابات دونست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 677.1,
   "end": 679.86,
   "text": "مائده آیه سی و یک، سی و دو می‌فرمایند نگاه کنید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
