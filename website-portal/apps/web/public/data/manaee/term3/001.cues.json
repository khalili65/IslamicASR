 "chapters": [
  {
   "index": 0,
   "title": "## آغاز جلسه و دعا",
   "start": 508.52,
   "end": 577.34
  },
  {
   "index": 1,
   "title": "## نظم تحویل تکلیف و قید مباحثه",
   "start": 577.34,
   "end": 875.24
  },
  {
   "index": 2,
   "title": "## حضور و غیرحضوری در شرایط ویژه",
   "start": 875.24,
   "end": 1002.5
  },
  {
   "index": 3,
   "title": "## صلوات و برکت مکان",
   "start": 1002.5,
   "end": 1058.8
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 10.2,
   "end": 12.54,
   "text": "اعوذ بالله من الشيطان الرجيم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 12.54,
   "end": 16.9,
   "text": "بسم الله الرحمن الرحيم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 16.9,
   "end": 21.69,
   "text": "الحمد لله رب العالمين.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 21.69,
   "end": 26.28,
   "text": "والصلاة والسلام على سيدنا ونبينا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 26.28,
   "end": 31.58,
   "text": "حبيب اله العالمين ابا القاسم المصطفى محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 31.58,
   "end": 36.42,
   "text": "اللهم صل على محمد وآل محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 36.42,
   "end": 40.22,
   "text": "وعلى آله الطيبين الطاهرين",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 40.22,
   "end": 46.96,
   "text": "و لعنة الله على أعدائهم أجمعين من الآن إلى قيام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 46.96,
   "end": 55.14,
   "text": "يوم الدين. خدایا تو را شکر می‌کنیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 55.14,
   "end": 59.34,
   "text": "که توفیق عطا فرمودی بار دیگر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 59.34,
   "end": 62.76,
   "text": "در محضر با سعادت و نورانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 62.76,
   "end": 68.08,
   "text": "کلام تو حاضر بشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 68.08,
   "end": 72.0,
   "text": "خدایا از تو عاجزانه مسألت می‌کنیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 72.0,
   "end": 82.16,
   "text": "همان طوری که ما را شایسته دانستی برای خواندن قرآن و فهم قرآن و انس با قرآن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 82.16,
   "end": 90.24,
   "text": "لیاقت عمل به آموزه‌های نورانی قرآن رو هم به ما عطا بفرما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 90.24,
   "end": 93.5,
   "text": "پروردگارا از تو می‌خواهیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 93.5,
   "end": 100.56,
   "text": "همانگونه که ما را در دنیا با قرآن کریم محشور فرمودی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 100.56,
   "end": 107.84,
   "text": "و اسم ما را و زندگی ما را به قرآن کریم پیوند زدی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 107.84,
   "end": 113.1,
   "text": "در آخرت هم ما را از کلام خودت جدا قرار ندهی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 113.1,
   "end": 119.54,
   "text": "ما را با قرآن محشور کنی و از شفاعت قرآن بهره‌مندمان کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 119.54,
   "end": 127.89,
   "text": "سلام عرض می‌کنم خدمت خواهران و برادران گرامی حاضر در جلسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 127.89,
   "end": 136.98,
   "text": "علیکم السلام. خدا رو شکر می‌کنیم که الحمد لله شما رو با عافیت و سلامتی در این جمع می‌بینیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 136.98,
   "end": 139.98,
   "text": "و می‌خواهیم که انشاالله به برکت قرآن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 139.98,
   "end": 143.08,
   "text": "آفات و بلیا و بیماری‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 143.08,
   "end": 148.02,
   "text": "از همه مردم ما و به ویژه از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 148.02,
   "end": 150.7,
   "text": "شما عزیزان دور باشه انشاالله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 150.7,
   "end": 162.12,
   "text": "و از خانواده‌هاتون، دوستانتون، آشنایانتون، عزیزانتون و همه مردممون انشاالله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 162.12,
   "end": 166.02,
   "text": "خب ما سطح سوم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 166.02,
   "end": 171.42,
   "text": "دوره آموزش معرفتی تدبر رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 171.42,
   "end": 178.74,
   "text": "داریم طی می‌کنیم. سطح اول،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 178.74,
   "end": 183.8,
   "text": "سوره‌های مبارکه انشقاق تا ناس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 183.8,
   "end": 187.98,
   "text": "در واقع مباحثه شد، گفت‌وگو شد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 187.98,
   "end": 193.78,
   "text": "و بیشتر آنچه که دغدغه ما بود به لحاظ آموزش فنی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 193.78,
   "end": 198.92,
   "text": "آشنا شدن شما عزیزان با تدبر بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 198.92,
   "end": 206.78,
   "text": "که خب در قالب سی و یک سوره انشقاق تا ناس این اتفاق افتاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 206.78,
   "end": 211.92,
   "text": "سطح دوم از سوره مزمل تا متفfin.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 211.92,
   "end": 217.46,
   "text": "یک قدم به لحاظ فنی جلوتر آمدیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 217.46,
   "end": 225.36,
   "text": "و یه مقدار تو گفت‌وگوهای خودمون سعی کردیم اون قسمت مربوط به تشخیص سیاق‌ها را",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 225.36,
   "end": 228.7,
   "text": "پررنگ‌تر دنبال بکنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 228.7,
   "end": 233.06,
   "text": "آشنایی شما تقویت شد اما کسانی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 233.06,
   "end": 238.38,
   "text": "تکالیف رو انجام می‌دادند و در کلاس حاضر می‌شدند، مطمئن هستم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 238.38,
   "end": 241.96,
   "text": "با نحوه تشخیص سیاق‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 241.96,
   "end": 247.62,
   "text": "در سوره‌ها آشناتر شدند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 247.62,
   "end": 252.12,
   "text": "الان که سطح سوم، اونجا هم یازده سوره یاد گرفتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 252.12,
   "end": 256.64,
   "text": "مجموعاً چهل و دو سوره که با سوره حم چهل و سه سوره تا اینجا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 256.64,
   "end": 262.56,
   "text": "کار کردیم ما. الان که ما در سطح سوم واقع شدیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 262.56,
   "end": 265.6,
   "text": "از سوره مبارکه طلاق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 265.6,
   "end": 268.24,
   "text": "آغاز می‌کنیم انشاالله تا سوره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 268.24,
   "end": 271.54,
   "text": "جن میایم جلو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 271.54,
   "end": 274.8,
   "text": "مبدا و معاد این سطح خیلی جالبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 274.8,
   "end": 279.38,
   "text": "سوره طلاق و سوره جن. حالا انشاالله خدا خیر کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 279.38,
   "end": 284.02,
   "text": "بعد هشت تا سوره هم انشاالله تو این سطح کار می‌کنیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 284.02,
   "end": 286.08,
   "text": "به پنجاهمین سوره می‌رسیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 286.08,
   "end": 289.54,
   "text": "یعنی به لحاظ تعداد این سطح که تمام میشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 289.54,
   "end": 293.56,
   "text": "ما پنجاه سوره را با هم کار کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 293.56,
   "end": 304.0,
   "text": "توی این سطح به لحاظ فنی یه مقدار دقتمون رو می‌خوایم رو قسمت جمع‌بندی سیاق‌ها بیشتر کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 304.0,
   "end": 307.58,
   "text": "تا حالا هم دقت داشتیم اما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 307.58,
   "end": 311.88,
   "text": "برای اینکه به لحاظ فنی شما پیشرفت داشته باشید،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 311.88,
   "end": 316.36,
   "text": "از این به بعد تقاضای بنده اینه تکالیفی که انجام خواهید داد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 316.36,
   "end": 322.54,
   "text": "توجهتون به جمع‌بندی سیاق‌ها بیشتر از قبل باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 322.54,
   "end": 328.08,
   "text": "چطور باید داخل یک سیاق رو، محتوای یک سیاق رو جمع‌بندی کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 328.08,
   "end": 335.06,
   "text": "انشاالله با تمرین بیشتری که شما بکنید و دقت بیشتری که ما در جلسه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 335.06,
   "end": 339.88,
   "text": "در جلسه‌های مربوط به این سطح داشته باشیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 339.88,
   "end": 343.56,
   "text": "توقع ما اینه که در پایان این سطح",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 343.56,
   "end": 347.48,
   "text": "به لحاظ معرفتی نگاه شما توسعه یافته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 347.48,
   "end": 357.54,
   "text": "چون هشت تا سوره پر و پیمون به مجموعه سوره‌هایی که تا به حال تدبر کردید اضافه خواهد شد و به لحاظ فنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 357.54,
   "end": 362.32,
   "text": "آشنایی شما با تدبر تقویت شده باشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 362.32,
   "end": 368.74,
   "text": "تمرینتون در سیاق‌شناسی بیشتر شده باشه و به طور خاص",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 368.74,
   "end": 372.7,
   "text": "آشنایی با نحوه جمع‌بندی سیاق‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 372.7,
   "end": 378.38,
   "text": "توی این سطح باید انشاالله تقویت بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 378.38,
   "end": 384.64,
   "text": "می‌طلبه که مثل سطوح قبلی شما در این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 384.64,
   "end": 387.92,
   "text": "دوره از مباحثات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 387.92,
   "end": 393.0,
   "text": "انشاالله جدی کار کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 393.0,
   "end": 397.78,
   "text": "مطالعه‌ی جدی داشته باشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 397.78,
   "end": 403.7,
   "text": "نباشد که بیاییم در جلسه‌ی یک surه ای حاضر بشیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 403.7,
   "end": 409.04,
   "text": "قبل از اینکه خودمون در اون surه تدبر کرده باشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 409.04,
   "end": 413.42,
   "text": "من اینو در سطوح قبلی هم گفتم ولی در این سطح",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 413.42,
   "end": 419.52,
   "text": "تاکید می‌کنم. حتما با جدیت تمام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 419.52,
   "end": 426.42,
   "text": "خودتون قبل از شروع تدریس بنده روی یک surه کار کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 426.42,
   "end": 429.94,
   "text": "الان دیگه گام‌های تدبر رو می‌شناسید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 429.94,
   "end": 433.5,
   "text": "مفاهیم آیات رو بررسی کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 433.5,
   "end": 435.78,
   "text": "سعی کنید تو آیات به درک برسید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 435.78,
   "end": 440.68,
   "text": "این مرحله اول. surه را سیاق شناسی کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 440.68,
   "end": 444.62,
   "text": "این مرحله دوم. سیاق‌ها را جمع‌بندی کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 444.62,
   "end": 450.04,
   "text": "این مرحله سوم. بین سیاق‌ها به دنبال کشف ارتباط باشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 450.04,
   "end": 456.16,
   "text": "این مرحله چهارم. تمام این مراحل رو به طور ویژه رو مرحله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 456.16,
   "end": 458.74,
   "text": "سه باید تمرکز داشته باشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 458.74,
   "end": 465.74,
   "text": "ولی تا مرحله یک و دو رو آدم انجام نده، تمرکز در مرحله سه فایده‌ای نخواهد داشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 465.74,
   "end": 470.38,
   "text": "یعنی عملاً شما کارتون داره از سطح قبلی بیشتر می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 470.38,
   "end": 473.32,
   "text": "ما در سطح قبلی همین که شما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 473.32,
   "end": 478.8,
   "text": "تکلیفی که می‌خواستی انجام بدی می‌رسید به حد اینکه surه انقدر سیاق داره برای من بس بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 478.8,
   "end": 480.98,
   "text": "می‌گفتم کار کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 480.98,
   "end": 484.64,
   "text": "اما تو این سطح توقع ما اینه که نه جمع‌بندی هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 484.64,
   "end": 490.32,
   "text": "بکنیم. پس می‌طلبه که اگر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 490.32,
   "end": 494.8,
   "text": "قبلاً برای یک جلسه‌ای در هفته ما می‌خواستیم داشته باشیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 494.8,
   "end": 500.24,
   "text": "شما بزرگواران روزی نیم ساعت، یه ساعت کار می‌کردید، بیشترش کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 500.24,
   "end": 505.44,
   "text": "هفته‌ای دو ساعت، سه ساعت کار می‌کردید، بیشترش کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 505.44,
   "end": 515.9,
   "text": "به طور ویژه عرض می‌کنم اون دسته از خواهران و برادرانی که انگیزه دارن قدم در عرصه مربی‌گری تدبر بگذارن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 515.9,
   "end": 521.54,
   "text": "اون‌ها بیشتر این تکلیف متوجه شونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 521.54,
   "end": 525.36,
   "text": "یعنی اون‌ها اصلا نباید از این تکلیف صرف‌نظر کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 525.36,
   "end": 536.24,
   "text": "باید جدی کار کنن. و مباحثه هم همه داشته باشید به طور خاص اونایی که اهداف بالاتر دارید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 536.24,
   "end": 545.58,
   "text": "و می‌خواید انشاالله به مربی‌گری و به مدرسی تدبر برسید حتما مباحثه رو در دستور کار داشته باشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 545.58,
   "end": 552.16,
   "text": "بالاخره دو نفر، سه نفر همدیگه رو پیدا کنید در طول هفته یه روزی رو قرار بگذارید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 552.16,
   "end": 558.78,
   "text": "با هم مباحثه کنید. حالا ما شاید اینجا نتونیم شرایط مباحثه رو به خصوص با توجه به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 558.78,
   "end": 562.82,
   "text": "مسائلی که الان تو جامعه‌مون خیلی سر زبون‌ها می‌چرخه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 562.82,
   "end": 565.82,
   "text": "نمی‌دونم کرونا هست و چی هست و این حرفا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 565.82,
   "end": 571.98,
   "text": "شاید نتونیم ما تدبیری بکنیم که مباحثه در این سالن انجام بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 571.98,
   "end": 577.34,
   "text": "ولی شما مباحثه رو ازش صرف نظر نکنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 577.34,
   "end": 584.4,
   "text": "همه عزیزانی که برای شرکت حضوری در این دوره ثبت نام کرده‌اند،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 584.4,
   "end": 586.92,
   "text": "همه عزیزان لطف کنند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 586.92,
   "end": 590.16,
   "text": "تکالیف رو مرتب از هفته آینده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 590.16,
   "end": 593.88,
   "text": "به مسئولین محترم کلاس تحویل بدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 593.88,
   "end": 596.5,
   "text": "این جلسه که جلسه اوله، نه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 596.5,
   "end": 606.32,
   "text": "اما از جلسه آینده مرتب تکالیف باید تحویل بشه و خواهش می‌کنم کسانی که مباحثه می‌کنند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 606.32,
   "end": 609.26,
   "text": "یا نمی‌کنند به هر حالت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 609.26,
   "end": 615.76,
   "text": "ذیل تکلیف خودشون قید کنن این رو که مباحثه کردیم یا نه، کی، کجا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 615.76,
   "end": 623.82,
   "text": "اینم قید کنید بذارید ما اقلاً بشناسیم که مثلاً تو جمع ما بیست نفر، سی نفر، پنجاه نفر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 623.82,
   "end": 628.84,
   "text": "مباحثه هم می‌کنن. علاوه بر اینکه مطالعه می‌کنند، تکالیف رو انجام میدن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 628.84,
   "end": 635.36,
   "text": "مباحثه هم می‌کنن. ممکنه با خودتون بگید خب چرا این همه تاکید رو تکلیف و مباحثه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 635.36,
   "end": 640.12,
   "text": "میایم اینجا می‌شینیم شما هم surه رو تدریس می‌کنی استفاده می‌کنیم می‌ریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 640.12,
   "end": 646.84,
   "text": "ببینید شاید من اینجا صحبت کنم این صحبت‌ها هم قابل استفاده باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 646.84,
   "end": 653.16,
   "text": "اما مطمئن باشید در خوشبینانه‌ترین حالت برای باهوش‌ترین آدم‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 653.16,
   "end": 661.32,
   "text": "عمده صحبت‌های من بعد از هفتاد و دو ساعت از یاد میره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 661.32,
   "end": 667.66,
   "text": "من اینجا هرچی به شما بگم تا کی یادتون می‌مونه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 667.66,
   "end": 670.6,
   "text": "دوازده ساعت، بیست و چهار ساعت، چهل و هشت ساعت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 670.6,
   "end": 676.4,
   "text": "دیگه هفتاد و دو ساعت به بعد کسی به شما بپرسه تو اون کلاس چی گفته شد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 676.4,
   "end": 680.1,
   "text": "حضور ذهن دیگه نخواهید داشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 680.1,
   "end": 683.86,
   "text": "الا اینکه شما به درک رسیده باشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 683.86,
   "end": 688.8,
   "text": "اون مطالبی که اینجا تو کلاس گفته می‌شه، اونا برای شما بومی بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 688.8,
   "end": 696.76,
   "text": "یعنی جزئی از ذهن و دل و فکر و جان خودتون بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 696.76,
   "end": 701.52,
   "text": "که بتونید قرآن رو باز کنید و از رو قرآن بگید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 701.52,
   "end": 706.06,
   "text": "اصلا فلانی چی گفته مسئله اصلی شما نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 706.06,
   "end": 709.66,
   "text": "مسئله اصلی شما اینه که قرآن چی گفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 709.66,
   "end": 711.52,
   "text": "خب شما surه طلاق رو درس گرفتی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 711.52,
   "end": 716.48,
   "text": "بله، درس گرفتم. باز کن توضیح بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 716.48,
   "end": 719.42,
   "text": "باید بتونی توضیحش بدی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 719.42,
   "end": 722.98,
   "text": "حداقل وقتی خودت surه طلاق رو می‌خونی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 722.98,
   "end": 728.72,
   "text": "آنچه را که در این surه تدبر کردی تو ذهنت تو دلت باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 728.72,
   "end": 732.1,
   "text": "surه طلاق رو می‌خونی ازش فاصله نگیری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 732.1,
   "end": 738.08,
   "text": "هدف اینه چون هدف اینه پس باید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 738.08,
   "end": 742.9,
   "text": "قبل از این که بذری در زمین ذهن شما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 742.9,
   "end": 745.96,
   "text": "کاشته و آبیاری بشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 745.96,
   "end": 751.54,
   "text": "پس باید این ذهن شخم خورده باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 751.54,
   "end": 755.16,
   "text": "ببینید درست مثل زمین زراعی میمونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 755.16,
   "end": 758.76,
   "text": "زمین زراعی را شما روش بذر بپاش،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 758.76,
   "end": 764.22,
   "text": "آبم بریز شاید بروید ولی سطحی می‌روید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 764.22,
   "end": 768.56,
   "text": "درسته؟ ریشه نمی‌دونه تو دل خاک.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 768.56,
   "end": 775.6,
   "text": "چون این بذرها داخل خاک فرو نرفته، سطحیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 775.6,
   "end": 780.9,
   "text": "زود از بین میره. اما اگر زمین رو شخم بزنی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 780.9,
   "end": 785.36,
   "text": "بذر بپاشی، مطمئنا اون بذری که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 785.36,
   "end": 788.98,
   "text": "توی زمین شخم زده قرار می‌گیره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 788.98,
   "end": 791.9,
   "text": "این بذر در اون زمین واقع میشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 791.9,
   "end": 799.54,
   "text": "تو دل اون زمین قرار می‌گیره و طبیعتا ریشه می‌دونه، طبیعتا رشد می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 799.54,
   "end": 805.66,
   "text": "پس این قسمت مطالعه و مباحثه را قسمت اصلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 805.66,
   "end": 810.82,
   "text": "فرآیند آموزش تدبر بدانید، نه قسمت حاشیه‌ای.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 810.82,
   "end": 814.86,
   "text": "کلاس قسمت حاشیه‌ای مسئله است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 814.86,
   "end": 818.64,
   "text": "ما اینجا میایم که به مطالعات شما جهت بدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 818.64,
   "end": 826.24,
   "text": "ما اینجا میایم که به مباحثات شما کمک بکنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 826.24,
   "end": 828.78,
   "text": "تدبر یک مهارته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 828.78,
   "end": 833.02,
   "text": "مثل رانندگی اتومبیل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 833.02,
   "end": 835.84,
   "text": "با کلاس گوش دادن به دست نمیاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 835.84,
   "end": 843.04,
   "text": "با اقدام باید کلاس داشته باشی، گوش بدی ولی اقدام کنید از قرآن ترستون بریزه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 843.04,
   "end": 844.72,
   "text": "اقدام کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 844.72,
   "end": 850.12,
   "text": "آقا ما شاید غلط فهمیدیم. خب من برای چی اینجا نشستم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 850.12,
   "end": 852.98,
   "text": "من اینجا نشستم شما اگر یه مطلبی فهمیدید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 852.98,
   "end": 857.18,
   "text": "اینجا بیاید تو کلاس چک کنید ببینید درست بود غلط بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 857.18,
   "end": 860.96,
   "text": "درست بود خوشحال بشید. غلط بود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 860.96,
   "end": 864.54,
   "text": "اصلاحش کنید. تجربه به دست بیارید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 864.54,
   "end": 868.14,
   "text": "سؤال براتون پیش اومد؟ سؤال بپرسید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 868.14,
   "end": 875.24,
   "text": "تا انشاالله بتونیم یک دوره پربار و مفیدی رو انشاالله داشته باشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 875.24,
   "end": 882.48,
   "text": "با توجه به شرایطی که توش هستیم همونطور که می‌بینید مجبوریم یه مقدار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 882.48,
   "end": 886.9,
   "text": "حضور کمتره. خب این کلاس حدود دویست و هفتاد نفر ثبت‌نامی داشته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 886.9,
   "end": 891.9,
   "text": "سطح یک و سطح دویش با دویست و هفتاد نفر برگزار شده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 891.9,
   "end": 898.58,
   "text": "و ما در سطح سه هم اعلام کردیم که حضور اجباری نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 898.58,
   "end": 901.96,
   "text": "کسانی که میخوان حضور داشته باشن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 901.96,
   "end": 906.1,
   "text": "اعلان حضور کنن، حضورشون رو ما قطعی بدونیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 906.1,
   "end": 909.2,
   "text": "برنامه‌ریزی کنیم، سالنی رو تهیه ببینیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 909.2,
   "end": 910.84,
   "text": "با همدیگه دوره رو ادامه بدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 910.84,
   "end": 913.48,
   "text": "کسانی هم که نمی‌خوان حضور داشته باشن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 913.48,
   "end": 916.4,
   "text": "همین الان ما پخش زنده داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 916.4,
   "end": 919.56,
   "text": "بعد فایل‌ها هم که رو سایت بنده قرار می‌گیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 919.56,
   "end": 922.26,
   "text": "می‌تونن اون فایل‌ها رو دنبال بکنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 922.26,
   "end": 926.88,
   "text": "ولی خب حالا از من سؤال بشه حضوری یا غیرحضوری؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 926.88,
   "end": 933.44,
   "text": "میگم خیلی فرق می‌کنه. بالاخره حضوری برکت و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 933.44,
   "end": 937.66,
   "text": "فایده علمی معنوی خودش را دارد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 937.66,
   "end": 941.8,
   "text": "غیرحضوری هم در حد خودش فایده علمی و معنوی داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 941.8,
   "end": 946.3,
   "text": "بی‌فایده که نیست، در حد خودشه ولی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 946.3,
   "end": 951.3,
   "text": "حتما حضوری اولویت داره برای کسی که می‌تونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 951.3,
   "end": 955.74,
   "text": "اما اگر کسی به هر دلیلی نمی‌تونه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 955.74,
   "end": 960.5,
   "text": "بیماری جسمی داره، ضعف عمومی بدن داره، می‌ترسه، نگرانه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 960.5,
   "end": 965.52,
   "text": "عقلایی به لحاظ عقلایی می‌بینه شاید تو این شرایط بیرون آمدنش از خونه صلاح نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 965.52,
   "end": 972.68,
   "text": "خانواده‌اش همراه نیستند. بنا بر هر دلیلی نمی‌تونه حضور پیدا کنه حتما نباید دست از آموزش برداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 972.68,
   "end": 975.16,
   "text": "دوره‌ها رو غیرحضوری دنبال بکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 975.16,
   "end": 982.04,
   "text": "انشاالله تو ترم‌های بعدی بتونن اون جمعیتی که غیرحضوری دنبال می‌کنن که شاید دو برابر شما هستن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 982.04,
   "end": 984.16,
   "text": "اونا هم انشاالله بتونن به این جمع",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 984.16,
   "end": 986.46,
   "text": "ملحق بشن. شرایط",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 986.46,
   "end": 992.94,
   "text": "حالا بگیم بحرانی جامعه یه مقدار افت بکنه از بین بره انشاالله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 992.94,
   "end": 999.76,
   "text": "اونا هم بتونن با سلامتی و عافیت به جمع ما بپیوندند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 999.76,
   "end": 1006.4,
   "text": "خب، مطالب اولیه ای که گفتم خیلی خشک بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 1006.4,
   "end": 1011.6,
   "text": "بیایید برای طراوت مجلسمون یک صلوات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 1011.6,
   "end": 1015.16,
   "text": "قرایی ختم کنیم. اللهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 1015.16,
   "end": 1017.88,
   "text": "صل على محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 1017.88,
   "end": 1022.1,
   "text": "و آل محمد و عجل فرجهم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 1022.1,
   "end": 1028.26,
   "text": "ما از مسجد پیامبر خدا آغاز کردیم، به مسجد امام زمان رسیدیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 1028.26,
   "end": 1034.48,
   "text": "و الان حوالی مسجد مولا امیر المومنین علی ابن ابی طالب علیه السلام شدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 1034.48,
   "end": 1039.1,
   "text": "انشاالله که نام مقدسی که بر این مسجد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 1039.1,
   "end": 1048.72,
   "text": "مسجد و مکان مقدس گذاشته شده یعنی نام مقدس امیر المومنین علی علیه السلام همای برکت در دوره ما باشه و توجهات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 1048.72,
   "end": 1055.0,
   "text": "ویژه و ادعیه خاص اون امام بزرگوار رو شامل حال همه ما بکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 1055.0,
   "end": 1058.8,
   "text": "باز هم به برکت صلوات بر محمد و آل محمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}