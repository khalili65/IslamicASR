 },
 "chapters": [
  {
   "index": 0,
   "title": "یعنی به پیامبر پیشنهاد می‌دهد قسمت را بکشای. نمی‌گوید آن قسم چه بوده و آیا پیامبر شکست یا نه. فقط جلوتر می‌آید:",
   "start": 74.28,
   "end": 480.36
  },
  {
   "index": 1,
   "title": "### تطبیق بر سورهٔ تحریم",
   "start": 480.36,
   "end": 604.72
  },
  {
   "index": 2,
   "title": "## جهاد در آیهٔ سوره؛ لزوماً شمشیر نیست",
   "start": 604.72,
   "end": 1006.33
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 10.26,
   "end": 13.6,
   "text": "عرض کرده بودم که در ابتدای جلسه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 13.6,
   "end": 17.28,
   "text": "اگر سوالی از سوره تحریم باشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 17.28,
   "end": 20.44,
   "text": "ابهامی، اشکالی در سوره تحریم داشته باشیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 20.44,
   "end": 22.98,
   "text": "پاسخ بدیم بعد سوره ملک رو شروع کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 22.98,
   "end": 25.36,
   "text": "اگر سوالی هست من در خدمتم بفرمایید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 25.36,
   "end": 27.86,
   "text": "پیامبر چه قسمی خورده بودند؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 27.86,
   "end": 31.06,
   "text": "ببینید تصریح نشده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 31.06,
   "end": 35.36,
   "text": "ولی اونچه که از سیاق اول برمی‌آد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 35.36,
   "end": 39.68,
   "text": "اینه که پیامبر قسم خورده بودند که اینها را طلاق ندن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 39.68,
   "end": 42.2,
   "text": "همسران خود را طلاق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 42.2,
   "end": 47.38,
   "text": "ندهند. طلاق دادن جزء امور مباح بر پیغمبر محسوب میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 47.38,
   "end": 50.72,
   "text": "اگر میخواست طلاق بده میتونست از این حقش چیکار کنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 50.72,
   "end": 56.1,
   "text": "استفاده کنه. ولی برای جلب رضایت همسرانش و بدست آوردن دل اونها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 56.1,
   "end": 63.0,
   "text": "که اونا از یک مسئله‌ای به هر حال خوشحال بشن و جای دیگری پیغمبر رو خوشحال بکنن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 63.0,
   "end": 66.58,
   "text": "پیامبر سوگند یاد کرده بودند که اینها را طلاق ندن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 66.58,
   "end": 69.3,
   "text": "من این مطلب رو از شأن نزول نمیگم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 69.3,
   "end": 72.24,
   "text": "برداشتی‌ست که از سیاق اول کردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 72.24,
   "end": 79.82,
   "text": "چرا؟ چون در ابتدا که خدا می‌فرماید \"لم تحرم ما احلل الله لك تبتغي مرضات ازواجک\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 79.82,
   "end": 86.38,
   "text": "بعد می‌فرماید که \"قد فرض الله لكم تحلة أيمانكم\" یعنی به پیغمبر پیشنهاد میده قسمتو بشکن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 86.38,
   "end": 88.79,
   "text": "هیچی نمیگه اون قسمه چی بوده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 88.79,
   "end": 91.14,
   "text": "و آیا پیغمبر قسمو شکست یا نه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 91.14,
   "end": 97.06,
   "text": "فقط جلوتر میایم میگه \"عسی ربه إن فلّقكن\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 97.06,
   "end": 104.14,
   "text": "یه چیزی اینجا خدا میگه امیدوار است پروردگار پیغمبر که اگر ایشون یعنی پیغمبر شما را طلاق داد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 104.14,
   "end": 106.28,
   "text": "بهتر از شما را به او بدهد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 106.28,
   "end": 113.18,
   "text": "این گزینه رو در ذهن ما تقویت میکنه که خدا بعد از اینکه به پیغمبرش گفته قسمتو بشکن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 113.18,
   "end": 117.04,
   "text": "الان میخواد بگه خیالت راحت اگر از گزینه طلاق استفاده کنی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 117.04,
   "end": 121.14,
   "text": "من بهتر از این همسران رو به تو خواهم داد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 121.14,
   "end": 127.54,
   "text": "این سؤال اولتون. سؤال اینه چرا قرآن کریم صراحتاً به مسئله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 127.54,
   "end": 131.98,
   "text": "اینکه این توطئه چی بوده، اون قسم چی بوده و غیره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 131.98,
   "end": 135.28,
   "text": "اشاره نکرده. و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 135.28,
   "end": 139.02,
   "text": "من میخوام سؤال شما رو حتی یه مقدار کامل‌تر بکنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 139.02,
   "end": 147.98,
   "text": "چرا اصلا قرآن کریم در حوزه ولایت به تصریح اسم اولیاء بعد از پیغمبر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 147.98,
   "end": 152.88,
   "text": "و نمیدونم حل مسائلی که دیگه امت دچار شعبه‌ها و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 152.88,
   "end": 159.02,
   "text": "شاخه‌ها و غیره نشود، چرا قرآن کریم اصلاً اونجاها این کارو نکرده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 159.02,
   "end": 161.46,
   "text": "من چرا میگم این کامل‌ترشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 161.46,
   "end": 164.98,
   "text": "چون این سوره با توجه به درکی که ما داشتیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 164.98,
   "end": 168.2,
   "text": "توطئه‌ای که تو بیت پیغمبر اتفاق افتاده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 168.2,
   "end": 171.42,
   "text": "این توطئه در حوزه ولایت و امامت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 171.42,
   "end": 177.6,
   "text": "تحقق یافت. لذا اگر اینجا هم تصریح نشده به بعضی از چیزا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 177.6,
   "end": 184.32,
   "text": "اینم یه قسمتی از همین سیاست قرآنه که کلاً در حوزه ولایت و امامت با تصریح",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 184.32,
   "end": 189.54,
   "text": "اسم و مشخص کردن نفر و اینا پیش نرفته،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 189.54,
   "end": 193.48,
   "text": "بلکه اومده قرآن کریم در حد پایه‌گذاری،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 193.48,
   "end": 197.0,
   "text": "طراحی، پی‌ریزی اینجوری عمل کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 197.0,
   "end": 204.36,
   "text": "ببینید شاید به این سؤال از منظرهای مختلفی بشه جواب داد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 204.36,
   "end": 208.9,
   "text": "و حکمت‌های مختلفی بشه برای این مسئله برشمرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 208.9,
   "end": 213.26,
   "text": "ولی اونچه که من درک می‌کنم اینه:",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 213.26,
   "end": 215.96,
   "text": "در زندگی یک انسان،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 215.96,
   "end": 224.1,
   "text": "یک انسان آیا پیش میاد به دوراهی، سه راهی، چهارراهی، پنج راهی برسه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 224.1,
   "end": 229.32,
   "text": "و دچار ابهام بشه که من کدوم راهو برم صحیحه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 229.32,
   "end": 232.52,
   "text": "پیش میاد یا نه؟ خب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 232.52,
   "end": 235.32,
   "text": "چرا خداوند یک انسان رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 235.32,
   "end": 239.8,
   "text": "طوری از عقل انسان رو، دیگه عقل ما بالاخره به عالم بالا وصله دیگه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 239.8,
   "end": 242.78,
   "text": "یه کاری کنه که هر جا ما به دوراهی خوردیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 242.78,
   "end": 246.22,
   "text": "مشخص کنه بگه الف خوبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 246.22,
   "end": 250.38,
   "text": "آقا خدایا من دوراهی جلومه. این شغلو دارم به من پیشنهاد میدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 250.38,
   "end": 253.1,
   "text": "قبول کنم یا قبول نکنم. خدا بگه الف خوبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 253.1,
   "end": 258.56,
   "text": "قبول کن. حالا بعضیا جبران این مسئله رو با استخاره انجام میدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 258.56,
   "end": 260.1,
   "text": "استخاره رافع تهیُره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 260.1,
   "end": 262.62,
   "text": "واقعاً نمیشه استخاره رو گفت نظر خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 262.62,
   "end": 264.36,
   "text": "بذار ببینم نظر خدا چیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 264.36,
   "end": 268.28,
   "text": "نه واقعاً اینجوری نیست. استخاره رافع تهیُره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 268.28,
   "end": 273.4,
   "text": "یعنی امیدواریم ان شاء الله اگر ما فکرامونو کردیم، مشورتامونو کردیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 273.4,
   "end": 275.5,
   "text": "به نتیجه نرسیدیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 275.5,
   "end": 277.92,
   "text": "حالا دو به شکیم، پنجاه پنجاهیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 277.92,
   "end": 282.38,
   "text": "ان شاء الله خدا اون صلاح ما را به ما بگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 282.38,
   "end": 284.05,
   "text": "ان شاء الله. آه تمام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 284.05,
   "end": 291.2,
   "text": "استخاره همینه. چرا خدا معین نکرده برای ما یا عقل ما را طوری نچیده که قشنگ،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 291.2,
   "end": 296.44,
   "text": "راحت، شفاف بتونیم بگیم این کار درسته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 296.44,
   "end": 299.92,
   "text": "چرا؟ چون رشد یک انسان،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 299.92,
   "end": 302.24,
   "text": "لازمه رشد یک انسان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 302.24,
   "end": 307.98,
   "text": "اینه که بتونه با تفکر و با تقوا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 307.98,
   "end": 311.66,
   "text": "و با تکیه به مبانی تشخیص بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 311.66,
   "end": 317.12,
   "text": "این خاصیت انسانه. اگه بنا بود که قدم به قدم این انسان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 317.12,
   "end": 320.34,
   "text": "دائماً بهش گفته بشه چیکار کن، چیکار نکن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 320.34,
   "end": 324.24,
   "text": "دیگه اون امتحان سطوح عالی گویا این انسان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 324.24,
   "end": 326.06,
   "text": "بگید ندارد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 326.06,
   "end": 330.86,
   "text": "انگار امتحان سطوح-- همیشه در رتبه ابتدایی میمونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 330.86,
   "end": 333.0,
   "text": "بله تا-- ببینید الان نگاه کنید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 333.0,
   "end": 338.26,
   "text": "ما تا بچه هستیم معمولاً تو بچگی تهیُّر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 338.26,
   "end": 342.66,
   "text": "خیلی نداریم. تو بچگی خوب و بد ما خیلی شفافه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 342.66,
   "end": 345.38,
   "text": "خیلی شفافه. این کارو بکن، این کارو نکن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 345.38,
   "end": 350.24,
   "text": "این خوبه، این بده. تو بچگی روشنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 350.24,
   "end": 353.14,
   "text": "باید غذاتو بخوری. این روشنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 353.14,
   "end": 355.32,
   "text": "باید الان مثلاً فرض کن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 355.32,
   "end": 357.74,
   "text": "با گوشی بازی نکنی. این روشنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 357.74,
   "end": 362.22,
   "text": "یعنی جواب روشنی داره. هرچی بزرگتر میشیم مسائل ما چی میشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 362.22,
   "end": 365.4,
   "text": "پیچیده‌تر. این طراحی عالمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 365.4,
   "end": 367.18,
   "text": "چون ما باید به کمال برسیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 367.18,
   "end": 372.54,
   "text": "تمام امت‌ها هم همینن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 372.54,
   "end": 375.58,
   "text": "امت‌ها هم همینن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 375.58,
   "end": 381.0,
   "text": "همونطور که انسان مراطبی در رشد و پیشرفت و تکامل داره، امت هم همینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 381.0,
   "end": 384.72,
   "text": "امت یه حیات داره، یک حقیقتی داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 384.72,
   "end": 389.62,
   "text": "اگه بنا بود که تمام ریزه‌کاری‌های تاریخ تا آینده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 389.62,
   "end": 394.04,
   "text": "و گذشته، همه ریزه‌کاری‌ها به امت گفته بشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 394.04,
   "end": 397.48,
   "text": "دیگه گویا مجالی برای رشد خود این امت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 397.48,
   "end": 400.24,
   "text": "نذاشتی. به این میگن فتنه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 400.24,
   "end": 405.18,
   "text": "میگن آزمایش. حضرت علی علیه‌السلام سؤال کردن زین سوره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 405.18,
   "end": 409.78,
   "text": "عنکبوت \"أَحَسِبَ النَّاسُ أَنْ يُتْرَكُوا أَنْ يَقُولُوا آمَنَّا وَهُمْ لا يُفْتَنُونَ\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 409.78,
   "end": 414.84,
   "text": "مردم خیال کردن همین که بگن ایمان آوردیم تمامه، دیگه امتحانی، فتنه‌ای در کار نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 414.84,
   "end": 416.72,
   "text": "از حضرت سؤال کردن این فتنه چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 416.72,
   "end": 420.72,
   "text": "گفت این فتنه، فتنه امامت و رهبریه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 420.72,
   "end": 423.3,
   "text": "یعنی خدا یه جوری قرار داده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 423.3,
   "end": 426.32,
   "text": "که با رشد بهش برسی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 426.32,
   "end": 428.76,
   "text": "با تفکر و تقوا بهش برسی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 428.76,
   "end": 433.2,
   "text": "آقا من مشخص کردم تو بخوای بفهمی میتونی بفهمی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 433.2,
   "end": 437.98,
   "text": "اما راه هم گذاشتم که اگه خواستی خودتو به نفهمی بزنی، بگیر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 437.98,
   "end": 439.88,
   "text": "بتونی؟ بزنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 439.88,
   "end": 442.74,
   "text": "می‌خوای سر خود کلاه بذاری؟ خب بذار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 442.74,
   "end": 445.38,
   "text": "کی ضرر می‌کنه؟ خب خودت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 445.38,
   "end": 450.92,
   "text": "من میگم امت بعد پیغمبر خدا سر خودش کلاه گذاشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 450.92,
   "end": 456.6,
   "text": "نه که نمی‌دونست. مشکل امت ندونستن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 456.6,
   "end": 460.2,
   "text": "امام بعد پیغمبر یا نمی‌دونم شاخصه‌ها نبود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 460.2,
   "end": 466.1,
   "text": "میگم به خودش خیانت کرد. الان صحبتی که کردم که به عقل خودش اعتنا نکرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 466.1,
   "end": 469.16,
   "text": "حالا اینکه به پیغمبر اعتنا نکرد یه ظلمیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 469.16,
   "end": 471.28,
   "text": "به شاخصه‌ها اعتنا نکرد یه ظلمیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 471.28,
   "end": 473.14,
   "text": "آقا عقل هم نداشتی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 473.14,
   "end": 475.88,
   "text": "عقل. با عقلت می‌فهمیدی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 475.88,
   "end": 480.36,
   "text": "حالا در همین سوره حالا بیام تطبیق بدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 480.36,
   "end": 485.08,
   "text": "اگر کسی واقعاً بخواد از سوره مبارکه تحریم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 485.08,
   "end": 488.02,
   "text": "نتیجه بگیره که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 488.02,
   "end": 493.46,
   "text": "برای زندگی خودش یه درس بگیره، اونی که خدا توش گفته کافیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 493.46,
   "end": 498.4,
   "text": "آقا همین مقدار فهمیدی که تو بیت پیغمبر دو تا از خانوماش خیانت کردن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 498.4,
   "end": 501.54,
   "text": "توطئه کردن، تبانی کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 501.54,
   "end": 504.9,
   "text": "اینو گفتم؟ بله خدایا گفتی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 504.9,
   "end": 511.68,
   "text": "متوجه شدی که من به اینا گفتم اگر توبه کردید که منحرفید، اگر توبه هم نکردید بدونید که با خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 511.68,
   "end": 515.62,
   "text": "و جبرائیل و صالح مؤمنین و ملائکه طرفید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 515.62,
   "end": 520.98,
   "text": "بله خدا اینم شنیدم. دیدی بعدش گفتم که آتیش به پا شده مؤمنین مواظب باشید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 520.98,
   "end": 527.06,
   "text": "بله خدا شنیدم. دیدی آخر سوره من گفتم که دو تا مس-- دو نفر رو دارم مثل می‌زنم برای کفر،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 527.06,
   "end": 529.02,
   "text": "دو تا زن پیغمبر مثل زدم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 529.02,
   "end": 531.22,
   "text": "بله. چی می‌خوام بهت بگم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 531.22,
   "end": 536.08,
   "text": "خدایا تو می‌خوای به من بگی زن پیغمبر بودن دلیل بر حجت بودن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 536.08,
   "end": 538.98,
   "text": "نیست. خب دیگه خودتو اینجا به نفهمی نزن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 538.98,
   "end": 545.12,
   "text": "حالا هرچی بود اون قصد، حالا اون راز هرچی بود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 545.12,
   "end": 548.76,
   "text": "، هرچی بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 548.76,
   "end": 552.24,
   "text": "پس تو درسی رو که بخوای بگیری می‌تونی بگیری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 552.24,
   "end": 555.52,
   "text": "مگر دنبال فرار باشی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 555.52,
   "end": 558.9,
   "text": "حالا بخوای فرار کنی خدا یه راه در رو گذاشته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 558.9,
   "end": 560.88,
   "text": "می‌خوای سر خود کلاه بذاری؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 560.88,
   "end": 563.8,
   "text": "برو بگو قصه شربت بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 563.8,
   "end": 570.06,
   "text": "سر خود کلاه بذار. بگو خبری نبود، شربت بود، شربت بود، ریخته بود، درست شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 570.06,
   "end": 573.84,
   "text": "خودت می‌دونی. نمی‌خوای عقلتو به کار بگیری؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 573.84,
   "end": 577.12,
   "text": "خودت می‌دونی. دودش تو چشم خودت میره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 577.12,
   "end": 580.34,
   "text": "من قرار نیست که تا حل قضا رو تو دهن شما بذارم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 580.34,
   "end": 582.46,
   "text": "من مشخص کردم دیگه. آها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 582.46,
   "end": 585.38,
   "text": "من فکر می‌کنم پس این مسئله به طور کلی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 585.38,
   "end": 589.34,
   "text": "نه فقط تو این سوره، قرآن کریم خیلی جاها راه در رو می‌ذاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 589.34,
   "end": 592.5,
   "text": "برای کسی که بخواد فرار کنه، فرار کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 592.5,
   "end": 595.26,
   "text": "فرار کنه خودش بندازه تو آتیش. خودش می‌دونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 595.26,
   "end": 600.68,
   "text": "ولی خدا این راه در روهایی که می‌ذاره به معنی این نیستش که اتمام حجت نکرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 600.68,
   "end": 603.82,
   "text": "اتمام حجت می‌کنه ولی راه در رو هم می‌ذاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 603.82,
   "end": 606.64,
   "text": "سؤال سوم. در جلسه قبل عرض کردم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 606.64,
   "end": 609.48,
   "text": "اینکه خدا به پیغمبر می‌فرماید جهاد کن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 609.48,
   "end": 618.96,
   "text": "سخت بگیر، لزوماً به معنی جهاد با شمشیر یا چوب یا مثلاً جهاد فیزیکی لزوماً نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 618.96,
   "end": 623.62,
   "text": "ما در آیه خوندم از قرآن کریم \"جَاهِدْهُم بِهِ جِهَادًا كَبِيرًا\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 623.62,
   "end": 628.78,
   "text": "اصلاً قرآن جهاد کبیر را جهاد با قرآن می‌دونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 628.78,
   "end": 634.32,
   "text": "به نظر شما تبلیغ همین سوره تحریم تو جامعه جهاد علیه این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 634.32,
   "end": 640.88,
   "text": "منافقین نبود؟ همین که سوره تحریم گفته بشه، خونده بشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 640.88,
   "end": 644.3,
   "text": "تبیین بشه، تعلیم داده بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 644.3,
   "end": 646.1,
   "text": "به نظرتون حال زنان پیغمبر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 646.1,
   "end": 652.56,
   "text": "تو اون روز که داشته این سوره تو جامعه ترویج می‌شده و تبلیغ می‌شده و درس داده می‌شده و پیغمبر با این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 652.56,
   "end": 659.04,
   "text": "سوره منبر می‌رفته، حال اون زنان چطور بوده اون روز؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 659.04,
   "end": 663.0,
   "text": "اونا اونجا بودن. پیغمبر رفت و هنوزم بودن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 663.0,
   "end": 669.62,
   "text": "این سوره هم هنوز خونده می‌شد. فرض کنید همسر پیغمبر رو دعوت کرده باشیم در یه همایشی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 669.62,
   "end": 672.42,
   "text": "زمان صدر اسلامه. توی تجمعی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 672.42,
   "end": 676.06,
   "text": "شما خانم پیغمبر یه محترمی تشریف بیار-- تشریف آورده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 676.06,
   "end": 679.88,
   "text": "\"أعوذ بالله من الشيطان الرجيم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 679.88,
   "end": 687.34,
   "text": "إن تتوبا إلى الله فقد صغت قلوبكما\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 687.34,
   "end": 692.48,
   "text": "خوشش هسته اینجا. \"وإن تظاهرا عليه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 692.48,
   "end": 697.9,
   "text": "فإن الله هو مولاه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 697.9,
   "end": 703.94,
   "text": "وجبريل وصالح المؤمنين",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 703.94,
   "end": 710.12,
   "text": "والملائكة بعد ذلك ظهير",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 710.12,
   "end": 715.02,
   "text": "عسى ربه إن طلقهكن\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 715.02,
   "end": 717.14,
   "text": "ببینید، پدرش در میاد دیگه. جهاد غلیظ.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 717.14,
   "end": 719.82,
   "text": "دیگه چی می‌خوای؟ یعنی پیغمبر جز--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 719.82,
   "end": 728.28,
   "text": "من میگم هیچ کار نکرده باشد جز اینکه سوره تحریم را تو جامعه برای مردم خونده باشه و درس داده باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 728.28,
   "end": 731.06,
   "text": "مصداقشه. و بعدش هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 731.06,
   "end": 736.36,
   "text": "ما خیلی از اتفاقات تاریخ به ما نقل نشده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 736.36,
   "end": 741.52,
   "text": "ما نمی‌تونیم اونچه را که از تاریخ به گوشمون خورده معیار قرار بدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 741.52,
   "end": 745.1,
   "text": "ما نمی‌دونیم واقعاً اون روز چه اتفاقاتی افتاده که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 745.1,
   "end": 748.46,
   "text": "دست‌هایی که می‌خواستن این تاریخ‌ها نقل نشود،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 748.46,
   "end": 750.52,
   "text": "جلوی نقل شدن اون رو گرفتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 750.52,
   "end": 752.08,
   "text": "برای ما قرآن معیاره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 752.08,
   "end": 757.06,
   "text": "ما از رو قرآن مطمئنیم که پس پیغمبر سخت‌گیری‌های لازم را",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 757.06,
   "end": 762.46,
   "text": "کردند. هرچه که-- چون پیغمبر قطعاً مطیع خدا هستند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 762.46,
   "end": 766.52,
   "text": "تمام. بفرمایید. اون بحث موضوعیه اصلاً.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 766.52,
   "end": 773.56,
   "text": "شما یه بار آیات مربوط به یه موضوع رو از قرآن جمع می‌کنی، اینا با هم ارتباط دارن از جاهای مختلف قرآن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 773.56,
   "end": 775.7,
   "text": "اون تدبر موضوعیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 775.7,
   "end": 778.86,
   "text": "در تدبر ترتیبی که ما داریم کار می‌کنیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 778.86,
   "end": 782.86,
   "text": "نمی‌خوایم هیچ آیه‌ای رو از بیرون بیاریم قاطی این بکنیم یا از اینجا ببریم بیرون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 782.86,
   "end": 787.58,
   "text": "می‌گیم این یه سوره ایه. این سوره یه ورود و خروجی داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 787.58,
   "end": 789.78,
   "text": "از اینجا تا اینجا، این یه پاراگراف.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 789.78,
   "end": 792.64,
   "text": "از اینجا تا اینجا، یه پاراگراف. از اینجا تا اینجا، یه پاراگراف.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 792.64,
   "end": 795.32,
   "text": "حالا جمع‌بندی کنیم ارتباط اینا رو کشف کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 795.32,
   "end": 799.42,
   "text": "این تدبر ترتیبیه که ما داریم انجام میدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 799.42,
   "end": 802.3,
   "text": "طبق ترتیب آیات تدبر می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 802.3,
   "end": 805.43,
   "text": "به همین اشاره کردم ولی من نقد کردم دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 805.43,
   "end": 807.98,
   "text": "اصلاً با این سوره جور در نمیاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 807.98,
   "end": 809.92,
   "text": "ما باید به سوره نگاه بکنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 809.92,
   "end": 813.44,
   "text": "خب اونم که اینا رو نقل کردن در تفاسیر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 813.44,
   "end": 819.52,
   "text": "ببینید اینجوریه مثلاً فرض کنیدا بنده می‌خواستم راجع به این آیه چیزی بنویسم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 819.52,
   "end": 822.98,
   "text": "رفتم دیدم ده تا قبل از من اینو گفتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 822.98,
   "end": 826.24,
   "text": "منم یه چیز دیگه بنویسم دستم دیگه نیومده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 826.24,
   "end": 829.0,
   "text": "منم همونو نوشتم شدم یازدهمی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 829.0,
   "end": 831.2,
   "text": "همینجوری هی زیاد شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 831.2,
   "end": 835.8,
   "text": "یه دفعه ما می‌بینیم آقا چند صد تا تفسیر اینو گفتن، نباید هول ما رو برداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 835.8,
   "end": 839.0,
   "text": "معنیش این نیست که چند صد نفر نشستن دونه دونه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 839.0,
   "end": 840.62,
   "text": "فکر کردن و تایید کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 840.62,
   "end": 846.44,
   "text": "نه. خیلی از این موارد اینه تا من می‌بینم ده نفر اینو گفتن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 846.44,
   "end": 848.66,
   "text": "حرف دیگه رو دیگه به سادگی نمی‌تونم بگم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 848.66,
   "end": 852.34,
   "text": "نگران میشم که الان بگم چی میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 852.34,
   "end": 855.28,
   "text": "یا قطعی نمیگم. یا قطعی نمیگم، در حد احتمال میگم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 855.28,
   "end": 858.16,
   "text": "یه جوری میگم که خلاصه رد، رد بشه بره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 858.16,
   "end": 860.68,
   "text": "به خاطر اینکه می‌دونید قرآن حساسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 860.68,
   "end": 864.52,
   "text": "الان حالا مثلاً ماها یه کم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 214,
   "start": 864.52,
   "end": 868.74,
   "text": "ما میگیم خدا رحمت کند علامه طباطبایی رحمت‌الله علیه رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 215,
   "start": 868.74,
   "end": 875.3,
   "text": "علامه طباطبایی با باز کردن باب تفسیر عقلی و اجتهادی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 216,
   "start": 875.3,
   "end": 880.38,
   "text": "الان ما می‌تونیم راحت حرف بزنیم، ما مدیون علمه‌ایم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 217,
   "start": 880.38,
   "end": 883.54,
   "text": "اگر علامه طباطبایی رحمت‌الله علیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 218,
   "start": 883.54,
   "end": 885.96,
   "text": "این باب رو باز نکرده بود و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 219,
   "start": 885.96,
   "end": 892.98,
   "text": "به خودش این جرات رو نداده بود که از برخی از این نقل قول‌ها و شأن نزول‌ها و غیره عبور کنه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 220,
   "start": 892.98,
   "end": 895.37,
   "text": "شاید امروز ماها کارمون خیلی سخت‌تر بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 221,
   "start": 895.37,
   "end": 900.46,
   "text": "اما خود علامه که این باب رو باز کرده، خیلی جاها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 222,
   "start": 900.46,
   "end": 906.42,
   "text": "دیگه رد نشده ازشا. یه در حدود بیست، سی درصد کار کرده ولی راهو برای ما باز کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 223,
   "start": 906.42,
   "end": 909.38,
   "text": "حالا ما خیلی راحت‌تر میگیم. میگیم آقا این شأن نزول،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 224,
   "start": 909.38,
   "end": 912.0,
   "text": "شأن نزول که قرآن نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 225,
   "start": 912.0,
   "end": 918.64,
   "text": "شأن نزول یه نقل تاریخی یا رواییه که معلوم نیست واقعاً از امام معصوم صادر شده یا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 226,
   "start": 918.64,
   "end": 920.78,
   "text": "نه. باید به کجا عرضه بشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 227,
   "start": 920.78,
   "end": 923.44,
   "text": "به قرآن. کی باید تایید کنه شأن نزول را؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 228,
   "start": 923.44,
   "end": 926.42,
   "text": "قرآن. کی گفته قرآن باید تایید کنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 229,
   "start": 926.42,
   "end": 929.9,
   "text": "خود اهل بیت .",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 230,
   "start": 929.9,
   "end": 933.16,
   "text": "یعنی اهل بیت علیهم السلام،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 231,
   "start": 933.16,
   "end": 937.6,
   "text": "ما حدیث متواتر کم داریم ولی یکی از احادیث متواتر که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 232,
   "start": 937.6,
   "end": 944.46,
   "text": "یقیناً از امام معصوم، امامان معصوم صادر شده، یقیناً مثل حدیث غدیر، انقدر قطعیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 233,
   "start": 944.46,
   "end": 949.12,
   "text": "یکیش همینه که آقا هرچی از ما به شما نقل می‌کنند به قرآن عرضه کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 234,
   "start": 949.12,
   "end": 954.18,
   "text": "اگر موافق قرآن بود ما گفتیم، اگر نبود ما نگفتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 235,
   "start": 954.18,
   "end": 956.98,
   "text": "اگه مخالف قرآن بود ما نگفتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 236,
   "start": 956.98,
   "end": 961.58,
   "text": "یعنی پس امام توقع داشته که من قرآن را بفهمم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 237,
   "start": 961.58,
   "end": 965.42,
   "text": "و بتونم حدیث را با قرآن مقایسه کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 238,
   "start": 965.42,
   "end": 970.94,
   "text": "ببینم این حدیث با این آیات جور در میاد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 239,
   "start": 970.94,
   "end": 976.2,
   "text": ". آیا اینکه سرتا سر سوره تحریم را با شربت جمع کنم با سوره جور در میاد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 240,
   "start": 976.2,
   "end": 982.28,
   "text": "من میگم شهادت می‌دهم در پیشگاه خدا با سلول، سلول وجودم که جور در نمیاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 241,
   "start": 982.28,
   "end": 989.18,
   "text": "خب پس قبول نمی‌کنن. حالا صد نفر نوشتن تو کتابشون، هزار نفر نوشته باشن مثلاً فرقی نمی‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 242,
   "start": 989.18,
   "end": 991.9,
   "text": "اونا، اونا مکلفن عرضه کنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 243,
   "start": 991.9,
   "end": 993.84,
   "text": "اونا باید عرضه می‌کردند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 244,
   "start": 993.84,
   "end": 996.32,
   "text": "تمام. خب دیگه عبور کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 245,
   "start": 996.32,
   "end": 998.06,
   "text": "یه صلواتی هم ختم کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 246,
   "start": 998.06,
   "end": 1002.0,
   "text": "سلام. اللهم صل على محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 247,
   "start": 1002.0,
   "end": 1006.33,
   "text": "و آل محمد و عجل فرجهم. و عجل فرجهم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}