 ],
 "cues": [
  {
   "i": 0,
   "start": 2.96,
   "end": 3.46,
   "text": "**استاد:** حجت‌الاسلام قاسمیان **دوره:** انسان کامل **موضوع جلسه:** پایان پروندهٔ «خطاهای انبیا» سورهٔ عبس زهد انبیا (نهج ۱۶۰) رؤیت موسی ابراهیم",
   "kind": "speech",
   "chapter": null,
   "block": 2
  },
  {
   "i": 1,
   "start": 2.96,
   "end": 3.46,
   "text": "و احیای موتی زکریا متی نصر الله",
   "kind": "speech",
   "chapter": null,
   "block": 2
  },
  {
   "i": 2,
   "start": 2.96,
   "end": 3.46,
   "text": "أَعُوذُ بِاللَّهِ مِنَ الشَّيْطَانِ الرَّجِيمِ بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ اللَّهُمَّ",
   "kind": "quote",
   "chapter": 0,
   "block": 4
  },
  {
   "i": 3,
   "start": 2.96,
   "end": 3.46,
   "text": "صَلِّ عَلَىٰ مُحَمَّدٍ وَآلِ مُحَمَّدٍ.",
   "kind": "quote",
   "chapter": 0,
   "block": 4,
   "translation": "پناه می‌برم به خدا از شیطان رانده‌شده. به نام خداوند بخشندهٔ مهربان. خدایا بر محمد و آل محمد درود فرست."
  },
  {
   "i": 4,
   "start": 2.96,
   "end": 3.46,
   "text": "«عَبَسَ وَتَوَلَّىٰ أَن جَاءَهُ الْأَعْمَىٰ وَمَا يُدْرِيكَ لَعَلَّهُ يَزَّكَّىٰ أَوْ يَذَّكَّرُ",
   "kind": "quote",
   "chapter": 1,
   "block": 7
  },
  {
   "i": 5,
   "start": 2.96,
   "end": 3.46,
   "text": "فَتَنفَعَهُ الذِّكْرَىٰ أَمَّا مَنِ اسْتَغْنَىٰ فَأَنتَ لَهُ تَصَدَّىٰ وَمَا عَلَيْكَ أَلَّا",
   "kind": "quote",
   "chapter": 1,
   "block": 7
  },
  {
   "i": 6,
   "start": 2.96,
   "end": 3.46,
   "text": "يَزَّكَّىٰ وَأَمَّا مَن جَاءَكَ يَسْعَىٰ وَهُوَ يَخْشَىٰ فَأَنتَ عَنْهُ تَلَهَّىٰ» (عبس/۸۰:۱–۱۰)",
   "kind": "quote",
   "chapter": 1,
   "block": 7,
   "translation": "چهره درهم کشید و روی گرداند، چون آن نابینا نزد او آمد. تو چه می‌دانی؟ شاید او پاک شود، یا متذکر شود و تذکر به او سود دهد. اما کسی که خود را بی‌نیاز می‌بیند، تو به او می‌پردازی؛ و بر تو نیست اگر پاک نشود. و اما کسی که شتابان نزد تو می‌آید و می‌ترسد، تو از او روی‌گردان می‌شوی."
  },
  {
   "i": 7,
   "start": 2.96,
   "end": 3.46,
   "text": "«فَقَالَ الْمَلَأُ الَّذِينَ كَفَرُوا مِن قَوْمِهِ مَا نَرَاكَ إِلَّا بَشَرًا مِّثْلَنَا وَمَا",
   "kind": "quote",
   "chapter": 1,
   "block": 9
  },
  {
   "i": 8,
   "start": 2.96,
   "end": 3.46,
   "text": "نَرَاكَ اتَّبَعَكَ إِلَّا الَّذِينَ هُمْ أَرَاذِلُنَا بَادِيَ الرَّأْيِ» (هود/۱۱:۲۷)",
   "kind": "quote",
   "chapter": 1,
   "block": 9,
   "translation": "اشراف کافر قومش گفتند: ما تو را جز بشری مانند خود نمی‌بینیم، و نمی‌بینیم که جز فرومایگانِ ما — با رأی سطحی — از تو پیروی کرده باشند."
  },
  {
   "i": 9,
   "start": 2.96,
   "end": 3.46,
   "text": "«وَيَا قَوْمِ لَا أَسْأَلُكُمْ عَلَيْهِ مَالًا إِنْ أَجْرِيَ إِلَّا عَلَى اللَّهِ وَمَا أَنَا",
   "kind": "quote",
   "chapter": 1,
   "block": 11
  },
  {
   "i": 10,
   "start": 2.96,
   "end": 3.46,
   "text": "بِطَارِدِ الَّذِينَ آمَنُوا» (هود/۱۱:۲۹)",
   "kind": "quote",
   "chapter": 1,
   "block": 11,
   "translation": "ای قوم من، برای این رسالت مالی از شما نمی‌خواهم؛ مزد من تنها بر خداست، و من طردکنندهٔ مؤمنان نیستم."
  },
  {
   "i": 11,
   "start": 2.96,
   "end": 3.46,
   "text": "«وَلَمَّا جَاءَ مُوسَىٰ لِمِيقَاتِنَا وَكَلَّمَهُ رَبُّهُ قَالَ رَبِّ أَرِنِي أَنظُرْ إِلَيْكَ",
   "kind": "quote",
   "chapter": 1,
   "block": 13
  },
  {
   "i": 12,
   "start": 2.96,
   "end": 3.46,
   "text": "قَالَ لَن تَرَانِي وَلَٰكِنِ انظُرْ إِلَى الْجَبَلِ فَإِنِ اسْتَقَرَّ مَكَانَهُ فَسَوْفَ تَرَانِي",
   "kind": "quote",
   "chapter": 1,
   "block": 13
  },
  {
   "i": 13,
   "start": 2.96,
   "end": 3.46,
   "text": "فَلَمَّا تَجَلَّىٰ رَبُّهُ لِلْجَبَلِ جَعَلَهُ دَكًّا وَخَرَّ مُوسَىٰ صَعِقًا فَلَمَّا أَفَاقَ",
   "kind": "quote",
   "chapter": 1,
   "block": 13
  },
  {
   "i": 14,
   "start": 2.96,
   "end": 3.46,
   "text": "قَالَ سُبْحَانَكَ تُبْتُ إِلَيْكَ وَأَنَا أَوَّلُ الْمُؤْمِنِينَ» (اعراف/۷:۱۴۳)",
   "kind": "quote",
   "chapter": 1,
   "block": 13,
   "translation": "چون موسی به میقات ما آمد و پروردگارش با او سخن گفت، گفت: پروردگارا، خودت را به من بنما تا به تو بنگرم. فرمود: هرگز مرا نخواهی دید؛ ولی به کوه بنگر؛ اگر بر جای خود آرام گرفت، به‌زودی مرا خواهی دید…"
  },
  {
   "i": 15,
   "start": 2.96,
   "end": 3.46,
   "text": "«وَإِذْ قَالَ إِبْرَاهِيمُ رَبِّ أَرِنِي كَيْفَ تُحْيِي الْمَوْتَىٰ قَالَ أَوَلَمْ تُؤْمِن",
   "kind": "quote",
   "chapter": 1,
   "block": 15
  },
  {
   "i": 16,
   "start": 2.96,
   "end": 3.46,
   "text": "قَالَ بَلَىٰ وَلَٰكِن لِّيَطْمَئِنَّ قَلْبِي» (بقره/۲:۲۶۰)",
   "kind": "quote",
   "chapter": 1,
   "block": 15,
   "translation": "و هنگامی که ابراهیم گفت: پروردگارا، به من بنما چگونه مردگان را زنده می‌کنی؟ فرمود: مگر ایمان نیاورده‌ای؟ گفت: آری، ولی تا دلم آرام گیرد."
  },
  {
   "i": 17,
   "start": 2.96,
   "end": 3.46,
   "text": "«ذِكْرُ رَحْمَتِ رَبِّكَ عَبْدَهُ زَكَرِيَّا إِذْ نَادَىٰ رَبَّهُ نِدَاءً خَفِيًّا» (مریم/۱۹:۲–۳)",
   "kind": "quote",
   "chapter": 1,
   "block": 17,
   "translation": "یاد رحمت پروردگارت بر بنده‌اش زکریا؛ هنگامی که پروردگارش را با ندایی نهان خواند."
  },
  {
   "i": 18,
   "start": 2.96,
   "end": 3.46,
   "text": "«أَمْ حَسِبْتُمْ أَن تَدْخُلُوا الْجَنَّةَ وَلَمَّا يَأْتِكُم مَّثَلُ الَّذِينَ خَلَوْا مِن",
   "kind": "quote",
   "chapter": 1,
   "block": 19
  },
  {
   "i": 19,
   "start": 2.96,
   "end": 3.46,
   "text": "قَبْلِكُم مَتَىٰ نَصْرُ اللَّهِ أَلَا إِنَّ نَصْرَ اللَّهِ قَرِيبٌ» (بقره/۲:۲۱۴)",
   "kind": "quote",
   "chapter": 1,
   "block": 19,
   "translation": "آیا پنداشتید وارد بهشت می‌شوید در حالی که هنوز مانند آنچه بر پیشینیان گذشت بر شما نیامده… تا آنجا که پیامبر و مؤمنان با او گفتند: یاری خدا کی است؟ بدانید یاری خدا نزدیک است."
  },
  {
   "i": 20,
   "start": 2.96,
   "end": 7.16,
   "text": "سلام علیکم و رحمة الله.",
   "kind": "speech",
   "chapter": 2,
   "block": 22
  },
  {
   "i": 21,
   "start": 7.16,
   "end": 9.42,
   "text": "أعوذ بالله من الشيطان الرجيم.",
   "kind": "speech",
   "chapter": 2,
   "block": 22
  },
  {
   "i": 22,
   "start": 9.42,
   "end": 14.12,
   "text": "بسم الله الرحمن الرحيم، و به نستعين.",
   "kind": "speech",
   "chapter": 2,
   "block": 22
  },
  {
   "i": 23,
   "start": 14.12,
   "end": 19.0,
   "text": "وصلى الله على سيدنا محمد و آله الطاهرين.",
   "kind": "speech",
   "chapter": 2,
   "block": 22
  },
  {
   "i": 24,
   "start": 19.0,
   "end": 25.14,
   "text": "اللهم صل على محمد و آل محمد.",
   "kind": "speech",
   "chapter": 2,
   "block": 22
  },
  {
   "i": 25,
   "start": 25.14,
   "end": 37.1,
   "text": "جهت شادی ارواح طیبه شهدا، روح حضرت امام، همه گذشتگان، ذوي الحقوق، پدر، مادرمون، معلمانمون.",
   "kind": "speech",
   "chapter": 2,
   "block": 22
  },
  {
   "i": 26,
   "start": 37.1,
   "end": 39.6,
   "text": "الفاتحة مع الصلاة.",
   "kind": "speech",
   "chapter": 2,
   "block": 22
  },
  {
   "i": 27,
   "start": 39.6,
   "end": 59.6,
   "text": "اللهم صل على محمد و آل محمد.",
   "kind": "speech",
   "chapter": 2,
   "block": 22
  },
  {
   "i": 28,
   "start": 66.22,
   "end": 80.24,
   "text": "در جریان بحث انسان کامل و آیات مربوط به انسان وقتی که به آیات عصیان آدم رسیدیم،",
   "kind": "speech",
   "chapter": 2,
   "block": 22
  },
  {
   "i": 29,
   "start": 80.24,
   "end": 94.74,
   "text": "یه فصل مشبعی رو باز کردیم و راجع به تمام آنچه که به عنوان خطاهای انبیا در قرآن ازش یاد می‌شه،",
   "kind": "speech",
   "chapter": 2,
   "block": 22
  },
  {
   "i": 30,
   "start": 94.74,
   "end": 105.0,
   "text": "این‌ها رو یه صحبتی راجع بهش داشتیم و انشاالله هم این جلسه به نظر میاد که جلسه آخر این بحث باشه.",
   "kind": "speech",
   "chapter": 2,
   "block": 22
  },
  {
   "i": 31,
   "start": 105.0,
   "end": 113.26,
   "text": "یعنی اینکه حالا من دیگه تو این استقصایی که کردم خطای دیگری پیدا نکردم.",
   "kind": "speech",
   "chapter": 2,
   "block": 22
  },
  {
   "i": 32,
   "start": 113.26,
   "end": 128.66,
   "text": "حالا مگه اینکه جدیداً یه چیزای دیگه کشف بشه ولی، خب یه سری‌شو می‌شد به عنوان ترک اولی پذیرفت مثل حضرت یونس و کثیری از اون‌هایی رو که نسبت میدن",
   "kind": "speech",
   "chapter": 2,
   "block": 22
  },
  {
   "i": 33,
   "start": 128.66,
   "end": 135.52,
   "text": "اصلاً قابل پذیرش نیست و دقت در محتوای خود آیات هم همین رو نشون میده.",
   "kind": "speech",
   "chapter": 2,
   "block": 22
  },
  {
   "i": 34,
   "start": 135.52,
   "end": 154.97,
   "text": "اون فایلی رو که جلسه گذشته باز کردیم و یعنی که غضب‌های بیجا نمونه آخرش هم این هست که البته این سوره مبارکه عبس.",
   "kind": "speech",
   "chapter": 2,
   "block": 22
  },
  {
   "i": 35,
   "start": 154.97,
   "end": 173.16,
   "text": "سوره مبارکه عبس، که صفحهٔ ۵۸۵.",
   "kind": "speech",
   "chapter": 2,
   "block": 22
  },
  {
   "i": 36,
   "start": 173.16,
   "end": 175.44,
   "text": "بسم الله الرحمن الرحیم.",
   "kind": "speech",
   "chapter": 2,
   "block": 22
  },
  {
   "i": 37,
   "start": 175.44,
   "end": 180.92,
   "text": "شما می‌خونید سوره های.",
   "kind": "speech",
   "chapter": 2,
   "block": 22
  },
  {
   "i": 38,
   "start": 180.92,
   "end": 188.62,
   "text": "این آیات ابتدای سوره عبس رو گفتن که راجع به وجود مبارک پیغمبر اکرمه.",
   "kind": "speech",
   "chapter": 2,
   "block": 22
  },
  {
   "i": 39,
   "start": 188.62,
   "end": 194.1,
   "text": "تقریباً یک نوع توبیخ پیامبر اکرمه.",
   "kind": "speech",
   "chapter": 2,
   "block": 22
  },
  {
   "i": 40,
   "start": 194.1,
   "end": 209.22,
   "text": "که مشغول صحبت با یکی از سران قریش بودند که یه کوری وارد مثلا اون مسجد میشه یا اون محوطه میشه و هی می‌خواد از پیغمبر سوالی بکنه.",
   "kind": "speech",
   "chapter": 2,
   "block": 22
  },
  {
   "i": 41,
   "start": 209.22,
   "end": 214.22,
   "text": "پیغمبرم خیلی تحویلش نمی‌گیرن.",
   "kind": "speech",
   "chapter": 2,
   "block": 22
  },
  {
   "i": 42,
   "start": 214.22,
   "end": 217.1,
   "text": "بعد این آیات نازل میشه.",
   "kind": "speech",
   "chapter": 2,
   "block": 22
  },
  {
   "i": 43,
   "start": 217.1,
   "end": 223.528,
   "text": "«عَبَسَ وَتَوَلَّىٰ أَن جَاءَهُ الْأَعْمَىٰ» (عبس/۸۰:۱–۲)",
   "kind": "speech",
   "chapter": 2,
   "block": 22
  },
  {
   "i": 44,
   "start": 223.528,
   "end": 224.752,
   "text": "عبس ۱–۱۰؛ هود",
   "kind": "speech",
   "chapter": 3,
   "block": 45
  },
  {
   "i": 45,
   "start": 224.752,
   "end": 225.22,
   "text": "۲۷",
   "kind": "speech",
   "chapter": 3,
   "block": 45
  },
  {
   "i": 46,
   "start": 225.22,
   "end": 226.42,
   "text": "و",
   "kind": "speech",
   "chapter": 3,
   "block": 45
  },
  {
   "i": 47,
   "start": 226.42,
   "end": 246.42,
   "text": "۲۹؛",
   "kind": "speech",
   "chapter": 3,
   "block": 45
  },
  {
   "i": 48,
   "start": 406.74,
   "end": 426.74,
   "text": "شعراء",
   "kind": "speech",
   "chapter": 3,
   "block": 45
  },
  {
   "i": 49,
   "start": 587.06,
   "end": 607.06,
   "text": "۱۱۱؛",
   "kind": "speech",
   "chapter": 3,
   "block": 45
  },
  {
   "i": 50,
   "start": 767.38,
   "end": 787.38,
   "text": "نامه",
   "kind": "speech",
   "chapter": 3,
   "block": 45
  },
  {
   "i": 51,
   "start": 947.74,
   "end": 951.844,
   "text": "عثمان بن حنیف؛ نهج خطبه ۱۶۰؛",
   "kind": "speech",
   "chapter": 3,
   "block": 45
  },
  {
   "i": 52,
   "start": 951.844,
   "end": 953.596,
   "text": "نجم ۸–۱۳؛",
   "kind": "speech",
   "chapter": 3,
   "block": 45
  },
  {
   "i": 53,
   "start": 953.596,
   "end": 955.348,
   "text": "اعراف ۱۴۳–۱۴۴؛",
   "kind": "speech",
   "chapter": 3,
   "block": 45
  },
  {
   "i": 54,
   "start": 955.348,
   "end": 959.728,
   "text": "بقره ۵۵، ۱۴۴، ۲۱۴، ۲۵۸–۲۶۰؛",
   "kind": "speech",
   "chapter": 3,
   "block": 45
  },
  {
   "i": 55,
   "start": 959.728,
   "end": 962.84,
   "text": "انعام ۷۵ و ۱۰۳؛",
   "kind": "speech",
   "chapter": 3,
   "block": 45
  },
  {
