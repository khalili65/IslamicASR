 "cues": [
  {
   "i": 0,
   "start": 0.38,
   "end": 7.04,
   "text": "بسم الله الرحمن الرحيم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 7.04,
   "end": 10.56,
   "text": "قل هو الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 10.56,
   "end": 13.36,
   "text": "أحد. به نام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 13.36,
   "end": 17.18,
   "text": "خداوند بخشایشگر مهربان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 17.18,
   "end": 37.18,
   "text": "بگو خدا یک است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 40.84,
   "end": 49.52,
   "text": "توحیدنامه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 49.52,
   "end": 52.14,
   "text": "با بیانات حضرت آیت الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 52.14,
   "end": 68.82,
   "text": "محمد شجاعی. مقصود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 68.82,
   "end": 71.36,
   "text": "از بحث توحید صفت از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 71.36,
   "end": 73.54,
   "text": "معرفت خدای متعال،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 73.54,
   "end": 81.2,
   "text": "صفات خدای متعال و افعال خدای متعال به یک بیان دیگر به اصطلاح معرفت و حضانیت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 81.2,
   "end": 87.0,
   "text": "ذات مقدس حق و اینکه جز ذات او ذاتی نیست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 87.0,
   "end": 107.0,
   "text": "و جز صفات او صفاتی نیست و جز افعال او افعالی نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 107.98,
   "end": 111.54,
   "text": "بسم الله الرحمن الرحیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 111.54,
   "end": 114.64,
   "text": "خداوندا بر محمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 114.64,
   "end": 117.02,
   "text": "و آلش درود فرست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 117.02,
   "end": 121.26,
   "text": "و ایمان مرا به کمال مطلوب برسان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 121.26,
   "end": 125.28,
   "text": "یقین مرا برترین یقین گردان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 125.28,
   "end": 129.1,
   "text": "نیت مرا به بهترین نیتها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 129.1,
   "end": 135.56,
   "text": "و کارهای مرا به نیکوترین کارها منتهی گردان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 135.56,
   "end": 138.34,
   "text": "خدایا به لطف خود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 138.34,
   "end": 145.38,
   "text": "نیت مرا خالص گردان و به آنچه نزد توست یقینم را تصحیح نما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 145.38,
   "end": 152.54,
   "text": "و به قدرت خود کارهای تباه مرا سامان بخش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 152.54,
   "end": 158.0,
   "text": "دوستان قرآنی سلام. ویژه برنامه توحیدنامه را می‌شنوید از شبکه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 158.0,
   "end": 163.52,
   "text": "رادیویی قرآن و بهره‌مند می‌شوید از بیانات عالمانه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 163.52,
   "end": 170.54,
   "text": "دانشمند فرزانه حضرت آیت الله محمد شجاعی درباره توحید خداوند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 170.54,
   "end": 177.58,
   "text": "یا الله الله سبحان الله الحمد لله الله الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 177.58,
   "end": 184.62,
   "text": "یا الله الله سبحان الله الحمد لله الله الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 184.62,
   "end": 191.26,
   "text": "منور النور مدبر النور خالق النور مقدر النور.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 191.26,
   "end": 198.66,
   "text": "یا منور النور مدبر النور خالق النور مقدر النور.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 198.66,
   "end": 205.7,
   "text": "یا الله الله سبحان الله الحمد لله الله الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 205.7,
   "end": 212.7,
   "text": "یا الله الله سبحان الله الحمد لله الله الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 212.7,
   "end": 216.18,
   "text": "يا مَن إليْ يهرع الخائفون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 216.18,
   "end": 219.72,
   "text": "يا مَن إليْ يفتعل المذنبون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 219.72,
   "end": 223.39,
   "text": "يا مَن إليْ يقصد المنيبون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 223.39,
   "end": 229.04,
   "text": "يا مَن إليْ يرجو السائلون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 229.04,
   "end": 232.6,
   "text": "يا مَن إليْ يسكن الموغلون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 232.6,
   "end": 236.12,
   "text": "يا مَن بهِ يستانس المريدون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 236.12,
   "end": 243.14,
   "text": "يا الله الله سبحان الله الحمد لله الله الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 243.14,
   "end": 250.16,
   "text": "يا الله الله سبحان الله الحمد لله الله الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 250.16,
   "end": 258.08,
   "text": "يا الله الله سبحان الله الحمد لله الله الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 258.08,
   "end": 269.26,
   "text": "همراهان گرامی، حضرت آیت الله محمد شجاعی در برنامه گذشته فرمودند تمام ضررها و بدی‌هایی که به انسان‌ها می‌رسد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 269.26,
   "end": 278.86,
   "text": "به دلیل اراده و انتخاب آنها و اینکه مسیر غلط در پیش گرفته‌اند و ظلم و گناه کرده‌اند می‌باشد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 278.86,
   "end": 285.42,
   "text": "چنانکه خداوند در آیه سی و شش سوره مبارکه روم می‌فرماید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 285.42,
   "end": 296.92,
   "text": "وقتی به مردم رحمتی چشاندیم با آن شاد می‌شوند و اگر بدی به آنها برسد به جهت آنچه که خود انجام داده‌اند،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 296.92,
   "end": 300.94,
   "text": "آن وقت مأیوس می‌شوند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 300.94,
   "end": 310.94,
   "text": "و در سوره مبارکه مائده نیز خداوند خطاب به رسول اکرم صلی الله علیه و آله و سلم می‌فرماید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 310.94,
   "end": 316.36,
   "text": "بین مردم با آنچه خدا نازل کرده است حکم کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 316.36,
   "end": 319.42,
   "text": "تابع هوی و هوس نباش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 319.42,
   "end": 322.34,
   "text": "اگر آنها به آن حکم راضی نشدند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 322.34,
   "end": 326.02,
   "text": "و سرپیچی کردند، ناراحت نباش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 326.02,
   "end": 334.64,
   "text": "بدان سری هست که آن سر عبارت است از اینکه خدا می‌خواهد به خاطر بعضی از گناهانشان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 334.64,
   "end": 342.26,
   "text": "سیئه و بدی برایشان بفرستد و رحمت‌ها را از آنها دور کند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 342.26,
   "end": 346.62,
   "text": "بنابراین بدی‌هایی که به انسان‌ها می‌رسد نتیجه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 346.62,
   "end": 349.94,
   "text": "اعمال خود انسان‌هاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 349.94,
   "end": 359.06,
   "text": "خب دوستان اکنون توجه شما را جلب می‌کنیم به بیانات عالمانه عالم فرزانه حضرت آیت الله محمد شجاعی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 359.06,
   "end": 361.08,
   "text": "درباره توحید صفاتی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 361.08,
   "end": 364.66,
   "text": "خداوند با ما همراه باشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 364.66,
   "end": 366.78,
   "text": "توحیدی که می‌شود گفت که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 366.78,
   "end": 369.1,
   "text": "دنباله همین مسئله توحید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 369.1,
   "end": 375.02,
   "text": "نظری و بعد توحید ذاتی، توحید عملی به اصطلاح",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 375.02,
   "end": 378.36,
   "text": "و یکی از معانی توحید است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 378.36,
   "end": 386.19,
   "text": "یعنی در واقع باید گفت توحید ذاتی و توحید نظری و توحید عملی یا توحید افعال و اوصافی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 386.19,
   "end": 391.36,
   "text": "این سه مرحله از توحید بخش جدا‌ناپذیری از معانی توحید است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 391.36,
   "end": 396.2,
   "text": "در هر صورت در این جلسه من می‌خواستم توحید عملی یا اوصافی را توضیح دهم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 396.2,
   "end": 402.22,
   "text": "انشاالله به تفیض الهی این هم بحثی جدا و دقیق و در عین حال از معانی توحید است و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 402.22,
   "end": 405.9,
   "text": "شناختنش برای ارباب معرفت لازم است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 405.9,
   "end": 412.12,
   "text": "توحید اوصافی یا عملی مانند توحید نظری مقتضا و مفهومش این است که همه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 412.12,
   "end": 416.12,
   "text": "صفات کمال که در نظام وجود و هستی دیده می‌شود،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 416.12,
   "end": 418.72,
   "text": "همه صفات کمال، همه کمالات،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 418.72,
   "end": 422.36,
   "text": "صفات کمالی، همه از آن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 422.36,
   "end": 430.18,
   "text": "ذات مقدس حق است و به اصطلاح در موجوداتی که به ظاهر manifest شده می‌شود یا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 430.18,
   "end": 433.58,
   "text": "در موجوداتی که به ظاهر دیده می‌شود در مخلوقات،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 433.58,
   "end": 437.86,
   "text": "حقیقت این کمالات به ذات مقدس حق می‌رسد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 437.86,
   "end": 441.9,
   "text": "از کمالات و صفات کمالی حق نشأت می‌گیرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 441.9,
   "end": 450.48,
   "text": "هیچ موجودی کمالی از کمالات یا صفتی از صفات کمالی را به ذات و به نفسه مستقلاً واجد نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 450.48,
   "end": 456.66,
   "text": "آنچه از کمالات در موجودات دیده می‌شود، یعنی صفات کمالی، اینها همش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 456.66,
   "end": 461.38,
   "text": "تابش‌ها یا جلوهات و تجلیات است منتها در مراتب مختلف.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 461.38,
   "end": 467.22,
   "text": "جلوهات و تجلیات و تابش‌های در مراتب مختلف است از صفات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 467.22,
   "end": 471.12,
   "text": "کمالی ذات مقدس حق یا از کمالات حق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 471.12,
   "end": 477.6,
   "text": "در بیان دیگر باید اینطور گفت که اصل همه کمالات را ذات مقدس حق دارد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 477.6,
   "end": 483.38,
   "text": "و آنچه از کمالات وجودی از صفات کمال در موجودات و مخلوقات دیده می‌شود،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 483.38,
   "end": 488.64,
   "text": "اینها تابش‌های همان کمالاتی است که اصلش برای خدا ثابت است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 488.64,
   "end": 493.7,
   "text": "و برای هیچ کدام از موجودات کمالی بی ذات و بی نفسه ثابت نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 493.7,
   "end": 496.02,
   "text": "تابش است فقط. تجلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 496.02,
   "end": 499.08,
   "text": "است. تجلی اینها در مراتب مختلف.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 499.08,
   "end": 503.08,
   "text": "مثلاً از باب مثال از اینجا حالا چند تا مثال از این بحث هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 503.08,
   "end": 506.92,
   "text": "حوزه مسئله را از روی اشارات و نکات پایه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 506.92,
   "end": 514.86,
   "text": "ادامه دهیم. مثلاً علمی که در انسان دیده می‌شود یا علمی که در موجود دیگر دیده می‌شود یا علمی که در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 514.86,
   "end": 519.0,
   "text": "موجودات بالاتر از انسان مانند موجودات مقرب،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 519.0,
   "end": 526.18,
   "text": "ملائکه و موجودات بالاتر دیده می‌شود، در مراتب مختلف این علم انسان و علم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 526.18,
   "end": 533.42,
   "text": "موجودات غیر از انسان و علم موجودات بالاتر از انسان، علمی به عنوان اینکه صفتی از صفات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 533.42,
   "end": 540.94,
   "text": "کمال و کمالی از کمالات وجودی برای اینها ثابت نیست بی نفسه و به ذات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 540.94,
   "end": 544.62,
   "text": "مستقلاً اینها واجد این کمال نیستند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 544.62,
   "end": 551.4,
   "text": "این کمال علم در اینها تابشی است از علم خدای متعال در مراتب مختلف.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 551.4,
   "end": 554.7,
   "text": "انسان در مرتبه‌ای از این تابش برخوردار است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 554.7,
   "end": 560.42,
   "text": "موجودی که ضعیف‌تر از انسان است در مرتبه ضعیف‌تر از این تابش برخوردار است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 560.42,
   "end": 568.88,
   "text": "ملکی که بالاتر از انسان است چون قابلیت بیشتر دارد، او بیشتر از انسان برخوردار از این تابش است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 568.88,
   "end": 579.3,
   "text": "همه تابش‌هایی در مراتب مختلف از علم خدا، از صفت علم خدا، از کمال علمی ذات مقدس حق، تابش‌هاست فقط.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 579.3,
   "end": 587.12,
   "text": "آنچه مالک علم است و دارای علم است آن هم بی‌حد و بی‌نهایت ذات مقدس حق است که به ذات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 587.12,
   "end": 591.14,
   "text": "واجد علم است، صاحب علم است و مالک علم است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 591.14,
   "end": 593.98,
   "text": "و این علومی که در موجودات دیگر در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 593.98,
   "end": 598.94,
   "text": "مراتب مختلف جلوه کرده است، اینها تابش‌های در مراتب مختلف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 598.94,
   "end": 605.34,
   "text": "علم حق است که این موجودات به اندازه قابلیت خودشان از آن تابش‌ها برخوردار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 605.34,
   "end": 608.28,
   "text": "هستند. در حقیقت تابش علم خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 608.28,
   "end": 610.95,
   "text": "علوم مخلوقات، علم از آن خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 610.95,
   "end": 616.44,
   "text": "اینها هم تابش‌های علم خداست که در موجودات به اندازه خودشان ظهور کرده است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 616.44,
   "end": 619.48,
   "text": "مستقلاً مالک نیستند. دلیلش هم این است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 619.48,
   "end": 622.94,
   "text": "که انسان قبلاً علمی ندارد، بعد واجد علم می‌شود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 622.94,
   "end": 625.22,
   "text": "احیاناً فاقد علم هم می‌شه--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 625.22,
   "end": 629.0,
   "text": "می‌شود یا نمی‌شود؟ احیاناً فاقد علم هم می‌شود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 629.0,
   "end": 632.26,
   "text": "حالا بعداً آیاتی می‌خوانیم اینها را توضیح خواهد داد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 632.26,
   "end": 636.15,
   "text": "یا موجودات دیگر هم همینطور. آن اندازه‌ای که ما از موجودات مخلوقات می‌بینیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 636.15,
   "end": 638.91,
   "text": "اینطور می‌بینیم مسلماً همه موجودات این چنین هستند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 638.91,
   "end": 645.52,
   "text": "یعنی به ذات بی نفسه مالک این علم نیستند، صاحب علم نیستند، دارای علم نیستند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 645.52,
   "end": 649.64,
   "text": "تابشی است در اینها در یک شرایط مخصوصی بر اینها می‌تابد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 649.64,
   "end": 653.04,
   "text": "آن هم در حد معین به اندازه قابلیت اینها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 653.04,
   "end": 655.14,
   "text": "که اگر این شرایط از بین رفت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 655.14,
   "end": 657.84,
   "text": "آن تابش هم به اصطلاح برچیده می‌شود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 657.84,
   "end": 664.22,
   "text": "این شاهدش آن اندازه‌ای است که ما در انسان‌ها می‌بینیم و در موجودات دیگر که مقصود ماست می‌بینیم خیلی روشن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 664.22,
   "end": 667.16,
   "text": "است. یا مثلاً قدرت، توانایی، قدرت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 667.16,
   "end": 670.98,
   "text": "توان و قدرت، مسئله کمال از کمالات وجودی، صفات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 670.98,
   "end": 676.18,
   "text": "از صفات کمال در انسان و در موجودات دیگر در مراتب مختلف دیده می‌شود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 676.18,
   "end": 679.44,
   "text": "در موجودات بالاتر از انسان هم بالاتر دیده می‌شود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 679.44,
   "end": 684.66,
   "text": "این هم باز مانند علم از وجود بی ذات و بی نفسه دارای این کمال نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 684.66,
   "end": 689.34,
   "text": "به دلیل اینکه نبود و بعد واجد می‌شود و بعد هم فاقد می‌گردد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 689.34,
   "end": 692.78,
   "text": "این هم در درجات مختلف باز معلوم است که قدرت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 692.78,
   "end": 699.06,
   "text": "مصدرش از آن ذات مقدس حق است و این قدرت‌ها در مراتب مختلفی در موجودات دیده می‌شود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 699.06,
   "end": 706.9,
   "text": "اینها تابش‌هایی است از قدرت ذات مقدس حق که این موجودات به اندازه قابلیت خودشان ظهور کرده‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 706.9,
   "end": 710.22,
   "text": "مسئله جمال و زیبایی همچنین و هر صفتی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 710.22,
   "end": 714.98,
   "text": "را شما که حساب کنید به عنوان صفت کمال تحلیلت از همین قرار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 714.98,
   "end": 718.22,
   "text": "است. معنیش این می‌شود که صفات کمال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 718.22,
   "end": 721.0,
   "text": "مختص چه؟ مختص",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 721.0,
   "end": 727.34,
   "text": "ذات مقدس حق است. هر چه کمال در وجود است، هر صفت کمالی در نظام وجود است،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 727.34,
   "end": 729.68,
   "text": "همه این صفات کمال،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 729.68,
   "end": 732.02,
   "text": "صفات ذات مقدس حق است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 732.02,
   "end": 735.61,
   "text": "منتها نبینیم انا که عموماً صفت خداست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 735.61,
   "end": 738.55,
   "text": "علماً تابشی است از علم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 738.55,
   "end": 741.97,
   "text": "خدا و در واقع این علم را من ندارم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 741.97,
   "end": 743.79,
   "text": "اصلش را چه کسی دارد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 743.79,
   "end": 748.27,
   "text": "خدای متعال اصلش را نه با این حدود، نه با این محدودیت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 748.27,
   "end": 751.59,
   "text": "خب حالا این کلی قضیه بود که عرض کردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 751.59,
   "end": 755.71,
   "text": "گفتم این دارم ظریفت و بعضی جاهاش هست که مورد لغزش است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 755.71,
   "end": 760.49,
   "text": "باید خیلی دقت کرد. نمیخواد بگی لغزش به این صورت می‌شود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 760.49,
   "end": 763.89,
   "text": "من بگم علمی که من دارم علم من مثل علم خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 763.89,
   "end": 766.01,
   "text": "اینجا اگر به این معنی بگم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 766.01,
   "end": 770.73,
   "text": "که علمی که من دارم با حدود معین که محدود است و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 770.73,
   "end": 781.59,
   "text": "بسیار آمیخته به ندانستن‌ها و فقدان علم با همین حدود و با همین محدودیت، این علم من با همین محدودیت سمت چه باشد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 781.59,
   "end": 784.33,
   "text": "سمت خدا باشد. این انحراف است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 784.33,
   "end": 786.14,
   "text": "و این ضلالت. اینطور نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 786.14,
   "end": 789.25,
   "text": "علم خدا چیه؟ علم بی‌نهایت است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 789.25,
   "end": 791.77,
   "text": "مطلق است. هیچ عدی درش نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 791.77,
   "end": 794.25,
   "text": "علم است محض. لا جهل فیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 794.25,
   "end": 796.49,
   "text": "اما علم من کلاً با جهل است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 796.49,
   "end": 798.23,
   "text": "و جهلش هم بی‌نهایت است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 798.23,
   "end": 805.57,
   "text": "علمش خیلی محدود است. علم من با اون حدود اگر سمت خدا باشد از آن خدا باشد درست نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 805.57,
   "end": 813.55,
   "text": "اما علم من به عنوان اینکه تابشی است به اندازه‌ای که من قابلیت دارم قبول کردم از علم مطلق خدا و طبعا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 813.55,
   "end": 816.89,
   "text": "معنیش این می‌شود که علم از آن خداست نه از آن من.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 816.89,
   "end": 819.41,
   "text": "این معنی صحیح توحید،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 819.41,
   "end": 822.75,
   "text": "فراخ و توحید وسیع دقت می‌کنید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 822.75,
   "end": 827.31,
   "text": "خیلی باید دقت کرد که نه به لغزش افتاد و نه به شرک مبتلا شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 827.31,
   "end": 833.13,
   "text": "شرک به این معنا که ما موجودی را find out و به نفس دارای علم بدانیم نه خیر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 833.13,
   "end": 837.73,
   "text": "علم ذاتاً به عنوان اینکه مالکش کیست و صاحبش کیست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 837.73,
   "end": 840.19,
   "text": "صاحب علم کیست؟ فقط خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 840.19,
   "end": 842.13,
   "text": "علمی جز برای خدا نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 842.13,
   "end": 845.95,
   "text": "این علوم که در موجودات دیده می‌شود تابش‌هایی است از کلام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 845.95,
   "end": 849.63,
   "text": "دلیلش همین است گفتم نبود و می‌شود و بعد هم از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 849.63,
   "end": 853.39,
   "text": "میان می‌رود. برای اینکه من اول آیاتی از قرآن را می‌خوانم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 853.39,
   "end": 857.95,
   "text": "اونها با یک توجیه مخصوص که به این مسئله طولش را دقت بفرمایید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 857.95,
   "end": 861.85,
   "text": "که توضیحش هم از خود مسئله می‌شود دقیق‌تر است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 861.85,
   "end": 865.75,
   "text": "خیلی دقت بفرمایید. عرض کنم که قرآن کریم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 865.75,
   "end": 868.15,
   "text": "آیاتی دارد به این مضمون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 868.15,
   "end": 872.65,
   "text": "راهی تمام اونچه از به اصطلاح کمال خوبی‌ها،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 872.65,
   "end": 875.45,
   "text": "کمالات وجودی در روی زمین دیده می‌شود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 875.45,
   "end": 879.23,
   "text": "حالا رو سخن که با زمینی‌هاست با انسان‌هاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 879.23,
   "end": 885.63,
   "text": "همه کمالات وجودی که در روی زمین دیده می‌شود همه اینها را تابشی می‌داند که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 885.63,
   "end": 888.31,
   "text": "تابیده است و مدتی زوال دارد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 888.31,
   "end": 891.37,
   "text": "و بعد از میان برچیده خواهد شد و می‌شود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 891.37,
   "end": 896.35,
   "text": "راه اینطور بیان دارد. خب می‌خواهد به ما حقیقت را بفهماند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 896.35,
   "end": 900.95,
   "text": "عرض کنم که آیه هفت و هشت سوره کهف این موضوع بیان می‌کند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 900.95,
   "end": 905.13,
   "text": "\"إِنَّا جَعَلْنَا مَا عَلَى الْأَرْضِ زِينَةً لَهَا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 905.13,
   "end": 908.25,
   "text": "لِنَبْلُوَهُمْ أَيُّهُمْ أَحْسَنُ عَمَلًا\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 908.25,
   "end": 910.69,
   "text": "این آیه عشر است در سوره کهف.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 910.69,
   "end": 917.33,
   "text": "آیه هشتم اینطور بیان می‌فرماید \"وَإِنَّا لَجَاعِلُونَ مَا عَلَيْهَا صَعِدًا جُرُزًا\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 917.33,
   "end": 924.29,
   "text": "ما آنچه در روی زمین شما از کمالات و خوبی‌ها و حسنی‌ها می‌بینید \"إِنَّا جَاعِلُونَ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 924.29,
   "end": 928.47,
   "text": "مَا عَلَى الْأَرْضِ زِينَةً لَهَا\" ما اینجا زینتی در اینجا قرار داده‌ایم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 928.47,
   "end": 932.41,
   "text": "معنی این زینت را اگر دقت کنید این است که پایداری ندارد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 932.41,
   "end": 935.01,
   "text": "دقت می‌کنید؟ اثاتی है",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 935.01,
   "end": 941.25,
   "text": "ندارد. تابشی است و اثاث ندارد و یک مقداری تابش است اثاث ندارد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 941.25,
   "end": 943.59,
   "text": "این میگن زینت معنی زینت این است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 943.59,
   "end": 948.07,
   "text": "تعبیر، تعبیر قرآن است و کلام است و برای همه تعبیرات مصداق است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 948.07,
   "end": 951.89,
   "text": "ما آنچه در زمین دیده می‌شود اینها را زینت قرار دادیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 951.89,
   "end": 955.49,
   "text": "زینت تابشی است که پایداری ندارد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 955.49,
   "end": 958.06,
   "text": "اثاث هم ندارد. فرسوده شود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 958.06,
   "end": 961.49,
   "text": "شما را \"لِنَبْلُوَهُمْ\" تا این انسان‌ها را ما می‌خواهیم امتحان کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 961.49,
   "end": 968.53,
   "text": "\"أَيُّهُمْ أَحْسَنُ عَمَلًا\" چه کسی دل به تابش داده است و چه کسی دل به صادر تابش داده است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 968.53,
   "end": 970.71,
   "text": "دقت می‌کنید؟ آن امتحان کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 970.71,
   "end": 976.77,
   "text": "و اینا به حقیقت این است که ما خدا \"وَإِنَّا لَجَاعِلُونَ مَا عَلَيْهَا صَعِدًا جُرُزًا\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 976.77,
   "end": 983.33,
   "text": "آنچه در اینجا از خوبی‌ها و کمالات می‌بینید همه اینها را صعد جرز قرار خواهیم داد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 983.33,
   "end": 985.07,
   "text": "یعنی از بین نابود خواهیم کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 985.07,
   "end": 986.89,
   "text": "از میان خواهیم برداشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 986.89,
   "end": 990.27,
   "text": "البته متفقاً برمی‌دارد و دنبالش میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 990.27,
   "end": 995.65,
   "text": "دقت می‌کنید؟ اما در کل که بیان می‌فرماید \"لَجَاعِلُونَ مَا عَلَيْهَا صَعِدًا جُرُزًا\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 995.65,
   "end": 997.93,
   "text": "همه‌اش از میان خواهیم برداشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 997.93,
   "end": 999.77,
   "text": "البته عرض کردم این مسئله دو تا است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 999.77,
   "end": 1006.97,
   "text": "یکی این است که شما الان دقت روی زمین یک ماده‌ای دارد که مرتب کمالات را قبول می‌کند و می‌گذرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 1006.97,
   "end": 1010.03,
   "text": "این به جهت ظریفی است. همه تابش‌ها،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 1010.03,
   "end": 1012.57,
   "text": "خاک است که نبات می‌شود و از میان می‌رود و خاک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 1012.57,
   "end": 1016.89,
   "text": "است که میوه می‌شود و از میان می‌رود و خاک است که صورت انسانی قبول می‌کند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 1016.89,
   "end": 1019.45,
   "text": "و خاک است الان خاک یک مواد اولیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 1019.45,
   "end": 1022.69,
   "text": "حالا خود مواد اولیه هم با صورت‌های مختلف قبول شده است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 1022.69,
   "end": 1027.61,
   "text": "قبول می‌کنند. هی داریم این مواد اولیه صورت‌های مختلف را قبول می‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 1027.61,
   "end": 1034.73,
   "text": "از نباتات مختلف زیبا، خوب، دارای کمالات بسیار جالب یا صورت‌های مختلف هی قبول می‌کنند و از دست می‌دهند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 1034.73,
   "end": 1036.4,
   "text": "قبول می‌کنند و از دست می‌دهند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 214,
   "start": 1036.4,
   "end": 1039.21,
   "text": "روح مانند آینه‌ای است که می‌تابد و می‌گذرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 215,
   "start": 1039.21,
   "end": 1044.33,
   "text": "خوب اگر تأمل کنید یک گذری در این عالم ماده از لحاظ کمالات است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 216,
   "start": 1044.33,
   "end": 1047.11,
   "text": "کمالاتی می‌تابد روی ماده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 217,
   "start": 1047.11,
   "end": 1056.07,
   "text": "روی ماده تابیده این کمالات می‌تابد و مدتی هم دوام دارد روی ماده و ظرف می‌کند و بعد می‌گذرد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 218,
   "start": 1056.07,
   "end": 1057.58,
   "text": "و کلش هم می‌گذرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 219,
   "start": 1057.58,
   "end": 1060.89,
   "text": "\"وَإِنَّا لَجَاعِلُونَ مَا عَلَيْهَا صَعِدًا جُرُزًا\"",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 220,
   "start": 1060.89,
   "end": 1062.71,
   "text": "خب می‌خواهد چی بفرماید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 221,
   "start": 1062.71,
   "end": 1065.29,
   "text": "هرچه هست اینجا زینت است و تابش است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 222,
   "start": 1065.29,
   "end": 1068.35,
   "text": "ما اینجا صعد جرز قرار خواهیم داد و می‌دهیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 223,
   "start": 1068.35,
   "end": 1070.31,
   "text": "همانطور که عرض کردم خیلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 224,
   "start": 1070.31,
   "end": 1074.49,
   "text": "جالب است. شاید شماها خودتان به تنهایی روی آن همیشه فکر کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 225,
   "start": 1074.49,
   "end": 1079.91,
   "text": "خیلی فکر-- علایمی است که این انسان‌ها را به سوی خودش جلب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 226,
   "start": 1079.91,
   "end": 1088.39,
   "text": "می‌کند. همه اینها تابش‌هایی است که بعد از متفقاً قبلاً نبود در وسط می‌شود و بعد هم چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 227,
   "start": 1088.39,
   "end": 1090.85,
   "text": "از بین. این یک چیز عجیبی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 228,
   "start": 1090.85,
   "end": 1095.41,
   "text": "است. حالا باید گفت که این مثلاً حقیقت این صفت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 229,
   "start": 1095.41,
   "end": 1099.83,
   "text": "خوبی در نبات مثلاً در گل، در میوه، در انسان، در همه جاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 230,
   "start": 1099.83,
   "end": 1102.74,
   "text": "اینها چیه؟ از کجا آمد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 231,
   "start": 1102.74,
   "end": 1107.98,
   "text": "بعدش کجا رفت؟ به قول معروف که میگن چیزی که نورزید کجا می‌آ-- آیید و فرخنده کجا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 232,
   "start": 1107.98,
   "end": 1112.08,
   "text": "می‌رود؟ اونچه میاد از کجا میاد و اونچه می‌رود به کجا می‌رود؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 233,
   "start": 1112.08,
   "end": 1114.26,
   "text": "هی میاد و می‌رود. تابش است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 234,
   "start": 1114.26,
   "end": 1118.4,
   "text": "درست تابش است. می‌تابد مدتی می‌تابد بعد می‌رود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 235,
   "start": 1118.4,
   "end": 1123.86,
   "text": "خب باید اولا فکر کرد که غیر از اینکه این یک حقیقت تابشی است در اینجا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 236,
   "start": 1123.86,
   "end": 1128.62,
   "text": "این زیبایی که الان من در گل می‌بینم، خاک که بود مواد در اولیه بود اول نداشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 237,
   "start": 1128.62,
   "end": 1133.74,
   "text": "بعد الان تابیده رو می‌بینیم بعدا باز خاک می‌شود سر می‌رود حالت اولیه مواد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 238,
   "start": 1133.74,
   "end": 1138.84,
   "text": "این جمال، این زیبایی با آن طوافق، کمالات دیگر و نور و رنگ و امثال اینها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 239,
   "start": 1138.84,
   "end": 1142.16,
   "text": "اینها از کجا آمد؟ این از کجا آمد دارد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 240,
   "start": 1142.16,
   "end": 1145.28,
   "text": "بعدش می‌شود گفت که پس از به کجا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 241,
   "start": 1145.28,
   "end": 1148.96,
   "text": "می‌رود؟ غیر از اینکه این ظاهره، این تابشی است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 242,
   "start": 1148.96,
   "end": 1151.34,
   "text": "در هر صورت از هر جهت حالا من دنبالش می‌گیرم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 243,
   "start": 1151.34,
   "end": 1156.76,
   "text": "قرآن می‌فرماید که آنچه می‌بینید یک تابش است که ما اینها را از میان برمی‌داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 244,
   "start": 1156.76,
   "end": 1159.62,
   "text": "این در کل، کل مسئله است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 245,
   "start": 1159.62,
   "end": 1165.7,
   "text": "گاهی در آیات قرآن به کل آنچه در زمین دیده می‌شود از طواف کمال و زیبایی‌ها ناظر است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 246,
   "start": 1165.7,
   "end": 1173.24,
   "text": "سبحان الله والحمد لله ولا اله الا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 247,
   "start": 1173.24,
   "end": 1178.14,
   "text": "الله الله اکبر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 248,
   "start": 1178.14,
   "end": 1190.6,
   "text": "سبحان الله والحمد لله ولا اله الا الله الله اکبر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 249,
   "start": 1190.6,
   "end": 1199.64,
   "text": "سبحان الله والحمد لله ولا اله الا الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 250,
   "start": 1199.64,
   "end": 1203.04,
   "text": "الله اکبر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 251,
   "start": 1203.04,
   "end": 1215.32,
   "text": "سبحان الله والحمد لله ولا اله الا الله الله اکبر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 252,
   "start": 1215.32,
   "end": 1219.81,
   "text": "همراهان قرآنی با برنامه توحیدنامه در خدمت شما هستیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 253,
   "start": 1219.81,
   "end": 1223.22,
   "text": "بیانات عالمانه حضرت آیت الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 254,
   "start": 1223.22,
   "end": 1229.02,
   "text": "محمد شجاعی را درباره توحید صفاتی خداوند شنیدید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 255,
   "start": 1229.02,
   "end": 1231.76,
   "text": "با سخنی گهربار از حضرت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 256,
   "start": 1231.76,
   "end": 1236.48,
   "text": "علی علیه السلام برنامه امروز را به پایان می‌بریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 257,
   "start": 1236.48,
   "end": 1245.7,
   "text": "هرکس تو را دعوت به آخرت نماید و کمک کار تو باشد برای عمل صالح و کارهای آخرتی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 258,
   "start": 1245.7,
   "end": 1251.46,
   "text": "آن شخص دوست مهربان و واقعی توست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 259,
   "start": 1251.46,
   "end": 1254.64,
   "text": "تا برنامه دیگر و فرصتی دوباره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 260,
   "start": 1254.64,
   "end": 1257.1,
   "text": "خداوند یار و نگهدارتان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}