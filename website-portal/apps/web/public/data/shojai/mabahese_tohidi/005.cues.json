 ],
 "cues": [
  {
   "i": 0,
   "start": 0.42,
   "end": 7.2,
   "text": "بسم الله الرحمن الرحيم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 7.2,
   "end": 10.8,
   "text": "قل هو الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 10.8,
   "end": 13.64,
   "text": "أحد. به نام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 13.64,
   "end": 17.54,
   "text": "خداوند بخشایشگر مهربان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 17.54,
   "end": 37.54,
   "text": "بگو خدا یکی است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 41.66,
   "end": 50.48,
   "text": "توحیدنامه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 50.48,
   "end": 53.14,
   "text": "با بیانات حضرت آیت الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 53.14,
   "end": 70.12,
   "text": "محمد شجاعی. مقصود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 70.12,
   "end": 72.74,
   "text": "از بحث توحید، صحبت از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 72.74,
   "end": 84.94,
   "text": "معرفت خدای متعال، صفات خدای متعال و افعال خدای متعال، پیش بیان دیگر به اصطلاح معرفت وحدانیت ذات مقدس حق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 84.94,
   "end": 94.18,
   "text": "و اینکه جز ذات او ذاتی نیست و جز صفات او صفاتی نیست و جز افعال او افعالی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 94.18,
   "end": 108.38,
   "text": "نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 108.38,
   "end": 112.2,
   "text": "بسم الله الرحمن الرحیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 112.2,
   "end": 114.82,
   "text": "ابو هاشم جعفری می‌گوید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 114.82,
   "end": 122.64,
   "text": "از امام رضا علیه السلام سؤال کردم درباره خداوند که آیا توصیف می‌شود؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 122.64,
   "end": 125.48,
   "text": "حضرت در جواب فرمودند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 125.48,
   "end": 127.96,
   "text": "آیا قرآن خوانده‌ای؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 127.96,
   "end": 130.94,
   "text": "گفتم بلی. فرمودند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 130.94,
   "end": 135.26,
   "text": "آیا این آیه را قرائت کرده‌ای که خداوند می‌فرماید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 135.26,
   "end": 138.76,
   "text": "چشم‌ها نمی‌توانند او را درک کنند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 138.76,
   "end": 142.8,
   "text": "اما او چشم‌ها را درک می‌کند؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 142.8,
   "end": 146.56,
   "text": "گفتم بلی. حضرت فرمودند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 146.56,
   "end": 149.96,
   "text": "شما چشم‌ها را می‌شناسید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 149.96,
   "end": 154.04,
   "text": "گفتم بلی. فرمودند چیست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 154.04,
   "end": 158.32,
   "text": "گفتم همین بینایی چشمان ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 158.32,
   "end": 165.92,
   "text": "حضرت فرمودند اوهام قلب‌ها بالاتر از بینایی چشم‌های ظاهر است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 165.92,
   "end": 168.34,
   "text": "نه تنها چشم‌های ظاهر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 168.34,
   "end": 172.96,
   "text": "بلکه آن اوهام قلب‌ها هم نمی‌توانند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 172.96,
   "end": 175.52,
   "text": "خداوند را درک کنند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 175.52,
   "end": 178.72,
   "text": "ولی خداوند آن اوهام را",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 178.72,
   "end": 184.03,
   "text": "درک می‌کند. دوستان شنونده سلام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 184.03,
   "end": 186.74,
   "text": "برنامه توحیدنامه رو از شبکه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 186.74,
   "end": 192.22,
   "text": "سراسری رادیو قرآن می‌شنوید و بهره‌مند می‌شوید از بیانات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 192.22,
   "end": 199.56,
   "text": "عالمانه عالم فرزانه حضرت آیت الله شجاعی درباره توحید و معرفت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 199.56,
   "end": 204.06,
   "text": "خداوند متعال. یا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 204.06,
   "end": 207.56,
   "text": "ربنا یا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 207.56,
   "end": 223.94,
   "text": "الهنا یا محینا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 223.94,
   "end": 228.41,
   "text": "والموتنا وثبت اقدامنا يا حبيبنا يا صديقنا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 228.41,
   "end": 230.8,
   "text": "يا ربنا يا الهنا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 230.8,
   "end": 238.22,
   "text": "يا محينا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 238.22,
   "end": 245.3,
   "text": "والموتنا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 245.3,
   "end": 249.72,
   "text": "وثبت اقدامنا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 249.72,
   "end": 254.58,
   "text": "يا حبيبنا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 254.58,
   "end": 259.7,
   "text": "يا صديقنا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 259.7,
   "end": 268.24,
   "text": "قرآن دوستان عزیز، حضرت آیت الله شجاعی در برنامه گذشته فرمودند در قرآن کریم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 268.24,
   "end": 271.78,
   "text": "در آیاتی که درباره مشتکین بیان شده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 271.78,
   "end": 280.8,
   "text": "اشاره شده است به اینکه در قیامت آنچه به عنوان معبود و اله برای انسان‌ها در نظام دنیوی مطرح بوده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 280.8,
   "end": 284.2,
   "text": "از نظرشان محو و نابود می‌شود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 284.2,
   "end": 287.64,
   "text": "و این همان حقیقت توحید است که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 287.64,
   "end": 295.34,
   "text": "جز ذات حق و اسماء و صفات او و جلوات اسماء چیزی نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 295.34,
   "end": 298.96,
   "text": "آنچه ما به عنوان ذات‌های مستقل می‌بینیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 298.96,
   "end": 304.32,
   "text": "همه خیال است و همه از دید ناقص ما سرچشمه می‌گیرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 304.32,
   "end": 314.1,
   "text": "اگر ما دیدی فراتر داشته باشیم، همه اینها را وجه حق می‌بینیم و اینکه اینها فانی در وجه خدا هستند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 314.1,
   "end": 319.88,
   "text": "در قیامت نیز که ما هستیم و شریکانی که برای خدا در دنیا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 319.88,
   "end": 326.28,
   "text": "قرار داده بودیم، دیگر آنها را به صورت بت‌ها و شریکان خدا نمی‌بینیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 326.28,
   "end": 329.68,
   "text": "آن هستی کاذبشان از بین رفته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 329.68,
   "end": 331.72,
   "text": "و همه را آیات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 331.72,
   "end": 334.04,
   "text": "وجه خداوند می‌بینیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 334.04,
   "end": 341.56,
   "text": "خلاصه در همه آنها تنها ذات خداوند متعال دیده می‌شود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 341.56,
   "end": 343.66,
   "text": "خب دوستان قرآنی اکنون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 343.66,
   "end": 347.34,
   "text": "توجه شما را جلب می‌کنیم به بیانات عالمانه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 347.34,
   "end": 349.54,
   "text": "حضرت آیت الله شجاعی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 349.54,
   "end": 353.74,
   "text": "درباره توحید خداوند متعال.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 353.74,
   "end": 359.44,
   "text": "آیاتی که در باب مشرکین هست و خصوص مشرکین هست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 359.44,
   "end": 370.6,
   "text": "یک حقیقت یا یک نکته که بارها در جاهای مختلف با بیان‌های مختلف و با عبارات مختلف و اشارات مختلف اشاره کرده است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 370.6,
   "end": 375.1,
   "text": "و اون روزی در قیامت انشاالله خوب تأمل کنید این که گفتم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 375.1,
   "end": 377.36,
   "text": "معارف عالی قرآن است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 377.36,
   "end": 379.86,
   "text": "در قیامت آنچه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 379.86,
   "end": 383.24,
   "text": "به عنوان معبود و آنچه به عنوان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 383.24,
   "end": 386.52,
   "text": "اله، به عنوان به اصطلاح معبود برای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 386.52,
   "end": 388.94,
   "text": "انسان‌ها در نظام دنیوی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 388.94,
   "end": 397.58,
   "text": "مصرف شده است و عبادت می‌کردند، در قیامت از نظر این‌ها محو و نابود می‌شود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 397.58,
   "end": 401.22,
   "text": "ناپدید می‌شوند اون معبودها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 401.22,
   "end": 407.34,
   "text": "منتها این-- انشاالله خوب تأمل کنید این که گفتم معارف عالی قرآن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 407.34,
   "end": 409.94,
   "text": "است. در قیامت آنچه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 409.94,
   "end": 413.28,
   "text": "به عنوان معبود و آنچه به عنوان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 413.28,
   "end": 416.54,
   "text": "اله، به عنوان به اصطلاح معبود برای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 416.54,
   "end": 418.96,
   "text": "انسان‌ها در نظام دنیوی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 418.96,
   "end": 427.62,
   "text": "مصرف شده است و عبادت می‌کردند، در قیامت از نظر این‌ها محو و نابود می‌شود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 427.62,
   "end": 431.24,
   "text": "ناپدید می‌شوند اون معبودها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 431.24,
   "end": 434.98,
   "text": "منتها این حقیقت را به بیانی بیان می‌کند که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 434.98,
   "end": 437.96,
   "text": "زیاد جای دقت و تفکر به فرماید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 437.96,
   "end": 446.34,
   "text": "کلیه‌ش این است که در قیامت اون معبودها که برای مشتکی در درجات مختلف شرک در نظام دنیوی بوده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 446.34,
   "end": 450.14,
   "text": "است، اون معبودها، اون رنگ و رو را ندارند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 450.14,
   "end": 453.5,
   "text": "اون صورت را که در اینجا بود ندارند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 453.5,
   "end": 457.42,
   "text": "اون پری‌بندگی را که در اینجا بود ندارند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 457.42,
   "end": 460.28,
   "text": "گم می‌شود از نظر اون‌ها تعبیر قرآن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 460.28,
   "end": 462.92,
   "text": "گم می‌شود. یدل عنهم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 462.92,
   "end": 468.26,
   "text": "این چیزی که باید از عنوان که قرآن به کلام هست و همه تعبیراتش حساب شده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 468.26,
   "end": 472.4,
   "text": "است و باید به خوب تأمل کرد، چیزی که باید تأمل درش داشته باشیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 472.4,
   "end": 476.9,
   "text": "یعنی اینکه گم می‌شود. نمی‌خواهد اینطور بفرماید که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 476.9,
   "end": 485.44,
   "text": "این بت‌ها و معبودها که مشتکی در نظام دنیوی اون‌ها را عبادت می‌کردند، اون‌ها دیگه اونجا نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 485.44,
   "end": 489.9,
   "text": "نیست، مطرح نمی‌فرماید. حتی با صراحت در بعضی از این آیات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 489.9,
   "end": 497.32,
   "text": "می‌فرماید که هستند ولی به اون شکلی که این‌ها می‌یافتند در اینجا نمی‌یابند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 497.32,
   "end": 500.32,
   "text": "به اون صورتی که در اینجا می‌دیدند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 500.32,
   "end": 507.32,
   "text": "نمی‌بینند و با اون وضعی که اینجا با اون‌ها مواجه می‌شدند، اونجا مواجه نمی‌شوند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 507.32,
   "end": 510.72,
   "text": "گم می‌شود، گم می‌شود از نظر اون‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 510.72,
   "end": 515.48,
   "text": "این چنین خاصیت این آیات گفتم خیلی عمیق است باید بهش تأمل کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 515.48,
   "end": 519.9,
   "text": "حالا از آیات را هم می‌خوانم و با هم روی آیات تأمل می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 519.9,
   "end": 539.9,
   "text": "عرض کنم که شصت و هفت و شصت و هشت سوره قصص است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 634.94,
   "end": 640.82,
   "text": "اون روزی که خدا این مشتکی را ندا می‌‌کند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 640.82,
   "end": 644.58,
   "text": "ای نشورکائی یا زایشورکائی من کجا هستم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 644.58,
   "end": 646.2,
   "text": "حالا الان اونجا مفقود هستم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 646.2,
   "end": 649.64,
   "text": "الان حاضرند هم انسان‌ها و هم بت‌ها، معبودها،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 649.64,
   "end": 652.96,
   "text": "مخلوقاتی به عنوان معبود انتخاب شده بودند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 652.96,
   "end": 657.78,
   "text": "به شرک جلی یا خفی. و يوم يناديهم اون وقتی که خدا ما را ندا می‌کند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 657.78,
   "end": 660.56,
   "text": "ای نشورکائی، کجا شرکای من؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 660.56,
   "end": 667.45,
   "text": "حالو حالاً علش گفتم که مسئله علش شده، ایده ها بالا رفته، همه جا برچه از ظاهر است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 667.45,
   "end": 669.82,
   "text": "دیگه بت‌ها با اون قیافه نیستند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 669.82,
   "end": 671.84,
   "text": "از آن مشتکی جواب می‌دهند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 671.84,
   "end": 674.08,
   "text": "قال اذنا كما من شهید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 674.08,
   "end": 679.92,
   "text": "خدایا به تو گفتیم ما هیچ شاهدی نداریم به اونچه که داشتیم می‌کردیم و می‌گفتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 679.92,
   "end": 683.54,
   "text": "یعنی چه می‌شود گفت؟ اذنا كما تعبیرش مخصوص است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 683.54,
   "end": 688.28,
   "text": "اذنا كما میشن. هیچ ما دلیلی بر آن نداریم که این را تلاش کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 688.28,
   "end": 693.25,
   "text": "روشن می‌شود قضیه. زل عنهم بعد می‌فرماید و زل عن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 693.25,
   "end": 696.74,
   "text": "باز میاد تعبیر زل آید بعدش که در سوره قصص است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 696.74,
   "end": 698.74,
   "text": "اذنا كما من شهید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 698.74,
   "end": 703.18,
   "text": "بعد می‌فرماید و زل عنهم ما كانوا يدعون من قبله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 703.18,
   "end": 708.02,
   "text": "گم می‌شود از نظر اون‌ها آنچه قبلاً می‌خواندند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 708.02,
   "end": 710.54,
   "text": "و زل ما لهم من نصره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 710.54,
   "end": 714.92,
   "text": "یعنی نه که جدا افترا را براشون میگه خواهی نمانده است کار از کار گذشته است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 714.92,
   "end": 718.98,
   "text": "و زل عنهم ما كانوا يدعون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 718.98,
   "end": 723.14,
   "text": "یعنی گم می‌شود اونچه که قبلاً می‌خواندند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 723.14,
   "end": 725.34,
   "text": "پرده کنار رفت، نقاب دور شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 725.34,
   "end": 729.28,
   "text": "این هم یک سطر از آیات. حالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 729.28,
   "end": 734.18,
   "text": "از اونجا که این انسان‌ها دروغ را زیاد در اینجا گفتم ملکه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 734.18,
   "end": 735.88,
   "text": "دروغ گفتن براشون ملکه شده است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 735.88,
   "end": 741.66,
   "text": "احیاناً در این رابطه انسان‌ها در قیامت در یک جا به نام دروغ هم می‌برند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 741.66,
   "end": 745.36,
   "text": "بعد از خود خدا فرماید که ببینید اینها چجوری به ضلالت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 745.36,
   "end": 747.33,
   "text": "میرن. اونجا، اونها به ضلالت کار میکنن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 747.33,
   "end": 749.88,
   "text": "اینجا هم اینطور. اینجا دروغ هم میگن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 749.88,
   "end": 751.53,
   "text": "توجه کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 751.53,
   "end": 755.05,
   "text": "این دروغی که اینجا هست به نام ظهور ملکه دروغ است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 755.05,
   "end": 760.34,
   "text": "انسان در اینجا عادت کرده است به آن دروغ گفتن به اون شخص که اینجا داره، اینجا نکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 760.34,
   "end": 780.34,
   "text": "هفتاد و سه، هفتاد و چهار سوره مومن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 831.8,
   "end": 837.72,
   "text": "آیاتی که در اول نام برده من از یه قسمتی خوندم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 837.72,
   "end": 848.96,
   "text": "وقتی که جمع شده‌اند مشرکین و همه جمع شده‌اند برای قیامت گفته میشه به مشرکین که أينما كنتم أينما كنتم تشتركون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 848.96,
   "end": 851.48,
   "text": "کجا هستن اونایی که شریک برای خدا بود؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 851.48,
   "end": 853.82,
   "text": "سؤال می‌شود از این کجا هستن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 853.82,
   "end": 856.56,
   "text": "أينما کجا هستن ما کنتم تشتركون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 856.56,
   "end": 859.86,
   "text": "من دون الله که خدا شریک دارند به غیر از خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 859.86,
   "end": 862.36,
   "text": "سؤال و جواب میدن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 862.36,
   "end": 869.36,
   "text": "ضل عنا. خب نگاه کردن که نمی‌بینن که در همه جا وحشت را می‌بینند و آثار حق را",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 869.36,
   "end": 871.34,
   "text": "میگن که ضل عنا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 871.34,
   "end": 873.44,
   "text": "دیگه از ما گم شدن. نیستن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 873.44,
   "end": 874.97,
   "text": "هیچ‌کس رو که نمی‌بینیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 874.97,
   "end": 876.52,
   "text": "بعد اینجا قرآن دروغ هم میگن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 876.52,
   "end": 878.57,
   "text": "میگن بل لم نكن ندعوا من شيء.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 878.57,
   "end": 881.74,
   "text": "اصلا قبلاً هم غیر از تو چیزی را نمی‌خواستیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 881.74,
   "end": 887.06,
   "text": "توجه کنید. این دروغ است. كذلك يضل الله الكافرين.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 887.06,
   "end": 891.4,
   "text": "خدا این چنین کافرین را اونجا و اینجا به ضلالت می‌اندازد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 891.4,
   "end": 894.86,
   "text": "توجه کنید. یضل الله. مثلا میگن ما غیر از تو چیزی را،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 894.86,
   "end": 897.71,
   "text": "غیر از تو چیزی را نمی‌بینیم. این کاری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 897.71,
   "end": 902.12,
   "text": "این ظهور ملکه دروغ. یه آیه هم بخونم بعد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 902.12,
   "end": 922.12,
   "text": "خب هشتاد و شش، هشتاد و هفت سوره نحل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 925.12,
   "end": 945.12,
   "text": "اوناتی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 1013.6,
   "end": 1016.48,
   "text": "که مشرکین شرکا خودشان را می‌بینند،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 1016.48,
   "end": 1019.52,
   "text": "اونا که اینجا شرکا برای خدا بر قرار داده بودند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 1019.52,
   "end": 1022.98,
   "text": "فقالوا ربنا هؤلاء شرکاؤنا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 1022.98,
   "end": 1025.9,
   "text": "میگن که خدایا، به خدا میگن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 1025.9,
   "end": 1027.76,
   "text": "اینا هستن شرکای ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 1027.76,
   "end": 1030.9,
   "text": "الذين كنا ندعوا من دونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 1030.9,
   "end": 1034.4,
   "text": "غیر از تو ما عبادت می‌کردیم و می‌خواستیم اینا بگن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 1034.4,
   "end": 1037.28,
   "text": "شرکا رو به خدا می‌خوان نشان بدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 1037.28,
   "end": 1040.44,
   "text": "فألقوا اليهم القول انهم لتاسقون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 1040.44,
   "end": 1043.02,
   "text": "فورا، فوراً شرکا به اینها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 1043.02,
   "end": 1044.63,
   "text": "گفتار را رد می‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 1044.63,
   "end": 1048.62,
   "text": "میگن که شما دروغ میگید. وألقوا إلى الله عمرهم سلام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 1048.62,
   "end": 1052.48,
   "text": "ارضاء سلام می‌کنند به خدا یعنی آیت هستم و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 1052.48,
   "end": 1054.52,
   "text": "خدا را در خود نشان می‌دهم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 1054.52,
   "end": 1056.96,
   "text": "توجه کنید. دروغ، به این گونه یک دروغ میگیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 1056.96,
   "end": 1060.78,
   "text": "خدا را در خود نشان می‌دهم و ضل عنهم ما کانوا يعبدون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 1060.78,
   "end": 1066.46,
   "text": "اونا در چه خدایی‌اند و گم می‌شود از دید این مشرکین آنچه که قرار داده اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 1066.46,
   "end": 1069.88,
   "text": "یعنی از اول این مشرکین مثل اینکه می‌خوان این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 1069.88,
   "end": 1072.26,
   "text": "فاز ظهور",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 1072.26,
   "end": 1074.08,
   "text": "ملکه اصطلاحا روطلبی خواهی بیجاش که در اینجا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 1074.08,
   "end": 1079.54,
   "text": "وقتی می‌آیند پیشش میخوان بگن خدا ای شرکای ما بودند که همین که اینجا میگن اینا شرکای ما بودند،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 1079.54,
   "end": 1083.32,
   "text": "اونها هم وحشت را نشان می‌دهند و ضل عنهم ما کانوا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 1083.32,
   "end": 1088.54,
   "text": "يعبدون. میخوان بگن فورا به گونه‌ای که مقصود их شود این جور و لحن آیه اینطوری‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 1088.54,
   "end": 1096.08,
   "text": "بعد از این حاضرش چند مورد از آیات بود که گفتم و در یک نوع به عنوان نمونه تا نوشته بودم بدان که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 1096.08,
   "end": 1097.66,
   "text": "اونا رو دیگه از همدیگه شو نمی‌فهمیدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 1097.66,
   "end": 1100.74,
   "text": "چهار مورد یا پنج موردش رو اینجا به اینها اشاره می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 1100.74,
   "end": 1104.99,
   "text": "این حقیقتی است که با این توضیح گفتم برای ما انشاالله که روشن شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 1104.99,
   "end": 1111.7,
   "text": "یکی از معارف قرآن که بعدا باز تحقیق می‌کنم شما این قبیل آیات را ببینید در نکات و شارحش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 1111.7,
   "end": 1115.02,
   "text": "بسیاری از حقایق را برای شما در نام توحید معلوم می‌شود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 1115.02,
   "end": 1121.26,
   "text": "خب این یکی از اون عاقبتی من در این جلسه عنوان مکمل و جلسه تبلیغی خواستم بگم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 1121.26,
   "end": 1127.24,
   "text": "نکته‌ی دیگر و نکته‌ی دوم که هست در این بحث توحید که عنوان کردیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 1127.24,
   "end": 1134.2,
   "text": "این که در نظام وجود جز ذات او و اسماء و صفات او چیزی نیست و یا جلوات اسماء او.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 1134.2,
   "end": 1138.06,
   "text": "آنچه به عنوان ذرات مستقل می‌بینیم اشتباه است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 1138.06,
   "end": 1144.44,
   "text": "و این از دید ناقص ماست و همه پامنی در ورش God هستند و حالش در ورش God.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 1144.44,
   "end": 1147.16,
   "text": "در این رابطه یک نکته‌ای هم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 1147.16,
   "end": 1152.16,
   "text": "نسبت به آن تا حالا اون را توضیح دادم برای شما انشاالله اون هم به تفضیل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 1152.16,
   "end": 1154.38,
   "text": "خب همه چیز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 1154.38,
   "end": 1156.4,
   "text": "حالش در ورش خدا هستند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 1156.4,
   "end": 1161.62,
   "text": "پانه در ورش او. از جمله این چیزها یکی هم خود انسان است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 1161.62,
   "end": 1166.92,
   "text": "این هم اینجا لازم است در این مبحث توحید عنوان بکنیم که کاملاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 1166.92,
   "end": 1171.84,
   "text": "یعنی من بعداً که لازم ضرورت دارد از اینجا نگذریم باید قبل از گفتنی از اینجا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 1171.84,
   "end": 1174.96,
   "text": "من و شما هم بالاخره از مخلوقات هستیم یا نه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 1174.96,
   "end": 1178.1,
   "text": "انسان هم که هستم کجا مخلوق هستم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 1178.1,
   "end": 1181.56,
   "text": "به طوری که کل شی حالش در ذاتش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 1181.56,
   "end": 1188.3,
   "text": "است. این توحید ذاتی می‌گوید جز ذات او و اسماء و صفات او و جلوات اسماءش و چیزی نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 1188.3,
   "end": 1191.38,
   "text": "اون توحید ذاتی می‌گوید انسان هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 1191.38,
   "end": 1196.92,
   "text": "که به جای خود یک موجودیت مستقلی در بازی نظر دارد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 1196.92,
   "end": 1201.32,
   "text": "یک ذات مستقلی در ابتدا نظر دارد با دید ناقص،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 1201.32,
   "end": 1202.9,
   "text": "انسان هم اینطور نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 1202.9,
   "end": 1205.1,
   "text": "انسان هم صورتی دارد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 1205.1,
   "end": 1211.7,
   "text": "حقیقتی دارد که اون حقیقت اصلیش هانه ای در ورش خداست و حالش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 1211.7,
   "end": 1219.81,
   "text": "در ورش اوست که اگر ارده کنار برود ما انسان را هم مانند موجودات دیگر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 1219.81,
   "end": 1223.92,
   "text": "چی در خواهیم دید؟ خود انسان‌ها را و خودمان را چی در خواهیم دید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 1223.92,
   "end": 1227.06,
   "text": "حالش خواهیم دید. حالتی در ورش خدا خواهیم دید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 1227.06,
   "end": 1231.72,
   "text": "الان حالا عبارت رو عوض می‌کنم خوب دقت کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 1231.72,
   "end": 1236.58,
   "text": "من خودم را چیزی می‌بینم همان که اشیاء دیگر را چیزی می‌بینم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 1236.58,
   "end": 1239.42,
   "text": "در هر دو مورد این از دید ناقص من است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 1239.42,
   "end": 1245.3,
   "text": "اگر دید بالایی داشته باشم نه تنها همه چیز را حالتی در ورش خدا می‌بینم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 214,
   "start": 1245.3,
   "end": 1247.38,
   "text": "از جمله مگه گفتیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 215,
   "start": 1247.38,
   "end": 1250.64,
   "text": "از جمله خود را هم حالتی در ورش خدا خواهم دید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 216,
   "start": 1250.64,
   "end": 1253.8,
   "text": "این هم نکته‌ای است که می‌خواهم در این باب توضیح بدهم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 217,
   "start": 1253.8,
   "end": 1257.26,
   "text": "این تنها مخصوص همه موجودات جز انسان که نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 218,
   "start": 1257.26,
   "end": 1260.26,
   "text": "انسان اگر خدایی ناید بکند،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 219,
   "start": 1260.26,
   "end": 1264.58,
   "text": "آن دید بالا و درک بالا را خدا به انسان بدهد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 220,
   "start": 1264.58,
   "end": 1271.9,
   "text": "تنها این نیست که همه چیز را نه به عنوان حجاب ورش الله بلکه مرآت ورش الله خواهد دید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 221,
   "start": 1271.9,
   "end": 1274.76,
   "text": "از جمله خودش را هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 222,
   "start": 1274.76,
   "end": 1282.24,
   "text": "عارض الله، آینه الله، عارض فی ورش الله و خودش را هم مرآت چی خواهد دید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 223,
   "start": 1282.24,
   "end": 1284.43,
   "text": "مرآت ورش الله خواهد دید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 224,
   "start": 1284.43,
   "end": 1291.16,
   "text": "این دیگه مخصوص موجودات دیگر باشد به خود انسان نرسد این است مثال استثنایی است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 225,
   "start": 1291.16,
   "end": 1294.08,
   "text": "این باز چیزی در اینجا توضیحی می‌خواستم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 226,
   "start": 1294.08,
   "end": 1298.28,
   "text": "بدم برای روشن شدن اون حقیقتی که کم و بیش گوشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 227,
   "start": 1298.28,
   "end": 1306.42,
   "text": "من و شما خورده است که در عبودیت و در سیر عبودی اون مرحله‌ی آخری که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 228,
   "start": 1306.42,
   "end": 1311.82,
   "text": "سیر عبودی به اونجا منتهی می‌شود عبارت است از فنای چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 229,
   "start": 1311.82,
   "end": 1315.1,
   "text": "از فنای کی؟ ورش الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 230,
   "start": 1315.1,
   "end": 1317.88,
   "text": "دقت می‌کنید؟ این زیاد به گوش شما خورده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 231,
   "start": 1317.88,
   "end": 1326.04,
   "text": "که اصلاً سالکانی در سلوکشون اگر موفق باشند و مدارج سیر را و سلوک را طی بکنند،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 232,
   "start": 1326.04,
   "end": 1329.78,
   "text": "سیرشون منتهی می‌شود به فنای فی ورش الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 233,
   "start": 1329.78,
   "end": 1337.1,
   "text": "این معروف است دیگه در همه نوشته‌ها گفت‌هاشن که سیر عبودی منتهی خواهد شد به فنای فی ورش الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 234,
   "start": 1337.1,
   "end": 1340.72,
   "text": "چون فنای فی ورش الله اصل مکان ما است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 235,
   "start": 1340.72,
   "end": 1343.09,
   "text": "اصل چیه؟ موقعیت ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 236,
   "start": 1343.09,
   "end": 1347.5,
   "text": "اون آیه‌ای که می‌خوندیم ها که گفت که مکانکم انتم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 237,
   "start": 1347.5,
   "end": 1352.12,
   "text": "و شرکاء. من الان خودم را چیزی می‌بینم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 238,
   "start": 1352.12,
   "end": 1357.9,
   "text": "و این خود من به این صورت که می‌بینم از دید ناقص من است، از ذات ناقص من است،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 239,
   "start": 1357.9,
   "end": 1362.38,
   "text": "یا از کمال ناقص من. و این من خودش اصلاً حجاب ورش الله است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 240,
   "start": 1362.38,
   "end": 1365.08,
   "text": "مانند هر چیز دیگر که توضیح داده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 241,
   "start": 1365.08,
   "end": 1367.1,
   "text": "اگر بنا باشد من",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 242,
   "start": 1367.1,
   "end": 1375.52,
   "text": "مکان اصلی خودم را بیابم مانند مکان اصلی هر موجود دیگر، همه آیات خدا، من هم آیه‌ای هستم برای خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 243,
   "start": 1375.52,
   "end": 1379.48,
   "text": "حال که در ورش او هستم، هانه ای در ورش او هستم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 244,
   "start": 1379.48,
   "end": 1383.1,
   "text": "مرآت ورش او هستم. اصل من حقیقت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 245,
   "start": 1383.1,
   "end": 1386.12,
   "text": "اگر مکان خودم را بیابم همین مکان است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 246,
   "start": 1386.12,
   "end": 1390.02,
   "text": "توجه می‌کنید؟ این مکان اصلی من است، منزلت اصلی من است،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 247,
   "start": 1390.02,
   "end": 1391.74,
   "text": "موقعیت اصلی من است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 248,
   "start": 1391.74,
   "end": 1395.58,
   "text": "اینو که در کلمات عرفا هم شنیده‌اید یا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 249,
   "start": 1395.58,
   "end": 1399.8,
   "text": "ممکن است تا بعضی‌ها اون غغوطن اینها رو اینجور معنی کنند و واقعاً خوب نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 250,
   "start": 1399.8,
   "end": 1401.92,
   "text": "این وطن نیست و عراق و شام نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 251,
   "start": 1401.92,
   "end": 1404.9,
   "text": "این وطن جایی است. سانرا نام نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 252,
   "start": 1404.9,
   "end": 1410.6,
   "text": "غغوطن ما این نیست. این غلط انداز است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 253,
   "start": 1410.6,
   "end": 1414.14,
   "text": "این نه تنها غلط انداز است خیلی گرفتاری‌ها دارد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 254,
   "start": 1414.14,
   "end": 1417.54,
   "text": "این موجودیت فعلی که الان ما از خودمون می‌یابیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 255,
   "start": 1417.54,
   "end": 1422.86,
   "text": "نه تنها موجودیت ناقص است، نه تنها حقیقت کاذب است، نه تنها به اصطلاح",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 256,
   "start": 1422.86,
   "end": 1427.46,
   "text": "سرتاپا محدودیت است بلکه حجاب بین ما و خدا حتی هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 257,
   "start": 1427.46,
   "end": 1432.52,
   "text": "موقعیت و موطن و مکان و منزلت و موقعیت اصلی ما همان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 258,
   "start": 1432.52,
   "end": 1434.76,
   "text": "هانه بودن در ورش الله هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 259,
   "start": 1434.76,
   "end": 1437.1,
   "text": "مرآت ورش الله بودن است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 260,
   "start": 1437.1,
   "end": 1439.44,
   "text": "آینه‌ی ورش خدا بودن است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 261,
   "start": 1439.44,
   "end": 1446.95,
   "text": "این اصل موقعیت ماست و سیر عبودی و سلوک و تزکیه انسان را به همین مرحله می‌رساند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 262,
   "start": 1446.95,
   "end": 1449.74,
   "text": "اون نامش را می‌گویند فناء فی ورش الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 263,
   "start": 1449.74,
   "end": 1454.64,
   "text": "هانه شدن در ورش خدا. با این برنامه که عرض می‌کنم خوب خیلی تأملات دارد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 264,
   "start": 1454.64,
   "end": 1458.86,
   "text": "اولاً برای شما روشن می‌شود که معنی فناء فی ورش الله چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 265,
   "start": 1458.86,
   "end": 1463.68,
   "text": "و ثانیاً برای شما معلوم می‌شود که ببینید حقیقت قرآنی چیزی نیست که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 266,
   "start": 1463.68,
   "end": 1469.14,
   "text": "اونیکه بعضی‌ها گفتند مثلاً ساخته‌ای درویش‌ها باشد یا صوفی‌ها باشد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 267,
   "start": 1469.14,
   "end": 1472.18,
   "text": "اگر درویش و صوفی همین حقیقت را گفته باشد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 268,
   "start": 1472.18,
   "end": 1481.4,
   "text": "این اندازه گفته باشد، اونچه قرآن فرماید، هیچ حقیقت رو گفته، هرچی گفته باشد توجه می‌کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 269,
   "start": 1481.4,
   "end": 1501.4,
   "text": "شنونده‌گران",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 270,
   "start": 1522.08,
   "end": 1530.58,
   "text": "در برنامه توحیدنامه امروز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 271,
   "start": 1530.58,
   "end": 1535.4,
   "text": "بیانات حضرت آیت الله شجاعی و تلاوت آیات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 272,
   "start": 1535.4,
   "end": 1545.24,
   "text": "چهل و هفت و چهل و هشت سوره مبارکه فصلت و آیات هفتاد و سه و هفتاد و چهار سوره مبارکه مؤمن و همچنین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 273,
   "start": 1545.24,
   "end": 1547.94,
   "text": "آیات هشتاد و شش و هشتاد و هفت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 274,
   "start": 1547.94,
   "end": 1551.1,
   "text": "سوره مبارکه نحل را شنیدید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 275,
   "start": 1551.1,
   "end": 1554.48,
   "text": "با سخنی گهربار از رسول خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 276,
   "start": 1554.48,
   "end": 1561.78,
   "text": "صلی الله علیه و آله و سلم برنامه امروز را به پایان می‌بریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 277,
   "start": 1561.78,
   "end": 1564.82,
   "text": "هر چیزی را کلیدی است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 278,
   "start": 1564.82,
   "end": 1566.96,
   "text": "و کلید آسمان‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 279,
   "start": 1566.96,
   "end": 1571.86,
   "text": "گفتار لا اله الا الله است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 280,
   "start": 1571.86,
   "end": 1574.98,
   "text": "تا برنامه دیگر و فرصتی دوباره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 281,
   "start": 1574.98,
   "end": 1578.42,
   "text": "همه شما را به خداوند منان می‌سپاریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 282,
   "start": 1578.42,
   "end": 1581.0,
   "text": "خداوند یا نگهدارتان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}