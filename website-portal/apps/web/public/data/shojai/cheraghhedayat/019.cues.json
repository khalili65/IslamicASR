   "title": "## ادامهٔ حر؛ اقرار و توبه",
   "start": 91.74,
   "end": 113.53
  },
  {
   "index": 1,
   "title": "## بشارت غیبی از دارالاماره",
   "start": 113.53,
   "end": 322.24
  },
  {
   "index": 2,
   "title": "## أول من بارز؛ جان در آغوش حسین",
   "start": 322.24,
   "end": 618.72
  },
  {
   "index": 3,
   "title": "## نقطهٔ مقابل: عبیدالله بن حر جعفی",
   "start": 618.72,
   "end": 1264.04
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 1.66,
   "end": 4.8,
   "text": "حسین، حسین،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 4.8,
   "end": 6.37,
   "text": "حسین، حسین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 6.37,
   "end": 20.32,
   "text": "حسین، حسین، حسین، حسین. شهید کربلای حسین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 20.32,
   "end": 26.44,
   "text": "حسین، حسین، حسین، حسین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 26.44,
   "end": 29.3,
   "text": "غریب بن اله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 29.3,
   "end": 35.74,
   "text": "نوا حسین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 35.74,
   "end": 41.92,
   "text": "حسین، حسین، حسین- السلام علیک یا أبا عبدالله الحسین-",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 41.92,
   "end": 57.58,
   "text": "حسین، حسین- وعلی الأرواح التي حلت بفنائک-",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 57.58,
   "end": 69.04,
   "text": "حسین، حسین، حسین، حسین. غریب بن اله نوا حسین. حسین، حسین- چراغ هدایت چراغ مصباح هدایت تویی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 69.04,
   "end": 77.38,
   "text": "چراغ مصباح هدایت تویی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 77.38,
   "end": 80.26,
   "text": "سفینه‌ای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 80.26,
   "end": 85.86,
   "text": "غرق در آبیم کند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 85.86,
   "end": 91.74,
   "text": "سفینه‌ای غرق در آبیم کند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 91.74,
   "end": 94.96,
   "text": "بسم الله الرحمن الرحیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 94.96,
   "end": 101.4,
   "text": "و خبر رب الحسین علیه السلام الذي قتل معصوما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 101.4,
   "end": 104.04,
   "text": "بسم الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 104.04,
   "end": 107.98,
   "text": "الرحمن الرحیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 107.98,
   "end": 116.68,
   "text": "یَا أَيَّتُهَا النَّفْسُ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 116.68,
   "end": 124.36,
   "text": "الْمُطْمَئِنَّةُ ارْجِعِي",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 124.36,
   "end": 133.11,
   "text": "إِلَىٰ رَبِّكِ رَاضِيَةً مَرْضِيَّةً.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 133.11,
   "end": 147.04,
   "text": "الله. سلام بر حسین و بر یاران حسین و سلام بر شما دوستداران و معتقدین به راه حسین علیه السلام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 147.04,
   "end": 151.58,
   "text": "نوزدهمین برنامه چراغ هدایت را می‌شنوید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 151.58,
   "end": 161.8,
   "text": "در این برنامه ادامه صحبت‌های استاد فرزانه حضرت آیت الله محمد شجاعی را در باب شخصیت حضرت سید الشهدا علیه السلام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 161.8,
   "end": 165.7,
   "text": "و برخی یاران آن بزرگوار می‌شنوید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 165.7,
   "end": 169.9,
   "text": "در برنامه قبل استاد به دو شخصیت بزرگوار از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 169.9,
   "end": 178.1,
   "text": "اصحاب حضرت اشاره کردند که یکی حبیب بن مظاهر و دیگری حر بن یزید ریاحی است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 178.1,
   "end": 187.92,
   "text": "ایشان توضیح دادند که حر چگونه راه را بر حضرت سید الشهدا علیه السلام بست و در عین اینکه به ظاهر به سوی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 187.92,
   "end": 190.2,
   "text": "جهنم در حرکت است،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 190.2,
   "end": 193.04,
   "text": "چگونه به سوی جنت روانه شد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 193.04,
   "end": 197.3,
   "text": "و اسراری در این بین وجود دارد که از این شخصیت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 197.3,
   "end": 200.5,
   "text": "چهره جاودانه دیگری ساخت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 200.5,
   "end": 206.4,
   "text": "ادامه بحث استاد را در باب شخصیت حر در این برنامه خواهید شنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 206.4,
   "end": 211.06,
   "text": "در ادامه استاد پرده از باطن شخصیت دیگری برمی‌دارد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 211.06,
   "end": 216.12,
   "text": "که جنت به او رو یاورد اما قابلیت نداشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 216.12,
   "end": 219.28,
   "text": "بشنوید. بسم الله الرحمن الرحیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 219.28,
   "end": 225.1,
   "text": "أشهد أن لا إله إلا الله رب العالمين وصلى الله على محمد وآله الطاهرين.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 225.1,
   "end": 228.28,
   "text": "ان وقت- خودش هم آمده اقرار هم کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 228.28,
   "end": 232.26,
   "text": "آمد پیش حسین علیه السلام گفت که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 232.26,
   "end": 239.7,
   "text": "أنا صاحب. من آن دوست شما هستم اینطور گفت سلام داد گفت یا حسین من آن کسی هستم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 239.7,
   "end": 241.98,
   "text": "نگذاشتم شما برگردید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 241.98,
   "end": 244.48,
   "text": "چه کردم؟ چه کردم؟ اینها را شمرد و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 244.48,
   "end": 252.1,
   "text": "جمع شما را آوردم در اینجا و شما را در اینجا هم محصور کردم در این بیابان بیابان و اینجورم که دیگه جمع،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 252.1,
   "end": 256.08,
   "text": "جمعیت زیادی آمده بودند و محاصره شده بود و دیگه بنای محاصره بود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 256.08,
   "end": 258.78,
   "text": "دقیقا روز عاشورا بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 258.78,
   "end": 263.86,
   "text": "بعد گفت که اما من نمی‌دانستم این چنین همه اش با شما رفتار می‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 263.86,
   "end": 272.14,
   "text": "من فکر نمی‌کردم که این چنین باشد این مردم چنین می‌کنند و فکر می‌کردم مطلب شما را قبول می‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 272.14,
   "end": 278.0,
   "text": "در عین حال و الا نمی‌کردم این را گفت و الا نمی‌کردم آنچه که کردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 278.0,
   "end": 280.46,
   "text": "البته این گفتارشان مسلماً درست است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 280.46,
   "end": 288.7,
   "text": "او ظاهراً فکر می‌کرده که مسئله به نحوی غیر این نحو که شد خواسته را پیدا می‌کند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 288.7,
   "end": 292.38,
   "text": "مثلاً حرف سید الشهدا قبول بشود یا چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 292.38,
   "end": 299.32,
   "text": "بعد گفت که نمی‌کردم و الا نمی‌کردم اینها، آن چه کردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 299.32,
   "end": 305.62,
   "text": "بعد گفت که حالا یا رسول الله من در عین حال تائپم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 305.62,
   "end": 307.62,
   "text": "توبه کرده‌ام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 307.62,
   "end": 313.21,
   "text": "گفت که بعد تا اینجا گفتم اینها همه‌اش اون ریزه کاری‌هاست که انجام داد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 313.21,
   "end": 317.06,
   "text": "گفت که حالا خب خیلی سخته این توبه به جاش بیفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 317.06,
   "end": 320.96,
   "text": "مگر اینکه همان باب توبه که خود سید الشهداست رو روش باز بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 320.96,
   "end": 324.33,
   "text": "توجه می‌کنین؟ چون باب الله هست، باب توبه هم اونجاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 324.33,
   "end": 330.06,
   "text": "تمام این باب اونجاست. باب آزاد، باب توبه هم اونجاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 330.06,
   "end": 339.16,
   "text": "خب اینجا با خود سید الشهدا سلام الله علیه مواجه می‌شود و می‌شود مشکل حل بشود اما خیلی سخت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 339.16,
   "end": 342.76,
   "text": "گفت که من تائب هستم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 342.76,
   "end": 345.14,
   "text": "فهل تری لی în توبه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 345.14,
   "end": 349.46,
   "text": "اینجور گفت. گفت که حالا شما راه توبه برای من باز می‌بینید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 349.46,
   "end": 353.18,
   "text": "اینجور سؤال کرد. راه توبه را برای من باز می‌بینید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 353.18,
   "end": 357.96,
   "text": "سید الشهدا فرمود که خدای متعال تو، توبه تو را قبول می‌کند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 357.96,
   "end": 364.56,
   "text": "مطلب تمام شد. خدای متعال توبه تو را قبول می‌کند و خدا به سوی تو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 364.56,
   "end": 367.14,
   "text": "بازگشت می‌کند به رحمتش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 367.14,
   "end": 369.3,
   "text": "اینجاش رو دقت کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 369.3,
   "end": 373.1,
   "text": "گفته به سیدالشهدای سلام الله علیه بعد اینکه توبه قبول شده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 373.1,
   "end": 380.08,
   "text": "و مطلب حل شده، خودش تازه بیدار شده و مطلب به یادش افتاده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 380.08,
   "end": 387.03,
   "text": "گفت که یابن رسول الله من اون وقتی که ابن زیاد منو از کوفه که مامور شدم بیام به سوی شما،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 387.03,
   "end": 389.96,
   "text": "از قصر ابن زیاد که خارج شدم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 389.96,
   "end": 393.34,
   "text": "این جریان واقعا عجیبیه. یعنی خودش نقل کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 393.34,
   "end": 396.64,
   "text": "این را یکی نقل کرده در بحار هم آورده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 396.64,
   "end": 401.77,
   "text": "اِاِاِ یکی از رواه نقل کرده که حر گفت که یعنی اون وقت یادش افتاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 401.77,
   "end": 408.68,
   "text": "اون وقت که من از کوفه مأموریت پیدا کردم بیام مقابل شما را بگیرم و ببرم به پیش ابن زیاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 408.68,
   "end": 414.92,
   "text": "مامور که بودم مأموریت و به من داده شده بود از قصر یعنی از کاخ از قصر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 414.92,
   "end": 420.28,
   "text": "ابن زیاد که خارج می‌شدم، خارج که شدم می‌خواستم بیام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 420.28,
   "end": 422.74,
   "text": "و بالاخره جمع خودمو جمع کنم بیام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 422.74,
   "end": 425.86,
   "text": "دفعةً من یه صدایی شنیدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 425.86,
   "end": 429.5,
   "text": "صدا به من گفت که أبشر بالخير.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 429.5,
   "end": 432.34,
   "text": "أبشر یا حر بالخير.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 432.34,
   "end": 437.48,
   "text": "معنی این جمله این هست که ای حر مژده باد به تو خیر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 437.48,
   "end": 442.76,
   "text": "یک چنین ندایی شنیدم و برگشتم هم نگاه کردم کسی را ندیدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 442.76,
   "end": 445.04,
   "text": "همش تو فکر بود اون وقت این ندا چه بود؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 445.04,
   "end": 446.86,
   "text": "یه ندای غیبی بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 446.86,
   "end": 452.36,
   "text": "وقتی از دارالعمارة خارج شده برای اینکه بیاید با سیدالشهدای مقابله کند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 452.36,
   "end": 455.52,
   "text": "این ندا را شنیده. حر خودش میگه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 455.52,
   "end": 461.12,
   "text": "سیدالشهدای میگه. دیگه حتی من خب اون وقت فکر هم نمی‌کردم بیام رو شما ملحق بشوم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 461.12,
   "end": 465.96,
   "text": "فکر من چیزی دیگه بود. این ندا را شنیدم کسی هم ندیدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 465.96,
   "end": 469.66,
   "text": "پیش خودم گفتم که این چه بشارتیست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 469.66,
   "end": 473.12,
   "text": "من میرم با حسین بن علی مقابله بکنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 473.12,
   "end": 475.71,
   "text": "الان فهمیدم که بشارت چه بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 475.71,
   "end": 483.6,
   "text": "دقت می‌کنید؟ الان فهمیدم که بشارت با این مقدمات بالاخره رفت در پانیان در،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 483.6,
   "end": 487.08,
   "text": "در برابره عبدالله سلام الله علیه شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 487.08,
   "end": 490.34,
   "text": "رفت اول از اون کساری هم هست که اجابت خواست گفت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 490.34,
   "end": 497.58,
   "text": "چون اول کسی بودم که با شما مقابله کردم اول کسی هم می‌خواهم باشم که هدای شما را تازه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 497.58,
   "end": 501.9,
   "text": "تأثیر کرده بود رفته و با شهامت و شجاعت هم جنگیده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 501.9,
   "end": 506.98,
   "text": "حسامی را هم کشته بالاخره در آخر هم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 506.98,
   "end": 514.16,
   "text": "افتاده. یاران سیدالشهدای بعد از افتادن وجود نیاید یک دکه خاک که رمه و جزئی درش مونده بود او را",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 514.16,
   "end": 516.32,
   "text": "آوردند به خیر نگاه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 516.32,
   "end": 520.24,
   "text": "به نزد ابا عبدالله آوردند از معرکه میدان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 520.24,
   "end": 524.1,
   "text": "آوردند و لحظات آخرش بود اما نمرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 524.1,
   "end": 528.34,
   "text": "یعنی روح از بدنش کاملاً طلاقه نکرده بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 528.34,
   "end": 530.54,
   "text": "عرض کنم که خب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 530.54,
   "end": 538.8,
   "text": "نوشتن که همین که گذاشتن بدن مجروحش را که لحظات آخرش بود سرش را سیدالشهدای گرفته روی زانوییش گرفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 538.8,
   "end": 544.3,
   "text": "این مطلب را گفته. گفت که خب نام حر، حر هست دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 544.3,
   "end": 548.56,
   "text": "حر یعنی آزاد. معنی لغوی حر آزاد است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 548.56,
   "end": 551.92,
   "text": "گفت که سیدالشهدای الان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 551.92,
   "end": 556.18,
   "text": "خودتون ببینید مسئله از کجا آمد در کجا منتهی شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 556.18,
   "end": 561.98,
   "text": "گفت که در روی زانو سیدالشهدای،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 561.98,
   "end": 566.24,
   "text": "در آغوش ابا عبدالله سلام الله علیه جان روح",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 566.24,
   "end": 570.64,
   "text": "با نظر به صورت سیدالشهدای خارج بشود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 570.64,
   "end": 572.7,
   "text": "این دیگه هرکس بفهمد می‌فهمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 572.7,
   "end": 576.2,
   "text": "لابد تعبیری هم می‌فهمید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 576.2,
   "end": 584.64,
   "text": "گفت که أنته حر كما سمتک أمک یعنی تو واقعاً آزادی همانطور که مادرت این اسم را به تو انتخاب کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 584.64,
   "end": 588.32,
   "text": "بعد گفت أنته حر في الدنيا و أنته حر في الآخرة.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 588.32,
   "end": 591.87,
   "text": "تو در دنیا هم آزادی در آخرت هم آزادی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 591.87,
   "end": 594.8,
   "text": "این جملات را شنید و روح هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 594.8,
   "end": 597.74,
   "text": "از بدنش مفارقت کرد. این یک نکته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 597.74,
   "end": 600.86,
   "text": "بود. حالا من بعضی نکات دیگر هم عرض کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 600.86,
   "end": 605.32,
   "text": "در همین جریان که حضرت سیدالشهدای سلام الله علیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 605.32,
   "end": 608.76,
   "text": "گفتم با حر مواجه شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 608.76,
   "end": 613.06,
   "text": "اونجا عرض که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 613.06,
   "end": 619.48,
   "text": "با همان جمعش تو اون راه که انتخاب کردن می‌آمدند و وجود نیاید هم با جمعش در اون حالت تحمیض و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 619.48,
   "end": 623.02,
   "text": "درازادن که الان قبلاً گفتم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 623.02,
   "end": 625.28,
   "text": "قبل از اینکه برسند به کربلا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 625.28,
   "end": 627.24,
   "text": "حالا نکته مقابل جریان را دقت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 627.24,
   "end": 630.22,
   "text": "بکنید. قبل از اینکه برسند به کربلا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 630.22,
   "end": 632.84,
   "text": "چند مونده بود؟ در یکی از مناظر وسط راه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 632.84,
   "end": 635.0,
   "text": "یعنی اون راه که انتخاب کردن می‌آمدند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 635.0,
   "end": 641.68,
   "text": "در عرض که، در یکی از مناظر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 641.68,
   "end": 645.92,
   "text": "که خیمه، همین اونجا تلقی کردن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 645.92,
   "end": 651.5,
   "text": "جمع سیدالشهدای در یک طرف و جمع وجود نیاید یحیی هم در یک طرف دیگر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 651.5,
   "end": 654.08,
   "text": "اونجا حضرت نظرش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 654.08,
   "end": 659.58,
   "text": "سلام الله علیه افتاد به یه خیمه‌ای که اونجا بود در همون جا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 659.58,
   "end": 665.58,
   "text": "خیمه زده بودند. گفت که این خیمه سؤال فرمود این خیمه مال کیه اینجا زدن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 665.58,
   "end": 670.4,
   "text": "عرض کنم که گفتند که مخصوص",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 670.4,
   "end": 674.04,
   "text": "عبیدالله بن بر جُعفی است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 674.04,
   "end": 679.92,
   "text": "شخصی به نام عبیدالله فرزند بر از جُعفی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 679.92,
   "end": 684.66,
   "text": "حضرت سیدالشهدای سلام الله علیه فرمود که قاصدی فرستاد که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 684.66,
   "end": 688.1,
   "text": "برود به اون بگوید که سیدالشهدای او را می‌خواهد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 688.1,
   "end": 691.54,
   "text": "به عبیدالله بن بر جُعفی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 691.54,
   "end": 696.43,
   "text": "قاصد ابا عبدالله سلام الله علیه آمد وارد خیمه اون شخص شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 696.43,
   "end": 699.76,
   "text": "اونجا خیمه زده بود و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 699.76,
   "end": 703.49,
   "text": "سلام داد و گفت که حسین بن علی تو را می‌خواهد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 703.49,
   "end": 711.21,
   "text": "این مطلب را. این گفت که همین این جمله را شنید تکان خورد ناراحت شد گفت إنا لله وإنا إليه راجعون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 711.21,
   "end": 713.68,
   "text": "مصیبت آمد سرش. دقت بکنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 713.68,
   "end": 716.18,
   "text": "این جمله رو اون وقت میگه که چی بشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 716.18,
   "end": 718.46,
   "text": "مصیبت بشه بگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 718.46,
   "end": 721.36,
   "text": "یعنی خیلی سخت تکان خورد. این چه مصیبتیست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 721.36,
   "end": 725.26,
   "text": "خود سیدالشهدای خودش تعریف فرستاده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 725.26,
   "end": 728.28,
   "text": "إنا لله وإنا إليه راجعون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 728.28,
   "end": 732.16,
   "text": "حالا ما که از دور نگاه می‌کنیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 732.16,
   "end": 736.0,
   "text": "ما هم باید بگیم که «إن لله وإنه إليه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 736.0,
   "end": 740.28,
   "text": "راجعون». مطلب چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 740.28,
   "end": 745.64,
   "text": "گفت که بعد دنبالش گفت که خیلی ناراحت شد «إن لله وإنه إليه راجعون».",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 745.64,
   "end": 748.32,
   "text": "گفت که من اصلاً از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 748.32,
   "end": 751.52,
   "text": "کوفه آمدم بیرون، به اون شخص گفتم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 751.52,
   "end": 755.68,
   "text": "از کوفه آمدم بیرون برای اینکه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 755.68,
   "end": 759.46,
   "text": "فکر می‌کردم احتمال می‌دادم حسین بن علی بیاد به کوفه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 759.46,
   "end": 762.18,
   "text": "می‌خواستم اصلاً من اونجا نباشم اون وقت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 762.18,
   "end": 765.78,
   "text": "چون می آمد به کوفه دیگه اول قصه اینطور بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 765.78,
   "end": 771.34,
   "text": "اصلاً من می‌خواستم به قاصد گفت من می‌خواستم اونجا نباشم اون وقت حسین بن علی میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 771.34,
   "end": 773.88,
   "text": "می‌خواستم نه من او را ببینم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 773.88,
   "end": 780.18,
   "text": "نه او مرا ببیند. حتی برای این از کوفه من خارج شدم، مهاجرت کردم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 780.18,
   "end": 782.96,
   "text": "و این جمله را گفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 782.96,
   "end": 786.82,
   "text": "حالا دوباره دارد تکرار می‌کند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 786.82,
   "end": 795.18,
   "text": "بعد این قاصد آمد و به سری الشهدا سلام الله علیه گفت که اینجور جواب را گفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 795.18,
   "end": 797.32,
   "text": "خود سری الشهدا سلام الله علیه بلند شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 797.32,
   "end": 800.46,
   "text": "حالا مطلب اینجا شده که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 800.46,
   "end": 804.02,
   "text": "خودش بلند شد. بهشت و بهشتها آمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 804.02,
   "end": 810.94,
   "text": "آمد و وارد خیمه اون شخص خودش یعنی قاصد آمد اینجوری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 810.94,
   "end": 817.84,
   "text": "خود حضرت بلند شده آمده به وارد خیمه همان ابو عیدالله بن حر جُعفی شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 817.84,
   "end": 825.02,
   "text": "وارد شد و هر جور سلام داد حضرت و گفت که من آمده‌ام تو را برای نصرت خودمون دعوت می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 825.02,
   "end": 828.98,
   "text": "برای یاری خودمون دعوت می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 828.98,
   "end": 832.39,
   "text": "این شخص برگشت به خود سری الشهدا عین همان جملات را گفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 832.39,
   "end": 835.82,
   "text": "عین همان جملاتی که به اون قاصد گفته بود گفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 835.82,
   "end": 840.18,
   "text": "بعد حضرت فقط اینطور یک شعری هست هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 840.18,
   "end": 844.6,
   "text": "می‌گفتند جنت آمده به آغوشش کشیده صلاحیت نبوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 844.6,
   "end": 850.86,
   "text": "گوهر پاک باید که شود قابل قدر زنه هر سنگ و گلی لعل و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 850.86,
   "end": 856.26,
   "text": "مرجان نشود. اینو اینجور گفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 856.26,
   "end": 863.1,
   "text": "اینو حافظ گفته. مولوی اشعاری دارد در اینجا البته در اینجاست در این مضمون است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 863.1,
   "end": 867.12,
   "text": "مولوی می‌گوید که حالا این از مرگ می‌ترسد یک بنده خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 867.12,
   "end": 871.4,
   "text": "تعجب می‌کنید؟ اما این از مرگ می‌ترسد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 871.4,
   "end": 876.1,
   "text": "بالاخره مطلب چقدر فرق می‌کند با مطلب حضرت یزید ریاحی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 876.1,
   "end": 879.64,
   "text": "اون تا اونجا آمد و آنچنان شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 879.64,
   "end": 886.6,
   "text": "اینجا هم خود شخص سری الشهدا سلام الله علیه بلند شده آمده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 886.6,
   "end": 888.84,
   "text": "نمی‌دانم. گفتم اینا همش اسرار است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 888.84,
   "end": 893.78,
   "text": "همش اسرار است و در اینها گوش‌دار دهنده هم هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 893.78,
   "end": 903.34,
   "text": "آیا همان است که حافظ گفت گوهر پاک باید که شود قابل قدر زنه هر سنگ و گلی لعل و مرجان نشود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 903.34,
   "end": 906.48,
   "text": "آیا از ترق پاک این نشأت می‌گیرد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 906.48,
   "end": 908.46,
   "text": "و باید به خدا پناه برد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 908.46,
   "end": 911.62,
   "text": "مجنون. این آزمایش‌ها می‌آید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 911.62,
   "end": 915.68,
   "text": "مسئله چیه؟ مولوی می‌گوید که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 915.68,
   "end": 917.98,
   "text": "آنکه در جریان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 917.98,
   "end": 924.14,
   "text": "حمزه حمزه بن عبدالمطلب داستانی دارد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 924.14,
   "end": 927.88,
   "text": "حالا مولوی گفته تشریح این است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 927.88,
   "end": 929.82,
   "text": "گفته است که حمزه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 929.82,
   "end": 933.16,
   "text": "حمزه عموی پیغمبر اسلام الله علیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 933.16,
   "end": 934.94,
   "text": "حمزه مرد شجاعی بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 934.94,
   "end": 937.5,
   "text": "خیلی معروف بوده شجاع و جنگجو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 937.5,
   "end": 939.18,
   "text": "خیلی مرد بزرگی هم بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 939.18,
   "end": 947.88,
   "text": "حالا قبل از اینکه جنگ‌های پیغمبر و جنگ‌های اسلام پیش بیاد از نظر شجاعت معروف بوده و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 947.88,
   "end": 954.46,
   "text": "این مولوی می‌گوید داستانش اینطور است که بی وصل جنگ می‌کرد در جوانی حمزه در جوانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 954.46,
   "end": 958.2,
   "text": "حالا اون زمان. خب به جنگ‌ها که می‌رفت زره می‌پوشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 958.2,
   "end": 961.34,
   "text": "لباس جنگ می‌پوشید آماده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 961.34,
   "end": 969.78,
   "text": "اما اون وقت که پیر بود و جنگ‌های اسلامی شروع شده بود توحیدی و الهی به امر رسول اکرم صلوات الله علیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 969.78,
   "end": 974.0,
   "text": "این حمزه در و به امر خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 974.0,
   "end": 981.24,
   "text": "در اون جنگ‌ها که بعداً بود اون وقت حمزه پیر بود اما باز شجاعت خودش را داشت اما پیر بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 981.24,
   "end": 984.32,
   "text": "اون وقت دیگه همینطور بی‌زره می‌رفت جنگ.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 984.32,
   "end": 987.38,
   "text": "دیگه زره‌ها نمی‌پوشید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 987.38,
   "end": 995.38,
   "text": "و اینا را در اشعار خوب گفته مولوی که چون جوان بودی و زفت و سحزه تو نمی‌رفتی سوی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 995.38,
   "end": 999.64,
   "text": "سبکی زره. چون شدی پیر و ضعیف و منحنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 999.64,
   "end": 1003.55,
   "text": "سال در نزد پرده‌های لاغ و بال می‌زنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 214,
   "start": 1003.55,
   "end": 1006.6,
   "text": "این چیه؟ الان دیگه بی‌زره میره. البته طولانش اشعارش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 215,
   "start": 1006.6,
   "end": 1009.1,
   "text": "بعد حمزه یک نکته اینجا بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 216,
   "start": 1009.1,
   "end": 1012.18,
   "text": "حمزه بن عبدالمطلب گفت که خب اون وقت جنگ می‌کردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 217,
   "start": 1012.18,
   "end": 1016.8,
   "text": "اون یه مسئله‌ای بود. اون وقت مرگ برای ما یک مسئله‌ای بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 218,
   "start": 1016.8,
   "end": 1020.12,
   "text": "اما الان مرگ برای ما مسئله‌ی دیگه‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 219,
   "start": 1020.12,
   "end": 1021.65,
   "text": "اون مرگ یک معنا داشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 220,
   "start": 1021.65,
   "end": 1025.5,
   "text": "این مرگ الان هست حالا که دیگه زره پوشیدن لازم نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 221,
   "start": 1025.5,
   "end": 1032.84,
   "text": "اشعارو می‌گوید بعد مولوی می‌گوید که حالا اون به اصطلاح شخصی که سری الشهدا بهش گفت که إن لله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 222,
   "start": 1032.84,
   "end": 1037.8,
   "text": "به قاصد گفت و به خودش هم اون جواب را «إن لله وإنه إليه راجعون» از کوفه هستم خارج شدم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 223,
   "start": 1037.8,
   "end": 1040.74,
   "text": "شما را نبینم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 224,
   "start": 1040.74,
   "end": 1045.82,
   "text": "می‌گوید که آن که مردن پیش جانش تهلُچ است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 225,
   "start": 1045.82,
   "end": 1049.32,
   "text": "تهلُچ «لا تُلْقُوا بَعْضِكُمْ إِلَى التَّهْلُكَةِ».",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 226,
   "start": 1049.32,
   "end": 1054.97,
   "text": "آن که مردن پیش جانش تهلُچ است امر لا تُلْقُوا بگیرد او به دست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 227,
   "start": 1054.97,
   "end": 1058.34,
   "text": "«لا تُلْقُوا بَعْضِكُمْ إِلَى التَّهْلُكَةِ».",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 228,
   "start": 1058.34,
   "end": 1066.12,
   "text": "و آن که مردن پیش او شد خط باب مانند حمزه سلام الله علیه مانند حضرت یزید ریاحی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 229,
   "start": 1066.12,
   "end": 1070.84,
   "text": "اون اولی مانند همان شخص عیدالله بن حر جُعفی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 230,
   "start": 1070.84,
   "end": 1077.8,
   "text": "و آن که مردن پیش او شد خط هباب سارع او آمد مر او را در خطاب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 231,
   "start": 1077.8,
   "end": 1081.33,
   "text": "اون یکی لا تُلْقُوا بَعْضِكُمْ فوراً یادش می‌افته از قرآن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 232,
   "start": 1081.33,
   "end": 1085.82,
   "text": "این یکی چه چیز یادش می‌افته؟ سارعوا إلى مغفرة من ربكم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 233,
   "start": 1085.82,
   "end": 1091.7,
   "text": "بعد مولوی می‌گوید الهذر ای مرگ بینا دارعوا دارعوا یعنی زره بپوشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 234,
   "start": 1091.7,
   "end": 1094.94,
   "text": "الهذر ای مرگ بینا دارعوا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 235,
   "start": 1094.94,
   "end": 1097.64,
   "text": "العجل ای عاشر بینا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 236,
   "start": 1097.64,
   "end": 1100.95,
   "text": "عاشر بینا سارعوا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 237,
   "start": 1100.95,
   "end": 1104.87,
   "text": "الصَّلاَةِ لُطْفًا إِنَانِ اِفْرَهُ.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 238,
   "start": 1104.87,
   "end": 1108.85,
   "text": "الصَّلاَةِ لُطْفًا إِنَانِ اِفْرَهُ.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 239,
   "start": 1108.85,
   "end": 1111.97,
   "text": "البَلاءِ تَاحْ إِنَانِ اِفْرَهُ.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 240,
   "start": 1111.97,
   "end": 1115.61,
   "text": "یعنی شما به ترتیب محظون باشید اینها یک تشابه هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 241,
   "start": 1115.61,
   "end": 1117.95,
   "text": "البَلاءِ تَاحْ إِنَانِ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 242,
   "start": 1117.95,
   "end": 1132.31,
   "text": "اِفْرَهُ. آن انگشت این هم انگشت که ترتیب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 243,
   "start": 1132.31,
   "end": 1151.47,
   "text": "حسین، حسین،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 244,
   "start": 1151.47,
   "end": 1156.23,
   "text": "حسین مولای يا حسین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 245,
   "start": 1156.23,
   "end": 1163.05,
   "text": "يا حسین. حسین، حسین، حسین مولای يا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 246,
   "start": 1163.05,
   "end": 1165.77,
   "text": "حسین. يا حسین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 247,
   "start": 1165.77,
   "end": 1168.23,
   "text": "حسین، حسین مولای يا حسین. حسین، حسین،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 248,
   "start": 1168.23,
   "end": 1170.39,
   "text": "حسین مولای يا حسین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 249,
   "start": 1170.39,
   "end": 1174.97,
   "text": "حسین، حسین، حسین مولای يا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 250,
   "start": 1174.97,
   "end": 1177.61,
   "text": "حسین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 251,
   "start": 1177.61,
   "end": 1184.77,
   "text": "يا حسین. حسین، حسین، حسین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 252,
   "start": 1184.77,
   "end": 1189.65,
   "text": "مولای يا حسین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 253,
   "start": 1189.65,
   "end": 1199.61,
   "text": "يا حسین. دوستان عزیز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 254,
   "start": 1199.61,
   "end": 1204.55,
   "text": "بحث این برنامه استاد آیت الله محمد شجاعی را شنیدید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 255,
   "start": 1204.55,
   "end": 1208.37,
   "text": "ادامه این بحث را در برنامه بعد بشنوید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 256,
   "start": 1208.37,
   "end": 1228.37,
   "text": "خدا یار و نگهدارتان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 257,
   "start": 1241.07,
   "end": 1244.39,
   "text": "خوشا قلبی که دنبال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 258,
   "start": 1244.39,
   "end": 1246.51,
   "text": "حسین است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 259,
