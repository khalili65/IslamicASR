   "start": 168.34,
   "end": 268.3
  },
  {
   "index": 1,
   "title": "## رضای حسین، رضای رحمان",
   "start": 268.3,
   "end": 315.03
  },
  {
   "index": 2,
   "title": "## تجلّی ربوبی بر رسول و حضور سیّدالشّهدا",
   "start": 315.03,
   "end": 367.0
  },
  {
   "index": 3,
   "title": "## مصیبت سیّدالشّهدا در محفل اهل سر از ازل",
   "start": 367.0,
   "end": 420.54
  },
  {
   "index": 4,
   "title": "## آدم تا آخر پیامبران؛ شراکت در مصیبت و خون خدا",
   "start": 420.54,
   "end": 603.38
  },
  {
   "index": 5,
   "title": "## آدم، اسماء خمسه و اشک بر نام حسین",
   "start": 603.38,
   "end": 1060.21
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 1.42,
   "end": 4.56,
   "text": "حسین، حسین،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 4.56,
   "end": 12.36,
   "text": "حسین، حسین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 12.36,
   "end": 14.25,
   "text": "حسین، حسین، حسین، حسین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 14.25,
   "end": 16.9,
   "text": "شهید چرا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 16.9,
   "end": 20.05,
   "text": "داد حسین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 20.05,
   "end": 23.18,
   "text": "حسین، حسین، حسین، حسین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 23.18,
   "end": 27.66,
   "text": "بری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 27.66,
   "end": 32.24,
   "text": "بنه نه حسین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 32.24,
   "end": 35.52,
   "text": "حسین، حسین، حسین-",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 35.52,
   "end": 49.54,
   "text": "السلام علیک یا أبا عبدالله الحسین- حسین، حسین- وعلی الارواح التي",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 49.54,
   "end": 59.26,
   "text": "حلت- حسین، حسین، حسین، حسین- بثغرك.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 59.26,
   "end": 68.84,
   "text": "حسین، حسین، حسین، حسین. بری بنه نه حسین. حسین، حسین، حسین- چراغ هدایت. چراغ و مصباح هدایت تویی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 68.84,
   "end": 77.16,
   "text": "چراغ و مصباح هدایت تویی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 77.16,
   "end": 82.54,
   "text": "سفینه‌ی غصه‌ را",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 82.54,
   "end": 88.86,
   "text": "یم کن. سفینه‌ی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 88.86,
   "end": 91.72,
   "text": "غصه‌ را",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 91.72,
   "end": 96.62,
   "text": "یم کن. بسم الله الرحمن الرحيم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 96.62,
   "end": 102.36,
   "text": "وهو رب الحسین الذي قتل عطشانا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 102.36,
   "end": 106.04,
   "text": "سلام بر حسین و عاشقان حسین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 106.04,
   "end": 111.46,
   "text": "دوستان این ششمین برنامه چراغ هدایت است که می‌شنوید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 111.46,
   "end": 117.86,
   "text": "در این برنامه استاد فرزانه آیت الله محمد شجاعی اسراری از شخصیت حضرت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 117.86,
   "end": 122.46,
   "text": "سید و شهدا علیه السلام را برای ما بیان می‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 122.46,
   "end": 126.08,
   "text": "در برنامه گذشته شنیدیم که استاد به شرح این نکته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 126.08,
   "end": 133.58,
   "text": "مهم پرداختند که بیت المعمور مرتبه نازله عرش خداست و کعبه مرتبه نازله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 133.58,
   "end": 136.72,
   "text": "بیت المعمور بر زمین است و کعبه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 136.72,
   "end": 141.58,
   "text": "که در بیت الله هست در عالم ظاهر خانه خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 141.58,
   "end": 146.3,
   "text": "اما قلب سید و شهدا علیه السلام حقیقت عرش است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 146.3,
   "end": 148.5,
   "text": "و بیت الله در اصل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 148.5,
   "end": 152.3,
   "text": "وجود مقدس امام حسین علیه السلام است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 152.3,
   "end": 157.42,
   "text": "این نکته را استاد مستند به آیات و روایات بحث کردند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 157.42,
   "end": 162.64,
   "text": "در این برنامه استاد نکات دیگری را در رابطه با شخصیت و جایگاه حضرت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 162.64,
   "end": 168.34,
   "text": "سید و شهدا علیه السلام بیان می‌کنند که به اتفاق می‌شنوید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 168.34,
   "end": 170.32,
   "text": "بسم الله الرحمن الرحيم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 170.32,
   "end": 176.84,
   "text": "الحمد لله رب العالمين وصلى الله على محمد و آله الطاهرين.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 176.84,
   "end": 180.1,
   "text": "بسم الله الرحمن الرحيم. بعد جملاتی در زیارت نامه‌است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 180.1,
   "end": 187.56,
   "text": "يا مَنْ رِضاهُ مِن رِضَا الرَّحمن وسَخَطُهُ مِن سَخَطِ الرَّحمن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 187.56,
   "end": 190.3,
   "text": "خب این جمله، جمله ساده‌ای نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 190.3,
   "end": 194.36,
   "text": "ای آن کسی که رضاش رضای رحمان است،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 194.36,
   "end": 196.54,
   "text": "سخطش سخط رحمان است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 196.54,
   "end": 199.82,
   "text": "رضای رحمان عاملش حضرت است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 199.82,
   "end": 203.22,
   "text": "همان‌طور که سخطش را هم عاملش اوست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 203.22,
   "end": 205.19,
   "text": "سخط او سخط رحمان است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 205.19,
   "end": 208.26,
   "text": "رضای او رضای رحمان است و رضا هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 208.26,
   "end": 217.32,
   "text": "انشاالله اگر شما بیدار بودید، هوشیار بودید و اهل درک بودید، خواستید یک وقتی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 217.32,
   "end": 219.76,
   "text": "رضای خدا را به دست بیارید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 219.76,
   "end": 227.22,
   "text": "و در طریق هدایت نظر خدا را برای خودتان کسب کنید، باید سعی در توجه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 227.22,
   "end": 231.74,
   "text": "کسب توجه حضرت ابی عبدالله سلام الله علیه داشته باشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 231.74,
   "end": 235.1,
   "text": "يا مَنْ رِضاهُ مِن رِضَا الرَّحمن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 235.1,
   "end": 238.16,
   "text": "وسَخَطُهُ مِن سَخَطِ الرَّحمن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 238.16,
   "end": 241.16,
   "text": "یا مثلاً بعضی قطعات هست که می‌گوید که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 241.16,
   "end": 245.0,
   "text": "به خود حضرت اشاره می‌کند و می‌گوید که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 245.0,
   "end": 250.18,
   "text": "من راهی را که باید بیایم و در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 250.18,
   "end": 253.26,
   "text": "کنار تو قرار بگیرم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 253.26,
   "end": 256.2,
   "text": "در چه حالتی است؟ دقت می‌کنید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 256.2,
   "end": 260.82,
   "text": "آن راهی که من باید در پیش بگیرم و بیایم و تحت چه حالتی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 260.82,
   "end": 267.17,
   "text": "تو بیفتم، در این راه به من توجه کن تا من بتوانم این راه را بیایم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 267.17,
   "end": 271.72,
   "text": "معنیش این است که اگر راه را موفق بودیم تحت چه حالتی او قرار خواهیم گرفت؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 271.72,
   "end": 274.58,
   "text": "و این چنین است یکی از اسرار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 274.58,
   "end": 279.46,
   "text": "دقت می‌کنید؟ در بعضی از قطعات زیارت‌نامه‌ها هست که به حضرت خطاب می‌کند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 279.46,
   "end": 282.08,
   "text": "می‌گوید که الله الله!",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 282.08,
   "end": 285.96,
   "text": "تو را به خدا قسم می‌دهم که مرا تنها نگذار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 285.96,
   "end": 289.84,
   "text": "به حضرت خطاب می‌کند. مرا تنها نگذار در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 289.84,
   "end": 297.6,
   "text": "آن مسائل و شدائد و عتبات و منازلی که در پیش است، تنها نگذار مرا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 297.6,
   "end": 299.98,
   "text": "الله الله لا تخذلنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 299.98,
   "end": 305.57,
   "text": "مرا تنها نگذار در آنجا که باید تو به سراغَم بیایی و این‌ها اسرار است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 305.57,
   "end": 309.1,
   "text": "این برای همه است، برای یک نفری که زیارت می‌خواند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 309.1,
   "end": 311.62,
   "text": "می‌گوید برای هر کسی اینطور است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 311.62,
   "end": 315.01,
   "text": "برای هر کسی که می‌خواهد راهی پیدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 315.01,
   "end": 321.84,
   "text": "کند. در یکی از تجلیات ربوبی که برای رسول اکرم صلی الله علیه و آله و سلم پیش آمد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 321.84,
   "end": 325.42,
   "text": "البته این روایتی بود که من می‌خواستم بخوانم ولی برای اینکه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 325.42,
   "end": 330.51,
   "text": "خلاصه بگذریم از اینجا دیگه تصمیم من این نشد که این را بخوانم برای شما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 330.51,
   "end": 336.86,
   "text": "ولی که تجلیات ربوبی نه ملکی بیاید، نه فرشته‌ای در میان باشد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 336.86,
   "end": 342.82,
   "text": "تجلی مستقیم ربوبی بر رسول اکرم صلی الله علیه و آله و سلم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 342.82,
   "end": 347.24,
   "text": "که حضرت سید الشهدا در نزد رسول الله بود،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 347.24,
   "end": 349.02,
   "text": "خدا برایش تجلی کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 349.02,
   "end": 354.84,
   "text": "روایتی هست که خود خدا مستقیماً تجلی همون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 354.84,
   "end": 366.42,
   "text": "بلا واسطه معصوم. و سید الشهدا سلام الله علیه هم نزد رسول الله بود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 366.42,
   "end": 369.28,
   "text": "سؤالی از خدا شد که این را دوست داری؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 369.28,
   "end": 372.1,
   "text": "گفت بله دوست دارم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 372.1,
   "end": 376.54,
   "text": "این بله دوست دارم هم از رسول اکرم صلی الله علیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 376.54,
   "end": 383.54,
   "text": "به اونجا که خدا بهش اینجور میگوید از اون دوست دارم‌ها نیست که افراد عادی به بچه‌ش یا به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 383.54,
   "end": 389.98,
   "text": "به اصطلاح فرزندانشون میگن بله دوست دارم که با این روشنی وقتی در برابر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 389.98,
   "end": 394.86,
   "text": "سؤال خدا میگوید این هم به لحاظ این هست که دوست داشتن سیدالشهدا دوست داشتن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 394.86,
   "end": 397.42,
   "text": "خداست نه به عنوان که فرزندش بوده است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 397.42,
   "end": 401.58,
   "text": "اینها که در مقام تجلی ربوبی مستقیماً و در مقام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 401.58,
   "end": 406.24,
   "text": "سؤال و گفت نور چشم من است و تعبیرات دیگر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 406.24,
   "end": 409.78,
   "text": "بعد هست اونجا که دست خدا آمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 409.78,
   "end": 413.76,
   "text": "به سر ابا عبدالله صلی الله علیه و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 413.76,
   "end": 418.36,
   "text": "اون برکاتی را که در این وجود هست به اون اشاره کرد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 418.36,
   "end": 422.38,
   "text": "و خدا فرمود که اما پدرش هم از این افضل است نزد من.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 422.38,
   "end": 426.26,
   "text": "و پدرش یعنی حضرت امیر سلام الله علیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 426.26,
   "end": 428.54,
   "text": "دست خدا آمد بر سر سیدالشهدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 428.54,
   "end": 436.12,
   "text": "در مقام تجلی و برکات و مضمون این است که اونچه برکات است همین جاست و همین جا قرار داده شده است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 436.12,
   "end": 437.73,
   "text": "این‌ها یک series از اسرار است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 437.73,
   "end": 440.78,
   "text": "دقت بکنید که یک series از اسرار و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 440.78,
   "end": 443.96,
   "text": "لغایب. از طرف دیگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 443.96,
   "end": 453.66,
   "text": "می‌بینیم که مسئله، مسئله سیدالشهدا سلام الله علیه و مصیبت سیدالشهدا و کشته شدن سیدالشهدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 453.66,
   "end": 457.12,
   "text": "که قاتل کریمی و قتل مظلوم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 457.12,
   "end": 466.38,
   "text": "این هم در یاتون و این جور جمله بسیار خوب قاتل کریمی و قتل مظلوم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 466.38,
   "end": 472.26,
   "text": "این جریان مصیبت سیدالشهدا سلام الله از طرفی می‌بینیم این هم یک series از اسرار و ابنا دارد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 472.26,
   "end": 477.32,
   "text": "می‌بینیم که از اول مطرح بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 477.32,
   "end": 481.84,
   "text": "از اول مطرح بوده یعنی مسئله این نبوده که بعدها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 481.84,
   "end": 486.06,
   "text": "البته نه به اون معنا که همه چیز در دین خدا از اول مطرح است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 486.06,
   "end": 495.5,
   "text": "از اول مطرح بوده در محفل اولیا و انبیا و در جمع مردان خدا و اونها که اهل سر هستند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 495.5,
   "end": 500.06,
   "text": "انبیا و اولیا وقتی میگیم یعنی باید بگیم که اهل سر،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 500.06,
   "end": 505.96,
   "text": "ارباب سر و اونهایی که خدا به سر اونها را راه داده است به حضرت ذی اونها را راه داده است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 505.96,
   "end": 510.06,
   "text": "عرض کنم که در محفل اهل سر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 510.06,
   "end": 517.42,
   "text": "و بزرگان اهل سر و اون پیشوایان اهل سر که انبیا باشند، انبیا و حضور همه انبیا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 517.42,
   "end": 524.84,
   "text": "عرض کنم که اولیا باشند این شخص یعنی شخص حسین علیه السلام و جریان او",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 524.84,
   "end": 531.36,
   "text": "در کربلا و مصیبتش و کشته شدنش و این که خونش به زمین ریخته می‌شود و الی آخر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 531.36,
   "end": 533.98,
   "text": "این در این محفل از اول مطرح بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 533.98,
   "end": 539.22,
   "text": "این هم مسئله را دقیقاً از آرامش و حتی طوری مطرح بوده که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 539.22,
   "end": 542.92,
   "text": "حضرت یحیی سلام الله علیه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 542.92,
   "end": 551.18,
   "text": "به اصطلاح مانند حضرت سیدالشهدا سلام الله علیه به شهادت رسیده و شباهت زیادی هم داشته از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 551.18,
   "end": 553.94,
   "text": "شهادتش. به شهادت سیدالشهدا سلام الله علیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 553.94,
   "end": 560.16,
   "text": "زیاد شباهت داشته. سرش را بریده‌اند بر اساس مجاهدت بوده و عرض کنم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 560.16,
   "end": 563.1,
   "text": "همون مسیر سیدالشهدا داشته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 563.1,
   "end": 565.58,
   "text": "و عرض کنم که جریانات و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 565.58,
   "end": 569.4,
   "text": "حتی همش مانند سیدالشهدا سلام الله علیه شش ماهه بوده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 569.4,
   "end": 576.94,
   "text": "و حتی اون منزلتی که اگر آتش هست و است داخل اون و داخل سیدالشهدا مخصوص اون منیت هستند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 576.94,
   "end": 586.56,
   "text": "اون اندازه‌ای مسئله‌ای که خواستم بگم در محفل اهل سر و انبیا مطرح بوده که زکریا پدر حضرت یحیی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 586.56,
   "end": 592.8,
   "text": "سلام الله علیهم اجمعین زکریا که مشهور به اصطلاح از جریان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 592.8,
   "end": 598.88,
   "text": "کربلا که به اصطلاح براش مطرح شده حضرت زکریا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 598.88,
   "end": 606.04,
   "text": "و بارو موزیک ها آیا انسان همه این اشارات برای زکریا یاد شده است؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 606.04,
   "end": 611.56,
   "text": "عرض کنم که و جریان که مطرح شد براش زیاد، زیاد گریه می‌کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 611.56,
   "end": 616.0,
   "text": "زیاد گفتم، گفتم این اونا می‌فهمیدند یعنی چه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 616.0,
   "end": 624.52,
   "text": "این زیاد گریه می‌کرد و حتی هست که ظاهراً در مسجد دو روز یا سه روز در و ورودش بست و از اول که مطرح شد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 624.52,
   "end": 632.66,
   "text": "گریه می‌کرد. اونگاه از خدا خواست زکریا که حالا برای اینکه با رسول الله صلی الله علیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 632.66,
   "end": 637.9,
   "text": "و با امیرالمؤمنین سلام الله علیه در این جریان او هم بهتر شریک باشد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 637.9,
   "end": 639.94,
   "text": "خدا به او فرزندی بدهد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 639.94,
   "end": 644.74,
   "text": "زکریا خواست فرزندی بدهد که فرزند خوب باشد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 644.74,
   "end": 651.73,
   "text": "از اولیا باشد، بندگان خدا باشد و محبت شدید هم که از آن به او داشته باشد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 651.73,
   "end": 661.78,
   "text": "اینجور گفت خدا اینجور فرزند به من بده که از بندگان تو باشد و به من محبت شدید هم به او بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 661.78,
   "end": 664.84,
   "text": "این را هم بده و در همین دل او را",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 664.84,
   "end": 668.08,
   "text": "به مصیبتی که شبیه مصیبت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 668.08,
   "end": 676.48,
   "text": "سیدالشهدا است او را مبتلا بکن تا دل من هم همدرد با دل رسول الله باشد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 676.48,
   "end": 680.36,
   "text": "و چنین هم شد. یعنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 680.36,
   "end": 683.36,
   "text": "خدا یحیی را داد و یحیی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 683.36,
   "end": 694.02,
   "text": "که مقام بسیار بالایی داشت و خب معلوم است که زکریا او حب شدید هم داشته به لحاظ اینکه نبی بوده است در مقام بالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 694.02,
   "end": 696.62,
   "text": "و در همان حال به اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 696.62,
   "end": 702.1,
   "text": "مصیبت هم گرفتار شد. اینجور در محفل اهل سر مطرح بوده است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 702.1,
   "end": 706.66,
   "text": "انبیا و اولیا از اول حضرت آدم سلام الله علیه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 706.66,
   "end": 710.16,
   "text": "این مسئله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 710.16,
   "end": 714.52,
   "text": "برای اون حضرت تا آخر پیامبران همه شان مطرح شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 714.52,
   "end": 720.0,
   "text": "یعنی این جریان گفته شده است یا معلوم شده است یا مشهور شده است و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 720.0,
   "end": 722.26,
   "text": "نه تنها مشهور شده است،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 722.26,
   "end": 733.03,
   "text": "این اهل سر و انبیا و اولیا موظف هم بوده‌اند از اشارات این معلوم می‌شود که موظف هم بوده‌اند که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 733.03,
   "end": 735.4,
   "text": "با حضرت سیدالشهدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 735.4,
   "end": 741.27,
   "text": "از اول حضرت آدم با اون حضرت شریک مصیبت باشند و شریک هم و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 741.27,
   "end": 749.95,
   "text": "غم باشند و بلکه چون ثارالله است خونی هم از اون عادل این باغ که آمیخته به خون حضرت سیدالشهدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 749.95,
   "end": 754.37,
   "text": "باشد، در مسیر خون خدا باشد باید ریخته شود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 754.37,
   "end": 761.19,
   "text": "این‌ها دقت می‌کنید؟ همه‌ش گفتمون نکات و اسرارآمیز بودن جریان است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 761.19,
   "end": 767.01,
   "text": "در بعضی جاها خون‌ها از این‌ها ریخته شده به صورت غیرمعمولی و گفته شده است این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 767.01,
   "end": 770.23,
   "text": "خون باید با خون سیدالشهدا باشد از انبیا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 770.23,
   "end": 774.71,
   "text": "در بعضی جاها فقط اختمام و حزن و گریه و این‌ها بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 774.71,
   "end": 779.31,
   "text": "اشک بوده در جریان بوده. حالا جزئیاتش را دیگه ماها نمی‌رسیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 779.31,
   "end": 782.71,
   "text": "کلیش هم به همین طور که میگم می‌فهمیم فقط دیگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 782.71,
   "end": 786.09,
   "text": "اون بحث اصلی را نمی‌فهمیم چیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 786.09,
   "end": 789.57,
   "text": "در خصوص حضرت آدم هست که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 789.57,
   "end": 797.21,
   "text": "این‌ها در جریان قرار گرفتند و شریک قرار گرفتند در این نکته بسیار بالاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 797.21,
   "end": 804.69,
   "text": "عرض کنم که در روایتی شنیده‌اید حضرت آدم آن وقتی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 804.69,
   "end": 809.39,
   "text": "به اون صاحب عرش نگاه می‌کرد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 809.39,
   "end": 815.07,
   "text": "نظر می‌کرد، خب تجاوز نبود براش که صاحب عرش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 815.07,
   "end": 819.49,
   "text": "نگاه می‌کرد، اونجا اسماء خمسه را یعنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 819.49,
   "end": 821.89,
   "text": "رسول اکرم ،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 821.89,
   "end": 824.43,
   "text": "حضرت امیر، حضرت زهرا، حضرت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 824.43,
   "end": 827.87,
   "text": "مصطفی، حضرت سیدالشهدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 827.87,
   "end": 831.19,
   "text": "را اونجا مشاهده کرد و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 831.19,
   "end": 841.09,
   "text": "با اون اسماء به خدا به اصطلاح به سوی خدا برای قرب بیشتر راه می‌برد و با اسماء خمسه یعنی با اسماء",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 841.09,
   "end": 845.77,
   "text": "این پنج تن. ولی وقتی هست در روایت می‌گوید که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 845.77,
   "end": 848.52,
   "text": "وقتی که نام سیدالشهدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 848.52,
   "end": 852.15,
   "text": "را می‌برد آن وقت حضرت آدم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 852.15,
   "end": 859.11,
   "text": "به نکاتش گفته رفتم. وقتی نام سیدالشهدا را می‌برد که از این طریق هم به خدا تقرب بیشتر و از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 859.11,
   "end": 862.35,
   "text": "خدا بخواهد اونچه که می‌خواهد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 862.35,
   "end": 864.71,
   "text": "لما من قسمت روایت را می‌خوانم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 864.71,
   "end": 869.35,
   "text": "لما ذكر الحسین وقتی که نام سیدالشهدا را برد که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 869.35,
   "end": 875.07,
   "text": "در مقام دعا و مسأله بود سالت دموعه و انخشعت القلب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 875.07,
   "end": 879.15,
   "text": "به طور بدون اینکه مسئله از قبل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 879.15,
   "end": 885.89,
   "text": "اطلاع براش معلوم باشد همینطور قلبش به درد آمد و اشک چشمش به جریان افتاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 885.89,
   "end": 889.75,
   "text": "این یعنی کم اسم سیدالشهدا را می‌برد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 889.75,
   "end": 895.51,
   "text": "و قال یا أخي جبرائیل فی ذک الخمس ینكسر قلبی و تسیل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 895.51,
   "end": 904.03,
   "text": "عبرتی. به جبرائیل گفت که اینجا چه سری هست من همین که این اسم را می‌گم، این پنج‌گانه را وقتی می‌گم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 904.03,
   "end": 910.05,
   "text": "من دلم منكسر، متاثر می‌شود و اشک چشمم جریان پیدا می‌کند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 910.05,
   "end": 916.09,
   "text": "جبرائیل گفت که ولدك هذا یصاب بمصیبه أصغر عنده المصائب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 916.09,
   "end": 918.37,
   "text": "این فرزندت که اسمش را می‌بری،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 918.37,
   "end": 924.77,
   "text": "این مصیبتی دارد که هیچ مصیبتی به اون نخواهد رسید و همه مصائب نسبت به اون مصیبت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 924.77,
   "end": 928.75,
   "text": "کوچکند. گفت که یا أخي الماهی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 928.75,
   "end": 931.81,
   "text": "به جبرائیل گفت که اون مصیبت چیست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 931.81,
   "end": 939.81,
   "text": "یقتل گفت جبرائیل گفت که یقتل عطشانا غریبا وحیدا فریدا ليس له ناصر و لا معین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 939.81,
   "end": 943.79,
   "text": "و لو تراه یا آدم و هو یقول واتشاه و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 943.79,
   "end": 952.65,
   "text": "قلة ناصراه حتی یحول الاطش بینه و بین السماء کالدخان فلم یجبه احد الا بالسیوف.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 952.65,
   "end": 955.63,
   "text": "این‌ها به مصائب سیدالشهدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 955.63,
   "end": 958.83,
   "text": "جبرائیل اشاره کرد که چنین به قتل می‌رسد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 958.83,
   "end": 963.67,
   "text": "عطشان، غریب، وحید، فرید و ليس له ناصر و لا معین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 963.67,
   "end": 967.01,
   "text": "این‌ها را گفت به حضرت آدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 967.01,
   "end": 972.75,
   "text": "بعد بكى آدم و جبرائیل بكى استكلا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 972.75,
   "end": 977.91,
   "text": "هم جبرائیل سخت گریه کرد همین که متأثر که شدم و هم آدم سخت گریه کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 977.91,
   "end": 985.15,
   "text": "هر دو گریه کردند و جبرائیل گفت که اینجور در علم خدا گذشته است باید چنین باشد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 985.15,
   "end": 987.29,
   "text": "کذا سبقت في علم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 987.29,
   "end": 990.67,
   "text": "الواحد المنان. دقت می‌کنید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 990.67,
   "end": 993.15,
   "text": "خب این چه سری است؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 993.15,
   "end": 1002.71,
   "text": "حالا حضرت آدم وقتی اسمش را می‌گوید اینجور منكسر باشد و باید هم در جریان گیرد، قرار گیرد باید هم گریه بکند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 1002.71,
   "end": 1007.89,
   "text": "گریه بکند. آیا مسئله این است که این یتر الله الموتور",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 1007.89,
   "end": 1012.59,
   "text": "است و باید همه انبیا با او وحدتی داشته باشند؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 1012.59,
   "end": 1015.49,
   "text": "آیا مسئله بالاتر از این‌هاست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 1015.49,
   "end": 1023.25,
   "text": "هرچه هست خیلی مسئله اسرارآمیزی است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 1023.25,
   "end": 1026.67,
   "text": "حسین مولایا دوستان عزمن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 1026.67,
   "end": 1034.91,
   "text": "ششمین بخش صحبت‌های استاد آیت الله محمد شجاعی را در باب حضرت سید و شهدا علیه السلام شنیدید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 1034.91,
   "end": 1039.69,
   "text": "دعوت می‌کنیم ادامه این بحث را در برنامه‌های بعد بشنوید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 1039.69,
   "end": 1044.83,
   "text": "تا دیگر برنامه خدا یار و نگهدارتان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 1044.83,
   "end": 1054.25,
   "text": "حسین مولایا یا حسین، یا حسین،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 1054.25,
   "end": 1060.21,
   "text": "حسین، حسین، حسین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}