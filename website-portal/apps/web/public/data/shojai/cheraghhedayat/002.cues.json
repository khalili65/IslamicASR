 "chapters": [
  {
   "index": 0,
   "title": "## ادامهٔ زیارت؛ وارث کتب آسمانی و امین الرحمن",
   "start": 81.06,
   "end": 131.4
  },
  {
   "index": 1,
   "title": "و نیز بار دیگر «شریک القرآن» که پیشتر تبیین شد. سپس:",
   "start": 131.4,
   "end": 353.6
  },
  {
   "index": 2,
   "title": "قرآن می‌فرماید:",
   "start": 353.6,
   "end": 374.1
  },
  {
   "index": 3,
   "title": "و سخن معروف حضرت:",
   "start": 374.1,
   "end": 1114.23
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 4.62,
   "end": 6.21,
   "text": "حسین، حسین، حسین، حسین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 6.21,
   "end": 12.42,
   "text": "حسین، حسین، حسین، حسین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 12.42,
   "end": 15.15,
   "text": "شهید کربلا حسین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 15.15,
   "end": 17.01,
   "text": "حسین، حسین، حسین، حسین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 17.01,
   "end": 20.14,
   "text": "بریده نهال حسین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 20.14,
   "end": 23.24,
   "text": "حسین، حسین، حسین-",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 23.24,
   "end": 37.78,
   "text": "السلام علیک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 37.78,
   "end": 41.77,
   "text": "یا أبا عبدالله الحسین-",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 41.77,
   "end": 49.6,
   "text": "حسین، حسین، حسین، حسین- وعلی الأرواح التي",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 49.6,
   "end": 57.42,
   "text": "حلت بفنائك-",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 57.42,
   "end": 60.34,
   "text": "حسین، حسین، حسین، حسین. بریده نهال حسین. حسین، حسین- چراغ هدایت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 60.34,
   "end": 68.9,
   "text": "چراغ مصباح هدایت تویی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 68.9,
   "end": 77.22,
   "text": "چراغ مصباح هدایت تویی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 77.22,
   "end": 80.1,
   "text": "سفینه‌ی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 80.1,
   "end": 85.52,
   "text": "غرق در آبیم کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 85.52,
   "end": 92.28,
   "text": "بسم الله الرحمن الرحیم و هو اللطيف الخبير.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 92.28,
   "end": 96.42,
   "text": "سرزمین کربلا پر لاله شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 96.42,
   "end": 100.5,
   "text": "وادی حزن و عزا و ناله شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 100.5,
   "end": 104.94,
   "text": "نینوا میعاد عشق و درد و خون،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 104.94,
   "end": 107.54,
   "text": "صحنه شمع و گل و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 107.54,
   "end": 117.22,
   "text": "پروانه شد. سلام بر شما عزاداران حسینی و به سوگ نشستگان شهدای کربلا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 117.22,
   "end": 123.64,
   "text": "دومین برنامه چراغ هدایت را می‌شنوید که اختصاص دارد به مباحث استاد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 123.64,
   "end": 131.4,
   "text": "آیت الله محمد شجاعی پیرامون شخصیت و جایگاه حضرت سید الشهدا علیه السلام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 131.4,
   "end": 136.98,
   "text": "در برنامه گذشته استاد شجاعی ضمن ترجمه بخش‌هایی از زیارت مطلقه حضرت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 136.98,
   "end": 146.42,
   "text": "سید الشهدا علیه السلام به توضیح نکاتی پرداختند پیرامون این فراز که در آن حضرت فتر الله الموتور",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 146.42,
   "end": 154.74,
   "text": "خطاب شده است. در این برنامه نیز استاد به قسمت‌هایی از زیارت مطلقه و نیز زیارات دیگر حضرت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 154.74,
   "end": 156.8,
   "text": "سید الشهدا علیه السلام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 156.8,
   "end": 159.34,
   "text": "استناد می‌کنند. با هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 159.34,
   "end": 162.9,
   "text": "می‌شنویم. بسم الله الرحمن الرحیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 162.9,
   "end": 168.98,
   "text": "الحمد لله رب العالمین وصلی الله علی محمد و آله الطاهرين.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 168.98,
   "end": 170.76,
   "text": "در همان زیارت جمله دیگر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 170.76,
   "end": 174.82,
   "text": "السلام الیک یا وارث التوراة و الانجيل و الزبور.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 174.82,
   "end": 179.34,
   "text": "سلام بر تو ای وارث تورات و انجیل و زبور.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 179.34,
   "end": 182.34,
   "text": "تأمل بکنید ببینید چیست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 182.34,
   "end": 186.32,
   "text": "در زیارت همان اول رجب و نیمه رجب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 186.32,
   "end": 190.76,
   "text": "و نیمه شعبان که گفتم این از همان زیارت است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 190.76,
   "end": 194.62,
   "text": "در همان زیارت السلام الیک یا امین الرحمن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 194.62,
   "end": 199.74,
   "text": "تأمل بکنید. السلام الیک یا شریک القرآن که قبلاً گفتم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 199.74,
   "end": 202.52,
   "text": "السلام الیک یا عمود الدين.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 202.52,
   "end": 205.38,
   "text": "با توضیحی که گفتم این semana",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 205.38,
   "end": 211.0,
   "text": "و اونچه که شماها و ما یاد گرفتیم عمود دین چه بود؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 211.0,
   "end": 213.41,
   "text": "عمود دین و نماز عمود دین است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 213.41,
   "end": 216.0,
   "text": "ولی واقعاً عمود دین چه بود؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 216.0,
   "end": 219.06,
   "text": "دین را چه نگه داشت به اذن الله؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 219.06,
   "end": 223.63,
   "text": "عمود. السلام علیک جمله بعدی همان زیارت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 223.63,
   "end": 226.14,
   "text": "اینها از همان زیارت به یادتان باشد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 226.14,
   "end": 231.3,
   "text": "السلام الیک یا باب حکمت رب العالمین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 231.3,
   "end": 235.26,
   "text": "سلام بر تو ای باب حکمت ربوبی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 235.26,
   "end": 240.84,
   "text": "حکمت ربوبی. این را هم تأمل بکنید فقط یک جمله به شما عرض می‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 240.84,
   "end": 247.18,
   "text": "می‌خواهید از حکمت و من یوتی حکمت فقط اوتیه خیرًا کثیرًا برخوردار باشید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 247.18,
   "end": 250.96,
   "text": "به حضرت حشر و نشر شریفت توسل کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 250.96,
   "end": 253.72,
   "text": "باب حکمت چیست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 253.72,
   "end": 255.96,
   "text": "حکمت خدا را حکمت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 255.96,
   "end": 259.34,
   "text": "یکی از اسماء خدا چیست؟ حکیم است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 259.34,
   "end": 261.84,
   "text": "خدا در همه جا حکمتش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 261.84,
   "end": 267.94,
   "text": "روشن است و واضح است برای آن کسانی که حکمت به آن‌ها عنایت شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 267.94,
   "end": 269.64,
   "text": "من و شما نمی‌دانیم حکمت چیست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 269.64,
   "end": 271.7,
   "text": "آقا دستت درد نکنه، اصلا نمی‌دانیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 271.7,
   "end": 279.28,
   "text": "ولی اگر خواستید یک وقتی خیر کثیر طمع کردید و من یوتی حکمت فقط اوتیه خیرًا کثیرًا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 279.28,
   "end": 284.24,
   "text": "خواص از بندگان خدا به حکمت می‌رسند در مرتبه خودشان آنها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 284.24,
   "end": 287.7,
   "text": "هم. اما باب این حکمت چیست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 287.7,
   "end": 292.0,
   "text": "باب این حکمت پیدا می‌شود. برای همین من مکرر به شما گفتم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 292.0,
   "end": 297.48,
   "text": "خواص از بندگان خدا، اولیاء خدا، خوبان، صالحان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 297.48,
   "end": 305.14,
   "text": "معمولاً در رسیدن به آنجاهایی که می‌رسند، یکی از ترسلات دائم‌شان ترسل به چیست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 305.14,
   "end": 309.66,
   "text": "ترسل به حضرت سیر و شراب صلوات الله علیه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 309.66,
   "end": 311.49,
   "text": "جمله دیگر از همان زیارت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 311.49,
   "end": 317.16,
   "text": "السلام الیک یا باب حتّی الذی من دخله کان آمنا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 317.16,
   "end": 321.22,
   "text": "خدا کند که این ترسل که من و شما امروز داریم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 321.22,
   "end": 329.12,
   "text": "و ترسل‌هایی که به عنایات خدا خواهیم داشت و داشته‌ایم و خود از خدا توفیق این معنا را با عمر طولانی می‌خواهیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 329.12,
   "end": 334.74,
   "text": "خدا کند این ترسل‌ها موجب می‌شود ما به این باب حتّه روی بیاوریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 334.74,
   "end": 337.44,
   "text": "سلام بر تو ای باب حتّه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 337.44,
   "end": 344.96,
   "text": "باب حتّه یعنی بابی که هر کسی به آن باب روی بیاورد من دخله کان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 344.96,
   "end": 351.0,
   "text": "آمنا. تأکید می‌کنم هر که می‌توانید البته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 351.0,
   "end": 356.78,
   "text": "عامیانه نه، گناه بکنید و بعد روز به سوی ترسل را زیاد بکنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 356.78,
   "end": 360.92,
   "text": "اگر می‌خواهید ترسل‌تان ترسل باشد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 360.92,
   "end": 370.82,
   "text": "و سلامتون به اون حضرت برسد و جواب از اون حضرت بیاید و نظر اون حضرت به سوی شما معطوف بشود و باب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 370.82,
   "end": 374.1,
   "text": "هدی به روی شما باز بشود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 374.1,
   "end": 378.3,
   "text": "در طاعت بکوشید و در توسل به اون حضرت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 378.3,
   "end": 384.76,
   "text": "نه اینکه عامیانه برداشت بکنید هرچی دلتون بخواهد بکنید بعد بگید به امام توسل می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 384.76,
   "end": 388.24,
   "text": "این عامیانه است. این جور نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 388.24,
   "end": 394.86,
   "text": "این درست نیست. همون زیارت جمله‌ی بعدی، السلام علیک یا حیب فعلم الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 394.86,
   "end": 398.56,
   "text": "حیب یعنی جایی که اونجا چیزی را چی می‌کنند؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 398.56,
   "end": 403.46,
   "text": "چیزهایی را حفظ می‌کنند. صندوقچه، صندوق، جای حفظ، جای نگهداری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 403.46,
   "end": 408.78,
   "text": "حیب با ح. به حضرت خطاب می‌کنه در همین زیارت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 408.78,
   "end": 413.36,
   "text": "سلام بر تو ای، ای صندوق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 413.36,
   "end": 415.38,
   "text": "چی؟ علم الهی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 415.38,
   "end": 420.5,
   "text": "یعنی آنچه در علم خدا هست صندوقش کیست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 420.5,
   "end": 425.42,
   "text": "در سینه کیست؟ در دل کیست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 425.42,
   "end": 428.06,
   "text": "السلام علیک در همان زیارت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 428.06,
   "end": 430.26,
   "text": "السلام علیک یا موضع اسرار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 430.26,
   "end": 433.42,
   "text": "الله. اسرار خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 433.42,
   "end": 439.0,
   "text": "جاش کجاست؟ جاش کجاست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 439.0,
   "end": 441.82,
   "text": "دل ابو عبدالله صلوات الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 441.82,
   "end": 446.16,
   "text": "خب اینا از اون زیارت بود که چند سلام خواندم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 446.16,
   "end": 450.3,
   "text": "از زیارت اون حضرت در نیمه‌ی شعبان دو سه جمله برای شما بخوانم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 450.3,
   "end": 453.16,
   "text": "دو جمله. می‌بینید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 453.16,
   "end": 460.78,
   "text": "می‌گه و اشهد انک نور الله الذي لم یطفأ و لا یطفأ ابدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 460.78,
   "end": 469.82,
   "text": "اون که قرآن می‌گوید که خدا نوری دارد که هرچی سعی بکنند اون نور را خاموش بکنند، این نور خاموش شدنی نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 469.82,
   "end": 474.38,
   "text": "اون نور کیست؟ حضرت حسین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 474.38,
   "end": 476.84,
   "text": "این زیارت اینجوریه. زیارت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 476.84,
   "end": 479.48,
   "text": "نیمه‌ی شعبان آن حضرت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 479.48,
   "end": 482.36,
   "text": "نظرتون باشد در نیمه‌ی شعبان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 482.36,
   "end": 485.08,
   "text": "همه انبیا میان به زیارت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 485.08,
   "end": 487.78,
   "text": "رسول الله صلوات الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 487.78,
   "end": 490.49,
   "text": "یعنی همه میان اول العزم و غیر اول العزم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 490.49,
   "end": 493.08,
   "text": "همه انبیا و رسول الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 493.08,
   "end": 499.06,
   "text": "همه ملائکه در شب نیمه‌ی شعبان به زیارت اون حضرت به کربلا نزول می‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 499.06,
   "end": 501.82,
   "text": "به کربلا، به حرم شریف اون حضرت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 501.82,
   "end": 507.88,
   "text": "و لذا هرکسی هست که در شب نیمه‌ی شعبان این توفیق را حاصل بکند در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 507.88,
   "end": 511.76,
   "text": "بارگاه اون حضرت، در حرم اون حضرت باشد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 511.76,
   "end": 516.36,
   "text": "با همه انبیا در باطن امر مصاحبه کرده است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 516.36,
   "end": 520.3,
   "text": "شب عجیبیست شب نیمه‌ی شعبان از لحاظ زیارت سید الشهدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 520.3,
   "end": 525.34,
   "text": "شما در این مواقف هم که می‌دونید یکی از دستورات همیشه این است که مثلاً در این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 525.34,
   "end": 528.48,
   "text": "عید زیارت امام حسین را زیارت بکنید، در اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 528.48,
   "end": 532.0,
   "text": "موقع زیارت. این هم یکی از خصوصیات خاص",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 532.0,
   "end": 534.38,
   "text": "برای همونی است که در اون باب صحبت می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 534.38,
   "end": 536.98,
   "text": "السلام علیک یا چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 536.98,
   "end": 541.2,
   "text": "در چه باب صحبت می‌کنیم؟ یا فضل الله الموتری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 541.2,
   "end": 545.32,
   "text": "حین عید فطر و قربان است زیارتش را بکن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 545.32,
   "end": 548.74,
   "text": "نیمه‌ی شعبان است زیارت سید الشهدا بکن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 548.74,
   "end": 551.04,
   "text": "رجب است زیارت سید الشهدا بکن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 551.04,
   "end": 553.5,
   "text": "اولش هست چنین، وسطش هست چنین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 553.5,
   "end": 556.26,
   "text": "چرا؟ چه سزی هست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 556.26,
   "end": 560.76,
   "text": "بگو چه سزی هست؟ شهادت می‌دهم تو آن نوری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 560.76,
   "end": 563.24,
   "text": "که نه خاموش شده نه خاموش خواهد شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 563.24,
   "end": 569.0,
   "text": "و انک وجه الله الذي لم یهلک و لا یهلک ابدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 569.0,
   "end": 572.46,
   "text": "در قرآن می‌خواند کل شی هلک الا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 572.46,
   "end": 576.44,
   "text": "وجهه. می‌گه اون وجه تویی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 576.44,
   "end": 579.46,
   "text": "خب اینم دو جمله از زیارت نیمه‌ی شعبان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 579.46,
   "end": 585.08,
   "text": "از زیارت اون حضرت در عید فطر و قربان هم دو سه جمله بگم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 585.08,
   "end": 587.06,
   "text": "یکی این است در عید فطر و قربان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 587.06,
   "end": 590.36,
   "text": "السلام علیک یا بطن المسلمین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 590.36,
   "end": 597.06,
   "text": "روح الله لا اعطینکم یدی اعطاء الذلیل و لا افر فرار العبید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 597.06,
   "end": 599.58,
   "text": "این افرادی که در عالم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 599.58,
   "end": 605.5,
   "text": "شما می‌بینید، این آزاد مردانی که در برابر کفار و ظالمان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 605.5,
   "end": 613.04,
   "text": "و ستمگران و جباران گردن فرود نمی‌آورند و و از اینجا فرار هم نمی‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 613.04,
   "end": 615.6,
   "text": "آنچنان که چه کسانی فرار می‌کنند؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 615.6,
   "end": 620.78,
   "text": "بنده ها فرار. نه فرار خواهم کرد و نه دست بیعتی به شما خواهم داد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 620.78,
   "end": 627.54,
   "text": "یا بطن المسلمین. این جمله هم از جمله‌های استثنایی در خصوص اون حضرت است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 627.54,
   "end": 630.9,
   "text": "السلام علیک بطن به معنی پهلوان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 630.9,
   "end": 633.0,
   "text": "ببین زبان ما میشه پهلوان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 633.0,
   "end": 635.6,
   "text": "بطن با طاء معله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 635.6,
   "end": 637.76,
   "text": "است. سلام بر تو ای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 637.76,
   "end": 640.7,
   "text": "بطن مسلمان‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 640.7,
   "end": 647.4,
   "text": ". جمله‌ی بعدی از همان زیارت، السلام علیک یا باب المقام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 647.4,
   "end": 650.26,
   "text": "سلام بر تو ای باب مقام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 650.26,
   "end": 653.14,
   "text": "تأمل بکنید اما یک جمله بگم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 653.14,
   "end": 659.52,
   "text": "هرکسی در عبودیت به هر مقامی برسد از چه دری باید وارد شود؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 659.52,
   "end": 662.74,
   "text": "خیلی پرمعنی است. نمی‌دونم فهمیدید یا نه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 662.74,
   "end": 666.06,
   "text": "باب مقام برای هرکسی کیست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 666.06,
   "end": 670.14,
   "text": "هرکسی در هر مقامی از مقامات توحید است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 670.14,
   "end": 676.1,
   "text": "هرکسی به هر مقامی از مقامات توحید برسد، بابش کیست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 676.1,
   "end": 678.88,
   "text": "باب المقام. باز در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 678.88,
   "end": 682.12,
   "text": "زیارت عید فطر و قربان این جمله‌ی بعدی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 682.12,
   "end": 685.9,
   "text": "که می‌گه که این جمله را هم از اون زیارت بخوانم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 685.9,
   "end": 687.58,
   "text": "جمله‌ی سوم بعد بگذریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 687.58,
   "end": 690.94,
   "text": "السلام علیک یا حجة الحساب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 690.94,
   "end": 697.28,
   "text": "این هم برای همه مؤمنین هوشیار و با شعور،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 697.28,
   "end": 699.84,
   "text": "عرض کنم غیر توجیه گر،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 699.84,
   "end": 704.48,
   "text": "مخلص، متعبد این جمله همیشه دست به انداز است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 704.48,
   "end": 707.16,
   "text": "سلام بر تو ای حجة.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 707.16,
   "end": 711.44,
   "text": "ای حجة در برابر دشمنی‌ها با توحید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 711.44,
   "end": 716.44,
   "text": "یعنی کسی می‌خواهد حجتش را بداند، حجتش چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 716.44,
   "end": 718.4,
   "text": "راهش را از کجا باید بگیرد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 718.4,
   "end": 727.44,
   "text": "حجت برای او در برابر دشمنی‌هایی که با توحید و قرآن و اساس اسلام می‌کنند حجتش کیست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 727.44,
   "end": 730.83,
   "text": "حجة امام حسین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 730.83,
   "end": 734.85,
   "text": "تعمیدی که گفتم یا حجة الخصام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 734.85,
   "end": 737.95,
   "text": "کسی با هر خصومتی مواجه شد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 737.95,
   "end": 740.23,
   "text": "خصومت‌ها که با چی می‌شود؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 740.23,
   "end": 742.61,
   "text": "با اسلام، با قرآن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 742.61,
   "end": 746.89,
   "text": "میگی می‌خواهی در برابر خصومت‌ها بدانی چیکار باید بکنی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 746.89,
   "end": 750.87,
   "text": "حجت رویا هستی، حجتت کیست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 750.87,
   "end": 753.35,
   "text": "به اون نگاه کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 753.35,
   "end": 757.53,
   "text": "خصومت با قرآن می‌کنند چه باید بکنیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 757.53,
   "end": 760.79,
   "text": "وظیفه‌مون چیه؟ به چه نگاه کن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 760.79,
   "end": 763.0,
   "text": "به ماست. یا حجة الخصام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 763.0,
   "end": 764.63,
   "text": "بسیار جمله‌ی عجیبی است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 764.63,
   "end": 771.45,
   "text": "خب. از زیارت عرفه هم دو جمله بخوانم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 771.45,
   "end": 777.31,
   "text": "میگه که این، دیگه از زیارت این کلامی می‌خوانم، زیارت اون حضرت در روز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 777.31,
   "end": 780.73,
   "text": "عرفه. میگه و أنت باب الهدى.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 780.73,
   "end": 782.51,
   "text": "تو که هستی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 782.51,
   "end": 786.35,
   "text": "باب هدایه. می‌خواهید هدایت پیدا بکنید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 786.35,
   "end": 788.33,
   "text": "از طریق کی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 788.33,
   "end": 791.15,
   "text": "از طریق کی؟ باب الهدى.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 791.15,
   "end": 794.47,
   "text": "توسل بکنید. اما گفتم توسل با سعی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 794.47,
   "end": 797.33,
   "text": "به گناه ادامه بدید توسل بکنید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 797.33,
   "end": 799.33,
   "text": "این خودتون رو معطل کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 799.33,
   "end": 801.03,
   "text": "سعی خودتون رو جدی بکنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 801.03,
   "end": 804.81,
   "text": "می‌خواهید روز روز از هدایت‌ها برخوردار باشید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 804.81,
   "end": 808.35,
   "text": "به کی به عنوان شفیع متوسل بشید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 808.35,
   "end": 810.69,
   "text": "به اون حضرت. باب الهدى.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 810.69,
   "end": 814.89,
   "text": "باب الهدى. هدایت الهی از کجا می‌رسد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 814.89,
   "end": 819.23,
   "text": "به شفاعت او. جمله‌ی دیگر از همان زیارت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 819.23,
   "end": 824.81,
   "text": "این جمله هم جمله‌ای است که الان به این جور جلسه‌ها مربوطه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 824.81,
   "end": 837.45,
   "text": "السلام علیک یا سریع العبرة الساقطة یا سریع العبرة الساقطة وقرین المصيبة الراسخة.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 837.45,
   "end": 840.71,
   "text": "مصیبت، این جمله‌ها اینجور ترجمه میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 840.71,
   "end": 846.87,
   "text": "سلام بر تو ای کشته‌ی اشک‌های ریزان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 846.87,
   "end": 850.71,
   "text": "یعنی کشته‌ای هستی که اشک‌هایی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 850.71,
   "end": 854.69,
   "text": "مؤمنین دارند همیشه بر تو می‌ریزد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 854.69,
   "end": 858.45,
   "text": "یا سریع یعنی اون کشته که به زمین می‌افته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 858.45,
   "end": 862.51,
   "text": "السلام علیک یا سریع العبرة الساقطة.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 862.51,
   "end": 866.67,
   "text": "سلام بر تو ای کشته‌ی به زمین افتاده‌ی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 866.67,
   "end": 870.45,
   "text": "اشک‌های جاری از چشم‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 870.45,
   "end": 872.53,
   "text": "وقرین المصيبة الراسخة.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 872.53,
   "end": 877.95,
   "text": "سلام بر تو ای کسی که مصیبت پی در پی بر تو متوجه شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 877.95,
   "end": 880.13,
   "text": "این یک نکته‌ست ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 880.13,
   "end": 883.41,
   "text": "مصیبت سرشادا یکی دو تا نبود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 883.41,
   "end": 887.53,
   "text": "دقت بکنید قرین مصیبت راتبه بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 887.53,
   "end": 893.47,
   "text": "راتبه، مصیبت راتبه اون مصیبتهام مصائبی می‌گن که یکی پس از دیگری هی چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 893.47,
   "end": 896.83,
   "text": "هی میاد تمام نمی‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 896.83,
   "end": 901.07,
   "text": "دقت؟ عذاب الان به نظرتون بیاد همیشه به نظرتون بیاده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 901.07,
   "end": 908.79,
   "text": "فقط مثلاً این در وسط بگم. این دستور از هر وقت اباعبدالله به یادتون افتاد سؤال کردن از امام چه بگیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 908.79,
   "end": 911.83,
   "text": "گفت سه بار بگید صلى الله عليك يا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 911.83,
   "end": 913.81,
   "text": "ابا عبدالله صلى الله عليك.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 214,
   "start": 913.81,
   "end": 915.45,
   "text": "هر وقت یادتون افتاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 215,
   "start": 915.45,
   "end": 918.93,
   "text": "هر وقت صلى الله عليك يا ابا عبدالله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 216,
   "start": 918.93,
   "end": 921.67,
   "text": "به یادتون بیاره بگه که مصائب از چه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 217,
   "start": 921.67,
   "end": 928.65,
   "text": "شروع شد و چطور پیش رفت و به کجا منتهی شد و چقدر طول پیدا کرد و چقدر ابعاد داشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 218,
   "start": 928.65,
   "end": 933.45,
   "text": "خودتون تأمل بکنید. منصفانه ببینید این جمله که در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 219,
   "start": 933.45,
   "end": 936.87,
   "text": "زیارت‌ها آمده است السلام علیک یا أثیر الكربات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 220,
   "start": 936.87,
   "end": 940.21,
   "text": "بقیه رو من ننوشتم از رو. چون در زیارت‌ها به یاد آمده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 221,
   "start": 940.21,
   "end": 942.51,
   "text": "یا أثیر الكربات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 222,
   "start": 942.51,
   "end": 947.11,
   "text": "اصلاً در میان مصیبت‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 223,
   "start": 947.11,
   "end": 950.59,
   "text": "محبوس شده بود. یعنی أثیر الكربات بود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 224,
   "start": 950.59,
   "end": 952.99,
   "text": "در این مصیبت راتبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 225,
   "start": 952.99,
   "end": 962.99,
   "text": "شما با این رسم می‌توانید به اجمال بدانید که وتر الله الموتوف السماوات والأرض یعنی به اجمال ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 226,
   "start": 962.99,
   "end": 965.25,
   "text": "مثلاً من قبلاً گفته بودم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 227,
   "start": 965.25,
   "end": 967.65,
   "text": "چیست که بفهمد وتر الله چیست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 228,
   "start": 967.65,
   "end": 970.65,
   "text": "الان هم باز تکرار می‌کنم اون جمله هم را.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 229,
   "start": 970.65,
   "end": 973.55,
   "text": "چیست؟ بفهمد معنی این جمله چیست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 230,
   "start": 973.55,
   "end": 978.23,
   "text": "که در زیارت‌ها مشهد را آمده است السلام علیک أيها ال...",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 231,
   "start": 978.23,
   "end": 980.67,
   "text": "این فرد ایماناً وتر الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 232,
   "start": 980.67,
   "end": 989.17,
   "text": "خودش هم میگه وتر الله. اما خب به اجمال با این نکته‌ها که گفتم می‌شود فهمید که به اجمال با یک،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 233,
   "start": 989.17,
   "end": 996.71,
   "text": "با یک تصویری موباً و کلی و ذهنی از اون ایمانندی اون حضرت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 234,
   "start": 996.71,
   "end": 1005.37,
   "text": "در اصل خصوصیات وجودیش و در مصائبش و در اهداف عالیه‌اش و الی آخر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 235,
   "start": 1005.37,
   "end": 1009.93,
   "text": "خودش وتر الله بود. اصحاب حسین سلام الله علیه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 236,
   "start": 1009.93,
   "end": 1013.13,
   "text": "صلوات الله علیه و سلام الله علیهم أجمعین هم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 237,
   "start": 1013.13,
   "end": 1018.01,
   "text": "اینجا می‌خواستم چند جمله بگم خب زیاد متأثر می‌شوم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 238,
   "start": 1018.01,
   "end": 1021.53,
   "text": "اینجا هم توجه بکنید که حساب خاصی هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 239,
   "start": 1021.53,
   "end": 1027.01,
   "text": "اولاً به اون شهدا، همه شهدا جوسه می‌کنند اینجا را یقیناً.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 240,
   "start": 1027.01,
   "end": 1031.31,
   "text": "همه شهدا که، شهدا که ثقفی الله هستند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 241,
   "start": 1031.31,
   "end": 1034.89,
   "text": "عرض کنم که اون وقتی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 242,
   "start": 1034.89,
   "end": 1037.97,
   "text": "اون منزلت‌های شهدایی را که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 243,
   "start": 1037.97,
   "end": 1039.97,
   "text": "با اون حضرت شهید شدند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 244,
   "start": 1039.97,
   "end": 1046.23,
   "text": "می‌بینند آرزو می‌کنند که کاش در کجا با کی شهید می‌شدند؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 245,
   "start": 1046.23,
   "end": 1047.85,
   "text": "این مضمون اینه واقعاً.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 246,
   "start": 1047.85,
   "end": 1052.35,
   "text": "کما اینکه همه هم آرزو می‌کنند مقام حضرت ابوالفضل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 247,
   "start": 1052.35,
   "end": 1056.81,
   "text": "سلام الله، اونم برسند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 248,
   "start": 1056.81,
   "end": 1061.45,
   "text": "مولای يا حسین،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 249,
   "start": 1061.45,
   "end": 1066.01,
   "text": "حسین، حسین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 250,
   "start": 1066.01,
   "end": 1071.75,
   "text": "و این چنین به پایان فرصت دومین برنامه چراغ هدایت رسیدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 251,
   "start": 1071.75,
   "end": 1082.75,
   "text": "ادامه بحث حکیم فرزانه آیت الله محمد شجاعی را در باب شخصیت حضرت سید الشهدا علیه السلام در برنامه بعد بشنوید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 252,
   "start": 1082.75,
   "end": 1085.39,
   "text": "تا دیگر برنامه خدا یار و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 253,
   "start": 1085.39,
   "end": 1099.37,
   "text": "نگهدار. حسین، حسین،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 254,
   "start": 1099.37,
   "end": 1106.49,
   "text": "مولای يا حسین،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
