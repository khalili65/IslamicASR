 "cues": [
  {
   "i": 0,
   "start": 9.86,
   "end": 14.62,
   "text": "حسین، حسین، حسین، حسین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 14.62,
   "end": 20.84,
   "text": "حسین، حسین، حسین، حسین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 20.84,
   "end": 25.32,
   "text": "شهید کربلا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 25.32,
   "end": 29.78,
   "text": "حسین. حسین، حسین، حسین، حسین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 29.78,
   "end": 39.14,
   "text": "ضعیف بن حنانه حسین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 39.14,
   "end": 42.3,
   "text": "حسین، حسین، حسین-",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 42.3,
   "end": 48.63,
   "text": "السلام علیک یا أبا عبدالله الحسین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 48.63,
   "end": 52.78,
   "text": "حسین، حسین- وعلی الارواح التي",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 52.78,
   "end": 64.26,
   "text": "حلت بفنائك.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 64.26,
   "end": 66.33,
   "text": "حسین، حسین، حسین، حسین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 66.33,
   "end": 72.72,
   "text": "ضعیف بن حنانه حسین. حسین، حسین- چراغ هدایت. چراغ مصباح هدایت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 72.72,
   "end": 84.1,
   "text": "تویی. چراغ مصباح هدایت تویی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 84.1,
   "end": 89.62,
   "text": "سفینه‌ی غصه‌ رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 89.62,
   "end": 95.8,
   "text": "می‌گم کنم. سفینه‌ی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 95.8,
   "end": 99.42,
   "text": "غصه‌ رو می‌گم کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 99.42,
   "end": 102.4,
   "text": "بسم الله الرحمن الرحيم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 102.4,
   "end": 108.1,
   "text": "و هو رب الحسین الذي قتل مظلوما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 108.1,
   "end": 112.2,
   "text": "سلام بر حسین و بر عاشقان حسین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 112.2,
   "end": 117.52,
   "text": "و سلام بر شما محبین کوی حسین علیه السلام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 117.52,
   "end": 122.52,
   "text": "دوستان، نهمین برنامه چراغ هدایت را می‌شنوید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 122.52,
   "end": 124.16,
   "text": "در این برنامه بخش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 124.16,
   "end": 134.38,
   "text": "دیگری از سخنان استاد آیت الله محمد شجاعی را درباره شخصیت و جایگاه حضرت سید الشهدا علیه السلام می‌شنویم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 134.38,
   "end": 139.08,
   "text": "در برنامه قبل شنیدیم که استاد وارسته به بیانات پیامبر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 139.08,
   "end": 148.82,
   "text": "بزرگوار اسلام صلی الله علیه و آله و سلم درباره مصائب سید الشهدا علیه السلام اشاراتی داشتند و از اینجا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 148.82,
   "end": 154.82,
   "text": "به توضیحاتی درباره طی الارض و طی الزمان پرداختند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 154.82,
   "end": 157.34,
   "text": "در ادامه روایتی را از ام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 157.34,
   "end": 164.46,
   "text": "سلمه که ام المؤمنین و همسر مکرمه پیامبر بوده است بیان کردند که به اسرارآمیز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 164.46,
   "end": 169.0,
   "text": "بودن عنایت رسول خدا به واقعه کربلا و مصائب امام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 169.0,
   "end": 172.06,
   "text": "حسین علیه السلام اشاره دارد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 172.06,
   "end": 184.02,
   "text": "سپس یکی از اسرار گریه بر حضرت سید الشهدا علیه السلام را توضیح دادند که برای اهلش محل تأمل و دقت بسیار است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 184.02,
   "end": 189.04,
   "text": "اکنون ادامه مطالب استاد را با هم می‌شنویم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 189.04,
   "end": 191.0,
   "text": "بسم الله الرحمن الرحيم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 191.0,
   "end": 197.42,
   "text": "أشهد أن لا إله إلا الله وحده لا شريك",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 197.42,
   "end": 203.4,
   "text": "له. در خصوص زیارت سید الشهدا سلام الله علیه و قبر شریف آن حضرت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 203.4,
   "end": 210.94,
   "text": "مطالب عجیب و نکات بسیار ظریف و اسرارآمیزی در روایات به چشم می‌خورد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 210.94,
   "end": 214.58,
   "text": "اولاً از بعضی از روایات بر می‌آید که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 214.58,
   "end": 216.46,
   "text": "زیارت آن حضرت واجب است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 216.46,
   "end": 222.08,
   "text": "البته فقها از لحاظ مباحث فقهی واجب ندانسته‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 222.08,
   "end": 228.38,
   "text": "اما خب له روایات این است که فریضه است برای هر مرد و زن مسلمان و مؤمن و شیعه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 228.38,
   "end": 232.68,
   "text": "فریضه است، مفترض است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 232.68,
   "end": 234.88,
   "text": "این خودش حکایتی دارد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 234.88,
   "end": 238.68,
   "text": "زیارت قبر شریف آن حضرت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 238.68,
   "end": 242.42,
   "text": "حالا اگر مثلاً ما به نظر خودمان بگوییم کسی اگر به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 242.42,
   "end": 245.76,
   "text": "قبر شریف نزدیک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 245.76,
   "end": 248.76,
   "text": "دستش نرسید، زیارت مطلقش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 248.76,
   "end": 255.76,
   "text": "فریضه خواهد بود. این در اصل خودش اسرارآمیز است، حکایت‌ها دارد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 255.76,
   "end": 260.0,
   "text": "در این باب من یکی دو روایت، دو، سه روایت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 260.0,
   "end": 262.11,
   "text": "خلاصه اشاره می‌کنم و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 262.11,
   "end": 267.12,
   "text": "برای اینکه متوجه باشیم که به چه صورتی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 267.12,
   "end": 269.6,
   "text": "مسئله اسرارآمیز خواهد بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 269.6,
   "end": 274.12,
   "text": "یکی روایتی است که ثقنوی‌ها را نمی‌خوانند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 274.12,
   "end": 277.82,
   "text": "از امام باقر سلام الله علیه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 277.82,
   "end": 281.6,
   "text": "در باهار قبر جدید،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 281.6,
   "end": 284.7,
   "text": "جلد چهل و یک، صفحه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 284.7,
   "end": 295.26,
   "text": "سه. می‌فرماید امام باقر سلام الله علیه می‌فرماید مرو شیعتنا بزیارت قبر الحسین، حسین بن علی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 295.26,
   "end": 305.54,
   "text": "علیه السلام، فإن ایتی انا مفترض على کل مؤمن یقر للحسین علیه السلام بالإمام من الله جل جلاله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 305.54,
   "end": 308.2,
   "text": "شیعیان ما را امر بکنید به زیارت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 308.2,
   "end": 314.78,
   "text": "قبر حسین، می‌فرماید حسین بن علی سلام الله علیه برای اینکه آمدن به زیارت قبر آن حضرت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 314.78,
   "end": 320.0,
   "text": "آن حضرت مفترض است، فریضه است بر هر مؤمنی که اقرار دارد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 320.0,
   "end": 327.22,
   "text": "مقر است، معترف است بر امامت سید الشهدا سلام الله علیه مفترض است از ناحیه خدا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 327.22,
   "end": 330.62,
   "text": "از ناحیه خدا مفترض است، فریضه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 330.62,
   "end": 334.64,
   "text": "یک روایت، در روایت دیگری که ام سعيد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 334.64,
   "end": 342.7,
   "text": "یکی از زنان شیعه است، ام سعيد می‌گوید امام صادق به من گفت که یا ام سعيد تزورین قبر الحسین؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 342.7,
   "end": 346.24,
   "text": "به من گفت که ای ام سعيد قبر حسین را زیارت می‌کنی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 346.24,
   "end": 349.28,
   "text": "قالت گفتم نه. می‌گفتم بله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 349.28,
   "end": 354.28,
   "text": "قالت فقال لی، ام سعيد می‌گوید که امام صادق دوباره به من فرمود یا ام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 354.28,
   "end": 363.06,
   "text": "سعيد زوریه زیارتتان حتماً، فإن زیارة الحسین واجبة على الرجال والنساء.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 363.06,
   "end": 366.7,
   "text": "این زیارت واجب است بر مرد و زن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 366.7,
   "end": 370.94,
   "text": "این هم یک روایت روایت دیگری را",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 370.94,
   "end": 377.54,
   "text": "که باز در همین زمینه است ولی لحن خاصی و نکات دیگری هم دارد از امام باقر سلام الله علیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 377.54,
   "end": 381.64,
   "text": "پس اینا همش از همین هست که قبل گفتم براتون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 381.64,
   "end": 391.1,
   "text": "عرض کنم که امام باقر فرمود: «لَوْ أَنَّ أَحَدَكُمْ حَجَّ دَهْرَهُ ثُمَّ لَمْ يَزُرِ الحُسَيْنَ»",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 391.1,
   "end": 397.82,
   "text": "از حسین بن علی علیه السلام «لَكانَ تارِكًا حَقًّا مِنْ حُقُوقِ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 397.82,
   "end": 404.34,
   "text": "وَ آلِهِ لِأَنَّ حَقَّ الحُسَيْنِ عَلَيْهِ السَّلامَ فَرِيضَةٌ مِنْ اللهِ وَاجِبَةٌ عَلَى كُلِّ مُسْلِمٍ».",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 404.34,
   "end": 415.6,
   "text": "فرمود که اگر یکی از شما شیعه‌ها، مسلمان‌ها یک عمر به حج برود، یک عمر دهرش را به حج بپردازد، حج، حج بیت الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 415.6,
   "end": 422.12,
   "text": "و اما سیدالشهدا سلام الله علیه را زیارت نکند، حقی از حقوق رسول الله را ترک کرده است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 422.12,
   "end": 424.94,
   "text": "برای اینکه حسین بن علی سلام الله علیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 424.94,
   "end": 427.28,
   "text": "فریضه است، واجب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 427.28,
   "end": 429.92,
   "text": "از خدا بر هر مسلمان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 429.92,
   "end": 436.78,
   "text": "اینم که خلاصه کردیم چه لحنی دارد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 436.78,
   "end": 444.26,
   "text": "یکی دیگر نقل می‌کند از امام صادق سلام الله علیه باز سأل دو أمَن ترك زیارت، زیارت قبر حسین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 444.26,
   "end": 449.62,
   "text": "من سؤال کردم از کسی که ترک می‌کند زیارت قبر حسین سلام الله علیه را من غیر علته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 449.62,
   "end": 454.62,
   "text": "علتی هم نداشته باشد. قال هذا الرجل من أهل النار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 454.62,
   "end": 457.64,
   "text": "اینجور آدم معزی از اهل آتش است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 457.64,
   "end": 461.02,
   "text": "ببینم لحن‌ش را خوب دقت کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 461.02,
   "end": 464.2,
   "text": "مطلقاً رجل من أهل النار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 464.2,
   "end": 470.0,
   "text": "دوباره روایت دیگری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 470.0,
   "end": 476.18,
   "text": "لحن خاصی دارد. او شامخ سالم است از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 476.18,
   "end": 478.5,
   "text": "باز در همان سقیفه‌نگر از امام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 478.5,
   "end": 481.88,
   "text": "صادق سلام الله علیه. در یک حدیث طویلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 481.88,
   "end": 487.14,
   "text": "حتی مردی آمد به حضور امام صادق گفت ید زار و والده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 487.14,
   "end": 491.16,
   "text": "باید پدر و جد شما یعنی مقصود سیدالشهدا بود زیارت کرد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 491.16,
   "end": 492.94,
   "text": "باید زیارت کرد؟ فقال نه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 492.94,
   "end": 494.9,
   "text": "امام فرمود بله. امام صادق فرمود بله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 494.9,
   "end": 497.72,
   "text": "فقال فمال من یزوره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 497.72,
   "end": 500.22,
   "text": "کسی زیارت کند چی در مقابلش است؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 500.22,
   "end": 502.8,
   "text": "قال الجنة این خانه یعتم و به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 502.8,
   "end": 507.58,
   "text": "یعتم و به. اگر به امامت امام موحد باشد جاش بهشت است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 507.58,
   "end": 509.96,
   "text": "قال این جاش بهشت است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 509.96,
   "end": 512.44,
   "text": "فمال من ترکه رغبة عن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 512.44,
   "end": 515.08,
   "text": "او کسی که همینطور",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 515.08,
   "end": 518.14,
   "text": "زیارت قبر حسین را ترک کند،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 518.14,
   "end": 522.24,
   "text": "گو چی در برابرش است؟ قال الحسرة یوم الحسرة.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 522.24,
   "end": 525.62,
   "text": "این گرفتار حسرتی خواهد بود در روز حسرت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 525.62,
   "end": 534.1,
   "text": "حسرتی بزرگ. این روایتم بخوانم و عرض کنم که تمام می‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 534.1,
   "end": 536.9,
   "text": "از امام باقر در این باب یعنی تمام می‌کنم صحبتم را.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 536.9,
   "end": 541.58,
   "text": "در از امام باقر سلام الله علیه هست که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 541.58,
   "end": 544.06,
   "text": "بعضی از اصحابش از امام باقر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 544.06,
   "end": 550.24,
   "text": "سلام الله علیه نقل می‌کنند که فرمود امام باقر به او کم بینکم و بین قبر حسین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 550.24,
   "end": 554.25,
   "text": "بین شما و قبر حسین سلام الله علیه چقدر فاصله است؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 554.25,
   "end": 558.34,
   "text": "قلت سِتَّةَ عشر فرسخاً. گفتم که شونزده فرسخ.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 558.34,
   "end": 561.58,
   "text": "قال ألم تأته له؟ نمیای به زیارتش؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 561.58,
   "end": 563.76,
   "text": "قلت لا. گفتم نه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 563.76,
   "end": 567.08,
   "text": "قال ما أجفاکم چقدر جها کار هستید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 567.08,
   "end": 568.59,
   "text": "أجفاکم جها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 568.59,
   "end": 572.74,
   "text": "اینجا تعبیر جهاد کرده برای کسی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 572.74,
   "end": 580.78,
   "text": "و این لحن البته در روایات متعدد آمده که کسی زیارت حسین سلام الله علیه را ترک کند جها کرده است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 580.78,
   "end": 585.36,
   "text": "مثلاً در بعد از این همین روایت، روایتی هست که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 585.36,
   "end": 591.22,
   "text": "از امام صادق سلام الله علیه شخص می‌گوید که قلت له ما تقول فی زیارت حسین؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 591.22,
   "end": 594.48,
   "text": "در زیارت حسین چه می‌گویید؟ به امام صادق گفتم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 594.48,
   "end": 597.5,
   "text": "قال زور ولا تشف.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 597.5,
   "end": 602.3,
   "text": "یعنی زیارت بکن و جها کار نباش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 602.3,
   "end": 605.66,
   "text": "عرض کنم که در امام علی روایات زیاد است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 605.66,
   "end": 608.36,
   "text": "خواستید به همین کتاب، به همین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 608.36,
   "end": 613.8,
   "text": "جلد صد و یک بهار بیش از این به نکاتش متوجه باشید مراجعه می‌کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 613.8,
   "end": 618.76,
   "text": "این خودش اولین نکته‌ای که در اینجا از من می‌خواستم بگم اینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 618.76,
   "end": 621.02,
   "text": "این خودش حاکی از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 621.02,
   "end": 632.48,
   "text": "مسائل می‌‌کند. لحن روایات‌شان می‌دهد صریحاً واجب است این زیارت و اگر این زیارت نشود حتی یک عمر انسان به حج برود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 632.48,
   "end": 635.44,
   "text": "حقی را ترک کرده، فریضه‌ای را ترک کرده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 635.44,
   "end": 638.44,
   "text": "جها کرده و کلا حسرت خواهد شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 638.44,
   "end": 648.58,
   "text": "بعضی روایات دارد که خودش را محروم کرده است از خیراتی که از زیارت سربازان از خودش محروم کرده است و اینها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 648.58,
   "end": 655.18,
   "text": "ولی نکته اصلی ما فریضه بودن و مفترض بودن این زیارت است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 655.18,
   "end": 659.58,
   "text": "عرض کنم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 659.58,
   "end": 667.42,
   "text": "از اینها گذشتیم در خصوص همین زیارت سیدالشهدا سلام الله علیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 667.42,
   "end": 673.58,
   "text": "نکته دیگری که باز ما را به اسرارآمیز بودن اون وجود مقدس و ابعاد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 673.58,
   "end": 677.16,
   "text": "مسائل مربوط به اون وجود مقدس آشنا می‌کند در خصوص",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 677.16,
   "end": 680.8,
   "text": "همین در ارتباط با زیارتش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 680.8,
   "end": 685.32,
   "text": "این است که در روایت آمده متعدد ذکر شده که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 685.32,
   "end": 693.4,
   "text": "عرض کنم که من زار حسین علیه السلام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 693.4,
   "end": 696.66,
   "text": "كمن زار الله فی عرشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 696.66,
   "end": 701.64,
   "text": "این تعبیر این هست در خصوص زیارت حضرت سیدالشهدا سلام الله علیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 701.64,
   "end": 708.06,
   "text": "کسی که اون حضرت را زیارت کند خدا را در عرشش زیارت کرده است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 708.06,
   "end": 710.96,
   "text": "دقت می‌کنید؟ من زار حسین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 710.96,
   "end": 714.38,
   "text": "كمن زار الله فی عرشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 714.38,
   "end": 717.58,
   "text": "که زیارتش قیام کند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 717.58,
   "end": 721.62,
   "text": "خدا را در عرش او زیارت کرده است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 721.62,
   "end": 725.04,
   "text": "در روایتی هست که راوی می‌گوید که گفتم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 725.04,
   "end": 729.46,
   "text": "أمی دیگر چطور؟ شماها به خود امام گفتم أمی دیگر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 729.46,
   "end": 734.12,
   "text": "او کسی ما را زیارت کند ما را لفظ الله را زیارت کرده است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 734.12,
   "end": 736.53,
   "text": "به نکاتش دقت کنید خوب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 736.53,
   "end": 743.47,
   "text": "ما را کسی زیارت کند رسول الله را زیارت کرده است ولی من زار حسین زار الله فی عرشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 743.47,
   "end": 747.67,
   "text": "خب این خود حتی راوی سؤال می‌کند اینجا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 747.67,
   "end": 754.93,
   "text": "شما چطور گفت که اگر ما را زیارت کند رسول الله را زیارت کرده اما سیدالشهدا زار الله فی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 754.93,
   "end": 758.41,
   "text": "عرشه؟ این ذهن هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 758.41,
   "end": 761.85,
   "text": "در باب زیارت آن حضرت این نکته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 761.85,
   "end": 764.71,
   "text": "به چشم می‌خورد که در اینجا هم به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 764.71,
   "end": 772.01,
   "text": "برای اینکه باز به این قبیل روایات مراجعه کنید که یک یا دو روایت از این باب اشاره می‌کنم و جاشم را عذر می‌خواهم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 772.01,
   "end": 779.69,
   "text": "جلد صد و یک اولاً هستند این مباحث در باب دیگری از جلد صد و یک بهار قبل جدید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 779.69,
   "end": 782.19,
   "text": "اما صفحه این روایتی که من می‌کنم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 782.19,
   "end": 785.67,
   "text": "صفحه هفتاد و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 785.67,
   "end": 787.67,
   "text": "شش هست، هفتاد و شش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 787.67,
   "end": 801.19,
   "text": "در این روایت می‌گوید که غلتل ابی عبدالله تنش را نمی‌خوانم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 801.19,
   "end": 803.67,
   "text": "مال من زار الحسین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 803.67,
   "end": 806.27,
   "text": "بر کسی که سیدالشهدا را زیارت کند چی هست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 806.27,
   "end": 812.93,
   "text": "در مقابلش گفت کان کمن زار الله فی عرشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 812.93,
   "end": 816.51,
   "text": "البته موضوعی که من در اینجا صحبت می‌کردم نظرتون هست بر اساس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 816.51,
   "end": 823.03,
   "text": "آنچه که بعضی از بزرگان گفتند و با توجه به نکات عمده‌ای که در باب ولایت هست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 823.03,
   "end": 827.35,
   "text": "و بعضی بزرگان هم گفتند حتی دستوراتی هم دادند در این باب که اصل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 827.35,
   "end": 835.05,
   "text": "کعبه عبارت است از کربلا و کعبه واقعی عبارت است از وجود شریف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 835.05,
   "end": 841.53,
   "text": "حسین بن علی سلام الله علیه. اونجا هم نکاتی از کردم خارج از جلسه بود اگر یادتون باشد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 841.53,
   "end": 844.19,
   "text": "اونها را همینجا به نظرتون بیارید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 844.19,
   "end": 851.13,
   "text": "گفت که کمن زار الله فی عرشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 851.13,
   "end": 856.61,
   "text": "دل سیدالشهدا سلام الله علیه، وجود سیدالشهدا سلام الله علیه دیگه مسلم است که عرش الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 856.61,
   "end": 860.07,
   "text": "است. اللهمان على العرش استوى.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 860.07,
   "end": 862.35,
   "text": "کان کمن زار الله فی عرشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 862.35,
   "end": 867.11,
   "text": "البته ائمه دیگر هم همینطور است ولی صحبت در این است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 867.11,
   "end": 868.85,
   "text": "که اینجا نکات اسرارآمیزی است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 868.85,
   "end": 870.58,
   "text": "همینقدر وقت کلیش را می‌فهمیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 870.58,
   "end": 873.95,
   "text": "اونها را براتون گفتم. نمی‌خواهم بگویم می‌فهمیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 873.95,
   "end": 875.77,
   "text": "که چی هست اسرار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 875.77,
   "end": 879.39,
   "text": "می‌دانیم که وجود اسرارآمیز است اما اسرار چیست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 879.39,
   "end": 881.99,
   "text": "دیگر به آنجا عقل و فکر ما نمی‌رسد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 881.99,
   "end": 883.95,
   "text": "کان کمن زار الله فی عرشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 883.95,
   "end": 889.83,
   "text": "آنوقت دوباره شخص می‌گوید که قال بود من گفتم که مال من زار احدا می‌گفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 889.83,
   "end": 894.25,
   "text": "حالا کسی یکی دیگر از شما را زیارت کرد برای او چیست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 894.25,
   "end": 897.71,
   "text": "قال کمن زار رسول الله صلی الله علیه و آله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 897.71,
   "end": 899.99,
   "text": "و سلم. مانند این است رسول الله را",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 899.99,
   "end": 902.89,
   "text": "زیارت کرده است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 902.89,
   "end": 906.07,
   "text": "این هم یکی دیگر از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 906.07,
   "end": 909.85,
   "text": "نکات که باز به اسرارآمیز بودن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 909.85,
   "end": 914.33,
   "text": "مسئله اشاره می‌کند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 914.33,
   "end": 926.59,
   "text": "عرض کنم که اون وقت در باب زیارتش حالا من دیگه در اینجا روایت خاصی برای شما نمی‌خوانم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 926.59,
   "end": 931.39,
   "text": "در باب زیارتش و آثار و برکات زیارت آن حضرت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 931.39,
   "end": 935.11,
   "text": "مطالب زیادی به چشم می‌خورد که یکی دو تا نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 935.11,
   "end": 939.45,
   "text": "حالا خواستید به همین جلد صد و یک بهار مراجعه می‌کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 939.45,
   "end": 943.83,
   "text": "روایات بسیار خوب با سندهای دقیق در اینها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 943.83,
   "end": 950.49,
   "text": "شکایتهای بسیار بالا برای زوّار حضرت سیدالشهدا سلام الله علیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 950.49,
   "end": 960.49,
   "text": "عرض کنم که در یکی از روایات هست که این البته من کوتاه انتخاب کردم چند تا کوتاهش را.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 960.49,
   "end": 963.11,
   "text": "اون مفصل‌هاش رو خودتون می‌بینید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 963.11,
   "end": 967.03,
   "text": "در یک روایتی هست یکی از حاجبین غیبی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 967.03,
   "end": 975.13,
   "text": "همیشه در آنجا این ندا را دارد که به همه می‌گوید يا باغی الخیر اغبد الی خالصة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 975.13,
   "end": 977.91,
   "text": "یعنی به هر کسی که شعوری دارد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 977.91,
   "end": 987.09,
   "text": "و حالا نمی‌شنویم ولی به هر کس که شعور دارد این ندا را دارد که ای اونچه که، اون کسی که به دنبال خیر هستی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 987.09,
   "end": 989.83,
   "text": "خیر می‌خواهی اغبد الی خالصة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 989.83,
   "end": 992.07,
   "text": "بیا به سوی خالصه خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 992.07,
   "end": 997.22,
   "text": "خالصة الله مخصوص سیدالشهدا سلام الله علیه است که از خود این تعبیر هم باز شکایتها دارد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 997.22,
   "end": 1004.15,
   "text": "الی خالصة الله. یعنی اون کس، اونچه که خالص است، خالص شده است برای کی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 1004.15,
   "end": 1010.45,
   "text": "برای خدا. يا باغی الخیر این ندای غیبی همیشه به اصطلاح طنین‌انداز است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 1010.45,
   "end": 1012.53,
   "text": "اونها گوش می‌خواهد بشنود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 1012.53,
   "end": 1015.99,
   "text": "يا باغی الخیر اغبد الی خالصة الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 1015.99,
   "end": 1020.93,
   "text": "بیا به سوی خالصه خدا. ترحد کرامت و تأمن الندامت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 1020.93,
   "end": 1024.81,
   "text": "می‌خواهی با کرامت بیا، بیایی از این عالم سفر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 1024.81,
   "end": 1028.91,
   "text": "کنی؟ می‌خواهی از ندامت و پشیمانی در امان باشی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 1028.91,
   "end": 1034.47,
   "text": "بیا به سوی خالصه خدا که عبارت است از سیدالشهدا سلام الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 214,
   "start": 1034.47,
   "end": 1039.07,
   "text": "علیه. بعد هست که این ندا را، این ندای غیبی را غیر از جن و انس بقیه می‌شنوند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 215,
   "start": 1039.07,
   "end": 1044.13,
   "text": "از انسان‌ها مگر کسی گوش دیگری و گوش شنوا یعنی گوش بالاتری داشته باشد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 216,
   "start": 1044.13,
   "end": 1049.59,
   "text": "یسمع اهل المشر و اهل المغرب ذکرنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 217,
   "start": 1049.59,
   "end": 1055.31,
   "text": "در روایتی هست که وقتی کسی به زیارتش می‌رود، اون وقتی که منصرف می‌شود از زیارت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 218,
   "start": 1055.31,
   "end": 1061.41,
   "text": "باز اون ندای غیبی می‌آید به اون شخصی که زیارت را تمام کرده و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 219,
   "start": 1061.41,
   "end": 1063.41,
   "text": "منصرف شده است بهش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 220,
   "start": 1063.41,
   "end": 1071.55,
   "text": "یک ندایی می‌آید به او جملاتی گفته می‌شود که اگر او بشنود هیچ وقت دیگه از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 221,
   "start": 1071.55,
   "end": 1076.24,
   "text": "قبر حضرت سیدالشهدا سلام الله علیه دست بردار نمی‌شود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 222,
   "start": 1076.24,
   "end": 1078.43,
   "text": "بعد از اینکه منصرف می‌شود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 223,
   "start": 1078.43,
   "end": 1082.29,
   "text": "این هم ذهن بعضی از روایات هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 224,
   "start": 1082.29,
   "end": 1087.19,
   "text": "هست در روایت که برای خانم‌های مؤمن، برای هر زن مؤمنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 225,
   "start": 1087.19,
   "end": 1096.3,
   "text": "این وظیفه است که مصاعدت بکند، کمک بکند به حضرت زهرا سلام الله علیها در زیارت قبر سیدالشهدا سلام الله علیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 226,
   "start": 1096.3,
   "end": 1107.12,
   "text": "این تعبیر روایات است. برای هر زن مؤمنی لازم است که مصاعدت بکند به حضرت زهرا در زیارت قبر حسین سلام الله علیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 227,
   "start": 1107.12,
   "end": 1110.18,
   "text": "خب عرض کنم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 228,
   "start": 1110.18,
   "end": 1113.32,
   "text": "در این زیارت خیلی مسائل هست زیارت عاشورا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 229,
   "start": 1113.32,
   "end": 1115.18,
   "text": "من اینجا یه دوکته می‌خواستم به شما بگم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 230,
   "start": 1115.18,
   "end": 1121.02,
   "text": "اولا برای شما که دستمون که نمی‌رسه اما اینها مجموعاً این روایات در زیارت حضرت اباالفضل عاشورا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 231,
   "start": 1121.02,
   "end": 1122.82,
   "text": "سلام الله علیه، حضرت مسلماً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 232,
   "start": 1122.82,
   "end": 1129.21,
   "text": "کسی که مانند من و شما باشد و دور باشد و دستش نرسد، مسلماً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 233,
   "start": 1129.21,
   "end": 1133.34,
   "text": "این مسائل به او از دور هم متوجه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 234,
   "start": 1133.34,
   "end": 1139.82,
   "text": "خواهد بود. یعنی اگر به عنوان وظیفه حساب کنیم وظیفه من و شماست که زیارت از دور را ترک نکنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 235,
   "start": 1139.82,
   "end": 1143.32,
   "text": "اون نکته اول که می‌گفتم که در این حالت آرام است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 236,
   "start": 1143.32,
   "end": 1146.72,
   "text": "اگر برکات و آثار زیارت را بگیم زیارت عاشورا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 237,
   "start": 1146.72,
   "end": 1155.56,
   "text": "را اگر دستمون نمی‌رسد از نزدیک حتماً از دور ترک نکنید و همان‌طور که اون حافظ شیعی میگه بیا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 238,
   "start": 1155.56,
   "end": 1158.35,
   "text": "باغ خیر شما هم از دور ترک نکنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 239,
   "start": 1158.35,
   "end": 1161.88,
   "text": "دیگه از نزدیک که دست ما نمی‌رسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 240,
   "start": 1161.88,
   "end": 1166.5,
   "text": "مولای يا حسين،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 241,
   "start": 1166.5,
   "end": 1168.9,
   "text": "حسين،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 242,
   "start": 1168.9,
   "end": 1173.6,
   "text": "حسين، حسين،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 243,
   "start": 1173.6,
   "end": 1179.52,
   "text": "مولای يا حسين،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 244,
   "start": 1179.52,
   "end": 1183.04,
   "text": "يا حسين، حسين، حسين،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 245,
   "start": 1183.04,
   "end": 1185.38,
   "text": "حسين،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 246,
   "start": 1185.38,
   "end": 1193.8,
   "text": "مولای يا حسين، يا حسين، حسين،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 247,
   "start": 1193.8,
   "end": 1197.12,
   "text": "حسين،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 248,
   "start": 1197.12,
   "end": 1211.18,
   "text": "حسين، مولای يا حسين،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 249,
   "start": 1211.18,
   "end": 1215.94,
   "text": "يا حسين، حسين، حسين،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 250,
   "start": 1215.94,
   "end": 1220.78,
   "text": "مولای يا حسين،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 251,
   "start": 1220.78,
   "end": 1227.88,
   "text": "حسين، حسين، مولای يا حسين، حسين، حسين، حسين،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 252,
   "start": 1227.88,
   "end": 1232.52,
   "text": "مولای يا حسين،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 253,
   "start": 1232.52,
   "end": 1243.3,
   "text": "حسين. دوستان بخش دیگری از صحبت‌های استاد آیت الله محمد شجاعی را در باب عظمت شخصیت حضرت سید الشهدا علیه السلام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 254,
   "start": 1243.3,
   "end": 1248.36,
   "text": "شنیدید. ادامه این بحث را در برنامه بعد بشنوید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 255,
   "start": 1248.36,
   "end": 1251.34,
   "text": "تا برنامه بعد خدانگهدار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 256,
   "start": 1251.34,
   "end": 1263.18,
   "text": "مولای يا حسين،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 257,
   "start": 1263.18,
   "end": 1272.35,
   "text": "يا حسين، حسين،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 258,
   "start": 1272.35,
   "end": 1277.1,
   "text": "حسين، حسين، مولای يا حسين،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 259,
