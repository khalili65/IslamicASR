 },
 "chapters": [
  {
   "index": 0,
   "title": "## لرزش حر و رفتن به سوی توبه",
   "start": 111.0,
   "end": 883.5
  },
  {
   "index": 1,
   "title": "یاران گفتند:",
   "start": 883.5,
   "end": 1204.06
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 3.1,
   "end": 6.22,
   "text": "حسین، حسین،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 6.22,
   "end": 14.02,
   "text": "حسین، حسین. حسین، حسین، حسین، حسین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 14.02,
   "end": 20.19,
   "text": "شهید زهرای برون حسین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 20.19,
   "end": 23.3,
   "text": "حسین، حسین، حسین، حسین. غریب بن هیج و را حسین. حسین، حسین،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 23.3,
   "end": 36.84,
   "text": "حسین- السلام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 36.84,
   "end": 41.84,
   "text": "علیک یا أبا عبدالله الحسین-",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 41.84,
   "end": 46.72,
   "text": "حسین، حسین- وعلی الارواح التي",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 46.72,
   "end": 57.65,
   "text": "حلت بفنائك- حسین، حسین، حسین، حسین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 57.65,
   "end": 59.38,
   "text": "غریب بن هیج و را حسین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 59.38,
   "end": 68.98,
   "text": "حسین، حسین- چراغ هدایت چراغ و مصباح هدایت تویی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 68.98,
   "end": 77.32,
   "text": "چراغ و مصباح هدایت تویی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 77.32,
   "end": 80.2,
   "text": "سفینه‌ی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 80.2,
   "end": 83.02,
   "text": "غرق در آب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 83.02,
   "end": 88.58,
   "text": "یم کنم. بسم الله الرحمن الرحیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 88.58,
   "end": 91.56,
   "text": "و هو السميع البصير.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 91.56,
   "end": 100.7,
   "text": "السلام علیک یا أبا عبدالله و علی الارواح التي حلت بفنائك.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 100.7,
   "end": 103.58,
   "text": "سلام بر شما همراهان ارزشمند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 103.58,
   "end": 106.16,
   "text": "و دل‌ها به غم گرفته‌تان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 106.16,
   "end": 109.76,
   "text": "که در عزا یال الله سوگوارید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 109.76,
   "end": 111.48,
   "text": "در این برنامه ادامه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 111.48,
   "end": 120.48,
   "text": "صحبت‌های استاد آیت الله محمد شجاعی را در باب شخصیت حضرت امام حسین علیه السلام و اصحاب آن بزرگوار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 120.48,
   "end": 125.06,
   "text": "خواهیم شنید. در برنامه قبل استاد ضمن استناد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 125.06,
   "end": 134.86,
   "text": "به بخش‌هایی از زیارات وارده به جایگاه بلند شهدای کربلا اشاره نمودند و سپس اشاراتی به شخصیت یکی از شهدای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 134.86,
   "end": 139.76,
   "text": "کربلا جناب حر سلام الله علیه داشتند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 139.76,
   "end": 144.42,
   "text": "و ادب آن بزرگوار در مقابل حضرت سید الشهدا علیه السلام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 144.42,
   "end": 150.3,
   "text": "و نکات اسرارآمیز توبه و بازگشت او به سمت امام علیه السلام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 150.3,
   "end": 154.46,
   "text": "ادامه بحث استاد را به اتفاق می‌شنویم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 154.46,
   "end": 156.62,
   "text": "بسم الله الرحمن الرحیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 156.62,
   "end": 162.46,
   "text": "الحمد لله رب العالمین و صلی الله على محمد و آله الطاهرين.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 162.46,
   "end": 170.32,
   "text": "چه سری هست؟ می‌خواهد دل درد بشود از اشیا الله بله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 170.32,
   "end": 174.36,
   "text": "چه سری هست؟ گفت که می‌دیدم بدنش میلرزد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 174.36,
   "end": 176.9,
   "text": "حر هم از شجاعان بود، معروف بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 176.9,
   "end": 180.42,
   "text": "یعنی کسی او را دیده باشد این خودش تعجب کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 180.42,
   "end": 186.14,
   "text": "در جنگ می‌ترسد و از ترس ناب لرزد این معنا نبود که یعنی ترس معمولی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 186.14,
   "end": 188.36,
   "text": "مهاجر می‌دید من گفتم حر،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 188.36,
   "end": 191.54,
   "text": "ای حر رفتار تو مرا به شک انداخت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 191.54,
   "end": 195.44,
   "text": "آخه من این حالت را از تو تا حالا ندیده بودم تو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 195.44,
   "end": 205.14,
   "text": "به این جور بلرزی من اگر می‌گفتند شجاع‌ترین آدم‌ها را از آدم‌های شجاع و اینا مثال بیار تو را می‌گفتند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 205.14,
   "end": 209.92,
   "text": "این گفت و به سرعت اسبش را حرکت داد و رفت به سوی صحرا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 209.92,
   "end": 216.98,
   "text": "ولی دیدید موقع رفتن دیدم که دست‌هاش را گذاشت بالای سرش حالت تسلیم رفت که رفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 216.98,
   "end": 221.2,
   "text": "رفت و بعد به عبدالله صغار الله گفت، گفت منم اون کسی که چه کردم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 221.2,
   "end": 224.48,
   "text": "چه کردم از جرائمش شمرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 224.48,
   "end": 230.37,
   "text": "شمرد یه همه‌ش. بعد گفت من نمی‌دانستم من فکر می‌کردم با شما طور دیگه معامله می‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 230.37,
   "end": 232.0,
   "text": "این‌ها را راست می‌گفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 232.0,
   "end": 235.28,
   "text": "نمی‌دانستم کار اینجا منتهی می‌شود اما الان پشیمان هستم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 235.28,
   "end": 242.68,
   "text": "الان اینجور если اگر می‌دانستم اینجور بود من جلو شما را نمی‌گرفتم که چرا الی آخر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 242.68,
   "end": 246.56,
   "text": "بالاخره الآنم پشیمانم ای فرزند رسول.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 246.56,
   "end": 248.84,
   "text": "آیا حر توبه من قبول",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 248.84,
   "end": 252.18,
   "text": "می‌شود؟ حالا اینجا تو روتی بیاین جمله را بحث بکنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 252.18,
   "end": 256.94,
   "text": "در این باب صحبت بکنیم که این‌ها خصوصیات داشتند اسرارآمیز.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 256.94,
   "end": 260.14,
   "text": "این بزرگواران مخصوص بودند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 260.14,
   "end": 263.84,
   "text": "در خصوص حر گفتم حر با این وضع آمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 263.84,
   "end": 269.86,
   "text": "ولی بزرگانی بودند ابن عباس هم همراه آنها شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 269.86,
   "end": 276.6,
   "text": "اینجا چی میگه؟ بعد از آمدنش به حسین بن علی سلام الله علیه این را گفته بعد از بازگشتش این روایت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 276.6,
   "end": 278.74,
   "text": "چیه؟ قال الحسین علیه السلام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 278.74,
   "end": 283.14,
   "text": "میگه لما وجهنی عبیدالله الیک عبدالله گفت وقتی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 283.14,
   "end": 291.08,
   "text": "که ابن زیاد من و با اون هزار نفر که فرستاد به سوی تو بیای همون که آمد راه را ببر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 291.08,
   "end": 294.46,
   "text": "لما وجهنی عبیدالله الیک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 294.46,
   "end": 296.74,
   "text": "به عبدالله میگه حر میگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 296.74,
   "end": 303.28,
   "text": "بعد از بازگشتم وقتی عبیدالله مرا به سوی شما فرستاد خرجت من القصر از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 303.28,
   "end": 309.82,
   "text": "قصر ابن زیاد از کوفه خارج شدم با اون جمع بیام به سوی تو برای مقابله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 309.82,
   "end": 313.96,
   "text": "که اونا از حجاز و بیابانه کوفه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 313.96,
   "end": 316.3,
   "text": "خنوذیت من خلفی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 316.3,
   "end": 321.6,
   "text": "می‌آمدم از قصر خارج شده بودم از پشت سرم یه ندایی شنیدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 321.6,
   "end": 326.42,
   "text": "بفرمایید. از پشت سرم یه ندایی شنیدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 326.42,
   "end": 341.14,
   "text": "ندا چه بود؟ أبشر یا حر بخیر ندای شنیدم که بشارت با خیر تو را ای حر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 341.14,
   "end": 343.52,
   "text": "میگه اینم نداش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 343.52,
   "end": 346.22,
   "text": "التفت برگشتم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 346.22,
   "end": 350.52,
   "text": "برگشتم که الم أرى کسی را ندیدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 350.52,
   "end": 357.06,
   "text": "کسی را ندیدم. فقلت بعد کسی را ندیدم این ندا چه بود؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 357.06,
   "end": 360.78,
   "text": "فقلت والله ما هذه بشارة",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 360.78,
   "end": 363.38,
   "text": "ببینید اینم، اینم دلیله‌هام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 363.38,
   "end": 367.72,
   "text": "می‌گفتم که قسم به خدا این که بشارت نیست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 367.72,
   "end": 371.4,
   "text": "یعنی اینجا بشارتش من کجا میروم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 371.4,
   "end": 373.04,
   "text": "یعنی به جهنم میروم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 373.04,
   "end": 374.66,
   "text": "من این بشارت دلخواهم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 374.66,
   "end": 378.0,
   "text": "از اول متوجه بود که این رفتن چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 378.0,
   "end": 381.54,
   "text": "اما متوجه آخر قضیه نبوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 381.54,
   "end": 385.4,
   "text": "گفت و گفتم که والله ما هذا بشارت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 385.4,
   "end": 388.66,
   "text": "اینجا هم درس است ها. ببینید برای من و شما درس هست دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 388.66,
   "end": 390.76,
   "text": "اما این بحث طولانی میخواست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 390.76,
   "end": 393.52,
   "text": "وقتی انسان چیزی را به عنوان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 393.52,
   "end": 400.66,
   "text": "کشف و امثال اینها یا خواب اینها دید، ولی خلاف موازین دید باید بداند درست است یا نیست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 400.66,
   "end": 403.48,
   "text": "ها؟ درست نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 403.48,
   "end": 410.1,
   "text": "کشفی بیاید، خوابی بیاد، مقتضایش، مقادیش، مفهومش خلاف موازین باشد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 410.1,
   "end": 413.34,
   "text": "این درست نیست. این حُر بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 413.34,
   "end": 417.84,
   "text": "وقتی که میداند، میداند برای مقابله با حسین بن علی حالا چی بوده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 417.84,
   "end": 421.36,
   "text": "چرا مستور بوده؟ چی بوده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 421.36,
   "end": 426.06,
   "text": "در این حال خودش میدانه که این کار، کار جهنمی‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 426.06,
   "end": 431.02,
   "text": "بنابراین وقتی این جمله را شنید میگه من گفتم والله ما هذا بشارت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 431.02,
   "end": 435.54,
   "text": "این که بشارت نیست. یعنی احتمال دارد که این ندا، ندای چی باشد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 435.54,
   "end": 438.74,
   "text": "شیطانی باشد. اما متوجه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 438.74,
   "end": 443.04,
   "text": "اون یکه قضیه نبود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 443.04,
   "end": 446.4,
   "text": "میگه که قلت ما هذا بشارة و أنا أسیر إلی الحسین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 446.4,
   "end": 450.58,
   "text": "این که بشارت نیست. من میروم به سوی حسین بن علی با او مقابله بکنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 450.58,
   "end": 455.44,
   "text": "سر او را برید کنم و در محاصره بیاندازم و بیارم پیش نزیاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 455.44,
   "end": 459.98,
   "text": "این که بشارت نیست. و ما أُحدِّثُ نَفسي باتباعک.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 459.98,
   "end": 468.5,
   "text": "و ابو عبدالله گفت یا ابو عبدالله من اون وقت هیچ به نظرم نمیآمد که میام در زمره تو قرار میگیرم و این بشارت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 468.5,
   "end": 470.74,
   "text": "چیه؟ بشارت است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 470.74,
   "end": 478.76,
   "text": "هیچ به فکرم نمیآمد. فقال علیه السلام ابو عبدالله در جوابش گفت لعل اصب تعجراً و خیرًا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 478.76,
   "end": 481.14,
   "text": "خب حالا به خیر رسیدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 481.14,
   "end": 483.18,
   "text": "اینها بزرگان بودند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 483.18,
   "end": 485.78,
   "text": "توجه کردید؟ اون ذکر موثور بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 485.78,
   "end": 489.46,
   "text": "اینها هم السلام علیک یا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 489.46,
   "end": 492.28,
   "text": "أث Bیا الله. افراد مخصوص",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 492.28,
   "end": 494.62,
   "text": "بودند. بزرگان بودند. حساب خاص بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 494.62,
   "end": 498.48,
   "text": "اون زهیر بن قینش، این حُر بن یزید ریاحیش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 498.48,
   "end": 501.04,
   "text": "اون زهیر نمیخواست ابو عبدالله را ببیند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 501.04,
   "end": 506.46,
   "text": "آمد و شهید شد. این حُر بن یزید با این وضع آمد و از اث Bیا شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 506.46,
   "end": 512.14,
   "text": "سید الشهدای رفت. عبیدالله یکی دیگه داستان بگم به شما؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 512.14,
   "end": 517.0,
   "text": "نمیدونم بگم. نزدیک کربلا رفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 517.0,
   "end": 518.92,
   "text": "نزدیک بود که به کربلا برسند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 518.92,
   "end": 521.02,
   "text": "همان وقت که همان،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 521.02,
   "end": 524.04,
   "text": "همین حُر بن یزید ریاحی با جمعش مراقب بودند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 524.04,
   "end": 528.82,
   "text": "نمیذاشت اینا برگردند ولی منتظر همان قاصد بودند که فرستاده بودند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 528.82,
   "end": 532.49,
   "text": "گفت که در آتن راهی بکنه که نه مدینه باشد نه کوفه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 532.49,
   "end": 537.96,
   "text": "همون راهی را که در دست گرفتند که بعد از چند منزل منتهی شد به کجا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 537.96,
   "end": 546.3,
   "text": "به کربلا و در کربلا که رسیدند اون قاصد آمد از ناحیه ابن زیاد به حُر دستور داد که در یک جای بی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 546.3,
   "end": 551.68,
   "text": "آب و علفی متوقف بکن و سخت بگیر که شروع شد جریان صدر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 551.68,
   "end": 554.12,
   "text": "قبل از رسیدن به کربلا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 554.12,
   "end": 557.4,
   "text": "که راهشون رو که سر گرفته بودند میرفتند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 557.4,
   "end": 565.85,
   "text": "که وقتی در اجا که ابو عبدالله با جمعش و اصحابش خیمه‌ها را زده بودند، نظرش افتاد یه خیمه در یه طرف.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 565.85,
   "end": 567.75,
   "text": "گفت این خیمه چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 567.75,
   "end": 570.04,
   "text": "گفتن عبیدالله بن حُر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 570.04,
   "end": 573.78,
   "text": "جُعفی است. عبیدالله بن حُر یه شخصی بود از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 573.78,
   "end": 577.2,
   "text": "کوفیان. گفت که برید به،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 577.2,
   "end": 581.02,
   "text": "یه پنل هم فرستاد گفت برید به او بگویید که بیاید اینجا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 581.02,
   "end": 583.12,
   "text": "یعنی حضرت او را طلبی، طلب کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 583.12,
   "end": 585.74,
   "text": "یعنی یه قاصدی فرستاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 585.74,
   "end": 590.18,
   "text": "رفت قاصد وارش شد به عبیدالله بن حُر گفت که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 590.18,
   "end": 595.28,
   "text": "من از ناحیه حسین بن علی میام صلوات الله و ابو عبدالله سید الشهدای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 595.28,
   "end": 601.6,
   "text": "تو را میخواهد. این فوراً گفت إنّا لِلّهِ و إنّا إلیه راجعون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 601.6,
   "end": 606.06,
   "text": "إنّا لِلّهِ یعنی مصیبت شده این دعوت براش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 606.06,
   "end": 608.98,
   "text": "دقت میکنید؟ نقطه مقابل صحبت میکنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 608.98,
   "end": 612.29,
   "text": "نقطه مقابل. مصیبت شده این دعوت براش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 612.29,
   "end": 614.4,
   "text": "گفت إنّا لِلّهِ و إنّا إلیه راجعون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 614.4,
   "end": 617.82,
   "text": "من از کوفه اصلاً خارج شدم برای اینکه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 617.82,
   "end": 622.26,
   "text": "خواستم اون وقتی که حسین بن علی میاد کوفه من اونجا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 622.26,
   "end": 626.8,
   "text": "نباشم و نمیخواهم نه من او را ببینم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 626.8,
   "end": 631.04,
   "text": "نه او مرا ببیند. مسلمان هم بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 631.04,
   "end": 634.26,
   "text": "جمله بعدی هم دارد که من بگم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 634.26,
   "end": 635.98,
   "text": "زیاد متاثر میشویم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 635.98,
   "end": 638.66,
   "text": "نمیخواهم اون جمله بعدیش رو بگم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 638.66,
   "end": 642.0,
   "text": "جمله بعدی داره. اگر مسئله اینجا خواستم پیدا نکنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 642.0,
   "end": 644.62,
   "text": "جمله بعدش دردآورتره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 644.62,
   "end": 649.46,
   "text": "جمله البته صحبت در این است که این اث Bیا، اث Bیا بودند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 649.46,
   "end": 652.94,
   "text": "اسرار از در بین. این هم مسلمان بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 652.94,
   "end": 657.5,
   "text": "صحبت در این است. و الا ابو عبدالله همان است که گفت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 657.5,
   "end": 660.38,
   "text": "و همان است که در زیارت ها گفتیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 660.38,
   "end": 664.14,
   "text": "و همان است که الله لا أوتيناکم یدی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 664.14,
   "end": 667.08,
   "text": "اعطا از دلیل. ولی مسئله این بود که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 667.08,
   "end": 669.22,
   "text": "جوهره ها بیرون آمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 669.22,
   "end": 674.14,
   "text": "بنابراین اینو توجه بکنید بعد دنبال جریان بحث کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 674.14,
   "end": 677.7,
   "text": "قاصد آمد گفت که رفتم و گفتم اینجور گفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 677.7,
   "end": 680.62,
   "text": "حضرت سید الشهدای صلوات الله علیه خودش بلند شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 680.62,
   "end": 684.52,
   "text": "خودش بلند شد رفت خیمه همون شخص.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 684.52,
   "end": 687.27,
   "text": "سلام کرد. نشست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 687.27,
   "end": 694.16,
   "text": "خلاصه به نصرتش دعوت کرد و اون طرف هم همون جمله ها رو تکرار کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 694.16,
   "end": 695.9,
   "text": "به نصرت خودش دعوت کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 695.9,
   "end": 697.94,
   "text": "به یاری خودش دعوت کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 697.94,
   "end": 702.02,
   "text": "اون شخص هم همون جمله ها رو تکرار کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 702.02,
   "end": 708.46,
   "text": "بعد حضرت فرمود حالا که به آقای ما یاری نمیکنی وظیفت این که بر علیه ما به جنگ قیام کنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 708.46,
   "end": 710.14,
   "text": "وارد جنگ بشی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 710.14,
   "end": 716.1,
   "text": "گفت خدا شنیده نکن. اینا خلاصه شهدا اث Bیا بودند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 716.1,
   "end": 718.44,
   "text": "مسئله اسرارآمیز است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 718.44,
   "end": 726.3,
   "text": "و یک جمله هم از این حالات شهدا از شب عاشورا برای شما بخوانم تمام میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 726.3,
   "end": 733.88,
   "text": "دیگه تمام. حس می‌کنم که این جمع هم متذکر شدیم اینها چه بزرگان بوده‌اند و چه اسراری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 733.88,
   "end": 736.46,
   "text": "در بین بوده‌اند. در جلد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 736.46,
   "end": 741.02,
   "text": "چهل و چهار بهار،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 741.02,
   "end": 747.68,
   "text": "شب عاشورا، شب عاشورا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 747.68,
   "end": 751.06,
   "text": "از جریان،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 751.06,
   "end": 758.86,
   "text": "جریانات شب عاشورا در خصوص این بزرگان است، این شهدا است، این اصفیاالله است، اینها که حساب خاصی داشتند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 758.86,
   "end": 763.76,
   "text": "فرد معمولی حساب نباید کرد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 763.76,
   "end": 767.64,
   "text": "در این باب. این شب از جریانات شب عاشورایی به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 767.64,
   "end": 769.34,
   "text": "خصوص همین‌ها بگم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 769.34,
   "end": 779.36,
   "text": "این در جلد چهل و چهار صفحه دویست و نود و هشت روایتی را نقل می‌کنه از ابو حمزه ثمالی با-- سندشو نخوندم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 779.36,
   "end": 785.08,
   "text": "از امام سجاد، امام سجاد هم که بود دیگه در جریان کربلا بود، شب عاشورا بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 785.08,
   "end": 787.06,
   "text": "قال علی بن الحسین علیه السلام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 787.06,
   "end": 793.36,
   "text": "از سجاد می‌فرماید کُنتُ مَعَ أَبِی تِلْ لَيْلَةِ الَّتِي قُتِلَ فِي صَبِيحَتِهَا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 793.36,
   "end": 798.3,
   "text": "من با پدرم اون شب، شب عاشورایی که صبحش به شهادت رسید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 798.3,
   "end": 800.2,
   "text": "با پدرم بودم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 800.2,
   "end": 803.96,
   "text": "از امام سجاد می‌فرماید. فَذَالَ لِأَصْحَابِ.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 803.96,
   "end": 810.64,
   "text": "در محضر پدرم بودم به اصحابش، همین اصحاب که پرورше شده‌اند، همین بزرگان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 810.64,
   "end": 816.42,
   "text": "به اصحابش گفت که هَذَا اللَّيْلَ فَتَّخِذُوهُ جُنَّةً.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 816.42,
   "end": 824.13,
   "text": "آخه این، اینه این داستان وقتی گفت که الان شب هست و ظلمت هست و تاریک است اینها فقط کارشون با من است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 824.13,
   "end": 828.4,
   "text": "شما می‌توانید از این شب استفاده کنید، از ظلمت شب بروید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 828.4,
   "end": 833.62,
   "text": "فردا دیگه، فردا مسئله khác هم پیدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 833.62,
   "end": 836.18,
   "text": "می‌شه. هَذَا اللَّيْلَ فَتَّخِذُوهُ جُنَّةً.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 836.18,
   "end": 839.44,
   "text": "این شب است این را ستر برای خود قرار بدهید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 839.44,
   "end": 842.98,
   "text": "ظلمت شب را ابا عبدالله فرمود به نقل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 842.98,
   "end": 850.54,
   "text": "امام سجاد. امام سجاد میگه پدرم به اصحابش گفت این شب را ستر اتخاذ کنید و ظلمت شب را.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 850.54,
   "end": 855.08,
   "text": "فَإِنَّ الْغُـ یعنی بروید اگر می‌خواهید فَإِنَّ الْغُومَةَ إِنَّمَا يُرِيدُونَنِي.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 855.08,
   "end": 857.74,
   "text": "اینها فقط مقصودشون من هستم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 857.74,
   "end": 864.12,
   "text": "وَلَوْ قَتَلُونِي. اینو بدانید فردا بعد از اینکه منو به شهادت رساندند ذَنْ يَرْتَفِتُوا إِلَيْكُمْ.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 864.12,
   "end": 867.86,
   "text": "به دنبال شما نخواهند آمد چون مقصودشون من هستم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 867.86,
   "end": 870.88,
   "text": "وَأَنْتُمْ فِي حِلٍّ وَكِـ شما راحت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 870.88,
   "end": 872.68,
   "text": "یعنی با شما کاری نخواهند داشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 872.68,
   "end": 875.22,
   "text": "اگر می‌خواهید بروید. مقصودشون من.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 875.22,
   "end": 878.4,
   "text": "فَقَالُوا بِاللهِ لا يَكُونُ هَذَا أَبَدًا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 878.4,
   "end": 881.68,
   "text": "قسم به خدا این که نمی‌شود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 881.68,
   "end": 883.5,
   "text": "والله ما يَكُونُ هَذَا أَبَدًا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 883.5,
   "end": 886.66,
   "text": "جمله‌های زیادی هم گفتند که اونها در این روایت نیامده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 886.66,
   "end": 889.08,
   "text": "اینجا خلاصه‌ش آمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 889.08,
   "end": 893.0,
   "text": "گُه هم شدن تک تک جمله‌ها گفتند همین بزرگان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 893.0,
   "end": 895.59,
   "text": "این جمله‌ی کللی والله لا يَكُونُ هَذَا أَبَدًا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 895.59,
   "end": 897.6,
   "text": "این که نخواهد شد، این که نمی‌شود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 897.6,
   "end": 902.9,
   "text": "فکان بعد اباعبدالله فرمود إِنَّكُمْ تُقْتَلُونَ غَدًا كُلُّكُمْ.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 902.9,
   "end": 909.14,
   "text": "گفت اگر اینجا باشید فردا بدانید که همه شما کشته خواهید شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 909.14,
   "end": 911.9,
   "text": "كُلُّكُمْ وَلا يَخْلُصُ مِنْكُمْ رَجُلٌ.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 911.9,
   "end": 915.2,
   "text": "اه از شما باقی نخواهد ماند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 915.2,
   "end": 917.46,
   "text": "قَالُوا چه جواب دادند؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 917.46,
   "end": 922.12,
   "text": "گفتند الْحَمْدُ لِلَّهِ الَّذِي شَرَّفَنَا بِالْقَتْلِ مَعَكَ.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 922.12,
   "end": 926.28,
   "text": "خدا را شکر که این شرافت را داد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 926.28,
   "end": 930.12,
   "text": "که با، در رکابت ما کشته بشویم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 214,
   "start": 930.12,
   "end": 933.64,
   "text": "ثُمَّ دَعَا. این جمله‌ها که شد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 215,
   "start": 933.64,
   "end": 939.54,
   "text": "ثُمَّ دَعَا. امام سجاد میگه سپس امام یعنی ابا عبدالله دعا کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 216,
   "start": 939.54,
   "end": 947.3,
   "text": "فَقَالَ لَهُمْ دعایی کرد به این شهدا گفت که اینا که خب دیگه اظهار پشیمانی کردند گفت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 217,
   "start": 947.3,
   "end": 953.24,
   "text": "اینها دعایی کرد به اینها گفت که ارْفَعُوا رُؤُوسَكُمْ وَانْظُرُوا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 218,
   "start": 953.24,
   "end": 955.32,
   "text": "این جمله‌هاش تمام شد گفت که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 219,
   "start": 955.32,
   "end": 959.92,
   "text": "حالا سرهاتون رو بلند بکنید نگاه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 220,
   "start": 959.92,
   "end": 964.04,
   "text": "نگاه. سرهاتون رو بلند بکنید نگاه کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 221,
   "start": 964.04,
   "end": 969.12,
   "text": "فَجَعَلُوا يَنْظُرُونَ. این نگاه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 222,
   "start": 969.12,
   "end": 975.12,
   "text": "نگاهی بود که اینها یعنی با اون تصرف و با اون دعا و با",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 223,
   "start": 975.12,
   "end": 979.3,
   "text": "اون نظر حضرت پرده‌ها رفت کنار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 224,
   "start": 979.3,
   "end": 983.94,
   "text": "و اینها منازلت‌های خودشون را در اون سو که کردن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 225,
   "start": 983.94,
   "end": 987.52,
   "text": "دیدند که فردا به اون منازلت‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 226,
   "start": 987.52,
   "end": 994.27,
   "text": "بنا بود نائل بشوند. فَجَعَلُوا يَنْظُرُونَ إِلَى مَوَازِعِهِمْ وَمَنَازِلِهِمْ فِي الْجَنَّةِ.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 227,
   "start": 994.27,
   "end": 999.3,
   "text": "اینا پرده کنار رفت و منازلت‌های خود، خودشون را،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 228,
   "start": 999.3,
   "end": 1001.94,
   "text": "جایگاه‌های خودشون را از بهشت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 229,
   "start": 1001.94,
   "end": 1004.15,
   "text": "نگاه می‌کردند همشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 230,
   "start": 1004.15,
   "end": 1006.88,
   "text": "وَسَيِّدُ الشُّهَدَاءِ وَهُوَ يَقُولُ لَهُمْ.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 231,
   "start": 1006.88,
   "end": 1011.3,
   "text": "خودش هم به تک تک اونها می‌فرمود هَذَا مَنْزِلُكَ يَا فُلَانَ.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 232,
   "start": 1011.3,
   "end": 1014.18,
   "text": "هر کدوم رو می‌گفت اون منازلت توست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 233,
   "start": 1014.18,
   "end": 1016.44,
   "text": "اون جای توست تک تک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 234,
   "start": 1016.44,
   "end": 1018.46,
   "text": "منازلتشون را نشان می‌داد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 235,
   "start": 1018.46,
   "end": 1021.5,
   "text": "فکان اون جای توست تک تک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 236,
   "start": 1021.5,
   "end": 1023.52,
   "text": "منازلتشون را نشان می‌داد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 237,
   "start": 1023.52,
   "end": 1029.42,
   "text": "فَكَانَ الرَّجُلُ امام سجاد می‌فرماید اینها که این حجاب‌ها رفت و این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 238,
   "start": 1029.42,
   "end": 1030.6,
   "text": "مسائل را دیدند،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 239,
   "start": 1030.6,
   "end": 1033.7,
   "text": "این حقایق مکشوف شد فَكَانَ الرَّجُلُ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 240,
   "start": 1033.7,
   "end": 1038.6,
   "text": "يَسْتَقْبِلُ الرِّمَاحَ وَالسُّيُوفَ بِصَدْرِهِ وَبَشِئِهِ لِيَتَصِلَ إِلَى",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 241,
   "start": 1038.6,
   "end": 1041.46,
   "text": "مَنْزِلَتِهِ مِنَ الْجَنَّةِ.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 242,
   "start": 1041.46,
   "end": 1043.64,
   "text": "روی همین حساب اینها که،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 243,
   "start": 1043.64,
   "end": 1046.52,
   "text": "این که منازلت‌ها را دیدند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 244,
   "start": 1046.52,
   "end": 1051.52,
   "text": "فردا در موقع جنگ اینا چنان با نیزه‌ها،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 245,
   "start": 1051.52,
   "end": 1055.46,
   "text": "با شمشیرها، با تیرها،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 246,
   "start": 1055.46,
   "end": 1057.84,
   "text": "با آغوش باز چی می‌کردند؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 247,
   "start": 1057.84,
   "end": 1060.56,
   "text": "البته جنگشون برای کشته شدن نبود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 248,
   "start": 1060.56,
   "end": 1064.58,
   "text": "برای کشتن بودم و آماده و مشتاق جنگ بودم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 249,
   "start": 1064.58,
   "end": 1070.56,
   "text": "مشتاق شهادتم بودم. می‌دانست که همه‌شون هم معمولاً زیاد کشتند و بعد کشته شدند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 250,
   "start": 1070.56,
   "end": 1077.44,
   "text": "ولی میگه با یک وجدی این تیرها را، شمشیرها را، نیزه‌ها را اینا چی می‌کردند؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 251,
   "start": 1077.44,
   "end": 1081.5,
   "text": "استقبال می‌کردند. استقبال کلمه‌ای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 252,
   "start": 1081.5,
   "end": 1084.4,
   "text": "به اصطلاح تکرار شده در همین روایت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 253,
   "start": 1084.4,
   "end": 1087.1,
   "text": "صبح انشاالله که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 254,
   "start": 1087.1,
   "end": 1090.6,
   "text": "من و شما انشاالله از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 255,
   "start": 1090.6,
   "end": 1094.46,
   "text": "نظر و برکات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 256,
   "start": 1094.46,
   "end": 1099.08,
   "text": "توجه اون حضرت یعنی سیدالشهدای صلوات الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 257,
   "start": 1099.08,
   "end": 1102.64,
   "text": "و همچنین شهدا که با اون حضرت شهید شدند،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 258,
   "start": 1102.64,
   "end": 1108.86,
   "text": "مخصوصاً حضرت ابالفضل صلوات الله و حضرت علی اکبر صلوات الله که مقام و منزلت مخصوصی دارند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 259,
   "start": 1108.86,
   "end": 1112.48,
   "text": "انشاالله خدا کنه من و شما محروم نباشیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 260,
   "start": 1112.48,
   "end": 1118.84,
   "text": "و در این ماه محرم آداب و عزادار را مراعات کنیم در ایام ماه محرم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 261,
   "start": 1118.84,
   "end": 1125.78,
   "text": "و ایام صفر. در دو ماه مخصوصاً آدابش رو مراعات بکنیم انشاالله موفق باشیم آداب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 262,
   "start": 1125.78,
   "end": 1132.18,
   "text": "عزادار را داشته باشیم آدابش رو مراعات بکنیم و از برکات توجه اون حضرت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 263,
   "start": 1132.18,
   "end": 1141.26,
   "text": "و حضرت ابالفضل صلوات الله و علی اکبر صلوات الله و سایر شهدا و اهل بیت اون حضرت و حضرت زینب همشون،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 264,
   "start": 1141.26,
   "end": 1147.44,
   "text": "همشون انشاالله بهره‌مند باشیم هم آداب را به جا بیاریم و هم بهره‌مند باشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 265,
   "start": 1147.44,
   "end": 1149.46,
   "text": "السلام علیکم و رحمه الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 266,
   "start": 1149.46,
   "end": 1153.66,
   "text": "السلام علیک یا صابر الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 267,
   "start": 1153.66,
   "end": 1160.6,
   "text": "دوستان در برنامه‌ی بعد ادامه‌ی صحبت‌های استاد آیت الله محمد شجاعی را",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 268,
   "start": 1160.6,
   "end": 1170.44,
   "text": "در باب شخصیت و نهضت حضرت امام حسین علیه السلام و ابعادی از این واقعه‌ی بی‌بدیل نظام هستی بشنوید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 269,
   "start": 1170.44,
   "end": 1177.52,
   "text": "خدا نگهدار. حسین،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 270,
   "start": 1177.52,
   "end": 1194.76,
   "text": "حسین، حسین،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 271,
   "start": 1194.76,
   "end": 1204.06,
   "text": "حسین، حسین، حسین، حسین، حسین، شهید کربلا حسین، حسین، حسین، حسین، ضریح بنین و حسین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}