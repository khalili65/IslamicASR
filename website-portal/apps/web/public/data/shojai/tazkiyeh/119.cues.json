  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.94,
   "end": 4.02,
   "text": "اعوذ بالله السميع العليم من الشيطان الرجيم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 4.02,
   "end": 6.52,
   "text": "بسم الله الرحمن الرحيم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 6.52,
   "end": 8.9,
   "text": "در این جلسه هم در دنباله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 8.9,
   "end": 16.02,
   "text": "مبحثی که داشتیم در تجلیات ربوبیت برای صالح صادق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 16.02,
   "end": 24.02,
   "text": "با صفت جمال، با صفت جلال را اول نمونه‌هایی گفتیم با صفت جمال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 24.02,
   "end": 26.02,
   "text": "که در مجموع",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 26.02,
   "end": 29.0,
   "text": "صالح را به حال اندوه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 29.0,
   "end": 32.68,
   "text": "امید و رجا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 32.68,
   "end": 37.62,
   "text": "می‌آورد. تجلی است با صفت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 37.62,
   "end": 42.04,
   "text": "مغفران و مغفرت که غیر از عفو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 42.04,
   "end": 47.3,
   "text": "است. یا تجلی ربوبیت با اسم غفور و افوار که غیر از عفو است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 47.3,
   "end": 55.4,
   "text": "البته فرق بین عفو و غفران را از هفته گذشته تاحدودی اشاره کردم که قبلاً هم من در بعضی از نوشته‌هام،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 55.4,
   "end": 59.44,
   "text": "مقالاتی که من نوشتم اگر به دستتان رسیده باشد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 59.44,
   "end": 63.9,
   "text": "و فرق بین عفو و غفران در اونچه که گفتیم یا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 63.9,
   "end": 65.78,
   "text": "خنده گفتم و نوشتم خلاصه نمی‌شود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 65.78,
   "end": 68.0,
   "text": "خیلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 68.0,
   "end": 72.9,
   "text": "فرق باریک و خیلی دارای ابعاد و اسرار است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 72.9,
   "end": 78.22,
   "text": "ان شا الله که خود شما خدا عنایت می‌کند بهتر متوجه می‌شوید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 78.22,
   "end": 87.42,
   "text": "مخصوصاً حالا در همین جا من دوباره توصیه می‌کنم که به آیاتی که در آن‌ها کلمه عفو، مشتقات عفو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 87.42,
   "end": 91.88,
   "text": "به کار رفته و در اشارات اون آیات و همچنین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 91.88,
   "end": 95.22,
   "text": "در آیاتی که زیاد هم هست تعدادش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 95.22,
   "end": 105.22,
   "text": "نسبت به اون آیاتی که در آن‌ها عفو است، در آیاتی که مغفرت، غفران و مشتقاتش و عفو، غفار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 105.22,
   "end": 108.94,
   "text": "مغفرت با اجتهادات مختلف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 108.94,
   "end": 114.38,
   "text": "مطرح شده در قرآن کریم که گفتم خیلی زیاد است و همه‌اش هم چون که قرآن سخن است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 114.38,
   "end": 120.2,
   "text": "و دارای اشارات و نماد است برای هرکسی به اندازه‌ی خودش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 120.2,
   "end": 121.87,
   "text": "تأمل زیاد می‌فرمایید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 121.87,
   "end": 124.46,
   "text": "حالا ببینید مسئله غفران چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 124.46,
   "end": 132.48,
   "text": "این یک نظر می‌شود گفت که آنچه برای انسان هست در این آفرینش مقدّس است در غفران خلاصه می‌شود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 132.48,
   "end": 138.02,
   "text": "غفران دائرش خیلی وسیع است، ابعادش خیلی میتند به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 138.02,
   "end": 140.4,
   "text": "است و غفران در صورت‌های مختلف است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 140.4,
   "end": 146.46,
   "text": "این‌جوری که از قرآن استفاده می‌شود غفران قبل از توبه است، غفران بعد از توبه است،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 146.46,
   "end": 154.46,
   "text": "غفران قبل از به خود آمدن است، غفران بعد از به خود آمدن است، غفران قبل از عفو است، غفران بعد از عفو است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 154.46,
   "end": 157.1,
   "text": "که من اون وقت به یکی‌ش اشاره کردم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 157.1,
   "end": 162.6,
   "text": "نظرتون هست؟ گفتم که اگر خدای متعال بخواهد با اسم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 162.6,
   "end": 171.14,
   "text": "عفویش برای صالح تجلی بکند و اون سابقه صالح را از او و او را از سابقه اشتباهش است جدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 171.14,
   "end": 177.96,
   "text": "بکند که این تجلی عفو با صفت عفو بود، بسیار نیاز دارد قبل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 177.96,
   "end": 180.86,
   "text": "از تجلی عفو با صفت غفور.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 180.86,
   "end": 184.86,
   "text": "این غفران قبل از به اصطلاح",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 184.86,
   "end": 188.38,
   "text": "عفو است. بلعکسش هم هست یعنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 188.38,
   "end": 193.82,
   "text": "بعد از عفو هم غفران دیگری هست که البته اینها همه غیر عمدند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 193.82,
   "end": 198.66,
   "text": "بالاخره این‌که تا این حد غفران زیاد است و نمی‌شود در این صحبت‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 198.66,
   "end": 201.18,
   "text": "با این موصله‌های کم و با این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 201.18,
   "end": 203.76,
   "text": "ظرفیت‌های کم و با این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 203.76,
   "end": 211.66,
   "text": "عدم طلاعت خودم مانند من بیننده‌ها مسائل که مربوط به غفران است مطرح بشود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 211.66,
   "end": 214.12,
   "text": "ولی همین‌قدر تأمل زیاد بکنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 214.12,
   "end": 216.98,
   "text": "در این جلسه من در تجلی ربوبیت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 216.98,
   "end": 220.72,
   "text": "با اسم غفور برای صالح",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 220.72,
   "end": 224.62,
   "text": "که نه تنها به صورت کلی عرض",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 224.62,
   "end": 227.28,
   "text": "می‌کنم از جمله تجلیات ربوبیت با صفت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 227.28,
   "end": 234.5,
   "text": "جمال است. غفران از خدا می‌بینیم در which گفتم ابعاد زیاد دارد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 234.5,
   "end": 238.48,
   "text": "در کل می‌شود چنین تعریف کرد غفران را.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 238.48,
   "end": 240.96,
   "text": "غفران اضافه ای در حق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 240.96,
   "end": 244.0,
   "text": "البته این تعریفی هم که عرض می‌کنم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 244.0,
   "end": 247.98,
   "text": "این تعریف درست مقتبس از بیان استاد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 247.98,
   "end": 254.16,
   "text": "مرحوم عزیزان ما آله، آیت الله عسگری در رساله اسماشان که ما داریم خطی‌ش است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 254.16,
   "end": 256.62,
   "text": "خطی است البته رساله اسما چاپ نشده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 256.62,
   "end": 261.4,
   "text": "نمی‌دانم الان چاپ کرده‌اند یا نه ولی به هر حال خطی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 261.4,
   "end": 263.2,
   "text": "است. از این آقا که چاپ نشده بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 263.2,
   "end": 268.6,
   "text": "در اونجا ایشان در بحثی، بحثی دیگر، رساله ای که در اسما دارند در اونجا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 268.6,
   "end": 274.08,
   "text": "وقتی که اسم غفور را عنوان می‌کنند که از آن شعابات اسم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 274.08,
   "end": 276.15,
   "text": "بالایی است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 276.15,
   "end": 282.66,
   "text": "عرض می‌کنند اونجا غفران را از تعریف جامع که خیلی خلاصه‌اش دارم این‌طور می‌شود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 282.66,
   "end": 285.82,
   "text": "برداشت کرد و با آیات هم همین‌طور استفاده می‌شود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 285.82,
   "end": 289.86,
   "text": "در تعریف کلی غفران هدی در حق،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 289.86,
   "end": 295.72,
   "text": "اضافه ای در حق، رحمت در حق که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 295.72,
   "end": 300.32,
   "text": "اون را نقائص را از وجود صالح",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 300.32,
   "end": 304.28,
   "text": "برطرف می‌کند. البته این غیر از عفو است ها اشتباه نکنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 304.28,
   "end": 310.12,
   "text": "عفو نادیده گرفتن گفتم اون جرائم و زنگه‌هات هست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 310.12,
   "end": 320.1,
   "text": "و انتضار وجودی انسان هست و مانع، و مانع است اگر اون از انسان جدا نشود از حرکت انسان و در آخرت هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 320.1,
   "end": 323.8,
   "text": "موجب عذاب است. این عفو است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 323.8,
   "end": 328.4,
   "text": "غفران هدی، اضافه ای، رحمتی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 328.4,
   "end": 331.7,
   "text": "از خدا می‌رسد به صالح",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 331.7,
   "end": 335.38,
   "text": "و به هر کسی که مشمول مغفرت می‌شود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 335.38,
   "end": 343.06,
   "text": "می‌رسد و در مجموع باید گفت اون نقائص‌ها، شمول‌ها، نقائص، اون کم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 343.06,
   "end": 346.16,
   "text": "داشتن‌ها، اون نداشتن‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 346.16,
   "end": 349.78,
   "text": "و اون نیازها که برای صالح است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 349.78,
   "end": 353.08,
   "text": "اون را برمی‌کند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 353.08,
   "end": 358.3,
   "text": "خالی می‌کنه وجود صالح را از آنچه که باید پر شود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 358.3,
   "end": 363.8,
   "text": "کمی می‌کند از اونچه-- صالح را از آنچه به اون نیاز دارد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 363.8,
   "end": 368.56,
   "text": "زینت می‌بخشد به سالک با آنچه که باید داشته باشد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 368.56,
   "end": 374.46,
   "text": "در بیان دیگر آمادگی می‌دهد سالک برای لقاء",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 374.46,
   "end": 379.56,
   "text": "حق و ورود به جوار دوست حق و به سالک حق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 379.56,
   "end": 382.36,
   "text": "معنی غفران این است. حالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 382.36,
   "end": 386.4,
   "text": "با این توصف و تصف کردن انشاالله شما دیگه از اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 386.4,
   "end": 388.8,
   "text": "برداشت عامیانه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 388.8,
   "end": 391.72,
   "text": "معمولاً ماها هم بر اساس اون برداشت کلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 391.72,
   "end": 399.3,
   "text": "عامیانه در ذهن داریم، پس غفران یک چیزیست که مثلاً یک چیز اتفاقی و مانند اینها اینطور نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 399.3,
   "end": 403.26,
   "text": "پس اگر شما حساب بکنید، حالا گفتم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 403.26,
   "end": 405.74,
   "text": "این بحث‌ها را نمی‌شود الان این‌ها را بحث کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 405.74,
   "end": 411.98,
   "text": "مثلاً شما به هر کجای وجود نگاه بکنید، به هر ذره‌ای نگاه بکنید، قدمی که برمی‌دارد، نقیضه‌ای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 411.98,
   "end": 414.64,
   "text": "از اون می‌رود، کمالی که روش می‌آید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 414.64,
   "end": 416.42,
   "text": "از تجلیات چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 416.42,
   "end": 420.59,
   "text": "از تجلیات وجود است با اسم غفور است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 420.59,
   "end": 428.34,
   "text": "اون چیزی که نباتی می‌شود، خدا با اسم غفورش، گفتیم این جمله آیه دقت بکنید، اون نباتی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 428.34,
   "end": 432.0,
   "text": "انسان می‌شود، خدا با اسم غفورش برای چی می‌کند؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 432.0,
   "end": 441.24,
   "text": "تجلی می‌کند. وجود ذرات وجود از همین جا که به وجود می‌آیند و در مسیر کمال به سوی کمال مطلق حرکت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 441.24,
   "end": 445.3,
   "text": "می‌کنند، هر قدمی که برمی‌دارند، هر کمالی که به اون‌ها می‌رسد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 445.3,
   "end": 452.52,
   "text": "هر چیزی که به اون‌ها می‌رسد از مبدأ وجود صریحت است و بر اساس خصوص و قوانین و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 452.52,
   "end": 456.08,
   "text": "سنت پذیر شده، همین جلوه های الهی حق است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 456.08,
   "end": 458.63,
   "text": "اون‌ها در واقع تجلیات اسم غفور است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 458.63,
   "end": 460.59,
   "text": "دقت کنید فقط برای انسان مخصوص است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 460.59,
   "end": 462.51,
   "text": "خدا برای همه غفور است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 462.51,
   "end": 469.38,
   "text": "دقت بکنید. مثلاً این که این چیزها سر ما اشتباه شده اسم‌های خدا، صفات خدا فقط همه‌ش برای چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 469.38,
   "end": 471.18,
   "text": "فقط برای انسان است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 471.18,
   "end": 473.16,
   "text": "خدا، خدای همه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 473.16,
   "end": 477.72,
   "text": "اما غفران خدا برای هر موجودی به تناسب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 477.72,
   "end": 480.8,
   "text": "وجودش. خدا غفور است برای هر مخلوقش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 480.8,
   "end": 483.28,
   "text": "خدا غفور است هم برای همه‌ش،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 483.28,
   "end": 485.82,
   "text": "راض هم برای همه‌ش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 485.82,
   "end": 487.9,
   "text": "کل اسماء خدا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 487.9,
   "end": 491.5,
   "text": "صفات خدا برای کل مخلوقات خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 491.5,
   "end": 497.56,
   "text": "فقط اینکه درباره هر مخلوقی وقتی اثر اون اسم یا برکات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 497.56,
   "end": 502.25,
   "text": "اون اسم را وقتی می‌خواهیم ملاحظه بکنیم باید به تناسب خود اون مخلوق باشد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 502.25,
   "end": 509.0,
   "text": "دیگه اون غفرانی که به انسان می‌رسد غیر از آن است که به خاک می‌رسد، خاک را نبات می‌کند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 509.0,
   "end": 515.22,
   "text": "اونی که به خاک می‌رسد و خاک را نبات می‌کند، همونی است که شما نامش می‌گویید کمال نباتی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 515.22,
   "end": 519.24,
   "text": "دقت بکنید. نباتی، یعنی کمالی که آمد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 519.24,
   "end": 524.02,
   "text": "آمد و برای یک کمبودی را از این خاک چه کرد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 524.02,
   "end": 526.28,
   "text": "ازش رفع کرد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 526.28,
   "end": 530.42,
   "text": "برطرف کرد. به همین طور و به طلاق است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 530.42,
   "end": 534.2,
   "text": "اون غفران پس برای همه هست، برای انسان هم هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 534.2,
   "end": 538.42,
   "text": "البته در انسانی که در مسیر کمال باشد، طبیعی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 538.42,
   "end": 542.36,
   "text": "انسانی که در مسیر حرکت به سوی عمل به دستور حق باشد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 542.36,
   "end": 548.52,
   "text": "و کمال مطلق باشد، خداوند غفرانش را مرتب تکمیل می‌کند،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 548.52,
   "end": 557.88,
   "text": "تکمیل می‌کند، زینت می‌بخشد، زاهی می‌کند، زیاد می‌کند، توسعه می‌دهد، فرمایه‌ش نقایص را برطرف می‌کند،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 557.88,
   "end": 562.66,
   "text": "تا به تناسب آن جوار خودش کند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 562.66,
   "end": 569.14,
   "text": "و بنابراین این معنایی که عامیانه به ذهن ما است،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 569.14,
   "end": 571.84,
   "text": "بگذار. این تعریف کلی و کوتاه که برای شما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 571.84,
   "end": 574.96,
   "text": "من عرض کردم. خب این تجلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 574.96,
   "end": 584.56,
   "text": "خدا با اسم غفورش یا غفارش برای سالک چون سالک، سالک سابق است، فرض بگیریم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 584.56,
   "end": 595.18,
   "text": "و قدم در طریقی گذاشته که به سوی حق منتهی می‌شود، فرض کرده‌ایم سابقانه و متصانه، طبعا اون باید اون عیوبی را که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 595.18,
   "end": 601.12,
   "text": "در وجودش هست که نمی‌گذارد با اون عیوب به لقاء رسد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 601.12,
   "end": 604.76,
   "text": "اون کمبودهایی که در خود این انسان،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 604.76,
   "end": 611.7,
   "text": "که با اون کمبودها به اونجا راه پیدا نمی‌کند، تناسب لازم است، دقت کنید، عرضم گفتم، اون‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 611.7,
   "end": 613.72,
   "text": "را غفور با،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 613.72,
   "end": 622.06,
   "text": "یعنی خدا با تجلیاتش، با صفت غفور که می‌کنه از الاتصال سالک برطرف می‌کند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 622.06,
   "end": 627.18,
   "text": "سالک را از این مشمول غفرانش می‌کنه، این مشمول غفرانش می‌کند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 627.18,
   "end": 631.44,
   "text": "و در آخر هم باید اینطور بگویم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 631.44,
   "end": 633.92,
   "text": "در آخر هم اون نباتی کلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 633.92,
   "end": 643.0,
   "text": "که ریشه همه گناهان است، ریشه همه گناهان، خوب عمل بکنه انشاالله بگوید که شما بعضی از حرف‌ها را نمی‌شنوید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 643.0,
   "end": 645.8,
   "text": "حالا من این‌طور فکر می‌کنم انشاالله که درست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 645.8,
   "end": 649.08,
   "text": "فکر می‌کنم که شما misschien بعضی حرف‌ها را که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 649.08,
   "end": 651.5,
   "text": "شما هم انشاالله عرض می‌کنید،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 651.5,
   "end": 654.24,
   "text": "اون ریشه همه گناهان که اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 654.24,
   "end": 660.04,
   "text": "شاعر گفت که بین من و بین خدای من مانع می‌شود که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 660.04,
   "end": 663.16,
   "text": "از اونچه که می‌خواهم. لذا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 663.16,
   "end": 667.28,
   "text": "اون گناهاتی که من هستم که اون من و از من برتره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 667.28,
   "end": 671.99,
   "text": "و چه کسی می‌گوید که من قبلاً گفتم و در اینجا اشاره می‌کنم که بیاد داشته باشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 671.99,
   "end": 676.6,
   "text": "می‌گوید که گناه، من خودم برای خودم گناهی هستم که هیچ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 676.6,
   "end": 679.16,
   "text": "گناهی غیر این گناه نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 679.16,
   "end": 688.98,
   "text": "یا می‌گوید که خود برای خود گناهی است که هیچ گناهی جز این گناه نیست و هر گناهی از همین گناه نشأت می‌گیرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 688.98,
   "end": 692.34,
   "text": "دقت بکنید. چرا من گناه می‌کنم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 692.34,
   "end": 694.1,
   "text": "در مراحلی مختلف؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 694.1,
   "end": 698.42,
   "text": "و چرا شما به ابتلاء گناه می‌کنید در مراحلی مختلف؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 698.42,
   "end": 701.1,
   "text": "و چرا علی سلام الله علیه گناه نمی‌کرد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 701.1,
   "end": 705.38,
   "text": "مایه گناه نبود چون از علی خبری از خود نبود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 705.38,
   "end": 712.06,
   "text": "اون که خبر می‌آورد و به سوی گناه سوق می‌دهد، منشاء گناه می‌شود خودی که نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 712.06,
   "end": 714.12,
   "text": "خودی نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 714.12,
   "end": 717.7,
   "text": "یعنی چه؟ خودی وجود ندارد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 717.7,
   "end": 723.95,
   "text": "اگر خودی رفت و اون حضور حق تعالی پیش آمد، رو میگن سر حضور کلاً غره کرد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 723.95,
   "end": 728.26,
   "text": "انسان در قدرت شد، دیگه اصلاً خبری نیست، رشه اش نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 728.26,
   "end": 731.06,
   "text": "الله ولی الذی گناه من و او عمل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 731.06,
   "end": 733.84,
   "text": "به گناه. مخرجهم من الذنوب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 733.84,
   "end": 736.36,
   "text": "الله ولی الذی نبود،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 736.36,
   "end": 739.62,
   "text": "من بگو، من می‌خوام نبوده، من کی می‌خواد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 739.62,
   "end": 742.46,
   "text": "من می‌خوام نیست. من که دارم می‌خواد نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 742.46,
   "end": 745.04,
   "text": "من کردن نیست، من نکردن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 745.04,
   "end": 749.08,
   "text": "نیست. هرچی می‌خواد همونه. ببین اینجا تو مصداق چه بود؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 749.08,
   "end": 751.72,
   "text": "اینجا اون مایه گناه از میان می‌رود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 751.72,
   "end": 756.28,
   "text": "علی‌رغم اینکه گناه نمی‌کرد چون خودی در اون نبود تا گناه داشته باشد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 756.28,
   "end": 758.16,
   "text": "من گناه می‌کنم، شما گناه می‌کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 758.16,
   "end": 760.72,
   "text": "خود اون مایه گنده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 760.72,
   "end": 766.48,
   "text": "و اون گناه هست دیگه. یعنی خود هرچی خواست میشه گناه دیگه و در مراحل مختلف.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 766.48,
   "end": 769.24,
   "text": "و بعداً خودش اصله گناه‌ها چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 769.24,
   "end": 773.0,
   "text": "اصل گناه‌ها بالاخره منشاء همه گناه‌هاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 773.0,
   "end": 778.52,
   "text": "وجود سرزمین همون خارج از معروفه که گفته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 778.52,
   "end": 784.22,
   "text": "معروف‌هاش گفته که وجود سرزمین ضایع آفرین زمینه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 784.22,
   "end": 786.78,
   "text": "وجود گناه هیچ گناهی قطع نمی‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 786.78,
   "end": 789.54,
   "text": "در آخر غفران خدا با",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 789.54,
   "end": 800.08,
   "text": "اسم غفورش بر کسی تجلی کرد و او با مشهور مغفرتش هست همه چیز را، همه سیئات را، نواقص را، معایب را",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 800.08,
   "end": 806.06,
   "text": "و آن گناهان را در مراحل مختلف نام نشان و حضور که گرفت در آخرینش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 806.06,
   "end": 810.9,
   "text": "نام و نشانی از خود بود که از درود باقیه نذاشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 810.9,
   "end": 818.4,
   "text": "اون رو از خود پاک کرد و به اون دیگه انسان ذکر حق در وجودش تجلی شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 818.4,
   "end": 824.02,
   "text": "اینجا دیگه که اصلاً غفران حق در تو وجود انسان با چی شده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 824.02,
   "end": 826.19,
   "text": "وجود انسان با شانه شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 826.19,
   "end": 832.73,
   "text": "و لذا اینجاست که شما وقتی در دعا می‌کنید می‌گویید که می‌گید استغفار خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 832.73,
   "end": 838.54,
   "text": "تو راجع به خودت به غیر از ذخار بودنش، غیر از ذخر بودنش می‌گویی یا غفران.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 838.54,
   "end": 843.18,
   "text": "اینجا دیگه خود غفران می‌شه رد برای انسان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 843.18,
   "end": 845.2,
   "text": "وجود وجد الرب،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 845.2,
   "end": 848.32,
   "text": "وجد الله وجود انسان را چی می‌کند؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 848.32,
   "end": 851.08,
   "text": "وجود انسان را یعنی گفت چی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 851.08,
   "end": 853.58,
   "text": "می‌کند؟ می‌گیرد. وجودش را از تو می‌کند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 853.58,
   "end": 860.6,
   "text": "و اینجاست که شما می‌گویید که أين وجه الله الذي الیه يتوجه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 860.6,
   "end": 862.13,
   "text": "في دعاء مستجاب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 862.13,
   "end": 863.82,
   "text": "ببین امام زمان اینجوری می‌گویند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 863.82,
   "end": 870.32,
   "text": "غوث علیه أین وجه الله الذي الیه يتوجه العباد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 870.32,
   "end": 872.48,
   "text": "او کجاست؟ این وجه خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}