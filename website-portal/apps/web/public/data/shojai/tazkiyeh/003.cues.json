  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.26,
   "end": 3.5,
   "text": "اعوذ بالله السميع العليم من الشيطان الرجيم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 3.5,
   "end": 6.26,
   "text": "بسم الله الرحمن الرحيم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 6.26,
   "end": 10.4,
   "text": "گفتیم در جلسه گذشته انسان در تنزلش از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 10.4,
   "end": 20.86,
   "text": "مراتب بالاتر وجود به تدریج با گذر از عوالم آمده و در مرتبه ادنای وجود که وجود دنیوی‌اش است قرار گرفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 20.86,
   "end": 28.22,
   "text": "به همین نحو هم از مراتب حیات تنزل کرده و در مرحله حیات نازل قرار گرفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 28.22,
   "end": 33.16,
   "text": "این حیات نازل که حیات دنیوی است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 33.16,
   "end": 35.86,
   "text": "آخرین مرحله از حیات است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 35.86,
   "end": 43.12,
   "text": "انسان در برگشتش که در تزکیه مطرح می‌کنیم، در برگشتش به سوی حق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 43.12,
   "end": 45.1,
   "text": "و در سیر صعودیش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 45.1,
   "end": 48.46,
   "text": "که در قوس صعود قرار می‌گیرد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 48.46,
   "end": 55.06,
   "text": "همین مراطبی را که در نزول و در مقام تنزل از دست داده است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 55.06,
   "end": 59.36,
   "text": "باید به دست بیاورد و به دست می‌آورد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 59.36,
   "end": 66.78,
   "text": "در تزکیه یعنی در برگشت و صعود الی الله و در عروج الی الله و در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 66.78,
   "end": 72.36,
   "text": "سیر الی الله. انسانی که در مرتبه پایین‌تر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 72.36,
   "end": 80.2,
   "text": "وجود دنیوی و حیات دنیوی قرار گرفته از این مرتبه دوباره شروع به توبه می‌کند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 80.2,
   "end": 83.04,
   "text": "توبه یعنی برگشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 83.04,
   "end": 95.62,
   "text": "برگشت می‌کند و همان منازلی را که در موقع آمدن پشت سر گذاشته در موقع برگشت هم همان منازل را طی می‌کند،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 95.62,
   "end": 101.26,
   "text": "بر می‌گردد. متوجه هستید راه برگشت همیشه راه، از همان راهی است که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 101.26,
   "end": 104.4,
   "text": "موجود در نظام وجود در مقام تنزل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 104.4,
   "end": 115.6,
   "text": "پایین آمده است و لذا هم اینم توجه بکنیم به این نکته هم که برگشت می‌گیم، رجعت می‌گیم، رجوع می‌گیم، صعود می‌گیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 115.6,
   "end": 120.64,
   "text": "این تعبیرات معمولاً اونجاست که تنزلی بوده که این تعبیر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 120.64,
   "end": 128.04,
   "text": "می‌شود. هفته گذشته بعد از اینکه این قسمت گفته شد، من یه مقدار تصویر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 128.04,
   "end": 136.26,
   "text": "این مراحلی را که در سیر صعودی و در تزکیه و خودسازی انسان از مرحله حیات دنیا بالا می‌رود،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 136.26,
   "end": 140.5,
   "text": "این مراحل چیست؟ اون را یه مقدار من تشریح کردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 140.5,
   "end": 151.34,
   "text": "نظرتون هست که گفتم که بعد از اینکه انسان به صعود شروع کرد، به سیر شروع کرد، به تزکیه پرداخت، از حیات دنیوی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 151.34,
   "end": 156.84,
   "text": "می‌رود بالا. و در این زمینه آیات هم خوندیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 156.84,
   "end": 163.18,
   "text": "از حیات دنیوی قدم می‌گذارد در مرحله بالاتر حیات دنیا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 163.18,
   "end": 165.5,
   "text": "که حیات برزخی است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 165.5,
   "end": 171.96,
   "text": "بعد از حیات دنیا. در صعود همان که در نزول از آن طرف که می‌آمدیم هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 171.96,
   "end": 176.04,
   "text": "برزخی آخرین مرحله بود قبل از دنیا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 176.04,
   "end": 183.18,
   "text": "در مقام صعود انسان از حیات دنیا که منصرف شد از حیات دنیا که مرد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 183.18,
   "end": 190.28,
   "text": "به اصطلاح مرگ با مرگ ارادی و با مرگ اختیاری به حیات برزخی وارد می‌شود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 190.28,
   "end": 198.92,
   "text": "از حیات برزخی هم که انسان منصرف شد در صعود و به صعود و سیرش ادامه داد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 198.92,
   "end": 205.96,
   "text": "با حیات عقلانی و حیات نوری و بالاتر و جبروتی به اصطلاح",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 205.96,
   "end": 212.26,
   "text": "یا ملأ الشیخ أعلا زنده می‌شود و همینطور مراتب حیات را می‌رود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 212.26,
   "end": 215.44,
   "text": "بعد از اونش می‌شود حیات به حیات حق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 215.44,
   "end": 220.5,
   "text": "در این تقسیم‌بندی کلی بعد از حیات دنیا، حیات برزخی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 220.5,
   "end": 224.94,
   "text": "است. بعد از حیات برزخی در صعود عرض می‌کنم حیات عقلانی است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 224.94,
   "end": 232.09,
   "text": "بعد از حیات عقلانی که مرحله فنا پیش می‌آید و فنا حیات به حیات حق است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 232.09,
   "end": 236.3,
   "text": "دیگه حیات استقلالی نیست بعد از فناست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 236.3,
   "end": 239.36,
   "text": "البته قبل از اونم حیات استقلالی نبود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 239.36,
   "end": 245.12,
   "text": "یعنی حیات بالاتر که حیات انسان به حیات حق است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 245.12,
   "end": 253.22,
   "text": "خب و در این تشریح یه مقدار من مفصل مطالب گفتم، آیاتی خوندم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 253.22,
   "end": 263.96,
   "text": "تقریباً این نتیجه را گرفتیم که انسان در تزکیه باید از مرحله حیات دنیا منصرف باشد و به سوی حیات‌های بالاتر بره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 263.96,
   "end": 270.34,
   "text": "البته مقصود نه این است که به سوی حیات‌های بالاتر برود و به حیات‌های بالاتر برسد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 270.34,
   "end": 281.68,
   "text": "مقصود سالک خداست. اما نتیجه این صعود یا لازمه تحریق این صعود این است که انسان از حیات دنیا منصرف می‌شود،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 281.68,
   "end": 288.48,
   "text": "با حیات برزخی زنده و سپس حیات عقلانی و سپس حیات به حیات حق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 288.48,
   "end": 292.1,
   "text": "البته این تقسیم‌بندی کلی بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 292.1,
   "end": 297.42,
   "text": "سالک نظرش خداست اما در برگشتش این مراتب حیات را بالا می‌برد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 297.42,
   "end": 303.58,
   "text": "چون این مراتب حیات را بالا می‌برد از حیات دنیا منصرف می‌شود، با حیات برزخی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 303.58,
   "end": 307.07,
   "text": "یا حیات‌های برزخی حیات پیدا می‌کند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 307.07,
   "end": 313.24,
   "text": "در رنگ آثاری در وجودش مشهود می‌گردد که مشروحاً گفتم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 313.24,
   "end": 316.24,
   "text": "چیزهایی می‌بیند اصطلاحاً که دیگران نمی‌بینند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 316.24,
   "end": 318.1,
   "text": "می‌شنود که نمی‌شنوند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 318.1,
   "end": 319.62,
   "text": "می‌یابد که نمی‌یابند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 319.62,
   "end": 322.02,
   "text": "می‌تواند که نمی‌توانند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 322.02,
   "end": 324.4,
   "text": "هرچه حیات بالاتر برود،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 324.4,
   "end": 326.88,
   "text": "قدرت و اراده از یک طرف،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 326.88,
   "end": 335.6,
   "text": "علم و شعور از یک طرف دیگر که دو اثر از آثار وارده حیات است در وجود انسان کامل می‌شود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 335.6,
   "end": 343.5,
   "text": "هرچه انسان حیاتش کامل‌تر بود، آثار حیاتش هم کامل‌تر می‌شود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 343.5,
   "end": 348.18,
   "text": "در صعود که شروع کرد آثار مخصوصی در وجودش پیدا می‌شود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 348.18,
   "end": 354.96,
   "text": "آثار حیات است. دید‌های بالاتر، توانستن‌های بالاتر، قدرت اراده‌های بالاتر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 354.96,
   "end": 358.9,
   "text": "هرچه بالا برود این‌ها هم کامل‌تر می‌شود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 358.9,
   "end": 361.06,
   "text": "و از این نظر است گفتیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 361.06,
   "end": 364.7,
   "text": "برای سالک این مسئله کشف و شهود،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 364.7,
   "end": 368.94,
   "text": "اون وقتی که انصراف از حیات دنیا شروع می‌شود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 368.94,
   "end": 372.54,
   "text": "شروع می‌کردند. کشف و شهود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 372.54,
   "end": 382.82,
   "text": "و یعنی به این معنا ادراکات فوق‌العاده در وجود انسان بروز کردن و اراده‌ها و قدرت‌های بالاتر در وجود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 382.82,
   "end": 392.5,
   "text": "انسان پیدا شدن. حیات دنیا که یواش یواش از بین میره، یعنی مبدل میشه یا تکامل پیدا می‌کنه به حیات برزخی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 392.5,
   "end": 395.82,
   "text": "مشاعر برزخی انسان به کار می‌افتد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 395.82,
   "end": 398.62,
   "text": "ادراکات برزخی به کار می‌افتد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 398.62,
   "end": 402.92,
   "text": "کما اینکه قدرت و اراده بیشتری هم پیدا می‌کند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 402.92,
   "end": 408.06,
   "text": "از برزخ گذشت به بالاتر با حیات عقلانی وقتی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 408.06,
   "end": 411.1,
   "text": "زنده شد، حیات پیدا کرد، مشاعر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 411.1,
   "end": 420.6,
   "text": "بالاتر به اصطلاح متناسب با اون حیات در وجود انسان و ادراکات بالاتر بروز می‌کند و به اصطلاح مکاشفات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 420.6,
   "end": 423.44,
   "text": "و مشاهدات بالاتر پیش میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 423.44,
   "end": 426.68,
   "text": "اینا از آثار این شهود و آثار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 426.68,
   "end": 428.24,
   "text": "طی این مدارج حیات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 428.24,
   "end": 431.06,
   "text": "بالاخره روشن شد که باید از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 431.06,
   "end": 442.64,
   "text": "راهی که آمده‌ایم برگردیم و شروع باید شد از حیات دنیاوی دست برداشتن با موت ارادی به سوی حیات‌های بالاتر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 442.64,
   "end": 445.38,
   "text": "البته مقصد هم خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 445.38,
   "end": 452.32,
   "text": "می‌خواستم اینو عرض بکنم الا اینکه به نظرم آمد که یه مقدار باید مسئله از نظر این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 452.32,
   "end": 459.48,
   "text": "حالا بحثی اینجا ها منجر شده باید مسئله در این جلسه حداقل به صورت به اندازه یک جلسه بیشتر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 459.48,
   "end": 463.52,
   "text": "با نمونه‌های عینی تأیید بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 463.52,
   "end": 465.26,
   "text": "البته آیات خوندم من.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 465.26,
   "end": 469.18,
   "text": "آیاتی خوندم و بعد از اینکه تشریح را عرض کردم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 469.18,
   "end": 474.68,
   "text": "بعد از اتمام تشریح پرداختیم به آیات چون اصل آیات و روایات هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 474.68,
   "end": 483.52,
   "text": "ما دام که چیزی با آیات و روایات برای ما تأیید نشده، هر قدر هم برهان عقلی محکم باشد چندان برای ما دلچسب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 483.52,
   "end": 488.26,
   "text": "نیست و اصل موضوع استناد از آیات و روایات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 488.26,
   "end": 489.56,
   "text": "خب آیات و روایات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 489.56,
   "end": 499.04,
   "text": "هم تأیید می‌کند که این چنین حیاتی برای سالکین و حیات‌هایی برای سالکین شروع می‌شود که از حیات دنیا می‌میرند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 499.04,
   "end": 504.32,
   "text": "با حیات بالاتر، حیات‌های بالاتر حیات پیدا می‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 504.32,
   "end": 507.86,
   "text": "اما نمونه‌های عینی خوب انشاالله این هفته تأمل فرمایید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 507.86,
   "end": 511.18,
   "text": "ما در نمونه‌های عینی صحبت می‌کنیم تا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 511.18,
   "end": 515.52,
   "text": "که از آیات و روایات استفاده می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 515.52,
   "end": 517.18,
   "text": "به چه معنا نمونه‌های عینی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 517.18,
   "end": 521.74,
   "text": "به این معنا که ببین ما حالا قرآن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 521.74,
   "end": 525.22,
   "text": "و روایات، کتاب و سنت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 525.22,
   "end": 533.78,
   "text": "از کتاب و سنت و از قرآن و روایات نمونه‌هایی داشته‌ایم از انسان‌ها که کتاب دلالت بر این معنا می‌کند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 533.78,
   "end": 536.42,
   "text": "نمونه‌هایی داشته باشیم که اون‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 536.42,
   "end": 539.1,
   "text": "همین راه را به همین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 539.1,
   "end": 546.52,
   "text": "بیانی که گفتیم پیش بروند و از حیات دنیا به سوی حیات‌های بالاتر بروند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 546.52,
   "end": 552.9,
   "text": "و، و به حساب اون آثار که مشروحاً گفتیم در وجود اون‌ها پیاده بشود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 552.9,
   "end": 557.14,
   "text": "آیا این از آیات قرآن و روایات استفاده می‌شود یا نه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 557.14,
   "end": 560.84,
   "text": "اونم نه تأیید و نمونه‌های عینی یا تأیید از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 560.84,
   "end": 562.94,
   "text": "ناحیه بعضی از جهت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 562.94,
   "end": 565.32,
   "text": "به اصطلاح بعضی از قضايا و داستان‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 565.32,
   "end": 570.5,
   "text": "گفتم از قرآن و از روایات معتبری که می‌شود روش استناد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 570.5,
   "end": 574.36,
   "text": "بله خب ما اگر به سراغ قرآن بریم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 574.36,
   "end": 580.48,
   "text": "در قرآن تأمل کنیم، در صراحت‌های قرآن و در اشارات‌های قرآن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 580.48,
   "end": 586.36,
   "text": "البته اینو تکرار عرض کردم که نباید در همیشه در صراحت‌های قرآن اکتفا بکنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 586.36,
   "end": 590.56,
   "text": "قرآن اشاراتی هم دارد که اون‌ها را نباید نادیده بگیریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 590.56,
   "end": 595.72,
   "text": "اگر صراحت‌های قرآن و اشارات‌های قرآن را در نظر بگیریم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 595.72,
   "end": 603.24,
   "text": "مسلماً نمونه‌های عینی زیادی قرآن بیان می‌کند از این مسئله که انسان‌هایی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 603.24,
   "end": 605.52,
   "text": "حالا چه از انبیا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 605.52,
   "end": 610.04,
   "text": "چه از اولیا، چه از افراد عادی کاری نداریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 610.04,
   "end": 616.6,
   "text": "فقط انسان باشد و این راه را این چنین که نتیجه می‌گیریم پیش برود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 616.6,
   "end": 619.18,
   "text": "و نمونه‌های عینی را قرآن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 619.18,
   "end": 623.22,
   "text": "از به اصطلاح اون‌ها که این راه را رفتند و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 623.22,
   "end": 627.96,
   "text": "از حیات‌های بالاتر برخوردار شده‌اند و اون آثار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 627.96,
   "end": 633.38,
   "text": "ادراکات فوق‌العاده در وجودشون و اراده‌های فوق‌العاده در وجودشون پیاده شده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 633.38,
   "end": 637.74,
   "text": "قرآن از این‌ها به ما گفته باشد از انسانی که این چنین باشد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 637.74,
   "end": 642.16,
   "text": "روایات هم همچنین. بله هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 642.16,
   "end": 645.16,
   "text": "هست یعنی از آیات قرآن زیاد استفاده می‌شود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 645.16,
   "end": 650.3,
   "text": "البته من فقط نمونه خواهم گفت و این نمونه‌های گفته‌ام خود شما اگر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 650.3,
   "end": 652.04,
   "text": "انشاالله که از اهل تفکر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 652.04,
   "end": 659.04,
   "text": "و توأم با ذوق هستید که خودتون دیگه از صراحت‌ها و اشارات‌های قرآن بیشتر می‌توانید استفاده کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 659.04,
   "end": 662.34,
   "text": "از روایات هم نمونه‌هایی خواهم گفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 662.34,
   "end": 664.56,
   "text": "نمونه‌های عینی از این مسئله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 664.56,
   "end": 669.0,
   "text": "اول به سراغ آیات قرآن می‌روم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 669.0,
   "end": 675.34,
   "text": "آیا از آیات قرآن این معنا استفاده می‌شود نمونه‌های عینی داشته؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 675.34,
   "end": 679.66,
   "text": "قرآن البته اونچه که قرآن بیان می‌فرماید باز،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 679.66,
   "end": 682.82,
   "text": "اونچه که قرآن بیان می‌فرماید باز،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 682.82,
   "end": 688.72,
   "text": "اگر دقت بکنیم یک قسمت از بیانات قرآن یعنی نمونه‌هایی که از اون‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 688.72,
   "end": 694.88,
   "text": "به دست می‌آید و بیان می‌کنه از انبیا بودند فرقی نمی‌کند بالاخره انسان بودند و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 694.88,
   "end": 701.96,
   "text": "این راه را این چنین رفتند و از حیات بالاتر برخوردار شدند، اون آثار هم در حضورشان بوده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 701.96,
   "end": 705.06,
   "text": "و اوائل دیگه اشراق پیدا کردند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 705.06,
   "end": 709.66,
   "text": "چون در اوائل دیگه بودند، در حیات‌های بالاتر بودند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 709.66,
   "end": 712.36,
   "text": "بعضی از بیانات قرآن خودش از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 712.36,
   "end": 719.22,
   "text": "نه تنها به انبیا را می‌گه، اصلاً از این می‌رساند بیان که از انسان‌های دیگه هم این چنین می‌شوند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 719.22,
   "end": 721.94,
   "text": "منتها مدارج و مراتب هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 721.94,
   "end": 725.2,
   "text": "در جای خود محفوظ است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 725.2,
   "end": 727.42,
   "text": "اولین آیه‌ای که ما در اینجا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 727.42,
   "end": 731.68,
   "text": "می‌خوانیم عرض کنم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 731.68,
   "end": 736.32,
   "text": "اولین آیه من برای شما اینجا به عنوان نمونه می‌خوانم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 736.32,
   "end": 740.74,
   "text": "آیه‌ای سر خصوص حضرت ابراهیم سلام الله عليه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 740.74,
   "end": 745.56,
   "text": "یک انسان کامل، یک موحد کامل بوده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 745.56,
   "end": 753.94,
   "text": "البته در حد خودش. یعنی که میگیم کامل بوده خب اینا رو میداند دیگه توضیح احتیاج نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 753.94,
   "end": 758.2,
   "text": "نسبت به بعضی مانند رسول اکرم صلوات الله عليه پایین‌تر بوده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 758.2,
   "end": 761.28,
   "text": "اما خب در حد خودش از اون موحدین بالاتر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 761.28,
   "end": 765.06,
   "text": "قرآن درباره ابراهیم سلام الله عليه این چنین آیه دارد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 765.06,
   "end": 768.4,
   "text": "آیه هفتاد و شش سوره انعام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 768.4,
   "end": 771.44,
   "text": "«و کذلک نری ابراهیم»",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 771.44,
   "end": 773.34,
   "text": "هفتاد و شش سوره انعام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 773.34,
   "end": 781.02,
   "text": "به قول هفتاد و پنج چون این تعداد عدد آیات یه مقدار 가وه اختلاف هست در این عدد آیات یعنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 781.02,
   "end": 783.62,
   "text": "هفتاد و شش باشه، هفتاد و پنج.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 783.62,
   "end": 788.78,
   "text": "هفتاد و پنج مثلاً به موجه نگاه کنید هفتاد و پنج می‌نویسند ولی من به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 788.78,
   "end": 793.29,
   "text": "قرآنی که مراجعه کردم، اون قرآنی که من مراجعه کردم هفتاد و شش بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 793.29,
   "end": 795.85,
   "text": "«و کذلک» در آیه دقت کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 795.85,
   "end": 802.9,
   "text": "«و کذلک نری ابراهیم ملكوت السماوات والأرض",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 802.9,
   "end": 805.92,
   "text": "لیكون من الموقنین».",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 805.92,
   "end": 809.22,
   "text": "و این چنین. حالا ترجمه ساده‌ش اینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 809.22,
   "end": 814.78,
   "text": "این چنین ما نشان می‌دهیم، ارائه می‌کنیم به ابراهیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 814.78,
   "end": 818.44,
   "text": "ملكوت آسمان‌ها و زمین را.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 818.44,
   "end": 820.54,
   "text": "بعد اینجا ساکت می‌مونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 820.54,
   "end": 823.84,
   "text": "برای چی؟ انشاالله اهل ادب می‌فهمن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 823.84,
   "end": 827.98,
   "text": "یه باب آصفه آورده بدون اینکه مفعول علیهش باشد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 827.98,
   "end": 831.1,
   "text": "این یکی از اون جاهایی‌ست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 831.1,
   "end": 833.2,
   "text": "که مطلب گفتنی نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 833.2,
   "end": 837.96,
   "text": "نمی‌شود گفت. به زبان نمی‌شود آورد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 837.96,
   "end": 843.72,
   "text": "یا مطلب خیلی بالاست یا مستمع ظرفیتش را ندارد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 843.72,
   "end": 847.44,
   "text": "یا هر دو به یک جا بر می‌گردد و فرقی نمی‌کند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 847.44,
   "end": 850.62,
   "text": "ترجمه می‌کنیم. گفته نمی‌شود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 850.62,
   "end": 852.98,
   "text": "اما یه قسمت گفته می‌شود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 852.98,
   "end": 857.62,
   "text": "اینطور ببینید. میگه این چنین نشان می‌دهیم به ابراهیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 857.62,
   "end": 864.98,
   "text": "و این چنین ارائه می‌کنیم به ابراهیم ملكوت آسمان‌ها و زمین را.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 864.98,
   "end": 871.24,
   "text": "خب برای چی؟ اینجا س-سکوت بعد میگه و برای اینکه از موقنین باشد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 871.24,
   "end": 881.56,
   "text": "این و مانند چیزهایی گفت و بعد این با و اثر می‌کنه به چیزهایی گفته ولی نگفته یعنی در تقدیر است به اصطلاح.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 881.56,
   "end": 887.68,
   "text": "به قول آیت الله العظمی زانوی الله ایشون می‌فرمایند این جوره «و کذلک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 887.68,
   "end": 896.1,
   "text": "نری ابراهیم ملكوت السماوات والأرض لیكون کذا و کذا و لیكون من الموقنین»",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 896.1,
   "end": 900.6,
   "text": "تا این چنین باشد و آن چنان باشد و از موقنین باشد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 900.6,
   "end": 905.52,
   "text": "یک دفعه گفته و از موقنین باشد و از موقنین نه اینکه از موقنین باشد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 905.52,
   "end": 911.58,
   "text": "در هر صورت صحبت در این است که این ارائه ملكوت که اینجا به عنوان یک نمونه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 911.58,
   "end": 915.1,
   "text": "از ابراهیم بیان می‌شه. ارائه ملكوت چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 915.1,
   "end": 921.26,
   "text": "ملكوت این آسمان‌ها و این زمین را ما ارائه کردیم به کی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 921.26,
   "end": 927.98,
   "text": "به ابراهیم. خب ملكوت آسمان و زمین بالاخره خود آسمان و زمین است یا غیرش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 927.98,
   "end": 932.26,
   "text": "است؟ می‌گفتی غیرش این روشن که غیر آسمان و زمین است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 932.26,
   "end": 935.42,
   "text": "خود آسمان و زمین رو میگن آسمان و زمین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 935.42,
   "end": 938.14,
   "text": "ملكوت آسمان و زمین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 938.14,
   "end": 939.94,
   "text": "غیر این آسمان و زمین است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 939.94,
   "end": 943.57,
   "text": "صورت‌های بالاتر این آسمان‌ها و زمین است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 943.57,
   "end": 946.78,
   "text": "صورت‌های امر الهی این‌هاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 946.78,
   "end": 952.78,
   "text": "صورت‌های بالاترش که این صورت فعلی‌اش از اونجا نشأت می‌گیرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 952.78,
   "end": 959.64,
   "text": "چهره‌های باطنی این آسمان و زمین و خلاصه عوالم بالا که این آسمان و زمین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 959.64,
   "end": 962.4,
   "text": "اونجا صورت‌های بالاتر دارد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 962.4,
   "end": 965.38,
   "text": "آسمان‌ها ملكوتش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 965.38,
   "end": 971.32,
   "text": "در سوره یاسین یادتون باشه اگه خواستید از ملكوت یه مقدار توجه داشته باشید ملكوت چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 971.32,
   "end": 978.68,
   "text": "در سوره یاسین می‌فرماید «إنما أمره إذا أراد شيئا أن يقول له كن فيكون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 978.68,
   "end": 981.94,
   "text": "فسبحان الذي بيده ملكوت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 981.94,
   "end": 984.28,
   "text": "كل شيء وإليه ترجعون».",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 984.28,
   "end": 987.48,
   "text": "اول عالم امر را عنوان می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 987.48,
   "end": 990.44,
   "text": "بعد دنبالش می‌فرماید «فسبحان الذي»",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 990.44,
   "end": 995.94,
   "text": "پس خدا منزه است. اون خدایی که «بيده ملكوت كل شيء»",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 995.94,
   "end": 998.54,
   "text": "ملكوت هر چیز به دست اوست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 998.54,
   "end": 1002.62,
   "text": "چون بعد از آیه امر آورده معلوم می‌شود که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 1002.62,
   "end": 1009.52,
   "text": "ملكوت عبارت است از اون عالم امر که این موجودات صورت‌های بالاترش اونجاست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 1009.52,
   "end": 1013.84,
   "text": "و صورت‌های اینجاییش تنزل یافته است صورت‌های",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 1013.84,
   "end": 1021.7,
   "text": "اونجاییش. و از این سوره یاسین، آیه سوره یاسین این هم استفاده می‌شود که برای هر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 1021.7,
   "end": 1025.26,
   "text": "چیزی بدون استثناء یک صورت چی هست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 1025.26,
   "end": 1029.43,
   "text": "صورت ملکوتی هست یا یک ملكوتی هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 1029.43,
   "end": 1032.16,
   "text": "«ملكوت كل شيء».",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 1032.16,
   "end": 1038.48,
   "text": "ابراهیم اون صورت بالاتر همه موجودات را بهش نشان دادیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 1038.48,
   "end": 1040.94,
   "text": "حالا شما باشید نشان دادیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 1040.94,
   "end": 1043.94,
   "text": "ارائه کردیم یعنی اونم رؤیت کرد یا نه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 214,
   "start": 1043.94,
   "end": 1046.34,
   "text": "اون هم رؤیت کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 215,
   "start": 1046.34,
   "end": 1048.46,
   "text": "اون هم شاهد گشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 216,
   "start": 1048.46,
   "end": 1052.14,
   "text": "خب شاهد گشتن ابراهیم عوالم بالاتر را",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 217,
   "start": 1052.14,
   "end": 1058.5,
   "text": "آیا معنیش غیر از این است که ابراهیم در اون عوالم بالاتر قرار گرفت؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 218,
   "start": 1058.5,
   "end": 1062.36,
   "text": "غیر از این معنی ندارد. در اون عوالم بالاتر قرار گرفت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 219,
   "start": 1062.36,
   "end": 1066.48,
   "text": "شاهد شد و دید عوالم بالاتر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 220,
   "start": 1066.48,
   "end": 1073.96,
   "text": "را. این دیدن و این شاهد گشتن که نتیجه ارائه حق است رؤیت ابراهیم، شهود ابراهیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 221,
   "start": 1073.96,
   "end": 1080.28,
   "text": "در عوالم بالا را با قرار گرفتن ابراهیم در عوالم بالا دو مطلب نیست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 222,
   "start": 1080.28,
   "end": 1085.68,
   "text": "در عوالم بالا. این یک نمونه کاملاً روشنی‌ست که ابراهیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 223,
   "start": 1085.68,
   "end": 1093.24,
   "text": "از حیات بالاتر برخوردار بوده که از رؤیت و ادراک و شهود بالاتر هم که گشته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 224,
   "start": 1093.24,
   "end": 1096.07,
   "text": "برخوردار گشته. نمونه عینی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 225,
   "start": 1096.07,
   "end": 1099.45,
   "text": "این حیات دنیوی همین جا را به ما نشان میدهد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 226,
   "start": 1099.45,
   "end": 1102.95,
   "text": "حیات دنیوی همه که من و شما الان داریم دیگه حیات دنیا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 227,
   "start": 1102.95,
   "end": 1110.19,
   "text": "مشاعر و ادراکاتش حدودش همین‌هاست و این آسمان‌ها و زمین را در همین حدی که می‌تواند شاهد می‌گردد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 228,
   "start": 1110.19,
   "end": 1115.13,
   "text": "اما جنبه‌های پنهی این‌ها را که صورت‌های باطنی این‌هاست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 229,
   "start": 1115.13,
   "end": 1120.95,
   "text": "این حیات دنیوی نمی‌تواند انسان را به آنها ناظر و شاهد بکند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 230,
   "start": 1120.95,
   "end": 1126.15,
   "text": "اینکه شاهد آنها بوده از حیات بالاتر برخوردار بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 231,
   "start": 1126.15,
   "end": 1130.25,
   "text": "در این زمینه من یک روایت می‌خوانم در شرح این آیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 232,
   "start": 1130.25,
   "end": 1134.57,
   "text": "دقت کنید که روایت عجیب روایتی‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 233,
   "start": 1134.57,
   "end": 1142.77,
   "text": "روایتی‌ست که از بسائر و درجات نقل می‌کنم در زمینه این آیه است و جریان حضرت ابراهیم سلام الله علیه هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 234,
   "start": 1142.77,
   "end": 1146.93,
   "text": "که حالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 235,
   "start": 1146.93,
   "end": 1149.37,
   "text": "ببینم شما در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 236,
   "start": 1149.37,
   "end": 1151.04,
   "text": "درس‌های گذشته را خوب یاد گرفتید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 237,
   "start": 1151.04,
   "end": 1160.03,
   "text": "ابراهیم سلام الله وقتی که می‌دید ملکوط را در کجای این عالم می‌دید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 238,
   "start": 1160.03,
   "end": 1161.73,
   "text": "اگر گفتی کجاش؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 239,
   "start": 1161.73,
   "end": 1163.75,
   "text": "در کدام جهتش؟ کدام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 240,
   "start": 1163.75,
   "end": 1170.05,
   "text": "سمت؟ به طرف زمین، به طرف هوا، فضا، کجاست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 241,
   "start": 1170.05,
   "end": 1172.23,
   "text": "بالای آسمون، کرات بالا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 242,
   "start": 1172.23,
   "end": 1181.11,
   "text": "نه گفتیم که ملکوط اگر ملکوط بالاتر منظور باشد که ملکوط اعلی و تجرد این‌ها دیگه بالا و پایین و اینجا و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 243,
   "start": 1181.11,
   "end": 1182.91,
   "text": "اینجا ندارد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 244,
   "start": 1182.91,
   "end": 1184.89,
   "text": "نه اشاره این همه‌جاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 245,
   "start": 1184.89,
   "end": 1190.45,
   "text": "عرض می‌کنم رسول اکرم صلی الله علیه کلمات قرآن را موقع وحی از کجا می‌شنید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 246,
   "start": 1190.45,
   "end": 1193.11,
   "text": "از همه جا. این محیط",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 247,
   "start": 1193.11,
   "end": 1196.79,
   "text": "ابوالملکوط بالا محیط باطنه، محیطه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 248,
   "start": 1196.79,
   "end": 1199.37,
   "text": "حقیقت هم اون‌هاست. البته این صورتی‌ست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 249,
   "start": 1199.37,
   "end": 1202.77,
   "text": "از این صورت انسان در حیات بالاتر اینجوری‌ست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 250,
   "start": 1202.77,
   "end": 1206.89,
   "text": "ها. یه خورده از این صورت تفتل می‌کنه مثل اینجا تفتل می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 251,
   "start": 1206.89,
   "end": 1214.71,
   "text": "مانند سرابی‌ست که یک دفعه این سراب برطرف می‌شه و حقیقت پشت این سراب چی می‌کنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 252,
   "start": 1214.71,
   "end": 1216.39,
   "text": "واضح می‌گردد. اون ملکوط.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 253,
   "start": 1216.39,
   "end": 1219.45,
   "text": "البته ملکوط هم دیگه اینا رو توضیح نمی‌دم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 254,
   "start": 1219.45,
   "end": 1221.71,
   "text": "متوجه شدین که ملکوط مراتب دارد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 255,
   "start": 1221.71,
   "end": 1224.31,
   "text": "ملکوط اسفل و ملکوط",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 256,
   "start": 1224.31,
   "end": 1227.89,
   "text": "اعلی. مراتب دارد ملکوط.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 257,
   "start": 1227.89,
   "end": 1232.15,
   "text": "به اصطلاح کسانی که می‌بینند البته اونا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 258,
   "start": 1232.15,
   "end": 1234.86,
   "text": "انسان تا نبیند نمی‌داند چطور می‌بینند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 259,
   "start": 1234.86,
   "end": 1240.91,
   "text": "ولی کسانی که می‌بینند از بیانات و اشارات و نکات و گفته‌های،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 260,
   "start": 1240.91,
   "end": 1244.71,
   "text": "از بیانات خود قرآن و روایات و گفته‌های",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 261,
   "start": 1244.71,
   "end": 1251.19,
   "text": "اهل باطن و اهل دقت و اهل بصيرت در مجموع اینجور می‌شود نتیجه گرفت که،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 262,
   "start": 1251.19,
   "end": 1258.37,
   "text": "که به اصطلاح یه پرده‌ها که کنار میره، پرده‌ها کنار می‌رود همه جا انسان ملکوط را",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 263,
   "start": 1258.37,
   "end": 1260.21,
   "text": "می‌بیند. این سراب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 264,
   "start": 1260.21,
   "end": 1263.69,
   "text": "کنار میره، حقیقت پشت سراب واضح می‌گردد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}