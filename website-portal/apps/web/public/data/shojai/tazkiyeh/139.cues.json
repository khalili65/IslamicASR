  {
   "index": 2,
   "title": "## سلام بر رسول‌الله و بوی دهان",
   "start": 272.04,
   "end": 424.0
  },
  {
   "index": 3,
   "title": "بعضی دوستان و خانم‌ها که نشسته‌اید دعا بکنید. دعا بکنید این آیه را هم دیگر فراموش نکنید:",
   "start": 424.0,
   "end": 500.42
  },
  {
   "index": 4,
   "title": "## استشمام رسول‌الله از حضرت زهرا؛ پوشاندن بو",
   "start": 500.42,
   "end": 654.52
  },
  {
   "index": 5,
   "title": "## تنوع بوهای بد؛ صفات جهنمی؛ تمثیل پیاز",
   "start": 654.52,
   "end": 889.4
  },
  {
   "index": 6,
   "title": "## جمع‌بندی کشف شمی و دعای برخورداری",
   "start": 889.4,
   "end": 1008.52
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 1.0,
   "end": 4.1,
   "text": "اعوذ بالله السميع العليم من الشيطان الرجيم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 4.1,
   "end": 6.5,
   "text": "بسم الله الرحمن الرحيم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 6.5,
   "end": 15.68,
   "text": "عرض کنم که. حضرات یا چیزهایی، پدیده هایی در اینجا هست که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 15.68,
   "end": 21.76,
   "text": "گفته بشه من و شما توی خودمون بیاییم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 21.76,
   "end": 25.6,
   "text": "خب با این بیانی که عرض کردم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 25.6,
   "end": 30.08,
   "text": "اونها که شامه دارن در این عالم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 30.08,
   "end": 38.74,
   "text": "از رسول اکرم صلی الله علیه و آله و سلم مانند من و شما هستند و همچنین مانند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 38.74,
   "end": 41.98,
   "text": "حضرات معصومین صلوات الله علیهم اجمعین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 41.98,
   "end": 45.48,
   "text": "و مانند ملائکه الهی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 45.48,
   "end": 51.38,
   "text": "و بالاتر از همه اینها اون خدا که این روایح بد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 51.38,
   "end": 57.56,
   "text": "را از من و شما از دم من و شما از نفس من و شما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 57.56,
   "end": 60.0,
   "text": "به اصطلاح می یابند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 60.0,
   "end": 62.96,
   "text": "شما منصفانه بگید اون وقت من و شما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 62.96,
   "end": 69.78,
   "text": "دهان به دعا باز می‌کنیم اگر دم دمی باشد که همه چیز را به فرار وادار بکنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 69.78,
   "end": 75.28,
   "text": "دعاش چه جوری میشه؟ توجه بکنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 75.28,
   "end": 77.64,
   "text": "آقا اینا حرف هست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 77.64,
   "end": 80.98,
   "text": "گاهی خودم میگم خدایا اینا حرف هست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 80.98,
   "end": 85.82,
   "text": "حقیقت است؟ البته حقیقت است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 85.82,
   "end": 88.32,
   "text": "اما ما خیلی هیچی نمی‌دانیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 88.32,
   "end": 91.18,
   "text": "اون جای بسیار تاسف است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 91.18,
   "end": 98.4,
   "text": "خب شما شنیده‌اید کسی که گناهکار است وقتی دهنش رو باز می‌کند دعا بکند دعاش چه میشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 98.4,
   "end": 102.48,
   "text": "چه میشه؟ به اجابت نمی‌رسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 102.48,
   "end": 105.02,
   "text": "گفتم در دعا دم پاک می‌خواد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 105.02,
   "end": 109.6,
   "text": "اینا یک قسمتش مربوط به دهن ما وقتی که روزه داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 109.6,
   "end": 113.32,
   "text": "گفتم در دعا و اجابت دعا دم پاک می‌خواد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 113.32,
   "end": 115.05,
   "text": "نفس پاک می‌خواد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 115.05,
   "end": 119.12,
   "text": "اون نفس که میاد رائحه خوب داشته باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 119.12,
   "end": 121.6,
   "text": "همه از انسان فرار نکنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 121.6,
   "end": 126.39,
   "text": "خدا که دور باشیم، ملائکه، رسول، ائمه همه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 126.39,
   "end": 129.66,
   "text": "هیچکس اصلاً جرات دم نکنه نزدیک بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 129.66,
   "end": 136.36,
   "text": "توجه بکنید. مولوی در اینجا هم اشعاری دارد که این‌ها را هم دلم می‌خواست به شما بخوانم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 136.36,
   "end": 143.88,
   "text": "از زبان مولوی بگیم بهتر است که من خودم بگم و این اشعار هم دقت می‌کنید و این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 143.88,
   "end": 150.06,
   "text": "برای این طول ادامه دادن این صحبت را که برای من و شما تذکرآمیز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 150.06,
   "end": 154.26,
   "text": "است و شما و ما خیلی باید به خودمون بیاییم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 154.26,
   "end": 159.68,
   "text": "عالم را که همه جاش اسرار است و وجودمون که همه قسمتش اسرار است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 159.68,
   "end": 164.14,
   "text": "اسرار است باطن و ظاهر به خودمون بیاییم، متوجه باشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 164.14,
   "end": 169.14,
   "text": "توجه می‌کنید؟ نکند همیشه وقتی ما دعا می‌کنیم به قول مولوی بگوید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 169.14,
   "end": 171.34,
   "text": "احذروا جناب بیاید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 171.34,
   "end": 174.21,
   "text": "احذروا. خب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 174.21,
   "end": 178.2,
   "text": "توجه می‌کنید؟ مخصوصا اونجا که انسان بداند عمل نکند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 178.2,
   "end": 181.76,
   "text": "این برای خودش بوی خاص بدی دارد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 181.76,
   "end": 184.12,
   "text": "این هم رمزی است در نظرتون باشد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 184.12,
   "end": 191.8,
   "text": "هر که را هر کس به هر اندازه بداند و عمل نکند و خلاف دانسته اش عمل بکند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 191.8,
   "end": 195.34,
   "text": "غیر از اینکه هر معصیت برای خودش بویی دارد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 195.34,
   "end": 199.3,
   "text": "هر قسمتی برای خودش رائحه‌ای خیلی زشتی دارد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 199.3,
   "end": 208.19,
   "text": "غیر از این خود این موضوع که بدان و عمل نکند، خود این خصلت و این حالت و این جریان روحی در انسان چه دارد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 208.19,
   "end": 211.88,
   "text": "یک بوی خیلی رائحه‌ی بدی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 211.88,
   "end": 219.92,
   "text": "دارد. اهلش می‌خواهد که شنیده اون عالمی که عمل نمی‌کند جهنمی‌ها دور بدو چه می‌کنند؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 219.92,
   "end": 222.64,
   "text": "از بوی بد او جهنمی‌ها ناراحت می‌شوند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 222.64,
   "end": 225.14,
   "text": "یعنی اون جهنم که همه چیز را دارد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 225.14,
   "end": 226.88,
   "text": "تمام زدی‌ها را دارد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 226.88,
   "end": 229.72,
   "text": "بوی بدش را هم دارد. بوهای بد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 229.72,
   "end": 234.0,
   "text": "توجه می‌کنید؟ اما بوی ناصح که علم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 234.0,
   "end": 236.24,
   "text": "بی عمل باشد خیلی بد است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 236.24,
   "end": 246.14,
   "text": "حتی جهنمی‌ها دیگر که این روی علی مثلا مانند من نمی‌دانم مانند ما иногда با ظاهر به آسانی می‌گیم حالا خدا کند که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 246.14,
   "end": 249.52,
   "text": "عالم به خودش معناه نیست. آنی که می‌داند عمل نمی‌کند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 249.52,
   "end": 254.2,
   "text": "می‌داند عمل نمی‌کند. شما ما همه اینطور هستیم در درجات مختلف.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 254.2,
   "end": 260.14,
   "text": "گفته در روایت هست که از عالمی که عمل نکرده است جهنمی‌ها دور بدو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 260.14,
   "end": 261.97,
   "text": "ناله و شکایت می‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 261.97,
   "end": 264.56,
   "text": "به خدا وقتی میان آنها می‌برند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 264.56,
   "end": 267.82,
   "text": "که دانسته و عمل نکرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 267.82,
   "end": 270.02,
   "text": "این بو خیلی بد است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 270.02,
   "end": 272.04,
   "text": "توجه می‌کنید؟ خب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 272.04,
   "end": 276.86,
   "text": "به همین زمینه و شما وقتی حالا من و شما به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 276.86,
   "end": 283.98,
   "text": "این زیارت می‌کنیم میگیم که السلام علیک یا رسول الله یا وجیها عند الله که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 283.98,
   "end": 286.98,
   "text": "اشبه عندالله. این بوی رسول الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 286.98,
   "end": 294.23,
   "text": "رسول الله هم بوی الله صلوات الله عليه با اون مرتبت بی به اصطلاح خود تصورش که دارد، وجود دارد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 294.23,
   "end": 297.7,
   "text": "بوی الله است. همیشه با او خطاب می‌کنیم دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 297.7,
   "end": 303.46,
   "text": "السلام علیک در نماز که با او خطاب می‌کنیم معلوم هست که بوی الله شائبه جودی دارد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 303.46,
   "end": 307.36,
   "text": "وقتی میگیم السلام علیک اگر این دم دمی باشد که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 307.36,
   "end": 310.94,
   "text": "به قول مستمعین بوی پیاده بهش بیاد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 310.94,
   "end": 313.52,
   "text": "چه باید کرد؟ توجه می‌کنید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 313.52,
   "end": 319.96,
   "text": "چه باید کرد؟ السلام علیک یا رسول الله یا وجیها عندالله اشبه عندالله و همچنین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 319.96,
   "end": 325.88,
   "text": "سلام‌ها که به حضرات معصومین می‌دهند اونها که شامه دارن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 325.88,
   "end": 328.76,
   "text": "دقت می‌کنید؟ گاهی خطاب ملائکه می‌کنیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 328.76,
   "end": 331.38,
   "text": "یا در اذهان بالاتر از اذهان بالاتر به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 331.38,
   "end": 338.66,
   "text": "خدا دهان باز می‌کنیم چیزی می‌فهمیم دعا می‌کنیم و که واقعا مثلا می‌تونیم حرف داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 338.66,
   "end": 345.58,
   "text": "مولوی می‌گوید باز دقت کنید این اشعاری که می‌گویم درش به انصاف امثال خیلی بسیار خوبی هست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 345.58,
   "end": 350.26,
   "text": "و میگه گناه رسوا کرد متن دیش را.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 350.26,
   "end": 355.52,
   "text": "هیچ من و شما هیچ وقت از خدا نخواستیم خدا به ما یه خوبه اهد بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 355.52,
   "end": 358.9,
   "text": "قبلا هم گفتم ما هیچکس از عقل خودش شکایت نکرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 358.9,
   "end": 363.38,
   "text": "یعنی یک دونه پیدا نکردیم که کسی از عقل خودش چه می‌کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 363.38,
   "end": 365.44,
   "text": "از جهل قرائت چه می‌کنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 365.44,
   "end": 370.52,
   "text": "چه آیاتی رو می‌خونه؟ کسی که علم کامل است و عقل هم برای همه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 370.52,
   "end": 372.7,
   "text": "می‌گه درست شده در صورت پرور.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 372.7,
   "end": 374.84,
   "text": "العقل ما عود به حج رحمان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 374.84,
   "end": 380.28,
   "text": "اگر هر اندازه که در راه خدایی بگذارید عقلتون کار می‌کند و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 380.28,
   "end": 384.9,
   "text": "در قرآن فرمود به من یدعوا امه ابراهیم لایضاهن سفه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 384.9,
   "end": 387.3,
   "text": "اینا رو ما پیشیم به قول معروف مزه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 387.3,
   "end": 390.86,
   "text": "مزه نکردیم حرف‌های این آیات، این کلمات چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 390.86,
   "end": 397.94,
   "text": "می‌گه که چی نیست از مسیر توحیدی ابراهیم بیرون زد مگر آن کسی که سفاحت داشته باشد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 397.94,
   "end": 401.46,
   "text": "یعنی عقلش چندان کار که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 401.46,
   "end": 409.4,
   "text": "نکند. این چه حرف‌های پرمعنی، حرف کلام حق است، حق کلام است، حقیقت است، واقعیت است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 409.4,
   "end": 412.62,
   "text": "واقعاً انسان باید یه خورده خودش بیاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 412.62,
   "end": 417.0,
   "text": "من بعضی دوستان میگن خانم‌ها چون جاش نشستن ببینید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 417.0,
   "end": 420.9,
   "text": "دعا بکنید. دعا بکنید این آیه را هم دیگر فراموش نکنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 420.9,
   "end": 424.0,
   "text": "ویجعل الرجس على الذین لا یعقلون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 424.0,
   "end": 426.54,
   "text": "خدا فرمود که قرآن است ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 426.54,
   "end": 429.66,
   "text": "هر که خوب تأمل در این عالم نداشته باشد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 429.66,
   "end": 432.82,
   "text": "اما تأمل به اون صورت که خدا میگه دا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 432.82,
   "end": 435.76,
   "text": "نه به اون معنایی که اینها امر میگن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 435.76,
   "end": 439.64,
   "text": "خب هر کسی تأمل را تو این معنی کرده دقت می‌کنید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 439.64,
   "end": 441.76,
   "text": "تأمل به اون معنا که کی میگه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 441.76,
   "end": 444.54,
   "text": "به اون معنا که خدا میگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 444.54,
   "end": 450.66,
   "text": "میگه خدا فرموده این سنت حاکم در نظام وجود است که رجس و پلیدی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 450.66,
   "end": 458.0,
   "text": "را متوجه آن وجود می‌کنیم که تأمل در اصلاح نشئتش حاکم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 458.0,
   "end": 460.68,
   "text": "نباشد. رجس، پلیدی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 460.68,
   "end": 464.48,
   "text": "عجب آلی. دعا بکنید دوستان،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 464.48,
   "end": 468.02,
   "text": "خانم‌ها که نشستید به خودتون بیایید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 468.02,
   "end": 470.05,
   "text": "شما هم به من اینجورا نگاه می‌کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 470.05,
   "end": 475.2,
   "text": "گفتم حالا من به شما میگم کسی هم باید به من بگه و به ما هم گفتن و میگن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 475.2,
   "end": 477.64,
   "text": "فرصتی دادن به ما از دست ندهیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 477.64,
   "end": 480.94,
   "text": "میگه بوی رسوا کرد مقصد اندیش را.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 480.94,
   "end": 482.88,
   "text": "هیچ از خود راضی نباشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 482.88,
   "end": 486.28,
   "text": "هیچ. گرفتار فقراده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 486.28,
   "end": 489.42,
   "text": "بوی رسوا کرد مقصد اندیش را.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 489.42,
   "end": 494.94,
   "text": "باز مولوی میگه کی داند بوی خصم خویش را.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 494.94,
   "end": 501.66,
   "text": "بعد حالا اونجوری گفتم. میگه آن که یابد بوی رحمان از گمن، یعنی رسول اکرم صلی الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 501.66,
   "end": 506.56,
   "text": "علیه و آله و سلم. آن که یابد بوی رحمان از گمن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 506.56,
   "end": 510.6,
   "text": "چون نیابد بوی باطل رازمن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 510.6,
   "end": 515.62,
   "text": "چطور میشه آدم این نیابد؟ چون نیابد بوی باطل رازمن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 515.62,
   "end": 521.06,
   "text": "بوی باطل رازمن. خب رسول الله فرمود انی اشم رائحة الرحمن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 521.06,
   "end": 523.74,
   "text": "این جان بگم. رسول اکرم یادم رفت ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 523.74,
   "end": 526.44,
   "text": "رسول اکرم صلی الله علیه و آله و سلم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 526.44,
   "end": 528.88,
   "text": "آن فانی الله را که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 528.88,
   "end": 532.72,
   "text": "حامل به ولایت مطلقه است الا اینکه امام نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 532.72,
   "end": 536.4,
   "text": "یعنی حضرت زهرا صلوات الله علیها را چه میگه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 536.4,
   "end": 539.2,
   "text": "استشمام می‌کند. اصلاً استشمام می‌کند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 539.2,
   "end": 541.82,
   "text": "می‌گفت که بوی چی استشمام می‌کنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 541.82,
   "end": 546.76,
   "text": "بوی عشق. اونش حامل رسول الله می‌خوادش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 546.76,
   "end": 550.46,
   "text": "بوی عشق، بوی خدا، بوی بنده‌ خدا، بوی دوست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 550.46,
   "end": 553.34,
   "text": "هر چیزی. اصلاً استشمام می‌کند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 553.34,
   "end": 558.91,
   "text": "این کار رسول الله. چون فانی بود، چون حامل ولایت مطلقه بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 558.91,
   "end": 561.26,
   "text": "سر الله صلوات الله علیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 561.26,
   "end": 568.86,
   "text": "خب می‌دانیم حضرت زهرا صلوات الله کامل ولایت منعم لا مطلقه است الا اینکه امامت نیست و امامتش نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 568.86,
   "end": 575.16,
   "text": "مصطفی، حالا مولوی میگه مصطفی چون بوی برد از راه دور،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 575.16,
   "end": 579.64,
   "text": "چون نیابد از دهان ما بکور.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 579.64,
   "end": 583.32,
   "text": "از راه دور انی اشم رائحة الرحمن این جان بگم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 583.32,
   "end": 586.52,
   "text": "مصطفی چون بوی برد از راه دور،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 586.52,
   "end": 589.46,
   "text": "چون نیابد از دهان ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 589.46,
   "end": 591.85,
   "text": "بکور. می‌شود نیابد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 591.85,
   "end": 596.92,
   "text": "هم بیابد. میگه نه این طور فکر نکن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 596.92,
   "end": 600.38,
   "text": "همه چی حساب شده است. اون که می‌یابد، می‌یابد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 600.38,
   "end": 603.6,
   "text": "حتی من نمی‌فهمم که می‌یابد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 603.6,
   "end": 612.62,
   "text": "چه چیز را می‌فهمیم که؟ هم بیابد لیک پوشان ز ما، هم بیابد لیک پوشان ز ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 612.62,
   "end": 616.52,
   "text": "بوی نکبت برآید بر سما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 616.52,
   "end": 620.68,
   "text": "تو همین خسفه و حالا در خواب هم اینطورم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 620.68,
   "end": 626.34,
   "text": "من و شما می‌خوابیم به اونجا هم در ما بی‌راهه نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 626.34,
   "end": 630.16,
   "text": "تو همین خسفه و بوی آن حرام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 630.16,
   "end": 634.38,
   "text": "می‌زند بر آسمان سرسام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 634.38,
   "end": 638.4,
   "text": "همغش انفاس حالا اینو به من خطاب می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 638.4,
   "end": 641.36,
   "text": "همغش انفاس زشت است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 641.36,
   "end": 644.04,
   "text": "می‌شود. یعنی اون بو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 644.04,
   "end": 650.18,
   "text": "همغش انفاس زشت است می‌شود تا به بوگیران گردن می‌رود،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 650.18,
   "end": 653.28,
   "text": "تا به بوگیران گردن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 653.28,
   "end": 656.7,
   "text": "می‌رود. بوی کبر و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 656.7,
   "end": 661.22,
   "text": "حالا ببینید که مولوی اینجا گفته این حقیقت است و من قبلاً اشاره کردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 661.22,
   "end": 663.0,
   "text": "مولوی میگه نگین اینطوری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 663.0,
   "end": 673.36,
   "text": "هر صفت بد، هر نیت بد و همچنین هر عمل خلاف موقع انجام در، در وجود انسان بوی خاص بد دارد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 673.36,
   "end": 676.08,
   "text": "نمی‌دونم شما ارباب ذوق هستید یا نه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 676.08,
   "end": 681.1,
   "text": "میرزا هندسی گفت صورتی در زیر دارد آنچه در کی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 681.1,
   "end": 686.36,
   "text": "بالاستی. که با این اختران نزع خود را زیباستی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 686.36,
   "end": 690.36,
   "text": "صورتی در زیر دارد آنچه در بالاستی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 690.36,
   "end": 693.36,
   "text": "صورت زیرین اگر با نظر عال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 693.36,
   "end": 698.56,
   "text": "معرفت در رود بالا همان با اصل خود یکتاستی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 698.56,
   "end": 706.04,
   "text": "از شما سؤال می‌کنم شما بوهای بد در این عالم را یک رنده بوی به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 706.04,
   "end": 708.89,
   "text": "تنوع می‌بینید؟ آنجا هم بدانید که اصلش هم به تنوعه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 708.89,
   "end": 710.61,
   "text": "اینها لازمه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 710.61,
   "end": 713.58,
   "text": "اصلش هم به تنوعه و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 713.58,
   "end": 722.38,
   "text": "تنوعش هم به تنوع صفات جهنمی، اعمال جهنمی، نیات جهنمی و اوصاف و اخلاق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 722.38,
   "end": 724.7,
   "text": "جهنمی انسان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 724.7,
   "end": 727.36,
   "text": "است. تعطرش به تعطر اونهاست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 727.36,
   "end": 731.4,
   "text": "همون در گفتار من به دقت و تعمق توجه میکنید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 731.4,
   "end": 734.54,
   "text": "به احوالتون بسپارید بعدش به تفکر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 734.54,
   "end": 736.62,
   "text": "بوی کفر و بعد یک تا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 736.62,
   "end": 740.18,
   "text": "بوی کفر و بوی هوس و بوی عاز.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 740.18,
   "end": 742.08,
   "text": "در سخن گفتن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 742.08,
   "end": 746.08,
   "text": "بیآید یا بیاید چون پیاز.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 746.08,
   "end": 749.56,
   "text": "ببخشید چون پیاز درست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 749.56,
   "end": 753.36,
   "text": "اما متکبر یه حرف زدن اگر شامل باشد اونجا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 753.36,
   "end": 759.45,
   "text": "بوی پیاز میآید. حالا خیر صاحب رنت تملق بوی پیاز میده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 759.45,
   "end": 762.42,
   "text": "بوی حالا سیر میاد ترجمه کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 762.42,
   "end": 768.52,
   "text": "بوی میده. میگه که معلم میگه حالا یه کسی پیاز میخوره بعد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 768.52,
   "end": 772.4,
   "text": "سعی میکنه که میگه اما بوی پیاز میاد از دهنش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 772.4,
   "end": 776.72,
   "text": "میخواهد قسم بخورد که بوی پیاز من پیاز دیروز چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 776.72,
   "end": 780.42,
   "text": "نخورده همون من پیاز نخوردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 780.42,
   "end": 783.56,
   "text": "کسی پیاز خورده باشد بوی پیاز از دهنش بیاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 783.56,
   "end": 786.36,
   "text": "شما استشعار میکنید که پیاز خورده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 786.36,
   "end": 787.94,
   "text": "بود. بوی پیاز و سیر از دهن بیاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 787.94,
   "end": 793.0,
   "text": "بخواد قسم بخوره که اینجوری نیست بوی پیاز و سیر بیشتر چه میشود؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 793.0,
   "end": 796.0,
   "text": "روشن میشود. توجه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 796.0,
   "end": 798.6,
   "text": "بکنید این دهن‌ها که باز میکنند خدایا!",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 798.6,
   "end": 801.72,
   "text": "چنین و چنان شبیه این اینجا و اونجان حضرات ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 801.72,
   "end": 806.74,
   "text": "فهمیدی چه گفت؟ گفت که در خوری سوگند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 806.74,
   "end": 808.88,
   "text": "من چه خورده‌ام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 808.88,
   "end": 813.18,
   "text": "از پیاز و سیر. تعویض کردم، این تعویض کردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 813.18,
   "end": 816.42,
   "text": "آن داند سوگند دراز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 816.42,
   "end": 820.02,
   "text": "کند بر دماغ همه‌چنان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 820.02,
   "end": 824.14,
   "text": "بگذار دعاها رد شود از بوی آن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 824.14,
   "end": 828.12,
   "text": "آن دل کژ نمی نماید از زبان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 828.12,
   "end": 832.28,
   "text": "آن دل کژ نمی نماید از زبان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 832.28,
   "end": 834.74,
   "text": "گوش نیاد. اکثعُ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 834.74,
   "end": 837.14,
   "text": "آید جواب آن دعا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 837.14,
   "end": 842.34,
   "text": "اکثعُ. در مورد جهنمی‌ها که اونجا در جهنم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 842.34,
   "end": 844.78,
   "text": "میخوان که ندای بکنند خدایا!",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 844.78,
   "end": 848.6,
   "text": "من نفهمیدم چنین و چنان گفتن چه شد که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 848.6,
   "end": 855.08,
   "text": "اکثعُ، اکثعُ در جای خاصی هم میخواندم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 855.08,
   "end": 862.58,
   "text": "اکثعُ آید جواب آن دعا چون به رد باشد جزای هر دعا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 862.58,
   "end": 866.6,
   "text": "در حدیثت کژ بود معنی راست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 866.6,
   "end": 870.34,
   "text": "در حدیثت کژ بود معنی راست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 870.34,
   "end": 872.36,
   "text": "آن کژی لفظ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 872.36,
   "end": 880.94,
   "text": "مغبون خداست. ور بود معنی کژ و لفظ مغبون آنچنان معنی نیارزد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 880.94,
   "end": 884.5,
   "text": "یک کسو. این باز در دفتر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 884.5,
   "end": 888.56,
   "text": "سوم است یعنی. توجه کردید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 214,
   "start": 888.56,
   "end": 891.24,
   "text": "خب ما را به این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 215,
   "start": 891.24,
   "end": 894.76,
   "text": "مطالبی که گفتم به تفکر میکنید که اینجا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 216,
   "start": 894.76,
   "end": 898.02,
   "text": "اینجا هم حضراتم نظرتون باشد که ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 217,
   "start": 898.02,
   "end": 904.5,
   "text": "نمیفهمیم شامل نداریم ولی روای خیلی برتر از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 218,
   "start": 904.5,
   "end": 907.78,
   "text": "تمام روای عالم هست و شامل میخواند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 219,
   "start": 907.78,
   "end": 911.72,
   "text": "کسی از این شامل در حد خودش برخوردار شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 220,
   "start": 911.72,
   "end": 917.86,
   "text": "به اصطلاح میگویند از چشم شمع برخوردار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 221,
   "start": 917.86,
   "end": 925.26,
   "text": "است. خب از این گذشتیم، از این گذشتیم و به زودی هم گذشتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 222,
   "start": 925.26,
   "end": 928.0,
   "text": "هر در اینجا و آنجا when کلام میشود خط و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 223,
   "start": 928.0,
   "end": 930.56,
   "text": "خطای زیاد است. اصلاً جلسات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 224,
   "start": 930.56,
   "end": 934.5,
   "text": "میخواهد در نه ولی همش گفتم کلیت‌ها صحبت میکنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 225,
   "start": 934.5,
   "end": 938.72,
   "text": "من شما حالا که میخواهیم بگذریم از خدا بخواهید که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 226,
   "start": 938.72,
   "end": 944.12,
   "text": "به شما خدا از این شمع هرچی بخوه از این شمع هم بدهد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 227,
   "start": 944.12,
   "end": 949.98,
   "text": "حتی این شمع، شمعی است که برای انسان نور به چشم هم میآورد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 228,
   "start": 949.98,
   "end": 959.4,
   "text": "این یادتون باشد و اصولا کسی، کسی از شمع، چشم شمعیه این خاصیت را دارد ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 229,
   "start": 959.4,
   "end": 961.44,
   "text": "برخوردار باشد چشمش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 230,
   "start": 961.44,
   "end": 964.64,
   "text": "در یک вроде دیگر هم کار میکند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 231,
   "start": 964.64,
   "end": 967.86,
   "text": "شما شنیدید حضرت یوسف صلوات الله،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 232,
   "start": 967.86,
   "end": 973.06,
   "text": "سلام الله صلوات الله بوی حضرت یوسف سلام الله را چه کرد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 233,
   "start": 973.06,
   "end": 980.74,
   "text": "بوی استشمام کرد اصلاً و بوی را که استشمام کرد چشمش هم که شد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 234,
   "start": 980.74,
   "end": 983.24,
   "text": "حالا رو میایم انشاالله بحث میکنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 235,
   "start": 983.24,
   "end": 989.78,
   "text": "خب من از خدا میخواهم که حضرت یوسف را",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 236,
   "start": 989.78,
   "end": 992.48,
   "text": "هم که گفت شما من را ملامت میکنید اما من بوی یوسف را",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 237,
   "start": 992.48,
   "end": 995.04,
   "text": "چه میکنم؟ استشمام میکنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 238,
   "start": 995.04,
   "end": 997.38,
   "text": "گفت اشما نباید استشمام میکرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 239,
   "start": 997.38,
   "end": 1003.4,
   "text": "آنها نمیفهمیدند. میگفت من میترسم ملامت بشم اما من استشمام میکنم بوی یوسف را.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 240,
   "start": 1003.4,
   "end": 1008.52,
