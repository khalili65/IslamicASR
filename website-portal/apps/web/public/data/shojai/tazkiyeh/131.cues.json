 "chapters": [
  {
   "index": 0,
   "title": "اعوذ بالله السمیع العلیم من الشیطان الرجیم. بسم الله الرحمن الرحیم.",
   "start": 4.29,
   "end": 77.48
  },
  {
   "index": 1,
   "title": "## قوهٔ خیالیه و خواب‌ها",
   "start": 77.48,
   "end": 258.92
  },
  {
   "index": 2,
   "title": "## سوءاستفادهٔ خیال از نورِ ابتدایی",
   "start": 258.92,
   "end": 279.48
  },
  {
   "index": 3,
   "title": "## مثال: دیدنِ دیگران به صورت حیوان",
   "start": 279.48,
   "end": 317.52
  },
  {
   "index": 4,
   "title": "## وهم و ترسِ حادثه",
   "start": 317.52,
   "end": 338.0
  },
  {
   "index": 5,
   "title": "## جمعِ زمینه‌ها",
   "start": 338.0,
   "end": 834.95
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 4.29,
   "end": 15.1,
   "text": "اونچه آمادگی درش پیدا شده یعنی انواری در چشم و قلبش گاه گاهی گاهی از وقتی‌ها پیدا شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 15.1,
   "end": 23.42,
   "text": "و اما از طرفی ببینید زمینه‌های اشتباه از چند لحاظ و دخالت‌های شیطان در وجودش هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 23.42,
   "end": 28.5,
   "text": "یکی اینکه آدم مقتدی هنوز اصلاً مجاهدت نکرده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 28.5,
   "end": 33.04,
   "text": "و نفس در وجودش با کمال قوت حاکم‌فرماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 33.04,
   "end": 34.84,
   "text": "خوب دقت کنید اینو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 34.84,
   "end": 41.04,
   "text": "خوب در نکات ارازه. نفس در وجودش با کمال قوت چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 41.04,
   "end": 43.48,
   "text": "حاکم‌فرماست. این یک.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 43.48,
   "end": 47.02,
   "text": "خود اسیر نفس بودن، هواها بودن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 47.02,
   "end": 51.88,
   "text": "خودش به انحایی کافیست انسان بازیچه شیطان بشود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 51.88,
   "end": 55.6,
   "text": "یعنی وقتی نفس حاکم است یعنی شیطان در وجود حاکم است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 55.6,
   "end": 63.02,
   "text": "این یک. اصلاً نفس ابزار کامل شیطان است و حکومت نفس خلاصه یعنی حکومت شیطان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 63.02,
   "end": 64.94,
   "text": "این یک چیز مثلث.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 64.94,
   "end": 67.56,
   "text": "اولاً یک اشکالی نیست که در مراحل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 67.56,
   "end": 74.0,
   "text": "ابتداییه سرای جمیع که چیزهای ناقص شروع کرده اولاً در تحت قوت نفس است نه تحت قوت شیطان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 74.0,
   "end": 79.48,
   "text": "این یک. ثانیاً در تحت اسارت خیال و وهم است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 79.48,
   "end": 81.52,
   "text": "این نکات را خوب توجه کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 81.52,
   "end": 85.16,
   "text": "خیال یکی از مسائل است در وجود همه ما هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 85.16,
   "end": 92.58,
   "text": "از خیال و خیال باقی و تحت اسارت تخیل و قوه خیالیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 92.58,
   "end": 96.3,
   "text": "قرار گرفتن و نگرفتن هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 96.3,
   "end": 104.98,
   "text": "یکی از مسائل است که در مجاهدت اگر در طریق مستقیم باشد این اسارت از میان می‌رود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 104.98,
   "end": 112.96,
   "text": "اگر انسان در طریق مست-مستقیم مجاهدت نکرد تحت اسارت تخیلش هم همیشه چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 112.96,
   "end": 116.44,
   "text": "هست و همین‌طور در تحت اسارت توهمش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 116.44,
   "end": 122.96,
   "text": "حالش فکر کنید که شما خودتون و همه اونایی که مانند من و شما هستند و عامه مردم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 122.96,
   "end": 129.96,
   "text": "این همه خواب‌ها که ما در موقع که خوابیدیم می‌بینیم ذاتاً علاقات معنی هم ندارد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 129.96,
   "end": 132.69,
   "text": "می‌داند اینها ساخته و پرداخته کیست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 132.69,
   "end": 134.64,
   "text": "یعنی گفتید؟ ها؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 134.64,
   "end": 136.74,
   "text": "احسنت. همان قوه خیال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 136.74,
   "end": 140.24,
   "text": "است. یه مقدار که قوه خیال پر و بال پیدا کرد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 140.24,
   "end": 142.64,
   "text": "این نکات رو خوب دقت کنید ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 142.64,
   "end": 148.48,
   "text": "وقتی ما می‌خوابیم قوه تـ-- خیال ما که از قوای درونی ماست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 148.48,
   "end": 153.57,
   "text": "که به معانی به سو-- مسائل ذهنی ما صورت می‌بخشد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 153.57,
   "end": 156.86,
   "text": "اینو میگن قوه خیالیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 156.86,
   "end": 159.4,
   "text": "چیزهایی که ما ف-فکر می‌کنیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 159.4,
   "end": 162.22,
   "text": "افکار‌هایی که داریم، کمال‌هایی که در باطن داریم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 162.22,
   "end": 168.44,
   "text": "آرزوهایی که می‌کنیم، تصویرهایی که می‌کنیم در حالت بیداری و در وجود ما ریشه دارد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 168.44,
   "end": 172.64,
   "text": "قوه خیالیه خلاقیت دارد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 172.64,
   "end": 179.4,
   "text": "یعنی می‌تواند اگر پر و بالش باز شود به آنچه که شما در مفکرین خودتون،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 179.4,
   "end": 187.12,
   "text": "فکرتون در حالت بیداری فکر می‌کنید، ریشه دار است، تفکر می‌کنید، آرزو می‌کنید، تصویر می‌کنید،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 187.12,
   "end": 192.49,
   "text": "اون‌ها را قوه خیالیه اگر پر و بالش باز باشه چی می‌کند؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 192.49,
   "end": 194.96,
   "text": "ها؟ یعنی گفتید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 194.96,
   "end": 198.98,
   "text": "صورت می‌دهد. ما همون رو در خواب است دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 198.98,
   "end": 207.42,
   "text": "اکثر خواب‌ها که ما می‌بینیم این‌ها اکثر خواب‌ها حالا که نه همه اش، اکثر خواب یعنی تو انواعی تعبیر داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 207.42,
   "end": 212.42,
   "text": "البته در اون تعبیردارها هم خیلی خیال خلاق دارد صورت می‌دهد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 212.42,
   "end": 215.54,
   "text": "فعلاً اکثر خواب‌ها که بی‌تعبیر است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 215.54,
   "end": 218.8,
   "text": "این‌ها خلاقیت قوه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 218.8,
   "end": 220.7,
   "text": "خیالیه ماست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 220.7,
   "end": 222.82,
   "text": "که وقتی خوابیدیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 222.82,
   "end": 229.54,
   "text": "آنچه در درون داریم در بیداری ریشه‌دار است از مسائل مختلف این‌ها را صورت می‌بخشد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 229.54,
   "end": 236.54,
   "text": "چی؟ درست می‌کند. همین انسان خواب می‌بینه از اینجا از اونجا و چیزهایی که نمی‌فهمد چیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 236.54,
   "end": 239.7,
   "text": "گاهی خوش است گاهی ناخوش است و اینا آخر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 239.7,
   "end": 241.33,
   "text": "این خلاقیت خیال است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 241.33,
   "end": 249.04,
   "text": "البته اینجا توجه بکنید خیال اگر به اصطلاح پخته بشود خیال ماها نه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 249.04,
   "end": 254.74,
   "text": "نهاد، نهاد. خیال کسی اگر تجرید بشود خودش تجرید بشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 254.74,
   "end": 257.2,
   "text": "قوه خیالیه‌اش هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 257.2,
   "end": 261.86,
   "text": "به اصطلاح در مسیر صحیحی بیفتد خیلی به درد می‌خورد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 261.86,
   "end": 264.36,
   "text": "با هدف نکرده. چند تا ذکر می‌گرد. یه خورده صفای هم دارد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 264.36,
   "end": 266.7,
   "text": "یه مقدار مسائل میراثی هم هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 266.7,
   "end": 268.42,
   "text": "یه مسائل مزاجی هم هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 268.42,
   "end": 271.62,
   "text": "یه انواری در قلب و در چشمش پیدا شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 271.62,
   "end": 274.82,
   "text": "اما قسیره نفس که گفت دوم اسیر چی بود؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 274.82,
   "end": 276.92,
   "text": "اسیر ها؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 276.92,
   "end": 279.48,
   "text": "فراموش کرد. اسیر خیالش هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 279.48,
   "end": 282.0,
   "text": "خیال اینجا در سوراخ در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 282.0,
   "end": 284.48,
   "text": "کمین آدم هست که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 284.48,
   "end": 289.66,
   "text": "از اون نوری که در چشم و قلبش هست خیال سوء استفاده کند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 289.66,
   "end": 296.18,
   "text": "در یک شرایط که اینگونه جمع شد بیاید یک چیزی از ذهنیات این طرف را",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 296.18,
   "end": 304.16,
   "text": "خلق کند در حالت بیداری به صورت یک مشاهده در برابرش قرار بدهد و این آقا می‌بیند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 304.16,
   "end": 312.33,
   "text": "فکر می‌کند که واقعیت می‌بیند و ندانَد که این فکر خودش هست که این را کی چیزی به صورت آورده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 312.33,
   "end": 315.74,
   "text": "تخیل خودش با استفاده از اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 315.74,
   "end": 319.46,
   "text": "آمادگی که دارد و نوری که در قلب و باطن‌اش هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 319.46,
   "end": 323.16,
   "text": "توجه کردید؟ مثلاً،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 323.16,
   "end": 328.2,
   "text": "مثلاً من گاهی به بعضی‌ها که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 328.2,
   "end": 338.0,
   "text": "اینجور چیزها چند زیاد دور نیست و تکرار هم شده در خصوص یه نفری که چندین بار اینجا آمده صحبت کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 338.0,
   "end": 345.85,
   "text": "مثلاً این خودش تصور می‌کند که از اینکه خوب هم هست از لحاظ موفق نیست ولی بالاخره از این گرفتاری‌ها هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 345.85,
   "end": 349.32,
   "text": "هنوز اسارت نفس است، اسارت خیال هم هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 349.32,
   "end": 351.98,
   "text": "مثلاً فکر می‌کند که من آدم بدی هستم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 351.98,
   "end": 355.64,
   "text": "فلان خصلت در من هست. عقیده‌اش بر اینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 355.64,
   "end": 359.68,
   "text": "حالا من دارم این خصلت را، این گرفتاری را",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 359.68,
   "end": 363.68,
   "text": "یا ندارم. فعلاً عقیده او بر اینه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 363.68,
   "end": 371.12,
   "text": "بر اساس عقیده خودش که منو با این خصلت و این خصلت بد را در وجود من ریشه دار میداند،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 371.12,
   "end": 374.96,
   "text": "قهراً شون مشاهدات و مکاشفات ابتداییه دارد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 374.96,
   "end": 379.86,
   "text": "یک دفعه میبینید منو بر صورتی که متناسب با اون خصلتش میبینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 379.86,
   "end": 384.76,
   "text": "چندین بار آمده از من سؤال کرده که من فلانی را با این قیافه میبینم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 384.76,
   "end": 389.48,
   "text": "توجه میکنید؟ مثلا با قیافه حیوانی که متناسب با اون صفت است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 389.48,
   "end": 393.52,
   "text": "صفتی که دین در وجود او اون صفت را غالب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 393.52,
   "end": 395.78,
   "text": "نمیداند طبق دید خودش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 395.78,
   "end": 398.52,
   "text": "و یا فرضاً ما-- غالب هم هست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 398.52,
   "end": 400.66,
   "text": "اما مسئله این نیست که صورت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 400.66,
   "end": 403.78,
   "text": "برزخی او برای این مشهور شده چون اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 403.78,
   "end": 406.12,
   "text": "یه خورده در حد بالاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 406.12,
   "end": 410.3,
   "text": "میداند که اینجور چیزی داره در مشاهدات، در کشف ابصاری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 410.3,
   "end": 412.92,
   "text": "من جلسه گذشته چند تا رو بهمون گفتم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 412.92,
   "end": 416.44,
   "text": "اینم یکی. نگفتم اینجا ولی یکی از صورت‌هاش اینه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 416.44,
   "end": 420.42,
   "text": "که کسی که از کشف ابصاری در مرحله اواسط،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 420.42,
   "end": 428.86,
   "text": "نه ابتدا، اواسط برخورددار است اگر اشتباه نشود و خدا حفظش و خدا مشیتش علاقه بگیرد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 428.86,
   "end": 431.6,
   "text": "اواسط، اونم اوائل اواسط نه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 431.6,
   "end": 436.44,
   "text": "یه خورده پخته باشد اواسط و اواسط نزدیک به نهايات،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 436.44,
   "end": 446.82,
   "text": "اوائل نهايات. در اون مرازه یک فرد م-مرد الهی، فرد الهی ممکن است بنده را با صورت برزخی هم ببیند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 446.82,
   "end": 448.96,
   "text": "یعنی شما با همین صورت هم میبینید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 448.96,
   "end": 451.74,
   "text": "اما اون با صورت چی میبیند؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 451.74,
   "end": 454.56,
   "text": "با صورت برزخی هم میبیند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 454.56,
   "end": 459.66,
   "text": "اگر صفت یک گرنده‌ای در من مانند صدام مثلا حاکم است،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 459.66,
   "end": 463.46,
   "text": "خب او را به صورت یک گرگ میبیند و یا به صورت--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 463.46,
   "end": 470.3,
   "text": "حالا من نمیخوام خدایی نخواسته اونجا بگن دارم یه زنی را از سردر دارم با صدام هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 470.3,
   "end": 472.96,
   "text": "به اصطلاح تش-- روابط صدام تشکیل میدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 472.96,
   "end": 475.52,
   "text": "کار دینی آسانی نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 475.52,
   "end": 478.48,
   "text": "فرض کنم که میبینم تو رو گرگ میبیند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 478.48,
   "end": 483.22,
   "text": "یا گاهی مثلا خصلت‌های مختلف در وجود یک کس حاکم است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 483.22,
   "end": 489.02,
   "text": "این صورتش را مجموعه‌ای از صور حیوانات که اون خصلت‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 489.02,
   "end": 491.51,
   "text": "در آن حیوانات ریشه دار است میبیند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 491.51,
   "end": 494.15,
   "text": "مثلا سرش را شبیه فلان حیوان میبیند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 494.15,
   "end": 499.84,
   "text": "دستش را شبیه فلان حیوان یا صورتش رو اصلاً مجموعه‌ای مرکبی از صورت چند حیوان میبیند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 499.84,
   "end": 504.4,
   "text": "اینا آخه که رسول اکرم صلی الله علیه و آله و سلم فرمود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 504.4,
   "end": 511.24,
   "text": "البته این در صورتی است که اون خصلت‌ها در درون انسان ریشه دار و حاکم باشد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 511.24,
   "end": 516.0,
   "text": "یعنی از انسانیت انسان دیگه خبری در باطن امر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 516.0,
   "end": 518.72,
   "text": "چیه؟ نمونده باشد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 518.72,
   "end": 520.94,
   "text": "نه جزئی باشد که مثلا یه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 520.94,
   "end": 528.06,
   "text": "خصلت براش پیدا میشود ولی انسانیت غالب است خاص مانند من و شما انشاالله که اینطور هستیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 528.06,
   "end": 534.24,
   "text": "اونجا که غالب است این صفات، این در برزخ مخصوصاً در حشر با صور دیگر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 534.24,
   "end": 542.42,
   "text": "اینا مشهور می‌شوند. آدمی که در مشاهدات و مکاشفات در اواسط و یه خورده نزدیک به نهايات از خدا خواست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 542.42,
   "end": 548.12,
   "text": "ممکن است کسی را با صورت برزخی و اخروی خودش که صورت دیگریست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 548.12,
   "end": 551.1,
   "text": "ببیند. این یکی از کشف‌های ابصاری است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 551.1,
   "end": 554.74,
   "text": "مراحل تقریباً نزدیک به آیه کشف ابصاری است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 554.74,
   "end": 557.2,
   "text": "آیه این اواسط کشف ابصاری است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 557.2,
   "end": 560.92,
   "text": "و بوده‌اند و بعضی از مردان خدا میبینند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 560.92,
   "end": 563.64,
   "text": "رسول اکرم صلی الله علیه و آله و سلم فرمود که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 563.64,
   "end": 570.42,
   "text": "بعضی‌ها مشهور می‌شوند با صورت‌هایی که خوب مثل قرده، میمون‌ها و خنزیرها از اون صورت‌ها خیلی بهتره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 570.42,
   "end": 572.78,
   "text": "خیلی بد می‌شود از صورت انسان اگر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 572.78,
   "end": 579.01,
   "text": "اون انسان‌های مسخ شده و یکی از معانی مسخ هم در اینجا نظرتون باشد همین است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 579.01,
   "end": 582.14,
   "text": "یعنی در باطن انسان مسخ شده به هر صورت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 582.14,
   "end": 588.28,
   "text": "خب این آدمی که الآن گفتم مثلا چندی با پیش من صحبت کرده در مراحل و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 588.28,
   "end": 592.3,
   "text": "اممم اصطلاح مراحل اولیه مشاهدات و مکاشفات است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 592.3,
   "end": 597.56,
   "text": "اما این یه کسی را که با این صورت میبیند البته تشخیصش مشکله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 597.56,
   "end": 600.18,
   "text": "حالا شما میگید که از کجا میشود تشخیص داد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 600.18,
   "end": 603.44,
   "text": "این هم یه سوالی است که بگذره باشد به جای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 603.44,
   "end": 613.42,
   "text": "خودش. این در واقع خیال خودش بر اساس دید خودش، طرف را به این صورت در نظرش چیه میکنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 613.42,
   "end": 615.82,
   "text": "در نظرش، نگفته؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 615.82,
   "end": 618.26,
   "text": "مجسم و محصل میکنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 618.26,
   "end": 621.44,
   "text": "و فکر میکند طرف باطن این صورت را دارد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 621.44,
   "end": 630.56,
   "text": "نه اون اشتباه کرده و این اشتباه از ناحیه دربه‌ خیال است و در وجودش خب یه مقدار زمینه‌اش آماده است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 630.56,
   "end": 634.02,
   "text": "انوار در چشمش هست، انوار در قلبش هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 634.02,
   "end": 638.42,
   "text": "ولی قسمت خدا هم فرض میکنیم در اون لحظه که میبیند نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 638.42,
   "end": 640.18,
   "text": "حفظ و عنایت خدا هم نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 640.18,
   "end": 643.66,
   "text": "میبیند بنده را مثلا به صورت یک حیوان میبیند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 643.66,
   "end": 647.24,
   "text": "نه اون، او فکر میکند این صفت حیوانی در وجود من غالب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 647.24,
   "end": 651.54,
   "text": "است و بر اساس دید خودش اینجور میبیند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 651.54,
   "end": 654.4,
   "text": "حالا مسئله تنها به حیوان بودن نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 654.4,
   "end": 660.24,
   "text": "مثلا فرض فرماید که عه به جاج‌ها در صورت و صورت‌های زیادی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 660.24,
   "end": 663.62,
   "text": "مثلا با گفتن تمام نمی‌شود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 663.62,
   "end": 672.14,
   "text": "من چندین بار بهش گفتم که تو اینجوری و حتی بهش گفتم تو می‌خواهی خوب بدانی که اینجور، اینطور نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 672.14,
   "end": 675.26,
   "text": "استخاره بکن، خیلی استخاره بکن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 675.26,
   "end": 680.46,
   "text": "از اینکه اینجور فکر کردی و پناهنده باش به خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 680.46,
   "end": 685.2,
   "text": "ببین اون طرف را در چه صورتی میبینی که میگی با این صورت میبینی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 685.2,
   "end": 690.6,
   "text": "و شده هم و بعد هم با صورت خودش معمولی خودش میبینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 690.6,
   "end": 694.68,
   "text": "خب اون، این دخالت خیال است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 694.68,
   "end": 697.04,
   "text": "دخالت خیال و با",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 697.04,
   "end": 700.12,
   "text": "استعانه از واهمه انسان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 700.12,
   "end": 704.0,
   "text": "البته این در خواب هم به سراغ انسان میآید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 704.0,
   "end": 708.2,
   "text": "حالا این مشاهده و مکاشفه حق است یا باطل است؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 708.2,
   "end": 713.68,
   "text": "باطل است. مثلا مشاهده در حقیقت اگر بخواهیم به معنی техниکی نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 713.68,
   "end": 718.98,
   "text": "مکاشفه هم نیست. برای اینکه مشاهده و مکاشفه اون که از واقعیت کشف کند این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 718.98,
   "end": 722.42,
   "text": "خیال خود شخص است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 722.42,
   "end": 725.56,
   "text": "که اینجور براش متصور می‌شود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 725.56,
   "end": 730.12,
   "text": "یا مثلا میبینید که از یک چیزی خیلی ناراحت است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 730.12,
   "end": 732.46,
   "text": "از یک حادثه محتمل،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 732.46,
   "end": 736.68,
   "text": "حادثه محتمل. خب فرد نفس گشته است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 736.68,
   "end": 740.8,
   "text": "اوائل است. مثلا اون جمله بیجا در وجودش هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 740.8,
   "end": 744.64,
   "text": "نفس که حاکم است، خیال هم که حاکم است، وهم هم که حاکم است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 744.64,
   "end": 747.66,
   "text": "اینجا بیشتر سهم وهم است این مثالی که عرض می‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 747.66,
   "end": 756.62,
   "text": "البته باز اون صورت دهنده تخیل است چون همیشه صورت از تخیل است اما بیشتر استعانه از وهم است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 756.62,
   "end": 759.22,
   "text": "مثلا زیاد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 759.22,
   "end": 765.22,
   "text": "خیلی مثلا می‌ترسد که مثلا عرض کنم که بچه‌اش مثلا تصادف بکند در بیرون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 765.22,
   "end": 767.84,
   "text": "مثلا رفته بیرون تصادف بکنه مثلا با ماشین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 767.84,
   "end": 770.82,
   "text": "تصادف، تصادف با ماشین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 770.82,
   "end": 775.15,
   "text": "یا مثلا یه دفعه می‌بینید که این ترس‌ها سر وجودش غالبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 775.15,
   "end": 778.88,
   "text": "حالا اگر فرد پخته باشد اینجور ترس‌ها غالب نمی‌شود در وجودش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 778.88,
   "end": 784.56,
   "text": "اون پخته نیست و از مسائل اولیه تابش نور در قلب و چشم هم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 784.56,
   "end": 787.36,
   "text": "گفتیم و زمینه آماده است این مثال.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 787.36,
   "end": 790.88,
   "text": "اما خیال غالب، نفسانیت غالب، وهم هم غالب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 790.88,
   "end": 793.42,
   "text": "این فکر هم در وجودش تامله می‌شود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 793.42,
   "end": 796.08,
   "text": "یه دفعه می‌بینید، می‌بینید که در خواب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 796.08,
   "end": 798.92,
   "text": "یا در بیداری، یکی از این دو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 798.92,
   "end": 801.62,
   "text": "می‌بیند که مثلا اون بچه‌اش اونجا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 801.62,
   "end": 804.72,
   "text": "چی شد؟ مثلا افتاده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 804.72,
   "end": 808.26,
   "text": "یا افتاده است و مثلا دست و پا می‌زند و منشیش رو خورده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 808.26,
   "end": 811.6,
   "text": "این مصنوع چیست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 811.6,
   "end": 815.15,
   "text": "مصنوع... خب اون وقت فکر میکنه که واقعیت است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 815.15,
   "end": 821.26,
   "text": "توجه کنید. یا مثلا درباره کس دیگه فکری میکنه حادثه‌ای به سراغش بیاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 821.26,
   "end": 824.92,
   "text": "درباره خودش نه، کسان خودش نه، برای کس دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 824.92,
   "end": 831.32,
   "text": "می‌بینید در عالم خیال چیزی برایش درست کرده و حالا مکاشفه و مشاهده در بیداری یا در خواب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 831.32,
   "end": 834.95,
   "text": "این باعث دخالت خیال است و وهم است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}