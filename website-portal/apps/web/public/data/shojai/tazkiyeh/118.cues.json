   "start": 6.92,
   "end": 343.45
  },
  {
   "index": 1,
   "title": "## مراتب تجلی غفور در مرحلهٔ عالی",
   "start": 343.45,
   "end": 409.44
  },
  {
   "index": 2,
   "title": "## ابراهیم علیه‌السلام و طمع مغفرت",
   "start": 409.44,
   "end": 604.21
  },
  {
   "index": 3,
   "title": "## عفو مترتب بر غفور؛ دعای سی‌ودوم صحیفه",
   "start": 604.21,
   "end": 888.96
  },
  {
   "index": 4,
   "title": "## دستورالعمل پایانی جلسه",
   "start": 888.96,
   "end": 929.52
  },
  {
   "index": 5,
   "title": "## برنامهٔ اوراد",
   "start": 929.52,
   "end": 1039.17
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 1.26,
   "end": 4.32,
   "text": "اعوذ بالله السميع العليم من الشيطان الرجيم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 4.32,
   "end": 6.92,
   "text": "بسم الله الرحمن الرحيم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 6.92,
   "end": 10.92,
   "text": "مثنوی در اینجا دو سه شعر دارد که بخوانم گوش بکنید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 10.92,
   "end": 19.35,
   "text": "و ان شاءالله که البته به اون معنی درستش گوش بکنید، نه به اون معنای که بعضی‌ها داده معنی نادرست معنی می‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 19.35,
   "end": 24.76,
   "text": "چون برای مثال هی معنی‌های نادرستی داره معنی‌های درستی داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 24.76,
   "end": 30.06,
   "text": "می‌گوید که چند صد شعره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 30.06,
   "end": 34.12,
   "text": "بخوانم و بعد هم بپردازیم به بعضی از آیات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 34.12,
   "end": 36.46,
   "text": "حالا این الانش گفتنش برای ما مونده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 36.46,
   "end": 38.24,
   "text": "شنیدنش هم برای شماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 38.24,
   "end": 41.37,
   "text": "توجه می‌کنید؟ بقیه هم برای ما شنیدن هم می‌مونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 41.37,
   "end": 44.52,
   "text": "ولی فعلاً برای شما شنیدنه الان در اینجا گفتن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 44.52,
   "end": 49.87,
   "text": "برای من. می‌گه چون انای بنده، انا یعنی انا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 49.87,
   "end": 51.8,
   "text": "الان برای شعر می‌گفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 51.8,
   "end": 55.06,
   "text": "چون انای بنده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 55.06,
   "end": 57.7,
   "text": "شد لا از وجود،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 57.7,
   "end": 61.84,
   "text": "چون انای بنده شد لا از وجود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 61.84,
   "end": 66.9,
   "text": "پس چه ماند این بی اندیشه‌ی عنود؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 66.9,
   "end": 69.54,
   "text": "توجه می‌کنید؟ پس چه ماند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 69.54,
   "end": 73.3,
   "text": "این بی اندیشه‌ی عنود؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 73.3,
   "end": 75.66,
   "text": "در تو را چشم است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 75.66,
   "end": 78.24,
   "text": "بگو شادر نگر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 78.24,
   "end": 83.18,
   "text": "بعد الله آخر چه می‌ماند دیگر؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 83.18,
   "end": 85.46,
   "text": "توجه کنید. بعد الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 85.46,
   "end": 90.62,
   "text": "آخر چه می‌ماند دیگر؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 90.62,
   "end": 93.64,
   "text": "توجه کنید. کل شیء حاله الی الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 93.64,
   "end": 97.96,
   "text": "مشم. اون که علی سلام الله علیه کُمیل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 97.96,
   "end": 100.6,
   "text": "رضوان الله علیه گفت که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 100.6,
   "end": 103.34,
   "text": "دیگه صبح تالای شد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 103.34,
   "end": 107.92,
   "text": "الی آخر شنیده‌اید که علی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 107.92,
   "end": 110.08,
   "text": "چنین است یا نشنیده‌اید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 110.08,
   "end": 112.5,
   "text": "نشنیده‌اید؟ پس چه شنیده‌اید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 112.5,
   "end": 115.09,
   "text": "شنیده‌اید اشتباه. توجه کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 115.09,
   "end": 117.0,
   "text": "گفت‌وگو با هم در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 117.0,
   "end": 125.26,
   "text": "اسرار علی سلام الله علیه که کُمیل می‌گفت البته می‌گفت از این گفتن‌ها که معمولی باشد نه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 125.26,
   "end": 127.96,
   "text": "آن می‌گفت نبود. می‌گفت و می‌برد. توجه کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 127.96,
   "end": 131.88,
   "text": "کُمیل می‌گفت با هم بودند، با هم رفته بودند بیرون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 131.88,
   "end": 140.08,
   "text": "و صحبت از اسرار بود و حرکت بود و عوالم بود و مسائلی که بین علی سلام الله علیه و اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 140.08,
   "end": 146.44,
   "text": "صاحب صدر که از نزدیکانش بود و تربیت‌شده‌هاش که کُمیل باشد بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 146.44,
   "end": 149.54,
   "text": "اونجا اون عوالم بود، اون مسائل بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 149.54,
   "end": 152.42,
   "text": "به هر صورت در صحرا و بیابان هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 152.42,
   "end": 159.48,
   "text": "رفتند بیرون شهر. صحبت بود که کُمیل از علی سلام الله علیه سوالی کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 159.48,
   "end": 164.78,
   "text": "بعد اه از ولایت علی سلام الله علیه یک استنطاقی داشت از جوابی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 164.78,
   "end": 167.78,
   "text": "می‌خواست. بالاخره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 167.78,
   "end": 169.9,
   "text": "بیانی بر از کُمیل ازش شروع کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 169.9,
   "end": 172.08,
   "text": "بیانی داشت که حضرت را",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 172.08,
   "end": 177.18,
   "text": "نازل بر گفتازی کرد و حضرت سلام الله علیه شروع کرد مسائل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 177.18,
   "end": 179.52,
   "text": "را. بعد گفت که دیگه صبح،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 179.52,
   "end": 182.26,
   "text": "لفظ گفت و بعد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 182.26,
   "end": 185.68,
   "text": "لفظی به کار برد که خلاصه دیگه صبح آمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 185.68,
   "end": 190.42,
   "text": "دیگه چراغ را خاموش باید کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 190.42,
   "end": 194.82,
   "text": "اینو شنیده بود. باید کرد یعنی این چی بود؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 194.82,
   "end": 197.2,
   "text": "بالاخره یه شبی داره، یه صبحی داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 197.2,
   "end": 200.72,
   "text": "یه صبحی خواهد آمد. اون وقت بیاد که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 200.72,
   "end": 203.7,
   "text": "ربوبیت با اسم و صفورش تجلی می‌کند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 203.7,
   "end": 210.5,
   "text": "این جهان و دنیان بختی است و هر چه حق در وجود انسان چه باشد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 210.5,
   "end": 213.58,
   "text": "ها؟ تجلی می‌کنه و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 213.58,
   "end": 215.46,
   "text": "فرود می‌آید. اون صبح صادقه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 215.46,
   "end": 218.38,
   "text": "صبح صادق که شنیده‌اید اصلش اونجاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 218.38,
   "end": 220.72,
   "text": "و روز قیامت که شنیده‌اید باز معرشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 220.72,
   "end": 222.52,
   "text": "روز الان شبه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 222.52,
   "end": 225.1,
   "text": "الان شبه. روزش کیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 225.1,
   "end": 229.04,
   "text": "اون وقتی که ظهور بشه و این حرف.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 229.04,
   "end": 238.68,
   "text": "خب فرض کنم که مثنوی چند چیز، سطر دیگر هم دارد اینا بخوانم اما باز معنی درستش رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 238.68,
   "end": 241.8,
   "text": "عشق آن شعله است اونجاهائه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 241.8,
   "end": 247.56,
   "text": "پس معلومه کسی که اونجاها رسیده دیگه خبر از خود نمی‌ماند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 247.56,
   "end": 251.44,
   "text": "این مسئله معلوم است چیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 251.44,
   "end": 254.16,
   "text": "و تو اونجاها دیگه باید همان‌طور که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 254.16,
   "end": 262.38,
   "text": "از ائمه وارد است خدا را می‌گه هم افعول هم افعال می‌گه، هم افعال می‌گه هم می‌گه یا غفران.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 262.38,
   "end": 264.28,
   "text": "هر دو گناه خیلی بزرگ است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 264.28,
   "end": 267.06,
   "text": "یا غفران",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 267.06,
   "end": 269.62,
   "text": "عین غفران است. خود غفران است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 269.62,
   "end": 272.58,
   "text": "هم صاحب غفران است و هم غفران",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 272.58,
   "end": 276.2,
   "text": "است. یا غفران. لذات این است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 276.2,
   "end": 277.89,
   "text": "خوب این چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 277.89,
   "end": 285.56,
   "text": "عشق اون شعله است. تو چون در فرود هر چه جز معشوق باقی جمله سود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 285.56,
   "end": 290.36,
   "text": "بود. کی به الله در قحل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 290.36,
   "end": 292.48,
   "text": "غیر اخفرانی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 292.48,
   "end": 296.08,
   "text": "کی به الله در قحل غیر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 296.08,
   "end": 302.82,
   "text": "اخفران. در نگر آخر که بعد از لا چه ماند؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 302.82,
   "end": 306.44,
   "text": "توجه می‌کنید؟ در نگر آخر که بعد از لا چه ماند؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 306.44,
   "end": 310.16,
   "text": "ماند الی الله باقی جمله رخت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 310.16,
   "end": 312.36,
   "text": "شاد باش ای عشق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 312.36,
   "end": 315.5,
   "text": "به شرکت سود ز.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 315.5,
   "end": 318.96,
   "text": "خود همون بود از اولین و آخری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 318.96,
   "end": 322.32,
   "text": "شرک جز از دیده احمر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 322.32,
   "end": 325.82,
   "text": "نبین. شرک جز از دیده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 325.82,
   "end": 328.7,
   "text": "احمر چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 328.7,
   "end": 331.52,
   "text": "نبین. خب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 331.52,
   "end": 335.4,
   "text": "حالا در این با",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 335.4,
   "end": 338.48,
   "text": "ببینید یک گفتم دیدم دو سه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 338.48,
   "end": 341.58,
   "text": "آیه بخوانم. یه دو سه آیه بخوانم براش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 341.58,
   "end": 345.68,
   "text": "نکته این که خود تجلی ربوبیت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 345.68,
   "end": 348.86,
   "text": "با این اسمش با ذوفور",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 348.86,
   "end": 357.32,
   "text": "و در این مرتبه با اسم ذوفورش در این مرتبه برای بنده‌اش، برای سالک خودش مراتب دارد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 357.32,
   "end": 368.08,
   "text": "خودش مراتب دارد. تجلی خدا در مرتبه عالی با اسم ذوفورش برای رسول الله کجا صلوات الله سلام عليه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 368.08,
   "end": 372.98,
   "text": "و برای یک سالک وارسته که در نهایات است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 372.98,
   "end": 381.62,
   "text": "کجا؟ در همین مورد سوم آیه تجلی که می‌تواند او را از ناموشان خود پاک کند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 381.62,
   "end": 387.7,
   "text": "این خودش مراتب داره. خدا یه وقت با اسم غفورش برای رسول الله صلی الله علیه و آله تجلی می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 387.7,
   "end": 390.88,
   "text": "یه وقت برای حضرت ابراهیم سلام الله تجلی قرآن می‌دهد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 390.88,
   "end": 394.42,
   "text": "تجلی می‌کنه. یه وقت هم برای یک صالح بارکه‌ای از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 394.42,
   "end": 400.62,
   "text": "صالحین عادی فاصله از زمین تا آسمان یه فاصله فهم نمی‌آورد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 400.62,
   "end": 403.1,
   "text": "اون استعاره‌شه این چیه؟ ولی هرچه هست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 403.1,
   "end": 408.06,
   "text": "این تجلی ربوبیت با اسم غفور در مراحل عالی است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 408.06,
   "end": 411.06,
   "text": "خب ما وقتی به سوره قرآن می‌رویم در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 411.06,
   "end": 416.48,
   "text": "حضور حضرت ابراهیم سلام الله علیه می‌بینیم که حضرت ابراهیم می‌گه که من امیدوارم که خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 416.48,
   "end": 420.7,
   "text": "مغفرتش را به حال من در قیامت چی بکنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 420.7,
   "end": 423.6,
   "text": "شامل. چه مغفرتی می‌خواد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 423.6,
   "end": 426.74,
   "text": "یعنی خب حضرت ابراهیم سلام الله علیه معصوم بود دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 426.74,
   "end": 428.9,
   "text": "قول معصوم بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 428.9,
   "end": 434.12,
   "text": "همه انبیا. حضرت ابراهیم، اون حضرت ابراهیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 434.12,
   "end": 437.2,
   "text": "اون می‌گه که به آیات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 437.2,
   "end": 444.94,
   "text": "می‌گه که عرض بفرمایید می‌گه که سوره شوری این آیات از افق از قطاری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 444.94,
   "end": 450.14,
   "text": "که قبلاً هم به تناسب‌های دیگر من این آیات را برای شما تلاوت کردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 450.14,
   "end": 453.42,
   "text": "هفتاد و هشت تا هشتاد و سه، هشتاد و دو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 453.42,
   "end": 458.88,
   "text": "که الان باز تلاوت بکنم. ولی فقط برای اون شاهد عرض که هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 458.88,
   "end": 462.32,
   "text": "الذي ابراهیم که می‌گه الذي سلام الله علیه خَلَلَ نِعْمَةَ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 462.32,
   "end": 466.46,
   "text": "وَيَأْخِينِ وَالَّذِي هُوَ يُطْعِمُنِي وَيَأْخِينِ فَإِذَا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 466.46,
   "end": 473.06,
   "text": "مَرِضْتُ فَهَوَ يَشْفِينِ وَالَّذِي يُمِيتُنِي ثُمَّ يُحْيِينِ وَالَّذِي أَسْمَعُ أَنْ يَغْفِرَ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 473.06,
   "end": 475.82,
   "text": "لِي خَطِيئَتِي يَوْمَ الدِّينِ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 475.82,
   "end": 481.76,
   "text": "دقت بکنید و اون خدا که سمع من این است که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 481.76,
   "end": 485.76,
   "text": "خطای مرا در قیامت چی می‌کند؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 485.76,
   "end": 488.14,
   "text": "مشمول غفرانش می‌کند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 488.14,
   "end": 491.96,
   "text": "أَنْ يَغْفِرَ لِي. به من",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 491.96,
   "end": 494.28,
   "text": "ببخشد. حالا به زبان خودمون ببخشد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 494.28,
   "end": 502.74,
   "text": "این دو کیست؟ این دو حالت من به زور به سوی خدا خودمو می‌کشم، سوی اغیار خود راحت می‌روم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 502.74,
   "end": 508.5,
   "text": "اون به سوی خدا کشیده می‌شه به سوی اغیار نمی‌تواند توجه بکند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 508.5,
   "end": 512.88,
   "text": "این دو توجه از من و او از دو ذات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 512.88,
   "end": 518.2,
   "text": "یا از دو کیفیת در دو ذات سرچشمه می‌گیرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 518.2,
   "end": 526.0,
   "text": "ذات علی خصوصیتی دارد سلام الله علیه که این خصوصیت نمی‌گذارد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 526.0,
   "end": 527.98,
   "text": "او به غیر توجه کند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 527.98,
   "end": 534.2,
   "text": "گرچه خود با مجاهدت خود این را به دست آورده و خدا نیز عنایت کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 534.2,
   "end": 537.02,
   "text": "اما ذات من چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 537.02,
   "end": 542.7,
   "text": "ذات من به قصدانه با اکتساب که کردم انحرافی درش، رنگی در ذاتم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 542.7,
   "end": 546.68,
   "text": "تحولی ایجاد کردم که این به سوی بدی کشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 546.68,
   "end": 550.32,
   "text": "پس بدی‌ها را گرفتن تنها کافی نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 550.32,
   "end": 555.12,
   "text": "اون منشاء بدی‌ها را از ذات ما هم برداشتن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 555.12,
   "end": 558.16,
   "text": "ضرورت دارد. اون از عفو است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 558.16,
   "end": 561.74,
   "text": "این از چی؟ این از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 561.74,
   "end": 564.28,
   "text": "عفو است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 564.28,
   "end": 566.9,
   "text": "پس اینو اجمالاً فرقی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 566.9,
   "end": 571.42,
   "text": "در اینجا عرض کردیم باشد، گرچه توضیح غفور",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 571.42,
   "end": 576.66,
   "text": "یا توضیح تجلی ربوبیت با اسم غفور برای صالح",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 576.66,
   "end": 581.9,
   "text": "با این خلاصه روشن نمی‌شود و یه خورده توضیح بالاتر می‌خواد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 581.9,
   "end": 584.8,
   "text": "البته اصلش که با این گفتارها روشن نمی‌شه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 584.8,
   "end": 589.2,
   "text": "بحث‌های طولانی می‌خواد. اما همین‌قدر اجمالاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 589.2,
   "end": 596.36,
   "text": "فرق عفو و غفران را اقلاً اگر موفق به صحبت نبودیم بشناسید، به این نکته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 596.36,
   "end": 600.68,
   "text": "توجه داشته باشید. بنابراین عرض",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 600.68,
   "end": 609.21,
   "text": "کنم که گوشه ما دار مو این است اگر غفران شامل حال انسان نشود،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 609.21,
   "end": 612.94,
   "text": "ببینید شما دیگه اهل ذوق شده‌اید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 612.94,
   "end": 616.42,
   "text": "غفران حال به حال انسان شامل نشود،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 616.42,
   "end": 621.62,
   "text": "اگر تجلی با اسم غفور برای صالح از اول پیش نیاید،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 621.62,
   "end": 624.44,
   "text": "تجلی با اسم عفو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 624.44,
   "end": 626.54,
   "text": "میاد یا نمیاد؟ نمیاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 626.54,
   "end": 630.42,
   "text": "اگر خدا حالا دیگه این نکته رو گفتم توضیح دادم دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 630.42,
   "end": 640.5,
   "text": "سورت بفرمایید. اگر خدا مایه فساد را از ذات من نگیرد، بین من و فساد من فاصله انداختن امر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 640.5,
   "end": 643.04,
   "text": "چیه؟ امر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 643.04,
   "end": 646.5,
   "text": "محال یا ممکنه؟ محاله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 646.5,
   "end": 650.26,
   "text": "دقت بکنید. حالا این دیگه خودتون بیشتر دقت بکنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 650.26,
   "end": 657.34,
   "text": "بین من و اون بدی‌ها بخواهد فاصله بیاندازد، من از اون‌ها رها، اون‌ها را از من جدا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 657.34,
   "end": 665.96,
   "text": "این به این می‌شود که اول این مایه در اینجا اصلاح بشه و الا مایه باقی باشد، اون‌ها از من دست بردار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 665.96,
   "end": 669.66,
   "text": "نمی‌شود. تجلی خدا با اسم عفو، ببینید یکی از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 669.66,
   "end": 675.92,
   "text": "اون اسم اسما هست که گفتم انشاالله تأمل در باره‌ش زیاد می‌کرد، قدرش هم داشته باشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 675.92,
   "end": 680.36,
   "text": "تجلی عفو مترتّب بر تجلی چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 680.36,
   "end": 684.82,
   "text": "غفور است. اینجا هم یک دفعه از دعای امام سجاد را بخوانیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 684.82,
   "end": 689.26,
   "text": "ختام و نصف و فيض الله که فضله تنافس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 689.26,
   "end": 694.3,
   "text": "متنافسون و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 694.3,
   "end": 701.62,
   "text": "فقتدان از جنس هم باهاش نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 701.62,
   "end": 707.0,
   "text": "خب اون می‌گه خدایا من این دفعه تو حالا تضرع‌ها که می‌کنه توبه‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 707.0,
   "end": 709.66,
   "text": "می‌گه لا یضیق النّعیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 709.66,
   "end": 713.48,
   "text": "از دعایی که بعد از نماز شب می‌خواند و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 713.48,
   "end": 715.82,
   "text": "در اون دعا است یادتون باشد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 715.82,
   "end": 719.18,
   "text": "عرض کنم که دعای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 719.18,
   "end": 721.26,
   "text": "سی و دوم است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 721.26,
   "end": 726.84,
   "text": "دعای سی و دوم باز چون یه شرحی که من دارم فعلاً از چیز ردم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 726.84,
   "end": 736.26,
   "text": "که دوستان شرح کرده، دعای سی و دوم از صحیفه سجادیه و دعایی است که بعد از نماز شب هر شب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 736.26,
   "end": 738.66,
   "text": "امام سجاد سلام الله علیه می‌خواند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 738.66,
   "end": 740.98,
   "text": "در اون دعا یک جمله‌اش اینه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 740.98,
   "end": 748.98,
   "text": "اونجا که طلب مغفرت میکنه میگه به هذا مقام العائذ بك خدايا اين مقام كسى است كه به تو پناه آورده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 748.98,
   "end": 751.48,
   "text": "و محل المعترف لك",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 751.48,
   "end": 755.88,
   "text": "محل كسى است كه در برابر تو اعتراف به قصورات خود دارد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 755.88,
   "end": 758.86,
   "text": "فلا يزيل عنى عفوك پس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 758.86,
   "end": 763.06,
   "text": "عفو تو از من دور نباشد و لا يفسلن عنى عفوك عفو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 763.06,
   "end": 765.7,
   "text": "تو از من كنار نباشد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 765.7,
   "end": 768.08,
   "text": "و لا أكن میبینید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 768.08,
   "end": 771.54,
   "text": "و لا أكن أخيب عبادك التائبين",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 771.54,
   "end": 774.82,
   "text": "من از اون‌ها نباشم از اون توبه کننده‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 774.82,
   "end": 778.66,
   "text": "خوب دقت کنیده‌ها. تو همان دور جاهلیت یکیش از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 778.66,
   "end": 781.24,
   "text": "درد و مافک موضوع ما بیرون بره ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 781.24,
   "end": 789.64,
   "text": "میگه که خدايا از تو می‌خواهم از اون توبه کننده‌ها نباشم که ضرر می‌برند و نفعی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 789.64,
   "end": 792.3,
   "text": "نمی‌برند. دقت کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 792.3,
   "end": 795.68,
   "text": "توبه تنها نیست. که من",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 795.68,
   "end": 797.29,
   "text": "برگشتم این تنها نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 797.29,
   "end": 803.37,
   "text": "این حرفه. تو دور جاهلیت یکیش اینجوری جا به ما فکر می‌کردیم من برگشتم دیگه تمام شد کار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 803.37,
   "end": 807.08,
   "text": "او باید برگردد به سوی ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 807.08,
   "end": 811.77,
   "text": "توجه می‌کنید؟ برای اینکه قرآن میگه تو برگشتی باید او برگردد به سوی تو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 811.77,
   "end": 813.66,
   "text": "اصل قضیه چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 813.66,
   "end": 817.82,
   "text": "برگشت اوست به رحمتش و فضلش و عفوش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 817.82,
   "end": 820.03,
   "text": "این برگشتن یعنی تو مقدمه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 820.03,
   "end": 824.22,
   "text": "اگر اون نتیجه را به دنبال خود آورد بعد هذا الا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 824.22,
   "end": 826.32,
   "text": "نه. میگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 826.32,
   "end": 833.06,
   "text": "که خدايا نباشم و لا أكن از تو می‌خواهم نباشم أخيب عبادك التائبين",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 833.06,
   "end": 837.0,
   "text": "اون بندگان تائبت که ضرر می‌برند و خسار می‌برند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 837.0,
   "end": 841.64,
   "text": "توبه‌شون مورد قبول تو نمی‌شود از اون‌ها نباشم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 841.64,
   "end": 849.32,
   "text": "و لا أغنى ترفضك العاملين و اون‌ها که به سوی تو می‌آورند ولی مأیوس می‌شوند از اون‌ها نباشم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 849.32,
   "end": 857.76,
   "text": "بعفرني برای اینکه از تو می‌خواهم منو مشمول مغفرتت بکن إنك خير الغافرين تو خير الغافرين هستی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 857.76,
   "end": 862.38,
   "text": "یعنی مشمول مغفرتت کردی دیگه عفو تو به حال من چه می‌شود؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 862.38,
   "end": 864.62,
   "text": "به حال من شامل می‌شود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 864.62,
   "end": 866.58,
   "text": "دقت کردید؟ می‌ترسم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 866.58,
   "end": 869.66,
   "text": "میگم می‌ترسم. توبه کن. توبه کرده‌ام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 869.66,
   "end": 871.71,
   "text": "مورد عفو تو قرار نگیرم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 871.71,
   "end": 877.02,
   "text": "برای اینکه منو مشمول مغفرتت قرار بده که عفت تو را به دنبالش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 877.02,
   "end": 879.94,
   "text": "خواهد آمد. اونجا گفتم اجل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 879.94,
   "end": 882.54,
   "text": "خدا با اسم عفو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 882.54,
   "end": 885.5,
   "text": "بعد از اجل خدا با اسم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 214,
   "start": 885.5,
   "end": 892.18,
   "text": "غفور است. خب بحث را هم در اینجا تمام می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 215,
   "start": 892.18,
   "end": 894.24,
   "text": "انشاالله امیدواریم که ...",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 216,
   "start": 894.24,
   "end": 896.39,
   "text": "حالا بحث ما تحلیلی است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 217,
   "start": 896.39,
   "end": 899.76,
   "text": "از اینجا شما برای خودتون دستورالعمل‌هایی بگیرید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 218,
   "start": 899.76,
   "end": 901.84,
   "text": "مخصوصا باز در آخر تذکر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 219,
   "start": 901.84,
   "end": 910.66,
   "text": "میدم هر کسی شروع به سلوک کرد، یکی از برنامه‌های اساسیش اگر تمام اورادش در این خلاصه نشود اول باید یکی از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 220,
   "start": 910.66,
   "end": 914.5,
   "text": "و جزئی از برنامه‌هاش طلب عفو و مغفرت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 221,
   "start": 914.5,
   "end": 917.08,
   "text": "کلاً با اصرار، با تضرع،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 222,
   "start": 917.08,
   "end": 923.26,
   "text": "بی جاهلیت، با شعور، با توجه تا اینها را به عنوان یه یه جزو جدید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 223,
   "start": 923.26,
   "end": 928.42,
   "text": "شروع میکنید به استغفار و طلب عفو و مغفرت با تضرع",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 224,
   "start": 928.42,
   "end": 931.56,
   "text": "و با اصرار. اینجوری که من و شما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 225,
   "start": 931.56,
   "end": 936.22,
   "text": "نیست. که یه راه به هر کسی هم این آسانی نمیدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 226,
   "start": 936.22,
   "end": 938.48,
   "text": "اما زیاد تضرع کردی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 227,
   "start": 938.48,
   "end": 942.3,
   "text": "و اصرار کردی به حال گریه برون نخواهد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 228,
   "start": 942.3,
   "end": 950.38,
   "text": "شد ولی شبیه حال گریه باشه با تضرع به ترسی بالاخره یواش یواش هم گریه میاد مخصوصا آثارش را انشاالله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 229,
   "start": 950.38,
   "end": 952.42,
   "text": "حفظشون خواهد کرد و از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 230,
   "start": 952.42,
   "end": 955.32,
   "text": "حضور خودتون می‌بینید چه وقت توبه پذیر شوید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 231,
   "start": 955.32,
   "end": 958.26,
   "text": "توجه. مخصوصا به سجده بیفتید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 232,
   "start": 958.26,
   "end": 966.38,
   "text": "و اگر ناراحتی کمر چیزی نذاره یعنی نذارید سجده‌های طولانی طلب عفو و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 233,
   "start": 966.38,
   "end": 971.1,
   "text": "مغفرت‌ها و اگر خواست که باز یاد خود بیایید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 234,
   "start": 971.1,
   "end": 975.22,
   "text": "باز به توصیه من عمل کنید و اون اینکه دعاهای طیبه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 235,
   "start": 975.22,
   "end": 977.78,
   "text": "را مخصوصا و دعاهای دیگر را",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 236,
   "start": 977.78,
   "end": 980.42,
   "text": "بخوانید. می‌بینید قرآن سجاد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 237,
   "start": 980.42,
   "end": 985.96,
   "text": "چیه؟ همین دعایی که بعد نماز شب مخصوصا برای یاد کردن، برای این خودآمدن، برای این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 238,
   "start": 985.96,
   "end": 989.44,
   "text": "تنزيه شدن بخوانید. دعاهای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 239,
   "start": 989.44,
   "end": 993.64,
   "text": "دیگر را بخوانید. شما همون وقت طلب مغفرت که درخواست می‌کنید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 240,
   "start": 993.64,
   "end": 999.18,
   "text": "اونقدر تضرع اون زبان شما باشد بخوانید تا نشنوند حال شما را.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 241,
   "start": 999.18,
   "end": 1003.64,
   "text": "اگر خدا رحیم نیابد بعد رسول الله صلوات الله علیه دلش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 242,
   "start": 1003.64,
   "end": 1005.18,
   "text": "میشکند. شفاعت می‌کند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 243,
   "start": 1005.18,
   "end": 1010.5,
   "text": "belki علی سلام الله علیه این حالت از تو را می‌یابد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 244,
   "start": 1010.5,
   "end": 1013.04,
   "text": "کردی این این اتفاق همش نمی‌افته و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 245,
   "start": 1013.04,
   "end": 1019.3,
   "text": "اینجوریه. و ما قبل از این مسئله را ساده گرفتیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 246,
   "start": 1019.3,
   "end": 1027.0,
   "text": "و امیدواریم انشاالله that our God شما اثر کند به همه ما را از گناهان انشاالله نجات دهد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 247,
   "start": 1027.0,
   "end": 1033.36,
   "text": "این از دعاهای خود شما و سجاده شما باشد که خاص ما را خدا از رحمت بیابد و خلاص",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 248,
   "start": 1033.36,
   "end": 1036.46,
   "text": "کند. ما عفو بده انشاالله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 249,
   "start": 1036.46,
   "end": 1039.17,
   "text": "السلام علیکم و رحمه الله. السلام علیکُم و رحمه الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}