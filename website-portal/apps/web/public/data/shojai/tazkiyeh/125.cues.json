 "chapters": [
  {
   "index": 0,
   "title": "اعوذ بالله السمیع العلیم من الشیطان الرجیم. بسم الله الرحمن الرحیم.",
   "start": 8.08,
   "end": 642.74
  },
  {
   "index": 1,
   "title": "## مسیر تکاملِ تصویرِ کشف ابصاری",
   "start": 642.74,
   "end": 788.61
  },
  {
   "index": 2,
   "title": "## تفصیلِ آفتاب و ماهِ مثالی",
   "start": 788.61,
   "end": 1172.57
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.68,
   "end": 3.76,
   "text": "اعوذ بالله السميع العليم من الشيطان الرجيم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 3.76,
   "end": 5.64,
   "text": "بسم الله الرحمن الرحيم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 5.64,
   "end": 13.08,
   "text": "منظورم که البته مسائل که در جلسه گذشته و در جلسات قبل گفته بودم در ارتباط",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 13.08,
   "end": 19.82,
   "text": "با مرحله کشف اون‌ها را لابد در نظر دارید که در روشن شدن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 19.82,
   "end": 22.68,
   "text": "مقصد امروز ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 22.68,
   "end": 27.82,
   "text": "کاملاً لزوم دارد و مؤثر است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 27.82,
   "end": 32.02,
   "text": "کشف سرّی که اصل معنیش این بود که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 32.02,
   "end": 36.14,
   "text": "برای سالک آنچه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 36.14,
   "end": 40.56,
   "text": "برای عامه مردم دیده نمی‌شود،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 40.56,
   "end": 46.68,
   "text": "دیده بشود. بعضی از مخفيات یعنی ابعادی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 46.68,
   "end": 50.82,
   "text": "دیدنی‌ست ولی نمی‌بینند عامه مردم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 50.82,
   "end": 53.86,
   "text": "سالک ببیند. این دیدن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 53.86,
   "end": 59.2,
   "text": "دیدن پشت پرده، دیدن دیدنی‌های پشت پرده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 59.2,
   "end": 61.78,
   "text": "حکم کشف سرّی‌ست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 61.78,
   "end": 64.06,
   "text": "و اما این مراتب دارد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 64.06,
   "end": 70.04,
   "text": "مراتبش را تا حدودی من در این جلسه صحبت می‌کنم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 70.04,
   "end": 75.0,
   "text": "تقریباً با چه ترتیب شروع می‌کند و به چه صورت پیش می‌رود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 75.0,
   "end": 76.68,
   "text": "یه تصویری عرض می‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 76.68,
   "end": 79.74,
   "text": "تصویر کلی‌ست، یک بیان کلی‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 79.74,
   "end": 82.6,
   "text": "البته حقیقت است اما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 82.6,
   "end": 90.6,
   "text": "این که عرض می‌کنم کلی‌ست منظورم این است که جزئیات و ابعاد مختلف قضیه و همچنین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 90.6,
   "end": 98.42,
   "text": "خصوصیات که در برای هر کدام از سالکین هست، این‌ها یک مسائل جداگانه‌ست و نمی‌شود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 98.42,
   "end": 104.96,
   "text": "در صحبت و گفت‌وگو اون‌ها را تمام کرد یا نمی‌شود اصلاً به گفتار بیاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 104.96,
   "end": 109.14,
   "text": "سلام ورحمت الله. در خیلی جاها الفاظ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 109.14,
   "end": 112.58,
   "text": "ناقص است و خود مسئله اصلاً مفصل است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 112.58,
   "end": 117.38,
   "text": "اما این تصویری که عرض می‌کنم یعنی این بیان کلی که عرض می‌کنم به جای خود حقیقت است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 117.38,
   "end": 122.17,
   "text": "برای بعضی‌ها به این ترتیب که الان توضیح خواهم داد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 122.17,
   "end": 125.64,
   "text": "به صورت کلی باز عرض می‌کنم کشف سرّی پیش می‌آید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 125.64,
   "end": 131.12,
   "text": "منظور روشن شدن مراتب کشف سرّی‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 131.12,
   "end": 135.78,
   "text": "در مراحل اولیه‌ اولیه یعنی اونجا که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 135.78,
   "end": 138.62,
   "text": "انوار در قلب سالک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 138.62,
   "end": 142.64,
   "text": "تجلی کرده کمتر منتها خیلی کم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 142.64,
   "end": 149.7,
   "text": "و این انوار در عدد بسیار محدودی که در قلب سالک متجلی شده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 149.7,
   "end": 161.8,
   "text": "در بصر سالک هم به ظهور رسیده باشد و از بصر بالاتر برخوردار باشد که طبعا کشف شروع می‌شود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 161.8,
   "end": 165.86,
   "text": "در مراحل ابتدایی اولیه‌ کاملاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 165.86,
   "end": 173.1,
   "text": "سالکین بعضی از قطعات نوری را می‌بینند، انوار می‌بینند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 173.1,
   "end": 181.3,
   "text": "این انوار را همین طور هفته گذشته مسئله چشم ماده و مسئله بصر بالاتر و همچنین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 181.3,
   "end": 185.66,
   "text": "حواس بالاتر را توضیح دادم که این‌ها چگونه وحدت پیدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 185.66,
   "end": 190.42,
   "text": "می‌کند در مراتب پایین‌تر با همین حواس یا غالب بر این حواس می‌شود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 190.42,
   "end": 195.0,
   "text": "این‌ها را توضیح دادم و طبعا اون‌ها را هم به نظر بیارید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 195.0,
   "end": 199.68,
   "text": "سالکی که در مراحل اولیه انوار می‌بیند،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 199.68,
   "end": 203.06,
   "text": "نورها می‌بیند یعنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 203.06,
   "end": 206.75,
   "text": "در همین عالم به ظاهر این در دید خودش اینجوری‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 206.75,
   "end": 211.68,
   "text": "در حالت بیداری انواری می‌بیند در شکل‌های مختلف.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 211.68,
   "end": 219.1,
   "text": "گاهی در قطعه مثلاً دایره‌ای می‌بیند، گاهی به صورت نقطه‌های روشن می‌بیند یعنی مانند ستاره‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 219.1,
   "end": 224.2,
   "text": "گاهی به صورت شکل دیگر قطعه نوری را می‌بیند، گاهی هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 224.2,
   "end": 227.58,
   "text": "کل اون جایی را که هست نور می‌بیند در اونجا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 227.58,
   "end": 232.12,
   "text": "اما انوار را هم باز به اقتضای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 232.12,
   "end": 238.24,
   "text": "اون خصوصیات که در درون سالک دارد در رنگ‌های مختلف می‌بیند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 238.24,
   "end": 240.5,
   "text": "گاهی مثلاً سفید می‌بیند،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 240.5,
   "end": 243.48,
   "text": "گاهی سبز می‌بیند، گاهی سرخ می‌بیند،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 243.48,
   "end": 246.7,
   "text": "گاهی به نقشه‌ای می‌بیند، گاهی زرد می‌بیند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 246.7,
   "end": 248.76,
   "text": "این‌ها هم هیچ‌کدام بی‌حساب نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 248.76,
   "end": 251.71,
   "text": "البته دیگه حساب‌های این‌ها را نمی‌شود تشریح کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 251.71,
   "end": 255.54,
   "text": "خیلی طولانی‌ست و خیلی‌هاش هم نگفته‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 255.54,
   "end": 257.27,
   "text": "نه اینکه بی‌حساب است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 257.27,
   "end": 263.42,
   "text": "یعنی همین طور مثلاً نور به رنگ آبی در میاد یا همین طور به رنگ سبزی یا در میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 263.42,
   "end": 267.78,
   "text": "نه، در هر رنگی حکایتی، حکایت‌هایی هست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 267.78,
   "end": 270.42,
   "text": "و همه‌اش هم می‌رسد به خود سالک.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 270.42,
   "end": 273.83,
   "text": "در اکثر مواقع نه به غیر سالک.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 273.83,
   "end": 282.58,
   "text": "یعنی خصوصیات درونی روحی سالک است که نور را در رنگ‌های مختلف نشان می‌دهد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 282.58,
   "end": 289.34,
   "text": "یا نور با رنگ‌های مختلف تجلی می‌کند و همچنین اون اشکال هم حساب دارد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 289.34,
   "end": 297.04,
   "text": "مثلاً به شکل دایره‌ای ببیند، به شکل مستطیل ببیند، قطعات نوری مانند ستاره‌ها ببیند یا جهت را کلاً نوری ببیند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 297.04,
   "end": 300.84,
   "text": "این‌ها هم باز خصوصیات خود سالک مربوط است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 300.84,
   "end": 303.8,
   "text": "در مراحل اولیه اینجور است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 303.8,
   "end": 306.76,
   "text": "در حالت بیداری گاهی حالتی پیش میاد این طور می‌بیند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 306.76,
   "end": 310.11,
   "text": "خارج از اختیارم هست. یعنی اختیاری نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 310.11,
   "end": 315.38,
   "text": "در مراحل ابتدایی وقتی این‌ها را می‌بیند این طور نیست خودش دلش خواست ببیند در آن مثلاً.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 315.38,
   "end": 317.68,
   "text": "نه، همین طور بی‌اختيار پیش میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 317.68,
   "end": 323.02,
   "text": "یا در مواقع ذکر که به ظاهر به حساب خودش هم مشغول ذکر است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 323.02,
   "end": 330.83,
   "text": "یا در مواقع عادی که به ظاهر مشغول ذکر نیست طبق محاسبات معمولی حالت عادی‌ست طبق حساب‌های مربوط.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 330.83,
   "end": 336.46,
   "text": "با همین که میگم طبق حساب‌های معمولی برای اینکه توجه داشته باشید که این‌ها طبق حساب‌های",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 336.46,
   "end": 340.01,
   "text": "معمولی اینجوری‌ست و الا همه‌اش حساب شده‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 340.01,
   "end": 344.42,
   "text": "به ظاهر در حال عادی‌ست اما نور می‌بیند دفعةً.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 344.42,
   "end": 348.66,
   "text": "برو در جمعی نشستی و هر نوری می‌بیند در شکل خاصی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 348.66,
   "end": 357.5,
   "text": "این‌ها در مراحل ابتدایی، ابتدایی کاملاً اولیه برای سالک در کشف سرّی پیش میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 357.5,
   "end": 365.3,
   "text": "فراموش نکنید که قبلاً گفتم معنیش این نیست که هر سالکی ولو موفق باشد این مسائل همین طور براش شروع می‌شود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 365.3,
   "end": 368.76,
   "text": "گفتم قبلاً خصوصیات سالکی متفاوت است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 368.76,
   "end": 371.58,
   "text": "برای بعضی از سالکین این مسائل لوک پیش میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 371.58,
   "end": 375.86,
   "text": "کسانی هستند که اصلاً از کشف نه از مراحل ابتدایی‌اش و از نه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 375.86,
   "end": 381.36,
   "text": "از مراتب بالاترش به لحاظ خیلی عللی که هست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 381.36,
   "end": 385.32,
   "text": "کشف را ندارند در اینجا یعنی کشف براشون پیش نمیاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 385.32,
   "end": 391.06,
   "text": "و رو صالح موفقیم هست و رو مدارجی را هم طی کرده مراحل را طی کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 391.06,
   "end": 398.18,
   "text": "حتی می‌شود کسانی کاملاً موفق باشند و دارای منزلت‌های خیلی بالا باشند در نهایت فرا بگیرند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 398.18,
   "end": 406.36,
   "text": "و اصلاً از این مسائل مشاهدات و مکاشفات در حیات دنیوی برای آنها اصلاً ظهوری نداشته باشد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 406.36,
   "end": 410.46,
   "text": "ظهور نداشته باشد، تجلی نکند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 410.46,
   "end": 413.02,
   "text": "خب این نکته را در وسط گفتم که اشتباه نشود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 413.02,
   "end": 416.3,
   "text": "یعنی فکر نکنید برای همه این مسائل پیش میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 416.3,
   "end": 418.05,
   "text": "اصلاً معیار اینها نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 418.05,
   "end": 422.32,
   "text": "بعد در خلال عرایضم عرض خواهم کرد و توضیح خواهیم داد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 422.32,
   "end": 425.12,
   "text": "اجمالاً عرض بکنم که اینها معیار نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 425.12,
   "end": 430.84,
   "text": "معیار موفقیت یک صالح انطباقش هست با موازین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 430.84,
   "end": 438.4,
   "text": "همیشه صالح موظف است خودش را منطبق با موازین بکند که چقدر منطبق است و چقدر نه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 438.4,
   "end": 442.68,
   "text": "چه مشاهدات و مکاشفاتی باشد، چه نباشد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 442.68,
   "end": 448.2,
   "text": "اصلاً کسی که اینها را معیار قرار بدهد در همان اول به ضلالت افتاده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 448.2,
   "end": 451.62,
   "text": "برای اینکه خیلی‌ها از همین طریق به ضلالت افتاده‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 451.62,
   "end": 458.04,
   "text": "مثلاً خیلی‌ها را شما الان هم اگر بعد از این مطلب یادتان باشد، چشما باشید خواهید دید و می‌بینید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 458.04,
   "end": 461.74,
   "text": "و اصلاً شاید هم دیده‌اید خیلی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 461.74,
   "end": 468.23,
   "text": "با همین مثلاً کشف به اصطلاح کشف ابتدائی و سایر کلماتی که الان به آنها گفتم فکر می‌کنند چیزی هستند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 468.23,
   "end": 473.98,
   "text": "در صورتی که اگر همین آدم خودش منصفانه اگر البته معرفت داشته باشد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 473.98,
   "end": 478.24,
   "text": "اگر علم داشته باشد که موازین در سلوک چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 478.24,
   "end": 483.94,
   "text": "قرآن چه می‌فرماید؟ حضرات معصومین صلوات الله علیهم چه بیان فرموده‌اند؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 483.94,
   "end": 486.6,
   "text": "صالح باید چگونه باشد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 486.6,
   "end": 489.56,
   "text": "در مراحل مختلف چه خصوصیات باید داشته باشد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 489.56,
   "end": 493.48,
   "text": "اگر به اینها معرفت داشته باشد، خودش حال خودش را",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 493.48,
   "end": 499.09,
   "text": "با این موازین تطبیق کند، می‌بیند هیچ یک از موازین به خودش تطبیق نمی‌کند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 499.09,
   "end": 506.44,
   "text": "یک فرد عامی، مؤمن عامی است و فقط یک سلسله بعضی از اوراد و ادعیه را پراکنده گفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 506.44,
   "end": 511.78,
   "text": "دیگه نه از ترجیحی، نه از مراحل ایمان، نه از مراحل توحید خبری نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 511.78,
   "end": 516.42,
   "text": "فقط همین قدر بعضی از حالا احکام را اشتباه کرده واجبات رو انجام داده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 516.42,
   "end": 519.56,
   "text": "چند تا هم ذکر برای خودش ورز کرده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 519.56,
   "end": 526.36,
   "text": "و از اینها می‌بینه و بعد فکر می‌کند که به جایی رسیده در صورتی که اگر موازین را بداند منطبق بکند می‌بیند که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 526.36,
   "end": 530.14,
   "text": "اولین میزان که عبارت است از غفلت ور بودن در هواها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 530.14,
   "end": 533.82,
   "text": "کلاً به اصطلاح با این شخص و با",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 533.82,
   "end": 535.48,
   "text": "هواهای شخص مخالفه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 535.48,
   "end": 537.52,
   "text": "اصلاً راهی تعیین نکرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 537.52,
   "end": 542.76,
   "text": "توجه می‌کنید؟ پس نباید دیگر نور اینها را معیار قرار بدید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 542.76,
   "end": 549.08,
   "text": "خوب دقت بکنید و اگر کسی را اینجور در اشتباه و ضلالت دیدید فوراً بهش تذکر بدید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 549.08,
   "end": 553.96,
   "text": "میزان قرآن است. خود خداوند تعالی می‌فرماید که ما میزان فرستادیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 553.96,
   "end": 556.98,
   "text": "شما باید با این خودتان را تطبیق کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 556.98,
   "end": 560.84,
   "text": "و الّا خیلی از افراد من که خیلی دیده‌ام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 560.84,
   "end": 565.46,
   "text": "و خیلی هم عرض می‌کنم به معنی کلمه‌ عرض می‌کنم و نه اینکه به اصطلاح",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 565.46,
   "end": 567.51,
   "text": "یک بحث مبالغه هم هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 567.51,
   "end": 570.4,
   "text": "خیلی دیدم کسانی که از همین انواع کلاگه می‌بینم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 570.4,
   "end": 579.5,
   "text": "ولی اگر بخواهیم طبق موازین روشون حساب بکنیم نمی‌شه اصلاً کلمه صالح را به عنوان مصطلح براش اطلاق کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 579.5,
   "end": 581.4,
   "text": "خب اینها میزان نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 581.4,
   "end": 584.82,
   "text": "در وسط عرض کردم بعداً باز توضیحاتی عرض می‌کنم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 584.82,
   "end": 589.32,
   "text": "و کسی تکرار می‌کنم اگر اینها را برای خودش میزان یعنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 589.32,
   "end": 597.93,
   "text": "معیار قرار بدهد و با اینها خودش را بسنجد و بعد بگوید موفقم یا ناموفق این در ضلالت است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 597.93,
   "end": 600.92,
   "text": "و حالا ضلالت‌های اینجوری‌ش خیلی مهم نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 600.92,
   "end": 604.64,
   "text": "ضلالت‌های بالاتری دارد که من اگر انشاالله خدا خواسته به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 604.64,
   "end": 609.94,
   "text": "ابواب فرعی ناخ شیطانی رسیدیم اونجا مطالبی بیشتر عرض می‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 609.94,
   "end": 614.54,
   "text": "عرض کنم که خب مرحله اولش به این صورت شروع می‌شود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 614.54,
   "end": 616.84,
   "text": "این البته خب تجلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 616.84,
   "end": 620.94,
   "text": "انواع حق است در کشف صغری براش روشن می‌شود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 620.94,
   "end": 624.84,
   "text": "بشارت‌آمیز است همین و تجلی نور",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 624.84,
   "end": 630.18,
   "text": "محمدی صلی الله علیه و آله وسلم است و بشارت‌آمیز است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 630.18,
   "end": 640.81,
   "text": "و عرض کنم تجلی، تجلی نور همه ائمه معصومین است و بالاخره نور ولایت است و نور حق است، صد درصد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 640.81,
   "end": 644.5,
   "text": "عرض کنم که ابتدا اینجوری‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 644.5,
   "end": 648.48,
   "text": "حالا در مسیر تکاملش من تصویر می‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 648.48,
   "end": 653.72,
   "text": "ابتدا، ابتدا البته من حالت بیداریش رو گفتم در رویا هم پیش میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 653.72,
   "end": 657.06,
   "text": "یعنی در رویا منظورم از رویا این است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 657.06,
   "end": 659.91,
   "text": "که وقتی که می‌خواد خواب بگیرد، اون وقته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 659.91,
   "end": 669.42,
   "text": "در واقع بین حالت بیداری و بین حالت خواب اینجور مشاهد-- کشف ابصاری در ابتدا که الان عرض کردم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 669.42,
   "end": 674.4,
   "text": "اون وقتی می‌خواد خواب بگیرد هم برای بعضی از صالحین پیش میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 674.4,
   "end": 681.04,
   "text": "اما در خود خواب که در واقع خواب ببیند هم پیش میاد اون چندان مهم نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 681.04,
   "end": 682.7,
   "text": "خب یعنی اون دیگه هیچ مهم نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 682.7,
   "end": 684.68,
   "text": "یعنی زیاد نمیشه روش حساب کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 684.68,
   "end": 687.94,
   "text": "باز اینها در حد یکسری پیش‌رهایی دارد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 687.94,
   "end": 691.88,
   "text": "خب حالا که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 691.88,
   "end": 702.04,
   "text": "بنا شد این کشف صغری توفیقات الهی است و پرده‌ها و حجوب از قلب دارد یواش یواش کنار میره و خب عرض",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 702.04,
   "end": 709.52,
   "text": "کردم هرچه قلب از حجاب بیرون بیاد این انواع تجلی‌ش بیشتر و طبعا چشم کامل‌تر خواهد بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 709.52,
   "end": 715.34,
   "text": "صالح اگر در مسیرش موفق است و حجوب از قلبش بیشتر کنار رفت، تجلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 715.34,
   "end": 718.44,
   "text": "نور در باطن در قلب بیشتر شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 718.44,
   "end": 722.3,
   "text": "این نور بیشتر در بصر هم بیشتر ظهور کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 722.3,
   "end": 725.14,
   "text": "اون وقت به اصطلاح",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 725.14,
   "end": 727.88,
   "text": "عرض کنم که کشف‌های بالاتر پیش میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 727.88,
   "end": 730.34,
   "text": "در کشف ابصاری صحبت می‌کنیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 730.34,
   "end": 737.8,
   "text": "ها. کشف‌های بالاتر پیش میاد یعنی چیزهای بالاتر را تقریباً معنی‌دارتر را می‌بیند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 737.8,
   "end": 742.25,
   "text": "اون اوائل که عرض کردم زیاد معنی نداشت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 742.25,
   "end": 745.79,
   "text": "اونم باز نه، نه به این معنا که نا حساب نداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 745.79,
   "end": 748.31,
   "text": "گفتم حساب دارد چرا رنگش اینجوره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 748.31,
   "end": 750.27,
   "text": "نور چرا زرده‌ست، چرا سرخ است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 750.27,
   "end": 756.49,
   "text": "همه‌ش معنی دارد ولی زیاد حکایت کننده آنچنان نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 756.49,
   "end": 758.83,
   "text": "مثلاً چی می‌بیند؟ حالا در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 758.83,
   "end": 762.87,
   "text": "مراحل بالاتر فرضاً آفتاب می‌بیند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 762.87,
   "end": 768.83,
   "text": "نه این آفتاب را. یعنی دفعه‌ first یک آفتاب خیلی پرنور، خیلی روشن را می‌بیند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 768.83,
   "end": 772.43,
   "text": "در کشف می‌بیند ها نه این آفتاب را.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 772.43,
   "end": 775.93,
   "text": "ماه می‌بیند. یعنی دقیقاً 월 ماه می‌بیند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 775.93,
   "end": 781.79,
   "text": "حالا چشمش بسته باشد، چشمش باز باشد، در حالت بیداری باشد، در حالتی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 781.79,
   "end": 787.39,
   "text": "بین النوم و الیقظه است از فرضاً باشد یا در خواب باشد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 787.39,
   "end": 789.99,
   "text": "یعنی در خواب کامل، در خواب دیدن باشد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 789.99,
   "end": 793.85,
   "text": "آفتاب می‌بیند، ماه می‌بیند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 793.85,
   "end": 798.17,
   "text": "این‌ها خب تقریباً می‌شود گفت از اون اولی کامل‌تره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 798.17,
   "end": 801.53,
   "text": "یعنی آفتاب می‌بینه نه شع دایره نوری غیر از اون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 801.53,
   "end": 809.69,
   "text": "دقیقاً یک آفتاب خیلی و طوریکه به این آفتاب نمی‌شود نظر کرد و دقت کرد از اون هم نورانی‌تر، روشن‌تر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 809.69,
   "end": 813.6,
   "text": "و از نگاه کردن خیلی سخت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 813.6,
   "end": 817.55,
   "text": "این یه خورده کامل‌تر از قبل است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 817.55,
   "end": 820.77,
   "text": "بعد این آخ-- حالا یه خورده هم کامل‌تر شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 820.77,
   "end": 827.23,
   "text": "یعنی کا-- یعنی اگر بنا شد کشف صاری دوباره از کمال بیشتری برخوردار بشود،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 827.23,
   "end": 834.93,
   "text": "آفتاب را اینطور می‌بیند که آفتاب می‌بیند که همه جا را روشن کرده، دیگه هیچی نمی‌بیند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 834.93,
   "end": 840.05,
   "text": "یعنی در اون صورت اول چیزای دیگرم می‌دید، ولی آفتاب می‌دید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 840.05,
   "end": 845.33,
   "text": "ولی گوشه‌ای مثل اینکه. همینطور که افقی مثلاً نگاه می‌کنه آفتاب می‌بینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 845.33,
   "end": 850.71,
   "text": "ولی گاه این آفتاب را طور می‌بیند که همه جا را دیگه نور آفتاب گرفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 850.71,
   "end": 855.21,
   "text": "چیزی از این اشیا که در حالت عادی می‌بیند در اون حال نمی‌بیند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 855.21,
   "end": 858.43,
   "text": "دری، دیواری، کسی، موجودی نمی‌بیند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 858.43,
   "end": 860.89,
   "text": "نور آفتاب را می‌بیند که باقی چه نمی‌بیند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 860.89,
   "end": 864.01,
   "text": "این کامل‌تر از اون‌هاست و این خوبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 864.01,
   "end": 868.17,
   "text": "این جاها که دیگه هیچی نبیند در اون مقام کشف،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 868.17,
   "end": 870.35,
   "text": "فقط نور بی‌نهایت می‌بیند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 870.35,
   "end": 874.61,
   "text": "آفتاب یا در این بین می‌بیند که این آفتاب باز آفتاب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 874.61,
   "end": 877.89,
   "text": "شمس ولایت است و تجلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 877.89,
   "end": 881.85,
   "text": "نور الهی در مرتبه بالاتر از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 881.85,
   "end": 886.21,
   "text": "اونم که شمس ولایت هم هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 886.21,
   "end": 890.75,
   "text": "خب. یه خورده هم کامل‌تر شد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 890.75,
   "end": 897.05,
   "text": "این یعنی نور اگر دیگه نوری کامل‌تر شد همین در این مثلی که عرض می‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 897.05,
   "end": 904.15,
   "text": "آفتاب را که می‌بیند، همه جا را که نوری می‌بیند و هیچی نمی‌دید اول، یه خورده هم کامل‌تر شد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 904.15,
   "end": 906.59,
   "text": "اونوقت عا-عالم دیگری می‌بینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 906.59,
   "end": 908.99,
   "text": "یعنی عالمی می‌بیند اول",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 908.99,
   "end": 917.79,
   "text": "همین آفتاب و نور همه جا را آکنده حالت بیداری عرض می‌کنم اینو و هیچی هم نمی‌بیند و بعد عالم دیگر می‌بیند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 917.79,
   "end": 922.57,
   "text": "یعنی موجودات، باغ‌ها، نمی‌دونم پرنده‌ها،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 922.57,
   "end": 927.95,
   "text": "چشمه‌ها یا احیاناً به اصطلاح دریاها همسال این‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 927.95,
   "end": 930.69,
   "text": "و یا حالا اینا دیگه متفاوت می‌شود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 930.69,
   "end": 934.27,
   "text": "بناها عرض کنم که درختان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 934.27,
   "end": 936.27,
   "text": "و موجودات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 936.27,
   "end": 942.94,
   "text": "به شکل انسان یعنی انسان‌ها در واقع منتها انسان به اون معنا که می‌گیم نه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 942.94,
   "end": 946.65,
   "text": "انسان‌ها می‌بیند، موجودات نوری می‌بیند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 946.65,
   "end": 949.47,
   "text": "اینجا که عرض می‌کنم نظرتون به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 949.47,
   "end": 951.45,
   "text": "بعضی مسائل نره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 951.45,
   "end": 958.96,
   "text": "منظورم که دیگه برای این تسخیر کننده های ارواح و نامه‌ست اون‌ها نیست ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 958.96,
   "end": 964.02,
   "text": "این عوالم بالایی‌ست. اینا تمثلات هستن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 964.02,
   "end": 966.07,
   "text": "اینجور می‌بیند عوا-- عالمی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 966.07,
   "end": 970.57,
   "text": "می‌بیند، عالم نوری‌ست، آفتابی نوری و خلاصه عالم دیگر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 970.57,
   "end": 974.91,
   "text": "اونیکه این عالم ما که آفتاب می‌تابد و همه چیز را روشن می‌کند،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 974.91,
   "end": 981.15,
   "text": "اونجا نور دیگری تابیده و همه چیز اون عالم برای این شخص چه شده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 214,
   "start": 981.15,
   "end": 983.59,
   "text": "برای این شخص روشن شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 215,
   "start": 983.59,
   "end": 988.39,
   "text": "مولوی می‌گوید که مولوی اینجا چیز خوبی دارد در این رابطه‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 216,
   "start": 988.39,
   "end": 995.19,
   "text": "اشعار دارد که من می‌خواستم بنویسم بخوانم براشون بعد دیدم که مضمونش را بگم بهتره که خوندن اشعارش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 217,
   "start": 995.19,
   "end": 998.33,
   "text": "نکاتی داشت که توضیح اونها طولانی می‌شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 218,
   "start": 998.33,
   "end": 1002.77,
   "text": "خب شما الآن در همین روز وقتی نگاه می‌کنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 219,
   "start": 1002.77,
   "end": 1007.45,
   "text": "اگر شب باشد که دیگه این موجودات را با رنگ و خصوصیات که نمی‌بینید که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 220,
   "start": 1007.45,
   "end": 1015.07,
   "text": "هم دید در چشم شما لازم است و هم نوری لازم است که این موجودات را روشن بکنه که شما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 221,
   "start": 1015.07,
   "end": 1018.49,
   "text": "چی بکنید؟ با این چشمتون موجودات را",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 222,
   "start": 1018.49,
   "end": 1021.37,
   "text": "ببینید. عوالم بالا هم همینطوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 223,
   "start": 1021.37,
   "end": 1029.73,
   "text": "یعنی اون‌ها برا خودش آفتابی دارد، ماهی دارد، نوری دارد که در آن نور موجودات اونجا چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 224,
   "start": 1029.73,
   "end": 1034.97,
   "text": "برای چشم بالای انسان بالاتر انسان روشن می‌شود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 225,
   "start": 1034.97,
   "end": 1036.89,
   "text": "خوبه بهتر شد از قبل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 226,
   "start": 1036.89,
   "end": 1041.39,
   "text": "الآن با این چشمتون می‌بینید موجودات را ولی در اثر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 227,
   "start": 1041.39,
   "end": 1043.11,
   "text": "تابش نور آفتاب می‌بینید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 228,
   "start": 1043.11,
   "end": 1046.05,
   "text": "در نور می‌بینید، با نور می‌بینید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 229,
   "start": 1046.05,
   "end": 1053.91,
   "text": "اگر نوری نباشد مانند شب شما چشمتون هرچه باز بکنی هیچی نمی‌بینید اگر ظلمت محض باشد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 230,
   "start": 1053.91,
   "end": 1057.47,
   "text": "اینجا در واقع به این صورت کشف کامل‌تره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 231,
   "start": 1057.47,
   "end": 1065.17,
   "text": "هم چشم از نور بالاتر برخوردار شده و هم عالم صالک عالم چی شده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 232,
   "start": 1065.17,
   "end": 1071.19,
   "text": "عالم بالاتری شده، نوری شده از اون عالم بالاتر در واقع",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 233,
   "start": 1071.19,
   "end": 1075.15,
   "text": "عالم خود صالک بالا رفته و به عالم بالاتر مرتبط گشته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 234,
   "start": 1075.15,
   "end": 1084.03,
   "text": "اون عالمی که موجودات اون با خصوصیاتش در نور بالاتر به ظهور می‌رسند، اون عالم را با نورش،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 235,
   "start": 1084.03,
   "end": 1087.01,
   "text": "با موجوداتش، با خصوصیاتش چی می‌کند؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 236,
   "start": 1087.01,
   "end": 1090.09,
   "text": "درک می‌کند. این مرحله بالاتری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 237,
   "start": 1090.09,
   "end": 1092.97,
   "text": "از کشف است. کشف ابصاری که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 238,
   "start": 1092.97,
   "end": 1096.51,
   "text": "البته همه این‌ها خارج از اختیاره اصلاً فراموش نکنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 239,
   "start": 1096.51,
   "end": 1099.31,
   "text": "هیچکدام به اختیار انسان مربوط نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 240,
   "start": 1099.31,
   "end": 1108.11,
   "text": "در مراحل ابتدایی کشف است ولی البته این که عرض کردم ابتدایی‌ست ولی تقریباً روش می‌شود زیاد حساب کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 241,
   "start": 1108.11,
   "end": 1118.05,
   "text": "این را در حالت بین النوم و الیقظه هم همین شب را می‌بیند انسان و در حالت خواب هم همینطور می‌بیند آفتاب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 242,
   "start": 1118.05,
   "end": 1120.81,
   "text": "و آنجور که یاد گرفتم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 243,
   "start": 1120.81,
   "end": 1124.43,
   "text": "بیشتر اونی که مهمه حالت بیداری را",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 244,
   "start": 1124.43,
   "end": 1127.59,
   "text": "در این جاها که الآن عرض می‌کنم را که روش حساب کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 245,
   "start": 1127.59,
   "end": 1130.99,
   "text": "خب. کامل‌تر شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 246,
   "start": 1130.99,
   "end": 1133.89,
   "text": "یواش یواش مسئله مسائل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 247,
   "start": 1133.89,
   "end": 1139.81,
   "text": "صور مثالی و حقایق مثالی و برزخی پیش میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 248,
   "start": 1139.81,
   "end": 1142.69,
   "text": "یعنی از این مرحله به بعد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 249,
   "start": 1142.69,
   "end": 1147.53,
   "text": "من در یک مثلی خیلی باریک پیش میرم و ابعاد قضیه خیلی طولانی‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 250,
   "start": 1147.53,
   "end": 1158.35,
   "text": "کامل‌تر شد. دیدن موجودات مثالی، عوالم مثالی، برازخ، اشباح نوری و اینها شروع می‌شود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 251,
   "start": 1158.35,
   "end": 1161.61,
   "text": "برازخ هم چه برازخ قبلی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 252,
   "start": 1161.61,
   "end": 1168.03,
   "text": "چه برازخ بعدی. اینا هم باز متفاوتند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 253,
   "start": 1168.03,
   "end": 1172.57,
   "text": "خب مشاهده یعنی م-مخفوش شدن عوالم مثالی شروع می‌شود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}