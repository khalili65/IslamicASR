   "start": 16.28,
   "end": 117.08
  },
  {
   "index": 1,
   "title": "## آیات سورهٔ جن و عصمت در اخذ و ابلاغ وحی",
   "start": 117.08,
   "end": 220.59
  },
  {
   "index": 2,
   "title": "## نتیجهٔ مقدمه: ساده‌لوحی ممنوع",
   "start": 220.59,
   "end": 428.26
  },
  {
   "index": 3,
   "title": "## آغازِ توضیحِ اشتباه در کشف ابصاری",
   "start": 428.26,
   "end": 519.16
  },
  {
   "index": 4,
   "title": "## پناهندگی به عنوان سپرِ نسبی",
   "start": 519.16,
   "end": 1155.8
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 1.12,
   "end": 4.2,
   "text": "اعوذ بالله السميع العليم من الشيطان الرجيم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 4.2,
   "end": 6.34,
   "text": "بسم الله الرحمن الرحيم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 6.34,
   "end": 12.8,
   "text": "عرض کنم که اولا در مقدمه این مطالب یعنی برای اینکه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 12.8,
   "end": 16.28,
   "text": "برای ما کاملا روشن باشد که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 16.28,
   "end": 20.64,
   "text": "در مقام مشاهده و مکاشفه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 20.64,
   "end": 24.5,
   "text": "و مراتب مختلفش اشتباهات، لرزش‌ها پیش میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 24.5,
   "end": 29.29,
   "text": "البته در مراحل ابتدایی بیشتر است و در اواسط کمتر است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 29.29,
   "end": 32.84,
   "text": "در نهايات از اون هم کمتر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 32.84,
   "end": 37.13,
   "text": "و به عکس اشتباهات مراتب اولیه ضعیف‌تر است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 37.13,
   "end": 40.91,
   "text": "اواسط قوی‌تر است. نهايات کاملا خطرناک‌تر است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 40.91,
   "end": 51.9,
   "text": "یعنی در مراحل اولیه مشاهده ایجاد می‌کند مشاهده و مکاشفه در مراحل ابتدایی‌ش اشتباهات و لرزش‌ها، دخالت‌های خیال و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 51.9,
   "end": 55.34,
   "text": "شیطان زیاد است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 55.34,
   "end": 60.16,
   "text": "اما چون مراحل اولیه مکاشفه و مشاهده است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 60.16,
   "end": 63.7,
   "text": "از نظر کمیت زیاد است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 63.7,
   "end": 73.98,
   "text": "ولی اگر کمیت تعبیرش در اینجا درست باشد ولی خطراتش در حد اون خطراتی است که در اشتباهات بالاتر پیش می‌آید نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 73.98,
   "end": 81.94,
   "text": "در اینکه اینها هم بی‌خطر نیست و خیلی خطرات دارد که الان توضیح هم می‌دانم عرض می‌کنم بعد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 81.94,
   "end": 85.1,
   "text": "ولی در اواسط که اشتباهات پیش میاد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 85.1,
   "end": 87.64,
   "text": "در مشاهده و مکاشفه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 87.64,
   "end": 94.08,
   "text": "و القاءات شیطانی پیش میاد، ضلالت‌ها پیش میاد در عین اینکه از نظر کمیت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 94.08,
   "end": 98.28,
   "text": "قضیه تعبیر درست باشد به نسبت به اوائل کمتر است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 98.28,
   "end": 102.12,
   "text": "اما از نظر کیفیت خطراتش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 102.12,
   "end": 108.98,
   "text": "به اصطلاح اون هلاکت‌ها که پیش می‌آید بیشتر است و در نهايات این خطرات کامل‌تر می‌شود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 108.98,
   "end": 114.98,
   "text": "در چه اشتباهات کمتر می‌شود و دخالت‌های شیطانی کمتر می‌شود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 114.98,
   "end": 120.2,
   "text": "در مقدمه می‌خواستم اینو عرض کنم که برای مشاهده و مکاشفه بودن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 120.2,
   "end": 124.86,
   "text": "معنیش این نیست که انسان هرچی می‌یابد در مقام مشاهده و مکاشفه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 124.86,
   "end": 129.32,
   "text": "صالح هرچی می‌یابد مشهور می‌افزد براش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 129.32,
   "end": 131.96,
   "text": "یا مکشوف می‌افزد برایش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 131.96,
   "end": 135.74,
   "text": "حالا صورت‌های مختلف از هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 135.74,
   "end": 139.46,
   "text": "هرچه مشهور و مکشوف می‌افزد که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 139.46,
   "end": 145.32,
   "text": "کشف صوری باشد که کشف دیگر باشد که کشف صوری باشد که کشف معنوی باشد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 145.32,
   "end": 153.56,
   "text": "اینها حق است. این مسئله را فراموش نکنید که آنچه مکشوف می‌افزد برای صالح",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 153.56,
   "end": 156.04,
   "text": "در کل همش حق است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 156.04,
   "end": 159.98,
   "text": "بدون استثناء همش عین حقیقت است و همش واقعی است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 159.98,
   "end": 163.54,
   "text": "یعنی غلط نیست. این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 163.54,
   "end": 167.92,
   "text": "فقط در جایی می‌شود که فرض بکنیم اون انسانی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 167.92,
   "end": 176.06,
   "text": "که این مکاشفات و مشاهدات براش می‌آید معصوم باشد و معصوم هیچ کس جز معصومین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 176.06,
   "end": 177.94,
   "text": "سلام الله علیهم أجمعین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 177.94,
   "end": 183.18,
   "text": "نیستند. یعنی عصمت از خدا لازم است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 183.18,
   "end": 187.56,
   "text": "عصمت در همه احوال که انسان را از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 187.56,
   "end": 190.44,
   "text": "دخالت‌های خیال و وهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 190.44,
   "end": 192.6,
   "text": "و شیطان و اینها در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 192.6,
   "end": 195.98,
   "text": "مکاشفه و مشاهده حفظ می‌کند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 195.98,
   "end": 200.06,
   "text": "و این عصمت هم در همه احوال کلی و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 200.06,
   "end": 203.44,
   "text": "همگی و شامل باشد و این فقط مخصوص",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 203.44,
   "end": 208.12,
   "text": "معصومین است. چون دیگران معصوم نیستند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 208.12,
   "end": 218.48,
   "text": "لذا در مقام مشاهده و مکاشفه از اشتباه و لرزش و از دخالت‌های شیطانی معصوم و معصوم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 218.48,
   "end": 224.78,
   "text": "نیستند. این کلی مسئله است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 224.78,
   "end": 234.54,
   "text": "در این مقدمه که می‌خوام عرض بکنم به یکی دو آیه از آیات قرآن اشاره می‌کنم که کاملا bütün مسئله برای ما جا بیفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 234.54,
   "end": 239.88,
   "text": "در خصوص رسول اکرم صلی الله علیه و آله و سلم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 239.88,
   "end": 246.56,
   "text": "البته این در خصوص رسول الله هست به یک نظر این آیات و به یک نظر در خصوص همه انبیا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 246.56,
   "end": 251.84,
   "text": "که از خداي متعال وحی می‌گیرند هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 251.84,
   "end": 256.34,
   "text": "آیاتی در سوره جن داریم که آیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 256.34,
   "end": 259.3,
   "text": "بیست و شش و بیست و هفت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 259.3,
   "end": 262.72,
   "text": "و بیست و هشت است که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 262.72,
   "end": 265.9,
   "text": "در اینجا بیان کردن بیان کلی‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 265.9,
   "end": 270.48,
   "text": "ان شاء الله به تفاسیر هم مخصوصا تفسیر فخر الرازی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 270.48,
   "end": 275.46,
   "text": "رضوان الله علیه در این باب اگر خواستید مراجعه بکنید چه بهتر که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 275.46,
   "end": 277.52,
   "text": "در این قسمت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 277.52,
   "end": 281.34,
   "text": "بالاخره به حقایق بیشتر متوجه می‌شوید و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 281.34,
   "end": 285.26,
   "text": "یکی از معارف قرآن برايتون روشن‌تر می‌شود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 285.26,
   "end": 288.48,
   "text": "ایشون عرض کنم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 288.48,
   "end": 296.56,
   "text": "در تفسیرشون در این زمینه بحث جالب و مفید و جامعی دارند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 296.56,
   "end": 299.04,
   "text": "آیات را تلاوت می‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 299.04,
   "end": 302.74,
   "text": "اجمالا معنی می‌کنم که مقدمه باشد برای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 302.74,
   "end": 308.8,
   "text": "عرائض ما. بیست و شش و بیست و هفت و بیست و هشت سوره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 308.8,
   "end": 314.0,
   "text": "جن. \"عَالِمُ الْغَيْبِ فَلَا يُظْهِرُ عَلَىٰ غَيْبِهِ أَحَدًا\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 314.0,
   "end": 318.08,
   "text": "آیه بیست و شش. \"عَالِمُ الْغَيْبِ فَلَا يُظْهِرُ عَلَىٰ غَيْبِهِ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 318.08,
   "end": 326.74,
   "text": "أَحَدًا إِلَّا مَنِ ارْتَضَىٰ مِن رَّسُولٍ فَإِنَّهُ يَسْرُتُ مِن بَيْنِ يَدَيْهِ وَمِنْ خَلْفِهِ رَّسَدًا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 326.74,
   "end": 336.06,
   "text": "لِّيَعْلَمَ أَنَّهُ حَقَّ رِسَالَاتِ رَبِّهِ وَأَحَاطَ بِمَا لَدَيْهِمْ وَأَحْصَىٰ كُلَّ شَيْءٍ عَدَدًا\".",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 336.06,
   "end": 340.6,
   "text": "در این آیات در خصوص",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 340.6,
   "end": 344.32,
   "text": "مسئله وحی است و اینکه خدا به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 344.32,
   "end": 355.26,
   "text": "چه شخص رسول اکرم صلوات الله علیه و چه هر پیامبری و هر نبی و رسولی که از خدا وحی می‌گیرد و به مردم می‌رساند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 355.26,
   "end": 359.44,
   "text": "در این باب آیات اینجا شروع می‌شود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 359.44,
   "end": 362.04,
   "text": "که خدا عالم الغیب است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 362.04,
   "end": 365.48,
   "text": "و به غیبش کسی را",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 365.48,
   "end": 370.08,
   "text": "کسی را به غیبش آگاه نمی‌کند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 370.08,
   "end": 378.66,
   "text": "مگر آن کسی که خدا خودش راضی باشد که به غیبش در حدی که می‌خواهد آشنا بسازد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 378.66,
   "end": 384.0,
   "text": "من الرسول از پیغمبرها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 384.0,
   "end": 392.5,
   "text": "خدا غیبش را به کسی معلوم یعنی غیب، غیب مراتب دارد که غیبش کسی را آگاه نمی‌کند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 392.5,
   "end": 396.18,
   "text": "مخصوص اوست الا کسی را که خودش بخواهد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 396.18,
   "end": 401.06,
   "text": "از پیغمبرها. خب پیغمبرها وقتی وحی می‌گیرند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 401.06,
   "end": 406.26,
   "text": "در حقیقت به غیب راه می‌یابند یا از غیب می‌گیرند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 406.26,
   "end": 413.78,
   "text": "این خودش به اصطلاح یظهر على غیبه هست چون می‌فرماید الا من ارتضی من رسول.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 413.78,
   "end": 418.92,
   "text": "مگر پیغمبرها را خدا خودش می‌خواهد آنها را به غیبش آگاه می‌کند که به آنها وحی می‌کند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 418.92,
   "end": 422.62,
   "text": "وحی از غیب است. اونوقت در اینجا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 422.62,
   "end": 427.38,
   "text": "در مرحله‌ای که از غیب خدا از احوال غیبی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 427.38,
   "end": 431.3,
   "text": "که به انبیا وحی می‌فرماید و انبیا هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 431.3,
   "end": 436.46,
   "text": "و رسل هم موظفاً از خدا گرفتند به انسان‌ها ابلاغ کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 436.46,
   "end": 440.22,
   "text": "در اینجا می‌فرماید که و خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 440.22,
   "end": 444.38,
   "text": "فإنه یسکه من بین یدیه و من خلفه رسدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 444.38,
   "end": 448.2,
   "text": "وقتی که وحی می‌فرستد به پیغمبری از غیبش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 448.2,
   "end": 450.64,
   "text": "و به غیبش آشنا می‌کند،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 450.64,
   "end": 456.32,
   "text": "خدا کاملاً رسدها، حافظها، حافظینی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 456.32,
   "end": 463.06,
   "text": "حفظ کننده‌هایی از ملائکه‌ی بخصوصش را مامور می‌کند و موکل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 463.06,
   "end": 471.1,
   "text": "می‌کند که این نبی و این رسول غیب را آنچنان که هست از اصلش بگیرند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 471.1,
   "end": 473.31,
   "text": "هم خوب بگیرند، درست بگیرند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 473.31,
   "end": 475.42,
   "text": "خوب به وقتی که چی میده ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 475.42,
   "end": 478.88,
   "text": "و این برای ما چه معلوم می‌کند؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 478.88,
   "end": 482.94,
   "text": "خدا ملائکه را به عنوان رصد و حفظ کننده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 482.94,
   "end": 489.9,
   "text": "حفظ کننده از اشتباه، حفظ کننده از دخالت‌های شیطان و جمود شیطانی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 489.9,
   "end": 496.94,
   "text": "ملائکه اینها را حفظ می‌کند هم در مقام اخذ وحی از اونجا که باید اخذ کند هم در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 496.94,
   "end": 502.84,
   "text": "مقام حفظ وحی وقتی خودش اخذ می‌کنه باید حفظ بکند، تحمر بکند،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 502.84,
   "end": 506.62,
   "text": "حاملش باشد و هم در مقام ابلاغ وحی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 506.62,
   "end": 508.71,
   "text": "اونها که باید چی بکند؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 508.71,
   "end": 511.12,
   "text": "اونها که باید برسانند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 511.12,
   "end": 517.38,
   "text": "در سه مرحله گفتم باز انشاالله به تفسیر مرحوم آیت الله طباطبایی عزوان الله انشاالله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 517.38,
   "end": 524.7,
   "text": "مراجعه بکنید که ایشان در این آیه تحقیقی خیلی جالبی دارند بر خلاف اون تفسیرهایی که هرکجا گفتند زیاد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 524.7,
   "end": 529.96,
   "text": "به آیه خوب نمی‌خوره و همه جوانب آیه را معنی نمی‌کند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 529.96,
   "end": 537.92,
   "text": "در اینجا می‌گوید خدا وقتی پیغمبری را به غیبش آگاه می‌سازد، وحی را می‌فرماید ،یسکه من بین یدیه رسدا و من",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 537.92,
   "end": 540.78,
   "text": "خلف یسکه من بین یدیه و من خلفه رسدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 540.78,
   "end": 546.26,
   "text": "هم از روبرو هم از پشت سر ملائکه موکل می‌کند او را حفظ کنند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 546.26,
   "end": 549.06,
   "text": "هم در اخذ وحی و هم در ابلاغ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 549.06,
   "end": 552.06,
   "text": "وحی و همچنین در وسط در تحمر وحی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 552.06,
   "end": 559.8,
   "text": "حفظ می‌کند از روبرو یا در مقام ابلاغ مردم حفظ می‌کند از اشتباه و خطا و دخالت‌های شیطان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 559.8,
   "end": 563.84,
   "text": "از پشت سر، یعنی در مقام اخذ از منبع حفظ می‌کند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 563.84,
   "end": 567.74,
   "text": "در وسط هم که تحمر وحی است حفظشون می‌کند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 567.74,
   "end": 569.84,
   "text": "چرا حفظ می‌کند اونها را خدا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 569.84,
   "end": 576.92,
   "text": "چرا این ملائکه را دور ید اسراعیج مامور می‌کند، رصد چیز می‌کند تا اونها را حفظ کند؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 576.92,
   "end": 581.74,
   "text": "ليعلم ان قد ابله رسالات ربهم تا خدا بداند که این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 581.74,
   "end": 587.42,
   "text": "انبیا اون رسالت‌هایی را که از ناحیه پروردگارشون دارند اینها را",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 587.42,
   "end": 592.02,
   "text": "خوب گرفتند و خوب به اون مردمی که باید برسانند،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 592.02,
   "end": 598.5,
   "text": "چه کردند؟ رسانیدند درست بدون اینکه کم و زیاد بشود، بدون اینکه دخالتی بشود،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 598.5,
   "end": 605.12,
   "text": "بدون که چیزی از خودشون، چیزی از ناحیه القاءات دیگر و خلاصه اشتباه بکند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 605.12,
   "end": 608.24,
   "text": "و احاط بما لديه خدا خوب محيط است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 608.24,
   "end": 612.06,
   "text": "اونها را حفظ می‌کند و احصى كل شيء عددا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 612.06,
   "end": 615.38,
   "text": "خب این در خصوص",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 615.38,
   "end": 621.96,
   "text": "پیغمبران است که معصوم هستند و این در واقع حکایتی است اگر گفتید از چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 621.96,
   "end": 626.42,
   "text": "از عصمت انبیا علیهم السلام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 626.42,
   "end": 630.08,
   "text": "که اگر خدا حفظ نکند انبیا را،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 630.08,
   "end": 638.36,
   "text": "اون وقت رسول الله صلوات الله علیه از خدا حقایق را می‌گیرد، حالا بی‌واسطه یا با واسطه جبرئیل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 638.36,
   "end": 644.68,
   "text": "اون حقایق ماورا را می‌گیرد و جبرائت نامش رو میگن وحی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 644.68,
   "end": 649.84,
   "text": "وقتی می‌گیرد در موقع گرفتن باید خدا حفظش بکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 649.84,
   "end": 652.46,
   "text": "وقتی گرفت خودش حاملش هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 652.46,
   "end": 657.24,
   "text": "در موقع حامل بودن باید حفظ بکنه که دخالت‌هایی نشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 657.24,
   "end": 660.76,
   "text": "وقتی می‌خواد ابلاغ بکند هم باید خدا چی بکنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 660.76,
   "end": 663.62,
   "text": "باید خدا حفظ بکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 663.62,
   "end": 670.68,
   "text": "خب این در خصوص انبیاست و این جریان عصمت را در اینجا با این صورت تصویر می‌کند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 670.68,
   "end": 676.04,
   "text": "البته در همه احوالی نام معصوم هستند ولی این گوشه‌ای از جریان عصمت اونهاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 676.04,
   "end": 680.08,
   "text": "این خودش برای ما هشدار دهنده است که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 680.08,
   "end": 682.7,
   "text": "اگر چنانچه یه وقتی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 682.7,
   "end": 688.24,
   "text": "کسی در حد خودش به پشت پرده در حد خودش البته در حد وقت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 688.24,
   "end": 695.16,
   "text": "در حد خودش به پشت پرده خواست راه پیدا کند، خدا راه بهش داد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 695.16,
   "end": 697.46,
   "text": "این راه دادن یا راه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 697.46,
   "end": 703.66,
   "text": "پی-پیدا کردن چیزیست و اشتباه کردن هم چیز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 703.66,
   "end": 715.08,
   "text": "چی؟ دیگریست و خدا این وعده را و این حفاظت را به عصمته با عصمت و حفاظت خودش در خصوص انبیا که رسالت دارند،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 715.08,
   "end": 720.02,
   "text": "دارد و از دیگران را اینجا خدا وعده فرموده است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 720.02,
   "end": 729.52,
   "text": "البته معنی حرف این نیست که دیگران در حدی که از غیب خدا با مشیت خودش احیانا برخوردار شده‌اند،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 729.52,
   "end": 731.66,
   "text": "خدا هدیشون نمی‌کند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 731.66,
   "end": 734.44,
   "text": "هر اندازه به خدا پناهنده باشد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 734.44,
   "end": 742.84,
   "text": "هر اندازه به خدا متوکل و متکی باشد، هر اندازه از راهی که باید هدایت شوند پیش بروند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 742.84,
   "end": 744.84,
   "text": "البته خدا هدیشون می‌کند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 744.84,
   "end": 748.04,
   "text": "اما همینقدر آیه به خوبی حاکی از این است که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 748.04,
   "end": 750.32,
   "text": "راه اشتباه برای دیگران",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 750.32,
   "end": 754.68,
   "text": "چیه؟ راه اشتباه برای دیگران باز است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 754.68,
   "end": 763.16,
   "text": "این آیه را به عنوان مقدمه گفتم با اون مطلبش اول گفتم که بنا بشود هر مشاهده و هر مکاشفه از هر کسی در هر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 763.16,
   "end": 769.38,
   "text": "مقامی به هر شیوه‌ای حق و حقیقت باشد بدون استثناء معنایش این است آن شخص باید معصوم باشد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 769.38,
   "end": 771.6,
   "text": "و جز معصومین ما معصومی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 771.6,
   "end": 775.76,
   "text": "معصوم دیگری نداریم. عصمت مسئله‌ای است که خدا باید اینها،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 775.76,
   "end": 781.02,
   "text": "منصب است. منصب به خصوصی است و کسب کردنی هم نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 781.02,
   "end": 789.22,
   "text": "البته گفتم هر که به هر اندازه رو به خدا باشد در راهی که خدا فرموده از عصمت حق برخوردار است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 789.22,
   "end": 791.4,
   "text": "اما اون عصمت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 791.4,
   "end": 799.14,
   "text": "من جمع الجهات منصبی است که خدا به هر کس خاص عنایت می‌فرماید و دیگران معصوم نیستند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 799.14,
   "end": 803.62,
   "text": "خب این مقدمه ما توضیحی بود برای اینکه ما وقتی الان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 803.62,
   "end": 805.64,
   "text": "من می‌خوام شروع بکنم برای شما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 805.64,
   "end": 810.88,
   "text": "نمونه‌هایی و توضیحاتی در خصوص اشتباهاتی در مشاهده و مکاشفه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 810.88,
   "end": 815.34,
   "text": "آیا بیایم این توضیحات را ذهن شما روشن باشد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 815.34,
   "end": 818.14,
   "text": "دوستان متوجه شدید که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 818.14,
   "end": 824.1,
   "text": "خیلی از افراد ساده لوحی که از مرگ و زل هستند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 824.1,
   "end": 832.54,
   "text": "و چه خودشان چیزهایی از مسائل ابتدایی مشاهدات و مکاشفات برخوردار باشند،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 832.54,
   "end": 836.04,
   "text": "چه دوستشان، آشناشان برخوردار باشد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 836.04,
   "end": 841.76,
   "text": "ساده لوح هستند فکر می‌کنند آنچه دیدند و یافتند چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 841.76,
   "end": 846.24,
   "text": "حق است. اینو خوب نتیجه گرفتیم که اینطور نیست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 846.24,
   "end": 855.26,
   "text": "و اصولاً در مراحل ابتدایی مخصوصاً احتمال خطا و لغزش بیشتر است تا احتمال چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 855.26,
   "end": 860.81,
   "text": "تا احتمال صدق و راستی و مطابقت با واقعیت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 860.81,
   "end": 862.42,
   "text": "البته این‌ها که من میگم طبق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 862.42,
   "end": 869.94,
   "text": "قواعد به شما میگم این طبق قواعد عرایضی که اینجا عرض می‌کنم همش مؤید با تجربه هم هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 869.94,
   "end": 873.66,
   "text": "یعنی همشو با تجربه هم دیده ایم ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 873.66,
   "end": 880.54,
   "text": "در ابتدا مخصوصاً اغفالتهای خیال، خیال خود انسان،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 880.54,
   "end": 882.9,
   "text": "وهم، وهم خود انسان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 882.9,
   "end": 889.64,
   "text": "و شیطان در اوائل مخصوصاً زیاد است، مخصوصاً زیاد است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 889.64,
   "end": 891.72,
   "text": "نه آن کسی که در اوائل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 891.72,
   "end": 900.3,
   "text": "مشاهدات و مکاشفات گفت ساده خود باید به همه مشهودات و مکشوفات خودش کاملاً مطمئن باشد که درست است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 900.3,
   "end": 902.72,
   "text": "و نه اون کسی که با این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 902.72,
   "end": 910.96,
   "text": "چنین شخصی روبرو هست باید این چنین به اصطلاح فکر بکند یا این چنین خیال بکند و ساده لوحی داشته باشد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 910.96,
   "end": 913.4,
   "text": "چقدر این خطرات دارد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 913.4,
   "end": 917.98,
   "text": "و چقدر خود این افرادی که اینجور ساده هستند و چیزهایی می‌یابند به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 917.98,
   "end": 924.1,
   "text": "خطر می‌افتند و دیگران هم به همان طور به ضلالت می‌افتند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 924.1,
   "end": 932.5,
   "text": "عرض کنم که حالا من توضیح را در ریزه کاری‌هاش به شما توضیحاتی البته باز بیان کلی است ولی ریزه کاری‌هاش گفتن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 932.5,
   "end": 934.22,
   "text": "اصلاً با گفتن تمام نمی‌شود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 934.22,
   "end": 936.72,
   "text": "مخصوصاً به اندازه‌ای که من خودم دیدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 936.72,
   "end": 939.42,
   "text": "خودم دیدم نه اینکه خودم مشهودم شده‌ام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 939.42,
   "end": 941.46,
   "text": "خودم از اینجور افراد دیدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 941.46,
   "end": 948.02,
   "text": "از این افرادی که در مراحل اولیه بودند یا بر حواسی بودند و از اونا که در نهایت بوده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 948.02,
   "end": 950.38,
   "text": "نوده اند و اشتباهات داشته‌اند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 950.38,
   "end": 954.22,
   "text": "خونده‌ام، شنیده‌ام از حالاتشون ولی از این ابتدا هم من",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 954.22,
   "end": 956.78,
   "text": "به چشم خودم خیلی دیده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 956.78,
   "end": 961.96,
   "text": "ام. خیلی یعنی می‌توان گفت که تعدادشون زیاد است، خیلی زیاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 961.96,
   "end": 965.58,
   "text": "که اصلاً در گرو خیال و وهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 965.58,
   "end": 968.4,
   "text": "و در تحت اغفال شیطانه قرار می‌گیرند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 968.4,
   "end": 972.08,
   "text": "چه عجیب! و در مراحل اولیه مشاهدات و مکاشفات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 972.08,
   "end": 974.3,
   "text": "البته صادقش هم می‌شود،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 974.3,
   "end": 975.94,
   "text": "درستش هم می‌شود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 975.94,
   "end": 979.66,
   "text": "اما صحبت ما در اشتباهات است و در ضلالت‌ها و در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 979.66,
   "end": 984.04,
   "text": "اغفال شیطانی. خب ببینید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 984.04,
   "end": 988.34,
   "text": "حالا توضیح. کسی است که مشغول است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 988.34,
   "end": 995.62,
   "text": "این و دار خب پروا دارد، پاکی دارد و به قسمت اعمال مستعدی حالا با یک برنامه منظم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 995.62,
   "end": 1000.02,
   "text": "حساب شده یا یک با یک برنامه بی‌نظم، بی‌حساب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 1000.02,
   "end": 1004.46,
   "text": "کاری انجام می‌دهد و فرادی از کار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 1004.46,
   "end": 1007.54,
   "text": "رو به خدا آورده و چیز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 1007.54,
   "end": 1016.62,
   "text": "است. در اینجا وقتی توجه داشته باشید که وراثت‌ها هم در این بی اثر نیستند در مخصوص اوائل مشاهدات و مکاشفات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 1016.62,
   "end": 1022.8,
   "text": "و خصوصیات مزاجی و روحی هم بی‌اثر نیستند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 1022.8,
   "end": 1034.16,
   "text": "خب ببینید که یک آمادگی در وجودش پیدا شده، یک به اصطلاح انواری اجمالاً در قلبش و در چشمش،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 1034.16,
   "end": 1036.5,
   "text": "حالا ما در کشف ابصاری صحبت می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 1036.5,
   "end": 1042.72,
   "text": "در چه این اشتباه که من میگم در همه مراحل کشفه است ولی فعلاً صحبت در کشف ابصاری است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 214,
   "start": 1042.72,
   "end": 1046.3,
   "text": "انواری در قلبش یا در چشمش اجمالاً پیدا شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 215,
   "start": 1046.3,
   "end": 1052.52,
   "text": "مثلاً انواری می‌بیند، گاهی مناظری می‌بیند، گاهی منظری، منظرهایی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 216,
   "start": 1052.52,
   "end": 1062.34,
   "text": "اون اوائل که انوار می‌بیند که اون درجه گذشته گفتم فقط دفعات نوری می‌بیند، نه منظره‌ای که یک حکایت داشته باشد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 217,
   "start": 1062.34,
   "end": 1068.02,
   "text": "نوری می‌بیند حالا به صورت ستاره‌ها، به صورت ماه، به صورت آفتاب، به صورت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 218,
   "start": 1068.02,
   "end": 1075.28,
   "text": "یک پارچه نور مسطح شرقی یا دایره شرق یا همه اون اتاق را که در شرع مثلاً نوری می‌بیند ها در رنگ‌های مختلف.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 219,
   "start": 1075.28,
   "end": 1078.08,
   "text": "اینجاهایی که خب جای اینکه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 220,
   "start": 1078.08,
   "end": 1080.7,
   "text": "اشتباه بشود زیاد چندان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 221,
   "start": 1080.7,
   "end": 1084.42,
   "text": "مطرح آنچنان نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 222,
   "start": 1084.42,
   "end": 1088.3,
   "text": "حالا که بنا شد که چیزها ببینند،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 223,
   "start": 1088.3,
   "end": 1091.68,
   "text": "چه در بیداری و چه در خواب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 224,
   "start": 1091.68,
   "end": 1096.4,
   "text": "در هر دو این تصویر یعنی اشتباه درست است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 225,
   "start": 1096.4,
   "end": 1105.06,
   "text": "خب از اونجا که مراحل اولیه است این آدم اولاً خب شرتاها، تعلقات هست و حجاب است از یک طرف.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 226,
   "start": 1105.06,
   "end": 1109.62,
   "text": "یعنی نفسانیت هنوز در وجودش کاملاً چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 227,
   "start": 1109.62,
   "end": 1111.76,
   "text": "هنوز در وجودش کاملاً.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 228,
   "start": 1111.76,
   "end": 1113.66,
   "text": "یعنی گفتید؟ حاكم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 229,
   "start": 1113.66,
   "end": 1116.88,
   "text": "الان خود اینها که به این خیالات می‌افتند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 230,
   "start": 1116.88,
   "end": 1120.12,
   "text": "یعنی اینجور چیزها را می‌بینند که من بعضی‌هاشون حتی آمدند و واژه شدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 231,
   "start": 1120.12,
   "end": 1124.92,
   "text": "دیدم واقعاً گرفتار خیال شده‌اند حتی گاهی فکر می‌کنند که دیگه مطلب تمام شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 232,
   "start": 1124.92,
   "end": 1128.28,
   "text": "توجه می‌کنید؟ اساساً اطلاع ندارند، نمی‌دانند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 233,
   "start": 1128.28,
   "end": 1132.42,
   "text": "یا به در مقابلش یک اطلاعی مانند خودشان قرار می‌دهند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 234,
   "start": 1132.42,
   "end": 1136.06,
   "text": "اون هم خودشون اونا رو تشویق مثلاً اون استاد می‌شود، این هم شاگرد می‌شود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 235,
   "start": 1136.06,
   "end": 1139.8,
   "text": "اینطور فکر می‌کنند که اساساً مطلب تمام شده دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 236,
   "start": 1139.8,
   "end": 1142.02,
   "text": "آسمان و زمین تسخیر شده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 237,
   "start": 1142.02,
   "end": 1147.6,
   "text": "و به خدا هم واصل شده‌اند و مراتب را طی کرده‌اند، مناظر را طی کرده‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 238,
   "start": 1147.6,
   "end": 1151.64,
   "text": "به خلاصه مسئله تمام شده با دیدن یک دفعات نوری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 239,
   "start": 1151.64,
   "end": 1154.12,
   "text": "گاهی اینجور تخیل و توهم هم می‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 240,
   "start": 1154.12,
   "end": 1155.8,
   "text": "حالا این خودش هم یکی از اشتباهات است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}