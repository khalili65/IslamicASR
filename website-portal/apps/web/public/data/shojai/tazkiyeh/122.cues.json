 "chapters": [
  {
   "index": 0,
   "title": "اعوذ بالله السمیع العلیم من الشیطان الرجیم. بسم الله الرحمن الرحیم.",
   "start": 7.82,
   "end": 418.83
  },
  {
   "index": 1,
   "title": "## نور حق بر نور حس؛ نور علی نور",
   "start": 418.83,
   "end": 755.67
  },
  {
   "index": 2,
   "title": "## هشدار: گیرنکردن در انوار و مناظر",
   "start": 755.67,
   "end": 907.19
  },
  {
   "index": 3,
   "title": "## مرحلهٔ تجرد: کل وجود چشم است",
   "start": 907.19,
   "end": 952.39
  },
  {
   "index": 4,
   "title": "اصل حقیقت ما صورت مجردِ بالاتر از زمان و مکان است:",
   "start": 952.39,
   "end": 1100.03
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 1.0,
   "end": 4.08,
   "text": "اعوذ بالله السميع العليم من الشيطان الرجيم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 4.08,
   "end": 6.16,
   "text": "بسم الله الرحمن الرحيم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 6.16,
   "end": 12.08,
   "text": "اولاً توجه داشته باشید که همین که نور در چشم متجلی شد یعنی از قلب به چشم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 12.08,
   "end": 19.96,
   "text": "زد و انسان از کشف ابصار برخوردار شد در هر مرتبه‌ای باشد ابتدایش اواسطش و نهائاتش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 19.96,
   "end": 23.44,
   "text": "این چشم جدید را می‌گویند چشم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 23.44,
   "end": 25.4,
   "text": "دل. توجه کنید چشم رو چی میگن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 25.4,
   "end": 28.98,
   "text": "چشم دل. چشم دل همین چشم است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 28.98,
   "end": 31.3,
   "text": "یعنی همین چشمی که از رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 31.3,
   "end": 36.22,
   "text": "به اصطلاح با تجلی نور در قلب و در چشم پیش آمده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 36.22,
   "end": 38.7,
   "text": "آن چشمی که از نور الهی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 38.7,
   "end": 44.08,
   "text": "بر اثر رفع حجوب، ارتفاع حجوب برخوردار گشته و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 44.08,
   "end": 50.58,
   "text": "می‌بیند یا می‌یابد آنچه را که قبلاً افراد دیگر نمی‌یابند و این هم نمی‌یافت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 50.58,
   "end": 54.1,
   "text": "قبلاً. این آدم میگن از چشم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 54.1,
   "end": 58.38,
   "text": "دل بهره‌مند است. گفته می‌شود چشم دلش باز شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 58.38,
   "end": 62.34,
   "text": "حالا تعبیرات مختلف هست. اما چشم دل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 62.34,
   "end": 68.9,
   "text": "خوب دقت کنید که اون دریافتش یه مقدار مخصوصاً برای ماها من و شما که اهلش نیستیم یه مقدار مشکله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 68.9,
   "end": 73.88,
   "text": "چشم دل نه این است که این چشم هیچ درش تحولی پیش نیاید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 73.88,
   "end": 76.36,
   "text": "همین چشمی که داریم توجه می‌کنید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 76.36,
   "end": 81.9,
   "text": "چشم دل چیزی است که یعنی ادراکی است، بصیره‌ای است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 81.9,
   "end": 84.32,
   "text": "که جدیداً پیدا شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 84.32,
   "end": 86.84,
   "text": "ابصار است، دیدن است، چشم است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 86.84,
   "end": 92.42,
   "text": "اما این چشم در مراحلی در همین چشم هم ظهور می‌کند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 92.42,
   "end": 98.98,
   "text": "یعنی چشم دل وقتی باز می‌شود چه در حال بیداری و چه در حال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 98.98,
   "end": 101.98,
   "text": "خواب و چه در بین بیداری و خواب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 101.98,
   "end": 106.48,
   "text": "در اون حالاتی که برای سالکین پیش میاد گاهی حالات بیخودی مانند و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 106.48,
   "end": 110.91,
   "text": "حالات مختلفی که نمی‌شود گفت بیداری است و نمی‌شود گفت خواب است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 110.91,
   "end": 115.68,
   "text": "یعنی از اون بیداری‌ها که ما داریم در عین غفلت یا عین غفلت و عین خواب است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 115.68,
   "end": 120.22,
   "text": "از اون نیست، از اون خوابی که داریم باز اصطلاحاً از اون هم نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 120.22,
   "end": 125.96,
   "text": "یه حالت ثالثی است. در هر صورت کشف انصار در سه مرحله پیش میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 125.96,
   "end": 131.64,
   "text": "اون چشمی که حقایق پشت پرده‌ها که می‌بیند در هر مرتبه‌ای باشد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 131.64,
   "end": 135.04,
   "text": "آنچه در پشت پرده می‌بیند همین چشم می‌بیند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 135.04,
   "end": 137.06,
   "text": "در مراتبی همین چشم می‌بیند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 137.06,
   "end": 139.72,
   "text": "خوب دقت کنید نه در همه مراتبش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 139.72,
   "end": 142.98,
   "text": "در نهائات عرض می‌کنم چطور می‌شود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 142.98,
   "end": 145.34,
   "text": "در ابتدا و در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 145.34,
   "end": 151.12,
   "text": "اواسط وقتی چشم دل باز می‌شود فکر نکنید یعنی این چشم همین است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 151.12,
   "end": 154.88,
   "text": "نه، همین چشم دل در این چشم پیاده می‌شود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 154.88,
   "end": 159.72,
   "text": "دقت می‌کنید؟ اون چشم دل در همین چشم پیاده می‌شود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 159.72,
   "end": 162.7,
   "text": "نور حق بر نور ظاهر حس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 162.7,
   "end": 168.0,
   "text": "به اصطلاح سیطره پیدا می‌کند و نور نافذی در چشم پیدا می‌شود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 168.0,
   "end": 177.0,
   "text": "البته این دیگه نه چیزی است که من و شما اگر کسی این چنین را ببینیم در چشمش آنچنان نور را چه بکنیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 177.0,
   "end": 186.72,
   "text": "می‌یابید؟ اگر گفت نه، شما الان همین چشم عادی من که هست نور در چشم عادی من هست این را می‌یابید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 186.72,
   "end": 189.86,
   "text": "نه. خب اون نور را نمی‌یابید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 189.86,
   "end": 197.54,
   "text": "در مرحله عادی تو نوری که در چشم شما هست و با اون شما در همه مراحل عادی و هفته گذشته گفتم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 197.54,
   "end": 200.25,
   "text": "تمام ادراکات ما از نور سرچشمه می‌گیرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 200.25,
   "end": 204.72,
   "text": "ما همه ادراکاتمون صورت‌های مختلف نور است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 204.72,
   "end": 206.42,
   "text": "حالا اینجا مس-مسئله زیاد است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 206.42,
   "end": 208.26,
   "text": "انشاالله خدا به شما عنایت می‌کند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 208.26,
   "end": 213.04,
   "text": "خیلی چیزا بعداً می‌فهمید. هم با نور می‌بینیم، هم در نور می‌بینیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 213.04,
   "end": 216.32,
   "text": "و هم نور می‌بینیم. چیز دیگری نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 216.32,
   "end": 217.98,
   "text": "آنچه می‌بیند نور است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 217.98,
   "end": 222.26,
   "text": "آنچه در اون این دید حاضر می‌شود باز در نور است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 222.26,
   "end": 224.08,
   "text": "آنچه دیده می‌شود هم نور است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 224.08,
   "end": 228.44,
   "text": "اشکال مختلف نور است. هرچه شما می‌بینید اشکال مختلف نور است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 228.44,
   "end": 231.56,
   "text": "منتهی در مراحل نازله‌اش، خشوله‌اش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 231.56,
   "end": 234.26,
   "text": "اینا رو خب بعدها انشاالله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 234.26,
   "end": 236.8,
   "text": "پیدا می‌کنید. به هر صورت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 236.8,
   "end": 243.58,
   "text": "مسئله این است که نوری که الان من در چشم دارم، شما در چشم دارید این نور با برهنه مدرک نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 243.58,
   "end": 247.14,
   "text": "با چشم ظاهری این نور در چشم را نمی‌شود دید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 247.14,
   "end": 252.4,
   "text": "همان‌طور که نور بالاتر را هم در چشم کسی که پیاده می‌شود نمی‌شود دید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 252.4,
   "end": 259.38,
   "text": "توجه کنید. وقتی میگیم کسی از چشم دل برخوردار می‌شود نه این است که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 259.38,
   "end": 262.38,
   "text": "این چشم ظاهری‌اش همان چشم ظاهری است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 262.38,
   "end": 266.5,
   "text": "نه، در همین چشم ظاهری‌اش نوری پیش میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 266.5,
   "end": 272.7,
   "text": "وقتی با همین چشم ظاهری نگاه می‌کند مثلاً عالم برزخ را می‌بیند با همون،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 272.7,
   "end": 276.52,
   "text": "با همین چشم ظاهری یعنی حضوری با همین چشم می‌بیند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 276.52,
   "end": 283.18,
   "text": "دقت می‌کنید؟ اما نوری در همین چشم هست که این نور حجاب شکن است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 283.18,
   "end": 285.5,
   "text": "پرده برانداز است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 285.5,
   "end": 287.36,
   "text": "پرده‌ها را کنار می‌زند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 287.36,
   "end": 289.72,
   "text": "نافذ است. نور حق نافذ است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 289.72,
   "end": 292.16,
   "text": "توجه می‌کنید؟ این یادتون نرود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 292.16,
   "end": 297.54,
   "text": "نور به هر اندازه در قلب و در مشاعب جریده‌گر بشود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 297.54,
   "end": 300.74,
   "text": "اولین مشخصه‌اش این است که چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 300.74,
   "end": 303.56,
   "text": "نافذ است، محیط است،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 303.56,
   "end": 309.48,
   "text": "حجاب نمی‌شناسد. منتهی بستگی دارد که در چه مرتبه‌ای این نور تجلی کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 309.48,
   "end": 314.84,
   "text": "حجاب نمی‌شناسد. پشت دیوار و اون طرف دیوار نمی‌داند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 314.84,
   "end": 321.02,
   "text": "یا خیلی الان من بعدها به جزئیات اشاره می‌کنم که فعلاً قدم به قدم پیش برویم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 321.02,
   "end": 325.1,
   "text": "قدم به قدم انشاالله مطالب روشن‌تر می‌شود بشود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 325.1,
   "end": 328.04,
   "text": "این نور در این چشم است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 328.04,
   "end": 330.96,
   "text": "اما نمی‌شود گفت که در چشم دیگری است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 330.96,
   "end": 335.06,
   "text": "با اینکه ما غیر از این چشم یک چشم چه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 335.06,
   "end": 338.38,
   "text": "دیگری هم پیدا کردیم و این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 338.38,
   "end": 341.88,
   "text": "دو با هم یکی شده‌اند. توجه کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 341.88,
   "end": 343.98,
   "text": "حالا در حالت بیداری اینجوری است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 343.98,
   "end": 347.86,
   "text": "در حالت خواب هم مشابه همین است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 347.86,
   "end": 351.36,
   "text": "یعنی اون کسی که از چشم دل برخوردار است در رویا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 351.36,
   "end": 359.8,
   "text": "مسائل و حقایقی را می‌بیند و اون کسی که در بیداری می‌بیند و اون کسی که در حالت ثالث بین بیداری و خواب می‌بیند،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 359.8,
   "end": 361.96,
   "text": "این با چشم دل می‌بیند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 361.96,
   "end": 366.68,
   "text": "اما چشم دل دیگه با این چشم برای اون کس دو تا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 366.68,
   "end": 370.41,
   "text": "نیست. البته توجه داشته باشید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 370.41,
   "end": 377.99,
   "text": "مثلاً من اگر از اون نور برخوردار باشم در همین حال عادی که در حال عادی هستم همین طور می‌بینم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 377.99,
   "end": 380.95,
   "text": "شما هم می‌بینید همه افراد می‌بینند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 380.95,
   "end": 387.77,
   "text": "اگر خدا خواست و اون نور در چشم ظهور پیدا کرد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 387.77,
   "end": 396.11,
   "text": "یه مقدارم گاهگاهی یه مقدارش هم می‌شود گفت که زمام امر در دست خود انسان است باز با مشیت حق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 396.11,
   "end": 402.93,
   "text": "اگر خواست به اصطلاح ببیند آنچه را که می‌بیند اگر خدا هم بخواهد اون نور،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 402.93,
   "end": 410.58,
   "text": "اون که تازه وارد چشم شد و پرده‌ها را رفع شد آنچه را که می‌خواهد ببیند، می‌بیند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 410.58,
   "end": 412.35,
   "text": "توجه می‌کنید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 412.35,
   "end": 417.85,
   "text": "خب پس اون نور بر همین نور عادی به قول حالا اینجا من به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 417.85,
   "end": 422.57,
   "text": "اشعاری از مولوی اشاره می‌کنم که روشنگر است در این باز.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 422.57,
   "end": 425.77,
   "text": "اون نور بر اون نور ظاهر حس،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 425.77,
   "end": 429.13,
   "text": "اون که سیطره پیدا می‌کند اونجا که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 429.13,
   "end": 433.51,
   "text": "نور قلب در چشم متجلی می‌شود،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 433.51,
   "end": 435.37,
   "text": "این چشم می‌بیند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 435.37,
   "end": 441.71,
   "text": "مثال عالم مثال را می‌بیند، پشت پرده را می‌بیند و یا خیلی چیزها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 441.71,
   "end": 445.11,
   "text": "که روزی یا چند روز بعد کرده می‌رسد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 445.11,
   "end": 451.31,
   "text": "اشتباه نکنید. گفتم در مراحل عالیه تجلی نور در چشم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 451.31,
   "end": 462.01,
   "text": "که انسان از چشم بالاتر قلبی از چشم دل بالاتر برخوردار شد، اون مراحل عالیه اصلاً دیگه این حرف‌ها را زدن بیجاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 462.01,
   "end": 467.19,
   "text": "این چشم است اون، اونجا مسائل دیگری هست که بعد عرض می‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 467.19,
   "end": 472.19,
   "text": "حالا مولوی می‌گوید که نور حق بر نور حس،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 472.19,
   "end": 474.43,
   "text": "نور حق بر نور حس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 474.43,
   "end": 478.15,
   "text": "راکب شود. در تلفظش خوب دقت بکنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 478.15,
   "end": 481.29,
   "text": "نور حق بر نور حس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 481.29,
   "end": 487.39,
   "text": "راکب شود. آندهی جان سوی حق راغب شود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 487.39,
   "end": 489.27,
   "text": "اسب بی‌راکب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 489.27,
   "end": 491.47,
   "text": "چه داند رسم راه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 491.47,
   "end": 496.85,
   "text": "این چشم معمول را به جای اسب حساب می‌کند و اون نور بالاتر را به جای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 496.85,
   "end": 502.71,
   "text": "سوار حساب می‌کند. خب اسب بی‌راکب بی‌سوار که نمی‌داند تو کجا و چطور راه بره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 502.71,
   "end": 505.77,
   "text": "اسب بی‌راکب چه داند رسم راه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 505.77,
   "end": 509.81,
   "text": "شاه باید تا بداند شاه راه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 509.81,
   "end": 511.71,
   "text": "سوی حسی رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 511.71,
   "end": 515.61,
   "text": "که نورش راکب است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 515.61,
   "end": 519.19,
   "text": "سوی حسی رو که نورش راکب است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 519.19,
   "end": 521.09,
   "text": "حس را آن نور",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 521.09,
   "end": 524.73,
   "text": "نیکو صاحب است. نور حس را",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 524.73,
   "end": 527.39,
   "text": "نور حق تزیین بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 527.39,
   "end": 529.27,
   "text": "در کلماتش دقت کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 529.27,
   "end": 533.23,
   "text": "نور حس را نور حق چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 533.23,
   "end": 538.59,
   "text": "تزیین بود. معنی نور على نور این بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 538.59,
   "end": 543.07,
   "text": "معنی نور على نور که در آیه است البته یک معنیش این است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 543.07,
   "end": 549.85,
   "text": "یعنی حالا من اینو من، من میگم حالا مثلاً اینکه معنی نور، مولوی معنی نور على نور",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 549.85,
   "end": 553.91,
   "text": "این بود. نور حسی می‌کشد سوی سرا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 553.91,
   "end": 556.31,
   "text": "نور حقش می‌برد سوی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 556.31,
   "end": 560.01,
   "text": "ولا. زان که محسوسات دون‌تر عالم است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 560.01,
   "end": 564.49,
   "text": "نور حق دریا و حس آن شبنم است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 564.49,
   "end": 566.77,
   "text": "خب بعد میگه لیک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 566.77,
   "end": 572.69,
   "text": "تا حالا اینجا فکر کنید که من گفتم فکر نکن که حالا اون نور وقتی در چشم کسی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 572.69,
   "end": 578.25,
   "text": "صاحب آن نور است متجلی می‌شود ما باید اون نور را در چشم او چی بکنیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 578.25,
   "end": 583.41,
   "text": "بیاریم. میگه یافته نمی‌شه. مگر تو این نور را می‌بری تا آن را بیابی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 583.41,
   "end": 590.41,
   "text": "لیک پیدا نیست آن را که بر او جز به آثار و به گفتار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 590.41,
   "end": 595.55,
   "text": "نقو. نور حسی کو غلیظ است و گران.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 595.55,
   "end": 598.33,
   "text": "خب این نوری که الان ما داریم در چشممون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 598.33,
   "end": 604.53,
   "text": "در مقایسه به اون نور بالاتر که در قلب و در چشم می‌زند خیلی غلیظ است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 604.53,
   "end": 606.81,
   "text": "خیلی خوب دقیق گفته اینجا. میگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 606.81,
   "end": 612.17,
   "text": "نور حسی کو غلیظ است و گران است پنهان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 612.17,
   "end": 615.99,
   "text": "در سواد دیدگان است پنهان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 615.99,
   "end": 619.33,
   "text": "در سواد دیدگان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 619.33,
   "end": 622.91,
   "text": "چون که نور حس نمی‌بینی ز چشم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 622.91,
   "end": 627.15,
   "text": "چون ببینی نور آن دنی ز چشم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 627.15,
   "end": 629.09,
   "text": "نور آن بالا، نور",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 629.09,
   "end": 634.45,
   "text": "آن دنیای نور بالاتر. چون ببینی نور آن دنی ز چشم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 634.45,
   "end": 643.35,
   "text": "نور حس با این غلیظی مختص است چون خفی نبود ضیایی کان سفید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 643.35,
   "end": 647.99,
   "text": "بنابراین حالا البته شما اگر چنانچه وقتی با",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 647.99,
   "end": 651.09,
   "text": "کسان کسی اگر اینجور روبرو شدید،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 651.09,
   "end": 657.91,
   "text": "چون وقتی نگاه شما اگر خودتون دقت کنید وقتی نگاه می‌کند چیزها را می‌بیند همین طور نگاه می‌کند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 657.91,
   "end": 660.61,
   "text": "می‌بینید که چشمش حالا به صورت افقی به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 660.61,
   "end": 663.17,
   "text": "جز اینکه چشمش دقیق شده به یه جایی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 663.17,
   "end": 664.81,
   "text": "چیزها را می‌بیند و می‌بیند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 664.81,
   "end": 668.67,
   "text": "اگر کسی را اینجور دیدید یعنی همین چشمش به ظاهر متوجه می‌شود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 668.67,
   "end": 671.79,
   "text": "ولی من و شما همین چشم می‌بینیم این جسد چشم را می‌بینیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 671.79,
   "end": 675.09,
   "text": "نه اون نور خودش را می‌بینیم نه اون نور",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 675.09,
   "end": 677.77,
   "text": "چیه؟ نور بالاتر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 677.77,
   "end": 681.49,
   "text": "بعد چجور می‌بیند؟ گفتم که نور نافذ است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 681.49,
   "end": 686.79,
   "text": "شما اینکه باز توضیح میدم چجور عالم مثال را پشت پرده را",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 686.79,
   "end": 691.57,
   "text": "پشت پرده اینو که حاضر است من مرقبات سياه را این حجاب‌ها را کنار می‌زنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 691.57,
   "end": 694.47,
   "text": "توجه می‌کنید؟ اون حجاب‌ها را چی می‌کنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 694.47,
   "end": 697.99,
   "text": "اون حجاب‌ها را که برای من و شما حجاب است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 697.99,
   "end": 703.21,
   "text": "آن نوری که در این چشم است که این چشم همین این چشم است و همین چشم دل است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 703.21,
   "end": 706.31,
   "text": "اون حجاب‌ها را کنار می‌زند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 706.31,
   "end": 711.75,
   "text": "و عرض کنم که از میان می‌برد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 711.75,
   "end": 714.21,
   "text": "خب این قسمت را توضیح دادم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 714.21,
   "end": 717.23,
   "text": "اما اگر در این بر کجاهست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 717.23,
   "end": 721.03,
   "text": "در اونجاهست که سالک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 721.03,
   "end": 727.37,
   "text": "به اصطلاح در مراحل اولیه تشویش است یا در مراحل اواسط تشویش است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 727.37,
   "end": 733.29,
   "text": "اما در نهایت، نهایت منظور اون، اون وقت‌هاست که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 733.29,
   "end": 738.84,
   "text": "چشم دل ناظر وجه حق است که اون اصل مقصد سالک است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 738.84,
   "end": 745.19,
   "text": "یعنی سالک اینا هیچکدوم مقصتش نیست اگر سالک باشد و اگر مقصتش باشد اصلاً در راه می‌ماند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 745.19,
   "end": 747.17,
   "text": "حالا این‌ها را بعداً خواهم گفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 747.17,
   "end": 750.57,
   "text": "گفتم اشاره‌اش کافیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 750.57,
   "end": 752.75,
   "text": "بازم انشاالله خواهیم گفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 752.75,
   "end": 755.67,
   "text": "الان هم در این وسط به یادم افتاد بگم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 755.67,
   "end": 762.79,
   "text": "هیچ سالکی نباید اگر وقتی از این انوار ناب برخوردار شد که لازمه‌ی سلوکش هست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 762.79,
   "end": 771.23,
   "text": "نباید دست و پای خودش را گم بکند و مقصد را فراموش بکند و متوجه این مسائل باشد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 771.23,
   "end": 774.43,
   "text": "مثلاً مثال را دید و اوامر مثال.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 774.43,
   "end": 785.45,
   "text": "اوامر برزخی را دید، حالات برزخی را دید و خیلی حقایق و اسرار مرتب علی الاتصال از طریق کشف و شهود براش مکشوف شد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 785.45,
   "end": 788.23,
   "text": "و از اونجا هم بالاتر رفت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 788.23,
   "end": 794.07,
   "text": "فوق مثال و به اصطلاح وجودات هدا و نوری بالاتر را مشاهده نمود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 794.07,
   "end": 804.14,
   "text": "هیچ سالکی اگر سالک باشد، سالک واقعی به معنی کلمه باشد، هیچ وقت با پیدا شدن این احوال براش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 804.14,
   "end": 806.99,
   "text": "به اصطلاح دست و پای خودش را گم نمی‌کند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 806.99,
   "end": 812.67,
   "text": "و خودش را با آنها مسرور نمی‌کند و همتش هیچ وقت این نیست که اینجور چیزها ببیند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 812.67,
   "end": 816.21,
   "text": "اگر این باشد، اون در راه مانده است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 816.21,
   "end": 819.89,
   "text": "همان وقت که این انوار پیدا شد برای سالک و به او خوش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 819.89,
   "end": 824.35,
   "text": "آمد و دلش خواست که همیشه از این‌ها ببیند، در همان مرحله می‌ماند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 824.35,
   "end": 827.69,
   "text": "توجه کنید در همان مرحله اگر سقوط نکند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 827.69,
   "end": 829.85,
   "text": "حالا این اگر دارد باز.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 829.85,
   "end": 833.45,
   "text": "آن خیالاتی که دام اولیاست این شعر فراموش نکنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 833.45,
   "end": 836.43,
   "text": "عکس مهرویان بستان خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 836.43,
   "end": 839.97,
   "text": "این خیالات اینجا خیالات من و شماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 839.97,
   "end": 844.13,
   "text": "سالکی وقتی از این انوار برخوردار شد و به وجود برتر شد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 844.13,
   "end": 851.73,
   "text": "حقایق و اشکال مختلف در مراتب مختلف براش متجلی گشت تا ظهور پیدا کرد از اعصار وجود از پشت پرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 851.73,
   "end": 857.89,
   "text": "اگر اون‌ها براش دامنگیر باشد درست مانند دامنگیر بودن این دنیا برای ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 857.89,
   "end": 861.75,
   "text": "آن خیالاتی که دام اولیاست دام،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 861.75,
   "end": 864.93,
   "text": "عکس مهرویان بستان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 864.93,
   "end": 867.59,
   "text": "چیه؟ خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 867.59,
   "end": 869.93,
   "text": "او مظاهر جمال را می‌بیند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 869.93,
   "end": 874.01,
   "text": "خیلی چیزها می‌بیند. اگر بنا باشد همانجا گیر بکند،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 874.01,
   "end": 876.49,
   "text": "همانجا می‌ماند، می‌ماند اگر سقوط نکند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 876.49,
   "end": 881.63,
   "text": "سالک از اول همتش رو به سوی مقصد اعلی است و شهود وجه حق است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 881.63,
   "end": 883.99,
   "text": "اون هم شهود در مرحله فناء.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 883.99,
   "end": 889.11,
   "text": "خود سالک اگر سید باشه، باشد خدا خودش هدایت می‌کند البته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 889.11,
   "end": 892.69,
   "text": "یا توسط ملائکه و هدایتش می‌کند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 892.69,
   "end": 896.27,
   "text": "والذی نجىٰ حبیبنا لنھدینه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 896.27,
   "end": 899.0,
   "text": "سبلنا. عرض کنم که این مسئله‌ای است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 899.0,
   "end": 904.93,
   "text": "اما به هر صورت عرض کردم که مقصد نهایی سالک شهود وجه الله هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 904.93,
   "end": 908.79,
   "text": "آنجا که اینو می‌خواستم بگم، آنجا که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 908.79,
   "end": 918.09,
   "text": "سالک از چشم دلی برخوردار است، از چشم دلی برخوردار است که با آن چشم دل وجه حق را شاهد باشد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 214,
   "start": 918.09,
   "end": 921.49,
   "text": "دیگه اونجا این صحبت‌ها همش بی‌جاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 215,
   "start": 921.49,
   "end": 924.71,
   "text": "این چشم است، چشم دیگر است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 216,
   "start": 924.71,
   "end": 929.33,
   "text": "اصلاً چرا بی‌جاست؟ اون مرحله، مرحله تجرد انسان است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 217,
   "start": 929.33,
   "end": 935.17,
   "text": "مرحله تجرد انسان فوق زمان و مکان و ماده و مادیات امثال اینهاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 218,
   "start": 935.17,
   "end": 940.49,
   "text": "خوب دقت کنید. در اون مرحله کل وجود انسان چشم است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 219,
   "start": 940.49,
   "end": 943.65,
   "text": "اینجا دیگه من بیشتر توضیح نمی‌توانم بدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 220,
   "start": 943.65,
   "end": 946.49,
   "text": "فقط این‌ها را فقط شما به یاد داشته باشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 221,
   "start": 946.49,
   "end": 951.03,
   "text": "در وقت خودش خدا شما را بیشتر تعلیم می‌کند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 222,
   "start": 951.03,
   "end": 957.85,
   "text": "عرض کنم که آنجا که انسان از چشم دلی که شاهد وجه حق است دیگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 223,
   "start": 957.85,
   "end": 965.67,
   "text": "برخوردار است، اونجا کل وجود انسان چشم است، گوشش هم چشم است، لمسش هم چشم است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 224,
   "start": 965.67,
   "end": 971.23,
   "text": "دقت بکنید. حالا گفتم دریافتش مشکله‌ها ولی حقیقت این است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 225,
   "start": 971.23,
   "end": 974.47,
   "text": "دیگه چشم و گوش اولاً اونجا نداریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 226,
   "start": 974.47,
   "end": 976.65,
   "text": "بدن و غیر بدن نداریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 227,
   "start": 976.65,
   "end": 978.65,
   "text": "این چشم و اون چشم نداریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 228,
   "start": 978.65,
   "end": 980.41,
   "text": "حتی گفتم چشم و گوش نداریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 229,
   "start": 980.41,
   "end": 982.73,
   "text": "حتی لمس و گوش نداریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 230,
   "start": 982.73,
   "end": 987.03,
   "text": "در مرحله تجرد انسان کل او چشم است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 231,
   "start": 987.03,
   "end": 989.15,
   "text": "چه مانند کل او گوش است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 232,
   "start": 989.15,
   "end": 995.31,
   "text": "توجه بکنید. شنیده‌اید از رسول اکرم صلی الله علیه و آله و سلم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 233,
   "start": 995.31,
   "end": 1002.67,
   "text": "رسول الله می‌فرمود که من به طوری که از همه روبرو می‌بینم از پشت سر هم چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 234,
   "start": 1002.67,
   "end": 1005.29,
   "text": "که ببینم این رو مرحله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 235,
   "start": 1005.29,
   "end": 1007.58,
   "text": "نه این است که رسول الله در این مرحله بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 236,
   "start": 1007.58,
   "end": 1012.85,
   "text": "ولی چون که سر آمد نرد هم شماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 237,
   "start": 1012.85,
   "end": 1017.83,
   "text": "یعنی این حقیقت است رسول. در اون مرحله اصلاً مسئله 가دم مطرح نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 238,
   "start": 1017.83,
   "end": 1021.53,
   "text": "لذا آن چشم دلی که وجه حق می‌بید غیر از اینهاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 239,
   "start": 1021.53,
   "end": 1024.11,
   "text": "یعنی همین چشم دل است می‌خواهد در مرتبه بالاتر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 240,
   "start": 1024.11,
   "end": 1029.79,
   "text": "دیگه اونجا این چشم که همین گفتیم اینجا همین نظر همینجا ظاهر می‌شود، اینطور نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 241,
   "start": 1029.79,
   "end": 1034.61,
   "text": "اصلاً این روابط همش کنار می‌رود و انسان کلش چشم است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 242,
   "start": 1034.61,
   "end": 1036.67,
   "text": "تمام وجودش چشم است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 243,
   "start": 1036.67,
   "end": 1038.89,
   "text": "مرحله تجرد انسان است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 244,
   "start": 1038.89,
   "end": 1042.77,
   "text": "مرحله ظهور حقیقت مجرد و نوری انسان است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 245,
   "start": 1042.77,
   "end": 1050.41,
   "text": "اصل حقیقت ما توجه داشته باشید اصل حقیقت و کل حقیقت ما، اون صورت مجرد ما،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 246,
   "start": 1050.41,
   "end": 1054.27,
   "text": "صورت بالاتر از زمان و مکان، ماده و مادیات ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 247,
   "start": 1054.27,
   "end": 1056.36,
   "text": "که صورت حقیقت ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 248,
   "start": 1056.36,
   "end": 1059.23,
   "text": "ان الله خلق آدم على صورته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 249,
   "start": 1059.23,
   "end": 1064.53,
   "text": "اون صورتی که اصل حقیقت انسان دارد، مرحله تجرد می‌گیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 250,
   "start": 1064.53,
   "end": 1070.31,
   "text": "اونجا انسان وجودش سم است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 251,
   "start": 1070.31,
   "end": 1072.57,
   "text": "یاد داشته باشید آ. وجودش چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 252,
   "start": 1072.57,
   "end": 1075.43,
   "text": "کل وجودش چیه؟ سم است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 253,
   "start": 1075.43,
   "end": 1077.05,
   "text": "کل وجودش چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 254,
   "start": 1077.05,
   "end": 1080.11,
   "text": "بصر است. کل وجودش لمس است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 255,
   "start": 1080.11,
   "end": 1081.73,
   "text": "کل وجودش عقل است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 256,
   "start": 1081.73,
   "end": 1084.35,
   "text": "کل وجود همینطور دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 257,
   "start": 1084.35,
   "end": 1086.49,
   "text": "اونجا این مسائل بهرمند است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 258,
   "start": 1086.49,
   "end": 1094.33,
   "text": "لذا وقتی علی علیه السلام می‌فرمود من دیدم وجه حق را شاهد داشتم وجه پروردگار را،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 259,
   "start": 1094.33,
   "end": 1097.03,
   "text": "گفته شد که با این چشم گفته شد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 260,
   "start": 1097.03,
   "end": 1100.03,
   "text": "نه با این چشم بلکه با چشم دل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}