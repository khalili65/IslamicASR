  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.46,
   "end": 3.66,
   "text": "اعوذ بالله السميع العليم من الشيطان الرجيم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 3.66,
   "end": 5.94,
   "text": "بسم الله الرحمن الرحيم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 5.94,
   "end": 11.52,
   "text": "بحث ما در جلسه گذشته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 11.52,
   "end": 16.94,
   "text": "نحوه شروع در تزکیه و اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 16.94,
   "end": 22.44,
   "text": "حرکت که باید در مقام عمل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 22.44,
   "end": 26.14,
   "text": "انسان داشته باشد رسید و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 26.14,
   "end": 31.78,
   "text": "در جلسه گذشته گفتیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 31.78,
   "end": 34.16,
   "text": "اصل راه تزکیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 34.16,
   "end": 38.16,
   "text": "همان راهی است که خدا فرموده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 38.16,
   "end": 46.26,
   "text": "و راه تزکیه و سلوک ارباب تزکیه و سلوک در نوشته‌ها و گفته‌هاشون دارند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 46.26,
   "end": 50.84,
   "text": "نه یک راه دیگر است. اون روشن همان راهی است که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 50.84,
   "end": 54.94,
   "text": "خدا فرموده الا اینکه برداشت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 54.94,
   "end": 60.24,
   "text": "اهل تزکیه و ارباب تزکیه از راهی که خدا برای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 60.24,
   "end": 63.04,
   "text": "برگشت انسان به سوی خود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 63.04,
   "end": 70.3,
   "text": "ارایه فرموده برداشت درستی است و برداشت عمیقی است و برداشت جامعی است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 70.3,
   "end": 75.34,
   "text": "بر خلاف برداشت‌های دیگر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 75.34,
   "end": 78.74,
   "text": "که در حقیقت suri است،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 78.74,
   "end": 84.14,
   "text": "عمیق نیست، ناقص است و جامع نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 84.14,
   "end": 89.58,
   "text": "راه تزکیه و راه سلوک در مقام عمل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 89.58,
   "end": 91.64,
   "text": "همان‌ است که خدا فرموده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 91.64,
   "end": 96.46,
   "text": "که این راه را ارباب تزکیه خوب فهمیده‌اند و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 96.46,
   "end": 104.08,
   "text": "جامع فهمیده‌اند و عمیق فهمیده‌اند و گفته‌اند و نوشته‌اند و در مقام عمل هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 104.08,
   "end": 107.84,
   "text": "بر اساس اون فهم عمیق و جامع خودشان،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 107.84,
   "end": 112.2,
   "text": "خود و دیگران را به راه انداختند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 112.2,
   "end": 117.34,
   "text": "در مقام عمل گفتیم حالا ببینیم که در، از گفته‌ها و برداشتی که ارباب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 117.34,
   "end": 125.7,
   "text": "تزکیه دارند به شروع به عمل و شروع به تزکیه یعنی راهی که خدا نشان داده چگونه شروع می‌شود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 125.7,
   "end": 131.52,
   "text": "این راه شروع از نوشته‌ها و گفته‌های ارباب سلوک وقتی دقت می‌کنیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 131.52,
   "end": 137.82,
   "text": "در مجموع کم با همدیگه در نحوه شروع و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 137.82,
   "end": 140.44,
   "text": "مراتب و منازل اختلاف دارند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 140.44,
   "end": 142.54,
   "text": "اختلاف هم اگر باشد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 142.54,
   "end": 145.78,
   "text": "اون کم به صورت اختلاف در بیان است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 145.78,
   "end": 149.1,
   "text": "حقیقت یک است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 149.1,
   "end": 153.04,
   "text": "رو این حساب اگر در تصویر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 153.04,
   "end": 158.68,
   "text": "مرحله عملی تزکیه که شروع کردیم هفته گذشته قدم اول را",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 158.68,
   "end": 165.26,
   "text": "که یقظه بود صحبت کردیم و بعد هم بقیه‌ش را انشاالله صحبت می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 165.26,
   "end": 174.36,
   "text": "اگر تصویری که اینجا داشتیم، بحثی که داشتیم و اونچه که گفتیم شمایی وقتی در موقع مطالعه در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 174.36,
   "end": 182.28,
   "text": "نوشته و گفته‌ای کسی از ارباب معنا و سلوک و از صاحبان تحقیق و بصیرت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 182.28,
   "end": 188.72,
   "text": "احیاناً با گفته‌های آن‌ها تفاوت دیدید از نظر ترتیب و از نظر اینکه منزل اول",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 188.72,
   "end": 194.14,
   "text": "چیست و منزل دوم چیست و چگونه پیش می‌رود صالح،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 194.14,
   "end": 199.84,
   "text": "باید دقیق باشید و دقیق باشیم که این اختلاف‌ها یه مقدار اختلاف suri است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 199.84,
   "end": 203.12,
   "text": "و نحوه‌های بیان فرق می‌کند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 203.12,
   "end": 206.32,
   "text": "به هر صورت قدم اول را در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 206.32,
   "end": 208.84,
   "text": "جلسه اول گفتیم که یقظه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 208.84,
   "end": 212.26,
   "text": "بر اساس تحلیلی که من",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 212.26,
   "end": 217.86,
   "text": "با دقت در آیات و روایات و در گفته‌های",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 217.86,
   "end": 221.04,
   "text": "ارباب باطن به نظرم می‌آید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 221.04,
   "end": 229.66,
   "text": "اینجا می‌گویم اولین قدم یقظه بود که بعضی‌ها مانند خواجه عبدالله و دیگران هم همینطور گفتند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 229.66,
   "end": 234.28,
   "text": "که قدم اول یقظه و بیداری‌ست با شحری که گذشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 234.28,
   "end": 244.16,
   "text": "گفتیم یقظه که قدم اول است که انسان بیدار باشد در نظام وجود و به خود بیاید و از غفلت بیدار بشه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 244.16,
   "end": 253.82,
   "text": "وجود چیست، اولش چیست، آخرش چیست، انسان در وجود چیست، از کجا آمده، در کجا قرار گرفته، باید چگونه پیش برود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 253.82,
   "end": 255.36,
   "text": "در مقابل چه اوهامی هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 255.36,
   "end": 259.54,
   "text": "اینا رو می‌گیم یقظه. وقتی بیدار شد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 259.54,
   "end": 262.0,
   "text": "این آثار در وجود دارد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 262.0,
   "end": 268.42,
   "text": "که من در موقع گفتن از آثار یقظه سه اثر را گفتم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 268.42,
   "end": 273.84,
   "text": "اثر سوم توبه بود که قدم دوم در حقیقت حساب می‌شود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 273.84,
   "end": 277.04,
   "text": "در اثری که به طور کلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 277.04,
   "end": 288.06,
   "text": "از آثار یقظه در وجود انسان بیدار شده از غفلت فیاده می‌شود این است که این یقظه او را سوق می‌دهد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 288.06,
   "end": 290.8,
   "text": "به سوی برگشت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 290.8,
   "end": 293.4,
   "text": "به سوی بازگشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 293.4,
   "end": 301.66,
   "text": "برگشت و بازگشت به یک معنا از راهی که به صورت راه ضلالت در پیش گرفته بود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 301.66,
   "end": 307.06,
   "text": "به سوی راهی که انسان باید در پیش داشته باشد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 307.06,
   "end": 313.1,
   "text": "و برگشت و بازگشت به یک معنا از غیر خدا به سوی خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 313.1,
   "end": 317.5,
   "text": "راهی که انسان قبل از یقظه در پیش گرفته با",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 317.5,
   "end": 326.48,
   "text": "شحری که هفته گذشته عرض کردم از اون اولی که انسان به وجود می‌آد و قدم به عرصه دنیا می‌گذارد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 326.48,
   "end": 330.64,
   "text": "خود، اطرافیان، پدر و مادر معمولاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 330.64,
   "end": 338.9,
   "text": "و محیط، دوست، آشنا، کتاب، عالم، آسمان، زمین این است که انسان را سوق می‌دهند به سوی اهریمن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 338.9,
   "end": 342.08,
   "text": "مثل این چی‌ها؟ تحقیرند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 342.08,
   "end": 347.64,
   "text": "اون دل بی‌قرار را که در اصل و در نهاد و فطرتش او را می‌خواهد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 347.64,
   "end": 351.84,
   "text": "و بی‌قرار است و تا آخر عمر هم بی‌قرار می‌ماند گفتیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 351.84,
   "end": 357.44,
   "text": "این دل را بهش می‌قبولانند که تو این آن را می‌خواهی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 357.44,
   "end": 360.76,
   "text": "از همان وقت می‌قبولانند به که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 360.76,
   "end": 364.02,
   "text": "و دل را به راه ضلالت می‌اندازند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 364.02,
   "end": 368.12,
   "text": "و ادامه هم می‌دهند. شما الان به نظرتون بیارید،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 368.12,
   "end": 373.6,
   "text": "به نظرتون بیارید و به نظرمون بیاریم خودمون را، نه دیگران را.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 373.6,
   "end": 376.62,
   "text": "خودمون را که از اون اول که ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 376.62,
   "end": 380.3,
   "text": "پا به عرصه دنیا گذاشته‌ایم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 380.3,
   "end": 387.66,
   "text": "هر چه علل و عوامل بوده که روی دل می‌خواسته کار بکنه و به چیزی را می‌خواسته،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 387.66,
   "end": 390.4,
   "text": "خواستند او بفهمانند که تو این را می‌خوای.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 390.4,
   "end": 394.96,
   "text": "از اون اول بچگی حساب بکنید به نظرتون بیاره به مجسم می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 394.96,
   "end": 397.44,
   "text": "هر خواستند میگن این و اون را می‌خواهی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 397.44,
   "end": 400.23,
   "text": "تا حالا هم گفتند و میگن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 400.23,
   "end": 403.89,
   "text": "مثل اینکه آسمان و زمین مثل اینکه همه اینو میگن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 403.89,
   "end": 405.56,
   "text": "البته آسمان و زمین نمی‌گوید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 405.56,
   "end": 414.38,
   "text": "در واقع اگر تربیت غلطی باشد، ضلالتی باشد از انسان است و شیطان ماورای انسان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 414.38,
   "end": 420.7,
   "text": "اینجور ترغیب کردند و به راه ضلالت انداختند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 420.7,
   "end": 425.34,
   "text": "دل را و تا حالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 425.34,
   "end": 430.16,
   "text": "دل در راه ضلالت است تا به حال بیداری.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 430.16,
   "end": 433.52,
   "text": "یعنی در راه رسیدن به این و آن است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 433.52,
   "end": 438.52,
   "text": "در راه رسیدن به اغیار است، در راه داشتن اغیار است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 438.52,
   "end": 442.0,
   "text": "و آرزوی اغیار است و محبت اغیار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 442.0,
   "end": 447.32,
   "text": "و خلاصه فکر می‌کنه که دل تا به حال روی این تربیت‌های غلط",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 447.32,
   "end": 449.38,
   "text": "بهش قبولاندن چون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 449.38,
   "end": 453.3,
   "text": "اغیار را می‌خواهی در اغیار فانی گشته و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 453.3,
   "end": 455.3,
   "text": "کاملاً فانی گشته،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 455.3,
   "end": 459.54,
   "text": "پراکنده شده. این راه ضلالت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 459.54,
   "end": 466.48,
   "text": "وقتی کسی بیدار می‌شود از این راهی که از اول بچگی تا حالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 466.48,
   "end": 472.64,
   "text": "خود و دیگران در این راه پیش برده‌اند، او را از این راه برمی‌گرداند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 472.64,
   "end": 476.92,
   "text": "از این راه. هر چه بوده تا به حال غلط بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 476.92,
   "end": 479.6,
   "text": "هرچی می‌خواسته این نادرست بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 479.6,
   "end": 482.2,
   "text": "هرچه محبت داشته این بیجا بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 482.2,
   "end": 485.48,
   "text": "هر آرزوی باطل داشته این غلط بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 485.48,
   "end": 489.04,
   "text": "همه خیال بوده. اصلاً راه من این نبوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 489.04,
   "end": 491.54,
   "text": "مطلوب دل هم این نبوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 491.54,
   "end": 495.24,
   "text": "زحمت هم نمی‌بایست در این راه می‌کشیدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 495.24,
   "end": 498.08,
   "text": "غصه هم نمی‌بایست می‌خوردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 498.08,
   "end": 500.72,
   "text": "شاد هم نمی‌بایست می‌شدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 500.72,
   "end": 503.78,
   "text": "و جنگ و نزاع و دوستی و صلح هم با",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 503.78,
   "end": 505.88,
   "text": "همدیگه نمی‌بایست داشته باشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 505.88,
   "end": 507.9,
   "text": "اصلاً هرچه بوده غلط بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 507.9,
   "end": 512.04,
   "text": "خوب تصور کنید هرچه بوده راه ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 512.04,
   "end": 516.36,
   "text": "تا حالا قبل از بیداری با همه ابعادش غلط بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 516.36,
   "end": 519.6,
   "text": "یک دفعه به خود میاییم غلط بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 519.6,
   "end": 529.56,
   "text": "و طبعا وقتی بر می‌گردیم در نتیجه یگزه به صورت توبه از این راهی که با ابعادش در پیش گرفته بودیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 529.56,
   "end": 533.38,
   "text": "با همه معیارها و ابعاد و ارزش‌هاش بر می‌گردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 533.38,
   "end": 537.22,
   "text": "این برگشت به این معناست به یک نظر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 537.22,
   "end": 545.0,
   "text": "به یک نظر، همین برگشت از این راه ضلالت، برگشت از همه چیز به سوی خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 545.0,
   "end": 549.08,
   "text": "چون این راه به سوی غیر خدا منتهی می‌شد تا به حال،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 549.08,
   "end": 554.96,
   "text": "سوی اغیار و این برگشت از این راه در واقع برگشت از کل اغیار است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 554.96,
   "end": 560.82,
   "text": "توبه از کل اغیار است به سوی خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 560.82,
   "end": 570.18,
   "text": "این اثر از آثار یگزه و قدم دومه که میگن بعد از یگزه سالک باید توبه بکنه یعنی برگردد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 570.18,
   "end": 573.64,
   "text": "از راه ضلالت به راه انسان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 573.64,
   "end": 576.8,
   "text": "و از غیر به سوی خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 576.8,
   "end": 582.74,
   "text": "بنابراین معنی توبه برای ما در کل به عنوان یک معنی وسیع",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 582.74,
   "end": 586.82,
   "text": "که قرآن اون را مطرح می‌فرماید،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 586.82,
   "end": 590.44,
   "text": "انسان باید توبه بکند معنی توبه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 590.44,
   "end": 597.08,
   "text": "همین است. یعنی در معنی وسیعش برگشت از اغیار به سوی اوست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 597.08,
   "end": 600.96,
   "text": "پشت کردن به اغیار، رو به خدا کردن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 600.96,
   "end": 607.08,
   "text": "از اغیار بازگشت نمودن به سوی خدا در کل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 607.08,
   "end": 608.64,
   "text": "در این زمینه که گفتم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 608.64,
   "end": 617.32,
   "text": "قرآن این توبه را مطرح می‌کنه به یکی دو آیه اشاره می‌کنیم بعد مطلب را ادامه می‌دهیم که توبه به این معناست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 617.32,
   "end": 620.62,
   "text": "و اون صورت‌های دیگر توبه بعد عرض می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 620.62,
   "end": 625.28,
   "text": "در کل معنی توبه که در قرآن از انسان خواسته شده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 625.28,
   "end": 632.02,
   "text": "از انسان خواسته شده از راهی که در پیش گرفته بود هر وقت بیدار شد برگردد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 632.02,
   "end": 634.22,
   "text": "اول می‌خواد قرآن بیدار بکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 634.22,
   "end": 636.32,
   "text": "وقتی بیدار شد میگه برگرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 636.32,
   "end": 639.38,
   "text": "از کل راهی که گرفته بودی در پیش برگرد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 639.38,
   "end": 641.68,
   "text": "یا از اغیار برگرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 641.68,
   "end": 644.84,
   "text": "دل او را می‌خواهد به سوی او برگردد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 644.84,
   "end": 648.02,
   "text": "در این زمینه آیات و روایات زیاد داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 648.02,
   "end": 651.0,
   "text": "من به یکی، دو نمونه فقط اشاره می‌کنم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 651.0,
   "end": 653.86,
   "text": "که توبه‌ای به معنی وسیع را،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 653.86,
   "end": 656.96,
   "text": "برگشت به سوی خدا را مطرح می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 656.96,
   "end": 659.92,
   "text": "سوره نور آیه سی و دو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 659.92,
   "end": 664.38,
   "text": "می‌فرماید اینجا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 664.38,
   "end": 672.86,
   "text": "مسئله این که چه عملی کرده، چه اشتباهی، اینا مطرح نیست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 672.86,
   "end": 679.46,
   "text": "ها. آیه به اتم به صورت وسیع در یک کتاب شامل به همه انسان‌ها،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 679.46,
   "end": 681.2,
   "text": "انسان‌ها خطاب می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 681.2,
   "end": 690.14,
   "text": "می‌فرماید برگردید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 690.14,
   "end": 694.18,
   "text": "به سوی خدا همه مؤمنین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 694.18,
   "end": 697.6,
   "text": "شاید نجات پیدا کنید، برگردید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 697.6,
   "end": 699.62,
   "text": "دیگه از چی برگردید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 699.62,
   "end": 704.4,
   "text": "مطرح نیست. از همه برگردید چون غیر او نباید مقصود باشد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 704.4,
   "end": 706.66,
   "text": "از هرچه هست برگردید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 706.66,
   "end": 712.5,
   "text": "این یک آیه. آیه دیگر، آیه نه از سوره تحریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 712.5,
   "end": 714.38,
   "text": "این آیه را هم به عنوان نمونه می‌خوانیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 714.38,
   "end": 719.27,
   "text": "در مضمون آیه بحث می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 719.27,
   "end": 724.38,
   "text": "مؤمنین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 724.38,
   "end": 726.6,
   "text": "برگردید به سوی خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 726.6,
   "end": 728.92,
   "text": "به صورت برگشت نسو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 728.92,
   "end": 731.28,
   "text": "حالا برگشت نسو را در مقام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 731.28,
   "end": 733.96,
   "text": "تشریح مراحل توبه بعدا عرض می‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 733.96,
   "end": 736.7,
   "text": "همینه در اینجا به صورت برگشت کلی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 736.7,
   "end": 740.88,
   "text": "به برگشت کلی دعوت می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 740.88,
   "end": 748.0,
   "text": "اگه برگردید به سوی خدا امید است که خدا سیئات شما را از میان بردارد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 748.0,
   "end": 750.68,
   "text": "اون عیوب شما را، اون حجاب‌ها را بردارد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 750.68,
   "end": 757.08,
   "text": "چون در برگشت اون حجاب‌ها در برگشت کلی از اغیار و سوی خدا حجاب‌ها برداشته می‌شود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 757.08,
   "end": 759.14,
   "text": "این ادعای سیئات در اینجا اون معن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}