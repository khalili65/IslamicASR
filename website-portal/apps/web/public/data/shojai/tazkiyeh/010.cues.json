 ],
 "cues": [
  {
   "i": 0,
   "start": 0.42,
   "end": 3.96,
   "text": "اعوذ بالله السميع العليم من الشيطان الرجيم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 3.96,
   "end": 7.08,
   "text": "بسم الله الرحمن الرحيم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 7.08,
   "end": 9.92,
   "text": "توبه برگشت از غیر خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 9.92,
   "end": 12.98,
   "text": "از یک طاع شد به معنی وسیله‌ش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 12.98,
   "end": 16.36,
   "text": "البته منازل خدا هم یکم برای حالت ، ولی کل توبه برگشت از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 16.36,
   "end": 20.28,
   "text": "غیر، آگاه شدن و برگشته از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 20.28,
   "end": 21.88,
   "text": "غیر حضور خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 21.88,
   "end": 24.16,
   "text": "این برگشت که شروع شد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 24.16,
   "end": 31.67,
   "text": "و انسان و سالک که به واحه طلب یا به مرحله طلب وارد شد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 31.67,
   "end": 35.0,
   "text": "در مرحله طلب که صعود خواهد کرد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 35.0,
   "end": 37.58,
   "text": "به صعود خواهد کرد، مسئله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 37.58,
   "end": 40.4,
   "text": "انابه شروع می‌شود. یعنی انابه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 40.4,
   "end": 43.5,
   "text": "یعنی این چنین سالکی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 43.5,
   "end": 46.76,
   "text": "در کل یک حالت اضطرار،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 46.76,
   "end": 49.08,
   "text": "یک حالت وحشت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 49.08,
   "end": 53.34,
   "text": "از غیر دارد که یک حالت انس با خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 53.34,
   "end": 58.19,
   "text": "و یک حالت اطمینان به خدا یا با خدا یا با ذکر خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 58.19,
   "end": 61.3,
   "text": "این حالت را میگوییم انابه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 61.3,
   "end": 63.44,
   "text": "یا این منزل را میگوییم انابه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 63.44,
   "end": 67.02,
   "text": "منزل انابه. که اشاره می‌کنم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 67.02,
   "end": 69.74,
   "text": "قبل از خوندن آیاتش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 69.74,
   "end": 76.86,
   "text": "انسان بعد از اینکه برگشت از غیر حضور خدا و شروع کرد در منزل طلب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 76.86,
   "end": 79.14,
   "text": "به حرکت شروع کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 79.14,
   "end": 82.68,
   "text": "این‌چنین انسانی فرض کنید صادق باشد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 82.68,
   "end": 85.0,
   "text": "البته موقعی که در اینها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 85.0,
   "end": 90.24,
   "text": "کردم و از کرده‌ام الهام هم عرض می‌کنم هیچ وقت خودمون تخیل نکنید، فقط از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 90.24,
   "end": 92.54,
   "text": "نظر فکری تخیل بکنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 92.54,
   "end": 96.02,
   "text": "یعنی از نظر فکری که واقعاً باید چنین باشد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 96.02,
   "end": 101.72,
   "text": "اگر راست باشد. بعد از اینکه کسی طاع بود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 101.72,
   "end": 110.74,
   "text": "و برگشت، این که بر صعود حرکت کرد، شروع به حرکت کرد یعنی برگشته از غیر حضور خدا و حالا این راه صعود را به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 110.74,
   "end": 113.72,
   "text": "قدم برمی‌دارد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 113.72,
   "end": 117.88,
   "text": "این‌چنین انسانی حالت دارد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 117.88,
   "end": 119.9,
   "text": "البته این حالتش هم مراقب باید،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 119.9,
   "end": 121.86,
   "text": "ولی حالت دارد در کل که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 121.86,
   "end": 124.08,
   "text": "این حالت عبارت است از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 124.08,
   "end": 130.92,
   "text": "انس داشتن به خدا، مطمئن بودن، آرام بودن فقط با یاد خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 130.92,
   "end": 135.22,
   "text": "و وحشت داشتن از غیر خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 135.22,
   "end": 139.78,
   "text": "این چنین حالت و این چنین مسئله را و این چنین منزل را میگوییم انابه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 139.78,
   "end": 147.42,
   "text": "حالا بر اشارات قرآن اشاره می‌کنم و به خوندن آیات که این حالت وقتی این چنین حالت است از کجا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 147.42,
   "end": 150.06,
   "text": "از کدام نکته از نکته‌های قرآن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 150.06,
   "end": 156.8,
   "text": "و از کدام اشارات، اشارات قرآن برداشت می‌کنیم و به خوندن و بنا بر آیات اشاره می‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 156.8,
   "end": 159.62,
   "text": "بعضی‌ها می‌، می‌شنیده‌اید، دیده‌اید،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 159.62,
   "end": 162.6,
   "text": "آثارشون رو خوندید، حالاتشون رو دیدید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 162.6,
   "end": 165.04,
   "text": "که گرفتاره‌هایی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 165.04,
   "end": 170.54,
   "text": "در دنیا بعضی گرفتاری‌ها مثلا یک محبت مجازی براشون پیش میاد که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 170.54,
   "end": 174.98,
   "text": "انسانی می‌بینه گرفتار انسان می‌شود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 174.98,
   "end": 178.16,
   "text": "و این گرفتاره، این تعلق تمام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 178.16,
   "end": 180.74,
   "text": "وجودش را میگیرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 180.74,
   "end": 185.4,
   "text": "دوست داشتی مرض. نامش را احیانا عشق هم می‌گذارند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 185.4,
   "end": 188.76,
   "text": "یک شرایطی مرض تمام وجودش را میگیرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 188.76,
   "end": 192.06,
   "text": "این‌چنین انسانی معمولاً یک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 192.06,
   "end": 195.36,
   "text": "حالتی دارد، اون انس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 195.36,
   "end": 197.8,
   "text": "فقط آرام شدن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 197.8,
   "end": 201.56,
   "text": "به ذکر اون محبوب یا با اون محبوب بودن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 201.56,
   "end": 205.6,
   "text": "هر کس که به اون محبوب مربوط است با اون آرام می‌گیرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 205.6,
   "end": 212.68,
   "text": "این‌ها اگر هرچه را که مطلب داشته از خوبی‌ها، از لذت‌ها، از اشتهاها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 212.68,
   "end": 217.46,
   "text": "و هر کاری را هم صورتا بخواهد انجام دهد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 217.46,
   "end": 220.1,
   "text": "کاملاً صوری است. با اون گرفتاری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 220.1,
   "end": 223.34,
   "text": "که хоть دیگر است. با هیچ‌چی آرام نمی‌شود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 223.34,
   "end": 226.06,
   "text": "از چیزی خوش نمی‌شود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 226.06,
   "end": 234.22,
   "text": "انابه حالتی است که وقتی منزلی است که وقتی کسی این منزل وارد شد، دیگه قبل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 234.22,
   "end": 236.5,
   "text": "مانند افعال معمولی نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 236.5,
   "end": 242.62,
   "text": "اگر از این مسافتی غیر حق است کلاً چیزی داشته باشد، مشغول باشد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 242.62,
   "end": 248.02,
   "text": "با آنها باشد، باطنش همیشه ناراحت است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 248.02,
   "end": 253.1,
   "text": "یعنی نمی‌تواند دلش هست نمی‌چسبد، ناآرام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 253.1,
   "end": 258.98,
   "text": "یک چیزی مثل اینکه اگر کسانی حالت انتظاری دارد، اگر التفو به غیر کند،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 258.98,
   "end": 261.3,
   "text": "یک حالت ناآرامی دارد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 261.3,
   "end": 265.64,
   "text": "یعنی صورتا اگر یک حالتی، کاری داشته باشد باطنش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 265.64,
   "end": 269.72,
   "text": "نمی‌سازد با این کار، نمی‌چسبد به این.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 269.72,
   "end": 279.22,
   "text": "فقط اون وقت آرام است و آن وقت مثل اینکه خارج هم است اطمینان خاطر دارد که به ذکر حق با حق است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 279.22,
   "end": 281.42,
   "text": "این حالت انابه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 281.42,
   "end": 283.27,
   "text": "منزل انابه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 283.27,
   "end": 289.5,
   "text": "البته این منزل را از کردم، اشارات کردم که توجّه داشته باشید خود این منزل،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 289.5,
   "end": 293.88,
   "text": "خود این حالت از یک درجه‌ای، از یک مرتبه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 293.88,
   "end": 296.76,
   "text": "از یک نقطه شروع می‌شود و شدت پیدا می‌کند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 296.76,
   "end": 299.4,
   "text": "یعنی خودش مراقب دارد هم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 299.4,
   "end": 308.14,
   "text": "کل بحث الکی آمده‌ایم. آرام بودن در جای خدا، وحشت داشتن از غیر خدا، آرامش داشتن فقط با خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 308.14,
   "end": 310.54,
   "text": "این یک حالتی است و مراقب هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 310.54,
   "end": 316.8,
   "text": "خب این منزل بعد از توبه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 316.8,
   "end": 321.82,
   "text": "حالا من قبل از اینکه به آیات بپردازم برای اینکه ترتیب بحث ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 321.82,
   "end": 329.1,
   "text": "از ذهن شما دور نباشد، در این وسط قبل از پرداختن به آیه یک نکته‌ای اشاره می‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 329.1,
   "end": 336.78,
   "text": "اون اینکه نظرتون هست ما در مقدمه بحث الکی که به عنوان مقدمه این بحث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 336.78,
   "end": 339.32,
   "text": "یک چندین جلسه بحث کردیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 339.32,
   "end": 346.26,
   "text": "نظرتون هست که از قدیم، از قدیم انسان در محبت عواطف دنیا قرار گرفته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 346.26,
   "end": 349.74,
   "text": "و اگر بخواهد برگردد باید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 349.74,
   "end": 355.24,
   "text": "راهی را در پیش بگیرد که از این محبت چی بکند؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 355.24,
   "end": 364.88,
   "text": "خلاص بشود. اولین قدمی که انسان در صعود و صیرت و برگشت و رجعت باید بردارد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 364.88,
   "end": 371.0,
   "text": "از همان اولین قدمش برگشت و انصراف از حیات دنیاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 371.0,
   "end": 375.99,
   "text": "این را که رسید به آنجا از حیات‌های بعدی برات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 375.99,
   "end": 378.84,
   "text": "راه صعود راهی است که از همان گز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 378.84,
   "end": 386.92,
   "text": "که شروع می‌شود. و به اشخاص و اشخاص آخر برگشت است از حیات دنیا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 386.92,
   "end": 389.84,
   "text": "مردن است از حیات دنیا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 389.84,
   "end": 392.38,
   "text": "رفتن است به سوی حیات بالا تر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 392.38,
   "end": 395.32,
   "text": "باز مردن است از آن حیات بالا تر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 395.32,
   "end": 399.18,
   "text": "صعود است به حیات بالاتر از آن و الی آخر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 399.18,
   "end": 407.64,
   "text": "این مقدمه رو گفته بودم و حتی نظری هست که این مقدمه را متجمل کنیم که راه برگشت رو برای ما خوب روشن باشد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 407.64,
   "end": 410.84,
   "text": "بر اساس مقدمه باید توجه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 410.84,
   "end": 413.44,
   "text": "داشته باشید ما هر منزلی را که مطرح",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 413.44,
   "end": 423.2,
   "text": "می کنیم این منزل بر اساس این مطلب کلی در این منزل ما از حیات دنیا منصرف می‌شویم و از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 423.2,
   "end": 425.04,
   "text": "حیات‌های بالا تر هم باز به تدریج",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 425.04,
   "end": 429.31,
   "text": "منصرف باید بشیم و الا راه برگشت نخواهد بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 429.31,
   "end": 437.12,
   "text": "یعنی گز که کسی که بیدار شد به اندازه‌ی بیداریش از حیات دنیا، حیات دنیایش متزلزل شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 437.12,
   "end": 439.32,
   "text": "توبه که کرد، همان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 439.32,
   "end": 444.22,
   "text": "قدم دوم، به اندازه‌ی توبه باز حیات دنیا متزلزل شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 444.22,
   "end": 448.3,
   "text": "در این عنابه حیات دنیا خیلی متزلزل می‌شود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 448.3,
   "end": 454.18,
   "text": "همین را متجمل کردیم. شما حساب کن کسی که این شیوه را انتخاب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 454.18,
   "end": 457.32,
   "text": "کرد که حالت وحشت از غیر و خضوع با حق و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 457.32,
   "end": 462.4,
   "text": "فرار از غیر و اطمینان به عاقبت با حق داشته باشد، این حالت را داشته باشد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 462.4,
   "end": 467.8,
   "text": "این انسان حیات دنیوی‌اش خیلی متزلزل می‌شود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 467.8,
   "end": 473.16,
   "text": "یعنی در واقع ارکان حیات دنیا در این منزل متزلزل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 473.16,
   "end": 475.68,
   "text": "است که با شکست یافتن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 475.68,
   "end": 482.4,
   "text": "عنابه و تقوی یافتن آن حیات دنیا به بسیار بیشتر از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 482.4,
   "end": 486.72,
   "text": "پیش از پیش بیش از پیش متزلزل می‌شود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 486.72,
   "end": 489.36,
   "text": "این مطلب را هم در اینجا توجه داشته باشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 489.36,
   "end": 493.0,
   "text": "در این عنابه که الان متجمل می‌ کنیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 493.0,
   "end": 498.7,
   "text": "از حیات دنیا دیگه با اون شکلی که قبلاً انسان داشت خبری نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 498.7,
   "end": 501.26,
   "text": "منظورم از حیات دنیا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 501.26,
   "end": 503.73,
   "text": "منظور از حیات دنیا توجه داشته باشید چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 503.73,
   "end": 507.7,
   "text": "اون مرحله‌ای که آقای ثقفی گفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 507.7,
   "end": 511.96,
   "text": "و از اون حیات واسه متزلزل میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 511.96,
   "end": 516.08,
   "text": "اینم در اینجا توجه کنید. حالا می‌رسیم به سراغ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 516.08,
   "end": 517.92,
   "text": "آیات و آیات در عنابه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 517.92,
   "end": 523.06,
   "text": "من آیات رو می‌خونم و بعد هم عنابه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 523.06,
   "end": 527.58,
   "text": "اون به اصطلاح در عنابه شریحه‌ها این بخش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 527.58,
   "end": 531.42,
   "text": "که دارم با فارسی ساده از گفته‌های حاج اقا باقری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 531.42,
   "end": 540.36,
   "text": "از عنابه اضافه متون خوبی می‌شنود که نسبت به دیگران از علما و صلوح گفته حاج",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 540.36,
   "end": 545.76,
   "text": "اقا ثقفی در مقام ترتیب گفتن عنابه را بعد از اون آثار مطرح کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 545.76,
   "end": 549.16,
   "text": "ولی خب از گفتار ایشون هم چیزایی می‌گیریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 549.16,
   "end": 551.78,
   "text": "حالا اول به آیات بپردازیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 551.78,
   "end": 556.86,
   "text": "ببینیم آیات عنابه را چگونه مطرح می‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 556.86,
   "end": 559.68,
   "text": "در سورهی رعد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 559.68,
   "end": 564.08,
   "text": "آیه بیست و هفت و بیست و هشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 564.08,
   "end": 568.78,
   "text": "و یقول الذين كفروا لولا انزل عليه آية من ربه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 568.78,
   "end": 574.36,
   "text": "قل ان الله یذل من یشاء و يهدي لمن انا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 574.36,
   "end": 576.92,
   "text": "ان الذين آمنوا وتطمئن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 576.92,
   "end": 579.18,
   "text": "قلوبهم بذكر الله الا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 579.18,
   "end": 581.7,
   "text": "بذكر الله تطمئن القلوب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 581.7,
   "end": 584.3,
   "text": "حالا از اشارات همین آیه می‌توانیم بفهمیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 584.3,
   "end": 586.62,
   "text": "منظور عنابه چیه؟ این نکته توجه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 586.62,
   "end": 594.32,
   "text": "فرمود که وقتی قرآن عنابه را به این صورت فرموده معلوم است عنابه مسئله‌ای بزرگ است بر اساس بحث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 594.32,
   "end": 596.88,
   "text": "هرچند خیلی ساده است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 596.88,
   "end": 601.84,
   "text": "می‌فرماید که طرفدار گفتند چرا بر رسول صلوات الله بر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 601.84,
   "end": 604.16,
   "text": "رسول اکرم صلوات الله آیه ای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 604.16,
   "end": 610.44,
   "text": "نازل نشده؟ آیه‌ای ندارد، نشانه ای ندارد، موزه‌ای ندارد از آسمان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 610.44,
   "end": 613.84,
   "text": "حالا اون آیات را برای ما بردید و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 613.84,
   "end": 616.44,
   "text": "گفت برگرد به رسول اکرم صلی الله علیه وآله گفتند به او بگو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 616.44,
   "end": 622.34,
   "text": "именно بگو ان الله یذل من یشاء و يهدي لمن انا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 622.34,
   "end": 627.76,
   "text": "خدا تفسیراتی می‌خواهد همچنین به زوال می‌اندازد و تفسیراتی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 627.76,
   "end": 630.36,
   "text": "ضوع آرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 630.36,
   "end": 632.46,
   "text": "عنابه وجود کرد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 632.46,
   "end": 634.52,
   "text": "او را هدایت می‌کند. و يهدي",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 634.52,
   "end": 639.34,
   "text": "لمن انا. اینجا خدا اولا هدایتش را",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 639.34,
   "end": 648.7,
   "text": "با این آیه که را می‌خوانیم هدایت خاصه اش را شامل حال آنانی می‌داند که در منزل عنابه هستند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 648.7,
   "end": 651.98,
   "text": "یعنی کسی که روح خدا آورده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 651.98,
   "end": 655.96,
   "text": "جدی است، مخلص است، صادق است و آن تعبیری که گفتم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 655.96,
   "end": 662.02,
   "text": "شما خودتان واضحانه اگر در مطالعه این حالت پیش بیاید خدای این چنین کسی را",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 662.02,
   "end": 666.87,
   "text": "دیگه شامل این آیاتش، مشمول این آیاتش در نظر نمی گیرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 666.87,
   "end": 669.16,
   "text": "نمی‌شود خدای اینها یک کار می‌کند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 669.16,
   "end": 672.6,
   "text": "خدا می‌فرماید که و يهدي لمن انا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 672.6,
   "end": 675.78,
   "text": "هرکسی که عنابه صعود می‌کرد او را هدایت می‌کند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 675.78,
   "end": 677.88,
   "text": "آیه بعدش می‌فرماید،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 677.88,
   "end": 682.28,
   "text": "آیه بعدی می‌فرماید که،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 682.28,
   "end": 685.61,
   "text": "خب آیه بعدی در واقع عنابه را تشریح می‌کند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 685.61,
   "end": 687.82,
   "text": "بیان می‌کند. ان الذين",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 687.82,
   "end": 694.32,
   "text": "عنابه کننده‌ها آنهایی هستند که آمنوا ایمان آوردند و تطمئن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 694.32,
   "end": 698.84,
   "text": "قلوبهم بذكر الله و قلبشان به یاد خدا مطمئن است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 698.84,
   "end": 704.16,
   "text": "این همان نکته‌ای بود که گفتم این حالت وحشت از خدا و از غیر و اطمینان با خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 704.16,
   "end": 710.3,
   "text": "اون مثال زدم، مثالی را عرض کردم، مثالی را عرض کردم تکمیل می‌کند با این آیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 710.3,
   "end": 719.62,
   "text": "از جهت عدم اشتباه تو می‌داند ان الذين که می‌گویند با همین قلوب آمده در اول آیه دوم این در واقع توجیه می‌دهد همان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 719.62,
   "end": 724.0,
   "text": "من انا را در آخر آیه اول که و يهدي",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 724.0,
   "end": 728.72,
   "text": "لمن انا را خدا هدایتی که به کسانى وقتی انجام میدهند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 728.72,
   "end": 730.89,
   "text": "فوری در آیه دوم تشریح میکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 730.89,
   "end": 733.9,
   "text": "النَّصِیر آن، آنهایی را",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 733.9,
   "end": 738.58,
   "text": "که انجام میدهند آنها اونهایی هستند که آمن و طمع نکنند به غرور و بزک الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 738.58,
   "end": 742.06,
   "text": "اینها قوی‌ش اطمینان به زیک خدا دارند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 742.06,
   "end": 744.86,
   "text": "فَلَا بُزُکِى اللَّهِ تَطْمَعُوا بِهِ.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 744.86,
   "end": 748.58,
   "text": "کم و زیاد کم باشد بزک حق را طمع کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 748.58,
   "end": 750.47,
   "text": "این یک حالت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 750.47,
   "end": 754.38,
   "text": "از اشاراتش ما میفهمیم که حالت نیست، چیز است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 754.38,
   "end": 757.04,
   "text": "در اون حالات البته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 757.04,
   "end": 765.68,
   "text": "اگر بخوام بگم توجه داشته باشید اول از این بیداریا، اول این بیداریا و قدم‌های اولیه‌ست.ِ در مقام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 765.68,
   "end": 785.68,
   "text": "بحث از بیداریا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 787.72,
   "end": 800.48,
   "text": "و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 800.48,
   "end": 811.95,
   "text": "از انبیا و در این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 811.95,
   "end": 814.68,
   "text": "وقت شب تاریک که رفت به نزدیکی‌های",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 814.68,
   "end": 816.7,
   "text": "بیت اون زاتی که یه ناله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 816.7,
   "end": 819.66,
   "text": "جازد به گوشش رسید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 819.66,
   "end": 822.02,
   "text": "و شب بیت خیلی مهم واسه حج بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 822.02,
   "end": 828.3,
   "text": "کنار بیت خدا رفت. یعنی اسمعیلی رفت که میرفت به فکه حرام و بیت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 828.3,
   "end": 830.36,
   "text": "بعد تاریک بود، خیلی تاریک.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 830.36,
   "end": 838.14,
   "text": "ناله‌ها شنید و از این کسی بعد یواشکی آشنایی شد و گوش کرد و بعد دید که یک کسی است اونجا مشغول است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 838.14,
   "end": 841.78,
   "text": "تاریک بود، نمیدید و نمیشناخت دقیقاً.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 841.78,
   "end": 844.18,
   "text": "و خیلی نزدیک شد و گوش کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 844.18,
   "end": 846.9,
   "text": "دید که خیلی گوش کرد. ناله‌اش گوش کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 846.9,
   "end": 850.72,
   "text": "گوش می‌کرد و دید که زیر جوان است پس معلومه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 850.72,
   "end": 853.0,
   "text": "ناله میکنه با سوز زیاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 853.0,
   "end": 856.76,
   "text": "مطلب حرف‌ها میزند، سخن‌ها دارد و مطالب میگوید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 856.76,
   "end": 862.78,
   "text": "گفت و گفت، جیغ‌ها کرد و بعد هم دوباره بعد از جیغ‌ها و گفتن‌های زیاد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 862.78,
   "end": 866.02,
   "text": "شروع کرد این گوینده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 866.02,
   "end": 869.02,
   "text": "اشعار را اونجا میکند و گریه میکرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 869.02,
   "end": 873.22,
   "text": "کنار بیت خدا بود. کسوی بود به بیت خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 873.22,
   "end": 875.98,
   "text": "و نمیشناخت اسمعیلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 875.98,
   "end": 881.1,
   "text": "و بعد اون اشعار رو خون-- اشعارش رو هم حس کرده که بعدها نعل قریه نوشتم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 881.1,
   "end": 884.02,
   "text": "اشعار عجیبی است. بعد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 884.02,
   "end": 886.34,
   "text": "به اون دجایی گوش کرد و دقیق به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 886.34,
   "end": 889.44,
   "text": "اونجا یه گوشه‌ای ایستاده بود دید که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 889.44,
   "end": 892.4,
   "text": "مناجات بود با خدا داشت با دلش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 892.4,
   "end": 897.64,
   "text": "دجایی که رسید خیلی فریاد و بزم و ناله بلند کرد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 897.64,
   "end": 900.98,
   "text": "و گفتار رفت به نزدیک.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 900.98,
   "end": 904.4,
   "text": "اسمعیلی رفت به نزدیک و تاریک هم بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 904.4,
   "end": 906.54,
   "text": "نشست و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 906.54,
   "end": 909.12,
   "text": "سرش رو روی زانوش گذاشت و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 909.12,
   "end": 912.8,
   "text": "نگاه کرد از نزدیک دید امام سجاد سلام الله علیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 912.8,
   "end": 914.9,
   "text": "پس حالت البته خاصی بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 214,
   "start": 914.9,
   "end": 918.88,
   "text": "یعنی الان طمع نکرده بود. بحث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 215,
   "start": 918.88,
   "end": 926.1,
   "text": "این حالت را اسمعیلی دید گریه کرد و از کثرت اشکش که صورت امام افتاد که به خودش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 216,
   "start": 926.1,
   "end": 928.68,
   "text": "آمد نگاه می‌کرد و اول این حرف را زد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 217,
   "start": 928.68,
   "end": 932.62,
   "text": "گفت چیزی بین من و خدا شاهد شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 218,
   "start": 932.62,
   "end": 938.21,
   "text": "این حالت دلعلقه‌ است در مقام دلالت هم بسیار شدید است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 219,
   "start": 938.21,
   "end": 939.93,
   "text": "الان ناراحت بود از این که چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 220,
   "start": 939.93,
   "end": 943.1,
   "text": "که آمده در این وسط جلوی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 221,
   "start": 943.1,
   "end": 948.0,
   "text": "مورد توجه امام سجاد سلام الله علیه اینجور برام چیز بین من",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 222,
   "start": 948.0,
   "end": 950.68,
   "text": "و تبدیل به من حاصله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 223,
   "start": 950.68,
   "end": 954.9,
   "text": "شد. و ما توفیقی إلا بالله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 224,
   "start": 954.9,
   "end": 958.34,
   "text": "این درست به خاطر واسه همینم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 225,
   "start": 958.34,
   "end": 961.9,
   "text": "که ما حتماً باید حقوق رو بخوریم برای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 226,
   "start": 961.9,
   "end": 963.76,
   "text": "حقوق رو تخطئه نکنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 227,
   "start": 963.76,
   "end": 966.16,
   "text": "گام‌های ابتدایی رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 228,
   "start": 966.16,
   "end": 970.16,
   "text": "عرض بکنم. ماها در معنی و معنای که وقتی به نماز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 229,
   "start": 970.16,
   "end": 976.84,
   "text": "و عبادتی، سجده‌ای، ذکری چیزی مشغول باشیم اصلاً خودمون در حال فرار هستیم در مقام عبادت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 230,
   "start": 976.84,
   "end": 980.08,
   "text": "این یه شکی نیست. در حالی که این است که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 231,
   "start": 980.08,
   "end": 982.34,
   "text": "در اون موقعی که تمام میشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 232,
   "start": 982.34,
   "end": 988.8,
   "text": "شما حالا بعد از این یه دقتی بکنید آیا این عبادت شروع کرده که hopes که نمی‌رود تمام بشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 233,
   "start": 988.8,
   "end": 993.02,
   "text": "و خدای متعال یه مقدار بوی مسائل ممکنه استشمام بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 234,
   "start": 993.02,
   "end": 995.04,
   "text": "حالا تازه از این که فرار کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 235,
   "start": 995.04,
   "end": 999.07,
   "text": "ولی اول این موضوعیت ما بود که در مقابل همین وضع حالت فرار از حق است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 236,
   "start": 999.07,
   "end": 1008.06,
   "text": "باید مراقب باشیم. نماز می‌خوانیم در ضمن خوشیم و همت خوشیم وقتی تمام میشه حس میکنیم حال شدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 237,
   "start": 1008.06,
   "end": 1011.22,
   "text": "خوشی و فرحت. درست سخن و قام این حالت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 238,
   "start": 1011.22,
   "end": 1013.6,
   "text": "آیه بیست و هشت سوره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 239,
   "start": 1013.6,
   "end": 1016.24,
   "text": "و ما توفیقی إلا بالله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 240,
   "start": 1016.24,
   "end": 1018.89,
   "text": "علیه توکل کن و به نایب الیمون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 241,
   "start": 1018.89,
   "end": 1024.14,
   "text": "این از فرمایش‌های امام سجاد سلام الله علیه که می‌گوید که اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 242,
   "start": 1024.14,
   "end": 1028.0,
   "text": "اذیت‌هایی که میشنید پیش هذا و اذیت‌ها و حرف‌هایی که می‌زدند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 243,
   "start": 1028.0,
   "end": 1030.82,
   "text": "فرمود که hope من به خدا نیست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 244,
   "start": 1030.82,
   "end": 1033.74,
   "text": "توکل به خداست و انا ام سولی او.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 245,
   "start": 1033.74,
   "end": 1036.96,
   "text": "یعنی بس آیات انا به معلوم شود انا چیست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 246,
   "start": 1036.96,
   "end": 1040.12,
   "text": "و इसलिए می‌گوید من در حال انا هستم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 247,
   "start": 1040.12,
   "end": 1043.9,
   "text": "از زبان رسول صلوات الله علیه پس در آیه ده سوره زال.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 248,
   "start": 1043.9,
   "end": 1046.72,
   "text": "الله ربی علیه توکلت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 249,
   "start": 1046.72,
   "end": 1052.35,
   "text": "و الیه همن. من در مقام توکلم و در مقام انا هستم به سوی خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 250,
   "start": 1052.35,
   "end": 1055.92,
   "text": "این هم از زبان رسول اکرم صلوات الله علیه بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 251,
   "start": 1055.92,
   "end": 1059.86,
   "text": "آیه دیگر پنجاه و چهار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 252,
   "start": 1059.86,
   "end": 1062.42,
   "text": "و پنجاه و شش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 253,
   "start": 1062.42,
   "end": 1065.78,
   "text": "زمر می‌فرماید و انيبوا الى ربکم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 254,
   "start": 1065.78,
   "end": 1068.06,
   "text": "انيبوا الى ربکم. این دیگه به ماها در واسه انسان‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 255,
   "start": 1068.06,
   "end": 1070.58,
   "text": "باز معلوم است که معنای چیست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 256,
   "start": 1070.58,
   "end": 1073.54,
   "text": "این رو هم می‌کردم بخوانم که معلوم بشه و اشاراتش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 257,
   "start": 1073.54,
   "end": 1075.2,
   "text": "هم اجابت دارند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 258,
   "start": 1075.2,
   "end": 1077.12,
   "text": "و انيبوا الى ربکم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 259,
   "start": 1077.12,
   "end": 1079.78,
   "text": "انا به در شأن خود به سوی خدا есть اصل نهمده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 260,
   "start": 1079.78,
   "end": 1083.14,
   "text": "بود. اصل نهمده که در بر ابств.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 261,
   "start": 1083.14,
   "end": 1086.66,
   "text": "من بعد ان لتتکوا العذاب ثم لا یثرون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 262,
   "start": 1086.66,
   "end": 1090.78,
   "text": "بعد از آن عذاب یارو مشمول عذاب نشوید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 263,
   "start": 1090.78,
   "end": 1093.4,
   "text": "فتموا احسن ما اونزیل الیکم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 264,
   "start": 1093.4,
   "end": 1096.45,
   "text": "من ربکم. این که در پیش روی شما باشد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 265,
   "start": 1096.45,
   "end": 1103.34,
   "text": "در آیه قبول بعد از اینکه در آیه اول دستور انا را می‌دهد در آیه دوم می‌فرماید که و اتبعوا احسن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 266,
   "start": 1103.34,
   "end": 1108.54,
   "text": "ما اونزیل. تسلیم باشید در مقابل این که خدا دستور داده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 267,
   "start": 1108.54,
   "end": 1116.54,
   "text": "خب، اینها آیاتی بود که خداوند در bullshit تمامی مصحف یازده جدید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}