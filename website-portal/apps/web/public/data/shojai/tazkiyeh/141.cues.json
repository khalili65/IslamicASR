 },
 "chapters": [
  {
   "index": 0,
   "title": "بسم الله الرحمن الرحیم.",
   "start": 4.64,
   "end": 74.36
  },
  {
   "index": 1,
   "title": "## کشف معنوی موکول به بعد از ماه مبارک",
   "start": 74.36,
   "end": 106.46
  },
  {
   "index": 2,
   "title": "## معنای به‌تعویق‌افتادن کشف معنوی",
   "start": 106.46,
   "end": 212.54
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 4.64,
   "end": 12.8,
   "text": "بحث ما در در زمان بحث و آثار تشکیل در اقسام مشاغل پنج",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 12.8,
   "end": 16.44,
   "text": "بخش کشف افساری و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 16.44,
   "end": 20.24,
   "text": "سماعی و از این زودی در این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 20.24,
   "end": 27.16,
   "text": "لنزها در جلسات گذشته توضیح دادیم و بنا بود که در این جلسه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 27.16,
   "end": 30.24,
   "text": "به حساب ماه مبارک میآید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 30.24,
   "end": 34.72,
   "text": "و جلسات تشکیل میشه فعلاً.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 34.72,
   "end": 40.38,
   "text": "در آخرین جلسه که این جلسه هست در کشف معنوی هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 40.38,
   "end": 43.5,
   "text": "یه صحبتی بکنیم که کلی کلی داشته باشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 43.5,
   "end": 45.92,
   "text": "چون این قسمتی که عرض کردم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 45.92,
   "end": 51.08,
   "text": "در اصطلاح بین عرفا در اصطلاح معروف آنها را از اقسام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 51.08,
   "end": 53.42,
   "text": "کشف صوری حساب می‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 53.42,
   "end": 56.22,
   "text": "یعنی کشف را اول تقسیم می‌کنند به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 56.22,
   "end": 61.02,
   "text": "صوری و معنوی و بعد کشف صوری را هم به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 61.02,
   "end": 64.28,
   "text": "پنج قسمتی تقسیم می‌کنند که توضیح دادم و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 64.28,
   "end": 72.94,
   "text": "بعد هم کشف معنوی را بیان می‌کنند، توضیح می‌دهند و هر کسی به اندازه‌ام توضیحاتی دادند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 72.94,
   "end": 78.58,
   "text": "قرار بود در این جلسه بعد از فراغ از اقسام پنج گانه کشف صوری در کشف معنوی هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 78.58,
   "end": 87.08,
   "text": "صحبتی بکنیم و من فکر کردم که خب هم دوستان و هم خانم‌ها انتظار دارند شاید طبق انتظار گفتم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 87.08,
   "end": 91.62,
   "text": "هم و می‌گویند معمولاً به من گفتند که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 91.62,
   "end": 98.32,
   "text": "تذکراتی در خصوص ماه مبارک میآید عرض کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 98.32,
   "end": 100.96,
   "text": "دیدم که اگر این تذکرات را ما این دفعه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 100.96,
   "end": 105.68,
   "text": "این زمینه رو کنیم و بحثی در کشف معنوی کنیم داریم در یک جلسه تمام می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 105.68,
   "end": 109.08,
   "text": "این هم خیلی کلی، خیلی برای شما خواهد بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 109.08,
   "end": 113.48,
   "text": "بنا می‌خواستیم زیاد ادامه ندهیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 113.48,
   "end": 118.04,
   "text": "هم این تذکرات اینجا جای یعنی خیلی نادره کم خواهد بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 118.04,
   "end": 120.74,
   "text": "یعنی این تذکرات لازم را عرض کنیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 120.74,
   "end": 128.54,
   "text": "و هم اون بیان اجمالی که از کشف معنوی می‌خواستیم داشته باشیم، اون بیان اجمالی دیگه طوری تنظیم می‌شود،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 128.54,
   "end": 132.66,
   "text": "می‌شود مانند لابیان که دیگه فرق نمی‌کنه زیاد گفتن با",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 132.66,
   "end": 138.06,
   "text": "گفتن با نگفتن. بعد من تصمیم گرفتم که کلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 138.06,
   "end": 146.04,
   "text": "کشف معنوی را بگذارم باشد برای بعد اگر اون روز خدا خواست بعد از ماه مبارک در جمعی یا اگر خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 146.04,
   "end": 152.02,
   "text": "خواست جلسه‌ای باشد و باشیم در حضور شما، آن‌وقت کشف معنوی را",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 152.02,
   "end": 160.1,
   "text": "هم که در یک جلسه که در دو جلسه به صورت اجمال در کلی توضیح دادیم و از اون بحثی که در دست داشتیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 160.1,
   "end": 162.14,
   "text": "کاملاً تمام می‌کنیم اون بحث رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 162.14,
   "end": 165.78,
   "text": "خارج بشیم و که تمام می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 165.78,
   "end": 169.76,
   "text": "بعد از ماه مبارک اگر آن روز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 169.76,
   "end": 173.14,
   "text": "بود، جلسه خواهد بود و اگر خدا غیر از آن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 173.14,
   "end": 178.86,
   "text": "از جان دیگران خواست اگر جلسه‌ای باشد انشاالله یک برای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 178.86,
   "end": 183.66,
   "text": "بعد از ماه مبارک از حالا برنامه گذاشتم چیزی خوبی نیست بعد از ماه مبارک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 183.66,
   "end": 187.76,
   "text": "اگر بزیم دو روزی بودیم، بودیم همه جهت پوشش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 187.76,
   "end": 191.16,
   "text": "انشاالله در شما را می‌بینیم صحبت‌ها می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 191.16,
   "end": 194.08,
   "text": "اگر ندیدیم، ندیدید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 194.08,
   "end": 198.02,
   "text": "یا نشد همدیگر رو ببینیم انشاالله جسارتی بود،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 198.02,
   "end": 200.66,
   "text": "بخشید. رنجی شد، میگذرید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 200.66,
   "end": 204.39,
   "text": "از دعا فراموش نمی‌کنید. من هم به ع H شما انشاالله هستم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 204.39,
   "end": 206.46,
   "text": "السلام علیکم و رحمه الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 206.46,
   "end": 210.96,
   "text": "اللهم صل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 210.96,
   "end": 212.54,
   "text": "علی محمد و آل محمد و عجل فرجهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}