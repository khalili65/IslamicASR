   "title": "اعوذ بالله السمیع العلیم من الشیطان الرجیم. بسم الله الرحمن الرحیم.",
   "start": 0.76,
   "end": 153.76
  },
  {
   "index": 1,
   "title": "## توبهٔ ناقص و منظرِ «آمرزیده شده‌ای»",
   "start": 153.76,
   "end": 490.04
  },
  {
   "index": 2,
   "title": "## ریشهٔ اباحه در القای شیطانی",
   "start": 490.04,
   "end": 650.47
  },
  {
   "index": 3,
   "title": "## شباهت به ارتباط با ارواح",
   "start": 650.47,
   "end": 853.47
  },
  {
   "index": 4,
   "title": "## کشفِ صادق در کنارِ اغفال",
   "start": 853.47,
   "end": 1015.29
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 0.76,
   "end": 3.84,
   "text": "اعوذ بالله السميع العليم من الشيطان الرجيم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 3.84,
   "end": 6.26,
   "text": "بسم الله الرحمن الرحيم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 6.26,
   "end": 10.18,
   "text": "از دخالت شیطان براتون عرض",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 10.18,
   "end": 14.06,
   "text": "کنم. اینا دخالت‌های تخیل بود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 14.06,
   "end": 18.7,
   "text": "و وهم بود در مشاهدات و مکاشفات انسان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 18.7,
   "end": 23.4,
   "text": "که به جای مشاهدات و مکاشفات واقعی اجراء",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 23.4,
   "end": 30.72,
   "text": "شد. از دخالت شیطان. دخالت شیطان خب از اسمش می‌دانید دیگه البته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 30.72,
   "end": 37.74,
   "text": "شیطان از اسمش معلوم است اینو می‌خواستم بگم که شیطان معمولاً منظورش،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 37.74,
   "end": 46.32,
   "text": "منظورش معمولاً اهواء انسان است یا خودش یا، یا بالاخره دوستانش بالاخره هر چه انسان را چه میکنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 46.32,
   "end": 50.44,
   "text": "انسان را به اصطلاح اضلال بکند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 50.44,
   "end": 53.72,
   "text": "به ضلالت نیارد. اولین هدف شیطان این است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 53.72,
   "end": 56.34,
   "text": "در چه شیطان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 56.34,
   "end": 59.52,
   "text": "برای انسان چون عداوت خاص دارد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 59.52,
   "end": 63.38,
   "text": "غیر از اضلال ناراحتی‌های دیگر را هم خوشش میاد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 63.38,
   "end": 68.14,
   "text": "ایجاد بکند. مثلاً غض ایجاد بکند، غصه ایجاد بکند،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 68.14,
   "end": 71.02,
   "text": "ناراحتی ایجاد بکند. توجه بفرمایید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 71.02,
   "end": 73.52,
   "text": "یه وقتی در شیطان صحبت کردیم اونجا در عبارات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 73.52,
   "end": 75.36,
   "text": "حالا غیر از اینها مسائل دیگر است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 75.36,
   "end": 80.22,
   "text": "مثلا شما به خود خود محزون باشید، غصه بخورید این کار شیطان است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 80.22,
   "end": 82.65,
   "text": "شیطان خوشش میاد شما به زحمت بیفتید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 82.65,
   "end": 84.96,
   "text": "توجه بفرمایید. به زحمت بیفتید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 84.96,
   "end": 88.38,
   "text": "گرچه گفتم اولین نظرش این است که به کلی به زحمت بیفتید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 88.38,
   "end": 93.04,
   "text": "یکجا پدر شما را دربیارد و اونیکه به ضلالت بیاندازد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 93.04,
   "end": 95.58,
   "text": "حالا اگر اون نشد فعلاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 95.58,
   "end": 99.02,
   "text": "اینجا فعلاً حالا به قول معروف پرانداز عداوت است دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 99.02,
   "end": 102.2,
   "text": "عداوت دارد با انسان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 102.2,
   "end": 105.34,
   "text": "تبعاً اونجا هم که دو مورد براتون گفتم از دخالت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 105.34,
   "end": 111.91,
   "text": "خیال و وهم، اونجا که مثلاً کسی یک نوبت برای خودش حادثه برای کسی از دوستانش حادثه بد بیاد و می‌بیند،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 111.91,
   "end": 114.72,
   "text": "اونجا شیطان باز بی سهم است یا بی سهم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 114.72,
   "end": 117.24,
   "text": "با سهم است یا نیست؟ با سهم است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 117.24,
   "end": 121.84,
   "text": "ولی حالا صحبت من در دخالت شیطان در اونجایی است که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 121.84,
   "end": 124.02,
   "text": "به اصطلاح بیشتر عبارات شیطان گفته می‌شود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 124.02,
   "end": 126.56,
   "text": "نظر شیطان همیشه در کمین است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 126.56,
   "end": 130.64,
   "text": "شیطان با ما هست و در کمین هم هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 130.64,
   "end": 133.44,
   "text": "و قسم یاد کرده هیچ کس از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 133.44,
   "end": 139.7,
   "text": "به اصطلاح در تحت نظر شیطان یعنی شیطان بهش نظر نداشته باشد نیست از انسان‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 139.7,
   "end": 141.68,
   "text": "إلا من أسنَهُ الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 141.68,
   "end": 144.26,
   "text": "مگر معصوم باشند که خدا معصومی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 144.26,
   "end": 146.5,
   "text": "بقیه شیطان در سراغشون هست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 146.5,
   "end": 150.96,
   "text": "در همه احوال. خب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 150.96,
   "end": 156.24,
   "text": "عرض کنم که می‌بینید که خب طرف حالا یه خورده رو راه شده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 156.24,
   "end": 160.94,
   "text": "چیزای انواع چیزی هم می‌بیند و یواش یواش مناظر دیدن و تش--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 160.94,
   "end": 163.32,
   "text": "مشاهدات و مکاشفات ابتدایی‌اش یه خورده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 163.32,
   "end": 167.4,
   "text": "یه خورده ابتدایی کامل‌تر شده که انسان می‌تونه ببینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 167.4,
   "end": 171.98,
   "text": "خب عرض کنم که خوشش میاد که حالا من",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 171.98,
   "end": 174.96,
   "text": "عرض کنم اون طرف رو که می‌بینه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 174.96,
   "end": 181.96,
   "text": "خوشش میاد ببیند که این گرفتاری‌ها و مثلاً گناهانی که تا به حال کرده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 181.96,
   "end": 186.44,
   "text": "اون گناهان زیادی که داشته در عمرش، مانند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 186.44,
   "end": 194.68,
   "text": "خیلی از این آیان و خانم‌ها که دو، سه سال است به راه آمده‌اند و فکر می‌کنند که از انبیا هم بالاترند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 194.68,
   "end": 198.78,
   "text": "توجه کنید. خب فهمیدید که چی گفتم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 198.78,
   "end": 204.4,
   "text": "دو، سه سال است همش به راه آمده‌اند ولی فراموش کرده‌اند که یک عمر با خدا چه بوده‌اند؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 204.4,
   "end": 207.38,
   "text": "در حال جنگ بوده‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 207.38,
   "end": 213.5,
   "text": "اینا دقت نمی‌کنند که مسئله پاک شدن از گناهان به این آسانی نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 213.5,
   "end": 219.48,
   "text": "یک عمر باید با ندامت و سوز و آتش ندامت در باطن و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 219.48,
   "end": 224.62,
   "text": "تضرع این‌ها تا آخر عمر که آدم به معصیت یه تصورش را",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 224.62,
   "end": 230.84,
   "text": "نکرد و در عمر امیدوار بود که احتمالاً خدا اونچه که در باطن ما بود اون‌ها را چه بکنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 230.84,
   "end": 234.1,
   "text": "اون‌ها را پاک بکنه. این شرط توبه اینجور است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 234.1,
   "end": 237.5,
   "text": "علیه السلام در نزهةالقلوب فرموده حالا من هم دارم در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 237.5,
   "end": 240.84,
   "text": "مقاله‌ای می‌نویسم انشاالله اگر عمری بود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 240.84,
   "end": 244.9,
   "text": "نگاه بکنید می‌بینید. حضرت علیه السلام فرموده می‌فرماید که نظر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 244.9,
   "end": 249.84,
   "text": "من اینه که در نزد استغفار، استغفار به این آسانی شش تا شرط داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 249.84,
   "end": 255.68,
   "text": "کی، کی، کی، کی؟ شروع که خلاصه‌اش همین بود که من خیلی کوچک و بزرگش همین بود که گفتم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 255.68,
   "end": 259.0,
   "text": "ترک کردن گناه، نادم شدن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 259.0,
   "end": 266.18,
   "text": "فوق العاده نادم شدن، تا آخر عمر نزدیک نشدن، تا آخر عمر گریه کردن، گریه و به اصطلاح ندامت و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 266.18,
   "end": 268.6,
   "text": "سوز زیاد داشتن حتی اگر بتوان گفت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 268.6,
   "end": 276.56,
   "text": "که در اون دوران گناه داشته‌ها همه ذوب بشه در بدن و اون وقت امیدوار باشد در نزهةالقلوب هست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 276.56,
   "end": 281.12,
   "text": "که خدا گناهش رو می‌بخشد و استغفار می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 281.12,
   "end": 284.54,
   "text": "خب می‌بینید که چند سال بیشتر نیست به راه آمده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 284.54,
   "end": 292.2,
   "text": "الان هم به راه آمده اینطور به راه آمده خیلی ناقص و خیلی با معرفت و شناخت خیلی ناقص یا هیچ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 292.2,
   "end": 293.9,
   "text": "و شروع کرده حالا اسمش،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 293.9,
   "end": 296.98,
   "text": "اسمش هم سالک الی الله گذاشته و در ذکر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 296.98,
   "end": 304.0,
   "text": "روتین مستحباتی بالاخره انواع در درونش فعلیانی مختلف شده و تجلی شده در مراحل اولیه‌اش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 304.0,
   "end": 310.38,
   "text": "این انواع رو می‌بینه چیز-- عموما مشرف است اما باید گنجه‌ها بود تحت نفوذ شیطان قرار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 310.38,
   "end": 312.02,
   "text": "چیه؟ نگرفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 312.02,
   "end": 317.0,
   "text": "در جا خودش مشرف است اما شیطان در کمین است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 317.0,
   "end": 320.86,
   "text": "می‌بینید که خب به نظرش میاد که حالا من",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 320.86,
   "end": 323.88,
   "text": "خوشش میاد که بداند که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 323.88,
   "end": 329.25,
   "text": "در نزد خدا چه جور است، در نزد رسول الله چه جور است، در نزد ائمه چه جور است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 329.25,
   "end": 334.04,
   "text": "فکر می‌کند که بالاخره دیگه این ترک کرده به اون‌ها رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 334.04,
   "end": 341.64,
   "text": "توجه کنید. خواجه عبدالله می‌گوید که فکر نکن یه وقتی خواجه به این نکته اشاره کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 341.64,
   "end": 348.12,
   "text": "فکر نکن یه وقتی توبه کردی و برگشتی فکر بکنی که منتی هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 348.12,
   "end": 350.26,
   "text": "حالا من به زبان ساده‌تر میگم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 350.26,
   "end": 352.92,
   "text": "منتی هم به گردن خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 352.92,
   "end": 354.52,
   "text": "چیه؟ گذاشتی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 354.52,
   "end": 358.18,
   "text": "این از اون خطرات است. خب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 358.18,
   "end": 361.81,
   "text": "فکر می‌کند که من ببینم چه جور هستم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 361.81,
   "end": 364.31,
   "text": "کاش معلوم می‌شد که من چه جور هستم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 364.31,
   "end": 367.29,
   "text": "توجه می‌کنید؟ بعد این وقتی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 367.29,
   "end": 372.09,
   "text": "در عالم خودش درست می‌شود متخیله به کار می‌افتد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 372.09,
   "end": 376.15,
   "text": "وهم به کار می‌افتد، شیطان هم به میدان می‌آد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 376.15,
   "end": 382.57,
   "text": "اصل جای مأموریت شیطان یکی از جاهاش هست که براش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 382.57,
   "end": 392.33,
   "text": "یک منظری پیش می‌آورد که در اون منظر این آیه خانم بخواند که گناهان گذشته و اینا همش چی شده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 392.33,
   "end": 397.91,
   "text": "همش رفته و در نزد خدا یک منظره‌ای دارد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 397.91,
   "end": 400.05,
   "text": "در منظر اینجا می‌بیند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 400.05,
   "end": 403.87,
   "text": "توجه می‌کنید؟ و خاطرجمع می‌شود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 403.87,
   "end": 406.17,
   "text": "این حالا در حقیقت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 406.17,
   "end": 410.51,
   "text": "به هلاک افتاد اگر به این باور افتاد یا نیفتاد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 410.51,
   "end": 412.19,
   "text": "بله. افتاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 412.19,
   "end": 419.25,
   "text": "توجه. حتی اگر رفت در گردش نماز قضا هست، روزه قضا هست، حقوق مردم هست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 419.25,
   "end": 421.57,
   "text": "گناهان زیاد هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 421.57,
   "end": 427.89,
   "text": "به هیچ نه گریه کرده، نه استغفار کرده، نه جبران گذشته از قضای مافات کرده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 427.89,
   "end": 429.94,
   "text": "فقط ترک کرده گناه را.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 429.94,
   "end": 438.31,
   "text": "اون ترکش هم به صورت اون ندامتی که از ته دل باشد، آتش در درون داشته باشد نیست، هم فقط ترک کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 438.31,
   "end": 441.13,
   "text": "خیلی این فکر می‌کند به خاطر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 441.13,
   "end": 447.17,
   "text": "اینکه منظر یا در خواب می‌بیند که بهش مثلاً وعده می‌دهند که تو بعد منظره‌ای در خواب می‌بینه فلان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 447.17,
   "end": 450.25,
   "text": "این هم کشف خواب است که تو برو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 450.25,
   "end": 454.71,
   "text": "معنیش این هست که خلاصه کارت درست شده و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 454.71,
   "end": 458.01,
   "text": "تو به اصطلاح نورچشم پروردگار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 458.01,
   "end": 460.97,
   "text": "عالم هستی. توجه می‌کنید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 460.97,
   "end": 466.93,
   "text": "اینجا شیطان پیش می‌آورد این را در بیداری و در خواب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 466.93,
   "end": 468.71,
   "text": "اینو میگن القای شیطان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 468.71,
   "end": 472.13,
   "text": "ولی شیطان از چه چیز در اینجا کمک می‌گیرد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 472.13,
   "end": 476.81,
   "text": "از تخیل انسان و از ترحم انسان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 476.81,
   "end": 483.51,
   "text": "چون اینا ابزار شیطان قرار می‌گیرند مادامی که شیطان به وجود انسان راه نفوذ دارد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 483.51,
   "end": 486.13,
   "text": "یا مثلاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 486.13,
   "end": 489.63,
   "text": "می‌بیند که فکر می‌کند که حالا اینا اینم دقت کنید که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 489.63,
   "end": 493.59,
   "text": "اباحه از اینجا شروع شده. البته این در مراحل مختلف است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 493.59,
   "end": 497.43,
   "text": "تو حالا مثلاً از گناهی نمی‌خواد دست بردارد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 497.43,
   "end": 498.95,
   "text": "خیالات به سرش می‌زند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 498.95,
   "end": 501.65,
   "text": "گفت من اینجور ذکر و ورد گفتم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 501.65,
   "end": 505.65,
   "text": "ممکن است که اصلاً اینو خدا برای من نادیده بگیرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 505.65,
   "end": 508.33,
   "text": "اشکال نکند این حرام برای من.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 508.33,
   "end": 512.61,
   "text": "توجه می‌کنید؟ این گناه برای من اشکال چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 512.61,
   "end": 516.45,
   "text": "نکند. بعد می‌بینید که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 516.45,
   "end": 520.39,
   "text": "به اصطلاح در خواب و در بیداری منظری،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 520.39,
   "end": 528.15,
   "text": "چیزی انسان براش مکشوف می‌افتد که این برای تو خلاصه اشکال چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 528.15,
   "end": 537.37,
   "text": "ندارد. و این در مراحل بالاترش همون است که مذهب اباحه را که در بین دسته‌ای از متصوفه هست پیش آورده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 537.37,
   "end": 541.61,
   "text": "دقت می‌کنید؟ یعنی در مراحل و عواقب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 541.61,
   "end": 553.91,
   "text": "مشاهدات و مکاشفات و حتی احیاناً در نهایت ببینید که یک به اصطلاح صوفی به ظاهر وارسته از خیلی مجاهدت‌ها کرده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 553.91,
   "end": 558.93,
   "text": "ولی متأسفانه نفوذ شیطان پیش آمد در مقام حالا در ابتدا نه ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 558.93,
   "end": 563.21,
   "text": "این دیگه در ابتدا نمیگم. در مراحل بالاتر، عواقب بالاتر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 563.21,
   "end": 565.93,
   "text": "براش به اصطلاح یک القای شیطانی پیش می‌آد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 565.93,
   "end": 573.17,
   "text": "مشاهده مکاشفه بالاتری و بهش به این، این مسئله القا می‌شود که دیگه از تو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 573.17,
   "end": 576.17,
   "text": "حکم و تکلیف چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 576.17,
   "end": 582.29,
   "text": "برداشت بشه. اباحه کلاً ریشه‌اش به این است که بر اثر القاءات شیطان مخصوصا در مراحل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 582.29,
   "end": 586.85,
   "text": "بالای به اصطلاح چشم، مکاشفات، مشاهدات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 586.85,
   "end": 592.01,
   "text": "توجه کردید؟ این هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 592.01,
   "end": 594.71,
   "text": "عرض کنم که یا حالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 594.71,
   "end": 596.59,
   "text": "بعضی از اینا که ما دیده‌ایم چون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 596.59,
   "end": 601.35,
   "text": "اینم این گوشه رو هم بگم درباره دیگران هم احیانا اینها به خودشون که خیانت می‌کنند،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 601.35,
   "end": 606.71,
   "text": "این بعضی از مقتضیات بازه شیطانیشون برای دیگران هم خیانت می‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 606.71,
   "end": 608.26,
   "text": "چون من از اینا هم دیده‌ام بگم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 608.26,
   "end": 610.81,
   "text": "می‌دونید که عرض کنم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 610.81,
   "end": 616.31,
   "text": "یک چیزایی می‌بینند. مثلاً من حالا به عنوان فردی که آلودگی به گناه دارم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 616.31,
   "end": 617.91,
   "text": "ببین وضع من چه جوری؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 617.91,
   "end": 620.41,
   "text": "تو چی می‌بینی؟ حالا در بیداری مثلاً.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 620.41,
   "end": 623.33,
   "text": "یک چیزی می‌بیند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 623.33,
   "end": 627.07,
   "text": "در خصوص وضع من که خیلی چشمگیر است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 627.07,
   "end": 631.75,
   "text": "من خیلی خوشم میاد و طبعا من نتیجه می‌گیرم که خلاصه این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 631.75,
   "end": 634.45,
   "text": "گناهانی که الان من دارم اینها را خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 634.45,
   "end": 636.95,
   "text": "چیه؟ به حساب نمیاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 636.95,
   "end": 640.57,
   "text": "حالا پولش را که نجات داده به ما هم شهادت می‌ده اینچنینی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 640.57,
   "end": 642.19,
   "text": "این نام القاءات شیطان است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 642.19,
   "end": 650.47,
   "text": "توجه. من در اینجا لازم است به شما بگم که با این توضیحاتی که شما که من عرض می‌کنم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 650.47,
   "end": 653.93,
   "text": "اسرار در این مسئله تمام شدنی نیستند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 653.93,
   "end": 660.37,
   "text": "خیلی من ساده میگم پیش فرض مسائل اون اندازه است که من بخواهم به پیش فرضش بپردازم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 660.37,
   "end": 665.93,
   "text": "اصلاً نه در یک جلسه و نه در چندین جلسه نمی‌شود گفت مسائلش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 665.93,
   "end": 675.09,
   "text": "خیلی اسرار دارد و اینجا اشتباهات شبیه به یک نظر، اشتباهات در این مراحل ابتداییه از نظر دخالت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 675.09,
   "end": 681.21,
   "text": "شیطان و جن و شیطان، شبیه اشتباهاتی است در ارتباطات روحی پیش می‌آد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 681.21,
   "end": 685.45,
   "text": "نمی‌دونم شنیدید یا نه. من قبلاً یک دو بار اجمالاً گفتم برا خود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 685.45,
   "end": 688.09,
   "text": "در این ارتباطات روحی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 688.09,
   "end": 692.5,
   "text": "اونجا هم یه عده‌ای الان هم اصلاً پولا سرشون می‌رود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 692.5,
   "end": 699.05,
   "text": "یعنی بازچه شیطان قرار می‌گیرند در ارتباطات روحی که با میز و با لیوان و و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 699.05,
   "end": 703.31,
   "text": "و امثال این‌ها که رابطه با ارواح پیدا می‌کنند و فکر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 703.31,
   "end": 709.01,
   "text": "می‌کنند با انسان‌ها ارتباط پیدا کردن، فکر می‌کنند اونی که روح می‌گوید حقیقت است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 709.01,
   "end": 718.13,
   "text": "این جریانی که در مشاهدات و مکاشفات ابتداییه برای افراد نپخته، اسیر نفس، اسیر هوی، اسیر خیال پیش میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 718.13,
   "end": 723.27,
   "text": "اشتباهات و دخالت‌های شیطانی شبیه دخالت‌های شیطان در اونجاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 723.27,
   "end": 725.29,
   "text": "تو اونجا شیطان عجب غوغا می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 725.29,
   "end": 729.84,
   "text": "اگر وقتی ما یه جلسه‌ای در این باب داشتیم من با شما صحبت کردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 729.84,
   "end": 737.87,
   "text": "کیه؟ در خارج حالا در اون محفل‌ها که ارتباطات روحی را برگزار می‌کردند و می‌کنند از خارج هم این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 737.87,
   "end": 741.03,
   "text": "صحبت‌ها آمده البته به ایران.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 741.03,
   "end": 747.57,
   "text": "ایران هم همین طور بعضی‌ها بودند و هستند با میز و امثال این‌ها رابطه با ارواح پیدا می‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 747.57,
   "end": 751.55,
   "text": "هیچ سنخیتیه. اونجا هم از این مسائل زیاد است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 751.55,
   "end": 754.51,
   "text": "می‌بینید یکی از جنود شیطان میاد اونجا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 754.51,
   "end": 758.71,
   "text": "و به سؤالات که می‌شود جواب‌ها می‌دهند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 758.71,
   "end": 761.77,
   "text": "جواب‌های خیلی مساعد، خیلی گمراه کننده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 761.77,
   "end": 765.41,
   "text": "مساعد یعنی مساعد با مزاج شیطان،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 765.41,
   "end": 767.19,
   "text": "نه با مزاج عقیده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 767.19,
   "end": 771.09,
   "text": "توجه می‌کنید؟ جواب‌های خیلی مساعد می‌دهند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 771.09,
   "end": 773.21,
   "text": "ارواح هم عجیب و غریب‌ها هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 773.21,
   "end": 777.93,
   "text": "یه موجودات مرموزی میان به سؤالات جواب می‌دهند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 777.93,
   "end": 784.67,
   "text": "از راه‌های مختلف. من که می‌گم به شما قبلاً هم گفتم این حرف من حرف فقط نقلی نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 784.67,
   "end": 787.43,
   "text": "من خودم در این مرحله خیلی وقت صرف کردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 787.43,
   "end": 791.33,
   "text": "خیلی ریزه کاری‌هاش عملاً با غار شده دیدیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 791.33,
   "end": 793.67,
   "text": "که ابتلاءاتی در این بیه هست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 793.67,
   "end": 797.95,
   "text": "و خیلی‌ها من دلم می‌سوزد از صدور می‌شنوم که مثلاً در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 797.95,
   "end": 801.9,
   "text": "این جریانات ارتباط با ارواح، با میز و اینا هستند و کلاه سرشون می‌ره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 801.9,
   "end": 804.01,
   "text": "فکر می‌کنم هر سوالی می‌کنند جوابش چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 804.01,
   "end": 806.41,
   "text": "جوابش عینه مادیت هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 806.41,
   "end": 811.99,
   "text": "خیلی مسائل است. گاهی درون خود انسان در جواب میاد درون خود انسان‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 811.99,
   "end": 815.31,
   "text": "مثلاً من مسلمانم. مفروضم که اسلام حق است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 815.31,
   "end": 818.85,
   "text": "اون جواب که میاد بر اساس درون کیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 818.85,
   "end": 820.8,
   "text": "درون خود من است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 820.8,
   "end": 825.89,
   "text": "میاد اسلام حق است. حتی مثلاً ادعا می‌کند من فلان مرده هستم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 825.89,
   "end": 827.43,
   "text": "خب میگه چی می‌خوای اونجا؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 827.43,
   "end": 830.97,
   "text": "حالا ما مسلمانیم میایم قرآن می‌خوانیم برای مرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 830.97,
   "end": 837.21,
   "text": "یکی از چیه؟ یکی از مسائل خوب است در درون ما این هست از درون این ناسوداگاه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 837.21,
   "end": 839.77,
   "text": "ما و که ولی هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 839.77,
   "end": 843.37,
   "text": "می‌بینید که سؤال میاد که برای ما زیاد چی بخونید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 843.37,
   "end": 845.73,
   "text": "برای ما زیاد ها؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 845.73,
   "end": 852.11,
   "text": "قرآن بخوانید. اون یکی مثلاً می‌بینید کس هم به قرآن معتقد نیست در این عالم حالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 852.11,
   "end": 856.13,
   "text": "تجربه‌ست ارتباط با ارواح چیزی تجربه‌ست آدم خوب بد نمی‌شناسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 856.13,
   "end": 860.08,
   "text": "این کارا تجربه‌ست هرکس. ارتباط با ارواح این معنا میگم‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 860.08,
   "end": 863.19,
   "text": "این‌ها ارواح انسان نیست. اصلاً بحث ما نیستند صحبت کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 863.19,
   "end": 865.6,
   "text": "نامش رو میگن ارواح. صحبتش زیاد است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 865.6,
   "end": 871.49,
   "text": "اثارش زیاد است. ولی اونیکه مفروض است درونم می‌بینید جواب میاد از همان روحی که آمده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 871.49,
   "end": 877.61,
   "text": "به هر صورت می‌گفتم که این مسائل اینجور خطرناک است البته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 877.61,
   "end": 884.73,
   "text": "ببینید گاهی در اون مشاهدات، مکاشفات در همین مراحل ابتدایش خیلی چیزها که حق میشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 884.73,
   "end": 891.19,
   "text": "و این بستگی به این دارد که اون طرفی که عهد مشاهده و مکاشف است چقدر معرفت دارد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 891.19,
   "end": 897.49,
   "text": "شناخت دارد، چقدر در پناه خداست و چقدر با حالت تضرع",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 897.49,
   "end": 901.61,
   "text": "پناهندگی به خدا و به ائمه معصومین سلام الله علیهم اجمعین است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 901.61,
   "end": 906.65,
   "text": "و لذا ما خیلی از اون کسانی که در مراحل ابتدایی مشاهدات و مکاشفات بودند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 906.65,
   "end": 909.63,
   "text": "هم حقایق زیاد دیده‌ایم. حقایق که چشم انسان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 909.63,
   "end": 915.97,
   "text": "دقیقاً می‌داند که این چیزی که مشهود افتاده عین واقعیت است و حتی گاهی چیزها که اصلاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 214,
   "start": 915.97,
   "end": 918.57,
   "text": "کاملاً پشت پرده بوده و مشهود شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 215,
   "start": 918.57,
   "end": 925.01,
   "text": "مشهود شده نه اینکه بگم صدقش نیست و اما اکثراً انسان در معرض",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 216,
   "start": 925.01,
   "end": 929.91,
   "text": "اغفالات شیطان، دخالت‌های تخیل و دخالت‌های",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 217,
   "start": 929.91,
   "end": 933.27,
   "text": "چی هست؟ دخالت‌های تله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 218,
   "start": 933.27,
   "end": 940.49,
   "text": "هم هست. با خیلی مشاهدات مکاشفته معلوم می‌کند که درست است یا نه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 219,
   "start": 940.49,
   "end": 942.97,
   "text": "خیلی معلوم می‌کنه. مثلاً یه وقتی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 220,
   "start": 942.97,
   "end": 947.9,
   "text": "در همین نزدیکا یکی از بچه‌ها که شاید الان در این جلسه باشد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 221,
   "start": 947.9,
   "end": 951.53,
   "text": "عرض کنم که یک صحبتی من با کسی می‌کردم خصوصی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 222,
   "start": 951.53,
   "end": 954.27,
   "text": "خصوصی بود یعنی دو نفری صحبت می‌کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 223,
   "start": 954.27,
   "end": 959.21,
   "text": "صحبتی بود این در رابطه با انقلاب از من سوالی می‌کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 224,
   "start": 959.21,
   "end": 964.03,
   "text": "یعنی سوالی داشت. این سؤال را من اون براش توضیح می‌دادم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 225,
   "start": 964.03,
   "end": 969.45,
   "text": "این موجب یک نوع خدمتی بر انقلاب می‌شد از ناحیه اون شخص.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 226,
   "start": 969.45,
   "end": 972.97,
   "text": "همون دو نفری نشسته بودیم و همین اتاق هم اینجا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 227,
   "start": 972.97,
   "end": 976.87,
   "text": "بعد یکی از بچه‌ها به من",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 228,
   "start": 976.87,
   "end": 980.23,
   "text": "حالا ما دو نفری اصلاً هیچ صحبت کسی نمی‌دانست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 229,
   "start": 980.23,
   "end": 982.49,
   "text": "یکی از بچه‌ها بعد از اینکه اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 230,
   "start": 982.49,
   "end": 989.99,
   "text": "جلسه تمام شد فلان یکی که از این مشاهدات مکاشفات ابتداییه برخورداره به من گفت که من امام را دیدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 231,
   "start": 989.99,
   "end": 992.57,
   "text": "منظور امام یعنی آقا را دیدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 232,
   "start": 992.57,
   "end": 996.71,
   "text": "گفت که گفت فلانه بگو که اون جوابشو بده که این در خدمت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 233,
   "start": 996.71,
   "end": 999.01,
   "text": "به نفع انقلاب کاملاً تمام شود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 234,
   "start": 999.01,
   "end": 1001.85,
   "text": "نمی‌داند که من با کی، با کی صحبت می‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 235,
   "start": 1001.85,
   "end": 1006.27,
   "text": "اون آقا در خصوص انقلاب انتظار از فلانی دارد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 236,
   "start": 1006.27,
   "end": 1008.61,
   "text": "انتظار یا سوالی که دارد رو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 237,
   "start": 1008.61,
   "end": 1011.33,
   "text": "خوب بده که این به نفع چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 238,
   "start": 1011.33,
   "end": 1015.29,
   "text": "به نفع چی؟ به نفع انقلاب خودمون. دیگه معلوم است هدف چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
