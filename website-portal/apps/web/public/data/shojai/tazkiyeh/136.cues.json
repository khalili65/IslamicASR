 ],
 "cues": [
  {
   "i": 0,
   "start": 0.72,
   "end": 3.8,
   "text": "اعوذ بالله السميع العليم من الشيطان الرجيم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 3.8,
   "end": 6.04,
   "text": "بسم الله الرحمن الرحيم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 6.04,
   "end": 10.64,
   "text": "در این مرحله اگر به فرد سالک چشمش قوی‌تر بشود،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 10.64,
   "end": 13.74,
   "text": "این طرفش به صورت شنیدن اصوات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 13.74,
   "end": 16.76,
   "text": "برزخی است. اصوات برزخی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 16.76,
   "end": 19.1,
   "text": "چون این تجربه قوی‌تر است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 19.1,
   "end": 23.44,
   "text": "اصوات برزخی عالم برزخ را قبلاً تعریفش رو گفتم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 23.44,
   "end": 28.5,
   "text": "هر jemand هم میدانه که نظام برزخی که صعودی است که نزولی است، نظامش به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 28.5,
   "end": 33.22,
   "text": "نظامی است بالاتر از این نظام مادی و به این بر این نظام مادی، به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 33.22,
   "end": 36.82,
   "text": "این مادی و این جانب چیز.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 36.82,
   "end": 39.94,
   "text": "صداها دارد. این نظام است همه چیز را دارد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 39.94,
   "end": 43.42,
   "text": "از جمله اصوات دارد، صداها دارد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 43.42,
   "end": 49.86,
   "text": "اگر کشف سمعی سالک بالا تر شد، قوی‌تر شد تقریباً به عواطف اینجوریه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 49.86,
   "end": 53.08,
   "text": "این تقریباً عواطف می‌شود که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 53.08,
   "end": 55.64,
   "text": "صدای برزخی را",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 55.64,
   "end": 59.74,
   "text": "می‌شنود و من منظورم به این حد که از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 59.74,
   "end": 63.96,
   "text": "مسائل که در برزخ می‌گذرد در حد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 63.96,
   "end": 67.74,
   "text": "کمی برخورد را می‌شود. صدای برزخی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 67.74,
   "end": 70.44,
   "text": "نه این است که در جای دور است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 70.44,
   "end": 72.06,
   "text": "این نوع اینجور است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 72.06,
   "end": 74.14,
   "text": "نه این است که پشت دیوار است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 74.14,
   "end": 76.12,
   "text": "نه، نه این است که حجابی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 76.12,
   "end": 79.92,
   "text": "بین ما و صداهای برزخی است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 79.92,
   "end": 84.52,
   "text": "اصلاً بین ما و عالم برزخ حجاج و منى هست یا نیست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 84.52,
   "end": 87.8,
   "text": "حجاج و منى نیست. ما خود در عالم برزخ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 87.8,
   "end": 91.98,
   "text": "هستیم. الان اینجا که ما نشستیم برزخ ما را احاطه دارد به لحاظ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 91.98,
   "end": 97.56,
   "text": "احاطه خود مادی بر معنوی، به لحاظ احاطه خود زمان بر زمان،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 97.56,
   "end": 103.9,
   "text": "به لحاظ احاطه خود جهت بر جهت و به لحاظ احاطه بالاخره عدم صدا عالم ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 103.9,
   "end": 105.54,
   "text": "برزخ همه ما را احاطه دارد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 105.54,
   "end": 114.04,
   "text": "اون برزخی که در شروع است مورد اول اینجا را می‌شود و اون برزخی در وجود است که در این عالم دیگر است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 114.04,
   "end": 119.8,
   "text": "به لحاظ عالم، عالم را احاطه دارد و ما درست در میان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 119.8,
   "end": 128.56,
   "text": "عالم برزخ و احاطه عالم برزخ و مسائل برزخ، دیدنی‌های برزخ، شنیدنی‌های برزخ، چشیدنی‌های برزخ،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 128.56,
   "end": 131.55,
   "text": "مشامه‌نی‌های برزخ قرار گرفتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 131.55,
   "end": 134.2,
   "text": "تمام متأسفانه از همه‌اش هستیم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 134.2,
   "end": 136.86,
   "text": "از همه‌اش در حجاب هستیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 136.86,
   "end": 139.36,
   "text": "حجاب اینجوری است. حجاب در کجاست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 139.36,
   "end": 142.19,
   "text": "حجاب در وجود خود ما است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 142.19,
   "end": 146.24,
   "text": "توجه می‌کنید؟ بله دیگه. متأسفانه حساب نکنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 146.24,
   "end": 155.06,
   "text": "صداهای برزخی را وقتی حجاب از کنار و از مشاعر حجاب کنار رفت مثلاً همین طوری که شما برزخی را می‌بیند،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 155.06,
   "end": 160.4,
   "text": "دیدنی‌های برزخ را می‌بیند، شنیدنی‌های برزخ را هم در حد خودش چی می‌کنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 160.4,
   "end": 167.56,
   "text": "در حد خودش می‌شنود. آن جاهت را می‌خواهد، هم در حد خود به همان وقت خود را می‌خواهد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 167.56,
   "end": 170.76,
   "text": "در اینجا من منظورم از شما اینه که یه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 170.76,
   "end": 174.86,
   "text": "سر مثال عرض کنم که خیلی مسئله تکراری زیاد میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 174.86,
   "end": 178.94,
   "text": "سراغ همین‌ها صحبت بکنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 178.94,
   "end": 184.04,
   "text": "البته اگر بین شما کسی باشد که نمی‌دانید که شما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 184.04,
   "end": 187.42,
   "text": "از شما خیلی هستند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 187.42,
   "end": 190.1,
   "text": "همه خوب. نمی‌دانیم ولی به اینجا می‌شود گفت که این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 190.1,
   "end": 193.44,
   "text": "پسری در اینجا اعلام نمی‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 193.44,
   "end": 195.9,
   "text": "همه بینمون نشدند. اما بگو ایندی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 195.9,
   "end": 198.88,
   "text": "ایندی دیگه زیاد این بحث‌ها اختلاف ندارد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 198.88,
   "end": 201.98,
   "text": "خیلی مسئله ساده است وقتی انسان رسید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 201.98,
   "end": 204.12,
   "text": "حالا وقتی رسید ساده است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 204.12,
   "end": 207.02,
   "text": "ها. یعنی وقتی رسید مسئله ساده به این معنا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 207.02,
   "end": 209.83,
   "text": "معنوی می‌شه براش صدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 209.83,
   "end": 212.4,
   "text": "اصلاً کل انسان خود زمان ما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 212.4,
   "end": 216.46,
   "text": "من می‌دونم مسائل و اسرار براش حقیقتاً واضح و روشن می‌شه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 216.46,
   "end": 220.22,
   "text": "میت یعنی اون انسان وقتی می‌خواد بمیرد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 220.22,
   "end": 222.96,
   "text": "منجرز اشراف که پیدا می‌کند به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 222.96,
   "end": 233.02,
   "text": "عالم برزخ قطعا از اینجا چون انقطاع شده تقریباً کامل نشده، منقطع نشده، انقطاع زیادی به دست آمده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 233.02,
   "end": 238.6,
   "text": "تا به آن حدی که خلاصه بگم این طرف برگشتنی که برگشتنی نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 238.6,
   "end": 240.94,
   "text": "انقطاع زیادی حاصل شده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 240.94,
   "end": 247.84,
   "text": "و خلاصه در عالم برزخ درست باز شده چون از این طرف انقطاع زیاد حاصل شده، اون وقت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 247.84,
   "end": 251.14,
   "text": "مشاعر بالاتر انسان به کار افتاده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 251.14,
   "end": 259.02,
   "text": "یعنی چشم برزخی به کار افتاده و گوش برزخی به کار افتاده و چشم برزخی‌اش رو می‌بینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 259.02,
   "end": 262.06,
   "text": "فرزندانش و برادرهاش متصل می‌شوند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 262.06,
   "end": 266.06,
   "text": "اموالش متصل می‌شود و عملش براش متصل می‌شود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 266.06,
   "end": 268.02,
   "text": "با آنها گفت‌وگو می‌کند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 268.02,
   "end": 270.9,
   "text": "این گفت‌وگو هم، هم با زبان برزخی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 270.9,
   "end": 272.74,
   "text": "است و هم شنیدنش با چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 272.74,
   "end": 275.3,
   "text": "با چی؟ گوش برزخی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 275.3,
   "end": 280.71,
   "text": "توجه کردید؟ یه مقدار که این انقطاع حاصل شد گوش برزخی به کار می‌افتد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 280.71,
   "end": 284.9,
   "text": "این از باب تغییر ذهن گفتم و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 284.9,
   "end": 292.26,
   "text": "همین گوش برزخی اگر در حالت عادی انسان با مرگ ارادی مرد، صدق پیدا می‌کند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 292.26,
   "end": 294.14,
   "text": "اون مرگ طبیعی نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 294.14,
   "end": 296.48,
   "text": "اگر انسان مجاهدت کرد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 296.48,
   "end": 301.84,
   "text": "ریاضت شرعی کشید و خلاصه تزکیه کرد و قطع علاقة",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 301.84,
   "end": 305.56,
   "text": "به โ ล ก ، انقطاع براش حاصل شد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 305.56,
   "end": 310.78,
   "text": "همین گوش برزخی چطور در اونجا به لحاظ انقطاع باز میشه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 310.78,
   "end": 314.9,
   "text": "اون گوش برزخی اینجا در حالت عادی برای انسان چه میشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 314.9,
   "end": 320.9,
   "text": "گوش برزخی انسان باز می‌شود و اصوات برزخی را به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 320.9,
   "end": 323.7,
   "text": "اصطلاح می‌شنود و به اون معنی حکایات دارد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 323.7,
   "end": 327.74,
   "text": "این برای تغییر ذهن یک تشبیه و یک تنزیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 327.74,
   "end": 330.6,
   "text": "به عنوان تنزیه گفتم این جریان روایتی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 330.6,
   "end": 338.18,
   "text": "از علی علیه السلام هست و قبلاً هم شاید شما در نواسی معادی این صلوح یا در نواسی دیگر شنیده باشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 338.18,
   "end": 342.31,
   "text": "اون که میت می‌شنود در موقع رفقا با گوش برزخی است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 342.31,
   "end": 345.9,
   "text": "اون گوش برزخی به لحاظ انقطاع باز شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 345.9,
   "end": 350.84,
   "text": "اگر انقطاع در حال عادی هم باشد باز گوش برزخی انسان به کار می‌افتد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 350.84,
   "end": 355.48,
   "text": "و انسان می‌شنود و انقطاع قبلاً نمی‌شنید یا دیگران",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 355.48,
   "end": 358.72,
   "text": "نمی‌شنیدند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 358.72,
   "end": 363.16,
   "text": "احساس کنم که راهی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 363.16,
   "end": 366.98,
   "text": "و در این جُند و ماه این اشارات رو در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 366.98,
   "end": 371.7,
   "text": "این سفر که به اینجا آمدم بیشتر کنم، بیشتر کنم این تشریح‌ رو شما انشاالله انجام میدین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 371.7,
   "end": 377.12,
   "text": "مثلا در روایات هست که در روایت اشاره شده که وقتی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 377.12,
   "end": 383.7,
   "text": "کسی مُرد یا آدم ناموسی بود، مجرم بود و یا پشی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 383.7,
   "end": 385.29,
   "text": "بود، گرفتار بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 385.29,
   "end": 389.6,
   "text": "اونم که مُرد و مثلا دارن جنازه‌ش رو حمل می‌کنن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 389.6,
   "end": 391.98,
   "text": "همونجا ای صدا می‌زند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 391.98,
   "end": 395.72,
   "text": "اون حمل‌کنندگان و اونایی که دورش هستن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 395.72,
   "end": 400.98,
   "text": "تلفات‌دهه‌ها، کسان، دوستان و آشنایان، اون همه را صدا می‌زند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 400.98,
   "end": 405.08,
   "text": "بعد از این ناراحت میشه که چرا اینها نمی‌شنوند؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 405.08,
   "end": 411.12,
   "text": "راجع به خود ناراحت میشه که چرا اینها یعنی موجودین در اینجا نمی‌شنوند؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 411.12,
   "end": 413.56,
   "text": "ای خودشو به گونه‌ای که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 413.56,
   "end": 415.5,
   "text": "جواب وارد می‌کنه، ای صدا می‌زنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 415.5,
   "end": 418.64,
   "text": "فقط شما هستین. این تعبیر روایته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 418.64,
   "end": 421.66,
   "text": "چرا؟ چرا من حرفم اینقدر گوش ندارد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 421.66,
   "end": 424.04,
   "text": "راجع به خود. اونم در همین روایت می‌آید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 424.04,
   "end": 428.06,
   "text": "مثلا کسی گوش این گوشه حتی نداشت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 428.06,
   "end": 431.61,
   "text": "که شما هی میگی میگی هیچ اصلا اون گوش این به سنگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 431.61,
   "end": 433.33,
   "text": "ازش خبری نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 433.33,
   "end": 437.6,
   "text": "این طوره دیگه. میگه ای الا تسمعون؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 437.6,
   "end": 442.9,
   "text": "ای دوستان من، نزدیکان من، برادر، ای اونایی که منو حمل نمی‌شنوید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 442.9,
   "end": 444.58,
   "text": "ببین من با شما حرف دارم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 444.58,
   "end": 447.1,
   "text": "در روایت اینجوریه. چرا گوش نمی‌کنید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 447.1,
   "end": 448.97,
   "text": "من اخه دارم می‌خوام به شما حرف بزنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 448.97,
   "end": 450.94,
   "text": "دلم به شما می‌سوزه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 450.94,
   "end": 453.15,
   "text": "می‌خوام بگم من به چه وضعی افتادم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 453.15,
   "end": 455.82,
   "text": "اقلا شما به وضع من",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 455.82,
   "end": 458.72,
   "text": "نیفتید. تو این آرامش و اینها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 458.72,
   "end": 462.55,
   "text": "اینا نمی‌شنوند. شخصی هم اینو که می‌گویند راجع به جهان از این طرف میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 462.55,
   "end": 464.64,
   "text": "پس این صداها رو ما چرا نمی‌شنویم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 464.64,
   "end": 467.72,
   "text": "برای این ما نمی‌شنویم چون گوششو نداریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 467.72,
   "end": 470.22,
   "text": "راجع به خود. چون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 470.22,
   "end": 473.0,
   "text": "گوششو نداریم در این عالم این صداها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 473.0,
   "end": 480.52,
   "text": "حتی امام می‌فرماید که اون صدا می‌زند، فریاد می‌زند و می‌گویند که حرفاشو میگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 480.52,
   "end": 488.24,
   "text": "حتی جاهایی که دارند در اون خصوص جنازه هر وقت که به اون دیوار چیز وارد می‌کنند،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 488.24,
   "end": 492.36,
   "text": "قبر وارد می‌شه تا به اینجا ای به صدای خودش تو مدا خودش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 492.36,
   "end": 495.62,
   "text": "ادامه میده. بدون مدا شنیدنش گوش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 495.62,
   "end": 498.82,
   "text": "نازنین با گوش برزخی رو داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 498.82,
   "end": 508.58,
   "text": "اگر کسی از کشف سماعات بالاتر برخوردار باشد، وقت داد بخواهد می‌تواند اینجور صداها رو چه بکنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 508.58,
   "end": 510.5,
   "text": "اینجور صداها را بشنود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 510.5,
   "end": 512.13,
   "text": "من از شما سؤال می‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 512.13,
   "end": 515.72,
   "text": "اونی که امام می‌فرماید که اینجور صدا می‌زند و اینجور صداها در این دنیا وجود دارد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 515.72,
   "end": 519.18,
   "text": "یعنی اینها رو می‌شنود؟ بله. بله درست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 519.18,
   "end": 520.75,
   "text": "راجع به خود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 520.75,
   "end": 524.04,
   "text": "کی گفت کی مرد کی می‌دوند، کی می‌دوند و اینا نمی‌شنوند و با",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 524.04,
   "end": 526.78,
   "text": "چه شیکایت حمل می‌کنند و ناله حمل می‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 526.78,
   "end": 528.58,
   "text": "پس اینا یه چیزی هست البته نه معنوی است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 528.58,
   "end": 531.6,
   "text": "اینا نه معنیش هست که مقال رو این مسئله‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 531.6,
   "end": 533.7,
   "text": "نه چون صد آیه همش اینو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 533.7,
   "end": 536.24,
   "text": "داشته باش چون صد آیه نود هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 536.24,
   "end": 540.3,
   "text": "پیش ماست مثلا. خب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 540.3,
   "end": 548.62,
   "text": "اینه که اینجا یکم صبر شود از این مولایی بخواهیم بعد بریم که دنبال مطلب را بگیریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 548.62,
   "end": 554.04,
   "text": "مطلب اینه که این یاد و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 554.04,
   "end": 557.56,
   "text": "فضل در اینجا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 557.56,
   "end": 562.1,
   "text": "به حاشیه بروند. به وقتی که امام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 562.1,
   "end": 566.86,
   "text": "باقر سلام الله علیه این مسئله را در مقابل شما می‌گفتند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 566.86,
   "end": 571.28,
   "text": "از رسول اکرم صلوات الله علیه نقل می‌کرد که رسول الله اینجور فرمود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 571.28,
   "end": 575.8,
   "text": "که ای مدا می‌زند و اینها نمی‌شنوند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 575.8,
   "end": 584.86,
   "text": "یعنی امام باقر چون این بود آن، اصرار کردن که صحبت بکنند این مطلب را بیان فرمودند که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 584.86,
   "end": 589.04,
   "text": "بعد اون که ذکر بشم یک کسی اونجا بود به نام زمره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 589.04,
   "end": 593.06,
   "text": "این، این حرفو شنید که اون مدا می‌زند و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 593.06,
   "end": 596.28,
   "text": "مخصوصا جنازه را که حمل می‌کنند هی مدا می‌زند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 596.28,
   "end": 599.7,
   "text": "حاملین‌شان مدا می‌زنند اینها نمی‌شنوند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 599.7,
   "end": 607.42,
   "text": "اون یک کسی اونجا بود به نام ذریه‌الایمان به چه بود خلاصه یهو این آدم به این حرف طوری برخورد کرد در حضور امام و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 607.42,
   "end": 609.76,
   "text": "آشکارا در خودش هم آشکار کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 609.76,
   "end": 616.88,
   "text": "گفت این تقریبا حرف خاص مثلا استهزای مانند یا طوری جمله هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 616.88,
   "end": 619.42,
   "text": "گفت. بعد امام باقر سلام الله علیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 619.42,
   "end": 622.4,
   "text": "گفت که خدا را شکر در بین جمع، اون جمع هم فقط",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 622.4,
   "end": 625.46,
   "text": "خصوص مفسرین امام به وسیله‌شون بودند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 625.46,
   "end": 631.41,
   "text": "بعد اینجا تقریبا مسخره‌مانند کرد امام را، حرف، راجع به حرف رسول الله را.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 631.41,
   "end": 634.36,
   "text": "البته ظاهرا اون حرف و مطلبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 634.36,
   "end": 639.44,
   "text": "بعد امام باقر سلام الله علیه فرمود که خدا حالا این زمره اگر نظرش به استهزاء",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 639.44,
   "end": 646.88,
   "text": "کلام رسول صلوات الله علیه بود خود را مواخذه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 646.88,
   "end": 650.06,
   "text": "کند. و اینجور گفت بعد یک ماه زمره مرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 650.06,
   "end": 653.16,
   "text": "بعد یکی از نزدیکان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 653.16,
   "end": 658.36,
   "text": "امام باز علم. حالا من البته به حاشیه رفتم ولی باز از کشف سماعات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 658.36,
   "end": 667.64,
   "text": "یکی از نزدیکان که زهرا نام داشت یا داشته در اون موقع که زمره مرده بوده اونجا و دفن کردن حاضر بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 667.64,
   "end": 674.2,
   "text": "گفت که من ساعت یعنی بعد از دفن زمره آمد پیش امام باقر سلام الله علیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 674.2,
   "end": 676.25,
   "text": "گفت که من اونجا بودم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 676.25,
   "end": 680.06,
   "text": "این معلوم است این نام داشت یا داشته از اهل این اندازه کشف بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 680.06,
   "end": 684.9,
   "text": "برای اینکه یا از اهلش بوده یا خدا پس اونجا این کشف براش پیش آمده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 684.9,
   "end": 688.4,
   "text": "گاهی هم میشه وقتی استثناً برای کسی این کشف سماع یا غیر سماع پیش بیاد که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 688.4,
   "end": 690.48,
   "text": "در واقع اهلش برای همیشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 690.48,
   "end": 692.98,
   "text": "نیست یا برای استعداده آماده‌ایه خلاصه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 692.98,
   "end": 695.48,
   "text": "هم اتفاق نیست. حالا می‌فهمیم این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 695.48,
   "end": 698.08,
   "text": "آدم چه طور بوده. یکی از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 698.08,
   "end": 705.02,
   "text": "نزدیکان گفتش رو در روایته. گفت که امام باقر گفت که من اونجا که دفنش کردن من",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 705.02,
   "end": 709.24,
   "text": "صورتم رو گذاشتم رو خاک یعنی خاک قبر اون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 709.24,
   "end": 713.96,
   "text": "گوش دادم. گوش دادم دیدم زمره دارد ناله می‌کند و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 713.96,
   "end": 720.28,
   "text": "موجودات به خودش خطاب می‌کند تو اینجا ها این عالم، عالم خصوصا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 720.28,
   "end": 723.0,
   "text": "بعد به خودش خطاب می‌کند که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 723.0,
   "end": 725.22,
   "text": "تو برای خودت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 725.22,
   "end": 729.24,
   "text": "کار، اینجا فرمود نشه. کار کردی زمره بر خود که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 729.24,
   "end": 735.58,
   "text": "همه از تو می‌دانند آتش جهنم برای تو آماده است و تو آماده برای آتش جهنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 735.58,
   "end": 738.82,
   "text": "به خودش و خودش خلاصه مذمت می‌کند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 738.82,
   "end": 744.14,
   "text": "این هم یک کشف سماعات. مولوی در چه گوش را بندد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 744.14,
   "end": 746.72,
   "text": "این اشعار را دقت کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 746.72,
   "end": 750.3,
   "text": "گوش را بندد کمه از استماع.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 750.3,
   "end": 755.18,
   "text": "گوش را بندد کمه از استماع.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 755.18,
   "end": 757.3,
   "text": "شما اگر بخواهید،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 757.3,
   "end": 759.5,
   "text": "این حالا این شعر را معنی کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 759.5,
   "end": 762.7,
   "text": "خودتون به تفکر بپردازید. اگر بخواهیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 762.7,
   "end": 765.48,
   "text": "از این عالم بیش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 765.48,
   "end": 770.04,
   "text": "از کمه را برداریم، اون وقت این مسئله برای ما حل میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 770.04,
   "end": 772.6,
   "text": "گوش را بندد کمه از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 772.6,
   "end": 778.32,
   "text": "استماع، چشم را بندد غرض از اطلاع.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 778.32,
   "end": 786.32,
   "text": "همچنین که بعد مولوی مثال میزنه میگه اون جنین را دیده، بچه در رحم مادر جنین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 786.32,
   "end": 791.72,
   "text": "خب اونجا چون خیلی سخت و اون خنک بودن اونها زیاد علاقه دارد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 791.72,
   "end": 796.72,
   "text": "اصلاً توجه ندارد. فکر میکند همه زندگی و همه چیز فقط توی همونه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 796.72,
   "end": 802.74,
   "text": "نمیداند که خارج از اون رحم عالمی چنین چنان با اون مسائل عالم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 802.74,
   "end": 805.06,
   "text": "دیگری هست. اونها رو نمیشناسد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 805.06,
   "end": 812.16,
   "text": "خوب و بدش را هم نمیداند. باور نمیکند چون اونجا کمه دارد فعلاً به اون وضعیت خودش و وابستگی شدید دارد به اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 812.16,
   "end": 814.14,
   "text": "خنک بودن هم خیلی سخت کمه دارد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 814.14,
   "end": 818.98,
   "text": "این تشریح میکنه. همچنین که آن جنین را تن به خنک،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 818.98,
   "end": 822.76,
   "text": "تن غذای گوشت در اوطان خون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 822.76,
   "end": 827.28,
   "text": "از حدیث این جهان محروم کرد، از حدیث",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 827.28,
   "end": 830.04,
   "text": "این جهان محروم کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 830.04,
   "end": 837.76,
   "text": "خود کاملاً با برده‌ش محبوس کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 837.76,
   "end": 841.64,
   "text": "در یه جا دیگه باز مثلاً میگه تنبه وسواس را",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 841.64,
   "end": 844.55,
   "text": "بیرون کن ز گوش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 844.55,
   "end": 847.08,
   "text": "توجه بکنید. تنبه وسواس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 847.08,
   "end": 850.26,
   "text": "بیرون کن ز گوش تا بشنود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 850.26,
   "end": 853.48,
   "text": "آید از گردون خروش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 853.48,
   "end": 857.18,
   "text": "تا کند فهم معماهاش را، آن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 214,
   "start": 857.18,
   "end": 858.74,
   "text": "معماهاش را.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 215,
   "start": 858.74,
   "end": 863.26,
   "text": "تا کند ادراک رمز فاش را.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 216,
   "start": 863.26,
   "end": 865.72,
   "text": "کار این اشعار بر می گردد به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 217,
   "start": 865.72,
   "end": 870.04,
   "text": "مراحل عالی کشف سماعی اشاره است که اگر اینجا خودم من",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 218,
   "start": 870.04,
   "end": 872.26,
   "text": "زنگ بینندگان باید بگم اینجا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 219,
   "start": 872.26,
   "end": 880.22,
   "text": "هم به این چند سطر اشاره کنم که اینجا هم باور بکنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 220,
   "start": 880.22,
   "end": 882.78,
   "text": "خب. این مهم مرحله‌ای از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 221,
   "start": 882.78,
   "end": 885.9,
   "text": "کشف به اصطلاح",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 222,
   "start": 885.9,
   "end": 888.86,
   "text": "سماعی است که شنیدن اصوات برزخی‌ها است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 223,
   "start": 888.86,
   "end": 896.88,
   "text": "حالا صرف یک انواع معنوی که احیاناً گفته‌ها و اندوه را می شنوند و اسرار آنها را می فهمند یا چیزای دیگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 224,
   "start": 896.88,
   "end": 900.1,
   "text": "یا حتی اگر اینجا هم باز مسئله استماع",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 225,
   "start": 900.1,
   "end": 904.76,
   "text": "کلام ملائکه مثالی هست، ملائکه مثالی و برزخی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 226,
   "start": 904.76,
   "end": 907.54,
   "text": "این در قسم دیگری از کشف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 227,
   "start": 907.54,
   "end": 912.34,
   "text": "سماع است که در آن عرض کردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 228,
   "start": 912.34,
   "end": 914.84,
   "text": "خب اگر حالا این قسمی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 229,
   "start": 914.84,
   "end": 919.6,
   "text": "بود و این یک اصطلاح نوعی بود و در این 물론 انواع مختلف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 230,
   "start": 919.6,
   "end": 922.04,
   "text": "کشف سماعی پیش میاد. حالا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 231,
   "start": 922.04,
   "end": 924.34,
   "text": "سالک بالا رفت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 232,
   "start": 924.34,
   "end": 927.2,
   "text": "و از کشف بالاتر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 233,
   "start": 927.2,
   "end": 929.44,
   "text": "سماعی در حال شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 234,
   "start": 929.44,
   "end": 932.38,
   "text": "در اون مراحل عالی و نهایاتش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 235,
   "start": 932.38,
   "end": 939.2,
   "text": "مسئله تسخیر موجودات را شنیدن و تسخیر موجودات را فهمیدن،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 236,
   "start": 939.2,
   "end": 941.34,
   "text": "کلام ملائکه را شنیدن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 237,
   "start": 941.34,
   "end": 944.2,
   "text": "و مقاصد آنها را فهمیدن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 238,
   "start": 944.2,
   "end": 949.04,
   "text": "و سوی مسائل دیگری که به اسرار وجود مربوط است اینها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 239,
   "start": 949.04,
   "end": 951.56,
   "text": "پیش می آید و قسم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 240,
   "start": 951.56,
   "end": 953.6,
   "text": "بالاتر از این دیگه به اینجا منتهی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 241,
   "start": 953.6,
   "end": 956.64,
   "text": "تسخیر دیگه و تسخیر فعلاً اینو میگم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 242,
   "start": 956.64,
   "end": 961.32,
   "text": "همین جا توجه داشته باشید که تسخیر موجودات را شنیدن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 243,
   "start": 961.32,
   "end": 967.86,
   "text": "با یک serie مسائلات دیگر به معانی مقاصد تسخیر را فهمیدن و موجودات را فهمیدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 244,
   "start": 967.86,
   "end": 971.78,
   "text": "این در مراحل عالی کشف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 245,
   "start": 971.78,
   "end": 975.04,
   "text": "چیه؟ کشف سماعه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 246,
   "start": 975.04,
   "end": 980.04,
   "text": "تا تسخیر جمادات آید دست، دست به تأدیب ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 247,
   "start": 980.04,
   "end": 983.98,
   "text": "نر بایدت یا بر بایدت که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 248,
   "start": 983.98,
   "end": 986.76,
   "text": "خلاف جواد الود است، نر باید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 249,
   "start": 986.76,
   "end": 990.38,
   "text": "نر باید کند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 250,
   "start": 990.38,
   "end": 995.44,
   "text": "در این مرحله شنیدن اصوات یعنی مراحل عالی کشف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 251,
   "start": 995.44,
   "end": 1000.74,
   "text": "سماعی، مخصوص شدن بهشت آج عذابها،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 252,
   "start": 1000.74,
   "end": 1003.6,
   "text": "شنیدن بهشت صدای بهشتیان و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 253,
   "start": 1003.6,
   "end": 1005.82,
   "text": "ناله جهنمیان،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 254,
   "start": 1005.82,
   "end": 1008.84,
   "text": "شنیدن ضخیر آتش جهنمیان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 255,
   "start": 1008.84,
   "end": 1011.18,
   "text": "در اون عرش قیامت اینها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 256,
   "start": 1011.18,
   "end": 1014.08,
   "text": "که یه وقتی اشعار را از مولوی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 257,
   "start": 1014.08,
   "end": 1020.52,
   "text": "با روایتی با اشاره در خصوص ذکری که از جوان‌های منفرد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 258,
   "start": 1020.52,
   "end": 1026.05,
   "text": "در زمان رسول اکرم صلی الله علیه و آله و سلم بود با شما هست شاید هم نظرتون هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 259,
   "start": 1026.05,
   "end": 1030.66,
   "text": "اون در این مرحله است. مراحل عالی کشف سماع است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 260,
   "start": 1030.66,
   "end": 1036.08,
   "text": "در نهج البلاغه حضرت علی علیه السلام اهل ذکر را اینجوری توصیف می‌کند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 261,
   "start": 1036.08,
   "end": 1041.36,
   "text": "در خصوص اهل ذکر این جمله خیلی معروفی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 262,
   "start": 1041.36,
   "end": 1046.24,
   "text": "دارد که در نهج البلاغه می‌فرماید. اینجا در خصوص یک شخص یا کسانی که می‌شناسد از اهل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 263,
   "start": 1046.24,
   "end": 1055.38,
   "text": "ذکر می‌فرماید که قیامت آنچه را که در وقت خودش برای دیگران ظاهر خواهد کرد، برای آنها ظاهر کرده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 264,
   "start": 1055.38,
   "end": 1060.76,
   "text": "برای آنها محقق شده و می‌فرماید می‌شنوند اینها آنچه را که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 265,
   "start": 1060.76,
   "end": 1062.86,
   "text": "دیگران نخواهند شنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 266,
   "start": 1062.86,
   "end": 1065.0,
   "text": "این در مراحل عالی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 267,
   "start": 1065.0,
   "end": 1067.36,
   "text": "کشف است و خیلی چیزهای دیگر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 268,
   "start": 1067.36,
   "end": 1074.89,
   "text": "که تسخیر موجودات به اینکه عرض کردم و مسائل دیگری در مراحل عالی کشف سماع پیش می آید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}