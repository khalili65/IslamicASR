   "start": 1.28,
   "end": 151.98
  },
  {
   "index": 1,
   "title": "## روایتِ خطیب و مصباح",
   "start": 151.98,
   "end": 327.62
  },
  {
   "index": 2,
   "title": "## صراحت یا سکوت",
   "start": 327.62,
   "end": 400.92
  },
  {
   "index": 3,
   "title": "## استثنای مدارا با شرور",
   "start": 400.92,
   "end": 592.44
  },
  {
   "index": 4,
   "title": "## حکایتِ رسول و اتقاء لشره",
   "start": 592.44,
   "end": 796.96
  },
  {
   "index": 5,
   "title": "## نفاق با حق و افقِ صدّیق",
   "start": 796.96,
   "end": 957.32
  },
  {
   "index": 6,
   "title": "## حرکاتِ بیش از باطن",
   "start": 957.32,
   "end": 1237.25
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 1.28,
   "end": 4.36,
   "text": "اعوذ بالله السميع العليم من الشيطان الرجيم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 4.36,
   "end": 7.1,
   "text": "بسم الله الرحمن الرحيم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 7.1,
   "end": 14.0,
   "text": "ظلمت قلب مسئله‌ای‌ست که سالک دردمند از این ظلمت قلب باید خیلی وحشت داشته باشد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 14.0,
   "end": 17.48,
   "text": "قلب ظلمانی دیگه به جایی راه نمی‌برد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 17.48,
   "end": 19.74,
   "text": "نفاق ظلمت قلب می‌آورد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 19.74,
   "end": 23.84,
   "text": "قلب تاریک است. حالا نمی‌فهمم اصلاً قلب چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 23.84,
   "end": 26.46,
   "text": "تاریکیش چیه؟ ما اصلاً اصلش رو نمی‌فهمیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 26.46,
   "end": 32.92,
   "text": "ولی هرچه هست حقیقت اینه. قلب تاریک است، موجب ظلمت است نفاق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 32.92,
   "end": 40.38,
   "text": "در این باب به یک روایت فقط اشاره می‌کنم می‌گذارم به قسم دوم از نفاق، نفاق رفیق خدا که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 40.38,
   "end": 43.22,
   "text": "اصل مصیبت ما اونجاهاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 43.22,
   "end": 45.72,
   "text": "حالا در این باب که نفاق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 45.72,
   "end": 50.88,
   "text": "موجب ظلمت قلب می‌شود به یک روایت اشاره می‌کنم و بس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 50.88,
   "end": 53.56,
   "text": "اصول کافی، جلد چهار، باب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 53.56,
   "end": 57.72,
   "text": "ظلمة قلب المنافق و این أُعطي اللسان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 57.72,
   "end": 62.18,
   "text": "یک باب مخصوصی‌ست در با-- که در خصوص ظلمت قلب منافق است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 62.18,
   "end": 72.08,
   "text": "حالا منافق هر جور منافق باشد با بیانی که از قبل توجه کردید منافق در هر مرتبه‌ای منافق باشد قلبش چی خواهد بود؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 72.08,
   "end": 74.18,
   "text": "قلبش ظلمانی خواهد بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 74.18,
   "end": 75.9,
   "text": "این یک بابی دارد در اصول کافی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 75.9,
   "end": 79.48,
   "text": "در آنجا روایات مربوط به این را آورده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 79.48,
   "end": 83.18,
   "text": "در یک روایت عن أبي عبد الله عليه السلام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 83.18,
   "end": 90.8,
   "text": "از امام صادق علیه السلام قال لنا ذات يوم آن راوی می‌گوید امام صادق یک روز به ما گفت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 90.8,
   "end": 94.64,
   "text": "تجد الرجل لا يخطي بلام ولا واو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 94.64,
   "end": 104.06,
   "text": "خطيبا مثل أقم مثل قأ و لقلبه أشد ظلمة من الليل المظلم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 104.06,
   "end": 111.28,
   "text": "حالا من این شب روایت را می‌نوشتم، می‌دیدم که این بیان امام صادق سلام الله علیه حالا به هر منافقی تطبیق می‌کند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 111.28,
   "end": 117.12,
   "text": "در عین حال به اون منافق‌ها که خوب صحبت می‌کنند می‌ترسیدم مثلاً ماها باشیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 117.12,
   "end": 121.06,
   "text": "صحبت شیرین می‌کنند بیشتر تطبیق می‌کند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 121.06,
   "end": 123.92,
   "text": "می‌فرماید که تجد الرجل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 123.92,
   "end": 127.7,
   "text": "مرد را می‌بینی لا يخطي بلام ولا واو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 127.7,
   "end": 132.14,
   "text": "خطيبا موقع سخن در نه حتی در یک واو خطا نمی‌کند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 132.14,
   "end": 133.94,
   "text": "در یک یا خطا نمی‌کند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 133.94,
   "end": 136.7,
   "text": "خیلی خوب، روشن، منظم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 136.7,
   "end": 139.88,
   "text": "سلیس، دقیق، مرتب صحبت می‌کند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 139.88,
   "end": 142.6,
   "text": "در یک واوش خطا نمی‌کند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 142.6,
   "end": 148.02,
   "text": "اما و لقلبه أشد ظلمة من الليل المظلم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 148.02,
   "end": 151.98,
   "text": "اما قلبش از آن شب تاریک‌تر است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 151.98,
   "end": 162.2,
   "text": "و تجد الرجل مقابلش می‌یابی شخصی را که لا يستطيع أن يعبر ما فی قلبه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 162.2,
   "end": 165.88,
   "text": "نمی‌تواند آنچه در قلبش هست را به زبان بیاورد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 165.88,
   "end": 172.42,
   "text": "زبان خوب ندارد بنده خدا و قلبه يظهر كما يظهر المصباح",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 172.42,
   "end": 176.02,
   "text": "و قلبش مانند چراغ روشن است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 176.02,
   "end": 179.16,
   "text": "این یکیش هم اینطور می‌شود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 179.16,
   "end": 182.96,
   "text": "این در باب نفاق است و term نفاق در اینجا به کار آورده نشده است ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 182.96,
   "end": 192.04,
   "text": "ولی مفهوم روایت نمی‌دونم خوب توجه کردین، مفهوم روایت می‌گوید کسی که ظاهرش با باطنش یکی نبود قلبش چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 192.04,
   "end": 194.5,
   "text": "قلبش از ظلمت خاصی برخورد دارد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 194.5,
   "end": 196.82,
   "text": "حالا اونجا روی صحبت نکردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 196.82,
   "end": 203.26,
   "text": "کسانی هستند که زبان ندارند حتی قلبشون يظهر كما يظهر المصباح.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 203.26,
   "end": 205.9,
   "text": "اینجا شما ان شاء الله خودتون از،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 205.9,
   "end": 208.34,
   "text": "از اون آدم‌های موفق بودید،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 208.34,
   "end": 212.08,
   "text": "خودتون خواهید فهمید این تعبیرات در روایات چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 212.08,
   "end": 217.56,
   "text": "در خصوص صالحین از بندگان خدا این هست که در قلبشون مصباح هست مصباح.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 217.56,
   "end": 224.17,
   "text": "الله نور السماوات و الأرض مثل نوره كالمشكاة في المصباح.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 224.17,
   "end": 230.42,
   "text": "اون تجلیات نوری حق است در قلب در مقام تجلیات و مشاهدات و مشاهدات به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 230.42,
   "end": 234.1,
   "text": "اونجاها پیش میاد. این قسمت دوم روایت به اونجاها شاهد است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 234.1,
   "end": 239.98,
   "text": "خب بنابراین یک شعبه از نفاق، یک صورت از نفاق، نفاق در بندگان خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 239.98,
   "end": 241.66,
   "text": "ملحد است، ظلمت می‌آورد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 241.66,
   "end": 244.24,
   "text": "اون جورم که عذاب و تمسخر اخروی دارد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 244.24,
   "end": 246.34,
   "text": "انسان در آخرت از اشرار است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 246.34,
   "end": 249.16,
   "text": "برای سالک این مسئله مفهوم ندارد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 249.16,
   "end": 251.08,
   "text": "بنابراین ما اولاً در مقام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 251.08,
   "end": 257.72,
   "text": "صورتی که خواستیم به سلوک قدم بگذاریم، باید از دروغ بودن و دو زبان بودن با بندگان خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 257.72,
   "end": 260.44,
   "text": "به هر صورتش اجتناب بکنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 260.44,
   "end": 264.2,
   "text": "خیلی صراحت داشته باشیم، صراحت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 264.2,
   "end": 268.9,
   "text": "یادتون باشد اگر انسان بخواهد منافق نباشد باید صریح باشد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 268.9,
   "end": 271.4,
   "text": "صریح یا ساکت یا صریح.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 271.4,
   "end": 277.4,
   "text": "دیگه دروغ بودن و دو زبان داشتن نمی‌گذارد انسان، نمی‌گذارد انسان جلو بیفتد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 277.4,
   "end": 283.62,
   "text": "اینجا یک مسئله حالا قبل از اینکه من به قسم دوم کتاب بپردازم به یک نکته لازم است اشاره بکنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 283.62,
   "end": 287.86,
   "text": "ممکنه بعدها به نظر شما بیاید آیا این هیچ استثنا ندارد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 287.86,
   "end": 291.08,
   "text": "انسان گاهی ممکن است در یک جایی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 291.08,
   "end": 297.36,
   "text": "به اصطلاح یک زمینه خاصی باشد که چیزی به زبان لازم است بیاورد با در برخورد با",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 297.36,
   "end": 303.28,
   "text": "کسی‌ها، در برخورد با انسان‌ها چیزی به زبان بیاورد که در قلبشان اونطور نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 303.28,
   "end": 305.7,
   "text": "چرا این مورد استثنا دارد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 305.7,
   "end": 316.26,
   "text": "مورد استثنای این موضوع یعنی در برخورد با انسان‌ها، انسان ظاهر و باطنش یکی نباشد و اما نفاق هم حساب نشود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 316.26,
   "end": 321.5,
   "text": "این استثنا دارد. نفاق حساب نشود ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 321.5,
   "end": 327.62,
   "text": "این همان موارد مدارا است که در روایات این شرعا جایز شمرده شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 327.62,
   "end": 331.12,
   "text": "در جاها انسان باید مدارا بکند یعنی بسازد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 331.12,
   "end": 332.63,
   "text": "بسازد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 332.63,
   "end": 342.54,
   "text": "مثلاً چطور؟ مثلاً با کسی شما شرور است در همین دنیا اشرار است، بد است، شر است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 342.54,
   "end": 350.24,
   "text": "مواجه شدید در یک صحنه‌ای افتادید که بالاخره باید یک تعریف‌هایی از او بکنید، یک چیزهایی بگید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 350.24,
   "end": 352.66,
   "text": "بالاخره باید چیزی بگید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 352.66,
   "end": 358.16,
   "text": "یک بله‌ها باید رو بگید فعلاً و الا به شما شرش خواهد رسید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 358.16,
   "end": 363.72,
   "text": "اینجا تا حدی که از شرش نجات پیدا بکنید، روی خوش نشان بدهید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 363.72,
   "end": 366.32,
   "text": "که زبان یه تعریفی می‌کنه در قلبتون نیست دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 366.32,
   "end": 371.46,
   "text": "این آخه از مصادره‌یه مخالفت ظاهر با باطن هست یا نیست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 371.46,
   "end": 373.72,
   "text": "یعنی گفته هست اما مستثناست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 373.72,
   "end": 377.54,
   "text": "نفاق نیست اینجا. با آدم شرور روبه‌رو شده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 377.54,
   "end": 383.46,
   "text": "طوری پیش آمده که اصلاً از شر این خلاص نمی‌شود مگر اینکه چند جمله اینجا بگوید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 383.46,
   "end": 388.66,
   "text": "که قلبتون اون را که زبان تون می‌گوید در قلبتون نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 388.66,
   "end": 390.88,
   "text": "این اشکال ندارد. این مدارا است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 390.88,
   "end": 398.9,
   "text": "اون هم فقط در جایی است که نمی‌توانید بدون این چند جمله و بدون این برخورد از شر او چه بکنید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 398.9,
   "end": 400.92,
   "text": "از شر او خلاص بشوید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 400.92,
   "end": 404.6,
   "text": "اگر می‌توانید بدون اون دیگه مجاز نیستید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 404.6,
   "end": 406.86,
   "text": "فقط در جایی که نمی‌توانید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 406.86,
   "end": 408.98,
   "text": "در کل این مورد استثناست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 408.98,
   "end": 412.72,
   "text": "حالا ممکنه این به صورت‌های مختلف در زندگی انسان پیش بیاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 412.72,
   "end": 416.24,
   "text": "یه وقتی در باب، در خصوص خود رسول اکرم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 416.24,
   "end": 418.78,
   "text": "صلی الله علیه و آله و سلم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 418.78,
   "end": 423.48,
   "text": "این مسئله را در مرحوم نراقی در جامع السعادات آورده که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 423.48,
   "end": 428.4,
   "text": "از ابا شاهد آورده که یه شخصی آمد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 428.4,
   "end": 440.62,
   "text": "زمدرد رسول-- از رسول اکرم صلوات الله علیه استیزان کرد که بیاد رسول الله به اصطلاح.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 440.62,
   "end": 443.72,
   "text": "فرمود که به او اذن بدهید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 443.72,
   "end": 451.46,
   "text": "اما همین که فرمود به او اذن بدهید بذار بیاد فرمود که فبعث رجل من الأشیرة.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 451.46,
   "end": 453.75,
   "text": "مرد بد اون قوم است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 453.75,
   "end": 457.12,
   "text": "اینجور فرمود. حالا نیامده بوده مرد بد قوم است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 457.12,
   "end": 459.66,
   "text": "آمد. حالا آمد نشست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 459.66,
   "end": 463.06,
   "text": "همون وقتی نشست رسول اکرم صلوات الله علیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 463.06,
   "end": 469.3,
   "text": "با نرمی باهاش، با ملایمت، با نرمی، با خوشرویی یه مقدار باهاش برخورد کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 469.3,
   "end": 470.7,
   "text": "اون کسانی که اون جمله اول",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 470.7,
   "end": 476.38,
   "text": "را از رسول الله صلوات الله علیه شنیده بودند دیدند که این رفتار رسول الله چندان با اون جمله که میفرم-",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 476.38,
   "end": 479.08,
   "text": "فرمود چندان جور در نیامد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 479.08,
   "end": 483.0,
   "text": "فرمود که بد مردی است که میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 483.0,
   "end": 486.12,
   "text": "بد مرد اون قوم است، اون اشیره‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 486.12,
   "end": 491.3,
   "text": "دیدن که یه خورده الان له القول یعنی یه خورده با نرمی باهاش برخورد کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 491.3,
   "end": 495.1,
   "text": "حتی بعضی اون کسانی که اونجا حاضر بودند گفتند نکنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 495.1,
   "end": 500.12,
   "text": "دیگه منزلتی در نزد رسول اکرم صلوات الله علیه دارد برای اینجوری که برخورد کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 500.12,
   "end": 503.52,
   "text": "بلند شد که رفت. حضرت الله سؤال کردند صلوات الله علیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 503.52,
   "end": 510.58,
   "text": "گفتند که اونجور فرمودید ولی طوری هم رفتار کردید که ما گفتیم شاید مثلاً منزلتی، آشنایی، چیزی، خصوصیتی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 510.58,
   "end": 512.04,
   "text": "شما بهش ارزش gave",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 512.04,
   "end": 514.66,
   "text": "فلان. فرمود که، چی فرمود؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 514.66,
   "end": 522.26,
   "text": "حالا این بیانه که فرمود هم اولاً اون تجویز این مسئله را در مو-- مواقع برخورد با اشرار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 522.26,
   "end": 529.82,
   "text": "می‌رساند به هم، اون اشرار بودن اینها در قیامت را می‌رساند که قبلاً گفتم اینجور افراد رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 529.82,
   "end": 534.44,
   "text": "حالا اینجور افراد را که اون معلوم است که از اون اشرار قیامت بودند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 534.44,
   "end": 536.24,
   "text": "خب فرمود که فرفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 536.24,
   "end": 545.26,
   "text": "رسول الله فرمود إن شر الناس منزلة عند الله يوم القيامة من أكرم الناس اتقاءً لشره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 545.26,
   "end": 548.8,
   "text": "اینا هم یه تیپ اشرار دیگه هستند و اون اشرار اول که گفتم نه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 548.8,
   "end": 552.34,
   "text": "فرمود که رسول الله فرمود اونا گفتند چرا اینجور رفتار کرد با اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 552.34,
   "end": 557.88,
   "text": "بیانتون؟ فرمود که إن شر الناس بدترین مردم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 557.88,
   "end": 559.58,
   "text": "منزلةً عند الله از نظر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 559.58,
   "end": 567.38,
   "text": "منزلت نزد خدا يوم القيامة در روز قیامت من أكرم الناس اونایی هستند که مردم به آنها احترام بکنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 567.38,
   "end": 572.52,
   "text": "ولی از خوف و ترس شرشون، از ترس شرشون اتقاءً لشر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 572.52,
   "end": 581.26,
   "text": "یعنی من هم اینجا از ترس شرش اینجور کردم و اینا از اشرار در قیامت هم هستند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 581.26,
   "end": 584.5,
   "text": "این هم چیزی باید خیلی انسان وجودش متأثر باشد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 584.5,
   "end": 588.86,
   "text": "یه وقتی طوری برخورد نکند انسان، انسان‌ها با انسان که از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 588.86,
   "end": 592.44,
   "text": "ترس انسان، انسان‌ها به انسان چه بکنند؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 592.44,
   "end": 594.88,
   "text": "احترام بکنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 594.88,
   "end": 597.64,
   "text": "از ترسش. اینجور میشه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 597.64,
   "end": 599.94,
   "text": "اتقاءً لشره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 599.94,
   "end": 605.18,
   "text": "خیلی بده. خب به هر صورت این از موارد استثناست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 605.18,
   "end": 612.58,
   "text": "کسی که در مواردی ظاهر و باطنش یکی نباشد، اون جاها که اتقاءً لشر باشد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 612.58,
   "end": 619.36,
   "text": "طرف شرور است، باید یه برخورد خوبی باهاش داشته باشه، چند جمله‌ی تعریفی بهش بکنه که نمی‌شود اگر نکند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 619.36,
   "end": 624.38,
   "text": "خلاص بشود. این جاها از نفاق نیست و مستثناست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 624.38,
   "end": 629.14,
   "text": "اما باید خیلی دقیق بود که اگر می‌شود اون کار را نکند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 629.14,
   "end": 634.6,
   "text": "خب این اندازه که توضیح دادم این نفاق و دورویی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 634.6,
   "end": 642.5,
   "text": "یک مؤمن، یک مسلمان است با بندگان خدا از مغلکات است برای همه، برای صالح هم مفک است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 642.5,
   "end": 647.9,
   "text": "خب ظلمت هم می‌آورد با اون توضیح که گفتیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 647.9,
   "end": 656.5,
   "text": "یک صورت دیگری در اون تقسیم‌بندی کلی که گفتیم صورت دوم نفاق برای یک مسلمان، برای یک مؤمن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 656.5,
   "end": 660.54,
   "text": "عبارت است نفاق در پیشگاه حق،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 660.54,
   "end": 665.42,
   "text": "نفاق با حق، نفاق در برابر ذات مقدس حق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 665.42,
   "end": 670.62,
   "text": "یعنی ظاهر و باطن در پیشگاه حق با هم یکی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 670.62,
   "end": 674.62,
   "text": "نباشد. در ارتباط با حق یکی نباشد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 674.62,
   "end": 676.86,
   "text": "خب حالا این جورها که من گفتم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 676.86,
   "end": 678.98,
   "text": "تو خود حدیث و تفسیر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 678.98,
   "end": 684.64,
   "text": "بخوانید از این مشبت. این می‌بینید دیگه چقدر مراتب پیدا می‌کند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 684.64,
   "end": 689.9,
   "text": "این نفاق که از مراتب نفاق است،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 689.9,
   "end": 701.44,
   "text": "از صور نفاق است، خودش در مراتب مختلف عنوان می‌شود و از مغلکات است و کمتر کسی می‌تواند از مراتب،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 701.44,
   "end": 706.02,
   "text": "از همه مراتب این نفاق خلاص بشود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 706.02,
   "end": 711.76,
   "text": "و صالح به هر اندازه از این نفاق برخوردار باشد براش مغلک است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 711.76,
   "end": 716.1,
   "text": "اگر خیلی برخوردار است یک مغلک بالاتر یه عذار است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 716.1,
   "end": 718.84,
   "text": "اگر کم برخوردار است کمتر است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 718.84,
   "end": 727.28,
   "text": "نمی‌دارم این جمله را در دفتر دید از مر-- همه مراتب این نوع نفاق خلاص شدن کار هر کسی نیست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 727.28,
   "end": 732.72,
   "text": "یعنی ظاهر و باطن در پیشگاه خدا، در ارتباط با خدا، در مقام بودیت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 732.72,
   "end": 735.94,
   "text": "برای صالح یکی نباشد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 735.94,
   "end": 739.78,
   "text": "باطنش با ظاهرش فرق می‌کند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 739.78,
   "end": 743.4,
   "text": "در پیشگاه خداها توجه می‌کنید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 743.4,
   "end": 750.26,
   "text": "خب این مراتب دارد یعنی مراتب شدید و ضعیف و خفی و اخفی دارد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 750.26,
   "end": 754.48,
   "text": "مراتب اینجوری دارد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 754.48,
   "end": 758.37,
   "text": "در روایات به بعضی از مراتب این مسئله اشاره شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 758.37,
   "end": 763.68,
   "text": "در آیات، اشارات آیات را کسی خوب ببیند اشاره شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 763.68,
   "end": 768.96,
   "text": "من قبل از توضیح بعضی از مراتب این نوع نفاق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 768.96,
   "end": 775.36,
   "text": "که الان عرض کردم و خودم هم پیش خوشم نمیاد توضیح بدم چون باز اون نتیجه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 775.36,
   "end": 777.08,
   "text": "خواهد بود که بعضی از دوستان معمولاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 777.08,
   "end": 783.06,
   "text": "هر هفته بعد از جلسه میگن، میگن قضیه بدتر شد باز اون خواهد شد و بدتر از سابق هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 783.06,
   "end": 788.58,
   "text": "خواهد شد. وضع ما یعنی وضع ما بدتر خواهد شد چون انسان تطبیق می‌کند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 788.58,
   "end": 794.14,
   "text": "زیاد مایل نیستم توضیح بدم ولی در عین حال یه خرده توضیح خواهم داد انشاالله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 794.14,
   "end": 796.96,
   "text": "اما قبلاً می‌خواستم یه جمله به شما بگم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 796.96,
   "end": 804.22,
   "text": "شما خیلی کلمه صدّيق را تا به حال شنیده‌اید و شاید خواستید بفهمید صدّيق یعنی چه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 804.22,
   "end": 806.8,
   "text": "و یک تعریف خوبی یا یک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 806.8,
   "end": 811.38,
   "text": "معنایی که برای شما هضم بشود که صدّيق اصلاً یعنی چه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 811.38,
   "end": 814.28,
   "text": "اونی که قرآن روش حساب می‌کنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 814.28,
   "end": 818.78,
   "text": "از اون انعام شده‌ها هم هستند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 818.78,
   "end": 821.1,
   "text": "چهار طبقه را قرآن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 821.1,
   "end": 824.96,
   "text": "مورد تفضل خاص خدای متعال می‌شمارد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 824.96,
   "end": 827.32,
   "text": "چهار صنف را، چهار دسته را،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 827.32,
   "end": 836.49,
   "text": "چهار طبقه را و چهار تیپ را از انسان‌ها که یکی از اون‌ها کسانی هستند عبارت هستند ص-- از صدّيقین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 836.49,
   "end": 844.7,
   "text": "«أُولَٰئِكَ مَعَ الَّذِينَ أَنْعَمَ اللَّهُ عَلَيْهِمْ مِنَ النَّبِيِّينَ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 844.7,
   "end": 849.36,
   "text": "وَالصِّدِّيقِينَ وَالشُّهَدَاءِ وَالصَّالِحِينَ».",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 849.36,
   "end": 855.04,
   "text": "صدّيقين چیزی است در قرآن، انعام شده‌ها هستند، اصحاب صراط‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 855.04,
   "end": 861.52,
   "text": "خیلی بالاست مقامشون. این بیانی که امروز خواهیم داشت در مراتب نفاق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 861.52,
   "end": 872.16,
   "text": "که میگیم از مراتب شدید و ضعیف این نفاق کسی بخواهد در مقام بودیت خلاص بشود که خیلی سخت است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 872.16,
   "end": 876.16,
   "text": "خلاص شدن، اگر کسی خلاص بشود می‌شود چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 876.16,
   "end": 878.04,
   "text": "می‌شود صدّيق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 878.04,
   "end": 880.56,
   "text": "توجه داشته باشید. صدّيق معنوش اینجا فقط--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 880.56,
   "end": 885.42,
   "text": "من در صدّيق صحبت نمی‌کنم، در صدق هم صحبت نمی‌کنم و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 885.42,
   "end": 888.54,
   "text": "شواهد برای صدّيق نخواهیم آورد از آیات و روایات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 888.54,
   "end": 892.5,
   "text": "ولی یادتان باشد صحبت ما در نفاق است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 892.5,
   "end": 899.18,
   "text": "الا که نتیجه که به دست میاد از یک طرف شما می‌خوا-- می‌تواند کلمه، معنی صدّيق یا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 899.18,
   "end": 902.42,
   "text": "اون صدّيقين را هم بفهمید چه کسانی‌اند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 902.42,
   "end": 906.03,
   "text": "از مراتب این گونه نفاق خلاص کسی بشود صدّيق است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 906.03,
   "end": 909.18,
   "text": "یعنی چه؟ اول کلی توضیح بدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 909.18,
   "end": 916.0,
   "text": "یعنی این انسان در قبال حق و در مقابل حق، این بنده خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 916.0,
   "end": 918.5,
   "text": "ظاهر و باطنش،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 918.5,
   "end": 920.66,
   "text": "زبان و قلبش،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 920.66,
   "end": 925.56,
   "text": "حرکات و قلبش، چه زبان و قلبش، چه حرکات و قلبش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 925.56,
   "end": 929.36,
   "text": "با هم چی باشد؟ همه‌ش یکی باشد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 929.36,
   "end": 936.34,
   "text": "هیچ موردی پیدا نکنید که به زبان چیزی بگوید که قلب اونطور نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 936.34,
   "end": 943.54,
   "text": "موردی پیدا نکنید که حرکتی از او صادر بشود که خلاف آنچه در قلبش است باشد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 943.54,
   "end": 945.86,
   "text": "این می‌شود چی؟ می‌شود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 945.86,
   "end": 950.94,
   "text": "صدّيق. خب حالا بریم به اصل صحبتمون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 950.94,
   "end": 957.32,
   "text": "نفاق در پیشگاه خدا این است که باطن و ظاهر انسان با هم یکی نباشد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 957.32,
   "end": 961.3,
   "text": "در این باب، اینجا ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 961.3,
   "end": 964.44,
   "text": "به یک نظر در دو مرحله تقسیم می‌کنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 964.44,
   "end": 967.36,
   "text": "یکی این است که حرکات انسان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 967.36,
   "end": 973.38,
   "text": "با قلبش یکی نباشد. یکی این است که اقوال انسان با قلبش چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 973.38,
   "end": 975.06,
   "text": "یکی نباشد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 975.06,
   "end": 981.38,
   "text": "تقسیم‌بندی کلی می‌کنم که در اون مشخص بشه برای شما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 981.38,
   "end": 989.48,
   "text": "اگر بخواهیم مراتب این نفاق را، نفاق در پیشگاه خدا را به یک نظر تقسیم می‌کنیم به دو قسمت باید تقسیم بکنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 214,
   "start": 989.48,
   "end": 995.76,
   "text": "یک صورت این است که انسان حرکاتش با قلبش یکی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 215,
   "start": 995.76,
   "end": 999.62,
   "text": "نباشد. این از شعبه‌های نفاق است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 216,
   "start": 999.62,
   "end": 1003.64,
   "text": "این مؤمن به نفاق مبتلاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 217,
   "start": 1003.64,
   "end": 1007.72,
   "text": "شما از من حرکتی می‌بینید که این حرکت من",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 218,
   "start": 1007.72,
   "end": 1010.36,
   "text": "از باطن من، از قلب من، از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 219,
   "start": 1010.36,
   "end": 1022.02,
   "text": "معنویت من، از تقرب من، از تقوای من حکایتی می‌کند که آن حکایت در درون من آنچنان که برای شما این حرکت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 220,
   "start": 1022.02,
   "end": 1024.38,
   "text": "ازم حکایت می‌کند،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 221,
   "start": 1024.38,
   "end": 1027.9,
   "text": "وجود ندارد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 222,
   "start": 1027.9,
   "end": 1030.16,
   "text": "خب بعد تعریفش دقت کنید الآن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 223,
   "start": 1030.16,
   "end": 1032.68,
   "text": "حرکت، تکرار می‌کنم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 224,
   "start": 1032.68,
   "end": 1036.9,
   "text": "کلی میگم که دیگه شما تطبیقش با خود شما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 225,
   "start": 1036.9,
   "end": 1041.84,
   "text": "حرکتی از من ببینید، حرکتی از من ببینید،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 226,
   "start": 1041.84,
   "end": 1044.76,
   "text": "این حرکت در نظر شما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 227,
   "start": 1044.76,
   "end": 1058.04,
   "text": "حکایتی از یک معنا و تقوا و باطنی از من می‌کند که آنچنان که حکایت می‌کند در درون من وجود ندارد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 228,
   "start": 1058.04,
   "end": 1069.1,
   "text": "این نفاق است. کسی که اینطور حرکت انجام بدهد که حرکتش بیش از آنچه در باطنش است نشان بدهد چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 229,
   "start": 1069.1,
   "end": 1073.92,
   "text": "مبتلای به نفاق در پیشگاه خداست و منافق است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 230,
   "start": 1073.92,
   "end": 1076.82,
   "text": "و این می‌خواهد خدا را خدعه بکند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 231,
   "start": 1076.82,
   "end": 1079.58,
   "text": "خودش مشمول چیست؟ مشمول",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 232,
   "start": 1079.58,
   "end": 1081.49,
   "text": "خود-- از اونای اول یادتون نره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 233,
   "start": 1081.49,
   "end": 1084.67,
   "text": "«إِنَّ الْمُنَافِقِينَ» دبا-- جری و تثبیح ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 234,
   "start": 1084.67,
   "end": 1089.64,
   "text": "«إِنَّ الْمُنَافِقِينَ يُخَادِعُونَ اللَّهَ وَهُوَ خَادِعُهُمْ».",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 235,
   "start": 1089.64,
   "end": 1095.18,
   "text": "منافقین میخوان در این بگه کلاه گذاری بکنند ولی کلاه سر خودشون میره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 236,
   "start": 1095.18,
   "end": 1101.21,
   "text": "توجه ندارند و هو خادعهم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 237,
   "start": 1101.21,
   "end": 1110.85,
   "text": "این و هو خادعهم را دیگه من اینجا روایاتی الان من ننوشتم ولی به نظرم میاد روایاتی در ابواب مختلف دقیق دیدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 238,
   "start": 1110.85,
   "end": 1117.49,
   "text": "هی به نظرم میاد میخواد به زبانم بیاد بگم ولی نگفتنش صلاح است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 239,
   "start": 1117.49,
   "end": 1120.13,
   "text": "هست ها این در روایت صاف به چشم میخوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 240,
   "start": 1120.13,
   "end": 1125.07,
   "text": "کسی اینجور حرکت داشته باشد که از باطنش بیشتر نشان بدهد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 241,
   "start": 1125.07,
   "end": 1130.11,
   "text": "از باطن ندا میاد که میخواهی خودعه بکنی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 242,
   "start": 1130.11,
   "end": 1131.62,
   "text": "میخواهی خدا را خودعه بکنی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 243,
   "start": 1131.62,
   "end": 1133.57,
   "text": "از باطن میاد این ندا. ما نمیشنویم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 244,
   "start": 1133.57,
   "end": 1137.15,
   "text": "حالا فعلاً اون گوش نیست که بشنویم اما میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 245,
   "start": 1137.15,
   "end": 1138.89,
   "text": "ایاد ندا میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 246,
   "start": 1138.89,
   "end": 1143.77,
   "text": "خب به این روایت فقط دقت بکنید در این باب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 247,
   "start": 1143.77,
   "end": 1154.79,
   "text": "تعریف کلیشو گفتم. تعریف کلیشو گفتم و خیلی باید حالا شما به عنوان یک سالک در این مرحله هم تذکر بدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 248,
   "start": 1154.79,
   "end": 1157.81,
   "text": "از این مسئله خیلی اجتناب کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 249,
   "start": 1157.81,
   "end": 1167.53,
   "text": "هیچوقت مواظبت کنید حرکتی از شما، از نگاهتون، از لباس پوشیدنتون، از جا رفتنتون، از قیافتون، از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 250,
   "start": 1167.53,
   "end": 1170.91,
   "text": "شکل قیافتون، از نحوه صحبتتون،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 251,
   "start": 1170.91,
   "end": 1174.25,
   "text": "از بالاخره حرکاتتون دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 252,
   "start": 1174.25,
   "end": 1181.83,
   "text": "حرکاتتون، حرکتی از شما صادر نشود که بیشتر از آنچه در باطن شما هست نشان بدهد و این نفاق است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 253,
   "start": 1181.83,
   "end": 1185.95,
   "text": "باید پرهیز کرد. پس بنابراین باید به این هم مراقب بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 254,
   "start": 1185.95,
   "end": 1189.41,
   "text": "به چه قد کار سخت می‌شود که چند چیز باید مراقبت کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 255,
   "start": 1189.41,
   "end": 1191.27,
   "text": "به این هم باید مراقب بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 256,
   "start": 1191.27,
   "end": 1198.49,
   "text": "جهاد اکبر. به این هم باید مراقب بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 257,
   "start": 1198.49,
   "end": 1205.73,
   "text": "و راه صلاح، راه درست این است که انسان سالک درست و مقولیش که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 258,
   "start": 1205.73,
   "end": 1208.41,
   "text": "حرکاتش خیلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 259,
   "start": 1208.41,
   "end": 1210.55,
   "text": "پایین‌تر از اون باطنش باشد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 260,
   "start": 1210.55,
   "end": 1217.51,
   "text": "حرکاتی که به مردم ارائه می‌کند خیلی پایین‌تر از باطنش یعنی باطنش خیلی بالاتر از ظاهرش باشد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 261,
   "start": 1217.51,
   "end": 1223.09,
   "text": "سعی بکند حرکتش حتی باطنش را در اون حد دمجه‌ات نشان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 262,
   "start": 1223.09,
   "end": 1226.03,
   "text": "ندهد. به جز اینکه هیچی نشان ندهد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 263,
   "start": 1226.03,
   "end": 1228.81,
   "text": "توجه بکنید. هیچی نشان ندهد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 264,
   "start": 1228.81,
   "end": 1234.49,
   "text": "بوده‌اند کسانی که اصلاً حرکاتی دارن، حرکاتشون هیچ معنایی از باطن‌شون نشان نمی‌دهد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 265,
   "start": 1234.49,
   "end": 1237.25,
   "text": "ولی باطن چه باطنی است؟ توجه بکنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}