 "chapters": [
  {
   "index": 0,
   "title": "اعوذ بالله السمیع العلیم من الشیطان الرجیم. بسم الله الرحمن الرحیم.",
   "start": 34.92,
   "end": 243.9
  },
  {
   "index": 1,
   "title": "## پنج‌گانهٔ کشف و برتریِ گویاییِ ابصاری",
   "start": 243.9,
   "end": 472.4
  },
  {
   "index": 2,
   "title": "## خواندنِ اسرار از قیافه",
   "start": 472.4,
   "end": 617.98
  },
  {
   "index": 3,
   "title": "## رشید و علم بلایا و منایا",
   "start": 617.98,
   "end": 1052.34
  }
 ],
 "cues": [
  {
   "i": 0,
   "start": 1.22,
   "end": 4.32,
   "text": "اعوذ بالله السميع العليم من الشيطان الرجيم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 4.32,
   "end": 6.32,
   "text": "بسم الله الرحمن الرحيم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 6.32,
   "end": 12.26,
   "text": "بحث در مشاهدات و مکاشفات.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 12.26,
   "end": 18.1,
   "text": "کشف ابصاری را که یکی از اقسام کشف بود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 18.1,
   "end": 25.46,
   "text": "تا حدودی توضیح دادیم و بنا بود که اقسام دیگر کشف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 25.46,
   "end": 29.6,
   "text": "البته در حد یک توضیح کلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 29.6,
   "end": 39.1,
   "text": "توضیح داده شود. الا اینکه من اون دفعه یعنی در جلسه آخر بنا بود که دیگه کشف ابصاری صحبتی نکنیم و اقسام دیگر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 39.1,
   "end": 41.8,
   "text": "کشف را هم تا حدودی توضیح بدهیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 41.8,
   "end": 51.02,
   "text": "الا اینکه بعداً متوجه شدم که در کشف ابصاری به لحاظ اینکه فرق زیادی با کشف‌های دیگر دارد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 51.02,
   "end": 58.48,
   "text": "از لحاظ اون وسعت و اسرارآمیز بودنش در این زمینه هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 58.48,
   "end": 63.14,
   "text": "توضیحاتی در این جلسه عرض بکنم که انشاالله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 63.14,
   "end": 65.32,
   "text": "با این آیه خدا مطلع باشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 65.32,
   "end": 68.92,
   "text": "اگر چنانچه خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 68.92,
   "end": 72.38,
   "text": "توفیق داد وقتی از شما کسی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 72.38,
   "end": 80.98,
   "text": "با کشف ابصاری، از کشف ابصاری برخوردار شد اون اسرارآمیز بودنش را تا حدودی توجه داشته باشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 80.98,
   "end": 85.84,
   "text": "به اصولاً این حقیقت برای ما به صورت کلی معلوم باشد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 85.84,
   "end": 89.42,
   "text": "کشف ابصاری گرچه که از اقسام کشف هست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 89.42,
   "end": 94.42,
   "text": "کشف ابصاری این بود که عرض کردیم در مراتب مختلف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 94.42,
   "end": 100.76,
   "text": "حجاب از مقابل دید انسان،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 100.76,
   "end": 105.62,
   "text": "دید انسان، دیدن انسان برطرف شود و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 105.62,
   "end": 108.92,
   "text": "انسان پشت حجاب را",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 108.92,
   "end": 111.66,
   "text": "ببیند، مشاهده کند، بیابد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 111.66,
   "end": 115.76,
   "text": "این کشف ابصاری‌ست. البته مراتب دارد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 115.76,
   "end": 118.5,
   "text": "ببیند، مشاهده کند، بیابد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 118.5,
   "end": 123.64,
   "text": "این کشف ابصاری‌ست. البته مراتب دارد، مراتب ابتدایی دارد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 123.64,
   "end": 126.14,
   "text": "مراتبی به اصطلاح عواصف دارد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 126.14,
   "end": 129.16,
   "text": "در نهایت مراتب عالیه دارد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 129.16,
   "end": 137.44,
   "text": "کشف ابصاری. و کشف ابصاری بعدها که من یک تقسیم دیگری عرض خواهم کرد حضورتون به عنوان کشف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 137.44,
   "end": 142.38,
   "text": "صوری معنوی، کشف ابصاری خودش بعضی از اقسامش از کشف صوری است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 142.38,
   "end": 144.78,
   "text": "بعضی از اقسامش از کشف ابصاری است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 144.78,
   "end": 154.12,
   "text": "یعنی مراتبش آن چنان وسیع است که در مراتب اولیه از کشف صوری حساب می‌شود، در مراتب بعدی از کشف معنوی حساب می‌شود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 154.12,
   "end": 156.96,
   "text": "حالا اون مسئله‌ای است که بعداً عرض خواهم کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 156.96,
   "end": 158.9,
   "text": "منظورم این است که کشف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 158.9,
   "end": 165.92,
   "text": "ابصاری اولاً معنیش را تکرار می‌کنیم تا اون مطلبی را که امروز می‌خواهیم عرض بکنیم اون را توضیح بدهیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 165.92,
   "end": 175.04,
   "text": "کشف ابصاری عبارت بود از اینکه حجاب از مقابل دید انسان برطرف بشود و انسان پشت حجاب را ببیند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 175.04,
   "end": 181.08,
   "text": "در مراتب مختلف از ابتدایی گرفته تا نهایات مراتب عالیه‌اش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 181.08,
   "end": 187.24,
   "text": "آخرین مرحله کشف ابصاری هم عرض کردیم مرحله کامل‌تر او که مرحله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 187.24,
   "end": 195.94,
   "text": "نهاییش که همه سالکین به سوی اون مرحله اگر سالک صادق و مخلص باشند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 195.94,
   "end": 203.74,
   "text": "سیر می‌کنند. مرحله نهاییش هم که مقصدم همونه در واقع و قبلی‌ها همش مقدمات است و هیچ وقت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 203.74,
   "end": 208.52,
   "text": "سالک نظرش به اونها نیست اگر سالک باشد به معنی کلمه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 208.52,
   "end": 215.2,
   "text": "نهایتاً کشف ابصاری به اصطلاح منتهی می‌شود به شهود وجه الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 215.2,
   "end": 222.58,
   "text": "یعنی با چشم دل نظر به وجه حق که این نظر از مراتب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 222.58,
   "end": 226.18,
   "text": "کشف ابصاری است ولی مرتبه عالیه‌اش هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 226.18,
   "end": 229.86,
   "text": "دیدن وجه الله هست اون هم با چشم دل.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 229.86,
   "end": 235.34,
   "text": "اما دیدن در اونجا دیگه معنی خاصی دارد و بعدش سیفی وجه الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 235.34,
   "end": 238.64,
   "text": "خب مطلبی که می‌خواستم امروز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 238.64,
   "end": 253.4,
   "text": "عرض بکنم این است که کشف ابصاری از اون اقسام پنج‌گانه کشف که نظرتون هست گفتم کشف ابصاری، سمعی، ذوقی، لمسی و شمی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 253.4,
   "end": 261.86,
   "text": "در مقابل اون چهارتای دیگر گرچه اونها هم از اقسام کشف هستند ولی کشف ابصاری خیلی اسرارآمیز است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 261.86,
   "end": 271.34,
   "text": "یعنی اینکه اسرارآمیز است به این معنا که کشف ابصاری در مقایسه با اون چهارتای دیگر از کشف‌ها که مربوط به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 271.34,
   "end": 274.24,
   "text": "این پنج حس است،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 274.24,
   "end": 282.84,
   "text": "در مقابل اون چهارتای دیگر کشف ابصاری از نظر گویا بودن از اسرار",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 282.84,
   "end": 286.14,
   "text": "و حکایت از دقایق وجود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 286.14,
   "end": 289.94,
   "text": "هیچ قابل مقایسه با کشف‌های دیگر نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 289.94,
   "end": 293.78,
   "text": "فکر می‌کنید؟ یعنی کشف ابصاری هم کشف است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 293.78,
   "end": 299.08,
   "text": "مثلاً ذوقی هم کشف است، شمی هم کشف است، سمعی هم کشف است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 299.08,
   "end": 306.46,
   "text": "گاهی انسان اون چیزهایی که پشت حجاب است می‌شنود در مراتب مختلف که کشف سمعی البته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 306.46,
   "end": 310.28,
   "text": "کشف به اصطلاح سمعی گفته می‌شود که اون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 310.28,
   "end": 320.32,
   "text": "شنیدن. این هم خب بعضی از اسرار را برای انسان کشف می‌کند، معلوم می‌کند برای سالک از اسرار وجود در مراتب مختلف.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 320.32,
   "end": 325.58,
   "text": "اما اگر بخواهیم کشف ابصاری را با کشف سمعی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 325.58,
   "end": 330.84,
   "text": "کشف سمایی اگر بخواهیم مقایسه بکنیم اصلاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 330.84,
   "end": 336.74,
   "text": "تفاوتشون از لحاظ صعë، از لحاظ حکایت از اسرار و دقایق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 336.74,
   "end": 339.08,
   "text": "تفاوت خیلی زیاد است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 339.08,
   "end": 344.04,
   "text": "یعنی می‌شود گفت که تفاوت از زمین تا آسمان است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 344.04,
   "end": 350.86,
   "text": "کشف ابصاری از همون اول که شروع می‌شود البته مراحل اولیه اولیه‌اش نه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 350.86,
   "end": 356.27,
   "text": "به اصطلاح مراحل کاملاً اولیه‌اش چون هنوز سالک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 356.27,
   "end": 365.66,
   "text": "خیلی به اصطلاح سالک مبتدی است و نفخته است و هنوز آمادگی ندارد، کشفش هم خیلی کشف ناقص است و ابتدایی است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 365.66,
   "end": 368.84,
   "text": "در اون مراحل اولیه حکایت‌ها اصلاً ندارد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 368.84,
   "end": 374.9,
   "text": "ولی از مراحل اولیه یک خورده که گذشت و کشف رو به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 374.9,
   "end": 379.32,
   "text": "تکمیل که گذاشت کامل‌تر که شد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 379.32,
   "end": 381.57,
   "text": "هی حاکی‌تر می‌شود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 381.57,
   "end": 385.42,
   "text": "اونوقت این حاکی‌تر بودنش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 385.42,
   "end": 387.58,
   "text": "در دایره خیلی وسیع حاکی میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 387.58,
   "end": 390.88,
   "text": "یعنی ظاهرش این است که حالا این توضیح میدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 390.88,
   "end": 397.86,
   "text": "ظاهرش این است که سالک مثلا منظری می‌بیند در از اون منظره‌های پشت حجاب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 397.86,
   "end": 402.32,
   "text": "منظری می‌بیند، چیزی می‌بیند، حقیقتی را می‌بیند،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 402.32,
   "end": 408.24,
   "text": "مشاهده می‌کند. اما این به ظاهر دیدن است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 408.24,
   "end": 411.24,
   "text": "دریای از معانی را با خود دارد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 411.24,
   "end": 415.64,
   "text": "حقایقی را در همان موقع که می‌بیند می‌یابد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 415.64,
   "end": 422.02,
   "text": "گفتم این ظاهر دیدن است اما دیدنی است که توأم با یافتن است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 422.02,
   "end": 428.5,
   "text": "دقت می‌کنید؟ حالا اگر در بین شما کسی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 428.5,
   "end": 431.5,
   "text": "شایدم هست دیگه اگر کسی بود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 431.5,
   "end": 433.72,
   "text": "می‌دانست که خوب من چی میگم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 433.72,
   "end": 437.44,
   "text": "توجه می‌کنید؟ نگاه می‌کند چیزی می‌بیند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 437.44,
   "end": 440.18,
   "text": "اما دیدن نیست. دیدن است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 440.18,
   "end": 442.34,
   "text": "دیدن است با فهمیدنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 442.34,
   "end": 444.68,
   "text": "دیدن است با یافتن‌هایی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 444.68,
   "end": 447.19,
   "text": "دیدن است با خوندن‌هایی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 447.19,
   "end": 450.96,
   "text": "یا دیدن است با توأم با اسراری از وجود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 450.96,
   "end": 453.74,
   "text": "باز در مراحل مختلف.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 453.74,
   "end": 457.8,
   "text": "این یک خاصه بخصوصی‌ست که در کشف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 457.8,
   "end": 463.12,
   "text": "ابصاری هست. اون وقت گاه کشف ابصاری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 463.12,
   "end": 467.32,
   "text": "طوری می‌شود که به اصطلاح",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 467.32,
   "end": 475.44,
   "text": "وقتی از اسرار زیادی حکایت می‌کند، کشف ابصاری مثلا اون مکاشف، اون مشاهد، اون سالک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 475.44,
   "end": 477.88,
   "text": "که چیزی را می‌بیند،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 477.88,
   "end": 481.46,
   "text": "منظره‌ای را می‌بیند، چیزی را مشاهده می‌کند،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 481.46,
   "end": 490.84,
   "text": "حقیقتی را می‌بیند، اون را در عین حال که در یک نگاه چیزی می‌بیند، حکایت‌ها دارد و یافت‌ها و دریافت‌ها دارد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 490.84,
   "end": 496.94,
   "text": "می‌بینید که فوری نظر یعنی منظر و اونچه می‌بیند عوض شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 496.94,
   "end": 499.04,
   "text": "عوض شد با حکایت‌های دیگر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 499.04,
   "end": 506.86,
   "text": "اما در این عوض شدن هم باز اسراری که چرا این صورت رفت به جای اون صورت، این صورت مبدل شد به اون صورت،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 506.86,
   "end": 509.48,
   "text": "این منظر مبدل شد به منظر دیگر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 509.48,
   "end": 511.84,
   "text": "در منظر اول اسرار زیاد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 511.84,
   "end": 516.6,
   "text": "در تبدلش اسرار دیگر، منظر دیگر اسرار جدید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 516.6,
   "end": 524.62,
   "text": "می‌بینید که عوض میشه. حالا من مثالی هم در اینجا از جریانی که مولوی از یکی از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 524.62,
   "end": 528.7,
   "text": "بزرگان نقل می‌کند در اینجا به عنوان مثال برای شما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 528.7,
   "end": 536.54,
   "text": "عرض می‌کنم. حالا قبل از اینکه به اون برسیم توضیحاتی که می‌گویم دقت بکنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 536.54,
   "end": 540.56,
   "text": "از همین بابت که در کشف ابصاری می‌بینید که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 540.56,
   "end": 542.86,
   "text": "طرف مثلا مکاشف است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 542.86,
   "end": 544.88,
   "text": "یعنی اهل کشف و شهود است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 544.88,
   "end": 550.24,
   "text": "مکاشف نظرتون باشد هر وقت به کار بردیم یعنی اهل کشف و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 550.24,
   "end": 553.36,
   "text": "شهود. اصطلاحاً بهش میگن مکاشف.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 553.36,
   "end": 557.14,
   "text": "مسئله اینکه نظر به قیافه کردن، کشف ابصاری پیش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 557.14,
   "end": 564.84,
   "text": "آمد، به ظاهر قیافه می‌بیند اما می‌بیند آنچه که باید ببیند یا آنچه که خدا می‌خواهد و می‌بیند از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 564.84,
   "end": 572.36,
   "text": "خصوصیات به، به قیافه من نگاه می‌کند، کشف ابصاری پیش میاد از درون من، از خصوصات‌های من، از گذشته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 572.36,
   "end": 574.84,
   "text": "من، امروز چه کردم، دیروز چه کردم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 574.84,
   "end": 578.28,
   "text": "الی آخر. یا احیانا از آینده و امثال اینها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 578.28,
   "end": 580.94,
   "text": "این در ضمن چیست که گفتیم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 580.94,
   "end": 584.46,
   "text": "در ضمن یک کشف ابصاری‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 584.46,
   "end": 588.4,
   "text": "کشف ابصاری این نیست فقط یک منظری را می‌بیند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 588.4,
   "end": 591.94,
   "text": "البته در همین جا که عرض می‌کنم یک قیافه را می‌بیند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 591.94,
   "end": 594.32,
   "text": "و اسرار را می‌خواند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 594.32,
   "end": 596.02,
   "text": "اینو توجه داشته باشید. گفتم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 596.02,
   "end": 602.28,
   "text": "کشف پیش میاد و کشف ابصاری پیش میاد چیزا می‌بینه ولی در همان چیزها خیلی چیزها گنده میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 602.28,
   "end": 605.28,
   "text": "خلاصه ظاهرش دیدن است اما اسرار است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 605.28,
   "end": 611.1,
   "text": "متوجه شدید؟ این یک نمونه‌ای بود از اینکه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 611.1,
   "end": 614.24,
   "text": "گفتم و البته در حال،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 614.24,
   "end": 617.52,
   "text": "در خصوصیات بزرگان این مسئله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 617.52,
   "end": 622.5,
   "text": "هست. غیر از ائمه در خصوص میثم تمار که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 622.5,
   "end": 624.72,
   "text": "اسمش را شنیدید از اصحاب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 624.72,
   "end": 627.56,
   "text": "خاص حضرت علی سلام الله علیه بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 627.56,
   "end": 633.56,
   "text": "میثم مثلا از این نمونه‌ها مکرر ازش دیده می‌شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 633.56,
   "end": 637.47,
   "text": "یعنی با نظر به قیافه طرف،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 637.47,
   "end": 642.34,
   "text": "ابصاری براش پیش می آمد. اونم کشف ابصاری در حد خیلی بالاتر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 642.34,
   "end": 644.96,
   "text": "و خیلی چیزهای مهمی می‌گفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 644.96,
   "end": 651.42,
   "text": "من اینجا که دو روایت نوشتم که این روایت را بخوانم به شما و به اصطلاح دیگه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 651.42,
   "end": 653.96,
   "text": "بیش از اونچه که در روایت است یا احیاناً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 653.96,
   "end": 656.36,
   "text": "کم از اونچه که در روایت است چیزی نگم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 656.36,
   "end": 659.14,
   "text": "چند تا روایتی که من می‌خوانم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 659.14,
   "end": 662.22,
   "text": "یکی دو روایته. بر این روایت دقت کن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 662.22,
   "end": 668.48,
   "text": "کشف ابصاری از میثم تمار رضوان الله تعالی علیه که از اصحاب سر بود،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 668.48,
   "end": 671.34,
   "text": "از یاران خاص علی سلام الله علیه بود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 671.34,
   "end": 673.56,
   "text": "و علم معانی و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 673.56,
   "end": 682.14,
   "text": "بلایا به اصطلاح روایات یعنی آنچه که به خصوصیات گذشته افراد و خصوصیات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 682.14,
   "end": 686.86,
   "text": "آینده افراد مربوط می‌شود را می‌دانست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 686.86,
   "end": 692.55,
   "text": "یعنی این مسئله که از مسائل پشت حجاب و ماوراء الحجب است براش مکشوف بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 692.55,
   "end": 695.64,
   "text": "این از خصوصیات به اصطلاح",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 695.64,
   "end": 698.68,
   "text": "رشید و ببخشید من میثم گفتم رشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 698.68,
   "end": 705.72,
   "text": "همان رشید که شهید هم به اصطلاح شهید کردن همون رشید معروف.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 705.72,
   "end": 708.96,
   "text": "دختر رشید البته در از میثم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 708.96,
   "end": 712.82,
   "text": "هم هست ولی اینکه گفتم این از رشید روایته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 712.82,
   "end": 715.58,
   "text": "رشید از اصحاب بود و اینجوری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 715.58,
   "end": 722.84,
   "text": "بود. دختر رشید این روایت را شیخ مفید مرحوم در امالی‌ش نقل می‌کند از دختر یعنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 722.84,
   "end": 727.52,
   "text": "سند روایت منتهی میشه به دختر رشید کرشی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 727.52,
   "end": 734.32,
   "text": "از دخترش گفت. گفت که علی علیه السلام که رشید از اصحاب خاصش بود، دختر رشید نقل می‌کند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 734.32,
   "end": 739.24,
   "text": "میگه علی سلام الله علیه رشید را راشد مبتلا می‌نامید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 739.24,
   "end": 746.8,
   "text": "راشد مبتلا. یعنی مبتلا منظور اون که در معرض آزمایش‌های سخت پروردگار قرار بگیرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 746.8,
   "end": 750.66,
   "text": "منظور از مبتلا اینه. راشد رشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 750.66,
   "end": 754.44,
   "text": "دخترش میگه علی سلام الله علیه بهش راشد مبتلا می‌گفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 754.44,
   "end": 758.48,
   "text": "وکان قد علق ایه علم البلايا بالمنايا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 758.48,
   "end": 764.94,
   "text": "دخترش می‌گوید که وکان قد علق ایه علم البلايا بالمنايا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 764.94,
   "end": 774.46,
   "text": "علی سلام الله علیه امیرالمؤمنین به رشید علم بلایا و منایا را آموخته بود، یاد داده بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 774.46,
   "end": 777.88,
   "text": "اینم توجه بکنید که این یاد داده بود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 777.88,
   "end": 783.6,
   "text": "نه به این است که مثلاً مانند این درس‌هاست که مثلاً من به شما چیزی یاد میدم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 783.6,
   "end": 786.66,
   "text": "شما به من چیزی یاد میدید، یا از روی کتاب یاد میدن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 786.66,
   "end": 789.77,
   "text": "یک ضابطه میگن که به اون ضابطه مثلاً حساب می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 789.77,
   "end": 793.18,
   "text": "ریاضیات نیست. مسائل کذا نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 793.18,
   "end": 797.88,
   "text": "این تعلیم، تعلیم بخصوصی‌ست از این تعلیم‌ها که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 797.88,
   "end": 804.21,
   "text": "بین ما معمول است و برای ما شناخته شده است، حتماً یقیناً بدانید این از اون‌ها نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 804.21,
   "end": 806.16,
   "text": "یه وقتی اینجوری حساب نکنه مثلاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 806.16,
   "end": 810.34,
   "text": "رشید را مثلاً می‌آورد درس می‌داد بلایا و منایا را.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 810.34,
   "end": 814.28,
   "text": "یعنی اونچه که از پشت پرده افراد باخبر باشد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 814.28,
   "end": 816.56,
   "text": "این درس دادن به این معنا نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 816.56,
   "end": 818.86,
   "text": "یک درس دادن است به معنای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 818.86,
   "end": 828.13,
   "text": "دیگری. یه همون چیزی‌ست که رشید چون آمادگی داشت، صلاحیت روحی داشت، علی سلام الله علیه هم ولی بود،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 828.13,
   "end": 832.52,
   "text": "به خدا به ولی این چنین علم در تصرف را داده است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 832.52,
   "end": 835.68,
   "text": "او تصرفی می‌کند در روح",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 835.68,
   "end": 839.16,
   "text": "آماده‌ی رشید که از نفوس مستعده است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 839.16,
   "end": 844.54,
   "text": "و حجاب را او به اذن الله از مقابل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 844.54,
   "end": 851.02,
   "text": "دید و قلب رشید برطرف می‌کند و دفاً او به بلایا و منایا چی می‌شود؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 851.02,
   "end": 853.48,
   "text": "باخبر می‌شود. تقریباً اینجوری‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 853.48,
   "end": 857.44,
   "text": "من که نمی‌دانم چه جوری‌ست که اما تقریباً اینجوری‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 857.44,
   "end": 861.82,
   "text": "یک تصرف است، یک توجهی‌ست از ولایت، از مقام ولایت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 861.82,
   "end": 864.3,
   "text": "مطلقه به اذن الله که کار را",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 864.3,
   "end": 872.56,
   "text": "یکسره می‌کند و درست می‌شود و از این تصرف‌ها به صورت‌های مختلف از حضرات معصومین در خصوص نفوس مستعده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 872.56,
   "end": 875.77,
   "text": "دیده شده است. خب این طرح اینجور تعلیم است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 875.77,
   "end": 880.94,
   "text": "دخترش می‌گوید که وکان قد علق ایه علم البلايا بالمنايا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 880.94,
   "end": 888.1,
   "text": "راشد مبتلا بهش می‌گفت و او علم بلایا و منایا را آموخته بود فکان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 888.1,
   "end": 891.56,
   "text": "دختر رشید می‌گوید که پدرم اینجور بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 891.56,
   "end": 898.26,
   "text": "یلقر رجل. شخص را می‌دید، نظری به قیافه‌اش می‌کرد و یقول له.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 898.26,
   "end": 900.58,
   "text": "همین که نظر به قیافه او می‌کرد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 900.58,
   "end": 905.32,
   "text": "به او می‌گفت که یا فلان بن فلان تموت میتة کذا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 905.32,
   "end": 907.4,
   "text": "نظر به قیافه‌اش می‌کرد. می‌گفت که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 907.4,
   "end": 912.14,
   "text": "تو مثلاً فلان وقت اینطور می‌میری یا تو را اینطور می‌کشند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 912.14,
   "end": 916.74,
   "text": "از آینده از جریانی که برای او پیش خواهد آمد می‌گفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 916.74,
   "end": 919.58,
   "text": "البته خالص گفته‌هاش در این که خلاصه نمی‌شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 919.58,
   "end": 922.34,
   "text": "این رو به عنوان مثال دخترش می‌گوید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 922.34,
   "end": 924.96,
   "text": "این نگاهی‌ست که در آنجا چه پیش می‌آید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 924.96,
   "end": 928.34,
   "text": "کشف افساری. در ظاهر نگاه عادی‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 928.34,
   "end": 930.92,
   "text": "در متن این نگاه عادی کشف افساری‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 930.92,
   "end": 936.14,
   "text": "در اون کشف افساری، جریانات و اسرار و بلایا و منایا چی می‌شود؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 936.14,
   "end": 938.84,
   "text": "دیده می‌شود و خونده می‌شود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 938.84,
   "end": 941.56,
   "text": "شاهد، اصل مسئله را گم نکنید آقا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 941.56,
   "end": 946.4,
   "text": "اینکه کشف افساری ظاهر خیلی کشف ساده نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 946.4,
   "end": 949.54,
   "text": "دیدن یک منظر یا چند منظر نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 949.54,
   "end": 952.86,
   "text": "و یا مثلاً می‌گفت انت يا فلان تقتل قتلة کذا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 952.86,
   "end": 954.86,
   "text": "فلانی تو را اینجور می‌کشند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 954.86,
   "end": 958.72,
   "text": "فيكون الأمر كما قاله الراشد رحمه الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 958.72,
   "end": 961.96,
   "text": "دخترش می‌گوید جریان را ما دقت می‌کردیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 961.96,
   "end": 966.32,
   "text": "همونطور که راشد رشید گفته بود به همون نحو هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 966.32,
   "end": 970.48,
   "text": "می‌شد. در بین رشید و میثم چنین جریان شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 970.48,
   "end": 972.88,
   "text": "او به او گفت که می‌بینم تو را این چنین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 972.88,
   "end": 974.7,
   "text": "میثم همینطور بود. میثم تمار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 974.7,
   "end": 979.22,
   "text": "او هم از اهل کشف در اون مراحل بالاش بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 979.22,
   "end": 981.7,
   "text": "رشید به میثم گفت می‌بینم چنین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 981.7,
   "end": 984.92,
   "text": "به دارت می‌زنند. اونم گفت چنین می‌بینم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 214,
   "start": 984.92,
   "end": 986.54,
   "text": "او از قتل این خبر داد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 215,
   "start": 986.54,
   "end": 988.76,
   "text": "اینم از قتل او خبر داد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 216,
   "start": 988.76,
   "end": 992.72,
   "text": "حالا اینا چه حال و احوالی داشتند، چه خصوصیاتی داشتند،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 217,
   "start": 992.72,
   "end": 994.56,
   "text": "چه صفاتی، چه عالمی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 218,
   "start": 994.56,
   "end": 996.8,
   "text": "گاه انسان اینها را مطالعه می‌کند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 219,
   "start": 996.8,
   "end": 999.26,
   "text": "من گاهی به بچه‌ها در صحبت‌ها خصوصی میگم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 220,
   "start": 999.26,
   "end": 1001.96,
   "text": "میگم انسانیت از کجا ظهور کرده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 221,
   "start": 1001.96,
   "end": 1004.18,
   "text": "در کجاست فعلاً؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 222,
   "start": 1004.18,
   "end": 1008.08,
   "text": "انسانیت از یک جهت می‌بینید قرار گرفته که آیا الان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 223,
   "start": 1008.08,
   "end": 1011.94,
   "text": "میگن در بیرون مثلاً چه کارها می‌کنند؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 224,
   "start": 1011.94,
   "end": 1015.36,
   "text": "یا مثلاً می‌بینیم دیگه شما می‌بینید، ما می‌بینیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 225,
   "start": 1015.36,
   "end": 1018.38,
   "text": "حالا خودمون رو فعلاً مورد انتقاد قرار ندهیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 226,
   "start": 1018.38,
   "end": 1021.86,
   "text": "انسان چه بوده و چی شده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 227,
   "start": 1021.86,
   "end": 1025.42,
   "text": "اون خلیفة الله چه بوده و الان چی شده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 228,
   "start": 1025.42,
   "end": 1028.32,
   "text": "کالأنعام لهم أزل و چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 229,
   "start": 1028.32,
   "end": 1030.78,
   "text": "گفته أزل و سبیلا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 230,
   "start": 1030.78,
   "end": 1033.11,
   "text": "واقعاً أزل و سبیلا. مسئله چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 231,
   "start": 1033.11,
   "end": 1035.36,
   "text": "چه حال و احوالی. شوخی بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 232,
   "start": 1035.36,
   "end": 1038.18,
   "text": "می‌بینم چنینیت به دار می‌زنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 233,
   "start": 1038.18,
   "end": 1041.28,
   "text": "می‌بینم چنین سرت را می‌برند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 234,
