 "cues": [
  {
   "i": 0,
   "start": 1.7,
   "end": 4.5,
   "text": "بسم الله الرحمن الرحیم. در جلسه‌ی گذشته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 4.5,
   "end": 10.1,
   "text": "در اصل اول صحبت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 10.1,
   "end": 16.32,
   "text": "قسمتی از وقت گذشته را در خصوص یکی از اقسام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 16.32,
   "end": 21.34,
   "text": "کشف اختصاص دادیم و برنامه کشف را",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 21.34,
   "end": 23.18,
   "text": "ادامه دادیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 23.18,
   "end": 27.22,
   "text": "و اجمالا کشف ظاهری را توضیح دادیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 27.22,
   "end": 31.52,
   "text": "قرار است در ادامه‌ی جلسه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 31.52,
   "end": 40.1,
   "text": "صحبت دیگر داشتیم. ما در این جلسه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 40.1,
   "end": 42.22,
   "text": "دو قسمت دیگر از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 42.22,
   "end": 47.74,
   "text": "اقسام کشف به صورت باز خیلی موجمل و کلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 47.74,
   "end": 56.6,
   "text": "من اشاره می‌کنم که اگر خدا خواست در جلسه‌ی دیگر صحبتی در کشف معنوی داشته باشیم به صورت خیلی کلی و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 56.6,
   "end": 62.02,
   "text": "خدا خواست این بحث تمام شود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 62.02,
   "end": 65.78,
   "text": "کشف صوری را گفتیم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 65.78,
   "end": 69.96,
   "text": "چند قسمت کشف اثایی توضیح دادیم دو سه جلسه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 69.96,
   "end": 74.14,
   "text": "که با هم به صورت کلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 74.14,
   "end": 78.4,
   "text": "کشف سماعی را، سماعی را، سماعی را",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 78.4,
   "end": 81.72,
   "text": "هم در یک جلسه توضیح دادم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 81.72,
   "end": 86.86,
   "text": "کشف ظاهری هم در جلسه‌ی گذشته به اجمال گفتم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 86.86,
   "end": 90.78,
   "text": "حالا در این صحبت امروز هم باز اشاراتی در کشف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 90.78,
   "end": 99.28,
   "text": "به خصوص کشف ظاهری که جلسه‌ی گذشته داشتیم خواهیم داشت در حضرتون باشد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 99.28,
   "end": 108.24,
   "text": "اما اصل صحبتی که در این جلسه داریم دو قسم دیگر باقی مانده است که کشف شمی باشد و کشف لمسی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 108.24,
   "end": 114.5,
   "text": "در اصطلاح اینجور گفته می‌شود کشف شمی و لمسی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 114.5,
   "end": 121.46,
   "text": "از اقسام پنج گانه کشف صوری که به حواس پنج گانه مربوط است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 121.46,
   "end": 129.32,
   "text": "آنجا که قلب صالح به اذن الله با انوار الهی روشن شد و این انوار به مشاعر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 129.32,
   "end": 138.76,
   "text": "ظاهری و باطنی سرایت کرد یا در مشاعر این انوار که در قلب تجلی کرده بود تجلی شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 138.76,
   "end": 145.32,
   "text": "مشاعر هم از ادراک بالا تر قوی شدند از جمله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 145.32,
   "end": 148.48,
   "text": "شم انسان مشامه و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 148.48,
   "end": 156.34,
   "text": "همچنین لمس انسان لامسه نیز از ادراک بالا تر و از دریافت بالاتری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 156.34,
   "end": 161.94,
   "text": "بر اثر تجلی انوار وجودی در آنها برخوردار می‌شوند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 161.94,
   "end": 172.48,
   "text": "یعنی چانمه‌ی صالح استشمام می‌کند آنچه را که قبلاً استشمام نمی‌کرد یا دیگران افراد عادی استشمام نمی‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 172.48,
   "end": 175.88,
   "text": "در این مرحله گفته می‌شود این صالح از کشف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 175.88,
   "end": 180.9,
   "text": "شمی برخوردار است. در لمسی لامسه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 180.9,
   "end": 187.36,
   "text": "صالح لمس می‌کند آنچه را که قبلاً لمس نمی‌کرد یا دیگران افراد عادی لمس نمی‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 187.36,
   "end": 192.94,
   "text": "اینجا گفته می‌شود که صالح از کشف لمسی برخوردار است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 192.94,
   "end": 196.7,
   "text": "این دو قسم را در این جلسه تا حدودی من توضیح می‌دهم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 196.7,
   "end": 199.84,
   "text": "این دو قسم هم اول این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 199.84,
   "end": 202.82,
   "text": "کشف شمی را یه خورده توضیح میدم بعد کشف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 202.82,
   "end": 208.66,
   "text": "لمسی را. هر دو قسمش دارای مراتب است مانند اون سه قسم دیگر و اول که قبلاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 208.66,
   "end": 216.7,
   "text": "گفتیم. این دارای مراتب بودن چیزی است که خود شما هم که برای توضیح دادیم دیگه برایتون روشن شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 216.7,
   "end": 220.34,
   "text": "صالح در سلوکش اگر مرتب باشد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 220.34,
   "end": 222.88,
   "text": "مدارج و منازل طی می‌کند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 222.88,
   "end": 232.32,
   "text": "منازل یک هزار بی‌شمار، یک هزار بعضی‌ها شمارشی طی کردند اونم طبق تقسیم بندی‌هایی که اولیاء سلوک و عرفا داشتند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 232.32,
   "end": 236.78,
   "text": "و گفته می‌شود که منازل وجودش روشن است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 236.78,
   "end": 240.28,
   "text": "روایتی هم که ناظر بر منازل دل انسان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 240.28,
   "end": 244.18,
   "text": "است خداست. روایت هم لهنش باز با لحاظ‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 244.18,
   "end": 249.28,
   "text": "فرق می‌کند. گاهی هفتاد هزار گفته شده است، گاهی منازل چند هزار گفته شده است الی آخر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 249.28,
   "end": 251.71,
   "text": "خیلی گاهی کمتر گفته شده است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 251.71,
   "end": 255.88,
   "text": "اینها باز با لحاظ‌ها و اعتبارها فرق می‌کند که خیلی طولانی است بحثش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 255.88,
   "end": 262.66,
   "text": "هر اندازه صالح در منازل پیش می‌رود، منزلت‌ها، مدارج، مراحل،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 262.66,
   "end": 267.2,
   "text": "ابعاد همین تعبیرات هست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 267.2,
   "end": 274.98,
   "text": "و طبیعی‌ست صالح وقتی در منازل پیش می‌رود و در مدارج بالا می‌رود و سلوک می‌کند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 274.98,
   "end": 283.52,
   "text": "به تناسب منزلت‌ها از انوار وجودی متجلی در قلب و در وجودش برهمه‌ام می‌شود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 283.52,
   "end": 287.98,
   "text": "هرچه منزلت بالا‌تر باشد انوار تجلیش بیشتر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 287.98,
   "end": 290.18,
   "text": "تا جایی که به نهایت برسد که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 290.18,
   "end": 299.46,
   "text": "[سخنگوی 1: الهدی و الهدی بنور عزته ابهر و افضل کعبه] عارف‌ها که در مناجات شبانیه‌ میخوانند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 299.46,
   "end": 305.26,
   "text": "انشاالله اگر تا حالا نخوانده‌اید بعد از این بخوانید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 305.26,
   "end": 307.5,
   "text": "که ظهور بنور عز خدا باشد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 307.5,
   "end": 309.5,
   "text": "حالا ما را هم نمی‌فهمیم چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 309.5,
   "end": 313.8,
   "text": "ولی همین‌طور تا نهایت به اونجا برسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 313.8,
   "end": 318.88,
   "text": "حالا اون نهایت هم به اون معنا نیست ولی اون اندازه‌ای که ماها می‌فهمیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 318.88,
   "end": 326.04,
   "text": "خب در هر منزلت این تجلی انوار به تناسب همان منزلت خواهد بود و طبعا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 326.04,
   "end": 328.48,
   "text": "صالح",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 328.48,
   "end": 333.98,
   "text": "از متآشفات و مشاهدات در درجات مختلف برخوردار می‌شود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 333.98,
   "end": 338.28,
   "text": "در نتیجه کشف شمی صالح از یک جا شروع می‌شود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 338.28,
   "end": 345.1,
   "text": "و به تناسب بالا رفتن منزلت وجودیتش، وجودش این کشف هم کامل‌تر می‌شود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 345.1,
   "end": 349.8,
   "text": "کشف لمسی هم همینطور مانند کشف‌های دیگر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 349.8,
   "end": 355.62,
   "text": "مراحل ابتدایی و کاملاً اولیه کشف شمی به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 355.62,
   "end": 359.88,
   "text": "این صورت، ترکیب مطلب را دقیق گنگ نشود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 359.88,
   "end": 364.18,
   "text": "مراحل ابتدایی و اولیه کشف شمی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 364.18,
   "end": 370.26,
   "text": "که شامه صالح استشمام می‌کند آنچه را که محجوب و از او پوشیده پرده است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 370.26,
   "end": 375.58,
   "text": "به این صورت معمولاً شروع می‌کند که صالح که در مواقع ذکر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 375.58,
   "end": 377.68,
   "text": "که در مواقع به ظاهر غیر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 377.68,
   "end": 387.1,
   "text": "ذکر و در حالات مختلف و هم در همینجوری باز در خواب یا در بیداری یا بین خواب و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 387.1,
   "end": 391.56,
   "text": "بیداری و در حالات خصوصی که برای سالکین هست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 391.56,
   "end": 394.48,
   "text": "روایحی را استشمام می‌کند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 394.48,
   "end": 397.14,
   "text": "روایح یعنی رایحه‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 397.14,
   "end": 400.22,
   "text": "و بوها، بوهای خوب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 400.22,
   "end": 404.6,
   "text": "به اصطلاح روایح خوب را که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 404.6,
   "end": 412.68,
   "text": "وجود در تاول می‌شود گفت در اون مراحل اولیه‌اش بعضی مشابهت‌ها و بعضی از روایح خوب موجود در این دنیا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 412.68,
   "end": 418.5,
   "text": "دارد. در این حال بشدت هم دارد اما به یکدیگر هیچ مشابهتی ندارد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 418.5,
   "end": 421.7,
   "text": "استشمام روایح می‌کند مثلاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 421.7,
   "end": 423.72,
   "text": "در ابتدا می‌بیند که رایحه‌ای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 423.72,
   "end": 426.32,
   "text": "مشامش می‌رسد البته در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 426.32,
   "end": 429.46,
   "text": "مراحل اولیه کاملاً ابتدایی خیلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 429.46,
   "end": 434.32,
   "text": "جذب‌کننده‌ست اون روایح و خیلی خوب است و این مورد هم ناشناخته‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 434.32,
   "end": 437.34,
   "text": "گفتم این مورد هم شباهت دارد به اون اولیه‌اش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 437.34,
   "end": 444.08,
   "text": "و استشمام این روایح در اول گفتم در خواب مختلف می‌شود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 444.08,
   "end": 448.72,
   "text": "بحث کنم که خب در اول اینجوری‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 448.72,
   "end": 457.96,
   "text": "البته اینجا یک نکته را تذکر را عرض بکنم که توجه داشته باشید که گاهی ممکن است کسی که بعضی از از کارها را",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 457.96,
   "end": 460.48,
   "text": "شروع کرده از این مسئله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 460.48,
   "end": 462.76,
   "text": "برخوردار باشد. ما می‌گیم این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 462.76,
   "end": 468.54,
   "text": "کشف اول مرحله و آن مرحله ابتدایی کشف شم نیست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 468.54,
   "end": 470.61,
   "text": "و این در این حد است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 470.61,
   "end": 472.9,
   "text": "بیش از این نیست. توجه می‌کنید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 472.9,
   "end": 479.68,
   "text": "ممکن است حتی کسی بعضی از غراب از کار باعث سلسله آمادگی‌هایی در درونش هست مشغول شده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 479.68,
   "end": 488.28,
   "text": "ولی در صعود می‌شود و هیچ قدمی بر نداشته است از این روایح به صورت ابتدایی‌اش استشمام می‌کند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 488.28,
   "end": 496.14,
   "text": "این دلیل بر هیچ منزلتی نمی‌شود و خودت توجه کنید در مراحل اولی ابتداییه شروع کردنش یک صورت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 496.14,
   "end": 503.2,
   "text": "اما اینکه این دلیل شود این آدم ان شاءالله منزلت و قدرت خیلی‌ها از این جور مسائل تا به اشتباه بیفتند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 503.2,
   "end": 508.66,
   "text": "اینطور نیست. خیلی آدم‌های نه خوانده، نه ساخته، ساخته نشده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 508.66,
   "end": 512.28,
   "text": "پر از هوا و هوس، پر از اشکالات، قصد‌های بد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 512.28,
   "end": 515.78,
   "text": "خلاصه در راه هیچ قدمی نگذاشته اما در این حال",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 515.78,
   "end": 520.49,
   "text": "یک صفایی دارد، یک از کار مشغول است، یک عذوب پاکی دارد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 520.49,
   "end": 522.26,
   "text": "و یک چیزی از دیگر جمع شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 522.26,
   "end": 527.76,
   "text": "گاهی از این مسائل از این روایح خوب می‌بینه که دفعه اول استشمام می‌کند به روایح غیر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 527.76,
   "end": 529.92,
   "text": "به اصطلاح. این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 529.92,
   "end": 535.6,
   "text": "تذکر خوب نظرتون باشد و تذکر دیگری که گاهی ممکن است بعضی‌ها اشتباه بکنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 535.6,
   "end": 541.84,
   "text": "یعنی چیزی را که رایحه عادی، رایحه غیر ثابت کند در اون مراحل ابتدایی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 541.84,
   "end": 545.78,
   "text": "اینجور شروع می‌کند. این اولش اینطور است و شاید بعضی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 545.78,
   "end": 551.72,
   "text": "از شماها هم از این مسائل دیده باشید یعنی استشمام کرده باشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 551.72,
   "end": 555.54,
   "text": "بحث کنم، بحث کنم که شاید شما منزلتی داشته باشید من چی می‌دونم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 555.54,
   "end": 561.6,
   "text": "بحث کنم که این در اولش اینجور شروع می‌شود و وقتی که سالک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 561.6,
   "end": 567.78,
   "text": "اون وجود از قلبش به تدریج برطرف می‌شود، منزلت‌ها تر می‌شود، خب این استشمام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 567.78,
   "end": 570.84,
   "text": "هی بالا تر می‌شود، تکمیل می‌شود، کامل می‌شود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 570.84,
   "end": 575.62,
   "text": "این شامه از اون رو بیشتر برخوردار می‌شود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 575.62,
   "end": 577.62,
   "text": "و از اون روایح",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 577.62,
   "end": 581.04,
   "text": "پشت پرده استشمام می‌کند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 581.04,
   "end": 587.86,
   "text": "شما در موقعی که دعا می‌خوانید چیز بوز می‌گیرید، اونجا به استنشاق می‌کنید آب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 587.86,
   "end": 592.48,
   "text": "بینی می‌کشید استنشاق می‌کنید، اونجا دعا می‌کنید که خدا به من رایحه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 592.48,
   "end": 594.86,
   "text": "کوچیک را به مشامم برساند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 594.86,
   "end": 599.7,
   "text": "رایحه جنت را، رایحه بهشت را دقت می‌کنید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 599.7,
   "end": 604.76,
   "text": "چون تو ناظر به این مسئله‌ست، این حقیقت است که الان داریم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 604.76,
   "end": 612.36,
   "text": "صحبت می‌کنیم. این عالم پر است از روایح، از روایحی که محجوب از این شامه به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 612.36,
   "end": 614.6,
   "text": "اصطلاح ناقص ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 614.6,
   "end": 616.32,
   "text": "پر است از روایح.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 616.32,
   "end": 619.52,
   "text": "چه روایح خیلی خوب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 619.52,
   "end": 624.22,
   "text": "و دیگه نمی‌شود به تصور بیاید اصلاً قبل از این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 624.22,
   "end": 630.16,
   "text": "و چه به اصطلاح بوها و رایحه‌های خیلی بد پر است همه‌جا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 630.16,
   "end": 636.92,
   "text": "مخصوصاً هر موجودی برای خودش حالا این‌ها را که می‌گم دیگه شما خیلی فکرتون را جمع بکنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 636.92,
   "end": 645.58,
   "text": "این‌ها را که می‌گیم چون حقیقت‌هاست می‌گیم ولی برای من و شما نفس از یک تصور ذهنی‌ست و از حقیقت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 645.58,
   "end": 650.6,
   "text": "هر موجودی برای خودش رایحه‌ای دارد از اون روایح غیر، خوب یا بد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 650.6,
   "end": 653.96,
   "text": "هر موجودی در احوال مختلف رایحه‌ها دارد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 653.96,
   "end": 656.62,
   "text": "خوب یا بد. رسیدیم به انسان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 656.62,
   "end": 659.42,
   "text": "من و شما در هر لحظه‌ای رایحه‌ای داریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 659.42,
   "end": 662.76,
   "text": "خوب یا چی؟ نگفتید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 662.76,
   "end": 671.52,
   "text": "بله. هرچه شما در حال طاعت و در حال عبودیت و توجه و فزان دشت عقل باشید، رایحه خوب دارید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 671.52,
   "end": 676.68,
   "text": "هرچه شما در حال معصیت، غفلت باشید در مراحل مختلف و انواع گناهان،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 676.68,
   "end": 679.78,
   "text": "روایح بد دارید، بد دارید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 679.78,
   "end": 685.38,
   "text": "این چیزی‌ست که اگر انسان به اون محلی از کشف برسد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 685.38,
   "end": 688.44,
   "text": "اون وقت واقعاً تحیر‌آور است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 688.44,
   "end": 696.19,
   "text": "هر وقت شما تصوری معصیت را می‌گیرید، بوی خیلی بد که به تصور نمی‌آید دقت بکنید ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 696.19,
   "end": 700.24,
   "text": "اصلاً به تصور نمیاد. این بوهای بدی که در این عالم دیده‌ای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 700.24,
   "end": 702.82,
   "text": "این‌ها ناظر به هست از اون روایح بد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 702.82,
   "end": 705.62,
   "text": "جهنمی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 705.62,
   "end": 708.56,
   "text": "از معص-معصیت این‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 708.56,
   "end": 718.86,
   "text": "متولد می‌شود. هر وقت انسان تصوری بر معصیت می‌گیرد، این بو از وجودش و از نفسش و از دمش مخصوصاً متصاعده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 718.86,
   "end": 722.5,
   "text": "دقت بکنید ها. از دمش مخصوصاً متصاعد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 722.5,
   "end": 725.14,
   "text": "اما اهلش می‌خواهد که بیابد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 725.14,
   "end": 729.16,
   "text": "دقت می‌کنید؟ معصیت را اگر شروع کرد، بو",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 729.16,
   "end": 735.36,
   "text": "خیلی بد به شکل دیگر از وجود انسان مخصوصاً از دم انسان و از نفس انسان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 735.36,
   "end": 741.84,
   "text": "صاعده و اگر اهل کشف باشد در این بین می‌بیند که ملائکه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 741.84,
   "end": 745.3,
   "text": "که موجودات نوری و طاهت هستند،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 745.3,
   "end": 748.74,
   "text": "اون‌ها چجوری فرار می‌کنند از این بوها؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 748.74,
   "end": 751.32,
   "text": "دقت می‌کنید؟ چجوری فرار می‌کنند؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 751.32,
   "end": 755.26,
   "text": "یعنی به شرطی که اون بو را استشمام می‌کند، ملک را هم ببیند، تشخیص",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 755.26,
   "end": 759.56,
   "text": "بصری هم داشته باشد و ببیند که چجوری فرار می‌کنند،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 759.56,
   "end": 761.38,
   "text": "چه راهی می‌کشند مثلاً.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 761.38,
   "end": 769.18,
   "text": "اینجوری است. و در اینجا باید این نکته را پزشیور داشته باشید که حتی بوهای بعد دنیوی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 769.18,
   "end": 774.1,
   "text": "که من و شما با هیش هم استشمام می‌کنیم حتی این‌ها در مقام رویت دیده که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 774.1,
   "end": 780.84,
   "text": "نشده. گفته شده است که دستور شرع مقدس این است که از این‌ها دور باشید حتی این‌ها بد است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 780.84,
   "end": 785.64,
   "text": "حتی این بوهای عادی معمولی بد در دنیا که با هیش هم عادی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 785.64,
   "end": 788.98,
   "text": "اون‌ها اسرار است، ماها نمی‌فهمیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 788.98,
   "end": 795.22,
   "text": "می‌دانید گفته شده است اون وقتی عبادت می‌کنید سر و صورت، لباس‌تون، بدن‌تون هیچ میوه ندهد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 795.22,
   "end": 797.48,
   "text": "کثیف نباشد، گرس پاک خوب هم تا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 797.48,
   "end": 805.08,
   "text": "حدش دارید. گفته شده است موقع مشهور ذکر هستید، مشهور دعا هستید، الان جای عبادت‌تون، به جای ذکر‌تون،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 805.08,
   "end": 810.38,
   "text": "دور مثلاً روشن می‌کنید، معطر می‌کنید اونجا را، بدن را، لباس را، مخصوصاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 810.38,
   "end": 813.76,
   "text": "اون منزل را، اون جایی را که دارید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 813.76,
   "end": 821.42,
   "text": "خیلی تو-- تاکید شده است که بالاخره در منزل و لباس این‌ها از این مسائل نباشد حتی مشاحبه ایجاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 821.42,
   "end": 828.94,
   "text": "به هر صورت، انسان در حال معصیت روایح خیلی بدی دارد مخصوصاً از دهنش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 828.94,
   "end": 837.3,
   "text": "در حال طاعت در آن حال مختلف و در درجات مختلف دارای روایح طیبه و خوبی است که باز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 837.3,
   "end": 841.54,
   "text": "به تصور نمی‌آید و عقل چشم می‌یابند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 841.54,
   "end": 844.66,
   "text": "گفتم ملاک هم این طرفش رو می‌یابند هم اون طرفش رو می‌یابند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 844.66,
   "end": 848.52,
   "text": "خب معلوم است. توجه کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 848.52,
   "end": 851.6,
   "text": "کسی که از عه-- چشم برگزاره است از چشم شمع",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 851.6,
   "end": 855.92,
   "text": "این مسائل را به اصطلاح می‌یابد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 855.92,
   "end": 860.6,
   "text": "یعنی اگر بین شما کسی باشد از چشم شمع برگزاره باشد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 860.6,
   "end": 863.5,
   "text": "وقتی به بنده نزدیک می‌شوید اگر من",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 863.5,
   "end": 871.78,
   "text": "معصیت‌کار باشم، تاثیر معصیت داشته باشم، کسی از من متوجه معصیتم بشود یک روایح خیلی بد استشمام می‌کند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 871.78,
   "end": 875.6,
   "text": "که دیگه نمی‌شه گفت هم چطور بده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 875.6,
   "end": 880.66,
   "text": "مخصوصاً در حال معصیت و اگر یک فرد الهی باشم روایح خوبی استشمام",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 880.66,
   "end": 888.14,
   "text": "خواهید کرد. هرچه الهی‌تر باشم رایحه‌ای که اصلاً انسان را گفتم دیگه به تصور نمیاد چجوری است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 888.14,
   "end": 892.12,
   "text": "رسول اکرم صلی الله علیه و آله و سلم بود که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 892.12,
   "end": 894.76,
   "text": "وارد منزل شد که اویس،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 894.76,
   "end": 898.32,
   "text": "اون اویس که رحمة الله علیه و رضوان الله علیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 898.32,
   "end": 905.5,
   "text": "که از خاصان و از اصحاب سر بود رسول اکرم صلی الله علیه و آله و سلم از خلاص رشید الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 905.5,
   "end": 910.22,
   "text": "شراف الله علیه و از خلاص علی سلام الله علیه بود اویس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 910.22,
   "end": 912.46,
   "text": "کرم، کرمی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 912.46,
   "end": 922.1,
   "text": "این خب دیگه از خود خلاص شده بود اویس و اویس بالاخره مظهر اسماء و صفات حق بود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 922.1,
   "end": 925.14,
   "text": "و خیلی رائحه‌ی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 925.14,
   "end": 928.9,
   "text": "جالبی داشته و بود اما شمع می‌خواست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 928.9,
   "end": 932.78,
   "text": "دقت می‌کنید؟ شمع می‌خواست بوی خدا را،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 932.78,
   "end": 936.3,
   "text": "دقت می‌کنید؟ بوی خدا را از کی استشمام می‌کنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 936.3,
   "end": 938.41,
   "text": "از اویس. بوی اسماء و صفات است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 938.41,
   "end": 940.4,
   "text": "بوی جمع جنار مطلق است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 940.4,
   "end": 947.3,
   "text": "بوی خداست. حالا بوی خدا میگیم دیگه تصور کفرآمیز نکنیم به طوری که سید الشهدا سلام الله علیه میگفت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 947.3,
   "end": 951.44,
   "text": "بوی خدا یا ثارالله ولنا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 951.44,
   "end": 956.76,
   "text": "ثار. این هم باید به محامی داشته باشد متناسب با ساحت اون ساحت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 956.76,
   "end": 959.0,
   "text": "خب رسول اکرم صلوات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 959.0,
   "end": 964.2,
   "text": "الله علیه فرض کنم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 964.2,
   "end": 968.94,
   "text": "وارد منزل شد. اویس آمده بود برای دیدن رسول الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 968.94,
   "end": 976.94,
   "text": "در روایتی من اینجور در جایی خیلی وقت دیدم یه بار هم همینجوری گفتم یه روش تناسبی گفتم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 976.94,
   "end": 985.22,
   "text": "این اشم روائحت الرحمن من قبل اليمن یا من جانب اليمن فرمایش رسول الله معروف بین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 985.22,
   "end": 991.4,
   "text": "روات، بین ادعای باطن و بین عرفا در کتاب حاشیه میبینید بیان معروفی است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 991.4,
   "end": 995.45,
   "text": "همه عرفا، شیعه، سنی همه‌شون اینو آوردند این بیان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 995.45,
   "end": 998.42,
   "text": "اما اینکه داستانه که عرض می‌کنم رو کجا دیدم؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 998.42,
   "end": 1003.36,
   "text": "یه وقتی دیدم که اینها اونجا گفته رسول اکرم صلی الله علیه و آله و سلم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 1003.36,
   "end": 1006.4,
   "text": "اشم روائحت الرحمن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 1006.4,
   "end": 1016.14,
   "text": "من جانب اليمن. من رائحه‌ای می فرمود که من رائحه‌ی رحمن را از جانب یمن استشمام می‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 1016.14,
   "end": 1018.86,
   "text": "اویس اونجا بود آخه در یمن بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 1018.86,
   "end": 1023.8,
   "text": "گفته شده است که اونجا بود و یوسف الکرام هم بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 1023.8,
   "end": 1026.44,
   "text": "اینجور گفته شده است اگر درست باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 1026.44,
   "end": 1032.44,
   "text": "هرچی بود اونجا بود. می‌فرمود که من رایحه خدا را از اونجا استشمام می‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 1032.44,
   "end": 1036.68,
   "text": "این اشم روائحت الرحمن من قبل اليمن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 1036.68,
   "end": 1041.28,
   "text": "یا من جانب اليمن. اون داستانی که گفتم من سابقاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 1041.28,
   "end": 1044.02,
   "text": "کجا دیدم؟ اه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 214,
   "start": 1044.02,
   "end": 1046.58,
   "text": "هست اینطور بود که اویس",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 215,
   "start": 1046.58,
   "end": 1052.1,
   "text": "رضوان الله علیه مادر پیری هم داشت که بود متقضار بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 216,
   "start": 1052.1,
   "end": 1058.48,
   "text": "یه وقتی از مادرش اجازه گرفت که بیاد به زیارت رسول اکرم صلی الله علیه و آله و سلم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 217,
   "start": 1058.48,
   "end": 1063.72,
   "text": "به مکه آمدی. این اونجا که یادم نیست روز زیارتش در مکه آمدی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 218,
   "start": 1063.72,
   "end": 1066.1,
   "text": "یادم نیست. یکی از این بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 219,
   "start": 1066.1,
   "end": 1073.24,
   "text": "آمد و هست حتی اونچه من دیدم بود که تا ظهر مادرش اجازه داده بود که برود و برگردد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 220,
   "start": 1073.24,
   "end": 1077.08,
   "text": "خیلی افتاده بود مادرش که اویسی همه وقت در خدمتش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 221,
   "start": 1077.08,
   "end": 1087.94,
   "text": "بود. فرض کنم که آمد و وارد منزل رسول اکرم صلوات الله علیه شد و سؤال کرد و گفتند رسول الله منزل نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 222,
   "start": 1087.94,
   "end": 1094.6,
   "text": "بیرون بود رسول الله. اون اندازه هم اویس فرصت نداشت که تبرک بکند رسول الله بیاید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 223,
   "start": 1094.6,
   "end": 1098.3,
   "text": "زیارت بکند و برگردد چون می‌ترسید به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 224,
   "start": 1098.3,
   "end": 1106.34,
   "text": "ظهر نرسه و مادر پیرش بماند که این خلاف رضای خدا و رضایت رسول صلوات الله علیه بود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 225,
   "start": 1106.34,
   "end": 1113.44,
   "text": "و لذا برگشت با تأسف برگشت که به زیارت رسول اکرم صلی الله علیه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 226,
   "start": 1113.44,
   "end": 1118.92,
   "text": "و آله نرسید. بعد رسول الله که آمد به منزل همین که رسید گفت إني أشم رائحة",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 227,
   "start": 1118.92,
   "end": 1121.72,
   "text": "الرحمن. من بوی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 228,
   "start": 1121.72,
   "end": 1125.94,
   "text": "رحمان از جان یمن را یعنی از اون منزلش استشمام می‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 229,
   "start": 1125.94,
   "end": 1130.2,
   "text": "یعنی قویس آمده این بود منتها بعد قویس از غران آمده بود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 230,
   "start": 1130.2,
   "end": 1137.02,
   "text": "و رائحه‌ش را رسول الله شما اگه یک بوی خیلی معطری عطر معطری را در یک منزلی بیاری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 231,
   "start": 1137.02,
   "end": 1140.16,
   "text": "به برید رائحه‌ش این بود در ظاهر اینجوری‌ست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 232,
   "start": 1140.16,
   "end": 1145.68,
   "text": "اما در باطن بالاتر از این است و اصولا باطنش مکان و مکان نمی‌شناسد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 233,
   "start": 1145.68,
   "end": 1149.68,
   "text": "فوق مکان و مسائل احکام مکان و زمان و امثال اینهاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 234,
   "start": 1149.68,
   "end": 1154.54,
   "text": "إني أشم رائ که این می‌گوید که در اینجا به عیش هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 235,
   "start": 1154.54,
   "end": 1158.82,
   "text": "است البته نمی‌گوییم رسول اکرم صلی الله علیه و آله در این منزلت بود که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 236,
   "start": 1158.82,
   "end": 1162.92,
   "text": "کشف شم می‌داشت منزلت او را خدا می‌داند و خودش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 237,
   "start": 1162.92,
   "end": 1165.92,
   "text": "اما چون که صد آیه نود هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 238,
   "start": 1165.92,
   "end": 1167.98,
   "text": "پیش کیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 239,
   "start": 1167.98,
   "end": 1173.48,
   "text": "ما از کوه بینا که رسول الله صلی الله علیه و آله بعد گفت اِ.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 240,
   "start": 1173.48,
   "end": 1178.66,
   "text": "اینجا به اشعاری از مولوی گوش می‌کنیم می‌گوید که بوی رامین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 241,
   "start": 1178.66,
   "end": 1182.3,
   "text": "که محمد صلی الله علیه و آله و سلم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 242,
   "start": 1182.3,
   "end": 1192.4,
   "text": "این در دفتر چهارم است یعنی اشعار که اگر دقت کنید که محمد گفته بر دست صبا که محمد گفته بر دست صبا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 243,
   "start": 1192.4,
   "end": 1193.94,
   "text": "صبای باد صبا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 244,
   "start": 1193.94,
   "end": 1198.3,
   "text": "این باد صبا از این بادها نیست ها توجه کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 245,
   "start": 1198.3,
   "end": 1201.96,
   "text": "از یمن می‌آیدم بوی خدا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 246,
   "start": 1201.96,
   "end": 1206.32,
   "text": "بوی رامین می‌رسد از جان قویس،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 247,
   "start": 1206.32,
   "end": 1213.26,
   "text": "بوی یزدان می‌رسد هم از قویس، بوی رامین می‌رسد از جان قویس،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 248,
   "start": 1213.26,
   "end": 1216.06,
   "text": "بوی یزدان می‌رسد هم از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 249,
   "start": 1216.06,
   "end": 1221.84,
   "text": "قویس. از قویس و از غران بوی عجب،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 250,
   "start": 1221.84,
   "end": 1226.12,
   "text": "نه نبی را مست کرد و پرتره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 251,
   "start": 1226.12,
   "end": 1230.32,
   "text": "چون قویس از خویش کام گشته بود، دقت می‌کنید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 252,
   "start": 1230.32,
   "end": 1233.6,
   "text": "چون قویس از خویش کام گشته بود،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 253,
   "start": 1233.6,
   "end": 1236.89,
   "text": "آن زمین آسمان گشته بود،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 254,
   "start": 1236.89,
   "end": 1239.92,
   "text": "آن حلیله پروریده در شکر،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 255,
   "start": 1239.92,
   "end": 1243.32,
   "text": "چاشنی تلخش نعت دگر،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 256,
   "start": 1243.32,
   "end": 1247.12,
   "text": "آن حلیله رسته از ما و منی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 257,
   "start": 1247.12,
   "end": 1251.86,
   "text": "نش دارد از حلیله طعمی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 258,
   "start": 1251.86,
   "end": 1257.98,
   "text": "آن کسی که از خود به کلی در گذشت، بی ملی و مائه‌ی خود در نروشت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}