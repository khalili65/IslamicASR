 "duration": 1119.92,
 "alignment": {
  "exact": 2434,
  "total": 2434,
  "ratio": 1.0,
  "maxGapSeconds": 0.0,
  "p95GapSeconds": 0.0,
  "driftFraction": 0.0
 },
 "chapters": [],
 "cues": [
  {
   "i": 0,
   "start": 0.72,
   "end": 3.8,
   "text": "اعوذ بالله السميع العليم من الشيطان الرجيم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 3.8,
   "end": 6.82,
   "text": "بسم الله الرحمن الرحيم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 6.82,
   "end": 13.06,
   "text": "از لحاظ توحید همه چیز را باید خدا بخواهد حتی من موفق به سعی بشم سستی نکنم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 13.06,
   "end": 16.9,
   "text": "حتی توفیق بر سعی و مجاهدت هم از چیست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 16.9,
   "end": 21.12,
   "text": "از خداست. سستی و کنار بگذارم این هم از خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 21.12,
   "end": 25.78,
   "text": "دقت بکنید. امروز فردا نکنم اون هم از خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 25.78,
   "end": 29.26,
   "text": "هرچی خیر است از خداست حتما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 29.26,
   "end": 32.82,
   "text": "پس از لحاظ دعا باید همه اینها را از کی خواست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 32.82,
   "end": 35.58,
   "text": "از خدا خواست. هم مفاهیم است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 35.58,
   "end": 40.5,
   "text": "معنیش این است که وقتی همش از اوست حتی سعی من هم از اوست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 40.5,
   "end": 42.96,
   "text": "مجاهدت من هم باید او بخواهد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 42.96,
   "end": 46.68,
   "text": "پس فقط من به دعای کار بکنم بشینم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 46.68,
   "end": 52.48,
   "text": "اینجوری باید نتیجه بگیرد. بشینم یا در جهت دعای خودم حرکت بکنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 52.48,
   "end": 58.3,
   "text": "اینجور باشد. لیس للإنسان إلا ما سعى که جمله واضحی است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 58.3,
   "end": 59.96,
   "text": "همه هم مفهومش رو میفهمن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 59.96,
   "end": 63.08,
   "text": "نمیشود آدم معنی دیگری بهش داد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 63.08,
   "end": 70.52,
   "text": "در عین حال که سعی را هم باید خدا بخواهد و با تضرع از خدا بخواهیم خدایا بخواه ما سعی بکنیم باید سعی را بکنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 70.52,
   "end": 75.4,
   "text": "اینجوری. یک چیز بسیار ظریفی است این دو تا را با هم جمع کردن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 75.4,
   "end": 82.6,
   "text": "خیلی ظریف. چون خیلی ظریفه به شما توصیه میکنم در فهم این دو حقیقت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 82.6,
   "end": 87.48,
   "text": "و در جمع کردن این دو با همدیگر مواظبت بکنید اشتباه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 87.48,
   "end": 93.1,
   "text": "نکنید. فهم این دو به این معنا که انسان جمع بکند بین اینکه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 93.1,
   "end": 97.68,
   "text": "همه چیز را باید خدا بخواهد و بین اینکه انسان باید سعی هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 97.68,
   "end": 101.62,
   "text": "بکند. جمع بین این دو کار هر کسی نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 101.62,
   "end": 105.88,
   "text": "ولی شما بدانید که باید بین این دو جمع کرد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 105.88,
   "end": 112.32,
   "text": "و از خدا بخواهد خودش به شما خوب بفهماند که این دو حقیقت چطور با هم جمع میشود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 112.32,
   "end": 116.06,
   "text": "بفهماند و شما را اینجور نکند فهم شما را",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 116.06,
   "end": 119.2,
   "text": "که نتوانید دو تا را با همدیگر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 119.2,
   "end": 128.5,
   "text": "جمع بکنید. اگر این دو حقیقت رو خوب نفهمیدید و خوب جمع نکردید حتما به این گرفتاری‌ها که خیلی گرفتار هستند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 128.5,
   "end": 132.24,
   "text": "دچار میشوید. عرض کردم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 132.24,
   "end": 135.24,
   "text": "ببینید این در این دعای جمعه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 135.24,
   "end": 140.7,
   "text": "اول من ترجمه رو کنم خب ترجمه‌اش فهمیدید گفتم دیدید در دعاها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 140.7,
   "end": 142.72,
   "text": "در دعای روز جمعه است ولی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 142.72,
   "end": 150.14,
   "text": "همین مضمون در دعاهای دیگر غیر از این نه، نه دعای روزها در دعاهای دیگر هم آمده بلا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 150.14,
   "end": 159.42,
   "text": "نه یعنی اینکه به یک حقیقت بسیار عجیبی اشاره می‌کند و یک هشدار عجیبی است برای ما اگر بفهمیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 159.42,
   "end": 162.26,
   "text": "شاهد میگیرم حق خود تو را،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 162.26,
   "end": 166.6,
   "text": "ملائکه را، سلطان سماوات را، عمله عرش را،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 166.6,
   "end": 173.42,
   "text": "انبیا و مرسلین را، همه در و دیوار و موجودات و مخلوقات را شاهد میگیرم که من",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 173.42,
   "end": 179.1,
   "text": "مؤمنم. من شهادت میدهم به توحید و به رسالت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 179.1,
   "end": 182.18,
   "text": "رسول اکرم صلی الله علیه و آله و سلم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 182.18,
   "end": 184.02,
   "text": "خود شما اون ترجمه‌اش گفتند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 184.02,
   "end": 187.14,
   "text": "این از چه جایi حرف میزند؟ این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 187.14,
   "end": 192.04,
   "text": "برای اون این لامه های خطره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 192.04,
   "end": 194.72,
   "text": "منظورم در پیش است در این دنیا نه ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 194.72,
   "end": 198.72,
   "text": "منظور در پیش نه در تحولاتی که در پیش دارد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 198.72,
   "end": 201.2,
   "text": "از موقع مرگ مخصوصا شروع میشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 201.2,
   "end": 205.46,
   "text": "از احتضار البته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 205.46,
   "end": 210.74,
   "text": "ممکنه بعضیا مثلاً در آتisme زندگی کنند به یک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 210.74,
   "end": 214.84,
   "text": "مثلاً مراحل خطرناک از لحاظ عقیدتی براش پیش بیاد و اون هم شامل بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 214.84,
   "end": 220.48,
   "text": "ولی اصلش ناظر به اون مراحل خطرناکی است که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 220.48,
   "end": 225.58,
   "text": "در، از موقع مرگ و احتضار شروع میشه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 225.58,
   "end": 230.34,
   "text": "شیاطین مسلماً به سراغ همه میان برای تشکیک.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 230.34,
   "end": 232.48,
   "text": "یعنی به شک انداختن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 232.48,
   "end": 239.32,
   "text": "دقت بکنید. اون موقع مرگ بدون استثنا شیاطین به سراغ همه میان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 239.32,
   "end": 243.24,
   "text": "که از عقاید و از این چیزها که داشتند در زندگی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 243.24,
   "end": 247.14,
   "text": "گفتم که داشتند دیگه. مؤمنین.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 247.14,
   "end": 250.54,
   "text": "از اون عقایدشون اینها را چه بکند؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 250.54,
   "end": 252.36,
   "text": "به سراغ بگیرند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 252.36,
   "end": 260.98,
   "text": "این یک مرحله‌شون مرحله احتضار که بسیار مرحله عجیب و غریبی است که هیچکس ندیده نمیداند چیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 260.98,
   "end": 264.76,
   "text": "ندیده کسی نخواهد دانست چیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 264.76,
   "end": 268.26,
   "text": "اون حالت احتضار که روح به،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 268.26,
   "end": 274.92,
   "text": "به اصطلاح میخواهد از بدن خارج بشود ولتی به اصطلاح به سینه و به قلب و اونجاهایی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 274.92,
   "end": 277.82,
   "text": "میرسد به اون وقت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 277.82,
   "end": 283.26,
   "text": "البته از لحاظ باطن امر هم مسئله، مسئله فوق زمان است که انسان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 283.26,
   "end": 287.32,
   "text": "یک مرحله‌ای است که دیگه برگشتنی نیست و اون مرحله است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 287.32,
   "end": 295.84,
   "text": "که حداقل‌ها و اینها کنار میرود و از یک طرف شیاطین با جنودش به سراغ انسان‌ها میان برای اینکه به شک بیاندازند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 295.84,
   "end": 298.44,
   "text": "حالا چه جور به شک می‌اندازند؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 298.44,
   "end": 302.02,
   "text": "به چه شکلی تشکیک می‌کنند؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 302.02,
   "end": 305.6,
   "text": "این را دیگه گفتم ندیده انسان نمیداند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 305.6,
   "end": 310.94,
   "text": "فقط روایات صاف میگوید که شیاطین، شیطان با جنودش به سراغ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 310.94,
   "end": 313.62,
   "text": "انسان‌ها در اون موقع میان که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 313.62,
   "end": 318.02,
   "text": "تشکیکشون بکنند. یعنی به شکشون بیاندازند در عقایدشون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 318.02,
   "end": 323.56,
   "text": "این عقاید را دیگه حالا اصلش در اینجا اون توحید است و رسالت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 323.56,
   "end": 328.86,
   "text": "رسول اکرم صلی الله علیه هم چنین در خصوص امامت، در خصوص کل عقاید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 328.86,
   "end": 331.5,
   "text": "به شک میاندازند. چه جور تشکیک می‌کنند؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 331.5,
   "end": 333.68,
   "text": "چه چیزها، چه اوضاعی پیش میآید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 333.68,
   "end": 338.22,
   "text": "چه چیزها به فکر می آورند؟ چه چیزها القا می‌کنند شیاطین؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 338.22,
   "end": 342.06,
   "text": "و کسانی در این مقام به شک میروند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 342.06,
   "end": 345.4,
   "text": "دقت کنید. دیگه اون عقایدشون را که صاف",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 345.4,
   "end": 349.66,
   "text": "و روشن در دنیا برای خودشان عقاید بود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 349.66,
   "end": 352.32,
   "text": "نمیتوانند حفظ بکنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 352.32,
   "end": 356.36,
   "text": "دقت کنید. این جمله‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 356.36,
   "end": 358.32,
   "text": "البته این یک مرحله خطر است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 358.32,
   "end": 360.74,
   "text": "یک مرحله مخاطراتی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 360.74,
   "end": 363.58,
   "text": "است که در پیش است در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 363.58,
   "end": 366.86,
   "text": "بعد مرگ هم در برزخ هم هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 366.86,
   "end": 370.5,
   "text": "در موقع سؤال مثل این هم هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 370.5,
   "end": 375.64,
   "text": "مراحل خطرات. اینها این شاهد گرفتن‌ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 375.64,
   "end": 381.3,
   "text": "با یک حالت مخصوص برای این مواقع که خدایا من تو را شاهد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 381.3,
   "end": 386.74,
   "text": "یعنی تو خودت شاهد باش اگر اینجور چیزها پیش آمد من تو را شاهد می‌گیرم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 386.74,
   "end": 389.4,
   "text": "که تویی أنت الله لا اله الا أنت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 389.4,
   "end": 394.3,
   "text": "تمام آسمان و زمین را شاهد می‌گیرم که من مؤمن بر وحدانیت هستم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 394.3,
   "end": 399.46,
   "text": "من موحد هستم. من به رسالت رسول الله معتقد هستم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 399.46,
   "end": 403.56,
   "text": "که در مواقع خطر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 403.56,
   "end": 413.06,
   "text": "این شهادت، این شاهد گرفتن خدا و آسمان و زمین اگر انسان درد مندانه این کار را در عمرش داشته باشد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 413.06,
   "end": 416.2,
   "text": "در اون مواقع به دردش می‌خوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 416.2,
   "end": 417.92,
   "text": "به درد می‌خوره، به دردش می‌خوره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 417.92,
   "end": 421.46,
   "text": "خدا به کمکش میاد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 421.46,
   "end": 424.96,
   "text": "و ملائکه به کمکش میان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 424.96,
   "end": 428.12,
   "text": "انبیا و رسل هم به کمکش میان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 428.12,
   "end": 431.54,
   "text": "ائمه اطهار صلوات الله علیهم اجمعین به کمکش میان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 431.54,
   "end": 435.06,
   "text": "اونجا که شیطان می‌خواد تشکیک بکنه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 435.06,
   "end": 438.1,
   "text": "خدا خلاصه در مجموع چی می‌کنه او را؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 438.1,
   "end": 441.08,
   "text": "کمک می‌کنه. الان فهمیدی جمله چه معنی می‌ده؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 441.08,
   "end": 444.66,
   "text": "خدایا من شاهد می‌گیرم تو را",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 444.66,
   "end": 449.04,
   "text": "که من می‌گویم لا اله الا انت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 449.04,
   "end": 454.18,
   "text": "شاهد می‌گیرم تو را شاهد باش من می‌گویم لا اله الا انت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 454.18,
   "end": 458.02,
   "text": "شاهد باش من می‌گویم ان محمدا عبده و رسوله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 458.02,
   "end": 460.9,
   "text": "این برای اون مواقع. شاهد باش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 460.9,
   "end": 464.96,
   "text": "که خدا در اون مواقع دست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 464.96,
   "end": 467.54,
   "text": "انسان را می‌گیره. گرچه دیر شده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 467.54,
   "end": 472.6,
   "text": "ولی برای اینکه من گفتم امروز تصمیم داشتم اینجا با شما بگم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 472.6,
   "end": 480.7,
   "text": "دورانش صحبت ولی این یک چیزی‌ست که اگر شما این را عمل کردید و همه‌تون ان‌شاءالله عمل کنید،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 480.7,
   "end": 486.74,
   "text": "نه یک بار باید این دعا را با این لحن گفتن در دعاهای دیگر هم آمده است حتی به زبان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 486.74,
   "end": 489.14,
   "text": "آزاد خودتون می‌تونید ممکنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 489.14,
   "end": 491.64,
   "text": "همین را که در دعای چیز هست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 491.64,
   "end": 499.92,
   "text": "در دعای روز جمعه است یا اشباع این را که در دعاهای دیگر هست برای خودتون بنویسید و به صورت دعای آزاد در مواقع",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 499.92,
   "end": 502.9,
   "text": "دیگر در بعد از نمازها، در وقت‌های دیگر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 502.9,
   "end": 505.26,
   "text": "همیشه این دعا را داشته باشید که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 505.26,
   "end": 509.06,
   "text": "با ترس و حتماً این مسئله که ترسی دارد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 509.06,
   "end": 514.44,
   "text": "اونا که خوب می‌فهمن زیاد از این موضوع می‌ترسند که در مواقعی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 514.44,
   "end": 517.76,
   "text": "مواقع مخاطرات عقیدتی و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 517.76,
   "end": 525.16,
   "text": "فکری و باطنی‌ست که از موقع مرگ مخصوصاً شروع می‌شود ممکن است قبل از مرگ هم به سراغ کسی بیاد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 525.16,
   "end": 528.56,
   "text": "در دوران زندگی. خب خیلی‌ها هستند که در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 528.56,
   "end": 531.62,
   "text": "بعد زندگی‌شون عقایدشون را چی می‌کنند؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 531.62,
   "end": 535.46,
   "text": "از دست می‌دهند. عرض کنم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 535.46,
   "end": 538.64,
   "text": "اونا که می‌فهمن زیاد از این مسئله می‌ترسند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 538.64,
   "end": 543.58,
   "text": "لذا با تضرع اینجور دعاها را می‌خوان با تضرع.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 543.58,
   "end": 546.24,
   "text": "یعنی وقتی میگه که اما انش--",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 546.24,
   "end": 549.18,
   "text": "انشأتم من اصناف خلقت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 549.18,
   "end": 552.66,
   "text": "این آدمای خوب را می‌گویند. وقتی میگه خدایا من",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 552.66,
   "end": 556.68,
   "text": "تو را شاهد می‌گیرم، انبیا و رسل و ملائکه فلان و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 556.68,
   "end": 558.42,
   "text": "تمام خلقت را شاهد می‌گیرم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 558.42,
   "end": 563.8,
   "text": "اینا با یه حالتی میگن و کأن خطاب به در و دیوار هم می‌کنند که شاهد باشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 563.8,
   "end": 570.68,
   "text": "من شاهد باشید و از الان من میگم شاهد باشید که من موحدم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 570.68,
   "end": 574.44,
   "text": "اینو با درد مندی این را میگن و با ترس زیاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 574.44,
   "end": 577.58,
   "text": "یکی از مسائل بسیار اساسی‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 577.58,
   "end": 580.18,
   "text": "لذا یادتون باشد و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 580.18,
   "end": 582.84,
   "text": "گرچه وقت گذشت ولی من",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 582.84,
   "end": 587.68,
   "text": "آینده یک روایت از اون روایاتی که انتخاب کردم بعداً به همان مضمون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 587.68,
   "end": 594.36,
   "text": "برای شما بخوانم. این روایت البته دو سه تا من روایت انتخاب کرده بودم در هر کدام نکاتی در involved هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 594.36,
   "end": 599.62,
   "text": "من یکیشو می‌خوانم. روایت این است از تفسیر عیاشی نقل شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 599.62,
   "end": 602.0,
   "text": "این جلد شش بهار هست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 602.0,
   "end": 603.88,
   "text": "از تفسیر عیاشی نقل شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 603.88,
   "end": 606.0,
   "text": "جلد شش بهار جدید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 606.0,
   "end": 609.34,
   "text": "جلد جدید صفحه صد و هشتاد و هشت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 609.34,
   "end": 613.36,
   "text": "از تفسیر عیاشی نقل شده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 613.36,
   "end": 616.46,
   "text": "از امام صادق علیه السلام قال.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 616.46,
   "end": 619.14,
   "text": "امام صادق فرمود اونا چه می‌نویسند؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 619.14,
   "end": 622.16,
   "text": "اینجوری می‌نویسن إن الشيطان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 622.16,
   "end": 626.84,
   "text": "لیأتی الرجل من أولياءنا عند موته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 626.84,
   "end": 632.3,
   "text": "إن الشيطان لیأتی الرجل من أولياءنا عند موته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 632.3,
   "end": 637.02,
   "text": "اینکه از رجل گفت یعنی به سراغ انسان‌ها میان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 637.02,
   "end": 639.32,
   "text": "منظور این نیست که سراغ خانم، خانم میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 639.32,
   "end": 642.28,
   "text": "شیطان میاد به سراغ",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 642.28,
   "end": 645.68,
   "text": "مؤمنین از اولیاء ما عند موته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 645.68,
   "end": 651.44,
   "text": "یعنی اون وقتی که مرگش می‌رسیده در حالت اغماض.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 651.44,
   "end": 655.9,
   "text": "عن يمینه وعن يساره از راستش میاد، از چپش میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 655.9,
   "end": 661.08,
   "text": "یعنی با جنون و انواع مختلف و از راه‌های مختلف شیطان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 661.08,
   "end": 668.32,
   "text": "با جنودش. چون من دیگه ندارم توجیهات بیشتر میگم با استناد به روایات دیگر که درpart دیگر آمده است وگرنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 668.32,
   "end": 672.92,
   "text": "خود روایت سر بسته بود. از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 672.92,
   "end": 679.5,
   "text": "جوانب مختلف شیطان با جنودش میاد به سراغش که یصده عن ما هو عليه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 679.5,
   "end": 685.76,
   "text": "تا او را از اونچه که از اون عقایدی که دارد منعش کند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 685.76,
   "end": 689.04,
   "text": "فيأمن الله له ذلك.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 689.04,
   "end": 691.0,
   "text": "از اون عقایدش بازداره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 691.0,
   "end": 694.88,
   "text": "با توجه بر اونچه در روایات دیگر آمده است، صاف در روایات",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 694.88,
   "end": 699.52,
   "text": "دیگر آمده که او را تشکیک، کلمه تشکیک آمده به شک می‌اندازد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 699.52,
   "end": 702.74,
   "text": "یعنی القاءاتی می‌کند به ادوار مختلف از راست و چپ.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 702.74,
   "end": 706.34,
   "text": "حالا راست و چپ هم منظور راست و چپ ظاهری نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 706.34,
   "end": 709.94,
   "text": "حالا اون خودش تفسیر طولانی دارد که چیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 709.94,
   "end": 713.72,
   "text": "تشکیک می‌کند بالاخره عقایدش از دستش بگیره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 713.72,
   "end": 716.48,
   "text": "بعد فيأمن الله له ذلك.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 716.48,
   "end": 724.84,
   "text": "اونهایی که خدا و در خصوص البته این در خصوص کسانی‌ست که خدا نظر می‌کند و آنها را از این تشکیک‌ها چه می‌کنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 724.84,
   "end": 727.44,
   "text": "حفظ می‌کنه و به همه کس نمی‌شود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 727.44,
   "end": 731.42,
   "text": "فيأمن الله له ذلك. خدا او را حفظ می‌کند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 731.42,
   "end": 733.48,
   "text": "و کذا که قال الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 733.48,
   "end": 743.68,
   "text": "و اینجاست که خدا فرموده است که [سوره مبارکه هود آیه 112] این آیه قرآن است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 743.68,
   "end": 746.94,
   "text": "این را امام در اینجا که خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 746.94,
   "end": 750.32,
   "text": "در برابر تشکیک شیطان، خدا او را",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 750.32,
   "end": 754.96,
   "text": "حالا با الهام ملائکه، با هدایت‌های ملائکه، با",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 754.96,
   "end": 757.08,
   "text": "فرستادن ملائکه‌ای",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 757.08,
   "end": 760.98,
   "text": "شیاطین را رد می‌کنند، تشکیک‌شون را برطرف می‌کنند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 760.98,
   "end": 765.9,
   "text": "یا با حضور رسول اکرم صلی الله علیه و آله و سلم اگر خیلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 765.9,
   "end": 768.28,
   "text": "انسان مقامش بالا باشد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 768.28,
   "end": 772.54,
   "text": "یا حضرت امیرالمؤمنین علیه السلام خلاصه شیاطین از میدان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 772.54,
   "end": 779.4,
   "text": "میروند و اینها، اینها را باز گفتم من با استناد روایات دیگر میگم من اینجا نیستم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 779.4,
   "end": 783.82,
   "text": "خدا خلاصه یأولى الله الذالک این تشکیک را، این خطر را از او برطرف میکند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 783.82,
   "end": 786.94,
   "text": "بعد این آیه را خوند. امام این آیه را خوند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 786.94,
   "end": 795.82,
   "text": "[سوره مبارکه هود آیه 112] خدا ثابت نگه می‌دارد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 795.82,
   "end": 799.16,
   "text": "آن‌هایی را که ایمان آوردند و روی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 799.16,
   "end": 805.04,
   "text": "ایمان و گفته خودشان عملاً هم ثابت بودند در حیات دنیا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 805.04,
   "end": 809.02,
   "text": "و در آخرت. خدا آنها را چی میکنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 809.02,
   "end": 812.16,
   "text": "ثابت نگه می‌دارد. آن‌هایی را که،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 812.16,
   "end": 821.16,
   "text": "کدام‌ها را؟ اونایی که ایمان آوردند به قول ثابت و گفته خودشان یعنی بر اساس ایمان‌شون در دنیا عمل کردند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 821.16,
   "end": 824.66,
   "text": "خدا آنها را ثابت نگه می‌دارد هم در دنیا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 824.66,
   "end": 827.62,
   "text": "و هم در کجا؟ هم در آخرت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 827.62,
   "end": 832.9,
   "text": "خب این آیه اشاره میکنه که در آخرت یه موارد لغزشی هست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 832.9,
   "end": 839.38,
   "text": "و در دنیا هم موارد لغزشی هست که خدا کسانی را در این موارد لغزش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 839.38,
   "end": 841.5,
   "text": "چی میکنند؟ ثبت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 841.5,
   "end": 845.38,
   "text": "امام اینجا در اینجا میخواند که یکی از مواردش همین جاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 845.38,
   "end": 848.44,
   "text": "موقع مرگ شیطان تشکیک میکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 848.44,
   "end": 850.6,
   "text": "خدا کسانی را",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 850.6,
   "end": 853.3,
   "text": "حفظ. کسانی را حفظ میکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 853.3,
   "end": 858.72,
   "text": "اما کسانی که وقتی مخصوصاً این آیه را میخواند خیلی قضیه را سخت میکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 858.72,
   "end": 864.26,
   "text": "چه کسانی را حفظ میکنه؟ کسانی را که آمن و بالقول ثابت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 864.26,
   "end": 867.48,
   "text": "اگر بر اساس این آیه بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 867.48,
   "end": 871.14,
   "text": "و اما من دیگه روایات دیگر را نمیخوانم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 871.14,
   "end": 876.66,
   "text": "همین جلد شش صفحه صد و نود و پنج هم یک روایتی را از کافی نقل کرده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 876.66,
   "end": 890.82,
   "text": "[سوره مبارکه هود آیه 112] شیاطین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 890.82,
   "end": 896.36,
   "text": "وقتی تو کفر وامی‌دارند، تشکیک می‌کنند، به شک می‌اندازند تا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 896.36,
   "end": 898.64,
   "text": "جان و روحش خارج بشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 898.64,
   "end": 905.22,
   "text": "فمن کان مؤمناً لم یغر عليه اون‌ها که مؤمن هستند شیطان نمی‌تواند آنها را به شک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 905.22,
   "end": 908.14,
   "text": "بیاندازد. حالا به شک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 908.14,
   "end": 910.88,
   "text": "کس که مؤمن است نمی‌تواند آنها را به شک بیاندازد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 910.88,
   "end": 916.02,
   "text": "ببینم شما اگر به نهان و آشکار باجرا معنی بکنی چطور معنی می‌کنی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 214,
   "start": 916.02,
   "end": 922.16,
   "text": "خب این شک در خصوص تشکیک اصلاً در خصوص کافران بود، در خصوص کی بود؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 215,
   "start": 922.16,
   "end": 924.96,
   "text": ". پس چرا میگه من کار مؤمنن غالب میشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 216,
   "start": 924.96,
   "end": 930.84,
   "text": "یعنی چی؟ پس شیطان تشکیک میکنه، غالب کفر میکنه و تشکیک میکنه در دینش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 217,
   "start": 930.84,
   "end": 933.22,
   "text": "اما کسی که مؤمن است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 218,
   "start": 933.22,
   "end": 935.5,
   "text": "او زورش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 219,
   "start": 935.5,
   "end": 938.9,
   "text": "نمیرسه. این، این چجور نتیجه‌ش این میشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 220,
   "start": 938.9,
   "end": 941.82,
   "text": "نتیجه میگه این تشکیک در خصوص مؤمن‌هاست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 221,
   "start": 941.82,
   "end": 945.28,
   "text": "اما کسانی که مؤمن خوب هستند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 222,
   "start": 945.28,
   "end": 950.6,
   "text": "و این تشکیک در باب اونها به نتیجه‌ای که شیطان می‌خواهد نمی‌رسه ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 223,
   "start": 950.6,
   "end": 954.74,
   "text": "تحلیلی که گفتم. همون که گفت که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 224,
   "start": 954.74,
   "end": 962.8,
   "text": "اون آیه را خوندیم. پس از اون میگه فإذا حضر الموت حق وقتی احتضار نز-مرگ حق را حاضر شدی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 225,
   "start": 962.8,
   "end": 965.06,
   "text": "فلتغبطن مستحب است که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 226,
   "start": 965.06,
   "end": 968.18,
   "text": "وقتی احتضار سر بالایی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 227,
   "start": 968.18,
   "end": 972.1,
   "text": "بالای سر کسی که در حال احتضار است بودید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 228,
   "start": 972.1,
   "end": 975.52,
   "text": "ای تلقین کنید او را شهادتین را.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 229,
   "start": 975.52,
   "end": 977.6,
   "text": "این بر همه حساب است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 230,
   "start": 977.6,
   "end": 979.9,
   "text": "این در مقام تشکیک می‌کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 231,
   "start": 979.9,
   "end": 984.16,
   "text": "ما که نمی‌فهمیم در باطن هم او را شیطان دارد تشکیک می‌کند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 232,
   "start": 984.16,
   "end": 987.54,
   "text": "میگه شما از این طرف حیف چی بکنید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 233,
   "start": 987.54,
   "end": 995.34,
   "text": "تلقین بکنید که لا اله الا الله محمدا رسول الله که تلقین خودش در جای خود در این چنین جایی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 234,
   "start": 995.34,
   "end": 1000.02,
   "text": "اگر طرف صلاحیتش را داشته باشد، آمادگی داشته باشد اثر خودش را",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 235,
   "start": 1000.02,
   "end": 1006.96,
   "text": "میگذارد. میگه فإذا حضر الموت حق فلتغبطن شهادت أن لا اله الا الله و ان محمدا رسول الله حتی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 236,
   "start": 1006.96,
   "end": 1012.46,
   "text": "که حتی جانش از بدنش خارج بشه این تلقین‌ها را.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 237,
   "start": 1012.46,
   "end": 1017.94,
   "text": "این صفحه صد و نود و پنج بود که روایتش رو نخوندم با تنظیم و تصحیح",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 238,
   "start": 1017.94,
   "end": 1023.76,
   "text": "که بعداً گفتم نگاه بکنید برای ادامه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 239,
   "start": 1023.76,
   "end": 1027.18,
   "text": "خلاصه این توصیه را به شما می‌کنم ان شاءالله که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 240,
   "start": 1027.18,
   "end": 1031.12,
   "text": "هم بترسید و هم چنین دعایی داشته باشید و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 241,
   "start": 1031.12,
   "end": 1034.3,
   "text": "خلاصه سختی‌ها و مسائل خیلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 242,
   "start": 1034.3,
   "end": 1036.54,
   "text": "زیاد است. ان شاءالله خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 243,
   "start": 1036.54,
   "end": 1039.88,
   "text": "ما و شما را از آنها برهانه بکند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 244,
   "start": 1039.88,
   "end": 1042.5,
   "text": "توفیق عمل را داشته باشیم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 245,
   "start": 1042.5,
   "end": 1046.28,
   "text": "که مضمون همین روایات خدا به سراغمون بیاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 246,
   "start": 1046.28,
   "end": 1048.82,
   "text": "اون دعاها رو هم بکنیم. اللهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 247,
   "start": 1048.82,
   "end": 1051.68,
   "text": "تو را شاهد می‌گیرم چی، چی دعا هم بکنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 248,
   "start": 1051.68,
   "end": 1056.4,
   "text": "ولی عمل هم داشته باشید خدا دستمون رو در اون مواقع خطرناک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 249,
   "start": 1056.4,
   "end": 1061.1,
   "text": "بگیرد. دعا با تضرع خدا را شاهد گرفتن، خدایا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 250,
   "start": 1061.1,
   "end": 1064.6,
   "text": "یعنی خدا به کمکم بیا در اون مواقع",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 251,
   "start": 1064.6,
   "end": 1066.76,
   "text": "و امری را شاهد گرفتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 252,
   "start": 1066.76,
   "end": 1070.12,
   "text": "این جور چیزها مسلماً حساب داره.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 253,
   "start": 1070.12,
   "end": 1074.44,
   "text": "اما این هم حساب دارد که انسان اهل عمل هست یا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 254,
   "start": 1074.44,
   "end": 1077.22,
   "text": "نیست. چون الان گفتم گفت که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 255,
   "start": 1077.22,
   "end": 1080.92,
   "text": "میاد تشکیک میکنه اما کسی که مؤمن هست رو غالب نمیشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 256,
   "start": 1080.92,
   "end": 1085.6,
   "text": "مؤمن هست یعنی چیه؟ تشکیک از اساس برای مؤمنان بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 257,
   "start": 1085.6,
   "end": 1088.44,
   "text": "یعنی مؤمن به معنی کلمه است، عامل است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 258,
   "start": 1088.44,
   "end": 1091.8,
   "text": "در اون روایت اول گفت که امام گفت که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 259,
   "start": 1091.8,
   "end": 1094.72,
   "text": "میاد اما خدا نمیذاره او را تشکیک بکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 260,
   "start": 1094.72,
   "end": 1101.64,
   "text": "بعد کدوم آیه را خوند؟ آیه [سوره مبارکه هود آیه 112] را خوند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 261,
   "start": 1101.64,
   "end": 1109.78,
   "text": "یعنی اینجا هم صاف اشاره میکنه که اگر خدای خطرناک کسی برطرف کنه کسانی هستند که به فضای ایمان‌شون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 262,
   "start": 1109.78,
   "end": 1114.88,
   "text": "عمل کردند. پس بنابراین هم باید در عمل سعی کرد از این خطر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 263,
   "start": 1114.88,
   "end": 1119.92,
   "text": "محفوظ بود و هم اون دعا را با تضرع داشت. هر دو لازم و ضروری است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}