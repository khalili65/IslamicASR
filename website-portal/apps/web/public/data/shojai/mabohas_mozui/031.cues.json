 },
 "chapters": [],
 "cues": [
  {
   "i": 0,
   "start": 0.92,
   "end": 4.02,
   "text": "اعوذ بالله من الشيطان الرجيم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 4.02,
   "end": 6.28,
   "text": "بسم الله الرحمن الرحيم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 6.28,
   "end": 14.14,
   "text": "حقیقتی که از عقاید قرآن هست و قرآن در دهها آیات مختلف با صراحت و اشاره،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 14.14,
   "end": 16.58,
   "text": "اشاره می‌کنه. دلایل بسیار،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 16.58,
   "end": 21.44,
   "text": "متاسفانه با آن که در دهها آیات آمده است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 21.44,
   "end": 24.72,
   "text": "با این وصف بر اون توجه،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 24.72,
   "end": 28.64,
   "text": "چندان توجه قرار نگرفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 28.64,
   "end": 32.7,
   "text": "اون این است که قرآن با صراحت خیلی،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 32.7,
   "end": 36.7,
   "text": "در آیات با صراحت، در بعضی از آیات با اشاره",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 36.7,
   "end": 39.96,
   "text": "این حقیقت را گوشزد می‌کنه که شما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 39.96,
   "end": 43.98,
   "text": "انسان‌ها توجه داشته باشید که در یک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 43.98,
   "end": 48.46,
   "text": "غشاو و پرده و حجاب سختی قرار گرفته‌اید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 48.46,
   "end": 53.32,
   "text": "دور و بر شما پر است، نمی‌دانید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 53.32,
   "end": 56.8,
   "text": "این را زیاد می‌خواهد بگوید، انسان‌ها گوشزد کند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 56.8,
   "end": 61.9,
   "text": "این حقیقت را. که در سرت کشال،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 61.9,
   "end": 64.76,
   "text": "در دهها آیات با صراحت",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 64.76,
   "end": 73.16,
   "text": "و اشاره این حقیقت را گوشزد می‌کند که شما انسان‌ها در یک حجابی قرار گرفته‌اید، مشiar باشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 73.16,
   "end": 79.48,
   "text": "در یک پرده‌ای. دور بر شما پر است و نمی‌بینید و نمی‌دانید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 79.48,
   "end": 81.76,
   "text": "در سوره تکاثر چه می‌فرماید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 81.76,
   "end": 83.8,
   "text": "اعوذ بالله من الشيطان الرجيم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 83.8,
   "end": 86.44,
   "text": "بسم الله الرحمن الرحيم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 86.44,
   "end": 89.8,
   "text": "أَلْهَاكُمُ التَّكَاثُرُ حَتَّى زُرْتُمُ الْمَقَابِرَ.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 89.8,
   "end": 92.28,
   "text": "سوره هم گوشزد می‌دهد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 92.28,
   "end": 98.66,
   "text": "این که زیاد دنیا را به دست بیارید، این شما را از آنچه دور و بر شما را گرفته است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 98.66,
   "end": 104.06,
   "text": "و پر است، کاملاً غافل کرده است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 104.06,
   "end": 106.08,
   "text": "أَلْهَاكُم، أَلْهَى",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 106.08,
   "end": 115.18,
   "text": "معنی غافل کردن است. کسی را از چیزی، انسان چیزی کسی را غافل کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 115.18,
   "end": 117.52,
   "text": "از یک حقیقتی غافل کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 117.52,
   "end": 119.5,
   "text": "اینجا کلمه أَلْهَى به کار رفته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 119.5,
   "end": 123.44,
   "text": "أَلْهَاكُم یعنی شما را غافل کرده است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 123.44,
   "end": 125.2,
   "text": "غافل در آورده است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 125.2,
   "end": 127.6,
   "text": "چه چیز؟ تکاثر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 127.6,
   "end": 130.94,
   "text": "این که با تمام وجود روح دنیا آورده که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 130.94,
   "end": 135.52,
   "text": "زیاد به دست بیاورد با تمام وجود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 135.52,
   "end": 138.04,
   "text": "دنیا را البته فقط پول حساب نکنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 138.04,
   "end": 142.56,
   "text": "دنیا یعنی غیر خدا. هرچه هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 142.56,
   "end": 151.1,
   "text": "پول باشد، منزل باشد، ریاست باشد، شهرت باشد، جمال باشد، کمال باشد، هر از معنی و معنایی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 151.1,
   "end": 154.18,
   "text": "هنر باشد، شهرت باشد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 154.18,
   "end": 157.66,
   "text": "هر چیزی، هر راحتی باشد، لذت باشد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 157.66,
   "end": 162.82,
   "text": "خوابیدن باشد، خوردن باشد، هر چیزی غیر خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 162.82,
   "end": 171.88,
   "text": "می‌گوید این روح آوردن با تمام وجود شما به غیر خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 171.88,
   "end": 175.88,
   "text": "به نحوی که کلاً فانی شده‌اید در غیر خدا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 175.88,
   "end": 180.46,
   "text": "شما را از آنچه دور و بر شما پر است کاملاً غافل کرده است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 180.46,
   "end": 187.48,
   "text": "این یک حقیقت است. و می‌فرماید این ادامه دارد تا شما وارد قبر شوید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 187.48,
   "end": 193.84,
   "text": "این جوری گرفته است. حَتَّى زُرْتُمُ الْمَقَابِرَ.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 193.84,
   "end": 198.58,
   "text": "ببینید و بشر این آیه و این نکته",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 198.58,
   "end": 201.48,
   "text": "که وقتی انسان فانی شد چیزی را نمی‌داند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 201.48,
   "end": 203.8,
   "text": "من یکی دو مثال ساده به شما بگویم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 203.8,
   "end": 207.52,
   "text": "انسان از لحاظ درک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 207.52,
   "end": 210.46,
   "text": "اینطور است. اگر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 210.46,
   "end": 217.9,
   "text": "با تمام وجود به یک نقطه متوجه باشد، متمرکز شود به یک نقطه با تمام وجود،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 217.9,
   "end": 222.16,
   "text": "از نقطه‌های دیگر و از مسائل دیگر معمولاً چیست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 222.16,
   "end": 225.7,
   "text": "غافل است. اگر این توجه و تمرکز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 225.7,
   "end": 233.04,
   "text": "به صورت فنا دربیاید، یعنی انسان فانی شود، اصلاً یک گسست کامل شود، همان کلمه فنا تعبیر می‌کنند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 233.04,
   "end": 236.44,
   "text": "فانی شود در آن نقطه‌ای که متمرکز شده است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 236.44,
   "end": 241.52,
   "text": "اگر فانی شود از وجودش چیزی خارج از اون نقطه باقی نماند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 241.52,
   "end": 250.68,
   "text": "چشمش، گوشش، تمام مشاعر ظاهرش، مشاعر باطنش، فکرش، عقلش، تهذيبش، فهمش، همه دیگه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 250.68,
   "end": 255.16,
   "text": "همه اگر به یک نقطه محو شود می‌شود فنای چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 255.16,
   "end": 262.2,
   "text": "فنای کلی. و ما نسبت به دنیا نمی‌دانم هیچ یک از ما چنین هستیم یا نیستیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 262.2,
   "end": 264.58,
   "text": "دقیقاً اینطور است. یعنی چشم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 264.58,
   "end": 272.54,
   "text": "گوش، لامسه، چامه، مشاعر ظاهر کلاً فکر، عقل، فهم، قیاس،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 272.54,
   "end": 275.88,
   "text": "همه، همه در اثر غیر خداست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 275.88,
   "end": 277.5,
   "text": "در در دنیا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 277.5,
   "end": 281.56,
   "text": "این همان تکاثر است که زیاد دنیا را به دست بیاوریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 281.56,
   "end": 283.96,
   "text": "می‌گویم دنیا را به معنی وسیع بگیرید و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 283.96,
   "end": 291.52,
   "text": "فقط مواظبت بکنید که مانند بعضی‌ها محدود معنی نکنید که اون وقت نمی‌گذارد انسان حقیقتی را که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 291.52,
   "end": 295.54,
   "text": "قرآن می‌خواهد ارائه بفرماید خوب بفهمد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 295.54,
   "end": 302.46,
   "text": "دنیا یعنی غیر خداست. شما ملاحظه بکنید ما شبانه روز یک بررسی برای خودمان بکنیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 302.46,
   "end": 309.38,
   "text": "بررسی برای خودمان. ببینید که کلاً مشاعر شما در بیست و چهار ساعت در چه چیز محو است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 309.38,
   "end": 313.4,
   "text": "که لحظه‌ای نمی‌شود از اون آرام باشید و از اون کنار بکشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 313.4,
   "end": 322.04,
   "text": "نیست اصلاً چنین لحظه‌ای. کل مشاعر از ظاهر و باطن خواهی چیزی که غیر خداست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 322.04,
   "end": 323.88,
   "text": "و به همین دلیل هم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 323.88,
   "end": 328.26,
   "text": "قبلاً گفتم به همین دلیل هم هرچه سعی می‌کنیم یه لحظه در نماز دوست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 328.26,
   "end": 332.74,
   "text": "خدا متوجه باشید، این فانی شدن ما را نمی‌گذارد، باز می‌گردد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 332.74,
   "end": 339.92,
   "text": "فانی هستیم. می‌فرماید شما فانی شده‌اید، نمی‌فهمید و نمی‌دانید و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 339.92,
   "end": 347.74,
   "text": "دور بر شما پر است از آنچه شما نمی‌بینید بر اثر فنا در دنیا و نمی‌شنوید و نمی‌دانید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 347.74,
   "end": 356.3,
   "text": "أَلْهَاكُمُ التَّكَاثُرُ. فانی در دنیا هستیم از آنچه دور بر ماست کلاً غافل و بی‌خبریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 356.3,
   "end": 360.22,
   "text": "ولی خدا همه جا آگاه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 360.22,
   "end": 364.54,
   "text": "باز یه مثال بگم شما اگر چشمتون، الآن این تمام مشاعر بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 364.54,
   "end": 372.88,
   "text": "اگر شما دقت کردید، اگر مثلاً دیگه رفتید یک نقطه‌ای فقط از طریق چشم سخت متمرکز بشوید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 372.88,
   "end": 379.06,
   "text": "اینجا گوش شما می‌شنود معمولا می‌شنود، می‌فهمد اطرافیان چه صحبت می‌کنند یا نمی‌فهمد چه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 379.06,
   "end": 384.0,
   "text": "صحبت می‌کنند؟ اگر خیلی خوب از طریق چشم به یک نقطه متمرکز شده‌ای،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 384.0,
   "end": 386.64,
   "text": "می‌فهمی چه صحبت می‌کنند؟ برای این‌که مثل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 386.64,
   "end": 393.78,
   "text": "فانی هستی به اندازه‌ای که از طریق چشم فانی می‌شوی اگر با تمام وجود بشود ببین چی می‌شود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 393.78,
   "end": 401.9,
   "text": "چون از طریق چشم به یک نقطه سخت متمرکز شده‌ای خواهی فانی شده آن هم فقط از یک وجه که از طریق باصره است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 401.9,
   "end": 405.3,
   "text": "دیگه گوش شما نمی‌شنود یا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 405.3,
   "end": 409.9,
   "text": "نمی‌شنود، اصلا نمی‌فهمد چی میگن یا حتی صدا را انسان چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 409.9,
   "end": 412.58,
   "text": "نمی‌شنود. خب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 412.58,
   "end": 419.06,
   "text": "ببینید چه جالب. بعضیا مثلا در خیالات غوطه‌ورند مثلا از کوچه خیابان گذر می‌کند ولی چون در یک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 419.06,
   "end": 426.18,
   "text": "فکر حالا این از طریق فنای فکری است سر یک مسئله زیاد غوطه‌ور می‌شن من فکر می‌کند این فنای فکری است در چشم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 426.18,
   "end": 430.52,
   "text": "می‌بینید که آشنا و دوست و اینا میاد و می‌گذرد ولی این شخص چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 430.52,
   "end": 434.66,
   "text": "متوجه نمی‌شه. اینجا از طریق فکر متمرکز است به یک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 434.66,
   "end": 438.14,
   "text": "مسئله غوطه‌ور است در حدی فانی‌ست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 438.14,
   "end": 439.94,
   "text": "دیگه چشمش کار نمی‌کند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 439.94,
   "end": 441.58,
   "text": "دوستش رو می‌آورد نمی‌شناسد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 441.58,
   "end": 444.9,
   "text": "پدرش رو می‌بیند در رهگذر رو به رویش رو نمی‌شناسد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 444.9,
   "end": 447.88,
   "text": "برادر را می‌بیند نمی‌شناسد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 447.88,
   "end": 452.22,
   "text": "این خاصیت فناست. خوب دقت کنید خوب بفرمایید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 452.22,
   "end": 454.32,
   "text": "خاصیت فنا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 454.32,
   "end": 459.62,
   "text": "یعنی فانی شدن در یک نقطه و در یک چیز یا چند چیز.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 459.62,
   "end": 463.1,
   "text": "خاصیت فنا این است که انسان از چیزهای دیگر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 463.1,
   "end": 470.4,
   "text": "غافل می‌شود. اون وقت اضافه بکنید برای اینکه هرچه فنا کامل‌تر باشد این غفلت چی خواهد شد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 470.4,
   "end": 475.92,
   "text": "کامل‌تر خواهد شد. ما اگر با تمام وجود فانی بشویم در غیر خدا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 475.92,
   "end": 481.4,
   "text": "که هستیم با تمام وجود یعنی از مشاعر ما چیزی نیست که به غیر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 481.4,
   "end": 483.94,
   "text": "به سمت خدا متوجه شود. همه متوجه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 483.94,
   "end": 486.12,
   "text": "غیر خداست. تو اینطور هستی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 486.12,
   "end": 491.14,
   "text": "اگر اینطور بود دیگه ما هرکی در اطراف ما در وجود ما باشد بی‌خبریم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 491.14,
   "end": 494.68,
   "text": "ولو همه‌جا پر از صداها باشد نمی‌شنویم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 494.68,
   "end": 497.22,
   "text": "همه‌جا پر از دیدنی‌ها باشد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 497.22,
   "end": 502.66,
   "text": "نمی‌بینیم. همه‌جا پر از حقایق باشد که هست نمی‌دانیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 502.66,
   "end": 507.22,
   "text": "این آیه می‌فرماید «الحاکم التکاسل» دور بر شما پر است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 507.22,
   "end": 513.2,
   "text": "یعنی زیاد دنیا را به دست آوردن که با تمام وجود فانی شده‌ای، با اون توهمی که گفتم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 513.2,
   "end": 515.64,
   "text": "شما را مشغول کرده است، غافل کرده است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 515.64,
   "end": 522.08,
   "text": "«فتازقتم المقابر» و این غفلت شما ادامه دارد تا جایی که وارد چه می‌شوید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 522.08,
   "end": 526.24,
   "text": "وارد قبرها می‌شوید. بعد ادامه اش چی می‌فرماید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 526.24,
   "end": 529.22,
   "text": "«الله صفت علمو» ولی این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 529.22,
   "end": 534.22,
   "text": "فانی بودن و غافل بودن بالاخره تا وقتی که وارد قبر می‌شوید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 534.22,
   "end": 537.08,
   "text": "به زودی می‌دانید که چه بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 537.08,
   "end": 540.42,
   "text": "بعد لحن آله اجس این تکان در میاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 540.42,
   "end": 546.7,
   "text": "غافل شدید به زودی می‌دانید چه بوده که شما را نیافته‌ای.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 546.7,
   "end": 549.44,
   "text": "این یکی از حقایق قرآن است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 549.44,
   "end": 551.16,
   "text": "نمی‌دانم خوب فهمیدید یا نه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 551.16,
   "end": 553.78,
   "text": "حالا من در اینجا برای اینکه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 553.78,
   "end": 560.66,
   "text": "باز از این دهها آیاتی که گفتم با اشاره و با صراحت به این حقیقت اشاره می‌کند،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 560.66,
   "end": 563.54,
   "text": "هم اینقدر شما بدانید که دهها آیه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 563.54,
   "end": 567.62,
   "text": "یه ندا در می‌داد که نمی‌دانید، نمی‌دانید، نمی‌دانید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 567.62,
   "end": 572.54,
   "text": "اطراف پر است. نمی‌شنوید، نمی‌بینید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 572.54,
   "end": 574.28,
   "text": "عوالم است دور بر شما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 574.28,
   "end": 579.82,
   "text": "صداهاست، دیدنی‌هاست، ملائکه است، موجودات است، بهشت است، جهنم است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 579.82,
   "end": 583.2,
   "text": "می‌بینید؟ توحید است، اله است،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 583.2,
   "end": 585.2,
   "text": "خداست. همه چیزو می‌بینید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 585.2,
   "end": 594.36,
   "text": "نمی‌دانید، نمی‌بینید. من آیاتی می‌خوانم که فقط از باب نمونه است از اون دهها آیه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 594.36,
   "end": 603.62,
   "text": "ببینید یکی آیه چند مورد می‌خوانم فقط برای اینکه شما بدانید که این حقیقت را قرآن چطور به ما گوشزد می‌کند و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 603.62,
   "end": 609.22,
   "text": "خیلی گوشزد می‌دهد. اون آیه تکاثر را که آیات تکاثر را خوندم «الحاکم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 609.22,
   "end": 614.16,
   "text": "التکاسل» تا آخری فرمود شما را زیاد دنیا را خواستن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 614.16,
   "end": 616.56,
   "text": "«فتازقتم المقابر» تا به",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 616.56,
   "end": 619.16,
   "text": "قبر رسیدید. «الله» اینطور نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 619.16,
   "end": 624.44,
   "text": "«صفت علمو» به زودی می‌دانید «ثم الله صفت علمو».",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 624.44,
   "end": 627.3,
   "text": "این آیه. مورد دیگر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 627.3,
   "end": 630.32,
   "text": "سوره نجم آیه بیست و نه و سی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 630.32,
   "end": 635.34,
   "text": "«فأعرض عن من تولى عن ذكرنا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 635.34,
   "end": 638.14,
   "text": "ولم يرد إلا الحياة الدنيا»",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 638.14,
   "end": 641.46,
   "text": "این آیه بیست و نه هست از سوره نجم است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 641.46,
   "end": 644.98,
   "text": "آیه سی بعدش هست که فقط یک جمله‌ش من آوردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 644.98,
   "end": 647.68,
   "text": "«ذلك مبلغهم من العلم»",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 647.68,
   "end": 651.34,
   "text": "به رسول الله صلوات الله علیه می‌فرماید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 651.34,
   "end": 656.68,
   "text": "اونایی که از یاد ما غافلن از اون‌ها روی گردان باش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 656.68,
   "end": 659.96,
   "text": "رو به گردان از اون‌ها که از یاد ما غافلن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 659.96,
   "end": 666.12,
   "text": "حالا اگر این آیه را همان صراحت ظاهرش را بگیریم که ما هم شامل می‌شویم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 666.12,
   "end": 675.38,
   "text": "شما باید یعنی اگر این خطاب معنی عموم، عمومش باشد «فأعرض عن من تولى عن ذكرنا» آنکه از یاد ما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 675.38,
   "end": 682.42,
   "text": "رو گردان شده است از او تو رو بگردان ای رسول «ولم يرد إلا الحياة الدنيا»",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 682.42,
   "end": 684.9,
   "text": "اونی که از یاد ما غافل است و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 684.9,
   "end": 687.22,
   "text": "جز دنیا را نمی‌خواهد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 687.22,
   "end": 689.96,
   "text": "از اون‌ها دور باش، روی بگردان از رسول الله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 689.96,
   "end": 695.0,
   "text": "بعد می‌فرماید چی؟ شاهد بر اون جمله بعدی چی در آیه بعدی می‌آید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 695.0,
   "end": 699.28,
   "text": "می‌فرماید اینا فقط دنیا را رو آورده‌اند دنیا را",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 699.28,
   "end": 702.56,
   "text": "«ذلك مبلغهم من العلم» رسول الله می‌گوید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 702.56,
   "end": 705.8,
   "text": "حدود علمی‌ها همین است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 705.8,
   "end": 711.02,
   "text": "دقت کردید؟ حدود درک و ادراک، ادراکی و درکی‌شون همین است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 711.02,
   "end": 714.06,
   "text": "بذار باشد. «مبلغهم من العلم» خیلی تکاندهنده‌ست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 714.06,
   "end": 717.68,
   "text": "«ذلك مبلغهم من العلم» نمی‌بینند اینها نمی‌شنوند اینها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 717.68,
   "end": 722.0,
   "text": "دلشون بسته. «ذلك مبلغهم من العلم»",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 722.0,
   "end": 724.66,
   "text": "این یک اشاره است. اطراف پر است از این‌ها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 724.66,
   "end": 729.74,
   "text": "جز اونچه که فانی در اون هستند که دنیا باشد دیگه چیزی از اطراف او چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 729.74,
   "end": 731.44,
   "text": "این چون فانی است نمی‌بیند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 731.44,
   "end": 735.84,
   "text": "این یک آیه. آیه ای در حرف سوره روم است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 735.84,
   "end": 738.84,
   "text": "این آیه را من قبلاً به تناسب",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 738.84,
   "end": 741.24,
   "text": "یا به تناسب هایی برای شما تلاوت کردم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 741.24,
   "end": 744.86,
   "text": "در این زمینه باز از اون دفا آیات است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 744.86,
   "end": 748.24,
   "text": "یعلمون ظاهراً من الحياة الدنيا اینا فقط",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 748.24,
   "end": 750.4,
   "text": "از دنیا چیزی می خواهند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 750.4,
   "end": 752.54,
   "text": "و هم عن الآخرة",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 752.54,
   "end": 757.9,
   "text": "هم غافلند. همین مردم از آخرت همین ها غافل هستند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 757.9,
   "end": 761.38,
   "text": "این فرموده که اطراف تون پر است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 761.38,
   "end": 766.42,
   "text": "پنهان شدن در ظاهر دنیا شما را از آنچه در اطراف شما هست چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 766.42,
   "end": 777.24,
   "text": "غافل کرده است. آیه شصت و چهار عنکبوت و ما آتي الحياة الدنيا إلا لهو ولعب به بازیچه گرفتار شده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 777.24,
   "end": 780.6,
   "text": "id. إن دار الآخرة لهي الحيوان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 780.6,
   "end": 788.42,
   "text": "اطراف شما اصل حیات است و پر است و دار آخرت از دور و بر شما را پوش کرده است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 788.42,
   "end": 794.48,
   "text": "اینجور است لو کانوا يعلمون اگر اینها می دانستند، اگر می دانستند،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 794.48,
   "end": 799.24,
   "text": "این لنگ چیه؟ میگه دنیا لهو ولعب بازیچه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 799.24,
   "end": 802.68,
   "text": "دار آخرت حیوانی است و دار حیات است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 802.68,
   "end": 806.86,
   "text": "اما چی؟ چه فایده؟ لو کانوا يعلمون اگر چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 806.86,
   "end": 809.5,
   "text": "اگر می دانستند. اینها اشاره است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 809.5,
   "end": 813.36,
   "text": "اگر می دانستند، نمی دانستند، نمی بینند و نمی شنوند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 813.36,
   "end": 815.88,
   "text": "آیه ای دیگر در مورد جهاد است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 815.88,
   "end": 818.1,
   "text": "یعنی اینکه اینها همه اشاره است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 818.1,
   "end": 820.1,
   "text": "هر، هر جای تفسیر طولانی دارد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 820.1,
   "end": 822.26,
   "text": "فقط من اشاراتشو می خوانم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 822.26,
   "end": 824.42,
   "text": "در شریعت توبه می فرماید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 824.42,
   "end": 829.78,
   "text": "اهتفا و صدام و جاهدوا بأموالکم أنفسکم في سبيل الله",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 829.78,
   "end": 833.3,
   "text": "سباق غير سباق به جهاد بروید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 833.3,
   "end": 835.58,
   "text": "و در راه خدا جهاد کنید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 835.58,
   "end": 839.44,
   "text": "و معطل نشوید. ذلك خير لكم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 839.44,
   "end": 842.38,
   "text": "به خیر شماست این كنتم تعلمون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 842.38,
   "end": 845.76,
   "text": "اما به شرطی که چی؟ به شرطی که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 845.76,
   "end": 852.44,
   "text": "بدانید. از این آیات این كنتم تعلمون لو كانوا يعلمون و لکن لا تعلمون.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 852.44,
   "end": 854.86,
   "text": "این تغییرات در آیات کوره است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 854.86,
   "end": 861.0,
   "text": "یک آیه از این می تواند که دور و بر ما پر است و ما در دغدغه و در حجاب و غشاوة",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 861.0,
   "end": 863.76,
   "text": "سختی هستیم. سوره تکاثر را خواندم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 863.76,
   "end": 867.82,
   "text": "اصل مقصودم از بیان این آیات یک نکته بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 867.82,
   "end": 869.88,
   "text": "یک نکته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 869.88,
   "end": 878.4,
   "text": "آن اینکه این غشاوة و پرده ای که دور بر ما را پوشانده است که از تنهای مادی دنیا سرچشمه می گیرد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 878.4,
   "end": 886.92,
   "text": "این پرده و حجاب ببینیم با چه صورتی می شود و با چه طریقی از چه راهی می شود از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 886.92,
   "end": 890.48,
   "text": "چنا از به اصطلاح",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 890.48,
   "end": 892.8,
   "text": "رو به روی ما از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 892.8,
   "end": 895.02,
   "text": "مقابل ادراک ما،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 895.02,
   "end": 899.14,
   "text": "شنید ما، دید ما، فکر ما، عقل ما برطرف شود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 899.14,
   "end": 902.08,
   "text": "این راه برطرف شدن هم دارد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 902.08,
   "end": 904.58,
   "text": "یا ندارد؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 904.58,
   "end": 906.98,
   "text": "این حجاب برای همیشه هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 906.98,
   "end": 909.84,
   "text": "اون آیه گفت الحاکم تکاثر حتی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 909.84,
   "end": 913.72,
   "text": "زرتم المدار. بر اساس رویه ای که هست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 913.72,
   "end": 917.02,
   "text": "تا ما در این دنیا کارهای ها وارد شده ایم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 917.02,
   "end": 921.92,
   "text": "این ادامه دارد. اما بعد فرمود کلا صحبت علمون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 214,
   "start": 921.92,
   "end": 924.72,
   "text": "نه به زودی خواهید دانست. باز فرمود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 215,
   "start": 924.72,
   "end": 927.84,
   "text": "ثم کلا صحبت یعنی با مردن خواهید دانست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 216,
   "start": 927.84,
   "end": 930.38,
   "text": "بعدش می فرماید کلا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 217,
   "start": 930.38,
   "end": 932.78,
   "text": "لو تعلمون علم اليقين",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 218,
   "start": 932.78,
   "end": 935.36,
   "text": "لترمون الجنة. این آیه آشناست به شما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 219,
   "start": 935.36,
   "end": 937.62,
   "text": "مثلا من در تفسیرش می خواهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 220,
   "start": 937.62,
   "end": 942.64,
   "text": "یه نکته هایی که نشنیده ای به شما",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 221,
   "start": 942.64,
   "end": 946.2,
   "text": "بگویم. می فرماید این دنیا شما را مشغول کرده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 222,
   "start": 946.2,
   "end": 951.98,
   "text": "به زودی می دانید. ثم کلا صحبت علمون که به زودی با مرگ می دانید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 223,
   "start": 951.98,
   "end": 954.76,
   "text": "بعد فرمود کلا اینطور نیست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 224,
   "start": 954.76,
   "end": 958.46,
   "text": "فقط باید منتظر مرگ بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 225,
   "start": 958.46,
   "end": 967.02,
   "text": "کلا لو تعلمون علم اليقين اگر شما به اون مجاهدتی را شروع بکنید به مرحله یقین برسید،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 226,
   "start": 967.02,
   "end": 969.26,
   "text": "همینجا این پرده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 227,
   "start": 969.26,
   "end": 972.52,
   "text": "از برابر شما رفع میشود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 228,
   "start": 972.52,
   "end": 977.16,
   "text": "و شما آنچه دور بر شما هست و پر است اونها را چی میکنی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 229,
   "start": 977.16,
   "end": 984.3,
   "text": "می دانید. فلو تعلمون علم اليقين لترمون الجنة.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 230,
   "start": 984.3,
   "end": 988.96,
   "text": "جهنم را. حالا جهنم یکی از حقایقی است که دور و بر ما را پوشانده است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 231,
   "start": 988.96,
   "end": 994.9,
   "text": "چون ما جهنم دیده نیستیم، در اینجا فقط جهنم را ذکر کرده است ما ببینیم و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 232,
   "start": 994.9,
   "end": 999.32,
   "text": "روحیه بشود. و الا حقایق فقط در جهنم خلاصه نمیشود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 233,
   "start": 999.32,
   "end": 1001.28,
   "text": "بهشت در اطراف ما پر است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 234,
   "start": 1001.28,
   "end": 1003.34,
   "text": "برزخ اطراف ما پر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 235,
   "start": 1003.34,
   "end": 1007.16,
   "text": "است. بعضی از آنها با ما هستند و میگویند و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 236,
   "start": 1007.16,
   "end": 1009.86,
   "text": "حتی صدا میکنند و نمی شنویم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 237,
   "start": 1009.86,
   "end": 1013.44,
   "text": "پر است از ملائکه اطراف هستند،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 238,
   "start": 1013.44,
   "end": 1016.36,
   "text": "صحبت می کنند و کلام دارند و مکالمه دارند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 239,
   "start": 1016.36,
   "end": 1020.16,
   "text": "نمی شنویم. ندای خدا را نمی شنویم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 240,
   "start": 1020.16,
   "end": 1022.84,
   "text": "عوالم ملکوت را اعلی‌ و اسفل پر است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 241,
   "start": 1022.84,
   "end": 1025.36,
   "text": "اطراف ما پر است. ما نمی شنویم، نمی بینیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 242,
   "start": 1025.36,
   "end": 1027.1,
   "text": "در حجابی هستیم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 243,
   "start": 1027.1,
   "end": 1031.14,
   "text": "یکی جهنم است. می فرماید اگر به مرحله یقین برسید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 244,
   "start": 1031.14,
   "end": 1033.1,
   "text": "لترمون الجنة جهنم را",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 245,
   "start": 1033.1,
   "end": 1036.68,
   "text": "نمی بینید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 246,
   "start": 1036.68,
   "end": 1039.26,
   "text": "اینطور است این حجاب برای همیشه باشد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 247,
   "start": 1039.26,
   "end": 1043.08,
   "text": "می شود برطرف شود ولی با نیل به یقین،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 248,
   "start": 1043.08,
   "end": 1047.78,
   "text": "با نیل به یقین. می دانم شما در این زیارت نامه هایی که می خوانید،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 249,
   "start": 1047.78,
   "end": 1053.6,
   "text": "در جمله های زیارت نامه ها یا در بعضی از عباراتی که در دعاها آمده است،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 250,
   "start": 1053.6,
   "end": 1058.74,
   "text": "دقت کرده اید که دقت کرده اید که راه رسیدن به یقین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 251,
   "start": 1058.74,
   "end": 1062.74,
   "text": "چه چیزی است؟ می توانم بگویم که چه چیزی است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 252,
   "start": 1062.74,
   "end": 1067.06,
   "text": "این جمله را دیده اید در دعاها و در زیارت ها که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 253,
   "start": 1067.06,
   "end": 1072.82,
   "text": "و مجاهده که مثلا خطاب می کند به حضرات معصومین",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 254,
   "start": 1072.82,
   "end": 1080.22,
   "text": "که شما مجاهدت کردید الا الجهاد حتی الموت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 255,
   "start": 1080.22,
   "end": 1082.26,
   "text": "به مرحله یقین انسان رسید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 256,
   "start": 1082.26,
   "end": 1085.66,
   "text": "از طریق مجاهدت است این پرده کنار میرود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 257,
   "start": 1085.66,
   "end": 1087.54,
   "text": "این یک باب است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 258,
   "start": 1087.54,
   "end": 1090.86,
   "text": "یک باب دیگر که منظور من این است که انسان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 259,
   "start": 1090.86,
   "end": 1097.64,
   "text": "اگر با مجاهدت، با قدم مجاهدت، قدم در طریق گذاشت، پیش رفت، به یقین رسید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 260,
   "start": 1097.64,
   "end": 1100.46,
   "text": "در مرحله یقین انسان به محبت میرسد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 261,
   "start": 1100.46,
   "end": 1110.68,
   "text": "محبت یعنی خدا محبت خود را در دل انسان جایگزین میکند که از این مسئله از یقینش و از محبتش ー من شما فقط",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 262,
   "start": 1110.68,
   "end": 1112.44,
   "text": "اسمش را شنیده اید این بحث است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 263,
   "start": 1112.44,
   "end": 1119.6,
   "text": "سلام. به مقام محبت رسید انسان آن وقت است که اصل این پرده ها",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 264,
   "start": 1119.6,
   "end": 1122.84,
   "text": "و اصل این غشاوة ها و حجاب ها کنار برود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}