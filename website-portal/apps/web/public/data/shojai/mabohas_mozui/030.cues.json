{
 "version": 1,
 "sessionId": "030",
 "lang": "fa",
 "source": "raw",
 "duration": 1035.5,
 "alignment": {
  "exact": 2154,
  "total": 2154,
  "ratio": 1.0,
  "maxGapSeconds": 0.0,
  "p95GapSeconds": 0.0,
  "driftFraction": 0.0
 },
 "chapters": [],
 "cues": [
  {
   "i": 0,
   "start": 1.32,
   "end": 4.42,
   "text": "اعوذ بالله السميع العليم من الشيطان الرجيم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 1,
   "start": 4.42,
   "end": 6.56,
   "text": "بسم الله الرحمن الرحيم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 2,
   "start": 6.56,
   "end": 8.94,
   "text": "یکی نماز شب می‌خواند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 3,
   "start": 8.94,
   "end": 13.24,
   "text": "نماز شبش در یک شب عوالمی طی می‌کند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 4,
   "start": 13.24,
   "end": 16.5,
   "text": "فردا غیر از اونست که دیروز بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 5,
   "start": 16.5,
   "end": 21.14,
   "text": "یکی هم مانند من و شما، مانند اگر باشد، اگر درست باشد این حرفم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 6,
   "start": 21.14,
   "end": 23.68,
   "text": "مانند شما من البته اینش ندارم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 7,
   "start": 23.68,
   "end": 26.96,
   "text": "یکی مانند شما انشاالله مانند شما هم باز",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 8,
   "start": 26.96,
   "end": 29.72,
   "text": "ملعون شما می‌تونه باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 9,
   "start": 29.72,
   "end": 39.28,
   "text": "عرض کنم که یکی هم مانند شما نماز شب می‌خواند، هی می‌خواند ولی تمام هست که.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 10,
   "start": 39.28,
   "end": 42.84,
   "text": "چرا؟ این رابطه‌ش خوب نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 11,
   "start": 42.84,
   "end": 44.78,
   "text": "رابطه نوری‌ش خوب نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 12,
   "start": 44.78,
   "end": 48.78,
   "text": "ارتباط قلبی‌ش خوب نیست. اون یک رابطه دارد، ارتباط قلبی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 13,
   "start": 48.78,
   "end": 56.26,
   "text": "blandt Menschen ها که ارتباط درونی و قلبی بین انسان و خدای متعال را",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 14,
   "start": 56.26,
   "end": 58.78,
   "text": "خراب می‌کند. اصلا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 15,
   "start": 58.78,
   "end": 61.2,
   "text": "این رابطه از او گرفته می‌شود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 16,
   "start": 61.2,
   "end": 67.96,
   "text": "صریح روایات هست هم در مِصباح الشریعه و هم در روایات دیگر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 17,
   "start": 67.96,
   "end": 69.94,
   "text": "مسئله چیست؟ مسئله طمع.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 18,
   "start": 69.94,
   "end": 76.1,
   "text": "طمع می‌دانید یعنی چی؟ یعنی انسان در اونچه که دست مردم هست،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 19,
   "start": 76.1,
   "end": 79.94,
   "text": "در اون، در اونها چشم داشته باشد، نظر داشته باشد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 20,
   "start": 79.94,
   "end": 83.02,
   "text": "طمع که می‌گیم این امر قلبی است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 21,
   "start": 83.02,
   "end": 91.54,
   "text": "امر قلبی یعنی انسان چشم طمع دوخته باشد به آنچه که در دست این و اون هست از متاع دنیا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 22,
   "start": 91.54,
   "end": 99.14,
   "text": "از مالش، از ریاستش، از زرگش، از برگش، از ماشینش، از منزلش، از فرشش، از سنمش،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 23,
   "start": 99.14,
   "end": 103.4,
   "text": "از پولش، از لباسش، از طلاش، از هر نظفه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 24,
   "start": 103.4,
   "end": 107.34,
   "text": "دیگر. چشم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 25,
   "start": 107.34,
   "end": 111.08,
   "text": "طمع داشته در آنچه که در دست مردم است،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 26,
   "start": 111.08,
   "end": 114.42,
   "text": "ایمان رفت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 27,
   "start": 114.42,
   "end": 119.26,
   "text": "خب توضیح من به شما این است که با این مسئله در وجود خودتون مقابله بکنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 28,
   "start": 119.26,
   "end": 123.12,
   "text": "سعی کنید که طمع را از خودتون،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 29,
   "start": 123.12,
   "end": 127.96,
   "text": "چشم طمع داشتن به آنچه در دست مردم است از خودتون دور کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 30,
   "start": 127.96,
   "end": 133.24,
   "text": "آزاد باشید. این رشت را قطع بکنید در خاطر خودتان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 31,
   "start": 133.24,
   "end": 136.68,
   "text": "چشم طمع نداشته باشید و الا اون رابطه نوری",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 32,
   "start": 136.68,
   "end": 140.32,
   "text": "از میان می‌رود. حالا برای اینکه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 33,
   "start": 140.32,
   "end": 142.9,
   "text": "خوب بفهمید این روایت را،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 34,
   "start": 142.9,
   "end": 146.88,
   "text": "روایت خیلی مختصر برای شما می‌خوانم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 35,
   "start": 146.88,
   "end": 149.68,
   "text": "روایت در اصول کافی، جلد دوم، صفحه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 36,
   "start": 149.68,
   "end": 152.58,
   "text": "سیصد و بیست، باب طمع.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 37,
   "start": 152.58,
   "end": 159.7,
   "text": "از امام سؤال کردند چیز که ایمان را در بنده، یعنی در وجود بنده، در دل بنده، اون رابطه نوری را",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 38,
   "start": 159.7,
   "end": 164.02,
   "text": "تثبیت می‌کند. قال امام گفت البرء.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 39,
   "start": 164.02,
   "end": 167.32,
   "text": "برء مقابل طمع. برء مقابل طمع.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 40,
   "start": 167.32,
   "end": 169.76,
   "text": "حالا حرف ما در جمله بعدی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 41,
   "start": 169.76,
   "end": 172.14,
   "text": "است. والذي يخرجهم منه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 42,
   "start": 172.14,
   "end": 175.26,
   "text": "راوی می‌گه من سؤال کردم، گفت از امام سؤال کردم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 43,
   "start": 175.26,
   "end": 179.08,
   "text": "حالا چه چیز انسان را از ایمان خارج می‌کند؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 44,
   "start": 179.08,
   "end": 181.14,
   "text": "از ایمان خارج می‌کند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 45,
   "start": 181.14,
   "end": 184.48,
   "text": "یعنی اون رابطه را چه می‌کند؟ خراب می‌کند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 46,
   "start": 184.48,
   "end": 190.54,
   "text": "قال الطمع. الطمع.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 47,
   "start": 190.54,
   "end": 195.12,
   "text": "آزادی نصاب. آزاد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 48,
   "start": 195.12,
   "end": 200.26,
   "text": "انسان آزاد باشد از هر طمعی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 49,
   "start": 200.26,
   "end": 204.26,
   "text": "غلام متاعانم که زیر چرخ کبود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 50,
   "start": 204.26,
   "end": 207.84,
   "text": "ز هر چه رنگ تعلق پذیرد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 51,
   "start": 207.84,
   "end": 210.92,
   "text": "آزادم. این عِمد می‌خواد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 52,
   "start": 210.92,
   "end": 215.44,
   "text": "عِمد چرخ می‌خواد و عِمد می‌خواد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 53,
   "start": 215.44,
   "end": 218.42,
   "text": "انسان حتی در بین بعضی از",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 54,
   "start": 218.42,
   "end": 225.76,
   "text": "علما، اخلاق و عرفا و بزرگان هست که این‌ها می‌گن که نباید انسان وقتی بیرون می‌رود و منزل بعضی از مثلاً",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 55,
   "start": 225.76,
   "end": 228.56,
   "text": "ارباب ثروت و اینها می‌رود",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 56,
   "start": 228.56,
   "end": 235.04,
   "text": "مثلاً اگر گذرش افتاد یا بیرون، این‌ها نه کردن، میگن نگاه هم نکن همین طور بی‌هوا،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 57,
   "start": 235.04,
   "end": 237.98,
   "text": "بی‌ یعنی بی‌توجه. اصلا گفتن نگاه نباید کرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 58,
   "start": 237.98,
   "end": 242.48,
   "text": "اینقدر باید دله تو ناب بود. دستور هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 59,
   "start": 242.48,
   "end": 245.44,
   "text": "دستور هست و باید هم بکنید. یعنی وقتی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 60,
   "start": 245.44,
   "end": 249.46,
   "text": "زرد و برگ دنیا را می‌بینند می‌گه که باید نگاه هم اون بی‌",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 61,
   "start": 249.46,
   "end": 253.64,
   "text": "حساب نگاه. نه نگاه طمع. می‌گه اصلا نگاه نکن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 62,
   "start": 253.64,
   "end": 256.22,
   "text": "از این طرف. اینجور.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 63,
   "start": 256.22,
   "end": 260.56,
   "text": "این دل اینجور آزاد است که نور خدا می‌تابد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 64,
   "start": 260.56,
   "end": 262.5,
   "text": "رشت تربیت می‌شود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 65,
   "start": 262.5,
   "end": 266.14,
   "text": "جذبه‌ها پیش می‌آید و پیش می‌آید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 66,
   "start": 266.14,
   "end": 269.94,
   "text": "اگر دل پر از طمع شد ترش خودت را بکشی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 67,
   "start": 269.94,
   "end": 274.26,
   "text": "رفتی به همونی که طمع داری اونجا رو فلانی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 68,
   "start": 274.26,
   "end": 278.02,
   "text": "خب بعدش؟ بعدش چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 69,
   "start": 278.02,
   "end": 280.44,
   "text": "می‌خواهی موفق بشوی در عبودیت؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 70,
   "start": 280.44,
   "end": 283.62,
   "text": "بسم الله. این یکی از تدبرهای لازم،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 71,
   "start": 283.62,
   "end": 286.42,
   "text": "اون طرفش یکی از مخاطرات طریق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 72,
   "start": 286.42,
   "end": 290.76,
   "text": "سلوک عبودیت است. این یک بیان بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 73,
   "start": 290.76,
   "end": 293.44,
   "text": "یک جمله هم از بیان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 74,
   "start": 293.44,
   "end": 298.54,
   "text": "امام صادق سلام الله علیه در مصباح الشریعه در باب طمع",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 75,
   "start": 298.54,
   "end": 303.74,
   "text": "که امام صادق سلام الله علیه مطالبی که در باب طمع می‌فرماید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 76,
   "start": 303.74,
   "end": 310.0,
   "text": "و در وسط از امیرالمؤمنین سلام الله علیه چیزی نقل می‌کند، مطالبی نقل می‌کند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 77,
   "start": 310.0,
   "end": 313.42,
   "text": "یک جمله از بیان حضرت امیر این است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 78,
   "start": 313.42,
   "end": 315.06,
   "text": "و طامع في الخلق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 79,
   "start": 315.06,
   "end": 318.9,
   "text": "اینا خوب دقت کنید. و طامع في الخلق.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 80,
   "start": 318.9,
   "end": 322.3,
   "text": "جمله‌ایست ها. منزوع عنه الإيمان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 81,
   "start": 322.3,
   "end": 329.58,
   "text": "منزوع يعني چنانکه سواد عربی دارند اونی که طمع دارد در آنچه که در دست مردم است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 82,
   "start": 329.58,
   "end": 332.48,
   "text": "این طامع منزوع عنه الإيمان.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 83,
   "start": 332.48,
   "end": 334.62,
   "text": "ایمان از او گرفته شده،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 84,
   "start": 334.62,
   "end": 338.24,
   "text": "رفته. دقت می‌کنید؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 85,
   "start": 338.24,
   "end": 343.42,
   "text": "و هو لا يشعر. این لا يشعرش ربط به من است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 86,
   "start": 343.42,
   "end": 347.22,
   "text": "دقت کنید. این لا يشعرش خیلی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 87,
   "start": 347.22,
   "end": 349.9,
   "text": "امثال بنده ها مترجم می‌گویند که چی می‌گه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 88,
   "start": 349.9,
   "end": 354.92,
   "text": "می‌گه خودش نمی‌فهمد. فکر می‌کند ایمانش هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 89,
   "start": 354.92,
   "end": 357.8,
   "text": "و هو لا يشعر. و طامع.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 90,
   "start": 357.8,
   "end": 360.12,
   "text": "بیان امام هست. گفتم امام بیان است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 91,
   "start": 360.12,
   "end": 364.27,
   "text": "و طامع في الخلق منزوع عنه الإيمان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 92,
   "start": 364.27,
   "end": 367.21,
   "text": "اونی که طمع دارد در دست اینها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 93,
   "start": 367.21,
   "end": 369.23,
   "text": "این خانم‌ها رو مخصوصا من توصیه می‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 94,
   "start": 369.23,
   "end": 372.27,
   "text": "خانم‌ها رو مخصوصا توصیه می‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 95,
   "start": 372.27,
   "end": 375.59,
   "text": "ننگ آن باشد که این خانم این طلا را دارد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 96,
   "start": 375.59,
   "end": 379.29,
   "text": "آن خانم آن زندگی. ننگ است اینها برای بنده خدا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 97,
   "start": 379.29,
   "end": 381.21,
   "text": "من اصلاً می‌خوام فریاد بکشم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 98,
   "start": 381.21,
   "end": 383.15,
   "text": "چیه ایمان با اینها جمع میشه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 99,
   "start": 383.15,
   "end": 388.19,
   "text": "ننگه. غریبت و انسانیت و فضیلت‌تون در",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 100,
   "start": 388.19,
   "end": 392.85,
   "text": "فقر است. فقر یعنی نداشتن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 101,
   "start": 392.85,
   "end": 399.65,
   "text": "دقت کنید چون خیری از مؤمنین ندارند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 102,
   "start": 399.65,
   "end": 402.15,
   "text": "پس چشم طمع نبند به این چیزها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 103,
   "start": 402.15,
   "end": 404.71,
   "text": "ردیها فخر نده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 104,
   "start": 404.71,
   "end": 407.15,
   "text": "کفش‌ها را بیرون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 105,
   "start": 407.15,
   "end": 409.61,
   "text": "و اول این نعل و کلاه رو بذار دست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 106,
   "start": 409.61,
   "end": 413.05,
   "text": "خودت. می‌فهمی کجا آمدی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 107,
   "start": 413.05,
   "end": 417.47,
   "text": "اول نعلین را در بیار، بر بیا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 108,
   "start": 417.47,
   "end": 422.23,
   "text": "دقت کنید. خیلی به شما توصیه می‌کنم این جور چیزها، خطاهات رو بذارید کنار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 109,
   "start": 422.23,
   "end": 424.39,
   "text": "دقت کنید. و لا یشبع.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 110,
   "start": 424.39,
   "end": 426.91,
   "text": "ایمان رخصه نمی‌داند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 111,
   "start": 426.91,
   "end": 431.65,
   "text": "و ان الايمان يهدى بين العبد و بين الطمع في القلب.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 112,
   "start": 431.65,
   "end": 436.87,
   "text": "امام تمام اگر ایمان باشد، ایمان نمی‌گذارد انسان طمع داشته باشد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 113,
   "start": 436.87,
   "end": 438.63,
   "text": "در آنچه که در دست معلوم است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 114,
   "start": 438.63,
   "end": 442.91,
   "text": "اگر حالا ما فکر کردیم ایمان داریم فکر ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 115,
   "start": 442.91,
   "end": 445.37,
   "text": "فکر ماست. آیه که خوندم این بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 116,
   "start": 445.37,
   "end": 450.37,
   "text": "ظاهرش رسول الله هست. اما این خطاب رسول الله سرایت می‌کنه به من و شما.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 117,
   "start": 450.37,
   "end": 453.43,
   "text": "رسول الله صلی الله علیه و آله که معلوم است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 118,
   "start": 453.43,
   "end": 459.29,
   "text": "میگه لا تمدن عينيك الى ما متعنا به ازواجا منهم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 119,
   "start": 459.29,
   "end": 462.33,
   "text": "زهرة الحياة الدنيا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 120,
   "start": 462.33,
   "end": 465.59,
   "text": "حالا خطاب بودن ظاهرش به رسول الله صَلَّى الله عَلَيْهِ وَسَلَّمَ خیلی خطابه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 121,
   "start": 465.59,
   "end": 468.37,
   "text": "ولی این مسیر از خطاب به چی متوجهه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 122,
   "start": 468.37,
   "end": 470.99,
   "text": "به ما متوجهه. مسیر هست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 123,
   "start": 470.99,
   "end": 477.17,
   "text": "میگه لا تمدن عينيك الى ما متعنا به ازواجا منهم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 124,
   "start": 477.17,
   "end": 479.03,
   "text": "چشم طمع نبند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 125,
   "start": 479.03,
   "end": 481.57,
   "text": "به آنچه که در دست اینها می‌بینی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 126,
   "start": 481.57,
   "end": 485.99,
   "text": "زهرة الحياة الدنيا از این جنبه‌های حیات دنیا و متاع دنیا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 127,
   "start": 485.99,
   "end": 491.35,
   "text": "لنختبرهم به. اینی هم که به اینها دادیم این‌ها وسیله آزمایش است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 128,
   "start": 491.35,
   "end": 495.15,
   "text": "موقتی داده این‌ها چیکار می‌کنند؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 129,
   "start": 495.15,
   "end": 499.47,
   "text": "چرا فکر نوازهاشون هست و رزق و روزی که خیر و منت God",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 130,
   "start": 499.47,
   "end": 503.09,
   "text": "متوجه خدا باش. رزق را از خدا بخواه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 131,
   "start": 503.09,
   "end": 506.29,
   "text": "مقام خود را بخواه. حیات ابدی را بخواه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 132,
   "start": 506.29,
   "end": 509.45,
   "text": "حالا این خطاب رسول الله ظاهر به من و شماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 133,
   "start": 509.45,
   "end": 514.19,
   "text": "چی گفت؟ لا تمدن عينيك چشم طمع نبند به آنچه که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 134,
   "start": 514.19,
   "end": 521.49,
   "text": "از زهرای حیات دنیا می‌بینی در دست اینه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 135,
   "start": 521.49,
   "end": 529.21,
   "text": "خب این آیه بعد از اینی که گفتم اون شخص میگه بزنتی یکی از اصحاب امام رضا سلام الله علیه بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 136,
   "start": 529.21,
   "end": 532.53,
   "text": "بزنتی نام. اسمش یادتون باشه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 137,
   "start": 532.53,
   "end": 534.79,
   "text": "روایت هم روایت صحیح.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 138,
   "start": 534.79,
   "end": 539.65,
   "text": "میگه که من به امام رضا سلام الله علیه گفتم بزنتی مرد بزرگی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 139,
   "start": 539.65,
   "end": 542.61,
   "text": "اصلاً چی بوده؟ گرفتار شدید بوده مرد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 140,
   "start": 542.61,
   "end": 544.83,
   "text": "اونجور نبوده که الان مثلاً گفتم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 141,
   "start": 544.83,
   "end": 548.27,
   "text": "این گفتنش در یه بار مانند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 142,
   "start": 548.27,
   "end": 552.25,
   "text": "همیشه کار ما بود. و الا مرد بزرگی بود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 143,
   "start": 552.25,
   "end": 556.31,
   "text": "بزنتی حالا هیچی از این گرفتار شدید بوده گفتن که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 144,
   "start": 556.31,
   "end": 559.69,
   "text": "به امام رضا گفتن شما چیزی توصیه می‌کنید بنویسم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 145,
   "start": 559.69,
   "end": 563.51,
   "text": "من ببرم به نزد اسماعیلی بن داوود طائفی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 146,
   "start": 563.51,
   "end": 569.05,
   "text": "که با یک چیزی منظور دست اونام برسه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 147,
   "start": 569.05,
   "end": 571.07,
   "text": "بعد امام گفت که محرم بوده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 148,
   "start": 571.07,
   "end": 577.27,
   "text": "فذل. باز داد. یعنی نه گفتم نیاز من حیفم میاد که این کار را بکنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 149,
   "start": 577.27,
   "end": 581.31,
   "text": "حیف نیست. این کار بری از او درخواست بکنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 150,
   "start": 581.31,
   "end": 584.87,
   "text": "من بنویسم بری از او درخواست دنیا بکنی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 151,
   "start": 584.87,
   "end": 591.97,
   "text": "حیف نیست. خب اگر گرفتار داره از مال من هرچی می‌خواهی بردار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 152,
   "start": 591.97,
   "end": 594.49,
   "text": "از مال خود امام رضا. مشکل داری؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 153,
   "start": 594.49,
   "end": 596.69,
   "text": "اسمش فذل، فذل على ماله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 154,
   "start": 596.69,
   "end": 599.25,
   "text": "از مال من. امام از مال خودش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 155,
   "start": 599.25,
   "end": 605.33,
   "text": "تو هرچی گرفتار مشکلی داری حیف نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 156,
   "start": 605.33,
   "end": 610.73,
   "text": "طمع اینجور است. برای سالک طریق وجودیت طمع نباید باشد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 157,
   "start": 610.73,
   "end": 617.15,
   "text": "بود اصلاً رشته ارتباطش با اون توصیه‌ای که برای شما گفتم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 158,
   "start": 617.15,
   "end": 619.75,
   "text": "اونچنان می‌شود که توضیح دادم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 159,
   "start": 619.75,
   "end": 623.13,
   "text": "نه تنها حالا دیگه بقیه‌ش رو غیر به این جمع بگم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 160,
   "start": 623.13,
   "end": 627.19,
   "text": "نه تنها باید در درونش طمع نباشد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 161,
   "start": 627.19,
   "end": 629.93,
   "text": "وظیفه‌اش سنگین‌تر است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 162,
   "start": 629.93,
   "end": 632.55,
   "text": "بقیه‌ش رو دیگه گوش‌ها می‌زنیم. وظیفه ش سنگین‌تر.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 163,
   "start": 632.55,
   "end": 634.59,
   "text": "اولا در باطنش باید طمع نباشد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 164,
   "start": 634.59,
   "end": 637.79,
   "text": "باید باطن خودش از طمع پاک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 165,
   "start": 637.79,
   "end": 640.27,
   "text": "شود تا ایمانش در اون ثابت بماند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 166,
   "start": 640.27,
   "end": 643.25,
   "text": "اول این است. سالک از این سنگین‌تر بر می‌آید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 167,
   "start": 643.25,
   "end": 646.95,
   "text": "نه تنها باطنا طمع باید نداشته باشد،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 168,
   "start": 646.95,
   "end": 649.99,
   "text": "باید سعی کند که ظاهراً هم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 169,
   "start": 649.99,
   "end": 656.03,
   "text": "اون استغنا کند. یعنی ظاهراً هم رفتارش اوری باشد که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 170,
   "start": 656.03,
   "end": 662.63,
   "text": "ظهور رفتارش در این باشد که به هیچی اعتنا نمی‌کند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 171,
   "start": 662.63,
   "end": 665.51,
   "text": "دقت کنید. یعنی باطنا که بی اعتناست، بی‌طمع است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 172,
   "start": 665.51,
   "end": 669.21,
   "text": "در ظاهر هم باید ظهور داشته باشد این کارش",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 173,
   "start": 669.21,
   "end": 671.97,
   "text": "و عکسش ظهور نکند از او.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 174,
   "start": 671.97,
   "end": 675.07,
   "text": "دقت کنید. عکسش ظهور نکند",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 175,
   "start": 675.07,
   "end": 681.95,
   "text": "و عرض کنم که اون عزت یعنی اینها تعبیر به اون عزت ایمانه، عزت رو.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 176,
   "start": 681.95,
   "end": 684.81,
   "text": "اون عزتش باید ظهور بکنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 177,
   "start": 684.81,
   "end": 687.35,
   "text": "یعنی در اینها طمع ندارد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 178,
   "start": 687.35,
   "end": 695.23,
   "text": "اگر خب زمینه‌های پیش آمد و نواقص پیش آمد و زمینه‌های مختلف در هر زمینه‌ای قدم به قدم باید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 179,
   "start": 695.23,
   "end": 699.19,
   "text": "اظهار بکند که به هیچی چیه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 180,
   "start": 699.19,
   "end": 702.67,
   "text": "طمع ندارد. استغنا نشان بدهد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 181,
   "start": 702.67,
   "end": 704.87,
   "text": "استغنا غیر از گناست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 182,
   "start": 704.87,
   "end": 709.87,
   "text": "استغنا چیه؟ اون قسم طمع که در دلش هست که گناه است",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 183,
   "start": 709.87,
   "end": 714.55,
   "text": "و رذل و گناه است، اون را در ظاهر هم که می‌کنه سالک طریق توحید باید چه بکنه؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 184,
   "start": 714.55,
   "end": 717.45,
   "text": "اون رو معلوم هم بکنه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 185,
   "start": 717.45,
   "end": 720.15,
   "text": "و عزت خودش را باید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 186,
   "start": 720.15,
   "end": 722.63,
   "text": "روشن بکند، معلوم بکند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 187,
   "start": 722.63,
   "end": 726.19,
   "text": "اینجا به این روایت توجه کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 188,
   "start": 726.19,
   "end": 732.36,
   "text": "روایت عجیبی است. حالا این اسما علنی گذاشته شده.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 189,
   "start": 732.36,
   "end": 736.7,
   "text": "اسما که الان در American برای این دو آدم استفاده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 190,
   "start": 736.7,
   "end": 740.12,
   "text": "شده. برای اولیش یه روایت، روایت بسیار خلاصه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 191,
   "start": 740.12,
   "end": 743.34,
   "text": "اصول کافی، جلد دوم، صفحه صد و چهل و هشت.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 192,
   "start": 743.34,
   "end": 745.5,
   "text": "باب استغنا. باب استغنا.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 193,
   "start": 745.5,
   "end": 749.66,
   "text": "استغنا از مردم. با سند از امام صادق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 194,
   "start": 749.66,
   "end": 753.78,
   "text": "علیه السلام فرمود شرف المومن قیام الليل",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 195,
   "start": 753.78,
   "end": 755.82,
   "text": "و عزه استغناه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 196,
   "start": 755.82,
   "end": 759.38,
   "text": "عن الناس. شرف مؤمن چیست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 197,
   "start": 759.38,
   "end": 761.6,
   "text": "شرف قیام لیل است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 198,
   "start": 761.6,
   "end": 767.3,
   "text": "اونی که شب، شب زنده دار است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 199,
   "start": 767.3,
   "end": 770.64,
   "text": "نشرا ماست. قبل از شما شرف ماست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 200,
   "start": 770.64,
   "end": 773.36,
   "text": "برای این وسط حالا من جمله بعدی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 201,
   "start": 773.36,
   "end": 776.02,
   "text": "و جمله بعدی شاهد عرض ماست",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 202,
   "start": 776.02,
   "end": 779.26,
   "text": "و عزه و عزت مؤمن چیست؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 203,
   "start": 779.26,
   "end": 781.14,
   "text": "استغناه عن الناس.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 204,
   "start": 781.14,
   "end": 786.52,
   "text": "که خودش را کاملاً همه که ندارد، کمی نشان داده از،",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 205,
   "start": 786.52,
   "end": 788.78,
   "text": "از مردم. این عزت مؤمن است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 206,
   "start": 788.78,
   "end": 793.28,
   "text": "وللّه العزه و لرسوله و",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 207,
   "start": 793.28,
   "end": 796.82,
   "text": "للمؤمنین. شرف و عزت انسان",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 208,
   "start": 796.82,
   "end": 800.46,
   "text": "چیه؟ مخصوصاً اینم بگم براتون",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 209,
   "start": 800.46,
   "end": 806.62,
   "text": "از اون جروزی که در عبودیت بسیار به سرعت انسان را پیش می‌برد حفظ عزت است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 210,
   "start": 806.62,
   "end": 810.44,
   "text": "اگر کسی خواست رمز را بفهمد این هم یادداشت کند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 211,
   "start": 810.44,
   "end": 814.5,
   "text": "هر قدر عزت خودتان را حفظ کنید به سرعت پیش خواهید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 212,
   "start": 814.5,
   "end": 817.04,
   "text": "رفت. دم در جیب. مجرد از نفق",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 213,
   "start": 817.04,
   "end": 819.62,
   "text": "اهل امکان و از و از چیزها.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 214,
   "start": 819.62,
   "end": 822.22,
   "text": "هر قدر عزت را حفظ کردید",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 215,
   "start": 822.22,
   "end": 825.26,
   "text": "به سرعت به خدا نزدیک خواهید شد.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 216,
   "start": 825.26,
   "end": 828.86,
   "text": "ولعزه استغناء عنه. برای این وسط در خصوص",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 217,
   "start": 828.86,
   "end": 831.42,
   "text": "نماز شب هم می‌خواستم به شما بگم",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 218,
   "start": 831.42,
   "end": 841.02,
   "text": "مواظبت کنید. شیطانی در وجود من و شما هست که شیطان به اصطلاح شیطان مخصوصی است که ایغا",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 219,
   "start": 841.02,
   "end": 846.6,
   "text": "و سستی می‌کنه به انسان. خصوصیتی داره که کارش ایغا و سستی است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 220,
   "start": 846.6,
   "end": 851.14,
   "text": "سستی نکنید. زهرها گوش دهید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 221,
   "start": 851.14,
   "end": 854.9,
   "text": "گره تاره خودتان را در پیش است به یاد بیارید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 222,
   "start": 854.9,
   "end": 856.64,
   "text": "مرگ را به یاد بیارید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 223,
   "start": 856.64,
   "end": 858.84,
   "text": "حاجت به خداست به یاد بیارید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 224,
   "start": 858.84,
   "end": 862.68,
   "text": "در پیش است فراموش نکنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 225,
   "start": 862.68,
   "end": 865.24,
   "text": "سستی را به خودتان راه ندهید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 226,
   "start": 865.24,
   "end": 868.08,
   "text": "شب لااقل مقداری با خدا باشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 227,
   "start": 868.08,
   "end": 873.34,
   "text": "همشو نخوابید. سستی نکنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 228,
   "start": 873.34,
   "end": 879.06,
   "text": "یا برای دنیا با هول و هوس شب لااقل نماز شب را نخوانید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 229,
   "start": 879.06,
   "end": 881.26,
   "text": "سستی نکنید. پس سلام سستی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 230,
   "start": 881.26,
   "end": 885.98,
   "text": "حالا من سستی میگم. اگر توهین به ما انجام بده که باب دیگر",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 231,
   "start": 885.98,
   "end": 890.56,
   "text": "است. توهین به ما نشد وسط نماز شب نمیشود.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 232,
   "start": 890.56,
   "end": 896.26,
   "text": "سستی نکنید. ایام گره تاره در پیش است به نظر بیارید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 233,
   "start": 896.26,
   "end": 898.8,
   "text": "اگر جوان هستید معلول",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 234,
   "start": 898.8,
   "end": 902.72,
   "text": "دوران جوانی سلامت جوانی نباشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 235,
   "start": 902.72,
   "end": 906.22,
   "text": "از جوانی بالاترید یا پایین‌ترید معلول نباشید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 236,
   "start": 906.22,
   "end": 911.66,
   "text": "گره تاره و شست و شو و استاده جوی و پینچاله جوی هسته ای سر راه است.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 237,
   "start": 911.66,
   "end": 916.62,
   "text": "دقت بکنید. شب بلند شوید نماز شب بخوانید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 238,
   "start": 916.62,
   "end": 919.88,
   "text": "لیث بن شیعه نامند در سال صد و هفده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 239,
   "start": 919.88,
   "end": 924.04,
   "text": "فرمودند کسی که نماز شب نخواند شیعه نیست.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 240,
   "start": 924.04,
   "end": 927.84,
   "text": "دقت کنید. حالا اون در نماز شب صحبت نمی‌کردند.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 241,
   "start": 927.84,
   "end": 930.28,
   "text": "فقط می‌خواستم این رو مطرح بکنم که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 242,
   "start": 930.28,
   "end": 936.22,
   "text": "اونی که ایغا و سستی می‌کنه، می‌دونی کارتون زیاد سخته، میاد یه دهم و دوسته‌های",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 243,
   "start": 936.22,
   "end": 941.18,
   "text": "موهمل از اینور و اونور نمی‌خواد شما رو بگذاره شیطان با این روح وارد میشه",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 244,
   "start": 941.18,
   "end": 943.34,
   "text": "و انسان را سست می‌کنه.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 245,
   "start": 943.34,
   "end": 946.58,
   "text": "بعد انسان حالا این شب نخوانم بعداً انشاالله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 246,
   "start": 946.58,
   "end": 948.32,
   "text": "حالا این شب نشد بعداً انشاالله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 247,
   "start": 948.32,
   "end": 950.4,
   "text": "این شب نشد بعداً انشاالله.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 248,
   "start": 950.4,
   "end": 955.82,
   "text": "همان سوء گفتن است که می‌دونی که وقتی از این بعدش نیامده",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 249,
   "start": 955.82,
   "end": 961.28,
   "text": "قبل از اون بعد یاد انسان رفت به بعد این احوال.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 250,
   "start": 961.28,
   "end": 968.1,
   "text": "عزه استغناء. عزت را، سخن اصلی خودم را بگم، عزت را حفظ کنید.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 251,
   "start": 968.1,
   "end": 970.56,
   "text": "امیر، دیگه این رو باید بگم حالا تموم می‌کنم.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 252,
   "start": 970.56,
   "end": 974.4,
   "text": "امیرالمؤمنین علیه السلام فرمود که",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 253,
   "start": 974.4,
   "end": 978.32,
   "text": "در برخورد با مؤمنی",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 254,
   "start": 978.32,
   "end": 982.58,
   "text": "برخورد باید برخورد با امن، مضمون بیانش این",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 255,
   "start": 982.58,
   "end": 987.32,
   "text": "است. برخورد باید با حرمت، احترام و شاشک",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 256,
   "start": 987.32,
   "end": 993.64,
   "text": "و ادب و دلسوزی باشد که همه مؤمن وقتی برخورد",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 257,
   "start": 993.64,
   "end": 999.32,
   "text": "می‌کنه با بشاشت و حرمت و ادب و احترام و آنچه هست آراسته.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 258,
   "start": 999.32,
   "end": 1005.74,
   "text": "ولی این غیر از این است که در برابر کسی خشوع و خضوع بکنی برای چی؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 259,
   "start": 1005.74,
   "end": 1011.76,
   "text": "برای دنیا. از اون جهت عزت خودت را فرمود چه بکن؟",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 260,
   "start": 1011.76,
   "end": 1015.48,
   "text": "حفظ کن. حرمت افراد را نگه دار.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 261,
   "start": 1015.48,
   "end": 1019.14,
   "text": "ادب را نگه دار. با بشاشت روبرو باش.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 262,
   "start": 1019.14,
   "end": 1021.2,
   "text": "خضوع باش. با لین کلام.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 263,
   "start": 1021.2,
   "end": 1023.94,
   "text": "حسن پیش. اینها را مواظبت بکن.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 264,
   "start": 1023.94,
   "end": 1027.2,
   "text": "اما از این طرف مواظبت بکن نلغزی.",
   "kind": "speech",
   "chapter": null,
   "block": 0
  },
  {
   "i": 265,
   "start": 1027.2,
   "end": 1035.5,
   "text": "چون مثلاً این آدم دستش کیفی از از دنیا و امثال اینها براش خشوع برای دنیا نکن و عزت خودت را چه بکنی؟ حفظ کن",
   "kind": "speech",
   "chapter": null,
   "block": 0
  }
 ]
}